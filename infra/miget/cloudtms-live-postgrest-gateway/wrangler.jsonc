{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudtms-live-miget-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
