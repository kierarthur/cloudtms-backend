{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudtms-mytms-miget-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MIGET_POSTGREST_ORIGIN": "https://mytms-control-plane-postgrest-mwzkq.eu-east-1.migetapp.com"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
