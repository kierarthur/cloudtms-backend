{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "test-cloudtms-candidate-private-api",
  "main": "../broker/src/candidate-private-worker.js",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CANDIDATE_APP_ENVIRONMENT": "TEST",
    "CANDIDATE_APP_PUBLIC_URL": "https://testmode.arthur-rai.co.uk",
    "CANDIDATE_AGENCY_ID": "6d0aadb2-ddc8-4ee4-ab37-871bae4a0d88",
    "CANDIDATE_DATA_PLANE_ID": "2553f243-4846-495d-ba62-b524d0c113c5",
    "CANDIDATE_ROUTE_VERSION": "2",
    "CANDIDATE_ROUTE_CONTEXT_READ_KEY_VERSIONS": "1",
    "CANDIDATE_FEDERATED_ROUTING_ENABLED": "TRUE",
    "CANDIDATE_APP_READY_PROOF_ENABLED": "TRUE",
    "CANDIDATE_APP_READY_PROOF_CLASS": "REAL_TEST_DATA_PLANE",
    "CANDIDATE_APP_READY_RUNTIME_MARKER_SHA256": "8fd56d4854038ac97ce9c52837a0c5ee25c80efa0563b594603bd75cf7598d0c",
    "CANDIDATE_AUTH_REPLAY_KEY_VERSION": "1",
    "CANDIDATE_AUTH_REPLAY_READ_KEY_VERSIONS": "1",
    "CANDIDATE_CHALLENGE_TOKEN_KEY_VERSION": "1",
    "CANDIDATE_CHALLENGE_TOKEN_READ_KEY_VERSIONS": "1",
    "SUPABASE_URL": "https://yakevhtttcsljosbdpov.supabase.co",
    "CANDIDATE_MAX_UPLOAD_BYTES": "15728640",
    "CANDIDATE_MAX_IMAGE_DIMENSION": "10000",
    "CANDIDATE_MAX_IMAGE_PIXELS": "40000000"
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "test-cloudtms",
      "preview_bucket_name": "test-cloudtms-preview"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
