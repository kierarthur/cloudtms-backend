create or replace function private.weekly_source_automatic_reconcile_producer_ready_v1(p_cycle_id uuid)
returns boolean language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare q jsonb; c public.weekly_source_cycles%rowtype; actual_client uuid; rules jsonb;
begin
  q:=private.weekly_source_protected_capability_receipt_v1(p_cycle_id);
  if q->>'schema_version' is distinct from 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_OPERATIONAL_QUALIFICATION_V1'
    or q->>'phase' is distinct from 'ALL_PRE_SWITCH_GATES_QUALIFIED'
    or not(q->'capabilities' @> '["AUTOMATIC_RECONCILE"]'::jsonb) then return false; end if;
  select * into strict c from public.weekly_source_cycles where id=p_cycle_id;
  actual_client:=private.weekly_source_checking_client_scope_v1(c.current_projection_publication_id);
  if actual_client is not null then
    rules:=private.weekly_source_effective_rule_set_v1(actual_client,c.id)->'values';
    return coalesce(rules->>'invoice_sender'='CLIENT_SELF_BILL' and rules->>'equal_protected_hours'='CLEAR_AUTOMATICALLY',false);
  end if;
  -- Legacy group-wide scope is retained. Each actual event's S18b rule check
  -- remains in the normal selection owner; readiness grants no event permission.
  return exists(select 1 from public.weekly_source_group_clients member where member.source_group_id=c.source_group_id
    and c.finalisation_week_ending between member.valid_from and coalesce(member.valid_to,'infinity'::date)
    and private.weekly_source_effective_rule_set_v1(member.client_id,c.id)#>>'{values,invoice_sender}'='CLIENT_SELF_BILL'
    and private.weekly_source_effective_rule_set_v1(member.client_id,c.id)#>>'{values,equal_protected_hours}'='CLEAR_AUTOMATICALLY');
exception when no_data_found or too_many_rows or sqlstate '55000' then return false;
end;
$function$;
