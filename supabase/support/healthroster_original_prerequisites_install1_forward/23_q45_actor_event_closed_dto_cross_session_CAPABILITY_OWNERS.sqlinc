-- All new capability evidence lives in the existing release/assignment receipt.
-- Qualification is installed by root's protected managed-release evidence
-- workflow after actual native prerequisite journeys, never by a browser flag.
create or replace function private.weekly_source_protected_capability_release_evidence_v1(
  p_group_id uuid,p_from date,p_to date,p_expected_sha256 text
) returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare g public.weekly_source_groups%rowtype; r private.cloudtms_database_releases%rowtype;
  q jsonb; entry jsonb; count_rows integer; needed text[]; cap text;
begin
  select * into strict g from public.weekly_source_groups where id=p_group_id and active and source_family='ROSTER';
  select * into r from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1;
  if not found or r.status<>'VERIFIED' or r.completed_at_utc is null
    or r.installed_contract_sha256 is distinct from r.repository_contract_sha256
    or g.environment<>'TEST' or current_database()<>'cloudtms_test_clone'
    or not exists(select 1 from private.cloudtms_database_identity where singleton and environment=g.environment)
    or r.evidence_json#>>'{managed_release,environment}' is distinct from g.environment
    or r.evidence_json#>>'{managed_release,expected_database}' is distinct from current_database()
    or jsonb_typeof(r.evidence_json->'weekly_source_protected_capability_qualifications') is distinct from 'array' then
    raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_RELEASE_UNQUALIFIED' using errcode='55000'; end if;
  select count(*),jsonb_agg(value)->0 into count_rows,q
    from jsonb_array_elements(r.evidence_json->'weekly_source_protected_capability_qualifications') value
    where value->>'source_group_id'=g.id::text and value->>'effective_from_week_ending'=p_from::text
      and value->>'effective_to_week_ending' is not distinct from p_to::text;
  if count_rows<>1 or not private.weekly_exceptional_json_keys_exact_v1(q,array[
      'schema_version','release_id','git_commit','contract_sha256','agency_id','environment','source_group_id',
      'effective_from_week_ending','effective_to_week_ending','capabilities','gate_receipts','qualification_sha256'])
    or not(q ?& array['schema_version','release_id','git_commit','contract_sha256','agency_id','environment','source_group_id',
      'effective_from_week_ending','effective_to_week_ending','capabilities','gate_receipts','qualification_sha256'])
    or q->>'schema_version' is distinct from 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_QUALIFICATION_V1'
    or q->>'release_id' is distinct from r.release_id or q->>'git_commit' is distinct from r.git_commit
    or q->>'contract_sha256' is distinct from r.installed_contract_sha256
    or q->>'agency_id' is distinct from g.agency_id::text or q->>'environment' is distinct from g.environment
    or coalesce(q->>'qualification_sha256','') !~ '^[0-9a-f]{64}$'
    or q->>'qualification_sha256' is distinct from p_expected_sha256
    or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_PROTECTED_CAPABILITY_QUALIFICATION_V1',q-'qualification_sha256'),'hex')
      is distinct from q->>'qualification_sha256'
    or jsonb_typeof(q->'capabilities') is distinct from 'array' or jsonb_array_length(q->'capabilities') not between 1 and 2
    or exists(select 1 from jsonb_array_elements(q->'capabilities') value where jsonb_typeof(value)<>'string'
      or value#>>'{}' not in ('BULK_SIGNED','AUTOMATIC_RECONCILE'))
    or (select count(distinct value) from jsonb_array_elements(q->'capabilities') value)<>jsonb_array_length(q->'capabilities')
    or (q->'capabilities' @> '["AUTOMATIC_RECONCILE"]'::jsonb and not(q->'capabilities' @> '["BULK_SIGNED"]'::jsonb))
    or jsonb_typeof(q->'gate_receipts') is distinct from 'array' then
    raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_RELEASE_UNQUALIFIED' using errcode='55000'; end if;
  needed:=array['SOURCE_CAS_NATIVE','NATIVE_PROTECTION','SECURITY','LEGACY_PAY','NEXT_PAY','CLIENT_API','DOCUMENT','OWN_STAGE_CAS','SOURCE_ROUTING'];
  if q->'capabilities' @> '["AUTOMATIC_RECONCILE"]'::jsonb then needed:=array_append(needed,'AUTOMATIC_COMPONENT_DELTA'); end if;
  if jsonb_array_length(q->'gate_receipts')<>cardinality(needed)
    or (select count(distinct value->>'gate') from jsonb_array_elements(q->'gate_receipts') value)<>cardinality(needed) then
    raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_RELEASE_UNQUALIFIED' using errcode='55000'; end if;
  for entry in select value from jsonb_array_elements(q->'gate_receipts') value loop
    if not private.weekly_exceptional_json_keys_exact_v1(entry,array['gate','status','execution','database','receipt_id','receipt_sha256',
        'source_commit','contract_sha256','source_group_id','agency_id','environment'])
      or not(entry ?& array['gate','status','execution','database','receipt_id','receipt_sha256',
        'source_commit','contract_sha256','source_group_id','agency_id','environment'])
      or not(coalesce(entry->>'gate','')=any(needed)) or entry->>'status' is distinct from 'PASS'
      or entry->>'execution' is distinct from 'AGENCY_TEST_NATIVE' or entry->>'database' is distinct from current_database()
      or entry->>'source_commit' is distinct from r.git_commit or entry->>'contract_sha256' is distinct from r.installed_contract_sha256
      or entry->>'source_group_id' is distinct from g.id::text or entry->>'agency_id' is distinct from g.agency_id::text
      or entry->>'environment' is distinct from g.environment or nullif(btrim(entry->>'receipt_id'),'') is null
      or char_length(entry->>'receipt_id')>256 or coalesce(entry->>'receipt_sha256','') !~ '^[0-9a-f]{64}$' then
      raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_RELEASE_UNQUALIFIED' using errcode='55000'; end if;
  end loop;
  return q;
exception when no_data_found or too_many_rows or invalid_text_representation then
  raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_RELEASE_UNQUALIFIED' using errcode='55000';
end;
$function$;

-- Read-only exact pre-existing policy admission. It does not legalise or rewrite
-- any Client setting, signed preset, Source amount/pricing rule or NHSP route.
create or replace function private.weekly_source_protected_source_activation_scope_v1(p_group_id uuid,p_from date,p_to date)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare g public.weekly_source_groups%rowtype; v_boundary record; policy jsonb; count_rows integer:=0;
begin
  select * into strict g from public.weekly_source_groups where id=p_group_id and active and source_family='ROSTER';
  for v_boundary in
    with members as materialized(select * from public.weekly_source_group_clients where source_group_id=g.id
      and daterange(valid_from,coalesce(valid_to,'infinity'::date),'[]') && daterange(p_from-6,coalesce(p_to,'infinity'::date),'[]')),
    dates as (
      select client_id,greatest(valid_from,p_from-6) scope_date from members
      union select member.client_id,cp.effective_from from members member join public.weekly_source_client_policies cp
        on cp.client_id=member.client_id and cp.source_group_id=g.id where cp.effective_from>=p_from-6
          and cp.effective_from<=coalesce(p_to,'infinity'::date) and cp.effective_from between member.valid_from and coalesce(member.valid_to,'infinity'::date)
      union select member.client_id,cp.effective_to+1 from members member join public.weekly_source_client_policies cp
        on cp.client_id=member.client_id and cp.source_group_id=g.id where cp.effective_to is not null and cp.effective_to+1>=p_from-6
          and cp.effective_to+1<=coalesce(p_to,'infinity'::date) and cp.effective_to+1 between member.valid_from and coalesce(member.valid_to,'infinity'::date)
    ) select dates.client_id,null::uuid contract_id,dates.scope_date from dates
    union select contract.client_id,contract.id,dates.scope_date
      from public.contracts contract join dates on dates.client_id=contract.client_id
      where dates.scope_date between contract.start_date and contract.end_date
    union select contract.client_id,contract.id,greatest(contract.start_date,member.valid_from,p_from-6)
      from public.contracts contract join members member on member.client_id=contract.client_id
      where daterange(contract.start_date,contract.end_date,'[]') && daterange(greatest(member.valid_from,p_from-6),
        least(coalesce(member.valid_to,'infinity'::date),coalesce(p_to,'infinity'::date)),'[]')
    union select contract.client_id,contract.id,boundary.scope_date
      from public.contracts contract join members member on member.client_id=contract.client_id
      join public.weekly_source_contract_policies cp on cp.contract_id=contract.id
      cross join lateral (values(cp.effective_from),(cp.effective_to+1)) boundary(scope_date)
      where boundary.scope_date between greatest(contract.start_date,member.valid_from,p_from-6)
        and least(contract.end_date,coalesce(member.valid_to,'infinity'::date),coalesce(p_to,'infinity'::date))
    order by client_id,contract_id nulls first,scope_date
  loop
    count_rows:=count_rows+1;
    policy:=private._weekly_source_effective_policy_v1(v_boundary.client_id,v_boundary.contract_id,v_boundary.scope_date);
    if policy->>'source_group_id' is distinct from g.id::text or private.weekly_source_is_import_authoritative_v1(
      v_boundary.client_id,v_boundary.contract_id,v_boundary.scope_date) is distinct from true then
      raise exception 'WEEKLY_SOURCE_PROTECTED_SOURCE_SCOPE_NOT_IMPORT_AUTHORITATIVE' using errcode='22023'; end if;
  end loop;
  if count_rows=0 then raise exception 'WEEKLY_SOURCE_RULE_GROUP_MEMBERS_REQUIRED' using errcode='22023'; end if;
end;
$function$;

create or replace function private.weekly_source_protected_capability_receipt_v1(p_cycle_id uuid)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare c public.weekly_source_cycles%rowtype; g public.weekly_source_groups%rowtype;
  a public.weekly_source_group_rule_assignments%rowtype; q jsonb; receipt jsonb;
begin
  select * into strict c from public.weekly_source_cycles where id=p_cycle_id;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and active and source_family='ROSTER';
  select * into strict a from public.weekly_source_group_rule_assignments where source_group_id=g.id and feature_enabled
    and c.finalisation_week_ending between effective_from_week_ending and coalesce(effective_to_week_ending,'infinity'::date);
  receipt:=a.feature_receipt_json;
  if a.feature_purpose is null or a.feature_purpose not in ('RULE_SET','PROTECTED_SOURCE')
    or (a.feature_purpose='PROTECTED_SOURCE' and a.rule_set_version_id is not null)
    or receipt->>'contract' is distinct from 'WEEKLY_SOURCE_RULE_FEATURE_RECEIPT_V1'
    or receipt->>'assignment_id' is distinct from a.id::text or receipt->>'assignment_version' is distinct from a.version::text
    or receipt->>'source_group_id' is distinct from g.id::text
    or receipt->>'rule_set_version_id' is distinct from a.rule_set_version_id::text
    or receipt->>'feature_purpose' is distinct from a.feature_purpose or receipt->'feature_enabled' is distinct from 'true'::jsonb
    or receipt->>'actor_user_id' is distinct from a.feature_changed_by_user_id::text
    or receipt->>'request_id' is distinct from a.feature_request_id::text or receipt->>'release_id' is distinct from a.feature_release_id
    or receipt->>'effective_from_week_ending' is distinct from a.effective_from_week_ending::text
    or a.feature_request_sha256 is null or a.feature_changed_at_utc is null
    or not exists(select 1 from public.tms_users actor where actor.id=a.feature_changed_by_user_id and actor.is_active and actor.role='admin') then
    raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_ACTIVATION_UNQUALIFIED' using errcode='55000'; end if;
  q:=private.weekly_source_protected_capability_release_evidence_v1(g.id,a.effective_from_week_ending,a.effective_to_week_ending,
    receipt#>>'{protected_capability_qualification,qualification_sha256}');
  if q is distinct from receipt->'protected_capability_qualification' or q->>'release_id' is distinct from a.feature_release_id then
    raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_ACTIVATION_UNQUALIFIED' using errcode='55000'; end if;
  return q;
end;
$function$;

create or replace function private.weekly_source_bulk_producer_ready_v1(p_cycle_id uuid)
returns boolean language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare q jsonb;
begin
  q:=private.weekly_source_protected_capability_receipt_v1(p_cycle_id);
  return q->'capabilities' @> '["BULK_SIGNED"]'::jsonb;
exception when no_data_found or too_many_rows or sqlstate '55000' then return false;
end;
$function$;

create or replace function private.weekly_source_automatic_reconcile_producer_ready_v1(p_cycle_id uuid)
returns boolean language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare q jsonb; c public.weekly_source_cycles%rowtype; actual_client uuid; rules jsonb;
begin
  q:=private.weekly_source_protected_capability_receipt_v1(p_cycle_id);
  if not(q->'capabilities' @> '["AUTOMATIC_RECONCILE"]'::jsonb) then return false; end if;
  select * into strict c from public.weekly_source_cycles where id=p_cycle_id;
  actual_client:=private.weekly_source_checking_client_scope_v1(c.current_projection_publication_id);
  if actual_client is not null then
    rules:=private.weekly_source_effective_rule_set_v1(actual_client,c.id)->'values';
    return coalesce(rules->>'invoice_sender'='CLIENT_SELF_BILL' and rules->>'equal_protected_hours'='CLEAR_AUTOMATICALLY',false);
  end if;
  -- Legacy group-wide scope is retained. Each actual event's S18b rule check
  -- remains in the normal selection owner; readiness grants no event permission.
  return exists(select 1 from public.weekly_source_group_clients member where member.source_group_id=c.source_group_id
    and c.finalisation_week_ending between member.valid_from and coalesce(member.valid_to,'infinity'::date)
    and private.weekly_source_effective_rule_set_v1(member.client_id,c.id)#>>'{values,invoice_sender}'='CLIENT_SELF_BILL'
    and private.weekly_source_effective_rule_set_v1(member.client_id,c.id)#>>'{values,equal_protected_hours}'='CLEAR_AUTOMATICALLY');
exception when no_data_found or too_many_rows or sqlstate '55000' then return false;
end;
$function$;
