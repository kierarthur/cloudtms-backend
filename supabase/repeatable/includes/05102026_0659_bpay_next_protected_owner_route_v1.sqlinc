-- Pure owner discrimination shared by status, fresh writers and the four
-- factual selectors. Absence/NULL generation is never positive NEXT proof.
create or replace function private.bpay_next_protected_owner_route_v1(p_family_id uuid)
returns text language plpgsql stable security definer
set search_path=pg_catalog,private,public
as $function$
declare
  v_family public.weekly_exceptional_pay_target_families%rowtype;
  v_receipt private.bpay_next_protected_source_receipt%rowtype;
begin
  if p_family_id is null then
    raise exception using errcode='22023',message='BPAY_NEXT_PROTECTED_FAMILY_REQUIRED';
  end if;
  select f.* into strict v_family from public.weekly_exceptional_pay_target_families f where f.id=p_family_id;
  select r.* into v_receipt from private.bpay_next_protected_source_receipt r
    where r.generation_id=v_family.current_generation_id;
  if v_family.target_domain_version='C1_V1' then
    if found then raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_OWNER_CONFLICT';end if;
    return 'SOURCE_LOCAL';
  end if;
  if v_family.target_domain_version is distinct from 'NEXT_V1' or v_receipt.orchestration_run_id is null
     or v_receipt.family_id is distinct from v_family.id
     or exists(select 1 from public.weekly_source_entitlement_heads h
       where pg_catalog.btrim(h.root_family_booking_id)=pg_catalog.btrim(v_family.root_family_booking_id)
         and h.state='COMMITTED_CURRENT')
     or exists(select 1 from private.weekly_source_local_protected_decision_receipts l
       where l.generation_id=v_family.current_generation_id) then
    raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_OWNER_CONFLICT';
  end if;
  if not exists(select 1 from public.weekly_exceptional_pay_generations g
    join public.weekly_exceptional_orchestration_runs run on run.id=v_receipt.orchestration_run_id
    join public.weekly_exceptional_payment_approvals a on a.id=v_receipt.approval_id
    join private.bpay_next_work_revision r on r.id=v_receipt.revision_id and r.work_id=v_receipt.work_id
    join private.bpay_next_work w on w.id=r.work_id
    join private.bpay_next_publication p on p.work_id=w.id and p.revision_id=r.id
    join private.bpay_next_command c on c.id=p.command_id
    join private.bpay_next_command_member m on m.command_id=c.id and m.candidate_id=w.candidate_id
    where g.id=v_family.current_generation_id and g.family_id=v_family.id and g.lifecycle_state='PUBLISHED'
      and g.published_at_utc is not null and g.result_hash=v_receipt.publication_request_sha256
      and g.fixed_target_source_state_fingerprint=v_receipt.source_manifest_sha256
      and run.family_id=v_family.id and run.state='COMPLETE' and run.requested_by_user_id=v_receipt.actor_user_id
      and run.request_fingerprint=v_receipt.prepared_request_sha256
      and a.pay_target_family_id=v_family.id and a.creation_orchestration_run_id=run.id
      and a.candidate_id=v_family.candidate_id and a.contract_id=v_family.contract_id
      and a.week_ending=v_family.week_ending_date
      and r.source_kind='PROTECTED' and r.source_event_id=a.id and r.source_head_id is null
      and r.financial_snapshot_id is null and r.approved_at_utc is not null and r.sealed_at_utc is not null
      and w.work_kind='SOURCE' and w.candidate_id=v_family.candidate_id and w.contract_id=v_family.contract_id
      and w.booking_id=v_family.root_family_booking_id and w.week_ending_date=v_family.week_ending_date
      and p.command_id=v_receipt.command_id and p.candidate_id=w.candidate_id and p.revision_no=r.revision_no
      and c.command_kind='POSITION_APPLY' and c.agency_sequence=v_receipt.agency_sequence
      and c.expected_member_count=1 and c.sealed_at_utc is not null and m.member_no=1) then
    raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_OWNER_CONFLICT';
  end if;
  return 'NEXT';
exception when no_data_found or too_many_rows then
  raise exception using errcode='55000',message='BPAY_NEXT_PROTECTED_OWNER_SCOPE_INVALID';
end
$function$;

alter function private.bpay_next_protected_owner_route_v1(uuid) owner to postgres;
revoke all on function private.bpay_next_protected_owner_route_v1(uuid)
  from public,anon,authenticated,service_role;
