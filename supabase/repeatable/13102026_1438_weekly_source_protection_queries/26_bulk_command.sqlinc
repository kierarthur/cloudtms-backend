-- One shift per bounded round. Initial claims and round results reuse native
-- append-only audit_events; no command/receipt table or financial calculation.
create or replace function public.weekly_source_protect_all_signed_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_actor uuid; v_cycle_id uuid; v_mode text; v_phase text; v_key text; v_object text; v_initial jsonb;
  v_cycle public.weekly_source_cycles%rowtype; v_group uuid; v_selection jsonb; v_context jsonb; v_stage jsonb;
  v_request public.weekly_exceptional_c1_publication_requests%rowtype; v_generation public.weekly_exceptional_pay_generations%rowtype;
  v_proof jsonb; v_own jsonb; v_lock jsonb; v_gate jsonb; v_result jsonb; v_response jsonb; v_refusal text;
  v_claim jsonb; v_remaining jsonb:='[]'::jsonb; v_done jsonb:='[]'::jsonb; v_current jsonb; v_count integer;
  v_round_key text; v_source_cas text; v_selection_sha text; v_completed boolean; v_initial_claim jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['actor_user_id','source_cycle_id','mode','phase',
    'bulk_request_key','expected_selection_sha256','staged'])
    or jsonb_typeof(p_request) is distinct from 'object' or octet_length(convert_to(p_request::text,'UTF8'))>262144 then
    raise exception 'WEEKLY_SOURCE_BULK_REQUEST_INVALID' using errcode='22023'; end if;
  begin v_actor:=(p_request->>'actor_user_id')::uuid; v_cycle_id:=(p_request->>'source_cycle_id')::uuid;
  exception when invalid_text_representation then raise exception 'WEEKLY_SOURCE_BULK_REQUEST_INVALID' using errcode='22023'; end;
  v_mode:=p_request->>'mode'; v_phase:=coalesce(p_request->>'phase','ADMIT'); v_key:=p_request->>'bulk_request_key';
  select * into strict v_cycle from public.weekly_source_cycles where id=v_cycle_id;
  perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',v_cycle.source_group_id,null,v_cycle.finalisation_week_ending);
  if v_mode='PREVIEW' then
    if p_request ? 'staged' or p_request ? 'phase' then raise exception 'WEEKLY_SOURCE_BULK_REQUEST_INVALID' using errcode='22023'; end if;
    return jsonb_build_object('ok',true,'mode','PREVIEW')||private.weekly_source_protect_all_signed_selection_v1(v_cycle_id,v_actor,null);
  end if;
  if v_mode is distinct from 'COMMIT' or v_phase not in ('ADMIT','ROUND','APPLY')
    or coalesce(v_key,'') !~ '^[A-Za-z0-9:_-]{16,120}$' then
    raise exception 'WEEKLY_SOURCE_BULK_REQUEST_INVALID' using errcode='22023'; end if;
  v_object:=v_cycle_id::text||':'||v_actor::text||':'||v_key;
  select audit.after_json into v_initial from public.audit_events audit
    where audit.object_type='weekly_source_bulk_signed_command' and audit.object_id_text=v_object
      and audit.action='WEEKLY_SOURCE_BULK_SIGNED_COMMAND_ADMITTED' and audit.event_sequence_is_authoritative
    order by audit.event_sequence desc limit 1;
  if v_phase='ADMIT' then
    -- No family/gate call is made in this phase. The original cycle mutex owns
    -- admission idempotence, and is released before Worker preparation starts.
    perform 1 from public.weekly_source_groups where id=v_cycle.source_group_id for share;
    v_group:=v_cycle.source_group_id;
    select * into strict v_cycle from public.weekly_source_cycles where id=v_cycle_id for update;
    if v_cycle.source_group_id is distinct from v_group then
      raise exception 'WEEKLY_SOURCE_BULK_SOURCE_CHANGED' using errcode='40001'; end if;
    select audit.after_json into v_initial from public.audit_events audit
      where audit.object_type='weekly_source_bulk_signed_command' and audit.object_id_text=v_object
        and audit.action='WEEKLY_SOURCE_BULK_SIGNED_COMMAND_ADMITTED' and audit.event_sequence_is_authoritative
      order by audit.event_sequence desc limit 1;
    if v_initial is not null then
      if v_initial#>>'{initial_selection,selection_sha256}' is distinct from p_request->>'expected_selection_sha256' then
        raise exception 'WEEKLY_SOURCE_BULK_REPLAY_CONFLICT' using errcode='23505'; end if;
      return jsonb_build_object('ok',true,'phase','ADMITTED','idempotent_replay',true,'initial_selection',v_initial->'initial_selection');
    end if;
    v_selection:=private.weekly_source_protect_all_signed_selection_v1(v_cycle_id,v_actor,null);
    if v_selection->>'selection_sha256' is distinct from p_request->>'expected_selection_sha256' then
      raise exception 'WEEKLY_SOURCE_BULK_SELECTION_CHANGED' using errcode='40001'; end if;
    v_initial:=jsonb_build_object('schema_version','WEEKLY_SOURCE_BULK_COMMAND_V1','actor_user_id',v_actor,
      'source_cycle_id',v_cycle_id,'bulk_request_key',v_key,'initial_selection',v_selection);
    perform public._audit_insert('weekly_source_bulk_signed_command',v_object,'WEEKLY_SOURCE_BULK_SIGNED_COMMAND_ADMITTED',
      null,v_initial,'Protect signed MyTMS submissions',v_actor);
    return jsonb_build_object('ok',true,'phase','ADMITTED','idempotent_replay',false,'initial_selection',v_selection);
  end if;
  if v_initial is null then raise exception 'WEEKLY_SOURCE_BULK_COMMAND_NOT_ADMITTED' using errcode='55000'; end if;
  if v_phase='ROUND' then
    -- Resume the exact pending generation before deriving another round.
    select generation.complete_next_vector_json->'bulk_signed_selection_proof' into v_proof
      from public.weekly_exceptional_c1_publication_requests request
      join public.weekly_exceptional_pay_generations generation on generation.id=request.generation_id
      where generation.complete_next_vector_json#>>'{bulk_signed_selection_proof,bulk_request_key}'=v_key
        and generation.complete_next_vector_json#>>'{bulk_signed_selection_proof,actor_user_id}'=v_actor::text
        and generation.complete_next_vector_json#>>'{bulk_signed_selection_proof,source_cycle_id}'=v_cycle_id::text
        and request.state='READY' and generation.lifecycle_state='PENDING_C1'
      order by request.id limit 1;
    if v_proof is not null then
      v_context:=private.weekly_source_bulk_own_stage_context_v1(v_cycle_id,v_actor,v_key,
        v_proof->>'selection_sha256',v_proof#>>'{source_cas,source_cas_sha256}');
    end if;
    v_selection:=private.weekly_source_protect_all_signed_selection_v1(v_cycle_id,v_actor,v_context);
    if v_selection#>>'{source_cas,source_cas_sha256}' is distinct from v_initial#>>'{initial_selection,source_cas,source_cas_sha256}' then
      raise exception 'WEEKLY_SOURCE_BULK_SOURCE_CHANGED' using errcode='40001'; end if;
    for v_initial_claim in select value from jsonb_array_elements(v_initial#>'{initial_selection,eligible}') loop
      -- A completed disposition is accepted only from this command's actual
      -- immutable native stage proof and local completion receipt.
      select exists(select 1 from public.weekly_exceptional_c1_publication_requests request
        join public.weekly_exceptional_pay_generations generation on generation.id=request.generation_id
        join private.weekly_source_local_protected_decision_receipts receipt on receipt.publication_request_id=request.id
          and receipt.actor_user_id=v_actor and receipt.request_sha256=request.request_sha256 and receipt.state in ('COMPLETE','PENDING_FREEZE')
        where generation.complete_next_vector_json#>>'{bulk_signed_selection_proof,bulk_request_key}'=v_key
          and generation.complete_next_vector_json#>>'{bulk_signed_selection_proof,actor_user_id}'=v_actor::text
          and generation.complete_next_vector_json#>>'{bulk_signed_selection_proof,source_cycle_id}'=v_cycle_id::text
          and generation.complete_next_vector_json#>'{bulk_signed_selection_proof,eligible_claim}'=v_initial_claim
          and private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',generation.complete_next_vector_json)=generation.complete_next_vector_hash
          and receipt.result_json->>'ok'='true') into v_completed;
      if v_completed then v_done:=v_done||jsonb_build_array(v_initial_claim->'work_event_id'); continue; end if;
      select count(*),jsonb_agg(value)->0 into v_count,v_current from jsonb_array_elements(v_selection->'eligible') value
        where value->>'work_event_id'=v_initial_claim->>'work_event_id';
      if v_count<>1 or v_current is distinct from v_initial_claim then
        raise exception 'WEEKLY_SOURCE_BULK_ORIGINAL_CLAIM_CHANGED' using errcode='40001'; end if;
      v_remaining:=v_remaining||jsonb_build_array(v_current);
    end loop;
    return jsonb_build_object('ok',true,'phase','ROUND','selection',v_selection,'remaining',v_remaining,'completed_work_event_ids',v_done,
      'pending_stages',coalesce(v_context->'exclusions','[]'::jsonb),'max_stages_per_round',1);
  end if;
  if jsonb_typeof(p_request->'staged') is distinct from 'array' or jsonb_array_length(p_request->'staged')<>1 then
    raise exception 'WEEKLY_SOURCE_BULK_ROUND_INVALID' using errcode='22023'; end if;
  v_stage:=p_request#>'{staged,0}';
  if not private.weekly_exceptional_json_keys_exact_v1(v_stage,array['publication_request_id','request_sha256'])
    or not(v_stage ?& array['publication_request_id','request_sha256']) then
    raise exception 'WEEKLY_SOURCE_BULK_ROUND_INVALID' using errcode='22023'; end if;
  select * into strict v_request from public.weekly_exceptional_c1_publication_requests where id=(v_stage->>'publication_request_id')::uuid;
  select * into strict v_generation from public.weekly_exceptional_pay_generations where id=v_request.generation_id;
  v_proof:=v_generation.complete_next_vector_json->'bulk_signed_selection_proof';
  v_selection_sha:=v_proof->>'selection_sha256'; v_source_cas:=v_proof#>>'{source_cas,source_cas_sha256}';
  v_round_key:=v_request.id::text;
  -- Exact audit replay precedes mutable freshness checks and locks.
  select audit.after_json into v_response from public.audit_events audit where audit.object_type='weekly_source_bulk_signed_command'
    and audit.object_id_text=v_object and audit.action='WEEKLY_SOURCE_BULK_SIGNED_ROUND_COMPLETED'
    and audit.after_json->>'publication_request_id'=v_round_key and audit.event_sequence_is_authoritative
    order by audit.event_sequence desc limit 1;
  if v_response is not null then
    if v_response->>'request_sha256' is distinct from v_stage->>'request_sha256' then
      raise exception 'WEEKLY_SOURCE_BULK_REPLAY_CONFLICT' using errcode='23505'; end if;
    return v_response||jsonb_build_object('idempotent_replay',true);
  end if;
  -- Complete round has one real family. Every Candidate gate comes first;
  -- native I-1 still receives the complete round set and owns its raw order.
  perform private.weekly_source_pay_query_admit_v2();
  v_gate:=private.weekly_source_candidate_serial_gate_v1(v_request.candidate_id,'WORKBENCH_CANDIDATE_ENTITLEMENT_PUBLICATION',
    v_request.id,'WEEKLY_SOURCE_ENTITLEMENT_PUBLICATION');
  if v_gate->>'ok' is distinct from 'true' then return v_gate||jsonb_build_object('phase','BLOCKED','accepted',false); end if;
  if not exists(select 1 from public.timesheets sheet join public.contracts contract on contract.id=sheet.contract_id
    where sheet.timesheet_id=v_request.root_timesheet_id and contract.candidate_id=v_request.candidate_id) then
    raise exception 'WEEKLY_SOURCE_BULK_ROOT_CANDIDATE_MISMATCH' using errcode='55000'; end if;
  v_lock:=private.weekly_source_lock_family_rows_v1(array[v_request.root_timesheet_id],null);
  if v_lock->>'ok' is distinct from 'true' then return v_lock||jsonb_build_object('phase','BLOCKED','accepted',false); end if;
  v_group:=v_cycle.source_group_id;
  perform 1 from public.weekly_source_groups where id=v_group and active for update;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_cycle_id for update;
  if v_cycle.source_group_id is distinct from v_group then raise exception 'WEEKLY_SOURCE_BULK_SOURCE_CHANGED' using errcode='40001'; end if;
  v_own:=private.weekly_source_bulk_own_stage_v1(v_request.id,v_actor,v_cycle_id,v_key,v_selection_sha,v_source_cas);
  if v_request.request_sha256 is distinct from private.weekly_exceptional_hex_sha256_v1(v_stage->>'request_sha256')
    or not exists(select 1 from jsonb_array_elements(v_initial#>'{initial_selection,eligible}') original
      where original=v_proof->'eligible_claim') then
    raise exception 'WEEKLY_SOURCE_BULK_ORIGINAL_CLAIM_CHANGED' using errcode='40001'; end if;
  v_context:=private.weekly_source_bulk_own_stage_context_v1(v_cycle_id,v_actor,v_key,v_selection_sha,v_source_cas);
  if jsonb_array_length(v_context->'exclusions') is distinct from 1
    or v_context#>>'{exclusions,0,publication_request_id}' is distinct from v_request.id::text then
    raise exception 'WEEKLY_SOURCE_BULK_ROUND_INVALID' using errcode='55000'; end if;
  v_selection:=private.weekly_source_protect_all_signed_selection_v1(v_cycle_id,v_actor,v_context);
  if v_selection->>'selection_sha256' is distinct from v_selection_sha
    or v_source_cas is distinct from v_initial#>>'{initial_selection,source_cas,source_cas_sha256}' then
    raise exception 'WEEKLY_SOURCE_BULK_SELECTION_CHANGED' using errcode='40001'; end if;
  begin
    v_result:=public.weekly_exceptional_pay_complete_local_v1(jsonb_build_object('schema_version','WEEKLY_PROTECTED_LOCAL_COMPLETE_V1',
      'actor_user_id',v_actor,'publication_request_id',v_request.id,'expected_request_sha256',v_stage->>'request_sha256',
      'idempotency_key',(select idempotency_key from public.weekly_exceptional_orchestration_runs where id=v_request.orchestration_run_id)||':local-complete'));
    if v_result->>'ok' is distinct from 'true' or v_result->>'outcome' not in ('PUBLISHED','SAVED_PENDING_FREEZE') then
      raise exception 'WEEKLY_SOURCE_BULK_NATIVE_COMPLETE_REFUSED' using errcode='55000'; end if;
  exception when others then
    v_refusal:=coalesce(substring(sqlerrm from '^[A-Z][A-Z0-9_]{0,119}$'),'PROTECTION_REFUSED');
    return jsonb_build_object('ok',false,'phase','PARTIAL','publication_request_id',v_request.id,
      'work_event_id',v_proof#>'{eligible_claim,work_event_id}','code',v_refusal,'completed',false,'retryable',true);
  end;
  v_response:=jsonb_build_object('ok',true,'phase','ROUND_COMPLETED','publication_request_id',v_request.id,
    'request_sha256',v_stage->>'request_sha256','work_event_id',v_proof#>'{eligible_claim,work_event_id}',
    'native_result',v_result,'whole_command_atomic',false);
  perform public._audit_insert('weekly_source_bulk_signed_command',v_object,'WEEKLY_SOURCE_BULK_SIGNED_ROUND_COMPLETED',
    null,v_response,'Protected from the signed MyTMS submission',v_actor);
  return v_response;
end;
$function$;
alter function public.weekly_source_protect_all_signed_atomic_v1(jsonb) owner to postgres;
revoke all on function public.weekly_source_protect_all_signed_atomic_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_protect_all_signed_atomic_v1(jsonb) to service_role;
