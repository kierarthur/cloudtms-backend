      sh.appendRow([ts, '_1readEmailHistoryCompact', String(evt), JSON.stringify(obj || {}).slice(0, 5000)]);
    } catch (_) {}
  }

  lookbackDays = lookbackDays || 60;
  const ss = SpreadsheetApp.getActive();
  const eh = ss.getSheetByName(SH_EMAILHIST) || ss.getSheetByName('emailhistory');
  if (!eh) {
    log_('no_sheet', { sheetTried: [SH_EMAILHIST, 'emailhistory'] });
    return { byCid:{}, recentByCid:{}, bookingsBySiteWard:{}, profilesExtra:{}, namesByCid:{} };
  }

  const vals = eh.getDataRange().getDisplayValues();
  if (vals.length <= 1) {
    log_('empty', { rows: vals.length });
    return { byCid:{}, recentByCid:{}, bookingsBySiteWard:{}, profilesExtra:{}, namesByCid:{} };
  }

  const hdr = vals[0].map(function(s){ return String(s||'').toLowerCase(); });
  const iName  = hdr.indexOf('occupantkey');
  const iDate  = hdr.indexOf('date');
  const iShift = hdr.indexOf('shift');
  const iTel   = hdr.indexOf('telephone');
  const iSur   = hdr.indexOf('surname');
  const iFir   = hdr.indexOf('first name');
  const iNote  = hdr.indexOf('note');
  const iHosp  = hdr.indexOf('hospital');
  const iWard  = hdr.indexOf('ward');
  const iJob   = hdr.indexOf('job title'); // optional

  var byCid = {};
  var recentByCid = {};
  var bookingsBySiteWard = {};
  var profilesExtra = {};
  var namesByCid = {};

  const now = new Date();
  const from = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  from.setDate(from.getDate() - lookbackDays);

  function nameFromOccupantKey(occ) {
    const parts = String(occ||'').trim().split(/\s+/);
    if (!parts.length) return { sur:'', fir:'' };
    const fir = parts.pop() || '';
    const sur = parts.join(' ');
    return { sur: sur, fir: fir };
  }
  function resolveCid(sur, fir, email, phone) {
    const base = _1baseFromName(sur, fir);
    const e = _1normEmail(email);
    const p = _1normPhone(phone);
    if (!base) return '';

    const arr = avResolver && avResolver[base] ? avResolver[base] : null;
    if (arr && arr.length === 1) return arr[0].cid;
    if (arr && arr.length > 1) {
      for (let i=0; i<arr.length; i++) { if (e && arr[i].email && arr[i].email === e) return arr[i].cid; }
      for (let i=0; i<arr.length; i++) { if (p && arr[i].phone && arr[i].phone === p) return arr[i].cid; }
    }

    const hint = _1hintFromEmailPhone(e, p) || ('h:' + base);
    let cid = base + '_' + _1hash3(hint);
    return cid;
  }

  var rowsProcessed = 0, flagsE = 0, flags2 = 0;

  for (let r=1; r<vals.length; r++) {
    const dStr = vals[r][iDate] || '';
    const d = _1parseDDMMYYYY(dStr) || _1parseHeaderDate(dStr);
    if (!d) continue;
    if (d < from) continue;

    const ymd = _1fmtYmd(d);
    const shTxt  = String(vals[r][iShift] || '').trim().toUpperCase();
    const s      = (shTxt === 'N' || shTxt.startsWith('N')) ? 'N' : 'L';

    const sur = (iSur>=0 ? vals[r][iSur] : '');
    const fir = (iFir>=0 ? vals[r][iFir] : '');
    const tel = (iTel>=0 ? vals[r][iTel] : '');
    let esur = sur, efir = fir;
    if (!sur && !fir && iName>=0) {
      const n = nameFromOccupantKey(vals[r][iName]);
      esur = n.sur; efir = n.fir;
    }

    const cid = resolveCid(esur, efir, '', tel);
    if (!cid) continue;

    if (!byCid[cid]) byCid[cid] = { worked: {}, flags: '' };
    byCid[cid].worked[ymd] = s;

    if (!recentByCid[cid]) recentByCid[cid] = [];
    recentByCid[cid].push({ ymd: ymd, s: s });

    // --- Urgency flags from EH note ---
    const noteRaw = (iNote>=0 ? String(vals[r][iNote]||'') : '');
    const noteLower = noteRaw.toLowerCase();

    let tag = null;
    if (typeof _1noteToTag === 'function') {
      try { tag = _1noteToTag(noteRaw, s); } catch (_) { tag = null; }
    }

    const emergencyFallback =
      /asap|urgent|emergency/i.test(noteLower) ||
      /(?:\bafter\b|>)\s*11(?::\d{2})?\s*am\b/i.test(noteLower);

    const day2earlyFallback =
      /(day\s*2|second\s*day)/i.test(noteLower) &&
      /(?:before|<)\s*0?7(?::?[0-5]\d)?\s*am\b/i.test(noteLower);

    let f = byCid[cid].flags || '';
    var beforeFlags = f;
    if (tag === 'ASAP' || (!tag && emergencyFallback)) {
      if (f.indexOf('E') === -1) f += 'E';
    }
    if (tag === 'DAY2EARLY' || (!tag && day2earlyFallback)) {
      if (f.indexOf('2') === -1) f += '2';
    }
    byCid[cid].flags = f;
    if (beforeFlags !== f) {
      if (f.indexOf('E') >= 0 && beforeFlags.indexOf('E') < 0) flagsE++;
      if (f.indexOf('2') >= 0 && beforeFlags.indexOf('2') < 0) flags2++;
    }

    const site = (iHosp>=0 ? String(vals[r][iHosp]||'').trim() : '');
    const ward = (iWard>=0 ? String(vals[r][iWard]||'').trim() : '');
    const key  = (site || ward) ? (site + '|' + ward) : '';
    if (key) {
      if (!bookingsBySiteWard[key]) bookingsBySiteWard[key] = {};
      const sw = bookingsBySiteWard[key];
      const k = ymd + '|' + s;
      if (!sw[k]) sw[k] = [];
      sw[k].push(cid);
    }

    if (iJob >= 0) {
      const roleEH = _1normRole(vals[r][iJob] || '');
      if (roleEH) {
        if (!profilesExtra[cid]) profilesExtra[cid] = { role: roleEH, gender: 'Any' };
      }
    }

    const displayName = (efir ? (efir + ' ') : '') + (esur || '');
    if (displayName.trim()) namesByCid[cid] = displayName.trim();

    rowsProcessed++;
  }

  Object.keys(recentByCid).forEach(function(cid){
    recentByCid[cid].sort(function(a,b){ return (a.ymd < b.ymd ? 1 : -1); });
  });

  log_('done', { rowsProcessed: rowsProcessed, cids: Object.keys(byCid).length, flagsE: flagsE, flags2: flags2 });

  return { byCid: byCid, recentByCid: recentByCid, bookingsBySiteWard: bookingsBySiteWard, profilesExtra: profilesExtra, namesByCid: namesByCid };
}



function planWithDeepseekFromActiveRota(exclusions) {
  // Pin the ORIGINAL sheet up-front and carry it forward
  const ss = SpreadsheetApp.getActive();
  const activeSheet = ss.getActiveSheet();
  const pinnedName = activeSheet ? activeSheet.getName() : '';
  const pinnedId = activeSheet ? activeSheet.getSheetId() : -1;

  const runId = _1newRunId('DS');

  // --- timing helpers -------------------------------------------------------
  const t0 = Date.now();
  let site = '', ward = '', sheetName = pinnedName;
  function _tick(label, extra) {
    const now = Date.now();
    _tick._last = _tick._last || t0;
    const ms = now - _tick._last;
    _tick._last = now;
    try {
      _1logDeepseekCallChunked({
        runId: runId,
        mode: 'TIMING',
        sheetName: sheetName || '',
        site: site || '',
        ward: ward || '',
        payload: extra && extra.payloadSize != null ? ('payloadSize=' + extra.payloadSize) : '',
        outputJSON: '',
        status: label + ' | ' + ms + 'ms'
      });
    } catch (_) {}
  }
  function _tickTotal(label) {
    const total = Date.now() - t0;
    try {
      _1logDeepseekCallChunked({
        runId: runId,
        mode: 'TIMING',
        sheetName: sheetName || '',
        site: site || '',
        ward: ward || '',
        payload: '',
        outputJSON: '',
        status: (label || 'TOTAL') + ' | ' + total + 'ms'
      });
    } catch (_) {}
  }
  // --------------------------------------------------------------------------

  // Guard: must be on a Patient_ rota
  try {
    if (typeof _1isPatientRotaSheet === 'function' && !_1isPatientRotaSheet(activeSheet)) {
      SpreadsheetApp.getUi().alert('Please open a Patient_ rota sheet before running matching.');
      _tick('guard: not Patient_ rota (abort)');
      _tickTotal('TOTAL (aborted)');
      return { json: null, text: 'Aborted: not on a Patient_ rota.' };
    }
  } catch (_) {
    SpreadsheetApp.getUi().alert('Unable to verify sheet type. Open a Patient_ rota sheet and try again.');
    _tick('guard: verification error (abort)');
    _tickTotal('TOTAL (aborted)');
    return { json: null, text: 'Aborted: sheet guard failed.' };
  }
  _tick('guard: ok');

  // Gather context for the date-picker UI (USING THE PINNED SHEET)
  const scan = _1collectVacancyDatesNext7Days(activeSheet);
  _tick('_1collectVacancyDatesNext7Days');
  if (!scan || !Array.isArray(scan.dates) || !scan.dates.length) {
    const msg = scan && scan.hasAnyNames
      ? 'No empty future dates found.'
      : 'No empty dates found in the next 7 days.';
    SpreadsheetApp.getUi().alert(msg);
    _tick('no eligible vacancy dates (abort)');
    _tickTotal('TOTAL (aborted)');
    return { json: null, text: 'Aborted: no eligible vacancy dates.' };
  }

  // Defaults
  const defaults = scan.hasAnyNames ? scan.dates.slice(0) : scan.dates.slice(0, Math.min(5, scan.dates.length));
  _tick('defaults computed');

  // Best-effort site/ward/sheet context
  try {
    const layout = (typeof _1readCurrentRotaLayoutAndBlanks === 'function')
      ? _1readCurrentRotaLayoutAndBlanks(activeSheet)
      : { site:'', ward:'' };
    site = layout.site || '';
    ward = layout.ward || '';
    sheetName = pinnedName;
  } catch (_) {
    sheetName = pinnedName;
  }
  _tick('_1readCurrentRotaLayoutAndBlanks');

  // Scan other rotas (skip the pinned sheet by id as well as name)
  const tz = _1tz();
  const today = new Date(Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd') + 'T00:00:00');
  const todayYmd = _1fmtYmd(today);
  const otherRotasInfo = [];
  try {
    const sheets = ss.getSheets() || [];
    for (let i=0;i<sheets.length;i++){
      const s = sheets[i];
      if (s.getSheetId && s.getSheetId() === pinnedId) continue;
      const nm = String(s.getName()||'');
      if (!/^patient_/i.test(nm)) continue;
      const info = _1readCurrentRotaLayoutAndBlanks(s);
      const latest = info.latestYmd || '';
      const newestIsFuture = latest && latest >= todayYmd;
      otherRotasInfo.push({
        sheetName: nm,
        site: info.site||'',
        ward: info.ward||'',
        latestYmd: latest,
        newestIsFuture: !!newestIsFuture
      });
    }
  } catch (_) {}
  _tick('scan other rotas list');

  try {
    const t = HtmlService.createTemplateFromFile('DeepseekDatePicker');
    _tick('HtmlService.createTemplateFromFile');

    // IMPORTANT: pass the pinned sheet identity through to the continuation
    t.data = {
      runId: runId,
      sheetName: sheetName,
      pinnedSheetName: pinnedName,
      pinnedSheetId: pinnedId,
      site: site,
      ward: ward,
      dates: scan.dates,
      defaults: defaults,
      hasAnyNames: !!scan.hasAnyNames,
      exclusions: Array.isArray(exclusions) ? exclusions.slice(0) : [],
      otherRotas: otherRotasInfo,
      continuationFn: '_1beginDeepseekAfterDatePick'
    };

    const html = t.evaluate().setWidth(620).setHeight(680);
    _tick('template.evaluate');

    const dialogTitle = scan.hasAnyNames
      ? 'Pick dates to match (all future dates)'
      : 'Pick dates to match (next 7 days)';

    SpreadsheetApp.getUi().showModalDialog(html, dialogTitle);
    _tick('showModalDialog');

    _tickTotal('TOTAL (async path to modal)');
    return { started: true, text: 'Date picker opened.', runId: runId, sheetName: sheetName, pinnedSheetId: pinnedId };
  } catch (e) {
    _tick('async modal path failed; entering fallback');

    // Fallback path uses the PINNED SHEET explicitly
    if (typeof _1openDatePickerModal === 'function') {
      const pick = _1openDatePickerModal(scan.dates, defaults, { runId: runId, pinnedSheetName: pinnedName, pinnedSheetId: pinnedId });
      _tick('_1openDatePickerModal');
      if (!pick || !pick.ok || !Array.isArray(pick.selectedDates) || !pick.selectedDates.length) {
        _tick('fallback cancelled (abort)');
        _tickTotal('TOTAL (aborted)');
        return { json: null, text: 'Cancelled by user.' };
      }
      const pickedDates = pick.selectedDates;

      const built = _1buildCompactPayload(activeSheet, {
        exclusions: Array.isArray(exclusions) ? exclusions : [],
        selectedDates: pickedDates || [],
        extraLines: [],
        runId: runId
      });
      const payload = built.payload;
      _tick('_1buildCompactPayload', { payloadSize: (payload && payload.length) ? payload.length : 0 });

      const systemTEXT = _1buildDeepseekSystemText_TEXT();

      // DISPATCH to GitHub Actions (non-blocking) and open progress panel
      try {
        const meta = { sheetName: built.sheetName, site: built.site, ward: built.ward, pinnedSheetId: pinnedId };
        _dispatchToGitHub(runId, meta, { systemText: systemTEXT, payload: payload });
        _1logDeepseekCallChunked({
          runId: runId, mode: 'DISPATCHED', sheetName: built.sheetName, site: built.site, ward: built.ward,
          payload: 'len=' + (payload ? payload.length : 0), outputJSON: '', status: 'Sent to GitHub Actions'
        });
        if (typeof _storeLastRunId === 'function') { try { _storeLastRunId(runId); } catch(_){} }
        if (typeof showProgressPanel === 'function') {
          try { showProgressPanel(runId, meta); } catch(_) {}
        }
        _tickTotal('TOTAL (fallback dispatch path)');
        return { ok: true, runId: runId, dispatched: true, sheetName: built.sheetName, site: built.site, ward: built.ward, pinnedSheetId: pinnedId };
      } catch (errD) {
        const msg = (errD && errD.message) ? errD.message : String(errD);
        try { SpreadsheetApp.getUi().alert('Dispatch failed: ' + msg); } catch(_) {}
        _tickTotal('TOTAL (dispatch failed)');
        return { ok: false, error: msg };
      }
    } else {
      SpreadsheetApp.getUi().alert('Date-picker UI unavailable. Please add DeepseekDatePicker.html or provide _1openDatePickerModal().');
      _tick('fallback modal unavailable (abort)');
      _tickTotal('TOTAL (aborted)');
      return { json: null, text: 'Aborted: no date-picker available.' };
    }
  }
}




function _1computeOtherRotaProtections(options) {
  const ss = SpreadsheetApp.getActive();
  function _log(msg, obj) {
    try {
      const sh = ss.getSheetByName('Logs'); if (!sh) return;
      const ts = Utilities.formatDate(new Date(), _1tz(), 'yyyy-MM-dd HH:mm:ss');
      sh.appendRow([ts, '_1computeOtherRotaProtections', String(msg || ''), obj ? JSON.stringify(obj) : '']);
    } catch (_) {}
  }

  const activeSheet = (options && options.activeSheet) || SpreadsheetApp.getActiveSheet();
  const selectedDatesRaw = (options && options.selectedDates) || [];
  const selectedDates = Array.from(new Set(
    selectedDatesRaw.map(d => _1fmtYmd(new Date(d)))
  )).sort();

  _log('begin', { selectedDatesCount: selectedDates.length });

  if (!selectedDates.length) return { lines: [], protectedDatesCount: 0 };

  // Today (sheet timezone) at midnight
  const tz = _1tz();
  const todayYmd = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');

  // Helpers
  function addDaysYmd(ymd, n) { const d = new Date(ymd + 'T00:00:00'); d.setDate(d.getDate() + n); return _1fmtYmd(d); }
  function expandDates(startY, endY) { const out = []; let cur = startY; while (cur <= endY) { out.push(cur); cur = addDaysYmd(cur, 1); } return out; }

  // Determine if the furthest selected date includes any Night vacancy on the active rota.
  let lastSelected = selectedDates[selectedDates.length - 1];
  const activeLayout = _1readCurrentRotaLayoutAndBlanks(activeSheet);
  const nightOnLastSelected = (activeLayout.vacancies || []).some(v => v.ymd === lastSelected && v.shift === 'N');

  // Horizon rule
  const horizonEnd = nightOnLastSelected ? addDaysYmd(lastSelected, 1) : lastSelected;

  // Window start: from today (future-only per requirement)
  const windowStart = todayYmd <= selectedDates[0] ? todayYmd : selectedDates[0];
  const horizonDates = expandDates(windowStart, horizonEnd);

  // Normalize list of Patient_* sheet names toggled ON
  const selectedOtherNames = [];
  const raw = (options && options.otherRotasSelected) || [];
  for (let i = 0; i < raw.length; i++) {
    const x = raw[i];
    if (typeof x === 'string') selectedOtherNames.push(x);
    else if (x && typeof x.sheetName === 'string') selectedOtherNames.push(x.sheetName);
  }

  _log('horizon', {
    lastSelected,
    nightOnLastSelected,
    horizonEnd,
    windowStart,
    horizonDays: horizonDates.length,
    otherSheetsSelected: selectedOtherNames.length
