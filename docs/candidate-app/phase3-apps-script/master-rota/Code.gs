function newTryWATISessionMessage(phone, name, diffs) {
  if (!diffs || diffs.length === 0) return false;

  let lines = [`Hi ${name}, here are your recent shift updates:\n`];
  for (let d of diffs) {
    let prefix = d.type === 'NEW' ? '*NEW*' : d.type === 'CX' ? '*CX*' : '*newREF*';
    let date = Utilities.formatDate(new Date(d.date), Session.getScriptTimeZone(), "dd/MM");
    let line = `${prefix} – ${date} – ${d.shift} – ${d.hospital} ${d.ward}`;
    if (d.type === 'newREF') {
      line += ` – ${d.newRef}`;
    }
    lines.push('• ' + line);
  }
  lines.push('\nPlease get in touch if you have any questions.');

  const message = lines.join('\n');

  const payload = {
    phone: phone,
    message: message
  };

  const options = {
    method: 'post',
    contentType: 'application/json',
    headers: {
      Authorization: 'Bearer YOUR_WATI_API_KEY'
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };

  const response = UrlFetchApp.fetch('https://app.wati.io/api/v1/sendSessionMessage', options);

  return response.getResponseCode() === 200;
}




