/**
 * Deduplicate label list for HTML rendering (optional; used by buildChecklistHtml_ if you wire it).
 */
function includedDocLabelsDistinct_(arr) {
  const seen = new Set();
  const out = [];
  for (const x of (arr || [])) {
    const k = String(x || '').trim();
    if (!k || seen.has(k)) continue;
    seen.add(k);
    out.push(k);
  }
  return out;
}

/**
