function _1codes_encodeAvailability(c) {
  var t = String(c || '').trim().toUpperCase();
  if (t === 'L') return 1;
  if (t === 'N') return 2;
  if (t === 'X') return 4;
  if (t === 'B') return 8;
  if (t === 'K') return 16;
  if (t === '?') return 32;
  return 0; // empty/unknown
}

function _1dates_neighbors(ymd) {
  function fmt(d) { return Utilities.formatDate(d, _1tz(), 'yyyy-MM-dd'); }
  var d = new Date(String(ymd) + 'T00:00:00');
  if (isNaN(d)) return { prev: '', next: '' };
  var p = new Date(d.getTime()); p.setDate(p.getDate() - 1);
  var n = new Date(d.getTime()); n.setDate(n.getDate() + 1);
  return { prev: fmt(p), next: fmt(n) };
}

function _1n2ld_violation(ehByCid, cid, ymd, shift) {
  if (String(shift || 'L') !== 'L') return false;
  var nb = _1dates_neighbors(ymd);
  var prev = nb.prev;
  if (!prev) return false;
  var rec = ehByCid && ehByCid[cid];
  if (!rec || !rec.worked) return false;
  return rec.worked[prev] === 'N';
}

function _1streak_windowCheck(planMap, ymd, shift) {
  planMap = planMap || {};
  var windowShift = String(shift || 'L');
  var d = new Date(ymd + 'T00:00:00');
  if (isNaN(d)) return { ok: true, newStreak: 1 };

  // Count backward
  var back = 0, fwd = 0;
  var cur = new Date(d.getTime());
  for (;;) {
    cur.setDate(cur.getDate() - 1);
    var y = Utilities.formatDate(cur, _1tz(), 'yyyy-MM-dd');
    if (planMap[y] === windowShift) back++; else break;
    if (back > 10) break; // guard
  }
  // Count forward
  cur = new Date(d.getTime());
  for (;;) {
    cur.setDate(cur.getDate() + 1);
    var y2 = Utilities.formatDate(cur, _1tz(), 'yyyy-MM-dd');
    if (planMap[y2] === windowShift) fwd++; else break;
    if (fwd > 10) break; // guard
  }

  var newStreak = back + 1 + fwd;
  // Hard cap aligned with your weights: avoid >6 hard; prefer <=5
  var ok = newStreak <= 6;
  return { ok: ok, newStreak: newStreak };
}



function _1match_summaryForUI(shortlist, cidToNameMap) {
