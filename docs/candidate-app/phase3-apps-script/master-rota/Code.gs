/**
 * Sends a draft tabular email listing all confirmed or historical shifts.
 *
 * @param {string}   fullName
 * @param {string}   email
 * @param {Array[]}  shifts        Rows from EmailHistory
 * @param {string}   shiftType     "future" or "historical"
 * @param {string}   fromDateStr   YYYY-MM-DD (only if historical)
 * @param {string}   toDateStr     YYYY-MM-DD (only if historical)
 */
function sendEmailForShiftsNew(
  fullName,
  email,
  shifts,
  shiftType,
  fromDateStr,
  toDateStr
) {
  const ss = SpreadsheetApp.getActive();
  const tz = ss.getSpreadsheetTimeZone();

  // Build each table row, formatting date as "19 May 2025"
  const rowsHtml = shifts.map(r => {
    // r[9] is the Notes column (J) in EmailHistory
    const [_, dateStr, shift, ref, , hosp, ward, job, , note] = r;
    const d         = parseDMY(dateStr);
    const dayName   = Utilities.formatDate(d, tz, "EEEE");
    const formatted = Utilities.formatDate(d, tz, "d MMMM yyyy");
    // If there's a note, prefix with "Non standard shift – "
    const displayShift = note
      ? `Non standard shift - ${note}`
      : shift;
    return `
      <tr>
        <td>${dayName}</td>
        <td>${formatted}</td>
        <td>${displayShift}</td>
        <td>${job}</td>
        <td>${hosp}</td>
        <td>${ward}</td>
        <td>${ref || ""}</td>
      </tr>`;
  }).join("");

  // Choose the intro line based on shiftType
  let introHtml;
  if (shiftType === "historical") {
    const fromD  = new Date(fromDateStr);
    const toD    = new Date(toDateStr);
    const fromF  = Utilities.formatDate(fromD, tz, "dd/MM/yyyy");
    const toF    = Utilities.formatDate(toD, tz, "dd/MM/yyyy");
    introHtml = `<p>These are your historical shifts from the period ${fromF} to ${toF}:</p>`;
  } else {
    introHtml = `<p>Here are your confirmed bookings:</p>`;
  }

  const firstName = fullName.split(" ")[1] || "";
  const subject = "Your Confirmed Bookings";
  const body = `
    <p>Hi ${firstName},</p>
    ${introHtml}
    <table border="1" cellpadding="6" style="border-collapse:collapse">
      <tr>
        <th>Day</th>
        <th>Date</th>
        <th>Shift</th>
        <th>Job</th>
        <th>Hospital</th>
        <th>Ward</th>
        <th>Ref</th>
      </tr>
      ${rowsHtml}
    </table>
    <p>— Sussex Bookings Team</p>
  `;

  // Send via the TSO webhook instead of MailApp
  postToDoPostSendEmail(
    email,
    subject,
    "",              // fallback text body
    { htmlBody: body }  // pass the HTML into options.htmlBody
  );
}

