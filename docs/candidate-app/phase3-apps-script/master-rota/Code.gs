// Return current bookings summary (EmailHistory) to a candidate via WhatsApp
function processCurrentBookingsRequest(phone){
  if (_isAiOptOut(phone)) return; // do not message opted-out candidates

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const av = ss.getSheetByName(SH_AVAIL); if (!av) return;

  const rowIdx = _findAvailRowByPhone(av, phone); if (rowIdx<0) return;
  const lastCol = av.getLastColumn();
  const dateHdrs = av.getRange(1,7,1,lastCol-6).getDisplayValues()[0];
  const vals = av.getRange(rowIdx,7,1,lastCol-6).getDisplayValues()[0];
  const bgs  = av.getRange(rowIdx,7,1,lastCol-6).getBackgrounds()[0];

  const tz = ss.getSpreadsheetTimeZone();
  const booked = [];
  for (let c=0;c<dateHdrs.length;c++){
    const v=(vals[c]||'').toUpperCase(); const bg=bgs[c];
    if (bg===COLOR_BOOKED && (v==='LD'||v==='N')){
      const d=_parseDDMMYYYY(dateHdrs[c]); const day=d?Utilities.formatDate(d,tz,'EEE d MMM'):dateHdrs[c];
      booked.push(`${day} (${v})`);
    }
  }
  const msg = booked.length
    ? `You’re currently booked for: ${booked.join(', ')}.`
    : `You have no booked shifts showing in the next ${S().WINDOW_DAYS} days.`;
  _sendOrSimulate(phone, msg, { forename:'there' });
}

