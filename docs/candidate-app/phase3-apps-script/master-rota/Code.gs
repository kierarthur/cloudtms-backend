function findPossibleDbsDoc_(docs) {
  if (!Array.isArray(docs)) return null;
  const hits = docs.filter(d => {
    const k = normalize(d?.type?.key);
    const n = normalize(d?.type?.name);
    return k.includes('dbs') || k.includes('disclosure') || n.includes('dbs') || n.includes('disclosure');
  });
  if (hits.length) return hits[0];
  return null;
}
function extractCertificateNumberFromDoc_(doc) {
