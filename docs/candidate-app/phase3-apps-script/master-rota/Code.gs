/**
 * Returns a 7-day gender summary of Day/Night shifts between startDateStr and endDateStr,
 * and logs detailed per-cell diagnostics to a "Logs" sheet for debugging date & shift normalization.
 *
 * @param {string} startDateStr — ISO date string for the window start (e.g. "2025-08-08")
 * @param {string} endDateStr   — ISO date string for the window end   (e.g. "2025-08-14")
 * @return {Object}  Map of “YYYY-MM-DD” → { Day: { male, female, vacant }, Night: { … } }
 */
/**
 * Returns a 7-day gender summary of Day/Night shifts between startDateStr and endDateStr,
 * and logs detailed per-cell diagnostics—including the raw output of getActiveRangeShifts—to a "Logs" sheet.
 *
 * @param {string} startDateStr — ISO date string for the window start (e.g. "2025-08-08")
 * @param {string} endDateStr   — ISO date string for the window end   (e.g. "2025-08-14")
 * @return {Object}  Map of “YYYY-MM-DD” → { Day: { male, female, vacant }, Night: { … } }
 */
/**
 * Returns a 7-day gender summary of Day/Night shifts between startDateStr and endDateStr,
 * scanning the entire rota sheet rather than just the active selection, and logs detailed diagnostics.
 *
 * @param {string} startDateStr — ISO date string for the window start (e.g. "2025-08-08")
 * @param {string} endDateStr   — ISO date string for the window end   (e.g. "2025-08-14")
 * @return {Object}  Map of “YYYY-MM-DD” → { Day: { male, female, vacant }, Night: { … } }
 */
/**
 * Returns a 7-day gender summary of Day/Night shifts between startDateStr and endDateStr,
 * scanning the entire rota sheet and logging diagnostics—including running counts per shift/gender.
 *
 * @param {string} startDateStr — ISO date string for the window start (e.g. "2025-08-08")
 * @param {string} endDateStr   — ISO date string for the window end   (e.g. "2025-08-14")
 * @return {Object}  Map of “YYYY-MM-DD” → { Day: { male, female, vacant }, Night: { … } }
 */
/**
 * Returns a 7-day gender summary of Day/Night shifts between startDateStr and endDateStr,
 * scanning the entire rota sheet and logging diagnostics—including explicit classification flags
 * and running totals per shift/gender.
 *
 * @param {string} startDateStr — ISO date string for the window start (e.g. "2025-08-08")
 * @param {string} endDateStr   — ISO date string for the window end   (e.g. "2025-08-14")
 * @return {Object}  Map of “YYYY-MM-DD” → { Day: { male, female, vacant }, Night: { … } }
 */
/**
 * Returns a 7-day gender summary of Day/Night shifts between startDateStr and endDateStr,
 * scanning the entire rota sheet and logging diagnostics—including explicit classification flags
 * and running totals per shift/gender in the Logs sheet.
 *
 * @param {string} startDateStr — ISO date string for the window start (e.g. "2025-08-08")
 * @param {string} endDateStr   — ISO date string for the window end   (e.g. "2025-08-14")
 * @return {Object}  Map of “YYYY-MM-DD” → { Day: { male, female, vacant }, Night: { … } }
 */
/**
 * Returns a 7-day gender summary of Day/Night shifts between startDateStr and endDateStr,
 * scanning the entire rota sheet and logging diagnostics—including classification flags
 * and running totals per shift/gender.
 *
 * @param {string} startDateStr — ISO date string for the window start (e.g. "2025-08-08")
 * @param {string} endDateStr   — ISO date string for the window end   (e.g. "2025-08-14")
 * @return {Object}  Map of “YYYY-MM-DD” → { Day: { male, female, vacant }, Night: { … } }
 */
/**
 * Returns a 7-day gender summary of Day/Night shifts between startDateStr and endDateStr,
 * scanning the entire rota sheet.
 *
 * @param {string} startDateStr — ISO date string for the window start (e.g. "2025-08-08")
 * @param {string} endDateStr   — ISO date string for the window end   (e.g. "2025-08-14")
 * @return {Object}  Map of “YYYY-MM-DD” → { Day: { male, female, vacant }, Night: { … } }
 */
function getGenderSummary(startDateStr, endDateStr) {
  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getActiveSheet();
  if (!isPatientSheetName(sheet.getName())) return {};

  const tz    = ss.getSpreadsheetTimeZone();
  const start = new Date(startDateStr);
  const end   = new Date(endDateStr);

  // scan entire rota area for shift cells
  const startRow = 5, startCol = 3;
  const lastRow  = sheet.getLastRow(), lastCol = sheet.getLastColumn();
  const values   = sheet.getRange(startRow, startCol, lastRow - startRow + 1, lastCol - startCol + 1).getValues();
  const notes    = sheet.getRange(startRow, startCol, lastRow - startRow + 1, lastCol - startCol + 1).getNotes();
  const header   = sheet.getRange(4, startCol, 1, lastCol - startCol + 1).getDisplayValues()[0];

  // collect every valid "name" cell
  const cells = [];
  for (let i = 0; i < values.length; i++) {
    const row = startRow + i;
    if ((row - startRow) % 2 !== 0) continue;
    for (let j = 0; j < values[0].length; j++) {
      const col   = startCol + j;
      const name  = String(values[i][j] || '').trim();
      const dateDV = sheet.getRange(row, 2).getDisplayValue();
      const note   = notes[i][j] || '';
      const shift  = note !== '' ? note : header[j];
      cells.push({ row, dateDV, shift, name });
    }
  }

  // build name→gender lookup (lower‐case keys)
  const genderMap = {};
  getCandidateList().forEach(c => {
    const full = String(c.fullName || '').trim().toLowerCase();
    genderMap[full] = (c.gender || '').toLowerCase();
  });

  // initialize summary buckets
  const summary = {};
  for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
    const key = Utilities.formatDate(d, tz, 'yyyy-MM-dd');
    summary[key] = { Day:{male:0,female:0,vacant:0}, Night:{male:0,female:0,vacant:0} };
  }

  // process each cell
  cells.forEach(c => {
    // parse the date
    let dateObj;
    try {
      dateObj = parseDateDDMMYYYY(c.dateDV);
    } catch (e) {
      dateObj = sheet.getRange(c.row, 2).getValue();
    }
    if (!(dateObj instanceof Date) || isNaN(dateObj)) return;

    const dateKey = Utilities.formatDate(dateObj, tz, 'yyyy-MM-dd');

    // determine shift type
    const rawShift = c.shift || '';
    const isDay    = /day/i.test(rawShift);
    const isNight  = /night/i.test(rawShift);
    const shiftType= isDay ? 'Day' : isNight ? 'Night' : null;
    if (!shiftType || !(dateKey in summary)) return;

    // determine gender/vacancy
    const nameRaw = String(c.name || '').trim();
    const mapped  = genderMap[nameRaw.toLowerCase()] || '';
    if (!nameRaw) {
      summary[dateKey][shiftType].vacant++;
    } else if (/^m(ale)?$/i.test(mapped)) {
      summary[dateKey][shiftType].male++;
    } else if (/^f(emale)?$/i.test(mapped)) {
      summary[dateKey][shiftType].female++;
    } else {
      summary[dateKey][shiftType].vacant++;
    }
  });

  return summary;
}

