/**
 * Proxy for GmailApp.sendEmail that posts to your doPost entrypoint.
 */
/**
 * Sends an email via the TSO webhook and surfaces any errors in a modal dialog.
 *
 * @param {string} recipient – The email address to send to.
 * @param {string} subject   – The email’s subject line.
 * @param {string} body      – The HTML (or plain-text) body of the email.
 * @param {object} options   – (Unused) left in signature for backwards compatibility.
 */
/**
 * Sends an email via the TSO webhook. In a non-UI context will throw on error.
 *
 * @param {string} recipient – The email address to send to.
 * @param {string} subject   – The email’s subject line.
 * @param {string} body      – The HTML (or plain-text) body of the email.
 * @param {object} options   – (Unused) left in signature for backwards compatibility.
 */
/**
 * Sends an email via the TSO webhook, picking up HTML bodies passed in via options.
 *
 * @param {string} recipient – The email address to send to.
 * @param {string} subject   – The email’s subject line.
 * @param {string} body      – The fallback plain-text body of the email.
 * @param {object} options   – You can pass:
 *                              { htmlBody: "<p>…</p>" } to send an HTML body,
 *                              or { textBody: "…" } to override the plain text.
 */
function postToDoPostSendEmail(recipient, subject, body, options) {
  // 1) Webhook URL
  const webhookUrl = PropertiesService.getScriptProperties().getProperty('TSO_WEBHOOK_MAP');
  if (!webhookUrl) throw new Error('TSO webhook is not configured.');

  // 2) Normalize inputs
  const opts = options || {};
  const toStr       = String(recipient || '').trim();
  const subjectStr  = String(subject || '').trim();

  // Decide bodies (Flow will do coalesce(htmlBody, body) on its side)
  const htmlBodyStr = (opts.htmlBody != null ? String(opts.htmlBody) : null);
  const textBodyStr = (opts.textBody != null ? String(opts.textBody) : null);

  // Fallback "body" (can be HTML or text; Flow will treat as HTML in the Outlook action)
  const actualBody =
    htmlBodyStr != null ? htmlBodyStr :
    textBodyStr != null ? textBodyStr :
    String(body || '');

  // 3) Build attachments in the *new* shape: attachmentsV2: [{ Name, ContentBytes }]
  let attachmentsV2 = [];

  // Prefer callers that already provide the new shape
  if (Array.isArray(opts.attachmentsV2)) {
    attachmentsV2 = opts.attachmentsV2
      .map(a => ({
        Name:        a && (a.Name || a.name || a.filename) ? String(a.Name || a.name || a.filename) : 'attachment',
        ContentBytes: a && a.ContentBytes ? String(a.ContentBytes)
                      : (a && a.contentBase64 ? String(a.contentBase64) : '')
      }))
      .filter(a => a.ContentBytes); // keep only valid items
  }
  // Back-compat: transform legacy { filename, mimeType, contentBase64 } to new shape
  else if (Array.isArray(opts.attachments)) {
    attachmentsV2 = opts.attachments
      .map(a => ({
        Name:         a && a.filename ? String(a.filename) : 'attachment',
        ContentBytes: a && a.contentBase64 ? String(a.contentBase64) : ''
      }))
      .filter(a => a.ContentBytes);
  }
  // If neither provided, attachmentsV2 stays as [] (works fine)

  // 4) Build payload for the new Flow trigger
  const payload = {
    to:        toStr,
    subject:   subjectStr,
    // Provide both htmlBody (preferred) and body (fallback) to keep Flow mapping simple
    htmlBody:  htmlBodyStr != null ? htmlBodyStr : (actualBody || ''),
    body:      textBodyStr != null ? textBodyStr : (actualBody || ''),
    attachmentsV2 // [] or populated [{ Name, ContentBytes }]
  };

  // Optional fields (only added if provided; Flow will ignore unless in its schema)
  if (opts.cc)      payload.cc      = opts.cc;
  if (opts.bcc)     payload.bcc     = opts.bcc;
  if (opts.replyTo) payload.replyTo = opts.replyTo;
  if (opts.metadata) payload.metadata = opts.metadata;

  if (!payload.to)      throw new Error('Recipient is required.');
  if (!payload.subject) throw new Error('Subject is required.');
  if (!payload.htmlBody && !payload.body) {
    throw new Error('Email body is required.');
  }

  // 5) POST to webhook
  try {
    const res = UrlFetchApp.fetch(webhookUrl, {
      method: 'post',
      contentType: 'application/json',
      payload: JSON.stringify(payload),
      muteHttpExceptions: true
    });

    const code = res.getResponseCode();
    const text = res.getContentText() || '';

    if (code < 200 || code >= 300) {
      throw new Error(`HTTP ${code}: ${text.substring(0, 1000)}`);
    }

    // Return structured response when possible
    try {
      return JSON.parse(text);
    } catch (_) {
      return { ok: true, status: code, body: text };
    }
  } catch (e) {
    throw new Error(`Error sending email: ${e.message}`);
  }
}


/**
 * sendEmailTso(payload)
 *
 * (This function remains unchanged from your original code,
 *  so that “Continue” still works exactly as it did.)
 */
function sendEmailTso(payload) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();

  // ────────────────────────── LOGGING HELPERS ──────────────────────────
  const FN = "sendEmailTso";
  const _t0 = Date.now();
  let _tLast = _t0;
  const _marks = []; // [ts, fn, checkpoint, elapsed_ms, delta_ms, info, json]

  function _mark(checkpoint, info, obj) {
    const now = Date.now();
    const elapsed = now - _t0;
    const delta = now - _tLast;
    _tLast = now;
    const ts = Utilities.formatDate(new Date(), tz, "yyyy-MM-dd HH:mm:ss");
    let json = "";
    try { if (obj !== undefined) json = JSON.stringify(obj).slice(0, 1000); } catch (e) { json = "<json-error>"; }
    _marks.push([ts, FN, String(checkpoint || ""), elapsed, delta, String(info || ""), json]);
  }

  function _flushLogsSafe() {
    try {
      const logName = "Logs";
      let logS = ss.getSheetByName(logName);
      if (!logS) {
        logS = ss.insertSheet(logName);
        logS.getRange(1, 1, 1, 7).setValues([[
          "Timestamp", "Function", "Checkpoint", "Elapsed_ms", "Delta_ms", "Info", "JSON"
        ]]);
      }
      if (_marks.length) {
        logS.insertRowsAfter(logS.getLastRow() || 1, _marks.length);
        logS.getRange(logS.getLastRow() - _marks.length + 1, 1, _marks.length, 7).setValues(_marks);
      }
    } catch (e) {
      // swallow logging errors
    }
  }
  // ───────────────────── END LOGGING HELPERS ─────────────────────

  _mark("start", "payload received", { keys: Object.keys(payload || {}) });

  // Load webhook URL from Script Properties
  let webhookUrl = "";
  try {
    webhookUrl = PropertiesService.getScriptProperties().getProperty('TSO_WEBHOOK_MAP');
  } catch (e) {
    _mark("prop_error", "Error reading Script Property TSO_WEBHOOK_MAP", { error: String(e) });
  }
  if (!webhookUrl) {
    _mark("no_webhook", "TSO_WEBHOOK_MAP missing/empty; abort");
    _flushLogsSafe();
    return { success: false };
  }
  _mark("webhook_ok", "Webhook URL present");

  function fmt(d) {
    return d instanceof Date
      ? Utilities.formatDate(d, tz, "dd/MM/yyyy")
      : ("" + d).split(" ")[0];
  }

  // 1) Parse all entries (new bookings, cancellations, reminders)
  let entries = payload && payload.entries;
  _mark("entries_init", "raw entries type", { type: typeof entries });
  if (typeof entries === 'string') {
    try { entries = JSON.parse(entries); _mark("entries_json_parsed", "entries parsed from JSON", { count: (entries || []).length }); }
    catch (e) { entries = []; _mark("entries_json_error", "Failed to parse entries JSON", { error: String(e) }); }
  }
  entries = Array.isArray(entries) ? entries : (entries ? [entries] : []);
  _mark("entries_normalized", "entries array normalized", { count: entries.length });

  // 2) Build HTML (prefer htmlBody per schema) and normalize tables
  let rawHtml = "";
  try {
    rawHtml =
      (payload && payload.htmlBody != null ? String(payload.htmlBody)
       : (payload && payload.body != null ? String(payload.body) : ""));
    _mark("raw_html_pre", "rawHtml gathered", { length: rawHtml.length });
  } catch (e) {
    _mark("raw_html_error", "Error extracting rawHtml", { error: String(e) });
    rawHtml = "";
  }

  let htmlBody = rawHtml;
  try {
    htmlBody = rawHtml.replace(
      /<table(\s*)>/gi,
      `<table$1 border="1" cellpadding="5" cellspacing="0" style="border-collapse:collapse; width:100%;">`
    );
    _mark("html_tables_normalized", "table tags normalized", { finalLength: htmlBody.length });
  } catch (e) {
    _mark("html_replace_error", "Error normalizing table tags", { error: String(e) });
  }

  // 3) Fire the webhook (send fields exactly per schema)
  let success = false;
  let respCode = 0;
  let respTextSnippet = "";
  try {
    const payloadObj = {
      to:            payload ? payload.to : "",
      subject:       payload ? payload.subject : "",
      htmlBody:      htmlBody,                         // prefer HTML here
      body:          (payload && payload.body) || "",  // include body if provided
      attachmentsV2: Array.isArray(payload && payload.attachmentsV2) ? payload.attachmentsV2 : undefined
    };
    const payloadStr = JSON.stringify(payloadObj);
    _mark("webhook_send_begin", "sending to webhook", { urlLen: webhookUrl.length, payloadLen: payloadStr.length });

    const resp = UrlFetchApp.fetch(webhookUrl, {
      method:             "post",
      contentType:        "application/json",
      muteHttpExceptions: true,
      payload:            payloadStr
    });

    respCode = resp.getResponseCode();
    try { respTextSnippet = String(resp.getContentText() || "").slice(0, 500); } catch (e) { respTextSnippet = "<no content>"; }
    success = respCode >= 200 && respCode < 300;
    _mark("webhook_send_end", success ? "webhook OK" : "webhook NOT OK", { code: respCode, bodySnippet: respTextSnippet });
  } catch (e) {
    _mark("webhook_exception", "Exception during UrlFetchApp.fetch", { error: String(e) });
  }

  if (!success) {
    _mark("abort_after_webhook", "Webhook failed; not proceeding to logs/borders", { respCode, respTextSnippet });
    _flushLogsSafe();
    return { success: false };
  }

  // 4) Update TSO_Log (BATCH WRITE): remove old rows based on sheetName/rowIndex/colIndex, then rewrite in one setValues
  try {
    const HEADER = [
      "Timestamp","Date","Shift","Hospital","Ward","Candidate","Notifier","WebhookResp","SheetName","Row","Col"
    ];

    let logS = ss.getSheetByName("TSO_Log");
    if (!logS) {
      logS = ss.insertSheet("TSO_Log").hideSheet();
      _mark("tso_log_created", "Created TSO_Log sheet");
    }

    // Pull existing data (if any)
    const hasData = logS.getLastRow() > 0 && logS.getLastColumn() >= HEADER.length;
    const allRows = hasData ? logS.getDataRange().getValues() : [];
    _mark("tso_log_loaded", "Loaded TSO_Log", { rows: allRows.length });

    // Body rows are everything after header (index 0)
    const bodyRows = allRows.length > 1 ? allRows.slice(1) : [];

    // Determine which existing rows to keep
    const keep = bodyRows.filter(row => {
      const sheetNm = row[8], rIdx = row[9], cIdx = row[10];
      return !entries.some(e =>
        sheetNm === (e.sheetName || "") &&
        rIdx    === (e.rowIndex || "") &&
        cIdx    === (e.colIndex || "")
      );
    });

    _mark("tso_log_keep_calc", "Calculated rows to keep", {
      keepCount: keep.length,
      dropCount: Math.max(0, bodyRows.length - keep.length)
    });

    // Build new rows for this run
    const me = Session.getActiveUser().getEmail().split("@")[0];
    const newRows = entries.map(e => ([
      new Date(),
      e.date,
      e.shiftLabel,
      e.hospital,
      e.ward,
      e.newCandidate || e.candidate,
      me,
      "OK",
      e.sheetName || "",
      e.rowIndex || "",
      e.colIndex || ""
    ]));

    // Compose final matrix: header + kept + new
    const out = [HEADER, ...keep, ...newRows];
    const rows = out.length;
    const cols = HEADER.length;

    // Clear and ensure size, then single write
    logS.clearContents();
    if (logS.getMaxRows() < rows) logS.insertRowsAfter(logS.getMaxRows(), rows - logS.getMaxRows());
    if (logS.getMaxColumns() < cols) logS.insertColumnsAfter(logS.getMaxColumns(), cols - logS.getMaxColumns());
    logS.getRange(1, 1, rows, cols).setValues(out);

    _mark("tso_log_rewrote_batch", "Rewrote TSO_Log via setValues", {
      rowsWritten: rows, newAdded: newRows.length, kept: keep.length
    });
  } catch (e) {
    _mark("tso_log_error", "Error updating TSO_Log (batch)", { error: String(e) });
  }

  // 5) After sending and logging, update each cell’s border based on TSO_Log match and neighbour logic
  try {
    updateCellBorders(entries);
    _mark("borders_updated", "updateCellBorders completed", { entries: entries.length });
  } catch (e) {
    _mark("borders_error", "updateCellBorders threw", { error: String(e) });
  }

  _mark("end", "return success:true");
  _flushLogsSafe();
  return { success: true };
}



/**
 * updateCellBorders(cells)
 *
 * For each entry in `cells`, paint a double‐lined bottom border of the top cell only:
 *  • Red double border if there is no perfect TSO_Log match (or no log at all).
 *  • Dark‐green double border if there is a perfect match.
 *  • No border at all if the top cell is empty AND there's no TSO_Log entry for that cell.
 *
 * `cells` is an array of objects: { sheetName: string, rowIndex: number, colIndex: number }
 */
/**
 * updateCellBorders(cells)
 *
 * For each entry in `cells`, paint or clear just the bottom border of the top cell:
 *  • If the cell is empty AND no TSO_Log entry exists → clear bottom border only (leave all other edges alone).
 *  • Otherwise, check the latest TSO_Log entry:
 *      – If there’s a perfect match → paint a double‐lined GREEN bottom border (leave others alone).
 *      – Else (no log or mismatch) → paint a double‐lined RED bottom border (leave others alone).
 */
function updateCellBorders(cells) {
  if (!cells || !cells.length) return;

  const ss   = SpreadsheetApp.getActiveSpreadsheet();
  const logS = ss.getSheetByName("TSO_Log");

  // 1) If TSO_Log doesn’t exist, every cell is "no perfect match" → red bottom only.
  if (!logS) {
    cells.forEach(c => {
      paintBottomBorder(ss, c.sheetName, c.rowIndex, c.colIndex, /*isGreen=*/ false);
    });
    return;
  }

  // 2) Build a map of the latest TSO_Log entries by "sheet|row|col".
  const allRows = logS.getDataRange().getValues().slice(1);
  const logMap = {};
  for (let i = 0; i < allRows.length; i++) {
    const r = allRows[i];
    const entry = {
      timestamp:  r[0],
      shiftLabel: (r[2] || "").toString().trim(),
      candidate:  (r[5] || "").toString().trim(),
      sheetName:  (r[8] || "").toString(),
      rowIndex:   Number(r[9]),
      colIndex:   Number(r[10])
    };
    const key = [entry.sheetName, entry.rowIndex, entry.colIndex].join("|");
    if (!logMap[key] || new Date(entry.timestamp) > new Date(logMap[key].timestamp)) {
      logMap[key] = entry;
    }
  }
  const getLastLog = (sheetName, rowIdx, colIdx) =>
    logMap[[sheetName, rowIdx, colIdx].join("|")] || null;

  // 3) Group cell descriptors per sheet to reduce repeated lookups.
  const bySheet = new Map();
  cells.forEach(c => {
    if (!bySheet.has(c.sheetName)) bySheet.set(c.sheetName, []);
    bySheet.get(c.sheetName).push(c);
  });

  // Default shift labels (kept identical to original logic)
  const defaultShifts = [
    "Night 1930-0800hrs",
    "Long Day 0730-2000hrs"
  ];

  // 4) Process per sheet (behavior identical to original function).
  for (const [sheetName, group] of bySheet.entries()) {
    const sheet = ss.getSheetByName(sheetName);
    if (!sheet) continue;

    group.forEach(c => {
      const rTop = c.rowIndex;
      const cCol = c.colIndex;

      const topCell = sheet.getRange(rTop, cCol);
      const valTop  = ("" + (topCell.getValue() || "")).trim();
      const noteTop = ("" + (topCell.getNote()  || "")).trim();

      const lastLog = getLastLog(sheetName, rTop, cCol);

      // 4a) If empty AND no log → clear bottom border only (others unchanged)
      if (valTop === "" && !lastLog) {
        sheet.getRange(rTop, cCol).setBorder(
          /* top */     null,
          /* left */    null,
          /* bottom */  false,
          /* right */   null,
          /* vertical*/ null,
          /* horiz */   null
        );
        return;
      }

      // 4b) Otherwise decide if it’s a “perfect match” (green) or not (red)
      let isPerfectMatch = false;
      if (lastLog) {
        const cellCand    = valTop.toLowerCase();
        const loggedCand  = lastLog.candidate.toLowerCase();
        const cellShift   = noteTop;
        const loggedShift = lastLog.shiftLabel;

        if (
          cellCand === loggedCand &&
          (cellShift === loggedShift || (cellShift === "" && defaultShifts.includes(loggedShift)))
        ) {
          isPerfectMatch = true;
        }
      }

      // 4c) Paint bottom border accordingly (delegates all styling to helper)
      paintBottomBorder(ss, sheetName, rTop, cCol, isPerfectMatch);
    });
  }
}




/**
 * paintBottomBorder(ss, sheetName, rowIndex, colIndex, isGreen)
 *
 * If isGreen=true  → clear bottom border (no border).
 * If isGreen=false → paint a double‐lined red bottom border.
 *
 * Passing `null` for top/left/right/vertical/horizontal ensures we do not alter those edges.
 */
function paintBottomBorder(ss, sheetName, rowIndex, colIndex, isGreen) {
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) return;

  const range = sheet.getRange(rowIndex, colIndex);

  if (isGreen) {
    // Clear bottom border only
    range.setBorder(
      /* top */    null,
      /* left */   null,
      /* bottom*/  false,
      /* right */  null,
      /* vertical*/ null,
      /* horiz */  null
    );
  } else {
    // Paint bottom border double‐lined red
    const color = "#FF0000";
    const style = SpreadsheetApp.BorderStyle.DOUBLE;

    range.setBorder(
      /* top */    null,
      /* left */   null,
      /* bottom*/  true,
      /* right */  null,
      /* vertical*/ null,
      /* horiz */  null,
      /* color */  color,
      /* style */  style
    );
  }
}
/**
 * updateTsoLogOnly(payload)
 *
 * Called by the new “Update TSO without Email” button.
 * It does everything that sendEmailTso would do _except_ send the webhook email.
 * In other words: it records all selected entries into TSO_Log and then updates borders.
 */
function updateTsoLogOnly(payload) {
  const ss   = SpreadsheetApp.getActiveSpreadsheet();
  const tz   = ss.getSpreadsheetTimeZone();

  // 1) Parse incoming arrays (newSlots, changed, reconfirm)
  let newSlots   = payload.newSlots;
  let changed    = payload.changed;
  let reconfirm  = payload.reconfirm;
  if (typeof newSlots   === 'string') newSlots   = JSON.parse(newSlots);
  if (typeof changed    === 'string') changed    = JSON.parse(changed);
  if (typeof reconfirm  === 'string') reconfirm  = JSON.parse(reconfirm);
  newSlots   = Array.isArray(newSlots)   ? newSlots   : (newSlots   ? [newSlots]   : []);
  changed    = Array.isArray(changed)    ? changed    : (changed    ? [changed]    : []);
  reconfirm  = Array.isArray(reconfirm)  ? reconfirm  : (reconfirm  ? [reconfirm]  : []);

  // Combine them into a single “entries” array (new bookings first, then changes, then reconfirm)
  const entries = newSlots.concat(changed, reconfirm);

  // 2) Update TSO_Log: remove any existing rows for these same sheetName/rowIndex/colIndex,
  //    then append new log rows for each entry — batched write (same behaviour, faster).
  const HEADER = [
    "Timestamp","Date","Shift","Hospital","Ward","Candidate","Notifier","WebhookResp","SheetName","Row","Col"
  ];

  let logS = ss.getSheetByName("TSO_Log");
  if (!logS) {
    logS = ss.insertSheet("TSO_Log").hideSheet();
    // Header will be written by the batch setValues below.
  }

  // Read existing rows (body = after header if present)
  const allRows = logS.getDataRange().getValues();
  const body    = allRows.length > 1 ? allRows.slice(1) : [];

  // Build fast delete set from incoming entries
  const keyOf = (e) => `${e.sheetName || ""}#${e.rowIndex || ""}#${e.colIndex || ""}`;
  const del   = new Set(entries.map(keyOf));

  // Keep only those rows not being replaced
  const kept = body.filter(row => !del.has(`${row[8]}#${row[9]}#${row[10]}`));

  // Materialise new rows for entries (preserve existing semantics)
  const me = (Session.getActiveUser().getEmail() || "").split("@")[0];
  const newRows = entries.map(e => [
    new Date(),
    e.date,
    e.shiftLabel,
    e.hospital,
    e.ward,
    e.newCandidate || e.candidate,
    me,
    "OK",
    e.sheetName || "",
    e.rowIndex || "",
    e.colIndex || ""
  ]);

  // Single clear + single setValues write (header + kept + new)
  const out = [HEADER, ...kept, ...newRows];
  logS.clearContents();
  logS.getRange(1, 1, out.length, HEADER.length).setValues(out);

  // 3) Finally, update each cell’s border based on TSO_Log match and neighbour logic
  updateCellBorders(entries);

  return { success: true };
}

