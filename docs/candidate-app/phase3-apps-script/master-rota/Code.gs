// ==== Entry point (keeps your existing 6–7am trigger) ====
function updateCredentiallyDocs() {
  var props = PropertiesService.getScriptProperties();
  var POST_PROP = 'POST_CDOCS_COMPLIANCE';
  var COMPLIANCE_TRIG_PROP = 'COMPLIANCE_TRIGGER_IDS';
  var manualStatusActive_ = function() {
    try {
      var s = getCredentiallyComplianceRunStatus();
      return !!(s && s.manual === true && s.active !== false);
    } catch (e) {
      return false;
    }
  };
  var deleteQueuedComplianceTriggers_ = function() {
    var ids = [];
    try { ids = JSON.parse(props.getProperty(COMPLIANCE_TRIG_PROP) || '[]') || []; } catch (e) { ids = []; }
    if (!ids.length) {
      props.deleteProperty(COMPLIANCE_TRIG_PROP);
      return;
    }
    var wanted = {};
    for (var i = 0; i < ids.length; i++) wanted[ids[i]] = true;
    var trigs = ScriptApp.getProjectTriggers();
    for (var j = 0; j < trigs.length; j++) {
      var trig = trigs[j];
      try {
        if (wanted[trig.getUniqueId()]) {
          ScriptApp.deleteTrigger(trig);
        }
      } catch (e) {}
    }
    props.deleteProperty(COMPLIANCE_TRIG_PROP);
  };
  var queueComplianceRefresh_ = function() {
    deleteQueuedComplianceTriggers_();
    var trig = ScriptApp.newTrigger('refreshComplianceCache').timeBased().after(60 * 1000).create();
    props.setProperty(COMPLIANCE_TRIG_PROP, JSON.stringify([trig.getUniqueId()]));
  };

  var lock = LockService.getScriptLock();
  if (!lock.tryLock(15000)) {
    scheduleNext_(loadRunState_(), CDOCS_DEFAULT_BACKOFF_MIN);
    return;
  }
  try {
    cleanupFiredTriggers_();

    var state = loadRunState_();
    var freshRun = !state || !state.runId || state.aborted === true;

    if (freshRun) {
      var live = SpreadsheetApp.getActive().getSheetByName(CDOCS_LIVE_SHEET_NAME);
      if (!live) throw new Error('Live sheet "' + CDOCS_LIVE_SHEET_NAME + '" not found.');
      var liveHeader = live.getRange(1, 1, 1, live.getLastColumn()).getValues()[0].map(String);

      var snapshot = snapshotCandidates_();
      if (typeof CREDENTIALLY_TEST !== 'undefined' && CREDENTIALLY_TEST && snapshot.length > 1) {
        snapshot = snapshot.slice(0, 1);
      }

      recreateStagingSheet_();

      state = {
        runId: Utilities.getUuid(),
        startedAt: new Date().toISOString(),
        nextIndex: 0,
        totalCandidates: snapshot.length,
        batchSize: CDOCS_BATCH_SIZE,
        alertSent: false,
        aborted: false,
        backoffMinutes: CDOCS_DEFAULT_BACKOFF_MIN,
        liveHeader: liveHeader,
        lastTriedIndex: 0,
        retriesForIndex: 0
      };
      saveRunState_(state);
      state._candidateSnapshot = snapshot;

      PropertiesService.getScriptProperties().deleteProperty(CDOCS_PROP_TRIGS);
    } else {
      state._candidateSnapshot = snapshotCandidates_();
      if (typeof CREDENTIALLY_TEST !== 'undefined' && CREDENTIALLY_TEST && state._candidateSnapshot.length > 1) {
        state._candidateSnapshot = state._candidateSnapshot.slice(0, 1);
      }
      if (state.totalCandidates > state._candidateSnapshot.length) {
        state._candidateSnapshot = state._candidateSnapshot.slice(0, state.totalCandidates);
      } else if (state.totalCandidates < state._candidateSnapshot.length) {
        state._candidateSnapshot = state._candidateSnapshot.slice(0, state.totalCandidates);
      }
    }

    if (manualStatusActive_()) {
      setCredentiallyComplianceRunStatus_({
        manual: true,
        active: true,
        stage: 'credentially_running',
        message: 'Refreshing Credentially cache',
        credentiallyTotalCandidates: state.totalCandidates,
        credentiallyNextIndex: state.nextIndex,
        error: ''
      });
    }

    if (state.lastTriedIndex === state.nextIndex) {
      state.retriesForIndex = (state.retriesForIndex || 0) + 1;
    } else {
      state.lastTriedIndex = state.nextIndex;
      state.retriesForIndex = 0;
    }
    saveRunState_(state);

    if (state.retriesForIndex >= 3) {
      try {
        if (typeof postToDoPostSendEmail === 'function') {
          postToDoPostSendEmail(ALERT_TO, FAIL_SUBJ, '', { htmlBody: FAIL_HTML, metadata: { source: 'updateCredentiallyDocs', nextIndex: state.nextIndex } });
        }
      } catch (_) {}
      props.deleteProperty(POST_PROP);
      if (manualStatusActive_()) {
        setCredentiallyComplianceRunStatus_({
          manual: true,
          active: false,
          stage: 'failed',
          message: 'Credentially refresh failed',
          credentiallyTotalCandidates: state.totalCandidates,
          credentiallyNextIndex: state.nextIndex,
          error: 'retries_exceeded'
        });
      }
      state.aborted = true;
      saveRunState_(state);
      deleteStagingSheet_();
      deleteTypesLogIfCreatedThisRun_(state);
      cleanupOutstandingTriggers_();
      logOutcome_('failure', 'retries_exceeded: index=' + state.nextIndex, state);
      resetRunState_();
      return;
    }

    scheduleNext_(state, CDOCS_DEFAULT_BACKOFF_MIN);

    if (state.aborted) {
      resetRunState_();
      return;
    }

    if (state.nextIndex < state.totalCandidates) {
      var moreWork = workerBatch_(state);
      if (state.aborted) {
        props.deleteProperty(POST_PROP);
        if (manualStatusActive_()) {
          setCredentiallyComplianceRunStatus_({
            manual: true,
            active: false,
            stage: 'failed',
            message: 'Credentially refresh failed',
            credentiallyTotalCandidates: state.totalCandidates,
            credentiallyNextIndex: state.nextIndex,
            error: 'invalid_token'
          });
        }
        deleteStagingSheet_();
        deleteTypesLogIfCreatedThisRun_(state);
        cleanupOutstandingTriggers_();
        logOutcome_('failure', 'invalid_token', state);
        resetRunState_();
        return;
      }

      state.lastTriedIndex = state.nextIndex;
      state.retriesForIndex = 0;
      saveRunState_(state);

      if (manualStatusActive_()) {
        setCredentiallyComplianceRunStatus_({
          manual: true,
          active: true,
          stage: 'credentially_running',
          message: 'Refreshing Credentially cache — processed ' + state.nextIndex + ' of ' + state.totalCandidates,
          credentiallyTotalCandidates: state.totalCandidates,
          credentiallyNextIndex: state.nextIndex,
          error: ''
        });
      }

      scheduleNext_(state, state.backoffMinutes);
      return;
    }

    if (manualStatusActive_()) {
      setCredentiallyComplianceRunStatus_({
        manual: true,
        active: true,
        stage: 'credentially_finishing',
        message: 'Finalising Credentially cache',
        credentiallyTotalCandidates: state.totalCandidates,
        credentiallyNextIndex: state.totalCandidates,
        error: ''
      });
    }

    buildAndSwap_(state);

    var shouldQueueCompliance = String(props.getProperty(POST_PROP) || '') === '1';
    if (shouldQueueCompliance) {
      props.deleteProperty(POST_PROP);
      queueComplianceRefresh_();
      if (manualStatusActive_()) {
        setCredentiallyComplianceRunStatus_({
          manual: true,
          active: true,
          stage: 'queued_compliance',
          message: 'Credentially complete — compliance refresh queued',
          credentiallyTotalCandidates: state.totalCandidates,
          credentiallyNextIndex: state.totalCandidates,
          error: ''
        });
      }
    } else if (manualStatusActive_()) {
      setCredentiallyComplianceRunStatus_({
        manual: true,
        active: false,
        stage: 'completed',
        message: 'Credentially refresh complete',
        credentiallyTotalCandidates: state.totalCandidates,
        credentiallyNextIndex: state.totalCandidates,
        error: ''
      });
    }

    deleteStagingSheet_();
    deleteTypesLogIfCreatedThisRun_(state);
    cleanupOutstandingTriggers_();
    logOutcome_('success', '', state);
    resetRunState_();
  } catch (err) {
    var st2 = safeLoadState_();
    if (st2) {
      st2.backoffMinutes = Math.min(CDOCS_MAX_BACKOFF_MIN, Math.max((st2.backoffMinutes || 1) + 1, 2));
      saveRunState_(st2);
      scheduleNext_(st2, st2.backoffMinutes);
      if (manualStatusActive_()) {
        setCredentiallyComplianceRunStatus_({
          manual: true,
          active: true,
          stage: 'credentially_running',
          message: 'Credentially refresh paused — retry scheduled',
          credentiallyTotalCandidates: st2.totalCandidates,
          credentiallyNextIndex: st2.nextIndex,
          error: ''
        });
      }
    } else {
      scheduleNext_(null, CDOCS_DEFAULT_BACKOFF_MIN);
    }
    console.error('updateCredentiallyDocs error:', err && err.stack ? err.stack : err);
  } finally {
    lock.releaseLock();
  }
}

// ===== Worker: process up to batchSize candidates, write SAFE JSON summary to staging (with UPSERT) =====
function workerBatch_(state) {
  var snapshot = state._candidateSnapshot; // [{surname, firstName, publicId}]
  var start = state.nextIndex;
  var end = Math.min(state.nextIndex + state.batchSize, state.totalCandidates);
  var nowIso = new Date().toISOString();

  var sh = SpreadsheetApp.getActive().getSheetByName(CDOCS_STAGING_SHEET_NAME);
  if (!sh) throw new Error('Staging sheet missing unexpectedly.');

  // Build a map of existing (runId, publicId) -> row index (1-based), keeping the latest ProcessedAt per publicId
  var idxMap = getStagingRowIndexMap_(state.runId, sh);

  var sawRateLimit = false;

  for (var i = start; i < end; i++) {
    var cand = snapshot[i];
    if (!cand || !cand.publicId) continue;

    var raw = fetchCredentially(cand.publicId); // your function
    var docsSummaryJson, errorFlag = false;

    if (raw && typeof raw === 'object' && !Array.isArray(raw) && 'errorCode' in raw) {
      var bodyText = String(raw.body || '');
      if (!state.alertSent && /invalid_token/i.test(bodyText)) {
        try {
          if (typeof postToDoPostSendEmail === 'function') {
            postToDoPostSendEmail(ALERT_TO, ALERT_SUBJ, '', {
              htmlBody: ALERT_HTML,
              metadata: { source: 'updateCredentiallyDocs', candidateId: cand.publicId }
            });
          }
        } catch (_) {}
        state.alertSent = true;
        state.aborted = true;
        saveRunState_(state);
        return false;
      }
      if (raw.errorCode === 429 || raw.errorCode === 503) {
        sawRateLimit = true;
      }
      // On error, store empty summary (not raw body)
      docsSummaryJson = JSON.stringify({ t: {}, u: [], fi: '' });
      errorFlag = true;
    } else {
      var docs = Array.isArray(raw) ? raw : [];
      // Summarize to keep staging cell under 50k chars
      docsSummaryJson = summarizeDocsForStaging_(docs, state.liveHeader);
    }

    // Optional cache (not used for build)
    try {
      if (typeof credentiallyCache !== 'undefined' && credentiallyCache) {
        // You may choose to cache raw docs or parsed summary; raw often large.
        credentiallyCache[cand.publicId] = null; // avoid ballooning memory
      }
    } catch (_) {}

    // UPSERT into staging based on (runId, publicId)
    upsertStagingRow_(sh, idxMap, state.runId, cand.publicId, cand.surname, cand.firstName, docsSummaryJson, !!errorFlag, nowIso);
  }

  // Update state indices
  state.nextIndex = end;
  // Adaptive backoff if any 429/503 this batch
  if (sawRateLimit) {
    state.backoffMinutes = Math.min(CDOCS_MAX_BACKOFF_MIN, Math.max(state.backoffMinutes + 1, 2));
  } else {
    state.backoffMinutes = CDOCS_DEFAULT_BACKOFF_MIN;
  }
  saveRunState_(state);
  return state.nextIndex < state.totalCandidates;
}

// Summarize Credentially docs array into a compact JSON string safe for a single cell (<50k chars).
// IMPORTANT for Mandatory: always include every name in MANDATORY_TYPES (and CV for issuer),
// regardless of liveHeader. Never trim mandatory entries in size-reduction branches.
// EXACT PARITY for Mandatory selection: record the FIRST matching doc per type (activeFile || files[0]);
// do NOT replace e/i with earlier values if another doc of same type appears later.
// - Include per-type: { y:1/0 (present), e:'expiryISO' (optional), i:'issuer (trimmed)' (optional) }.
// - Top-level 'fi' = first available issuer (trimmed) for name-match fallback.
// - 'u' = list of unknown (not-in-header) type names for logging only.
function summarizeDocsForStaging_(docs, liveHeader) {
  var allowed = {};
  try {
    if (Array.isArray(liveHeader)) {
      for (var i = 2; i < liveHeader.length; i++) allowed[liveHeader[i]] = true;
    }
  } catch (_) {}

  // Always include all mandatory type names
  try {
    if (typeof MANDATORY_TYPES !== 'undefined' && Array.isArray(MANDATORY_TYPES)) {
      for (var m = 0; m < MANDATORY_TYPES.length; m++) {
        allowed[MANDATORY_TYPES[m]] = true;
      }
    }
  } catch (_) {}

  // Also include CV so we can prefer its issuer for name matching (parity with old logic)
  allowed['CV'] = true;

  var summary = { t: {}, u: [], fi: '' };
  var unknownSet = Object.create(null);

  for (var k = 0; k < docs.length; k++) {
    var d = docs[k];
    if (!d || !d.type || !d.type.name) continue;
    var tn = String(d.type.name);
    var f = d.activeFile || (d.files && d.files.length ? d.files[0] : null);
    var exp = f && f.expiry ? String(f.expiry) : '';
    var iss = f && f.issuingPerson ? String(f.issuingPerson) : '';
    if (!summary.fi && iss) summary.fi = iss.slice(0, 200);

    if (allowed[tn]) {
      var cur = summary.t[tn];
      if (!cur) {
        // First occurrence wins (matches old docs.find(...) behaviour)
        summary.t[tn] = { y: 1, e: exp || '', i: iss ? iss.slice(0, 200) : '' };
      } else {
        // Do NOT overwrite e/i with earlier values; only ensure presence flag
        cur.y = 1;
      }
    } else {
      if (tn && !unknownSet[tn]) unknownSet[tn] = true;
    }
  }
  summary.u = Object.keys(unknownSet);

  var s = JSON.stringify(summary);
  if (s.length > 48000) {
    // Drop per-type issuers first (but keep y/e, esp. for mandatory)
    for (var name in summary.t) { if (summary.t[name] && summary.t[name].i) delete summary.t[name].i; }
    s = JSON.stringify(summary);
  }
  if (s.length > 48000) {
    // Drop unknown list
    summary.u = [];
    s = JSON.stringify(summary);
  }
  if (s.length > 48000) {
    // Extreme fallback: keep all MANDATORY_TYPES + LEFT_TYPES + "Mandatory Training" + "CV"
    var keep = Object.create(null);
    if (typeof LEFT_TYPES !== 'undefined' && Array.isArray(LEFT_TYPES)) {
      for (var i2 = 0; i2 < LEFT_TYPES.length; i2++) keep[LEFT_TYPES[i2]] = true;
    }
    if (typeof MANDATORY_TYPES !== 'undefined' && Array.isArray(MANDATORY_TYPES)) {
      for (var m2 = 0; m2 < MANDATORY_TYPES.length; m2++) keep[MANDATORY_TYPES[m2]] = true;
    }
    keep['Mandatory Training'] = true;
    keep['CV'] = true;

    var trimmed = {};
    for (var key in summary.t) if (keep[key]) trimmed[key] = summary.t[key];
    summary.t = trimmed;
    s = JSON.stringify(summary);
  }
  // Final guard: hard trim if needed (should be extremely rare with summary)
  if (s.length > 50000) s = s.slice(0, 49900);
  return s;
}

// ===== Build full 2D matrices from staging and swap into live (with BUILD-TIME DEDUPE) =====
function buildAndSwap_(state) {
  var ss = SpreadsheetApp.getActive();
  var live = ss.getSheetByName(CDOCS_LIVE_SHEET_NAME);
  if (!live) throw new Error('Live sheet "' + CDOCS_LIVE_SHEET_NAME + '" not found.');
  var header = state.liveHeader; // canonical, frozen at run start
  if (!header || !header.length) throw new Error('Missing frozen header in run state.');

  // --- NEW: capture previous live data so we can reuse rows on API error ---
  var prevRange = live.getDataRange();
  var prevValues  = prevRange.getValues();
  var prevFormats = prevRange.getNumberFormats();
  var prevColors  = prevRange.getFontColors();
  var prevNotes   = prevRange.getNotes();

  // Map "Surname|FirstName" -> row index in prev* arrays (0-based)
  var prevRowByKey = {};
  if (prevValues && prevValues.length > 1) { // at least header + 1 row
    for (var iPrev = 1; iPrev < prevValues.length; iPrev++) {
      var prevSurname = String(prevValues[iPrev][0] || '');
      var prevFirst   = String(prevValues[iPrev][1] || '');
      if (!prevSurname && !prevFirst) continue;
      var keyPrev = prevSurname + '|' + prevFirst;
      prevRowByKey[keyPrev] = iPrev;
    }
  }

  // Read all staging for this runId
  var st = ss.getSheetByName(CDOCS_STAGING_SHEET_NAME);
  if (!st) throw new Error('Staging sheet missing at build stage.');
  var data = st.getDataRange().getValues(); // includes header row

  // Collect rows matching runId
  var rows = [];
  for (var i = 1; i < data.length; i++) {
    if (data[i][0] === state.runId) rows.push(data[i]); // [runId, publicId, surname, firstName, jsonSummary, errorFlag, processedAt]
  }

  // ---------- BUILD-TIME DEDUPE ----------
  // Keep the most recent processedAt for each publicId (stable order of first appearance)
  rows = dedupeRowsByPublicId_(rows);

  // Build sets of detected doc type names (to warn about new/unknown vs live header)
  var detectedTypesSet = {};
  var reportedUnknownSet = {};
  for (var r = 0; r < rows.length; r++) {
    var sum;
    try { sum = JSON.parse(rows[r][4] || '{}'); } catch (e) { sum = {}; }
    if (sum && sum.t) {
      for (var n in sum.t) detectedTypesSet[n] = true;
    }
    if (sum && Array.isArray(sum.u)) {
      for (var u = 0; u < sum.u.length; u++) reportedUnknownSet[sum.u[u]] = true;
    }
  }
  var liveHeaderTypes = header.slice(2); // everything after Surname, First Name
  var knownSet = {};
  for (var h = 0; h < liveHeaderTypes.length; h++) knownSet[liveHeaderTypes[h]] = true;

  var unknownTypes = [];
  for (var t in detectedTypesSet) if (!knownSet[t]) unknownTypes.push(t);
  for (var ut in reportedUnknownSet) if (!knownSet[ut] && unknownTypes.indexOf(ut) === -1) unknownTypes.push(ut);
  if (unknownTypes.length) logUnknownTypes_(state.runId, unknownTypes);

  // Prepare matrices
  var totalRows = rows.length + 1; // header row + data rows
  var totalCols = header.length;

  var values = new Array(totalRows);
  var numberFormats = new Array(totalRows);
  var fontColors = new Array(totalRows);
  var notes = new Array(totalRows);

  // Header row values (we will re-apply minimal formatting later)
  values[0] = header.slice();
  numberFormats[0] = header.map(function(){ return '@'; });
  fontColors[0] = header.map(function(){ return 'black'; });
  notes[0] = header.map(function(){ return ''; });

  var now = new Date();

  function expiryToCell(expiryIso) {
    if (!expiryIso) return { value: null, fmt: '@', color: 'black', days: null };
    var expDate = new Date(expiryIso);
    var days = Math.floor((expDate - now) / 86400000);
    var color = (days < 0) ? 'red' : (days <= 30 ? 'orange' : 'black');
    return { value: expDate, fmt: 'dd/MM/yyyy', color: color, days: days };
  }

  // Index header columns for quick lookups
  var hdrIndex = {};
  for (var c = 0; c < header.length; c++) hdrIndex[header[c]] = c;

  // Helper: choose issuing person from summary
  function issuingFromSummary_(sum) {
    if (!sum) return '';
    if (sum.t && sum.t['CV'] && sum.t['CV'].i) return String(sum.t['CV'].i);
    if (sum.t) {
      for (var k in sum.t) {
        if (sum.t[k] && sum.t[k].i) return String(sum.t[k].i);
      }
    }
    return sum.fi ? String(sum.fi) : '';
  }

  // Process each candidate row
  for (var ri = 0; ri < rows.length; ri++) {
    var stRow = rows[ri];
    var surname   = stRow[2] || '';
    var firstName = stRow[3] || '';
    var errorFlag = !!stRow[5]; // column 6 in staging = ErrorFlag

    // Defaults for new computation path
    var out = new Array(totalCols);
    var fmts = new Array(totalCols);
    var cols = new Array(totalCols);
    var nts  = new Array(totalCols);
    for (var z = 0; z < totalCols; z++) {
      out[z]  = '';
      fmts[z] = '@';
      cols[z] = 'black';
      nts[z]  = '';
    }

    // --- NEW: if errorFlag is true and we have a previous live row, reuse it as-is ---
    if (errorFlag) {
      var key = String(surname) + '|' + String(firstName);
      var prevIdx = prevRowByKey[key];
      if (typeof prevIdx === 'number') {
        var prevValsRow  = prevValues[prevIdx]  || [];
        var prevFmtRow   = prevFormats[prevIdx] || [];
        var prevColRow   = prevColors[prevIdx]  || [];
        var prevNotesRow = prevNotes[prevIdx]   || [];

        // Copy previous row up to current header length
        values[ri + 1]        = prevValsRow.slice(0, totalCols);
        numberFormats[ri + 1] = prevFmtRow.slice(0, totalCols);
        fontColors[ri + 1]    = prevColRow.slice(0, totalCols);
        notes[ri + 1]         = prevNotesRow.slice(0, totalCols);

        // Skip recalculation for this candidate
        continue;
      }
      // If no previous row exists, fall through to normal logic (will end up "NO"/blank)
    }

    // Normal: build from summary
    var sum;
    try { sum = JSON.parse(stRow[4] || '{}'); } catch (e) { sum = {}; }
    var tmap = (sum && sum.t) ? sum.t : {};

    // Name mismatch logic
    var issuing = issuingFromSummary_(sum);
    var parts = String(issuing || '').trim().split(/\s+/);
    var credFirst = parts.shift() || '';
    var credSur = parts.join(' ') || '';
    var surnameColor = (surname !== credSur || firstName !== credFirst) ? 'red' : 'black';

    // Col A, B
    out[0] = surname;
    out[1] = firstName;
    fmts[0] = '@'; fmts[1] = '@';
    cols[0] = surnameColor; cols[1] = 'black';

    // LEFT_TYPES columns (only if present in header)
    if (typeof LEFT_TYPES !== 'undefined' && LEFT_TYPES && LEFT_TYPES.length) {
      for (var lt = 0; lt < LEFT_TYPES.length; lt++) {
        var colName = LEFT_TYPES[lt];
        var idx = hdrIndex[colName];
        if (idx == null) continue;
        var ent = tmap[colName];
        if (!ent || !ent.y) {
          out[idx] = 'NO'; fmts[idx] = '@'; cols[idx] = 'black';
        } else if (!ent.e) {
          out[idx] = 'YES'; fmts[idx] = '@'; cols[idx] = 'black';
        } else {
          var cell = expiryToCell(ent.e);
          out[idx] = cell.value; fmts[idx] = cell.fmt; cols[idx] = cell.color;
        }
      }
    }

    // Mandatory Training column
    var mandIdx = hdrIndex['Mandatory Training'];
    if (mandIdx != null) {
      var expiries = [];
      var missing = false;
      var noteLines = [];
      if (typeof MANDATORY_TYPES !== 'undefined' && MANDATORY_TYPES && MANDATORY_TYPES.length) {
        for (var mt = 0; mt < MANDATORY_TYPES.length; mt++) {
          var tn = MANDATORY_TYPES[mt];
          var ent2 = tmap[tn];
          var eIso = ent2 && ent2.e ? String(ent2.e) : '';
          if (!eIso) {
            missing = true;
            noteLines.push(tn + ': DATE MISSING');
          } else {
            var dt = new Date(eIso);
            expiries.push(dt);
            var fmt = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd/MM/yyyy');
            noteLines.push(tn + ': Expiry date ' + fmt);
          }
        }
      }
      if (missing) {
        out[mandIdx] = 'DATE MISSING'; fmts[mandIdx] = '@'; cols[mandIdx] = 'red';
      } else if (!expiries.length) {
        out[mandIdx] = ''; fmts[mandIdx] = '@'; cols[mandIdx] = 'black';
      } else {
        // choose oldest expired if any, else earliest upcoming
        var oldestExpired = null, earliestUpcoming = null;
        for (var e2 = 0; e2 < expiries.length; e2++) {
          var dt2 = expiries[e2];
          if (dt2 < now) {
            if (oldestExpired === null || dt2 < oldestExpired) oldestExpired = dt2;
          } else {
            if (earliestUpcoming === null || dt2 < earliestUpcoming) earliestUpcoming = dt2;
          }
        }
        var chosen = oldestExpired ? oldestExpired : earliestUpcoming;
        var days = Math.floor((chosen - now) / 86400000);
        out[mandIdx] = chosen; fmts[mandIdx] = 'dd/MM/yyyy';
        cols[mandIdx] = oldestExpired ? 'red' : (days <= 30 ? 'orange' : 'black');
      }
      nts[mandIdx] = noteLines.join('\n');
    }

    // Rest of header columns (only those present in header; ignore unknown types)
    for (var hc = 2; hc < header.length; hc++) {
      var typeName = header[hc];
      if (typeName === 'Mandatory Training') continue;
      if (typeof LEFT_TYPES !== 'undefined' && LEFT_TYPES.indexOf(typeName) >= 0) continue;
      var ent3 = tmap[typeName];
      if (!ent3 || !ent3.y) {
        out[hc] = 'NO'; fmts[hc] = '@'; cols[hc] = 'black';
      } else if (!ent3.e) {
        out[hc] = 'YES'; fmts[hc] = '@'; cols[hc] = 'black';
      } else {
        var cell2 = expiryToCell(ent3.e);
        out[hc] = cell2.value; fmts[hc] = cell2.fmt; cols[hc] = cell2.color;
      }
    }

    values[ri + 1] = out;
    numberFormats[ri + 1] = fmts;
    fontColors[ri + 1] = cols;
    notes[ri + 1] = nts;
  }

  // === FULL CLEAN of the live sheet (contents + notes) to avoid stale notes ===
  var usedPrev = live.getDataRange();
  try { usedPrev.clear(); } catch (_) { try { usedPrev.clearContent(); usedPrev.clearFormat(); } catch (__) {} }
  try { usedPrev.clearNote(); } catch (_) {}

  // === Write: values, then formats/colors/notes (data rows only) ===
  var newRowCount = values.length;
  var newColCount = header.length;
  var range = live.getRange(1, 1, newRowCount, newColCount);

  // Values (header + data)
  range.setValues(values);

  // Basic layout (simple, uniform)
  try {
    live.setRowHeights(1, newRowCount, CDOCS_ROW_HEIGHT_PX);
  } catch (_) {}
  try {
    live.setColumnWidths(1, newColCount, CDOCS_COL_WIDTH_PX);
  } catch (_) {}
  try {
    live.getRange(1, 1, newRowCount, newColCount).setFontSize(CDOCS_FONT_SIZE).setWrap(false);
  } catch (_) {}

  // Apply formats & colours ONLY to data rows
  var dataRows = newRowCount - 1;
  if (dataRows > 0) {
    var dataRange = live.getRange(2, 1, dataRows, newColCount);
    try { dataRange.setNumberFormats(numberFormats.slice(1)); } catch (_) {}
    try { dataRange.setFontColors(fontColors.slice(1)); } catch (_) {}

    // Notes only for Mandatory Training column (fresh notes after full clean)
    var mandIdx1 = hdrIndex['Mandatory Training']; // 0-based
    if (mandIdx1 != null) {
      var mandNotes = [];
      for (var rr = 1; rr < notes.length; rr++) mandNotes.push([notes[rr][mandIdx1]]);
      try { live.getRange(2, mandIdx1 + 1, dataRows, 1).setNotes(mandNotes); } catch (_) {}
    }
  }
}


// ======== Trigger mgmt (create one continuation; always replace) =========
function scheduleNext_(state, minutes) {
  // Schedule unless explicitly aborted; also schedule if state is null (fresh start after lock fail).
  if (state && state.aborted) return;

  // Delete any outstanding continuations we created before scheduling a new one
  var sp = PropertiesService.getScriptProperties();
  var idsJson = sp.getProperty(CDOCS_PROP_TRIGS);
  if (idsJson) {
    try {
      var ids = JSON.parse(idsJson);
      if (Array.isArray(ids)) {
        var triggers = ScriptApp.getProjectTriggers();
        for (var j = 0; j < ids.length; j++) {
          var targetId = ids[j];
          for (var i = 0; i < triggers.length; i++) {
            var t = triggers[i];
            try {
              if (t.getHandlerFunction && t.getHandlerFunction() === 'updateCredentiallyDocs') {
                if (typeof t.getUniqueId === 'function' && t.getUniqueId() === targetId) {
                  ScriptApp.deleteTrigger(t);
                }
              }
            } catch (_) {}
          }
        }
      }
    } catch (_) {}
    sp.deleteProperty(CDOCS_PROP_TRIGS);
  }

  var mins = Math.max(1, Math.min(minutes || CDOCS_DEFAULT_BACKOFF_MIN, CDOCS_MAX_BACKOFF_MIN));
  var trig = ScriptApp.newTrigger('updateCredentiallyDocs').timeBased().after(mins * 60 * 1000).create();
  var id = safeGetTriggerId_(trig);
  if (id) {
    sp.setProperty(CDOCS_PROP_TRIGS, JSON.stringify([id]));
  }
}

// Return the uniqueId of a trigger, if available
function safeGetTriggerId_(triggerObj) {
  try {
    if (triggerObj && typeof triggerObj.getUniqueId === 'function') {
      var uid = triggerObj.getUniqueId();
      if (uid) return uid;
    }
  } catch (_) {}
  // Fallback: best-effort — find the most recent trigger for our handler
  try {
    var triggers = ScriptApp.getProjectTriggers();
    var list = [];
    for (var i = 0; i < triggers.length; i++) {
      var t = triggers[i];
      if (t.getHandlerFunction && t.getHandlerFunction() === 'updateCredentiallyDocs') {
        if (typeof t.getUniqueId === 'function') {
          var id = t.getUniqueId();
          if (id) list.push(id);
        }
      }
    }
    return list.length ? list[list.length - 1] : null;
  } catch (_) {}
  return null;
}

// Called at the very start of a run: delete the one-shot trigger that just fired (by stored ID)
function cleanupFiredTriggers_() {
  var sp = PropertiesService.getScriptProperties();
  var idsJson = sp.getProperty(CDOCS_PROP_TRIGS);
  if (!idsJson) return;
  var ids;
  try { ids = JSON.parse(idsJson); } catch (_) { ids = []; }
  if (!Array.isArray(ids) || !ids.length) {
    sp.deleteProperty(CDOCS_PROP_TRIGS);
    return;
  }

  var triggers = ScriptApp.getProjectTriggers();
  var remaining = [];
  for (var j = 0; j < ids.length; j++) {
    var targetId = ids[j];
    var deleted = false;
    for (var i = 0; i < triggers.length; i++) {
      var t = triggers[i];
      try {
        if (t.getHandlerFunction && t.getHandlerFunction() === 'updateCredentiallyDocs') {
          if (typeof t.getUniqueId === 'function' && t.getUniqueId() === targetId) {
            ScriptApp.deleteTrigger(t);
            deleted = true;
            break;
          }
        }
      } catch (_) {}
    }
    if (!deleted) remaining.push(targetId); // might have expired already
  }
  if (remaining.length) {
    sp.setProperty(CDOCS_PROP_TRIGS, JSON.stringify(remaining));
  } else {
    sp.deleteProperty(CDOCS_PROP_TRIGS);
  }
}

// Called at end of run (success/abort): delete any outstanding continuation triggers by stored ID(s)
function cleanupOutstandingTriggers_() {
  cleanupFiredTriggers_(); // same logic; ensures nothing is left behind
}

