/*********************************************************************
 * dailyWhatsappReminders()
 *********************************************************************/
function dailyWhatsappReminders() {
  const ss  = SpreadsheetApp.getActiveSpreadsheet();
  const tz  = ss.getSpreadsheetTimeZone();
  const now = new Date();

  // 1) Gather rota data
  const sheets = ss.getSheets().filter(s => isPatientSheetName(s.getName()));

  if (!sheets.length) return;
  const occupantMap    = buildAllOccupants(sheets);
  const candidateMap   = getCandidateDataMap();

  // 2) Loop through each candidate
  Object.keys(occupantMap).forEach(key => {
    const shifts = occupantMap[key];
    if (!shifts || !shifts.length) return;

    const cData = candidateMap[key];
    if (!cData || cData.skipWhatsApp) return;
    const phone = cData.phone, fn = cData.firstName;
    if (!phone) return;

    // 3) Sort shifts by start‑time
    shifts.sort((a,b)=> {
      const da = parseShiftDateTime(a)||new Date(2099,0,1);
      const db = parseShiftDateTime(b)||new Date(2099,0,1);
      return da-db;
    });

    // 4) Find next‑two
    const { next, second } = getNextTwoShiftsForCandidate(shifts, now, tz);
    if (!next) return;

    // 5) Build session text
    const text = second
      ? buildFreeTextMessageTwoShifts(fn, buildNextShiftObject(next, next.when), buildSecondShift(second))
      : buildFreeTextMessageOneShift(fn, buildNextShiftObject(next, next.when));

    // 6) Try WATI session API first
    const enc      = encodeURIComponent(text);
    const sessUrl  = `https://eu-api.wati.io/601205/api/v1/sendSessionMessage/${phone}?messageText=${enc}`;
    const token = WATI_TOKEN;
    const optsSess = { method:"post", headers:{Authorization:token}, muteHttpExceptions:true };
    let sentOK = false;

    try {
      const resp = UrlFetchApp.fetch(sessUrl, optsSess);
      const code = resp.getResponseCode();
      const json = JSON.parse(resp.getContentText()||"{}");
      if (code>=200 && code<300 && json.ok===true && json.result==="success") {
        sentOK = true;
      }
    } catch(e) {
      Logger.log(`Session error for ${key}: ${e}`);
    }

    // 7) If session fails, fall back on template
    if (!sentOK) {
      Logger.log(`Falling back to template for ${key}`);
      const tplName = second ? "nextshiftreminder1" : "oneshiftreminder";
      const payload = {
        template_name: tplName,
        broadcast_name: buildBroadcastName(key, now),
        parameters: buildWatiParams(fn, buildNextShiftObject(next, next.when), second ? buildSecondShift(second) : null)
      };
      const tplUrl   = `https://eu-api.wati.io/601205/api/v2/sendTemplateMessage?whatsappNumber=${phone}`;
      const optsTpl  = {
        method: "post",
        contentType: "application/json",
        headers: { Authorization: token },
        payload: JSON.stringify(payload),
        muteHttpExceptions:true
      };
      try {
        const r2 = UrlFetchApp.fetch(tplUrl, optsTpl);
        Logger.log(`Template response for ${key}: ${r2.getContentText()}`);
      } catch(e2) {
        Logger.log(`Template error for ${key}: ${e2}`);
      }
    }
  });

  Logger.log("Finished dailyWhatsappReminders.");
}
