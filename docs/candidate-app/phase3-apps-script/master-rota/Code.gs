/**
 * Fetch all documents for an employee from Credentially.
 */
function fetchCredentially(employeeId) {
  var url  = 'https://app.credentially.io/mp/api/employees/' + employeeId + '/documents/details';
  var resp, code, text;

  try {
    resp = UrlFetchApp.fetch(url, {
      method: 'get',
      headers: {
        'Accept':        'application/json',
        'Authorization': 'Bearer ' + CREDENTIALLY_TOKEN
      },
      muteHttpExceptions: true
    });
    code = resp.getResponseCode();
    text = resp.getContentText();
  } catch (err) {
    // Fetch error (e.g. network or invalid URL)
    throw new Error("Credentially fetch failed: " + err);
  }

  if (code !== 200) {
    // Return an error object so caller can handle gracefully
    return {
      errorCode: code,
      body: text
    };
  }

  // Success: parse JSON payload
  return JSON.parse(text);
}

