/**
 * Orchestrates the creation of the PMVA Checklist document:
 * - Copy+convert DOCX template to Google Doc
 * - Replace placeholders (base map + PMVA fields)
 * - Insert <Passport Photo>
 * - (Optional) style and save
 * - Export back to DOCX
 * - Push DOCX blob into attachments
 *
 * @param {{firstName:string, surname:string, jobTitle?:string, fullName?:string}} person
 * @param {object} summary  // expects summary.pmva fields populated (issued, expiry, trainingProvider, certificateNumber)
 * @param {{publicId:string, ctx:object, docs?:Array, photoDoc?:object, attachments:Array<Blob>, includedDocLabels?:Array<string>, email?:string, dobIso?:string, dobHyphen?:string, gender?:string, dbsIssueDateIso?:string, dbsIssuedBy?:string}} opts
 * @returns {{ok:boolean, fileId?:string, name?:string}}
 */
function runPmvaChecklistDocumentFlowForPerson_(person, summary, opts) {
  const { publicId, ctx, photoDoc, attachments, headshotBlob, docs } = opts || {};
  const fullName = person?.fullName || `${person?.surname || ''} ${person?.firstName || ''}`.trim();

  // 1) Resolve template ID
  const templateDocxId = getPmvaChecklistTemplateDocxId_();
  if (!templateDocxId) {
    return { ok: false };
  }

  // 2) Copy/convert template to working Google Doc (reuse existing helper’s return shape)
  let copyRes = null;
  let workingDocId = '';
  try {
    copyRes = copyTemplateForCandidate_(templateDocxId, person.surname || '', person.firstName || '');
    workingDocId = (copyRes && copyRes.docId) ? copyRes.docId : '';
  } catch (e) {
    return { ok: false };
  }
  if (!workingDocId) {
    return { ok: false };
  }

  // 3) Build placeholder map: base (existing checklist map) + PMVA-specific
  let baseMap = {};
  try {
    baseMap = composeChecklistPlaceholders_(person, summary, {
      email: (opts && opts.email) || '',
      dobIso: (opts && opts.dobIso) || '',
      dobHyphen: (opts && opts.dobHyphen) || '',
      gender: (opts && opts.gender) || '',
      dbsIssueDateIso: (opts && opts.dbsIssueDateIso) || '',
      dbsIssuedBy: (opts && opts.dbsIssuedBy) || ''
    }) || {};
  } catch (e) {
    baseMap = {};
  }

  const pmvaMap = {
    '<PMVA Issue Date>': String(summary?.pmva?.issued || ''),
    '<PMVA Expiry Date>': String(summary?.pmva?.expiry || ''),
    '<PMVA Certificate Number>': String(summary?.pmva?.certificateNumber || ''),
    '<PMVA Training Provider>': String(summary?.pmva?.trainingProvider || '')
  };

  const placeholderMap = Object.assign({}, baseMap, pmvaMap);
  // Ensure <DATE TODAY> is present in the same format as elsewhere (DD/MM/YYYY)
  placeholderMap['<DATE TODAY>'] = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy');

  // 4) Replace placeholders in the working doc
  try {
    replaceTextPlaceholdersInDoc_(workingDocId, placeholderMap);
  } catch (e) {
    // continue; we still try to export whatever exists for auditing
  }

  // 5) Insert <Passport Photo> — reuse processed headshot if provided; otherwise mirror compliance flow
  try {
    let inserted = false;

    // 5a) Prefer the provided processed headshot (reuse)
    if (headshotBlob) {
      const ins = insertImageAtPlaceholder_(workingDocId, '<Passport Photo>', headshotBlob, 7);
      inserted = !!(ins && ins.inserted);
    }

    // 5b) If not inserted yet, mirror the compliance pipeline:
    if (!inserted) {
      const effectivePhotoDoc =
        photoDoc ||
        (Array.isArray(docs) ? selectPassportPhotoDoc_(docs) : null);

      if (effectivePhotoDoc && effectivePhotoDoc.activeFile && effectivePhotoDoc.activeFile.id) {
        const imgRes = getPassportPhotoImageForChecklist_(effectivePhotoDoc, person.fullName, { ...(ctx || {}), step: 'PMVA DOC IMAGE: acquire' });
        if (imgRes && imgRes.ok && imgRes.blob) {
          const svc = callHeadshotService_(imgRes.blob, { ...(ctx || {}), step: 'PMVA DOC IMAGE: service' });
          if (svc && svc.ok && svc.blob) {
            const ins2 = insertImageAtPlaceholder_(workingDocId, '<Passport Photo>', svc.blob, 7);
            inserted = !!(ins2 && ins2.inserted);
          }
          if (!inserted) {
            try {
              const fallback = centerCropToIdAspect_(imgRes.blob);
              const ins3 = insertImageAtPlaceholder_(workingDocId, '<Passport Photo>', fallback, 7);
              inserted = !!(ins3 && ins3.inserted);
            } catch (_) {
            }
          }
        }
      }
    }
  } catch (e) {
  }

  // 6) Optional doc styling to A4 (reuse existing helpers if present)
  try {
    const docForStyle = DocumentApp.openById(workingDocId);
    const body = docForStyle.getBody();
    const marginsPt = { top: 72, bottom: 72, left: 72, right: 72 };
    applyA4DocStyle_(body, 'PORTRAIT', marginsPt);

    const pageSizePt = { w: 595.28, h: 841.89 }; // A4 portrait in points
    updateCurrentSectionPageStyle_(workingDocId, pageSizePt, marginsPt);

    saveAndCloseWithVerify_(docForStyle, workingDocId, { expectedImages: 1 });
  } catch (e) {
  }

  // 7) Export back to DOCX and attach (do NOT export as PDF)
  const filenameBase = `New Agency Worker Restraint checklist 17th Oct 2023 - ${_safeFilenamePart(person.surname || '')} ${_safeFilenamePart(person.firstName || '')}`;
  try {
    const ex = exportChecklistViaHttp_(workingDocId, filenameBase); // { blob, name, mimeType }
    if (ex && ex.blob) {
      attachments && attachments.push(ex.blob);
    } else {
      return { ok: false };
    }
  } catch (e) {
    return { ok: false };
  }

  return { ok: true, fileId: workingDocId, name: filenameBase + '.docx' };
}





/**
 * Infer whether the candidate is on the DBS Update Service.
 * Returns true if we have any reliable signal (status string, last check timestamp,
 * or an update-service certificate number); false otherwise.
 */
function _inferHasUpdateService_(summary) {
  try {
    const s = summary && summary.dbs ? summary.dbs : {};
    const status = String(s.updateStatus || '').trim();
    const lastChecked = String(s.lastCheckDateTime || '').trim();
    const cert = String(s.updateCertificateNumber || '').trim();

    // Any of these being present implies the Update Service was queried.
    if (status) return true;
    if (lastChecked) return true;
    if (cert) return true;

    return false;
  } catch (_) {
    return false;
  }
}

/**
 * Compute the text for <DBS Conviction>.
 *
 * Priority order:
 * 1) Explicit override (summary._overrides.dbsConviction) if provided: 'YES'|'NO' (returned verbatim).
 * 2) If we have an Update Service status:
 *    - 'BLANK_NO_NEW_INFO' (case-insensitive) => 'NO'
 *    - anything else (including other positive statuses) => 'YES'
 * 3) Otherwise, fall back to summary.hasConviction (boolean):
 *    - true  => 'YES'
 *    - false => '' (blank, because not on update service and no override)
 */
function _computeDbsConvictionText_(summary) {
  try {
    const ov = (summary && summary._overrides) ? String(summary._overrides.dbsConviction || '').trim() : '';
    if (ov) return ov; // Respect manual override

    const status = String(summary && summary.dbs && summary.dbs.updateStatus || '').trim();
    if (status) {
      return (status.toUpperCase() === 'BLANK_NO_NEW_INFO') ? 'NO' : 'YES';
    }

    const hasConviction = !!(summary && summary.hasConviction);
    return hasConviction ? 'YES' : '';
  } catch (_) {
    return '';
  }
}



/**
 * Replace all <...> placeholders in a Google Doc with values from a map.
 * Returns { replacedCount }.
 */
function replaceTextPlaceholdersInDoc_(docId, placeholderMap) {
  // Open the document with retry/backoff to avoid eventual-consistency race conditions
  const maxAttempts = 6;
  let doc = null;
  let lastErr = null;
  let mime = '';

  try {
    const f = DriveApp.getFileById(docId);
    if (typeof f.getMimeType === 'function') mime = f.getMimeType();
  } catch (e) {
    // If Drive lookup fails, we'll still try to open via DocumentApp
    mime = '';
  }

  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    try {
      doc = DocumentApp.openById(docId);
      break;
    } catch (e) {
      lastErr = String((e && e.stack) || e);
      Utilities.sleep(500 * attempt);
    }
  }

  if (!doc) {
    throw new Error(
      `replaceTextPlaceholdersInDoc_: Document ${docId} is inaccessible after retries (mime=${mime}, lastErr=${lastErr}).`
    );
  }

  // Proceed with merge
  const body = doc.getBody();
  let replaced = 0;

  try {
    for (const [ph, value] of Object.entries(placeholderMap || {})) {
      if (typeof ph === 'string' && ph.toUpperCase() === '<PASSPORT PHOTO>') continue; // handled by image inserter

      // Escape special chars in findText
      const pattern = String(ph).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      let range;

      // Iterate until all instances are replaced
      while ((range = body.findText(pattern)) !== null) {
        const textEl = range.getElement().asText();
        const start = range.getStartOffset();
        const end = range.getEndOffsetInclusive();
        textEl.deleteText(start, end);
        textEl.insertText(start, String(value || ''));
        replaced++;
      }
    }

    doc.saveAndClose();
    return { replacedCount: replaced };
  } catch (e) {
    // Try to save/close gracefully in case of partial edits
    try { doc.saveAndClose(); } catch (_) {}
    throw e;
  }
}



