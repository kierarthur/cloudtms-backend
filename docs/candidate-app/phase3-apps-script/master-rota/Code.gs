  if (shiftType === "future") {
    startD = today0;
  } else {
    startD = new Date(fromDateStr);
    endD   = new Date(toDateStr);
  }

  keys.forEach(fullName => {
    const key = fullName.toLowerCase().trim();

    const parts = raw.filter(r => {
      const rowKey = String(r[0]||"").toLowerCase().trim();
      if (rowKey !== key) return false;

      // handle both real Dates and dd/MM/yyyy strings:
      const dateCell = r[1];
      let d;
      if (dateCell instanceof Date) {
