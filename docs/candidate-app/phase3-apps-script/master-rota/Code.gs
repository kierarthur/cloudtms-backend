    .addToUi();

  // ─── W H A T S A P P ──────────────────────────────────────────────────────
  ui.createMenu('Whatsapp')
    .addItem('New Admission', 'openTieredAdmissionDialog')
    .addToUi();

  // ─── W I Z A R D ──────────────────────────────────────────────────────────
  ui.createMenu('Wizard')
    .addItem('Open Wizard', 'openWizardSidebar')
    .addToUi();

  // ─── A V A I L A B I L I T Y   A I ────────────────────────────────────────
