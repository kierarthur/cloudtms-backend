function ensureEditStateInitialized_() {
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty(PKEY_EDIT_ENABLED) == null) {
    props.setProperty(PKEY_EDIT_ENABLED, 'true'); // default to editing allowed
    recordEditStateAudit_(true);
  }
}

