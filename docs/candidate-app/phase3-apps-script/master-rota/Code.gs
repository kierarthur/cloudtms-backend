function httpGetJson_(url, ctx) {
  const step = (ctx && ctx.step) || 'HTTP GET';
  try {
    const res = UrlFetchApp.fetch(url, {
      method: 'get',
      headers: _headersJson_(),
      muteHttpExceptions: true,
    });
    const code = res.getResponseCode();
    const text = res.getContentText();
    if (code >= 200 && code < 300) {
      let parsed = {};
      try { parsed = text ? JSON.parse(text) : {}; } catch (e) { /* non-json */ }
      logStep_(ctx.name, ctx.publicId, step, 'OK', url, { code });
      return { ok: true, code, data: parsed };
    } else {
      logStep_(ctx.name, ctx.publicId, step, 'HTTP_ERROR', `${url} -> ${code}`, text ? text.slice(0, 1000) : '');
      return { ok: false, code, error: `HTTP ${code}`, body: text };
    }
  } catch (e) {
    logStep_(ctx.name, ctx.publicId, step, 'EXCEPTION', url, String(e && e.stack || e));
    return { ok: false, code: 0, error: String(e) };
  }
}

function httpGetBlob_(url, filename, contentTypeGuess, ctx) {
  const step = (ctx && ctx.step) || 'HTTP BLOB';
  try {
    const res = UrlFetchApp.fetch(url, {
      method: 'get',
      headers: _headersBin_(),
      muteHttpExceptions: true,
    });
    const code = res.getResponseCode();
    if (code >= 200 && code < 300) {
      const blob = res.getBlob();
      if (contentTypeGuess) {
        try { blob.setContentType(contentTypeGuess); } catch (_) {}
      }
      if (filename) {
        try { blob.setName(filename); } catch (_) {}
      }
      let sizeBytes = 0;
      try { sizeBytes = (blob.getBytes() || []).length; } catch (_) { sizeBytes = 0; }
      const contentType = (blob.getContentType && blob.getContentType()) || '';

      logStep_(ctx && ctx.name, ctx && ctx.publicId, step, 'OK', `Downloaded ${filename || 'file'}`, {
        url,
        size: sizeBytes,
        contentType
      });

      return { ok: true, blob, sizeBytes, contentType };
    } else {
      logStep_(ctx && ctx.name, ctx && ctx.publicId, step, 'HTTP_ERROR', `${url} -> ${code}`, '');
      return { ok: false, error: `HTTP ${code}` };
    }
  } catch (e) {
    logStep_(ctx && ctx.name, ctx && ctx.publicId, step, 'EXCEPTION', url, String((e && e.stack) || e));
    return { ok: false, error: String(e) };
  }
}


