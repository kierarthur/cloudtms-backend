/** Build free-text session message */
function buildSessionText(fn, diffs) {
  const lines = diffs.map(d => {
    const prefix = d.comment === "NEW" ? "NEW:"
                 : d.comment === "CANCELLED" ? "CANCELLED:"
                 : `NEW REF NO. ${d.reference}:`;
    const SH = d.shift.startsWith("Night") ? "N" : "LD";
    const HB = d.hospital === "Worthing Hospital" ? "WTG" : "SRH";
    return `${prefix} ${d.date} – ${SH} – ${HB} – ${d.ward} – ${d.jobTitle}`;
  });
  return [
    `Hi ${fn}`,
    ``,
    `*Shift Update*`,
    ``,
    ...lines,
    ``,
    `Please contact us if you have any questions.`
  ].join("\n");
}

/** Attempt a session WA; return true if successful */
function trySendSessionWA(phone, text) {
  const url = `https://eu-api.wati.io/601205/api/v1/sendSessionMessage/${phone}` +
              `?messageText=${encodeURIComponent(text)}`;
  try {
    const r = UrlFetchApp.fetch(url, {
      method: "post",
      headers: { Authorization: WATI_TOKEN },
      muteHttpExceptions: true
    });
    const j = JSON.parse(r.getContentText() || "{}");
    return (r.getResponseCode() >= 200 && r.getResponseCode() < 300 && j.ok && j.result==="success");
  } catch(e) {
    return false;
  }
}

/** Paginate your diffs into batches of `n` lines */
function paginateDiffLines(diffs, n) {
  const all = diffs.map(d => buildSessionLine(d));
  const pages = [];
  for (let i=0; i<all.length; i+=n) {
    pages.push(all.slice(i, i+n));
  }
  return pages;
}

