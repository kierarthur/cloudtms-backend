 */
function getActiveRangeShifts(opts) {
  const withMeta = !!(opts && opts.withMeta);

  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getActiveSheet();
  const rl    = sheet.getActiveRangeList();
  const ranges= rl ? rl.getRanges() : (sheet.getActiveRange() ? [sheet.getActiveRange()] : []);
  const out   = [];
  if (!ranges.length) return out;

  // helper: convert col number to A1 letter(s) (1-based)
  function colToLetters(col) {
    let s = '';
    while (col > 0) { const m = (col - 1) % 26; s = String.fromCharCode(65 + m) + s; col = (col - 1) / 26 | 0; }
    return s;
  }

  const sheetId   = sheet.getSheetId();
  const sheetName = sheet.getName();

  ranges.forEach(rng => {
    const startRow = rng.getRow();
    const startCol = rng.getColumn();
    const numRows  = rng.getNumRows();
    const numCols  = rng.getNumColumns();

    const values  = rng.getValues();         // same as before
    const notes   = rng.getNotes();          // batched notes
    const datesB  = sheet.getRange(startRow, 2, numRows, 1).getDisplayValues();            // column B (dates)
    const hdrRow4 = sheet.getRange(4, startCol, 1, numCols).getDisplayValues()[0];         // row 4 (shift labels)

    for (let i = 0; i < numRows; i++) {
      const row = startRow + i;
      // only “name rows” and C→end
      if (row < 5 || ((row - 5) % 2) !== 0) continue;

      const date = datesB[i][0]; // display value for col B

      for (let j = 0; j < numCols; j++) {
        const col = startCol + j;
        if (col < 3) continue;

        const name  = String(values[i][j] || '').trim();
        if (name === '' && !withMeta) {
          // still include empty names (unchanged behaviour)? Yes — original pushed all.
          // We keep behaviour: push every candidate cell, even if name is empty.
        }

        // shift: prefer note, else header row 4
        const note  = notes[i][j] || '';
        const shift = note !== '' ? note : (hdrRow4[j] || '');

        // A1 without extra getRange
        const a1 = `${colToLetters(col)}${row}`;

        const base = { row, col, a1, date, shift, name };
        if (withMeta) {
          base.sheetId          = sheetId;
          base.sheetName        = sheetName;
          base.expectedOldValue = values[i][j]; // snapshot matches original getValue()
        }
        out.push(base);
      }
    }
  });

  return out;
}




