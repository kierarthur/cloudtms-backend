/**
 * Best-effort deletion of a Drive file by id.
 * Logs success, not-found, or error to the Logs sheet.
 */
function deleteFileIfExists_(fileId, label) {
  const tag = label || 'TEMP DELETE';
  if (!fileId) {
    return { ok: false, reason: 'NO_ID' };
  }
  try {
    const file = DriveApp.getFileById(fileId);
    const name = file.getName();
    const mime = (typeof file.getMimeType === 'function') ? file.getMimeType() : '';
    file.setTrashed(true); // safer than .delete() in shared environments
    return { ok: true, name, mime };
  } catch (e) {
    const err = String((e && e.stack) || e);
    // Not found vs other errors
    if (err.toLowerCase().includes('not found')) {
      return { ok: false, reason: 'NOT_FOUND' };
    }
    return { ok: false, reason: 'ERROR', error: err };
  }
}

/**
 * Clean up the temporary files created during the checklist flow.
 * - originalDocxId: the working .docx copy created from the master (safe to remove)
 * - convertedGoogleDocId: the Google Doc we edited (safe to remove after export)
 * - options.keepGoogleDoc: if true, keep the Google Doc for audit/troubleshooting
 *
 * Returns an object summarizing outcomes.
 */
function cleanupChecklistTempFiles_(originalDocxId, convertedGoogleDocId, options) {
  const keepGoogleDoc = !!(options && options.keepGoogleDoc);
  const result = { removedDocx: null, removedGDoc: null, keptGDoc: keepGoogleDoc };

  // Remove the working .docx copy
  result.removedDocx = deleteFileIfExists_(originalDocxId, 'CLEANUP: DOCX');

  // Optionally remove or keep the converted Google Doc
  if (convertedGoogleDocId) {
    if (keepGoogleDoc) {
      result.removedGDoc = { ok: false, reason: 'KEPT' };
    } else {
      result.removedGDoc = deleteFileIfExists_(convertedGoogleDocId, 'CLEANUP: GDOC');
    }
  } else {
    result.removedGDoc = { ok: false, reason: 'NO_ID' };
  }

  return result;
}

