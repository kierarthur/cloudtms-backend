    .replace(/\s+/g, ' ')
    .trim();
}

/**
 * Fetch the most recent DOB (as ISO and DD-MM-YYYY) and Email from the Questionnaires API.
 * Returns { dobIso, dobHyphen, email } — empty strings if not found.
 */
function fetchDobAndEmailFromQuestionnaires_(employeeId, ctx) {
  const out = { dobIso: '', dobHyphen: '', email: '' };
  try {
    const res = httpGetJson_(
      `${API_BASE}/v1/employees/${employeeId}/questionnaires`,
      { ...ctx, step: 'DOB/Email: questionnaires GET' }
    );
    if (!res.ok || !Array.isArray(res.data)) {
      return out;
    }

    // Flatten answers with completion timestamp, then pick latest for each field
    const answers = [];
    for (const q of res.data) {
      const completed = q?.completed || '';
      if (Array.isArray(q?.answers)) {
        for (const a of q.answers) {
          answers.push({
            id: a?.id || 0,
            question: String(a?.question || ''),
            answer: a?.answer || '',
            completed
          });
        }
      }
    }

    const byMostRecent = (a, b) => {
      const ta = new Date(a.completed || 0).getTime();
      const tb = new Date(b.completed || 0).getTime();
      if (tb !== ta) return tb - ta;
      return (b.id || 0) - (a.id || 0);
    };

    // DOB
    const dobHit = answers
      .filter(it => it.question.toLowerCase().includes('date of birth'))
      .sort(byMostRecent)[0];

    if (dobHit && dobHit.answer) {
      const raw = String(dobHit.answer).trim().replace(/^"|"$/g, '');
      out.dobIso = raw; // usually YYYY-MM-DD
      out.dobHyphen = formatDobHyphen_(raw); // DD-MM-YYYY if ISO-like; graceful fallback otherwise
    }

    // Email
    const emailHit = answers
      .filter(it => it.question.toLowerCase().includes('email address'))
      .sort(byMostRecent)[0];

    if (emailHit && emailHit.answer) {
      out.email = String(emailHit.answer).trim().replace(/^"|"$/g, '');
    }

    return out;
  } catch (e) {
    return out;
  }
}

/**
 * Prefer the exact 'passport_style_photo' type; otherwise a tolerant name match.
 * Returns the matching document object or null.
 */
function selectPassportPhotoDoc_(docs) {
  if (!Array.isArray(docs)) return null;
  const exact = docs.find(d => String(d?.type?.key || '').toLowerCase() === 'passport_style_photo');
  if (exact) return exact;

  // Fallback on name
  const byName = docs.find(d => {
    const name = String(d?.type?.name || '').toLowerCase();
    return name.includes('passport') && name.includes('photo');
  });
  return byName || null;
}

/**
 * Download the active file of a document as a Blob WITHOUT adding it to attachments.
 * Returns { ok:boolean, blob?:Blob }.
 */
function downloadDocFileBlob_(doc, label, personName, ctx) {
  if (!doc || !doc.activeFile || !doc.activeFile.id) {
    return { ok: false };
  }
  const res = downloadActiveFile_(doc, label, personName, { ...ctx, step: `Files API (blob only): ${label}` });
  if (!res || !res.ok || !res.blob) {
