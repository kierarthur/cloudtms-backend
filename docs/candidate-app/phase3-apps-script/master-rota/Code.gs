function sendShiftUpdatesNew(keys, method, shiftType, fromDateStr, toDateStr) {
  const ss     = SpreadsheetApp.getActive();
  const histS  = ss.getSheetByName("EmailHistory");
  const raw    = histS.getDataRange().getValues().slice(1);
  const tz     = ss.getSpreadsheetTimeZone();
  const today  = new Date();
  const today0 = new Date(today.getFullYear(), today.getMonth(), today.getDate());

  // build bounds
  let startD = new Date(0), endD = new Date(8640000000000000);
  if (shiftType === "future") {
    startD = today0;
  } else {
    startD = new Date(fromDateStr);
    endD   = new Date(toDateStr);
  }

  keys.forEach(fullName => {
    const key = fullName.toLowerCase().trim();
    const parts = [];

    raw.forEach(r => {
      // handle both Date objects and strings in col B
      let d, dateRaw = r[1];
      if (dateRaw instanceof Date) {
        d = new Date(dateRaw.getFullYear(), dateRaw.getMonth(), dateRaw.getDate());
      } else {
        const [dd, mm, yy] = String(dateRaw||"").split("/").map(Number);
        d = new Date(yy, mm - 1, dd);
      }
      const dateStr = Utilities.formatDate(d, tz, "dd/MM/yyyy");
      const rowKey  = String(r[0]||"").toLowerCase().trim();
      const inWindow= (d >= startD && d <= endD);
      const isMatch = rowKey === key && inWindow;

      if (isMatch) parts.push(r);
    });

    if (!parts.length) return;

    // sort by actual date
    parts.sort((a,b) => {
      const da = (a[1] instanceof Date) ? a[1].getTime() : parseDMY(a[1]).getTime();
      const db = (b[1] instanceof Date) ? b[1].getTime() : parseDMY(b[1]).getTime();
      return da - db;
    });

    // EMAIL
    if (method === "email" || method === "both") {
      const email = lookupEmail(fullName);
      if (email) sendEmailForShiftsNew(fullName, email, parts);
    }

    // WHATSAPP
    if (method === "whatsapp" || method === "both") {
      const mobile = lookupMobile(fullName);
      if (mobile) sendWhatsAppForShiftsNew(fullName, mobile, parts);
    }
  });
}

/**
 * Turn a dd/MM/yyyy string *or* a Date object into a Date (with time zeroed out).
 */
function parseDMY(input) {
  // If it’s already a Date, just normalize to midnight and return
  if (input instanceof Date) {
    return new Date(input.getFullYear(), input.getMonth(), input.getDate());
  }
  // Otherwise treat it as a string “dd/MM/yyyy”
  const s = String(input || "");
  const [d, m, y] = s.split("/").map(Number);
  return new Date(y, m - 1, d);
}


