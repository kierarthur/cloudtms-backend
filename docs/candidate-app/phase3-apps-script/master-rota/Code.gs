/**
 * Write candidateName into each of the given cells (a1+k)
 */
/**
 * Inserts a candidate into each of the selected cells,
 * fires handleEdit on each one, then optionally opens
 * the WhatsApp notify dialog.
 *
 * @param {{a1:string}[]} cells         Array of objects with an `a1` property
 * @param {string}        candidateName The full candidate name to insert
 * @param {boolean}       notifyNow     Whether to immediately open the WhatsApp dialog
 */
/**
 * Inserts a candidate into each selected cell, triggers the normal onEdit logic
 * (including conflict checks & coloring), then returns whether the wizard’s
 * “auto-prompt” toggle is enabled so the client can open the notify window.
 *
 * @param {{a1:string}[]} cells
 * @param {string} candidateName
 * @return {boolean} true if auto-prompt is on
 */

/**
 * Inserts a candidate into each of the selected cells,
 * with a “wizardBook” option to bypass full onEdit handling.
 *
 * @param {{a1:string, date?:string, shift?:string}[]} cells
 * @param {string} candidateName
 * @param {{wizardBook?:boolean}} [options]
 * @return {boolean} True if auto-prompt is enabled
 */
function insertSelectedCandidateToCells(cells, candidateName, options) {
  options = options || {};

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();

  // Collections
  const events = [];
  const borderDescriptors = [];
  const bandIndex = new Map();       // bandKey -> { sheetId, sheetName, bandStartRow, _colSet:Set<number> }
  const rangesBySheetId = new Map(); // sheetKey -> { sheet, a1s: [] }

  // Lock
  const lock = LockService.getScriptLock();
  try { lock.tryLock(20000); } catch (_) {}

  // 1) Stage all changes
  try {
    cells.forEach(c => {
      const sh =
        (c.sheetId && ss.getSheetById(c.sheetId)) ||
        (c.sheetName && ss.getSheetByName(c.sheetName)) ||
        ss.getActiveSheet();

      if (!sh) return;

      const rng = c.a1 ? sh.getRange(c.a1) : sh.getRange(c.row, c.col);
      const old = rng.getValue();

      if (Object.prototype.hasOwnProperty.call(c, 'expectedOldValue')) {
        const expected  = c.expectedOldValue;
        const unchanged = (expected === '' ? (old === '' || old === null) : old === expected);
        if (!unchanged) return;
      }

      const sheetKey = String(sh.getSheetId ? sh.getSheetId() : sh.getName());
      if (!rangesBySheetId.has(sheetKey)) rangesBySheetId.set(sheetKey, { sheet: sh, a1s: [] });
      rangesBySheetId.get(sheetKey).a1s.push(rng.getA1Notation());

      events.push({ range: rng, oldValue: old, value: candidateName });

      const row = c.row || rng.getRow();
      const col = c.col || rng.getColumn();
      borderDescriptors.push({ sheetName: sh.getName(), rowIndex: row, colIndex: col });

      const bandStartRow = (row % 2 === 0) ? (row - 1) : row;
      const bandKey = (sh.getSheetId ? String(sh.getSheetId()) : sh.getName()) + '|' + bandStartRow;

      let tgt = bandIndex.get(bandKey);
      if (!tgt) {
        tgt = { sheetId: sh.getSheetId ? sh.getSheetId() : undefined, sheetName: sh.getName(), bandStartRow, _colSet: new Set() };
        bandIndex.set(bandKey, tgt);
      }
      tgt._colSet.add(col);
    });
  } catch (e) {
    try { lock.releaseLock(); } catch (_) {}
    return false;
  }

  // 2) Perform batched writes per sheet
  try {
    for (const { sheet, a1s } of rangesBySheetId.values()) {
      if (a1s.length) {
        sheet.getRangeList(a1s).setValue(candidateName);
      }
    }
  } catch (e) {
    try { lock.releaseLock(); } catch (_) {}
    return false;
  }

  // Ensure values are committed before repaint reads/paints
  SpreadsheetApp.flush();

  // 3) Follow-on logic (handleEdit vs wizard)
  try {
    if (!options.wizardBook) {
      events.forEach(e => { try { handleEdit(e); } catch (_) {} });
    } else {
      try { logChanges(events); } catch (_) {}
    }
  } catch (_) {}

  // 4) Targeted repaint
  let repaintTargets = [];
  try {
    for (const tgt of bandIndex.values()) {
      repaintTargets.push({
        sheetId: tgt.sheetId,
        sheetName: tgt.sheetName,
        bandStartRow: tgt.bandStartRow,
        cols: Array.from(tgt._colSet)
      });
    }

    // Clear cancellation hints for these exact cells (best-effort)
    try {
      if (repaintTargets.length && typeof removeCancellationHintForCell === 'function') {
        repaintTargets.forEach(t => (t.cols || []).forEach(c => {
          try { removeCancellationHintForCell(t.sheetId || t.sheetName, t.bandStartRow, Number(c)); } catch (_) {}
        }));
      }
    } catch (_) {}

    if (repaintTargets.length) {
      refreshAllPatientSheetColors(false, repaintTargets);
    } else {
      refreshAllPatientSheetColors(false);
    }
  } catch (_) {
    // swallow errors
  } finally {
    try { lock.releaseLock(); } catch (_) {}
  }

  // 5) Borders
  try {
    if (borderDescriptors.length) {
      updateCellBorders(borderDescriptors);
    }
  } catch (_) {}

  // FINAL push so values + colours + borders are visible to the client tab
  SpreadsheetApp.flush();

  // Outcome summary
  return isAutoPromptEnabled();
}



/**
 * Clears (cancels) each of the selected cells,
 * fires handleEdit on each one, then flushes and opens the Outstanding Updates dialog.
 *
 * @param {Array<{a1:string}>} cells  Array of objects with an `a1` property, e.g. [{ a1: "D7" }, …]
 */
function cancelSelectedShifts(cells) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  // Optional: reduce race conditions if multiple users act at once
  const lock = LockService.getScriptLock();
  try { lock.tryLock(20000); } catch (e) {}

  // Helpers
  const colToA1 = (col) => {
    let s = "";
    while (col > 0) {
      const m = (col - 1) % 26;
      s = String.fromCharCode(65 + m) + s;
      col = (col - m - 1) / 26;
    }
    return s;
  };

  // We’ll collect per-sheet: A1s to clear in one call, plus
  // synthetic events (for logging), border updates, and band targets to repaint.
  const perSheetA1s = new Map(); // key: sheet object, value: Set<string A1>
  const fakeEvents = [];
  const borderDescriptors = [];
  const bandTargets = [];

  // map bandKey -> target object so we can merge multiple column hits per band
  const bandIndex = new Map();

  // 1) Inspect & stage all requested clears
  cells.forEach(c => {
    const sh =
      (c.sheetId && ss.getSheetById(c.sheetId)) ||
      (c.sheetName && ss.getSheetByName(c.sheetName)) ||
      ss.getActiveSheet();
    if (!sh) return;

    const rng = c.a1 ? sh.getRange(c.a1) : sh.getRange(c.row, c.col);
    const oldVal = rng.getValue();

    if (Object.prototype.hasOwnProperty.call(c, 'expectedOldValue')) {
      const expected = c.expectedOldValue;
      const unchanged = (expected === '' ? (oldVal === '' || oldVal === null) : oldVal === expected);
      if (!unchanged) return;
    }

    const a1 = c.a1 || (colToA1(c.col || rng.getColumn()) + (c.row || rng.getRow()));
    if (!perSheetA1s.has(sh)) perSheetA1s.set(sh, new Set());
    perSheetA1s.get(sh).add(a1);

    // synthetic on-edit event parity
    fakeEvents.push({ range: rng, oldValue: oldVal, value: '' });

    const row = c.row || rng.getRow();
    const col = c.col || rng.getColumn();
    borderDescriptors.push({ sheetName: sh.getName(), rowIndex: row, colIndex: col });

    const bandStartRow = (row % 2 === 0) ? (row - 1) : row; // normalize to NAME row (1-based)
    const bandKey = (sh.getSheetId ? sh.getSheetId() : sh.getName()) + '|' + bandStartRow;

    let tgt = bandIndex.get(bandKey);
    if (!tgt) {
      tgt = {
        sheetId: sh.getSheetId ? sh.getSheetId() : undefined,
        sheetName: sh.getName(),
        bandStartRow: bandStartRow,
        _colSet: new Set()
      };
      bandIndex.set(bandKey, tgt);
      bandTargets.push(tgt);
    }
    tgt._colSet.add(col);

    // best-effort cancellation hint
    try {
      if (typeof addCancellationHint === 'function') {
        const sid = sh.getSheetId ? sh.getSheetId() : sh.getName();
        addCancellationHint(sid, bandStartRow, col, String(oldVal || ''));
      }
    } catch (_) {}
  });

  // Flatten internal _colSet -> cols[] for each target
  bandTargets.forEach(t => {
    if (t._colSet) {
      t.cols = Array.from(t._colSet);
      delete t._colSet;
    }
  });

  try {
    // 2) Batch clear per sheet in ONE call each
    perSheetA1s.forEach((a1Set, sh) => {
      if (!a1Set.size) return;
      try {
        sh.getRangeList(Array.from(a1Set)).clearContent();
      } catch (_) {
        // skip sheet on error; continue
      }
    });

    // 3) Optional: keep logging parity if you use it elsewhere
    try {
      fakeEvents.forEach(ev => logChanges(ev));
    } catch (_) {}

    // 4) Flush cleared values so the refresher reads the blanks
    SpreadsheetApp.flush();

    // 5) Targeted repaint (allowVacantClear=true so blanks turn white)
    if (bandTargets.length) {
      refreshAllPatientSheetColors(true, bandTargets);
    } else {
      refreshAllPatientSheetColors(true);
    }

    // 5b) Safety flush to ensure repaint is committed before we proceed/return
    SpreadsheetApp.flush();

    // 6) Update borders (optional cosmetic step)
    if (borderDescriptors.length) {
      updateCellBorders(borderDescriptors);
    }

    // 6b) Final flush so border changes are visible before return
    SpreadsheetApp.flush();

  } finally {
    try { lock.releaseLock(); } catch (_) {}
  }
}






