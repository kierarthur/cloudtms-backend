function getCurrentRotaCandidates() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("EmailHistory");
  const currentSheet = ss.getActiveSheet();

  // read hospital/ward from B1
  const hospitalAndWard = currentSheet.getRange("B1").getValue();
  const [hospital, ward] = hospitalAndWard.split(":").map(s => s.trim());

  if (!sheet) return [];
  const data = sheet.getDataRange().getValues();

  // grab the full master list once
  const allCandidates = getCandidateList();
  const candidatesInRota = [];
  const seen = new Set();  // track which fullNames we've already added

  // loop EmailHistory rows
  for (let i = 1; i < data.length; i++) {
    const row           = data[i];
    const key           = row[0]; // OccupantKey
    const sheetHospital = row[5]; // column F: Hospital
    const sheetWard     = row[6]; // column G: Ward
    const sheetJobTitle = row[7]; // column H: JobTitle

    // only if hospital and ward match
    if (sheetHospital === hospital && sheetWard === ward) {
      // attempt to find full record
      const match = allCandidates.find(c =>
        c.fullName.toLowerCase() === key.toString().toLowerCase()
      );

      // choose either the master record or a fallback
      const candidate = match
        ? match
        : {
            fullName: key,
            jobTitle: sheetJobTitle || "",
            gender:   "any",
            tier:     0
          };

      // ensure we haven't already added this fullName
      const nameKey = candidate.fullName.toLowerCase();
      if (!seen.has(nameKey)) {
        candidatesInRota.push(candidate);
        seen.add(nameKey);
      }
    }
  }

  return candidatesInRota;
}

