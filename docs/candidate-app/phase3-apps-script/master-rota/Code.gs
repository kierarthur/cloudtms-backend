// Helper function to categorize shift


/**
 * Map a full hospital name to its short code.
 */
function getHospitalCode(hospital) {
  if (!hospital) return "";
  const h = hospital.toLowerCase();
  if (h.includes("worthing"))         return "WTG";
  if (h.includes("st richards"))      return "SRH";
  if (h.includes("royal alexandra"))  return "RACH";
  if (h.includes("princess royal"))   return "PRH";
  // fallback: first three letters, uppercase
  return hospital.trim().slice(0, 3).toUpperCase();
}

/**
 * Categorize a shift for ordering.
 */
function getShiftCategory(shift) {
  const c = (shift.comment || "").toUpperCase();
  if (c.includes("CANCELLED")) return "CX";
  if (c.includes("NEW REF"))   return "newREF";
  if (c.includes("NEW"))       return "NEW";
  // anything else we’ll treat as existing booked
  return "BKD";
}

/**
 * Decide whether to include a shift in the WhatsApp message.
 */
function shouldIncludeShift(shift) {
  const today = new Date();
  today.setHours(0, 0, 0, 0);

  const [dd, mm, yyyy] = shift.date.split("/").map(Number);
  const shiftDate = new Date(yyyy, mm - 1, dd);
  shiftDate.setHours(0, 0, 0, 0);

  const category = getShiftCategory(shift);

  // ✅ Allow NEW REF always, regardless of date
  if (category === "newREF") return { result: true, reason: "reference change" };

  // ❌ Exclude past shifts unless they’re reference changes
  if (shiftDate < today) return { result: false, reason: "past and not newREF" };

  // ✅ Include future NEW, CX, or BKD shifts
  return { result: true, reason: `include ${category}` };
}



/**
 * Send a single WATI templated message.
 */
function sendWATITemplate(mobile, params, fullName) {
  const [surname, firstname] = fullName.trim().split(' ').reverse();
  const ts = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'ddMMyyHHmmss');
  const broadcastName = `${surname}_${firstname}_${ts}`;
  const url = `https://eu-api.wati.io/601205/api/v2/sendTemplateMessage?whatsappNumber=${mobile}`;
  const payload = {
    template_name: "updaterotautility",
    broadcast_name: broadcastName,
    parameters: Object.entries(params).map(([name, value]) => ({ name, value }))
  };
  const options = {
    method: "POST",
    headers: {
      Authorization: WATI_TOKEN,
      "Content-Type": "application/json-patch+json"
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };
  let responseText = "";
  try {
    responseText = UrlFetchApp.fetch(url, options).getContentText();
  } catch (e) {
    responseText = "ERROR: " + e.message;
  }
  return responseText;
}


/**
 * Send WhatsApp messages in pages of up to 7 shifts, with headings.
 * Respects date_1 = page label, date_2...date_8 for content.
 */
/**
 * Send WhatsApp messages in pages of up to 7 shifts, with headings.
 * Respects date_1 = page label, date_2...date_8 for content.
 */
function newSendWATIMessages(candidatesWithShifts) {
  const MAX_PER_PAGE = 7;
  const logSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Logs");

  candidatesWithShifts.forEach(({ fullName, mobile, diffs }) => {
    if (!mobile || !diffs || !diffs.length) return;

    // filter & sort as before
    const shifts = diffs
      .filter(d => shouldIncludeShift(d).result)
      .sort((a, b) => {
        const order = { NEW: 0, CX: 1, newREF: 2, BKD: 3 };
        const ca = getShiftCategory(a), cb = getShiftCategory(b);
        if (order[ca] !== order[cb]) return order[ca] - order[cb];
        const [da, ma, ya] = a.date.split("/").map(Number);
        const [db, mb, yb] = b.date.split("/").map(Number);
        return new Date(ya, ma - 1, da) - new Date(yb, mb - 1, db);
      });

    if (!shifts.length) return;

    // bucket into four sections, but TIME CHANGE always goes into NEW
    const sections = ["NEW", "CX", "newREF", "BKD"];
    const sectionNames = {
      NEW: "New Bookings",
      CX: "Cancelled Bookings",
      newREF: "New Reference Numbers",
      BKD: "Existing Confirmed Bookings"
    };
    const bySection = {};
    sections.forEach(sec => bySection[sec] = []);
    shifts.forEach(s => {
      const cat = (s.comment === "TIME CHANGE") ? "NEW" : getShiftCategory(s);
      bySection[cat].push(s);
    });

    // flatten with headers
    const flat = [];
    sections.forEach(sec => {
      if (!bySection[sec].length) return;
      flat.push({ isHeader: true, section: sec });
      bySection[sec].forEach(s => flat.push(s));
    });

    // compute how many pages we need
    const totalPages = Math.ceil(flat.length / MAX_PER_PAGE);

    // paginate through flat[] in pages of 7 slots
    let page = 1, i = 0;
    const seenSectionOnPage = {};
    while (i < flat.length) {
      const params = {
        date_1: `Page ${page} of ${totalPages}`,
        date_2: "-", date_3: "-", date_4: "-", date_5: "-",
        date_6: "-", date_7: "-", date_8: "-"
      };
      let slot = 2;

      while (slot <= 8 && i < flat.length) {
        const item = flat[i];

        if (item.isHeader) {
          let txt = sectionNames[item.section];
          if (seenSectionOnPage[item.section]) txt += " continued";
          seenSectionOnPage[item.section] = true;
          if (slot === 8) break;
          params[`date_${slot}`] = txt;
          slot++; i++;
        } else {
          let shiftDesc;
          if (item.comment === "TIME CHANGE") {
            // if a note exists, reuse it; otherwise pick default based on shift type
            if (item.note && item.note.trim()) {
              shiftDesc = "TIME CHANGE " + item.note.trim();
            } else if (item.shift.includes("Night")) {
              shiftDesc = "TIME CHANGE 1930hrs-0800hrs";
            } else {
              shiftDesc = "TIME CHANGE 0730hrs-2000hrs";
            }
          } else if (item.note) {
            shiftDesc = item.note;
          } else {
            shiftDesc = item.shift.includes("Night") ? "N" : "LD";
          }

          const shortDate = item.date.split("/").slice(0, 2).join("/");
          const hospCode  = getHospitalCode(item.hospital);
          const cat       = getShiftCategory(item);
          let refValue    = item.newRef || item.reference || "";
          const refSuffix = (refValue && cat !== "CX") ? ` Ref: ${refValue}` : "";

          const line = `${cat} - ${shortDate} - ${shiftDesc} - ${hospCode} ${item.ward}${refSuffix}`;
          params[`date_${slot}`] = line;
          slot++; i++;
        }
      }

      sendWATITemplate(mobile, params, fullName);
      Utilities.sleep(5000);
      page++;
    }
  });
}









function parseDate(input) {
  if (!input) return null;
  const parts = input.split('/');
  return new Date(+`20${parts[2] || '20'}`, parts[1] - 1, +parts[0]);
}

function formatDDMM(input) {
  const parts = input.split('/');
  return `${parts[0].padStart(2, '0')}/${parts[1].padStart(2, '0')}`;
}









