/**
 * Make a per-candidate copy of the master template.
 * Returns { file, docId, name }
 */
/**
 * Make a per-candidate copy of the master template.
 * Returns { file, docId, name, fileIdDocx }
 */
function copyTemplateForCandidate_(templateFileId, surname, firstName, now=new Date()) {
  // Use explicit output folder (supports Shared Drives via OUTPUT_FOLDER_ID)
  const folder = getOutputFolder_();

  const yyyy = Utilities.formatDate(now, Session.getScriptTimeZone(), 'yyyy');
  const mm   = Utilities.formatDate(now, Session.getScriptTimeZone(), 'MM');
  const dd   = Utilities.formatDate(now, Session.getScriptTimeZone(), 'dd');
  const name = CHECKLIST_FILENAME_PATTERN
    .replace('${SURNAME}', _safeFilenamePart(surname || ''))
    .replace('${FIRST}', _safeFilenamePart(firstName || ''))
    .replace('${YYYYMMDD}', `${yyyy}${mm}${dd}`);

  // 1) Copy the master (expected to be a Word .docx file)
  const master = DriveApp.getFileById(templateFileId);
  const copy   = master.makeCopy(name, folder);
  const copyId = copy.getId();
  const copyMime = (typeof copy.getMimeType === 'function') ? copy.getMimeType() : '';

  // 2) Convert the working .docx copy into a Google Doc for editing (Advanced Drive service)
  let convertedDocId = '';
  try {
    const converted = Drive.Files.copy(
      {
        title: name,
        parents: [{ id: folder.getId() }],
        mimeType: 'application/vnd.google-apps.document'
      },
      copyId
    );
    convertedDocId = converted && converted.id ? converted.id : '';
  } catch (e) {
    const err = String((e && e.stack) || e);
    throw new Error('copyTemplateForCandidate_: Conversion from DOCX to Google Doc failed.');
  }

  if (!convertedDocId) {
    throw new Error('copyTemplateForCandidate_: Missing converted Google Doc id.');
  }

  // 3) Readiness probe with backoff
  const maxAttempts = 6;
  let opened = false;
  let lastErr = null;
  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    try {
      const probeDoc = DocumentApp.openById(convertedDocId);
      void probeDoc.getBody();
      probeDoc.saveAndClose();
      opened = true;
      break;
    } catch (e) {
      lastErr = String((e && e.stack) || e);
      Utilities.sleep(500 * attempt);
    }
  }

  if (!opened) {
    throw new Error(`copyTemplateForCandidate_: Converted document ${convertedDocId} is inaccessible after retries.`);
  }

  return { file: copy, docId: convertedDocId, name, fileIdDocx: copyId };
}


/**
 * Export a Google Doc (by fileId) directly to DOCX via Drive v3 `files.export` with `alt=media`.
 * Returns { blob, name, mimeType } on success.
 * On failure, logs details and throws (no PDF fallback).
 *
 * Notes:
 * - Requires Drive scope (https://www.googleapis.com/auth/drive).
 * - Uses ScriptApp.getOAuthToken() for Authorization.
 * - Retries a few times with short backoff in case the doc is still finalizing.
 */
function exportChecklistViaHttp_(docId, baseName) {
  const mime = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
  const url  = 'https://www.googleapis.com/drive/v3/files/'
             + encodeURIComponent(docId)
             + '/export?mimeType=' + encodeURIComponent(mime)
             + '&alt=media';

  const headers = { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() };
  const name = `${baseName}.docx`;

  const maxAttempts = 3;
  let lastErr = null;

  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    try {
      const res = UrlFetchApp.fetch(url, {
        method: 'get',
        headers,
        muteHttpExceptions: true,
      });

      const code = res.getResponseCode();
      if (code >= 200 && code < 300) {
        const blob = res.getBlob();
        try {
          blob.setName(name);
          blob.setContentType(mime);
        } catch (_) {}

        let size = null;
        try { size = blob.getBytes().length; } catch (_) {}

        return { blob, name, mimeType: mime };
      }

      const bodyText = (() => {
        try { return res.getContentText().slice(0, 500); } catch (_) { return ''; }
      })();

      lastErr = `HTTP ${code} exporting ${docId}: ${bodyText}`;

      // brief backoff before retrying
      Utilities.sleep(400 * attempt); // 400ms, 800ms, 1200ms
    } catch (e) {
      lastErr = String((e && e.stack) || e);
      Utilities.sleep(400 * attempt);
    }
  }

  // After retries, propagate the failure (no PDF fallback)
  throw new Error('exportChecklistViaHttp_: ' + (lastErr || 'Unknown export failure'));
}


