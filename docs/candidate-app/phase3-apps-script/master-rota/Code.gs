function auditScriptPropertiesAndSetExpiry() {
  const MAX_BYTES = 500 * 1024; // ~500KB total limit for Script Properties

  const props = PropertiesService.getScriptProperties();
  const all   = props.getProperties(); // { key: value, ... }
  const keys  = Object.keys(all).sort();

  // Helpers
  const asBytes = (s) => Utilities.newBlob(String(s)).getBytes().length;
  const fmtPct  = (n) => (n * 100).toFixed(2) + '%';
  const fmtKB   = (b) => (b / 1024).toFixed(2) + ' KB';

  // Measure usage
  let totalBytes = 0;
  const entries = keys.map(k => {
    const vb = asBytes(all[k]);
    const kb = asBytes(k);
    const sum = vb + kb;
    totalBytes += sum;
    return { key: k, keyBytes: kb, valBytes: vb, totalBytes: sum };
  });

  // Sort by largest values first (by total bytes of key+value)
  entries.sort((a, b) => b.totalBytes - a.totalBytes);

  // Attempt to set WATI_EXPIRY_TIME = "3" (string)
  const toWriteKey = 'WATI_EXPIRY_TIME';
  const toWriteVal = '480';
  let writeOk = true;
  let writeErr = '';

  try {
    // Rough projection (replace existing size for that key if present)
    const existing = all[toWriteKey];
    const projectedBytes =
      totalBytes
      - (existing ? (asBytes(toWriteKey) + asBytes(existing)) : 0)
      + (asBytes(toWriteKey) + asBytes(toWriteVal));

    if (projectedBytes > MAX_BYTES) {
      Logger.log(
        '[WARN] Setting %s may exceed the Script Properties limit. ' +
        'Projected total: %s (limit %s). Proceeding to try anyway.',
        toWriteKey, fmtKB(projectedBytes), fmtKB(MAX_BYTES)
      );
    }

    props.setProperty(toWriteKey, toWriteVal);
  } catch (e) {
    writeOk  = false;
    writeErr = e && e.message ? e.message : String(e);
  }

  // Re-read to confirm
  const after = props.getProperty(toWriteKey);
  const confirmed = (after === toWriteVal);

  // Log summary header
  Logger.log('================ Script Properties Audit ================');
  Logger.log('Keys count: %s', keys.length);
  Logger.log('Total usage: %s (%s of %s)', fmtKB(totalBytes), fmtPct(totalBytes / MAX_BYTES), fmtKB(MAX_BYTES));

  // Top 10 largest keys
  Logger.log('--- Top largest keys (up to 10) ---');
  entries.slice(0, 10).forEach((e, i) => {
    Logger.log(
      '%d) %s  | value=%s  key=%s  total=%s',
      i + 1,
      e.key,
      fmtKB(e.valBytes),
      fmtKB(e.keyBytes),
      fmtKB(e.totalBytes)
    );
  });

  // Full list (optional): uncomment if you want everything
  // Logger.log('--- Full list by size ---');
  // entries.forEach(e => {
  //   Logger.log('%s  | value=%s  key=%s  total=%s', e.key, fmtKB(e.valBytes), fmtKB(e.keyBytes), fmtKB(e.totalBytes));
  // });

  // Report on write attempt
  Logger.log('--- Write Attempt: %s = "%s" ---', toWriteKey, toWriteVal);
  if (writeOk) {
    Logger.log('Write status: OK');
  } else {
    Logger.log('Write status: ERROR -> %s', writeErr);
  }
  Logger.log('Confirmed value now: %s', JSON.stringify(after));
  Logger.log('Confirmed match expected: %s', confirmed ? 'YES' : 'NO');

  // Return a compact summary object (also visible in Executions > Return value)
  return {
    keysCount: keys.length,
    totalBytes,
    totalKB: (totalBytes / 1024),
    limitKB: (MAX_BYTES / 1024),
    usagePct: (totalBytes / MAX_BYTES) * 100,
    topLargest: entries.slice(0, 10),
    write: {
      key: toWriteKey,
      triedValue: toWriteVal,
      ok: writeOk,
      confirmed,
      error: writeErr || null
    }
  };
}





function _1emitEHHistoryLines(bookingsBySiteWard, focusDates) {
  // Emits EH| lines ONLY for dates in focusDates (all wards/sites).
  const EH = [];
  if (!bookingsBySiteWard || typeof bookingsBySiteWard !== 'object') return EH;

  const fset = {};
  if (Array.isArray(focusDates)) focusDates.forEach(d => { if (d) fset[String(d)] = true; });

  // Collect entries as tuples for sorting
  const tuples = []; // [yys, S, site, ward, cids[]]

  const siteWardKeys = Object.keys(bookingsBySiteWard);
  for (let i = 0; i < siteWardKeys.length; i++) {
    const swKey = siteWardKeys[i] || '';
    const parts = swKey.split('|');
    const site = (parts[0] || '').trim();
    const ward = (parts[1] || '').trim();
    const perDateShift = bookingsBySiteWard[swKey] || {};

    const dsKeys = Object.keys(perDateShift);
    for (let j = 0; j < dsKeys.length; j++) {
      const ds = dsKeys[j] || ''; // "yyyy-mm-dd|S"
      const p2 = ds.split('|');
      const ymd = (p2[0] || '').trim();
      const S   = (p2[1] || 'L').trim().toUpperCase();
      if (!ymd) continue;
      if (fset && Object.keys(fset).length && !fset[ymd]) continue; // Focus filter

      // Convert to yymmdd
      const yys = _1fmtYYMMDD(new Date(ymd));
      // De-duplicate cids (stable)
      const raw = Array.isArray(perDateShift[ds]) ? perDateShift[ds] : [];
      const seen = {};
      const uniq = [];
      for (let k = 0; k < raw.length; k++) {
        const cid = String(raw[k] || '').trim();
        if (!cid || seen[cid]) continue;
        seen[cid] = true;
        uniq.push(cid);
      }
      tuples.push([yys, S === 'N' ? 'N' : 'L', site, ward, uniq]);
    }
  }

  // Sort: date asc, shift L before N, site asc, ward asc
  tuples.sort(function(a, b) {
    if (a[0] !== b[0]) return a[0] < b[0] ? -1 : 1;             // date
    if (a[1] !== b[1]) return a[1] === 'L' ? -1 : 1;            // L before N
    if (a[2] !== b[2]) return a[2] < b[2] ? -1 : 1;             // site
    if (a[3] !== b[3]) return a[3] < b[3] ? -1 : 1;             // ward
    return 0;
  });

  // Emit lines
  for (let i = 0; i < tuples.length; i++) {
    const [yys, S, site, ward, cids] = tuples[i];
    const list = (cids && cids.length) ? cids.join(';') : '?';
    EH.push('EH|' + yys + '|' + S + '|site=' + site + '|ward=' + ward + '|cids=' + list);
  }

  return EH;
}

function _1computeFocusDates(selectedDates, headerDates) {
  const tz = _1tz();
  const today = new Date(); today.setHours(0,0,0,0);

  function toYmd(d){ return Utilities.formatDate(d, tz, 'yyyy-MM-dd'); }
  function addDays(ymd, n){ const d = new Date(ymd + 'T00:00:00'); d.setDate(d.getDate() + n); return toYmd(d); }

  const headerSet = (Array.isArray(headerDates) ? headerDates : []).reduce((m,d)=>{ if(d)m[String(d)]=true; return m; }, {});
  const unique = {};
  (Array.isArray(selectedDates) ? selectedDates : []).forEach(s => {
    if (!s) return;
    const base = toYmd(new Date(s));
    [-1,0,+1].forEach(delta => {
      const y = addDays(base, delta);
      if (headerSet[y]) {
        const dd = new Date(y + 'T00:00:00');
        if (dd >= today) unique[y] = true;
      }
    });
  });
  return Object.keys(unique).sort();
}

function _1emitEB_ForFocusThisWard(bookingsBySiteWard, focusDates, site, ward) {
  const EB = [];
  if (!bookingsBySiteWard || typeof bookingsBySiteWard !== 'object') return EB;

  const key = String(site||'') + '|' + String(ward||'');
  const inner = bookingsBySiteWard[key] || {};
  const fset = {};
  (Array.isArray(focusDates) ? focusDates : []).forEach(d => { if (d) fset[String(d)] = true; });

  const keys = Object.keys(inner);
  for (let i=0; i<keys.length; i++) {
    const ds = keys[i]; // "yyyy-mm-dd|S"
    const p = ds.split('|');
    const ymd = (p[0]||'').trim();
    const S   = (p[1]||'L').trim().toUpperCase();
    if (!ymd || !fset[ymd]) continue;

    const yys = _1fmtYYMMDD(new Date(ymd));
    const list = Array.isArray(inner[ds]) ? inner[ds] : [];
    EB.push('EB|' + yys + '|' + (S==='N'?'N':'L') + '|cids=' + (list.length ? list.join(';') : '?'));
  }
  return EB;
}

function _1emitEH_ForFocusAllWards(bookingsBySiteWard, focusDates) {
  // Delegates to the focused version of the EH emitter (keeps sort & de-dupe semantics).
  return _1emitEHHistoryLines(bookingsBySiteWard, focusDates);
}

function _1emitA_ForFocus(daysByCid, focusDates) {
  const A = [];
  if (!daysByCid || typeof daysByCid !== 'object') return A;

  const sortedF = (Array.isArray(focusDates) ? focusDates.slice().sort() : []);
  const cids = Object.keys(daysByCid);
  for (let i=0; i<cids.length; i++) {
    const cid = cids[i];
    const rec = daysByCid[cid] || {};
    const parts = [];
    for (let j=0; j<sortedF.length; j++) {
      const y = sortedF[j];
      const code = String(rec[y] == null ? '' : rec[y]).trim();
      parts.push(_1fmtYYMMDD(new Date(y)) + '=' + (code || ''));
    }
    A.push('A|' + cid + '|' + parts.join(','));
  }
  return A;
}

function _1emitAVF_Flags(daysByCid, headerDates, focusDates) {
  const AVF = [];
  if (!daysByCid || typeof daysByCid !== 'object') return AVF;

  const H = (Array.isArray(headerDates) ? headerDates : []);
  const Fset = {};
  (Array.isArray(focusDates) ? focusDates : []).forEach(d => { if(d) Fset[String(d)] = true; });

  const cids = Object.keys(daysByCid);
  for (let i=0; i<cids.length; i++) {
    const cid = cids[i];
    const rec = daysByCid[cid] || {};
    let anyH = false, anyF = false;

    for (let h=0; h<H.length; h++) {
      const y = H[h];
      const c = String(rec[y] == null ? '' : rec[y]).trim();
      const isAvail = (c === 'L' || c === 'N');
      if (isAvail) {
        anyH = true;
        if (Fset[y]) anyF = true;
        if (anyH && anyF) break;
      }
    }
    const outsideOnly = (anyH && !anyF) ? 1 : 0;
    AVF.push('AVF|' + cid + '|anyH=' + (anyH?1:0) + '|anyF=' + (anyF?1:0) + '|outsideOnly=' + outsideOnly);
  }
  return AVF;
}

function _1emitESUM_OutsideFocus(byCid, focusDates) {
  const ESUM = [];
  if (!byCid || typeof byCid !== 'object') return ESUM;

  const fset = {};
  (Array.isArray(focusDates) ? focusDates : []).forEach(d => { if (d) fset[String(d)] = true; });

  function dowIdxMon0(d){ const js = d.getDay(); return (js+6)%7; } // Sun=0 → 6
  const DOW = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];

  const cids = Object.keys(byCid);
  for (let i=0; i<cids.length; i++) {
    const cid = cids[i];
    const node = byCid[cid] || {};
    const worked = node.worked || {};
    const counts = Array(7).fill(0).map(()=>({L:0,N:0}));

    const ymds = Object.keys(worked);
    for (let k=0; k<ymds.length; k++) {
      const y = ymds[k];
      if (fset[y]) continue; // exclude Focus
      const s = worked[y];   // 'L' or 'N'
      const d = new Date(y + 'T00:00:00');
      const idx = dowIdxMon0(d);
      if (s === 'L') counts[idx].L++; else if (s === 'N') counts[idx].N++;
    }

    // Derive responsiveness proxies from flags presence (extend to counts if available later)
    const flags = String(node.flags || '');
    const rapid = /E/.test(flags) ? 1 : 0; // rapid-response same day
    const early = /2/.test(flags) ? 1 : 0; // extra-early next day

    const segs = [];
    for (let j=0; j<7; j++) {
      segs.push(DOW[j] + ':L' + counts[j].L + 'N' + counts[j].N);
    }
    ESUM.push('ESUM|' + cid + '|dow=' + segs.join(';') + '|rapid=' + rapid + '|early=' + early);
  }
  return ESUM;
}


function _1runDeepseekAfterConfirm(args) {
  try {
    const runId     = String(args && args.runId || _1newRunId('DS'));
    const sheetName = String(args && args.sheetName || '');
    const site      = String(args && args.site || '');
    const ward      = String(args && args.ward || '');
    const payload   = String(args && args.payload || '');
    const cidToName = (args && args.cidToName) || {};
    const systemTextFromUI = String(args && args.systemText || '');
