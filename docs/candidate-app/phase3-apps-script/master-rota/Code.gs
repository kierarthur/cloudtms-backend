// Updated composer
// ───────────────────────────────────────────────────────────────

function composeChecklistPlaceholders_(person, summary, opts) {
  const o = opts || {};
  const jobIsHca = (String(person.jobTitle || '').trim().toLowerCase() === 'hca');

  // NEW: Simple, explicit rule for "<DBS Update Service registered>"
  const norm = s => String(s || '').trim().toLowerCase();
  const mostRecentStatusNorm = norm(summary?.dbs?.mostRecentStatus || summary?.dbs?.updateStatus || '');
  const hasUpdateService = (mostRecentStatusNorm && mostRecentStatusNorm !== 'no_match_found'); // true/false

  // DBS Conviction text rule (honours overrides + questionnaire-YES fallback)
  const dbsConviction = _computeDbsConvictionText_(summary);

  // Update Service date checked for the checklist DOC placeholder:
  // (Leave as "last successful" as per your existing document convention)
  const dbsChecked = String(summary?.dbs?.lastSuccessfulCheckDate || '');

  const today = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy');

  // NMC fields
  const nmcNumber = jobIsHca ? 'N/A' : (summary?.nmc?.registrationNumber || '');
  const nmcStatus = jobIsHca ? 'N/A' : (summary?.nmc?.status || '');
  const nmcExpiry = jobIsHca
    ? 'N/A'
    : (summary?.nmc?.feeExpiryDateHyphen ? String(summary.nmc.feeExpiryDateHyphen) : 'N/A');

  // NMC Warning placeholder
  let nmcWarning = '';
  if (jobIsHca) {
    nmcWarning = 'N/A';
  } else {
    const comment = String(summary?.nmc?.comment || '').trim();
    nmcWarning = comment ? ((comment.toLowerCase() === 'registered') ? 'NO' : comment) : '';
  }

  // Visa expiry (Online RTW expiry) — DD/MM/YYYY or N/A
  const visaExpiry = summary?.rtw?.onlineExpiry ? String(summary.rtw.onlineExpiry) : 'N/A';

  // DOB: prefer explicit hyphen form, else accept either dobIso or dob (ISO) and pretty-print
  const dobHyphen = (typeof o.dobHyphen === 'string') ? o.dobHyphen : '';
  const dobIsoInput = o.dobIso || o.dob || '';
  const dobValue = dobHyphen || (dobIsoInput ? pickDate(dobIsoInput) : '');

  // DBS Issue Date: accept either dbsIssueDateIso or dbsIssueDate (ISO) and pretty-print
  const dbsIssueIsoInput = o.dbsIssueDateIso || o.dbsIssueDate || '';
  const dbsIssueDate = dbsIssueIsoInput ? pickDate(dbsIssueIsoInput) : '';

  const map = {
    '<First Name>': person.firstName || '',
    '<Surname>': person.surname || '',
    '<Email>': o.email || '',
    '<NI Number>': summary?.niNumber || '',
    '<Date of Birth>': dobValue,
    '<Gender>': o.gender || '',

    // NMC / clinical
    '<NMC>': nmcNumber,
    '<NMC Expiry>': nmcExpiry,
    '<NMC Warning>': nmcWarning,

    // Immigration / RTW
    '<Visa Expiry>': visaExpiry,

    // DBS
    '<DBS Certificate>': summary?.dbs?.updateCertificateNumber || summary?.dbs?.providedCertificateNumber || '',
    '<DBS Issue Date>': dbsIssueDate, // DD/MM/YYYY
    '<DBS Issued by>': o.dbsIssuedBy || '',
    '<DBS Update Service Date checked>': dbsChecked, // keep as "last successful" for the document
    '<DBS Update Service registered>': hasUpdateService ? 'Yes' : 'No',
    '<DBS Conviction>': dbsConviction,

    // OH
    '<OH Issue Date>': (summary?.occHealth?.issued || ''),

    // Misc
    '<DATE TODAY>': today,
    // '<Passport Photo>' handled elsewhere
  };

  // Defensive cleanup of null/undefined
  Object.keys(map).forEach(k => { if (map[k] == null) map[k] = ''; });
  return map;
}




