  function normalizeBandStartRow(row) {
    // NAME row is the "band start". If we ever receive the REF row, step up by -1.
    // (Sheet rows are 1-based. First NAME row is 5, then 7,9,...)
    if (!row || row < 5) return null;
    return (row % 2 === 1) ? row : (row - 1);
  }

  function addBandTarget(sheet, bandStartRow) {
    if (!sheet || !bandStartRow) return;
    const key = `${sheet.getSheetId()}|${bandStartRow}`;
    if (bandTargetKeySet.has(key)) return;
    bandTargetKeySet.add(key);
    bandTargets.push({ sheetId: String(sheet.getSheetId()), bandStartRow: Number(bandStartRow) });
  }

  function ddmmyyyyFromAny(x) {
    try {
      if (x instanceof Date && !isNaN(x)) {
        return Utilities.formatDate(x, tz, "dd/MM/yyyy");
      }
      const s = String(x || "").trim();
      if (!s) return "";
      const m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
      if (m) return `${m[1].padStart(2,"0")}/${m[2].padStart(2,"0")}/${m[3]}`;
      const d = new Date(s);
      if (!isNaN(d)) return Utilities.formatDate(d, tz, "dd/MM/yyyy");
    } catch (e) {}
    return "";
  }

  function findBandStartRowForDate(sheet, dateStr) {
    if (!sheet || !dateStr) return null;
    const sid = sheet.getSheetId();
    if (!dateRowCacheBySheetId.has(sid)) {
      dateRowCacheBySheetId.set(sid, new Map());
    }
    const cache = dateRowCacheBySheetId.get(sid);
    if (cache.has(dateStr)) return cache.get(dateStr); // could be null

    const lastRow = sheet.getLastRow();
    if (lastRow < 5) { cache.set(dateStr, null); return null; }

    // Read column B once
    const colB = sheet.getRange(1, 2, lastRow, 1).getValues(); // 1-based rows

    // Scan only likely NAME rows (5,7,9,...) but tolerate if format differs
    for (let r = 5; r <= lastRow; r += 2) {
      const cell = colB[r - 1][0]; // zero-based index
      if (!cell) continue;
      const cellNorm = ddmmyyyyFromAny(cell);
      if (cellNorm && cellNorm === dateStr) {
        cache.set(dateStr, r);
        return r;
      }
    }

    // Fallback: scan all rows in case the sheet isn't in standard band layout
    for (let r = 1; r <= lastRow; r++) {
      const cell = colB[r - 1][0];
      if (!cell) continue;
      const cellNorm = ddmmyyyyFromAny(cell);
      if (cellNorm && cellNorm === dateStr) {
        const band = normalizeBandStartRow(r);
        cache.set(dateStr, band);
        return band;
      }
    }

    cache.set(dateStr, null);
    return null;
  }

  // NEW: collectors for one-shot dispatches
  const emailItems = [];          // items for Flow
  const emailMetaIndex = [];      // [{key, to}] aligned to emailItems

  // For WATI bulk we collect per-PAGE receivers & their meta (key/mobile/page)
  const watiReceivers = [];       // receivers for WATI broadcast (per page)
  const waMetaIndex = [];         // [{key, mobile, page}] aligned to watiReceivers

  // NEW: track candidates whose bookings changed (NEW / CANCELLED)
  const _changedKeys = new Set();

  // — Prepare EmailHistory batching —
  let histS = ss.getSheetByName("EmailHistory");
  if (!histS) {
    histS = ss.insertSheet("EmailHistory");
    histS.getRange("A1:J1").setValues([[
      "OccupantKey","Date","Shift","Reference","Day",
      "Hospital","Ward","JobTitle","(blank)","Notes"
    ]]);
  }
  const existingLastRow = histS.getLastRow();
  const tzStr = tz;
  let existing = existingLastRow > 1
    ? histS.getRange(2, 1, existingLastRow - 1, 10).getValues()
    : [];

  // ── (1) DEDUPE “existing” in memory ──
  const seenCodes = new Set();
  existing = existing.filter(row => {
    const key    = String(row[0]).toLowerCase().trim();
    const date   = Utilities.formatDate(new Date(row[1]), tzStr, "dd/MM/yyyy");
    const shift  = String(row[2]).trim();
    const hosp   = String(row[5]).trim();
    const ward   = String(row[6]).trim();
    const code   = `${key}|${date}|${shift}|${hosp}|${ward}`;
    if (seenCodes.has(code)) return false;
    seenCodes.add(code);
    return true;
  });

  // allFinalRows will collect the brand-new, de-duplicated history for everyone:
  const allFinalRows = [];

  // — Merge diffs by candidate —
  const mergedMap = {};
  rawCands.forEach(entry => {
    const k = entry.key.toLowerCase().trim();
    if (!mergedMap[k]) {
      mergedMap[k] = { key: k, fullName: entry.fullName, diffs: [] };
    }
    // Preserve sheet name on each diff so we can target repaint
    const diffsWithSheet = entry.diffs.map(d => ({ ...d, sheetName: entry.sheetName }));
    mergedMap[k].diffs.push(...diffsWithSheet);
  });

  const candSheet = ss.getSheetByName("Candidate List");
  const candData  = candSheet.getDataRange().getValues();
  const today     = new Date();
  const today0    = new Date(today.getFullYear(), today.getMonth(), today.getDate());
  const cutoff    = new Date(today0);
  cutoff.setMonth(cutoff.getMonth() - 2);

  // — Inject zero-diff candidates with recent history —
  const histKeys = new Set(
    existing
      .filter(r => parseDateDDMMYYYY(r[1]) >= cutoff)
      .map(r => String(r[0]).toLowerCase().trim())
  );
  histKeys.forEach(k => {
    if (!mergedMap[k]) {
      mergedMap[k] = {
        key: k,
        fullName: k.replace(/\b(\w)(\w*)/g, (_, a, b) => a.toUpperCase() + b.toLowerCase()),
        diffs: []
      };
    }
  });

  const allCands = Object.values(mergedMap);

  // — Build keysToSend by merging incoming keys with history-only keys —
  let keysToSend;
  if (Array.isArray(keys) && keys.length) {
    keysToSend = Array.from(new Set([
      ...keys.map(k => k.toLowerCase().trim()),
      ...histKeys
    ]));
  } else {
    keysToSend = allCands.map(c => c.key);
  }

  const sentEmail = new Set();
  const histDone  = new Set();
  const processedKeys = new Set();

  // ── Process each candidate ──
  allCands.forEach(candidate => {
    processedKeys.add(candidate.key);
    if (!keysToSend.includes(candidate.key)) return;

    // ── Look up email/mobile ──
    const [kSurname, kFirst] = candidate.key.split(" ");
    let rowMatch = null;
    for (let i = 1; i < candData.length; i++) {
      if (
        String(candData[i][0]).toLowerCase().trim() === kSurname &&
        String(candData[i][1]).toLowerCase().trim() === kFirst
      ) {
        rowMatch = candData[i];
        break;
      }
    }
    if (!rowMatch) return;

    const emailRaw = rowMatch[2] || "";
    const email    = emailRaw.toString().trim() || null;
    let mobile     = null;
    if (rowMatch[3]) {
      const m = String(rowMatch[3]).replace(/\D/g, "");
      mobile = m.startsWith("44") ? m : "44" + m.replace(/^0/, "");
    }
    if (!email && !mobile) return;

    // ── Sort diffs, split “current vs cancelled” ──
    const diffs     = candidate.diffs.slice()
                       .sort((a, b) => parseDateDDMMYYYY(a.date) - parseDateDDMMYYYY(b.date));
    const current   = diffs.filter(d => d.comment !== "CANCELLED");
    const cancelled = diffs.filter(d => d.comment === "CANCELLED");
    const hasChange = diffs.some(d =>
      ["NEW", "NEW REFERENCE NUMBER", "CANCELLED", "TIME CHANGE"].includes(d.comment)
    );
    if (!hasChange) {
      // Copy their existing history rows forward, only those within cutoff
      const theirRows = existing.filter(r =>
        String(r[0]).toLowerCase().trim() === candidate.key &&
        parseDateDDMMYYYY(r[1]) >= cutoff
      );
      allFinalRows.push(...theirRows);
      existing = existing.filter(r => String(r[0]).toLowerCase().trim() !== candidate.key);
      return;
    }

    // mark that we saw at least one change overall
    anyChanges = true;

    // NEW: if any diffs are NEW or CANCELLED, mark this key for Availability refresh
    if (diffs.some(d => d.comment === "NEW" || d.comment === "CANCELLED")) {
      _changedKeys.add(candidate.key);
    }

    const toSend = [...current, ...cancelled];

    // ── EMAIL batching (collect, do not send now) ──
    if (email && !sentEmail.has(candidate.key)) {
      const htmlBody = _buildShiftEmailHtml(candidate.fullName, toSend);
      emailItems.push({
        to: email,
        subject: `Shift Update – ${candidate.fullName}`,
        htmlBody: htmlBody,
        meta: { key: candidate.key, fullName: candidate.fullName }
      });
      emailMetaIndex.push({ key: candidate.key, to: email });
      sentEmail.add(candidate.key);
    }

    // ── WHATSAPP batching (collect PER PAGE using the SAME logic as newSendWATIMessages) ──
    if (viaWhatsApp && mobile) {
      const built = _buildWATIReceiversFromDiffs(candidate.fullName, candidate.key, mobile, toSend);
      if (built && built.receivers && built.receivers.length) {
        // Append all per-page receivers (date_1..date_8) for this candidate
        Array.prototype.push.apply(watiReceivers, built.receivers);
        Array.prototype.push.apply(waMetaIndex, built.metaIndex);
      }
    }

    // ── (2) BUILD THIS CANDIDATE’S EmailHistory rows ──
    if (!histDone.has(candidate.key)) {
      histDone.add(candidate.key);

      const candidateOwnRows = existing.filter(r =>
        String(r[0]).toLowerCase().trim() === candidate.key
      );
      const otherRows = existing.filter(r =>
        String(r[0]).toLowerCase().trim() !== candidate.key
      );

      const toReplace   = {};
      const cancelCodes = new Set();
      toSend.forEach(d => {
        const code = `${d.date}|${d.shift}|${d.hospital}|${d.ward}`;
        if (d.comment === "CANCELLED") {
          cancelCodes.add(code);
        } else if (parseDateDDMMYYYY(d.date) >= cutoff) {
          toReplace[code] = [
            candidate.key,
            d.date,
            d.shift,
            d.newRef || d.reference || "",
            d.day || "",
            d.hospital || "",
            d.ward || "",
            d.jobTitle || "",
            "",
            d.note || ""
          ];
        }
      });

      const candidateFinalRows = [];
      candidateOwnRows.forEach(row => {
        const [ , rDate, rShift, , , rHosp, rWard] = row;
        const dateStr = Utilities.formatDate(new Date(rDate), tzStr, "dd/MM/yyyy");
        const code = `${dateStr}|${rShift}|${rHosp}|${rWard}`;
        const rowDate = parseDateDDMMYYYY(rDate);

        let action, reason;
        if (toReplace[code]) {
          action = "REMOVED"; reason = "Replaced by new/cancel change";
        } else if (cancelCodes.has(code)) {
          action = "REMOVED"; reason = "Cancelled";
        } else if (rowDate < cutoff) {
          action = "REMOVED"; reason = "Older than retention cutoff";
        } else {
          action = "KEPT";
          reason = rowDate >= today0 ? "Future shift" : "Recent past";
          candidateFinalRows.push(row);
        }
      });

      Object.values(toReplace).forEach(newRow => candidateFinalRows.push(newRow));

      allFinalRows.push(...candidateFinalRows);
      existing = otherRows;
    }

    // ── NEW: collect repaint band targets for these diffs (no behavior change elsewhere) ──
    // We repaint the whole band (date row) per diff's sheet + date.
    toSend.forEach(d => {
      const sheet = getSheetByNameMemo(d.sheetName);
      if (!sheet) { unmappableChanges = true; return; }

      if (d.comment !== "CANCELLED" && d.row) {
        const bandStart = normalizeBandStartRow(Number(d.row));
        if (bandStart) {
          addBandTarget(sheet, bandStart);
        } else {
          unmappableChanges = true;
        }
      } else {
        // CANCELLED (no row/col): locate band by matching date in column B
        const dateStr = ddmmyyyyFromAny(d.date);
        if (!dateStr) { unmappableChanges = true; return; }
        const bandStart = findBandStartRowForDate(sheet, dateStr);
        if (bandStart) {
          addBandTarget(sheet, bandStart);
        } else {
          unmappableChanges = true;
        }
      }
    });
  });

  // ── DISPATCH: single email webhook + single (or chunked) WATI broadcast ──
  const runId = new Date().toISOString();

  // Emails (unchanged)
  let emailResults = null, emailBatchError = null;
  if (emailItems.length) {
    try {
      const flowRes = _dispatchEmailsBatch(emailItems, "sussex@arthur-rai.co.uk", runId);
      emailResults = Array.isArray(flowRes && flowRes.results) ? flowRes.results : [];
      if (!Array.isArray(emailResults)) {
        emailBatchError = "Invalid Flow response";
      }
    } catch (e) {
      emailBatchError = String(e && e.message || e);
    }
  }

  // WATI bulk (using SAME template/params as single-send: updaterotautility + date_1..date_8 via customParams)
  let waResults = [];           // per-page results [{ error: null|string }]
  let waBatchErrors = [];       // array of { reason, count } per chunk failure
  if (viaWhatsApp) {
    if (!watiReceivers.length) {
      _log('WATI', `No receivers to send (viaWhatsApp=true but watiReceivers.length=0).`);
    } else {
      // Optional: chunking if needed; here we send as one go unless you hit limits
      const CHUNK_SIZE = 300; // adjust if your tenant has tighter limits
      for (let start = 0; start < watiReceivers.length; start += CHUNK_SIZE) {
        const chunk = watiReceivers.slice(start, start + CHUNK_SIZE);
        const metaChunk = waMetaIndex.slice(start, start + CHUNK_SIZE);

        _log('WATI', `Preparing to send bulk template (updaterotautility) chunk: size=${chunk.length}, runId=${runId}`);
        try {
          const wa = _sendWATIBulkTemplate_DateParams(chunk, runId, tzStr); // same template/params
          _log('WATI', `HTTP ${wa.httpCode}. Raw body (truncated 800): ${_truncateSafe(JSON.stringify(wa.json || _safeText(wa.rawText), null, 2), 800)}`);

          if (wa && wa.httpCode === 200 && wa.json && Array.isArray(wa.json.receivers)) {
            const local = wa.json.receivers.map((r, idx) => {
              const err = r && (r.error || r.errorCode || (Array.isArray(r.errors) && r.errors.length ? r.errors.map(x => x.message || JSON.stringify(x)).join('; ') : null));
              if (err) {
                const m = metaChunk[idx] || {};
                _log('WATI', `Per-receiver error idx=${start + idx} mobile=${m && m.mobile ? (String(m.mobile).slice(0,4)+'****'+String(m.mobile).slice(-2)) : ''} page=${m && m.page ? m.page : ''}: ${_truncateSafe(String(err), 500)}`);
              }
              return { error: err || null };
            });
            waResults = waResults.concat(local);
          } else if (wa && wa.httpCode === 200 && wa.json && wa.json.result === true) {
            _log('WATI', `Broadcast accepted with no per-receiver array; assuming success for all ${chunk.length}.`);
            waResults = waResults.concat(new Array(chunk.length).fill({ error: null }));
          } else {
            const reason = (wa && (wa.json && (wa.json.error || wa.json.message))) || `HTTP ${wa && wa.httpCode}`;
            waBatchErrors.push({ reason, count: chunk.length });
            _log('WATI', `Broadcast-level failure detected for chunk: ${_truncateSafe(String(reason), 600)}`);
            // When batch fails, mark all in this chunk as error for mapping purposes
            waResults = waResults.concat(new Array(chunk.length).fill({ error: reason }));
          }
        } catch (e) {
          const reason = String(e && e.message || e);
          waBatchErrors.push({ reason, count: chunk.length });
          _log('WATI', `Exception thrown while sending WATI broadcast chunk: ${_truncateSafe(reason, 600)}`);
          waResults = waResults.concat(new Array(chunk.length).fill({ error: reason }));
        }
      }
    }
  } else {
    _log('WATI', 'viaWhatsApp=false; skipping WATI dispatch.');
  }

  // ── Write EmailHistory (unchanged) ──
  if (allFinalRows.length) {
    if (existingLastRow > 1) {
      histS.getRange(2, 1, existingLastRow - 1, 10).clearContent();
    }
    histS.getRange(2, 1, allFinalRows.length, 10).setValues(allFinalRows);
     SpreadsheetApp.flush();
  }

  // ── NEW LOGIC: notify Availability API that EmailHistory has been updated ──
  // This only signals the external API to bump its EH revision. It does not alter existing flows.
  try {
    if (typeof _emitEmailHistoryUpdated === 'function' && anyChanges) {
      const affected = Array.from(_changedKeys || []);
      _emitEmailHistoryUpdated(runId, affected);
    }
  } catch (e) {
    // Never throw; purely best-effort signal
    _log('AVAIL_API', `Failed to emit EMAILHISTORY_UPDATED: ${String(e && e.message || e)}`);
  }

  // ── Clear trailing ZW spaces in notes (unchanged) ──
  const ZWS = '\u200B';
  ss.getSheets().forEach(sheet => {
    const range = sheet.getDataRange();
    const notes = range.getNotes();
    const toClear = [];
    notes.forEach((rowNotes, i) =>
      rowNotes.forEach((n, j) => {
        if (n && n.endsWith(ZWS)) toClear.push({ r: i + 1, c: j + 1 });
      })
    );
    toClear.forEach(cell => sheet.getRange(cell.r, cell.c).clearNote());
  });

  try {
    // NEW: targeted repaint if we collected bands;
    // otherwise, ONLY do a global repaint if there were changes we couldn't map to a band.
    if (bandTargets.length) {
      refreshAllPatientSheetColors(true, bandTargets);
    } else if (anyChanges && unmappableChanges) {
      // Fallback to global repaint only in the outlined circumstances.
      refreshAllPatientSheetColors(true);
    } else {
      // No repaint needed (either no changes at all, or changes but nothing to repaint).
    }
  } catch (e) {
    // ignore
  }

  // ── Availability refresh for changed keys (unchanged) ──
  if (_changedKeys.size) {
    try {
      ai_refreshAvailabilityRowsFor(Array.from(_changedKeys));
      ai_sortAvailabilityByTierJobGenderSurname(); // re-sort after refresh
    } catch (e) {
      console.error('ai_refreshAvailabilityRowsFor failed:', e);
    }
  }

  // ── SINGLE FAILURE ALERT EMAIL to sussex@ if needed (unchanged) ──
  try {
    const failures = [];

    // Email batch-level failure
    if (emailItems.length && emailBatchError) {
      failures.push({
        channel: 'EMAIL',
        scope: 'BATCH',
        reason: emailBatchError,
        count: emailItems.length
      });
    }

    // Email per-item failures
    if (emailResults && emailResults.length) {
      emailResults.forEach((r, i) => {
        if (!r || r.status !== 'SUCCESS') {
          const meta = (r && r.meta) || emailItems[i].meta || null;
          failures.push({
            channel: 'EMAIL',
            to: r && r.to || emailItems[i].to,
            subject: r && r.subject || emailItems[i].subject,
            reason: (r && r.error) || 'Unknown',
            meta
          });
        }
      });
    }

    // WA batch-level failures (per chunk)
    if (viaWhatsApp && watiReceivers.length && waBatchErrors.length) {
      waBatchErrors.forEach(b => {
        failures.push({
          channel: 'WHATSAPP',
          scope: 'BATCH',
          reason: b.reason,
          count: b.count
        });
      });
    }

    // WA per-receiver (per-page) failures
    if (waResults && waResults.length) {
      waResults.forEach((r, i) => {
        const err = r && r.error;
        if (err) {
          const meta = waMetaIndex[i] || {};
          failures.push({
            channel: 'WHATSAPP',
            to: meta.mobile,
            reason: String(err),
            meta: { key: meta.key, page: meta.page }
          });
        }
      });
    }

    _log('WATI', `Failure aggregation complete. failures.length=${failures.length}`);

    if (failures.length) {
      const emailFailCount = failures.filter(f => f.channel === 'EMAIL' && f.scope !== 'BATCH').length +
                             failures.filter(f => f.channel === 'EMAIL' && f.scope === 'BATCH').reduce((a, f) => a + (f.count || 0), 0);
      const waAttempted = watiReceivers.length || 0;
      const waFailCount = failures.filter(f => f.channel === 'WHATSAPP' && f.scope !== 'BATCH').length +
                          failures.filter(f => f.channel === 'WHATSAPP' && f.scope === 'BATCH').reduce((a, f) => a + (f.count || 0), 0);

      const subject = `Email and Whatsapp Failures (runId: ${runId}; email: ${emailFailCount}/${emailItems.length || 0}; WA: ${waFailCount}/${waAttempted})`;

      let body = `
        <p><strong>Run ID:</strong> ${runId}</p>
        <p><strong>Timestamp:</strong> ${Utilities.formatDate(new Date(), tzStr, "yyyy-MM-dd HH:mm:ss")}</p>
        <p><strong>Email totals:</strong> ${emailFailCount} failed / ${emailItems.length || 0} attempted</p>
        <p><strong>WhatsApp totals (pages):</strong> ${waFailCount} failed / ${waAttempted} attempted</p>
      `;

      // Batch-level first
      const batchRows = failures.filter(f => f.scope === 'BATCH');
      if (batchRows.length) {
        body += `<h3>Batch-level errors</h3><ul>`;
        batchRows.forEach(f => {
          const reason = String(f.reason || '').slice(0, 500);
          body += `<li><b>${f.channel}</b> — ${reason} (count: ${f.count || 0})</li>`;
        });
        body += `</ul>`;
      }

      // Per-item failures
      const itemRows = failures.filter(f => f.scope !== 'BATCH');
      if (itemRows.length) {
        body += `
          <h3>Per-item failures</h3>
          <table border="1" cellpadding="5" cellspacing="0" style="border-collapse:collapse;width:100%;">
            <thead>
              <tr>
                <th>Channel</th>
                <th>Recipient</th>
                <th>Subject/Page</th>
                <th>Reason</th>
                <th>Meta</th>
              </tr>
            </thead>
            <tbody>
        `;
        itemRows.forEach(f => {
          const reason = String(f.reason || '').slice(0, 500);
          const subjOrPage = f.channel === 'WHATSAPP' ? (f.meta && f.meta.page ? `Page ${f.meta.page}` : '') : (f.subject || '');
          body += `
            <tr>
              <td>${f.channel || ''}</td>
              <td>${f.to || ''}</td>
              <td>${subjOrPage}</td>
              <td>${reason}</td>
              <td>${f.meta ? JSON.stringify(f.meta) : ''}</td>
            </tr>
          `;
        });
        body += `</tbody></table>`;
      }

      _log('WATI', `Sending single alert email to sussex@arthur-rai.co.uk (subject: ${subject})`);

      // Send single alert
      postToDoPostSendEmail(
        'sussex@arthur-rai.co.uk',
        subject,
        '',
        { htmlBody: body }
      );
    } else {
      _log('WATI', `No failures detected; not sending alert email.`);
    }
  } catch (e) {
    // Never throw from alerting
    console.error('Failure alert email error:', e);
  }
}

// ========================= Cancellation Hints Support =========================
// Storage format (Script Property key: CANCEL_HINTS_V1):
// {
//   "bands": {
//     "<sheetId>|<bandStartRow>": {
//       "ts": "2025-01-01T12:34:56.789Z",
//       "byCol": {
//         "7": { "col": 7, "occupantKey": "smith john", "ts": "2025-01-01T12:34:56.789Z" },
//         "9": { "col": 9, "occupantKey": "doe jane",  "ts": "2025-01-01T12:35:10.123Z" }
//       }
//     }
//   }
// }

const CANCEL_HINTS_PROP_KEY = 'CANCEL_HINTS_V1';

function _bandKeyForHints(sheetId, bandStartRow) {
  return String(sheetId) + '|' + Number(bandStartRow || 0);
}

function _loadCancellationHints() {
  const props = PropertiesService.getScriptProperties();
  const raw = props.getProperty(CANCEL_HINTS_PROP_KEY);
  if (!raw) return { bands: {} };
  try {
    const obj = JSON.parse(raw);
    if (!obj || typeof obj !== 'object' || !obj.bands || typeof obj.bands !== 'object') {
      return { bands: {} };
    }
    return obj;
  } catch (e) {
    return { bands: {} };
  }
}

function _saveCancellationHints(hintsObj) {
  const props = PropertiesService.getScriptProperties();
  try {
    props.setProperty(CANCEL_HINTS_PROP_KEY, JSON.stringify(hintsObj || { bands: {} }));
  } catch (e) {
    // swallow; hints are best-effort
  }
}

/**
 * Add (or overwrite) a cancellation hint for a specific cell.
 * @param {number|string} sheetId
 * @param {number} bandStartRow - 1-based NAME row for the band
 * @param {number} col - 1-based column index
 * @param {string} occupantKey - optional; stored for traceability
 * @returns {object} the stored hint snapshot
 */
function addCancellationHint(sheetId, bandStartRow, col, occupantKey) {
  const lock = LockService.getScriptLock();
  try { lock.tryLock(5000); } catch (e) {}
  try {
    const key = _bandKeyForHints(sheetId, bandStartRow);
    const nowIso = new Date().toISOString();
    const hints = _loadCancellationHints();

    if (!hints.bands[key]) {
      hints.bands[key] = { ts: nowIso, byCol: {} };
    }
    if (!hints.bands[key].byCol) hints.bands[key].byCol = {};

    const colKey = String(Number(col || 0));
    const entry = {
      col: Number(col || 0),
      occupantKey: occupantKey || '',
      ts: nowIso
    };

    hints.bands[key].byCol[colKey] = entry;
    hints.bands[key].ts = nowIso;

    _saveCancellationHints(hints);
    return entry;
  } finally {
    try { lock.releaseLock(); } catch (e) {}
  }
}

/**
 * Remove a stored cancellation hint for a specific cell, if present.
 * @param {number|string} sheetId
 * @param {number} bandStartRow
 * @param {number} col
 * @returns {boolean} true if a hint was removed, false if none existed
 */
function removeCancellationHintForCell(sheetId, bandStartRow, col) {
  const lock = LockService.getScriptLock();
  try { lock.tryLock(5000); } catch (e) {}
  try {
    const key = _bandKeyForHints(sheetId, bandStartRow);
    const hints = _loadCancellationHints();
    const band = hints.bands[key];
    if (!band || !band.byCol) return false;

    const colKey = String(Number(col || 0));
    if (!(colKey in band.byCol)) return false;

    delete band.byCol[colKey];

    // Clean up empty structures
    if (Object.keys(band.byCol).length === 0) {
      delete hints.bands[key];
    } else {
      band.ts = new Date().toISOString();
    }

    // If everything is empty, clear property entirely
    if (Object.keys(hints.bands).length === 0) {
      PropertiesService.getScriptProperties().deleteProperty(CANCEL_HINTS_PROP_KEY);
    } else {
      _saveCancellationHints(hints);
    }

    return true;
  } finally {
    try { lock.releaseLock(); } catch (e) {}
  }
}

/**
 * Get all cancellation hints for a band (sheetId + bandStartRow).
 * @param {number|string} sheetId
 * @param {number} bandStartRow
 * @returns {{hasHints:boolean, byCol:Object<string,{col:number,occupantKey:string,ts:string}>,
 *           cols:number[], updatedAt:string|null}}
 */
function getCancellationHintsForBand(sheetId, bandStartRow) {
  const key = _bandKeyForHints(sheetId, bandStartRow);
  const hints = _loadCancellationHints();
  const band = hints.bands[key];

  if (!band || !band.byCol) {
    return { hasHints: false, byCol: {}, cols: [], updatedAt: null };
  }

  const cols = Object.keys(band.byCol).map(k => Number(k)).sort((a, b) => a - b);
  return {
    hasHints: cols.length > 0,
    byCol: band.byCol,
    cols,
    updatedAt: band.ts || null
  };
}

/**
 * Clear all cancellation hints (start a new "hint window").
 * Use this at the start of sendUpdatesToCandidates.
 */
function clearCancellationHints() {
  const lock = LockService.getScriptLock();
  try { lock.tryLock(5000); } catch (e) {}
  try {
    PropertiesService.getScriptProperties().deleteProperty(CANCEL_HINTS_PROP_KEY);
  } finally {
    try { lock.releaseLock(); } catch (e) {}
  }
}

/**
 * Alias for clarity if you prefer the explicit "forRun" name.
 */
function clearCancellationHintsForRun() {
  return clearCancellationHints();
