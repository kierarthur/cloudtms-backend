}



function _1match_generateMaximalRuns(feasIdx) {
  function log_(evt, obj) {
    try {
      var ss = SpreadsheetApp.getActive();
      var sh = ss.getSheetByName('Logs') || ss.getSheetByName('logs');
      if (!sh) return;
      var ts = Utilities.formatDate(new Date(), _1tz(), "yyyy-MM-dd'T'HH:mm:ss");
      sh.appendRow([ts, '_1match_generateMaximalRuns', String(evt), JSON.stringify(obj || {}).slice(0, 5000)]);
    } catch (_) {}
  }

  var runs = [];
  var keys = (feasIdx && feasIdx.keys) ? feasIdx.keys.slice() : [];
  var byDay = {};
  keys.forEach(function (k) {
    var p = k.split('|'); var y = p[0];
    if (!byDay[y]) byDay[y] = [];
    byDay[y].push(k);
  });
  var days = Object.keys(byDay).sort();

  var trackKeys = keys.map(function (k) {
    var p = k.split('|'); return p[2] + '|' + p[3] + '|' + p[1]; // role|g|S
  });
  var uniqTracks = Array.from(new Set(trackKeys));

  uniqTracks.forEach(function (trk) {
    var tparts = trk.split('|');
    var role = tparts[0], g = tparts[1], S = tparts[2];

    var keysForTrackByDay = {};
    days.forEach(function (y) {
      var ks = (byDay[y] || []).filter(function (k) {
        var p = k.split('|'); return p[1] === S && p[2] === role && p[3] === g;
      });
      keysForTrackByDay[y] = ks;
    });

    var cidsInTrack = {};
    keys.forEach(function (k) {
      var p = k.split('|');
      if (p[2] !== role || p[3] !== g || p[1] !== S) return;
      (feasIdx.index[k] || []).forEach(function (f) {
        if (!cidsInTrack[f.cid]) cidsInTrack[f.cid] = {};
        cidsInTrack[f.cid][p[0]] = k; // day -> cellKey
      });
    });

    Object.keys(cidsInTrack).forEach(function (cid) {
      var dayList = Object.keys(cidsInTrack[cid]).sort();
      var i = 0;
      while (i < dayList.length) {
        var start = dayList[i];
        var seqDays = [start];
        var seqCells = [cidsInTrack[cid][start]];
        var cur = start;
        var gotNext = true;
        while (gotNext) {
          var nb = _1dates_neighbors(cur).next;
          if (nb && cidsInTrack[cid][nb]) {
            seqDays.push(nb);
            seqCells.push(cidsInTrack[cid][nb]);
            cur = nb;
          } else {
            gotNext = false;
          }
        }
        runs.push({ cid: cid, shift: S, ymds: seqDays, cells: seqCells, role: role, gender: g });
        i += seqDays.length;
      }
    });
  });

  var rawCount = runs.length;
  runs = runs.filter(function (r) { return r.ymds.length >= 2; });

  var seen = {};
  var unique = [];
  runs.forEach(function (r) {
    var sig = r.cid + '|' + r.shift + '|' + r.ymds.join(',');
    if (seen[sig]) return;
    seen[sig] = true;
    unique.push(r);
  });

  log_('built_runs', { tracks: uniqTracks.length, rawCount: rawCount, filteredLen2: runs.length, unique: unique.length });

  return unique;
}











function _1readEmailHistoryCompact(avResolver, lookbackDays) {
  function log_(evt, obj) {
