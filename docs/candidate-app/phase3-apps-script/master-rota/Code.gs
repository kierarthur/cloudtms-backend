  ].join('\n');
}

function _1weightsContinuityEmergency() {
  // Expose separate knobs; keep avoidClashes at 9999 for booked clashes.
  // Potential-clash is a finite penalty; engine functions read this key when present.
  return 'P|weights='
    + 'continuity:1.50,'
    + 'workedStreak:0.90,'
    + 'sameShiftBonus:0.25,'
    + 'emergency:0.90,'
    + 'day2early:0.75,'
    + 'history:0.25,'
    + 'recency:0.15,'
    + 'rolefit:0.20,'
    + 'genderfit:0.10,'
    + 'newPerson:-0.08,'
