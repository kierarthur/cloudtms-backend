/**
 * Send WhatsApp pages of up to 7 shifts each, logging every page's params.
 */
/**
 * Send a batch of confirmed shifts to WATI, choosing the right template
 * for historical vs future.
 *
 * @param {string} fullName   “Surname Firstname” key
 * @param {string} mobile     E.164 mobile, e.g. “44…”
 * @param {Array<Array>} shifts  Array of rows from EmailHistory
 * @param {string} shiftType  “historical” or “future”
 */
/**
 * Splits confirmed shifts into pages of 7, always populates date_1…date_8,
 * and sends via WATI using the right template for future vs historical.
 *
 * @param {string} fullName   Candidate key “Surname Firstname”
 * @param {string} mobile     E.164 mobile (e.g. “441234567890”)
 * @param {Array}  shifts     Array of rows from EmailHistory
 * @param {string} shiftType  “future” or “historical”
 */
function sendWhatsAppForShiftsNew(fullName, mobile, shifts, shiftType) {
  const ss           = SpreadsheetApp.getActive();
  const tz           = ss.getSpreadsheetTimeZone();
  const MAX_PER_PAGE = 7;

  // pick template
  const templateName = (shiftType === 'historical')
    ? 'sussex_history'
    : 'existingbookings';

  // build pages of up to MAX_PER_PAGE
  const pages = [];
  for (let i = 0; i < shifts.length; i += MAX_PER_PAGE) {
    pages.push(shifts.slice(i, i + MAX_PER_PAGE));
  }

  // for each page, build params with date_1…date_8
  pages.forEach((batch, pageIndex) => {
    // start with all slots as “-”
    const params = {
      date_1: `Page ${pageIndex + 1} of ${pages.length}`,
      date_2: '-', date_3: '-', date_4: '-', date_5: '-',
      date_6: '-', date_7: '-', date_8: '-'
    };

    // fill in slots 2… up to batch.length
    batch.forEach((row, j) => {
      // row[1] may be Date or string “dd/MM/yyyy”
      let shortDate;
      if (row[1] instanceof Date) {
        shortDate = Utilities.formatDate(row[1], tz, 'dd/MM');
      } else {
        shortDate = String(row[1]).split('/').slice(0,2).join('/');
      }
      const rawShift   = String(row[2] || '');
      const note       = row[9] || '';  // J = non-standard notes
      // if there's a note, use it in place of LD/N
      const descriptor = note
        ? note
        : (rawShift.toLowerCase().includes('night') ? 'N' : 'LD');
      const hospCode   = getHospitalCode(row[5] || '');
      const ward       = row[6] || '';
      const ref        = row[3] || '';

      params[`date_${j + 2}`] = `${shortDate} ${descriptor} ${hospCode} ${ward} ${ref}`;
    });

    // send via dynamic-template helper
    sendWATITemplateDynamic(mobile, templateName, params, fullName);
    Utilities.sleep(5000);
  });
}


/**
 * Sends a WATI template message with a dynamic template_name.
 *
 * @param {string}      mobile        E.164 mobile
 * @param {string}      templateName  WATI template name
 * @param {Object<string,string>} params  keys date_1…date_8
 * @param {string}      fullName      “Surname Firstname”
 */
function sendWATITemplateDynamic(mobile, templateName, params, fullName) {
  // build broadcast name from surname_firstname_timestamp
  const [surname, firstname] = fullName.trim().split(' ').reverse();
  const ts = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'ddMMyyHHmmss');
  const broadcastName = `${surname}_${firstname}_${ts}`;

  const payload = {
    template_name:  templateName,
    broadcast_name: broadcastName,
    parameters:     Object.entries(params).map(([name, value]) => ({ name, value }))
  };

  const options = {
    method: 'POST',
    headers: {
      Authorization: WATI_TOKEN,
      'Content-Type': 'application/json-patch+json'
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };

  const url = `https://eu-api.wati.io/601205/api/v2/sendTemplateMessage?whatsappNumber=${mobile}`;
  let responseText;
  try {
    responseText = UrlFetchApp.fetch(url, options).getContentText();
  } catch (e) {
    responseText = 'ERROR: ' + e.message;
  }

  return responseText;
}




