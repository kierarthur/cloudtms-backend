// helper to map hospital+ward back to sheet name
function findSheetForHospitalWard(hospital, ward) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheets()
    .find(s => {
      const raw = s.getRange("B1").getDisplayValue();
      const [h,w] = raw.split(":").map(x=>x.trim());
      return h===hospital && w===ward;
    })?.getName();
}
// ✅ FINAL VERSION OF getOutstandingUpdates — FILTERS OUT OLD CANCELLED SHIFTS UNLESS REF CHANGED

// ✅ FINAL VERSION: includes NEW, CANCELLED, UNCHANGED, and NEW REFERENCE NUMBER (even for past dates)

/**
 * Scans each patient sheet and EmailHistory to compute all outstanding updates,
 * now including TIME CHANGE when the sheet’s cell‐note differs from history.
 *
 * @param {string|null} candidateKey  Restrict to one candidate (optional)
 * @return {Array<Object>}            The list of { key, fullName, sheetName, diffs }
 */
/**
 * Returns a list of outstanding updates for each candidate.
 * Carries forward the cell-note as `.note`, and emits a TIME CHANGE diff
 * whenever the live note ≠ the historical note.
 */

function getOutstandingUpdates(candidateKey = null) {
  const ss          = SpreadsheetApp.getActiveSpreadsheet();
  const today       = new Date();
  const todayNoTime = new Date(today.getFullYear(), today.getMonth(), today.getDate());
  const twoMonthsAgo= new Date(todayNoTime);
  twoMonthsAgo.setMonth(twoMonthsAgo.getMonth() - 2);

  // loadOldEmailHistory now includes `.note`
  const historyMap = loadOldEmailHistory();

  const sheets  = ss.getSheets().filter(s => isPatientSheetName(s.getName()));
  const updates = [];

  sheets.forEach(sheet => {
    const sheetName = sheet.getName();
    const rawHW     = sheet.getRange("B1").getDisplayValue();
    const [hospital, ward] = rawHW.split(":").map(s => s.trim());

    const occMap = buildAllOccupants([sheet]);

    Object.entries(occMap).forEach(([key, allShifts]) => {
      if (candidateKey && key.toLowerCase().trim() !== candidateKey.toLowerCase().trim()) {
        return;
      }

      const futureShifts = allShifts.filter(s => parseDateDDMMYYYY(s.date) >= todayNoTime);

      const hist = (historyMap[key] || []).filter(h =>
        h.hospital === hospital &&
        h.ward     === ward     &&
        parseDateDDMMYYYY(h.date) >= twoMonthsAgo
      );
      const histMap = {};
      hist.forEach(h => {
        // include occupant key in code so different people don’t collide
        histMap[`${key}|${h.date}|${h.shift}`] = h;
      });

      const diffs = [];

      // 1) NEW / NEW REFERENCE / EXISTING (future shifts)
      futureShifts.forEach(s => {
        const code = `${key}|${s.date}|${s.shift}`;
        const h    = histMap[code];
        if (!h) {
          diffs.push({
            ...s, hospital, ward,
            comment: "NEW",
            note: sheet.getRange(s.row, s.col).getNote() || ""
          });
        } else {
          const oldRef = String(h.reference || "").trim();
          const newRef = String(s.reference || "").trim();

          if (newRef && newRef !== oldRef) {
            diffs.push({
              ...s, hospital, ward,
              newRef,
              comment: "NEW REFERENCE NUMBER",
              note: sheet.getRange(s.row, s.col).getNote() || ""
            });
          } else {
            diffs.push({ ...s, hospital, ward, _existing: true });
          }
        }
      });

      // 1b) NEW REFERENCE on past shifts (last 4 weeks)
      const fourWeeksAgo = new Date(todayNoTime);
      fourWeeksAgo.setDate(fourWeeksAgo.getDate() - 28);
      allShifts
        .filter(s => {
          const d = parseDateDDMMYYYY(s.date);
          return d >= fourWeeksAgo && d < todayNoTime;
        })
        .forEach(s => {
          const code   = `${key}|${s.date}|${s.shift}`;
          const h      = histMap[code];
          if (h) {
            const oldRef = String(h.reference || "").trim();
            const newRef = String(s.reference || "").trim();
            if (newRef && newRef !== oldRef) {
              diffs.push({
                ...s, hospital, ward,
                newRef,
                comment: "NEW REFERENCE NUMBER",
                note: sheet.getRange(s.row, s.col).getNote() || ""
              });
            }
          }
        });

      // 2) CANCELLED on future dates
      hist.forEach(h => {
        const d = parseDateDDMMYYYY(h.date);
        if (d < todayNoTime) return;
        if (!futureShifts.some(s => s.date === h.date && s.shift === h.shift)) {
          diffs.push({
            date: h.date,
            shift: h.shift,
            jobTitle: h.jobTitle,
            hospital: h.hospital,
            ward: h.ward,
            day: h.day,
            reference: h.reference,
            comment: "CANCELLED",
            note: h.note || ""
          });
        }
      });

      // 3) TIME CHANGE detection (only for those marked _existing)
      allShifts.forEach(s => {
        const idx = diffs.findIndex(d =>
          d._existing &&
          d.date  === s.date &&
          d.shift === s.shift
        );
        if (idx === -1) return;

        const range     = sheet.getRange(s.row, s.col);
        const liveNote  = range.getNote() || "";
        const histEntry = (historyMap[key] || []).find(h =>
          h.date     === s.date &&
          h.shift    === s.shift &&
          h.hospital === hospital &&
          h.ward     === ward
        );
        const histNote  = (histEntry && histEntry.note) || "";

        if (liveNote !== histNote) {
          diffs[idx] = {
            ...s, hospital, ward,
            comment: "TIME CHANGE",
            note: liveNote
          };
        } else {
          delete diffs[idx]._existing;
        }
      });

      // remove any leftover _existing markers
      const finalDiffs = diffs.filter(d => !d._existing);

      if (finalDiffs.length) {
        updates.push({
          key,
          fullName: key.replace(/\b(\w)(\w*)/g, (_, a, b) => a.toUpperCase() + b),
          sheetName,
          diffs: finalDiffs
        });
      }
    });

    // existing “cancelled when no allShifts exist” block
    Object.keys(historyMap).forEach(key => {
      if (occMap[key]) return;
      if (candidateKey && key.toLowerCase().trim() !== candidateKey.toLowerCase().trim()) return;

      const hist2 = (historyMap[key] || []).filter(h =>
        h.hospital === hospital &&
        h.ward     === ward     &&
        parseDateDDMMYYYY(h.date) >= todayNoTime
      );
      const diffs2 = hist2.map(h => ({
        date: h.date,
        shift: h.shift,
        jobTitle: h.jobTitle,
        hospital: h.hospital,
        ward: h.ward,
        day: h.day,
        reference: h.reference,
        comment: "CANCELLED",
        note: h.note || ""
      }));
      if (diffs2.length) {
        updates.push({
          key,
          fullName: key.replace(/\b(\w)(\w*)/g, (_, a, b) => a.toUpperCase() + b),
          sheetName,
          diffs: diffs2
        });
      }
    });
  });

  // Sort by candidate then earliest diff date
  updates.sort((a, b) => {
    const nc = a.fullName.localeCompare(b.fullName);
    if (nc !== 0) return nc;
    return parseDateDDMMYYYY(a.diffs[0].date)
         - parseDateDDMMYYYY(b.diffs[0].date);
  });

  return updates;
}



