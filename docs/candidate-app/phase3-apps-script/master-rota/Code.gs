 * logging every comparison—including job/gender validation.
 */
/**
 * Given an array of selected cells and a candidate name,
 * returns an array of conflict objects:
 * { date, a1, shift, conflict, allowed, reason }
 */
/**
 * Given an array of selected cells and a candidate name,
 * returns an array of conflict objects and logs every check.
 */
/**
 * Given an array of selected cells and a candidate name,
 * returns an array of conflict objects and logs every check.
 */
/**
 * Given an array of selected cells and a candidate name,
 * returns an array of conflict objects and logs every check.
 */
function checkBookingConflicts(cells, candidateName) {
  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const tz    = ss.getSpreadsheetTimeZone();
  const sheet = ss.getActiveSheet();

  // Inputs used by logic
  const occupantMap   = buildOccupantMap();            // existing bookings
  const candidateInfo = lookupCandidateInfo(candidateName);

  // 0) Fast exits
  if (!cells || !cells.length) return [];

  // 1) Precompute each selected cell’s dateKey & shift-type (with time-based fallback)
  const newEntries = cells.map(c => {
    const dateStr  = c.date || "";
    const shiftStr = c.shift || "";
    const dateObj  = parseDateDDMMYYYY(dateStr);
    const dateKey  = Utilities.formatDate(dateObj, tz, 'yyyyMMdd'); // e.g., "20250814"

    // Night/Day detection:
    // 1) If label explicitly contains "night" or "day", use that.
    // 2) Otherwise, parse two times and mark night if it crosses midnight (start > finish).
    let isNight;
    const lower = (shiftStr || "").toLowerCase();
    if (lower.includes('night')) {
      isNight = true;
    } else if (lower.includes('day')) {
      isNight = false;
    } else {
      // Try to extract two times like "21:00 ... 08:00" or "1930-0800"
      const m = (shiftStr || '').match(/(\d{1,2}):?(\d{2})\D+(\d{1,2}):?(\d{2})/);
      if (m) {
        const sh = Number(m[1]), sm = Number(m[2]);
        const fh = Number(m[3]), fm = Number(m[4]);
        const start  = sh * 60 + sm;
        const finish = fh * 60 + fm;
        isNight = start > finish; // crosses midnight ⇒ night
      } else {
        // Default to day if we cannot determine
        isNight = false;
      }
    }

    return { c, dateObj, dateKey, isNight, shiftStr };
  });

  // 1b) Build quick lookup structures for "NEW vs NEW" checks (O(n))
  const newByKey    = new Map();       // dateKey -> [{idx,isNight}]
  const newDaySet   = new Set();       // dateKey that has a DAY new booking
  const newNightSet = new Set();       // dateKey that has a NIGHT new booking
  newEntries.forEach((e, idx) => {
    const arr = newByKey.get(e.dateKey);
    if (arr) arr.push({ idx, isNight: e.isNight });
    else newByKey.set(e.dateKey, [{ idx, isNight: e.isNight }]);
    (e.isNight ? newNightSet : newDaySet).add(e.dateKey);
  });

  // 2) SIX-DAY LIMIT BREACH (WARNING) – batch-level (unchanged logic)
  const keyToEpochDay = k => {
    // k = "yyyyMMdd"
    const y = +k.slice(0, 4), m = +k.slice(4, 6), d = +k.slice(6, 8);
    const dt = new Date(y, m - 1, d);
    return Math.floor(dt.getTime() / 86400000);
  };
  const findRunsOverSix = (keysArr) => {
    if (!keysArr.length) return [];
    const sorted = keysArr.slice().sort((a, b) => keyToEpochDay(a) - keyToEpochDay(b));
    const runs = [];
    let startIdx = 0;
    for (let i = 1; i <= sorted.length; i++) {
      const prev = keyToEpochDay(sorted[i - 1]);
      const cur  = i < sorted.length ? keyToEpochDay(sorted[i]) : null;
      const contiguous = (cur !== null) && (cur - prev === 1);
      if (!contiguous) {
        const run = sorted.slice(startIdx, i);
        if (run.length > 6) runs.push(run);
        startIdx = i;
      }
    }
    return runs;
  };

  const candKey = (candidateName || '').trim().toLowerCase();
  const candOcc = occupantMap[candKey] || {}; // cache per-candidate map

  const proposedKeys = Array.from(new Set(newEntries.map(e => e.dateKey)));
  const existingForCand = Object.keys(candOcc);

  const unionKeys = Array.from(new Set(existingForCand.concat(proposedKeys)));
  const unionRunsOverSix    = findRunsOverSix(unionKeys);
  const proposedRunsOverSix = findRunsOverSix(proposedKeys);

  const warnKeys = new Set();
  unionRunsOverSix.forEach(run => run.forEach(k => { if (proposedKeys.indexOf(k) >= 0) warnKeys.add(k); }));
  proposedRunsOverSix.forEach(run => run.forEach(k => warnKeys.add(k)));

  // 3) Batch-read header row 3 once (for role/gender), not per entry
  const cols = Array.from(new Set(newEntries.map(e => e.c.col))).sort((a,b) => a - b);
  let headerValByCol = {};
  if (cols.length) {
    const minCol = cols[0];
    const maxCol = cols[cols.length - 1];
    const width  = maxCol - minCol + 1;
    const headerRow = sheet.getRange(3, minCol, 1, width).getValues()[0];
    cols.forEach(col => { headerValByCol[col] = (headerRow[col - minCol] || "").toString(); });
  }

  // 4) Per-entry checks (A/B/C), then merge D-warning
  const results = newEntries.map((entry) => {
    const c = entry.c;
    let conflict = false;
    let allowed  = true;
    let reason   = '';

    // Precompute adjacency keys
    const prevKey = Utilities.formatDate(
      new Date(entry.dateObj.getFullYear(),
               entry.dateObj.getMonth(),
               entry.dateObj.getDate() - 1),
      tz, 'yyyyMMdd'
    );
    const nextKey = Utilities.formatDate(
      new Date(entry.dateObj.getFullYear(),
               entry.dateObj.getMonth(),
               entry.dateObj.getDate() + 1),
      tz, 'yyyyMMdd'
    );

    // ——— A) NEW vs NEW ———
    // A1: same-day duplicate among new selections
    const sameArr = newByKey.get(entry.dateKey) || [];
    if (sameArr.length > 1) {
      conflict = true;
      allowed  = false;
      reason   = 'Clashes with another new booking on same day';
    }
    // A2: adjacency clash among new selections (night→day or day←night)
    if (!conflict) {
      if (entry.isNight) {
        if (newDaySet.has(nextKey)) {
          conflict = true; allowed = false;
          reason   = 'Clashes (night→day) with another new booking';
        }
      } else {
        if (newNightSet.has(prevKey)) {
          conflict = true; allowed = false;
          reason   = 'Clashes (day→night) with another new booking';
        }
      }
    }

    // ——— B1) EXISTING booking same-day ———
    if (!conflict) {
      const existing = candOcc[entry.dateKey];
      if (existing) {
        conflict = true; allowed = false;
        reason   = 'Already booked that day';
      }
    }

    // ——— B2) EXISTING booking adjacency ———
    if (!conflict) {
      const prevInfo = candOcc[prevKey];
      const nextInfo = candOcc[nextKey];

      if (!entry.isNight && prevInfo && prevInfo.shift === 'night') {
        conflict = true; allowed = false;
        reason   = 'Worked NIGHT previous day (existing booking)';
      }
      else if (entry.isNight && nextInfo && nextInfo.shift === 'day') {
        conflict = true; allowed = false;
        reason   = 'Has DAY next day (existing booking)';
      }
    }

    // ——— C) JOB/GENDER validation ———
    if (!conflict && candidateInfo) {
      const headerVal      = headerValByCol[c.col] || "";
      const requiredRole   = parseJobTitleFromHeader(headerVal);
      let   requiredGender = 'any';
      if (/female/i.test(headerVal) && !/\(male or female\)/i.test(headerVal)) requiredGender = 'female';
      else if (/male/i.test(headerVal)   && !/\(male or female\)/i.test(headerVal)) requiredGender = 'male';

      const occRole   = (candidateInfo.jobTitle||"").trim().toUpperCase();
      const occGender = (candidateInfo.gender||"").trim().toLowerCase();

      if (requiredRole === 'HCA' && occRole === 'RMN') {
        conflict = true; allowed = true;
        reason   = 'RMN being booked into HCA shift (warning)';
      }
      else if (requiredRole === 'RMN' && occRole !== 'RMN') {
        conflict = true; allowed = false;
        reason   = 'Shift requires RMN';
      }

      if (!conflict && requiredGender !== 'any' && occGender !== requiredGender) {
        conflict = true; allowed = false;
        reason   = `Shift requires ${requiredGender}`;
      }
    }

    // ——— D) Merge the SIX-DAY LIMIT BREACH warning ———
    if (!(conflict && allowed === false)) { // not a hard CANNOT
      if (warnKeys.has(entry.dateKey)) {
        const priorReason = reason;
        conflict = true;          // show WARNING badge
        allowed  = true;          // still bookable
        reason   = priorReason ? (priorReason + ' | SIX DAY LIMIT BREACH') : 'SIX DAY LIMIT BREACH';
      }
    }

    return {
      date:     c.date,
      a1:       c.a1,
      shift:    c.shift,
      conflict: conflict,
      allowed:  allowed,
      reason:   reason
    };
  });

  return results;
}




