// STEP 1: load & filter, return array of selected candidates
function processNewAdmissionStep1(form) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  // load candidate list
  const rows = ss.getSheetByName('Candidate List').getDataRange().getValues();
  const hdrs = rows.shift().map(h => h.toString().toLowerCase());
  const idx = {
    surname:   hdrs.indexOf('surname'),
    firstname: hdrs.indexOf('first name') >= 0
                  ? hdrs.indexOf('first name')
                  : hdrs.indexOf('firstname'),
    phone:     hdrs.indexOf('telephone') >= 0
                  ? hdrs.indexOf('telephone')
                  : hdrs.indexOf('phone'),
    jobTitle:  hdrs.indexOf('job title'),
    gender:    hdrs.indexOf('gender'),
    tier:      hdrs.indexOf('tier')
  };
  const dataMap = {};
  rows.forEach(r => {
    const s = (r[idx.surname]   || '').toString().trim();
    const f = (r[idx.firstname] || '').toString().trim();
    let   p = ('' + (r[idx.phone] || '')).replace(/[^\d]/g, '');
    const j = (r[idx.jobTitle]  || '').toString().trim().toUpperCase();
    const g = (r[idx.gender]    || '').toString().trim().toLowerCase();
    const t = Number(r[idx.tier]) || 0;
    if (!s || !f || !p) return;
    if (p.startsWith('0')) p = '44' + p.slice(1);
    else if (!p.startsWith('44')) p = '44' + p;
    dataMap[`${s} ${f}`.toLowerCase()] = { surname: s, firstname: f, phone: p, jobTitle: j, gender: g, tier: t };
  });

  const candKeys = Object.keys(dataMap);

  // define filters
  const filters = [
    { key: 'Male_RMN',   role: 'RMN', gender: 'male'   },
    { key: 'Female_RMN', role: 'RMN', gender: 'female' },
    { key: 'Any_RMN',    role: 'RMN', gender: null     },
    { key: 'Male_HCA',   role: 'HCA', gender: 'male'   },
    { key: 'Female_HCA', role: 'HCA', gender: 'female' },
    { key: 'Any_HCA',    role: 'HCA', gender: null     }
  ];

  // select
  const sendRoles = {};
  filters.forEach(f => sendRoles[f.key] = Boolean(form[f.key]));

  const selected = [];
  candKeys.forEach(k => {
    const info = dataMap[k];
    for (const f of filters) {
      if (sendRoles[f.key]) {
        const roleOk   = info.jobTitle === f.role;
        const genderOk = f.gender ? info.gender === f.gender : true;
        if (roleOk && genderOk) {
          selected.push(info);
          break;
        }
      }
    }
  });

  return selected;
}

// STEP 2: build the Emergency sheet, return its name
function processNewAdmissionStep2(args) {
  const { form, selected } = args;
  const ss       = SpreadsheetApp.getActiveSpreadsheet();
  const tz       = ss.getSpreadsheetTimeZone();
  const today    = new Date();
  const tomorrow = new Date(today.getTime() + 24 * 3600 * 1000);
  const dayAfter = new Date(today.getTime() + 2 * 24 * 3600 * 1000);

  // timestamp for sheet name
  const ts        = Utilities.formatDate(new Date(), tz, "yyyyMMdd_HHmmss");
  const sheetName = `Emergency Whatsapp—${form.ward}—${ts}`;
  const out       = ss.insertSheet(sheetName);

  // formatted date strings
  const todayFmt     = Utilities.formatDate(today, tz, "ddMMyyyy");
  const tomorrowFmt  = Utilities.formatDate(tomorrow, tz, "ddMMyyyy");
  const dayAfterFmt  = Utilities.formatDate(dayAfter, tz, "ddMMyyyy");
  const dayAfterHeader = `DAT-LD ${dayAfterFmt}`;

  // build header row
  const hdr = [
    "Surname",
    "First Name",
    "Phone",
    "Job Title",
    "Gender",
    "Tier",
    form.mode === "Immediate Start" ? "Can leave now" : null,
    `Tonight ${todayFmt}`,
    `Tomorrow LD ${tomorrowFmt}`,
    `Tomorrow NT ${tomorrowFmt}`,
    dayAfterHeader,
    "Next Seven Days"
  ].filter(h => h !== null);

  // find the 1-based index of the DAT-LD column
  const dayAfterCol = hdr.indexOf(dayAfterHeader) + 1;

  // write headers
  out.appendRow(hdr);

  // write data rows
  selected.forEach(o => {
    const row = [
      o.surname,
      o.firstname,
      o.phone,
      o.jobTitle,
      o.gender,
      o.tier
    ];
    if (form.mode === "Immediate Start") row.push("");
    // blank placeholders for the date columns
    // we know there are exactly 5 date-columns in hdr
    row.push("", "", "", "", "");
    out.appendRow(row);
  });

  // style & filter
  out.getRange(1, 1, 1, hdr.length).setFontWeight("bold");
  out.setFrozenRows(1);
  if (out.getFilter()) out.getFilter().remove();
  out.getRange(1, 1, out.getMaxRows(), hdr.length).createFilter();

  // ── ensure DAT-LD column is Plain Text ──
  out.getRange(1, dayAfterCol, out.getMaxRows(), 1)
     .setNumberFormat("@");
  // ── rewrite the header cell itself as "DAT-LD <date>" ──
  out.getRange(1, dayAfterCol).setValue(dayAfterHeader);

  // sort & auto-resize
  sortEmergencySheet(out);

  const lastRow = out.getLastRow();
  const lastCol = hdr.length;
  for (let c = 1; c <= lastCol; c++) {
    const vals  = out.getRange(1, c, lastRow).getDisplayValues().flat();
    const width = vals.reduce((m, v) => Math.max(m, v.length), 0);
    out.setColumnWidth(c, (width + 3) * 7);
  }

  return sheetName;
}



