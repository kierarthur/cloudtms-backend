/**
 * Reads your Candidate List sheet and returns an array of
 * { fullName, jobTitle, gender, tier } objects.
 */
function getCandidateList() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Candidate List");
  if (!sheet) return [];

  const data = sheet.getDataRange().getValues();
  // header row → find Gender & Tier columns
  const hdrs      = data[0].map(h => h.toString().trim().toLowerCase());
  const genderCol = hdrs.indexOf("gender");
  const tierCol   = hdrs.indexOf("tier");
  
  const result = [];
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const surname  = (row[0] || "").toString().trim();
    const firstname= (row[1] || "").toString().trim();
    const jobTitle = (row[4] || "").toString().trim();
    const gender   = genderCol >= 0
                   ? (row[genderCol] || "").toString().trim().toLowerCase()
                   : "any";
    const tier     = tierCol   >= 0
                   ? Number(row[tierCol]) || 0
                   : 0;

    const fullName = `${surname} ${firstname}`.trim();
    if (fullName) {
      result.push({ fullName, jobTitle, gender, tier });
    }
  }
  return result;
}



