  sh.getRange(1,1,1,headers.length).setValues([headers]).setFontWeight('bold');
  sh.getRange(2,1,rows.length,headers.length).setValues(rows);
  sh.autoResizeColumns(1, headers.length);
}

/** ===== LOW-LEVEL HELPERS ===== */

function _safeStr_(v){ return (v == null) ? '' : String(v).trim(); }

function _normName_(s){
  return _safeStr_(s).toLowerCase().replace(/\s+/g,' ').trim();
}

function _normKey_(surname, firstname){
  var s = _normName_(surname);
  var f = _normName_(firstname);
  return (s && f) ? (s + '|' + f) : '';
}

function _escapeHtml_(s){
  return String(s)
    .replace(/&/g,'&amp;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;')
    .replace(/'/g,'&#39;');
}

function _escapeAttr_(s){
  // Basic attribute escaping (same as HTML)
  return _escapeHtml_(s);
}

/**
 * Normalize UK mobile to WATI format 44XXXXXXXXXX.
 * Returns '' if invalid.
 */
function _normalizeUkPhoneForWati_(raw) {
  var digits = (raw || '').replace(/[^\d]/g,'');
  if (!digits) return '';
  if (/^0\d{10}$/.test(digits)) {
    return '44' + digits.slice(1);
  }
  if (/^44\d{9,}$/.test(digits)) {
    return digits;
  }
  return '';
}

/**
 * Resolve latest "Active" token by CreatedAt; otherwise provide reason.
 * @param {Array<{tokenUrl:string,status:string,createdAt:Date}>} arr
 * @return {{tokenUrl?:string, reason?:string}}
 */
function _resolveActiveToken_(arr) {
  if (!Array.isArray(arr) || !arr.length) {
    return { reason: 'No Active Token issued for candidate' };
  }
  var active = arr.filter(function(x){ return String(x.status || '').toLowerCase() === 'active'; });
  if (active.length) {
    active.sort(function(a,b){
      var at = a.createdAt ? a.createdAt.getTime() : 0;
      var bt = b.createdAt ? b.createdAt.getTime() : 0;
      return bt - at;
    });
    return { tokenUrl: active[0].tokenUrl || '' };
  }
  // No Active; check for Revoked
  var revoked = arr.some(function(x){ return String(x.status || '').toLowerCase() === 'revoked'; });
  if (revoked) {
    return { reason: 'Token revoked, issue new one before proceeding' };
  }
  return { reason: 'No Active Token issued for candidate' };
}

/**
 * Coerce API item to a coarse status: success/queued/failed
 */
function _coerceStatus_(apiItem) {
  if (!apiItem) return 'failed';
  var s = '';
  if (apiItem.status) s = String(apiItem.status).toLowerCase();
  else if (apiItem.result) s = String(apiItem.result).toLowerCase();
  else if (apiItem.code) s = String(apiItem.code).toLowerCase();

  if (s.indexOf('success') >= 0 || s === 'ok' || s === 'sent' || s === 'delivered') return 'success';
  if (s.indexOf('queue') >= 0 || s === 'accepted' || s === 'created') return 'queued';
  if (!s && (apiItem.ok === true)) return 'success';
  return 'failed';
}

/**
 * Extract a human-readable reason from API item
 */
function _extractReason_(apiItem) {
  if (!apiItem) return '';
  var fields = ['message','error','reason','detail','description'];
  for (var i=0; i<fields.length; i++) {
    var f = fields[i];
    if (apiItem[f]) return String(apiItem[f]);
  }
  if (apiItem.body && typeof apiItem.body === 'string') return apiItem.body.substring(0, 300);
  if (apiItem.text && typeof apiItem.text === 'string') return apiItem.text.substring(0, 300);
  return '';
}
function ai_syncAvailabilityWithCandidates() {
  // ────────────────────────── NORMALISERS ──────────────────────────
  function normNameKey(sur, fir) {
    const s = (String(sur||'') + String(fir||''));
    const deaccent = s.normalize('NFD').replace(/\p{Diacritic}/gu, '');
    return deaccent.replace(/[^A-Za-z0-9]/g, '').toLowerCase();
  }
  function normPhone(s) {
    const digits = String(s || '').replace(/\D+/g, '');
    if (!digits) return '';
    if (digits.startsWith('44') && digits.length === 12) return '0' + digits.slice(2);
    if (digits.length === 10 && digits[0] !== '0')      return '0' + digits;
    if (digits.length === 11 && digits[0] === '0')      return digits;
    return digits[0] === '0' ? digits : ('0' + digits);
  }
  function normEmail(s) { return String(s||'').trim().toLowerCase(); }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();

  // Read TEST flag from Script Properties (set by ai_dailyRefresh)
  const props = PropertiesService.getScriptProperties();
  const DAILY_REFRESH_TEST = String(props.getProperty('DAILY_REFRESH_TEST') || 'false') === 'true';

  try {
    const av = ss.getSheetByName(SH_AVAIL);
    const cl = ss.getSheetByName(SH_CANDIDATES);
    if (!av || !cl) return;

    // Ensure Availability phone column is Plain text
    const phoneCol = 4; // column D
    const existingRows = Math.max(av.getLastRow() - 1, 0);
    if (existingRows > 0) {
      av.getRange(2, phoneCol, existingRows, 1).setNumberFormat('@');
    }

    function getWindowDateCount() {
      const lastCol = av.getLastColumn();
      return Math.max(0, lastCol - 6);
    }

    // ────────────────────────── LOAD CANDIDATE LIST ──────────────────────────
    const clVals = cl.getDataRange().getValues();
    if (clVals.length <= 1) return;

    const ch = clVals[0].map(s => (s || '').toString().toLowerCase());
    const iSur = ch.indexOf('surname');
    const iFir = ch.indexOf('first name');
    const iEm  = ch.indexOf('email');
    const iPh  = ch.indexOf('telephone');
    const iJob = ch.indexOf('job title');
    const iGen = ch.indexOf('gender');

    const CL_names = new Set();
    const CL_by_name = {};     // nameKey -> { sur, fir, email, phone, job, gender }
    const CL_by_phone = {};    // normPhone -> [nameKey, ...]
    let clBlankNameKey = 0;

    for (let r = 1; r < clVals.length; r++) {
      const row = clVals[r];
      const sur = (iSur >= 0 ? row[iSur] : row[0]) || '';
      const fir = (iFir >= 0 ? row[iFir] : row[1]) || '';
      const em  = (iEm  >= 0 ? row[iEm]  : row[2]) || '';
      const ph0 = (iPh  >= 0 ? row[iPh]  : row[3]);
      const job = (iJob >= 0 ? row[iJob] : row[4]) || '';
      const gen = (iGen >= 0 ? row[iGen] : row[5]) || '';

      const nameKey = normNameKey(sur, fir);
      if (!nameKey) clBlankNameKey++;

      const phone = normPhone(ph0);
      CL_names.add(nameKey);
      if (!CL_by_name[nameKey]) CL_by_name[nameKey] = { sur, fir, email: em, phone, job, gender: gen };
      if (phone) (CL_by_phone[phone] = CL_by_phone[phone] || []).push(nameKey);
    }

    // ────────────────────────── LOAD AV (SAFE WHEN EMPTY) ──────────────────────────
    const lastCol = av.getLastColumn();
    const bodyRows0 = Math.max(av.getLastRow() - 1, 0);
    let avVals = [];
    if (bodyRows0 > 0) {
      avVals = av.getRange(2, 1, bodyRows0, Math.max(6, lastCol)).getDisplayValues();
    }

    const AV_rows = [];           // { rowIdx, nameKey, sur, fir, email, phone, job, gender }
    const AV_names_to_row = {};   // nameKey -> rowIdx
    let avBlankNameKey = 0;

    for (let i = 0; i < avVals.length; i++) {
      const r = avVals[i];
      const sur = (r[0] || '');
      const fir = (r[1] || '');
      const email = (r[2] || '');
      const phone = normPhone(r[3]);
      const job   = (r[4] || '');
      const gender= (r[5] || '');
      const nameKey = normNameKey(sur, fir);
      const rowIdx = i + 2;

      AV_rows.push({ rowIdx, nameKey, sur, fir, email, phone, job, gender });
      if (!nameKey) { avBlankNameKey++; continue; }
      AV_names_to_row[nameKey] = rowIdx;
    }

    // ────────────────────────── DETERMINE DELETIONS (NAME-ONLY) ──────────────────────────
    const toDelete = [];
    for (const row of AV_rows) {
      if (!row.nameKey) continue;
      if (!CL_names.has(row.nameKey)) {
        toDelete.push(row);
      }
    }

    // ────────────────────────── CONTACT / IDENTITY UPDATES (NAME MATCH ONLY) ──────────────────────────
    const contactUpdates = [];   // { rowIdx, nameKey, oldEmail, newEmail, oldPhone, newPhone }
    const identityUpdates = [];  // { rowIdx, before:[], after:[] }

    for (const row of AV_rows) {
      if (!row.nameKey) continue;
      const clEnt = CL_by_name[row.nameKey];
      if (!clEnt) continue;

      const desired = [
        String(clEnt.sur || ''),
        String(clEnt.fir || ''),
        String(clEnt.email || ''),
        String(clEnt.phone || ''),
        String(clEnt.job || ''),
        String(clEnt.gender || '')
      ];
      const current = [
        String(row.sur || ''),
        String(row.fir || ''),
        String(row.email || ''),
        String(row.phone || ''),
        String(row.job || ''),
        String(row.gender || '')
      ];

      let changedIdentity = false;
      for (let i = 0; i < 6; i++) {
        if (current[i] !== desired[i]) { changedIdentity = true; break; }
      }
      if (changedIdentity) {
        identityUpdates.push({ rowIdx: row.rowIdx, before: current, after: desired });
      }

      const newEmail = normEmail(clEnt.email);
      const curEmail = normEmail(row.email);
      const newPhone = normPhone(clEnt.phone);
      const curPhone = normPhone(row.phone);

      const upd = { rowIdx: row.rowIdx, nameKey: row.nameKey };
      let any = false;

      if (newEmail && newEmail !== curEmail) {
        upd.oldEmail = row.email; upd.newEmail = clEnt.email; any = true;
      }
      if (newPhone && newPhone !== curPhone) {
        upd.oldPhone = row.phone; upd.newPhone = clEnt.phone; any = true;
      }
      if (any) contactUpdates.push(upd);
    }

    // ────────────────────────── DUPLICATE PHONES IN CL ──────────────────────────
    const dupPhones = [];
    Object.keys(CL_by_phone).forEach(ph => {
      const arr = Array.from(new Set(CL_by_phone[ph].filter(Boolean)));
      if (ph && arr.length > 1) {
        const names = arr.map(k => `${CL_by_name[k].sur} ${CL_by_name[k].fir}`);
        dupPhones.push({ phone: ph, candidates: names });
      }
    });

    // ────────────────────────── EMAIL (only if any planned actions) ──────────────────────────
    const totalDeletes = toDelete.length;
    const totalUpdates = contactUpdates.length;
    const totalDupPhs  = dupPhones.length;

    const ts = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd HH:mm');
    const subject = `Availability sync report — ${ts} (deleted: ${totalDeletes}, updates: ${totalUpdates}, dup phones: ${totalDupPhs})`;

    let emailOk = true;
    try {
      if (!String(DAILY_REFRESH_TEST).toLowerCase().includes('true')) {
        if (totalDeletes || totalUpdates || totalDupPhs) {
          postToDoPostSendEmail(
            'kier@arthur-rai.co.uk',
            subject,
            '', // fallback
            { htmlBody: (function(){ return ''; })(),
              metadata: { deletions: totalDeletes, updates: totalUpdates, dupPhones: totalDupPhs } }
          );
        }
      }
    } catch (e) {
      emailOk = false;
    }

    // ────────────────────────── APPLY DELETIONS (only if email succeeded or TEST) ──────────────────────────
    if ((emailOk || DAILY_REFRESH_TEST) && toDelete.length) {
      const lastColNow = av.getLastColumn();
      toDelete.sort((a,b) => b.rowIdx - a.rowIdx).forEach(row => {
        try {
          av.getRange(row.rowIdx, 1, 1, lastColNow).clearNote();
          av.deleteRow(row.rowIdx);
        } catch (e) {}
      });
    }

    // ────────────────────────── APPLY IDENTITY + CONTACT UPDATES & APPENDS ──────────────────────────
    const bodyRowsAfterDeletes = Math.max(av.getLastRow() - 1, 0);

    // Seed when empty
    if (bodyRowsAfterDeletes === 0) {
      const dateCols = getWindowDateCount();
      CL_names.forEach(nk => {
        const ent = CL_by_name[nk];
        av.appendRow([
          String(ent.sur || ''), String(ent.fir || ''), String(ent.email || ''), String(ent.phone || ''),
          String(ent.job || ''), String(ent.gender || '')
        ]);
        const newRow = av.getLastRow();
        av.getRange(newRow, 4).setNumberFormat('@').setValue(String(ent.phone || ''));
        if (dateCols > 0) {
          av.getRange(newRow, 7, 1, dateCols)
            .setValues([new Array(dateCols).fill('')])
            .setBackgrounds([new Array(dateCols).fill('#ffffff')]);
        }
      });
      return;
    }

    // Normal path when there are rows: rebuild map for name→row
    const avLastCol2 = av.getLastColumn();
    const bodyRows2  = Math.max(av.getLastRow() - 1, 0);
    let avVals2 = [];
    if (bodyRows2 > 0) {
      avVals2 = av.getRange(2, 1, bodyRows2, Math.max(6, avLastCol2)).getDisplayValues();
    }
    const nameToRow2 = {};
    for (let i = 0; i < avVals2.length; i++) {
      const sur = (avVals2[i][0] || ''), fir = (avVals2[i][1] || '');
      const nk = normNameKey(sur, fir);
      nameToRow2[nk] = i + 2;
    }

    // Append any missing CL names
    const dateCols2 = getWindowDateCount();
    CL_names.forEach(nk => {
      if (!nameToRow2[nk]) {
        const ent = CL_by_name[nk];
        av.appendRow([
          String(ent.sur || ''), String(ent.fir || ''), String(ent.email || ''), String(ent.phone || ''),
          String(ent.job || ''), String(ent.gender || '')
        ]);
        const newRow = av.getLastRow();
        av.getRange(newRow, 4).setNumberFormat('@').setValue(String(ent.phone || ''));
        if (dateCols2 > 0) {
          av.getRange(newRow, 7, 1, dateCols2)
            .setValues([new Array(dateCols2).fill('')])
            .setBackgrounds([new Array(dateCols2).fill('#ffffff')]);
        }
        nameToRow2[nk] = newRow;
      }
    });

    // Identity updates (A..F)
    identityUpdates.forEach(u => {
      const targetNk = normNameKey(u.after[0], u.after[1]);
      const rowIdx = nameToRow2[targetNk] || u.rowIdx;
      try {
        av.getRange(rowIdx, 1, 1, 6).setValues([u.after]);
        av.getRange(rowIdx, 4).setNumberFormat('@').setValue(String(u.after[3] || ''));
      } catch(e) {}
    });

    // Contact updates (email/phone only)
    contactUpdates.forEach(u => {
      const rowIdx = nameToRow2[u.nameKey];
      if (!rowIdx) return;
      const rowRange = av.getRange(rowIdx, 1, 1, 6);
      const cur = rowRange.getValues()[0];
      let changed = false;
      if (u.oldEmail!=null && u.newEmail!=null) { cur[2] = String(u.newEmail); changed = true; }
      if (u.oldPhone!=null && u.newPhone!=null) { cur[3] = String(normPhone(u.newPhone)); changed = true; }
      if (changed) {
        try {
          rowRange.setValues([cur]);
          av.getRange(rowIdx, 4).setNumberFormat('@').setValue(String(cur[3] || ''));
        } catch(e) {}
      }
    });

  } catch (err) {
    // Log details to Executions without changing behaviour
    try {
      var ctx = {};
      try { ctx.spreadsheetId = SpreadsheetApp.getActiveSpreadsheet().getId(); } catch (_) {}
      try { ctx.tz = tz; } catch (_) {}
      try { ctx.DAILY_REFRESH_TEST = DAILY_REFRESH_TEST; } catch (_) {}
      Logger.log('[' + new Date().toISOString() + '] ai_syncAvailabilityWithCandidates ERROR ' + JSON.stringify({
        name: err && err.name,
        message: err && err.message,
        stack: (err && err.stack) || '',
        context: ctx
      }));
    } catch (_) {}
    // swallow errors (behaviour unchanged)
  }
}


/***** Lightweight logging helpers (do not change functionality) *****/
function __nowIso() {
  try { return new Date().toISOString(); } catch (_) { return ''; }
}
function __safeStr(v) {
  try {
    return JSON.stringify(v, (k, val) => {
      if (val instanceof Date) return `DATE:${val.toISOString()}`;
      if (typeof val === 'function') return `[Function ${val.name || 'anonymous'}]`;
      if (typeof val === 'object' && val !== null) {
        // Avoid circulars
        if (val.__seen__) return '[Circular]';
        Object.defineProperty(val, '__seen__', { value: true, enumerable: false });
      }
      return val;
    });
  } catch (e) { return `[unserializable:${e && e.message}]`; }
}
function __log(label, data) {
  try {
    Logger.log(`[${__nowIso()}] ${label} ${data !== undefined ? __safeStr(data) : ''}`);
  } catch (_) {
    // Fallback
    try { Logger.log(`[${__nowIso()}] ${label}`); } catch (__) {}
  }
}
function __stepWrap(stepName, fn /*, ...args */) {
  const args = Array.prototype.slice.call(arguments, 2);
  const t0 = Date.now();
  __log('STEP_START', { step: stepName });
  try {
    const res = fn.apply(null, args);
    __log('STEP_OK', { step: stepName, ms: Date.now() - t0 });
    return res;
  } catch (e) {
    __log('STEP_ERR', { step: stepName, ms: Date.now() - t0, name: e && e.name, message: e && e.message, stack: (e && e.stack) || '' });
    throw e; // rethrow to keep identical behaviour
  }
}

/***** ORIGINAL CODE with instrumentation only (behaviour unchanged) *****/
function ai_dailyRefresh() {
  const __T0 = Date.now();
  __log('FUNC_ENTER', { fn: 'ai_dailyRefresh' });

  // ────────────────────────── TEST MODE SWITCH ──────────────────────────
  const props = PropertiesService.getScriptProperties();
  const DAILY_REFRESH_TEST = false; // <— flip to false to return to real behaviour
  props.setProperty('DAILY_REFRESH_TEST', DAILY_REFRESH_TEST ? 'true' : 'false');

  let simToday;
  if (DAILY_REFRESH_TEST) {
    let off = Number(props.getProperty('DAILY_REFRESH_TEST_OFFSET') || 0);
    off += 1; // each run simulates 1 more day
    props.setProperty('DAILY_REFRESH_TEST_OFFSET', String(off));

    const realToday = new Date();
    simToday = new Date(realToday.getFullYear(), realToday.getMonth(), realToday.getDate());
    simToday.setDate(simToday.getDate() + off);
    __log('TEST_MODE', { DAILY_REFRESH_TEST, offset: off, simToday: simToday && simToday.toISOString() });
  } else {
    props.deleteProperty('DAILY_REFRESH_TEST_OFFSET');
    const realToday = new Date();
    simToday = new Date(realToday.getFullYear(), realToday.getMonth(), realToday.getDate());
    __log('TEST_MODE', { DAILY_REFRESH_TEST, simToday: simToday && simToday.toISOString() });
  }

  // Orchestrate a coherent update window (we KEEP API emits even in test mode)
  const runId = (typeof _newRunId === 'function') ? _newRunId('AVREF') : ('AVREF-' + Date.now());
  __log('RUN_CTX', {
    runId,
    tz: (() => { try { return SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone(); } catch (_) { return 'unknown'; } })(),
    spreadsheetId: (() => { try { return SpreadsheetApp.getActiveSpreadsheet().getId(); } catch (_) { return 'unknown'; } })(),
  });

  const lock = LockService.getDocumentLock();
  const gotLock = lock.tryLock(30000);
  __log('LOCK_TRY', { gotLock });

  let __ok = false; // <-- added: track success to manage retry flag

  try {
    if (typeof _emitAvailabilityUpdateStart === 'function') {
      __stepWrap('_emitAvailabilityUpdateStart', _emitAvailabilityUpdateStart, runId);
    } else {
      __log('EMIT_START_SKIP', { reason: 'function not found' });
    }

    // 0) Sync candidates (emails suppressed in test mode inside function)
    __stepWrap('ai_syncAvailabilityWithCandidates', ai_syncAvailabilityWithCandidates);

    // 1) SNAPSHOT BEFORE (test mode only)
    if (DAILY_REFRESH_TEST) {
      __stepWrap('_snapshotAvailabilitySheet(BEFORE)', _snapshotAvailabilitySheet, 'BEFORE', simToday);
    }

    // 2) Realign by date keys (capture → roll headers → rehydrate)
    __stepWrap('_realignAvailabilityByDateKeys', _realignAvailabilityByDateKeys, simToday);

    // 3) Repaint overlays using authoritative policies (booked then blocked)
    __stepWrap('ai_markBookedAndSystemBlocks', ai_markBookedAndSystemBlocks, simToday);

    // 4) Sort after repaint
    __stepWrap('ai_sortAvailabilityByTierJobGenderSurname', ai_sortAvailabilityByTierJobGenderSurname);

    // 5) SNAPSHOT AFTER (test mode only)
    if (DAILY_REFRESH_TEST) {
      __stepWrap('_snapshotAvailabilitySheet(AFTER)', _snapshotAvailabilitySheet, 'AFTER', simToday);
    }

    // 6) Notify Availability API of the new window (we DO this in test mode)
    const hdr = __stepWrap('ai_refreshDateColumns', ai_refreshDateColumns, simToday); // returns { orderedYmds, headersChanged }
    __log('REFRESH_HEADERS_RESULT', hdr);
    if (hdr && Array.isArray(hdr.orderedYmds) && hdr.orderedYmds.length) {
      if (typeof _emitAvailabilityHeadersChanged === 'function') {
        __stepWrap('_emitAvailabilityHeadersChanged', _emitAvailabilityHeadersChanged, hdr.orderedYmds);
      } else {
        __log('EMIT_HEADERS_CHANGED_SKIP', { reason: 'function not found' });
      }
    }

    __ok = true; // <-- added: mark successful completion of core work

  } catch (err) {
    // Extra detail for unexpected failures
    try { props.setProperty('AVREF_NEEDS_RETRY', '1'); } catch (_) {} // <-- added: flag failure
    __log('TOPLEVEL_ERR', {
      runId,
      name: err && err.name,
      message: err && err.message,
      stack: (err && err.stack) || '',
      simToday: simToday && simToday.toISOString(),
      DAILY_REFRESH_TEST
    });
    throw err;
  } finally {
    // <-- added: clear failure flag only if success
    try { if (__ok) props.setProperty('AVREF_NEEDS_RETRY', '0'); } catch (_) {}

    try {
      if (typeof _emitAvailabilityUpdateEnd === 'function') {
        __stepWrap('_emitAvailabilityUpdateEnd', _emitAvailabilityUpdateEnd, runId);
      } else {
        __log('EMIT_END_SKIP', { reason: 'function not found' });
      }
    } catch (eEnd) {
      __log('EMIT_END_ERR', { message: eEnd && eEnd.message, stack: (eEnd && eEnd.stack) || '' });
    }
    try { lock.releaseLock(); __log('LOCK_RELEASED'); } catch (eLock) { __log('LOCK_RELEASE_ERR', { message: eLock && eLock.message }); }
    __log('FUNC_EXIT', { fn: 'ai_dailyRefresh', ms: Date.now() - __T0 });
  }
}

function ai_refreshWatchdog() {
  const lock = LockService.getDocumentLock();
  if (!lock.tryLock(1000)) { // don't fight other runs
    Logger.log('[watchdog] could not obtain lock; skipping');
    return;
  }
  try {
    const props = PropertiesService.getScriptProperties();
    const needs = props.getProperty('AVREF_NEEDS_RETRY') === '1';
    if (needs) {
      Logger.log('[watchdog] previous failure detected; re-running ai_dailyRefresh...');
      try {
        ai_dailyRefresh();
      } catch (e) {
        Logger.log('[watchdog] retry failed: ' + (e && e.message));
      }
    } else {
      Logger.log('[watchdog] no retry needed.');
    }
  } finally {
    try { lock.releaseLock(); } catch (_) {}
  }
}

/**
 * Rebuilds the Availability grid by DATE KEY and CANDIDATE KEY.
 * Steps:
 *  1) Read current headers → YMD list (old window)
 *  2) Build rowMap[candidateKey][ymd] = {text, bg, userNote}
 *     - If cell is BOOKED (blue), do not store underlying (overlay will repaint)
 *     - If cell is BLOCKED (green + 'BLOCKED'):
 *         If note is JSON {prevText,prevBg,userNote} → store underlying
 *         Else → store blank underlying with userNote = note
 *  3) Compute desired headers from simToday (today→today+13) and write headers
 *  4) For each row, rehydrate cells by desired YMDs from rowMap
 */
function _realignAvailabilityByDateKeys(baseDate) {
  const __T0 = Date.now();
  __log('FUNC_ENTER', { fn: '_realignAvailabilityByDateKeys', baseDate: baseDate && baseDate.toISOString ? baseDate.toISOString() : String(baseDate) });

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const av = ss.getSheetByName(SH_AVAIL);
  if (!av) { __log('SHEET_MISSING', { sheet: SH_AVAIL }); return; }
  const tz = ss.getSpreadsheetTimeZone();

  // Helpers
  function ymd(d) { return Utilities.formatDate(d, tz, 'yyyy-MM-dd'); }
  function parseHeaderToDate(h) {
    const s = String(h || '').trim();
    let m = s.match(/\b(\d{2}\/\d{2}\/\d{4})\b/);
    if (m) {
      const [dd, mm, yyyy] = m[1].split('/');
      const d = new Date(Number(yyyy), Number(mm) - 1, Number(dd));
      return isNaN(d) ? null : d;
    }
    const iso = s.match(/\b(\d{4}-\d{2}-\d{2})\b/);
    if (iso) { const d = new Date(iso[1]); if (!isNaN(d)) return d; }
    const d2 = new Date(s);
    return isNaN(d2) ? null : d2;
  }
  function normNameKey(sur, fir) {
    const s = (String(sur||'') + String(fir||''));
    const deaccent = s.normalize('NFD').replace(/\p{Diacritic}/gu, '');
    return deaccent.replace(/[^A-Za-z0-9]/g, '').toLowerCase();
  }
  function normPhone(s) {
    const digits = String(s || '').replace(/\D+/g, '');
    if (!digits) return '';
    if (digits.startsWith('44') && digits.length === 12) return '0' + digits.slice(2);
    if (digits.length === 10 && digits[0] !== '0')      return '0' + digits;
    if (digits.length === 11 && digits[0] === '0')      return digits;
    return digits[0] === '0' ? digits : ('0' + digits);
  }

  // Colours (lowercase)
  const COL_AV   = String(COLOR_AVAILABLE || '').toLowerCase();
  const COL_UNAV = String(COLOR_UNAVAIL   || '').toLowerCase();
  const COL_BOOK = String(COLOR_BOOKED    || '').toLowerCase();
  const COL_BLOCK= String(COLOR_BLOCKED   || '').toLowerCase();

  // Current header YMDs
  const lastCol = av.getLastColumn();
  const dateCount = Math.max(0, lastCol - 6);
  const headerVals = dateCount ? av.getRange(1, 7, 1, dateCount).getDisplayValues()[0] : [];
  const headerYmds = headerVals.map(parseHeaderToDate).map(d => d ? ymd(d) : '').filter(Boolean);
  __log('REALIGN_HEADERS', { dateCount, headerYmdsLen: headerYmds.length });

  // Full body snapshot
  const lastRow = av.getLastRow();
  const bodyRows = Math.max(lastRow - 1, 0);
  if (!bodyRows || !dateCount) { __log('REALIGN_EARLY_EXIT', { bodyRows, dateCount }); return; }

  const vals  = av.getRange(2, 1, bodyRows, 6 + dateCount).getDisplayValues();
  const bgs   = av.getRange(2, 1, bodyRows, 6 + dateCount).getBackgrounds();
  const notes = av.getRange(2, 1, bodyRows, 6 + dateCount).getNotes();

  // Build rowMap keyed by candidateKey + ymd
  const rowMap = new Map(); // candidateKey -> Map(ymd -> {t, bg, n})
  function keyForRow(r) {
    const sur = vals[r][0] || '';
    const fir = vals[r][1] || '';
    const tel = vals[r][3] || '';
    return normNameKey(sur, fir) + '|' + normPhone(tel);
  }

  for (let r = 0; r < bodyRows; r++) {
    const ck = keyForRow(r);
    if (!rowMap.has(ck)) rowMap.set(ck, new Map());
    const cmap = rowMap.get(ck);

    for (let c = 0; c < dateCount; c++) {
      const v  = String(vals[r][6 + c] || '');
      const bg = String(bgs[r][6 + c] || '').toLowerCase();
      const nt = String(notes[r][6 + c] || '');

      // BOOKED overlay → do not store underlying (we will repaint from EH)
      if (bg === COL_BOOK && (v.toUpperCase() === 'LD' || v.toUpperCase() === 'N')) {
        continue;
      }

      let tStore = '';
      let bgStore = '#ffffff';
      let nStore = '';

      if (bg === COL_BLOCK && v.toUpperCase() === 'BLOCKED') {
        // BLOCKED: try parse snapshot JSON
        let parsed = null;
        try {
          parsed = JSON.parse(nt);
        } catch(_) {}
        if (parsed && typeof parsed === 'object' && ('prevText' in parsed) && ('prevBg' in parsed)) {
          tStore = String(parsed.prevText || '');
          bgStore = String(parsed.prevBg || '#ffffff');
          nStore = String(parsed.userNote || '');
        } else {
          // Non-JSON note → underlying unknown, preserve note as user note
          tStore = '';
          bgStore = '#ffffff';
          nStore = nt ? String(nt) : '';
        }
      } else {
        // Normal user entry (available/unavailable/blank)
        tStore = v;
        bgStore = bg || '#ffffff';
