/**
 * Opens a modal dialog showing the history of the given cell(s).
 * It reads your "Logs" sheet (which you already append to in logChanges),
 * filters for matching date & shiftType, and passes them to HistoryDialog.html.
 */
/**
 * Opens a simple modal showing all log entries
 * for the given cells (by sheet name + A1).
 */
/**
 * Opens a modal showing all log entries for the given shift cells,
 * including any REFERENCE entries in the row immediately below.
 */
function openHistoryDialog(cells) {
  const ss   = SpreadsheetApp.getActiveSpreadsheet();
  const ui   = SpreadsheetApp.getUi();
  const tz   = ss.getSpreadsheetTimeZone();
  const logs = ss.getSheetByName('Logs');
  if (!logs) {
    ui.alert('No Logs sheet found.');
    return;
  }

  // load all log rows (skip header)
  const allRows = logs.getDataRange().getValues().slice(1);

  // helper: given "C47" returns "C48"
  function nextRowA1(a1) {
    const m = a1.match(/^([A-Z]+)(\d+)$/);
    if (!m) return null;
    return m[1] + (parseInt(m[2], 10) + 1);
  }

  // collect matching history entries
  const history = [];
  const activeSheet = ss.getActiveSheet().getName();
  allRows.forEach(r => {
    // expect 11 cols: ts, action, sheet, cellA1,
    // date, shift, candidate, ref, hosp, ward, user
    let [
      rawTs, action, sheetName, cellA1,
      rawDate, shift, candidate, reference,
      hospital, ward, rawUser
    ] = r;
    if (sheetName !== activeSheet) return;

    // strip domain from user email
    const user = String(rawUser || '').split('@')[0];

    cells.forEach(c => {
      const shiftA1 = c.a1;
      const refA1   = nextRowA1(shiftA1);
      if (
        cellA1 === shiftA1 ||
        (action === 'REFERENCE' && cellA1 === refA1)
      ) {
        history.push({ rawTs, rawDate, action, shift, candidate, reference, hospital, ward, user });
      }
    });
  });

  if (!history.length) {
    ui.alert('No history found for that cell.');
    return;
  }

  // build HTML
  let html = '<table style="width:100%;border-collapse:collapse" border="1">'
           + '<tr>'
           +   '<th>When</th><th>Action</th><th>Date</th><th>Shift</th>'
           +   '<th>Candidate</th><th>Ref No.</th><th>Hospital</th>'
           +   '<th>Ward</th><th>User</th>'
           + '</tr>';

  history.forEach(h => {
    const when    = Utilities.formatDate(new Date(h.rawTs), tz, "EEE d MMM yyyy HH:mm") + "hrs";
    const dateStr = h.rawDate instanceof Date
                  ? Utilities.formatDate(h.rawDate, tz, "EEE d MMM yyyy")
                  : String(h.rawDate);
    html += `<tr>
      <td>${when}</td>
      <td>${h.action}</td>
      <td>${dateStr}</td>
      <td>${h.shift}</td>
      <td>${h.candidate}</td>
      <td>${h.reference||''}</td>
      <td>${h.hospital}</td>
      <td>${h.ward}</td>
      <td>${h.user}</td>
    </tr>`;
  });

  html += '</table>';

  ui.showModalDialog(
    HtmlService.createHtmlOutput(html)
      .setWidth(700)
      .setHeight(400),
    'Shift & Reference History'
  );
}



