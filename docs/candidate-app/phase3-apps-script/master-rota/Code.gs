/**
 * 1) Copies this spreadsheet (including code) into your “Backups” folder
 *    with a timestamped name.
 * 2) Trashes any backups older than 5 days.
 */
function hourlyBackup() {
  const FOLDER_ID = '1rHbx0c2lNG0VAAGynpX6I1G_lIZQKsbw';  // backup folder
  const KEEP_DAYS = 5;

  const ss     = SpreadsheetApp.getActiveSpreadsheet();
  const file   = DriveApp.getFileById(ss.getId());
  const folder = DriveApp.getFolderById(FOLDER_ID);
  const now    = new Date();

  // ddMMyyyy_HHmm
  const stamp  = Utilities.formatDate(now, Session.getScriptTimeZone(), 'ddMMyyyy_HHmm');
  const sheetBackupName = `BACKUP MASTER Rota do not use ${stamp}`;
  const propsBackupName = `BACKUP ScriptProperties ${stamp}.json`;

  // 1) Make the spreadsheet copy
  file.makeCopy(sheetBackupName, folder);

  // 2) Export Script Properties to JSON (saved as plain text)
  const props = PropertiesService.getScriptProperties().getProperties(); // { [key]: value }
  const meta = {
    createdAt: now.toISOString(),
    scriptId: tryGetScriptId_(),
    spreadsheetId: ss.getId(),
    timezone: Session.getScriptTimeZone()
  };
  const payload = JSON.stringify({ meta, properties: props }, null, 2);
  // Save as plain text (Drive will treat it as text file with .json extension)
  folder.createFile(propsBackupName, payload, MimeType.PLAIN_TEXT);

  // 3) Trash backups older than KEEP_DAYS (both sheets and JSON)
  const cutoff  = new Date(now.getTime() - KEEP_DAYS * 24 * 60 * 60 * 1000);
  const files = folder.getFiles();
  while (files.hasNext()) {
    const f = files.next();
    if (f.getDateCreated() < cutoff) {
      f.setTrashed(true);
    }
  }
}


