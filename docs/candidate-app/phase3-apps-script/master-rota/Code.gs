/**
 * Append a single row to "Logs" with the raw JSON payload.
 * Columns:
 *  A: Timestamp
 *  B: Source (e.g., 'WATI')
 *  C: Action (e.g., 'WATI_OUTBOUND', 'WATI_INBOUND', 'ERROR')
 *  D: Phone (if present)
 *  E: TemplateName (if present)
 *  F: Origin/Source (if present)
 *  G: Status/Note (optional)
 *  H: JSON (full payload)
 */
function _logWebhookEvent(source, action, payload, note) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = _ensureSheetWithHeaders_(
    'Logs',
    ['Timestamp', 'Source', 'Action', 'Phone', 'TemplateName', 'Origin', 'Status/Note', 'JSON']
  );

  const phone = (payload && (payload.phone || payload.whatsappNumber || payload.from || payload.waId)) || '';
  const templateName = (payload && (payload.template_name || payload.templateName)) || '';
  const origin = (payload && (payload.origin || payload.source)) || '';
  const status = note || '';

  const row = [
    new Date(),
    source || '',
    action || '',
    String(phone || ''),
    String(templateName || ''),
    String(origin || ''),
    String(status || ''),
    JSON.stringify(payload || {})
  ];
  sh.appendRow(row);
}

/**
 * Create sheet if missing and stamp headers if empty.
 */
function _ensureSheetWithHeaders_(name, headers) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(name);
  if (!sh) sh = ss.insertSheet(name);
  if (sh.getLastRow() === 0) {
    sh.appendRow(headers);
    sh.setFrozenRows(1);
  }
  return sh;
}

