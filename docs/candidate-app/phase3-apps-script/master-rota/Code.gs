function mergeIntoActiveWatiCohort(newPhones) {
  const current = getActiveWatiCohort();
  const merged  = Array.from(new Set([].concat(current, (newPhones || []).map(String).filter(Boolean))));
  setActiveWatiCohort(merged);
  return merged;
}

/**
 * Compute expiry window in milliseconds from WATI_EXPIRY_TIME (minutes).
 * Defaults to 480 minutes if not set or invalid.
 */
function getWatiExpiryMs() {
  const mins = Number(_props().getProperty('WATI_EXPIRY_TIME') || '480');
  return Math.max(0, mins) * 60 * 1000;
}

/**
 * Decide whether the emergency window has elapsed for the latest cohort.
 * Returns true iff:
 *  - there is a non-empty cohort,
 *  - there is a LAST_WATI_SEND_TS, and
 *  - now - LAST_WATI_SEND_TS >= expiry.
 */
function shouldResetEmergencyWindow(nowEpochMs) {
  const cohort   = getActiveWatiCohort();
  const lastSend = Number(_props().getProperty('LAST_WATI_SEND_TS') || '0');
  const expiryMs = getWatiExpiryMs();
  return cohort.length > 0 && lastSend > 0 && (nowEpochMs - lastSend) >= expiryMs;
}

/**
 * Guard flag for in-progress reset.
 */
function isWatiResetRunning() {
  return _props().getProperty('WATI_RESET_RUNNING') === 'true';
}
function setWatiResetRunning(flag) {
  _props().setProperty('WATI_RESET_RUNNING', flag ? 'true' : 'false');
}

/**
 * Perform the attribute reset for the CURRENT active cohort only:
 *  - Sets emergencywhatsapp="BLANK" for each phone in the active cohort
 *  - Clears ACTIVE_WATI_CONTACTS_JSON afterwards
 * Returns the number of contacts processed.
 *
 * NOTE: Assumes caller already checked shouldResetEmergencyWindow(now).
 * Uses a lightweight in-function guard (WATI_RESET_RUNNING) for safety.
 */
function performWatiExpiryReset() {
  if (isWatiResetRunning()) return 0; // another cycle is handling it
  setWatiResetRunning(true);
  try {
    const cohort = getActiveWatiCohort();
    if (!cohort.length) return 0;

    const tenant = "601205";
    const urlFor = phone => `https://eu-api.wati.io/${tenant}/api/v1/updateContactAttributes/${phone}`;
    const body   = JSON.stringify({ customParams: [ { name: "emergencywhatsapp", value: "BLANK" } ] });
    const opts   = {
      method: "post",
      contentType: "application/json",
      headers: { Authorization: WATI_TOKEN },
      payload: body,
      muteHttpExceptions: true
    };

    // Execute one-by-one (fast enough for typical cohorts)
    cohort.forEach(phone => {
      try { UrlFetchApp.fetch(urlFor(phone), opts); } catch (_) { /* swallow per-contact */ }
    });

    // Clear cohort after successful pass
    _props().deleteProperty('ACTIVE_WATI_CONTACTS_JSON');
    return cohort.length;

  } finally {
    setWatiResetRunning(false);
  }
}

/**
 * Bookkeeping helper: restart the window after a send and merge the latest cohort.
 * Call this right after a successful WATI template broadcast.
 */
function recordWatiSendAndMergeCohort(sentPhonesArray) {
  mergeIntoActiveWatiCohort(sentPhonesArray);
  _props().setProperty('LAST_WATI_SEND_TS', String(Date.now()));
  // Do NOT touch WATI_EXPIRY_TIME here (admin-managed).
}


