function formatDateDDMMYYYY(date) {
  if (Object.prototype.toString.call(date) === '[object Date]') {
    const dd = ('0' + date.getDate()).slice(-2);
    const mm = ('0' + (date.getMonth() + 1)).slice(-2);
    const yyyy = date.getFullYear();
    return `${dd}/${mm}/${yyyy}`;
  }
  return date;
}




// Splits text into chunks of maxLen characters
function splitByLength(text, maxLen) {
  const chunks = [];
  for (let i = 0; i < text.length; i += maxLen) {
    chunks.push(text.substring(i, i + maxLen));
  }
  return chunks;
}

// Builds the session message body
function buildSessionText(fn, diffs) {
  const lines = diffs.map(d => {
    const prefix = d.comment === 'CANCELLED' ? 'CX' : 'NEW';
    const dayFmt = Utilities.formatDate(parseDateDDMMYYYY(d.date), Session.getScriptTimeZone(), 'EEE dd/MM');
    const shift  = d.shift.toLowerCase().includes('night') ? 'N' : 'LD';
    const hosp   = abbreviateHospital(d.hospital);
    const ward   = d.ward;
    const ref    = d.comment === 'NEW REF NUMBERS' ? ` - ${d.reference}` : '';
    return `${prefix} ${dayFmt} - ${shift} - ${hosp} - ${ward}${ref}`;
  });
  return `Hi ${fn}\n\n*Shift Update*\n\n` + lines.join('\n') +
         `\n\nPlease contact us if you have any questions.\nMany thanks.`;
}

// Abbreviates hospital names
function abbreviateHospital(name) {
  if (/Worthing/i.test(name)) return 'WTG';
  if (/St\s+Richards/i.test(name)) return 'SRH';
  return (name||'').substring(0,3).toUpperCase();
}

// Paginates template parameters by category and per-page limit
/**
 * Builds the template parameters for one page:
 *  • date_1 = "Page X of Y"
 *  • date_2 = sectionLabel
 *  • date_3… = each shift line
 *  • pads with “—” up to date_8
 */
/**
 * Builds the template parameters payload for one page.
 * Always includes:
 *  - date_1: “Page X of Y”
 *  - date_2: section header (e.g. “NEW BOOKINGS” or “CANCELLATIONS continued”)
 *  - date_3…date_8: up to six shift lines, padded with “—”
 */
function buildTemplateParamsForPage(sectionLabel, lines, pageNum, totalPages) {
  const params = [];
  // 1) Page indicator
  params.push({
    name: 'date_1',
    value: `Page ${pageNum} of ${totalPages}`
  });
  // 2) Section header
  params.push({
    name: 'date_2',
    value: sectionLabel
  });
  // 3) Shift lines
  lines.forEach((line, i) => {
    params.push({
      name: `date_${3 + i}`,
      value: line
    });
  });
  // 4) Pad out to date_8
  while (params.length < 8) {
    const idx = params.length + 1;
    params.push({
      name: `date_${idx}`,
      value: '—'
    });
  }
  return params;
}

/**
 * Given a flat array of diffs (each with .comment, .date, .shift, .hospital, .ward, .reference),
 * splits them into three buckets (NEW BOOKINGS, CANCELLATIONS, NEW REF NUMBERS),
 * then pages each bucket into groups of up to 6 and labels overflow pages “continued”.
 * Returns an array of parameter-arrays (one per page) ready for WATI.
 */
function paginateTemplateParams(diffs) {
  const perPage = 6;  // max 6 shifts per page

  // 1) Bucket by comment type
  const buckets = [
    { label: 'NEW BOOKINGS',     items: diffs.filter(d => d.comment === 'NEW') },
    { label: 'CANCELLATIONS',    items: diffs.filter(d => d.comment === 'CANCELLED') },
    { label: 'NEW REF NUMBERS',  items: diffs.filter(d => d.comment === 'NEW REFERENCE NUMBER') } // ✅ corrected
  ];

  // 2) Slice each bucket into pages
  const pages = [];
  buckets.forEach(bucket => {
    const { label, items } = bucket;
    for (let i = 0; i < items.length; i += perPage) {
      const chunk = items.slice(i, i + perPage).map(d => {
        const prefix    = d.comment === 'CANCELLED' ? 'CX' : 'NEW';
        const dateFmt   = Utilities.formatDate(parseDateDDMMYYYY(d.date), Session.getScriptTimeZone(), 'EEE dd/MM');
        const shiftAbbr = /night/i.test(d.shift) ? 'N' : 'LD';
        const hospAbbr  = /^Worthing/i.test(d.hospital) ? 'WTG' : 'SRH';
        let line = `${prefix} ${dateFmt} — ${shiftAbbr} — ${hospAbbr} — ${d.ward}`;
        
        if (label === 'NEW REF NUMBERS' && d.newRef) {
          line += ` — ${d.newRef}`; // ✅ uses newRef field
        }

        return line;
      });

      const sectionLabel = i === 0 ? label : `${label} continued`;
      pages.push({ sectionLabel, lines: chunk });
    }
  });

  // 3) Convert each page into template params
  const totalPages = pages.length;
  return pages.map((pg, idx) =>
    buildTemplateParamsForPage(pg.sectionLabel, pg.lines, idx + 1, totalPages)
  );
}


