function _1match_hashEHIndex(eh) {
  try {
    var core = {
      byCid: eh && eh.byCid ? Object.keys(eh.byCid).sort().map(function (cid) {
        var w = eh.byCid[cid].worked || {};
        var flags = eh.byCid[cid].flags || '';
        // Keep a tiny digest of worked days only (ordered)
        var days = Object.keys(w).sort().map(function (d) { return d + ':' + w[d]; }).join(',');
        return cid + '|' + flags + '|' + Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, days);
      }) : [],
      names: eh && eh.namesByCid ? Object.keys(eh.namesByCid).sort() : []
    };
    var raw = JSON.stringify(core);
    var md5 = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, raw);
    return md5.map(function (b) { var v = (b + 256) % 256; return ('0' + v.toString(16)).slice(-2); }).join('').slice(0, 12);
  } catch (_) {
    return 'ehhash000000';
  }
}

function _1match_hashAvailIndex(daysByCid) {
  try {
    var summary = Object.keys(daysByCid || {}).sort().slice(0, 500).map(function (cid) {
      var rec = daysByCid[cid] || {};
      // only sample up to first 120 dates to keep deterministic size
      var ks = Object.keys(rec).sort().slice(0, 120);
      var s = ks.map(function (d) { return d + ':' + String(rec[d] || ''); }).join(',');
      return cid + '|' + s;
    });
    var raw = JSON.stringify({ m: summary });
    var md5 = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, raw);
    return md5.map(function (b) { var v = (b + 256) % 256; return ('0' + v.toString(16)).slice(-2); }).join('').slice(0, 12);
  } catch (_) {
    return 'avhash000000';
  }
}

