/**
 * Build a map of <PLACEHOLDER> -> value strings for the Word doc.
 * Applies special rules (HCA=>N/A for NMC; DBS Conviction; date formats; etc).
 * Returns an object { '<Placeholder>': 'value', ... } (case-sensitive keys as they appear in the template).
 */
// ───────────────────────────────────────────────────────────────
// Helpers (new)
// ───────────────────────────────────────────────────────────────


function _inferHasUpdateService_(summary) {
  try {
    const s = (summary && summary.dbs) ? summary.dbs : {};

    // 1) Trust an explicit flag computed upstream (most reliable)
    if (typeof s.onUpdateService === 'boolean') {
      return s.onUpdateService;
    }

    // 2) Fall back to most-recent normalized status if provided
    if (typeof s.mostRecentStatus === 'string' && s.mostRecentStatus.trim()) {
      return s.mostRecentStatus.trim().toLowerCase() !== 'no_match_found';
    }

    // 3) Fall back to the raw status on the summary (may be stale)
    const statusRaw = String(s.updateStatus || '').trim().toLowerCase();
    if (statusRaw) {
      // Explicit rule: NO_MATCH_FOUND → NOT registered
      if (statusRaw === 'no_match_found') return false;
      // Any other explicit status implies registered
      return true;
    }

    // 4) Be conservative: do NOT infer registration from dates or certificate numbers alone
    return false;
  } catch (_) {
    return false;
  }
}


function _computeDbsConvictionText_(summary) {
  // 1) Respect explicit override from the pipeline when present
  const ov = String(summary && summary._overrides && summary._overrides.dbsConviction || '').trim();
  if (ov) return ov; // 'YES' or 'NO'

  const s = (summary && summary.dbs) ? summary.dbs : {};
  const status = String(s.updateStatus || '').toUpperCase();

  // 2) If Update Service provided a status, map it to YES/NO
  if (status) {
    return (status === 'BLANK_NO_NEW_INFO') ? 'NO' : 'YES';
  }

  // 3) If no Update Service status but the upstream logic concluded conviction is present
  //    (e.g., questionnaire "YES"), write 'YES'. Otherwise, leave blank.
  if (summary && summary.hasConviction) return 'YES';

  // 4) Truly unknown/blank
  return '';
}

