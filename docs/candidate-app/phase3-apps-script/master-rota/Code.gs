function getOccupantsForDate(sheetName, dateStr, headerText) {
  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) return [];
  const data  = sheet.getDataRange().getValues();
  const tz    = ss.getSpreadsheetTimeZone();
  const shiftRow = data[3];
  for (let r = 4; r < data.length; r += 2) {
    const raw = data[r][1];
    if (!raw) continue;
    const d = new Date(raw);
    if (isNaN(d)) continue;
    const ds = Utilities.formatDate(d, tz, 'dd/MM/yyyy');
    if (ds !== dateStr) continue;
    return data[r]
      .map((v,i) => v && String(shiftRow[i]) === headerText ? v.toString().trim() : null)
      .filter(Boolean);
  }
  return [];
}

function previewEndRota(params) {
  const ss       = SpreadsheetApp.getActiveSpreadsheet();
  const sheet    = ss.getSheetByName(params.sheetName);
  const tz       = ss.getSpreadsheetTimeZone();
  const now      = new Date();
  const endDate  = parseDateDDMMYYYY(params.endDate);
  const data     = sheet.getDataRange().getValues();
  const shiftRow = data[3];

  // ── NEW: identify every name on the rota ──
  const occMap        = buildAllOccupants([ sheet ]);  // { "surname firstname": […] }
  const candidateKeys = Object.keys(occMap);

  // 1) Determine Day-end vs Night-end
  const endIsNight = /night/i.test(params.endHeaderText);

  // 2) Find the **full** shift label for that date
  let fullShiftLabel = null;
  for (let r = 4; r < data.length; r += 2) {
    const raw = data[r][1];
    if (!raw) continue;
    const d = new Date(raw);
    if (isNaN(d)) continue;
    const ds = Utilities.formatDate(d, tz, 'dd/MM/yyyy');
    if (ds !== params.endDate) continue;
    for (let c = 2; c < shiftRow.length; c++) {
      const lbl = shiftRow[c] + '';
      if (lbl.toLowerCase().includes(params.endHeaderText.toLowerCase())) {
        fullShiftLabel = lbl;
        break;
      }
    }
    break;
  }

  // 3) Compute skip-ahead if that shift has already started
  let skipWarning = false;
  let effDate     = params.endDate;
  let effHeader   = params.endHeaderText;
  if (fullShiftLabel) {
    const originalStart = parseShiftDateTime({
      date:  params.endDate,
      shift: fullShiftLabel
    });
    if (originalStart && originalStart <= now) {
      skipWarning = true;
      if (!endIsNight) {
        effHeader = 'Night';
      } else {
        const [d,m,y] = params.endDate.split('/').map(Number);
        const nextDay = new Date(y, m-1, d+1);
        effDate   = Utilities.formatDate(nextDay, tz, 'dd/MM/yyyy');
        effHeader = 'Long Day';
      }
    }
  }

  // 4) Now gather cancellations from effDate / effHeader onward
  const endIsNight2  = /night/i.test(effHeader);
  const toCancel     = new Set();

  for (let r = 4; r < data.length; r += 2) {
    const raw = data[r][1];
    if (!raw) continue;
    const dObj = new Date(raw);
    if (isNaN(dObj)) continue;

    const isAfter = dObj > parseDateDDMMYYYY(effDate);
    const isEqual = dObj.getTime() === parseDateDDMMYYYY(effDate).getTime();

    for (let c = 2; c < data[r].length; c++) {
      const cellHasName = data[r][c];
      if (!cellHasName) continue;
      const candidate   = cellHasName.toString().trim();
      const shiftLabel  = shiftRow[c] + '';
      const isNightCol  = /night/i.test(shiftLabel);

      let include = false;
      let reason  = '';
      if (isAfter) {
        include = true;
        reason  = 'after cutoff';
      } else if (isEqual) {
        if (!endIsNight2) {
          include = true;
          reason  = 'equal and Day-end includes all';
        } else if (isNightCol) {
          include = true;
          reason  = 'equal and Night-end includes night';
        } else {
          include = false;
          reason  = 'equal and Night-end but not night column';
        }
      } else {
        include = false;
        reason  = 'before cutoff';
      }

      if (include) {
        toCancel.add(candidate);
      }
    }
  }

  // 5) Build and show dialog
  const candidates   = candidateKeys;

  let channelLabel;
  if (params.sendEmail && params.sendWA) channelLabel = 'Email and WhatsApp';
  else if (params.sendEmail)             channelLabel = 'Email';
  else                                   channelLabel = 'WhatsApp';

  const tpl = HtmlService.createTemplateFromFile('ConfirmEndRotaDialog');
  tpl.data = {
    sheetName:     params.sheetName,
    hospital:      params.hospital,
    ward:          params.ward,
    endDate:       effDate,
    endHeaderText: effHeader,
    sendEmail:     params.sendEmail,
    sendWA:        params.sendWA,
    comment:       params.comment,
    skipWarning,
    candidates,
    channelLabel
  };
  const html = tpl.evaluate()
    .setWidth(600)
    .setHeight(500)
    .setTitle('Confirm End Rota');
  SpreadsheetApp.getUi().showModalDialog(html, 'Confirm End Rota');
}

function getShiftWindow(rawDate, shiftLabel, note, tz) {
  // 1. Normalize to "dd/MM/yyyy"
  const dateString = rawDate instanceof Date
    ? Utilities.formatDate(rawDate, tz, 'dd/MM/yyyy')
    : rawDate;
  const [d, mo, y] = dateString.split('/').map(Number);

  // 2. Notes override?
  const mStart = note && note.match(/Start:\s*(\d{1,2}):(\d{2})/);
  const mFin   = note && note.match(/Finish:\s*(\d{1,2}):(\d{2})/);
  if (mStart && mFin) {
    const hhS = +mStart[1], mmS = +mStart[2];
    const hhF = +mFin[1],   mmF = +mFin[2];
    const start = new Date(y, mo - 1, d, hhS, mmS);
    // finish next day if finish ≤ start OR shiftLabel contains "Night"
    const finishSameDay = hhF > hhS || (hhF === hhS && mmF > mmS);
    const isNightLabel  = /night/i.test(shiftLabel);
    const end = (finishSameDay && !isNightLabel)
      ? new Date(y, mo - 1, d, hhF, mmF)
      : new Date(y, mo - 1, d + 1, hhF, mmF);
    return { start, end };
  }

  // 3. Fallback header parsing
  const m = shiftLabel.match(/(\d{2})(\d{2})-(\d{2})(\d{2})/);
  let start, end;
  if (m) {
    const sh = +m[1], sm = +m[2];
    const eh = +m[3], em = +m[4];
    start = new Date(y, mo - 1, d, sh, sm);
    if (/night/i.test(shiftLabel)) {
      end = new Date(y, mo - 1, d + 1, eh, em);
    } else {
      end = new Date(y, mo - 1, d, eh, em);
    }
  }
  return {
    start: start || new Date(0),
    end:   end   || new Date(0)
  };
}
function executeEndRota(params) {
  // ── PREVENT RE‐ENTRY VIA LOCK ──
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) {
    return;
  }
  try {
    const ss  = SpreadsheetApp.getActiveSpreadsheet();
    const tz  = ss.getSpreadsheetTimeZone();
    const now = new Date();

    // ── 0) Pause automatic updates for one hour ──
    const props = PropertiesService.getScriptProperties();
    const pauseUntil = Date.now() + 3600 * 1000;
    props.setProperty('PAUSE_UNTIL_TS', String(pauseUntil));

    // ── 1) Setup ──
    const sheet = ss.getSheetByName(params.sheetName);
    if (!sheet) {
      throw new Error('Sheet not found: ' + params.sheetName);
    }

    // ── A) Identify all live occupants on the rota ──
    const occMap        = buildAllOccupants([ sheet ]);
    const candidateKeys = Object.keys(occMap);

    // ── 2) Clear cells for cancellations ──
    const data         = sheet.getDataRange().getValues();
    const shiftRow     = data[3];
    const cellsToClear = [];
    let firstRowToGrey = null;
    const endDate      = parseDateDDMMYYYY(params.endDate);
    const endIsNight   = /night/i.test(params.endHeaderText);

    for (let r = 4; r < data.length; r += 2) {
      const rawDate = data[r][1];
      if (!rawDate) continue;
      const d       = new Date(rawDate);
      if (isNaN(d)) continue;
      const isAfter = d > endDate;
      const isEqual = d.getTime() === endDate.getTime();

      for (let c = 2; c < data[r].length; c++) {
        const name       = data[r][c];
        const shiftLabel = shiftRow[c] + '';
        const w          = getShiftWindow(rawDate, shiftLabel, '', tz);
        const willClear  = (
          (isEqual && now < w.start && name && (!endIsNight || (/night/i.test(shiftLabel)))) ||
          (isAfter && name)
        );
        if (willClear) {
          if (firstRowToGrey === null && isEqual) firstRowToGrey = r;
          cellsToClear.push({ row: r + 1, col: c + 1, name: (name || '').toString().trim(), dateISO: d.toISOString(), shiftLabel });
        }
      }
    }
    if (firstRowToGrey === null) firstRowToGrey = 4;

    cellsToClear.forEach(c => {
      sheet.getRange(c.row, c.col).clearContent();
    });

    // ── 3) Grey out live sheet ──
    let greyed = 0;
    for (let r = firstRowToGrey; r < data.length; r += 2) {
      sheet.getRange(r + 1, 1, 2, sheet.getLastColumn()).setBackground('#dddddd');
      greyed += 2;
    }

    // ── Compute single-template shift vars ──
    const [dd, mm, yy]        = params.endDate.split('/').map(Number);
    const endDateObj          = new Date(yy, mm - 1, dd);
    const nextShiftLabel      = endIsNight ? 'Night shift' : 'Day shift';
    const nextShiftDatePretty = Utilities.formatDate(endDateObj, tz, 'EEEE dd MMM yyyy');
    let prevType, prevDatePretty;
    if (endIsNight) {
      prevType       = 'Day';
      prevDatePretty = nextShiftDatePretty;
    } else {
      prevType       = 'Night';
      const prevDate = new Date(yy, mm - 1, dd - 1);
      prevDatePretty = Utilities.formatDate(prevDate, tz, 'EEEE dd MMM yyyy');
    }

    // ── 4) Notifications (bulk) ──
    const emailMap = getCandidateInfoMap();
    const waMap    = getCandidateDataMap();

    // Build result map per candidate (for summary UI)
    const results = {};
    candidateKeys.forEach(key => {
      const fn = (emailMap[key] && emailMap[key].firstName)
               || (waMap[String(key).toLowerCase().trim()] && waMap[String(key).toLowerCase().trim()].firstName)
               || key;
      results[key] = {
        name:     fn,
        email:    { ok: false, reason: null },
        whatsapp: { ok: false, reason: null, json: null, template: 'sussex_rota_ended_extra', payload: null }
      };
    });

    // Collect EMAIL items
    const emailItems = [];
    const emailIndex = []; // [{key, to}]
    candidateKeys.forEach(key => {
      const info = emailMap[key];
      if (!info || !info.email) {
        results[key].email.reason = 'no email address';
        return;
      }
      let body = `<p>Dear ${info.firstName},</p>`;
      if (params.comment) body += `<p><b>${params.comment}</b></p>`;
      body += `
        <p><b>Cancellations</b></p>
        <p>We have received notification that your patient at ${params.hospital} on ${params.ward} ward is due to be discharged on ${nextShiftDatePretty}.</p>
        <p>All shifts from the ${nextShiftLabel} (including this shift) on ${nextShiftDatePretty} have now been cancelled as the patient no longer requires RMN or HCA cover.</p>
        <p>If you are booked up to and including the ${prevType} shift on ${prevDatePretty} then those shifts are still booked.</p>
        <p>You will be sent an email notification shortly with the cancelled shifts (and also any shifts that are still confirmed with this or another patient).</p>
        <p>Please note that if you are booked shifts with a different patient then those shifts are still booked unless you receive a separate notification.</p>
        <p><strong>If you are currently on shift when asked to leave, please fill in your timesheet with the <em>original</em> end time you were meant to work (not the actual time of departure). Your manager may ask you to note “Patient was discharged at (time) e.g. 1500hrs,” but the <em>end time</em> on your shift must remain the one you were originally rostered for.</strong></p>
        <p><em>If you have any accommodation booked please contact them as soon as possible to get a full refund.</em></p>
        <p>Many thanks for your help throughout this admission. We will be in touch soon with further shifts.</p>
        <p>Arthur Rai Medical Services.</p>
      `;
      emailItems.push({
        to: info.email,
        subject: `Patient Discharged - ${params.hospital}, ${params.ward}`,
        htmlBody: body,
        meta: { key, fullName: info.firstName || key }
      });
      emailIndex.push({ key, to: info.email });
    });

    // Collect WA receivers
    const watiReceivers = [];
    const waMetaIndex   = []; // align to receivers
    if (params.sendWA) {
      const sentPhones = new Set();
      candidateKeys.forEach(origKey => {
        const lookupKey = String(origKey).toLowerCase().trim();
        const wi = waMap[lookupKey];
        if (!wi || !wi.phone) {
          results[origKey].whatsapp.reason = 'no WhatsApp number';
          return;
        }
        let mobile = String(wi.phone).replace(/\D/g, '');
        if (mobile.startsWith('0')) mobile = '44' + mobile.slice(1);
        if (!mobile.startsWith('44') && wi.phone.startsWith('+')) mobile = wi.phone.replace(/^\+/, '');
        if (sentPhones.has(mobile)) return;
        sentPhones.add(mobile);

        const customParams = [
          { name: 'forename',          value: wi.firstName },
          { name: 'nextshifthospital', value: params.hospital },
          { name: 'nextshiftward',     value: params.ward },
          { name: 'nextshiftdate',     value: nextShiftDatePretty },
          { name: 'nextshift',         value: nextShiftLabel },
          { name: 'secondshifttype',   value: prevType },
          { name: 'secondshift',       value: prevDatePretty }
        ];

        watiReceivers.push({ whatsappNumber: mobile, customParams });
        waMetaIndex.push({ key: origKey, mobile, page: 1 });
        results[origKey].whatsapp.payload = {
          template_name:  'sussex_rota_ended_extra',
          broadcast_name: `Cancel_${Utilities.formatDate(now, tz, 'yyyyMMdd_HHmmss')}`,
          parameters: customParams
        };
      });
    }

    // Dispatch EMAILS
    let emailBatchError = null;
    let emailResultsArr = [];
    if (emailItems.length) {
      try {
        const runId = new Date().toISOString();
        const flowRes = _dispatchEmailsBatch(emailItems, 'sussex@arthur-rai.co.uk', runId);
        emailResultsArr = Array.isArray(flowRes && flowRes.results) ? flowRes.results : [];
      } catch (e) {
        emailBatchError = String((e && e.message) || e);
      }
    }
    // Map email results back to candidates
    if (emailBatchError) {
      emailIndex.forEach(({ key }) => {
        results[key].email.ok = false;
        results[key].email.reason = emailBatchError;
      });
    } else if (emailResultsArr.length) {
      emailResultsArr.forEach((r, i) => {
        const meta = (r && r.meta) || (emailItems[i] && emailItems[i].meta) || {};
        const key  = meta.key || (emailIndex[i] && emailIndex[i].key);
        if (!key) return;
        if (r && r.status === 'SUCCESS') {
          results[key].email.ok = true;
        } else {
          results[key].email.ok = false;
          results[key].email.reason = (r && (r.error || r.message)) || 'Unknown';
        }
      });
    } else {
      emailIndex.forEach(({ key }) => { results[key].email.ok = true; });
    }

    // Dispatch WHATSAPP (if enabled)
    let waBatchErrors = [];
    let waPerReceiverResults = []; // [{error:null|String}]
    if (params.sendWA && watiReceivers.length) {
      const CHUNK = 300;
      const runId = new Date().toISOString();
      for (let start = 0; start < watiReceivers.length; start += CHUNK) {
        const chunk = watiReceivers.slice(start, start + CHUNK);
        const meta  = waMetaIndex.slice(start, start + CHUNK);
        try {
          const wa = _sendWATIBulkTemplate_Generic(
            'sussex_rota_ended_extra',
            chunk,
            `Cancel_${Utilities.formatDate(now, tz, 'yyyyMMdd_HHmmss')}_${runId}`,
            tz
          );
          if (wa && wa.httpCode === 200 && wa.json && Array.isArray(wa.json.receivers)) {
            const local = wa.json.receivers.map(r => {
              const err = r && (r.error || r.errorCode || (Array.isArray(r.errors) && r.errors.length ? r.errors.map(x => x.message || JSON.stringify(x)).join('; ') : null));
              return { error: err || null };
            });
            waPerReceiverResults = waPerReceiverResults.concat(local);
          } else if (wa && wa.httpCode === 200 && wa.json && wa.json.result === true) {
            waPerReceiverResults = waPerReceiverResults.concat(new Array(chunk.length).fill({ error: null }));
          } else {
            const reason = (wa && wa.json && (wa.json.error || wa.json.message)) || `HTTP ${wa && wa.httpCode}`;
            waBatchErrors.push({ reason, count: chunk.length });
            waPerReceiverResults = waPerReceiverResults.concat(new Array(chunk.length).fill({ error: reason }));
          }
        } catch (e) {
          const reason = String((e && e.message) || e);
          waBatchErrors.push({ reason, count: chunk.length });
          waPerReceiverResults = waPerReceiverResults.concat(new Array(chunk.length).fill({ error: reason }));
        }
      }

      // Map WA per-receiver results back to candidates
      waPerReceiverResults.forEach((res, i) => {
        const meta = waMetaIndex[i] || {};
        const key  = meta.key;
        if (!key) return;
        if (!res || res.error) {
          results[key].whatsapp.ok = false;
          results[key].whatsapp.reason = (res && res.error) || 'Unknown';
        } else {
          results[key].whatsapp.ok = true;
        }
      });
    }

    // ── 5) Final summary & reset ──
    let summary = '<b>End Rota complete.</b><br><br>';
    summary += '<table border="1" cellpadding="5" cellspacing="0">' +
               '<tr><th>Name</th><th>Email</th><th>WhatsApp</th></tr>';
    candidateKeys.forEach(key => {
      const r = results[key];
      const e = r.email.ok ? '✔' : `✘ (${r.email.reason})`;
      const w = params.sendWA
                ? (r.whatsapp.ok ? `✔<br><small>tmpl: ${r.whatsapp.template}</small>`
                                 : `✘ (${r.whatsapp.reason})`)
                : '';
      summary += `<tr>
                    <td>${r.name}</td>
                    <td style="text-align:center">${e}</td>
                    <td style="text-align:center">${w}</td>
                  </tr>`;
    });
    summary += '</table>';

    SpreadsheetApp.getUi().showModalDialog(
      HtmlService.createHtmlOutput(summary).setWidth(600).setHeight(400),
      'End Rota Summary'
    );

    // ── 6) Restore regular updates ──
    _resetUpdateTimer();

  } catch (err) {
    throw err;
  } finally {
    try {
      lock.releaseLock();
    } catch (e) {}
  }
}

function _resetUpdateTimer() {
  const props = PropertiesService.getScriptProperties();
  const now   = Date.now();
  props.setProperty('NEXT_UPDATE_TS', String(now + 5*60*1000));
  props.deleteProperty('PAUSE_UNTIL_TS');
}

