function _ensureHeaders(sh, desired) {
  const need = desired.length;
  const haveCols = Math.max(sh.getLastColumn(), need);
  const have = sh.getRange(1, 1, 1, haveCols).getDisplayValues()[0];

  // Expand if needed
  if (sh.getLastColumn() < need) {
    sh.insertColumnsAfter(sh.getLastColumn(), need - sh.getLastColumn());
  }

  // Write desired headers exactly for the first N columns
  sh.getRange(1, 1, 1, need).setValues([desired]);
}


/** =======================
 *  3) OUTBOUND START — STAGGERED
 *  ======================= */
/**********************
/**********************
 * DAILY PINGS — Coordinator + 3 Stages (single 30-min trigger after 08:00)
 * No new sheets. Uses Script Properties for hand-off.
 **********************/

// ── Script Properties keys
const DP = {
  RUN_ID:              'DP_RUN_ID',          // yyyyMMdd per tz
  STAGE:               'DP_STAGE',           // '', 'A_DONE', 'B_DONE', 'C_DONE'
  A_DONE:              'A_DONE',
  B_DONE:              'B_DONE',
  C_DONE:              'C_DONE',
  ENV_SNAPSHOT:        'DP_ENV_SNAPSHOT',
  SKIPS_JSON:          'DP_SKIP_COUNTS',
  ELIGIBLES_CHUNK:     'DP_ELIGIBLES',       // list from Stage B (pre-slot; optional/audit)
  SLOTS_CHUNK:         'DP_SLOTS',           // slots produced by Stage B → consumed by Stage C
  BUSY:                'DP_BUSY',            // 'true' / 'false'
  BUSY_SINCE:          'DP_BUSY_SINCE'       // ISO timestamp
};

// ── Property helpers
function _prop_(k, v) {
  const p = PropertiesService.getScriptProperties();
  if (typeof v === 'undefined') return p.getProperty(k);
  p.setProperty(k, v);
  return v;
}
function _propsDelete(prefix) {
  const p = PropertiesService.getScriptProperties();
  const all = p.getProperties();
  Object.keys(all).forEach(k => { if (k.startsWith(prefix)) p.deleteProperty(k); });
}

// ── Chunking helpers (stay below Apps Script per-prop limit)
function _setLargeJSON(keyBase, obj) {
  _propsDelete(keyBase + '_');
  const p = PropertiesService.getScriptProperties();
  const raw = JSON.stringify(obj || null);
  const CHUNK = 7500; // headroom under ~9KB
  const total = Math.ceil(raw.length / CHUNK) || 1;
  p.setProperty(keyBase + '_count', String(total));
  for (let i = 0; i < total; i++) {
    p.setProperty(`${keyBase}_part_${i}`, raw.slice(i * CHUNK, (i + 1) * CHUNK));
  }
}
function _getLargeJSON(keyBase) {
  const p = PropertiesService.getScriptProperties();
  const countStr = p.getProperty(keyBase + '_count');
  if (!countStr) return null;
  const total = parseInt(countStr, 10);
  let buf = '';
  for (let i = 0; i < total; i++) {
    buf += p.getProperty(`${keyBase}_part_${i}`) || '';
  }
  try { return JSON.parse(buf || 'null'); } catch (_) { return null; }
}
function _clearLargeJSON(keyBase) {
  _propsDelete(keyBase + '_');
  PropertiesService.getScriptProperties().deleteProperty(keyBase + '_count');
}

// ── Day reset (per timezone)
function _todayRunId_(tz) {
  return Utilities.formatDate(new Date(), tz || Session.getScriptTimeZone(), 'yyyyMMdd');
}
function _ensureFreshDay_(tz) {
  const today = _todayRunId_(tz);
  const current = _prop_(DP.RUN_ID);
  if (current !== today) {
    _prop_(DP.RUN_ID, today);
    _prop_(DP.STAGE, '');
    _prop_(DP.ENV_SNAPSHOT, '');
    _prop_(DP.SKIPS_JSON, '');
    _clearLargeJSON(DP.ELIGIBLES_CHUNK);
    _clearLargeJSON(DP.SLOTS_CHUNK);
    _prop_(DP.BUSY, 'false');
    _prop_(DP.BUSY_SINCE, '');
  }
}
function _afterEight_(tz) {
  const now = new Date();
  const hh = parseInt(Utilities.formatDate(now, tz, 'HH'), 10);
  return hh >= 8; // 08:00 or later
}

// ── Busy guard (no LockService; with stale clearing)
function _acquireBusy_(staleMinutes) {
  const now = new Date();
  const busy = (_prop_(DP.BUSY) || '').toLowerCase() === 'true';
  const sinceStr = _prop_(DP.BUSY_SINCE);
  if (busy && sinceStr) {
    const since = new Date(sinceStr);
    const ageMs = now - since;
    if (ageMs < (staleMinutes || 15) * 60000) {
      return false; // someone else is working
    }
    // stale
  }
  _prop_(DP.BUSY, 'true');
  _prop_(DP.BUSY_SINCE, now.toISOString());
  return true;
}
function _releaseBusy_() {
  _prop_(DP.BUSY, 'false');
  _prop_(DP.BUSY_SINCE, '');
}

/** ─────────────────────────────────────────────────────────────
 *  COORDINATOR — attach a single “every 30 minutes” trigger to this
 *  - Runs only after 08:00 (sheet TZ)
 *  - Resets day at first invocation per day
 *  - Runs A → B → C once/day, sequentially
 *  - Safe against overlap via BUSY flag (15-min stale)
 *  - Honors your kill switch
 *  - Idempotent: stages set DONE flags when finished
 *  - If a stage needs multiple ticks (very large data), you can add cursors later
 *  ─────────────────────────────────────────────────────────────*/
function ai_dailyPingsCoordinator() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();

  try {
    _ensureFreshDay_(tz);

    // Kill switch
    if (_isKillSwitchOn && _isKillSwitchOn()) {
      _logSchedule('Info', 'DailyPings/Coordinator', '', '', '', '', '', '', 'killSwitch=ON → exit');
      return;
    }

    // Earliest start
    if (!_afterEight_(tz)) {
      _logSchedule('Info', 'DailyPings/Coordinator', '', '', '', '', '', '', 'before 08:00 → exit');
      return;
    }

    // Busy guard
    if (!_acquireBusy_(15)) {
      _logSchedule('Info', 'DailyPings/Coordinator', '', '', '', '', '', '', 'busy → exit');
      return;
    }

    const stage = _prop_(DP.STAGE) || '';
    if (stage !== DP.A_DONE) {
      ai_dailyPings_stageA_(); // will set A_DONE
      _releaseBusy_();
      return;
    }

    if (stage === DP.A_DONE) {
      // If B not done, run B
      const stageNow = _prop_(DP.STAGE) || '';
      if (stageNow === DP.A_DONE) {
        ai_dailyPings_stageB_(); // will set B_DONE
        _releaseBusy_();
        return;
      }
    }

    if (_prop_(DP.STAGE) === DP.B_DONE) {
      ai_dailyPings_stageC_(); // will set C_DONE
      _releaseBusy_();
      return;
    }

    if (_prop_(DP.STAGE) === DP.C_DONE) {
      _logSchedule('Info', 'DailyPings/Coordinator', '', '', '', '', '', '', 'All stages done for today.');
      _releaseBusy_();
      return;
    }

    // Fallback
    _releaseBusy_();
  } catch (e) {
    _releaseBusy_();
    _logSchedule('Error', 'DailyPings/Coordinator', '', '', '', '', '', '', 'fatal: ' + String(e && e.message || e));
  }
}

/** ─────────────────────────────────────────────────────────────
 *  STAGE A — Housekeeping + header logging (sync + sort)
 *  - Idempotent; marks A_DONE when complete
 *  - Called by coordinator; manual wrapper bypasses time/stage checks
 *  ─────────────────────────────────────────────────────────────*/
function ai_dailyPings_stageA_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();
  const t0 = Date.now();

  _ensureFreshDay_(tz);

  // Header / env snapshot
  try {
    const killOn  = _isKillSwitchOn ? _isKillSwitchOn() : false;
    const testOn  = (typeof _isTestMode === 'function') ? _isTestMode() : false;
    const settings = S();
    const envLine = [
      `env: killSwitch=${killOn ? 'ON(disabled)' : 'OFF(enabled)'}`,
      `testMode=${testOn}`,
      `windowDays=${settings.WINDOW_DAYS}`,
      `cooldownDays=${settings.CONTACT_COOLDOWN_D}`,
      `quietWindowMin(Real)=${settings.QUIET_WINDOW_MIN_REAL}`,
      `stagger=${settings.STAGGER_START_HH}-${settings.STAGGER_END_HH}h, jitter=${settings.STAGGER_JITTER_MIN}-${settings.STAGGER_JITTER_MAX}m`,
      `maxDatesPerMsg=${settings.MAX_DATES_PER_MSG}`
    ].join(' | ');
    _prop_(DP.ENV_SNAPSHOT, envLine);
    _logSchedule('Start', 'DailyPings/A', '', '', '', '', '', '', envLine);
  } catch (_) {}

  // Housekeeping
  try {
    _logSchedule('Info', 'DailyPings/A', '', '', '', '', '', '', 'sync+sort: start');
    ai_syncAvailabilityWithCandidates();
    ai_sortAvailabilityByTierJobGenderSurname();
    _logSchedule('Info', 'DailyPings/A', '', '', '', '', '', '', 'sync+sort: done');
  } catch (e) {
    _logSchedule('Error', 'DailyPings/A', '', '', '', '', '', '', 'sync/sort failed: ' + String(e && e.message || e));
    return;
  }

  _prop_(DP.STAGE, DP.A_DONE);
  _logSchedule('End', 'DailyPings/A', '', '', '', '', '', '', `elapsedMs=${Date.now() - t0}`);
}

/** ─────────────────────────────────────────────────────────────
 *  STAGE B — Read, build eligibility, sort, assign staggered slots, cache
 *  - Requires A_DONE (unless manual wrapper)
 *  - Writes ELIGIBLES_CHUNK (optional) and SLOTS_CHUNK
 *  - Marks B_DONE when complete
 *  ─────────────────────────────────────────────────────────────*/
function ai_dailyPings_stageB_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();
  const t0 = Date.now();

  _ensureFreshDay_(tz);

  if (_prop_(DP.STAGE) !== DP.A_DONE) {
    _logSchedule('Info', 'DailyPings/B', '', '', '', '', '', '', `skip: Stage A not completed (stage=${_prop_(DP.STAGE) || 'NONE'})`);
    return;
  }

  const av = ss.getSheetByName(SH_AVAIL);
  if (!av) {
    _logSchedule('Error', 'DailyPings/B', '', '', '', '', '', '', 'Availability sheet missing');
    return;
  }

  // ---- local helpers for phone normalization ----
  const digitsOnly = (s) => String(s || '').replace(/\D+/g, '');
  const last10     = (s) => digitsOnly(s).slice(-10);

  try {
    const lastCol  = av.getLastColumn();
    const lastRow  = av.getLastRow();
    const dateHdrs = av.getRange(1, 7, 1, Math.max(lastCol - 6, 0)).getDisplayValues()[0];
    const bodyRows = Math.max(lastRow - 1, 0);

    if (!bodyRows || !dateHdrs.length) {
      _logSchedule('Info', 'DailyPings/B', '', '', '', '', '', '', `No body rows (${bodyRows}) or no date headers (${dateHdrs.length}). Exit.`);
      _setLargeJSON(DP.ELIGIBLES_CHUNK, []);
      _setLargeJSON(DP.SLOTS_CHUNK, []);
      _prop_(DP.SKIPS_JSON, JSON.stringify({}));
      _prop_(DP.STAGE, DP.B_DONE);
      return;
    }

    const rows = av.getRange(2, 1, bodyRows, lastCol).getDisplayValues();
    const bgs  = av.getRange(2, 7, bodyRows, Math.max(lastCol - 6, 0)).getBackgrounds();

    _logSchedule('Info', 'DailyPings/B', '', '', '', '', '', '', `read: rows=${rows.length}, dateCols=${dateHdrs.length}`);

    // ---- Build fast lookup maps from Candidate List (full digits & last-10) ----
    const cl     = ss.getSheetByName(SH_CANDIDATES);
    const clVals = cl ? cl.getDataRange().getValues() : [];
    let iPhone = -1, iTier = -1;

    const mapFullToTier   = new Map(); // "447412805426" -> tier (Number)
    const mapLast10ToTier = new Map(); // "7412805426"   -> tier (Number)

    if (clVals && clVals.length) {
      const clHdr = clVals[0].map(s => (s || '').toString().toLowerCase().trim());
      iPhone = clHdr.indexOf('telephone');
      iTier  = clHdr.indexOf('tier');
      if (iPhone < 0) iPhone = clHdr.findIndex(h => h.includes('phone')); // fallback if header is different
      if (iTier  < 0) iTier  = 7; // hard fallback to column H (0-based index)

      for (let r = 1; r < clVals.length; r++) {
        const rawPhone = clVals[r][iPhone];
        if (!rawPhone) continue;

        const full = digitsOnly(rawPhone);
        const ten  = last10(rawPhone);
        const tier = Number(clVals[r][iTier]) || 99;

        // First match wins (don't overwrite if duplicates)
        if (full && !mapFullToTier.has(full))   mapFullToTier.set(full, tier);
        if (ten  && !mapLast10ToTier.has(ten))  mapLast10ToTier.set(ten, tier);
      }
    } else {
      _logSchedule('Warn', 'DailyPings/B', '', '', '', '', '', '', 'Candidate List missing/empty — all phones will fail membership check');
    }

    // helper: resolve tier for a phone using maps
    const tierForPhone = (phone) => {
      const full = digitsOnly(phone);
      const ten  = last10(phone);
      if (full && mapFullToTier.has(full)) return mapFullToTier.get(full);
      if (ten  && mapLast10ToTier.has(ten)) return mapLast10ToTier.get(ten);
      return null; // not found
    };

    const fmtOpenDates = (opens) => {
      try { return opens.slice(0, 5).join(', ') + (opens.length > 5 ? ` (+${opens.length - 5} more)` : ''); }
      catch (_) { return ''; }
    };

    const todayElig = [];
    let considered = 0, added = 0;
    const skipCounts = { noPhone: 0, notInCL: 0, aiOptOut: 0, dnd: 0, quiet: 0, cooldown: 0, noOpen: 0 };

    for (let i = 0; i < rows.length; i++) {
      considered++;
      const surname = (rows[i][0] || '').toString().trim();
      const first   = (rows[i][1] || '').toString().trim();
      const phone   = (rows[i][3] || '').toString().trim();
      const label   = `${surname} ${first}`.trim() || '(unknown)';

      const reasons = [];
      if (!phone) {
        skipCounts.noPhone++; reasons.push('no phone');
        _logSchedule('Skip','DailyPings/B', phone, '', '', '', '', '', `[${label}] ${reasons.join('; ')}`);
        continue;
      }

      // Single-source-of-truth: membership + tier from Candidate List via normalized matching
      const clTier = tierForPhone(phone);
      if (clTier === null) { skipCounts.notInCL++; reasons.push('not in Candidate List'); }

      if (_isAiOptOut(phone)) { skipCounts.aiOptOut++; reasons.push('AI=NO'); }

      const conv = _conversationsFindMostRecentAny(phone);

      // DND / Quiet checks
      if (conv && conv.DoNotDisturbUntil && new Date(conv.DoNotDisturbUntil) > new Date()) {
        skipCounts.dnd++; reasons.push(`DND until ${Utilities.formatDate(new Date(conv.DoNotDisturbUntil), tz, 'dd/MM HH:mm')}`);
      }
      if (conv && conv.QuietUntil && new Date(conv.QuietUntil) > new Date()) {
        skipCounts.quiet++; reasons.push(`Quiet until ${Utilities.formatDate(new Date(conv.QuietUntil), tz, 'dd/MM HH:mm')}`);
      }

      // Cooldown
      const lastStart = conv && conv.LastStartTs ? new Date(conv.LastStartTs) : null;
      if (lastStart) {
        const days = (Date.now() - lastStart.getTime()) / (1000 * 3600 * 24);
        if (days < S().CONTACT_COOLDOWN_D) {
          skipCounts.cooldown++;
          reasons.push(`cooldown ${days.toFixed(2)}d < ${S().CONTACT_COOLDOWN_D}d`);
        }
      }

      // Open date cells
      let openCount = 0;
      const openDates = [];
      for (let c = 0; c < dateHdrs.length; c++) {
        const val = (rows[i][6 + c] || '').toString();
        const bg  = bgs[i][c];
        if (!val && bg !== COLOR_BOOKED) {
          const cell   = av.getRange(i + 2, 7 + c);
          const disp   = cell.getDisplayValue().toUpperCase();
          const cellBg = cell.getBackground();
          if (disp === 'BLOCKED' && cellBg === COLOR_BLOCKED) continue;
          if (cellBg === COLOR_UNAVAIL) continue;
          openCount++;
          const m = String(dateHdrs[c]).match(/(\d{2}\/\d{2}\/\d{4})/);
          openDates.push(m ? m[1] : dateHdrs[c]);
        }
        if (openCount >= 50) break;
      }
      if (!openCount) { skipCounts.noOpen++; reasons.push('no open dates'); }

      // Emit skip or mark eligible
      if (reasons.length) {
        _logSchedule('Skip','DailyPings/B', phone, '', '', '', '', '', `[${label}] ${reasons.join(' | ')}`);
        continue;
      }

      // Use the resolved tier if present, else 99
      const tierVal = (clTier !== null) ? Number(clTier) || 99 : 99;
      const lastStartTs = lastStart ? lastStart.getTime() : 0;

      todayElig.push({ phone, tier: tierVal, lastStartTs, label, openCount, openDates });
      added++;

      _logSchedule('Eligible','DailyPings/B', phone, '', '', '', '', '', `[${label}] tier=${tierVal} lastStartTs=${lastStartTs || 0} openDates=${openCount} (${fmtOpenDates(openDates)})`);
    }

    _logSchedule(
      'Info',
      'DailyPings/B',
      '',
      '',
      '',
      '',
      '',
      '',
      `considered=${considered} eligible=${added} | skips: ` + Object.entries(skipCounts).map(([k,v]) => `${k}=${v}`).join(', ')
    );

    // If none eligible, mark and exit so C won’t waste time
    if (!todayElig.length) {
      _setLargeJSON(DP.ELIGIBLES_CHUNK, []);
      _setLargeJSON(DP.SLOTS_CHUNK, []);
      _prop_(DP.SKIPS_JSON, JSON.stringify(skipCounts));
      _prop_(DP.STAGE, DP.B_DONE);
      _logSchedule('End', 'DailyPings/B', '', '', '', '', '', '', `No eligible candidates — nothing to schedule. elapsedMs=${Date.now() - t0}`);
      return;
    }

    // Sort + slot
    todayElig.sort((a, b) => a.tier - b.tier || a.lastStartTs - b.lastStartTs || a.phone.localeCompare(b.phone));
    _logSchedule('Info', 'DailyPings/B', '', '', '', '', '', '', `sorted eligible count=${todayElig.length}; head=${todayElig[0].phone} [${todayElig[0].label}]`);

    const slots = _assignStaggeredSlotsToday(todayElig);
    _logSchedule('Info', 'DailyPings/B', '', '', '', '', '', '', `slots assigned=${slots.length}`);

    // Cache for Stage C
    _setLargeJSON(DP.ELIGIBLES_CHUNK, todayElig);  // optional, for audit
    _setLargeJSON(DP.SLOTS_CHUNK, slots);
    _prop_(DP.SKIPS_JSON, JSON.stringify(skipCounts));

    _prop_(DP.STAGE, DP.B_DONE);
    _logSchedule('End', 'DailyPings/B', '', '', '', '', '', '', `scheduled(slots)=${slots.length}; elapsedMs=${Date.now() - t0}`);

  } catch (e) {
    _logSchedule('Error', 'DailyPings/B', '', '', '', '', '', '', 'fatal: ' + String(e && e.message || e));
  }
}


/** ─────────────────────────────────────────────────────────────
 *  STAGE C — Upsert conversations + queue pending follow-ups (send __OPEN__)
 *  - Requires B_DONE (unless manual wrapper)
 *  - Consumes SLOTS_CHUNK
 *  - Marks C_DONE when complete
 *  ─────────────────────────────────────────────────────────────*/
function ai_dailyPings_stageC_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();
  const t0 = Date.now();

  _ensureFreshDay_(tz);

  if (_prop_(DP.STAGE) !== DP.B_DONE) {
    _logSchedule('Info', 'DailyPings/C', '', '', '', '', '', '', `skip: Stage B not completed (stage=${_prop_(DP.STAGE) || 'NONE'})`);
    return;
  }

  try {
    const slots = _getLargeJSON(DP.SLOTS_CHUNK) || [];
    if (!slots.length) {
      _logSchedule('End', 'DailyPings/C', '', '', '', '', '', '', `No slots to action. elapsedMs=${Date.now() - t0}`);
      _prop_(DP.STAGE, DP.C_DONE);
      return;
    }

    // Helper: coerce any value to a valid Date or null
    const asDate = (v) => {
      if (v instanceof Date) return isNaN(v) ? null : v;
      if (typeof v === 'number') {
        const d = new Date(v);
        return isNaN(d) ? null : d;
      }
      if (typeof v === 'string' && v) {
        // Try ISO first; if that fails, let Date(string) parse it best-effort
        const d = new Date(v);
        return isNaN(d) ? null : d;
      }
      return null;
    };

    slots.forEach(s => {
      // Seed conversation (idempotency guard could be added here if needed)
      const convoId = _newConvoId();
      _conversationsUpsert({
        Phone: s.phone,
        ConversationID: convoId,
        Summary: 'Opener scheduled',
        LastInteractionsJSON: JSON.stringify([{ from: 'system', msg: '[opener scheduled]', ts: new Date().toISOString() }]),
        LastUpdated: new Date(),
        InitiatedBy: 'BOT',
        TTLExpiry: new Date(Date.now() + S().CONVO_TTL_MIN * 60000),
        LastBotMessageTs: '',
        Origin: 'appscript',
        TemplateSent: false,
        LastStartTs: '',
        LastStartKind: 'scheduled',
        Flow: 'availability',
        PendingConfirmJSON: '',
        Status: 'Open'
      });

      // Normalize schedule time
      let dueAt = asDate(s.testAt) || asDate(s.realAt);
      if (!dueAt) {
        // Fallback: schedule immediately to avoid crashing; log why
        dueAt = new Date();
        _logSchedule('Warn', 'DailyPings/C', s.phone, convoId, '', '', '', '',
          `Invalid slot time; falling back to now. testAt=${String(s.testAt)} realAt=${String(s.realAt)}`
        );
      }

      // Queue opener
      _setPendingFollowup(s.phone, '__OPEN__', dueAt, 'Slotting', 'daily opener slot');

      // Detailed schedule log
      _logSchedule(
        'Scheduled',
        'Slotting',
        s.phone,
        convoId,
        s.realHuman,
        s.testDelaySec,
        asDate(s.realAt) ? asDate(s.realAt).toISOString() : '',
        dueAt.toISOString(),
        'daily opener slot'
      );
    });

    _prop_(DP.STAGE, DP.C_DONE);
    _logSchedule('End', 'DailyPings/C', '', '', '', '', '', '', `scheduled=${slots.length}; elapsedMs=${Date.now() - t0}`);

  } catch (e) {
    _logSchedule('Error', 'DailyPings/C', '', '', '', '', '', '', 'fatal: ' + String(e && e.message || e));
  }
}


