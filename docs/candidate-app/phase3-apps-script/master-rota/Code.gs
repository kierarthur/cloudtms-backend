}

// Override previous sheet-name checks:
// if (!isPatientSheetName(sheet.getName())) return;

function getFilteredRoleOptions() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  if (!isPatientSheetName(sheet.getName())) return [];

  // grab all headers in row 3, cols C→end
  const raw = sheet.getRange(3, 3, 1, sheet.getLastColumn() - 2)
                   .getValues()[0]
                   .map(h => h.toString().trim())
                   .filter(h => /RMN|HCA/i.test(h));

  // group by RMN vs HCA
  const byRole = { RMN: new Set(), HCA: new Set() };
  raw.forEach(h => {
    const base = /\b(RMN|HCA)\b/i.exec(h)[1].toUpperCase();
    byRole[base].add(h);
  });

  const options = [];
  ['RMN','HCA'].forEach(role => {
    const variants = Array.from(byRole[role]);
    const hasUnisex = variants.some(v => /\(male or female\)/i.test(v));
    const hasMale   = variants.some(v => /\bmale\b/i.test(v));
    const hasFem    = variants.some(v => /\bfemale\b/i.test(v));

    if (hasUnisex || (hasMale && hasFem)) {
      options.push({ label: `All ${role}s`, role, gender: 'any' });
    } else if (hasMale) {
      options.push({ label: `Male ${role}s`, role, gender: 'male' });
    } else if (hasFem) {
      options.push({ label: `Female ${role}s`, role, gender: 'female' });
    }
  });

  // ↪ If you have HCA columns but *no* RMN columns, add an
  //    “Include RMNs” option (same gender-filter as the HCAs you do have)
  const hasRMN = Boolean(byRole.RMN.size);
  const hasHCA = Boolean(byRole.HCA.size);
  if (!hasRMN && hasHCA) {
    const hcaOpt = options.find(o => o.role === 'HCA');
    const gender = hcaOpt.gender;
    const label  = gender === 'any'
      ? 'Include All RMNs'
      : `Include ${gender.charAt(0).toUpperCase() + gender.slice(1)} RMNs`;
    options.push({ label, role: 'RMN', gender });
  }

  return options;
}


// Updated filtering to apply role options, exclusion, and tier
/**
 * Filter candidates based on the role-options checkboxes and the selected tier.
 *
 * @param {Object} form
 * @param {{label:string, role:string, gender?:string, excludeRole?:string}[]} form.roleOptions
 *   Array of rules, each with:
 *     – label:       the checkbox label (only for display)
 *     – role:        "RMN" or "HCA"
 *     – gender?:     "male", "female", or "any"
 *     – excludeRole?: if set, exclude that role entirely
 * @param {string} form.tier
 *   One of '1','2','3','4' or 'SPECIFIC'
 * @returns {string[]}  Array of selected "Surname Firstname" strings
 */
function filterCandidatesByForm(form) {
  const opts = form.roleOptions || [];
  const tier = form.tier;

  // 1) Read every candidate as { fullName, jobTitle, gender, tier }
  const all = getCandidateList();

  // 2) Include/exclude by role+gender
  let filtered = all.filter(c => {
    const include = opts.some(o => {
      if (o.excludeRole) return false;
      const roleMatch   = c.jobTitle === o.role;
      const genderMatch = o.gender === 'any' || c.gender === o.gender;
      return roleMatch && genderMatch;
    });
    const exclude = opts.some(o => o.excludeRole === c.jobTitle);
    return include && !exclude;
  });

  // 3) Apply tier filter (unless '4' = all tiers or 'SPECIFIC' = manual pick)
  if (tier !== '4' && tier !== 'SPECIFIC') {
    const tnum = parseInt(tier, 10);
    filtered = filtered.filter(c => c.tier === tnum);
  }

  // 4) Return just the array of names
  return filtered.map(c => c.fullName);
}

