}

/************************************************************
 * REVISED saveCandidateEdit — now cascades to Availability and Links, then refreshes caches
 ************************************************************/
function saveCandidateEdit(args, opts) {
  if (!args || !args.rowNo) throw new Error('Row number is required.');
  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sh = ss.getSheetByName(CANDIDATE_SHEET_NAME);
    if (!sh) throw new Error('Candidate List sheet not found.');
    const last = sh.getLastRow();
    if (args.rowNo < 2 || args.rowNo > last) throw new Error('Row out of range.');

    // 1) Read existing (pre-edit) + validate incoming (validator normalises status)
    const existing = readCandidateRow(args.rowNo);
    if (!existing) throw new Error('Existing candidate not found.');

    const norm = validateAndNormaliseCandidatePayload(args, { requireRowNo: true });

    // --- Public ID logic:
    // If existing ID is non-blank -> immutable (must not change, and DO NOT recheck).
    // If existing ID is blank and a new one is provided -> STRICT gating identical to createCandidate.
    const oldPid = String(existing.publicId || '').trim();
    const newPid = String(norm.publicId || '').trim();

    if (oldPid) {
      if (newPid !== oldPid) {
        throw new Error('Credentially Public ID cannot be changed on edit.');
      }
      // No recheck here (unchanged & locked).
    } else if (newPid) {
      // STRICT gating – SAME as createCandidate:
      let credResult, classification = null;
      try {
        credResult = fetchCredentiallyWithLog(newPid); // logging wrapper
      } catch (e) {
        credResult = { fetchError: true, message: String(e) }; // non-blocking fetch error, but we require FOUND below
      }
      classification = classifyCredentiallyResponse(credResult);

      if (classification !== 'FOUND') {
        throw new Error(`Credentially Public ID could not be verified: ${newPid}`);
      }
      const credName    = buildCredentiallyDisplayName(credResult);
      const enteredName = `${norm.surname} ${norm.firstname}`;
      if (!namesLooselyMatch(enteredName, credName)) {
        throw new Error(`CRED_NAME_MISMATCH|${enteredName}|${credName}`);
      }
      // PASS: we will write the new verified ID below
    }

    // 2) Detect changes (for rename propagation)
    const oldNameLower = nameKeyLower(existing.surname, existing.firstname);
    const newNameLower = nameKeyLower(norm.surname, norm.firstname);
    const nameChanged  = (oldNameLower !== newNameLower);

    // 3) Guard: name collision on rename
    if (nameChanged) {
      const dup = findDuplicateInCandidateList({
        email: null, telephone: null, nameLower: newNameLower, ignoreRowNo: args.rowNo
      });
      if (dup) throw new Error(dup);
    }

    // 4) Guard: email/tel dups (ignore own row)
    const dup2 = findDuplicateInCandidateList({
      email: norm.email, telephone: norm.telephone, nameLower: null, ignoreRowNo: args.rowNo
    });
    if (dup2) throw new Error(dup2);

    // 5) (No Public ID recheck when unchanged.)

    // 6) Write Candidate List row
    sh.getRange(args.rowNo, COL.SURNAME).setValue(norm.surname);
    sh.getRange(args.rowNo, COL.FIRSTNAME).setValue(norm.firstname);
    sh.getRange(args.rowNo, COL.EMAIL).setValue(norm.email);
    sh.getRange(args.rowNo, COL.TELEPHONE).setValue(norm.telephone);
    sh.getRange(args.rowNo, COL.JOBTITLE).setValue(norm.jobTitle);
    sh.getRange(args.rowNo, COL.GENDER).setValue(norm.gender);
    sh.getRange(args.rowNo, COL.TIER).setValue(norm.tier);

    // Public ID write:
    // - If oldPid existed, keep it (immutable)
    // - If oldPid was blank and newPid passed gating, write the newPid
    const pidToWrite = oldPid || newPid || '';
    sh.getRange(args.rowNo, COL.PUBLICID).setValue(pidToWrite);

    // NEW: (Re)generate Candidate_ID for this row after Public ID is set
    generateAndWriteCandidateIdForRow_(args.rowNo);

    // Status — validator-normalised (ACTIVE/INACTIVE)
    sh.getRange(args.rowNo, COL.STATUS).setValue(norm.status);

    // 7) Propagate name to rotas + EmailHistory if renamed
    if (nameChanged) {
      propagateRenameOnActiveRotas(oldNameLower, norm.surname, norm.firstname);
      updateEmailHistoryName(oldNameLower, newNameLower);
    }

    // 8) Cascade to Availability (A..F) in this workbook
    const availRes = _cascadeAvailabilityRow_(
      { surname: existing.surname, firstname: existing.firstname, email: existing.email, telephone: existing.telephone, jobTitle: existing.jobTitle, gender: existing.gender },
      { surname: norm.surname, firstname: norm.firstname, email: norm.email, telephone: norm.telephone, jobTitle: norm.jobTitle, gender: norm.gender }
    );

    // 9) Update Availability API Links workbook IN PLACE (by URL)
    const linksRes = _updateLinksRowInPlace_(
      { surname: existing.surname, firstname: existing.firstname, email: existing.email, telephone: existing.telephone },
      { surname: norm.surname, firstname: norm.firstname, email: norm.email, telephone: norm.telephone }
    );

    // 10) Nudge/warm the app caches
    _refreshAvailabilityApi_({
      oldKeyLower: oldNameLower,
      newKeyLower: newNameLower,
      oldTelLocal: _normaliseLocalTelUK_(existing.telephone),
      newTelLocal: _normaliseLocalTelUK_(norm.telephone),
      nameChanged
    });

    ai_syncAvailabilityWithCandidates();
    return `Candidate updated | Availability: ${availRes.status} | Links: ${linksRes.status}`;
  } finally {
    lock.releaseLock();
  }
}

/************************************************************
 * Availability cascade: update A..F in place
 ************************************************************/
function _cascadeAvailabilityRow_(oldVals, nextVals) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const found = _findAvailabilitySheetAndMap_(ss);
  if (!found) return { status: 'AV_NOT_FOUND', updated: 0, matched: 0 };

  const { sh, map } = found;
  const last = sh.getLastRow();
  if (last < 2) return { status: 'AV_EMPTY', updated: 0, matched: 0 };

  const rng = sh.getRange(2, 1, last - 1, Math.max(map.surname, map.first, map.email, map.tel, map.job, map.gender) + 1).getValues();

  const oldSurnameLower = String(oldVals.surname || '').trim().toLowerCase();
  const oldFirstLower   = String(oldVals.firstname || '').trim().toLowerCase();
  const oldEmailLower   = String(oldVals.email || '').trim().toLowerCase();
  const oldTelLocal     = _normaliseLocalTelUK_(oldVals.telephone);

  const nextSurnameTC   = titleCaseNamePart(String(nextVals.surname || '').trim());
  const nextFirstTC     = titleCaseNamePart(String(nextVals.firstname || '').trim());
  const nextEmail       = String(nextVals.email || '').trim();
  const nextTelLocal    = _normaliseLocalTelUK_(nextVals.telephone);
  const nextJob         = String(nextVals.jobTitle || '').trim();
  const nextGender      = String(nextVals.gender || '').trim();

  let matched = 0, updated = 0;
  const writes = [];

  for (let i = 0; i < rng.length; i++) {
    const row = rng[i];

    const rSurnameLower = String(row[map.surname] || '').trim().toLowerCase();
    const rFirstLower   = String(row[map.first]   || '').trim().toLowerCase();
    if (rSurnameLower !== oldSurnameLower || rFirstLower !== oldFirstLower) continue;

    // Secondary guard to avoid name collisions:
    const rEmailLower = map.email >= 0 ? String(row[map.email] || '').trim().toLowerCase() : '';
    const rTelLocal   = map.tel   >= 0 ? _normaliseLocalTelUK_(row[map.tel]) : '';

    if (rEmailLower || rTelLocal) {
      if (oldEmailLower && rEmailLower === oldEmailLower) {
        // ok
      } else if (oldTelLocal && rTelLocal && rTelLocal === oldTelLocal) {
        // ok
      } else {
        continue; // collision, skip this row
      }
    }

    matched++;

    // Prepare new row values A..F
    const newRow = [...row];
    let rowChanged = false;

    function setIfChanged(idx, val) {
      if (idx < 0) return;
      if (String(newRow[idx] || '') !== String(val || '')) {
        newRow[idx] = val;
        rowChanged = true;
      }
    }

    setIfChanged(map.surname, nextSurnameTC);
    setIfChanged(map.first,   nextFirstTC);
    setIfChanged(map.email,   nextEmail);
    setIfChanged(map.tel,     nextTelLocal);
    setIfChanged(map.job,     nextJob);
    setIfChanged(map.gender,  nextGender);

    if (rowChanged) {
      writes.push({ r: i + 2, values: newRow });
      updated++;
    }
  }

  // Apply writes (only rows that changed)
  if (writes.length) {
    const maxCols = rng[0].length;
    const ranges = writes.map(w => sh.getRange(w.r, 1, 1, maxCols));
    // To minimize write calls, setValues row-by-row (small N), or you can RangeList -> setValues individually
    ranges.forEach((range, i) => range.setValues([writes[i].values]));
  }

  return { status: 'OK', matched, updated };
}

/************************************************************
 * Availability API Links updater — edit-in-place by URL
 ************************************************************/
function _updateLinksRowInPlace_(oldVals, nextVals) {
  const ssLinks = SpreadsheetApp.openByUrl(AVAILABILITY_API_LINKS_URL);
  const found = _findLinksSheetAndMap_(ssLinks);
  if (!found) return { status: 'LINKS_NOT_FOUND' };

  const { sh, map } = found;
  const last = sh.getLastRow();
  if (last < 2) return { status: 'LINKS_EMPTY' };

  const headerCols = Math.max(
    map.surname, map.first, map.email, map.tel,
    (map.status ?? 0), (map.pwh ?? 0), (map.pws ?? 0),
    (map.pwd ?? 0), (map.createdAt ?? 0), (map.revokedAt ?? 0)
  ) + 1;

  const rng = sh.getRange(2, 1, last - 1, headerCols).getValues();

  const oldEmailLower = String(oldVals.email || '').trim().toLowerCase();
  const oldTelLocal   = _normaliseLocalTelUK_(oldVals.telephone);
  const newTelLocal   = _normaliseLocalTelUK_(nextVals.telephone);

  // 1) Primary: find by oldTel
  let targetIdx = -1;
  for (let i = 0; i < rng.length; i++) {
    const rTel = map.tel >= 0 ? _normaliseLocalTelUK_(rng[i][map.tel]) : '';
    if (rTel && rTel === oldTelLocal) { targetIdx = i; break; }
  }

  // 2) Fallback: by oldEmail
  if (targetIdx < 0 && oldEmailLower) {
    for (let i = 0; i < rng.length; i++) {
      const rEmailLower = map.email >= 0 ? String(rng[i][map.email] || '').trim().toLowerCase() : '';
      if (rEmailLower && rEmailLower === oldEmailLower) { targetIdx = i; break; }
    }
  }

  // 3) Fallback: by newTel (if user was pre-migrated manually)
  if (targetIdx < 0 && newTelLocal) {
    for (let i = 0; i < rng.length; i++) {
      const rTel = map.tel >= 0 ? _normaliseLocalTelUK_(rng[i][map.tel]) : '';
      if (rTel && rTel === newTelLocal) { targetIdx = i; break; }
    }
  }

  if (targetIdx < 0) return { status: 'NOT_FOUND' };

  // Decide the "primary" row for newTel (avoid dup active rows)
  const dupIdxs = [];
  for (let i = 0; i < rng.length; i++) {
    if (i === targetIdx) continue;
    const rTel = map.tel >= 0 ? _normaliseLocalTelUK_(rng[i][map.tel]) : '';
    if (rTel && rTel === newTelLocal) dupIdxs.push(i);
  }

  // Prefer row with a password hash as primary
  function hasHash(row) {
    return map.pwh >= 0 && String(row[map.pwh] || '').trim() !== '' &&
           map.pws >= 0 && String(row[map.pws] || '').trim() !== '';
  }

  let primaryIdx = targetIdx;
  if (dupIdxs.length) {
    const cands = [targetIdx, ...dupIdxs];
    const withHash = cands.filter(i => hasHash(rng[i]));
    if (withHash.length) {
      // choose the most recently updated (PasswordUpdatedAt or CreatedAt)
      primaryIdx = withHash.sort((a,b) => _rowRecency_(rng[b], map) - _rowRecency_(rng[a], map))[0];
    } else {
      primaryIdx = cands[0]; // arbitrary but stable
    }
  }

  // 4) Write new values into the primary row
  const row = rng[primaryIdx].slice(); // clone
  const newSurnameTC = titleCaseNamePart(String(nextVals.surname || '').trim());
  const newFirstTC   = titleCaseNamePart(String(nextVals.firstname || '').trim());
  const newEmail     = String(nextVals.email || '').trim();

  function setIfChanged(idx, val) { if (idx >= 0 && String(row[idx] || '') !== String(val || '')) row[idx] = val; }

  setIfChanged(map.surname, newSurnameTC);
  setIfChanged(map.first,   newFirstTC);
  setIfChanged(map.tel,     newTelLocal);
  setIfChanged(map.email,   newEmail);

  // Apply primary write
  sh.getRange(primaryIdx + 2, 1, 1, row.length).setValues([row]);

  // 5) Deactivate/mark duplicates that also carry newTel (avoid two Active rows)
  if (dupIdxs.length) {
    const toDeactivate = dupIdxs.filter(i => i !== primaryIdx);
    toDeactivate.forEach(i => {
      if (map.status >= 0) sh.getRange(i + 2, map.status + 1).setValue('Inactive');
      if (map.revokedAt >= 0) sh.getRange(i + 2, map.revokedAt + 1).setValue(new Date().toISOString());
    });
  }

  return { status: 'OK', primaryRow: primaryIdx + 2, deactivated: dupIdxs.length };
}

/************************************************************
 * App refresh (Availability API doPost warmers)
 ************************************************************/
function _refreshAvailabilityApi_({ oldKeyLower, newKeyLower, oldTelLocal, newTelLocal, nameChanged }) {
  const url = _getAvailabilityApiUrl_();
  if (!url) return { sent: false, reason: 'NO_API_URL' };

  const token = _getAvailabilityApiToken_();
  const q = token ? ('?k=' + encodeURIComponent(token)) : '';

  // 1) If renamed, bump EH revision and warm msisdns mapped from keys
  if (nameChanged) {
    const bodyEH = { action: 'EMAILHISTORY_UPDATED', keys: [oldKeyLower, newKeyLower] };
    try {
      UrlFetchApp.fetch(url + q, {
        method: 'post',
        contentType: 'application/json',
        payload: JSON.stringify(bodyEH),
        muteHttpExceptions: true
      });
    } catch (_) {}
  }

  // 2) Warm tiles for the new tel (and optionally clear old)
  const items = [];
  if (newTelLocal) items.push({ msisdn: newTelLocal });
  if (oldTelLocal && oldTelLocal !== newTelLocal) items.push({ msisdn: oldTelLocal });

  if (items.length) {
    const bodyWarm = { action: 'AVAILABILITY_PARTIAL_UPDATED', items };
    try {
      UrlFetchApp.fetch(url + q, {
        method: 'post',
        contentType: 'application/json',
        payload: JSON.stringify(bodyWarm),
        muteHttpExceptions: true
      });
    } catch (_) {}
  }

  return { sent: true };
}

/************************************************************
 * Sheet discovery & header mapping (robust to column reorders)
 ************************************************************/
function _findAvailabilitySheetAndMap_(ss) {
  // We look for a sheet whose header row contains at least:
  // Surname, First OR First Name, Email, Telephone, Job Title, Gender
  const want = {
    surname: ['surname'],
    first:   ['first name','first'],
    email:   ['email'],
    tel:     ['telephone','phone','mobile','tel'],
    job:     ['job title','job'],
    gender:  ['gender','sex']
  };

  const sheets = ss.getSheets();
  for (const sh of sheets) {
    const header = sh.getRange(1,1,1,Math.min(sh.getMaxColumns(), 50)).getDisplayValues()[0].map(h => String(h || '').trim());
    if (!header.length) continue;
    const map = _mapHeaders_(header, want);
    if (map && map.surname >= 0 && map.first >= 0 && map.email >= 0 && map.tel >= 0 && map.job >= 0 && map.gender >= 0) {
      return { sh, map };
    }
  }
  return null;
}

function _findLinksSheetAndMap_(ss) {
  // Minimum we require to edit in place:
  // Surname, First, Telephone, Email (and we'll optionally read Status/Hash/Salt/CreatedAt/RevokedAt)
  const want = {
    surname: ['surname'],
    first:   ['first name','first'],
    email:   ['email'],
    tel:     ['telephone','phone','mobile','tel'],
    status:  ['status'],
    createdAt: ['createdat','created at'],
    revokedAt: ['revokedat','revoked at'],
    newUser: ['newuser','new user'],
    pwh:     ['passwordhash','hash'],
    pws:     ['passwordsalt','salt'],
    pwd:     ['passwordupdatedat','password updated at','pwd updated','pwd updated at'],
    token:   ['token'],
    url:     ['url'],
    resetToken: ['resettoken','reset token'],
    resetExpiresAt: ['resetexpiresat','reset expires at']
  };

  const sheets = ss.getSheets();
  for (const sh of sheets) {
    const header = sh.getRange(1,1,1,Math.min(sh.getMaxColumns(), 50)).getDisplayValues()[0].map(h => String(h || '').trim());
    if (!header.length) continue;
    const map = _mapHeaders_(header, want);
    if (map && map.surname >= 0 && map.first >= 0 && map.email >= 0 && map.tel >= 0) {
      return { sh, map };
    }
  }
  return null;
}

function _mapHeaders_(headerRow, wantSpec) {
  const idxByKey = {};
  const lower = headerRow.map(h => h.toLowerCase());
  function findIdx(aliases) {
    for (const a of aliases) {
      const k = a.toLowerCase();
      const idx = lower.findIndex(h => h === k);
      if (idx >= 0) return idx;
      // also allow simple contains (e.g. "PasswordHash" vs "Password Hash")
      const idx2 = lower.findIndex(h => h.replace(/\s+/g,'') === k.replace(/\s+/g,''));
      if (idx2 >= 0) return idx2;
    }
    return -1;
  }
  for (const key of Object.keys(wantSpec)) {
    idxByKey[key] = findIdx(wantSpec[key]);
  }
  return idxByKey;
}

/************************************************************
 * Small utilities
 ************************************************************/
function _normaliseLocalTelUK_(tel) {
  // Return UK local form "0XXXXXXXXXX" when possible. Otherwise, a digits-only best-effort.
  let s = String(tel || '').trim();
  if (!s) return '';
  s = s.replace(/[^\d+]/g, ''); // keep digits and +
  // +44xxxxxxxxxx -> 0xxxxxxxxxx
  if (s.startsWith('+44')) s = '0' + s.slice(3);
  // 0044xxxxxxxxxx -> 0xxxxxxxxxx
  if (s.startsWith('0044')) s = '0' + s.slice(4);
  // bare 44xxxxxxxxxx -> 0xxxxxxxxxx
  if (s.startsWith('44') && s.length >= 12) s = '0' + s.slice(2);
  // strip non-digits now
  s = s.replace(/\D/g, '');
  // pad/trim to 11 if clearly a UK local; else return digits-only fallback
  if (s.length === 11 && s.startsWith('0')) return s;
  return s;
}

function _rowRecency_(row, map) {
  // Prefer PasswordUpdatedAt, then CreatedAt; return epoch ms for sort
  const iso1 = map.pwd >= 0 ? String(row[map.pwd] || '') : '';
  const iso2 = map.createdAt >= 0 ? String(row[map.createdAt] || '') : '';
  const t1 = Date.parse(iso1) || 0;
  const t2 = Date.parse(iso2) || 0;
  return Math.max(t1, t2);
}

function fetchCredentiallyWithLog(employeeId) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const logSh = ss.getSheetByName('Logs');
  const ts = new Date();

  const url = 'https://app.credentially.io/mp/api/v1/employees/' + employeeId;
  let result, code, text;

  try {
    const resp = UrlFetchApp.fetch(url, {
      method: 'get',
      headers: {
        'Accept': 'application/json',
        'Authorization': 'Bearer ' + CREDENTIALLY_TOKEN
      },
      muteHttpExceptions: true
    });
    code = resp.getResponseCode();
    text = resp.getContentText();
    if (code !== 200) {
      result = { errorCode: code, body: text };
    } else {
      result = JSON.parse(text);
    }
  } catch (err) {
    if (logSh) {
      logSh.appendRow([ts, 'Credentially', employeeId, 'EXCEPTION', String(err)]);
    }
    throw err;
  }

  if (logSh) {
    logSh.appendRow([ts, 'Credentially', employeeId, JSON.stringify(result)]);
  }

  return result;
}


/* ---------------------------
   Credentially helpers (logic)
---------------------------- */

/** Classify Credentially response into FOUND / NOT_FOUND / OTHER_ERROR. */
function classifyCredentiallyResponse(credResult) {
  // Success path: parsed JSON with expected shape (no errorCode field)
  if (credResult && typeof credResult === 'object' && credResult.id && credResult.firstName && credResult.lastName) {
    return 'FOUND';
  }

  // Error path from fetchCredentially (non-200)
  if (credResult && credResult.errorCode) {
    try {
      const body = JSON.parse(credResult.body || '{}');

      // Treat any "error.notFound" (regardless of entity) OR explicit 404 code as NOT_FOUND
      if ((body && body.error === 'error.notFound') || credResult.errorCode === 404) {
        return 'NOT_FOUND';
      }
    } catch (_) {
      // ignore parse errors, fall through
    }
    return 'OTHER_ERROR';
  }

  // Network or unexpected structure
  if (credResult && credResult.fetchError) return 'OTHER_ERROR';

  return 'OTHER_ERROR';
}


/** Build "Surname Firstname" string from Credentially payload. */
function buildCredentiallyDisplayName(credPayload) {
  const ln = titleCaseNamePart(String(credPayload.lastName || '').trim());
  const fn = titleCaseNamePart(String(credPayload.firstName || '').trim());
  return `${ln} ${fn}`.trim();
}

/** Normalise names for loose matching (ignore case, spaces, hyphens, apostrophes). */
function normaliseNameLoose(s) {
  return String(s || '')
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')      // strip diacritics
    .replace(/[-'\s]/g, '')               // drop hyphen, apostrophe, spaces
    .replace(/[^a-z0-9]/g, '');           // strip anything else
}

/** Loose compare for "Surname Firstname" vs "Surname Firstname" with extra tokens toleration. */
function namesLooselyMatch(a, b) {
  // Quick check by aggressive normalisation
  if (normaliseNameLoose(a) === normaliseNameLoose(b)) return true;

  // Token tolerant: surnames and first names as leading tokens must match loosely
  const toksA = String(a || '').toLowerCase().split(/\s+/).filter(Boolean);
  const toksB = String(b || '').toLowerCase().split(/\s+/).filter(Boolean);
  if (!toksA.length || !toksB.length) return false;

  const aSurname = normaliseNameLoose(toksA[0]);
  const aFirst   = normaliseNameLoose(toksA[1] || '');
  const bSurname = normaliseNameLoose(toksB[0]);
  const bFirst   = normaliseNameLoose(toksB[1] || '');

  return aSurname === bSurname && (!!aFirst && !!bFirst ? aFirst === bFirst : true);
}

/**
 * Guarded delete for Candidate List row.
 * Only deletes the Candidate List row if:
 *  - no future rota entries,
 *  - no in-progress (including overnight) rota entries,
 *  - no EmailHistory entries dated >= today.
 */
function deleteCandidateRow(args) {
  if (!args || !args.rowNo) throw new Error('Row number is required.');
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(CANDIDATE_SHEET_NAME);
  if (!sh) throw new Error('Candidate List sheet not found.');

  const existing = readCandidateRow(args.rowNo);
  if (!existing) throw new Error('Candidate not found.');

  const keyLower = nameKeyLower(existing.surname, existing.firstname);

  // Booking guard (future or in-progress incl. overnight) & EmailHistory future
  if (hasFutureOrActiveBookings(keyLower)) {
    throw new Error('You cannot delete this candidate as they are booked for shifts in the future.');
  }
  if (emailHistoryHasDateOnOrAfterToday(keyLower)) {
    throw new Error('You cannot delete this candidate as they are booked for shifts in the future.');
  }

  // Hard delete the Candidate List row only
  sh.deleteRow(args.rowNo);
ai_syncAvailabilityWithCandidates(); 
  // Signal all open modeless lists to refresh
  try {
    markCandidatesListDirty();
  } catch (e) {
    // ignore if helper not yet deployed
  }

  return 'Candidate deleted';
}


/**
 * Preflight: return true if this candidate (by lowercased "surname firstname") has
 * future or in-progress (incl. overnight) rota bookings, or EmailHistory date >= today.
 * Used by the client to show the warning dialog for job/gender changes.
 */
function preflightCheckBookings(args) {
  const nameLower = (args && String(args.nameLower || '').trim().toLowerCase()) || '';
  if (!nameLower) return false;
  if (hasFutureOrActiveBookings(nameLower)) return true;
  if (emailHistoryHasDateOnOrAfterToday(nameLower)) return true;
  return false;
}

