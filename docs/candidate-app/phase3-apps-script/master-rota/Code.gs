/***** Candidate_ID generation (CID1-<Base32 payload><checksum>) *****
 * - Reversible: Public ID is Base32 (Crockford) encoded.
 * - Integrity: 4-char checksum from HMAC-SHA256 using CALLBACK_HMAC_KEY.
 * - Format: CID1-<PAYLOAD><CHK4>  (no extra dash before checksum)
 * - Only the Candidate_ID column is written by backfill utility.
 ********************************************************************/

// === Public constants (header names) ===
const HEADER_PUBLIC_ID     = 'Public ID - Credentially';
const HEADER_CANDIDATE_ID  = 'Candidate_ID';

// === Crockford Base32 alphabet (no I, L, O, U) ===
// 0-9 A-Z without I L O U ; we also accept i/l/o/u on decode by normalising.
const B32_ALPH = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
const B32_MAP  = (() => {
  const m = Object.create(null);
  for (let i = 0; i < B32_ALPH.length; i++) m[B32_ALPH[i]] = i;
  // Ambiguous char tolerance on decode (map to lookalikes)
  m['I'] = m['1']; m['L'] = m['1']; m['O'] = m['0']; m['U'] = m['V']; // optional helpers
  return m;
})();

// ---------- Utility: get Script Property (hex) → bytes ----------
function _getCallbackKeyBytes_() {
  const hex = String(PropertiesService.getScriptProperties().getProperty('CALLBACK_HMAC_KEY') || '').trim();
  if (!hex || !/^[0-9a-fA-F]+$/.test(hex) || (hex.length % 2 !== 0)) {
    throw new Error('CALLBACK_HMAC_KEY script property is missing or not valid hex.');
  }
  const bytes = [];
  for (let i = 0; i < hex.length; i += 2) {
    bytes.push(parseInt(hex.substr(i, 2), 16));
  }
  return bytes;
}

// ---------- Utility: UTF-8 encode/decode ----------
function _utf8Bytes_(str) {
  return Utilities.newBlob(str, 'text/plain').getBytes();
}
function _utf8FromBytes_(bytes) {
  return Utilities.newBlob(bytes).getDataAsString('utf-8');
}

// ---------- Base32 (Crockford) encode ----------
function _b32EncodeCrockford_(bytes) {
  if (!bytes || !bytes.length) return '';
  let bits = 0, value = 0, out = '';
  for (let i = 0; i < bytes.length; i++) {
    value = (value << 8) | (bytes[i] & 0xff);
    bits += 8;
    while (bits >= 5) {
      out += B32_ALPH[(value >>> (bits - 5)) & 31];
      bits -= 5;
    }
  }
  if (bits > 0) out += B32_ALPH[(value << (5 - bits)) & 31];
  return out;
}

// ---------- Base32 (Crockford) decode ----------
function _b32DecodeCrockford_(str) {
  if (!str) return [];
  const s = String(str).toUpperCase().replace(/[\s\-]/g, '');
  let bits = 0, value = 0;
  const out = [];
  for (let i = 0; i < s.length; i++) {
    const ch = s[i];
    const v = B32_MAP[ch];
    if (v == null) throw new Error('Invalid Base32 character: ' + ch);
    value = (value << 5) | v;
    bits += 5;
    if (bits >= 8) {
      out.push((value >>> (bits - 8)) & 0xff);
      bits -= 8;
    }
  }
  return out;
}

// ---------- Normalise Public ID ----------
function _normalisePublicId_(pid) {
  return String(pid || '').trim().replace(/\s+/g, '').toUpperCase();
}

// ---------- Checksum: HMAC-SHA256(key, payloadBase32) → 4 Crockford chars ----------
function _cidChecksum4_(payloadBase32) {
  const key = _getCallbackKeyBytes_();                  // from Script Properties
  const mac = Utilities.computeHmacSha256Signature(_utf8Bytes_(payloadBase32), key);
  // Take first 20 bits → 4 Base32 chars (since 4 * 5 = 20)
  let bits = (mac[0] & 0xff) << 12 | (mac[1] & 0xff) << 4 | ((mac[2] & 0xf0) >>> 4);
  let out = '';
  out += B32_ALPH[(bits >>> 15) & 31];
  out += B32_ALPH[(bits >>> 10) & 31];
  out += B32_ALPH[(bits >>> 5)  & 31];
  out += B32_ALPH[bits & 31];
  return out;
}

// ---------- Build Candidate_ID from Public ID (reversible) ----------
function buildCandidateIdFromPublicId_(publicIdRaw) {
  const pid = _normalisePublicId_(publicIdRaw);
  if (!pid) throw new Error('Cannot build Candidate_ID: Public ID is blank.');
  const payload = _b32EncodeCrockford_(_utf8Bytes_(pid));   // reversible payload
  const chk4   = _cidChecksum4_(payload);                   // keyed checksum
  return `CID1-${payload}${chk4}`;
}

// ---------- Decode Candidate_ID back to Public ID (verification / mapping) ----------
function decodeCandidateIdToPublicId_(candidateId) {
  const s = String(candidateId || '').trim();
  if (!s.startsWith('CID1-')) throw new Error('Unknown Candidate_ID version/prefix.');
  const body = s.substring(5).toUpperCase(); // after 'CID1-'
  if (body.length < 5) throw new Error('Malformed Candidate_ID (too short).');

  const payload = body.slice(0, -4);
  const chk     = body.slice(-4);
  const expect  = _cidChecksum4_(payload);
  if (expect !== chk) throw new Error('Candidate_ID checksum mismatch.');

  const bytes = _b32DecodeCrockford_(payload);
  const pid   = _utf8FromBytes_(bytes);
  return _normalisePublicId_(pid);
}

// ---------- Sheet helpers: header → column ----------
function _getColumnByHeader_(sh, headerText) {
  const lastCol = sh.getLastColumn();
  if (lastCol < 1) throw new Error('Sheet has no columns.');
  const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0].map(h => String(h || '').trim());
  const idx = headers.findIndex(h => h === headerText);
  if (idx === -1) throw new Error(`Header not found: ${headerText}`);
  return idx + 1; // 1-based
}

// ---------- Core: generate & write Candidate_ID for a given row (only that cell changes) ----------
function generateAndWriteCandidateIdForRow_(rowNo) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(CANDIDATE_SHEET_NAME);
  if (!sh) throw new Error('Candidate List sheet not found.');

  const colPID  = _getColumnByHeader_(sh, HEADER_PUBLIC_ID);
  const colCID  = _getColumnByHeader_(sh, HEADER_CANDIDATE_ID);

  if (rowNo < 2 || rowNo > sh.getLastRow()) throw new Error('Row out of range.');

  const pid = String(sh.getRange(rowNo, colPID).getValue() || '').trim();
  if (!pid) {
    // If there is no Public ID we must not write any Candidate_ID.
    sh.getRange(rowNo, colCID).setValue(''); // keep it blank (or leave existing as-is if you prefer)
    return { row: rowNo, status: 'SKIPPED_NO_PUBLIC_ID' };
  }

  const cid = buildCandidateIdFromPublicId_(pid);
  // Optional safety: if a value exists and is identical, no change; otherwise write
  const prev = String(sh.getRange(rowNo, colCID).getValue() || '').trim();
  if (prev !== cid) sh.getRange(rowNo, colCID).setValue(cid);

  return { row: rowNo, status: prev === cid ? 'UNCHANGED_OK' : 'WROTE' };
}

// ---------- Bulk backfill: create Candidate_ID for all rows (only writes Candidate_ID) ----------
function backfillAllCandidateIds() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(CANDIDATE_SHEET_NAME);
  if (!sh) throw new Error('Candidate List sheet not found.');

  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  try {
    const lastRow = sh.getLastRow();
    if (lastRow < 2) return { scanned: 0, wrote: 0, unchanged: 0, skipped: 0, errors: 0 };

    const colPID  = _getColumnByHeader_(sh, HEADER_PUBLIC_ID);
    const colCID  = _getColumnByHeader_(sh, HEADER_CANDIDATE_ID);

    const pidVals = sh.getRange(2, colPID, lastRow - 1, 1).getValues().map(r => String(r[0] || '').trim());
    const cidVals = sh.getRange(2, colCID, lastRow - 1, 1).getValues().map(r => String(r[0] || '').trim());

    let wrote = 0, unchanged = 0, skipped = 0, errors = 0;

    const outCid = cidVals.slice(); // clone to write back only this column

    for (let i = 0; i < pidVals.length; i++) {
      const rowNo = i + 2;
      const pid   = pidVals[i];
      if (!pid) { skipped++; continue; }

      try {
        const cid = buildCandidateIdFromPublicId_(pid);
        if (cidVals[i] !== cid) { outCid[i] = cid; wrote++; } else { unchanged++; }
      } catch (e) {
        errors++;
        // Leave Candidate_ID cell unchanged on error
      }
    }

    // Write back ONLY the Candidate_ID column
    const writeRange = sh.getRange(2, colCID, lastRow - 1, 1);
    const writeData  = outCid.map(v => [v]);
    writeRange.setValues(writeData);

    return { scanned: pidVals.length, wrote, unchanged, skipped, errors };
  } finally {
    lock.releaseLock();
  }
}
