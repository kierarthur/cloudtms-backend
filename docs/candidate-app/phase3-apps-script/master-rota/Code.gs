/**
 * Attach up to TWO Proof of Address files:
 * - From the same POA document object (activeFile + files[]).
 * - Sorted by created (desc); take the top 2 non-duplicate file IDs.
 * - Keep original content type; rename attachments as:
 *     "POA - <Surname> <Firstname>.<ext>"
 *     "POA 2 - <Surname> <Firstname>.<ext>"
 * - Included-docs list remains "Proof of Address" (deduped later).
 */
function attachProofOfAddressPair_(addressDoc, fullName, ctx, attachments, attachedFileIds, includedDocLabels, surname, firstName) {
  try {
    if (!addressDoc) return;

    // Build candidate list = activeFile + files[], unique by id
    const all = [];
    const pushIf = (f) => {
      if (!f || f.id == null) return;
      if (!all.some(x => String(x.id) === String(f.id))) all.push(f);
    };
    if (Array.isArray(addressDoc.files)) addressDoc.files.forEach(pushIf);
    if (addressDoc.activeFile) pushIf(addressDoc.activeFile);

    if (!all.length) {
      return;
    }

    // Enforce APPROVED-only (defensive)
    const isApproved = (fileObj) => {
      const verifs = Array.isArray(fileObj?.verifications) ? fileObj.verifications : [];
      return verifs.some(v => String(v?.verificationType || '').toUpperCase() === 'APPROVED');
    };
    const approved = all.filter(isApproved);

    if (!approved.length) {
      return;
    }

    // Sort newest first by created (fallback to issued)
    approved.sort((a, b) => {
      const ta = new Date(a.created || a.issued || 0).getTime();
      const tb = new Date(b.created || b.issued || 0).getTime();
      return tb - ta;
    });

    // Target: up to 2 non-duplicate POA attachments
    const targetCount = 2;
    let attachedCount = 0;

    // Iterate through approved files until we attach up to 2 (skipping already-attached and DL-duplicate-bytes if provided)
    for (const f of approved) {
      if (attachedCount >= targetCount) break;

      const idStr = String(f.id);
      if (attachedFileIds && attachedFileIds.has(idStr)) {
        continue; // skip if already attached
      }

      // Download for possible dedup + attach
      const ordinal = (attachedCount === 0) ? '' : ' 2';
      const baseName = `POA${ordinal} - ${surname} ${firstName}`;

      const dl = httpGetBlob_(
        `${API_BASE}/files/${f.id}`,
        baseName,
        null,
        { ...ctx, step: `POA: download candidate (aiming for ${attachedCount + 1}/${targetCount})` }
      );

      if (!dl || !dl.ok || !dl.blob) {
        continue;
      }

      // DL vs POA byte-size dedup (if caller provided dlDedupBytes)
      const dlDedupBytes = (typeof ctx?.dlDedupBytes === 'number') ? ctx.dlDedupBytes : null;
      if (dlDedupBytes != null && dl.sizeBytes === dlDedupBytes) {
        continue; // don’t attach this POA; try the next one
      }

      // Rename with appropriate extension based on actual content-type
      const extForType = (ctype) => {
        const t = String(ctype || '').toLowerCase();
        if (t === 'application/pdf') return '.pdf';
        if (t === 'image/jpeg' || t === 'image/jpg') return '.jpg';
        if (t === 'image/png') return '.png';
        if (t === 'image/heic' || t === 'image/heif') return '.heic';
        return ''; // unknown
      };
      try {
        const ext = extForType(dl.contentType);
        if (ext) dl.blob.setName(baseName + ext);
      } catch (_) {}

      attachments.push(dl.blob);
      if (attachedFileIds) attachedFileIds.add(idStr);
      includedDocLabels.push('Proof of Address');
      attachedCount++;
    }

  } catch (e) {
  }
}


