/**
 * Build complianceMap: key = "Surname|FirstName", stores status and items map
 */
function buildComplianceMap() {
  var ss = SpreadsheetApp.getActive();
  var cand = ss.getSheetByName('Candidate List').getDataRange().getValues();
  var docs = ss.getSheetByName('Credentially Docs').getDataRange().getValues();
  var hdr = docs[0];
  var complianceMap = {};

  // Map each header name to its column index in docs sheet:
  var docSheet = ss.getSheetByName('Credentially Docs');
  var docData = docSheet.getDataRange().getValues();
  var fullHdr = docData[0]; // includes col A & B
  var rowNumMap = {};
  for (var j = 1; j < docData.length; j++) {
    var key = docData[j][0] + '|' + docData[j][1];
    rowNumMap[key] = j + 1; // actual sheet row
  }

  // First pass: mark CAUTION for missing Public ID
  for (var i = 1; i < cand.length; i++) {
    var row = cand[i];
    var key = row[0] + '|' + row[1];
    if (!row[8]) { // col I = index 8
      complianceMap[key] = { status: 'CAUTION', items: {}, row: null };
    }
  }
  // Second pass: pull in everything from Credentially Docs
  for (var j = 1; j < docs.length; j++) {
    var r = docs[j];
    var key = r[0] + '|' + r[1];
    if (!(key in complianceMap)) {
      complianceMap[key] = {
        status: 'OK',
        items: {},
        row: rowNumMap[key] || null
      };
    }
    for (var k = 2; k < hdr.length; k++) {
      complianceMap[key].items[hdr[k]] = r[k];
    }
    complianceMap[key].row = rowNumMap[key] || null;
  }
  return complianceMap;
}

