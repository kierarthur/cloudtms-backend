function sendHistoricalShiftsEmail(selectedCandidates, startDate, endDate) {
  const histSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("EmailHistory");
  const historyData = histSheet.getDataRange().getValues();
  
  // Convert startDate and endDate to Date objects
  const start = new Date(startDate);
  const end = new Date(endDate);
  
  const updates = [];

  selectedCandidates.forEach(candidate => {
    const fullName = `${candidate.surname} ${candidate.firstName}`.toLowerCase().trim();
    const shifts = [];

    // Search for candidate's shifts in Email History within the date range
    historyData.forEach(row => {
      if (row[0].toLowerCase().trim() === fullName) {
        const shiftDate = new Date(row[1]);
        
        // Include shifts that fall within the date range
        if (shiftDate >= start && shiftDate <= end) {
          shifts.push({
            date: row[1],
            shift: row[2],
            reference: row[3],
            day: row[4],
            hospital: row[5],
            ward: row[6],
            jobTitle: row[7],
            comment: row[3] ? "*NEW REF NO.*" : ""  // Add *NEW REF NO.* if reference is updated
          });
        }
      }
    });

    if (shifts.length > 0) {
      updates.push({
        key: candidate.key,
        fullName: candidate.fullName,
        email: candidate.email,
        diffs: shifts  // Store historical shifts (filtered by date range)
      });
    }
  });

  if (updates.length > 0) {
    updates.forEach(candidate => {
      const emailBody = createEmailBodyForHistoricalShifts(candidate.diffs);
      const subject = `Historical Shift Updates – ${candidate.fullName}`;
      GmailApp.createDraft(candidate.email, subject, "", { htmlBody: emailBody });
    });
  }
}

