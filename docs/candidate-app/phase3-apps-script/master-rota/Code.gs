// Count consecutive booked days (LD/N) *before* the first window date, ending at (firstDate - 1 day).
// Looks back up to lookbackDays (default 10) in EmailHistory.
// nameKey is "surname firstName" lowercased, same as ai_markBookedAndSystemBlocks uses.
function _historicalBookedStreak(nameKey, firstDate, lookbackDays) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const eh = ss.getSheetByName(SH_EMAILHIST) || ss.getSheetByName('emailhistory');
  if (!eh || !nameKey || !firstDate) return 0;

  const tz = ss.getSpreadsheetTimeZone();
  const end = new Date(firstDate.getFullYear(), firstDate.getMonth(), firstDate.getDate() - 1); // yesterday relative to first
  const start = new Date(end.getFullYear(), end.getMonth(), end.getDate() - (lookbackDays || 10) + 1);

  const rows = eh.getDataRange().getDisplayValues();
  if (rows.length <= 1) return 0;
  const hdr = rows[0].map(s => (s||'').toString().toLowerCase());
  const iName = hdr.indexOf('occupantkey');
  const iDate = hdr.indexOf('date');
  const iShift= hdr.indexOf('shift');
  if (iName < 0 || iDate < 0) return 0;

  // Build a set of yyyy-MM-dd for booked days in the lookback range for this candidate
  const bookedSet = new Set();
  for (let r = 1; r < rows.length; r++) {
    const n = (rows[r][iName]||'').toString().trim().toLowerCase();
    if (n !== nameKey) continue;
    const d = _parseDDMMYYYY((rows[r][iDate]||'').toString().trim());
    if (!d) continue;
    if (d < start || d > end) continue;
    // Any valid shift counts as booked (LD or Night)
    if (iShift >= 0) {
      const shf = (rows[r][iShift]||'').toString().trim().toUpperCase();
      if (shf !== 'LD' && !shf.includes('N')) { /* still count as booked if row is present */ }
    }
    bookedSet.add(Utilities.formatDate(d, tz, 'yyyy-MM-dd'));
  }

  // Count consecutive days backward from 'end'
  let streak = 0;
  for (let k = 0; k < (lookbackDays || 10); k++) {
    const d = new Date(end.getFullYear(), end.getMonth(), end.getDate() - k);
    const ymd = Utilities.formatDate(d, tz, 'yyyy-MM-dd');
    if (bookedSet.has(ymd)) streak++;
    else break;
  }
  return streak;
}

function ai_refreshAvailabilityRowsFor(keys) {
  // Targeted repaint for a subset of candidates whose bookings changed (NEW or CANCELLED).
  // Implements the global overwrite guard, BOOKED/BLOCKED precedence,
  // and the refined notes policy (no new snapshot when overwriting an already-BLOCKED cell).

  if (!Array.isArray(keys) || !keys.length) return;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const av = ss.getSheetByName(SH_AVAIL);
  const eh = ss.getSheetByName(SH_EMAILHIST) || ss.getSheetByName('EmailHistory');
  if (!av || !eh) return;

  // ────────────────────────── Helpers / Normalisers ──────────────────────────
  function normPhone(s) {
    const digits = String(s || '').replace(/\D+/g, '');
    if (!digits) return '';
    if (digits.startsWith('44') && digits.length === 12) return '0' + digits.slice(2);
    if (digits.length === 10 && digits[0] !== '0')      return '0' + digits;
    if (digits.length === 11 && digits[0] === '0')      return digits;
    return digits[0] === '0' ? digits : ('0' + digits);
  }
  function normNameKeyFromCells(surCell, firCell) {
    return ((String(surCell||'') + ' ' + String(firCell||'')).toLowerCase().trim());
  }
  function normKeyRaw(s) { return String(s || '').toLowerCase().trim(); }

  // Force phone column (D) to Plain text for existing rows (appended rows inherit)
  const phoneCol = 4; // D
  const existingRows = Math.max(av.getLastRow() - 1, 0);
  if (existingRows > 0) av.getRange(2, phoneCol, existingRows, 1).setNumberFormat('@');

  // Normalise target keys to "surname first" lowercased, trimmed.
  const target = new Set(keys.map(k => normKeyRaw(k)).filter(Boolean));
  if (!target.size) return;

  // Date headers (row 1, from col G onward)
  const lastCol = av.getLastColumn();
  if (lastCol < 7) return;
  const headers = av.getRange(1, 7, 1, lastCol - 6).getDisplayValues()[0];
  const tz = ss.getSpreadsheetTimeZone();

  function parseHeaderToDate(h) {
    // supports "Wed 13/08/2025", "13/08/2025", or Date-like strings
    const s = String(h).trim();
    const m = s.match(/\b(\d{2}\/\d{2}\/\d{4})\b/);
    if (m) return _parseDDMMYYYY(m[1]);
    const d = new Date(s);
    return isNaN(d) ? null : d;
  }
  function ymdOf(d) {
    return Utilities.formatDate(d, tz, 'yyyy-MM-dd');
  }
  const todayMid = (function () {
    const now = _nowUK();
    return new Date(now.getFullYear(), now.getMonth(), now.getDate());
  })();

  function preWindowStreakLen(map, firstDate) {
    // Count consecutive booked days immediately BEFORE firstDate (max 6), from EH map
    let cnt = 0;
    if (!firstDate) return 0;
    let d = new Date(firstDate.getTime());
    d.setDate(d.getDate() - 1);
    for (let i = 0; i < 6; i++) {
      const y = ymdOf(d);
      if (map[y] === 'LD' || map[y] === 'N') {
        cnt++;
        d.setDate(d.getDate() - 1);
      } else {
        break;
      }
    }
    return cnt;
  }

  // NEW: Count consecutive booked days immediately AFTER lastDate (max 6), from EH map
  function postWindowStreakLen(map, lastDate) {
    let cnt = 0;
    if (!lastDate) return 0;
    let d = new Date(lastDate.getTime());
    d.setDate(d.getDate() + 1);
    for (let i = 0; i < 6; i++) {
      const y = ymdOf(d);
      if (map[y] === 'LD' || map[y] === 'N') {
        cnt++;
        d.setDate(d.getDate() + 1);
      } else {
        break;
      }
    }
    return cnt;
  }

  // ─────────────────────────────────────────────────────────────
  // 0) Ensure all target names exist in Availability (no deletions here).
  //    If a name is missing, look it up in Candidate List and append.
  // ─────────────────────────────────────────────────────────────
  (function ensureMissingRows() {
    // Collect existing "surname first" keys from Availability
    const bodyLastRow0 = av.getLastRow();
    const existing = new Set();
    if (bodyLastRow0 > 1) {
      const nameCells0 = av.getRange(2, 1, bodyLastRow0 - 1, 2).getDisplayValues();
      for (let r = 0; r < nameCells0.length; r++) {
        const key = normNameKeyFromCells(nameCells0[r][0], nameCells0[r][1]);
        if (key) existing.add(key);
      }
    }

    const missing = [];
    target.forEach(k => { if (!existing.has(k)) missing.push(k); });
    if (!missing.length) return;

    const cl = ss.getSheetByName(SH_CANDIDATES);
    if (!cl) return; // cannot append without Candidate List

    const clVals = cl.getDataRange().getDisplayValues();
    if (clVals.length <= 1) return;

    const ch = clVals[0].map(s => (s || '').toString().toLowerCase());
    const iSur = ch.indexOf('surname');
    const iFir = ch.indexOf('first name');
    const iEm  = ch.indexOf('email');
    const iPh  = ch.indexOf('telephone');
    const iJob = ch.indexOf('job title');
    const iGen = ch.indexOf('gender');

    // Build a quick lookup: "surname first" -> [surname, first, email, phone(normalised), job, gender]
    const byNameKey = {};
    for (let r = 1; r < clVals.length; r++) {
      const row = clVals[r];
      const sur = (iSur >= 0 ? row[iSur] : row[0]) || '';
      const fir = (iFir >= 0 ? row[iFir] : row[1]) || '';
      const em  = (iEm  >= 0 ? row[iEm]  : row[2]) || '';
      const ph0 = (iPh  >= 0 ? row[iPh]  : row[3]) || '';
      const ph  = normPhone(ph0);
      const job = (iJob >= 0 ? row[iJob] : row[4]) || '';
      const gen = (iGen >= 0 ? row[iGen] : row[5]) || '';
      const key = normKeyRaw(String(sur) + ' ' + String(fir));
      if (key && byNameKey[key] == null) {
        byNameKey[key] = [sur, fir, em, ph, job, gen];
      }
    }

    // Append any missing targets we can find in Candidate List
    missing.forEach(k => {
      const data = byNameKey[k];
      if (!data) return; // skip if not found in CL

      av.appendRow(data);
      const newRow = av.getLastRow();

      // Ensure phone cell (D) is Plain text and set normalised phone
      av.getRange(newRow, phoneCol).setNumberFormat('@').setValue(String(data[3] || ''));

      // Initialise date columns to blank white for the current window
      if (headers.length > 0) {
        av.getRange(newRow, 7, 1, headers.length)
          .setValues([new Array(headers.length).fill('')])
          .setBackgrounds([new Array(headers.length).fill('#ffffff')]);
      }
    });
  })();

  // ─────────────────────────────────────────────────────────────
  // 1) Build bookings map from EmailHistory for only the target keys
  // ─────────────────────────────────────────────────────────────
  const rows = eh.getDataRange().getDisplayValues();
  if (rows.length <= 1) return;

  const hdr = rows[0].map(s => (s || '').toString().toLowerCase());
  const iName  = hdr.indexOf('occupantkey');
  const iDate  = hdr.indexOf('date');
  const iShift = hdr.indexOf('shift');
  if (iName < 0 || iDate < 0 || iShift < 0) return;

  const booked = {}; // nameKey -> ymd -> 'LD' | 'N'
  for (let r = 1; r < rows.length; r++) {
    const name = normKeyRaw(rows[r][iName] || '');
    if (!target.has(name)) continue;
    const rawDate = (rows[r][iDate] || '').toString().trim();
    const m = rawDate.match(/\b(\d{2}\/\d{2}\/\d{4})\b/);
    const ddmmyyyy = m ? m[1] : rawDate;
    const d = _parseDDMMYYYY(ddmmyyyy);
    if (!name || !d) continue;
    const shf = (rows[r][iShift] || '').toString().toLowerCase();
    const ymd = ymdOf(d);
    (booked[name] = booked[name] || {})[ymd] =
      (shf.includes('night') || shf === 'n' || shf.startsWith('n ')) ? 'N' : 'LD';
  }

  // ─────────────────────────────────────────────────────────────
  // 2) Repaint rows (now guaranteed to exist) and recompute BLOCKED
  //    — obeying the global overwrite guard and the refined notes policy —
  // ─────────────────────────────────────────────────────────────
  const bodyLastRow = av.getLastRow();
  if (bodyLastRow <= 1) return;

  // Policy colors as lowercase hex for comparisons
  const UNAV_COL     = String(COLOR_UNAVAIL   || '').toLowerCase();
  const AVAIL_COL    = String(COLOR_AVAILABLE || '').toLowerCase();
  const BOOKED_COL   = String(COLOR_BOOKED    || '').toLowerCase();
  const BLOCKED_COL  = String(COLOR_BLOCKED   || '').toLowerCase();

  // Map "surname first" -> row index
  const nameCells = av.getRange(2, 1, bodyLastRow - 1, 2).getDisplayValues();
  for (let r = 0; r < nameCells.length; r++) {
    const nameKey = normNameKeyFromCells(nameCells[r][0], nameCells[r][1]);
    if (!target.has(nameKey)) continue;

    const map = booked[nameKey] || {};
    const rowIdx = r + 2;

    // Read current row state across the date window
    const rowVals  = av.getRange(rowIdx, 7, 1, headers.length).getDisplayValues()[0];
    const rowBgs   = av.getRange(rowIdx, 7, 1, headers.length).getBackgrounds()[0];
    const rowNotes = av.getRange(rowIdx, 7, 1, headers.length).getNotes()[0];

    // Start next buffers as copies of prior (we only change when allowed)
    const nextVals  = rowVals.slice();
    const nextBgs   = rowBgs.slice();
    const nextNotes = rowNotes.slice();

    // Precompute EH-booked flags across the window and carry-in/out for the 6-day rule
    const isBooked = headers.map(h => {
      const d = parseHeaderToDate(h); if (!d) return false;
      const ymd = ymdOf(d);
      return !!map[ymd];
    });
    const firstDate = parseHeaderToDate(headers[0]);
    const lastDate  = parseHeaderToDate(headers[headers.length - 1]);
    const carryInBooked  = preWindowStreakLen(map, firstDate);
    const carryOutBooked = postWindowStreakLen(map, lastDate);

    for (let c = 0; c < headers.length; c++) {
      const d = parseHeaderToDate(headers[c]); if (!d) continue;
      const ymd = ymdOf(d);

      const priorV    = String(rowVals[c]  || '');
      const priorVT   = priorV.toUpperCase();
      const priorBg   = String(rowBgs[c]   || '').toLowerCase();
      const priorNote = rowNotes[c];

      // Working state within this iteration (may differ from prior after stale-booked removal)
      let curVal  = priorV;
      let curBg   = priorBg;
      let curNote = priorNote;

      const wasBlockedText = (priorVT === 'BLOCKED');

      // Helper: write booked (always allowed)
      const writeBooked = () => {
        nextVals[c]  = map[ymd];    // 'LD' or 'N'
        nextBgs[c]   = COLOR_BOOKED;
        nextNotes[c] = '';          // clear notes when booking
      };

      // Helper: remove stale booked (allowed override)
      const removeStaleBooked = () => {
        nextVals[c]  = '';
        nextBgs[c]   = '#ffffff';
        nextNotes[c] = ''; // remove any note unconditionally
      };

      // Helper: set BLOCKED with refined note policy
      const setBlocked = () => {
        // If the cell is ALREADY BLOCKED (text "BLOCKED"), do NOT create/overwrite a note.
        // Keep any existing note as-is (nextNotes already seeded from priorNotes).
        if (!wasBlockedText && !curNote) {
          // Only snapshot when overwriting explicit UNAVAILABLE (red) or AVAILABLE (green)
          if (curBg === UNAV_COL || curBg === AVAIL_COL) {
            try {
              nextNotes[c] = JSON.stringify({ prevText: curVal, prevBg: rowBgs[c] });
            } catch (_) { /* ignore note failure */ }
          }
        }
        // Always write/maintain BLOCKED text and background
        nextVals[c] = 'BLOCKED';
        nextBgs[c]  = COLOR_BLOCKED;
      };

      // Helper: remove BLOCKED and restore from note (if snapshot), else to white/empty
      const removeBlocked = () => {
        if (priorNote) {
          try {
            const o = JSON.parse(priorNote);
            nextVals[c]  = (o && o.prevText != null) ? String(o.prevText) : '';
            nextBgs[c]   = (o && o.prevBg) ? String(o.prevBg) : '#ffffff';
          } catch(_) {
            nextVals[c] = ''; nextBgs[c] = '#ffffff';
          }
          nextNotes[c] = '';
        } else {
          nextVals[c]  = '';
          nextBgs[c]   = '#ffffff';
          nextNotes[c] = '';
        }
      };

      // ————— Global overwrite guard (decision tree) —————

      // 1) If cell is currently blue but EH no longer has it → stale booked → remove
      if (curBg === BOOKED_COL && !isBooked[c]) {
        removeStaleBooked();
        // Update working state to reflect the removal before further logic
        curVal  = nextVals[c];
        curBg   = String(nextBgs[c]).toLowerCase();
        curNote = nextNotes[c];
        // Fall through to potential BLOCKED logic
      }

      // 2) If EH says Booked now → always write booked, regardless of prior
      if (isBooked[c]) {
        writeBooked();
        continue; // Booked trumps blocking
      }

      // 3) Determine if should be BLOCKED (only consider today/future, and not booked)
      let shouldBlock = false;
      if (d >= todayMid) {
        // Count consecutive booked days left/right from EH
        let leftRun = 0;
        for (let i = c - 1; i >= 0; i--) { if (isBooked[i]) leftRun++; else break; }
        if (leftRun === c) leftRun += carryInBooked;

        let rightRun = 0;
        for (let j = c + 1; j < headers.length; j++) { if (isBooked[j]) rightRun++; else break; }
        // NEW: if the run reaches the right edge, include up to 6 future booked days (carry-out)
        if (c + 1 + rightRun === headers.length) {
          rightRun += carryOutBooked;
        }

        shouldBlock = (leftRun + 1 + rightRun > 6);
      }

      if (shouldBlock) {
        // Allowed override: write BLOCKED even if non-white/text
        setBlocked();
        continue;
      }

      // 4) Not booked & not newly blocked → respect guard:
      // If currently BLOCKED but no longer should be blocked → remove BLOCKED (restore)
      const isCurrentlyBlocked = (priorVT === 'BLOCKED') || (priorBg === BLOCKED_COL && priorVT === 'BLOCKED');
      if (isCurrentlyBlocked) {
        removeBlocked();
        continue;
      }

      // Otherwise (normal cells):
      // Guard: do not overwrite if cell has any text OR non-white bg
      const isWhite = (curBg === '' || curBg === '#ffffff');
      const hasText = (String(curVal).trim() !== '');
      if (hasText || !isWhite) {
        // leave as-is (next* already seeded from prior)
        continue;
      }

      // It is white/empty and no rule applies → leave white/empty (already in next buffers)
    }

    // Commit this row's changes in one go
    const rowRange = av.getRange(rowIdx, 7, 1, headers.length);
    rowRange.setValues([nextVals]);
    rowRange.setBackgrounds([nextBgs]);
    rowRange.setNotes([nextNotes]);
  }
}





/**
 * Called from the Notify dialog's Email Broadcast overlay:
 *   google.script.run.sendEmailBroadcast(emailForm)
 *
 * Expects the form to contain:
 *   - recipientsJson : JSON array of fullName strings (selectedCandidates)
 *   - subject        : string
 *   - bodyHtml       : string (HTML; taken from contenteditable div)
 *   - attachment     : Blob (optional)  [or "attachments" array of Blobs if you went with multiple]
 *
 * Returns: { success: boolean, sent: number, skipped: number, results: [{name, email, status, reason?}] }
 */
function sendEmailBroadcast(form) {
  try {
    // --- inputs
    const recipients = JSON.parse(form.recipientsJson || '[]');
    const subject    = String(form.subject || '').trim();
    const bodyHtml   = String(form.bodyHtml || '').trim();

    if (!recipients.length) return { success:false, error:'No recipients selected.' };
    if (!subject)           return { success:false, error:'Subject is required.' };
    if (!bodyHtml)          return { success:false, error:'Message body is required.' };

    // --- attachments (supports multiple; falls back to single "attachment" if present)
    let blobs = [];
    if (form.attachments != null) {
      // When multiple files are chosen, Apps Script provides an array of Blobs.
      // When a single file is chosen, it's a single Blob.
      blobs = [].concat(form.attachments || []).filter(b => b && b.getBytes && b.getBytes().length);
    } else if (form.attachment != null) {
      // Back-compat with single-file field named "attachment"
      const b = form.attachment;
      if (b && b.getBytes && b.getBytes().length) blobs = [b];
    }

    const attachments = blobs.map(b => ({
      filename: (b.getName && b.getName()) || 'attachment',
      mimeType: (b.getContentType && b.getContentType()) || 'application/octet-stream',
      contentBase64: Utilities.base64Encode(b.getBytes())
    }));

    // --- send per recipient
    let sent = 0, skipped = 0;
    const results = [];

    recipients.forEach(fullName => {
      const email = lookupEmail(fullName); // existing resolver
      if (!email) {
        skipped++;
        results.push({ name: fullName, email: '', status: 'failed', reason: 'No email found' });
        return;
      }
      try {
        postToDoPostSendEmail(
          email,
          subject,
          bodyHtml, // fallback "body"
          {
            htmlBody: bodyHtml,   // signal HTML body to the flow
            isHtml:   true,       // explicit flag (harmless if unused)
            attachments           // [] or array of { filename, mimeType, contentBase64 }
          }
        );
        sent++;
        results.push({ name: fullName, email, status: 'success' });
      } catch (e) {
        skipped++;
        results.push({ name: fullName, email, status: 'failed', reason: String(e) });
      }
    });

    return { success:true, sent, skipped, results };
  } catch (e) {
    return { success:false, error: String(e) };
  }
}



