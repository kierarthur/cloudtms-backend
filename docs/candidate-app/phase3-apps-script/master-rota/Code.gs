// ─────────────────────────────────────────────────────────
// CREATE ROTA FROM FORM (with Px suffix logic)
// ─────────────────────────────────────────────────────────
function createRotaFromForm() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const formSheet = ss.getSheetByName("New Patient Form");
  if (!formSheet) {
    SpreadsheetApp.getUi().alert("Sheet 'New Patient Form' not found!");
    return;
  }

  const [
    maleRMNs, femaleRMNs, maleHCAs, femaleHCAs,
    rmnNoGender, hcaNoGender, startDate, duration,
    wardRaw, hospitalRaw
  ] = formSheet.getRange("B1:B10").getValues().flat();

  let hospital = hospitalRaw.toString().trim();
  if (/^Worthing$/i.test(hospital)) {
    hospital = "Worthing Hospital, Lyndhurst Road, Worthing, BN11 2DH";
  } else if (/^St\s+Richards$/i.test(hospital)) {
    hospital = "St Richards Hospital, Spitalfield Lane, Chichester, PO19 6SE";
  } else if (/^Royal\s+Alexandra$/i.test(hospital)) {
    hospital = "Royal Alexandra Children's Hospital, North Drive, Brighton and Hove, Brighton, BN2 5BE";
  }

  const baseWard = wardRaw.toString().trim().replace(/\s+/g, "_");
  const tz = ss.getSpreadsheetTimeZone();
  const dateStamp = Utilities.formatDate(new Date(), tz, "ddMMyyyy");

  // Determine next available suffix based on sheet names
  const sheetNames = ss.getSheets().map(s => s.getName());
  let wardLabel = baseWard;
  let suffixCount = 0;
  const basePattern = new RegExp(`^Patient_\\d+_${baseWard}(?:_P(\\d+))?_\\d{8}$`);

  sheetNames.forEach(name => {
    const match = name.match(basePattern);
    if (match) {
      const num = match[1] ? parseInt(match[1], 10) : 0;
      suffixCount = Math.max(suffixCount, num + 1);
    }
  });

  if (suffixCount > 0) {
    wardLabel = `${baseWard}_P${suffixCount}`;
  }

  let idx = 1, sheetName;
  do {
    sheetName = `Patient_${idx}_${wardLabel}_${dateStamp}`;
    idx++;
  } while (ss.getSheetByName(sheetName));

  const rotaSheet = ss.insertSheet(sheetName);

  rotaSheet.getRange("A1").setValue("Hospital and Ward:");
  rotaSheet.getRange("B1").setValue(`${hospital}: ${wardLabel.replace(/_/g, " ")}`);

  const staffLayout = [];
  function pushStaff(role, gender, count) {
    for (let i = 0; i < count; i++) staffLayout.push({ role, gender });
  }
  pushStaff("RMN", "Male", parseInt(maleRMNs, 10));
  pushStaff("RMN", "Female", parseInt(femaleRMNs, 10));
  pushStaff("HCA", "Male", parseInt(maleHCAs, 10));
  pushStaff("HCA", "Female", parseInt(femaleHCAs, 10));
  pushStaff("RMN", "NoGender", parseInt(rmnNoGender, 10));
  pushStaff("HCA", "NoGender", parseInt(hcaNoGender, 10));

  let colIndex = 3;
  staffLayout.forEach(st => {
    const colHeader = st.gender === "NoGender"
      ? `${st.role} (Male or Female)`
      : `${st.gender} ${st.role}`;
    rotaSheet.getRange(3, colIndex).setValue(colHeader);
    rotaSheet.getRange(3, colIndex + 1).setValue(colHeader);
    rotaSheet.getRange(4, colIndex).setValue("Long Day 0730-2000hrs");
    rotaSheet.getRange(4, colIndex + 1).setValue("Night 1930-0800hrs");
    colIndex += 2;
  });

  const totalDays = parseInt(duration, 10);
  let rowIndex = 5;
  const start = new Date(startDate);
  for (let d = 0; d < totalDays; d++) {
    const thisDate = new Date(start);
    thisDate.setDate(thisDate.getDate() + d);
    const dayName = Utilities.formatDate(thisDate, tz, "EEEE");
    const dateStr = Utilities.formatDate(thisDate, tz, "dd/MM/yyyy");
    rotaSheet.getRange(rowIndex, 1).setValue(dayName);
    rotaSheet.getRange(rowIndex, 2).setValue(dateStr);
    rotaSheet.getRange(rowIndex + 1, 1).setValue("REF");
    rotaSheet.getRange(rowIndex + 1, 2).setValue("");
    const totalStaffCols = staffLayout.length * 2;
    rotaSheet.getRange(rowIndex + 1, 3, 1, totalStaffCols)
             .setBackground("white").setFontColor("black");
    rowIndex += 2;
  }

  const yellow = "#FFF2CC";
  rotaSheet.getRange("A1:B1").setBackground(yellow);
  rotaSheet.getRange(3, 1, 2, staffLayout.length * 2 + 2).setBackground(yellow);
  rotaSheet.getRange(5, 1, totalDays * 2, 2).setBackground(yellow);

  applyRotaFormatting(rotaSheet);
  SpreadsheetApp.getUi().alert(`Rota sheet "${sheetName}" created successfully!`);
}




/*************************************************
 * setupNewPatientForm
 *************************************************/
/**
 * Set up the “New Patient Form” sheet with dropdowns and date‐picker.
 */
function setupNewPatientForm() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();
  // 1) If it already exists, delete it
  const old = ss.getSheetByName("New Patient Form");
  if (old) {
    ss.deleteSheet(old);
    Logger.log("Deleted existing New Patient Form sheet");
  }
  // 2) Create brand-new sheet
  const formSheet = ss.insertSheet("New Patient Form");
  Logger.log("Inserted New Patient Form");

  // 3) Write the prompts
  const prompts = [
    "How many Male RMNs?",
    "How many Female RMNs?",
    "How many Male HCAs?",
    "How many Female HCAs?",
    "How many RMNs (Male or Female)?",
    "How many HCAs (Male or Female)?",
    "Start Date",
    "Rota Duration (in days)",
    "Ward",
    "Hospital"
  ];
  prompts.forEach((p, i) => {
    formSheet.getRange(i + 1, 1).setValue(p);
  });

  // 4) B1–B6: dropdown 0–10
  const counts = Array.from({ length: 11 }, (_, i) => i.toString());
  const countRule = SpreadsheetApp.newDataValidation()
    .requireValueInList(counts, true)
    .setAllowInvalid(false)
    .build();
  formSheet.getRange("B1:B6").setDataValidation(countRule);

  // 5) B7: date picker, default today, format dd/MM/yyyy
  const dateRule = SpreadsheetApp.newDataValidation()
    .requireDate()
    .setAllowInvalid(false)
    .build();
  formSheet.getRange("B7")
    .setDataValidation(dateRule)
    .setValue(new Date())
    .setNumberFormat("dd/MM/yyyy");

  // 6) B8: dropdown 1–21
  const durations = Array.from({ length: 21 }, (_, i) => (i + 1).toString());
  const durRule = SpreadsheetApp.newDataValidation()
    .requireValueInList(durations, true)
    .setAllowInvalid(false)
    .build();
  formSheet.getRange("B8")
    .setDataValidation(durRule)
    .setValue("7");

  // 7) Layout tweaks
  formSheet.setColumnWidth(1, 270);
  formSheet.setColumnWidth(2, 160);
  formSheet.getRange("A1:A10").setFontWeight("bold");
  formSheet.setFrozenColumns(1);

  // 8) Bring it to the front so you can see it
  formSheet.activate();
  SpreadsheetApp.flush();
  ui.alert("✅ New Patient Form is set up – check the “New Patient Form” tab now.");
}





/*************************************************
 * >>> NEW CODE FOR COLOR CODING REFRESH <<<
 *************************************************/

/**
 * After you update EmailHistory (e.g. after sending updates),
 * call this to re-check occupant + reference cells in all "Patient ???" sheets.
 * - occupant is green if occupant is found in EmailHistory for that date/shift & reference
 * - occupant is red if occupant isn't found in EmailHistory
 * - occupant is blank => white if occupant was canceled from EmailHistory
 * - occupant is blank => red if occupant is still in EmailHistory (not yet canceled)
 * 
 * Same logic for reference cells.
 */
/**
 * Re‑colors every Patient sheet:
 *  • Past shifts (finished) → light grey (permanently)
 *  • Future/upcoming shifts → green if in EmailHistory, red otherwise
 *  • Blank/vacant → white
 *  • References match history → green, mismatch → red
 */
/**
 * Repaints all patient sheets.
 *
 * @param {boolean=} allowVacantClear
 *   If true, blank future shifts will be turned white.
 *   Otherwise blank cells are left alone.
 */
/**
 * Repaints rota colours.
 * Backwards-compatible:
 *  - Old usage: refreshAllPatientSheetColors() -> global repaint (all patient sheets)
 *  - New usage: refreshAllPatientSheetColors(false, targets) -> repaint only specified bands
 *
 * @param {boolean} allowVacantClear  When true, upcoming vacant cells are whitened
 * @param {?Array<{sheetId?: number, sheetName?: string, bandStartRow: number}>} targets
 *        Optional targeted bands (name-row index; REF row is bandStartRow+1). If omitted/empty => global.
 */
function refreshAllPatientSheetColors(allowVacantClear = false, targets) {
  const ss  = SpreadsheetApp.getActiveSpreadsheet();
  const tz  = ss.getSpreadsheetTimeZone();
  const now = new Date();

  // === Colours ===
  const GREY  = "#dddddd";
  const GREEN = "#ccffcc";
  const RED   = "#ff9999";
  const WHITE = "#ffffff";

  // === Optional: cancellation-hint reader ===
  function getHintCols1Based(sheetId, bandStartRow) {
    try {
      if (typeof getCancellationHintsForBand === 'function') {
        const raw = getCancellationHintsForBand(String(sheetId), Number(bandStartRow));
        if (!raw) return new Set();
        if (Array.isArray(raw.cols)) return new Set(raw.cols.filter(n => Number.isFinite(n) && n >= 1));
        if (raw.byCol && typeof raw.byCol === 'object') {
          return new Set(Object.keys(raw.byCol).map(k => Number(k)).filter(n => Number.isFinite(n) && n >= 1));
        }
        if (Array.isArray(raw)) {
          const cols = [];
          raw.forEach(it => {
            if (typeof it === 'number') cols.push(it);
            else if (it && typeof it.col === 'number') cols.push(it.col);
          });
          return new Set(cols.filter(n => Number.isFinite(n) && n >= 1));
        }
      }
    } catch (_) {}
    return new Set();
  }

  function ddmmyyyyFromAny(x) {
    try {
      if (x instanceof Date && !isNaN(x)) return Utilities.formatDate(x, tz, "dd/MM/yyyy");
      const s = String(x || "").trim();
      if (!s) return "";
      const m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
      if (m) return `${m[1].padStart(2,"0")}/${m[2].padStart(2,"0")}/${m[3]}`;
      const d = new Date(s);
      if (!isNaN(d)) return Utilities.formatDate(d, tz, "dd/MM/yyyy");
    } catch (_) {}
    return "";
  }

  function normName(s) {
    return String(s || "")
      .normalize('NFD')
      .replace(/\p{Diacritic}/gu, '')
      .replace(/[^A-Za-z0-9 ]/g, '')
      .trim()
      .replace(/\s+/g, ' ')
      .toLowerCase();
  }

  function shiftKeyOf(label) {
    const lc = String(label || "").toLowerCase();
    if (!lc) return null;
    if (lc.includes("night")) return "night";
    if (lc.includes("day"))   return "day";
    if (/\b(n|night)\b/.test(lc)) return "night";
    if (/\b(d|day|ld|long day)\b/.test(lc)) return "day";
    return lc.includes('n') && !lc.includes('day') ? "night" : (lc.includes('day') ? "day" : null);
  }

  const allowClear = (typeof allowVacantClear === 'boolean') ? allowVacantClear : false;
  const isTargeted = Array.isArray(targets) && targets.length > 0;

  // Build targets map if targeted
  const targetsBySheet = new Map();
  if (isTargeted) {
    targets.forEach(t => {
      if (!t || (!t.sheetId && !t.sheetName) || !t.bandStartRow) return;
      const key = t.sheetId ? String(t.sheetId) : `name:${t.sheetName}`;
      if (!targetsBySheet.has(key)) targetsBySheet.set(key, new Map());
      const perSheet = targetsBySheet.get(key);
      const bandRow = Number(t.bandStartRow);
      if (!perSheet.has(bandRow)) perSheet.set(bandRow, { cols: null });
      if (Array.isArray(t.cols) && t.cols.length) {
        const entry = perSheet.get(bandRow);
        if (!entry.cols) entry.cols = new Set();
        t.cols.forEach(cn => {
          const n = Number(cn);
          if (Number.isFinite(n) && n >= 1) entry.cols.add(n);
        });
      }
    });
  }

  // Preload EmailHistory
  const histSheet = ss.getSheetByName("EmailHistory");
  const histVals  = histSheet ? histSheet.getDataRange().getValues() : [];

  // Candidate sheets
  let sheets = ss.getSheets().filter(s => isPatientSheetName(s.getName()));
  if (isTargeted) {
    sheets = sheets.filter(sh => {
      const idKey   = String(sh.getSheetId());
      const nameKey = `name:${sh.getName()}`;
      return targetsBySheet.has(idKey) || targetsBySheet.has(nameKey);
    });
  }

  // Per sheet
  sheets.forEach(sheet => {
    const sheetId = String(sheet.getSheetId());
    const rawHW = sheet.getRange("B1").getDisplayValue();
    const [hospital, ward] = (rawHW || "").split(":").map(s => String(s || "").trim());

    const dataRange = sheet.getDataRange();
    const values = dataRange.getValues();
    if (values.length < 5) return;

    const shiftRow = values[3];
    const lastRow  = values.length;
    const lastCol  = shiftRow.length;
    const width    = lastCol - 2;
    if (width <= 0) return;

    // EH filtered for this sheet
    const allHistRowsForSheet = [];
    if (histVals.length > 1 && hospital && ward) {
      for (let i = 1; i < histVals.length; i++) {
        const row = histVals[i];
        const [, , , , , h, w] = row;
        if (String(h) === hospital && String(w) === ward) {
          allHistRowsForSheet.push(row);
        }
      }
    }

    // Decide band rows
    let bandRows;
    const bandColsByR0 = new Map();
    if (isTargeted) {
      const idKey   = String(sheet.getSheetId());
      const nameKey = `name:${sheet.getName()}`;
      const mapA = targetsBySheet.get(idKey) || new Map();
      const mapB = targetsBySheet.get(nameKey) || new Map();
      const merged = new Map(mapA);
      for (const [br, entryB] of mapB.entries()) {
        if (!merged.has(br)) {
          merged.set(br, { cols: entryB && entryB.cols ? new Set(entryB.cols) : null });
        } else {
          const entryA = merged.get(br);
          if (!entryA.cols && entryB && entryB.cols) entryA.cols = new Set(entryB.cols);
          else if (entryA.cols && entryB && entryB.cols) entryB.cols.forEach(c => entryA.cols.add(c));
        }
      }
      bandRows = [];
      for (const [r1, entry] of merged.entries()) {
        const r0 = Number(r1) - 1;
        if (r0 >= 4 && r0 + 1 < lastRow) {
          bandRows.push(r0);
          bandColsByR0.set(r0, entry && entry.cols ? new Set(entry.cols) : null);
        }
      }
    } else {
      bandRows = [];
      for (let r = 4; r < lastRow; r += 2) bandRows.push(r);
    }

    // Build EH-by-date
    const histByDate = new Map();
    if (allHistRowsForSheet.length) {
      for (let i = 0; i < allHistRowsForSheet.length; i++) {
        const row = allHistRowsForSheet[i];
        const [, histDate] = row;
        const dNorm = ddmmyyyyFromAny(histDate);
        if (!dNorm) continue;
        if (!histByDate.has(dNorm)) histByDate.set(dNorm, []);
        histByDate.get(dNorm).push(row);
      }
    }

    // Per band
    for (let idx = 0; idx < bandRows.length; idx++) {
      const r = bandRows[idx];
      const occupantRow = values[r];
      const refRowVals  = values[r + 1] || [];
      const dateVal     = occupantRow[1];
      if (!dateVal) continue;

      const dateObj = new Date(dateVal);
      if (isNaN(dateObj)) continue;
      const dateStr = Utilities.formatDate(dateObj, tz, "dd/MM/yyyy");

      const bandStartRow1 = r + 1; // NAME row (1-based)
      const hintCols1Based = getHintCols1Based(sheetId, bandStartRow1);

      const bandRange = sheet.getRange(r + 1, 3, 2, width);
      const currentBG = bandRange.getBackgrounds(); // [[name...],[ref...]]
      const nameBgRow = currentBG[0].slice();
      const refBgRow  = currentBG[1].slice();

      const targetedColSet = bandColsByR0.get(r) || null;

      // Per col metadata
      const perColInfo = new Map();
      for (let c = 2; c < lastCol; c++) {
        const label = String(shiftRow[c] || "");
        const sk = shiftKeyOf(label);

        // Past detection
        let isPast = false;
        const startDt = parseShiftDateTime({ date: dateStr, shift: label });
        if (startDt) {
          const isNight = String(label || "").toLowerCase().includes("night");
          const endDt = new Date(startDt);
          if (isNight) { endDt.setDate(endDt.getDate() + 1); endDt.setHours(8, 0, 0, 0); }
          else { endDt.setHours(20, 0, 0, 0); }
          if (now > endDt) isPast = true;
        }

        perColInfo.set(c, {
          shiftKey: sk,
          isPast,
          oldNameBg: currentBG[0][c - 2],
          oldRefBg:  currentBG[1][c - 2],
          occupant: String(occupantRow[c] || "").trim(),
          refHere:  String(refRowVals[c] || "").trim()
        });

        if (isPast) {
          nameBgRow[c - 2] = GREY;
          refBgRow[c - 2]  = GREY;
        }
      }

      const rowsForDate = histByDate.get(dateStr) || [];

      // Buckets per shiftKey
      const shiftBuckets = new Map();
      function bucket(sk) {
        if (!sk) return null;
        if (!shiftBuckets.has(sk)) {
          shiftBuckets.set(sk, {
            colsAll: [], colsPaint: [],
            ehCounts: new Map(), ehRefsByName: new Map(),
            nameColsByName: new Map(), namedCols: [],
            blanks: [], blanksTargeted: []
          });
        }
        return shiftBuckets.get(sk);
      }

      for (let c = 2; c < lastCol; c++) {
        const info = perColInfo.get(c); const sk = info && info.shiftKey; if (!sk) continue;
        const b = bucket(sk); if (!b) continue;

        b.colsAll.push(c);
        const isTargetedCol = !targetedColSet || targetedColSet.has(c + 1);
        if (isTargetedCol) b.colsPaint.push(c);

        if (!info.isPast) {
          const nm = normName(info.occupant);
          if (nm) {
            b.namedCols.push(c);
            if (!b.nameColsByName.has(nm)) b.nameColsByName.set(nm, []);
            b.nameColsByName.get(nm).push(c);
          } else {
            b.blanks.push(c);
            if (isTargetedCol) b.blanksTargeted.push(c);
          }
        }
      }

      rowsForDate.forEach(row => {
        const occKey = row[0];
        const histShift = row[2];
        const histSk = shiftKeyOf(histShift);
        const nm = normName(occKey);
        if (!nm || !histSk) return;
        const b = bucket(histSk); if (!b) return;
        b.ehCounts.set(nm, (b.ehCounts.get(nm) || 0) + 1);
        const ref = String(row[3] || "").trim();
        if (!b.ehRefsByName.has(nm)) b.ehRefsByName.set(nm, new Set());
        if (ref) b.ehRefsByName.get(nm).add(ref);
      });

      // Decide colours per bucket
      for (const [sk, b] of shiftBuckets.entries()) {
        const matchedCols = new Set();
        const extraNamedCols = new Set();
        const remaining = new Map(b.ehCounts);

        // Match by name
        for (const [nm, colsArr] of b.nameColsByName.entries()) {
          let need = remaining.get(nm) || 0;
          if (need <= 0) { colsArr.forEach(c => extraNamedCols.add(c)); continue; }
          const take = Math.min(need, colsArr.length);
          for (let i = 0; i < take; i++) matchedCols.add(colsArr[i]);
          remaining.set(nm, need - take);
          for (let i = take; i < colsArr.length; i++) extraNamedCols.add(colsArr[i]);
        }

        // Shortfall -> blank reps (prefer hints)
        let unmatchedEH = 0; for (const v of remaining.values()) unmatchedEH += v;
        const candidateBlanks = (isTargeted ? b.blanksTargeted : b.blanks).slice().sort((a,b_) => a - b_);
        const hinted = [], nonHinted = [];
        const hintSet = getHintCols1Based(sheetId, r + 1);
        for (const c of candidateBlanks) { (hintSet.has(c + 1) ? hinted : nonHinted).push(c); }
        const orderedBlanks = hinted.concat(nonHinted);
        const blanksForShortfall = [];
        if (unmatchedEH > 0) {
          for (let i = 0; i < orderedBlanks.length && blanksForShortfall.length < unmatchedEH; i++) blanksForShortfall.push(orderedBlanks[i]);
        }

        // Choose columns to paint
        const toPaint = isTargeted ? b.colsPaint : b.colsAll;

        toPaint.forEach(c => {
          const info = perColInfo.get(c);
          if (!info || info.isPast) return;
          const nm = normName(info.occupant);
          const idx = c - 2;
          const isMatched = matchedCols.has(c);
          const isExtra   = extraNamedCols.has(c);
          const isBlank   = !nm;

          let newNameBg = nameBgRow[idx];
          let newRefBg  = refBgRow[idx];

          if (isMatched) {
            newNameBg = GREEN;
            const ehRefSet = b.ehRefsByName.get(nm) || new Set();
            const refOk = info.refHere && ehRefSet.size ? ehRefSet.has(info.refHere) : true;
            newRefBg = refOk ? GREEN : RED;
          } else if (isExtra) {
            newNameBg = RED; newRefBg = RED;
          } else if (isBlank) {
            const makeRed = blanksForShortfall.indexOf(c) !== -1;
            if (makeRed) { newNameBg = RED; newRefBg = RED; }
            else if (allowClear) { newNameBg = WHITE; newRefBg = WHITE; }
          }

          if (newNameBg !== nameBgRow[idx] || newRefBg !== refBgRow[idx]) {
            nameBgRow[idx] = newNameBg; refBgRow[idx] = newRefBg;
          }
        });
      }

      // Commit this band's backgrounds
      bandRange.setBackgrounds([nameBgRow, refBgRow]);
    }
  });

  SpreadsheetApp.flush();
}







/*********************************************************************
 * Helpers for WhatsApp shift reminders
 *********************************************************************/

/**
 * Finds the first 3–4 digit sequence in a shift label (e.g. "1930")
 * and returns e.g. "1930hrs".
 */
function parseShiftStartTime(label) {
  if (!label) return "";
  const m = label.match(/\b(\d{3,4})\b/);
  return m ? m[1] + "hrs" : "";
}

/**
 * Given a shiftObj { date:"dd/MM/yyyy", shift:"Night 1930-0800hrs", … },
 * returns a JS Date at the shift’s start moment, or null if unparsable.
 */
function parseShiftDateTime(shiftObj) {
  const bits = (shiftObj.date||"").split("/");
  if (bits.length !== 3) return null;
  const [d, m, y] = bits.map(Number);
  if (!d||!m||!y) return null;

  const tm = parseShiftStartTime(shiftObj.shift).replace(/[^\d]/g,"");
  let hour=0, min=0;
  if (tm.length===3) {
    hour   = parseInt(tm[0],10);
    min    = parseInt(tm.slice(1),10);
  } else if (tm.length===4) {
    hour   = parseInt(tm.slice(0,2),10);
    min    = parseInt(tm.slice(2),10);
  }
  return new Date(y, m-1, d, hour, min);
}

/**
 * Returns "night" or "day" if recognized in the label.
 */
function interpretShiftType(label) {
  const l = (label||"").toLowerCase();
  if (l.includes("night"))   return "night";
  if (l.includes("long day") || l.includes("day")) return "day";
  return null;
}

/**
 * Reads your "Candidate List" sheet and returns a map:
 *   occupantKey => { phone:"44…", firstName:"…", skipWhatsApp:true/false }
 */
function getCandidateDataMap() {
  const ss   = SpreadsheetApp.getActiveSpreadsheet();
  const data = ss.getSheetByName("Candidate List")
                 .getDataRange().getValues();
  if (data.length < 2) return {};

  // figure out which column is which
  const hdrs       = data[0].map(h => h.toString().trim().toLowerCase());
  const surnameIdx = hdrs.indexOf("surname");
  const firstIdx   = hdrs.indexOf("first name") >= 0
                     ? hdrs.indexOf("first name")
                     : hdrs.indexOf("firstname");
  const phoneIdx   = hdrs.indexOf("phone") >= 0
                     ? hdrs.indexOf("phone")
                     : hdrs.indexOf("telephone");
  const jobIdx     = hdrs.indexOf("job title") >= 0
                     ? hdrs.indexOf("job title")
                     : hdrs.indexOf("jobtitle");
  const genderIdx  = hdrs.indexOf("gender");
  const tierIdx    = hdrs.indexOf("tier");
  const waIdx      = hdrs.indexOf("whatsapp reminders");

  const map = {};
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const surname  = (row[surnameIdx] || "").toString().trim();
    const firstname= (row[firstIdx]   || "").toString().trim();
    let   phoneRaw = (row[phoneIdx]   || "").toString().replace(/[^\d]/g,"");
    if (!surname || !firstname || !phoneRaw) continue;
    // normalize UK intl
    if (phoneRaw.startsWith("0")) phoneRaw = phoneRaw.slice(1);
    const phone = "44" + phoneRaw;

    const jobTitle = jobIdx   >= 0 ? row[jobIdx].toString().trim() : "";
    const gender   = genderIdx>= 0 ? row[genderIdx].toString().trim().toLowerCase() : "";
    const tier     = tierIdx  >= 0 ? Number(row[tierIdx]) || 0 : 0;
    const skip     = waIdx    >= 0
                     && (row[waIdx] || "").toString().trim().toUpperCase() === "NO";

    map[(surname + " " + firstname).toLowerCase()] = {
      surname,
      firstName: firstname,
      phone,
      jobTitle,
      gender,
      tier,
      skipWhatsApp: skip
    };
  }
  return map;
}


/**
 * From a sorted list of upcoming shifts, finds the next one
 * that’s either today or tomorrow, plus the very next after it.
 */
function getNextTwoShiftsForCandidate(shifts, now, tz) {
  const todayY  = Utilities.formatDate(now, tz, "yyyyMMdd");
  const tom      = new Date(now); tom.setDate(now.getDate()+1);
  const tomoY    = Utilities.formatDate(tom, tz, "yyyyMMdd");

  let next=null, second=null;
  for (let i=0;i<shifts.length;i++) {
    const dt = parseShiftDateTime(shifts[i]);
    if (!dt || dt<=now) continue;
    const key = Utilities.formatDate(dt, tz, "yyyyMMdd");
    if (key===todayY||key===tomoY) {
      next   = { data:shifts[i], when:key===todayY?"today":"tomorrow", dt };
      // find second
      for (let j=i+1;j<shifts.length;j++) {
        const dt2 = parseShiftDateTime(shifts[j]);
        if (dt2>now) {
          second = { data:shifts[j], dt:dt2 };
          break;
        }
      }
      break;
    }
  }
  return { next, second };
}

/**
 * Builds the “next”‑shift object (used by both one‑shift and two‑shift reminders).
 * Now includes the raw booking reference from the rota.
 */
function buildNextShiftObject(n, when) {
  const s = n.data;
  const dt = n.dt;
  const datePretty = Utilities.formatDate(dt,
    SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone(),
    "EEEE d MMMM yyyy");

  // Prefer extracting start time from the note if present
  let startTime;
  if (s.note) {
    const m = s.note.match(/Start:\s*(\d{2}:\d{2})/);
    startTime = m ? `${m[1]}hrs` : parseShiftStartTime(s.shift);
  } else {
    startTime = parseShiftStartTime(s.shift);
  }

  return {
    nextShift:        when,           // “today” or “tomorrow”
    nextShiftDate:    datePretty,     // e.g. “Saturday 19 April 2025”
    startTimeString:  startTime,      // extracted or parsed
    hospital:         s.hospital,
    ward:             s.ward,
    reference:        (s.reference||"").trim()
  };
}

/**
 * One‑shift reminder: inject the booking reference sentence only if we have one.
 */

function buildSecondShift(n2) {
  const s = n2.data, dt=n2.dt, tz=SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone();
  const tomo = new Date(); tomo.setDate(tomo.getDate()+1);
  const key2 = Utilities.formatDate(dt,tz,"yyyyMMdd");
  const tomoKey = Utilities.formatDate(tomo,tz,"yyyyMMdd");
  const datePretty = key2===tomoKey
    ? "tomorrow"
    : Utilities.formatDate(dt,tz,"EEEE d MMMM");
  const t = interpretShiftType(s.shift)==="night" ? "night shift" : "long day";
  return { datePretty, startTimeString: t, hospital: s.hospital, ward: s.ward };
}

/**
 * Builds the template parameters payload for WATI.
 */
function buildWatiParams(forename, next, second) {
  const p = [
    { name:"forename",           value:forename },
    { name:"nextshift",          value:next.nextShift },
    { name:"nextshiftdate",      value:next.nextShiftDate },
    { name:"nextshiftstarttime", value:next.startTimeString },
    { name:"nextshifthospital",  value:next.hospital },
    { name:"nextshiftward",      value:next.ward }
  ];
  if (second) {
    p.push(
      { name:"secondshift",         value:second.datePretty },
      { name:"secondshifttype",     value:second.startTimeString },
      { name:"secondshifthospital", value:second.hospital },
      { name:"secondshiftward",     value:second.ward }
    );
  }
  return p;
}

/**
 * Unique broadcast name per candidate
 */
function buildBroadcastName(name, now) {
  const clean = name.replace(/\s+/g,"");
  const stamp = Utilities.formatDate(now,"Europe/London","ddMMyyHHmmss");
  return `${clean}_${stamp}`;
}

/**
 * One‑shift reminder: inject the booking reference sentence only if we have one.
 */
function buildFreeTextMessageOneShift(fn, next) {
  // only mention reference if non‑empty
  const refLine = next.reference
    ? ` Booking reference number for this shift is ${next.reference}.`
    : "";
  return (
    `Hi ${fn}\n\n` +
    `*Shift Reminder*\n\n` +
    `Your next confirmed shift is ${next.nextShift}, ${next.nextShiftDate}, ` +
    `starting at ${next.startTimeString}. This shift is at ${next.hospital} on ${next.ward} ward.${refLine}\n\n` +
    `Many thanks.`
  );
}

/**
 * Two‑shift reminder: same first‑shift reference logic, nothing for the second.
 */
function buildFreeTextMessageTwoShifts(fn, next, sec) {
  const refLine = next.reference
    ? ` Booking reference number for this shift is ${next.reference}.`
    : "";
  return (
    `Hi ${fn}\n\n` +
