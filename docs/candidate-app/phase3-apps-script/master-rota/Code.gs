/** Remove history rows older than 2 months */
function cleanupEmailHistory() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("EmailHistory");
  if (!sheet) return;
  const tz  = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone();
  const now = new Date();
  const cutoff = new Date(now.getFullYear(), now.getMonth()-2, now.getDate());
  const data = sheet.getDataRange().getValues();
  const keep = [data[0]]; // header
  for (let i=1; i<data.length; i++) {
    const row = data[i];
    const rawDate = row[1];
    const d = (rawDate instanceof Date)
      ? rawDate
      : parseDateDDMMYYYY(rawDate);
    if (d >= cutoff) {
      keep.push(row);
    }
  }
  sheet.clearContents();
  sheet.getRange(1,1,keep.length, keep[0].length).setValues(keep);
}

// Wrapper to send WhatsApp only for true diffs (new bookings, cancellations, new refs)
function sendWhatsAppDiffOnlyUpdates(candidateKeys) {
  // Ensure candidateKeys is an array of lowercase keys
  const keysSet = new Set(candidateKeys.map(k => k.toLowerCase()));

  // 1) Gather only outstanding diffs
  const allUpdates = getOutstandingUpdates();
  const updates    = allUpdates.filter(u => keysSet.has(u.key));

  // 2) Map candidate data for WhatsApp
  const waMap = getCandidateDataMap();

  // 3) Loop and send
  updates.forEach(u => {
    const w = waMap[u.key];
    if (!w || !w.phone) return;

    const phone = w.phone;
    const fn    = w.firstName;
    const diffs = u.diffs;

    // Build free-text session message
    const text = buildSessionText(fn, diffs);
    const sessionOK = trySendSessionWA(phone, text);

    // If session send failed, fallback to template pages
    if (!sessionOK) {
      const pages = paginateTemplateParams(diffs);
      pages.forEach(params => sendTemplateBroadcast(phone, params));
    }
  });
}

