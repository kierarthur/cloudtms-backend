function getCredentiallyComplianceRunStatus() {
  const props = PropertiesService.getScriptProperties();
  const STATUS_PROP = 'CDOCS_COMPLIANCE_MANUAL_STATUS_JSON';
  let status = {};
  try { status = JSON.parse(props.getProperty(STATUS_PROP) || '{}') || {}; } catch (e) { status = {}; }

  const isManual = status.manual === true;
  const isActive = isManual
    ? (typeof status.active === 'boolean'
        ? status.active
        : !/^(completed|failed|idle)$/i.test(String(status.stage || 'idle')))
    : false;

  return {
    manual: isManual,
    active: isActive,
    stage: isManual ? (status.stage || 'idle') : 'idle',
    message: isManual ? (status.message || 'Waiting for status…') : 'No manual refresh is currently active.',
    startedAt: isManual ? (status.startedAt || '') : '',
    updatedAt: isManual ? (status.updatedAt || '') : '',
    credentiallyNextIndex: isManual && typeof status.credentiallyNextIndex === 'number' ? status.credentiallyNextIndex : 0,
    credentiallyTotalCandidates: isManual && typeof status.credentiallyTotalCandidates === 'number' ? status.credentiallyTotalCandidates : null,
    complianceNextIndex: isManual && typeof status.complianceNextIndex === 'number' ? status.complianceNextIndex : 0,
    complianceTotalCandidates: isManual && typeof status.complianceTotalCandidates === 'number' ? status.complianceTotalCandidates : null,
    error: isManual ? (status.error || '') : ''
  };
}


function setCredentiallyComplianceRunStatus_(patch) {
  const props = PropertiesService.getScriptProperties();
  const STATUS_PROP = 'CDOCS_COMPLIANCE_MANUAL_STATUS_JSON';

  let current = {};
  try {
    current = JSON.parse(props.getProperty(STATUS_PROP) || '{}') || {};
  } catch (e) {
    current = {};
  }

  const nowIso = new Date().toISOString();
  const next = Object.assign({}, current, patch || {});

  if (!next.startedAt) {
    next.startedAt = current.startedAt || nowIso;
  }
  next.updatedAt = nowIso;

  props.setProperty(STATUS_PROP, JSON.stringify(next));
  return next;
}

function clearCredentiallyComplianceRunStatus_() {
  const props = PropertiesService.getScriptProperties();
  const STATUS_PROP = 'CDOCS_COMPLIANCE_MANUAL_STATUS_JSON';
  props.deleteProperty(STATUS_PROP);
}


function _readHeaderRoleGenderMap(sheet, cols) {
  if (!cols.length) return new Map();
  const minCol = Math.min.apply(null, cols);
  const maxCol = Math.max.apply(null, cols);
  const width  = maxCol - minCol + 1;
  const hdrs   = sheet.getRange(3, minCol, 1, width).getDisplayValues()[0];

  const map = new Map();
  for (let i = 0; i < cols.length; i++) {
    const col = cols[i];
    const hdr = String(hdrs[col - minCol] || '');
    const role   = _parseRoleFromHeader(hdr);   // "RMN" or "HCA"
    const gender = _parseGenderFromHeader(hdr); // "male" | "female" | "any"
    map.set(col, { role, gender });
  }
  return map;
}

function _collapseFilters(headerMap) {
  const set = new Set(); // of "ROLE|gender"
  headerMap.forEach(({ role, gender }) => {
    const g = gender || 'any';
    set.add(`${role}|${g}`);
  });
  // Return as array of objects for clarity
  return Array.from(set).map(s => {
    const [role, gender] = s.split('|');
    return { role, gender };
  });
}

function _parseRoleFromHeader(hdr) {
  const s = String(hdr || '').toLowerCase();
  if (s.includes('rmn') || s.includes('mental')) return 'RMN';
  if (s.includes('hca') || s.includes('health care') || s.includes('healthcare')) return 'HCA';
  // Fallback: prefer stricter role
  return 'HCA';
}

function _parseGenderFromHeader(hdr) {
  const s = String(hdr || '');
  const isEither = /\(male\s*or\s*female\)/i.test(s);
  if (/female/i.test(s) && !isEither) return 'female';
  if (/male/i.test(s)   && !isEither) return 'male';
  return 'any';
}

function _candidateMatchesAnyFilter(c, filters) {
  for (let i = 0; i < filters.length; i++) {
    const f = filters[i];

    // Role rule: RMNs can cover HCA shifts, but HCAs cannot cover RMN shifts
    const roleOk = (f.role === 'HCA')
      ? (c.jobUpper === 'HCA' || c.jobUpper === 'RMN')
      : (c.jobUpper === f.role);

    if (!roleOk) continue;

    const genderOk = (f.gender === 'any') || (c.genderLower === f.gender);
    if (genderOk) return true;
  }
  return false;
}

function _complianceKeyFromFullName(fullName) {
  // Using "Surname|FirstName(s)" as canonical key
  const parts = String(fullName || '').trim().split(/\s+/);
  if (parts.length < 2) return String(fullName || '').trim();
  const surname   = parts[0].trim();
  const firstName = parts.slice(1).join(' ').trim();
  return `${surname}|${firstName}`;
}

