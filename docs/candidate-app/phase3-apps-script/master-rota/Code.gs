/**
 * NEW: Return only non-DECLINED DBS files.
 * @param {!Array<!Object>} files Array of file objects (from Documents API).
 * @return {!Array<!Object>}
 */
function filterDbsFilesNonDeclined_(files) {
  if (!Array.isArray(files)) return [];
  return files.filter(f => {
    const v = Array.isArray(f && f.verifications) ? f.verifications : [];
    return !v.some(x => String(x && x.verificationType || '').toUpperCase() === 'DECLINED');
  });
}

/**
 * NEW: Pick the most recent file by `created` timestamp (desc).
 * @param {!Array<!Object>} files
 * @return {?Object} anchor file or null
 */
function selectLatestByCreated_(files) {
  if (!Array.isArray(files) || !files.length) return null;
  const sorted = files.slice().sort((a, b) => {
    const ta = new Date(a && a.created || 0).getTime();
    const tb = new Date(b && b.created || 0).getTime();
    return tb - ta;
  });
  return sorted[0] || null;
}

/**
 * NEW: Group files that share the same expiry as the anchor.
 * If the anchor has no expiry, return [anchor] only.
 * @param {!Array<!Object>} files Non-declined files.
 * @param {!Object} anchor The chosen anchor file.
 * @return {!Array<!Object>}
 */
function groupSameExpiryAsAnchor_(files, anchor) {
  if (!anchor) return [];
  if (!anchor.expiry) return [anchor];
  const exp = String(anchor.expiry || '');
  return (files || []).filter(f => String(f && f.expiry || '') === exp);
}

/**
 * NEW: Extract "<DBS Issued by>" from the most recent non-empty comment
 * found on the anchor file. If anchor has no comments, optionally fall back
 * to the document's activeFile comments.
 *
 * @param {!Object} anchor A DBS file object (from Documents API).
 * @param {?Object=} dbsDoc Optional full DBS document object to look at activeFile.comments as a fallback.
 * @param {string=} defaultValue Optional fallback value; defaults to "Arthur Rai Medical Services Limited".
 * @return {string}
 */
function extractLatestIssuedByComment_(anchor, dbsDoc, defaultValue) {
  const fallback = typeof defaultValue === 'string' && defaultValue
    ? defaultValue
    : 'Arthur Rai Medical Services Limited';

  const listA = Array.isArray(anchor && anchor.comments) ? anchor.comments : [];
  const listB = Array.isArray(dbsDoc && dbsDoc.activeFile && dbsDoc.activeFile.comments)
    ? dbsDoc.activeFile.comments
    : [];

  const pool = (listA.length ? listA : listB).slice();
  if (!pool.length) return fallback;

  const newest = pool.sort((a, b) => {
    const ta = new Date(a && a.created || 0).getTime();
    const tb = new Date(b && b.created || 0).getTime();
    return tb - ta;
  }).find(c => {
    const msg = String(c && c.message || '').trim();
    return msg.length > 0;
  });

  return newest ? String(newest.message).trim() : fallback;
}

/**
 * NEW: Utility – is a file type an IMAGE?
 * Accepts "IMAGE" or "image/*"
 * @param {string} fileType
 * @return {boolean}
 */
function isImageFileType_(fileType) {
  const t = String(fileType || '').toUpperCase();
  return t === 'IMAGE' || t.startsWith('IMAGE/');
}

/**
 * NEW: Utility – is a file type a PDF?
 * Accepts "PDF" or "application/pdf"
 * @param {string} fileType
 * @return {boolean}
 */
function isPdfFileType_(fileType) {
  const t = String(fileType || '').toUpperCase();
  return t === 'PDF' || t === 'APPLICATION/PDF';
}

/**
 * NEW (fallback): Center "crop" to ID aspect (35x45mm ≈ 0.777) without external services.
 * Apps Script lacks native pixel-accurate cropping of blobs; this fallback simply
 * returns the original blob so the doc can still render. The Cloud Run service
 * remains the primary approach for actual cropping.
 *
 * @param {!Blob} blob
 * @return {!Blob} blob (unchanged)
 */

/**
 * NEW: Flatten questionnaire objects to a single answers[] list, then
 * return the most recent match for a question pattern.
 *
 * @param {!Array<!Object>} questionnaires Raw payload from /v1/employees/{id}/questionnaires
 * @param {!RegExp} questionRegex Case-insensitive regex for question text
 * @return {{question:string,answer:*,completed:string}|null}
 */
function findMostRecentAnswer_(questionnaires, questionRegex) {
  if (!Array.isArray(questionnaires) || !questionnaires.length) return null;

  const answers = [];
  for (const q of questionnaires) {
    const completed = q && q.completed || '';
    const list = Array.isArray(q && q.answers) ? q.answers : [];
    for (const a of list) {
      answers.push({
        id: a && a.id || 0,
        question: String(a && a.question || ''),
        answer: a && a.answer,
        completed
      });
    }
  }

  answers.sort((a, b) => {
    const ta = new Date(a.completed || 0).getTime();
    const tb = new Date(b.completed || 0).getTime();
    if (tb !== ta) return tb - ta;
    return (b.id || 0) - (a.id || 0);
  });

  return answers.find(x => questionRegex.test(String(x.question)));
}

/**
 * NEW: Convert yyyy-mm-dd to dd-mm-yyyy (hyphens). Falls back via pickDate() if needed.
 * @param {string} iso
 * @return {string}
 */
function isoToHyphen_(iso) {
  const m = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (m) return `${m[3]}-${m[2]}-${m[1]}`;
  const ddmmyyyy = pickDate(iso || '');
  return ddmmyyyy ? ddmmyyyy.replace(/\//g, '-') : '';
}

/**
 * NEW: Standardized DBS attachment filename.
 * @param {string} surname
