function exportChecklist_(fileId, baseName, wantDocx=false) {
  // Primary requirement: the emailed attachment MUST be a Word .docx file.
  // This wrapper now delegates to the HTTP-based Drive v3 files.export with alt=media.
  // NOTE: `wantDocx` is ignored; we always export DOCX.
  try {
