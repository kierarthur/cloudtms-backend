/**
 * Return the raw cached compliance map (or {} if empty/corrupt).
 * Cache key: _CACHE_KEY_COMPLIANCE
 */
function getCachedComplianceMap() {
  const cache = CacheService.getScriptCache();
  const json  = cache.get(_CACHE_KEY_COMPLIANCE);
  if (!json) return {};
  try { return JSON.parse(json) || {}; } catch (e) { return {}; }
}

/**
 * Log the entire cached compliance map to the Logs sheet (Timestamp | Route | Message).
 * One row per entry + a summary line. No sheet reads.
 */
function logCachedCompliance() {
  const ss = SpreadsheetApp.getActive();
  const LOG_SHEET = 'Logs';

  const map = getCachedComplianceMap();
  const entries = Object.keys(map).sort((a,b)=>a.localeCompare(b, undefined, {sensitivity:'base'}));

  // ensure Logs exists with header
  let logSh = ss.getSheetByName(LOG_SHEET);
  if (!logSh) {
    logSh = ss.insertSheet(LOG_SHEET);
    logSh.getRange(1,1,1,3).setValues([['Timestamp','Route','Message']]);
  } else if (logSh.getLastRow() === 0) {
    logSh.getRange(1,1,1,3).setValues([['Timestamp','Route','Message']]);
  }

  const now = new Date();
  const rows = [];
  rows.push([now, 'cache:compliance', `DUMP BEGIN • entries=${entries.length}`]);
  for (const k of entries) {
    rows.push([now, 'cache:compliance', `key=${k} • status=${String(map[k]).toUpperCase()}`]);
  }
  rows.push([now, 'cache:compliance', 'DUMP END']);

  if (rows.length > 0) {
    const start = Math.max(2, logSh.getLastRow() + 1);
    logSh.getRange(start, 1, rows.length, 3).setValues(rows);
  }

  return { entries: entries.length };
}

/**
 * Write the cached compliance map to a dedicated sheet (no sheet reads to build it).
 * Columns: KeyOrName | Status | Type(KEY/FULLNAME)
 */
function dumpCachedComplianceToSheet() {
  const ss = SpreadsheetApp.getActive();
  const DUMP_SHEET = 'ComplianceCache_Dump';

  const map = getCachedComplianceMap();
  const entries = Object.keys(map).sort((a,b)=>a.localeCompare(b, undefined, {sensitivity:'base'}));
  const rows = entries.map(k => [k, String(map[k]).toUpperCase(), k.includes('|') ? 'KEY' : 'FULLNAME']);

  let sh = ss.getSheetByName(DUMP_SHEET);
  if (!sh) sh = ss.insertSheet(DUMP_SHEET);
  sh.clear();
  sh.getRange(1,1,1,3).setValues([['KeyOrName','Status','Type']]);
  if (rows.length) sh.getRange(2,1,rows.length,3).setValues(rows);

  return { rows: rows.length, sheet: DUMP_SHEET };
}

