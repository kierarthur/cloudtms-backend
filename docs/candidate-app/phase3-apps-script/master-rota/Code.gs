        payload: (cid + '|' + (role||'') + '|' + (gender||'')),
        outputJSON: JSON.stringify(detail || {}),
        status: reason
      });
    } catch (_) {}
    _logLocal('include', cid, role, gender, reason, detail);
  }

  // Helper to read availability code for a date
  function codeOn(cid, ymd) {
    const rec = daysByCid[cid] || {};
    const c = String(rec[ymd] == null ? '' : rec[ymd]).trim();
    return c || '';
  }

  // Build a compact list of RB targets (ymd, S, role, g)
  const rbTargets = vacancies.map(v => ({ ymd: v.ymd, S: v.shift || 'L', role: (v.role||'').toUpperCase(), g: (v.gender||'Any').toUpperCase() }));

  Object.keys(baseAllowedCidSet).forEach(function(cid){
    const pf = profilesUnion[cid] || { role:'', gender:'M' }; // gender is M/F in your data model
    const role = String(pf.role||'').toUpperCase();
    const gender = String(pf.gender||'').toUpperCase();

    // Global uniform filters
    if (allRMN && role !== 'RMN') { logExclude(cid, role, gender, 'GLOBAL_ROLE_FILTER_RMN_ONLY', {rbDates: rbTargets.map(x=>x.ymd)}); return; }
    if (allHCA && role !== 'HCA') { logExclude(cid, role, gender, 'GLOBAL_ROLE_FILTER_HCA_ONLY', {rbDates: rbTargets.map(x=>x.ymd)}); return; }
    if (allMale && gender !== 'M') { logExclude(cid, role, gender, 'GLOBAL_GENDER_FILTER_M_ONLY', {rbDates: rbTargets.map(x=>x.ymd)}); return; }
    if (allFemale && gender !== 'F') { logExclude(cid, role, gender, 'GLOBAL_GENDER_FILTER_F_ONLY', {rbDates: rbTargets.map(x=>x.ymd)}); return; }

    // Signal checks across the planning horizon H
    const hasEH = !!eh.byCid[cid];
    const codesAll = dates.map(d => codeOn(cid, d));
    const anyMark = codesAll.some(c => c !== '');
    const allUnknown = codesAll.length > 0 && codesAll.every(c => c === '?');
    if (!anyMark && !hasEH) {
      logExclude(cid, role, gender, 'NO_SIGNAL', {planningDates: dates});
      return;
    }
    if (allUnknown && !hasEH) {
      logExclude(cid, role, gender, 'ALL_UNKNOWN_AND_NO_EH', {planningDates: dates});
      return;
    }

    // Per-date feasibility across selected RB targets
    let kept = [];
    let rejected = [];
    rbTargets.forEach(function(t){
      // Role/gender per-slot (only matters when mixed sets)
      if (!allRMN && !allHCA) {
        if (role && t.role && role !== t.role) { rejected.push({t, reason:'ROLE_MISMATCH'}); return; }
      } else {
        if (role && t.role && role !== t.role) { rejected.push({t, reason:'ROLE_MISMATCH'}); return; }
      }
      if (!allMale && !allFemale) {
        if (t.g === 'M' && gender !== 'M') { rejected.push({t, reason:'GENDER_MISMATCH'}); return; }
        if (t.g === 'F' && gender !== 'F') { rejected.push({t, reason:'GENDER_MISMATCH'}); return; }
      } else {
        if (t.g === 'M' && gender !== 'M') { rejected.push({t, reason:'GENDER_MISMATCH'}); return; }
        if (t.g === 'F' && gender !== 'F') { rejected.push({t, reason:'GENDER_MISMATCH'}); return; }
      }

      // EH-only Night→LD ban (for LD dates)
      if (t.S === 'L') {
        const d1 = new Date(t.ymd + 'T00:00:00'); d1.setDate(d1.getDate()-1);
        const ymdPrev = _1fmtYmd(d1);
        const hasPrevNightEH = !!(eh.byCid[cid] && eh.byCid[cid].worked && eh.byCid[cid].worked[ymdPrev] === 'N');
        if (hasPrevNightEH) { rejected.push({t, reason:'EH_NIGHT_BEFORE_LD'}); return; }
      }

      // Availability on date
      const C = codeOn(cid, t.ymd); // '', L, N, X, B, K, ?
      if (C === 'B') { rejected.push({t, reason:'BOOKED'}); return; }
      if (C === 'K') { rejected.push({t, reason:'BLOCKED'}); return; }
      if (C === 'X') { rejected.push({t, reason:'UNAVAILABLE'}); return; }
      if (C === 'L' && t.S === 'N') { rejected.push({t, reason:'SHIFT_MISMATCH_L_ONLY'}); return; }
      if (C === 'N' && t.S === 'L') { rejected.push({t, reason:'SHIFT_MISMATCH_N_ONLY'}); return; }
      kept.push(t);
    });

    if (kept.length === 0) {
      const rbYmds = rbTargets.map(x=>x.ymd);
      const codesOnRB = rbTargets.map(t => ({ ymd:t.ymd, S:t.S, c: codeOn(cid, t.ymd) }));
      const allX = codesOnRB.length>0 && codesOnRB.every(x => x.c === 'X');
      const allBK = codesOnRB.length>0 && codesOnRB.every(x => x.c === 'B' || x.c === 'K');
      const ldTargets = rbTargets.filter(t => t.S === 'L');
      const allLDWipedByEH = ldTargets.length>0 && ldTargets.every(function(t){
        const d1 = new Date(t.ymd + 'T00:00:00'); d1.setDate(d1.getDate()-1);
        const ymdPrev = _1fmtYmd(d1);
        return !!(eh.byCid[cid] && eh.byCid[cid].worked && eh.byCid[cid].worked[ymdPrev] === 'N');
      });
      const remainingRB = rbTargets.filter(t => t.S !== 'L');
      const remainingAllBXK = remainingRB.length === 0 || remainingRB.every(t => {
        const c = codeOn(cid, t.ymd);
        return c === 'B' || c === 'K' || c === 'X';
      });

      if (allBK) { logExclude(cid, role, gender, 'ALL_BOOKED_OR_BLOCKED', {rbDates: rbYmds}); return; }
      if (allX)  { logExclude(cid, role, gender, 'ALL_UNAVAILABLE', {rbDates: rbYmds}); return; }
      if (allLDWipedByEH && remainingAllBXK) {
        logExclude(cid, role, gender, 'EH_NIGHT_BEFORE_LD_ALL + REMAINDER_BXK', {rbDates: rbYmds});
        return;
      }
      logExclude(cid, role, gender, 'NO_FEASIBLE_DATES_AFTER_FILTERS', {rejected});
      return;
    }

    survivors[cid] = true;

    // INCLUDE logging
    const includeReason =
      kept.some(k => { const c = codeOn(cid, k.ymd); return c === 'L' || c === 'N'; }) ? 'DECLARED_AVAIL_MATCH' :
      'PASSED_HARD_RULES';
    const keptDates = kept.map(k => k.ymd);
    const keptSummary = kept.map(k => (_1fmtYYMMDD(new Date(k.ymd||k)) + ':' + (codeOn(cid, k.ymd)||'?')) );
    logInclude(cid, role, gender, includeReason, {keptDates, keptSummary});
  });

  const survivorsCount = Object.keys(survivors).length;
  _log('survivors_ready', { survivorsCount });

  // Candidate static profile → C|  (only survivors)
  const C = [];
  const roleCounts = {};
  Object.keys(survivors).forEach(function(cid){
    const pf = profilesUnion[cid] || { role:'', gender:'M' };
    C.push('C|' + cid + '|role=' + (pf.role||'') + '|g=' + (pf.gender||'M'));
    const r = String(pf.role||'').trim() || 'Unknown';
    roleCounts[r] = (roleCounts[r]||0) + 1;
  });

  // Availability → A| (only Focus dates; only survivors)
  const A = [];
  const sortedF = focusDates.slice().sort();
  Object.keys(survivors).forEach(function(cid){
    const rec = daysByCid[cid] || {};
    const parts = [];
    for (let i=0; i<sortedF.length; i++) {
      const y = sortedF[i];
      const code = rec[y] || '';
      parts.push(_1fmtYYMMDD(new Date(y)) + '=' + (code || ''));
    }
    A.push('A|' + cid + '|' + parts.join(','));
  });

  // AVF| flags per cid over H vs F
  const AVF = [];
  Object.keys(survivors).forEach(function(cid){
    const rec = daysByCid[cid] || {};
    let anyH = false, anyF = false;
    for (let i=0; i<dates.length; i++) {
      const y = dates[i];
      const c = String(rec[y] || '').trim();
      if (c === 'L' || c === 'N') { anyH = true; if (Fset[y]) anyF = true; }
      if (anyH && anyF) break;
    }
    const outsideOnly = (anyH && !anyF) ? 1 : 0;
    AVF.push('AVF|' + cid + '|anyH=' + (anyH?1:0) + '|anyF=' + (anyF?1:0) + '|outsideOnly=' + outsideOnly);
  });

  // EmailHistory → E| (only survivors with EH present)
  const E = [];
  Object.keys(eh.byCid).forEach(function(cid){
    if (!survivors[cid]) return;
    const rec = eh.byCid[cid];
    const flags = rec.flags || '-';
    const recentArr = (eh.recentByCid[cid] || []).filter(x => !!Fset[x.ymd]).slice(0, 20); // only F
    const parts = [];
    for (let i=0; i<recentArr.length; i++) {
      const x = recentArr[i];
      parts.push(_1fmtYYMMDD(new Date(x.ymd)) + ':' + x.s);
    }
    const recent = parts.join(',');
    const v60 = (eh.recentByCid[cid] || []).length;
    const s60 = s60ByCid[cid] || 0;
    const activity_global = 1 - Math.exp(-(v60/12));
    const activity_site   = 1 - Math.exp(-(s60/6));
    const act = Math.min(1, 0.6*activity_global + 0.4*activity_site);
    E.push('E|' + cid + '|flags=' + flags + '|last=' + recent + '|v60=' + v60 + '|s60=' + s60 + '|act=' + act.toFixed(3));
  });

  // ESUM| weekday/shift summary OUTSIDE Focus dates
  const ESUM = [];
  function dowIndex(d){ const js = d.getDay(); return (js+6)%7; }
  const DOW = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
  Object.keys(survivors).forEach(function(cid){
    const worked = (eh.byCid[cid] && eh.byCid[cid].worked) ? eh.byCid[cid].worked : {};
    const counts = Array(7).fill(0).map(()=>({L:0,N:0}));
    Object.keys(worked).forEach(ymdStr => {
      if (Fset[ymdStr]) return; // exclude Focus
      const s = worked[ymdStr]; // 'L' or 'N'
      const d = new Date(ymdStr + 'T00:00:00');
      const di = dowIndex(d);
      if (s === 'L') counts[di].L++; else if (s === 'N') counts[di].N++;
    });
    const flags = (eh.byCid[cid] && eh.byCid[cid].flags) ? eh.byCid[cid].flags : '';
    const rapid = /E/.test(flags) ? 1 : 0; // presence proxy
    const early = /2/.test(flags) ? 1 : 0; // presence proxy
    const segs = [];
    for (let i=0;i<7;i++){ segs.push(DOW[i] + ':L' + counts[i].L + 'N' + counts[i].N); }
    ESUM.push('ESUM|' + cid + '|dow=' + segs.join(';') + '|rapid=' + rapid + '|early=' + early);
  });

  // Rules/weights
  const P = [
    'P|rules=hard:cidWhitelist,hard:matchRole,hard:matchGender,hard:noAssignIfXorK,hard:respectBooked(B),hard:noDoubleBook,hard:noLDafterNightBefore',
    'P|rules=soft:avoidShiftFlipWithinWindow,soft:inferFromHistoryWhenMissingAvailability',
    'P|limits=maxWorkedStreak:6,preferWorkedStreak:5,flipWindow:3',
    'P|weights=continuity:1.20,emergency:0.90,day2early:0.75,workedStreak:0.60,history:0.25,recency:0.15,rolefit:0.20,genderfit:0.10,newPerson:-0.08,flipPenalty:-0.30,sameShiftBonus:0.10,keepFewPeople:2.20,avoidClashes:9999,activity:0.15,patternInference:0.12,siteAffinity:0.00,dowAffinity:0.12'
  ];

  const payload = Hhdr
    .concat(C, A, AVF, E, ESUM, EHlines, EB, R, RB, NX, OR, P)
    .join('\n');

  _log('payload_built', {
    C: C.length, A: A.length, AVF: AVF.length, E: E.length, ESUM: ESUM.length,
    EH: (EHlines||[]).length, EB: EB.length, RB: RB.length, NX: NX.length, OR: OR.length
  });

  return {
    payload: payload,
    site: rota.site || '',
    ward: rota.ward || '',
    sheetName: pinnedName,
    allowedCidSet: survivors,
    cidToName: cidToName,
    cidToGender: cidToGender,
    roleCounts: roleCounts
  };
}


function _1openDeepseekTextViewer(text, meta) {
  // Combine Deepseek's prose+HTML with our own shortlist right after the Deepseek HTML block.
  // Expects `meta.payload` (or meta.prepared.payload) and optional `meta.cidToName` for nicer labels.
  meta = meta || {};
  var deepseekText = String(text || '');

  // --- helper: cut Deepseek message into prose + ROTAS HTML ---
  function _extractDeepseekHtmlParts(s) {
    var t = String(s || '');
    var start = t.indexOf('<!-- ROTAS_HTML_START -->');
    var end   = t.indexOf('<!-- ROTAS_HTML_END -->');
    var hasHtml = start >= 0 && end >= 0 && end > start;
    return {
      prose: hasHtml ? t.slice(0, start).trim() : t,
      htmlBlock: hasHtml ? t.slice(start, end + '<!-- ROTAS_HTML_END -->'.length) : '',
      hasHtml: hasHtml
    };
  }

  // --- build our shortlist HTML if we have a payload to base it on ---
  var payload = String(
    (meta && meta.payload) ||
    (meta && meta.prepared && meta.prepared.payload) ||
    ''
  );
  var cidToName =
    (meta && meta.cidToName) ||
    (meta && meta.prepared && meta.prepared.cidToName) ||
    {};

  var shortlistHtml = '';
  try {
    if (payload) {
      // Uses helpers you already have:
      //   _1makeShortlistArgsFromPayload(payload)
      //   _1match_makeShortlistForVacancies(args)
      //   _1renderShortlistHtml(shortlist, cidToName)
      var args = _1makeShortlistArgsFromPayload(payload);
      var shortlist = _1match_makeShortlistForVacancies(args);
      shortlistHtml = _1renderShortlistHtml(shortlist, cidToName);
    }
  } catch (e) {
    // Fail-soft: show an inline note if shortlist couldn't be built
    shortlistHtml =
      '<div style="color:#b91c1c;background:#fee2e2;border:1px solid #fecaca;padding:8px;border-radius:6px;">' +
      'Shortlist could not be built: ' + String(e && e.message ? e.message : e) +
      '</div>';
  }

  // --- assemble the combined viewer (Deepseek first, then our shortlist) ---
  var parts = _extractDeepseekHtmlParts(deepseekText);
  var html = [
    '<!doctype html><html><head><meta charset="utf-8">',
    '<style>',
      'body{font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.4;margin:14px;}',
      '.section{margin:14px 0;}',
      '.divider{margin:18px 0;border-top:2px solid #e5e7eb;}',
    '</style>',
    '</head><body>',

    // 1) Deepseek prose (if any)
    parts.prose ? ('<div class="section">' + HtmlService.createHtmlOutput(parts.prose).getContent() + '</div>') : '',

    // 2) Deepseek HTML rota block (as-is between sentinels)
    parts.htmlBlock ? ('<div class="section">' + parts.htmlBlock + '</div>') : '',

    // 3) Divider + our shortlist
    '<div class="divider"></div>',
    '<div class="section">',
      '<h3 style="margin:0 0 8px 0;">My Engine Shortlist</h3>',
      shortlistHtml || '<em>No shortlist available.</em>',
    '</div>',

    '</body></html>'
  ].join('');

  var out = HtmlService.createHtmlOutput(html).setWidth(1200).setHeight(900);
  SpreadsheetApp.getUi().showModelessDialog(out, 'Deepseek rota plan — Text & My Shortlist');
}

/**
 * Build the rota-table HTML (Date × Role × Gender × Shift) from a compact payload.
 * Uses your existing shortlist pipeline:
 *   _1makeShortlistArgsFromPayload → _1match_makeShortlistForVacancies
 * Then renders a neat HTML grid so each requirement type (role+gender) is split into LD and Night columns.
 *
 * @param {string} payload  Compact payload containing RB| lines.
 * @param {Object<string,string>} cidToName  Optional map of candidateId → display name.
 * @return {string} HTML string for embedding into panels/modals.
 */
function __collectShortlistHtmlTableFromPayload(payload, cidToName) {
  payload = String(payload || '');
  cidToName = cidToName || {};

  if (!payload) return '<em>No payload provided.</em>';

  // 1) Build shortlist using your existing engine
  var args = _1makeShortlistArgsFromPayload(payload);
  var shortlist = _1match_makeShortlistForVacancies(args);
  var byRB = (shortlist && shortlist.byRB) ? shortlist.byRB.slice() : [];
  if (!byRB.length) return '<em>No shortlist available for the selected dates.</em>';

  // 2) Derive table axes
  //    - Dates: unique set of r.date
  //    - Bucket spec (stable ordering):
  //        Order roles alphabetically; within role, genders in order [F, M, Any]; for each, two columns: LD then N.
  var datesSet = {};
  var rolesSet = {};
  var gendersSetByRole = {};
  byRB.forEach(function (r) {
    if (r && r.date) datesSet[r.date] = true;
    var role = String(r.role || '').trim();
    if (role) {
      rolesSet[role] = true;
      var g = String(r.gender_req || r.gender || '').trim();
      g = g ? g : 'Any';
      (gendersSetByRole[role] = gendersSetByRole[role] || {})[g] = true;
    }
  });

  var dates = Object.keys(datesSet).sort(); // yyyy-MM-dd
  if (!dates.length) return '<em>No valid dates found in shortlist.</em>';

  var roleOrder = Object.keys(rolesSet).sort();
  var genderOrder = ['Female', 'Male', 'Any'];
  // Normalize incoming gender tokens to display strings
  function normGender(g) {
    var u = String(g || '').trim().toUpperCase();
    if (u === 'F' || u === 'FEMALE') return 'Female';
    if (u === 'M' || u === 'MALE') return 'Male';
    if (u === 'ANY' || u === '' || u === 'A') return 'Any';
    return g || 'Any';
  }

  // Build bucket spec: array of {role, gender, shift} with shift in ['LD','N']
  var buckets = [];
  roleOrder.forEach(function (role) {
    var gset = gendersSetByRole[role] || {};
    var presentGenders = Object.keys(gset).map(normGender);
    // Ensure stable order and include only present genders
    genderOrder.forEach(function (gg) {
      if (presentGenders.indexOf(gg) >= 0) {
        buckets.push({ role: role, gender: gg, shift: 'LD' });
        buckets.push({ role: role, gender: gg, shift: 'N' });
      }
    });
  });
  if (!buckets.length) return '<em>No role/gender buckets found.</em>';

  // 3) Build a fast lookup: per (date, role, gender, shift) → ordered suggestion list (names)
  //    Treat shift: r.shift === 'N' → 'N' else 'LD'
  function keyOf(d, role, g, sh) { return [d, role, g, sh].join('||'); }
  var cellMap = {}; // key → array of display strings
  byRB.forEach(function (r) {
    var date = String(r.date || '').trim();
    if (!date) return;
    var role = String(r.role || '').trim();
    var g = normGender(r.gender_req || r.gender || 'Any');
    var sh = (String(r.shift || '').trim().toUpperCase() === 'N') ? 'N' : 'LD';
    var k = keyOf(date, role, g, sh);
    var arr = cellMap[k] = cellMap[k] || [];

    var suggs = Array.isArray(r.suggestions) ? r.suggestions : [];
    suggs.forEach(function (s) {
      var cid = s && s.cid ? String(s.cid) : '';
      if (!cid) return;
      var nm = cidToName[cid] || cid;
      // Primary first (already ordered by your engine), include score as a small badge if present
      var score = (s && typeof s.score === 'number') ? Math.round(s.score * 100) / 100 : null;
      var tag = '<span class="wname">' + safeHtml(nm) + '</span>' + (score !== null ? ' <span class="score">' + score + '</span>' : '');
      arr.push(tag);
    });
  });

  // 4) Render HTML table
  var css = [
    '<style>',
    '.rotaGrid{border-collapse:collapse;width:100%;font-family:Arial,Helvetica,sans-serif;font-size:13px;}',
    '.rotaGrid th,.rotaGrid td{border:1px solid #ddd;padding:6px 8px;vertical-align:top;}',
    '.rotaGrid th{background:#f5f7fb;text-align:left;}',
    '.dateCol{white-space:nowrap;width:130px;}',
    '.score{display:inline-block;font-size:11px;border:1px solid #cfd7e6;border-radius:10px;padding:0 6px;margin-left:6px;color:#4b5563;background:#f8fafc;}',
    '.wname{background:#f0f7ff;border:1px solid #e1e8f7;border-radius:6px;padding:0 6px;}',
    '.muted{color:#6b7280;}',
    '</style>'
  ].join('');

  function safeHtml(s) {
    return String(s || '').replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; });
  }
  function fmtDate(ymd) {
    try {
      var d = new Date(ymd + 'T00:00:00');
      var days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
      var mons = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      return days[d.getDay()] + ' ' + String(d.getDate()).padStart(2,'0') + ' ' + mons[d.getMonth()];
    } catch (_) { return ymd; }
  }
  function colLabel(b) {
    return safeHtml(b.role + ' — ' + b.gender + ' — ' + (b.shift === 'N' ? 'Night' : 'Long Day'));
  }

  // Header
  var thead = ['<thead><tr><th class="dateCol">Date</th>'];
  buckets.forEach(function (b) { thead.push('<th>' + colLabel(b) + '</th>'); });
  thead.push('</tr></thead>');

  // Body
  var tbody = ['<tbody>'];
  dates.forEach(function (d) {
    tbody.push('<tr>');
    tbody.push('<td class="dateCol"><strong>' + safeHtml(d) + '</strong><div class="muted">' + safeHtml(fmtDate(d)) + '</div></td>');
    buckets.forEach(function (b) {
      var k = keyOf(d, b.role, b.gender, b.shift);
      var items = cellMap[k] || [];
      var inner = items.length ? items.join('<br>') : '<span class="muted">—</span>';
      tbody.push('<td>' + inner + '</td>');
    });
    tbody.push('</tr>');
  });
  tbody.push('</tbody>');

  return [
    '<!doctype html><html><head><meta charset="utf-8">', css, '</head><body>',
    '<h3 style="margin:0 0 8px 0;">My Engine Shortlist (Rota View)</h3>',
    '<table class="rotaGrid">', thead.join(''), tbody.join(''), '</table>',
    '</body></html>'
  ].join('');
}

/**
 * Persist payload/meta for a run so the final viewer can rebuild the shortlist table.
 * Uses Script Properties (durable, simple). Keys: RUNPAYLOAD_<runId>
 *
 * @param {string} runId
 * @param {{payload:string, sheetName?:string, site?:string, ward?:string, cidToName?:Object}} meta
 */
function _storePayloadForRun(runId, meta) {
  runId = String(runId || '').trim();
  if (!runId) return;
  meta = meta || {};
  var toSave = {
    payload: String(meta.payload || ''),
    sheetName: String(meta.sheetName || ''),
    site: String(meta.site || ''),
    ward: String(meta.ward || ''),
    cidToName: meta.cidToName || {}
  };
  try {
    var props = PropertiesService.getScriptProperties();
    props.setProperty('RUNPAYLOAD_' + runId, JSON.stringify(toSave));
  } catch (e) {
    // best-effort; ignore
  }
}

/**
 * Retrieve previously stored payload/meta for a run.
 *
 * @param {string} runId
 * @return {{payload:string, sheetName:string, site:string, ward:string, cidToName:Object}|{}}
 */
function _getPayloadForRun(runId) {
  runId = String(runId || '').trim();
  if (!runId) return {};
  try {
    var props = PropertiesService.getScriptProperties();
    var raw = props.getProperty('RUNPAYLOAD_' + runId);
    if (!raw) return {};
    var parsed = JSON.parse(raw);
    // Type guards
    if (parsed && typeof parsed === 'object') {
      parsed.payload = String(parsed.payload || '');
      parsed.sheetName = String(parsed.sheetName || '');
      parsed.site = String(parsed.site || '');
      parsed.ward = String(parsed.ward || '');
      parsed.cidToName = parsed.cidToName || {};
      return parsed;
    }
  } catch (e) {
    // ignore
  }
  return {};
}





function _1beginDeepseekAfterDatePick(clientPayload) {
  function log_(evt, obj) {
    try {
      var ss = SpreadsheetApp.getActive();
      var sh = ss.getSheetByName('Logs') || ss.getSheetByName('logs');
      if (!sh) return;
      var ts = Utilities.formatDate(new Date(), _1tz(), "yyyy-MM-dd'T'HH:mm:ss");
      sh.appendRow([ts, '_1beginDeepseekAfterDatePick', String(evt), JSON.stringify(obj || {}).slice(0, 5000)]);
    } catch (_) {}
  }

  try {
    const ss = SpreadsheetApp.getActive();

    // Prefer the ORIGINAL (pinned) sheet identity passed from the UI payload
    const pinnedNameFromClient = clientPayload && (clientPayload.pinnedSheetName || clientPayload.sheetName) || '';
    const pinnedIdFromClient = (clientPayload && clientPayload.pinnedSheetId != null)
      ? Number(clientPayload.pinnedSheetId)
      : -1;

    // Fallback snapshot (used ONLY if client payload didn’t carry pinned info)
    const fallbackAtEntry = ss.getActiveSheet();
    const fallbackName = fallbackAtEntry ? fallbackAtEntry.getName() : '';
    const fallbackId = fallbackAtEntry ? fallbackAtEntry.getSheetId() : -1;

    // Resolver that tries: name from client → id from client → fallback snapshot
    function _getPinnedSheet() {
      if (pinnedNameFromClient) {
        const byName = ss.getSheetByName(pinnedNameFromClient);
        if (byName) return byName;
      }
      if (pinnedIdFromClient && pinnedIdFromClient > 0) {
        const sheets = ss.getSheets() || [];
        for (var i = 0; i < sheets.length; i++) {
          if (sheets[i].getSheetId && sheets[i].getSheetId() === pinnedIdFromClient) return sheets[i];
        }
      }
      // Last resort
      return fallbackAtEntry || ss.getActiveSheet();
    }

    // Trace what we think the target is
    log_('pin', { pinnedNameFromClient, pinnedIdFromClient, fallbackName, fallbackId });

    const runId         = clientPayload && clientPayload.runId ? String(clientPayload.runId) : _1newRunId('DS');
    const selectedDates = (clientPayload && Array.isArray(clientPayload.selectedDates)) ? clientPayload.selectedDates : [];
    const exclusions    = (clientPayload && Array.isArray(clientPayload.exclusions)) ? clientPayload.exclusions : [];
    const avoidSheets   = (clientPayload && Array.isArray(clientPayload.avoidSheets)) ? clientPayload.avoidSheets : [];
    const localOnly     = !!(clientPayload && clientPayload.localOnly); // NEW

    if (!selectedDates.length) {
      log_('error', { msg: 'No dates were selected.' });
      return { ok: false, error: 'No dates were selected.' };
    }

    // ---- Compute Focus dates (±1 of selected) ∩ header window ∩ future, using the PINNED sheet
    const tz = _1tz();
    const today = new Date(); today.setHours(0,0,0,0);

    const pinnedSheet = _getPinnedSheet();
    const rota  = _1readCurrentRotaLayoutAndBlanks(pinnedSheet);
    const headerDates = (rota.allDates || []).slice().sort(); // yyyy-MM-dd
    const headerSet = headerDates.reduce((m,d)=>{ m[d]=true; return m; }, {});
    function ymd(d){ return Utilities.formatDate(d, tz, 'yyyy-MM-dd'); }
    function addDaysYmd(ymdStr, n){
      const d = new Date(ymdStr + 'T00:00:00'); d.setDate(d.getDate()+n); return ymd(d);
    }
    const rawSel = Array.from(new Set((selectedDates||[]).map(d => ymd(new Date(d)))));
    const fSet = {};
    rawSel.forEach(d => {
      [ -1, 0, +1 ].forEach(delta => {
        const dy = addDaysYmd(d, delta);
        if (headerSet[dy]) {
          const dd = new Date(dy + 'T00:00:00');
          if (dd >= today) fSet[dy] = true;
        }
      });
    });
    let focusDates = Object.keys(fSet).sort();

    let prepareNote = '';
    if (!focusDates.length) {
      const fallback = rawSel.filter(d => headerSet[d] && new Date(d + 'T00:00:00') >= today).sort();
      if (fallback.length) {
        focusDates = fallback;
        prepareNote = ' | Focus was empty; fell back to selected-only window for A|/EB|/EH|';
      } else {
        prepareNote = ' | Focus is empty (all outside header window or in the past)';
      }
    }

    // ---- Other rota protections — pass the PINNED SHEET explicitly
    let protect = { lines: [], protectedDatesCount: 0 };
    try {
      protect = _1computeOtherRotaProtections({
        activeSheet: pinnedSheet,
        selectedDates: selectedDates,
        otherRotasSelected: avoidSheets
      }) || { lines: [], protectedDatesCount: 0 };
    } catch (_) {
      protect = { lines: [], protectedDatesCount: 0 };
    }
    const extraLines = Array.isArray(protect.lines) ? protect.lines : [];
    const protectedDatesCount = Number(protect.protectedDatesCount || 0);

    // ---- Build compact payload — pass the PINNED SHEET and the precomputed Focus
    const built = _1buildCompactPayload(pinnedSheet, {
      exclusions: exclusions,
      selectedDates: selectedDates,
      focusDates: focusDates,
      extraLines: extraLines
    });
    const payload = built.payload;

    // ---- Save to Drive (already logs via _1logDeepseekCallChunked)
    try {
      const props = PropertiesService.getScriptProperties();
      const folderId = (props && props.getProperty('DS_PAYLOAD_FOLDER_ID')) || (typeof DRIVE_TARGET_FOLDER_ID !== 'undefined' ? DRIVE_TARGET_FOLDER_ID : '');
      if (folderId && typeof _saveTextFileToDrive_ === 'function') {
        const stamp = Utilities.formatDate(new Date(), _1tz(), 'yyyyMMdd_HHmmss');
        _saveTextFileToDrive_(folderId, 'deepseek_payload_' + stamp + '.txt', payload);
        _saveTextFileToDrive_(folderId, 'deepseek_payload_latest.txt', payload);
        const systemTEXT_tmp = _1buildDeepseekSystemText_TEXT();
        _saveTextFileToDrive_(folderId, 'deepseek_system_' + stamp + '.txt', systemTEXT_tmp);
        _saveTextFileToDrive_(folderId, 'deepseek_system_latest.txt', systemTEXT_tmp);
        _1logDeepseekCallChunked({ runId: runId, mode: 'SAVE', sheetName: built.sheetName, site: built.site, ward: built.ward, payload: '', outputJSON: '', status: 'Saved payload/system text to Drive folder ' + folderId });
      } else {
        _1logDeepseekCallChunked({ runId: runId, mode: 'SAVE', sheetName: built.sheetName, site: built.site, ward: built.ward, payload: '', outputJSON: '', status: 'Drive save skipped: DS_PAYLOAD_FOLDER_ID/DRIVE_TARGET_FOLDER_ID not set' });
      }
    } catch (e) {
      _1logDeepseekCallChunked({ runId: runId, mode: 'SAVE', sheetName: built.sheetName, site: built.site, ward: built.ward, payload: '', outputJSON: '', status: 'Drive save error: ' + (e && e.message ? e.message : String(e)) });
    }

    // ---- Preview counts & PREPARE log
    const rbCount = (String(payload).match(/^RB\|/gm) || []).length;
    const roleCounts = built.roleCounts || {};
    const roles = Object.keys(roleCounts).sort();
    const countsSummary = roles.map(r => (roleCounts[r] + ' ' + r)).join(', ') || '0 candidates';

    const systemTEXT = _1buildDeepseekSystemText_TEXT();

    _1logDeepseekCallChunked({
      runId: runId,
      mode: 'PREPARE',
      sheetName: built.sheetName,
      site: built.site,
      ward: built.ward,
      payload: payload,
      outputJSON: '',
      status: 'Prepared (awaiting user confirmation)' + (selectedDates.length ? ' | Sel=' + selectedDates.join(',') : '') + prepareNote
    });

    // Also add a brief row into Logs sheet for visibility
    log_('prepared', {
      runId: runId, sheet: built.sheetName, site: built.site, ward: built.ward,
      rbCount: rbCount, protectedDates: protectedDatesCount, countsSummary: countsSummary
    });

    return {
      ok: true,
      prepared: {
        runId: runId,
        sheetName: built.sheetName,
        site: built.site,
        ward: built.ward,
        rbCount: rbCount,
        protectedCount: protectedDatesCount,
        countsSummary: countsSummary,
        continuationFn: '_1runDeepseekAfterConfirm',
        payload: payload,
        systemText: systemTEXT,
        cidToName: built.cidToName || {},
        cidToGender: built.cidToGender || {},
        pinnedSheetId: (pinnedSheet && pinnedSheet.getSheetId) ? pinnedSheet.getSheetId() : -1,
        localOnly: localOnly // NEW: carry downstream
      }
    };
  } catch (e) {
    var msg = (e && e.message) ? e.message : String(e);
    log_('error', { error: msg });
    return { ok: false, error: msg };
  }
}


function _1readCurrentRotaLayoutAndBlanks(activeSheet) {
  function log_(evt, obj) {
    try {
      var ss = SpreadsheetApp.getActive();
      var sh = ss.getSheetByName('Logs') || ss.getSheetByName('logs');
      if (!sh) return;
      var ts = Utilities.formatDate(new Date(), _1tz(), "yyyy-MM-dd'T'HH:mm:ss");
      sh.appendRow([ts, '_1readCurrentRotaLayoutAndBlanks', String(evt), JSON.stringify(obj || {}).slice(0, 5000)]);
    } catch (_) {}
  }

  // Pin the intended sheet up-front and re-resolve by NAME to avoid any active-sheet drift from logging.
  const ss = SpreadsheetApp.getActive();
  const initialSheet = activeSheet || ss.getActiveSheet();
  const pinnedName = initialSheet ? initialSheet.getName() : '';
  const pinnedId = initialSheet ? initialSheet.getSheetId() : -1;
  function _getPinnedSheet() {
    var s = pinnedName ? ss.getSheetByName(pinnedName) : null;
    return s || initialSheet; // fallback just in case
  }
  log_('pin', { pinnedName: pinnedName, pinnedId: pinnedId });

  const sh  = _getPinnedSheet();
  const maxR = sh.getLastRow();
  const maxC = sh.getLastColumn();

  // Site/Ward from B1: split on last colon
  const b1 = String(sh.getRange('B1').getDisplayValue() || '');
  let site = '', ward = '';
  const lastColon = b1.lastIndexOf(':');
  if (lastColon >= 0) {
    site = b1.slice(0, lastColon).trim();
    ward = b1.slice(lastColon + 1).trim();
  }

  const hdrRow3 = sh.getRange(ROTA_ROW_ROLE_GENDER, 1, 1, maxC).getDisplayValues()[0];
  const hdrRow4 = sh.getRange(ROTA_ROW_SHIFT_TIME, 1, 1, maxC).getDisplayValues()[0];

  let lastCol = 2;
  for (let c = 3; c <= maxC; c++) {
    const hasHeader =
      String(hdrRow3[c - 1] || '').trim() !== '' ||
      String(hdrRow4[c - 1] || '').trim() !== '';
    if (hasHeader) lastCol = c;
  }
  if (lastCol < 3) {
    log_('no_rota_cols', { sheet: sh.getName(), site: site, ward: ward });
    return { site: site, ward: ward, dateColumns: [], vacancies: [], hasAnyNames: false, latestYmd:'', allDates:[] };
  }

  const abVals = sh.getRange(ROTA_BODY_START_ROW, 1, Math.max(0, maxR - ROTA_BODY_START_ROW + 1), 2).getDisplayValues();
  let lastRow = ROTA_BODY_START_ROW - 1;
  for (let i = 0; i < abVals.length; i++) {
    const r = ROTA_BODY_START_ROW + i;
    const a = String(abVals[i][0] || '').trim();
    const b = String(abVals[i][1] || '').trim();
    if (a === '' && b === '') break;
    lastRow = r;
  }
  if (lastRow < ROTA_BODY_START_ROW) {
    log_('no_rota_rows', { sheet: sh.getName(), site: site, ward: ward });
    return { site: site, ward: ward, dateColumns: [], vacancies: [], hasAnyNames: false, latestYmd:'', allDates:[] };
  }

  const bodyRows = lastRow - ROTA_BODY_START_ROW + 1;
  const bodyCols = lastCol - 2;
  const bodyVals  = sh.getRange(ROTA_BODY_START_ROW, 3, bodyRows, bodyCols).getDisplayValues();
  const bodyNotes = sh.getRange(ROTA_BODY_START_ROW, 3, bodyRows, bodyCols).getNotes();

  const colBRange = sh.getRange(ROTA_BODY_START_ROW, 2, bodyRows, 1).getDisplayValues();
  const ymdByRow = {};
  const dayRows = [];
  const allDatesSet = {};
  for (let r = ROTA_BODY_START_ROW; r <= lastRow; r += 2) {
    const offset = r - ROTA_BODY_START_ROW;
    const bVal = String(colBRange[offset][0] || '').trim();
    const d = _1parseHeaderDate(bVal) || _1parseDDMMYYYY(bVal);
    if (d && !isNaN(d)) {
      const y = _1fmtYmd(d);
      ymdByRow[r] = y;
      allDatesSet[y] = true;
    }
    dayRows.push(r);
  }

  function headerCell(row, col) {
    return (row === ROTA_ROW_ROLE_GENDER ? hdrRow3[col - 1] : hdrRow4[col - 1]) || '';
  }

  const dateColumns = [];
  const vacancies = [];
  let hasAnyNames = false;
  let latestYmd = '';

  for (let c = 3; c <= lastCol; c++) {
    const roleGenderCell = headerCell(ROTA_ROW_ROLE_GENDER, c);
    const shiftTimeCell  = headerCell(ROTA_ROW_SHIFT_TIME, c);

    const shift = _1inferShiftFromTimeCell(shiftTimeCell);
    const parsed = _1parseRoleGenderCell(roleGenderCell);
    const role = parsed.role;
    const gender = parsed.gender;

    let repYmd = '';
    for (let i = 0; i < dayRows.length; i++) {
      const rr = dayRows[i];
      if (ymdByRow[rr]) { repYmd = ymdByRow[rr]; break; }
    }
    dateColumns.push({ col: c, ymd: repYmd, shift: shift, role: role, gender: gender });

    for (let i = 0; i < dayRows.length; i++) {
      const r = dayRows[i];
      const ymd = ymdByRow[r];
      if (!ymd) continue;
      if (!latestYmd || ymd > latestYmd) latestYmd = ymd;

      const rowInBlock = r - ROTA_BODY_START_ROW;
      const colInBlock = c - 3;

      const val = String(bodyVals[rowInBlock][colInBlock] || '').trim();
      if (val && !_1isRotaBlank(val)) {
        hasAnyNames = true;
        continue;
      }

      const note = String(bodyNotes[rowInBlock][colInBlock] || '');
      const noteTag = _1noteToTag(note);
      vacancies.push({ ymd: ymd, shift: shift, role: role || '', gender: gender || 'Any', noteTag: noteTag });
    }
  }

  vacancies.sort(function(a, b) {
    if (a.ymd === b.ymd) return (a.shift < b.shift ? -1 : 1);
    return (a.ymd < b.ymd ? -1 : 1);
  });

  var out = {
    site: site,
    ward: ward,
    dateColumns: dateColumns,
    vacancies: vacancies,
    hasAnyNames: hasAnyNames,
    latestYmd: latestYmd || '',
    allDates: Object.keys(allDatesSet).sort()
  };

  log_('scan', { sheet: sh.getName(), site: site, ward: ward, cols: dateColumns.length, vacancies: vacancies.length, hasAnyNames: hasAnyNames });

  return out;
}

/**
 * Build a protected-rota feasibility index for OR base keys.
 * Input baseKeys are strings like "YYYY-MM-DD|S|ROLE|G".
 * Uses the same hard screens as your feasibility builder (role/gender match, A-codes, N→LD via EH, booked-elsewhere via EH).
 * Returns: { baseKey -> [cid, ...] } listing feasible cids for that protected cell.
 */
function _1buildORFeasIdx(baseKeys, profiles, daysByCid, eh) {
  var out = {};
  if (!Array.isArray(baseKeys) || !profiles) return out;

  var ehByCid = (eh && eh.byCid) ? eh.byCid : {};
  var cids = Object.keys(profiles || {});

  function parseBaseKey(k) {
    var p = String(k || '').split('|'); // ymd|S|ROLE|G
    return { ymd: p[0] || '', S: (p[1] || 'L').toUpperCase(), role: (p[2] || '').toUpperCase(), gReq: (p[3] || 'ANY').toUpperCase() };
  }

  baseKeys.forEach(function (bk) {
    var spec = parseBaseKey(bk);
    var feas = [];

    for (var i = 0; i < cids.length; i++) {
      var cid = cids[i];
      var pf = profiles[cid] || { role: '', gender: 'ANY' };
      var roleOK = String(pf.role || '').toUpperCase() === spec.role;
      var genderOK = spec.gReq === 'ANY' || String(pf.gender || 'ANY').toUpperCase() === spec.gReq;
      if (!roleOK || !genderOK) continue;

      var code = String((daysByCid[cid] || {})[spec.ymd] || '').toUpperCase();
      if (code === 'X' || code === 'B' || code === 'K') continue;
      if ((code === 'L' && spec.S === 'N') || (code === 'N' && spec.S === 'L')) continue;

      // Night → next-day Long Day prohibition (from any rota)
      if (_1n2ld_violation(ehByCid, cid, spec.ymd, spec.S)) continue;

      // Booked elsewhere same date via EH
      var worked = (ehByCid[cid] && ehByCid[cid].worked) ? ehByCid[cid].worked : {};
      if (worked[spec.ymd]) continue;

      feas.push(cid);
    }

    out[bk] = feas;
  });

  return out;
}

