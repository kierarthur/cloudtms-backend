// Build the same HTML used previously for per-candidate summary emails
function _buildShiftEmailHtml(candidateFullName, shiftsToSend) {
  function generateTable(shiftArray, tableTitle, color) {
    if (!shiftArray.length) return "";
    let table = `
      <h3>${tableTitle}</h3>
      <table border="1" cellpadding="5" cellspacing="0"
             style="border-collapse: collapse; width: 100%; ${color ? `color: ${color};` : ""}">
        <thead>
          <tr>
            <th>Day</th>
            <th>Date</th>
            <th>Shift Type</th>
            <th>Job Title</th>
            <th>Hospital</th>
            <th>Ward</th>
            <th>Ref No.</th>
            <th>Comments</th>
          </tr>
        </thead>
        <tbody>
    `;
    shiftArray.forEach(shift => {
      const note = (shift.note || "").toString().trim();
      const shiftType = note ? `Non standard shift – ${note}` : (shift.shift || "");
      table += `
        <tr>
          <td>${shift.day  || ''}</td>
          <td>${shift.date || ''}</td>
          <td>${shiftType}</td>
          <td>${shift.jobTitle || ''}</td>
          <td>${shift.hospital || ''}</td>
          <td>${shift.ward || ''}</td>
          <td>${shift.reference || ''}</td>
          <td>${shift.comment   || ''}</td>
        </tr>
      `;
    });
    table += `</tbody></table>`;
    return table;
  }

  const upcomingShifts  = shiftsToSend.filter(s => s.comment !== "CANCELLED");
  const cancelledShifts = shiftsToSend.filter(s => s.comment === "CANCELLED");

  let body = `
    <p>Dear ${candidateFullName},</p>
    <p>Here is a summary of your shift updates:</p>
  `;
  body += generateTable(upcomingShifts,  "Existing Bookings");
  body += generateTable(cancelledShifts, "Cancelled Shifts", "red");
  body += `
    <p><strong>PLEASE CONTACT US URGENTLY IF ANY OF THE INFORMATION APPEARS INCORRECT</strong></p>
    <p>Sussex Bookings Team</p>
    <p>Arthur Rai Medical Services</p>
  `;
  return body;
}

// Build per-PAGE WATI receiver entries exactly like newSendWATIMessages (date_1..date_8)
function _buildWATIReceiversFromDiffs(fullName, key, mobile, diffs) {
  const MAX_PER_PAGE = 7;
  if (!mobile || !Array.isArray(diffs) || !diffs.length) return { receivers: [], metaIndex: [] };

  // filter & sort as before (uses your existing helpers)
  const shifts = diffs
    .filter(d => (shouldIncludeShift(d) && shouldIncludeShift(d).result))
    .sort((a, b) => {
      const order = { NEW: 0, CX: 1, newREF: 2, BKD: 3 };
      const ca = getShiftCategory(a), cb = getShiftCategory(b);
      if (order[ca] !== order[cb]) return order[ca] - order[cb];
      const [da, ma, ya] = String(a.date || '').split("/").map(Number);
      const [db, mb, yb] = String(b.date || '').split("/").map(Number);
      return new Date(ya || 0, (ma || 1) - 1, da || 1) - new Date(yb || 0, (mb || 1) - 1, db || 1);
    });

  if (!shifts.length) return { receivers: [], metaIndex: [] };

  // bucket into four sections, but TIME CHANGE always goes into NEW
  const sections = ["NEW", "CX", "newREF", "BKD"];
  const sectionNames = {
    NEW: "New Bookings",
    CX: "Cancelled Bookings",
    newREF: "New Reference Numbers",
    BKD: "Existing Confirmed Bookings"
  };
  const bySection = {};
  sections.forEach(sec => bySection[sec] = []);
  shifts.forEach(s => {
    const cat = (s.comment === "TIME CHANGE") ? "NEW" : getShiftCategory(s);
    bySection[cat].push(s);
  });

  // flatten with headers
  const flat = [];
  sections.forEach(sec => {
    if (!bySection[sec].length) return;
    flat.push({ isHeader: true, section: sec });
    bySection[sec].forEach(s => flat.push(s));
  });

  // compute pages
  const totalPages = Math.ceil(flat.length / MAX_PER_PAGE);
  const receivers = [];
  const metaIndex = [];

  let page = 1, i = 0;
  const seenSectionOnPage = {}; // tracks "continued" labeling within a page
  while (i < flat.length) {
    const params = {
      date_1: `Page ${page} of ${totalPages}`,
      date_2: "-", date_3: "-", date_4: "-", date_5: "-",
      date_6: "-", date_7: "-", date_8: "-"
    };
    let slot = 2;

    while (slot <= 8 && i < flat.length) {
      const item = flat[i];

      if (item.isHeader) {
        let txt = sectionNames[item.section];
        if (seenSectionOnPage[item.section]) txt += " continued";
        seenSectionOnPage[item.section] = true;
        if (slot === 8) break; // keep at least one slot for a line
        params[`date_${slot}`] = _watiSanitize(txt);
        slot++; i++;
      } else {
        let shiftDesc;
        if (item.comment === "TIME CHANGE") {
          if (item.note && String(item.note).trim()) {
            shiftDesc = "TIME CHANGE " + String(item.note).trim();
          } else if (item.shift && String(item.shift).includes("Night")) {
            shiftDesc = "TIME CHANGE 1930hrs-0800hrs";
          } else {
            shiftDesc = "TIME CHANGE 0730hrs-2000hrs";
          }
        } else if (item.note) {
          shiftDesc = String(item.note);
        } else {
          shiftDesc = (item.shift && String(item.shift).includes("Night")) ? "N" : "LD";
        }

        const shortDate = String(item.date || '').split("/").slice(0, 2).join("/");
        const hospCode  = getHospitalCode(item.hospital);
        const cat       = getShiftCategory(item);
        let refValue    = item.newRef || item.reference || "";
        const refSuffix = (refValue && cat !== "CX") ? ` Ref: ${refValue}` : "";

        const line = `${cat} - ${shortDate} - ${shiftDesc} - ${hospCode} ${item.ward || ''}${refSuffix}`;
        params[`date_${slot}`] = _watiSanitize(line);
        slot++; i++;
      }
    }

    receivers.push({
      whatsappNumber: mobile,
      customParams: Object.keys(params).map(k => ({ name: k, value: params[k] }))
    });
    metaIndex.push({ key, mobile, page });
    page++;
  }

  return { receivers, metaIndex };
}

// Sanitize text for WATI parameter constraints (no newlines/tabs, limit space runs)
function _watiSanitize(s) {
  let out = String(s || '');
  out = out.replace(/[\r\n\t]+/g, ' ');
  // collapse more than 1 space to 1 (WATI also warns on long runs)
  out = out.replace(/ {2,}/g, ' ');
  // trim and cap length defensively
  if (out.length > 180) out = out.slice(0, 180);
  return out.trim();
}

// One-call email batch to Power Automate (Flow)
function _dispatchEmailsBatch(items, defaultFrom, runId) {
  const props = PropertiesService.getScriptProperties();
  const url   = props.getProperty('MULTI_EMAIL_SEND');
  if (!url) throw new Error('MULTI_EMAIL_SEND not set in Script Properties');

  const payload = {
    runId: runId || (new Date()).toISOString(),
    defaultFrom: defaultFrom || 'sussex@arthur-rai.co.uk',
    items
  };

  const resp = UrlFetchApp.fetch(url, {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });
  const code = resp.getResponseCode();
  const text = resp.getContentText() || '';
  if (code !== 200) throw new Error(`Flow HTTP ${code}: ${text.slice(0, 400)}`);
  let json;
  try { json = JSON.parse(text); } catch (e) {
    throw new Error(`Flow returned non-JSON: ${text.slice(0, 400)}`);
  }
  return json; // { runId, results: [...] }
}

