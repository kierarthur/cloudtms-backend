/**
 * Executes the full send flow using the model that was shown in the preview.
 * Shows the results dialog (HTML 3) and writes the summary sheet.
 * @param {Object} model - The same object embedded into HTML 2.
 */
function executeRotaTokenSend(model) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var tz = ss.getSpreadsheetTimeZone() || 'Etc/GMT';

  var rows = (model && Array.isArray(model.rows)) ? model.rows : [];
  var channels = model && model.channels ? model.channels : { email: false, whatsapp: false };

  // 1) Partition eligibility
  var eligibleForEmail = channels.email
    ? rows.filter(function(r){ return r.emailOk && r.tokenAvailable; })
    : [];
  var eligibleForWA = channels.whatsapp
    ? rows.filter(function(r){ return r.whatsappOk && r.tokenAvailable; })
    : [];

  // 2) Batch Email (single HTTP call)
  var emailResultsByName = {};
  if (eligibleForEmail.length) {
    try {
      var items = eligibleForEmail.map(function(r){
        return {
          to: r.email,
          subject: 'URGENT: Arthur Rai Availability and Bookings app',
          htmlBody: _buildEmailHtml_(r.firstName || '', r.tokenUrl || '')
        };
      });
      var runId = new Date().toISOString();
      var result = _dispatchEmailsBatch(items, 'sussex@arthur-rai.co.uk', runId);
      var resArr = result && Array.isArray(result.results) ? result.results : [];

      var byTo = {};
      resArr.forEach(function(it, idx){
        var to = (it && (it.to || it.email)) ? String(it.to || it.email).toLowerCase().trim() : '';
        var status = _coerceStatus_(it);
        var reason = _extractReason_(it);
        byTo[to] = { status: status, reason: reason };
        byTo['#'+idx] = { status: status, reason: reason };
      });

      eligibleForEmail.forEach(function(r, idx){
        var key = (r.email || '').toLowerCase().trim();
        var found = byTo[key] || byTo['#'+idx] || { status: 'success', reason: '' };
        emailResultsByName[r.fullName] = {
          status: found.status === 'success' ? '✓' : (found.status === 'queued' ? 'queued' : '✗'),
          error:  (found.status === 'success' || found.status === 'queued') ? '' : (found.reason || 'Email send failed')
        };
      });
    } catch (e) {
      var reason = String(e && e.message ? e.message : e);
      eligibleForEmail.forEach(function(r){
        emailResultsByName[r.fullName] = { status: '✗', error: reason };
      });
    }
  }

  // 3) WATI attribute update (mobileappurl), only when needed
  var waAttrResultsByName = {};
  var candidateListChanges = []; // [{ rowIndex, newUrl }]
  var hasWatiToken = !!(typeof WATI_TOKEN !== 'undefined' && WATI_TOKEN);

  if (eligibleForWA.length && hasWatiToken) {
    eligibleForWA.forEach(function(r){
      try {
        if (!r.phoneFormatted) {
          waAttrResultsByName[r.fullName] = { status: '✗', error: 'No WhatsApp number' };
          return;
        }
        if (!r.tokenUrl) {
          waAttrResultsByName[r.fullName] = { status: '✗', error: 'No Active Token' };
          return;
        }
        // If K already equals token, don't update WATI or sheet
        if ((r.appUrlK || '') === r.tokenUrl) {
          waAttrResultsByName[r.fullName] = { status: '✓', already: true, error: '' };
          return;
        }

        var up = _updateWatiMobileAppUrl_(r.phoneFormatted, r.tokenUrl);
        if (up.ok) {
          waAttrResultsByName[r.fullName] = { status: '✓', already: false, error: '' };
          if (r.rowIndex && r.rowIndex > 1) {
            candidateListChanges.push({ rowIndex: r.rowIndex, newUrl: r.tokenUrl });
          }
        } else {
          waAttrResultsByName[r.fullName] = { status: '✗', error: up.error || 'Failed to update WA attribute' };
        }
      } catch (e) {
        waAttrResultsByName[r.fullName] = { status: '✗', error: String(e && e.message ? e.message : e) };
      }
    });
  } else if (eligibleForWA.length && !hasWatiToken) {
    eligibleForWA.forEach(function(r){
      waAttrResultsByName[r.fullName] = { status: '✗', error: 'WATI token not configured' };
    });
  }

  // Batch write back to Candidate List Column K for changes
  if (candidateListChanges.length) {
    var sheet = ss.getSheetByName(CANDIDATE_SHEET_NAME);
    if (sheet) {
      candidateListChanges.sort(function(a,b){ return a.rowIndex - b.rowIndex; });
      var startRow = candidateListChanges[0].rowIndex;
      var endRow   = candidateListChanges[candidateListChanges.length-1].rowIndex;
      var totalRows = endRow - startRow + 1;

      var rng = sheet.getRange(startRow, COL_APPURL, totalRows, 1);
      var vals = rng.getValues();
      candidateListChanges.forEach(function(ch){
        vals[ch.rowIndex - startRow][0] = ch.newUrl;
      });
      rng.setValues(vals);
    }
  }

  // 4) WATI bulk send (template: "mobileapp2")
  var waBulkResultsByName = {};
  if (eligibleForWA.length && hasWatiToken) {
    var receivers = eligibleForWA.map(function(r){
      return {
        whatsappNumber: r.phoneFormatted,
        customParams: [{ name: 'forename', value: r.firstName || '' }]
      };
    });

    try {
      var resp = _sendWATIBulkTemplate_Generic(
        'mobileapp2',
        receivers,
        'RotaToken_' + Utilities.formatDate(new Date(), tz, 'yyyyMMdd_HHmmss'),
        tz
      );

      // Try to parse per-receiver results; fall back to queued
      var per = null;
      if (resp && resp.json && resp.json.data && Array.isArray(resp.json.data)) {
        per = resp.json.data;
      } else if (resp && resp.json && Array.isArray(resp.json.results)) {
        per = resp.json.results;
      }

      if (per && per.length) {
        var byNumber = {};
        per.forEach(function(it, idx){
          var num = String(it.whatsappNumber || it.receiver || it.to || it.phone || '').replace(/[^\d]/g,'');
          var status = _coerceStatus_(it);
          var reason = _extractReason_(it);
          byNumber[num] = { status: status, reason: reason };
          byNumber['#'+idx] = { status: status, reason: reason };
        });

        eligibleForWA.forEach(function(r, idx){
          var key = (r.phoneFormatted || '').replace(/[^\d]/g,'');
          var found = byNumber[key] || byNumber['#'+idx] || { status: 'queued', reason: '' };
          waBulkResultsByName[r.fullName] = {
            status: (found.status === 'success' ? '✓'
                    : (found.status === 'queued' ? 'queued' : '✗')),
            error:  (found.status === 'success' || found.status === 'queued') ? '' : (found.reason || 'WA send failed')
          };
        });
      } else {
        var httpOk = (resp && resp.httpCode >= 200 && resp.httpCode < 300);
        eligibleForWA.forEach(function(r){
          waBulkResultsByName[r.fullName] = httpOk
            ? { status: 'queued', error: '' }
            : { status: '✗', error: 'Bulk WA request failed: HTTP ' + (resp && resp.httpCode) };
        });
      }
    } catch (e) {
      var reason2 = String(e && e.message ? e.message : e);
      eligibleForWA.forEach(function(r){
        waBulkResultsByName[r.fullName] = { status: '✗', error: reason2 };
      });
    }
  } else if (eligibleForWA.length && !hasWatiToken) {
    eligibleForWA.forEach(function(r){
      waBulkResultsByName[r.fullName] = { status: '✗', error: 'WATI token not configured' };
    });
  }

  // 5) Build final results per candidate
  var results = rows.map(function(r){
    // Email
    var emailRes = emailResultsByName[r.fullName] || (channels.email ? (
      r.emailOk && r.tokenAvailable ? { status: 'skipped', error: '' }
                                    : { status: 'skipped', error: r.emailReason || (r.tokenAvailable ? '' : r.tokenReason || '') }
    ) : { status: 'skipped', error: '' });

    // WA attribute
    var waAttrRes = waAttrResultsByName[r.fullName] || (channels.whatsapp ? (
      r.whatsappOk && r.tokenAvailable ? { status: 'skipped', error: '' }
                                       : { status: 'skipped', error: r.whatsappReason || (r.tokenAvailable ? '' : r.tokenReason || '') }
    ) : { status: 'skipped', error: '' });

    // WA bulk
    var waBulkRes = waBulkResultsByName[r.fullName] || (channels.whatsapp ? (
      r.whatsappOk && r.tokenAvailable ? { status: 'skipped', error: '' }
                                       : { status: 'skipped', error: r.whatsappReason || (r.tokenAvailable ? '' : r.tokenReason || '') }
    ) : { status: 'skipped', error: '' });

    // Token
    var tokenAvailable = !!r.tokenAvailable;
    var tokenError = tokenAvailable ? '' : (r.tokenReason || '');

    // Normalize display statuses
    var emailStatusDisp = (emailRes.status === 'success' ? '✓'
                         : (emailRes.status === 'failed' ? '✗' : (emailRes.status || 'skipped')));
    var waAttrStatusDisp = (waAttrRes.already ? 'already up to date'
                          : (waAttrRes.status === 'success' ? '✓'
                            : (waAttrRes.status === 'failed' ? '✗' : (waAttrRes.status || 'skipped'))));
    var waBulkStatusDisp = (waBulkRes.status === 'success' ? '✓' : (waBulkRes.status || 'skipped'));

    return {
      fullName: r.fullName,
      email: r.email || '',
      whatsapp: r.phoneFormatted || '',
      tokenAvailable: tokenAvailable,
      tokenError: tokenError,

      emailStatus: emailResultsByName[r.fullName] ? emailResultsByName[r.fullName].status : emailStatusDisp,
      emailError: emailResultsByName[r.fullName] ? (emailResultsByName[r.fullName].error || '') : (emailRes.error || ''),

      waAttrStatus: waAttrResultsByName[r.fullName]
        ? (waAttrResultsByName[r.fullName].already ? 'already up to date' : (waAttrResultsByName[r.fullName].status || ''))
        : waAttrStatusDisp,
      waAttrError: waAttrResultsByName[r.fullName]
        ? (waAttrResultsByName[r.fullName].error || '')
        : (waAttrRes.error || ''),

      waBulkStatus: waBulkResultsByName[r.fullName] ? (waBulkResultsByName[r.fullName].status || '') : waBulkStatusDisp,
      waBulkError:  waBulkResultsByName[r.fullName] ? (waBulkResultsByName[r.fullName].error || '')  : (waBulkRes.error || '')
    };
  });

  // 6) Open results dialog (no summary sheet creation)
  var t = HtmlService.createTemplateFromFile('RotaTokenResults');
  t.results = results;
  var html = t.evaluate().setWidth(1100).setHeight(760);
  SpreadsheetApp.getUi().showModalDialog(html, 'Rota Token — Results');
}


/** ===== PREVIEW MODEL BUILDER ===== */

/**
 * Reads Candidate List + Availability Links ONCE and prepares a preview model.
 * @param {string[]} recipients
 * @param {{email:boolean, whatsapp:boolean}} channels
 */
function _buildPreviewModel_(recipients, channels) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();

  // Read Candidate List once
  var clSheet = ss.getSheetByName(CANDIDATE_SHEET_NAME);
  if (!clSheet) throw new Error('Candidate List sheet not found');

  var clRange = clSheet.getDataRange();
  var clValues = clRange.getValues(); // 2D array
  if (clValues.length < 2) {
    return { channels: channels, rows: [], recipients: recipients || [] };
  }

  // Build maps from Candidate List
  var head = clValues[0] || [];
  var rows = clValues.slice(1); // skip header

  var mapByFull_1 = {}; // "firstname surname"
  var mapByFull_2 = {}; // "surname firstname"
  var mapKey = {};      // "surname|firstname"
  var allPeople = [];   // keep array of all for fallback (not used heavily)

  for (var i = 0; i < rows.length; i++) {
    var r = rows[i];
    var surname = _safeStr_(r[COL_SURNAME - 1]);
    var firstname = _safeStr_(r[COL_FIRST   - 1]);
    var email = _safeStr_(r[COL_EMAIL   - 1]);
    var phone = _safeStr_(r[COL_PHONE   - 1]);
    var appUrl = _safeStr_(r[COL_APPURL  - 1]);
    var rowIndex = i + 2; // +2 because header at row 1

    var full1 = _normName_(firstname + ' ' + surname);
    var full2 = _normName_(surname + ' ' + firstname);
    var key   = _normKey_(surname, firstname);

    var obj = {
      firstName: firstname,
      surname: surname,
      email: email,
      phoneRaw: phone,
      appUrlK: appUrl,
      rowIndex: rowIndex,
      fullName: firstname && surname ? (firstname + ' ' + surname) : (firstname || surname || '')
    };

    if (full1) mapByFull_1[full1] = obj;
    if (full2) mapByFull_2[full2] = obj;
    if (key)   mapKey[key] = obj;
    allPeople.push(obj);
  }

  // Read Availability API Links once
  var availSS = SpreadsheetApp.openById(AVAIL_SPREADSHEET_ID);
  var availSheet = availSS.getSheetByName(AVAIL_SHEET_NAME);
  if (!availSheet) throw new Error('Availability API Links sheet not found');

  var avRange = availSheet.getDataRange();
  var avValues = avRange.getValues();
  var avRows = avValues.slice(1); // skip header

  var tokensByKey = {}; // key -> array of { tokenUrl, status, createdAt }
  for (var j = 0; j < avRows.length; j++) {
    var ar = avRows[j];
    var aSur = _safeStr_(ar[A_COL_SURNAME - 1]);
    var aFir = _safeStr_(ar[A_COL_FIRST   - 1]);
    var aUrl = _safeStr_(ar[A_COL_TOKENURL- 1]);
    var aSta = _safeStr_(ar[A_COL_STATUS  - 1]);
    var aCat = _safeStr_(ar[A_COL_CREATEDAT-1]);
    var key2 = _normKey_(aSur, aFir);
    var createdAt = aCat ? new Date(aCat) : null;

    if (!key2) continue;
    if (!tokensByKey[key2]) tokensByKey[key2] = [];
    tokensByKey[key2].push({ tokenUrl: aUrl, status: aSta, createdAt: createdAt });
  }

  // Build rows for preview based on recipients
  var outRows = [];
  (recipients || []).forEach(function(name){
    var norm = _normName_(name);
    var person = mapByFull_1[norm] || mapByFull_2[norm] || null;

    var firstName = person ? person.firstName : '';
    var surname   = person ? person.surname   : '';
    var email     = person ? person.email     : '';
    var phoneRaw  = person ? person.phoneRaw  : '';
    var appUrlK   = person ? person.appUrlK   : '';
    var rowIndex  = person ? person.rowIndex  : null;
    var fullName  = person ? (person.fullName || name) : name;

    // Normalize phone for WA
    var phoneFormatted = _normalizeUkPhoneForWati_(phoneRaw);

    // Resolve token
    var key = _normKey_(surname, firstName);
    var tk = _resolveActiveToken_(tokensByKey[key]);

    var tokenAvailable = !!(tk && tk.tokenUrl);
    var tokenUrl   = tk && tk.tokenUrl ? tk.tokenUrl : '';
    var tokenReason= tokenAvailable ? '' : (tk && tk.reason ? tk.reason : 'No Active Token issued for candidate');

    // Channel feasibilities + reasons
    var emailOk = !!(channels && channels.email && email);
    var emailReason = (!channels || !channels.email) ? '' : (email ? '' : 'No email found');

    var whatsappOk = !!(channels && channels.whatsapp && phoneFormatted);
    var whatsappReason = (!channels || !channels.whatsapp) ? '' : (phoneFormatted ? '' : 'No WhatsApp number');

    outRows.push({
      fullName: fullName,
      firstName: firstName,
      surname: surname,
      email: email,
      phoneRaw: phoneRaw,
      phoneFormatted: phoneFormatted,
      appUrlK: appUrlK,
      rowIndex: rowIndex,

      tokenAvailable: tokenAvailable,
      tokenUrl: tokenUrl,
      tokenReason: tokenReason,

      emailOk: emailOk,
      emailReason: emailReason,

      whatsappOk: whatsappOk,
      whatsappReason: whatsappReason
    });
  });

  return {
    channels: channels || { email:false, whatsapp:false },
    rows: outRows,
    recipients: recipients || []
  };
}

/** ===== HELPERS ===== */

/**
 * Builds the personalized HTML email body for a recipient.
 * Formatting rules per requirements: bold/underline on headings; bold labels/line.
 */
function _buildEmailHtml_(firstName, webappUrl) {
  var fn  = _escapeHtml_(firstName || '');
  var url = _escapeAttr_(webappUrl || '');

  // ---- Read from Script Properties (project-level) ----
  var props = PropertiesService.getScriptProperties();
  var tmpl = props.getProperty('WELCOME_TO_APP_HTML') || '';

  // Final guard: if still empty, use a minimal default so nothing breaks
  if (!tmpl) {
    tmpl =
      '<div style="font-family:Arial,Helvetica,sans-serif; line-height:1.45; font-size:14px; color:#111;">' +
      '<p>Dear {{firstName}},</p>' +
      '<p>Welcome. Your unique link is: <a href="{{webappUrlHref}}" target="_blank" rel="noopener">{{webappUrl}}</a></p>' +
      '</div>';
  }

  // Token replacement (escaped)
  tmpl = tmpl.replace(/\{\{\s*firstName\s*\}\}/gi, fn);
  tmpl = tmpl.replace(/\{\{\s*webappUrl\s*\}\}/gi, _escapeHtml_(webappUrl || ''));
  tmpl = tmpl.replace(/\{\{\s*webappUrlHref\s*\}\}/gi, url);

  return tmpl;
}


/**
 * Update WATI contact attribute "mobileappurl" for a single number.
 * @param {string} phone44 - e.g., "447545970472"
 * @param {string} urlValue
 * @return {{ok:boolean, error?:string}}
 */
function _updateWatiMobileAppUrl_(phone44, urlValue) {
  if (!WATI_TOKEN) return { ok:false, error:'WATI token not configured' };
  var tenantPath = '601205';
  var url = 'https://eu-api.wati.io/' + tenantPath + '/api/v1/updateContactAttributes/' + encodeURIComponent(phone44);

  var payloadObj = {
    customParams: [
      { name: 'mobileappurl', value: String(urlValue || '') }
    ]
  };

  var resp = UrlFetchApp.fetch(url, {
    method: 'post',
    contentType: 'application/json',
    headers: { Authorization: WATI_TOKEN },
    payload: JSON.stringify(payloadObj),
    muteHttpExceptions: true
  });

  var code = resp.getResponseCode();
  var text = resp.getContentText() || '';
  var json = null;
  try { json = JSON.parse(text); } catch (_) {}

  if (code >= 200 && code < 300) {
    return { ok:true };
  }
  return { ok:false, error: 'HTTP ' + code + ': ' + text.slice(0, 300) };
}

/**
 * Send WATI bulk template messages.
 * @param {string} templateName  e.g. "mobileapp2"
 * @param {Array<{whatsappNumber:string, customParams:Array<{name:string,value:string}>}>} receivers
 * @param {string} broadcastName
 * @param {string} tz
 * @return {{httpCode:number, json?:Object, rawText:string}}
 */
function _sendWATIBulkTemplate_Generic(templateName, receivers, broadcastName, tz) {
  if (!WATI_TOKEN) throw new Error('WATI token not configured');
  var tenant = '601205';
  var url = 'https://eu-api.wati.io/' + tenant + '/api/v2/sendTemplateMessages';

  var payload = {
    template_namespace: (typeof WATI_TEMPLATE_NAMESPACE !== 'undefined' && WATI_TEMPLATE_NAMESPACE)
      ? WATI_TEMPLATE_NAMESPACE
      : 'your_template_namespace_here',
    template_name: templateName,
    broadcast_name: broadcastName || ('RotaToken_' + Utilities.formatDate(new Date(), tz || Session.getScriptTimeZone() || 'Etc/GMT', 'yyyyMMdd_HHmmss')),
    receivers: receivers
  };

  var resp = UrlFetchApp.fetch(url, {
    method: 'post',
    contentType: 'application/json',
    headers: { Authorization: WATI_TOKEN },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });

  var httpCode = resp.getResponseCode();
  var rawText = resp.getContentText() || '';
  var json = null;
  try { json = JSON.parse(rawText); } catch (_) {}
  return { httpCode: httpCode, json: json, rawText: rawText };
}

/**
 * One-call batch email sender. If you already have this elsewhere, remove this duplicate.
 * Expects Script Property MULTI_EMAIL_SEND to point to your Flow/endpoint.
 * Payload: { runId, defaultFrom, items:[{ to, subject, htmlBody }] }
 */
function _dispatchEmailsBatch(items, defaultFrom, runId) {
  var props = PropertiesService.getScriptProperties();
  var url   = props.getProperty('MULTI_EMAIL_SEND');
  if (!url) throw new Error('MULTI_EMAIL_SEND not set in Script Properties');

  var payload = {
    runId: runId || (new Date()).toISOString(),
    defaultFrom: defaultFrom || 'sussex@arthur-rai.co.uk',
    items: items || []
  };

  var resp = UrlFetchApp.fetch(url, {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });
  var code = resp.getResponseCode();
  var text = resp.getContentText() || '';
  if (code !== 200) throw new Error('Flow HTTP ' + code + ': ' + text.slice(0, 400));
  var json;
  try { json = JSON.parse(text); } catch (e) {
    throw new Error('Flow returned non-JSON: ' + text.slice(0, 400));
  }
  return json; // { runId, results:[...] }
}

