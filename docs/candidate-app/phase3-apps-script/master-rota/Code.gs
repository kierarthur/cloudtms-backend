    if (p.action === 'CURRENTBOOKINGS') {
      try { processCurrentBookingsRequest(p.phone); _safeLog('CURRENTBOOKINGS', 'Processed', "phone=" + p.phone, p); }
      catch (ex7) { _safeLog('CURRENTBOOKINGS', 'Error', String(ex7), p); }
      return _retOK('CURRENTBOOKINGS', '');
    }

    if (p.action === 'WATI_OUTBOUND') {
      var phoneOB = _normPhoneUK((p.phone || p.whatsappNumber || '').toString().trim());
      var okOB = phoneOB && (_phoneInCandidateList(phoneOB) || _phoneInCandidateList(_convertTo44(phoneOB)));
      _safeLog('WATI_OUTBOUND_GATE', okOB ? 'CandidateOK' : 'Ignored', "phone=" + phoneOB, p);
      if (!okOB) return _retOK('WATI_OUTBOUND_IGNORED', '');

      var text = (p.message || '').toString();
      var tsOB   = p.ts ? new Date(p.ts) : new Date();
      var fromOrigin = String(p.origin || p.source || '').toLowerCase();
      var templateName = (p.template_name || p.templateName || '').toString();

      // NEW: enqueue outbound command for worker; worker will do template-recording or handoff logic
      _enqueueWatiOutbound({
        phone: phoneOB,
        message: text,
        templateName: templateName || '',
        origin: fromOrigin || 'appscript',
        ts: tsOB.toISOString()
      });
      _safeLog('WATI_OUTBOUND', 'Enqueued', templateName ? 'template deferred' : 'session deferred', { phone: phoneOB });
      return _retOK(templateName ? 'WATI_OUTBOUND_TEMPLATE_ENQUEUED' : 'WATI_OUTBOUND_ENQUEUED', '');
    }

    if (p.action === 'WATI_INBOUND') {
      var rawPhone = (p.phone || p.whatsappNumber || p.waId || '').toString().trim();
      var phoneIN = _normPhoneUK(rawPhone);
      var okIN = phoneIN && (_phoneInCandidateList(phoneIN) || _phoneInCandidateList(_convertTo44(phoneIN)));
      _safeLog('WATI_INBOUND_GATE', okIN ? 'CandidateOK' : 'Ignored', "raw=" + rawPhone + " norm=" + phoneIN, p);
      if (!okIN) return _retOK('WATI_INBOUND_IGNORED', '');

      var payload = Object.assign({}, p, {
        phone: phoneIN,
        phone44: _convertTo44(phoneIN),
        origin: 'wati',
        source: 'wati'
      });

      // NEW: enqueue inbound for worker instead of processing inline
      _enqueueWatiInbound({
        phone: payload.phone,
        message: String(payload.message || payload.text || ''),
        fromMe: !!payload.fromMe,
        ts: (payload.ts ? new Date(payload.ts) : new Date()).toISOString()
      });
      _safeLog('WATI_INBOUND', 'Enqueued', 'ai_handleWatiInbound deferred', payload);
      return _retOK('WATI_INBOUND_ENQUEUED', '');
    }

    // ---- Legacy sheet branch (only if not returned already) ----
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName(p.webhooksheet);
    if (!sheet) {
      _safeLog('Legacy', 'SheetNotFound', String(p.webhooksheet), p);
      return _retOK('LEGACY_SHEET_MISSING', '');
    }

    var hdrs = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0];
    var phoneCol = hdrs.indexOf('Phone') + 1;
    var phones = sheet.getRange(2, phoneCol, sheet.getLastRow() - 1).getDisplayValues().flat();

    var tr = phones.findIndex(function(r){ return String(r) === String(p.phone); }) + 2;
    if (tr < 2) {
      _safeLog('Legacy', 'PhoneNotInSheet', String(p.phone), p);
      return _retOK('LEGACY_PHONE_MISSING', '');
    }

    function mapField(key, matchFn) {
      if (p[key] != null) {
        var ci = hdrs.findIndex(function(h){ return matchFn(h); }) + 1;
        if (ci > 0) {
          var resp  = String(p[key]);
          var color = /^yes/i.test(resp) ? COLOR_AVAILABLE : COLOR_UNAVAIL;
          sheet.getRange(tr, ci).setBackground(color);
          _safeLog('LegacyMap', key, "resp=" + resp + " ci=" + ci, p);
        }
      }
    }

    if (p.action === 'immediateavailability') mapField('rightnow', function(h){ return h === 'Can leave now'; });
    mapField('tonight',         function(h){ return h.startsWith('Tonight'); });
    mapField('tomorrowld',      function(h){ return h.startsWith('Tomorrow LD'); });
    mapField('tomorrownight',   function(h){ return h.startsWith('Tomorrow NT'); });
    mapField('dayafterlongday', function(h){ return h.startsWith('DAT-LD'); });
    mapField('otheravailability', function(h){ return h === 'Next Seven Days'; });

    sortEmergencySheet(sheet);
    return _retOK('LEGACY_DONE', '');

  } catch (err) {
    // Early exit path for runner callbacks (preserves 200 + tag)
    if (err && err.__runnerHandled) {
      return _retOK(err.where, '');
    }

    var elapsedAll = (Date.now() - __startMs) + "ms";
    _safeLog('WebhookError', 'Exception', String(err && err.message || err) + " | elapsed=" + elapsedAll, null);
    return ContentService
      .createTextOutput(JSON.stringify({ status: "success", message: "Webhook received successfully." }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}



function _safeLog(event, reason, note, payload) {
  try {
    const props = PropertiesService.getScriptProperties();
    const key = "LOG_BUFFER";
    const raw = props.getProperty(key);
    const buf = raw ? JSON.parse(raw) : [];

    const entry = [
      new Date().toISOString(),
      event || '',
      reason || '',
      (payload && (payload.phone || payload.waId)) || '',
      (note || '').slice(0, 500)
    ];
    buf.push(entry);

    // prevent unbounded growth
    while (buf.length > 500) buf.shift();

    props.setProperty(key, JSON.stringify(buf));
  } catch (e) {
    console.error("safeLog error", e);
  }
}

function _enqueueWatiInbound(item) {
  _enqueueJson_('WATI_INBOUND_Q', item, 500);
}
function _enqueueWatiOutbound(item) {
  _enqueueJson_('WATI_OUTBOUND_Q', item, 500);
}
function _drainWatiInboundQueue() {
  const items = _dequeueAllJson_('WATI_INBOUND_Q');
  if (!items || !items.length) return;
  items.forEach(it => {
    try {
      ai_handleWatiInbound(it);
    } catch (e) {
      _safeLog('InboundQueue', 'ProcessError', String(e), { phone: (it && it.phone) || '' });
    }
  });
}
function _drainWatiOutboundQueue() {
  const items = _dequeueAllJson_('WATI_OUTBOUND_Q');
  if (!items || !items.length) return;
  items.forEach(it => {
    try {
      _processWatiOutboundCmd_(it);
    } catch (e) {
      _safeLog('OutboundQueue', 'ProcessError', String(e), { phone: (it && it.phone) || '' });
    }
  });
}

// generic, capped enqueue with script lock
function _enqueueJson_(key, obj, cap) {
  const lock = LockService.getScriptLock();
  lock.tryLock(3000);
  try {
    const props = PropertiesService.getScriptProperties();
    const raw = props.getProperty(key);
    let q = raw ? JSON.parse(raw) : [];
    q.push(obj);
    if (cap && q.length > cap) q = q.slice(q.length - cap);
    props.setProperty(key, JSON.stringify(q));
  } finally {
    try { lock.releaseLock(); } catch(_) {}
  }
}

// atomic drain (returns array; clears property)
function _dequeueAllJson_(key) {
  const lock = LockService.getScriptLock();
  lock.tryLock(3000);
  try {
    const props = PropertiesService.getScriptProperties();
    const raw = props.getProperty(key);
    if (!raw) return [];
    props.deleteProperty(key);
    const arr = JSON.parse(raw);
    return Array.isArray(arr) ? arr : [];
  } finally {
    try { lock.releaseLock(); } catch(_) {}
  }
}

// worker-side heavy logic for outbound commands (template or session)
function _processWatiOutboundCmd_(cmd) {
  if (!cmd || !cmd.phone) return;
  const phoneOB = _normPhoneUK(String(cmd.phone || ''));
  const text = String(cmd.message || '');
  const templateName = String(cmd.templateName || '');
  const tsOB = cmd.ts ? new Date(cmd.ts) : new Date();
  const fromOrigin = String(cmd.origin || '').toLowerCase();

  if (!phoneOB) return;

  if (templateName && templateName === S().TEMPLATE_NAME) {
    try {
      const existing = _conversationsFindActiveAvailability(phoneOB);
      const kind = 'template';
      if (existing) {
        _conversationsUpsert({
          Phone: phoneOB, ConversationID: existing.ConversationID,
          InitiatedBy: 'BOT', TemplateSent: true, LastStartKind: kind,
          LastStartTs: tsOB, LastBotMessageTs: tsOB, Origin: 'wati',
          TTLExpiry: new Date(Date.now() + S().CONVO_TTL_MIN * 60000),
          Status: 'Open'
        });
      } else {
        _conversationsUpsert({
          Phone: phoneOB, ConversationID: _newConvoId(),
          Summary: 'Availability template sent (WATI).',
          LastInteractionsJSON: JSON.stringify([{ from: 'bot', msg: "[template: " + S().TEMPLATE_NAME + "]", ts: tsOB.toISOString() }]),
          LastUpdated: tsOB, InitiatedBy: 'BOT',
          TTLExpiry: new Date(Date.now() + S().CONVO_TTL_MIN * 60000),
          LastBotMessageTs: tsOB, Origin: 'wati',
          TemplateSent: true, LastStartTs: tsOB, LastStartKind: kind,
          Flow: 'availability', PendingConfirmJSON: '', Status: 'Open'
        });
      }
      _safeLog('WATI_OUTBOUND', 'TemplateRecorded', "phone=" + phoneOB);
    } catch (ex8) { _safeLog('WATI_OUTBOUND', 'TemplateError', String(ex8), { phone: phoneOB }); }
    return;
  }

  // Session / manual outbound path (handoff + quiet scheduling)
  if (fromOrigin !== 'appscript') {
    try {
      _pauseAvailabilityAndOpenHandoff(phoneOB, text, tsOB);
      const convOB = _conversationsFindMostRecentAny(phoneOB);
      if (convOB) {
        const quietMsOB = new Date(convOB.QuietUntil).getTime() - tsOB.getTime();
        const whenOB = _computeFireTime(Math.max(quietMsOB, 0), 'QuietWindow');
        _setPendingFollowup(phoneOB, '__QUIET_CONTINUE__', whenOB.testAt, 'QuietWindow', 'pause->continue');
        _safeLog('Scheduled', 'QuietWindow',
                 "convoId=" + (convOB.ConversationID || '') +
                 " realHuman=" + (whenOB.realHuman || '') +
                 " testDelaySec=" + (whenOB.testDelaySec || '') +
                 " realAt=" + (whenOB.realAt || '') +
                 " testAt=" + (whenOB.testAt || ''),
                 { phone: phoneOB });
      }
      _safeLog('WATI_OUTBOUND', 'Paused+Scheduled', "phone=" + phoneOB);
    } catch (ex9) { _safeLog('WATI_OUTBOUND', 'HandoffError', String(ex9), { phone: phoneOB }); }
  }
}
/** =======================
 *  6) CONVERSATION PROCESSOR
 *  ======================= */
function ai_processConversation(phone) {
  // Hard block: do not talk to AI-opt-out numbers
  if (_isAiOptOut(phone)) return;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const av = ss.getSheetByName(SH_AVAIL); if (!av) return;

  const conv = _conversationsFindActiveAvailability(phone);
  if (!conv) return;

  // Respect paused/quiet
  if (conv.Status==='Paused') return;
  if (conv.QuietUntil && new Date(conv.QuietUntil) > new Date()) return;

  // Only bot-led and TTL valid
  if (conv.InitiatedBy !== 'BOT') return;
  if (new Date(conv.TTLExpiry) < new Date()) return;

  // pull candidate row & date matrix
  const rowIdx = _findAvailRowByPhone(av, phone);
  if (rowIdx < 0) return;

  const lastCol = av.getLastColumn();
  const dateHdrs = av.getRange(1,7,1,lastCol-6).getDisplayValues()[0];
  const vals = av.getRange(rowIdx,7,1,lastCol-6).getDisplayValues()[0];
  const bgs  = av.getRange(rowIdx,7,1,lastCol-6).getBackgrounds()[0];
  const tz = ss.getSpreadsheetTimeZone();

  // Build lists
  const booked = [], blockedSystem = [], available = [], unavailable = [], open = [];
  for (let c = 0; c < dateHdrs.length; c++) {
    const dStr = dateHdrs[c];
    const d = _parseDDMMYYYY(dStr);
    const day = d ? Utilities.formatDate(d, tz, 'EEE d MMM') : dStr;
    const v = (vals[c]||'').toUpperCase();
    const bg = bgs[c];

    if (bg === COLOR_BOOKED && (v==='LD'||v==='N')) booked.push({date:dStr, day, shift:v});
    else if (v==='BLOCKED' && bg===COLOR_BLOCKED) { /* omit */ }
    else if (!v && bg===COLOR_UNAVAIL) { unavailable.push({date:dStr, day}); }
    else if (['LD','N','LD/N','LD+N'].includes(v) && bg===COLOR_AVAILABLE) {
      available.push({date:dStr, day, shift: (v==='LD+N'?'LD/N':v)});
    } else if (!v && bg==='#ffffff') {
      open.push({date:dStr, day});
    }
  }

  // Choose up to settings-limited open dates to ask about
  const askOpen = open.slice(0, S().MAX_DATES_PER_MSG);
  const remaining = open.slice(S().MAX_DATES_PER_MSG);

  // DeepSeek payload
  const candidate = {
    surname: av.getRange(rowIdx,1).getDisplayValue(),
    firstName: av.getRange(rowIdx,2).getDisplayValue(),
    email: av.getRange(rowIdx,3).getDisplayValue(),
    phone: phone,
    jobTitle: av.getRange(rowIdx,5).getDisplayValue(),
    gender: av.getRange(rowIdx,6).getDisplayValue()
  };
  const lastTurns = JSON.parse(conv.LastInteractionsJSON||'[]');
  const kbAnswer = kb_matchLatestByTriggers(lastTurns);
  let kbNote = '';
  if (kbAnswer) kbNote = `\n\nFYI: ${kbAnswer}`;

  const systemPrompt = [
    'You are a rota assistant collecting and confirming availability.',
    'Rules:',
    '- Speak in terms of “availability updates”: say “you’re available for…” and “could you work…”.',
    '- Never imply booking or confirming a shift. Only refer to booked shifts when reading blue cells from the rota.',
    '- Use day+date when asking (e.g., "Sat 16 Aug").',
    `- Ask about at most ${S().MAX_DATES_PER_MSG} open dates per message.`,
    '- Accept LD, N, LD/N. If vague, ask a short targeted question.',
    '- If the user says "all", interpret as the set of dates you just listed; ask them to double-check their diary and reconfirm before writing.',
    '- Never overwrite booked (blue).',
    '- Do not ask about unavailable (red) or blocked system days.',
    '- If they change availability to unavailable, set cell background RED and clear text.',
    '- If they add/change availability, set GREEN with LD/N/LD-N.',
    '- Skip LD if previous day is a booked Night.',
    '- Enforce 6-day rule: if adding would make 7-in-a-row counting booked days, mark GREEN "BLOCKED" instead and explain.',
    '- Always end with a concise summary of Booked (from rota), Available (could work), and Unavailable for the next 14 days.',
    'Output strictly JSON with keys:',
    '{ "assistant_reply": "...",',
    '  "availability": [{"date":"DD/MM/YYYY","shift":"LD|N|LD/N"}],',
    '  "unavailable": ["DD/MM/YYYY", ...],',
    '  "needs_confirmation": false,',
    '  "asked_dates": ["DD/MM/YYYY", ...],',
    '  "wrap_up": false,',
    '  "summary": "≤700 chars" }'
  ].join('\n');

  const userPayload = {
    candidate,
    lastTurns,
    lastSummary: (conv.Summary||'').slice(0, S().SUMMARY_MAX_CHARS),
    booked, blockedSystem, available, unavailable,
    askOpen, remainingOpen: remaining
  };

  const ds = _deepseekJSON(systemPrompt, JSON.stringify(userPayload));

  // KB path (start request if needed)
  const latestNurseMsg = _lastNurseText(lastTurns);
  if (!kbAnswer && _looksLikeKB(latestNurseMsg)) {
    kb_startRequest(latestNurseMsg, phone);
  }

  if (ds) {
    // apply unavailable
    (ds.unavailable||[]).forEach(dStr => _setUnavailable(av, rowIdx, dateHdrs, dStr));

    // apply availability with safeguards
    const conflicts = { booked: [], nightAdj: [], ruleBlocked: [] };
    (ds.availability||[]).forEach(a => {
      const dStr = (a.date||'').trim(); let shift = (a.shift||'').toUpperCase();
      if (!dStr || !shift) return;
      if (shift==='LD+N') shift='LD/N';
      _writeAvailabilitySafely(av, rowIdx, dateHdrs, dStr, shift, conflicts);
    });

    // Build reply — availability framing
    let assistantMsg = (ds.assistant_reply||'').trim();
    const notes = [];
    if (conflicts.booked.length)    notes.push(`Already booked (from rota): ${_fmtShortDateList(conflicts.booked)} — ignored.`);
    if (conflicts.nightAdj.length)  notes.push(`LD after a booked Night (previous day): ${_fmtShortDateList(conflicts.nightAdj)} — ignored.`);
    if (conflicts.ruleBlocked.length) notes.push(`Would give 7 shifts in a row: ${_fmtShortDateList(conflicts.ruleBlocked)} — marked as BLOCKED.`);
    if (notes.length) assistantMsg += `\n\n${notes.map(n=>'• '+n).join('\n')}`;
    if (kbNote) assistantMsg += kbNote;

    assistantMsg = `Availability update:\n\n${assistantMsg}`;

    // Send or simulate reply (suppressed if kill-switch is on)
    _sendOrSimulate(phone, assistantMsg, { 'forename': candidate.firstName || 'there' });

    // Rolling summary + wrap-up
    const updTurns = JSON.parse(conv.LastInteractionsJSON||'[]');
    updTurns.push({from:'bot', msg:assistantMsg, ts:new Date().toISOString()});
    while (updTurns.length > S().MAX_TURNS_TO_KEEP) updTurns.shift();
    _conversationsUpsert({ Phone: phone, ConversationID: conv.ConversationID, LastInteractionsJSON: JSON.stringify(updTurns), LastUpdated: new Date(), LastBotMessageTs: new Date() });

    if (ds.summary) {
      _conversationsUpsert({ Phone: phone, ConversationID: conv.ConversationID, Summary: String(ds.summary).slice(0, S().SUMMARY_MAX_CHARS), TTLExpiry: new Date(Date.now()+S().CONVO_TTL_MIN*60000) });
    }

    if (ds.wrap_up || _allAccounted(av, rowIdx, dateHdrs)) {
      const summaryMsg = _buildFinalSummary(av, rowIdx, dateHdrs);
      _sendOrSimulate(phone, summaryMsg, { 'forename': candidate.firstName || 'there' });

      const t2 = JSON.parse(conv.LastInteractionsJSON||'[]'); t2.push({from:'bot', msg:summaryMsg, ts:new Date().toISOString()});
      while (t2.length > S().MAX_TURNS_TO_KEEP) t2.shift();
      _conversationsUpsert({ Phone: phone, ConversationID: conv.ConversationID, LastInteractionsJSON: JSON.stringify(t2), LastUpdated: new Date(), Status: 'Closed' });
    }
  }
}

/** =======================
 *  6b) CONTINUE AFTER QUIET + ASK NEXT QUESTION
 *  ======================= */
function _continueAndAskNext(phone){
  // Hard block: do not talk to AI-opt-out numbers
  if (_isAiOptOut(phone)) return;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const av = ss.getSheetByName(SH_AVAIL); if (!av) return;
  const rowIdx = _findAvailRowByPhone(av, phone); if (rowIdx<0) return;

  const conv = _conversationsFindActiveAvailability(phone);
  if (!conv) return;

  // If still paused or quiet, skip
  if (conv.Status==='Paused') return;
  if (conv.QuietUntil && new Date(conv.QuietUntil) > new Date()) return;

  const firstName = ss.getSheetByName(SH_AVAIL).getRange(rowIdx,2).getDisplayValue() || 'there';

  // Build next N open dates prompt
  const lastCol = av.getLastColumn();
  const dateHdrs = av.getRange(1,7,1,lastCol-6).getDisplayValues()[0];
  const vals = av.getRange(rowIdx,7,1,lastCol-6).getDisplayValues()[0];
  const bgs  = av.getRange(rowIdx,7,1,lastCol-6).getBackgrounds()[0];

  const open = [];
  for (let c = 0; c < dateHdrs.length; c++) {
    const val = (vals[c]||'').toString();
    const bg  = bgs[c];
    if (!val && bg !== COLOR_BOOKED) {
      const cell = av.getRange(rowIdx, 7+c);
      if (cell.getDisplayValue().toUpperCase() === 'BLOCKED' && cell.getBackground() === COLOR_BLOCKED) continue;
      if (cell.getBackground() === COLOR_UNAVAIL) continue;
      open.push(dateHdrs[c]);
    }
    if (open.length >= S().MAX_DATES_PER_MSG) break;
  }

  const tz = ss.getSpreadsheetTimeZone();
  const fmt = dStr => { const d=_parseDDMMYYYY(dStr); return d?Utilities.formatDate(d,tz,'EEE d MMM'):dStr; };
  const list = open.map(fmt).join(', ');

  const preface = `Okay, I’ll continue with your availability update. Type STOP any time to cancel.`;
  const question = open.length
    ? `Which of these dates could you work if shifts become available: ${list}? (LD, N, or LD/N)`
    : `I don’t see any open dates in the next ${S().WINDOW_DAYS} days. If anything changes, let me know.`;

  const msg = `${preface}\n\n${question}`;
  _sendOrSimulate(phone, msg, { 'forename': firstName });

  const turns = JSON.parse(conv.LastInteractionsJSON||'[]');
  turns.push({from:'bot', msg, ts:new Date().toISOString()});
  while (turns.length > S().MAX_TURNS_TO_KEEP) turns.shift();

  _conversationsUpsert({
    Phone: phone, ConversationID: conv.ConversationID,
    LastInteractionsJSON: JSON.stringify(turns),
    LastUpdated: new Date(),
    LastBotMessageTs: new Date(),
    Status: 'Open',
    TTLExpiry: new Date(Date.now()+S().CONVO_TTL_MIN*60000)
  });
}

/** =======================
 *  7) WATI SEND HELPERS (with test-mode simulation + kill-switch gate + AI opt-out)
 *  ======================= */
// --- helpers (safe to add once) ---------------------------------------------

// Return last-10-digit "keys" from Script Property TEST_REAL_WHITELIST
// or fall back to the hard-coded default array.
const TEST_REAL_WHITELIST_DEFAULT = ['7545970472']; // Kier

function _digitsOnly__(s){ return String(s||'').replace(/\D+/g,''); }
function _last10__(s){ const d=_digitsOnly__(s); return d ? d.slice(-10) : ''; }

function _getTestWhitelistKeys_() {
  try {
    const prop = PropertiesService.getScriptProperties().getProperty('TEST_REAL_WHITELIST') || '';
    const listed = prop.split(',').map(x => _last10__(x)).filter(Boolean);
    const fallback = TEST_REAL_WHITELIST_DEFAULT.map(_last10__).filter(Boolean);
    return (listed.length ? listed : fallback);
  } catch (_) {
    return TEST_REAL_WHITELIST_DEFAULT.map(_last10__).filter(Boolean);
  }
}

function _isWhitelistedForReal_(phone){
  const key = _last10__(phone);
  return key && _getTestWhitelistKeys_().includes(key);
}

// --- main send/simulate decision --------------------------------------------

function _sendOrSimulate(phone, text, templateParams){
  // AI Opt-out: block ALL sends/simulations
  if (_isAiOptOut(phone)) {
    return 'optout';
  }

  // Kill switch: block when comms are disabled
  if (typeof _isCommsEnabled === 'function' ? !_isCommsEnabled() : _isKillSwitchOn && _isKillSwitchOn()) {
    return 'blocked';
  }

  const isTest = (typeof _isTestMode === 'function') ? _isTestMode() : false;
  const allowRealInTest = _isWhitelistedForReal_(phone);

  if (isTest && !allowRealInTest) {
    // Simulate for non-whitelisted numbers in test mode
    const conv = _conversationsFindMostRecentAny(phone);
    const convoId = conv ? conv.ConversationID : _newConvoId();

    let turns = [];
    try { turns = conv ? JSON.parse(conv.LastInteractionsJSON || '[]') : []; } catch(_) {}
    turns.push({ from:'bot(simulated)', msg:String(text||''), ts:new Date().toISOString() });
    while (turns.length > (S().MAX_TURNS_TO_KEEP || 50)) turns.shift();

    _conversationsUpsert({
      Phone: phone,
      ConversationID: convoId,
      LastInteractionsJSON: JSON.stringify(turns),
      LastUpdated: new Date(),
      LastBotMessageTs: new Date(),
      Flow: (conv && conv.Flow) || 'availability',
      Status: (conv && conv.Status) || 'Open',
      TTLExpiry: new Date(Date.now() + (S().CONVO_TTL_MIN || 60) * 60000)
    });

    _logSchedule('Fired','SimulatedSend', phone, convoId, '', 0, new Date(), new Date(), String(text||'').slice(0,200));
    return 'simulated';
  }

  // Real send path (prod mode OR whitelisted in test mode)
  const res = _watiSendSessionOrTemplate(phone, text, templateParams);
  _logSchedule('Fired','RealSend', phone, '', '', '', '', '', String(text||'').slice(0,200));
  return res || 'sent';
}
/**
 * Convert any UK-ish phone into 44-prefixed (no plus).
 * - Strips non-digits
 * - Removes leading zeros
 * - If it doesn’t start with 44, prefixes 44
 * Examples:
 *   "07545970472"   -> "447545970472"
 *   "7545970472"    -> "447545970472"
 *   "+44 7545 970472" -> "447545970472"
 *   "00447545970472"  -> "447545970472"
 */
function convertTo44(s) {
  const d = String(s || '').replace(/\D+/g, '');
  if (!d) return '';
  let n = d.replace(/^0+/, '');      // drop any leading zeros (handles 0… and 00…)
  if (!n) return '';
  return n.startsWith('44') ? n : ('44' + n);
}

/**
 * Try session first, then template.
 * Ensures phone is normalized to 44… for safety and consistency.
 */
function _watiSendSessionOrTemplate(phone, text, templateParams) {
  const p44 = convertTo44(phone);
  if (!p44) return null;

  // Safety checks done against either stored form (defensive):
  const inCL = (_phoneInCandidateList && (_phoneInCandidateList(p44) || _phoneInCandidateList(phone)));
  if (!inCL) return null;

  const optedOut = (_isAiOptOut && (_isAiOptOut(p44) || _isAiOptOut(phone)));
  if (optedOut) return 'optout';

  if (_watiSendSession(p44, text)) return 'session';
  const entries = templateParams || {};
  if (_watiSendTemplate(p44, S().TEMPLATE_NAME, entries, text)) return 'template';
  return null;
}

/**
 * Send a session message via WATI using 44… number.
 */
function _watiSendSession(phone, text) {
  const p44 = convertTo44(phone);
  if (!p44) return false;

  try {
    const url = `${WATI_BASE}/api/v1/sendSessionMessage/${encodeURIComponent(p44)}`;
    const res = UrlFetchApp.fetch(url, {
      method: 'post',
      muteHttpExceptions: true,
      headers: { Authorization: WATI_TOKEN, 'Content-Type': 'application/json' },
      payload: JSON.stringify({ messageText: text })
    });
    return res.getResponseCode() >= 200 && res.getResponseCode() < 300;
  } catch (_) {
    return false;
  }
}

/**
 * Send a template message via WATI using 44… number.
 */
function _watiSendTemplate(phone, templateName, params, fullNameFallback) {
  const p44 = convertTo44(phone);
  if (!p44) return false;

  try {
    const parts = (fullNameFallback || '').trim().split(/\s+/);
    const surname   = parts.length ? parts[parts.length - 1] : 'User';
    const firstname = parts.length > 1 ? parts[0] : '';
    const ts = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'ddMMyyHHmmss');
    const broadcast = `${surname}_${firstname}_${ts}`;

    const payload = {
      template_name: templateName,
      broadcast_name: broadcast,
      parameters: Object.keys(params || {}).map(k => ({ name: k, value: String(params[k]) }))
    };
    const url = `${WATI_BASE}/api/v2/sendTemplateMessage?whatsappNumber=${encodeURIComponent(p44)}`;
    const res = UrlFetchApp.fetch(url, {
      method: 'post',
      muteHttpExceptions: true,
      headers: { Authorization: WATI_TOKEN, 'Content-Type': 'application/json-patch+json' },
      payload: JSON.stringify(payload)
    });
    return res.getResponseCode() >= 200 && res.getResponseCode() < 300;
  } catch (_) {
    return false;
  }
}

/** =======================
 *  8) DEEPSEEK CALL (JSON CONTRACT)
 *  ======================= */
function _deepseekJSON(systemText, userJSON) {
  try {
    const key = _deepseekKey();
    if (!key) return null;

    const body = {
      model: DS_MODEL,
      messages: [
        { role: 'system', content: systemText },
        { role: 'user', content: userJSON }
      ],
      response_format: { type: 'json_object' },
      temperature: 0.3
    };
    const res = UrlFetchApp.fetch(DS_URL, {
      method: 'post', muteHttpExceptions: true,
      headers: { Authorization: `Bearer ${key}`, 'Content-Type': 'application/json' },
      payload: JSON.stringify(body)
    });
    if (res.getResponseCode() < 200 || res.getResponseCode() >= 300) return null;
    const data = JSON.parse(res.getContentText());
    const content = data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content;
    if (!content) return null;
    return JSON.parse(content);
  } catch (e) { return null; }
}

/** =======================
 *  9) KB — MATCHING, REQUESTS, PARSE KIER
 *  ======================= */
const KB_REPLY_PREFIX = 'KB#';

function kb_matchLatestByTriggers(lastTurns) {
  const last = _lastNurseText(lastTurns);
  if (!last) return null;
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SH_KB); if (!sheet) return null;
  const vals = sheet.getDataRange().getDisplayValues();
  if (vals.length <= 1) return null;

  const hdr = vals[0].map(s => (s||'').toString().toLowerCase());
  const iStatus = hdr.indexOf('status');
  const iTrig   = hdr.indexOf('triggerscsv');
  const iAns    = hdr.indexOf('answer');
  if (iStatus < 0 || iTrig < 0 || iAns < 0) return null;

  const text = last.toLowerCase();
  for (let r = 1; r < vals.length; r++) {
    if ((vals[r][iStatus]||'').toLowerCase() !== 'active') continue;
    const trigCsv = (vals[r][iTrig]||'').toLowerCase();
    const triggers = trigCsv.split(',').map(s=>s.trim()).filter(Boolean);
    if (triggers.some(t => text.includes(t))) {
      return vals[r][iAns] || null;
    }
  }
  return null;
}

function _looksLikeKB(msg) {
  if (!msg) return false;
  const s = msg.toLowerCase();
  const hits = ['rate','pay','salary','overtime','expense','policy','uniform','parking','accommodation','mileage','travel','timesheet','invoice','holiday','sick','training','dbs','compliance','id','bank','payment','shift length','breaks','agency'];
  return hits.some(h => s.includes(h));
}

function kb_startRequest(question, candidatePhone) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const kb = ss.getSheetByName(SH_KB); if (!kb) return;
  const id = 'K' + Utilities.getUuid().slice(0,8);
  kb.appendRow([id, question, '', '', new Date(), 'system', 'Pending', candidatePhone]);

  const kier = _getKierPhone();
  const msg = [
    `New KB entry required.`,
    `Please reply in this exact format (lines):`,
    `${KB_REPLY_PREFIX}${id}`,
    `Answer - <your answer here>`,
    `Triggers - <comma,separated,trigger,words>`,
    '',
    `Original question: "${question}"`,
    `Candidate: ${candidatePhone}`
  ].join('\n');

  // Send to Kier (subject to kill-switch and test mode rules)
  _sendOrSimulate(kier, msg, { 'forename':'Kier' });
}

function kb_processKierReply(text) {
  const lines = text.split(/\r?\n/);
  if (!lines.length || !lines[0].startsWith(KB_REPLY_PREFIX)) return;
  const id = lines[0].substring(KB_REPLY_PREFIX.length).trim();

  const iAns = lines.findIndex(l => l.trim().toLowerCase().startsWith('answer - '));
  const iTrg = lines.findIndex(l => l.trim().toLowerCase().startsWith('triggers - '));

  if (iAns < 0 || iTrg < 0) {
    const kier = _getKierPhone();
    _sendOrSimulate(kier, `Format error for ${KB_REPLY_PREFIX}${id}. Please reply exactly:\n${KB_REPLY_PREFIX}${id}\nAnswer - <text>\nTriggers - <word1, word2, word3>`, { 'forename':'Kier' });
    return;
  }

  const answer = lines[iAns].split(' - ').slice(1).join(' - ').trim();
  const triggersCsv = lines[iTrg].split(' - ').slice(1).join(' - ').trim();
  if (!answer || !triggersCsv) {
    const kier = _getKierPhone();
    _sendOrSimulate(kier, `Please include both Answer and Triggers for ${KB_REPLY_PREFIX}${id}.`, { 'forename':'Kier' });
    return;
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const kb = ss.getSheetByName(SH_KB); if (!kb) return;
  const vals = kb.getDataRange().getValues();
  let rowIdx = -1;
  for (let r = 1; r < vals.length; r++) {
    if ((vals[r][0]||'').toString().trim() === id) { rowIdx = r+1; break; }
  }
  if (rowIdx < 0) return;

  kb.getRange(rowIdx, 3).setValue(triggersCsv);
  kb.getRange(rowIdx, 4).setValue(answer);
  kb.getRange(rowIdx, 5).setValue(new Date());
  kb.getRange(rowIdx, 6).setValue('Kier');
  kb.getRange(rowIdx, 7).setValue('Active');

  // 🔹 Normalize the candidate phone from the KB sheet before lookup/send
  const candidatePhoneRaw = kb.getRange(rowIdx, 8).getDisplayValue();
  const candidatePhone = candidatePhoneRaw ? _normPhoneUK(candidatePhoneRaw) : '';

  if (candidatePhone) {
    const conv = _conversationsFindActiveAvailability(candidatePhone);
    if (conv && new Date(conv.TTLExpiry) >= new Date()) {
      if (!_isAiOptOut(candidatePhone)) {
        _sendOrSimulate(candidatePhone, `Thanks for bearing with me. Here’s the info: ${answer}`, { 'forename':'there' });
      }
    }
  }
}

/** =======================
 * 10) CONVERSATIONS STORAGE
 *  ======================= */
function _conversationsFindActiveAvailability(phone) {
  const norm = _normPhoneUK(phone);
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SH_CONVOS); if (!sh) return null;
  const vals = sh.getDataRange().getValues();
  if (vals.length <= 1) return null;
  let best = null, bestTs = 0;
  for (let r = 1; r < vals.length; r++) {
    const sheetPhone = _normPhoneUK((vals[r][0]||'').toString().trim());
    if (sheetPhone !== norm) continue;
    const flow = (vals[r][12]||'').toString();
    const status = (vals[r][14]||'').toString() || 'Open';
    if (flow !== 'availability') continue;
    if (status === 'Closed') continue;
    const ts = new Date(vals[r][4]).getTime()||0;
    if (ts > bestTs) { best = vals[r]; bestTs = ts; }
  }
  if (!best) return null;
  return _rowToConvo(best);
}


function _rowToConvo(row){
  return {
    Phone: row[0], ConversationID: row[1], Summary: row[2], LastInteractionsJSON: row[3],
    LastUpdated: row[4], InitiatedBy: row[5], TTLExpiry: row[6], LastBotMessageTs: row[7],
    Origin: row[8], TemplateSent: row[9], LastStartTs: row[10], LastStartKind: row[11],
    Flow: row[12], PendingConfirmJSON: row[13], Status: row[14],
    LastExternalOutboundTs: row[15], QuietUntil: row[16], DoNotDisturbUntil: row[17]
  };
}


function _okToStartConversation(phone) {
  const norm = _normPhoneUK(phone);
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SH_CONVOS); if (!sh) return true;
  const vals = sh.getDataRange().getValues();
  let lastStart = 0;
  for (let r = 1; r < vals.length; r++) {
    const sheetPhone = _normPhoneUK((vals[r][0]||'').toString());
    if (sheetPhone !== norm) continue;
    const t = new Date(vals[r][10]).getTime()||0; // LastStartTs
    if (t > lastStart) lastStart = t;
  }
  if (!lastStart) return true;
  return (Date.now() - lastStart) / (1000*3600*24) >= S().CONTACT_COOLDOWN_D;
}

function _newConvoId() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMdd-HHmmss');
}

/** =======================
 * 11) PENDING FOLLOW-UPS (CacheService) + LOGGING + RAMP
 *  ======================= */


function _getDueFollowups() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SH_CONVOS); if (!sh) return [];
  const vals = sh.getDataRange().getValues();

  // Normalize all phones from the sheet and dedupe
  const phones = Array.from(new Set(
    vals.slice(1)
        .map(r => _normPhoneUK((r[0]||'').toString().trim()))
        .filter(Boolean)
  ));

  const cache = CacheService.getScriptCache();
  const out = [];
  phones.forEach(p => {
    const v = cache.get('pf:' + p);
    if (!v) return;
    const obj = JSON.parse(v);
    if (new Date(obj.when) <= new Date()) out.push(obj);
  });
  return out;
}

function _clearPendingFollowup(phone) {
  const norm = _normPhoneUK(phone);
  CacheService.getScriptCache().remove('pf:' + norm);
}

// Gentle ramp: reschedule all currently-due items evenly across windowMinutes
function _gentleRampReschedule(windowMinutes) {
  const due = _getDueFollowups();
  if (!due.length) return;

  // Stable sort by original due time, then phone
  due.sort((a,b) => (new Date(a.when) - new Date(b.when)) || a.phone.localeCompare(b.phone));

  const now = new Date();
  const N = due.length;
  for (let k = 0; k < N; k++) {
    const offsetMs = Math.round(((k + 0.5) * (windowMinutes * 60000)) / N);
    const newWhen = new Date(now.getTime() + offsetMs);
    _setPendingFollowup(due[k].phone, due[k].text, newWhen, due[k].reason, due[k].note);
  }
}

/** =======================
 * 12) AVAILABILITY WRITE HELPERS
 *  ======================= */
function _setUnavailable(av, rowIdx, dateHdrs, dStr) {
  const c = _findDateCol(dateHdrs, dStr); if (c < 0) return;
  const cell = av.getRange(rowIdx, 7+c);
  if (cell.getBackground() === COLOR_BOOKED) return;
  cell.setValue('');
  cell.setBackground(COLOR_UNAVAIL);
}

function _writeAvailabilitySafely(av, rowIdx, dateHdrs, dStr, shift, conflicts) {
  const c = _findDateCol(dateHdrs, dStr); if (c < 0) return false;

  const cell = av.getRange(rowIdx, 7 + c);
  const bg   = cell.getBackground();

  // Never overwrite booked (blue)
  if (bg === COLOR_BOOKED) {
    if (conflicts && conflicts.booked) conflicts.booked.push(dStr);
    return false;
  }

  // Do not allow LD immediately after a BOOKED Night the day before
  if (shift === 'LD' && c - 1 >= 0) {
    const prev = av.getRange(rowIdx, 7 + (c - 1));
    if (prev.getBackground() === COLOR_BOOKED && (prev.getDisplayValue() || '').toUpperCase() === 'N') {
      if (conflicts && conflicts.nightAdj) conflicts.nightAdj.push(dStr);
      return false;
    }
  }

  cell.setValue(shift).setBackground(COLOR_AVAILABLE);
  return true;
}

function _wouldBreachSixWithBookings(av, rowIdx, idx) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();

  // Visible window
  const lastCol = av.getLastColumn();
  const dates = av.getRange(1, 7, 1, lastCol - 6).getDisplayValues()[0];
  const rowVals = av.getRange(rowIdx, 7, 1, dates.length).getDisplayValues()[0];
  const bgs     = av.getRange(rowIdx, 7, 1, dates.length).getBackgrounds()[0];

  // Build candidate key ("surname first") to match EmailHistory occupantKey
  const surname = (av.getRange(rowIdx, 1).getDisplayValue() || '').trim();
  const first   = (av.getRange(rowIdx, 2).getDisplayValue() || '').trim();
  const nameKey = (surname + ' ' + first).toLowerCase();

  // Build a read-only bookings map from EmailHistory: map[yyyy-MM-dd] = 'LD'|'N'
  const bookedMap = {};
  const eh = ss.getSheetByName(SH_EMAILHIST) || ss.getSheetByName('emailhistory');
  if (eh) {
    const rows = eh.getDataRange().getDisplayValues();
    if (rows.length > 1) {
      const hdr = rows[0].map(s => (s || '').toString().toLowerCase());
      const iName = hdr.indexOf('occupantkey');
      const iDate = hdr.indexOf('date');
      const iShift= hdr.indexOf('shift');
      if (iName >= 0 && iDate >= 0 && iShift >= 0) {
        for (let r = 1; r < rows.length; r++) {
          const nm = (rows[r][iName] || '').toString().trim().toLowerCase();
          if (nm !== nameKey) continue;
          const dStr = (rows[r][iDate] || '').toString().trim();
          const shf  = (rows[r][iShift] || '').toString().toLowerCase();
          const d = _parseDDMMYYYY(dStr);
          if (!d) continue;
          const ymd = Utilities.formatDate(d, tz, 'yyyy-MM-dd');
          bookedMap[ymd] = shf.includes('night') ? 'N' : 'LD';
        }
      }
    }
  }

  // Helper to check if a ymd day is booked for this candidate (from EmailHistory)
  function isBookedYmd(ymd) {
    const v = bookedMap[ymd];
    return v === 'LD' || v === 'N';
  }

  // Helper to check if a sheet column index c is booked (blue) for this row
  function isBookedCol(c) {
    const v = (rowVals[c] || '').toUpperCase();
    return (v === 'LD' || v === 'N') && bgs[c] === COLOR_BOOKED;
  }

  // Date at idx
  const centerDate = _parseDDMMYYYY(dates[idx]);
  if (!centerDate) return false; // if we can't parse, be safe and say no breach

  // Count consecutive booked days to the LEFT of idx
  let left = 0;
  for (let c = idx - 1; c >= 0; c--) {
    if (isBookedCol(c)) left++;
    else break;
    if (left >= 6) break;
  }

  // If we hit the left edge of the sheet and still have capacity (<6), extend using EmailHistory
  if (left < 6 && idx - 1 < 0 && dates.length) {
    // We start from the day just before the first visible date
    let d = _parseDDMMYYYY(dates[0]);
    if (d) {
      d.setDate(d.getDate() - 1);
      for (let i = 0; i < 6 - left; i++) {
        const ymd = Utilities.formatDate(d, tz, 'yyyy-MM-dd');
        if (isBookedYmd(ymd)) {
          left++;
          d.setDate(d.getDate() - 1);
        } else {
          break;
        }
      }
    }
  }

  // Count consecutive booked days to the RIGHT of idx
  let right = 0;
  for (let c = idx + 1; c < dates.length; c++) {
    if (isBookedCol(c)) right++;
    else break;
    if (right >= 6) break;
  }

  // If we hit the right edge of the sheet and still have capacity, extend using EmailHistory
  if (right < 6 && idx + 1 >= dates.length && dates.length) {
    // Start from the day just after the last visible date
    let d = _parseDDMMYYYY(dates[dates.length - 1]);
    if (d) {
      d.setDate(d.getDate() + 1);
      for (let i = 0; i < 6 - right; i++) {
        const ymd = Utilities.formatDate(d, tz, 'yyyy-MM-dd');
        if (isBookedYmd(ymd)) {
          right++;
          d.setDate(d.getDate() + 1);
        } else {
          break;
        }
      }
    }
  }

  // Would adding this (proposed) day as a worked day create > 6 in a row?
  return (left + 1 + right) > 6;
}

/** =======================
 * 13) FINAL SUMMARY BUILDER
 *  ======================= */
function _buildFinalSummary(av, rowIdx, dateHdrs) {
  const tz = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone();
  const vals = av.getRange(rowIdx, 7, 1, dateHdrs.length).getDisplayValues()[0];
  const bgs  = av.getRange(rowIdx, 7, 1, dateHdrs.length).getBackgrounds()[0];

  const booked = [], available = [], unavailable = [];
  for (let c = 0; c < dateHdrs.length; c++) {
    const d   = _parseDDMMYYYY(dateHdrs[c]);
    const day = d ? Utilities.formatDate(d, tz, 'EEE d MMM') : dateHdrs[c];
    const v   = (vals[c] || '').toUpperCase();
    const bg  = bgs[c];

    if (bg === COLOR_BOOKED && (v === 'LD' || v === 'N')) {
      booked.push(`${day} (${v})`);
    } else if (v === 'BLOCKED' && bg === COLOR_BLOCKED) {
      // omit system block from summary
    } else if (!v && bg === COLOR_UNAVAIL) {
      unavailable.push(day);
    } else if (['LD', 'N', 'LD/N', 'LD+N'].includes(v) && bg === COLOR_AVAILABLE) {
      available.push(`${day} (${v === 'LD+N' ? 'LD/N' : v})`);
    }
  }

  const lines = [];
  lines.push('Your availability update');
  if (booked.length)     lines.push(`📘 Booked (from rota): ${booked.join(', ')}`);
  if (available.length)  lines.push(`✅ Available (could work): ${available.join(', ')}`);
  if (unavailable.length)lines.push(`❌ Unavailable: ${unavailable.join(', ')}`);
  if (!booked.length && !available.length && !unavailable.length) {
    lines.push(`No availability recorded yet for the next ${S().WINDOW_DAYS} days.`);
  }
  lines.push('Please double-check your diary and let me know if anything needs changing.');
  return lines.join('\n');
}

/** =======================
 * 14) UTILITIES, LOGGING & OUTBOUND HANDOFF
 *  ======================= */
function _jsonSuccess() { return ContentService.createTextOutput(JSON.stringify({success:true})).setMimeType(ContentService.MimeType.JSON); }
function _jsonSuccessObj(obj){ return ContentService.createTextOutput(JSON.stringify({success:true, ...obj})).setMimeType(ContentService.MimeType.JSON); }
function _jsonError(m)  { return ContentService.createTextOutput(JSON.stringify({success:false,error:m})).setMimeType(ContentService.MimeType.JSON); }
function _nowUK(){ const tz=SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone(); return new Date(Utilities.formatDate(new Date(), tz, "yyyy-MM-dd'T'HH:mm:ss")); }

function _parseDDMMYYYY(s){
  // Accept either "DD/MM/YYYY" or "Wed 13/08/2025" (any 3+ letter weekday prefix)
  if (!s) return null;
  const m = String(s).match(/(\d{2}\/\d{2}\/\d{4})/); // extract date portion anywhere in the string
  if (!m) return null;
  const parts = m[1].match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  if (!parts) return null;
  const d = new Date(+parts[3], +parts[2]-1, +parts[1]);
  return isNaN(d) ? null : d;
}

// From a header like "Wed 13/08/2025" return "13/08/2025"
function _headerToDDMMYYYY(hdr){
  const m = String(hdr||'').match(/(\d{2}\/\d{2}\/\d{4})/);
  return m ? m[1] : '';
}

// Find the column index for a given "DD/MM/YYYY" within header strings
function _findDateCol(dateHdrs, ddmmyyyy){
  const target = String(ddmmyyyy||'').trim();
  if (!target) return -1;
  return dateHdrs.findIndex(h => _headerToDDMMYYYY(h) === target);
}


function _isSameDay(a,b){ return a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()&&a.getDate()===b.getDate(); }
function _fmtShortDateList(list){ const tz=SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone(); return list.map(s=>{const d=_parseDDMMYYYY(s); return d?Utilities.formatDate(d,tz,'EEE d MMM'):s;}).join(', '); }

function _getKierPhone(){
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SH_CANDIDATES); if (!sh) return '';
  const vals = sh.getDataRange().getDisplayValues();
  for (let r=1;r<vals.length;r++){
    const sur=(vals[r][0]||'').toString().trim().toLowerCase();
    const fir=(vals[r][1]||'').toString().trim().toLowerCase();
    if (sur==='arthur' && fir==='kier') return (vals[r][3]||'').toString().trim();
  }
  return '';
}

function _findAvailRowByPhone(av, phone){
  const lastCol = av.getLastColumn();
  const vals = av.getRange(2,1,Math.max(av.getLastRow()-1,0), lastCol).getDisplayValues();
  for (let i=0;i<vals.length;i++){
    if ((vals[i][3]||'').toString().trim()===phone) return i+2;
  }
  return -1;
}

function _lastNurseText(turns){
  if (!Array.isArray(turns)) return '';
  for (let i=turns.length-1;i>=0;i--){
    if ((turns[i].from||'')==='nurse') return (turns[i].msg||'').toString();
  }
  return '';
}
// Normalise phone numbers for internal matching and WATI sending
function _normPhoneKey(raw) {
  if (!raw) return '';
  let d = String(raw).replace(/\D+/g, ''); // keep only digits
  if (!d) return '';

  // Drop leading 00 if present
  if (d.startsWith('00')) d = d.slice(2);

  // UK mobiles: 07xxxxxxxxx → 447xxxxxxxxx
  if (d.startsWith('0')) d = '44' + d.slice(1);

  // If missing the 0 but starts with 7, assume UK mobile
  if (d.length === 10 && d.startsWith('7')) d = '44' + d;

  return d;
}
function _digitsOnly_(v) {
  return String(v || '').replace(/\D+/g, '');
}
function _lastNDigits_(v, n) {
  const d = _digitsOnly_(v);
  return d ? d.slice(-Math.max(1, n)) : '';
}
function _normPhoneUK(s) {
  const d = String(s || '').replace(/\D+/g, '');
  if (!d) return '';
  if (d.startsWith('44') && d.length === 12) return '0' + d.slice(2); // +44… → 0…
  if (d.length === 10 && d[0] !== '0')       return '0' + d;          // 10-digit → 0…
  if (d.length === 11 && d[0] === '0')       return d;                // already ok
  return d[0] === '0' ? d : ('0' + d);                                // fallback
}

function _phoneInCandidateList(phone) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SH_CANDIDATES);
  if (!sh) return false;

  const vals = sh.getDataRange().getValues();
  if (!vals || !vals.length) return false;

  const hdr = vals[0].map(s => (s || '').toString().toLowerCase());
  const iPhone = hdr.indexOf('telephone');
  if (iPhone < 0) return false;

  // Normalize target (prefer full-digit match, fallback to last-10)
  const targetFull   = _digitsOnly_(phone);
  const targetLast10 = _lastNDigits_(phone, 10);
  if (!targetFull && !targetLast10) return false;

  for (let r = 1; r < vals.length; r++) {
    const raw = vals[r][iPhone];
    if (!raw) continue;

    const candFull   = _digitsOnly_(raw);
    const candLast10 = _lastNDigits_(raw, 10);

    if ((targetFull && candFull && candFull === targetFull) ||
        (targetLast10 && candLast10 && candLast10 === targetLast10)) {
      return true;
    }
  }
  return false;
}


// NEW: AI opt-out helper — returns true if Candidate List column "AI" is exactly "NO"
function _isAiOptOut(phone) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SH_CANDIDATES);
  if (!sh) return false;
  const vals = sh.getDataRange().getValues();
  const hdr = vals[0].map(s => (s||'').toString().toLowerCase());
  const iPhone = hdr.indexOf('telephone');
  const iOptOut = hdr.indexOf('ai opt-out');
  if (iPhone < 0 || iOptOut < 0) return false;

  const target = _normPhoneKey(phone);
  for (let r = 1; r < vals.length; r++) {
    if (_normPhoneKey(vals[r][iPhone]) === target) {
      const val = (vals[r][iOptOut] || '').toString().trim().toLowerCase();
      return val === 'yes' || val === 'true';
    }
  }
  return false;
}


// Pause availability, open/update human handoff, set quiet window
function _pauseAvailabilityAndOpenHandoff(phone, outboundText, ts){
  const now = ts || new Date();

  // Compute QuietUntil (real vs test)
  const quietRealMs = S().QUIET_WINDOW_MIN_REAL*60*1000;
  const when = _computeFireTime(quietRealMs, 'QuietWindow');
  const quietUntilToStore = when.realAt; // store real-world for reference

  // Pause any open availability
  const avc = _conversationsFindActiveAvailability(phone);
  if (avc) {
    _conversationsUpsert({
      Phone: phone, ConversationID: avc.ConversationID,
      Status: 'Paused',
      LastExternalOutboundTs: now,
      QuietUntil: quietUntilToStore
    });
    const turns = JSON.parse(avc.LastInteractionsJSON||'[]');
    turns.push({from:'human', msg:`[external outbound] ${outboundText}`, ts:now.toISOString()});
    while (turns.length > S().MAX_TURNS_TO_KEEP) turns.shift();
    _conversationsUpsert({ Phone: phone, ConversationID: avc.ConversationID, LastInteractionsJSON: JSON.stringify(turns), LastUpdated: now });
  }

  // Ensure/update human handoff row
  let conv = _conversationsFindMostRecentAny(phone);
  if (!conv || conv.Flow === 'availability') {
    _conversationsUpsert({
      Phone: phone,
      ConversationID: _newConvoId(),
      Summary: `External outbound at ${Utilities.formatDate(now, Session.getScriptTimeZone(), 'dd/MM HH:mm')}: ${outboundText.slice(0,120)}`,
      LastInteractionsJSON: JSON.stringify([{ from: 'human', msg: outboundText, ts: now.toISOString() }]),
      LastUpdated: now,
      InitiatedBy: 'HUMAN',
      TTLExpiry: new Date(now.getTime() + 24 * 3600 * 1000),
      LastBotMessageTs: '',
      Origin: 'wati',
      TemplateSent: false,
      LastStartTs: '',
      LastStartKind: '',
      Flow: 'handoff',
      PendingConfirmJSON: '',
      Status: 'Open',
      LastExternalOutboundTs: now,
      QuietUntil: quietUntilToStore
    });
  } else {
    const turns = JSON.parse(conv.LastInteractionsJSON || '[]');
    turns.push({ from: 'human', msg: outboundText, ts: now.toISOString() });
    while (turns.length > S().MAX_TURNS_TO_KEEP) turns.shift();

    _conversationsUpsert({
      Phone: phone,
      ConversationID: conv.ConversationID,
      Summary: `Latest external outbound at ${Utilities.formatDate(now, Session.getScriptTimeZone(), 'dd/MM HH:mm')}: ${outboundText.slice(0,120)}`,
      LastInteractionsJSON: JSON.stringify(turns),
      LastUpdated: now,
      InitiatedBy: 'HUMAN',
      TTLExpiry: new Date(now.getTime() + 2 * 3600 * 1000),
      LastExternalOutboundTs: now,
      QuietUntil: quietUntilToStore
    });
  }
}

/** =======================
 * 15) STAGGER, TIMERS, LOGGING, OPENERS, MISC
 *  ======================= */

// Deterministic small hash for jitter
function _hashStr(s){
  let h=2166136261>>>0;
  for (let i=0;i<s.length;i++){ h^=s.charCodeAt(i); h=Math.imul(h,16777619)>>>0; }
  return h>>>0;
}

// Assign slots evenly across today (real 08:00–22:00 UK; test: 14s window)
function _assignStaggeredSlotsToday(list){
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();
  const now = _nowUK();
  const dayKey = Utilities.formatDate(now, tz, 'yyyy-MM-dd');

  const startReal = new Date(now); startReal.setHours(S().STAGGER_START_HH,0,0,0);
  const endReal   = new Date(now); endReal.setHours(S().STAGGER_END_HH,0,0,0);
  const spanMs    = Math.max(1, endReal.getTime()-startReal.getTime());
  const N = list.length;

  const testSpanSec = 14; // compress the whole daily window to 14 seconds in test mode

  return list.map((it, idx) => {
    // Even placement
    const center = (idx+0.5)/N;
    let realAt = new Date(startReal.getTime() + Math.round(center*spanMs));

    // Deterministic jitter per candidate/day
    const h = _hashStr(it.phone + '|' + dayKey);
    const jitterMin = S().STAGGER_JITTER_MIN, jitterMax = S().STAGGER_JITTER_MAX;
    const jitterMs = (jitterMin + (h % Math.max(1,(jitterMax-jitterMin+1)))) * 60 * 1000;
    realAt = new Date(realAt.getTime() + jitterMs);

    // Test-time mapping: linearly compress to 14s from "now"
    const testDelaySec = Math.max(0, Math.round(( (realAt.getTime()-startReal.getTime()) / spanMs ) * testSpanSec));
    const testAt = new Date(now.getTime() + (testDelaySec*1000));

    return {
      phone: it.phone,
      realAt,
      realHuman: Utilities.formatDate(realAt, tz, 'dd/MM HH:mm'),
      testAt,
      testDelaySec
    };
  });
}

// Translate a real-world wait into test-time delay and return both timestamps
function _computeFireTime(waitRealMs, reason){
  const now = new Date();
  const realAt = new Date(now.getTime() + Math.max(0, waitRealMs));
  // Map minutes->seconds in test to keep things fast and logged
  const testDelaySec = Math.max(1, Math.round(waitRealMs/60000));
  const testAt = new Date(now.getTime() + testDelaySec*1000);
  const realHuman = (waitRealMs>=3600000)
      ? (Math.round(waitRealMs/3600000)+'h')
      : (Math.round(waitRealMs/60000)+'m');
  return { realAt, testAt, realHuman, testDelaySec, reason: reason||'' };
}

// Logs: TsLogged, Phone, ConvoID, Event, Reason, RealDelayHuman, TestDelaySec, RealFireAt, TestFireAt, Note


// Start/restart availability flow (used after STOP snooze or manual restart)
function _startOrRestartAvailability(phone){
  // Guard: do not start for AI-opt-out
  if (_isAiOptOut(phone)) return;
  _sendOpenerNow(phone);
}

// Send the daily opener now (template if possible; falls back to session)
function _sendOpenerNow(phone){
  // Guard: do not talk to AI-opt-out numbers
  if (_isAiOptOut(phone)) return;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const av = ss.getSheetByName(SH_AVAIL); if (!av) return;

  const rowIdx = _findAvailRowByPhone(av, phone); if (rowIdx<0) return;

  // Only proceed if the candidate has at least one open (white) date in window
  const lastCol = av.getLastColumn();
  const dateHdrs = av.getRange(1,7,1,lastCol-6).getDisplayValues()[0];
  const vals = av.getRange(rowIdx,7,1,lastCol-6).getDisplayValues()[0];
  const bgs  = av.getRange(rowIdx,7,1,lastCol-6).getBackgrounds()[0];
  let hasOpen = false;
  for (let c = 0; c < dateHdrs.length; c++) {
    const v  = (vals[c]||'').toString().trim();
    const bg = bgs[c];
    if (!v && bg !== COLOR_BOOKED && bg !== COLOR_UNAVAIL && bg !== COLOR_BLOCKED) { hasOpen = true; break; }
  }
  if (!hasOpen) return;

  const first = av.getRange(rowIdx,2).getDisplayValue() || 'there';

  // Always route sending through _sendOrSimulate to respect test mode + kill switch + opt-out
  const text = `Hi ${first}, quick availability update — could you work any dates over the next two weeks? (LD, N, or LD/N)`;
  const kind = _sendOrSimulate(phone, text, { forename:first });  // 'simulated' | 'session' | 'template' | 'blocked' | 'optout' | null

  // Prefer the active availability convo; otherwise fall back to most recent any
  const avail    = _conversationsFindActiveAvailability(phone);
  const existing = avail || _conversationsFindMostRecentAny(phone);
  const convoId  = existing ? existing.ConversationID : _newConvoId();

  // Append interaction turn safely
  const turns = existing ? (JSON.parse(existing.LastInteractionsJSON || '[]')) : [];
  turns.push({ from:'bot', msg:`[start:${kind||'failed'}] ${text}`, ts:new Date().toISOString() });
  while (turns.length > S().MAX_TURNS_TO_KEEP) turns.shift();

  _conversationsUpsert({
    Phone: phone,
    ConversationID: convoId,
    Summary: 'Availability opener sent.',
    LastInteractionsJSON: JSON.stringify(turns),
    LastUpdated: new Date(),
    InitiatedBy: 'BOT',
    TTLExpiry: new Date(Date.now()+S().CONVO_TTL_MIN*60000),
    LastBotMessageTs: new Date(),
    Origin: 'appscript',
    TemplateSent: kind === 'template',
    LastStartTs: new Date(),
    LastStartKind: kind || 'session',
    Flow: 'availability',
    PendingConfirmJSON: '',
    Status: 'Open'
  });
}

// Are there any open (white) cells left to ask about?
function _allAccounted(av, rowIdx, dateHdrs){
  const bgs = av.getRange(rowIdx,7,1,dateHdrs.length).getBackgrounds()[0];
  const vals= av.getRange(rowIdx,7,1,dateHdrs.length).getDisplayValues()[0];
  for (let i=0;i<dateHdrs.length;i++){
    const v=(vals[i]||'').toString().trim();
    const bg=bgs[i];
    if (!v && bg !== COLOR_BOOKED && bg !== COLOR_UNAVAIL && bg !== COLOR_BLOCKED){
      // still open (white)
      return false;
    }
  }
  return true;
}

