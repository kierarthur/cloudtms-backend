/**
 * Receive client-side logs from HTML (google.script.run.logClient(payload)).
 * Writes to Apps Script execution log AND a "ClientLog" sheet (auto-created).
 *
 * Payload shape is flexible; recommended: { evt, data, t }
 */
function logClient(payload) {
  try {
    const ss   = SpreadsheetApp.getActive();
    const tz   = ss.getSpreadsheetTimeZone() || 'UTC';
    const now  = new Date();
    const ts   = Utilities.formatDate(now, tz, 'dd/MM/yyyy HH:mm:ss');

    // Who initiated (best-effort)
    const user = (function () {
      try { return Session.getActiveUser().getEmail() || Session.getEffectiveUser().getEmail() || 'unknown'; }
      catch (e) { return 'unknown'; }
    })();

    // Normalize payload
    let evt  = 'client';
    let data = payload;
    let iso  = now.toISOString();

    if (payload && typeof payload === 'object') {
      evt  = String(payload.evt || 'client');
      data = payload.data !== undefined ? payload.data : payload;
      iso  = String(payload.t || iso);
    }

    const json = _logClient_safeStringify_(data);
    const jsonTrunc = _logClient_truncate_(json, 45000); // stay well under cell limits

    // Execution log
    Logger.log('[ClientLog] %s | %s | %s | %s', ts, user, evt, jsonTrunc);

    // Sheet log
    const sh = _logClient_getOrCreateSheet_('ClientLog');
    sh.appendRow([ts, user, evt, iso, jsonTrunc]);

    // Optionally return something to the client
    return { ok: true, ts, user, evt, len: json.length };
  } catch (e) {
    Logger.log('[ClientLog:ERROR] %s', e && e.message ? e.message : String(e));
    return { ok: false, error: String(e) };
  }
}

/* ---------- helpers ---------- */

/** Create/return a sheet with headers */
function _logClient_getOrCreateSheet_(name) {
  const ss = SpreadsheetApp.getActive();
  let sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    sh.appendRow(['Timestamp', 'User', 'Event', 'ISO Time', 'Data (JSON)']);
    sh.getRange(1, 1, 1, 5).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

/** Safe JSON stringify without blowing up on circulars; squashes big/unsupported values */
function _logClient_safeStringify_(val) {
  const seen = new WeakSet();
  try {
    return JSON.stringify(val, function (k, v) {
      if (typeof v === 'object' && v !== null) {
        if (seen.has(v)) return '[Circular]';
        seen.add(v);
      }
      // Apps Script Blobs/Files won't appear here from client payloads, but guard anyway
      try {
        if (v && typeof v.getBytes === 'function') return '[Blob]';
      } catch (_) {}
      return v;
    });
  } catch (e) {
    try { return String(val); } catch (_) { return '[Unstringifiable]'; }
  }
}

/** Truncate long strings for safe sheet storage */
function _logClient_truncate_(s, max) {
  s = String(s || '');
  if (s.length <= max) return s;
  return s.slice(0, max - 3) + '...';
}

/**
 * One-call bulk email test for Power Automate (schema-compliant).
 * - Script Property "multi_email_send" must contain your PA webhook URL.
 * - Payload schema:
 *   {
 *     runId: string,
 *     defaultFrom?: string,
 *     items: [{ to, cc?, bcc?, subject?, htmlBody?, textBody?, replyTo?, from?, importance?, attachmentsV2?, meta? }]
 *   }
 * - Flow response expected:
 *   { runId: "...", results: <array|json-string> }
 */
function testPowerAutomateBulkEmail_SchemaSingleCall() {
  const url = PropertiesService.getScriptProperties().getProperty('MULTI_EMAIL_SEND');
  if (!url) throw new Error('Set Script Property "MULTI_EMAIL_SEND" to your flow URL.');

  const defaultFrom = 'sussex@arthur-rai.co.uk'; // shared mailbox as default sender

  // Removed arthurrai2006@gmail.com as requested
  const targets = [
    'kier@arthur-rai.co.uk',
    'kier_w_arthur2@hotmail.com',
    'test@arthur-rai.co.uk',
    'testing@arthur-rai.co.uk',
  ];

  // Build 40 items (10 per recipient), adhering strictly to the schema.
  const nowIso = new Date().toISOString();
  const items = [];
  for (const to of targets) {
    for (let i = 1; i <= 10; i++) {
      items.push({
        to,
        subject: `Load Test ${i}/10 → ${to}`,
        importance: 'Normal',
        htmlBody:
          `<table border="1" cellpadding="4" cellspacing="0">
             <tr><th colspan="2">Load Test</th></tr>
             <tr><td>Recipient</td><td>${to}</td></tr>
             <tr><td>Index</td><td>${i}/10</td></tr>
             <tr><td>Timestamp</td><td>${nowIso}</td></tr>
           </table>`
        // Optional fields (cc,bcc,textBody,replyTo,from,attachmentsV2,meta) intentionally omitted
        // to respect "additionalProperties": false and avoid sending nulls.
      });
    }
  }

  const runId = Utilities.getUuid();
  const payload = { runId, defaultFrom, items };

  // Measure how quickly the immediate-ACK response returns
  const t0 = Date.now();
  let status = null, text = '', headers = null, elapsedMs = null;
  try {
    const res = UrlFetchApp.fetch(url, {
      method: 'post',
      contentType: 'application/json',
      payload: JSON.stringify(payload),
      muteHttpExceptions: true,
      followRedirects: true,
    });
    elapsedMs = Date.now() - t0;
    status = res.getResponseCode();
    text = res.getContentText() || '';
    headers = res.getAllHeaders && res.getAllHeaders();
  } catch (e) {
    elapsedMs = Date.now() - t0;
    status = 'EXCEPTION';
    text = String((e && e.message) || e);
  }

  // Parse possible immediate-ACK body (may not include results now)
  let parsed = null;
  try { parsed = JSON.parse(text); } catch (_) {}

  // Results may be absent (since processing is async now). Handle gracefully.
  let results = [];
  if (parsed && parsed.results != null) {
    const r = parsed.results;
    if (Array.isArray(r)) {
      results = r;
    } else if (typeof r === 'string') {
      try {
        const maybe = JSON.parse(r);
        if (Array.isArray(maybe)) results = maybe;
        else if (maybe && typeof maybe === 'object') results = [maybe];
      } catch (_) {/* leave empty */}
    } else if (typeof r === 'object') {
      results = [r];
    }
  }

  // Throttle detection from any synchronous detail we might get back
  let throttled = (status === 429);
  let okItems = 0, failedItems = 0, throttledItems = 0;

  for (const it of results) {
    const sc = normCode(it && (it.statusCode || it.code || it.status));
    const msg = String((it && (it.message || it.error || it.reason)) || '').toLowerCase();
    if (sc === 429 || msg.includes('throttle')) {
      throttled = true; throttledItems++; failedItems++;
    } else if (sc >= 200 && sc < 300) {
      okItems++;
    } else if (sc != null) {
      failedItems++;
    }
  }

  const summary = {
    runIdSent: runId,
    runIdEcho: (parsed && parsed.runId) || null,     // for correlation if your ACK returns it
    httpStatus: status,
    elapsedMsToAck: elapsedMs,                       // **key metric**: time to immediate response
    totalRequested: items.length,                    // 40 now (4 recipients × 10)
    resultsCount: results.length,                    // likely 0 with immediate ACK
    okItems,
    failedItems,
    throttledItems,
    throttled,
    responseHeaders: headers || null,
    responsePreview: (text || '').slice(0, 800),
    fullAck: parsed || null,
  };

  Logger.log(JSON.stringify(summary, null, 2));
  return summary;

  // ---- helpers ----
  function normCode(v) {
    if (v == null) return null;
    if (typeof v === 'number') return v;
    const n = parseInt(v, 10);
    if (!isNaN(n)) return n;
    const s = String(v).toLowerCase();
    if (s.includes('429')) return 429;
    if (s.includes('ok') || s.includes('success')) return 200;
    return null;
  }
}
