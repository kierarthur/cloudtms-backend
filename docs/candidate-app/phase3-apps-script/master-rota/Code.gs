function _1collectVacancyDatesNext7Days(activeSheet) {
  const rota = _1readCurrentRotaLayoutAndBlanks(activeSheet || SpreadsheetApp.getActiveSheet());

  const tz = _1tz();
  const today = new Date();
  const t0 = new Date(Utilities.formatDate(today, tz, 'yyyy-MM-dd') + 'T00:00:00');

  const hasNames = !!rota.hasAnyNames;
  const allVac = Array.isArray(rota.vacancies) ? rota.vacancies : [];

  // ─────────────── Logs sheet appender ───────────────
  function logRow(phase, note, payloadSize, payload) {
    try {
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      let sh = ss.getSheetByName("Logs");
      if (!sh) {
        sh = ss.insertSheet("Logs");
        sh.appendRow(["Timestamp", "Function", "Phase", "Note", "PayloadSize", "Payload"]);
      }
      sh.appendRow([new Date(), "_1collectVacancyDatesNext7Days", String(phase||''), String(note||''), Number(payloadSize||0), String(payload||'')]);
    } catch (_) {}
  }

  // Start log
  logRow("start", `site=${rota.site||''}; ward=${rota.ward||''}; hasAnyNames=${hasNames}; vacancies=${allVac.length}`, allVac.length, "");

  const vacSet = new Set();
  let considered = 0, included = 0, excludedPast = 0, excludedInvalid = 0, excludedNoYmd = 0;

  allVac.forEach(v => {
    considered++;
    const ymd = String(v.ymd || '').trim();
    if (!ymd) {
      excludedNoYmd++;
      logRow("exclude", "no ymd on vacancy", 0, JSON.stringify(v).slice(0, 5000));
      return;
    }
    const d = new Date(ymd + 'T00:00:00');
    if (isNaN(d)) {
      excludedInvalid++;
      logRow("exclude", `invalid date parsed from ymd=${ymd}`, 0, "");
      return;
    }
    if (d < t0) {
      excludedPast++;
      // Only log first few to avoid spam
      if (excludedPast <= 10) logRow("exclude", `past date (ymd=${ymd})`, 0, "");
      return;
    }
    vacSet.add(ymd);
    included++;
    // Light per-include trace (cap at 15 to avoid spam)
    if (included <= 15) logRow("include", `future vacancy kept (ymd=${ymd}, shift=${v.shift||''}, role=${v.role||''}, g=${v.gender||'Any'})`, 0, "");
  });

  let dates = Array.from(vacSet).sort();

  logRow("pre-cap", `uniqueFutureDates=${dates.length}; considered=${considered}; included=${included}; excludedPast=${excludedPast}; excludedInvalid=${excludedInvalid}; excludedNoYmd=${excludedNoYmd}`, dates.length, dates.join(','));

  // Brand-new rota (no names at all): cap to first 5 future dates
  if (!hasNames && dates.length > 5) {
    const before = dates.slice(0);
    dates = dates.slice(0, 5);
    // Log what was removed by the cap (limit to first 15 for verbosity control)
    const removed = before.slice(5);
    logRow("cap-applied", `no names on rota → capping to first 5 dates`, removed.length, removed.slice(0, 15).join(','));
  }

  logRow("result", `finalDates=${dates.length}; hasAnyNames=${hasNames}`, dates.length, dates.join(','));

  return {
    dates: dates,
    hasAnyNames: hasNames
  };
}



