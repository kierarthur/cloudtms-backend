function getCandidateIndex_() {
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(SHEET_CANDIDATE_LIST);
  if (!sh) throw new Error(`Missing sheet "${SHEET_CANDIDATE_LIST}"`);

  const values = sh.getDataRange().getValues();
  if (!values || values.length < 2) throw new Error('Candidate List has no data rows.');

  // Default to fixed positions per spec: A,B,E,I and F for Gender (0-based)
  let colSurname   = 0; // A
  let colFirst     = 1; // B
  let colJob       = 4; // E
  let colPublicId  = 8; // I
  let colGender    = 5; // F (as per your note)

  const headerRow = values[0] || [];
  const width = headerRow.length;

  // If the header row appears to have labels, try to detect columns as a bonus
  if (width >= 6) {
    const norm = (s) => (s == null ? '' : String(s).trim().toLowerCase());
    const headers = headerRow.map(norm);

    const findCol = (candidates) => {
      for (const cand of candidates) {
        const i = headers.indexOf(cand);
        if (i >= 0) return i;
      }
      return -1;
    };

    const guessSurname   = findCol(['surname', 'last name', 'lastname', 'family name', 'familyname']);
    const guessFirst     = findCol(['first name', 'firstname', 'forename', 'given name', 'givenname']);
    const guessJob       = findCol(['job title', 'jobtitle', 'role', 'position']);
    const guessPublicId  = findCol(['public id', 'publicid', 'employee id', 'employeeid', 'id']);
    const guessGender    = findCol(['gender', 'sex']);

    if (guessSurname  >= 0) colSurname  = guessSurname;
    if (guessFirst    >= 0) colFirst    = guessFirst;
    if (guessJob      >= 0) colJob      = guessJob;
    if (guessPublicId >= 0) colPublicId = guessPublicId;
    if (guessGender   >= 0) colGender   = guessGender;
  }

  // Sanity check we have enough columns to read the defaults
  if (Math.max(colSurname, colFirst, colJob, colPublicId, colGender) >= width) {
    throw new Error(
      `Candidate List does not have expected columns (need at least A, B, E, F, I). Found width=${width}.`
    );
  }

  const idx = new Map(); // keys: "first last" and "last first" (both normalized)
  for (let r = 1; r < values.length; r++) {
    const row = values[r] || [];
    const surname   = (row[colSurname]  || '').toString().trim();
    const first     = (row[colFirst]    || '').toString().trim();
    const jobTitle  = (row[colJob]      || '').toString().trim();
    const publicId  = (row[colPublicId] || '').toString().trim();
    const gender    = (row[colGender]   || '').toString().trim();

    if (!first || !surname || !publicId) continue;

    const n = (s) => s.toLowerCase().replace(/\s+/g, ' ').trim();
    const keyFirstLast = n(`${first} ${surname}`);
    const keyLastFirst = n(`${surname} ${first}`);

    const record = { publicId, jobTitle, firstName: first, surname, gender };
    idx.set(keyFirstLast, record);
    idx.set(keyLastFirst, record); // allow “Surname First” lookups too
  }

  try {
    logStep_('', '', 'INDEX', 'OK', 'Using columns', {
      colSurname, colFirst, colJob, colGender, colPublicId, rowsIndexed: idx.size
    });
  } catch (_) {}

  return idx;
}


