function findPublicIdByFullName_(indexMap, fullName) {
  const nm = (fullName || '').trim();
  const directParts = splitFullName_(nm);
  const key = normalize(`${directParts.first} ${directParts.surname}`);
  if (indexMap.has(key)) return indexMap.get(key);

  // Fallback: try "first ... last" (ignore middles)
  const parts = nm.split(/\s+/).filter(Boolean);
  if (parts.length >= 2) {
    const first = parts[0];
    const surname = parts[parts.length - 1];
    const key2 = normalize(`${first} ${surname}`);
    if (indexMap.has(key2)) return indexMap.get(key2);
  }

  // Last resort: scan for case-insensitive equalities
  for (const [k, v] of indexMap.entries()) {
    if (k === key) return v;
  }
  return null;
}
function blobsToAttachmentsV2_(blobs) {
  try {
    return (blobs || [])
      .map(b => {
        let name = '';
        try { name = b.getName && b.getName(); } catch (_) {}
        if (!name) name = 'attachment';
        let bytes;
        try { bytes = b.getBytes(); } catch (_) { bytes = []; }
        const base64 = Utilities.base64Encode(bytes);
        return { Name: String(name), ContentBytes: String(base64) };
      })
      .filter(a => a.ContentBytes);
  } catch (e) {
    return [];
  }
}
/*******************************
 * LOGGING HELPERS (safe + robust)
 *******************************/
function _ensureLogsSheet_() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let sh = ss.getSheetByName('Logs');
    if (!sh) {
      sh = ss.insertSheet('Logs');
      sh.getRange(1,1,1,7).setValues([[
        'Timestamp','Level','Stage','Message','Meta JSON','Name/PublicId','Step'
      ]]);
      sh.getRange(1,1,1,7).setFontWeight('bold');
    }
    return sh;
  } catch (e) {
    // Last-resort: console only
    console.error('Failed to ensure Logs sheet', e && e.stack || e);
    return null;
  }
}

function _redactProps_(obj) {
  const out = {};
  Object.keys(obj || {}).forEach(k => {
    // Never dump secrets — only presence
    const v = obj[k];
    const looksSecret = /key|token|secret|pass|auth|bearer|private/i.test(k);
    out[k] = (v == null || String(v).trim() === '')
      ? '(missing)'
      : (looksSecret ? '(set)' : String(v).substring(0,128));
  });
  return out;
}

function _logRow_(level, stage, message, meta, nameOrPublicId, step) {
  try {
    const sh = _ensureLogsSheet_();
    if (!sh) return;
    const row = [
      new Date(),
      String(level || 'INFO'),
      String(stage || ''),
      String(message || ''),
      (meta ? JSON.stringify(meta) : ''),
      String(nameOrPublicId || ''),
      String(step || '')
    ];
    sh.appendRow(row);
  } catch (e) {
    // Don’t crash core flow on logging errors
    console.error('Logging error', e && e.stack || e);
  }
}

function LOG_INFO(stage, message, meta, nameOrPublicId, step) {
  _logRow_('INFO', stage, message, meta, nameOrPublicId, step);
}

function LOG_WARN(stage, message, meta, nameOrPublicId, step) {
  _logRow_('WARN', stage, message, meta, nameOrPublicId, step);
}

function LOG_ERR(stage, message, meta, nameOrPublicId, step) {
  _logRow_('ERROR', stage, message, meta, nameOrPublicId, step);
}

/******************************************************************
 * sendComplianceUpdates — with detailed headshot/insert diagnostics
 ******************************************************************/

function sendComplianceUpdates(selectedNames, recipientEmail, context) {
  // ── Resolve final recipient (first-match "contains" rules; fallback to Sussex) ──
  function _routeRecipientFromEmail(sourceEmail) {
    try {
      var s = String(sourceEmail || '').trim().toLowerCase();
      if (!s) return EMAIL_ROUTING_FALLBACK;
      if (Array.isArray(EMAIL_ROUTING_RULES)) {
        for (var i = 0; i < EMAIL_ROUTING_RULES.length; i++) {
          var r = EMAIL_ROUTING_RULES[i] || {};
          if (s.indexOf(String(r.match || '').toLowerCase()) !== -1) return String(r.to || '').trim();
        }
      }
      return EMAIL_ROUTING_FALLBACK;
    } catch (_) {
      return EMAIL_ROUTING_FALLBACK;
    }
  }

  var requesterEmail = '';
  try { requesterEmail = String(context && context.requesterEmail || '').trim(); } catch (_) {}
  var resolvedRecipient = String(recipientEmail || '').trim() || _routeRecipientFromEmail(requesterEmail);

  // ─────────────────────────────────────────────────────────────────────
  // CHECKLIST PIPELINE (now with single-pass headshot processing & reuse)
  // ─────────────────────────────────────────────────────────────────────

  const startedAt = new Date();
  const uniqNames = Array.from(new Set((selectedNames || []).filter(Boolean)));

  if (!uniqNames.length) {
    return;
  }

  let idx;
  try {
    idx = getCandidateIndex_();
  } catch (e) {
    throw e;
  }

  uniqNames.forEach(fullName => {
    const personRow = findPublicIdByFullName_(idx, fullName);
    if (!personRow) {
      return; // skip to next person
    }

    const publicId  = personRow.publicId;
    const jobTitle  = personRow.jobTitle || '';
    const firstName = personRow.firstName || splitFullName_(fullName).first || '';
    const surname   = personRow.surname   || splitFullName_(fullName).surname || '';
    const gender    = personRow.gender    || '';
    const baseCtx   = { name: fullName, publicId };

    // Collections
    const attachments = [];
    const attachedFileIds = new Set();
    const includedDocLabels = [];
    const summary = {
      nmc: {
        include: normalize(jobTitle) !== 'hca',
        registrationNumber: '',
        status: '',
        abbreviation: '',
        birthDate: '',
        lastCheckDateTime: '',
        feeExpiryDateIso: '',
        feeExpiryDateHyphen: '',
        comment: ''
      },
      niNumber: '',
      dbs: {
        updateCertificateNumber: '',
        updateStatus: '',
        lastCheckDateTime: '',
        providedCertificateNumber: '',
        certificateExpiry: ''
      },
      rtw: {
        type: '',
        validityType: '',
        groupName: '',
        onlineExpiry: ''
      },
      passport: { expiry: '' },
      licence:  { expiry: '' },
      address:  { issued: '' },
      occHealth:{ issued: '', expiry: '' },
      pmva:     { issued: '', expiry: '', trainingProvider: '', certificateNumber: '' },
      hasConviction: false,
      _overrides: { dbsConviction: '' }
    };
    const alerts = [];
    let blockSend = false;

    // 1) Fetch Documents (APPROVED-only helper)
    const docs = fetchDocumentsApproved_(publicId, { ...baseCtx, step: 'Documents API (APPROVED only)' });

    // 1a) NI from Questionnaires (FIRST)
    const qni = fetchNiFromQuestionnaires_(publicId, { ...baseCtx, step: 'NI: questionnaires' });
    if (qni && qni.isValid && qni.ni) {
      summary.niNumber = qni.ni;
    } else if (qni && qni.ni && !qni.isValid) {
      alerts.push('NI Number missing or incorrect.');
    }

    // 2) Identity & common documents
    const passportDoc = findDocByKeyOrName_(docs, 'passport', 'passport');
    if (passportDoc) {
      summary.passport.expiry = pickDate(passportDoc?.activeFile?.expiry);
      tryAttachDoc_(passportDoc, 'Passport', fullName, baseCtx, attachments, attachedFileIds, includedDocLabels, surname, firstName);
    }

    // --- DRIVING LICENCE (capture bytes for POA dedup later) ---
    const licenceDoc = findDocByKeyOrName_(docs, 'driving_licence', 'driving licence');
    let dlDedupBytes = null;
    let dlSourceFileId = null;

    const pickApprovedFileForDoc_ = (doc) => {
      const isApproved = (fileObj) => {
        const verifs = Array.isArray(fileObj?.verifications) ? fileObj.verifications : [];
        return verifs.some(v => String(v?.verificationType || '').toUpperCase() === 'APPROVED');
      };
      if (doc?.activeFile && isApproved(doc.activeFile)) return doc.activeFile;
      if (Array.isArray(doc?.files) && doc.files.length) {
        const approved = doc.files
          .filter(isApproved)
          .sort((a, b) => new Date(b.created || b.issued || 0) - new Date(a.created || a.issued || 0));
        if (approved.length) return approved[0];
      }
      return null;
    };

    if (!licenceDoc) {
      const licenceAlt = docs
        .filter(d => /driv(ing|er)/i.test(d?.type?.name || '') || /licen[cs]e/i.test(d?.type?.name || ''))
        .sort((a, b) => new Date(b?.activeFile?.created || 0) - new Date(a?.activeFile?.created || 0))[0];

      if (licenceAlt) {
        summary.licence.expiry = pickDate(licenceAlt?.activeFile?.expiry);
        try {
          const f = pickApprovedFileForDoc_(licenceAlt);
          if (f && f.id != null) {
            const probe = httpGetBlob_(
              `${API_BASE}/files/${f.id}`,
              'DL_PROBE',
              null,
              { ...baseCtx, step: 'DL DEDUP PROBE (download APPROVED)' }
            );
            if (probe && probe.ok && probe.blob) {
              dlDedupBytes = (probe.blob.getBytes() || []).length;
              dlSourceFileId = String(f.id);
            }
          }
        } catch (e) {}
        tryAttachDoc_(licenceAlt, 'DL or POA', fullName, baseCtx, attachments, attachedFileIds, includedDocLabels, surname, firstName);
      }
    } else {
      summary.licence.expiry = pickDate(licenceDoc?.activeFile?.expiry);
      try {
        const f = pickApprovedFileForDoc_(licenceDoc);
        if (f && f.id != null) {
          const probe = httpGetBlob_(`${API_BASE}/files/${f.id}`, 'DL_PROBE', null, { ...baseCtx, step: 'DL DEDUP PROBE (download APPROVED)' });
          if (probe && probe.ok && probe.blob) {
            dlDedupBytes = (probe.blob.getBytes() || []).length;
            dlSourceFileId = String(f.id);
          }
        }
      } catch (e) {}
      tryAttachDoc_(licenceDoc, 'DL or POA', fullName, baseCtx, attachments, attachedFileIds, includedDocLabels, surname, firstName);
    }

    // ------------- PROOF OF ADDRESS (attach 2; skip if identical to DL) -------------
    const addressDoc = findDocByKeyOrName_(docs, 'proof_of_address', 'proof of address');
    if (addressDoc) {
      summary.address.issued = pickDate(addressDoc?.activeFile?.issued);
      const ctxWithDedup = { ...baseCtx, dlDedupBytes, dlDedupFileId: dlSourceFileId, step: 'POA attach (with DL dedup hint)' };
      attachProofOfAddressPair_(addressDoc, fullName, ctxWithDedup, attachments, attachedFileIds, includedDocLabels, surname, firstName);
    }

    // Occupational Health — keep in summary but DO NOT attach
    const occDoc = findDocByKeyOrName_(docs, 'certificate_from_occupational_health', 'occupational health');
    if (occDoc) {
      summary.occHealth.issued = pickDate(occDoc?.activeFile?.issued);
      summary.occHealth.expiry = pickDate(occDoc?.activeFile?.expiry);
    }

    // PMVA / Physical Restraint Awareness
    const pmvaCandidates = (() => {
      const out = [];
      for (const d of docs) {
        const key = normalize(d?.type?.key || '');
        const name = normalize(d?.type?.name || '');
        if (
          key.includes('physical_restraint_awareness') ||
          key.includes('pmva') ||
          name.includes('physical restraint') ||
          name.includes('pmva') ||
          name.includes('breakaway') ||
          name.includes('physical skills')
        ) out.push(d);
      }
      return out;
    })();
    let pmvaDoc = null;
    if (pmvaCandidates.length) {
      const withApproved = pmvaCandidates.filter(d => d?.hasApproved);
      const pool = withApproved.length ? withApproved : pmvaCandidates;
      pmvaDoc = pool.sort((a, b) => new Date(b?.activeFile?.created || 0) - new Date(a?.activeFile?.created || 0))[0];
    }
    if (pmvaDoc && pmvaDoc.hasApproved) {
      // Read details from the APPROVED anchor file (issue, expiry, provider from comments, certificate number)
      try {
        const f = pickApprovedFileForDoc_(pmvaDoc) || pmvaDoc.activeFile || null;
        if (f) {
          summary.pmva.issued            = pickDate(f.issued || '');
          summary.pmva.expiry            = pickDate(f.expiry || '');
          summary.pmva.certificateNumber = String(f.documentNumber || '').trim();
          // newest non-empty comment = training provider
          let provider = '';
          const comments = Array.isArray(f.comments) ? f.comments.slice() : [];
          if (comments.length) {
            comments.sort((a, b) => new Date(b.created || 0) - new Date(a.created || 0));
            const hit = comments.find(c => c && String(c.message || '').trim().length);
            if (hit) provider = String(hit.message).trim();
          }
          summary.pmva.trainingProvider = provider;
        }
      } catch (e) {}
      // Attach PMVA certificate as before
      tryAttachDoc_(pmvaDoc, 'PMVA Certificate', fullName, baseCtx, attachments, attachedFileIds, includedDocLabels, surname, firstName);
    }

    // Passport style photo — used in the Checklist docs; DO NOT attach to email
    const photoDoc = findDocByKeyOrName_(docs, 'passport_style_photo', 'passport style photo');

    // ─────────────────────────────────────────────────────────────
    // HEADSHOT: process ONCE per candidate and reuse in all doc flows
    // ─────────────────────────────────────────────────────────────
    let headshotBlob = null;
    try {
      if (photoDoc && photoDoc.activeFile && photoDoc.activeFile.id) {
        const acquire = getPassportPhotoImageForChecklist_(photoDoc, fullName, { ...baseCtx, step: 'HEADSHOT: acquire source' });
        if (acquire && acquire.ok && acquire.blob) {
          const svc = callHeadshotService_(acquire.blob, { ...baseCtx, step: 'HEADSHOT: service' });
          if (svc && svc.ok && svc.blob) {
            headshotBlob = svc.blob;
          } else {
            try {
              headshotBlob = centerCropToIdAspect_(acquire.blob);
            } catch (cropErr) {}
          }
        }
      }
    } catch (e) {}

    // 3) Right to Work
    const rtw = fetchRightToWork_(publicId, baseCtx);
    if (rtw.ok) {
      const rtwInfo = extractRtWInfo_(rtw);
      summary.rtw.type = rtwInfo.type || '';
      summary.rtw.validityType = rtwInfo.validityType || '';
      summary.rtw.groupName = rtwInfo.groupName || '';

      if (normalize(summary.rtw.type) !== 'passed') {
        alerts.push('RTW not confirmed - check passport');
      }
      if (normalize(summary.rtw.validityType) !== 'permanent') {
        (rtwInfo.configItems || [])
          .filter(x => x.documentPublicId)
          .forEach(x => {
            const refDoc = findDocByPublicId_(docs, x.documentPublicId);
            if (refDoc) {
              tryAttachDoc_(refDoc, 'RTW Document', fullName, baseCtx, attachments, attachedFileIds, includedDocLabels, surname, firstName);
            }
          });
      }

      const onlineRtwDoc = findDocByKeyOrName_(docs, 'online_right_to_work_check', 'online right to work');
      if (onlineRtwDoc) {
        summary.rtw.onlineExpiry = pickDate(onlineRtwDoc?.activeFile?.expiry);
        tryAttachDoc_(onlineRtwDoc, 'Online Right to Work Check', fullName, baseCtx, attachments, attachedFileIds, includedDocLabels, surname, firstName);
      }
    }

    // 4) DBS Update & Certificate
    const dbsCandidates = (() => {
      const out = [];
      for (const d of docs) {
        const k = normalize(d?.type?.key || '');
        const n = normalize(d?.type?.name || '');
        const looksDbs = k.includes('dbs') || k.includes('disclosure') || n.includes('dbs') || n.includes('disclosure');
        const isUpdateServiceCheck =
          n.includes('update service check') ||
          n.includes('registered on the update service') ||
          k.includes('dbs_update_service') ||
          k.includes('update_service');
        if (looksDbs && !isUpdateServiceCheck) out.push(d);
      }
      return out;
    })();

    let dbsDoc = null;
    if (dbsCandidates.length) {
      const withApproved = dbsCandidates.filter(d => d?.hasApproved);
      const pool = withApproved.length ? withApproved : dbsCandidates;
      dbsDoc = pool.sort((a, b) => new Date(b?.activeFile?.created || 0) - new Date(a?.activeFile?.created || 0))[0];
    }

    if (dbsDoc) {
      summary.dbs.certificateExpiry = pickDate(dbsDoc?.activeFile?.expiry);
      const providedNo = extractCertificateNumberFromDoc_(dbsDoc);
      summary.dbs.providedCertificateNumber = providedNo;
    }

    const dbsList = listDbsRecords_(publicId, baseCtx);
    let hasUpdateService = false;
    // helpers for status normalization
    const isConvictionStatus_ = (s) => {
      const n = normalize(s);
      return n === 'new_info' || n === 'non_blank_no_new_info';
    };
    const isBlankStatus_ = (s) => normalize(s) === 'blank_no_new_info';
    const isNoMatch_ = (s) => normalize(s) === 'no_match_found';

    // Variables for history-based logic
    let mostRecentStatusNorm = '';
    let lastSuccessfulBlankDateIso = ''; // ISO string from lastCheckDateTime
    let historyHasNonBlankConviction = false;

    // Track "most recent DBS detail was BLANK" for later comparison with questionnaire
    let _mostRecentWasBlank = false;

    if (dbsList.ok) {
      const items = Array.isArray(dbsList.data) ? dbsList.data : (dbsList.data?.items || []);
      if (Array.isArray(items) && items.length) {
        // pick most recent by lastCheckDateTime
        let chosen = items[0];
        items.forEach(it => {
          const a = new Date(chosen?.lastCheckDateTime || 0).getTime();
          const b = new Date(it?.lastCheckDateTime || 0).getTime();
          if (b > a) chosen = it;
        });

        // compute history features
        mostRecentStatusNorm = normalize(chosen?.status || '');
        historyHasNonBlankConviction = items.some(it => isConvictionStatus_(it?.status));

        // find most recent BLANK_NO_NEW_INFO
        let lastBlank = null;
        for (const it of items) {
          if (isBlankStatus_(it?.status)) {
            if (!lastBlank || new Date(it.lastCheckDateTime || 0) > new Date(lastBlank.lastCheckDateTime || 0)) {
              lastBlank = it;
            }
          }
        }
        if (lastBlank) {
          lastSuccessfulBlankDateIso = String(lastBlank.lastCheckDateTime || '');
        }
        // Most recent successful (non-NO_MATCH_FOUND) Update Service check
        let lastSuccessfulCheckIso = '';
        for (const it of items) {
          if (!isNoMatch_(it?.status)) {
            if (!lastSuccessfulCheckIso || new Date(it.lastCheckDateTime || 0) > new Date(lastSuccessfulCheckIso || 0)) {
              lastSuccessfulCheckIso = String(it.lastCheckDateTime || '');
            }
          }
        }
        // Pretty date for checklist placeholders
        summary.dbs.lastSuccessfulCheckDate = lastSuccessfulCheckIso ? pickDate(lastSuccessfulCheckIso) : '';

        // Fetch detail for the chosen record
        const detail = fetchDbsDetail_(publicId, chosen.id, baseCtx);
        if (detail.ok) {
          const d = detail.data || {};
          summary.dbs.updateCertificateNumber = d.certificateNumber || '';
          summary.dbs.updateStatus = d.status || '';
          summary.dbs.lastCheckDateTime = pickDateTime(d.lastCheckDateTime || '');

          // Determine Update Service membership strictly by MOST RECENT status
          hasUpdateService = !isNoMatch_(chosen?.status || '');

          // Persist most-recent membership & status into summary for downstream helpers
          summary.dbs.onUpdateService = hasUpdateService;
          summary.dbs.mostRecentStatus = normalize(chosen?.status || '');

          // Alerts for conviction statuses from most recent detail
          const detailStatusNorm = normalize(d.status || '');

          // Remember if most-recent Update Service result was BLANK (no new info)
          _mostRecentWasBlank = (detailStatusNorm === 'blank_no_new_info');

          if (detailStatusNorm === 'new_info') {
            alerts.push('Candidate Update Service shows a new conviction — do not submit; they need to do a new DBS application.');
          } else if (isConvictionStatus_(detailStatusNorm)) {
            alerts.push(`RED: DBS Certificate has a conviction. Will need client approval before candidate can work. (Status: ${summary.dbs.updateStatus})`);
          }

          // Certificate number mismatch
          if (summary.dbs.providedCertificateNumber && summary.dbs.updateCertificateNumber &&
              String(summary.dbs.providedCertificateNumber).trim() !== String(summary.dbs.updateCertificateNumber).trim()) {
            alerts.push('Certificate number provided does not match Update Service certificate.');
          }
        }
      }
    }

    // 5) NMC & NI
    const nmcNi = fetchNmcAndNi_(publicId, { ...baseCtx, step: 'NMC/NI aggregate' }, { existingNi: summary.niNumber });
    if (!summary.niNumber && nmcNi.niNumber) {
      const v = validateAndNormalizeNi_(nmcNi.niNumber);
      if (v.isValid) {
        summary.niNumber = v.ni;
      } else {
        alerts.push('NI Number missing or incorrect.');
      }
    } else if (!summary.niNumber) {
      alerts.push('NI Number missing or incorrect.');
    }

    if (summary.nmc.include) {
      summary.nmc.registrationNumber   = nmcNi.registrationNumber || '';
      summary.nmc.status               = nmcNi.status || '';
      summary.nmc.abbreviation         = nmcNi.abbreviation || '';
      summary.nmc.birthDate            = nmcNi.birthDate || '';
      summary.nmc.lastCheckDateTime    = nmcNi.lastCheckDateTime || '';
      summary.nmc.feeExpiryDateIso     = nmcNi.feeExpiryDateIso || '';
      summary.nmc.feeExpiryDateHyphen  = nmcNi.feeExpiryDateHyphen || '';
      summary.nmc.comment              = nmcNi.comment || '';

      const nmcComment = (summary.nmc.comment || '').trim();
      if (nmcComment) {
        if (nmcComment.toLowerCase() === 'lapsed') {
          alerts.push('RED: Candidate NMC Registration has Lapsed - Do not send checklist');
          blockSend = true;
        } else if (nmcComment.toLowerCase() !== 'registered') {
          alerts.push(`RED: Comment under NMC registration – ${summary.nmc.comment}. Review the checklist – you may need to add cautions to this applicant’s checklist and request authorisation to use this candidate.`);
        }
      }
    }

    // 5.1) DOB + Email + conviction answer
    let dobIso = '', dobHyphen = '', emailFromQ = '';
    let criminalAnswerTrue = false;
    try {
      const qres = httpGetJson_(
        `${API_BASE}/v1/employees/${publicId}/questionnaires`,
        { ...baseCtx, step: 'DOB/Email/Conviction: questionnaires GET' }
      );

      // Log full dump from Credentially questionnaires API to Logs sheet
      // (logging removed)

      if (qres.ok && Array.isArray(qres.data)) {
        const answers = [];
        for (const q of qres.data) {
          const completed = q?.completed || '';
          if (Array.isArray(q?.answers)) {
            for (const a of q.answers) {
              answers.push({
                id: a?.id || 0,
                question: String(a?.question || ''),
                answer: a?.answer || '',
                completed
              });
            }
          }
        }

        const byMostRecent = (a, b) => {
          const ta = new Date(a.completed || 0).getTime();
          const tb = new Date(b.completed || 0).getTime();
          if (tb !== ta) return tb - ta;
          return (b.id || 0) - (a.id || 0);
        };

        const dobHit = answers
          .filter(it => String(it.question).toLowerCase().includes('date of birth'))
          .sort(byMostRecent)[0];

        if (dobHit && dobHit.answer) {
          const raw = String(dobHit.answer).trim().replace(/^"|"$/g, '');
          if (raw) {
            // Normalise separators so we can handle 11/12/1964, 11-12-1964, 11.12.1964
            const norm = raw.replace(/[.\-]/g, '/');
            let dd = '', mm = '', yyyy = '';

            // 1) ISO-style yyyy/mm/dd
            let m = norm.match(/^(\d{4})\/(\d{2})\/(\d{2})$/);
            if (m) {
              yyyy = m[1];
              mm   = m[2];
              dd   = m[3];
            } else {
              // 2) DD/MM/YYYY (our expected questionnaire format)
              m = norm.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
              if (m) {
                dd   = m[1];
                mm   = m[2];
                yyyy = m[3];
              }
            }

            if (yyyy) {
              dd = dd.padStart(2, '0');
              mm = mm.padStart(2, '0');
              dobIso    = `${yyyy}-${mm}-${dd}`;   // canonical ISO if needed
              dobHyphen = `${dd}-${mm}-${yyyy}`;   // DD-MM-YYYY for the checklist
            } else {
              // Fallback: keep raw, just swap / to - for hyphen form
              dobIso    = raw;
              dobHyphen = raw.replace(/\//g, '-');
            }
          }
        }

        const emailHit = answers
          .filter(it => String(it.question).toLowerCase().includes('email address'))
          .sort(byMostRecent)[0];
        if (emailHit && emailHit.answer) {
          emailFromQ = String(emailHit.answer).trim().replace(/^"|"$/g, '');
        }

        const convHit = answers
          .filter(it => /criminal offence|bound over|cautioned|police investigations/i.test(it.question))
          .sort(byMostRecent)[0];
        if (convHit && typeof convHit.answer !== 'undefined') {
          criminalAnswerTrue = String(convHit.answer).trim().toLowerCase() === 'true';
        }
      }
    } catch (e) {}

    // === NEW: resolve canonical DOB (NMC → Employee → Questionnaire) + log all three ===
    const canonicalDob = resolveCanonicalDob_(
      {
        nmcInclude: !!summary.nmc.include
      },
      {
        // NMC DOB from fetchNmcAndNi_ (raw if available, otherwise fall back to pretty)
        nmcBirthRaw: (nmcNi && (nmcNi.nmcBirthRaw || nmcNi.birthDate || '')) || '',
        // Core employee birthDate from /v1/employees (YYYY-MM-DD)
        employeeBirthIso: (nmcNi && nmcNi.employeeBirthIso) || ''
      },
      {
        qDobIso: dobIso,
        qDobHyphen: dobHyphen
      }
    );

    // Overwrite summary + questionnaire DOBs with canonical values
    if (canonicalDob.display) {
      summary.nmc.birthDate = canonicalDob.display;
    }
    if (canonicalDob.iso) {
      dobIso = canonicalDob.iso;
    }
    if (canonicalDob.hyphen) {
      dobHyphen = canonicalDob.hyphen;
    }

    // Log the comparison so you can see NMC vs Employee vs Questionnaire and the chosen canonical
    // (logging removed)

    // 5.2) Compute hasConviction (via Update Service status OR questionnaire YES)
    // NOTE: treat only NEW_INFO / NON_BLANK_NO_NEW_INFO as conviction-indicative.
    const updateStatusNorm = normalize(summary.dbs.updateStatus || '');

    // Recent BLANK + Questionnaire = YES → clarify discrepancy
    if (_mostRecentWasBlank && criminalAnswerTrue) {
      alerts.push('No conviction on DBS Update Service but candidate declared conviction in Application Form. Check with candidate before proceeding.');
    }

    const updateIndicatesConviction = (updateStatusNorm === 'new_info' || updateStatusNorm === 'non_blank_no_new_info');
    summary.hasConviction = !!(criminalAnswerTrue || updateIndicatesConviction || historyHasNonBlankConviction);

    // ── Not on Update Service special cases (and new window logic) ──
    const notOnUpdateService = !hasUpdateService;
    if (notOnUpdateService) {
      // Always note they are no longer on the Update Service
      alerts.push('Candidate no longer on Update Service.');

      // If no conviction evidence anywhere:
      if (!criminalAnswerTrue && !historyHasNonBlankConviction) {
        if (lastSuccessfulBlankDateIso) {
          // derive valid-until = lastBlank + 364 days
          const lastBlankDt = new Date(lastSuccessfulBlankDateIso);
          const validUntilDt = new Date(lastBlankDt.getTime());
          validUntilDt.setDate(validUntilDt.getDate() + 364);
          const lastBlankPretty = pickDate(lastSuccessfulBlankDateIso);
          const validUntilPretty = pickDate(validUntilDt.toISOString());

          const today = new Date();
          if (today.getTime() <= validUntilDt.getTime()) {
            alerts.push(`Last Update Service check with no convictions was ${lastBlankPretty} — candidate can work up to ${validUntilPretty}.`);
          } else {
            alerts.push('RED: Candidate no longer on Update Service and last update service check was over 1 year ago — not eligible to work. Withdraw candidate.');
          }
        } else {
          alerts.push('RED: No previous update service check has been completed — unless the certificate is an Arthur Rai certificate dated within the last year this candidate is not eligible to work.');
        }
      }

      // Preserve existing override branch for checklist fields
      if (!criminalAnswerTrue) {
        summary._overrides.dbsConviction = 'NO';
        alerts.push('RED: The candidate has declared NO convictions so we have put NO on the checklist about convictions however the candidate is not on the update service. Please check the DBS certificate manually and confirm that they have no convictions (I have attached the DBS certificate for your review).');
        if (dbsDoc) {
          try {
            const sel = selectDbsAnchorAndGroup_(dbsDoc, { ...baseCtx, step: 'DBS: attach (not on update, declared NO)' });
            if (sel && sel.ok) {
              const standardizedName = `DBS Certificate - ${surname} ${firstName}.pdf`;
              attachDbsCertificateFromGroup_(sel.group, standardizedName, { ...baseCtx, step: 'DBS ATTACH (declared NO, no update svc)' }, attachments, includedDocLabels, alerts, fullName, publicId);
            } else {
              alerts.push('RED: Checklist not fully completed - Missing Value: DBS Certificate (file not found/attached)');
            }
          } catch (e) {
            alerts.push('RED: Checklist not fully completed - Missing Value: DBS Certificate (file not found/attached)');
          }
        } else {
          alerts.push('RED: Checklist not fully completed - Missing Value: DBS Certificate (file not found/attached)');
        }
      } else {
        summary._overrides.dbsConviction = 'YES';
      }
    }

    // 5.2a) If convicted, attach DBS certificate and Personal Statement
    let issueIssuerFromAttach = { issueDateIso: '', issuedBy: '' };
    if (summary.hasConviction) {
      if (!dbsDoc) {
        alerts.push('RED: This candidate has a criminal conviction, but there is no DBS document entry on file.');
      } else {
        const sel = selectDbsAnchorAndGroup_(dbsDoc, { ...baseCtx, step: 'DBS: anchor+group (conviction)' });
        if (!sel.ok) {
          alerts.push('RED: No usable DBS certificate files (PDF or images) found to attach, but conviction is present.');
        } else {
          const standardizedName = `DBS Certificate - ${surname} ${firstName}.pdf`;
          attachDbsCertificateFromGroup_(sel.group, standardizedName, { ...baseCtx, step: 'DBS ATTACH (conviction)' }, attachments, includedDocLabels, alerts, fullName, publicId);
          issueIssuerFromAttach.issueDateIso = sel.issueDateIso || '';
          issueIssuerFromAttach.issuedBy    = sel.issuedBy || '';
        }
        attachCriminalPersonalStatementOrAlert_(docs, { firstName, surname }, { ...baseCtx, step: 'Criminal PS' }, attachments, includedDocLabels, alerts);
      }
    }

    // 5.3) Derive DBS Issue Date & "Issued by"  (APPROVED-ONLY & DISCLOSURE SECTION ONLY)
    let dbsIssueDateIso = issueIssuerFromAttach.issueDateIso || '';
    let derivedDbsIssuedBy = issueIssuerFromAttach.issuedBy || ''; // do NOT pre-default; default to ARMSL only at the end
    let dbsIssueDateSource = dbsIssueDateIso ? 'attach' : '';
    let dbsIssuedBySource  = derivedDbsIssuedBy ? 'attach' : '';

    try {
      if (dbsDoc) {
        // Build APPROVED-only pool from THIS Disclosure document
        const isApproved = (fileObj) => {
          const verifs = Array.isArray(fileObj?.verifications) ? fileObj.verifications : [];
          return verifs.some(v => String(v?.verificationType || '').toUpperCase() === 'APPROVED');
        };

        let pool = [];
        let af = null;
        try {
          const filesArray = Array.isArray(dbsDoc.files) ? dbsDoc.files.slice() : [];
          af = dbsDoc.activeFile || null;
          if (af && !filesArray.some(f => String(f.id) === String(af.id))) filesArray.push(af);
          pool = filesArray.filter(isApproved);
        } catch (_) {
          pool = [];
        }

        if (pool.length) {
          // newest-first by created
          pool.sort((a, b) => new Date(b.created || 0) - new Date(a.created || 0));
          const anchor = pool[0];
          if (dbsIssueDateIso) {}

          // Issue Date selection (APPROVED only)
          if (!dbsIssueDateIso && String(anchor.issued || '').trim()) {
            dbsIssueDateIso = anchor.issued;
            dbsIssueDateSource = 'anchor';
          }
          if (!dbsIssueDateIso && af && isApproved(af) && String(af.issued || '').trim()) {
            dbsIssueDateIso = af.issued;
            dbsIssueDateSource = 'activeFile';
          }
          if (!dbsIssueDateIso) {
            const rest = pool.slice(1);
            const olderWithIssued = rest.find(f => String(f.issued || '').trim());
            if (olderWithIssued) {
              dbsIssueDateIso = olderWithIssued.issued;
              dbsIssueDateSource = 'olderApproved';
            }
          }

          // Issued By selection (APPROVED only) – only if not already from attach:
          if (!derivedDbsIssuedBy) {
            const commentsFrom = (f) => (Array.isArray(f?.comments) ? f.comments.slice() : []);
            let candidateIssuer = '';
            // Try newest non-empty comment on anchor or approved activeFile
            const anchorComments = commentsFrom(anchor);
            const afComments = commentsFrom(af && isApproved(af) ? af : {});
            const combined = anchorComments.concat(afComments);
            combined.sort((a, b) => new Date(b.created || 0) - new Date(a.created || 0));
            const hit = combined.find(c => c && String(c.message || '').trim().length);
            if (hit && hit.message) {
              candidateIssuer = String(hit.message).trim();
              dbsIssuedBySource = (anchorComments.includes(hit) ? 'anchorComment' : 'activeFileComment');
            }

            // If still blank, scan the rest of the approved pool (newest→older)
            if (!candidateIssuer) {
              for (const f of pool) {
                const cs = commentsFrom(f);
                cs.sort((a, b) => new Date(b.created || 0) - new Date(a.created || 0));
                const h = cs.find(c => c && String(c.message || '').trim().length);
                if (h && h.message) { candidateIssuer = String(h.message).trim(); dbsIssuedBySource = 'poolComment'; break; }
              }
            }

            if (candidateIssuer) {
              derivedDbsIssuedBy = candidateIssuer;
            }
          }
        } else {
          // No APPROVED files in Disclosure section
        }
      }
    } catch (e) {}

    // SPECIAL CASE: DBS Issue Date missing => attach DBS cert (if possible) + tailored alert text
    function _dbsCertAlreadyAttached() {
      try {
        return (includedDocLabels || []).some(l => String(l || '').toLowerCase().indexOf('dbs certificate') !== -1);
      } catch (_) { return false; }
    }

    if (!String(dbsIssueDateIso || '').trim()) {
      if (dbsDoc && !_dbsCertAlreadyAttached()) {
        try {
          const sel = selectDbsAnchorAndGroup_(dbsDoc, { ...baseCtx, step: 'DBS ATTACH (missing issue date)' });
          if (sel && sel.ok) {
            const standardizedName = `DBS Certificate - ${surname} ${firstName}.pdf`;
            attachDbsCertificateFromGroup_(sel.group, standardizedName, { ...baseCtx, step: 'DBS ATTACH (missing issue date)' }, attachments, includedDocLabels, alerts, fullName, publicId);
            // Propagate parsed values from the group if available
            if (sel.issueDateIso && !dbsIssueDateIso) {
              dbsIssueDateIso = sel.issueDateIso;
              dbsIssueDateSource = 'attachedParse';
            }
            if (sel.issuedBy && !derivedDbsIssuedBy) {
              derivedDbsIssuedBy = sel.issuedBy;
              dbsIssuedBySource = 'attachedParse';
            }
          } else {
          }
        } catch (e) {}
      }
      // If still blank after attach parsing, push alert
      if (!String(dbsIssueDateIso || '').trim()) {
        alerts.push('RED: Checklist not fully completed - Missing Value: DBS Issue Date — I have included the DBS Certificate in this email for you to extract the issue date');
      }
    }

    // Only now, if issuer is still blank after all approved-file attempts, default to ARMSL
    if (!derivedDbsIssuedBy) {
      derivedDbsIssuedBy = 'Arthur Rai Medical Services Limited';
      dbsIssuedBySource = 'default';
    }
    // RED employer-name checks when not on Update Service
    if (!hasUpdateService) {
      if (summary.dbs.lastSuccessfulCheckDate) {
        alerts.push(`RED: Check the name of the Employer on the DBS Certificate matches ${derivedDbsIssuedBy}, and if not change it.`);
      } else {
        alerts.push('RED: Check the name of the Employer is Arthur Rai Medical Services on the DBS Certificate, if not, candidate is not able to work, withdraw candidate.');
      }
    }

    // ─────────────────────────────────────────────────────────────
    // Generic “Missing Value” alerts (true blanks only)
    // ─────────────────────────────────────────────────────────────
    function addMissingIfBlank(fieldLabel, value) {
      const v = (value == null) ? '' : String(value).trim();
      if (!v) alerts.push(`RED: Checklist not fully completed - Missing Value: ${fieldLabel}`);
    }

    // All workers
    addMissingIfBlank('First Name', firstName);
    addMissingIfBlank('Surname', surname);
    addMissingIfBlank('NI Number', summary.niNumber);
    addMissingIfBlank('Date of Birth', (dobHyphen || dobIso));
    addMissingIfBlank('Gender', gender);

    const anyDbsCertNumber = (summary.dbs.updateCertificateNumber || summary.dbs.providedCertificateNumber || '').trim();
    addMissingIfBlank('DBS Certificate', anyDbsCertNumber);

    addMissingIfBlank('DBS Update Service Date checked', summary.dbs.lastSuccessfulCheckDate);

    // For DBS Conviction blank when not on update service and no questionnaire YES
    const hasConvictionOverride = !!(summary._overrides && summary._overrides.dbsConviction);
    if (!hasConvictionOverride && !summary.hasConviction && !hasUpdateService) {
      addMissingIfBlank('DBS Conviction', '');
    }

    // OH alerts
    addMissingIfBlank('OH Issue Date', summary.occHealth.issued);

    // PMVA alerts
    addMissingIfBlank('PMVA Issue Date', summary.pmva.issued);
    addMissingIfBlank('PMVA Expiry Date', summary.pmva.expiry);
    addMissingIfBlank('PMVA Training Provider', summary.pmva.trainingProvider);
    addMissingIfBlank('PMVA Certificate Number', summary.pmva.certificateNumber);

    // Not HCAs
    const notHca = !!summary.nmc.include;
    if (notHca) {
      addMissingIfBlank('NMC (registration number)', summary.nmc.registrationNumber);
      const nmcExpiry = summary.nmc.feeExpiryDateHyphen || summary.nmc.feeExpiryDateIso;
      if (!(nmcExpiry || '').trim()) addMissingIfBlank('NMC EXPIRY', '');
      addMissingIfBlank('NMC WARNING', (summary.nmc.comment || '').trim());
    }

    // 6) Build docs (reuse single headshot)
    try {
      if (!blockSend) {
        const personForDoc = { firstName, surname, jobTitle, fullName };

        // Compliance Checklist
        const runRes = runChecklistDocumentFlowForPerson_(
          personForDoc,
          summary,
          {
            publicId,
            ctx: baseCtx,
            email: emailFromQ || '',
            dobIso: dobIso || '',
            dobHyphen: dobHyphen || '',
            gender: gender || '',
            dbsIssueDateIso: dbsIssueDateIso || (dbsDoc?.activeFile?.issued || ''),
            dbsIssuedBy: derivedDbsIssuedBy || '',
            docs,
            photoDoc,
            headshotBlob,          // ← reuse
            attachments,
            includedDocLabels,
            overrides: summary._overrides || {}
          }
        );

        // PMVA Checklist
        try {
          const pmvaRes = runPmvaChecklistDocumentFlowForPerson_(
            personForDoc,
            summary,
            {
              publicId,
              ctx: baseCtx,
              docs,
              photoDoc,             // kept for fallback logic in the flow, if any
              headshotBlob,         // ← reuse
              attachments,          // push exported file buffer(s) here (DOCX for PMVA)
              includedDocLabels
            }
          );
          if (pmvaRes && pmvaRes.ok) {
            includedDocLabels.push('PMVA Checklist');
          }
        } catch (e) {}
      }
    } catch (e) {}

    // 7) Build and send email (via webhook)
    const person = { fullName, jobTitle };
    const distinctLabels = includedDocLabelsDistinct_(includedDocLabels);

    if (!blockSend) {
      // Compute pretty fields BEFORE building HTML so it can render them
      const lastSuccessfulBlankPretty = lastSuccessfulBlankDateIso ? pickDate(lastSuccessfulBlankDateIso) : '';
      let validUntilFromLastBlankIso = '';
      let validUntilFromLastBlankPretty = '';
      if (lastSuccessfulBlankDateIso) {
        const lastBlankDt = new Date(lastSuccessfulBlankDateIso);
        const validUntilDt = new Date(lastBlankDt.getTime());
        validUntilDt.setDate(validUntilDt.getDate() + 364);
        validUntilFromLastBlankIso = validUntilDt.toISOString();
        validUntilFromLastBlankPretty = pickDate(validUntilFromLastBlankIso);
      }

      // Expose to HTML builder
      summary.dbs.lastSuccessfulBlankDate = lastSuccessfulBlankPretty;
      summary.dbs.validUntilFromLastBlank = validUntilFromLastBlankPretty;

      const html = buildChecklistHtml_(person, summary, alerts, distinctLabels);
      const subject = `Compliance checklist: ${fullName}`;

      try {
        const attachmentsV2 = (attachments || []).map(b => {
          let name = 'attachment';
          try { name = b.getName() || 'attachment'; } catch (_) {}
          let bytes = [];
          try { bytes = b.getBytes(); } catch (_) { bytes = []; }
          const base64 = Utilities.base64Encode(bytes);
          return { Name: String(name), ContentBytes: String(base64) };
        }).filter(a => a.ContentBytes);

        const resp = postToDoPostSendEmail(
          resolvedRecipient,
          subject,
          '',
          {
            htmlBody: html,
            attachmentsV2,
            metadata: {
              publicId,
              fullName,
              jobTitle,
              alerts,
              includedDocs: distinctLabels,
              hasConviction: !!summary.hasConviction,
              nmc: {
                registrationNumber: summary.nmc.registrationNumber || '',
                status: summary.nmc.status || '',
                abbreviation: summary.nmc.abbreviation || '',
                feeExpiryDate: summary.nmc.feeExpiryDateHyphen || ''
              },
              dbs: {
                providedCertificateNumber: summary.dbs.providedCertificateNumber || '',
                updateCertificateNumber: summary.dbs.updateCertificateNumber || '',
                updateStatus: summary.dbs.updateStatus || '',
                lastCheckDateTime: summary.dbs.lastCheckDateTime || '',
                certificateExpiry: summary.dbs.certificateExpiry || '',
                onUpdateService: !(!hasUpdateService), // boolean
                lastSuccessfulBlankDate: lastSuccessfulBlankPretty || '',
                validUntilFromLastBlank: validUntilFromLastBlankPretty || ''
              },
              rtw: {
                type: summary.rtw.type || '',
                validityType: summary.rtw.validityType || '',
                groupName: summary.rtw.groupName || '',
                onlineExpiry: summary.rtw.onlineExpiry || ''
              },
              pmva: {
                issued: summary.pmva.issued || '',
                expiry: summary.pmva.expiry || '',
                trainingProvider: summary.pmva.trainingProvider || '',
                certificateNumber: summary.pmva.certificateNumber || ''
              },
              route: { requesterEmail: requesterEmail, recipient: resolvedRecipient },
              overrides: summary._overrides || {}
            }
          }
        );
      } catch (e) {}
    }
  });
}

/**
 * Resolve a canonical DOB for a candidate, preferring NMC when available
 * and falling back to questionnaire DOB. Returns:
 * {
 *   iso: 'YYYY-MM-DD' | '',
 *   display: 'DD/MM/YYYY' | '',
 *   hyphen: 'DD-MM-YYYY' | '',
 *   source: 'NMC' | 'QUESTIONNAIRE' | 'UNKNOWN',
 *   nmc: { iso, display, hyphen },
 *   q:   { iso, hyphen }
 * }
 */
/**
 * Resolve a canonical DOB for a candidate with this precedence:
 *   1) NMC DOB (if candidate is an NMC worker and NMC DOB exists)
 *   2) Core employee.birthDate from /v1/employees
 *   3) Questionnaire DOB (Occupational Health etc) as a last resort
 *
 * Returns:
 * {
 *   iso: 'YYYY-MM-DD' | '',
 *   display: 'DD/MM/YYYY' | '',
 *   hyphen: 'DD-MM-YYYY' | '',
 *   source: 'NMC' | 'EMPLOYEE' | 'QUESTIONNAIRE' | 'UNKNOWN',
 *   nmc:      { iso, display, hyphen },
 *   employee: { iso, display, hyphen },
 *   q:        { iso, hyphen }
 * }
 */
function resolveCanonicalDob_(personCtx, nmcCtx, qCtx) {
  const out = {
    iso: '',
    display: '',
    hyphen: '',
    source: 'UNKNOWN',
    nmc:      { iso: '', display: '', hyphen: '' },
    employee: { iso: '', display: '', hyphen: '' },
    q:        { iso: '', hyphen: '' }
  };

  const hasNmcFlag       = !!(personCtx && personCtx.nmcInclude);
  const nmcBirthRaw      = String(nmcCtx && nmcCtx.nmcBirthRaw || '').trim();
  const employeeBirthIso = String(nmcCtx && nmcCtx.employeeBirthIso || '').trim();
  const qDobIso          = String(qCtx && qCtx.qDobIso || '').trim();
  const qDobHyphen       = String(qCtx && qCtx.qDobHyphen || '').trim();

  // ---- NMC DOB canonicalisation ----
  let nIso = '';
  let nDisplay = '';
  let nHyphen = '';

  if (nmcBirthRaw) {
    let dd = '', mm = '', yyyy = '';
    // Try DD/MM/YYYY
    let m = nmcBirthRaw.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    if (m) {
      dd = m[1]; mm = m[2]; yyyy = m[3];
    } else {
      // Fallback: YYYY-MM-DD
      m = nmcBirthRaw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (m) {
        yyyy = m[1]; mm = m[2]; dd = m[3];
      }
    }
    if (yyyy && mm && dd) {
      nIso     = `${yyyy}-${mm}-${dd}`;
      nDisplay = `${dd}/${mm}/${yyyy}`;
      nHyphen  = `${dd}-${mm}-${yyyy}`;
    }
  }

  if (nIso) {
    out.nmc.iso     = nIso;
    out.nmc.display = nDisplay;
    out.nmc.hyphen  = nHyphen;
  }

  // ---- Employee DOB canonicalisation (YYYY-MM-DD expected) ----
  let eIso = '';
  let eDisplay = '';
  let eHyphen = '';

  if (employeeBirthIso) {
    const m = employeeBirthIso.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (m) {
      const yyyy = m[1], mm = m[2], dd = m[3];
      eIso     = `${yyyy}-${mm}-${dd}`;
      eDisplay = `${dd}/${mm}/${yyyy}`;
      eHyphen  = `${dd}-${mm}-${yyyy}`;
    }
  }

  if (eIso) {
    out.employee.iso     = eIso;
    out.employee.display = eDisplay;
    out.employee.hyphen  = eHyphen;
  }

  // ---- Questionnaire DOB canonicalisation ----
  let qIso = '';
  let qHyphenFinal = '';

  if (qDobHyphen && /^(\d{2})-(\d{2})-(\d{4})$/.test(qDobHyphen)) {
    const m = qDobHyphen.match(/^(\d{2})-(\d{2})-(\d{4})$/);
    const dd = m[1], mm = m[2], yyyy = m[3];
    qIso         = `${yyyy}-${mm}-${dd}`;
    qHyphenFinal = `${dd}-${mm}-${yyyy}`;
  } else if (qDobIso && /^(\d{4})-(\d{2})-(\d{2})$/.test(qDobIso)) {
    const m = qDobIso.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    const yyyy = m[1], mm = m[2], dd = m[3];
    qIso         = `${yyyy}-${mm}-${dd}`;
    qHyphenFinal = `${dd}-${mm}-${yyyy}`;
  }

  if (qIso) {
    out.q.iso    = qIso;
    out.q.hyphen = qHyphenFinal;
  }

  // ---- Canonical choice: NMC → Employee → Questionnaire ----
  if (hasNmcFlag && nIso) {
    out.iso     = nIso;
    out.display = nDisplay;
    out.hyphen  = nHyphen;
    out.source  = 'NMC';
  } else if (eIso) {
    out.iso     = eIso;
    out.display = eDisplay;
    out.hyphen  = eHyphen;
    out.source  = 'EMPLOYEE';
  } else if (qIso) {
    out.iso     = qIso;
    out.hyphen  = qHyphenFinal;
    out.display = qHyphenFinal ? qHyphenFinal.replace(/-/g, '/') : '';
    out.source  = 'QUESTIONNAIRE';
  } else {
    out.source = 'UNKNOWN';
  }

  return out;
}



/**
 * Select the DBS "anchor" file and a group of files sharing the same expiry as the anchor.
 * Also derive issuer/issue date from the newest non-empty comment on the anchor.
 * Ignores files with DECLINED verifications.
 */
function selectDbsAnchorAndGroup_(dbsDoc, ctx) {
  try {
    if (!dbsDoc) return { ok: false, reason: 'no_dbs_doc' };

    const meta = {
      docType: (dbsDoc?.type && (dbsDoc.type.name || dbsDoc.type.key)) || '',
      hasActiveFile: !!dbsDoc?.activeFile,
      filesCountRaw: Array.isArray(dbsDoc?.files) ? dbsDoc.files.length : 0
    };

    // Collect all candidate files (unique by id)
    const files = [];
    const byId = new Set();
    const pushUnique = f => { if (f && f.id && !byId.has(String(f.id))) { files.push(f); byId.add(String(f.id)); } };
    if (Array.isArray(dbsDoc.files)) dbsDoc.files.forEach(pushUnique);
    if (dbsDoc.activeFile) pushUnique(dbsDoc.activeFile);

    // Enforce APPROVED-only (defensive even though helper already filtered)
    const isApproved = f => {
      const verifs = Array.isArray(f?.verifications) ? f.verifications : [];
      return verifs.some(v => String(v?.verificationType || '').toUpperCase() === 'APPROVED');
    };
    const approved = files.filter(isApproved);

    if (!approved.length) return { ok: false, reason: 'no_approved_files' };

    // Anchor = most recent APPROVED by created
    approved.sort((a, b) => new Date(b.created || 0) - new Date(a.created || 0));
    const anchor = approved[0];

    // Group by same expiry as anchor (if present) else just the anchor
    let group = [];
    let groupKey = '';
    if (anchor.expiry) {
      groupKey = String(anchor.expiry);
      group = approved.filter(f => String(f.expiry || '') === groupKey);
      if (!group.length) group = [anchor]; // belt & braces
    } else {
      group = [anchor];
    }

    // ---- ISSUE DATE PICKING (APPROVED ONLY) ----
    let issueDateIso = '';
    let issueDateSource = '';

    for (const f of approved) {
      const candidate = f?.issued || f?.issueDate || '';
      if (String(candidate).trim()) {
        issueDateIso = candidate;
        issueDateSource = `approved_newest_first:file:${f.id}`;
        break; // approved is sorted newest-first
      }
    }

    if (!issueDateIso) {
      const candidate = anchor.issued || anchor.issueDate || '';
      if (String(candidate).trim()) {
        issueDateIso = candidate;
        issueDateSource = `anchor:file:${anchor.id}`;
      }
    }

    if (!issueDateIso && dbsDoc.activeFile && isApproved(dbsDoc.activeFile)) {
      const candidate = dbsDoc.activeFile.issued || dbsDoc.activeFile.issueDate || '';
      if (String(candidate).trim()) {
        issueDateIso = candidate;
        issueDateSource = `activeFile:file:${dbsDoc.activeFile.id}`;
      }
    }

    // ---- ISSUED BY PICKING (COMMENTS ONLY, APPROVED FILES) ----
    const pickNewestCommentMessage = (arr) => {
      if (!Array.isArray(arr) || !arr.length) return '';
      const hit = arr.slice()
        .sort((a, b) => new Date(b?.created || 0) - new Date(a?.created || 0))
        .find(c => c && String(c.message || '').trim().length);
      return hit ? String(hit.message).trim() : '';
    };

    let issuedBy = '';
    let issuedBySource = '';

    for (const f of approved) {
      const msg = pickNewestCommentMessage(f.comments);
      if (msg) { issuedBy = msg; issuedBySource = `approved_newest_first:file:${f.id}`; break; }
    }

    return { ok: true, anchor, group, issueDateIso, issuedBy };
  } catch (e) {
    return { ok: false, reason: 'exception' };
  }
}




/**
 * Attach a DBS certificate from a group of files:
 * - Prefer the newest PDF in the group
 * - Else combine images (oldest→newest) into a single A4 PDF via Slides
 * Pushes to attachments + includedDocLabels; adds RED alert on failure.
 */
function attachDbsCertificateFromGroup_(group, standardizedName, ctx, attachments, includedDocLabels, alerts, fullName, publicId) {
  try {
    if (!Array.isArray(group) || !group.length) {
      alerts.push('RED: No usable DBS certificate files (PDF or images) found to attach, but conviction is present.');
      return;
    }

    const pdfs = group
      .filter(f => String(f.fileType || '').toUpperCase() === 'PDF')
      .sort((a, b) => new Date(b.created || 0) - new Date(a.created || 0));

    if (pdfs.length) {
      const pdf = pdfs[0];
      const dl = httpGetBlob_(`${API_BASE}/files/${pdf.id}`, standardizedName, null, { ...ctx, step: 'DBS: download latest PDF' });
      if (dl && dl.ok && dl.blob) {
        try { dl.blob.setName(standardizedName); } catch (_) {}
        try { dl.blob.setContentType('application/pdf'); } catch (_) {}
        attachments.push(dl.blob);
        includedDocLabels.push(standardizedName.replace(/\.pdf$/i, ''));
        return;
      }
      alerts.push('RED: Failed to download DBS certificate PDF. Please re-check documents.');
      return;
    }

    // No PDFs -> images only
    const imageEntries = group
      .filter(f => {
        const t = String(f.fileType || '');
        return /^image\//i.test(t) || t.toUpperCase() === 'IMAGE';
      })
      .map(f => ({ fileId: f.id, created: f.created || '', expiry: f.expiry || '', fileType: f.fileType || '' }))
      .sort((a, b) => new Date(a.created || 0) - new Date(b.created || 0)); // keep natural order

    if (!imageEntries.length) {
      alerts.push('RED: No usable DBS certificate files (PDF or images) found to attach, but conviction is present.');
      return;
    }

    const combo = combineImagesToPdfViaSlides_(imageEntries, standardizedName, { ...ctx, step: 'DBS: combine images→PDF' });

    if (combo && combo.ok && combo.blob) {
      try { combo.blob.setName(standardizedName); } catch (_) {}
      attachments.push(combo.blob);
      includedDocLabels.push(standardizedName.replace(/\.pdf$/i, ''));
      return;
    }

    // Failed combine: ensure the operator knows a temp Doc was kept (if present)
    if (combo && combo.keptDocId) {
      alerts.push('RED: DBS image combine failed — a temporary Doc was kept for troubleshooting. Please open it from the logs and re-check images.');
    } else {
      alerts.push('RED: Failed to build DBS certificate PDF from images. Please re-check documents.');
    }
  } catch (e) {
    alerts.push('RED: Unexpected error when preparing DBS certificate. Please re-check documents.');
  }
}


/**
 * Find and attach the Criminal Convictions Personal Statement,
 * or raise a RED alert if missing or download fails.
 */
function attachCriminalPersonalStatementOrAlert_(docs, nameParts, ctx, attachments, includedDocLabels, alerts) {
  const { firstName, surname } = nameParts || {};
  try {
    const psDoc = (docs || []).find(d => {
      const key = String(d?.type?.key || '').toLowerCase();
      const name = String(d?.type?.name || '').toLowerCase();
      return key === 'criminal_convictions_declaration_positive_statement' ||
             /criminal\s+convictions?\s+declaration/.test(name);
    });

    if (psDoc && psDoc.activeFile && psDoc.activeFile.id) {
      const dlPs = downloadDocFileBlob_(psDoc, 'Criminal Conviction Personal Statement', `${surname} ${firstName}`, { ...ctx, step: 'Criminal PS: download' });
      if (dlPs && dlPs.ok && dlPs.blob) {
        // Derive extension: use existing one if present, otherwise default to .pdf
        let ext = '';
        const originalName = dlPs.blob.getName() || '';
        const match = originalName.match(/\.\w{2,5}$/);
        if (match) {
          ext = match[0];
        } else {
          ext = '.pdf';
        }

        const wantedName = `Criminal Conviction Personal Statement - ${surname} ${firstName}${ext}`;
        try { dlPs.blob.setName(wantedName); } catch (_) {}
        try {
          if (ext.toLowerCase() === '.pdf') {
            dlPs.blob.setContentType('application/pdf');
          }
        } catch (_) {}
        attachments.push(dlPs.blob);
        includedDocLabels.push(`Criminal Conviction Personal Statement - ${surname} ${firstName}`);
      } else {
        alerts.push("RED: This candidate has a criminal conviction and there is no personal statement present. You cannot send the checklist yet. Please obtain the personal statement from the candidate.");
      }
    } else {
      alerts.push("RED: This candidate has a criminal conviction and there is no personal statement present. You cannot send the checklist yet. Please obtain the personal statement from the candidate.");
    }
  } catch (e) {
    alerts.push("RED: Error while checking/attaching the personal statement. Please re-check documents.");
  }
}



function insertImageAtPlaceholder_(docId, placeholder, imageBlob, targetHeightCm = 7) {
  if (!imageBlob) {
    return { inserted: false };
  }

  // Guard: ensure the blob looks like an image (avoid inserting PDFs, etc.)
  let ctype = '';
  try { ctype = imageBlob.getContentType && imageBlob.getContentType(); } catch (_) {}
  if (!ctype || String(ctype).toLowerCase().indexOf('image/') !== 0) {
    let fname = '';
    try { fname = imageBlob.getName && imageBlob.getName(); } catch (_) {}
    return { inserted: false };
  }

  const doc = DocumentApp.openById(docId);
  const body = doc.getBody();

  // Find the placeholder text
  const pattern = String(placeholder).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const range = body.findText(pattern);
  if (!range) {
    doc.saveAndClose();
    return { inserted: false };
  }

  // Remove the placeholder text
  const el = range.getElement();
  const start = range.getStartOffset();
  const end = range.getEndOffsetInclusive();
  const t = el.asText();
  t.deleteText(start, end);

  // Insert image at the placeholder position (same paragraph)
  const par = t.getParent().asParagraph();
  const image = par.insertInlineImage(par.getChildIndex(t) + 1, imageBlob);

  // Compute target size in points (Docs API uses points; 1 cm ≈ 28.3465 pt)
  const cmToPt = 28.3464567;
  const targetHeightPt = Math.round(targetHeightCm * cmToPt);

  // Use the image’s intrinsic aspect ratio from its current size,
  // then set BOTH height and width to avoid mismatched X/Y scale in .docx
  try {
    // Ensure we have initial dimensions
    const currentW = image.getWidth();
    const currentH = image.getHeight();
    let ratio = (currentW && currentH) ? (currentW / currentH) : 0.78; // fallback to headshot ratio

    const targetWidthPt = Math.max(1, Math.round(targetHeightPt * ratio));

    // Set both dimensions explicitly (order doesn’t matter, but we’ll set height first)
    image.setHeight(targetHeightPt);
    image.setWidth(targetWidthPt);

    // If the placeholder paragraph contained other text/styling, try to keep the image on its own line
    // (Only if there is other content left in the paragraph)
    const leftoverText = par.getText ? String(par.getText()).trim() : '';
    if (leftoverText && leftoverText.length > 0) {
      // Insert a new clean paragraph after, move the image there by re-inserting, then remove the original one
      const parent = par.getParent();
      const newPar = parent.insertParagraph(parent.getChildIndex(par) + 1, '');
      // Re-insert image into the clean paragraph
      const imgBlobForMove = image.getBlob();
      image.removeFromParent();
      const moved = newPar.appendInlineImage(imgBlobForMove);
      // Re-apply explicit size on the moved image
      moved.setHeight(targetHeightPt);
      moved.setWidth(targetWidthPt);
    }

    doc.saveAndClose();
    return { inserted: true };
  } catch (e) {
    doc.saveAndClose();
    return { inserted: false };
  }
}




function tryAttachDoc_(doc, label, personName, ctx, attachments, attachedFileIds, includedDocLabels, surname, firstName) {
  // Defensive: approve-only selection (works even if upstream helper already filtered)
  const isApproved = (fileObj) => {
    const verifs = Array.isArray(fileObj?.verifications) ? fileObj.verifications : [];
    return verifs.some(v => String(v?.verificationType || '').toUpperCase() === 'APPROVED');
  };

  if (!doc) {
    return false;
  }

  // 1) Choose the file to attach:
  //    Prefer doc.activeFile if APPROVED; otherwise pick newest APPROVED from doc.files.
  let fileToUse = null;

  if (doc.activeFile && isApproved(doc.activeFile)) {
    fileToUse = doc.activeFile;
  } else if (Array.isArray(doc.files) && doc.files.length) {
    const approvedFiles = doc.files.filter(isApproved).sort((a, b) => {
      const tb = new Date(b.created || b.issued || 0).getTime();
      const ta = new Date(a.created || a.issued || 0).getTime();
      return tb - ta;
    });
    if (approvedFiles.length) fileToUse = approvedFiles[0];
  }

  if (!fileToUse || fileToUse.id == null) {
    return false;
  }

  const fileIdStr = String(fileToUse.id);
  if (attachedFileIds && attachedFileIds.has(fileIdStr)) {
    return true;
  }

  // 2) Download the chosen APPROVED file directly by id
  const dl = httpGetBlob_(
    `${API_BASE}/files/${fileToUse.id}`,
    label,
    null,
    { ...ctx, step: `Files API: ${label} (download APPROVED)` }
  );

  if (!dl || !dl.ok || !dl.blob) {
    return false;
  }

  // 3) Build the new filename: <DocType> - <Surname> <First name>.<ext>
  const finalType = _rewriteDocTypeLabel(label, doc);
  const safeType  = _safeFilenamePart(finalType);
  const sName     = _safeFilenamePart(surname || '');
  const fName     = _safeFilenamePart(firstName || '');
  const ext       = _fileExtFromOriginName(fileToUse?.originName || dl.blob?.getName?.() || '');
  const newName   = `${safeType} - ${sName} ${fName}${ext}`;

  try { dl.blob.setName(newName); } catch (_) {}

  // 4) Record attachment + bookkeeping
  attachments.push(dl.blob);
  if (attachedFileIds) attachedFileIds.add(fileIdStr);

  const origin = fileToUse?.originName || 'file';
  includedDocLabels.push(`${finalType} (${origin})`);

  return true;
}



function _rewriteDocTypeLabel(label, doc) {
  const raw = String(label || (doc && doc.type && doc.type.name) || 'Document').trim();

  // Exact renames per your spec
  if (/^proof of address$/i.test(raw)) return 'POA';
  if (/^occupational health certificate$/i.test(raw)) return 'OH Certificate';
  if (/^online right to work check$/i.test(raw)) return 'Online RTW Check';

  return raw; // leave others as-is (Passport, Driving Licence, PMVA Certificate, etc.)
}

function _safeFilenamePart(s) {
  return String(s || '')
    .replace(/[\\/:*?"<>|]/g, '_')
    .replace(/\s+/g, ' ')
    .trim();
}

function _fileExtFromOriginName(name) {
  try {
    const m = String(name || '').match(/\.([A-Za-z0-9]{1,8})$/);
    return m ? ('.' + m[1].toLowerCase()) : '.pdf';
  } catch (e) {
    return '.pdf';
  }
}

function fetchNiFromQuestionnaires_(employeeId, ctx) {
  const res = httpGetJson_(
    `${API_BASE}/v1/employees/${employeeId}/questionnaires`,
    { ...ctx, step: 'NI: questionnaires GET' }
  );

  if (!res.ok || !Array.isArray(res.data)) {
    return { ni: '', isValid: false };
  }

  // Flatten all answers from all questionnaires
  const allAnswers = [];
  for (const q of res.data) {
    if (Array.isArray(q.answers)) {
      for (const a of q.answers) {
        allAnswers.push({
          id: a?.id || 0,
          question: String(a?.question || ''),
          answer: a?.answer || '',
          completed: q?.completed || ''
        });
      }
    }
  }

  // Filter for NI Number questions
  const candidates = allAnswers
    .filter(item => {
      const q = item.question.toLowerCase();
      return q.includes('ni number') || q.includes('national insurance');
    })
    .sort((a, b) => {
      // Prefer most recent completed timestamp, then highest answer id
      const ta = new Date(a.completed || 0).getTime();
      const tb = new Date(b.completed || 0).getTime();
      if (tb !== ta) return tb - ta;
      return (b.id || 0) - (a.id || 0);
    });

  if (!candidates.length) return { ni: '', isValid: false };

  const raw = String(candidates[0].answer || '').trim().replace(/^"|"$/g, ''); // strip stray quotes
  const v = validateAndNormalizeNi_(raw);
  return v; // { ni, isValid }
}


function validateAndNormalizeNi_(value) {
  const raw = String(value || '');
  // normalize: remove spaces/hyphens, uppercase
  const compact = raw.replace(/[\s-]+/g, '').toUpperCase();
  const isValid = /^[A-Z]{2}\d{6}[A-Z]$/.test(compact);
  return { ni: compact, isValid };
}

