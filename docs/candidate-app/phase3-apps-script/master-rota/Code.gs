      } else {
        const [dd,mm,yy] = String(dateCell).split("/").map(Number);
        d = new Date(yy, mm-1, dd);
      }
      return d >= startD && d <= endD;
    });

    if (!parts.length) return;

    // sort by date
    parts.sort((a,b) => {
      const da = (a[1] instanceof Date)
                 ? new Date(a[1].getFullYear(), a[1].getMonth(), a[1].getDate())
                 : parseDMY(a[1]);
      const db = (b[1] instanceof Date)
                 ? new Date(b[1].getFullYear(), b[1].getMonth(), b[1].getDate())
