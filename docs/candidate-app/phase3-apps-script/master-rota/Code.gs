/**
 * Scans the given patient sheets and builds a map of every booked shift,
 * keyed by the lower-cased candidate name. Each shift object includes its
 * exact sheet row/column and the current cell Note (if any), so downstream
 * routines can detect time-change annotations.
 *
 * @param {GoogleAppsScript.Spreadsheet.Sheet[]} patientSheets
 * @return {Object<string, Array<Object>>} occupantMap
 */
function buildAllOccupants(patientSheets) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();
  const occupantMap = {};

  patientSheets.forEach(ptSheet => {
    const sheetName = ptSheet.getName();
    const data      = ptSheet.getDataRange().getValues();
    if (data.length < 5) return;

    // Hospital/Ward in B1
    let [hospital, ward] = ["", ""];
    const hwCell = data[0][1] || "";
    if (hwCell.toString().includes(":")) {
      [hospital, ward] = hwCell.toString().split(":").map(s => s.trim());
    } else {
      hospital = hwCell.toString();
    }

    const staffRow = data[2];  // row 3
    const shiftRow = data[3];  // row 4

    for (let r = 4; r < data.length; r += 2) {
      const occRow = data[r];
      if (!occRow[1]) continue;
      const dateObj = new Date(occRow[1]);
      if (isNaN(dateObj)) continue;
      const dateStr = Utilities.formatDate(dateObj, tz, "dd/MM/yyyy");

      for (let c = 2; c < occRow.length; c++) {
        const name = (occRow[c] || "").toString().trim();
        if (!name) continue;

        // parse job title
        const headerText = (staffRow[c] || "").toString().trim();
        const jobTitle   = parseJobTitleFromHeader(headerText);

        // reference
        const reference = (data[r + 1] && data[r + 1][c] != null)
          ? data[r + 1][c].toString().trim()
          : "";

        // shift label
        const shiftLabel = (shiftRow[c] || "").toString().trim();

        // read the note if any (retro‐safe: always define .note)
        let note = "";
        try {
          note = ptSheet.getRange(r + 1, c + 1).getNote() || "";
        } catch (e) {
          // ignore if no notes
        }

        const key = name.toLowerCase();
        occupantMap[key] = occupantMap[key] || [];
        occupantMap[key].push({
          day:         occRow[0],
          date:        dateStr,
          hospital,
          ward,
          shift:       shiftLabel,
          reference,
          header:      headerText,
          jobTitle,
          sheetName,

          // ** Add these so TIME CHANGE sees them **
          row:         r + 1,
          col:         c + 1,

          // legacy fields—not removed
          headerRow:   3,
          headerCol:   c + 1,
          shiftRow:    4,
          occupantRow: r + 1,
          refRow:      r + 2,

          note         // your cell-note text
        });
      }
    }
  });

  return occupantMap;
}




/**
 * Sends consolidated rota emails to each occupant.
 * Logs BEFORE & AFTER any fallback of jobTitle,
 * with real sheet names and A1 headerCell notation.
 */
function sendConsolidatedEmailsForAllCandidates() {
  Logger.clear();
  const ss            = SpreadsheetApp.getActiveSpreadsheet();
  const ui            = SpreadsheetApp.getUi();
  const tz            = ss.getSpreadsheetTimeZone();
  const patientSheets = ss.getSheets().filter(s => isPatientSheetName(s.getName()));
  if (!patientSheets.length) {
    ui.alert("No 'Patient ???' sheets found!");
    return;
  }

  const files   = DriveApp.getFilesByName('Blank Timesheet.pdf');
  if (!files.hasNext()) {
    ui.alert("Could not find ‘Blank Timesheet.pdf’ in My Drive");
    return;
  }
  const pdfBlob     = files.next().getAs(MimeType.PDF);
  const occupantMap = buildAllOccupants(patientSheets);
  const conflictMsg = detectAnyRotaConflicts(occupantMap);
  if (conflictMsg) {
    ui.alert(`CONFLICT DETECTED:\n${conflictMsg}\n\nEmail sending has been cancelled.`);
    return;
  }

  const oldDataMap    = loadOldEmailHistory();
  const candidateInfo = getCandidateInfoMap();
  const now           = new Date();
  const todayNoTime   = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  let sentCount       = 0;

  Object.keys(occupantMap).forEach(key => {
    // 1) Gather upcoming
    const upcoming = occupantMap[key]
      .filter(s => parseDateDDMMYYYY(s.date) >= todayNoTime)
      .sort((a, b) => parseDateDDMMYYYY(a.date) - parseDateDDMMYYYY(b.date));

    // log BEFORE fallback with proper A1 notation
    upcoming.forEach(s => {
      const sheetObj = ss.getSheetByName(s.sheetName);
      let a1 = "UNKNOWN";
      if (sheetObj && s.headerRow != null && s.headerCol != null) {
        a1 = sheetObj.getRange(s.headerRow, s.headerCol).getA1Notation();
      }
      Logger.log(
        `BEFORE fallback | occupant="${key}" | date="${s.date}"` +
        ` | sheet="${s.sheetName}"` +
        ` | headerCell=${a1}` +
        ` | header="${s.header}"` +
        ` | jobTitle="${s.jobTitle}"`
      );
    });

    // 2) Build map of old future shifts
    const oldFuture = (oldDataMap[key] || []).filter(s => parseDateDDMMYYYY(s.date) >= todayNoTime);
    const oldMap    = {};
    oldFuture.forEach(o => { oldMap[o.date + "|" + o.shift] = o; });

    // 3) Detect comments on upcoming
    upcoming.forEach(s => {
      const lookup = s.date + "|" + s.shift;
      const o      = oldMap[lookup];
      if (!o) {
        s.comments = "*NEW*";
      } else {
        const oldRef = String(o.reference || "").trim();
        const newRef = String(s.reference  || "").trim();
        if (!oldRef && newRef)      s.comments = "*New Ref. No.*";
        else if (oldRef && !newRef) s.comments = "*Ref. No removed*";
        else if (oldRef !== newRef) s.comments = "*Ref. No changed*";
      }
    });

    // 4) Cancellations
    const upKeys    = new Set(upcoming.map(s => s.date + "|" + s.shift));
    const cancelled = oldFuture
      .filter(o => !upKeys.has(o.date + "|" + o.shift))
      .map(o => { o.comments = "CANCELLED"; return o; })
      .sort((a, b) => parseDateDDMMYYYY(a.date) - parseDateDDMMYYYY(b.date));

    // 5) AFTER fallback logging
    upcoming.concat(cancelled).forEach(s => {
      if (!s.jobTitle && s.header) {
        s.jobTitle = parseJobTitleFromHeader(s.header);
        const sheetObj = ss.getSheetByName(s.sheetName);
        let a1 = "UNKNOWN";
        if (sheetObj && s.headerRow != null && s.headerCol != null) {
          a1 = sheetObj.getRange(s.headerRow, s.headerCol).getA1Notation();
        }
        Logger.log(
          `AFTER fallback  | occupant="${key}" | date="${s.date}"` +
          ` | sheet="${s.sheetName}"` +
          ` | headerCell=${a1}` +
          ` | final jobTitle="${s.jobTitle}"`
        );
      }
    });

    // 6) Skip if nothing to send
    if (!upcoming.length && !cancelled.length) return;

    // 7) Build + create draft
    const info = candidateInfo[key];
    if (!info) return;
    const subject = `Latest Rota ${Utilities.formatDate(now, tz, "dd/MM/yyyy")}`;

    /**
 * Build an HTML table with dynamic column widths (longest cell + 3ch padding).
 * Always includes JobTitle and Comments.
 */
/**
 * Builds an HTML table for a list of shift objects,
 * with each column width set to (max cell length + 3) in character units.
 *
 * @param {Array<Object>} rows   Array of shift objects, each with
 *                               { day, date, hospital, ward, shift,
 *                                 reference, jobTitle, comments }
 * @param {string} color         Optional text color for every cell ("red", etc).
 * @returns {string}             The HTML string for the table.
 */
/**
 * Builds an HTML table for a list of shift objects,
 * with each column width set to (max cell length in ch) + 1cm.
 *
 * @param {Array<Object>} rows   Array of shift objects, each with
 *                               { day, date, hospital, ward, shift,
 *                                 reference, jobTitle, comments }
 * @param {string} color         Optional text color for every cell ("red", etc).
 * @returns {string}             The HTML string for the table.
 */



    const htmlBody = `
      <p>Dear ${info.firstName},</p>
      <p>${upcoming.length
          ? "Please see all your upcoming (or changed) shifts below:"
          : "This is to inform you that all your upcoming shifts have been cancelled."
      }</p>
      ${makeTable(upcoming)}
      ${cancelled.length
          ? `<h4 style="color:red">Cancelled Shifts</h4>${makeTable(cancelled,"red")}`
          : ""
      }
      <p>Please do NOT reply to this email as this address is not monitored.</p>`;

    GmailApp.createDraft(info.email, subject, "", {
      htmlBody,
      attachments: [pdfBlob]
    });
    storeNewEmailHistory(key, upcoming.concat(cancelled));
    sentCount++;
  });

  // 8) Refresh colors and notify
  refreshAllPatientSheetColors();
  ui.alert(`Saved ${sentCount} email(s) to Gmail Drafts.`);
}


function buildEmailTableBody(firstName, diffs) {
  // Split diffs into new, existing, and cancelled
  const newShifts = diffs.filter(d => d.comment === 'NEW');
  const newRefShifts = diffs.filter(d => d.comment === 'NEW REF NUMBERS');
  const existingShifts = diffs.filter(d => d.comment !== 'NEW' && d.comment !== 'NEW REF NUMBERS' && d.comment !== 'CANCELLED');
  const cancelledShifts = diffs.filter(d => d.comment === 'CANCELLED');

  // Sort all shifts by date
  const allShifts = [...newShifts, ...newRefShifts, ...existingShifts].sort((a, b) => parseDateDDMMYYYY(a.date) - parseDateDDMMYYYY(b.date));

  // Make tables for current bookings (new, new ref, existing) and cancellations
  const currentBookingsTable = makeTable(allShifts); // Includes new, new ref, and existing bookings
  const cancellationsTable = makeTable(cancelledShifts, 'red'); // Cancellations in red

  return `  
    <p>Dear ${firstName},</p>
    <p>Please see below for your rota updates:</p>
    
    <h3>Current Bookings</h3>
    ${currentBookingsTable}

    <h3 style="color:red;">Cancellations</h3>
    ${cancellationsTable}

    <p>Please do NOT reply to this email as this address is not monitored.</p>
  `;
}


function makeTable(rows, color = "") {
  // 1) Headers
  const headers = ["Day","Date","Hospital","Ward","Shift","Ref","Job","Comments"];
  
  // 2) Compute max character length per column
  const maxLens = headers.map(h => h.length);
  rows.forEach(r => {
    const vals = [
      r.day   || "",
      r.date  || "",
      r.hospital || "",
      r.ward  || "",
      r.shift || "",
      r.reference || "",
      r.jobTitle || "",
      r.comments || ""
    ];
    vals.forEach((v,i) => {
      if (v.length > maxLens[i]) maxLens[i] = v.length;
    });
  });
  
  // 3) Build <colgroup> with width = calc(<maxLens>ch + 1cm)
  const cols = maxLens
    .map(l => `<col style="width:calc(${l}ch + 1cm);">`)
    .join("");
  
  // 4) Header row
  const headerRow = `
    <tr>
      ${headers.map(h => `<th>${h}</th>`).join("")}
    </tr>`;
  
  // 5) Data rows
  const dataRows = rows
    .map(r => {
      const cells = [
        r.day, r.date, r.hospital, r.ward,
        r.shift, r.reference, r.jobTitle, r.comments || ""
      ];
      return `
        <tr${color ? ` style="color:${color};"` : ""}>
          ${cells.map(c => `<td>${c || ""}</td>`).join("")}
        </tr>`;
    })
    .join("");
  
  // 6) Assemble table
  return `
    <table border="1" style="border-collapse:collapse; margin-bottom:12px;">
      <colgroup>${cols}</colgroup>
      ${headerRow}
      ${dataRows}
    </table>`;
}
   


    



/**
 * Sends emails only for candidates whose shifts have changed.
