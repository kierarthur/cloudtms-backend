function ai_setupSheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  // Ensure core sheets exist
  const av = ss.getSheetByName(SH_AVAIL)      || ss.insertSheet(SH_AVAIL);
  const cv = ss.getSheetByName(SH_CONVOS)     || ss.insertSheet(SH_CONVOS);
  const kb = ss.getSheetByName(SH_KB)         || ss.insertSheet(SH_KB);
  const lg = ss.getSheetByName(SH_LOGS)       || ss.insertSheet(SH_LOGS);

  // ── A) AVAILABILITY: enforce fixed headers A..F, clear row-1 after F ─────────
  const FIXED = ['Surname','First Name','Email','Telephone','Job Title','Gender'];
  // Write A..F exactly
  av.getRange(1, 1, 1, 6).setValues([FIXED]);
  // Clear any stray content in row 1 after F so dates always begin at G1
  if (av.getLastColumn() > 6) {
    av.getRange(1, 7, 1, av.getLastColumn() - 6).clearContent();
  }

  // Visuals: hide Email (col C), freeze row 1 and columns A..F
  av.hideColumns(3);
  av.setFrozenRows(1);
  av.setFrozenColumns(6);

  // Seed rows from Candidate List if Availability is empty (no body rows yet)
  const cl = ss.getSheetByName(SH_CANDIDATES);
  if (cl) {
    const clVals = cl.getDataRange().getValues();
    if (clVals.length > 1) {
      const bodyRows = Math.max(av.getLastRow() - 1, 0);
      if (bodyRows === 0) {
        // Take first 6 columns of Candidate List as A..F (Surname..Gender)
        const rows = clVals.slice(1).map(r => {
          const surname   = r[0] ?? '';
          const firstName = r[1] ?? '';
          const email     = r[2] ?? '';
          const phone     = (r[3] ?? '').toString();
          const job       = r[4] ?? '';
          const gender    = r[5] ?? '';
          return [surname, firstName, email, phone, job, gender];
        });
        if (rows.length) {
          av.getRange(2, 1, rows.length, 6).setValues(rows);
        }
      }
    }
  }

  // ── B) CONVERSATION / KB / LOGS headers (idempotent) ───────────────────────
  const cvHdr = [
    'Phone','ConversationID','Summary','LastInteractionsJSON','LastUpdated',
    'InitiatedBy','TTLExpiry','LastBotMessageTs','Origin','TemplateSent',
    'LastStartTs','LastStartKind','Flow','PendingConfirmJSON','Status',
    'LastExternalOutboundTs','QuietUntil','DoNotDisturbUntil'
  ];
  if (cv.getLastRow() === 0) cv.appendRow(cvHdr); else _ensureHeaders(cv, cvHdr);

  const kbHdr = ['ID','Question','TriggersCSV','Answer','LastUpdated','Source','Status','CandidatePhone'];
  if (kb.getLastRow() === 0) kb.appendRow(kbHdr); else _ensureHeaders(kb, kbHdr);

  const logHdr = [
    'TsLogged','Phone','ConversationID','Event','Reason',
    'RealDelayHuman','TestDelaySec','RealFireAt','TestFireAt','Note'
  ];
  if (lg.getLastRow() === 0) lg.appendRow(logHdr); else _ensureHeaders(lg, logHdr);

  // ── C) Dates + formatting + sort (existing helpers) ────────────────────────
  ai_refreshDateColumns();              // adds rolling date headers at G1 onward
  ai_markBookedAndSystemBlocks();       // paints blue/green/red + system blocks
  ai_sortAvailabilityByTierJobGenderSurname();

  SpreadsheetApp.getUi().alert('Setup complete.');
}

/**************************************************************
 * FAST WIZARD: Candidates + Compliance (single round-trip)
 * - Caches candidate index and compliance cache in CacheService
 * - Aligns key format to Surname|FirstName across the board
 * - Uses precomputed compliance (daily job) in interactive flows
 **************************************************************/

/** ───────── CONFIG (adjust only if your sheet layout differs) ───────── **/

const SH_COMPLIANCE_CACHE      = 'ComplianceCache';

// 1‑based columns in "Candidate List"
const CAND_SURNAME_COL         = 1; // A: Surname
const CAND_FIRSTNAME_COL       = 2; // B: First name(s)
const CAND_JOBTITLE_COL        = 5; // E: RMN/HCA
const CAND_GENDER_COL          = 6; // F: male/female

// Caching TTLs (seconds)
const TTL_COMPLIANCE_CACHE_SEC = 3600;  // 5 minutes
const TTL_CANDIDATE_INDEX_SEC  = 3600;  // 5 minutes

const _CACHE_KEY_COMPLIANCE    = 'compliance_cache_v2'; // bumped to v2 (keyed by Surname|FirstName)
const _CACHE_KEY_CAND_INDEX    = 'candidate_index_v1';

/** ───────── PUBLIC: Single entrypoint used by the wizard ─────────
 * Returns both names and statuses in one go.
 * @param {Array<{col:number}>} selectedCells - each has .col (1-based column index)
 * @return {{names:string[], statuses:Object<string,'PASS'|'FAIL'|'CAUTION'>}}
 */
function getCandidatesAndCompliance(selectedCells) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getActiveSheet();

  // 1) Derive role/gender filters from headers (row 3) for selected columns
  const cols = Array.isArray(selectedCells)
    ? Array.from(new Set(selectedCells.map(c => +c.col || 0).filter(Boolean))) // unique + valid
    : [];
  const headerInfo = _readHeaderRoleGenderMap(sheet, cols); // Map<col, {role, gender}>
  const filters = _collapseFilters(headerInfo);              // Set of {role, gender}

  // 2) Candidate index (cached). Returns array of { fullName, jobUpper, genderLower }
  const idx = getCandidateIndex();

  // 3) Filter candidates by role/gender (RMN can cover HCA)
  const names = [];
  for (let i = 0; i < idx.length; i++) {
    const c = idx[i];
    if (_candidateMatchesAnyFilter(c, filters)) names.push(c.fullName);
  }
  names.sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));

  // 4) Compliance statuses (cached map keyed by Surname|FirstName)
  const statusMap = getComplianceCache();
  const statuses = {};
  for (let i = 0; i < names.length; i++) {
    const n = names[i];
    const key = _complianceKeyFromFullName(n);
    statuses[n] = (statusMap[key] || statusMap[n] || 'CAUTION').toUpperCase();
  }

  return { names, statuses };
}

/** ───────── PUBLIC (legacy): keep these so nothing breaks ───────── **/
// If older code still calls these, they now reuse the caches internally.

function getCandidatesByRoles(selectedCells) {
  // Keep behavior: return names only
  return getCandidatesAndCompliance(selectedCells).names;
}

function computeComplianceAll(names) {
  // Batch lookup from cache; no per‑name evaluation
  const map = getComplianceCache();
  const out = {};
  for (let i = 0; i < names.length; i++) {
    const n = String(names[i] || '').trim();
    if (!n) { out[names[i]] = 'CAUTION'; continue; }
    const key = _complianceKeyFromFullName(n);
    out[n] = (map[key] || map[n] || 'CAUTION').toUpperCase();
  }
  return out;
}

function checkComplianceAll(names) {
  // Thin wrapper for compatibility with existing UI paths
  return computeComplianceAll(names);
}

/** ───────── CANDIDATE INDEX (CacheService) ─────────
 * Returns an array of { fullName, jobUpper, genderLower } built from Candidate List.
 */
function getCandidateIndex() {
  const cache = CacheService.getScriptCache();
  const cached = cache.get(_CACHE_KEY_CAND_INDEX);
  if (cached) {
    try { return JSON.parse(cached); } catch (_) {}
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SH_CANDIDATES);
  if (!sh) return [];

  const lastRow = sh.getLastRow();
  if (lastRow < 2) {
    cache.put(_CACHE_KEY_CAND_INDEX, '[]', TTL_CANDIDATE_INDEX_SEC);
    return [];
  }

  // Read only needed columns: Surname, Firstname, JobTitle, Gender, and Status
  const width = Math.max(
    CAND_SURNAME_COL,
    CAND_FIRSTNAME_COL,
    CAND_JOBTITLE_COL,
    CAND_GENDER_COL,
    COL.STATUS // ← Status column index (1-based)
  );
  const vals = sh.getRange(2, 1, lastRow - 1, width).getDisplayValues();

  const out = [];
  for (let i = 0; i < vals.length; i++) {
    const row = vals[i];

    // Normalise status; default blanks to ACTIVE
    const statusCell = row[COL.STATUS - 1];
    const candStatus = String(statusCell || 'ACTIVE')
      .replace(/\u00A0|\u200B/g, ' ')
      .trim()
      .toUpperCase();

    // Skip INACTIVE candidates so they never enter the index
    if (candStatus === 'INACTIVE') continue;

    const surname = String(row[CAND_SURNAME_COL - 1] || '').trim();
    const first   = String(row[CAND_FIRSTNAME_COL - 1] || '').trim();
    if (!surname && !first) continue;

    const fullName    = (surname + ' ' + first).trim();
    const jobUpper    = String(row[CAND_JOBTITLE_COL - 1] || '').trim().toUpperCase(); // "RMN" / "HCA"
    const genderLower = String(row[CAND_GENDER_COL - 1] || '').trim().toLowerCase();   // "male"/"female"

    out.push({ fullName, jobUpper, genderLower });
  }

  cache.put(_CACHE_KEY_CAND_INDEX, JSON.stringify(out), TTL_CANDIDATE_INDEX_SEC);
  return out;
}

function invalidateCandidateIndex() {
  CacheService.getScriptCache().remove(_CACHE_KEY_CAND_INDEX);
}

/** ───────── COMPLIANCE CACHE (CacheService) ─────────
 * Returns map: { "Surname|FirstName": "PASS|FAIL|CAUTION" }
 * Backwards‑compatible: if sheet uses 2‑col layout [Candidate, Status], we’ll also index the raw name.
 */
function getComplianceCache() {
  const cache = CacheService.getScriptCache();
  const cached = cache.get(_CACHE_KEY_COMPLIANCE);
  if (cached) {
    try { return JSON.parse(cached); } catch (_) {}
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SH_COMPLIANCE_CACHE);
  const empty = {};
  if (!sh) { cache.put(_CACHE_KEY_COMPLIANCE, JSON.stringify(empty), TTL_COMPLIANCE_CACHE_SEC); return empty; }

  const lastRow = sh.getLastRow();
  const lastCol = sh.getLastColumn();
  if (lastRow < 2) { cache.put(_CACHE_KEY_COMPLIANCE, JSON.stringify(empty), TTL_COMPLIANCE_CACHE_SEC); return empty; }

  const header = sh.getRange(1, 1, 1, Math.min(3, lastCol)).getDisplayValues()[0].map(String);
  const vals   = sh.getRange(2, 1, lastRow - 1, Math.min(3, lastCol)).getDisplayValues();

  const map = {};

  // New format (recommended): [Key, Status, FullName]
  const looksNew = /key/i.test(header[0] || '') && /status/i.test(header[1] || '');
  // Legacy format: [Candidate, Status]
  const looksOld = /candidate/i.test(header[0] || '') && /status/i.test(header[1] || '');

  for (let i = 0; i < vals.length; i++) {
    const row = vals[i];
    if (looksNew) {
      const key = String(row[0] || '').trim();
      const status = String(row[1] || 'CAUTION').trim().toUpperCase();
      if (key) map[key] = status;
      // Also backfill by raw full name if present to be lenient with callers
      const fullName = String(row[2] || '').trim();
      if (fullName && !map[fullName]) map[fullName] = status;
    } else if (looksOld) {
      const fullName = String(row[0] || '').trim();
      const status = String(row[1] || 'CAUTION').trim().toUpperCase();
      if (fullName) {
        map[fullName] = status;
        const key = _complianceKeyFromFullName(fullName);
        if (key && !map[key]) map[key] = status;
      }
    } else {
      // Unknown layout; do nothing to avoid corrupting the map
    }
  }

  cache.put(_CACHE_KEY_COMPLIANCE, JSON.stringify(map), TTL_COMPLIANCE_CACHE_SEC);
  return map;
}

function invalidateComplianceCache() {
  CacheService.getScriptCache().remove(_CACHE_KEY_COMPLIANCE);
}

/** ───────── DAILY: Rebuild ComplianceCache sheet (precompute) ─────────
 * Uses checkCompliance(key) once per candidate and writes a normalized 3‑column table:
 *   [Key, Status, FullName]
 */


/** ───────── Helpers ───────── **/



function refreshComplianceCache() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const original = ss.getActiveSheet();
  const props = PropertiesService.getScriptProperties();
  const STATUS_PROP = 'CDOCS_COMPLIANCE_MANUAL_STATUS_JSON';
  const RUN_PROP = 'COMPLIANCE_RUN_STATE';
  const TRIG_PROP = 'COMPLIANCE_TRIGGER_IDS';
  const STAGING_NAME = 'ComplianceCache — STAGING';
  const SAFETY_AFTER_MS = 60 * 1000;
  const BUDGET_MS = 90 * 1000;

  const parseJson_ = function(text, fallback) {
    try { return JSON.parse(text); } catch (e) { return fallback; }
  };
  const readManualStatus_ = function() {
    return parseJson_(props.getProperty(STATUS_PROP) || '{}', {});
  };
  const manualStatusActive_ = function() {
    try {
      const s = readManualStatus_();
      return !!(s && s.manual === true && s.active !== false);
    } catch (e) {
      return false;
    }
  };
  const complianceOnlyRun_ = function() {
    try {
      const s = readManualStatus_();
      return !!(s && s.manual === true && s.runMode === 'compliance_only');
    } catch (e) {
      return false;
    }
  };
  const completionMessage_ = function() {
    return complianceOnlyRun_()
      ? 'Compliance cache refresh complete'
      : 'Credentially and compliance refresh complete';
  };
  const failureMessage_ = function() {
    return complianceOnlyRun_()
      ? 'Compliance cache refresh failed'
      : 'Credentially and compliance refresh failed';
  };
  const loadComplianceRunState_ = function() {
    return parseJson_(props.getProperty(RUN_PROP) || '', null);
  };
  const saveComplianceRunState_ = function(state) {
    props.setProperty(RUN_PROP, JSON.stringify(state));
  };
  const clearComplianceRunState_ = function() {
    props.deleteProperty(RUN_PROP);
  };
  const getStoredTriggerIds_ = function() {
    const ids = parseJson_(props.getProperty(TRIG_PROP) || '[]', []);
    return Array.isArray(ids) ? ids : [];
  };
  const setStoredTriggerIds_ = function(ids) {
    props.setProperty(TRIG_PROP, JSON.stringify(ids || []));
  };
  const cleanupFiredContinuationTriggers_ = function() {
    const stored = getStoredTriggerIds_();
    if (!stored.length) {
      props.deleteProperty(TRIG_PROP);
      return;
    }
    const liveIds = {};
    const triggers = ScriptApp.getProjectTriggers();
    for (let i = 0; i < triggers.length; i++) {
      try { liveIds[triggers[i].getUniqueId()] = true; } catch (e) {}
    }
    const kept = [];
    for (let j = 0; j < stored.length; j++) {
      if (liveIds[stored[j]]) kept.push(stored[j]);
    }
    if (kept.length) setStoredTriggerIds_(kept);
    else props.deleteProperty(TRIG_PROP);
  };
  const deleteStoredContinuationTriggers_ = function() {
    const stored = getStoredTriggerIds_();
    if (!stored.length) {
      props.deleteProperty(TRIG_PROP);
      return;
    }
    const wanted = {};
    for (let i = 0; i < stored.length; i++) wanted[stored[i]] = true;
    const triggers = ScriptApp.getProjectTriggers();
    for (let j = 0; j < triggers.length; j++) {
      const trig = triggers[j];
      try {
        if (wanted[trig.getUniqueId()]) {
          ScriptApp.deleteTrigger(trig);
        }
      } catch (e) {}
    }
    props.deleteProperty(TRIG_PROP);
  };
  const scheduleComplianceContinuation_ = function(afterMs) {
    deleteStoredContinuationTriggers_();
    const trig = ScriptApp.newTrigger('refreshComplianceCache').timeBased().after(afterMs).create();
    setStoredTriggerIds_([trig.getUniqueId()]);
  };
  const recreateComplianceStagingSheet_ = function(snapshot) {
    let staging = ss.getSheetByName(STAGING_NAME);
    if (staging) ss.deleteSheet(staging);
    staging = ss.insertSheet(STAGING_NAME);
    try { staging.hideSheet(); } catch (e) {}
    staging.getRange(1, 1, 1, 6).setValues([['Key', 'Status', 'FullName', '', 'SnapshotKey', 'SnapshotFullName']]);
    if (snapshot.length) {
      staging.getRange(2, 5, snapshot.length, 2).setValues(snapshot);
    }
    return staging;
  };
  const deleteComplianceStagingSheet_ = function() {
    const staging = ss.getSheetByName(STAGING_NAME);
    if (staging) ss.deleteSheet(staging);
  };

  const lock = LockService.getScriptLock();
  if (!lock.tryLock(15000)) {
    scheduleComplianceContinuation_(SAFETY_AFTER_MS);
    if (manualStatusActive_()) {
      setCredentiallyComplianceRunStatus_({
        manual: true,
        active: true,
        stage: 'queued_compliance',
        message: 'Compliance refresh waiting for lock — retry scheduled',
        error: ''
      });
    }
    return;
  }

  try {
    cleanupFiredContinuationTriggers_();

    const credentiallyState = (typeof loadRunState_ === 'function') ? loadRunState_() : null;
    const credentiallyActive = !!(credentiallyState &&
      credentiallyState.runId &&
      credentiallyState.aborted !== true);

    if (credentiallyActive) {
      if (manualStatusActive_()) {
        setCredentiallyComplianceRunStatus_({
          manual: true,
          active: true,
          stage: 'queued_compliance',
          message: 'Waiting for Credentially refresh to finish',
          error: ''
        });
      }
      scheduleComplianceContinuation_(SAFETY_AFTER_MS);
      return;
    }

    let liveCache = ss.getSheetByName(SH_COMPLIANCE_CACHE);
    if (!liveCache) {
      liveCache = ss.insertSheet(SH_COMPLIANCE_CACHE);
      try { liveCache.hideSheet(); } catch (_) {}
    }

    const candSh = ss.getSheetByName(SH_CANDIDATES);
    if (!candSh) {
      if (manualStatusActive_()) {
        setCredentiallyComplianceRunStatus_({
          manual: true,
          active: false,
          stage: 'failed',
          message: failureMessage_(),
          error: 'Candidate sheet not found',
          runMode: ''
        });
      }
      return;
    }

    const lastRow = candSh.getLastRow();
    if (lastRow < 2) {
      liveCache.clearContents();
      liveCache.getRange(1, 1, 1, 3).setValues([['Key', 'Status', 'FullName']]);
      invalidateComplianceCache();
      deleteComplianceStagingSheet_();
      deleteStoredContinuationTriggers_();
      clearComplianceRunState_();
      if (manualStatusActive_()) {
        setCredentiallyComplianceRunStatus_({
          manual: true,
          active: false,
          stage: 'completed',
          message: completionMessage_(),
          complianceNextIndex: 0,
          complianceTotalCandidates: 0,
          error: '',
          runMode: ''
        });
      }
      if (original) ss.setActiveSheet(original);
      return;
    }

    let runState = loadComplianceRunState_();
    let staging = ss.getSheetByName(STAGING_NAME);
    const freshRun = !runState || !runState.runId || !staging;

    if (freshRun) {
      const width = Math.max(CAND_SURNAME_COL, CAND_FIRSTNAME_COL, COL.STATUS);
      const vals = candSh.getRange(2, 1, lastRow - 1, width).getDisplayValues();

      const snapshot = [];
      for (let i = 0; i < vals.length; i++) {
        const row = vals[i];
        const statusCell = row[COL.STATUS - 1];
        const candStatus = String(statusCell || 'ACTIVE').trim().toUpperCase();
        if (candStatus === 'INACTIVE') continue;

        const surname = String(row[CAND_SURNAME_COL - 1] || '').trim();
        const first = String(row[CAND_FIRSTNAME_COL - 1] || '').trim();
        if (!surname && !first) continue;

        const fullName = (surname + ' ' + first).trim();
        const key = _complianceKeyFromFullName(fullName);
        snapshot.push([key, fullName]);
      }

      if (!snapshot.length) {
        liveCache.clearContents();
        liveCache.getRange(1, 1, 1, 3).setValues([['Key', 'Status', 'FullName']]);
        invalidateComplianceCache();
        deleteComplianceStagingSheet_();
        deleteStoredContinuationTriggers_();
        clearComplianceRunState_();
        if (manualStatusActive_()) {
          setCredentiallyComplianceRunStatus_({
            manual: true,
            active: false,
            stage: 'completed',
            message: completionMessage_(),
            complianceNextIndex: 0,
            complianceTotalCandidates: 0,
            error: '',
            runMode: ''
          });
        }
        if (original) ss.setActiveSheet(original);
        return;
      }

      staging = recreateComplianceStagingSheet_(snapshot);
      runState = {
        runId: Utilities.getUuid(),
        startedAt: new Date().toISOString(),
        nextIndex: 0,
        totalCandidates: snapshot.length,
        outputNextRow: 2,
        lastTriedIndex: 0,
        retriesForIndex: 0
      };
      saveComplianceRunState_(runState);

      if (manualStatusActive_()) {
        setCredentiallyComplianceRunStatus_({
          manual: true,
          active: true,
          stage: 'compliance_starting',
          message: 'Starting compliance cache refresh',
          complianceNextIndex: 0,
          complianceTotalCandidates: runState.totalCandidates,
          error: ''
        });
      }
    }

    if (runState.lastTriedIndex === runState.nextIndex) {
      runState.retriesForIndex = (runState.retriesForIndex || 0) + 1;
    } else {
      runState.lastTriedIndex = runState.nextIndex;
      runState.retriesForIndex = 0;
    }
    saveComplianceRunState_(runState);

    if (runState.retriesForIndex >= 3) {
      deleteComplianceStagingSheet_();
      deleteStoredContinuationTriggers_();
      clearComplianceRunState_();
      if (manualStatusActive_()) {
        setCredentiallyComplianceRunStatus_({
          manual: true,
          active: false,
          stage: 'failed',
          message: failureMessage_(),
          complianceNextIndex: runState.nextIndex,
          complianceTotalCandidates: runState.totalCandidates,
          error: 'retries_exceeded',
          runMode: ''
        });
      }
      if (original) ss.setActiveSheet(original);
      return;
    }

    scheduleComplianceContinuation_(SAFETY_AFTER_MS);

    const ctx = {
      map: buildComplianceMap(),
      rules: getRules().rules
    };

    const remaining = runState.totalCandidates - runState.nextIndex;
    let snapshotSlice = [];
    if (remaining > 0) {
      snapshotSlice = staging.getRange(runState.nextIndex + 2, 5, remaining, 2).getDisplayValues();
    }

    const out = [];
    const startedAtMs = Date.now();
    let processed = 0;

    while (processed < snapshotSlice.length && (Date.now() - startedAtMs) < BUDGET_MS) {
      const pair = snapshotSlice[processed];
      const key = String(pair[0] || '').trim();
      const fullName = String(pair[1] || '').trim();
      if (!key || !fullName) {
        processed++;
        continue;
      }

      let status = 'CAUTION';
      try {
        const res = checkCompliance(key, ctx);
        status = (res && res.result) ? String(res.result).toUpperCase() : 'CAUTION';
      } catch (_) {
        status = 'CAUTION';
      }
      out.push([key, status, fullName]);
      processed++;
    }

    if (out.length) {
      staging.getRange(runState.outputNextRow, 1, out.length, 3).setValues(out);
      runState.outputNextRow += out.length;
    }

    runState.nextIndex += processed;
    runState.lastTriedIndex = runState.nextIndex;
    runState.retriesForIndex = 0;
    saveComplianceRunState_(runState);

    if (manualStatusActive_()) {
      setCredentiallyComplianceRunStatus_({
        manual: true,
        active: true,
        stage: 'compliance_running',
        message: 'Refreshing compliance cache — processed ' + runState.nextIndex + ' of ' + runState.totalCandidates,
        complianceNextIndex: runState.nextIndex,
        complianceTotalCandidates: runState.totalCandidates,
        error: ''
      });
    }

    if (runState.nextIndex < runState.totalCandidates) {
      scheduleComplianceContinuation_(SAFETY_AFTER_MS);
      return;
    }

    const finalRows = staging.getRange(1, 1, runState.outputNextRow - 1, 3).getValues();
    liveCache.clearContents();
    liveCache.getRange(1, 1, finalRows.length, 3).setValues(finalRows);
    invalidateComplianceCache();

    deleteComplianceStagingSheet_();
    deleteStoredContinuationTriggers_();
    clearComplianceRunState_();

    if (manualStatusActive_()) {
      setCredentiallyComplianceRunStatus_({
        manual: true,
        active: false,
        stage: 'completed',
        message: completionMessage_(),
        complianceNextIndex: runState.totalCandidates,
        complianceTotalCandidates: runState.totalCandidates,
        error: '',
        runMode: ''
      });
    }

    if (original) ss.setActiveSheet(original);
  } catch (err) {
    const st2 = loadComplianceRunState_();
    if (st2) {
      saveComplianceRunState_(st2);
      scheduleComplianceContinuation_(SAFETY_AFTER_MS);
      if (manualStatusActive_()) {
        setCredentiallyComplianceRunStatus_({
          manual: true,
          active: true,
          stage: 'compliance_running',
          message: 'Compliance refresh paused — retry scheduled',
          complianceNextIndex: st2.nextIndex,
          complianceTotalCandidates: st2.totalCandidates,
          error: ''
        });
      }
    } else {
      scheduleComplianceContinuation_(SAFETY_AFTER_MS);
      if (manualStatusActive_()) {
        setCredentiallyComplianceRunStatus_({
          manual: true,
          active: true,
          stage: 'queued_compliance',
          message: 'Waiting to start compliance refresh',
          error: ''
        });
      }
    }
    console.error('refreshComplianceCache error:', err && err.stack ? err.stack : err);
  } finally {
    try { lock.releaseLock(); } catch (_) {}
  }
}

function refreshComplianceCacheFromMenu() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const props = PropertiesService.getScriptProperties();
  const RUN_PROP = 'COMPLIANCE_RUN_STATE';
  const TRIG_PROP = 'COMPLIANCE_TRIGGER_IDS';
  const SAFETY_AFTER_MS = 60 * 1000;

  const parseJson_ = function(text, fallback) {
    try { return JSON.parse(text); } catch (e) { return fallback; }
  };

  const getLiveQueuedTriggerIds_ = function() {
    const storedTriggerIds = parseJson_(props.getProperty(TRIG_PROP) || '[]', []);
    const storedIds = Array.isArray(storedTriggerIds) ? storedTriggerIds : [];

    const liveTriggerIds = {};
    const triggers = ScriptApp.getProjectTriggers();
    for (let i = 0; i < triggers.length; i++) {
      try { liveTriggerIds[triggers[i].getUniqueId()] = true; } catch (e) {}
    }

    const queuedTriggerIds = [];
    for (let i = 0; i < storedIds.length; i++) {
      if (liveTriggerIds[storedIds[i]]) queuedTriggerIds.push(storedIds[i]);
    }
    return queuedTriggerIds;
  };

  const inspectComplianceState_ = function() {
    const runState = parseJson_(props.getProperty(RUN_PROP) || '', null);
    const queuedTriggerIds = getLiveQueuedTriggerIds_();
    return {
      runState: runState,
      queuedTriggerIds: queuedTriggerIds,
      complianceRunning: !!(runState && runState.runId),
      complianceQueued: queuedTriggerIds.length > 0
    };
  };

  const attachToExistingRun_ = function(stateInfo) {
    const patch = {
      manual: true,
      active: true,
      runMode: 'compliance_only',
      error: ''
    };

    if (stateInfo && stateInfo.complianceRunning) {
      patch.stage = 'compliance_running';
      patch.message = 'Compliance cache refresh is already running';
      if (stateInfo.runState && typeof stateInfo.runState.nextIndex === 'number') {
        patch.complianceNextIndex = stateInfo.runState.nextIndex;
      }
      if (stateInfo.runState && typeof stateInfo.runState.totalCandidates === 'number') {
        patch.complianceTotalCandidates = stateInfo.runState.totalCandidates;
      }
    } else {
      patch.stage = 'queued_compliance';
      patch.message = 'Compliance cache refresh is already queued';
    }

    setCredentiallyComplianceRunStatus_(patch);
    try {
      if (typeof showCredentiallyComplianceProgressDialog === 'function') {
        showCredentiallyComplianceProgressDialog();
      }
    } catch (e) {}
  };

  const queueComplianceWorker_ = function() {
    const trig = ScriptApp.newTrigger('refreshComplianceCache').timeBased().after(SAFETY_AFTER_MS).create();
    props.setProperty(TRIG_PROP, JSON.stringify([trig.getUniqueId()]));
  };

  let stateInfo = inspectComplianceState_();
  if (stateInfo.complianceRunning || stateInfo.complianceQueued) {
    attachToExistingRun_(stateInfo);
    return;
  }

  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) {
    stateInfo = inspectComplianceState_();
    if (stateInfo.complianceRunning || stateInfo.complianceQueued) {
      attachToExistingRun_(stateInfo);
      return;
    }

    clearCredentiallyComplianceRunStatus_();

    setCredentiallyComplianceRunStatus_({
      manual: true,
      active: true,
      runMode: 'compliance_only',
      stage: 'queued_compliance',
      message: 'Compliance cache refresh queued',
      startedAt: new Date().toISOString(),
      credentiallyNextIndex: 0,
      credentiallyTotalCandidates: null,
      complianceNextIndex: 0,
      complianceTotalCandidates: null,
      error: ''
    });

    queueComplianceWorker_();

    try {
      if (typeof showCredentiallyComplianceProgressDialog === 'function') {
        showCredentiallyComplianceProgressDialog();
      }
    } catch (e) {}
    return;
  }

  try {
    stateInfo = inspectComplianceState_();
    if (stateInfo.complianceRunning || stateInfo.complianceQueued) {
      attachToExistingRun_(stateInfo);
      return;
    }

    clearCredentiallyComplianceRunStatus_();

    setCredentiallyComplianceRunStatus_({
      manual: true,
      active: true,
      runMode: 'compliance_only',
      stage: 'queued_compliance',
      message: 'Compliance cache refresh queued',
      startedAt: new Date().toISOString(),
      credentiallyNextIndex: 0,
      credentiallyTotalCandidates: null,
      complianceNextIndex: 0,
      complianceTotalCandidates: null,
      error: ''
    });

    queueComplianceWorker_();

    try {
      if (typeof showCredentiallyComplianceProgressDialog === 'function') {
        showCredentiallyComplianceProgressDialog();
      }
    } catch (e) {}
  } finally {
    try { lock.releaseLock(); } catch (e) {}
  }
}



function showCredentiallyComplianceProgressDialog() {
