/**
 * Sends emails only for candidates whose shifts have changed.
 * Logs job‐cell lookups (and missing sheets) in the “Logs” sheet for debugging.
 */
function sendEmailsForChangedCandidatesOnly() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();

  // Ensure we have a Logs sheet for debugging
  let logsSheet = ss.getSheetByName("Logs");
  if (!logsSheet) {
    logsSheet = ss.insertSheet("Logs");
    logsSheet.appendRow(["Timestamp", "Sheet Name", "Job Cell Row", "Job Cell Col", "Cell Value"]);
  }

  // 1) Gather all Patient sheets
  const patientSheets = ss.getSheets().filter(s => isPatientSheetName(s.getName()));
  if (patientSheets.length === 0) {
    ui.alert("No 'Patient ???' sheets found!");
    return;
  }
  const occupantMap = buildAllOccupants(patientSheets);

  // 2) Conflict check
  const conflictMsg = detectAnyRotaConflicts(occupantMap);
  if (conflictMsg) {
    ui.alert(`CONFLICT DETECTED:\n${conflictMsg}\n\nEmail sending has been cancelled.`);
    return;
  }

  // 3) Load old data and candidate info
  const oldDataMap       = loadOldEmailHistory();
  const candidateInfoMap = getCandidateInfoMap();

  // Today's midnight
  const now         = new Date();
  const todayNoTime = new Date(now.getFullYear(), now.getMonth(), now.getDate());

  let sentCount = 0;

  //------------------------------------------------
  // PART A: Occupants who still have shifts
  //------------------------------------------------
  Object.keys(occupantMap).forEach(occupantKey => {
    const candidateInfo = candidateInfoMap[occupantKey];
    if (!candidateInfo) return;  // no email => skip

    // Filter new shifts to today-or-future
    let occupantShifts = (occupantMap[occupantKey] || [])
      .filter(s => parseDateDDMMYYYY(s.date) >= todayNoTime);

    // Filter old shifts to today-or-future
    const oldShifts = (oldDataMap[occupantKey] || [])
      .filter(os => parseDateDDMMYYYY(os.date) >= todayNoTime);

    // Build lookup of old shifts
    const newKeySet = {};
    occupantShifts.forEach(ns => {
      newKeySet[ns.date + "|" + ns.shift] = true;
    });

    // Identify cancellations
    const canceledShifts = oldShifts
      .filter(os => !newKeySet[os.date + "|" + os.shift])
      .map(os => { os.comments = "CANCELLED"; return os; });

    // Step 1: Mark new or ref‑changed
    const oldMap = {};
    oldShifts.forEach(o => { oldMap[o.date + "|" + o.shift] = o; });
    occupantShifts.forEach(ns => {
      const key = ns.date + "|" + ns.shift;
      const o = oldMap[key];
      if (!o) {
        ns.comments = "*NEW*";
      } else {
        const oldRef = String(o.reference || "").trim();
        const newRef = String(ns.reference || "").trim();
        if (!oldRef && newRef)      ns.comments = "*New Ref. No.*";
        else if (oldRef && !newRef) ns.comments = "*Ref. No removed*";
        else if (oldRef !== newRef) ns.comments = "*Ref. No changed*";
      }
    });

    // Check if anything changed
    const changesInUpcomingShifts =
      occupantShifts.some(s => s.comments) ||
      canceledShifts.length > 0;
    if (!changesInUpcomingShifts) {
      return;  // no change => skip
    }
// immediately after you build `occupantShifts`:
logsSheet.appendRow([
  new Date(),
  "SAMPLE OBJECT:",
  JSON.stringify(occupantShifts[0])
]);

    // DEBUG: Log job‐cell locations & values (or missing sheet)
occupantShifts.forEach(s => {
  // 🔑 get the real sheet by the name you stored earlier
  const sheetObj = ss.getSheetByName(s.sheetName);
  const jobRow   = s.headerRow;
  const jobCol   = s.headerCol;

  if (!sheetObj) {
    // Sheet literally not found
    logsSheet.appendRow([
      new Date(),
      s.sheetName + " (NOT FOUND)",
      jobRow,
      jobCol,
      ""
    ]);
  } else {
    const cellValue = sheetObj.getRange(jobRow, jobCol).getValue();
    logsSheet.appendRow([
      new Date(),
      s.sheetName,
      jobRow,
      jobCol,
      cellValue
    ]);
  }
});


    // Build HTML tables
    function makeTable(arr, color = "") {
      if (!arr.length) return "";
      const rows = arr.map(s => `
        <tr style="${color ? `color:${color};` : ""}">
          <td>${s.day}</td><td>${s.date}</td><td>${s.hospital}</td>
          <td>${s.ward}</td><td>${s.shift}</td><td>${s.reference}</td>
          <td>${s.jobTitle}</td><td>${s.comments || ""}</td>
        </tr>`).join("");
      return `
        <table border="1" style="border-collapse:collapse; margin-bottom:12px;">
          <tr>
            <th>Day</th><th>Date</th><th>Hospital</th><th>Ward</th>
            <th>Shift</th><th>Ref</th><th>Job</th><th>Comments</th>
          </tr>
          ${rows}
        </table>`;
    }

    const upcomingTable = makeTable(occupantShifts);
    const cancelTable   = canceledShifts.length
      ? `<h4 style="color:red">Cancelled Shifts</h4>${makeTable(canceledShifts, "red")}`
      : "";

    // Create draft
    const subject  = `Changes to your Rota – Important – ${Utilities.formatDate(now, ss.getSpreadsheetTimeZone(), "dd/MM/yyyy")}`;
    const htmlBody = `
      <p>Dear ${candidateInfo.firstName},</p>
      <p>Please see changes to your upcoming rota below:</p>
      ${upcomingTable}
      ${cancelTable}
      <p>Please do NOT reply to this email as this address is not monitored.</p>`;

    GmailApp.createDraft(candidateInfo.email, subject, "", { htmlBody });
    storeNewEmailHistory(occupantKey, occupantShifts.concat(canceledShifts));
    sentCount++;
  });

  //------------------------------------------------
  // PART B: Occupants who no longer have future shifts
  //------------------------------------------------
  Object.keys(loadOldEmailHistory()).forEach(occupantKey => {
    if (occupantMap[occupantKey]) return;  // still has shifts => skip
    const candidateInfo = candidateInfoMap[occupantKey];
    if (!candidateInfo) return;

    const futureShiftsOnly = (oldDataMap[occupantKey] || [])
      .filter(s => parseDateDDMMYYYY(s.date) >= todayNoTime);
    if (!futureShiftsOnly.length) return;

    futureShiftsOnly.forEach(s => s.comments = "CANCELLED");

    function makeTable(arr) {
      const rows = arr.map(s => `
        <tr style="color:red;">
          <td>${s.day}</td><td>${s.date}</td><td>${s.hospital}</td>
          <td>${s.ward}</td><td>${s.shift}</td><td>${s.reference}</td>
          <td>${s.jobTitle}</td><td>${s.comments}</td>
        </tr>`).join("");
      return `
        <table border="1" style="border-collapse:collapse;">
          <tr>
            <th>Day</th><th>Date</th><th>Hospital</th><th>Ward</th>
            <th>Shift</th><th>Ref</th><th>Job</th><th>Comments</th>
          </tr>
          ${rows}
        </table>`;
    }

    const subject  = `Rota Update – All Future Shifts Cancelled`;
    const htmlBody = `
      <p>Dear ${candidateInfo.firstName},</p>
      <p>This is to inform you that all your upcoming shifts have been cancelled.</p>
      ${makeTable(futureShiftsOnly)}
      <p>Please do NOT reply to this email as this address is not monitored.</p>`;

    GmailApp.createDraft(candidateInfo.email, subject, "", { htmlBody });
    storeNewEmailHistory(occupantKey, []);
    sentCount++;
  });

  ui.alert(`Changed‑Only emails: Created ${sentCount} draft(s).`);
  refreshAllPatientSheetColors();
}


/*************************************************
 * loadOldEmailHistory
 *************************************************/
function loadOldEmailHistory() {
  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("EmailHistory");
  if (!sheet) return {};

  const data = sheet.getDataRange().getValues();
  const tz   = ss.getSpreadsheetTimeZone();
  const map  = {};

  // determine if there is a “Notes” column header
  const headers = data[0].map(h=>h.toString().trim().toLowerCase());
  const noteIdx = headers.indexOf("notes");  // e.g. column I/J

  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const key     = row[0];
    if (!key) continue;

    // date normalization
    const rawDate = row[1];
    const dateStr = rawDate instanceof Date
      ? Utilities.formatDate(rawDate, tz, "dd/MM/yyyy")
      : rawDate.toString().trim();

    const shift    = row[2];
    const reference= row[3];
    const day      = row[4];
    const hospital = row[5];
    const ward     = row[6];
    const jobTitle = row[7];

    // pull in note if that column exists
    const note = (noteIdx >= 0 && row[noteIdx] != null)
      ? row[noteIdx].toString().trim()
      : "";

    const shiftObj = {
      date:      dateStr,
      shift,
      reference,
      day,
      hospital,
      ward,
      jobTitle,
      note      // ← new property
    };

    map[key] = map[key]||[];
    map[key].push(shiftObj);
  }
  return map;
}


/*************************************************
 * storeNewEmailHistory
 *************************************************/
/**
 * Updates EmailHistory sheet for a specific occupantKey, removing all old lines,
 * then appending only the occupant's active (non-cancelled) future shifts.
 */
/**
 * Updates EmailHistory sheet for a specific occupantKey, removing all old lines,
 * then appending only the occupant's active (non-cancelled) future shifts.
 */
function storeNewEmailHistory(occupantKey, occupantShifts) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName("EmailHistory");

  // Log the beginning of the process
  Logger.log(`Starting to store email history for OccupantKey: ${occupantKey}`);
  Logger.log("Shifts being passed to storeNewEmailHistory: " + JSON.stringify(occupantShifts));

  if (!sheet) {
    sheet = ss.insertSheet("EmailHistory");
    sheet.getRange("A1:H1").setValues([[
      "OccupantKey", "Date", "Shift", "Reference", "Day",
      "Hospital", "Ward", "JobTitle"
    ]]);
    Logger.log("Created new 'EmailHistory' sheet.");
  } else {
    Logger.log("'EmailHistory' sheet already exists.");
  }

  // 1) Remove existing data for this occupantKey
  const lastRow = sheet.getLastRow();
  const existingValues = (lastRow > 1)
    ? sheet.getRange(2, 1, lastRow - 1, 8).getValues()
    : [];
  const keyLower = occupantKey.toLowerCase();
  
  const kept = existingValues.filter(row => {
    return (row[0] || "").toString().trim().toLowerCase() !== keyLower;
  });

  Logger.log(`Found ${existingValues.length} existing rows for occupantKey: ${occupantKey}`);
  Logger.log(`Kept ${kept.length} rows that are not for ${occupantKey}`);

  if (lastRow > 1) {
    sheet.getRange(2, 1, lastRow - 1, 8).clearContent();
    Logger.log(`Cleared ${lastRow - 1} existing rows.`);
  }

  if (kept.length) {
    sheet.getRange(2, 1, kept.length, 8).setValues(kept);
    Logger.log(`Re-added ${kept.length} kept rows.`);
  }

  // 2) Append only the active (non-cancelled) shifts
  const toAppend = occupantShifts
    .filter(s => !/CANCELLED/i.test(s.comments || "")) // Exclude cancelled shifts
    .map(s => [
      occupantKey,
      s.date || "N/A",
      s.shift || "Unknown",
      s.reference || "",
      s.day || "Unknown",
      s.hospital || "Unknown",
      s.ward || "Unknown",
      s.jobTitle || "Unknown"
    ]);

  Logger.log(`Shifts to append: ${JSON.stringify(toAppend)}`);

  if (toAppend.length) {
    const start = sheet.getLastRow() + 1;
    sheet.getRange(start, 1, toAppend.length, toAppend[0].length)
         .setValues(toAppend);
    Logger.log(`Appended ${toAppend.length} shifts starting from row ${start}`);
  } else {
    Logger.log("No shifts to append.");
  }

  // 3) Clean up any history rows older than two months
  Logger.log("Cleaning up any email history rows older than two months...");
  cleanupEmailHistory();
  
  Logger.log(`Finished storing email history for ${occupantKey}`);
}




/*************************************************
 * parseDateDDMMYYYY => handle "dd/MM/yyyy"
 *************************************************/
function parseDateDDMMYYYY(value) {
  if (value instanceof Date && !isNaN(value.valueOf())) {
    return value;
  }
  if (typeof value !== "string") return new Date("Invalid");

  const [d, m, y] = value.split("/").map(Number);
  if (!d || !m || !y) return new Date("Invalid");
  return new Date(y, m - 1, d);
}


/*************************************************
 * GET CANDIDATE INFO MAP
 *************************************************/
function getCandidateInfoMap() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const cSheet = ss.getSheetByName("Candidate List");
  if (!cSheet) {
    return {};
  }

  const data = cSheet.getDataRange().getValues();
  const map = {};
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const surname   = (row[0] || "").toString().trim();
    const firstName = (row[1] || "").toString().trim();
    const email     = (row[2] || "").toString().trim();

    if (surname && firstName && email) {
      const occupantKey = (surname + " " + firstName).toLowerCase();
      map[occupantKey] = {
        email: email,
        firstName: firstName
      };
    }
  }
  return map;
}


/*************************************************
 * parseFirstTwoTokens
 *************************************************/
function parseFirstTwoTokens(value) {
  const str = (value || "").toString().trim();
  const tokens = str.split(/\s+/);

  let shortName = tokens[0] || "";
  if (tokens.length > 1) {
    shortName += " " + tokens[1];
  }
  return shortName.toLowerCase();
}


/*************************************************
 * APPLY ROTA FORMATTING
 *************************************************/
/**
 * Applies full “global” rota formatting — borders, column widths, REF colouring.
 * (Called when building a brand-new rota sheet only.)
 */
function applyRotaFormatting(sheet) {
  const range     = sheet.getDataRange();
  const values    = range.getValues();
  const numRows   = values.length;
  const numCols   = values[0].length;
  const whiteBg   = "#FFFFFF";
  const blackText = "#000000";

  // 1) Set all column widths
  const stdW = 160;
  for (let c = 1; c <= numCols; c++) {
    sheet.setColumnWidth(c, stdW);
  }

  // 2) Header borders (row 3 & 4)
  for (let c = 3; c <= numCols; c++) {
    sheet.getRange(3, c, 2, 1)
      .setBorder(true, true, true, true, null, null,
                 "black", SpreadsheetApp.BorderStyle.SOLID);
  }

  // 3) Row-by-row group borders + REF styling
  for (let r = 5; r < numRows; r += 2) {
    for (let c = 1; c <= numCols; c++) {
      // surround each day+REF block
      sheet.getRange(r, c, 2, 1)
        .setBorder(true, true, true, true, null, null,
                   "black", SpreadsheetApp.BorderStyle.SOLID);

      // REF cell styling
      const refCell = sheet.getRange(r + 1, c);
      if (c >= 3) {
        refCell.setBackground(whiteBg)
               .setFontColor(blackText)
               .setFontWeight("normal");
      }
    }
  }
}


