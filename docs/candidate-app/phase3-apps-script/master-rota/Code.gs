 */


function _coerceSettings(incoming){
  // Soft coercion to keep bad inputs from breaking runtime.
  const num = (v, dflt) => (v===null||v===undefined||v==='') ? dflt : (isNaN(+v) ? dflt : +v);
  const obj = { ...incoming };

  return {
    WINDOW_DAYS:            num(obj.WINDOW_DAYS,            DEFAULT_SETTINGS.WINDOW_DAYS),
    CONTACT_COOLDOWN_D:     num(obj.CONTACT_COOLDOWN_D,     DEFAULT_SETTINGS.CONTACT_COOLDOWN_D),
    CONVO_TTL_MIN:          num(obj.CONVO_TTL_MIN,          DEFAULT_SETTINGS.CONVO_TTL_MIN),
    BURST_BUFFER_SEC:       num(obj.BURST_BUFFER_SEC,       DEFAULT_SETTINGS.BURST_BUFFER_SEC),
    SUMMARY_MAX_CHARS:      num(obj.SUMMARY_MAX_CHARS,      DEFAULT_SETTINGS.SUMMARY_MAX_CHARS),
    MAX_TURNS_TO_KEEP:      num(obj.MAX_TURNS_TO_KEEP,      DEFAULT_SETTINGS.MAX_TURNS_TO_KEEP),
    MAX_DATES_PER_MSG:      num(obj.MAX_DATES_PER_MSG,      DEFAULT_SETTINGS.MAX_DATES_PER_MSG),
    REMOVE_YDAY_AT_HH:      num(obj.REMOVE_YDAY_AT_HH,      DEFAULT_SETTINGS.REMOVE_YDAY_AT_HH),

    QUIET_WINDOW_MIN_REAL:  num(obj.QUIET_WINDOW_MIN_REAL,  DEFAULT_SETTINGS.QUIET_WINDOW_MIN_REAL),
    STOP_SNOOZE_HOURS_REAL: num(obj.STOP_SNOOZE_HOURS_REAL, DEFAULT_SETTINGS.STOP_SNOOZE_HOURS_REAL),
    COOLDOWN_DAYS_REAL:     num(obj.COOLDOWN_DAYS_REAL,     DEFAULT_SETTINGS.COOLDOWN_DAYS_REAL),

    STAGGER_START_HH:       num(obj.STAGGER_START_HH,       DEFAULT_SETTINGS.STAGGER_START_HH),
    STAGGER_END_HH:         num(obj.STAGGER_END_HH,         DEFAULT_SETTINGS.STAGGER_END_HH),
    STAGGER_JITTER_MIN:     num(obj.STAGGER_JITTER_MIN,     DEFAULT_SETTINGS.STAGGER_JITTER_MIN),
    STAGGER_JITTER_MAX:     num(obj.STAGGER_JITTER_MAX,     DEFAULT_SETTINGS.STAGGER_JITTER_MAX),

    RAMP_WINDOW_MIN:        num(obj.RAMP_WINDOW_MIN,        DEFAULT_SETTINGS.RAMP_WINDOW_MIN),

    TEMPLATE_NAME:          (obj.TEMPLATE_NAME && String(obj.TEMPLATE_NAME).trim()) || DEFAULT_SETTINGS.TEMPLATE_NAME
  };
}

/** =======================
 *  5) INBOUND + FOLLOWUPS
 *  ======================= */
function ai_handleWatiInbound(p) {
  // Expect p.phone, p.message (string), p.fromMe (boolean), p.ts (ISO)
  const phone = (p.phone || '').toString().trim();
  const text  = (p.message || '').toString().trim();
  if (!phone || !text) return;

  // Ignore our own outbound echoes
  if (p.fromMe) return;

  // A) Kier KB reply (normalize stored phone before comparing)
  const kierPhone = _normPhoneUK(_getKierPhone());
  if (phone === kierPhone && text.startsWith(KB_REPLY_PREFIX)) {
    kb_processKierReply(text);
    return;
  }

  const conv = _conversationsFindMostRecentAny(phone);
  if (!conv) return;

  // STOP at any time closes and schedules restart after snooze+cooldown
  if (/^\s*(stop|cancel|abort)\s*$/i.test(text)) {
    const now = new Date();
    const snoozeMsReal   = S().STOP_SNOOZE_HOURS_REAL * 3600 * 1000;
    const cooldownMsReal = S().COOLDOWN_DAYS_REAL     * 24   * 3600 * 1000;
    const lastStart = conv.LastStartTs ? new Date(conv.LastStartTs) : null;
    const cooldownLeft = lastStart ? Math.max(0, (lastStart.getTime() + cooldownMsReal) - now.getTime()) : 0;

    const waitReal = Math.max(snoozeMsReal, cooldownLeft);
    const when = _computeFireTime(waitReal, 'StopSnooze');

    _conversationsUpsert({
      Phone: phone, ConversationID: conv.ConversationID,
      Status: 'Closed',
      DoNotDisturbUntil: when.realAt
    });

    // If AI opt-out is ON for this number, do not send the STOP acknowledgement
    if (!_isAiOptOut(phone)) {
      _sendOrSimulate(phone, 'No problem — I’ve paused your availability updates. Message me any time when you’d like to restart.', { 'forename':'there' });
    }

    _setPendingFollowup(phone, '__RESTART__', when.testAt, 'StopSnooze', 'STOP closed; restart later');
    _logSchedule('Scheduled','StopSnooze', phone, conv.ConversationID, when.realHuman, when.testDelaySec, when.realAt, when.testAt, 'STOP closed; restart later');
    return;
  }

  // Append inbound to conversation
  const last = JSON.parse(conv.LastInteractionsJSON || '[]');
  last.push({ from: 'nurse', msg: text, ts: new Date().toISOString() });
  while (last.length > S().MAX_TURNS_TO_KEEP) last.shift();
  _conversationsUpsert({
    Phone: phone,
    ConversationID: conv.ConversationID,
    LastInteractionsJSON: JSON.stringify(last),
    LastUpdated: new Date(),
    Origin: 'wati'
  });

  // If availability flow open and not paused/quiet → debounce then process
  if (conv.Flow === 'availability') {
    if (conv.Status === 'Paused') return;
    if (conv.QuietUntil && new Date(conv.QuietUntil) > new Date()) return;

    if (conv.InitiatedBy !== 'BOT') return;

    // If TTL expired, refresh it so the convo can proceed
    if (new Date(conv.TTLExpiry) < new Date()) {
      _conversationsUpsert({
        Phone: phone,
        ConversationID: conv.ConversationID,
        TTLExpiry: new Date(Date.now() + S().CONVO_TTL_MIN * 60000)
      });
    }

    // Respect AI opt-out: never auto-process availability
    if (_isAiOptOut(phone)) return;

    const when = _computeFireTime(S().BURST_BUFFER_SEC * 1000, 'Debounce');
    _setPendingFollowup(phone, '__PROCESS__', when.testAt, 'Debounce', 'inbound debounce');
    _logSchedule('Scheduled','Debounce', phone, conv.ConversationID, when.realHuman, when.testDelaySec, when.realAt, when.testAt, 'inbound debounce');
    return;
  }

  // Non-availability (handoff/unknown): no auto replies
  return;
}


// Gentle-ramp orchestration is handled inside ai_sendDueFollowups()
function ai_sendDueFollowups() {
  const props = PropertiesService.getScriptProperties();

  // flush any accumulated logs to "Logs" sheet first
  try {
    const key = "LOG_BUFFER";
    const raw = props.getProperty(key);
    if (raw) {
      const buf = JSON.parse(raw);
      if (buf.length) {
        const ss = SpreadsheetApp.getActiveSpreadsheet();
        let logS = ss.getSheetByName("Logs");
        if (!logS) {
          logS = ss.insertSheet("Logs");
          logS.appendRow(["Timestamp", "Event", "Reason", "Phone", "Note"]);
        }
        logS.getRange(logS.getLastRow() + 1, 1, buf.length, buf[0].length).setValues(buf);
        props.deleteProperty(key);
      }
    }
  } catch (err) {
    console.error("Log flush error", err);
  }

  // ── NEW: drain WATI queues first ───────────────────────────────────────────
  try {
    _drainWatiInboundQueue();   // processes queued inbound messages -> ai_handleWatiInbound()
  } catch (eInQ) {
    console.error('Inbound queue drain error:', eInQ);
    _safeLog('QueueDrain', 'InboundError', String(eInQ));
  }
  try {
    _drainWatiOutboundQueue();  // processes queued outbound commands (template or handoff path)
  } catch (eOutQ) {
    console.error('Outbound queue drain error:', eOutQ);
    _safeLog('QueueDrain', 'OutboundError', String(eOutQ));
  }
  // ───────────────────────────────────────────────────────────────────────────

  // ── Kill switch & gentle ramp handling
  const currentlyDisabled = _isKillSwitchOn();
  const lastStateStr = _prop_('KILL_SWITCH_LAST_STATE');
  const lastDisabled = String(lastStateStr).toLowerCase() === 'true';

  if (currentlyDisabled !== lastDisabled) {
    props.setProperty('KILL_SWITCH_LAST_STATE', currentlyDisabled ? 'true' : 'false');
    if (!currentlyDisabled && lastDisabled) {
      _gentleRampReschedule(S().RAMP_WINDOW_MIN);
      return;
    }
  }
  if (currentlyDisabled) return;

  // ── Busy-flag guard
  const BUSY_KEY = 'AI_BUSY_TS';
  const now = Date.now();
  const timeoutMs = (S && typeof S === 'function' && S().BUSY_TIMEOUT_MS) ? S().BUSY_TIMEOUT_MS : 10 * 60 * 1000;
  const prevRaw = props.getProperty(BUSY_KEY);
  const prevTs = prevRaw ? Number(prevRaw) : 0;

  if (prevTs && (now - prevTs) < timeoutMs) {
    console.log('ai_sendDueFollowups skipped — another run is still busy.');
    _safeLog('Skipped', 'BusyGuard', 'ai_sendDueFollowups busy');
    return;
  }

  props.setProperty(BUSY_KEY, String(now));

  try {
    const due = _getDueFollowups();

    due.forEach(item => {
      const phone = String(_normPhoneUK(item.phone || '') || '').trim();
      if (!phone) {
        _safeLog('Skipped', 'NoPhone', 'followup item has no phone');
        return;
      }

      const conv = _conversationsFindMostRecentAny(phone);
      const convoId = conv ? conv.ConversationID : '';

      _safeLog('Fired', item.reason || 'Unknown', `convoId=${convoId} note=${item.note || ''}`, { phone });

      if (_isAiOptOut(phone)) { 
        _clearPendingFollowup(phone); 
        return; 
      }

      const t = item.text;
      if (t === '__PROCESS__') {
        ai_processConversation(phone);
      } else if (t === '__QUIET_CONTINUE__') {
        _continueAndAskNext(phone);
      } else if (t === '__RESTART__') {
        _startOrRestartAvailability(phone);
      } else if (t === '__OPEN__') {
        _sendOpenerNow(phone);
      }

      _clearPendingFollowup(phone);
    });
  } catch (e) {
    console.error('ai_sendDueFollowups error:', e);
    throw e;
  } finally {
    props.deleteProperty(BUSY_KEY);
  }
}

function _logSchedule(event, reason, phone, convoId, realDelayHuman, testDelaySec, realAt, testAt, note){
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const lg = ss.getSheetByName(SH_LOGS) || ss.insertSheet(SH_LOGS);
  lg.appendRow([
    new Date(),
    phone||'',
    convoId||'',
    event||'',
    reason||'',
    realDelayHuman||'',
    (testDelaySec!==undefined && testDelaySec!==null) ? testDelaySec : '',
    realAt ? realAt : '',
    testAt ? testAt : '',
    note||''
  ]);
}

function _conversationsFindMostRecentAny(phone) {
  const norm = _normPhoneUK(phone);
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SH_CONVOS); if (!sh) return null;
  const vals = sh.getDataRange().getValues();
  if (vals.length <= 1) return null;
  let best = null, bestTs = 0;
  for (let r = 1; r < vals.length; r++) {
    const sheetPhone = _normPhoneUK((vals[r][0]||'').toString().trim());
    if (sheetPhone !== norm) continue;
    const ts = new Date(vals[r][4]).getTime()||0;
    if (ts > bestTs) { best = vals[r]; bestTs = ts; }
  }
  if (!best) return null;
  return _rowToConvo(best);
}

function _conversationsUpsert(obj) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SH_CONVOS); 
  if (!sh) return;
  const vals = sh.getDataRange().getValues();

  const idxByKey = {
    Phone:0, ConversationID:1, Summary:2, LastInteractionsJSON:3, LastUpdated:4,
    InitiatedBy:5, TTLExpiry:6, LastBotMessageTs:7, Origin:8, TemplateSent:9,
    LastStartTs:10, LastStartKind:11, Flow:12, PendingConfirmJSON:13, Status:14,
    LastExternalOutboundTs:15, QuietUntil:16, DoNotDisturbUntil:17
  };

  // 🔹 Always normalize and force Phone to string with leading 0
  if (obj.Phone !== undefined && obj.Phone !== null) {
    obj.Phone = _normPhoneUK(obj.Phone);
  }

  let rowIdx = -1;
  if (obj.Phone && obj.ConversationID) {
    for (let r = 1; r < vals.length; r++) {
      const sheetPhone = _normPhoneUK((vals[r][0]||'').toString());
      const sheetConv  = (vals[r][1]||'').toString();
      if (sheetPhone === obj.Phone && sheetConv === String(obj.ConversationID)) { 
        rowIdx = r+1; 
        break; 
      }
    }
  }
  if (rowIdx < 0 && obj.Phone) {
    let best=-1, bestTs=0;
    for (let r=1;r<vals.length;r++){
      const sheetPhone = _normPhoneUK((vals[r][0]||'').toString());
      if (sheetPhone === obj.Phone) {
        const ts = new Date(vals[r][4]).getTime()||0;
        if (ts > bestTs) { bestTs = ts; best = r+1; }
      }
    }
    if (best > 0) rowIdx = best;
  }

  if (rowIdx < 0) {
    const line = new Array(18).fill('');
    Object.keys(idxByKey).forEach(k => {
      line[idxByKey[k]] = obj[k] !== undefined ? obj[k] : line[idxByKey[k]];
    });
    if (!line[1]) line[1] = _newConvoId();
    if (!line[4]) line[4] = new Date();
    if (!line[6]) line[6] = new Date(Date.now()+S().CONVO_TTL_MIN*60000);
    if (!line[12]) line[12] = 'availability';
    if (!line[14]) line[14] = 'Open';

    // Force Phone to text in sheet
    line[0] = obj.Phone || '';
    sh.appendRow(line);
  } else {
    const cur = sh.getRange(rowIdx,1,1,18).getValues()[0];
    const write = cur.slice();
    Object.keys(idxByKey).forEach(k => { 
      if (obj[k] !== undefined) write[idxByKey[k]] = obj[k]; 
    });
    if (!write[idxByKey['LastUpdated']]) write[idxByKey['LastUpdated']] = new Date();

    // Force Phone to text in sheet
    write[0] = obj.Phone || '';
    sh.getRange(rowIdx,1,1,18).setValues([write]);
  }
}

function _setPendingFollowup(phone, text, when, reason, note) {
  // If kill-switch is ON, force due-now so it becomes part of the backlog
  const targetWhen = _isCommsEnabled() ? when : new Date();
  const norm = _normPhoneUK(phone);
  const payload = {
    phone: norm, text, when: targetWhen.toISOString(),
    reason: reason || '', note: note || ''
  };
  CacheService.getScriptCache().put('pf:' + norm, JSON.stringify(payload), 3600);
}

function _sendOrSimulate(phone, text, templateParams){
  // AI Opt-out: block ALL sends/simulations
  if (_isAiOptOut(phone)) {
    return 'optout';
  }

  // Kill switch: block when comms are disabled
  if (typeof _isCommsEnabled === 'function' ? !_isCommsEnabled() : _isKillSwitchOn && _isKillSwitchOn()) {
    return 'blocked';
  }

  const isTest = (typeof _isTestMode === 'function') ? _isTestMode() : false;
  const allowRealInTest = _isWhitelistedForReal_(phone);

  if (isTest && !allowRealInTest) {
    // Simulate for non-whitelisted numbers in test mode
    const conv = _conversationsFindMostRecentAny(phone);
    const convoId = conv ? conv.ConversationID : _newConvoId();

    let turns = [];
    try { turns = conv ? JSON.parse(conv.LastInteractionsJSON || '[]') : []; } catch(_) {}
    turns.push({ from:'bot(simulated)', msg:String(text||''), ts:new Date().toISOString() });
    while (turns.length > (S().MAX_TURNS_TO_KEEP || 50)) turns.shift();

    _conversationsUpsert({
      Phone: phone,
      ConversationID: convoId,
      LastInteractionsJSON: JSON.stringify(turns),
      LastUpdated: new Date(),
      LastBotMessageTs: new Date(),
      Flow: (conv && conv.Flow) || 'availability',
      Status: (conv && conv.Status) || 'Open',
      TTLExpiry: new Date(Date.now() + (S().CONVO_TTL_MIN || 60) * 60000)
    });

    _logSchedule('Fired','SimulatedSend', phone, convoId, '', 0, new Date(), new Date(), String(text||'').slice(0,200));
    return 'simulated';
  }

  // Real send path (prod mode OR whitelisted in test mode)
  const res = _watiSendSessionOrTemplate(phone, text, templateParams);
  _logSchedule('Fired','RealSend', phone, '', '', '', '', '', String(text||'').slice(0,200));
  return res || 'sent';
}

function _isAiOptOut(phone) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SH_CANDIDATES);
  if (!sh) return false;
  const vals = sh.getDataRange().getValues();
  const hdr = vals[0].map(s => (s||'').toString().toLowerCase());
  const iPhone = hdr.indexOf('telephone');
  const iOptOut = hdr.indexOf('ai opt-out');
  if (iPhone < 0 || iOptOut < 0) return false;

  const target = _normPhoneKey(phone);
  for (let r = 1; r < vals.length; r++) {
    if (_normPhoneKey(vals[r][iPhone]) === target) {
      const val = (vals[r][iOptOut] || '').toString().trim().toLowerCase();
      return val === 'yes' || val === 'true';
    }
  }
  return false;
}

