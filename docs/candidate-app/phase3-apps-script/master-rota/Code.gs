function handleEdit(e) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  // Guard: only proceed for real onEdit events that include a range
  if (!e || !e.range || typeof e.range.getSheet !== 'function') {
    return; // ignore programmatic calls, onChange triggers, or malformed events
  }

  const rng       = e.range;
  const sheet     = rng.getSheet();
  const sheetName = sheet.getName();
  const tz        = ss.getSpreadsheetTimeZone();
  const oldDataMap = loadOldEmailHistory();

  // ───────────────────────────────────────────────────────────────
  // Availability sheet partial-update hook
  // Delegates to partialUpdate_onAvailabilityEdit to notify the Availability API.
  // ───────────────────────────────────────────────────────────────
  try {
    if (typeof SH_AVAIL !== 'undefined' && sheetName === SH_AVAIL) {
      // Ignore if nothing actually changed for single-cell edits (preserves prior behavior)
      if (e.oldValue != null && e.value === e.oldValue) return;

      if (typeof partialUpdate_onAvailabilityEdit === 'function') {
        partialUpdate_onAvailabilityEdit(e);
      }
      // We handled Availability edits; no need to run patient-sheet logic below.
      return;
    }
  } catch (_) {
    // never let this branch break normal onEdit behavior
  }

  // Wizard-only fast path: just colour by history
  if (e.wizardBook) {
    const cell     = rng;
    const r        = cell.getRow();
    const c        = cell.getColumn();
    const dateVal  = sheet.getRange(r, 2).getValue();
    if (dateVal && !isNaN(new Date(dateVal))) {
      const dateObj   = new Date(dateVal);
      const dateStr   = Utilities.formatDate(dateObj, tz, "dd/MM/yyyy");
      const key       = String(cell.getValue()).trim().toLowerCase();
      const history   = oldDataMap[key] || [];
      const shiftLabel= String(sheet.getRange(4, c).getValue()).toLowerCase();
      const match     = history.find(s =>
        String(s.date).trim() === dateStr &&
        shiftLabel.includes(String(s.shift).toLowerCase())
      );

      const refCell = sheet.getRange(r + 1, c);
      const refVal  = String(refCell.getValue()).trim();

      if (match) {
        cell.setBackground("#ccffcc");
        refCell.setBackground((String(match.reference).trim() === refVal && !!refVal) ? "#ccffcc" : "#ff9999");
      } else {
        cell.setBackground("#ff9999");
        refCell.setBackground("#ff9999");
      }
    }
    return;
  }

  // 1) ignore if nothing changed
  if (e.oldValue != null && e.value === e.oldValue) {
    return;
  }

  // 2) sheet-name guard (patient rota sheets only)
  if (!isPatientSheetName(sheetName)) {
    return;
  }

  const row0 = rng.getRow(), col0 = rng.getColumn();
  // 3) row/col guard
  if (row0 <= 4 || col0 <= 2) {
    return;
  }
  // 4) header guard
  if (!sheet.getRange(3, col0).getValue()) {
    return;
  }

  // Collect descriptors for any edited NAME cell inside the rota area
  const borderCells = [];

  // 5) iterate each cell in the edited range
  const numRows = rng.getNumRows(), numCols = rng.getNumColumns();
  for (let dr = 0; dr < numRows; dr++) {
    for (let dc = 0; dc < numCols; dc++) {
      const cell = rng.getCell(dr + 1, dc + 1),
            r    = cell.getRow(),
            c    = cell.getColumn();

      // skip if column A blank
      if (!sheet.getRange(r, 1).getValue()) {
        continue;
      }

      // skip if header in row 3 is blank
      if (!sheet.getRange(3, c).getValue()) {
        continue;
      }

      const isNameRow = r >= 5 && ((r - 5) % 2 === 0),
            isRefRow  = r >= 6 && ((r - 6) % 2 === 0);
      if (!isNameRow && !isRefRow) {
        continue;
      }

      if (isNameRow) {
        // This NAME cell is inside the rota range and was edited
        borderCells.push({
          sheetName: sheetName,
          rowIndex:  r,
          colIndex:  c
        });

        // Name-row logic
        const newNameRaw = cell.getValue();
        if (!newNameRaw) {
          cell.setBackground("#ff9999");
          continue;
        }

        // Conflict & adjacency checks
        const newName = String(newNameRaw).trim().toLowerCase();
        const shiftLabel = String(sheet.getRange(4, c).getValue()).toLowerCase();
        const thisShift  = shiftLabel.includes("night") ? "night" : "day";
        const dateVal    = sheet.getRange(r, 2).getValue();
        if (!dateVal || isNaN(new Date(dateVal))) {
          continue;
        }
        const dateObj = new Date(dateVal);
        const dateKey = Utilities.formatDate(dateObj, tz, "yyyyMMdd");

        const occupantMap = buildOccupantMapSkippingEditedCell({ range: cell });
        // Same-day double-book
        if (occupantMap[newName] && occupantMap[newName][dateKey]) {
          revertNameWithAlert({ range: cell }, newNameRaw, occupantMap[newName][dateKey], "Already booked that day!");
          continue;
        }
        // Adjacency
        if (thisShift === "day") {
          const prev    = new Date(dateObj); prev.setDate(prev.getDate() - 1);
          const prevKey = Utilities.formatDate(prev, tz, "yyyyMMdd");
          if (occupantMap[newName] && occupantMap[newName][prevKey]?.shift === "night") {
            revertNameWithAlert({ range: cell }, newNameRaw, occupantMap[newName][prevKey], "Worked NIGHT previous day, cannot do DAY!");
            continue;
          }
        } else {
          const nxt    = new Date(dateObj); nxt.setDate(nxt.getDate() + 1);
          const nxtKey = Utilities.formatDate(nxt, tz, "yyyyMMdd");
          if (occupantMap[newName] && occupantMap[newName][nxtKey]?.shift === "day") {
            revertNameWithAlert({ range: cell }, newNameRaw, occupantMap[newName][nxtKey], "Has DAY next day, cannot do NIGHT!");
            continue;
          }
        }

        // Job/gender validation
        try {
          validateJobTitleAgainstColumn({ ...e, range: cell });
        } catch (err) {
          continue;
        }

        // Colour by history
        try {
          const dateStr = Utilities.formatDate(dateObj, tz, "dd/MM/yyyy");
          const history = oldDataMap[newName] || [];
          const match   = history.find(s =>
            String(s.date).trim() === dateStr &&
            shiftLabel.includes(String(s.shift).toLowerCase())
          );

          const refCell = sheet.getRange(r + 1, c);
          const refVal  = String(refCell.getValue()).trim();
          if (match) {
            cell.setBackground("#ccffcc");
            refCell.setBackground((String(match.reference).trim() === refVal && !!refVal) ? "#ccffcc" : "#ff9999");
          } else {
            cell.setBackground("#ff9999");
            refCell.setBackground("#ff9999");
          }
        } catch (err) {
          // ignore
        }

      } else if (isRefRow) {
        // Reference-row logic
        const occupantCell = sheet.getRange(r - 1, c);
        const occ          = String(occupantCell.getValue()).trim().toLowerCase();
        const ref          = String(cell.getValue()).trim();
        if (!occ) {
          cell.setBackground("#ff9999");
          continue;
        }
        const dateVal = sheet.getRange(r - 1, 2).getValue();
        if (!dateVal || isNaN(new Date(dateVal))) {
          continue;
        }
        const dateObj   = new Date(dateVal);
        const dateStr   = Utilities.formatDate(dateObj, tz, "dd/MM/yyyy");
        const shiftLabel= String(sheet.getRange(4, c).getValue()).toLowerCase();
        const history   = oldDataMap[occ] || [];
        const match     = history.find(s =>
          String(s.date).trim() === dateStr &&
          shiftLabel.includes(String(s.shift).toLowerCase())
        );
        if (match) {
          occupantCell.setBackground("#ccffcc");
          cell.setBackground((String(match.reference).trim() === ref) ? "#ccffcc" : "#ff9999");
        } else {
          occupantCell.setBackground("#ff9999");
          cell.setBackground("#ff9999");
        }
      }
    }
  }

  // Call updateCellBorders for all edited NAME cells inside the rota range
  if (borderCells.length) {
    updateCellBorders(borderCells);
  }

  // Final housekeeping
  logChanges(e);
  colorVacantShiftsIfCanceled(e);
}

/** ─────────────────────────────────────────────────────────────────────────────
 * Availability API integration – NEW helpers & partial-update pipeline
 * These functions are NEW. They do not modify existing logic elsewhere.
 * Ensure Script Properties include:
 *   AVAILABILITY_API_URL  → e.g. https://script.google.com/macros/s/XXX/exec
 *   AVAILABILITY_API_TOKEN
 * Optional:
 *   AV_PARTIAL_FLUSH_DELAY_MS (default 2000)
 * ────────────────────────────────────────────────────────────────────────────*/

/** Generic HTTP emitter to the Availability API */

function _postAvailabilityEvent(action, payload) {
  const sp   = PropertiesService.getScriptProperties();
  const url  = sp.getProperty('AVAILABILITY_API_URL');
  const t    = sp.getProperty('AVAILABILITY_API_TOKEN');

  if (!url || !t) throw new Error('Availability API URL/TOKEN not configured');

  const body = Object.assign({ action, t }, payload || {});
  const legacyResult = _postWithRetry(url, body, { maxAttempts: 3, backoffMs: 1000 });
  if (typeof ctmsP3_masterMirrorLegacyEvent_ === 'function') {
    ctmsP3_masterMirrorLegacyEvent_(action, payload, legacyResult);
  }
  return legacyResult;
}

/** POST with simple retry/backoff (handles API BUSY/503/429 semantics) */
function _postWithRetry(url, body, opts) {
  const maxAttempts = (opts && opts.maxAttempts) || 3;
  const backoffMs   = (opts && opts.backoffMs)   || 1000;

  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    try {
      const res = UrlFetchApp.fetch(url, {
        method: 'post',
        contentType: 'application/json',
        muteHttpExceptions: true,
        payload: JSON.stringify(body || {})
      });
      const code = res.getResponseCode();
      const txt  = res.getContentText() || '';
      let json   = null;
      try { json = txt ? JSON.parse(txt) : null; } catch (_) {}

      // Accept normal OK or {ok:true}
      if (code >= 200 && code < 300) {
        return { httpCode: code, json, rawText: txt };
      }

      // BUSY handling via JSON or 429/503 fallback
      const isBusy = (json && (json.status === 'BUSY' || json.error === 'TEMPORARILY_BUSY_TRY_AGAIN'))
                  || code === 429 || code === 503;
      if (isBusy && attempt < maxAttempts) {
        Utilities.sleep(backoffMs * attempt);
        continue;
      }

      // Hard failure
      return { httpCode: code, json, rawText: txt };
    } catch (e) {
      if (attempt < maxAttempts) {
        Utilities.sleep(backoffMs * attempt);
        continue;
      }
      return { httpCode: -1, json: null, rawText: String(e && e.message || e) };
    }
  }
  return { httpCode: -1, json: null, rawText: 'unknown error' };
}

/** --------- Helpers for logging & safety (kept local for simplicity) --------- */
function _logApiEvent(fnName, phase, data) {
  try {
    // Prefer active spreadsheet; if not available, bail gracefully
    const ss = SpreadsheetApp.getActiveSpreadsheet ? SpreadsheetApp.getActiveSpreadsheet() : null;
    if (!ss) { try { Logger.log('%s %s %s', fnName, phase, JSON.stringify(data || {})); } catch (_) {} return; }

    let sh = ss.getSheetByName('Logs');
    if (!sh) {
      sh = ss.insertSheet('Logs');
      sh.appendRow(['Timestamp', 'Function', 'Phase', 'Details']);
    }

    const payload = JSON.stringify(data || {});
    // Chunk to fit cell limits (approx)
    const MAX = 45000;
    if (payload.length <= MAX) {
      sh.appendRow([new Date(), fnName, String(phase || ''), payload]);
    } else {
      let idx = 0, chunk = 0;
      while (idx < payload.length) {
        sh.appendRow([new Date(), fnName, String(phase || '') + `#${chunk}`, payload.slice(idx, idx + MAX)]);
        idx += MAX; chunk++;
      }
    }
    SpreadsheetApp.flush();
  } catch (_) {
    try { Logger.log('log error %s %s', fnName, phase); } catch (__){ }
  }
}

function _redactSecrets(obj) {
  try {
    return JSON.parse(JSON.stringify(obj, function(k, v) {
      const key = (k || '').toString().toLowerCase();
      if (key === 't' || key === 'token' || key.endsWith('_token')) {
        if (typeof v === 'string') {
          const len = v.length;
          if (len <= 8) return '***';
          return v.slice(0, 4) + '...' + v.slice(-4);
        }
        return '***';
      }
      return v;
    }));
  } catch (_) {
    return { redactionError: true };
  }
}

function _truncate(s, max) {
  s = String(s || '');
  return s.length > max ? s.slice(0, max) + '…[truncated]' : s;
}

