/**
 * Evaluate compliance for a single candidate key, logging each check
 * and dumping the raw map contents first.
 */
/**
 * Evaluate compliance for a single candidate key (no logging).
 */

function checkCompliance(key, ctx) {
  var map   = (ctx && ctx.map) ? ctx.map : buildComplianceMap();
  var cfg   = (ctx && ctx.rules) ? { rules: ctx.rules } : getRules();
  var rules = cfg.rules;

  if (!map[key] || map[key].status === 'CAUTION') {
    return { result:'CAUTION', details:['No Public ID'] };
  }

  var items    = map[key].items;
  var failures = [];

  for (var item in rules) {
    var allowed   = rules[item] || [];
    if (allowed.indexOf('Ignore') >= 0) continue;

    var value     = items[item] || '';

    if (allowed.indexOf('Not Expired') >= 0) {
      var exp = Date.parse(value);
      if (isNaN(exp) || exp < Date.now()) {
        failures.push(item + ': expired or missing');
      }
    }

    if (allowed.indexOf('Yes') >= 0 && value !== 'YES') {
      failures.push(item + ': expected YES, got ' + value);
    }

    if (allowed.indexOf('No') >= 0 && value !== 'NO') {
      failures.push(item + ': expected NO, got ' + value);
    }
  }

  return {
    result:  failures.length ? 'FAIL' : 'PASS',
    details: failures
  };
}
