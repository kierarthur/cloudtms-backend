   ========================= */

/**
 * Append a single row to "Logs" with the raw JSON payload.
 * Columns:
 *  A: Timestamp
 *  B: Source (e.g., 'WATI')
 *  C: Action (e.g., 'WATI_OUTBOUND', 'WATI_INBOUND', 'ERROR')
 *  D: Phone (if present)
 *  E: TemplateName (if present)
 *  F: Origin/Source (if present)
 *  G: Status/Note (optional)
