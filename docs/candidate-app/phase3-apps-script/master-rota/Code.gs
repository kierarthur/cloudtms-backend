// One-call WATI bulk template using SAME convention as your other broadcast (namespace + customParams)
function _sendWATIBulkTemplate_Generic(templateName, receivers, broadcastName, tz) {
  const tenant = '601205';
  const url    = `https://eu-api.wati.io/${tenant}/api/v2/sendTemplateMessages`;

  const payload = {
    template_namespace: 'your_template_namespace_here', // use the SAME namespace you use elsewhere
    template_name:      templateName,                   // 'sussex_rota_ended_extra'
    broadcast_name:     broadcastName || `RotaEnd_${Utilities.formatDate(
      new Date(),
      tz || Session.getScriptTimeZone() || 'Etc/GMT',
      'yyyyMMdd_HHmmss'
    )}`,
    receivers                                            // [{ whatsappNumber, customParams:[{name,value},...] }]
  };

  const resp = UrlFetchApp.fetch(url, {
    method:             'post',
    contentType:        'application/json',
    headers:            { Authorization: WATI_TOKEN },
    payload:            JSON.stringify(payload),
    muteHttpExceptions: true
  });

  const httpCode = resp.getResponseCode();
  const rawText  = resp.getContentText() || '';
  let json = null;
  try { json = JSON.parse(rawText); } catch (_) {}

  return { httpCode, json, rawText };
}


