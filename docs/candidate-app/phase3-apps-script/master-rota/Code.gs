/** Read one candidate row from Candidate List. */
function readCandidateRow(rowNo) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(CANDIDATE_SHEET_NAME);
  if (!sh) return null;
  const last = sh.getLastRow();
  if (rowNo < 2 || rowNo > last) return null;

  // Read full width so COL.* can be anywhere (incl. STATUS at L)
  const row = sh.getRange(rowNo, 1, 1, sh.getLastColumn()).getValues()[0];

  return {
    rowNo,
    surname:   String(row[COL.SURNAME   - 1] || ''),
    firstname: String(row[COL.FIRSTNAME - 1] || ''),
    email:     String(row[COL.EMAIL     - 1] || ''),
    telephone: String(row[COL.TELEPHONE - 1] || ''),
    jobTitle:  String(row[COL.JOBTITLE  - 1] || ''),
    gender:    String(row[COL.GENDER    - 1] || ''),
    tier:      String(row[COL.TIER      - 1] || ''),
    publicId:  String(row[COL.PUBLICID  - 1] || ''),
    status:    (String(row[COL.STATUS   - 1] || 'ACTIVE').toUpperCase() === 'INACTIVE') ? 'INACTIVE' : 'ACTIVE',
  };
}

/** Validate + normalise add/edit payload. Enforces "no spaces in names" and title-cases. */
function validateAndNormaliseCandidatePayload(p, { requireRowNo }) {
  if (!p) throw new Error('Missing payload.');
  const require = (v, msg) => { if (!String(v || '').trim()) throw new Error(msg); };
  const hasNoSpaces = (s) => !/\s/.test(String(s || ''));

  // RowNo guard (used for edits)
  if (requireRowNo && !p.rowNo) throw new Error('Row number is required.');

  // Requireds
  require(p.surname,   'Surname is required.');
  require(p.firstname, 'First name is required.');
  require(p.email,     'Email is required.');
  require(p.telephone, 'Telephone is required.');
  require(p.jobTitle,  'Job Title is required.');
  require(p.gender,    'Gender is required.');
  require(p.tier,      'Tier is required.');

  // Names: no spaces
  if (!hasNoSpaces(p.surname) || !hasNoSpaces(p.firstname)) {
    throw new Error('Spaces are not permitted in names — please add a hyphen instead.');
  }

  // Normalise names: Title Case for Candidate List/rotas display
  const surnameTC   = titleCaseNamePart(String(p.surname).trim());
  const firstnameTC = titleCaseNamePart(String(p.firstname).trim());

  // Email + tel basic validation (server-side; client already checked)
  const email = String(p.email).trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new Error('Invalid email format.');
  const telephone = String(p.telephone).trim();
  if (!telephone) throw new Error('Telephone is required.');

  // Status: only ACTIVE / INACTIVE; default to ACTIVE
  let status = String(p.status || 'ACTIVE').trim().toUpperCase();
  status = (status === 'INACTIVE') ? 'INACTIVE' : 'ACTIVE';

  return {
    rowNo:     p.rowNo ? Number(p.rowNo) : undefined,
    surname:   surnameTC,
    firstname: firstnameTC,
    email,
    telephone,
    jobTitle:  String(p.jobTitle).trim(),
    gender:    String(p.gender).trim(),
    tier:      String(p.tier).trim(),
    publicId:  String(p.publicId || '').trim(),
    status, // ← enforced ACTIVE/INACTIVE
  };
}

/** Duplicate detection in Candidate List. Returns error message string if dup, else null. */
function findDuplicateInCandidateList({ email, telephone, nameLower, ignoreRowNo }) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(CANDIDATE_SHEET_NAME);
  if (!sh) return null;
  const last = sh.getLastRow();
  if (last < 2) return null;

  const rng = sh.getRange(2, 1, last - 1, 9).getValues();
  const telCanon = telephone ? canonicalisePhone(telephone) : null;
  const emailLower = email ? String(email).trim().toLowerCase() : null;

  for (let i = 0; i < rng.length; i++) {
    const rowNo = i + 2;
    if (ignoreRowNo && rowNo === ignoreRowNo) continue;
    const row = rng[i];
    const rSurname   = String(row[COL.SURNAME   - 1] || '');
    const rFirstname = String(row[COL.FIRSTNAME - 1] || '');
    const rEmail     = String(row[COL.EMAIL     - 1] || '');
    const rTel       = String(row[COL.TELEPHONE - 1] || '');

    if (emailLower && rEmail.toLowerCase() === emailLower) return 'This candidate already exists (duplicate email).';
    if (telCanon && canonicalisePhone(rTel) === telCanon)   return 'This candidate already exists (duplicate telephone).';

    if (nameLower) {
      const rKey = nameKeyLower(rSurname, rFirstname);
      if (rKey === nameLower) return 'This candidate already exists (duplicate name).';
    }
  }
  return null;
}

/** Propagate rename to occupant cells on active rotas (exact matches only). */
function propagateRenameOnActiveRotas(oldKeyLower, newSurnameTC, newFirstnameTC) {
  const newDisplay = `${newSurnameTC} ${newFirstnameTC}`;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets().filter(s => isPatientSheetName(s.getName()));
  if (!sheets.length) return;

  // Build occupants map per sheet; update matches
  sheets.forEach(sheet => {
    const occMap = buildAllOccupants([sheet]); // user-provided helper (we include below)
    const matches = occMap[oldKeyLower] || [];
    if (!matches.length) return;

    // Update each matched cell's value to newDisplay (in-place). No row adds/deletes.
    matches.forEach(m => {
      sheet.getRange(m.row, m.col).setValue(newDisplay);
    });
  });
}

/** Update EmailHistory name column only: old lower → new lower. No row adds/deletes. */
function updateEmailHistoryName(oldKeyLower, newKeyLower) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(EMAIL_HISTORY_SHEET);
  if (!sh) return;

  const data = sh.getDataRange().getValues();
  if (data.length < 2) return;

  for (let i = 1; i < data.length; i++) {
    const nameCell = String(data[i][0] || '').toLowerCase().trim();
    if (!nameCell) continue;
    if (nameCell === oldKeyLower) {
      sh.getRange(i + 1, 1).setValue(newKeyLower); // column A assumed for name
    }
  }
}

/** True if candidate has future or in-progress (incl. overnight) bookings on rotas. */
function hasFutureOrActiveBookings(nameLower) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets().filter(s => isPatientSheetName(s.getName()));
  if (!sheets.length) return false;

  const tz = ss.getSpreadsheetTimeZone();
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

  // Check today & future, and also "yesterday night rolling into today"
  const yesterday = new Date(today);
  yesterday.setDate(today.getDate() - 1);

  for (const sheet of sheets) {
    const occMap = buildAllOccupants([sheet]); // entries have: date (dd/MM/yyyy), shift (row 4 label), note, row, col
    const entries = occMap[nameLower] || [];
    if (!entries.length) continue;

    for (const e of entries) {
      const d = parseDateDDMMYYYY(e.date);
      if (isNaN(d)) continue;

      // Any future date → block
      if (d.getTime() > today.getTime()) return true;

      // Today in-progress?
      if (sameDay(d, today)) {
        const win = parseShiftWindowFromRow4Label(e.shift, e.date, tz);
        if (win && win.start && win.end) {
          // Handle normal same-day window
          if (win.end.getTime() >= win.start.getTime()) {
            if (now >= win.start && now < win.end) return true;
          } else {
            // Overnight window (e.g., Night 1930-0800hrs): for today's date,
            // treat as in-progress once we pass the start time this evening.
            if (now >= win.start) return true; // will run into tomorrow morning
          }
        } else {
          // Conservative if malformed but we have a label
          if (looksLikeNight(e.shift)) {
            const endFallback = combineDateTime(today, DEFAULT_NIGHT_END, tz);
            if (now < endFallback) return true;
          } else {
            // Day today with unknown times → conservative block
            return true;
          }
        }
      }

      // Overnight: yesterday Night rolling into today (e.g., 1930-0800hrs)
      if (sameDay(d, yesterday)) {
        const winY = parseShiftWindowFromRow4Label(e.shift, e.date, tz);
        if (winY && winY.start && winY.end && winY.end.getTime() < winY.start.getTime()) {
          // Carry end to today
          const carriedEnd = new Date(winY.end.getTime() + 24 * 3600 * 1000);
          if (now < carriedEnd) return true;
        } else if (looksLikeNight(e.shift)) {
          // No times parsed, but Night label → block until default end today
          const endFallback = combineDateTime(today, DEFAULT_NIGHT_END, tz);
          if (now < endFallback) return true;
        }
      }
    }
  }

  return false;
}

/** True if EmailHistory has any entry for nameLower with date >= today. */
function emailHistoryHasDateOnOrAfterToday(nameLower) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();
  const today = new Date();
  const todayNoTime = new Date(today.getFullYear(), today.getMonth(), today.getDate());
  const histMap = loadOldEmailHistory(); // provided below; maps lowercased name → [{date, ...}]
  const list = histMap[nameLower] || [];
  for (const h of list) {
    const d = parseDateDDMMYYYY(h.date);
    if (!isNaN(d) && d.getTime() >= todayNoTime.getTime()) return true;
  }
  return false;
}

/************************************************************
 * DATE/TIME & PARSING HELPERS
 ************************************************************/


function sameDay(a, b) {
  return a.getFullYear() === b.getFullYear()
    && a.getMonth() === b.getMonth()
    && a.getDate() === b.getDate();
}

/** From Row 4 label like "Long Day 0730-2000hrs" or "Night 1930-0800hrs". */
function parseShiftWindowFromRow4Label(label, dateStrDDMMYYYY, tz) {
  if (!label) return null;
  const m = String(label).match(/(\d{3,4})-(\d{3,4})\s*hrs/i);
  if (!m) return null;
  // normalise 0730 => 07:30
  const s = normalizeHHMM(m[1]);
  const e = normalizeHHMM(m[2]);
  if (!s || !e) return null;

  const d = parseDateDDMMYYYY(dateStrDDMMYYYY);
  if (isNaN(d)) return null;

  const start = combineDateTime(d, s, tz);
  const end   = combineDateTime(d, e, tz);
  return { start, end };
}

function combineDateTime(dateObj, hhmm, tz) {
  // hhmm = "HH:MM"
  const [H, M] = hhmm.split(':').map(Number);
  const d = new Date(dateObj.getFullYear(), dateObj.getMonth(), dateObj.getDate(), H, M, 0, 0);
  return d;
}

function normalizeHHMM(s) {
  const raw = String(s || '').trim();
  if (!/^\d{3,4}$/.test(raw)) return null;
  const padded = raw.padStart(4, '0');
  return `${padded.slice(0,2)}:${padded.slice(2)}`;
}

function looksLikeNight(label) {
  const L = String(label || '').toLowerCase();
  return /^night\b/.test(L) || L === 'n';
}

/************************************************************
 * STRING & NAME HELPERS
 ************************************************************/

function nameKeyLower(surname, firstname) {
  return `${String(surname||'').trim().toLowerCase()} ${String(firstname||'').trim().toLowerCase()}`;
}

function canonicalisePhone(tel) {
  // keep leading +, strip non-digits
  let s = String(tel || '').trim();
  const plus = s.startsWith('+');
  s = s.replace(/[^\d]/g, '');
  return plus ? ('+' + s) : s;
}

function titleCaseNamePart(s) {
  // No spaces allowed in parts (enforced elsewhere). Respect hyphens and apostrophes.
  const str = String(s || '').trim();
  if (!str) return '';
  const splitter = /([-'])/g;
  const parts = str.split(splitter);
  for (let i = 0; i < parts.length; i++) {
    const p = parts[i];
    if (p === '-' || p === "'") continue;
    parts[i] = p ? (p.charAt(0).toUpperCase() + p.slice(1).toLowerCase()) : p;
  }
  return parts.join('');
}

