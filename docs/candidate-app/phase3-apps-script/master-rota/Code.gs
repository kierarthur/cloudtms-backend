/**
 * header: the raw header string from row 3 (e.g. "RMN (Male or Female)", "Female RMN")
 * jobTitle: candidateInfo.jobTitle, uppercase "RMN" or "HCA"
 * gender:   candidateInfo.gender, lowercase "male" or "female"
 */
function candidateMatchesHeader(header, jobTitle, gender) {
  const baseMatch = header.match(/\b(RMN|HCA)\b/i);
  if (!baseMatch) return false;
  const base = baseMatch[1].toUpperCase();
  if (jobTitle !== base) return false;

  // unisex?
  if (/\(male or female\)/i.test(header)) return true;
  // gender‑specific?
  if (/female/i.test(header) && gender === "female") return true;
  if (/male/i.test(header)   && gender === "male")   return true;

  return false;
}


