/**
 * Menu handler: refreshes Credentially docs, then compliance cache.
 */

function refreshCredentiallyAndCompliance() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const props = PropertiesService.getScriptProperties();
  const POST_PROP = 'POST_CDOCS_COMPLIANCE';
  const toast = (msg, title, secs) => { try { ss.toast(msg, title || '', secs || 5); } catch (e) {} };

  try {
    if (typeof clearCredentiallyComplianceRunStatus_ === 'function') {
      clearCredentiallyComplianceRunStatus_();
    }
  } catch (e) {}

  props.setProperty(POST_PROP, '1');
  setCredentiallyComplianceRunStatus_({
    manual: true,
    active: true,
    stage: 'queued_credentially',
    message: 'Credentially refresh queued',
    startedAt: new Date().toISOString(),
    credentiallyNextIndex: 0,
    credentiallyTotalCandidates: null,
    complianceNextIndex: 0,
    complianceTotalCandidates: null,
    error: ''
  });

  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) {
    setCredentiallyComplianceRunStatus_({
      manual: true,
      active: true,
      stage: 'queued_credentially',
      message: 'Credentially refresh already running; compliance will follow automatically',
      error: ''
    });
    toast('Credentially refresh already running; compliance will follow automatically.', 'Busy', 8);
    try { if (typeof showCredentiallyComplianceProgressDialog === 'function') showCredentiallyComplianceProgressDialog(); } catch (e) {}
    return;
  }

  let lockReleased = false;
  try {
    setCredentiallyComplianceRunStatus_({
      manual: true,
      active: true,
      stage: 'credentially_starting',
      message: 'Starting Credentially refresh',
      error: ''
    });

    try { if (typeof showCredentiallyComplianceProgressDialog === 'function') showCredentiallyComplianceProgressDialog(); } catch (e) {}

    toast('Updating Credentially documents…', 'Started', 8);
    try {
      if (typeof logminimal === 'function') {
        logminimal('menu', 'refreshCredentiallyAndCompliance', { stage: 'started' });
      }
    } catch (e) {}

    try {
      lock.releaseLock();
      lockReleased = true;
    } catch (e) {}

    if (typeof updateCredentiallyDocs !== 'function') throw new Error('updateCredentiallyDocs() not found');
    updateCredentiallyDocs();
  } catch (err) {
    setCredentiallyComplianceRunStatus_({
      manual: true,
      active: false,
      stage: 'failed',
      message: 'Credentially refresh failed',
      error: String(err && err.message ? err.message : err)
    });
    toast(`Failed: ${err.message}`, 'Error', 12);
    throw err;
  } finally {
    if (!lockReleased) {
      try { lock.releaseLock(); } catch (e) {}
    }
  }
}


/**************************************************************
 * nextshiftisverysoon — Bulk WATI template sender (uses your
 * existing helpers: _sendWATIBulkTemplate_Generic,
 * _normalizeUkPhoneForWati_, _ensureLogsSheet_)
 *
 * - Morning (05:00–06:00): Long Day only
 * - Evening (17:00–18:00): Night only
 * - Timezone: Europe/London (uses the sheet’s TZ if set)
 * - Reads ONLY from EmailHistory + Candidate List
 * - TEST mode logs full would-be payload for everyone, but
 *   actually sends only to "arthur kier"
 **************************************************************/

/** ───────────────────────────────────────────────────────────
 * ENTRY POINTS — add these to time-based triggers
 * ─────────────────────────────────────────────────────────── */
function sendNextShiftMorning() {
  sendNextShiftIsVerySoonReminders('MORNING');
}
function sendNextShiftEvening() {
  sendNextShiftIsVerySoonReminders('EVENING');
}

/** Main orchestrator. windowHint ∈ {"MORNING","EVENING"} (optional) */
function sendNextShiftIsVerySoonReminders(windowHint) {
  // ── TEST FLAG (required at top)
  const REMINDERS_TEST = false;



  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone() || 'Europe/London';
  const now = new Date();

  // Determine run window if not supplied
  const hourLocal = Number(Utilities.formatDate(now, tz, 'H')); // 0..23
  const windowChosen =
    windowHint ||
    ((hourLocal >= 5 && hourLocal < 7) ? 'MORNING'
     : (hourLocal >= 17 && hourLocal < 19) ? 'EVENING'
     : (hourLocal < 12 ? 'MORNING' : 'EVENING')); // fallback

  const wantLongDay = (windowChosen === 'MORNING');
  const wantNight   = (windowChosen === 'EVENING');

  // Build candidate index from Candidate List (keyed by "surname firstname")
  const candidateMap = _buildCandidateIndexForReminders_(tz);

  // Load today’s rows from EmailHistory filtered by window
  const rowsToday = _loadEmailHistoryTodayByWindowForReminders_(tz, wantLongDay, wantNight);

  const nowHHmm  = Number(Utilities.formatDate(now, tz, 'HHmm'));
  const BCAST    = Utilities.formatDate(now, tz, 'ddMMyyyyHHmmss'); // required non-blank
  const TPL_NAME = 'nextshiftisverysoon';
  const NAMESPACE = 'shiftreminder'; // for logging context only

  const TEST_ALLOW_KEY = 'arthur kier'; // normalized key we actually send to in TEST
  const receivers = [];                 // what we will send to WATI
  const sentNumbers = new Set();        // dedupe by whatsapp number

  // Logs sheet (your existing shape) — only used in TEST mode
  const logsSheet = REMINDERS_TEST ? _ensureLogsSheet_() : null;

  for (const r of rowsToday) {
    const okeyRaw = String(r.occupantKey || '').trim();
    const okey    = _normalizeName_(okeyRaw);

    // Lookup candidate by key
    const cand = candidateMap[okey];
    if (!cand) {
      if (REMINDERS_TEST) _logReminder_(logsSheet, tz, 'INFO', 'WATI_REMINDER', 'NO_MATCH',
        { occupantKey: okeyRaw }, okeyRaw, windowChosen);
      continue;
    }
    if (cand.skipWhatsApp) {
      if (REMINDERS_TEST) _logReminder_(logsSheet, tz, 'INFO', 'WATI_REMINDER', 'SKIPPED_OPT_OUT',
        { occupantKey: okeyRaw, phoneTail: _tail_(cand.phone) }, okeyRaw, windowChosen);
      continue;
    }

    // Derive start time HHmm (Notes Start: HH:MM overrides Shift)
    const startHHmm = _deriveStartHHmm_(r.shiftText, r.notes);
    if (!startHHmm) {
      if (REMINDERS_TEST) _logReminder_(logsSheet, tz, 'WARN', 'WATI_REMINDER', 'SKIPPED_MISSING_PARAM:start',
        { occupantKey: okeyRaw, phoneTail: _tail_(cand.phone) }, okeyRaw, windowChosen);
      continue;
    }
    if (Number(startHHmm) < 0 || Number.isNaN(Number(startHHmm))) {
      if (REMINDERS_TEST) _logReminder_(logsSheet, tz, 'WARN', 'WATI_REMINDER', 'SKIPPED_BAD_START_FORMAT',
        { occupantKey: okeyRaw, startHHmm }, okeyRaw, windowChosen);
      continue;
    }

    // Always skip if already past start (strictly greater)
    if (nowHHmm > Number(startHHmm)) {
      if (REMINDERS_TEST) _logReminder_(logsSheet, tz, 'INFO', 'WATI_REMINDER', 'SKIPPED_PAST_START',
        { occupantKey: okeyRaw, nextshift: startHHmm, phoneTail: _tail_(cand.phone) }, okeyRaw, windowChosen);
      continue;
    }

    // Required non-blank params
    const forename = _deriveForename_(okeyRaw);
    const hospital = (r.hospital || '').toString().trim();
    const ward     = (r.ward || '').toString().trim();

    if (!forename || !hospital || !ward) {
      if (REMINDERS_TEST) _logReminder_(logsSheet, tz, 'WARN', 'WATI_REMINDER', 'SKIPPED_MISSING_PARAM',
        { occupantKey: okeyRaw, forename, hospital, ward }, okeyRaw, windowChosen);
      continue;
    }

    // Phone must be 447… and valid per your normalizer
    const phone = cand.phone;
    if (!phone || !_isValidUk447_(phone)) {
      if (REMINDERS_TEST) _logReminder_(logsSheet, tz, 'WARN', 'WATI_REMINDER', 'SKIPPED_NO_PHONE',
        { occupantKey: okeyRaw, phone }, okeyRaw, windowChosen);
      continue;
    }

    // De-duplicate by number
    if (sentNumbers.has(phone)) {
      if (REMINDERS_TEST) _logReminder_(logsSheet, tz, 'INFO', 'WATI_REMINDER', 'DEDUP_NUMBER',
        { occupantKey: okeyRaw, phoneTail: _tail_(phone) }, okeyRaw, windowChosen);
      continue;
    }

    // Build template parameters (your existing bulk API expects "parameters")
    const parameters = [
      { name: 'forename',          value: forename },
      { name: 'nextshifthospital', value: hospital },
      { name: 'nextshiftward',     value: ward },
      { name: 'nextshift',         value: startHHmm }
    ];

    // TEST mode: only actually send to Kier; log everyone else as WOULD_SEND
    if (REMINDERS_TEST) {
      const meta = {
        occupantKey: okeyRaw,
        phoneTail: _tail_(phone),
        template: TPL_NAME,
        namespace: NAMESPACE,
        broadcast_name: BCAST,
        params: _paramsToObj_(parameters)
      };

      if (okey === TEST_ALLOW_KEY) {
        receivers.push({ whatsappNumber: phone, customParams: parameters });
        sentNumbers.add(phone);
        _logReminder_(logsSheet, tz, 'INFO', 'WATI_REMINDER', 'SENT_ACTUAL', meta, okeyRaw, windowChosen);
      } else {
        _logReminder_(logsSheet, tz, 'INFO', 'WATI_REMINDER', 'WOULD_SEND', meta, okeyRaw, windowChosen);
      }
    } else {
      // LIVE mode: include everyone; no logging
      receivers.push({ whatsappNumber: phone, customParams: parameters });
      sentNumbers.add(phone);
    }
  }

  // Single bulk send (only if something to send)
  if (receivers.length > 0) {
    // Uses your existing sender. It expects:
    // - template_name
    // - receivers [{ whatsappNumber, parameters: [...] }]
    // - broadcast_name (we pass ddMMyyyyHHmmss to satisfy non-blank rule)
    _sendWATIBulkTemplate_Generic(TPL_NAME, receivers, BCAST, tz);
  }
}

/* ───────────────────────────────────────────────────────────
 * Candidate index from "Candidate List" (uses your phone normalizer)
 * ─────────────────────────────────────────────────────────── */
function _buildCandidateIndexForReminders_(tz) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('Candidate List');
  if (!sh) return {};
  const data = sh.getDataRange().getValues();
  if (data.length < 2) return {};

  const hdr = data[0].map(h => String(h || '').trim().toLowerCase());
  const col = {
    surname:   hdr.indexOf('surname'),
    firstname: hdr.indexOf('first name'),
    email:     hdr.indexOf('email'),
    telephone: hdr.indexOf('telephone'),
    jobTitle:  hdr.indexOf('job title'),
    gender:    hdr.indexOf('gender'),
    waRem:     hdr.indexOf('whatsapp reminders'),
    tier:      hdr.indexOf('tier'),
    publicId:  hdr.indexOf('public id - credentially'),
  };

  const map = {};
  for (let i = 1; i < data.length; i++) {
    const row = data[i];

    const surname   = _safeCell_(row, col.surname);
    const firstName = _safeCell_(row, col.firstname);
    if (!surname || !firstName) continue;

    const key = _normalizeName_(surname + ' ' + firstName);

    // Use your existing normalizer to produce 447… format
    const telRaw = _safeCell_(row, col.telephone);
    if (!telRaw) continue;
    const normalized = _normalizeUkPhoneForWati_(telRaw); // already in your code
    if (!normalized) continue;

    const jobTitle = _safeCell_(row, col.jobTitle);
    const gender   = _safeCell_(row, col.gender).toLowerCase();
    const tier     = Number(_safeCell_(row, col.tier)) || 0;
    const email    = _safeCell_(row, col.email);
    const publicId = _safeCell_(row, col.publicId);

    const waRaw = _safeCell_(row, col.waRem).toUpperCase();
    const skipWhatsApp = ['NO','N','FALSE','0','OFF'].includes(waRaw);

    map[key] = {
      surname,
      firstName,
      phone: normalized,
      jobTitle,
      gender,
      tier,
      email,
      publicId,
      skipWhatsApp
    };
  }
  return map;
}

/* ───────────────────────────────────────────────────────────
 * EmailHistory reader filtered by today & window
 * ─────────────────────────────────────────────────────────── */
function _loadEmailHistoryTodayByWindowForReminders_(tz, wantLongDay, wantNight) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName('EmailHistory');
  if (!sh) return [];

  const data = sh.getDataRange().getValues();
  if (data.length < 2) return [];

  const hdr = data[0].map(h => String(h || '').trim().toLowerCase());
  const idx = {
    occupantKey: hdr.indexOf('occupantkey'),
    date:        hdr.indexOf('date'),
    shift:       hdr.indexOf('shift'),
    reference:   hdr.indexOf('reference'),
    day:         hdr.indexOf('day'),
    hospital:    hdr.indexOf('hospital'),
    ward:        hdr.indexOf('ward'),
    jobTitle:    (hdr.indexOf('job title') >= 0 ? hdr.indexOf('job title') : hdr.indexOf('jobtitle')),
    notes:       hdr.indexOf('notes')
  };

  const todayStr = Utilities.formatDate(new Date(), tz, 'dd/MM/yyyy');
  const rows = [];

  for (let i = 1; i < data.length; i++) {
    const row = data[i];

    const occupantKey = _safeCell_(row, idx.occupantKey);
    if (!occupantKey) continue;

    // Normalise date to dd/MM/yyyy for compare
    const rawDate = row[idx.date];
    const dateStr = (rawDate instanceof Date)
      ? Utilities.formatDate(rawDate, tz, 'dd/MM/yyyy')
      : String(rawDate || '').trim();
    if (dateStr !== todayStr) continue;

    const shiftText = _safeCell_(row, idx.shift);
    if (!shiftText) continue;

    const isLongDay = /long\s*day/i.test(shiftText);
    const isNight   = /\bnight(s)?\b/i.test(shiftText);

    if (wantLongDay && !isLongDay) continue;
    if (wantNight   && !isNight)   continue;

    rows.push({
      occupantKey,
      dateStr,
      shiftText,
      reference: _safeCell_(row, idx.reference),
      day:       _safeCell_(row, idx.day),
      hospital:  _safeCell_(row, idx.hospital),
      ward:      _safeCell_(row, idx.ward),
      jobTitle:  _safeCell_(row, idx.jobTitle),
      notes:     _safeCell_(row, idx.notes)
    });
  }

  // De-dup by normalized occupantKey (last row wins)
  const byKey = {};
  for (const r of rows) byKey[_normalizeName_(r.occupantKey)] = r;
  return Object.values(byKey);
}

/* ───────────────────────────────────────────────────────────
 * Utilities used ONLY in this module (safe to add)
 * ─────────────────────────────────────────────────────────── */
function _normalizeName_(s) {
  return String(s || '')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();
}
function _deriveForename_(occupantKeyRaw) {
  const trimmed = String(occupantKeyRaw || '').trim();
  if (!trimmed) return '';
  const parts = trimmed.split(/\s+/);
  const last = parts[parts.length - 1] || '';
  return _titleCaseFirstOnly_(last);
}
function _titleCaseFirstOnly_(s) {
  const t = String(s || '').toLowerCase();
  return t ? t.charAt(0).toUpperCase() + t.slice(1) : '';
}
function _safeCell_(row, idx) {
  if (idx == null || idx < 0) return '';
  const v = row[idx];
  return (v == null) ? '' : String(v);
}
function _tail_(phone) {
  const p = String(phone || '');
  return p.slice(-4);
}

/** Return "HHmm" start time. Notes "Start: HH:MM" overrides Shift. */
function _deriveStartHHmm_(shiftText, notes) {
  // Notes override: Start: HH:MM
  const mNotes = String(notes || '').match(/start\s*:\s*([01]?\d|2[0-3])\s*:\s*([0-5]\d)/i);
  if (mNotes) {
    const HH = ('0' + mNotes[1]).slice(-2);
    const MM = ('0' + mNotes[2]).slice(-2);
    return HH + MM;
  }
  // From Shift: match "HHmm-HHmm" or "HH:MM-HH:MM"
  const mShift = String(shiftText || '').match(/(\d{4}|\d{2}:\d{2})\s*-\s*(\d{4}|\d{2}:\d{2})/);
  if (mShift) {
    const startRaw = mShift[1];
    if (/^\d{4}$/.test(startRaw)) return startRaw;
    if (/^\d{2}:\d{2}$/.test(startRaw)) return startRaw.replace(':', '');
  }
  return null;
}

/** Minimal validator for 447XXXXXXXXX */
function _isValidUk447_(digits) {
  return /^447\d{9}$/.test(String(digits || ''));
}

/* ───────────────────────────────────────────────────────────
 * Logging (uses your existing Logs sheet structure)
 * Columns: Timestamp | Level | Stage | Message | Meta JSON | Name/PublicId | Step
 * ─────────────────────────────────────────────────────────── */
function _logReminder_(logsSheet, tz, level, stage, message, metaObj, nameOrPublicId, step) {
  if (!logsSheet) return;
  const stamp = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd HH:mm:ss');
  const metaJson = JSON.stringify(metaObj || {});
  logsSheet.appendRow([
    stamp,
    level || 'INFO',
    stage || 'WATI_REMINDER',
    message || '',
    metaJson,
    nameOrPublicId || '',
    step || ''
  ]);
}

/** Transform ["{ name, value }"] → { name:value } for compact meta logging */
function _paramsToObj_(paramsArray) {
  const o = {};
  for (const p of (paramsArray || [])) {
    if (p && p.name) o[p.name] = p.value;
  }
  return o;
}
/** Set reminder markers to "yesterday" so the next eligible run will fire. */
function seedReminderRunMarkersToYesterday() {
  const props = PropertiesService.getScriptProperties();
  const tz = SpreadsheetApp.getActive().getSpreadsheetTimeZone() || 'Europe/London';

  // Compute yesterday in the script/spreadsheet timezone
  const d = new Date();
  d.setDate(d.getDate() - 1);
  const ymdYesterday = Utilities.formatDate(d, tz, 'yyyyMMdd');

  // Mark both morning & evening as last-run yesterday
  props.setProperty('REMINDERS_M_SENT_YMD', ymdYesterday);
  props.setProperty('REMINDERS_E_SENT_YMD', ymdYesterday);
}

