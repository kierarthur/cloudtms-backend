/** look up email from your Candidate List sheet */
function lookupEmail(fullName) {
  const [surname, firstname] = fullName.split(" ");
  const data = SpreadsheetApp.getActive()
    .getSheetByName("Candidate List")
    .getDataRange().getValues();
  for (let i=1; i<data.length; i++){
    if (String(data[i][0])===surname && String(data[i][1])===firstname) {
      return String(data[i][2]||"").trim() || null;
    }
  }
  return null;
}
/** look up mobile (as you do today) */
function lookupMobile(fullName) {
  const [surname, firstname] = fullName.split(" ");
  const data = SpreadsheetApp.getActive()
    .getSheetByName("Candidate List")
    .getDataRange().getValues();
  for (let i=1; i<data.length; i++){
    if (String(data[i][0])===surname && String(data[i][1])===firstname) {
      let m = String(data[i][3]||"").replace(/\D/g,"");
      return m.startsWith("44") ? m : "44"+m.replace(/^0/,"");
    }
  }
  return null;
}

/**
 * Fetch the existing cell-note for each selected shift cell.
 *
 * @param {Array<Object>} cells  Array from getActiveRangeShifts(), each with `row`,`col` or `a1`.
 * @return {string[]}            Notes ("" if none) in the same order.
 */
function getNotesForCells(cells) {
  const ss    = SpreadsheetApp.getActive();
  const sh    = ss.getActiveSheet();
  return cells.map(c => {
    let r;
    if (c.a1) {
      r = sh.getRange(c.a1);
    } else {
      r = sh.getRange(c.row, c.col);
    }
    return r.getNote() || "";
  });
}


/**
 * Applies or removes time‐adjustment notes on the given cells.
 *
 * @param {Array<Object>} cells       Array of cell‐descriptor objects from getActiveRangeShifts()
 * @param {string}        startTime   "hh:mm" — ignored if remove=true
 * @param {string}        finishTime  "hh:mm" — ignored if remove=true
 * @param {boolean}       remove      If true, clear the note; else set to "Start: hh:mm Finish: hh:mm"
 */
function applyTimeAdjustments(cells, startTime, finishTime, remove) {
  const ss       = SpreadsheetApp.getActive();
  const sheet    = ss.getActiveSheet();
  const noteText = `Start: ${startTime} Finish: ${finishTime}`;
  const borderCells = [];

  cells.forEach(cell => {
    let range;
    if (cell.a1) {
      range = sheet.getRange(cell.a1);
    } else if (cell.row && cell.col) {
      range = sheet.getRange(cell.row, cell.col);
    } else {
      return; // skip malformed
    }

    // always clear or set the note as requested
    if (remove) {
      range.clearNote();
    } else {
      range.setNote(noteText);
    }

    // only color if there's a name in this cell
    if (range.getValue()) {
      // apply the ff9999 background to this cell and the one below it
      range.setBackground('#FF9999');
      range.offset(1, 0).setBackground('#FF9999');
    }

    // collect descriptor for updateCellBorders
    borderCells.push({
      sheetName: range.getSheet().getName(),
      rowIndex:  range.getRow(),
      colIndex:  range.getColumn()
    });
  });

  updateCellBorders(borderCells);
}

