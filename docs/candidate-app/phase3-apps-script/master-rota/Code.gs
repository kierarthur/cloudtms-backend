/**
 * Given the raw form (mode + tier + role booleans),
 * returns the list of candidate‐objects matching role+tier.
 */
/**
 * Step 1: Given the raw form (mode + tier + send-flags),
 * return an **array of full-name strings** of candidates matching both role and tier.
 */
function filterCandidatesByRoleAndTier(form) {
  // reuse your step1 logic to get all matching objects
  // (we assume processNewAdmissionStep1 returns [{ surname, firstname, phone, jobTitle, gender, tier }, …])
  const allByRole = processNewAdmissionStep1(form);

  // now apply tier filter
  let tiered;
  switch (form.tier) {
    case '1':   tiered = allByRole.filter(o => o.tier === 1); break;
    case '2':   tiered = allByRole.filter(o => o.tier === 2); break;
    case '3':   tiered = allByRole.filter(o => o.tier === 3); break;
    case '4':   tiered = allByRole;                               break;
    case 'SPECIFIC':
      // for SPECIFIC we still return allByRole so the user can pick
      tiered = allByRole;
      break;
    default:
      tiered = allByRole;
  }

  // return just the display names → "Surname Firstname"
  return tiered.map(o => `${o.surname} ${o.firstname}`);
}

/**
 * Final wrapper: takes the raw form + the array of full-name strings selected,
 * looks each one up in your Candidate List (to get phone/job/gender/tier),
 * then calls your existing 3-step admission workflow.
 *
 * @param {Object} form              The raw form object ({ mode, tier, Any_RMN: true|false, … })
 * @param {string[]} candidateNames  Array of "Surname Firstname" strings
 */

function startNewAdmissionWithList(form, candidateNames) {
  const ss   = SpreadsheetApp.getActiveSpreadsheet();
  const cmap = getCandidateInfoMap();       // maps "surname firstname".toLowerCase() → { email, firstName }
  const pmap = getCandidateDataMap();       // maps fullName.toLowerCase() → { phone, firstName, jobTitle, gender, tier }

  // build the full array of objects your step2/3/4 expect
  const selected = candidateNames.map(fullName => {
    const key      = fullName.toLowerCase();
    const cd       = pmap[key] || {};
    return {
      surname:   cd.surname   || fullName.split(" ")[0],
      firstname: cd.firstName || fullName.split(" ")[1] || "",
      phone:     cd.phone     || "",
      jobTitle:  cd.jobTitle  || "",
      gender:    cd.gender    || "",
      tier:      cd.tier      || 0
    };
  });

  // STEP 2: build the Emergency sheet
  const sheetName = processNewAdmissionStep2({ form, selected });

  // STEP 3: update attributes on WATI server
  processNewAdmissionStep3({ form, selected, sheetName });

  // STEP 4: send the template messages
  processNewAdmissionStep4({ form, selected });
}
