/** ============== NMC & NI NUMBER ============== **/
function fetchNmcAndNi_(employeeId, ctx, options) {
  // Best-effort collector for NMC + NI using the working, non-org endpoints.
  const existingNi = options && options.existingNi ? String(options.existingNi).trim() : '';
  const result = {
    registrationNumber: '',
    status: '',
    abbreviation: '',
    birthDate: '',            // pretty DOB (pickDate) used for legacy NMC display
    lastCheckDateTime: '',
    niNumber: existingNi || '',

    // NEW: separate DOB sources for canonical resolver
    nmcBirthRaw: '',          // raw DOB from nmcData.birthDate (whatever Credentially returns)
    employeeBirthIso: '',     // raw DOB from top-level employee.birthDate (YYYY-MM-DD)

    // NEW: NMC expiry + comment fields
    feeExpiryDateIso: '',
    feeExpiryDateHyphen: '',
    comment: ''
  };

  // Local utils (scoped here; not new top-level helpers)
  const isoToHyphen = (iso) => {
    const m = (iso || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (m) return `${m[3]}-${m[2]}-${m[1]}`;
    const ddmmyyyy = pickDate(iso || ''); // dd/MM/yyyy
    return ddmmyyyy ? ddmmyyyy.replace(/\//g, '-') : '';
  };

  const chooseQualificationForExpiry_ = (quals) => {
    // Pick the qualification with the latest usable date:
    // prefer feeExpiryDate, fallback to renewalDate. Tie-breaker: latest startDate.
    if (!Array.isArray(quals) || !quals.length) return null;

    const parseIso = (s) => {
      const t = Date.parse(s);
      return Number.isFinite(t) ? t : NaN;
    };

    let best = null;
    for (const q of quals) {
      const feeIso = q && q.feeExpiryDate ? String(q.feeExpiryDate) : '';
      const renIso = q && q.renewalDate ? String(q.renewalDate) : '';
      const useIso = feeIso || renIso || '';
      const ts = parseIso(useIso);
      if (!Number.isFinite(ts)) continue;

      if (!best) {
        best = { q, iso: useIso, ts, start: parseIso(q && q.startDate) || -1 };
        continue;
      }
      if (ts > best.ts) {
        best = { q, iso: useIso, ts, start: parseIso(q && q.startDate) || -1 };
      } else if (ts === best.ts) {
        const sA = parseIso(q && q.startDate) || -1;
        if (sA > best.start) best = { q, iso: useIso, ts, start: sA };
      }
    }
    return best;
  };

  // Helper to parse a single "employee" JSON for NMC + NI
  function harvestFromEmployee_(d) {
    if (!d || typeof d !== 'object') return;

    // Always capture the core employee birthDate (second source of truth)
    // This is the "birthDate": "1984-10-10" line from /v1/employees/{id}
    if (d.birthDate && !result.employeeBirthIso) {
      try {
        result.employeeBirthIso = String(d.birthDate).trim();
      } catch (_) {
        result.employeeBirthIso = String(d.birthDate);
      }
    }

    // Common NMC containers seen in payloads
    const n = d.nmcData || d.NmcData || null;

    // Registration number and type found directly or under nmcData
    if (n) {
      if (!result.registrationNumber && n.registrationNumber) {
        result.registrationNumber = String(n.registrationNumber);
      }
      if (!result.status && n.status) result.status = String(n.status);

      // Primary NMC DOB: store both raw + pretty
      if (n.birthDate) {
        if (!result.nmcBirthRaw) {
          try {
            result.nmcBirthRaw = String(n.birthDate).trim();
          } catch (_) {
            result.nmcBirthRaw = String(n.birthDate);
          }
        }
        if (!result.birthDate) {
          // Pretty DOB for legacy NMC display (e.g. 20/12/1978)
          result.birthDate = pickDate(n.birthDate);
        }
      }

      if (!result.lastCheckDateTime && n.lastCheckDateTime) {
        result.lastCheckDateTime = pickDateTime(n.lastCheckDateTime);
      }

      // Choose qualification for expiry/comment
      const best = chooseQualificationForExpiry_(n.qualifications || []);
      if (best) {
        // Abbreviation from chosen qualification if not set yet
        if (!result.abbreviation && best.q && best.q.abbreviation) {
          result.abbreviation = String(best.q.abbreviation);
        }
        result.feeExpiryDateIso = best.iso || '';
        result.feeExpiryDateHyphen = isoToHyphen(best.iso || '');
        result.comment = (best.q && typeof best.q.comment === 'string')
          ? String(best.q.comment).trim()
          : '';
      } else {
        // fallback: set abbreviation from first, if available
        try {
          const q0 = (n.qualifications || [])[0];
          if (q0 && q0.abbreviation && !result.abbreviation) {
            result.abbreviation = String(q0.abbreviation);
          }
        } catch (_) {}
      }
    } else {
      // Sometimes the core object carries NMC-ish fields flat
      if (!result.registrationNumber && d.registrationNumber &&
          (d.registrationNumberType === 'NMC' ||
           String(d.registrationNumberType).toLowerCase() === 'nmc')) {
        result.registrationNumber = String(d.registrationNumber);
      }
      if (!result.status && d.registrationNumberStatus) {
        result.status = String(d.registrationNumberStatus);
      }

      // If we don't have a pretty DOB yet, use the flat birthDate as a display value
      if (!result.birthDate && d.birthDate) {
        result.birthDate = pickDate(d.birthDate);
      }
      if (!result.lastCheckDateTime && d.lastCheckDateTime) {
        result.lastCheckDateTime = pickDateTime(d.lastCheckDateTime);
      }
    }

    // Only harvest NI if we DON'T already have one from questionnaires
    if (!existingNi && !result.niNumber) {
      // NI number can appear in various "answers" arrays or fields
      const possibleAnswerArrays = [
        d.answers, d.Answers,
        d.questions, d.Questions,
        d.formAnswers, d.FormAnswers,
        d.customAnswers, d.CustomAnswers
      ].filter(Array.isArray);

      for (const arr of possibleAnswerArrays) {
        const hit = arr.find(a => {
          const q = (a && (a.question || a.label || a.key || '')).toString().toLowerCase();
          return q.includes('ni number');
        });
        if (hit && hit.answer && !result.niNumber) {
          result.niNumber = String(hit.answer).trim();
          break;
        }
      }

      // Fallback direct fields
      if (!result.niNumber && d.niNumber) {
        result.niNumber = String(d.niNumber).trim();
      }
      if (!result.niNumber && d.nationalInsuranceNumber) {
        result.niNumber = String(d.nationalInsuranceNumber).trim();
      }
    }
  }

  // Attempt 1: v1 Employee
  let resp = httpGetJson_(
    `${API_BASE}/v1/employees/${employeeId}`,
    { ...ctx, step: 'NMC/NI: v1 Employee' }
  );
  if (resp.ok && resp.data) {
    harvestFromEmployee_(resp.data);
  }

  // Attempt 2: unversioned Employee (some tenants expose this path)
  if ((!result.registrationNumber || !result.status) && (!existingNi && !result.niNumber)) {
    resp = httpGetJson_(
      `${API_BASE}/employees/${employeeId}`,
      { ...ctx, step: 'NMC/NI: Employee (no version)' }
    );
    if (resp.ok && resp.data) {
      harvestFromEmployee_(resp.data);
    }
  }

  // Attempt 3: Answers endpoint without organisation segment
  if (!existingNi && !result.niNumber) {
    const ans = httpGetJson_(
      `${API_BASE}/employees/${employeeId}/answers`,
      { ...ctx, step: 'NI: answers (employee)' }
    );
    if (ans.ok && Array.isArray(ans.data)) {
      const found = ans.data.find(a => {
        const q = (a && a.question ? String(a.question) : '').toLowerCase();
        return q.includes('ni number');
      });
      if (found && found.answer) {
        result.niNumber = String(found.answer).trim();
      }
    }
  }

  // Attempt 4: Registrations (non-org, non-v2) if present on your tenant
  if ((!result.registrationNumber || !result.status)) {
    const reg = httpGetJson_(
      `${API_BASE}/employees/${employeeId}/registrations`,
      { ...ctx, step: 'NMC: registrations (no version)' }
    );
    if (reg.ok && Array.isArray(reg.data)) {
      const nmc = reg.data.find(r => {
        const t = (r.registrationNumberType || r.type || '').toString().toLowerCase();
        return t === 'nmc';
      });
      if (nmc) {
        if (!result.registrationNumber && nmc.registrationNumber) {
          result.registrationNumber = String(nmc.registrationNumber);
        }
        if (nmc.nmcData) {
          const n = nmc.nmcData;
          if (!result.status && n.status) result.status = String(n.status);

          // DOB from registrations.nmcData as a backup NMC source
          if (n.birthDate) {
            if (!result.nmcBirthRaw) {
              try {
                result.nmcBirthRaw = String(n.birthDate).trim();
              } catch (_) {
                result.nmcBirthRaw = String(n.birthDate);
              }
            }
            if (!result.birthDate) {
              result.birthDate = pickDate(n.birthDate);
            }
          }

          if (!result.lastCheckDateTime && n.lastCheckDateTime) {
            result.lastCheckDateTime = pickDateTime(n.lastCheckDateTime);
          }

          const best = chooseQualificationForExpiry_(n.qualifications || []);
          if (best) {
            if (!result.abbreviation && best.q && best.q.abbreviation) {
              result.abbreviation = String(best.q.abbreviation);
            }
            result.feeExpiryDateIso = best.iso || '';
            result.feeExpiryDateHyphen = isoToHyphen(best.iso || '');
            result.comment = (best.q && typeof best.q.comment === 'string')
              ? String(best.q.comment).trim()
              : '';
          }
        }
      }
    }
  }

  return result;
}



