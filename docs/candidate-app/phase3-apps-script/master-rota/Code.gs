  // ---- fast, sheetless logging (buffer into Script Properties) ----
  function _safeLog(event, reason, note, payload) {
    try {
      var props = PropertiesService.getScriptProperties();
      var key = "LOG_BUFFER";
      var raw = props.getProperty(key);
      var buf = raw ? JSON.parse(raw) : [];

      var phone =
        (payload && (payload.phone || payload.waId)) ? String(payload.phone || payload.waId) : "";

      buf.push([
        new Date().toISOString(),
        String(event || ""),
