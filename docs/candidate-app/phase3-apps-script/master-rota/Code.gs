/*************************************************
 * MATCH HEALTHROSTER -> PATIENT ROTAS (robust name matching)
 * - Keeps the existing behavior for writing REF numbers
 * - Adds strong normalization + inversion tolerance
 * - Shows a tidy summary (matched vs not matched + reasons)
 *************************************************/
function matchHealthrosterReferences() {
  // ── PREVENT CONCURRENT RUNS VIA LOCK ──
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return;

  // ── PAUSE BACKGROUND UPDATES ──
  const props = PropertiesService.getScriptProperties();
  props.setProperty('PAUSE_UNTIL_TS', String(Date.now() + 3600 * 1000));

  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const ui = SpreadsheetApp.getUi();
    const hr = ss.getSheetByName('Healthroster');
    if (!hr) { ui.alert("No 'Healthroster' sheet found!"); return; }

    const hrRows = hr.getDataRange().getValues();
    if (hrRows.length <= 1) { ui.alert('No data found in the Healthroster sheet.'); return; }

    const tz = ss.getSpreadsheetTimeZone();

    // 1) Build candidate index (helps flag genuine typos)
    const candIndex = buildCandidateIndex_(); // { pairMap, uniqFirstMap, uniqLastMap }

    // 2) Discover ward/patient sheets, then PRE‑INDEX them once
    const wardSheets = ss.getSheets().filter(s => isPatientSheetName_(s.getName()));
    const rotaIndex = buildRotaIndex_(wardSheets, tz);
    // rotaIndex : { [dateKey]: { day: Map(nameKey -> Array<loc>), night: Map(..) } }
    // loc = { sheetName, nameRow, refRow, col }

    // Healthroster col indexes
    const COL_REQ   = 0; // A
    const COL_DATE  = 1; // B
    const COL_START = 2; // C
    const COL_END   = 3; // D
    const COL_NAME  = 8; // I

    // Collect writes per sheet (keeps write behavior the same, just grouped)
    const pendingWrites = new Map(); // sheetName -> Array<{row, col, value}>
    let matched = 0;
    const misses = [];

    // helper: parse hour as decimal
    const parseHour = (val) => {
      if (val instanceof Date && !isNaN(val.valueOf())) {
        return val.getHours() + val.getMinutes() / 60;
      }
      const str = (val || '').toString().trim();
      const norm = str.replace(/[:.]/g, '');
      const n = parseInt(norm, 10) || 0;
      const hh = Math.floor(n / 100);
      const mm = n % 100;
      return hh + mm / 60;
    };

    // 3) Walk Healthroster rows and do O(1) lookups in the rota index
    for (let r = 1; r < hrRows.length; r++) {
      const row = hrRows[r];

      const reqID   = row[COL_REQ];
      const rawDate = row[COL_DATE];
      const rawName = row[COL_NAME];
      if (!rawDate || !rawName) {
        misses.push(failLine_('Missing name/date', rawName, rawDate, reqID));
        continue;
      }

      // Date key "dd/MM/yyyy"
      let hrDateStr = '';
      if (rawDate instanceof Date && !isNaN(rawDate.valueOf())) {
        hrDateStr = Utilities.formatDate(rawDate, tz, 'dd/MM/yyyy');
      } else {
        const tmp = new Date(rawDate);
        if (isNaN(tmp.valueOf())) {
          misses.push(failLine_('Unparseable date', rawName, rawDate, reqID));
          continue;
        }
        hrDateStr = Utilities.formatDate(tmp, tz, 'dd/MM/yyyy');
      }

      // Determine day/night (same behavior as before)
      let startHr = parseHour(row[COL_START]);
      let endHr   = parseHour(row[COL_END]);
      if (endHr <= startHr) endHr += 24;          // crosses midnight
      const crosses3am = endHr >= 27;             // 03:00 next day
      const hrShiftType = crosses3am ? 'night' : shiftTypeFromTime(row[COL_START]);

      // Canonical pair key for the HR name
      const hrPairKey = canonicalPairFromString_(String(rawName));
      if (!hrPairKey) {
        misses.push(failLine_('No usable name tokens', rawName, hrDateStr, reqID));
        continue;
      }

      // Sanity: ensure HR name exists in Candidate List (optional but helpful for reasons)
      const inCandidates = candIndex.pairMap.get(hrPairKey) || resolveSingleTokenFallback_(hrPairKey, candIndex);
      if (!inCandidates) {
        misses.push(failLine_('No match in Candidate List', rawName, hrDateStr, reqID));
        continue;
      }

      // Attempt indexed lookup on the rota
      const bucket = (rotaIndex[hrDateStr] || {})[hrShiftType];
      if (!bucket) {
        misses.push(failLine_('No rota for that date/shift', rawName, hrDateStr, reqID));
        continue;
      }

      let placed = false;
      // Exact canonical pair match
      let locs = bucket.get(hrPairKey);

      // If an exact pair wasn’t found and HR reduced to a single token (e.g., “Funke|”),
      // try single‑token fallback only when uniquely identified in Candidate List
      if ((!locs || !locs.length) && (hrPairKey.endsWith('|') || hrPairKey.startsWith('|'))) {
        const parts = hrPairKey.split('|').filter(Boolean);
        const tok = parts[0];
        if (tok && (candIndex.uniqFirstMap.has(tok) || candIndex.uniqLastMap.has(tok))) {
          // traverse bucket keys and collect any whose pair contains the token
          const candidates = [];
          for (const [k, arr] of bucket.entries()) {
            const bits = k.split('|');
            if (bits.includes(tok)) candidates.push(...arr);
          }
          if (candidates.length) locs = candidates;
        }
      }

      if (locs && locs.length) {
        // Choose first location (consistent with previous behavior)
        const loc = locs[0];
        if (!pendingWrites.has(loc.sheetName)) pendingWrites.set(loc.sheetName, []);
        // WRITE: one row beneath the name (refRow), same column; value = reqID
        pendingWrites.get(loc.sheetName).push({ row: loc.refRow, col: loc.col, value: reqID });
        matched++;
        placed = true;
      }

      if (!placed) {
        misses.push(failLine_('Not found in any rota slot (date/shift mismatch or name variant)', rawName, hrDateStr, reqID));
      }
    }

    // 4) Perform writes per sheet (same write logic; just grouped to reduce API calls)
    for (const [sheetName, writes] of pendingWrites.entries()) {
      const sh = ss.getSheetByName(sheetName);
      if (!sh || !writes.length) continue;
      // Individual setValue calls (positions are sparse). Keeps exact placement semantics.
      writes.forEach(w => sh.getRange(w.row, w.col).setValue(w.value));
    }

    // 5) Friendly summary
    const total = hrRows.length - 1;
    const ok = matched;
    const bad = total - ok;
    let msg = [
      'Finished matching references from Healthroster.',
      '',
      `Matched: ${ok} / ${total}`,
      `Not matched: ${bad}`
    ].join('\n');
    if (misses.length) msg += '\n\nDetails:\n' + misses.join('\n');
    ui.alert(msg);

    // Keep your post‑processing hook
    refreshAllPatientSheetColors();

  } finally {
  try { _resetUpdateTimer(); } catch (_) {}
  try { lock.releaseLock(); } catch (_) {}
}

}

/* ──────────────────────────────────────────────────────────────
   ROTA INDEXING (fast O(1) lookups by date, shift, canonical name)
   ────────────────────────────────────────────────────────────── */
function buildRotaIndex_(sheets, tz) {
  /** Shape: idx[dateKey]["day"|"night"] = Map<nameKey, Array<{sheetName, nameRow, refRow, col}>> */
  const idx = Object.create(null);

  for (const sh of sheets) {
    const sheetName = sh.getName();
    const values = sh.getDataRange().getValues();
    if (values.length < 5) continue;

    const headerRowWithShifts = values[3]; // row 4 visible (0-based index 3)
    // Occupant rows start at index 4, then every 2 rows (name row, ref row)
    for (let r = 4; r < values.length; r += 2) {
      const nameRow = values[r];
      const dateCell = nameRow[1]; // column B (index 1)
      let dateKey = '';
      if (dateCell instanceof Date && !isNaN(dateCell.valueOf())) {
        dateKey = Utilities.formatDate(dateCell, tz, 'dd/MM/yyyy');
      } else {
        dateKey = (dateCell || '').toString().trim();
      }
      if (!dateKey) continue;

      for (let c = 2; c < nameRow.length; c++) { // from column C (index 2)
        const occupantNameCell = nameRow[c];
        if (!occupantNameCell) continue;

        const shiftLabel = (headerRowWithShifts[c] || '').toString().toLowerCase();
        const shiftType = shiftLabel.includes('night') ? 'night' : 'day';

        const pairKey = canonicalPairFromString_(String(occupantNameCell));
        if (!pairKey) continue;

        if (!idx[dateKey]) idx[dateKey] = { day: new Map(), night: new Map() };
        const bucket = idx[dateKey][shiftType];
        if (!bucket.has(pairKey)) bucket.set(pairKey, []);
        // record location; ref row is the row directly below the name row
        bucket.get(pairKey).push({
          sheetName,
          nameRow: r + 1,        // 1-based for UI reference (not used directly)
          refRow:  r + 2,        // REF always goes one row below
          col:     c + 1         // 1-based column index
        });
      }
    }
  }

  return idx;
}

/* ──────────────────────────────────────────────────────────────
   CANDIDATE INDEX (helps error reasons & safe single-token fallback)
   ────────────────────────────────────────────────────────────── */
function buildCandidateIndex_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const cl = ss.getSheetByName('Candidate List') || ss.getSheetByName(SH_CANDIDATES);
  const out = {
    pairMap: new Map(),
    uniqFirstMap: new Map(),
    uniqLastMap: new Map(),
  };
  if (!cl) return out;

  const rows = cl.getDataRange().getDisplayValues();
  if (rows.length <= 1) return out;

  const hdr = rows[0].map(x => (x || '').toString().toLowerCase());
  const iSur = hdr.indexOf('surname');
  const iFir = hdr.indexOf('first name');

  const firstFreq = new Map();
  const lastFreq  = new Map();
  const pairs = [];

  for (let r = 1; r < rows.length; r++) {
    const sur = ((iSur >= 0 ? rows[r][iSur] : rows[r][0]) || '').toString();
    const fir = ((iFir >= 0 ? rows[r][iFir] : rows[r][1]) || '').toString();
    const surTok = pickNameToken_(sur);
    const firTok = pickNameToken_(fir);
    if (!surTok || !firTok) continue;

    const key = canonicalPair_(firTok, surTok); // order‑insensitive
    pairs.push({ key, first: firTok, last: surTok, row: r });

    firstFreq.set(firTok, (firstFreq.get(firTok) || 0) + 1);
    lastFreq.set(surTok,  (lastFreq.get(surTok)  || 0) + 1);
  }

  for (const p of pairs) out.pairMap.set(p.key, { first: p.first, last: p.last, rawRow: p.row });
  for (const [tok, n] of firstFreq.entries()) if (n === 1) out.uniqFirstMap.set(tok, tok);
  for (const [tok, n] of lastFreq.entries())  if (n === 1) out.uniqLastMap.set(tok, tok);

  return out;
}

/* ──────────────────────────────────────────────────────────────
   NAME NORMALISATION (robust to order, roles, punctuation, symbols)
   ────────────────────────────────────────────────────────────── */
function canonicalPairFromString_(raw) {
  const tokens = extractNameTokens_(raw);
  if (tokens.length === 0) return '';
  if (tokens.length === 1) return canonicalPair_(tokens[0], '');
  const a = tokens[0];
  const b = tokens[tokens.length - 1];
  if (!a && !b) return '';
  if (a && !b)  return canonicalPair_(a, '');
  if (!a && b)  return canonicalPair_(b, '');
  return canonicalPair_(a, b);
}
function canonicalPair_(a, b) {
  const x = (a || '').trim();
  const y = (b || '').trim();
  if (!x && !y) return '';
  if (!y) return `${x}|`;
  if (!x) return `${y}|`;
  return (x < y) ? `${x}|${y}` : `${y}|${x}`;
}
function extractNameTokens_(raw) {
  const s0 = (raw || '').toString();
  // Strip parenthetical content e.g. (RMN), (care package)
  const noParen = s0.replace(/\([^)]*\)/g, ' ');
  // Remove punctuation/symbols; keep letters/numbers/hyphen, then treat hyphen as space
  const stripped = noParen
    .replace(/[^\p{L}\p{N}\s-]/gu, ' ')
    .replace(/[-]/g, ' ');
  const lower = stripped.toLowerCase().replace(/\s+/g, ' ').trim();
  if (!lower) return [];
  const roleStop = new Set([
    'rmn','hca','care','package','rmncare','carepackage','rmncarepackage','male','female','or','and'
  ]);
  return lower.split(' ').filter(t => t && !roleStop.has(t)).map(t => t.replace(/^['’]+|['’]+$/g, ''));
}
function pickNameToken_(cell) {
  const toks = extractNameTokens_(cell);
  return toks[0] || '';
}
function resolveSingleTokenFallback_(hrPairKey, index) {
  const parts = hrPairKey.split('|').filter(Boolean);
  if (parts.length !== 1) return null;
  const tok = parts[0];
  if (index.uniqFirstMap.has(tok) || index.uniqLastMap.has(tok)) return tok;
  return null;
}

/* ──────────────────────────────────────────────────────────────
   SHEET FILTER (same permissive behavior you had)
   ────────────────────────────────────────────────────────────── */
function isPatientSheetName_(name) {
  const n = (name || '').toString().toLowerCase();
  const exclude = new Set([
    'healthroster','candidate list','availability','conversationstate','kb',
    'emailhistory','logs','settings'
  ]);
  if (exclude.has(n)) return false;
  return true;
}

/* ──────────────────────────────────────────────────────────────
   TIDY FAILURE LINE (friendlier, compact, with counts in alert)
   ────────────────────────────────────────────────────────────── */
function failLine_(why, name, dateStr, ref) {
  const bits = [
    `✖ ${why}`,
    name ? `Name: "${name}"` : null,
    dateStr ? `Date: ${dateStr}` : null,
    ref ? `Ref: ${ref}` : null
  ].filter(Boolean);
  return ' - ' + bits.join(' | ');
}

/* ──────────────────────────────────────────────────────────────
   SHIFT TYPE FROM TIME (unchanged behavior)
   ────────────────────────────────────────────────────────────── */
function shiftTypeFromTime(possibleValue) {
  if (possibleValue instanceof Date && !isNaN(possibleValue.valueOf())) {
    const hour = possibleValue.getHours();
    return (hour >= 18 || hour < 4) ? 'night' : 'day';
  } else {
    const str = (possibleValue || '').toString().trim();
    const norm = str.replace(/[:.]/g, '');
    const numeric = parseInt(norm, 10) || 0;
    const hour = Math.floor(numeric / 100);
    return (hour >= 18 || hour < 4) ? 'night' : 'day';
  }
}


