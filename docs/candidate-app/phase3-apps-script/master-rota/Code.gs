function getFilteredCandidatesByColumn() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getActiveSheet();
  const cell = sheet.getActiveCell();
  const col = cell.getColumn();

  const header = (sheet.getRange(3, col).getValue() || "").toString().toLowerCase();

  let requiredRole = null;
  let requiredGender = "any";

  if (header.includes("rmn")) {
    requiredRole = "RMN";
  } else if (header.includes("hca")) {
    requiredRole = "HCA";
  }

  if (!header.includes("male or female")) {
    if (header.includes("female")) {
      requiredGender = "female";
    } else if (header.includes("male")) {
      requiredGender = "male";
    }
  }

  const sheetData = ss.getSheetByName("Candidate List").getDataRange().getValues();
  const results = [];

  for (let i = 1; i < sheetData.length; i++) {
    const row = sheetData[i];
    const surname = (row[0] || "").toString().trim();
    const firstname = (row[1] || "").toString().trim();
    const jobTitle = (row[4] || "").toString().trim().toUpperCase();
    const gender = (row[5] || "").toString().trim().toLowerCase();

    const fullName = `${surname} ${firstname}`.replace(/\s+/g, ' ').trim();

    if (requiredRole && jobTitle !== requiredRole) continue;
    if (requiredGender !== "any" && gender !== requiredGender) continue;

    results.push(fullName);
  }

  return results;
}

