/** ============== DOCUMENTS: FINDERS & DOWNLOAD ============== **/


function findDocByKeyOrName_(docs, key, nameIncludes) {
  if (!Array.isArray(docs)) return null;

  const keyNorm  = key ? normalize(key) : '';
  const nameNorm = nameIncludes ? normalize(nameIncludes) : '';

  // Helper: prefer docs with approved files, then sort by activeFile.created (desc)
  const pickBest = (arr) => {
    if (!arr || !arr.length) return null;
    const approvedFirst = arr.filter(d => d && d.hasApproved);
    const pool = approvedFirst.length ? approvedFirst : arr.slice();
    pool.sort((a, b) => {
      const da = a?.activeFile?.created ? new Date(a.activeFile.created).getTime() : 0;
      const db = b?.activeFile?.created ? new Date(b.activeFile.created).getTime() : 0;
      return db - da;
    });
    return pool[0] || null;
  };

  // ---- Special handling to keep "Passport" separate from "Passport Style Photo" ----
  // A) Explicitly looking for the headshot: passport_style_photo
  if (keyNorm === 'passport_style_photo' || (nameNorm && nameNorm.includes('passport style photo'))) {
    const candidates = [];
    for (const d of docs) {
      if (!d || !d.type) continue;
      const k = normalize(d.type.key || '');
      const n = normalize(d.type.name || '');
      if ((keyNorm && k === 'passport_style_photo') || (nameNorm && n.includes('passport style photo'))) {
        candidates.push(d);
      }
    }
    return pickBest(candidates);
  }

  // B) Looking for the Passport doc (NOT the headshot)
  // Prefer key=passport, then key=uk_passport, then name contains "passport" but exclude headshot
  const seekingPassport =
    keyNorm === 'passport' ||
    (nameNorm && nameNorm.includes('passport') && !nameNorm.includes('passport style photo'));

  if (seekingPassport) {
    // Pass 1: key === 'passport'
    let candidates = [];
    for (const d of docs) {
      if (!d || !d.type) continue;
      const k = normalize(d.type.key || '');
      if (k === 'passport') candidates.push(d);
    }
    let best = pickBest(candidates);
    if (best) return best;

    // Pass 2: key === 'uk_passport'
    candidates = [];
    for (const d of docs) {
      if (!d || !d.type) continue;
      const k = normalize(d.type.key || '');
      if (k === 'uk_passport') candidates.push(d);
    }
    best = pickBest(candidates);
    if (best) return best;

    // Pass 3: name contains "passport" EXCLUDING "passport style photo"
    candidates = [];
    for (const d of docs) {
      if (!d || !d.type) continue;
      const k = normalize(d.type.key || '');
      const n = normalize(d.type.name || '');
      if (n.includes('passport') && k !== 'passport_style_photo' && !n.includes('passport style photo')) {
        candidates.push(d);
      }
    }
    return pickBest(candidates);
  }

  // ---- Default behaviour (unchanged for all other document types) ----
  const candidates = [];
  for (const d of docs) {
    if (!d || !d.type) continue;
    const k = normalize(d.type.key || '');
    const n = normalize(d.type.name || '');
    if (keyNorm && k === keyNorm) {
      candidates.push(d);
    } else if (nameNorm && n.includes(nameNorm)) {
      candidates.push(d);
    }
  }

  return pickBest(candidates);
}


function downloadActiveFile_(doc, label, personName, ctx) {
  if (!doc || !doc.activeFile || !doc.activeFile.id) {
    return { ok: false, reason: 'No activeFile.id' };
  }
  const fileId = doc.activeFile.id;

  // Build a friendly filename
  const safe = (s) => String(s || '').replace(/[\\/:*?"<>|]+/g, '_').trim();
  const originName = safe(doc.activeFile.originName || `${label || doc.type?.name || 'document'}-${fileId}.pdf`);
  const baseLabel  = safe(label || (doc.type && doc.type.name) || 'document');
  const filename   = `${safe(personName)} - ${baseLabel} - ${originName}`;

  // Try endpoints in order
  let res = httpGetBlob_(`${API_BASE}/files/${fileId}`, filename, null, { ...ctx, step: 'Files API (direct)' });
  if (!res.ok) {
    res = httpGetBlob_(`${API_BASE}/files/${fileId}/download`, filename, null, { ...ctx, step: 'Files API (/download fallback)' });
  }
  if (!res.ok) {
    res = httpGetBlob_(`${API_BASE}/files/${fileId}?download=true`, filename, null, { ...ctx, step: 'Files API (?download=true fallback)' });
  }
  return res;
}


