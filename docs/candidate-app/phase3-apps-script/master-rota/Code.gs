function buildChecklistHtml_(person, summary, alerts, includedDocs) {
  const tr  = (label, value) => `<tr><th style="text-align:left;padding:6px;border:1px solid #ccc">${label}</th><td style="padding:6px;border:1px solid #ccc">${value || ''}</td></tr>`;
  const sec = (title) => `<tr><td colspan="2" style="background:#f6f6f6;font-weight:bold;padding:6px;border:1px solid #ccc">${title}</td></tr>`;
  const esc = (s) => (s == null ? '' : String(s).replace(/[<&>]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;'}[c])));

  // Render "RED:" alerts in red + bold
  const renderAlertLi = (txt) => {
    const raw = String(txt || '');
    const isRed = /^\s*RED:/i.test(raw);
    const safe = esc(raw);
    return isRed
      ? `<li><span style="color:#c00;font-weight:700">${safe}</span></li>`
      : `<li>${safe}</li>`;
  };

  const docList = includedDocs.length
    ? `<ul>${includedDocs.map(d => `<li>${esc(d)}</li>`).join('')}</ul>`
    : '<em>None</em>';

  // Simple, explicit rule for "Update Service registered"
  const norm = s => String(s || '').trim().toLowerCase();
  const mostRecentStatusNorm = norm(summary?.dbs?.mostRecentStatus || summary?.dbs?.updateStatus || '');
  const updateSvcRegistered = (mostRecentStatusNorm && mostRecentStatusNorm !== 'no_match_found') ? 'Yes' : 'No';

  // Extras populated earlier by sendComplianceUpdates
  const lastSuccessfulBlank  = esc(summary?.dbs?.lastSuccessfulBlankDate || '');   // DD/MM/YYYY
  const validUntilFromBlank  = esc(summary?.dbs?.validUntilFromLastBlank || '');   // DD/MM/YYYY

  // The “Update Service Date checked” should reflect the date/time of the shown most-recent status
  const mostRecentAnyOutcome = esc(summary?.dbs?.lastCheckDateTime || ''); // pretty-printed timestamp of the chosen record

  let html = `
    <div style="font-family:Arial,sans-serif">
      <p>Compliance checklist for <strong>${esc(person.fullName)}</strong></p>
      ${alerts.length ? `<p><strong>Alerts:</strong> <ul>${alerts.map(renderAlertLi).join('')}</ul></p>` : ''}
      <table style="border-collapse:collapse;border:1px solid #ccc;min-width:520px">
        ${sec('Candidate')}
        ${tr('Name', esc(person.fullName))}
        ${tr('Job Title', esc(person.jobTitle))}
  `;

  if (summary.nmc && summary.nmc.include) {
    html += `
        ${sec('NMC')}
        ${tr('Registration #', esc(summary.nmc.registrationNumber))}
        ${tr('Status', esc(summary.nmc.status))}
        ${tr('Abbreviation', esc(summary.nmc.abbreviation))}
        ${tr('Birth Date', esc(summary.nmc.birthDate))}
        ${tr('Last Checked', esc(summary.nmc.lastCheckDateTime))}
        <!-- Optional: show NMC Fee Expiry -->
        <!-- ${tr('NMC Fee Expiry', esc(summary.nmc.feeExpiryDateHyphen || 'N/A'))} -->
    `;
  }

  html += `
        ${sec('National Insurance')}
        ${tr('NI Number', esc(summary.niNumber))}
        ${sec('DBS')}
        ${tr('Update Service Registered', updateSvcRegistered)}
        ${tr('Update Service Status', esc(summary.dbs.updateStatus))}
        ${tr('Update Service Date checked', mostRecentAnyOutcome)}
        ${tr('Update Service Certificate #', esc(summary.dbs.updateCertificateNumber))}
        ${lastSuccessfulBlank ? tr('Last Successful Update Service Check (no convictions)', lastSuccessfulBlank) : ''}
        ${validUntilFromBlank ? tr('Valid to work until (from last blank check + 364 days)', validUntilFromBlank) : ''}
        ${tr('DBS Certificate (Provided) #', esc(summary.dbs.providedCertificateNumber))}
        ${tr('DBS Certificate Expiry', esc(summary.dbs.certificateExpiry))}
        ${sec('Right to Work')}
        ${tr('Overall Status', esc(summary.rtw.type))}
        ${tr('Validity', esc(summary.rtw.validityType))}
        ${tr('Group', esc(summary.rtw.groupName))}
        ${tr('Online RTW Expiry', esc(summary.rtw.onlineExpiry))}
        ${sec('Identity & Training')}
        ${tr('Passport Expiry', esc(summary.passport.expiry))}
        ${tr('Driving Licence Expiry', esc(summary.licence.expiry))}
        ${tr('Proof of Address Issued', esc(summary.address.issued))}
        ${tr('Occupational Health Issued', esc(summary.occHealth.issued))}
        ${tr('Occupational Health Expiry', esc(summary.occHealth.expiry))}
        ${tr('PMVA Expiry', esc(summary.pmva.expiry))}
        ${sec('Documents Included')}
        <tr><td colspan="2" style="padding:6px;border:1px solid #ccc">${docList}</td></tr>
      </table>
    </div>
  `;
  return html;
}




/**
 * Return the current end index of the document (Advanced Docs API index space).
 */
function getDocEndIndex_(docId) {
  const d = Docs.Documents.get(docId);
  return Number(d.body.content[d.body.content.length - 1].endIndex || 1);
}

/**
 * Insert a NEXT_PAGE section break at the given end index.
 * If insert fails (rare), throws to caller.
 */
function insertNextPageSectionBreak_(docId, endIndex) {
  Docs.Documents.batchUpdate(
    {
      requests: [
        {
          insertSectionBreak: {
            sectionType: 'NEXT_PAGE',
            location: { index: endIndex - 1 } // insert before the final newline
          }
        }
      ]
    },
    docId
  );
}

/**
 * Update the *current* section page style (attempt per-section page size/orientation + margins).
 * NOTE: In some environments, per-section page size/orientation may not be fully supported.
 * We try; if the API rejects, caller will fall back silently to document defaults.
 */
function updateCurrentSectionPageStyle_(docId, pageSizePt, marginsPt) {
  // We update the section that contains the end-of-body (i.e., most recently appended content)
  // by using an UpdateSectionStyle with a range covering the final section.
  const doc = Docs.Documents.get(docId);
  const content = doc.body.content || [];
  const last = content[content.length - 1];
  const lastIndex = Number(last.endIndex || 1);

  const requests = [];

  // Attempt to set per-section margins (usually supported)
  requests.push({
    updateSectionStyle: {
      range: { startIndex: lastIndex - 1, endIndex: lastIndex - 1 },
      sectionStyle: {
        marginTop: { magnitude: marginsPt.top, unit: 'PT' },
        marginBottom: { magnitude: marginsPt.bottom, unit: 'PT' },
        marginLeft: { magnitude: marginsPt.left, unit: 'PT' },
        marginRight: { magnitude: marginsPt.right, unit: 'PT' }
      },
      fields: 'marginTop,marginBottom,marginLeft,marginRight'
    }
  });

  // Attempt to set per-section page size/orientation (may not be supported everywhere).
  // If unsupported, this request will be ignored or error; caller handles fallback.
  requests.push({
    updateDocumentStyle: {
      documentStyle: {
        pageSize: {
          width:  { magnitude: pageSizePt.w, unit: 'PT' },
          height: { magnitude: pageSizePt.h, unit: 'PT' }
        }
      },
      fields: 'pageSize'
    }
  });

  Docs.Documents.batchUpdate({ requests }, docId);
}

/**
 * Export a Google Doc file to PDF (Drive export).
 */
function exportDocToPdf_(docId, finalPdfName) {
  const url = 'https://www.googleapis.com/drive/v3/files/' +
              encodeURIComponent(docId) +
              '/export?mimeType=' +
              encodeURIComponent('application/pdf') +
              '&alt=media';
  const headers = { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() };

  const res = UrlFetchApp.fetch(url, { method: 'get', headers, muteHttpExceptions: true });
  const code = res.getResponseCode();
  const blob = (code >= 200 && code < 300) ? res.getBlob() : null;
  let bytes = 0;
  try { bytes = (blob && blob.getBytes && blob.getBytes().length) || 0; } catch (_) {}

  if (code >= 200 && code < 300) {
    try { blob.setName(finalPdfName); } catch (_) {}
    try { blob.setContentType('application/pdf'); } catch (_) {}
    return blob;
  } else {
    const body = (() => { try { return res.getContentText().slice(0, 300); } catch (_) { return ''; } })();
    throw new Error(`Drive export failed ${code}: ${body}`);
  }
}

/***********************
 * CONFIG / CONSTANTS
 ***********************/
const PDF_TINY_THRESHOLD = 40000;     // bytes; PDFs smaller than this are suspicious
const COMMIT_ATTEMPTS = 3;
const COMMIT_SLEEP_MS = 900;          // ms between flush/commit checks
const DRIVE_NORMALIZE_IMAGES = true;  // set false to skip Drive round-trip normalization

/**************************************
 * MAIN: DOCS-BASED IMAGE → PDF COMBINER
 **************************************/
/**************************************
 * MAIN: DOCS-BASED IMAGE → PDF COMBINER
 * - No distortion (aspect preserved)
 * - One A4 orientation (picked from first image)
 * - Commit via doc.saveAndClose() before export
 **************************************/
function combineImagesToPdfViaSlides_(fileEntries, finalPdfName, ctx) {
  if (!Array.isArray(fileEntries) || !fileEntries.length) {
    return { ok: false };
  }

  // 1) Download & filter usable images
  const items = [];
  for (let i = 0; i < fileEntries.length; i++) {
    const f = fileEntries[i];
    const dl = httpGetBlob_(`${API_BASE}/files/${f.fileId}`, `dbs-img-${i + 1}`, null, { ...ctx, step: `Files API: DBS image ${i + 1}` });
    if (!dl || !dl.ok || !dl.blob) {
      continue;
    }
    const ctype = String(dl.blob.getContentType() || '').toLowerCase();
    let sizeBytes = 0;
    try { sizeBytes = (dl.blob.getBytes() || []).length; } catch (_) {}
    if (!/^image\//.test(ctype) || sizeBytes === 0) {
      continue;
    }
    items.push({ blob: dl.blob, fileId: f.fileId, created: f.created || '', sizeBytes, contentType: ctype });
  }
  if (!items.length) {
    return { ok: false };
  }

  // Keep natural order (oldest → newest)
  items.sort((a, b) => new Date(a.created || 0) - new Date(b.created || 0));

  // 2) Create temporary Google Doc (A4 + margins)
  const docName = `TMP DBS – ${String(finalPdfName || 'DBS.pdf').replace(/\.pdf$/i, '')}`;
  const doc = DocumentApp.create(docName);
  const docId = doc.getId();
  const body = doc.getBody();
  const marginsPt = { top: 36, bottom: 36, left: 36, right: 36 }; // 0.5"
  applyA4DocStyle_(body, 'PORTRAIT', marginsPt);

  // 3) Decide doc orientation from FIRST image (fallback: PORTRAIT)
  let firstMeasured = false;
  let firstImgAspect = 1;
  let firstImageInline = null;
  let firstPara = null;

  const tempImageFileIds = [];
  try {
    const firstSrc = items[0];
    const normFirst = DRIVE_NORMALIZE_IMAGES ? normalizeImageViaDrive_(firstSrc.blob, 'dbs-first') : { blob: firstSrc.blob, fileId: null };
    if (normFirst.fileId) tempImageFileIds.push(normFirst.fileId);

    firstPara = body.appendParagraph('').setSpacingBefore(0).setSpacingAfter(0);
    firstImageInline = firstPara.appendInlineImage(normFirst.blob);

    // We can immediately read width/height for aspect (no flush needed)
    let w = 0, h = 0;
    try { w = firstImageInline.getWidth(); h = firstImageInline.getHeight(); } catch (_) {}
    if (w > 0 && h > 0) { firstImgAspect = w / h; firstMeasured = true; }
  } catch (e) {
  }

  const orientation = firstMeasured ? (firstImgAspect >= 1 ? 'LANDSCAPE' : 'PORTRAIT') : 'PORTRAIT';
  applyA4DocStyle_(body, orientation, marginsPt);

  // 4) Insert all images (scale down only; aspect preserved; center; one per page)
  const contentBox = getContentBoxPts_(body, orientation, marginsPt); // { contentW, contentH }
  const imagesTarget = items.length;
  let imagesInserted = 0;

  // First image (if present)
  if (firstImageInline && firstPara) {
    try {
      scaleInlineImageToBox_(firstImageInline, contentBox.contentW, contentBox.contentH);
      firstPara.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
      imagesInserted++;
      if (imagesInserted < imagesTarget) body.appendPageBreak();
    } catch (e) {
    }
  }

  // Remaining images
  for (let i = 1; i < items.length; i++) {
    const src = items[i];
    let blobToUse = src.blob;
    try {
      if (DRIVE_NORMALIZE_IMAGES) {
        const norm = normalizeImageViaDrive_(src.blob, `dbs-img-${i + 1}`);
        blobToUse = norm.blob;
        if (norm.fileId) tempImageFileIds.push(norm.fileId);
      } else {
      }
    } catch (e) {
    }

    try {
      const p = body.appendParagraph('').setSpacingBefore(0).setSpacingAfter(0);
      const img = p.appendInlineImage(blobToUse);
      scaleInlineImageToBox_(img, contentBox.contentW, contentBox.contentH);
      p.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
      if (++imagesInserted < imagesTarget) body.appendPageBreak();
    } catch (e) {
    }
  }

  // 5) Commit the Doc before export
  const saveInfo = saveAndCloseWithVerify_(doc, docId, { logCtx: ctx, expectedImages: imagesInserted });
  // Optional: if you want to block on zero inline objects after save, you could check saveInfo.inlineObjectsCount here.

  // 6) Export Doc → PDF
  let pdfBlob = null;
  try {
    pdfBlob = exportDocToPdf_(docId, finalPdfName);
  } catch (e) {
  }

  let bytes = 0;
  try { bytes = (pdfBlob && pdfBlob.getBytes && pdfBlob.getBytes().length) || 0; } catch (_) {}
  const tinyThreshold = (typeof PDF_TINY_THRESHOLD === 'number' ? PDF_TINY_THRESHOLD : 40000);
  const tiny = (bytes > 0 && bytes < tinyThreshold);

  if (tiny || !pdfBlob) {
    // Keep Doc (and temp images) for manual inspection
    return { ok: false, keptDocId: docId, bytes, tempImageFileIds };
  }

  // 7) Cleanup on success
  try {
    deleteFileIfExists_(docId, 'CLEANUP: DOC');
    if (tempImageFileIds && tempImageFileIds.length) deleteTempDriveFiles_(tempImageFileIds, 'CLEANUP: IMAGES');
  } catch (e) {
  }

  try { pdfBlob.setName(finalPdfName); } catch (_) {}
  try { pdfBlob.setContentType('application/pdf'); } catch (_) {}
  return { ok: true, blob: pdfBlob, bytes };
}


function getInlineObjectDiagnostics_(docId) {
  try {
    const d = Docs.Documents.get(docId);
    const inlineCount = d.inlineObjects ? Object.keys(d.inlineObjects).length : 0;
    const content = Array.isArray(d.body?.content) ? d.body.content : [];
    const paraCount = content.filter(n => n.paragraph).length;
    const lastEndIndex = content.length ? Number(content[content.length - 1].endIndex || 1) : 1;
    return { inlineObjectsCount: inlineCount, paragraphCount: paraCount, lastEndIndex };
  } catch (e) {
    return { inlineObjectsCount: 0, paragraphCount: 0, lastEndIndex: 1, error: String(e && e.stack || e) };
  }
}

/**
 * Bulk delete temp Drive files by ID (best-effort).
 */
function deleteTempDriveFiles_(fileIds, logTag) {
  if (!Array.isArray(fileIds) || !fileIds.length) return;
  for (const id of fileIds) {
    try {
      DriveApp.getFileById(id).setTrashed(true);
    } catch (e) {
    }
  }
}

/**
 * Commit the document so Advanced Docs API / Drive can see the content.
 * Optionally verify once after save.
 */
function saveAndCloseWithVerify_(doc, docId, opts) {
  let saved = false;
  try {
    doc.saveAndClose();
    saved = true;
  } catch (e) {
  }

  // Small post-save wait + one verification read
  try { Utilities.sleep(600); } catch (_) {}
  let diag = null;
  try {
    const d = Docs.Documents.get(docId);
    const inlineCount = d.inlineObjects ? Object.keys(d.inlineObjects).length : 0;
    const content = Array.isArray(d.body?.content) ? d.body.content : [];
    const paraCount = content.filter(n => n.paragraph).length;
    const lastEndIndex = content.length ? Number(content[content.length - 1].endIndex || 1) : 1;

    diag = { inlineObjectsCount: inlineCount, paragraphCount: paraCount, lastEndIndex };
  } catch (e) {
  }
  return { saved, inlineObjectsCount: diag ? diag.inlineObjectsCount : 0, diag };
}

/**
 * Apply A4 page style & margins on the whole document.
 * orientation: 'PORTRAIT' | 'LANDSCAPE'
 */
function applyA4DocStyle_(body, orientation, marginsPt) {
  const isLandscape = String(orientation || 'PORTRAIT').toUpperCase() === 'LANDSCAPE';
  const pageW = isLandscape ? 841.89 : 595.28;
  const pageH = isLandscape ? 595.28 : 841.89;
  try {
    body.setPageWidth(pageW);
    body.setPageHeight(pageH);
    body.setMarginTop(marginsPt.top);
    body.setMarginBottom(marginsPt.bottom);
    body.setMarginLeft(marginsPt.left);
    body.setMarginRight(marginsPt.right);
  } catch (_) {}
}

/**
 * Compute content box (page minus margins), in points.
 */
function getContentBoxPts_(body, orientation, marginsPt) {
  const isLandscape = String(orientation || 'PORTRAIT').toUpperCase() === 'LANDSCAPE';
  const pageW = isLandscape ? 841.89 : 595.28;
  const pageH = isLandscape ? 595.28 : 841.89;
  const contentW = pageW - (marginsPt.left + marginsPt.right);
  const contentH = pageH - (marginsPt.top + marginsPt.bottom);
  return { contentW, contentH, pageW, pageH };
}

/**
 * Scale inline image to fit within a content box WITHOUT distortion; do not upscale.
 * (Setting width alone preserves aspect ratio.)
 */
function scaleInlineImageToBox_(inlineImage, maxWpt, maxHpt) {
  const curW = inlineImage.getWidth();
  const curH = inlineImage.getHeight();
  if (!(curW > 0 && curH > 0)) return;

  let scale = Math.min(maxWpt / curW, maxHpt / curH);
  if (!(scale > 0)) scale = 1;
  if (scale > 1) scale = 1; // no upscaling

  inlineImage.setWidth(curW * scale); // height auto-adjusts
}

/**
 * Upload to Drive and re-read the blob to normalize progressive/CMYK/EXIF quirks.
 * Returns { blob, fileId } so caller can clean up temp files later.
 */
function normalizeImageViaDrive_(blob, suggestedName) {
  const name = `${suggestedName || 'dbs-image'}.${guessImageExt_(blob)}`;
  const file = DriveApp.createFile(blob.copyBlob()).setName(name);
  const normBlob = file.getBlob();
  return { blob: normBlob, fileId: file.getId() };
}

function guessImageExt_(blob) {
  const c = String(blob.getContentType() || '').toLowerCase();
  if (c.includes('png'))  return 'png';
  if (c.includes('gif'))  return 'gif';
  if (c.includes('webp')) return 'webp';
  return 'jpg';
}

function requestComplianceUpdates(selectedNames) {
  // 1) Normalize inputs
  var names = Array.isArray(selectedNames) ? selectedNames.filter(Boolean) : [];
  names = Array.from(new Set(names)); // dedupe

  if (!names.length) {
    return { ok: false, reason: 'NO_NAMES' };
  }

  // 2) Determine requester email (logged-in user)
  var requesterEmail = '';
  try {
    requesterEmail = String(Session.getActiveUser().getEmail() || '').trim();
  } catch (_) {
    requesterEmail = '';
  }

  // If unavailable, you can optionally look up a cached user-provided email in UserProperties here.

  // 3) Load webhook URL + secret from Script Properties
  var props = PropertiesService.getScriptProperties();
  var url = String(props.getProperty('ROTA_DOPOST_URL') || '').trim();
  var key = String(props.getProperty('CALLBACK_HMAC_KEY') || '').trim();

  if (!url || !key) {
    throw new Error('Webhook not configured. Missing ROTA_DOPOST_URL or CALLBACK_HMAC_KEY.');
  }

  // 4) Build payload
  var payload = {
    action: 'COMPLIANCE_UPDATES',
    names: names,
    requesterEmail: requesterEmail,
    t: Date.now(),
    nonce: Utilities.getUuid()
  };
  var body = JSON.stringify(payload);

  // 5) Compute HMAC signature (hex) over the raw JSON body
  var sigBytes = Utilities.computeHmacSha256Signature(body, key, Utilities.Charset.UTF_8);
  var sigHex = sigBytes.map(function(b){ return ('0' + (b & 0xff).toString(16)).slice(-2); }).join('');

  // 6) POST to Web App (include sig as query param to read it from e.parameter.sig in doPost)
  var sep = url.indexOf('?') === -1 ? '?' : '&';
  var callUrl = url + sep + 'sig=' + encodeURIComponent(sigHex);

  var resp = UrlFetchApp.fetch(callUrl, {
    method: 'post',
    contentType: 'application/json',
    payload: body,
    muteHttpExceptions: true
  });

  var code = resp.getResponseCode();
  var text = resp.getContentText() || '';
  var ok = (code >= 200 && code < 300);

  return {
    ok: ok,
    status: code,
    body: text
  };
}
