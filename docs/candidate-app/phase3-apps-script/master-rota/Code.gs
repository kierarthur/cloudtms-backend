function _cbCacheKey(runId){ return 'CB_' + String(runId||'').trim(); }
function _cbCacheGet(runId){
  try {
    const raw = CacheService.getScriptCache().get(_cbCacheKey(runId));
    return raw ? JSON.parse(raw) : null;
  } catch(_) { return null; }
}
function _cbCachePut(runId, rec){
  try {
    const ttlSecs = 6 * 60 * 60; // 6h
    CacheService.getScriptCache().put(_cbCacheKey(runId), JSON.stringify(rec || {}), ttlSecs);
    return true;
  } catch(_) { return false; }
}
function _hmacHex(raw, key){
  const sig = Utilities.computeHmacSha256Signature(raw, key, Utilities.Charset.UTF_8);
  return sig.map(b=>('0'+(b&0xff).toString(16)).slice(-2)).join('');
}
function _getCallbackSecret(){
  return (PropertiesService.getScriptProperties().getProperty('CALLBACK_HMAC_KEY') || '').trim();
}

function getStream(runId, sinceSeq){
  runId = String(runId||'').trim();
  const rec = _cbCacheGet(runId) || {};
  const lastSeq = Number(rec.lastSeq || 0);
  const from = Math.max(Number(sinceSeq||0), 0);
  const delta = (rec.text || '').slice(Number(rec.sliceIndexMap && rec.sliceIndexMap[from] || 0));

  return {
    status: rec.status || 'init',       // 'streaming' | 'ok' | 'error' | 'init'
    lastSeq: lastSeq,
    prose_delta: delta || '',
    htmlReady: /\<!--\s*ROTAS_HTML_START\s*-->/i.test(rec.text || ''),
    meta: rec.meta || {},
    error_message: rec.error_message || ''
  };
}

function getResult(runId){
  runId = String(runId||'').trim();
  const rec = _cbCacheGet(runId) || {};
  return {
    ready: rec.status === 'ok' || rec.status === 'error',
    status: rec.status || 'init',
    text_full: rec.text || '',
    stats: rec.stats || {},
    meta: rec.meta || {},
    error_message: rec.error_message || ''
  };
}


function _1openDeepseekConfirm(prepared) {
  if (!prepared || !prepared.payload) {
    return { ok: false, error: 'Missing or invalid prepared payload.' };
  }

  // LOCAL-ONLY BRANCH: skip confirm & dispatch; open progress with shortlist table immediately
  if (prepared.localOnly === true) {
    try {
      // Optional: persist payload/meta for later final viewer use
      if (typeof _storePayloadForRun === 'function') {
        try {
          _storePayloadForRun(prepared.runId, {
            payload: prepared.payload,
            sheetName: prepared.sheetName,
            site: prepared.site,
            ward: prepared.ward,
            cidToName: prepared.cidToName || {}
          });
        } catch (_) {}
      }

      // Compute My Engine rota table HTML (calls new helper you’ll add)
      var shortlistHtmlTable = (typeof __collectShortlistHtmlTableFromPayload === 'function')
        ? __collectShortlistHtmlTableFromPayload(prepared.payload, prepared.cidToName || {})
        : '';

      if (typeof showProgressPanel === 'function') {
        showProgressPanel(prepared.runId, {
          sheetName: prepared.sheetName || '',
          site: prepared.site || '',
          ward: prepared.ward || '',
          cidToName: prepared.cidToName || {},
          shortlistHtmlTable: shortlistHtmlTable || '',
          localOnly: true
        });
      }
      return { ok: true, mode: 'local' };
    } catch (e) {
      return { ok: false, error: 'Local-only open failed: ' + (e && e.message ? e.message : String(e)) };
    }
  }

  // Try to get a UI context (may throw in headless)
  let ui = null;
  try { ui = SpreadsheetApp.getUi(); } catch (_) { ui = null; }

  // Safely probe for showModalDialog without triggering the property access error
  let canShow = false;
  try { canShow = !!(ui && ui.showModalDialog && typeof ui.showModalDialog === 'function'); } catch (_) { canShow = false; }

  if (canShow) {
    try {
      const t = HtmlService.createTemplateFromFile('DeepseekConfirmSend');
      // Ensure continuation goes to the dispatcher-based path
      prepared.continuationFn = '_1runDeepseekAfterConfirm';
      t.data = prepared;
      const html = t.evaluate().setWidth(420).setHeight(200);
      ui.showModalDialog(html, 'Ready to send (GitHub Actions)');
      return { ok: true, mode: 'ui' };
    } catch (e) {
      try {
        _1logDeepseekCallChunked({
          runId: prepared.runId || _1newRunId('DS'),
          mode: 'CONFIRM_ERROR',
          sheetName: prepared.sheetName || '',
          site: prepared.site || '',
          ward: prepared.ward || '',
          payload: '',
          outputJSON: '',
          status: 'showModalDialog failed: ' + (e && e.message ? e.message : String(e))
        });
      } catch (_) {}
      return { ok: false, error: 'Unable to open confirm modal (UI error). See Logs.' };
    }
  }

  // Headless fallback: log and return a clear result
  try {
    _1logDeepseekCallChunked({
      runId: prepared.runId || _1newRunId('DS'),
      mode: 'CONFIRM_FALLBACK',
      sheetName: prepared.sheetName || '',
      site: prepared.site || '',
      ward: prepared.ward || '',
      payload: '',
      outputJSON: '',
      status: 'No UI context; confirm modal not shown.'
    });
  } catch (_) {}

  return { ok: false, error: 'NO_UI_CONTEXT: cannot show confirm modal in a headless run.' };
}


function _dispatchToGitHub(runId, meta, data) {
  runId = String(runId || _1newRunId('DS'));
  meta = meta || {};
  data = data || {};

  const props = PropertiesService.getScriptProperties();
  const owner = (props.getProperty('GH_OWNER') || '').trim();
  const repo  = (props.getProperty('GH_REPO')  || '').trim();
  const pat   = (props.getProperty('GH_PAT')   || '').trim();

  if (!owner || !repo || !pat) {
    throw new Error('Missing GH_OWNER / GH_REPO / GH_PAT in Script Properties.');
  }

  const url = 'https://api.github.com/repos/' + encodeURIComponent(owner) + '/' + encodeURIComponent(repo) + '/dispatches';

  const body = {
    event_type: 'rota-plan',
    client_payload: {
      request_id: runId,
      system_text: String(data.systemText || ''),
      payload_inline: String(data.payload || ''),
      meta: {
        sheetName: String(meta.sheetName || ''),
        site: String(meta.site || ''),
        ward: String(meta.ward || '')
      }
    }
  };

  const headers = {
    'Authorization': 'Bearer ' + pat,
    'Accept': 'application/vnd.github+json',
    'X-GitHub-Api-Version': '2022-11-28',
    'Content-Type': 'application/json'
  };

  const res = UrlFetchApp.fetch(url, {
    method: 'post',
    muteHttpExceptions: true,
    headers: headers,
    payload: JSON.stringify(body)
  });

  const code = res.getResponseCode();
  if (code < 200 || code >= 300) {
    const txt = (res && res.getContentText && res.getContentText()) ? res.getContentText() : '';
    throw new Error('GitHub dispatch failed (' + code + '): ' + txt);
  }

  try {
    _1logDeepseekCallChunked({
      runId: runId,
      mode: 'DISPATCH_HTTP',
      sheetName: String(meta.sheetName || ''),
      site: String(meta.site || ''),
      ward: String(meta.ward || ''),
      payload: 'bytes=' + JSON.stringify(body).length,
      outputJSON: '',
      status: 'Dispatch accepted by GitHub (' + code + ')'
    });
  } catch (_) {}

  return { ok: true, runId: runId };
}

