  const waMap      = getCandidateDataMap();
  const sentPhones = new Set();
  const receivers  = [];
  const mapKeys    = [];

  // Build deduped receivers array
  candidateKeys.forEach(key => {
    const lookupKey = key.toLowerCase().trim();
    const wi = waMap[lookupKey];
    if (!wi) return;
    const phone = wi.phone;
    if (sentPhones.has(phone)) return;
    sentPhones.add(phone);

    receivers.push({
      whatsappNumber: phone,
      customParams: [{ name: 'nextshift', value: message }]
    });
    mapKeys.push(key);
  });

  if (!receivers.length) {
    return [];  // nothing to send
  }

  // Fire off the WATI template broadcast
  const tenant = '601205';
  const url    = `https://eu-api.wati.io/${tenant}/api/v2/sendTemplateMessages`;
  const payload = {
    template_namespace: 'your_template_namespace_here',
    template_name:      'susseximportantutility',
    broadcast_name:     `Broadcast_${Utilities.formatDate(new Date(), tz, 'yyyyMMdd_HHmmss')}`,
    receivers
  };

  const resp = UrlFetchApp.fetch(url, {
    method:             'post',
    contentType:        'application/json',
    headers:            { Authorization: WATI_TOKEN },
    payload:            JSON.stringify(payload),
    muteHttpExceptions: true
  });
  const rawText = resp.getContentText();
  const code    = resp.getResponseCode();

  // Parse the WATI response
  let json;
  try {
    json = JSON.parse(rawText);
  } catch (e) {
    // Invalid JSON => all failed
    return mapKeys.map(key => ({
      key,
      status: 'FAILED',
      reason: 'Invalid JSON response from WATI'
    }));
  }

  // If broadcast-level failure
  if (code !== 200 || json.result === false) {
    const reason = json.error || json.message || `HTTP ${code}`;
    return mapKeys.map(key => ({
      key,
      status: 'FAILED',
      reason
    }));
  }

  // Success at broadcast level, inspect each receiver
  const resultsArray = Array.isArray(json.receivers) ? json.receivers : [];

  return mapKeys.map((key, i) => {
    const entry = resultsArray[i] || {};

    // If WATI provides errors
    if (entry.error || entry.errorCode ||
        (Array.isArray(entry.errors) && entry.errors.length)) {
      let reason = entry.error || entry.errorCode;
      if (!reason && Array.isArray(entry.errors)) {
        reason = entry.errors
          .map(err => err.message || JSON.stringify(err))
          .join('; ');
      }
      if (!reason) {
        reason = JSON.stringify(entry);
      }
      return {
        key,
        status: 'FAILED',
        reason
      };
    }

    // Otherwise success
    return {
      key,
      status: 'SUCCESS'
    };
  });
}


