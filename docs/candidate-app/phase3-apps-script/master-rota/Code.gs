/**
 * Returns rows for the Candidates table.
 * Each item: { rowNo, surname, firstname, email, telephone, jobTitle, gender, tier, publicId }
 */
function getCandidatesList() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(CANDIDATE_SHEET_NAME);
  if (!sh) return [];
  const last = sh.getLastRow();
  if (last < 2) return [];

  // Read the full width so COL.* can live anywhere (incl. STATUS at L)
  const rng = sh.getRange(2, 1, last - 1, sh.getLastColumn());
  const values = rng.getValues();

  const out = [];
  for (let i = 0; i < values.length; i++) {
    const r = i + 2; // sheet row
    const row = values[i];

    // Skip empty rows (based on required fields being blank)
    if (!row[COL.SURNAME - 1] && !row[COL.FIRSTNAME - 1] && !row[COL.EMAIL - 1] && !row[COL.TELEPHONE - 1]) continue;

    out.push({
      rowNo:     r,
      surname:   String(row[COL.SURNAME   - 1] || ''),
      firstname: String(row[COL.FIRSTNAME - 1] || ''),
      email:     String(row[COL.EMAIL     - 1] || ''),
      telephone: String(row[COL.TELEPHONE - 1] || ''),
      jobTitle:  String(row[COL.JOBTITLE  - 1] || ''),
      gender:    String(row[COL.GENDER    - 1] || ''),
      tier:      String(row[COL.TIER      - 1] || ''),
      publicId:  String(row[COL.PUBLICID  - 1] || ''),
      status:    (String(row[COL.STATUS   - 1] || 'ACTIVE').toUpperCase() === 'INACTIVE') ? 'INACTIVE' : 'ACTIVE',
    });
  }
  return out;
}

/**
 * Opens the CandidateForm.html as a modal dialog.
 * Args: { mode: 'add'|'edit', rowNo?: number }
 * Injects window.__FORM_PROPS__ into the HTML.
 */


/**
 * Creates a new candidate (Add).
 * payload: { surname, firstname, email, telephone, jobTitle, gender, tier, publicId }
 * flags is ignored (the form sends {nameChanged}, but add always inserts).
 */
function createCandidate(payload, flags) {
  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  try {
    // Validate + normalise (also normalises status to ACTIVE/INACTIVE)
    const norm = validateAndNormaliseCandidatePayload(payload, { requireRowNo: false });

    // Duplicate checks (email, tel, name key)
    const dup = findDuplicateInCandidateList({
      email: norm.email,
      telephone: norm.telephone,
      nameLower: nameKeyLower(norm.surname, norm.firstname),
    });
    if (dup) throw new Error(dup);

    // --- Credentially gating (using Public ID from the modal) ---
    let credResult, classification = null;

    // STRICT: must supply a Public ID
    if (!norm.publicId) {
      throw new Error('Credentially Public ID is required to create a candidate.');
    }

    try {
      credResult = fetchCredentiallyWithLog(norm.publicId); // logging wrapper
    } catch (e) {
      credResult = { fetchError: true, message: String(e) };
    }

    classification = classifyCredentiallyResponse(credResult);

    // STRICT: the ID must resolve to a record
    if (classification !== 'FOUND') {
      throw new Error(`Credentially Public ID could not be verified: ${norm.publicId}`);
    }

    // STRICT: names must match (ignores any client-side override flags)
    const credName    = buildCredentiallyDisplayName(credResult);
    const enteredName = `${norm.surname} ${norm.firstname}`;
    if (!namesLooselyMatch(enteredName, credName)) {
      throw new Error(`CRED_NAME_MISMATCH|${enteredName}|${credName}`);
    }

    // Append to Candidate List
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sh = ss.getSheetByName(CANDIDATE_SHEET_NAME);
    if (!sh) throw new Error('Candidate List sheet not found.');

    const nextRow = sh.getLastRow() + 1;
    sh.getRange(nextRow, COL.SURNAME).setValue(norm.surname);
    sh.getRange(nextRow, COL.FIRSTNAME).setValue(norm.firstname);
    sh.getRange(nextRow, COL.EMAIL).setValue(norm.email);
    sh.getRange(nextRow, COL.TELEPHONE).setValue(norm.telephone);
    sh.getRange(nextRow, COL.JOBTITLE).setValue(norm.jobTitle);
    sh.getRange(nextRow, COL.GENDER).setValue(norm.gender);
    sh.getRange(nextRow, COL.TIER).setValue(norm.tier);
    sh.getRange(nextRow, COL.PUBLICID).setValue(norm.publicId || '');
    sh.getRange(nextRow, COL.STATUS).setValue(norm.status); // ACTIVE or INACTIVE

    // NEW: Generate Candidate_ID for this row (only writes Candidate_ID cell)
    generateAndWriteCandidateIdForRow_(nextRow);

    ai_syncAvailabilityWithCandidates();
    return 'Candidate created';
  } finally {
    lock.releaseLock();
  }
}

/************************************************************
 * CONFIG (hard-wired URL + gentle fallbacks)
 ************************************************************/
const AVAILABILITY_API_LINKS_URL = 'https://docs.google.com/spreadsheets/d/1BSomZL0jRse5SGfTgADwswVmIjY4mCMfvDAfQxxIUA8/edit'; // <-- your Links workbook
// Optional: if the Availability API doPost requires a shared token, set it in Script Properties:
//   AVAILABILITY_API_URL       (you’ve already set this)
//   AVAILABILITY_API_TOKEN     (optional; only if your Web App enforces a token)
function _getAvailabilityApiUrl_() {
  return PropertiesService.getScriptProperties().getProperty('AVAILABILITY_API_URL') || '';
}
function _getAvailabilityApiToken_() {
