/**
 * Sort an Emergency sheet so:
 * 1) Tier 1 rows come first,
 * 2) Within each tier, sorted by Job Title, Gender, then Surname.
 */
/**
 * Sorts your Emergency-WhatsApp sheet so that:
 * 1) Rows with ≥1 green response come first
 * 2) Within that, by Tier asc
 * 3) Then by green-count desc
 * 4) Then Job Title (HCA before RMN)
 * 5) Then Gender (female before male)
 * 6) Then Surname A→Z
 *
 * Always moves entire rows (values + background colors).
 */
/**
 * Sorts an Emergency sheet so that:
 * 1) Anyone with ≥1 green response rows come before those with none
 * 2) Within each group, Tier ascending (1→2→3→…)
 * 3) Within each tier, those with more green responses first
 * 4) Then by Job Title (HCA before RMN)
 * 5) Then by Gender (female before male)
 * 6) Finally by Surname A→Z
 */
/**
 * Sorts the given sheet according to:
 *  1) Tier ascending
 *  2) Job Title A→Z
 *  3) Any response (green/red) before no response (white)
 *  4) Within responders, more greens first
 *  5) Preserve original order for ties
 *
 * Rows are assumed to start at row 2, with headers in row 1.
 * The "Tier" and "Job Title" columns are looked up by header name.
 * All columns to the right of "Tier" are treated as response columns.
 */
function sortEmergencySheet(sheet) {
  // 1) Find our key columns
  const lastCol = sheet.getLastColumn();
  const headers = sheet
    .getRange(1, 1, 1, lastCol)
    .getDisplayValues()[0];
  const tierIdx = headers.indexOf('Tier');
  const jobIdx  = headers.indexOf('Job Title');
  if (tierIdx < 0 || jobIdx < 0) {
    // if we can’t find either header, bail
    return;
  }

  // 2) Grab all values & backgrounds
  const startRow = 2;
  const lastRow  = sheet.getLastRow();
  if (lastRow < startRow) return;
  const numRows = lastRow - startRow + 1;

  const dataRange = sheet.getRange(startRow, 1, numRows, lastCol);
  const values     = dataRange.getValues();
  const backgrounds= dataRange.getBackgrounds();

  // 3) Build an array of row-objects with our sorting keys
  const responseStartCol = tierIdx + 2;  // 1-based: immediately after Tier
  const rows = [];
  for (let i = 0; i < numRows; i++) {
    const rowVals = values[i];
    const rowBgs  = backgrounds[i];

    // parse tierNumber (non-numbers → Infinity)
    const rawTier = rowVals[tierIdx];
    const tierNum = typeof rawTier === 'number'
      ? rawTier
      : parseInt(rawTier, 10) || Infinity;

    const jobTitle = (rowVals[jobIdx] || '').toString();

    // count responses & green responses in the "response" columns
    let respCount = 0, greenCount = 0;
    for (let c = responseStartCol - 1; c < lastCol; c++) {
      const bg = rowBgs[c].toLowerCase();
      if (bg && bg !== '#ffffff' && bg !== 'white') {
        respCount++;
        if (bg === '#ccffcc') greenCount++;
      }
    }

    rows.push({
      values:        rowVals,
      backgrounds:   rowBgs,
      tier:          tierNum,
      job:           jobTitle,
      responded:     respCount > 0,
      greenCount:    greenCount,
      originalIndex:i
    });
  }

  // 4) Sort the array in place
  rows.sort((a, b) => {
    if (a.tier !== b.tier)       return a.tier - b.tier;
    const jobCmp = a.job.localeCompare(b.job);
    if (jobCmp !== 0)            return jobCmp;
    if (a.responded !== b.responded) return a.responded ? -1 : 1;
    if (a.greenCount !== b.greenCount) return b.greenCount - a.greenCount;
    return a.originalIndex - b.originalIndex;
  });

  // 5) Write values + backgrounds back in sorted order
  const sortedValues     = rows.map(r => r.values);
  const sortedBackgrounds= rows.map(r => r.backgrounds);

  dataRange.setValues(sortedValues);
  dataRange.setBackgrounds(sortedBackgrounds);
}



/**
 * Reads row 3 (columns C→end) of the active sheet,
 * and returns an array of unique role‑headers where:
 *  • If any “(Male or Female)” variant exists for RMN or HCA,
 *    only it is kept (all gender‑specific dropped);
 *  • Otherwise all gender‑specific variants stay (duplicates removed).
 */
function getFilteredRoleHeaders() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  // row 3, cols C through last
  const raw = sheet.getRange(3, 3, 1, sheet.getLastColumn() - 2)
                   .getValues()[0]
                   .map(h => h.toString().trim())
                   .filter(h => h !== "");
  
  // Group by base (RMN / HCA)
  const byBase = {};
  raw.forEach(h => {
    // extract “RMN” or “HCA” (assuming header always contains one)
    const baseMatch = h.match(/\b(RMN|HCA)\b/i);
    if (!baseMatch) return;
    const base = baseMatch[1].toUpperCase();
    byBase[base] = byBase[base] || new Set();
    byBase[base].add(h);
  });

  const result = [];
  Object.entries(byBase).forEach(([base, variants]) => {
    const arr = Array.from(variants);
    // find unisex
    const unisex = arr.find(v => /\(male or female\)/i.test(v));
    if (unisex) {
      result.push(unisex);
    } else {
      // no “(Male or Female)”, so keep all gendered (de‑duplicated already by Set)
      result.push(...arr);
    }
  });

  return result;
}

