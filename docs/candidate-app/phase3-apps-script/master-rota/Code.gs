      "dd/MM/yyyy"
    );
  } else {
    occupantDateStr = dateVal.toString();
  }
  const shiftLabel = sheet.getRange(4, e.range.getColumn()).getValue() || "";
  const occupantShift = shiftLabel.toLowerCase().includes("night") ? "night" : "day";

  let msg = `CONFLICT: ${occupantName} cannot be assigned.\nReason: ${reason}`;
  if (existingBooking) {
    msg += `\nAlready booked:\n`;
    msg += `  Date: ${existingBooking.dateStr}\n`;
    msg += `  Shift: ${existingBooking.shift.toUpperCase()}\n`;
    msg += `  Hospital: ${existingBooking.hospital}\n`;
