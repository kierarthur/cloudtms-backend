/*************************************************
 * VALIDATE JOB+GENDER USAGE 
 *************************************************/
function validateJobTitleAgainstColumn(e) {
  const sheet = e.range.getSheet();
  if (!isPatientSheetName(sheet.getName())) return;

  const row = e.range.getRow();
  const col = e.range.getColumn();
  const newVal = e.value || "";
  if (!newVal) return; // occupant cleared => skip

  // occupant rows => row5,7,9 => if it's not occupant row, skip
  if ((row - 5) % 2 !== 0 || row < 5) return;

  // staffHeader => e.g. "Female RMN", "RMN (Male or Female)", "Male HCA" etc.
  const staffHeader = sheet.getRange(3, col).getValue() || "";

  // occupant's row data from Candidate List
  const occupantInfo = lookupCandidateInfo(newVal);
  if (!occupantInfo) {
    revertNameWithAlert(e, newVal, null, `Candidate '${newVal}' not found.`);
    return;
  }

  const occupantJob = occupantInfo.jobTitle.trim().toUpperCase();   // "RMN"/"HCA"
  const occupantGender = occupantInfo.gender.trim().toLowerCase(); // "male"/"female"

  let requiredRole = null;    // "RMN"|"HCA"
  let requiredGender = "any"; // "male"|"female"|"any"

  const lowerHeader = staffHeader.toLowerCase();
  if (lowerHeader.includes("rmn")) {
    requiredRole = "RMN";
  } else if (lowerHeader.includes("hca")) {
    requiredRole = "HCA";
  }

  if (lowerHeader.includes("(male or female)")) {
    requiredGender = "any";
  } else if (lowerHeader.includes("female")) {
    requiredGender = "female";
  } else if (lowerHeader.includes("male")) {
    requiredGender = "male";
  }

  // *** RMN can do HCA shift, but HCA cannot do RMN shift. ***
  if (requiredRole === "RMN") {
    if (occupantJob !== "RMN") {
      revertNameWithAlert(
        e,
        newVal,
        null,
        `Shift requires "${staffHeader}", occupant jobTitle="${occupantInfo.jobTitle}".`
      );
      return;
    }
  }
  else if (requiredRole === "HCA") {
    if (occupantJob === "RMN") {
      // show a one-time alert
      SpreadsheetApp.getUi().alert(
        `Candidate "${newVal}" is an RMN and you're booking an HCA shift.\n` +
        `This is allowed, but just a warning.`
      );
    }
    else if (occupantJob !== "HCA") {
      revertNameWithAlert(
        e,
        newVal,
        null,
        `Shift requires "${staffHeader}", occupant jobTitle="${occupantInfo.jobTitle}" is not HCA or RMN.`
      );
      return;
    }
  }

  if (requiredGender !== "any") {
    if (occupantGender !== requiredGender) {
      revertNameWithAlert(
        e,
        newVal,
        null,
        `Shift requires "${staffHeader}", occupant gender="${occupantInfo.gender}".`
      );
      return;
    }
  }
}


/*************************************************
 * LOOKUP occupant => jobTitle/gender
 *************************************************/
function lookupCandidateInfo(fullName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const cSheet = ss.getSheetByName("Candidate List");
  if (!cSheet) return null;

  const data = cSheet.getDataRange().getValues();
  // row => [ Surname,FirstName,Email,Phone,JobTitle,Gender ]
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const surname   = (row[0] || "").toString().trim();
    const firstname = (row[1] || "").toString().trim();
    const jobTitle  = (row[4] || "").toString().trim();
    const gender    = (row[5] || "").toString().trim();

    const combined = (surname + " " + firstname).toLowerCase();
    if (combined === fullName.toLowerCase()) {
      return { jobTitle, gender };
    }
  }
  return null;
}


