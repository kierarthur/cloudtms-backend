// Build a map of (runId, publicId) -> rowIndex (1-based), keeping the latest ProcessedAt per publicId
function getStagingRowIndexMap_(runId, sh) {
  var map = {};
  try {
    var values = sh.getDataRange().getValues();
    // values[0] is header
    for (var i = 1; i < values.length; i++) {
      var r = values[i];
      if (r[0] !== runId) continue;
      var pid = String(r[1] || '');
      if (!pid) continue;
      var existingRow = map[pid];
      if (!existingRow) {
        map[pid] = i + 1; // sheet row index (1-based)
      } else {
        // Keep the row with the latest processedAt (index 6)
        var prevProcessed = values[existingRow - 1][6] || '';
        var curProcessed  = r[6] || '';
        if (String(curProcessed) > String(prevProcessed)) {
          map[pid] = i + 1;
        }
      }
    }
  } catch (_) {}
  return map;
}

// Upsert a single staging row by (runId, publicId)
function upsertStagingRow_(sh, idxMap, runId, publicId, surname, firstName, docsJson, errorFlag, processedAtIso) {
  // Guard to ensure we never exceed the 50k cell limit
  if (typeof docsJson !== 'string') docsJson = String(docsJson || '');
  if (docsJson.length > 49900) docsJson = docsJson.slice(0, 49900);

  var rowArr = [
    runId,
    publicId,
    surname,
    firstName,
    docsJson,
    !!errorFlag,
    processedAtIso
  ];
  var rowIndex = idxMap[publicId];
  if (rowIndex) {
    // Overwrite existing row
    sh.getRange(rowIndex, 1, 1, rowArr.length).setValues([rowArr]);
  } else {
    // Append by writing to next row via setValues (more controllable than appendRow)
    var target = sh.getLastRow() + 1;
    sh.getRange(target, 1, 1, rowArr.length).setValues([rowArr]);
    idxMap[publicId] = target;
  }
}

// Dedupe rows for build: keep the most recent processedAt per publicId, preserve first-seen order
function dedupeRowsByPublicId_(rows) {
  var seen = Object.create(null);
  var order = [];
  for (var i = 0; i < rows.length; i++) {
    var r = rows[i];
    var pid = String(r[1] || '');
    var ts  = String(r[6] || '');
    if (!(pid in seen)) {
      seen[pid] = { row: r, ts: ts };
      order.push(pid);
    } else {
      if (ts > seen[pid].ts) {
        seen[pid] = { row: r, ts: ts };
      }
    }
  }
  var out = [];
  for (var j = 0; j < order.length; j++) {
    out.push(seen[order[j]].row);
  }
  return out;
}

