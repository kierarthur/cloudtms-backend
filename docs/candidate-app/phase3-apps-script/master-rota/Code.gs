/*************************************************
 * BUILD OCCUPANT MAP
 *************************************************/

/**
 * Collect occupant data across all "Patient ???" sheets => occupantMap[name][yyyyMMdd].
 * Each occupant's reference is read from the row below occupant.
 */
function buildOccupantMap() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();
  const patientSheets = ss.getSheets().filter(s => isPatientSheetName(s.getName()));
  const occupantMap = {};

  for (let s = 0; s < patientSheets.length; s++) {
    const ptSheet = patientSheets[s];
    const data = ptSheet.getDataRange().getValues();
    if (data.length < 5) continue;

    // Row 1 col B: "Hospital: Ward"
    let hospital = "", ward = "";
    const hwCell = data[0][1] || "";
    if (typeof hwCell === "string" && hwCell.includes(":")) {
      const parts = hwCell.split(":");
      hospital = (parts[0] || "").trim();
      ward     = (parts[1] || "").trim();
    } else {
      hospital = String(hwCell);
    }

    // Row 4: shift labels; precompute per-column night/day once
    const shiftRow = data[3]; // 0-based row index
    const colIsNight = new Array(shiftRow.length);
    for (let c = 0; c < shiftRow.length; c++) {
      const lab = (shiftRow[c] || "").toString().toLowerCase();
      colIsNight[c] = lab.includes("night");
    }

    // Iterate rows: r = 5th row (index 4) is occupants; r+1 is references
    for (let r = 4; r < data.length; r += 2) {
      const occupantRow = data[r];
      if (!occupantRow || occupantRow.length < 2) continue;

      const occupantDateVal = occupantRow[1];
      if (!occupantDateVal) continue;

      const dateObj = occupantDateVal instanceof Date ? occupantDateVal : new Date(occupantDateVal);
      if (isNaN(dateObj.valueOf())) continue;

      const dateKey = Utilities.formatDate(dateObj, tz, "yyyyMMdd");
      const dateStr = Utilities.formatDate(dateObj, tz, "dd/MM/yyyy");
      const refRow  = data[r + 1]; // may be undefined

      for (let c = 2; c < occupantRow.length; c++) {
        const occupantNameCell = occupantRow[c];
        if (!occupantNameCell) continue;

        const occupantName = occupantNameCell.toString().trim().toLowerCase();
        if (!occupantName) continue;

        const occupantShift = colIsNight[c] ? "night" : "day";
        const occupantReference = (refRow && refRow[c]) ? refRow[c].toString().trim() : "";

        let perName = occupantMap[occupantName];
        if (!perName) {
          perName = {};
          occupantMap[occupantName] = perName;
        }
        perName[dateKey] = {
          shift: occupantShift,
          hospital,
          ward,
          dateStr,
          reference: occupantReference
        };
      }
    }
  }

  return occupantMap;
}

/**
 * Given a staff header like "Female RMN" or "HCA (Male or Female)",
 * returns just "RMN" or "HCA". Defaults to "" if not matched.
 */
/**
 * From a header like
 *   “Female RMN”
 *   “RMN (Male or Female)”
 *   “Male HCA”
 * … removes any occurrence of the words “male” or “female” (and any parentheses)
 * and returns the remainder in uppercase.
 */
function parseJobTitleFromHeader(headerVal) {
  let s = (headerVal||"").toString().trim();
  // 1) Remove parentheticals: "(…)"
  s = s.replace(/\([^)]*\)/g, "");
  // 2) Remove the words “male” or “female”
  s = s.replace(/\bmale\b/gi, "").replace(/\bfemale\b/gi, "");
  // 3) Collapse whitespace and uppercase
  return s.trim().replace(/\s+/g, " ").toUpperCase();
}


/**
 * Same occupantMap logic, but skip the cell currently being edited.
 */
function buildOccupantMapSkippingEditedCell(e) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const patientSheets = ss.getSheets().filter(s => isPatientSheetName(s.getName()));
  const occupantMap = {};

  const editedSheetName = e.range.getSheet().getName();
  const editedRow = e.range.getRow();
  const editedCol = e.range.getColumn();

  patientSheets.forEach(ptSheet => {
    const data = ptSheet.getDataRange().getValues();
    if (data.length < 5) return;

    let hospital = "", ward = "";
    const hwCell = data[0][1] || "";
    if (typeof hwCell === "string" && hwCell.includes(":")) {
      [hospital, ward] = hwCell.split(":").map(s => s.trim());
    } else {
      hospital = hwCell.toString();
    }

    const shiftRow = data[3]; // row 4 => shift labels

    for (let r = 4; r < data.length; r += 2) {
      const occupantRow = data[r];
      if (occupantRow.length < 2) continue;
      const occupantDateVal = occupantRow[1];
      if (!occupantDateVal) continue;

      const dateObj = new Date(occupantDateVal);
      if (isNaN(dateObj.valueOf())) continue;

      const dateKey = Utilities.formatDate(dateObj, ss.getSpreadsheetTimeZone(), "yyyyMMdd");
      const dateStr = Utilities.formatDate(dateObj, ss.getSpreadsheetTimeZone(), "dd/MM/yyyy");

      for (let c = 2; c < occupantRow.length; c++) {
        const occupantNameCell = occupantRow[c];
        if (!occupantNameCell) continue;

        // Skip the cell currently being edited
        const actualSheetRow = r + 1;
        const actualSheetCol = c + 1;
        if (
          ptSheet.getName() === editedSheetName &&
          actualSheetRow === editedRow &&
          actualSheetCol === editedCol
        ) {
          continue;
        }

        // occupantName => lowercased
        const occupantName = occupantNameCell
          .toString()
          .trim()
          .toLowerCase();

        const label = (shiftRow[c] || "").toString().toLowerCase();
        const occupantShift = label.includes("night") ? "night" : "day";

        // Also read the reference from the row below occupant => data[r+1][c]
        let occupantReference = "";
        if (data[r + 1] && data[r + 1][c]) {
          occupantReference = data[r + 1][c].toString().trim();
        }

        if (!occupantMap[occupantName]) occupantMap[occupantName] = {};
        occupantMap[occupantName][dateKey] = {
          shift: occupantShift,
          hospital,
          ward,
          dateStr,
          reference: occupantReference
        };
      }
    }
  });

  return occupantMap;
}


/*************************************************
 * EXTEND ROTA
 *************************************************/
/**
 * Prompts for a new end date and appends only the new rows,
 * then only redraws borders around those new rows.
 */


/**
 * Prompts for a new end date, appends “day + REF” rows in pairs,
 * and draws a four‐sided border around each new pair, across all columns.
 * Does not reformat any existing rows.
 */
function extendRota() {
  const ui    = SpreadsheetApp.getUi();
  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getActiveSheet();

  // 1) Verify we’re on a Patient_* rota sheet
  if (!isPatientSheetName(sheet.getName())) {
    ui.alert("This option only works on a 'Patient ???' rota sheet.");
    return;
  }

  // 2) Ask for new end date
  const resp = ui.prompt(
    "Extend Rota",
    "Enter the new end date (dd/mm/yyyy):",
    ui.ButtonSet.OK_CANCEL
  );
  if (resp.getSelectedButton() !== ui.Button.OK) return;

  const [d, m, y] = resp.getResponseText().trim().split("/").map(Number);
  const newEnd    = new Date(y, m - 1, d);
  if (isNaN(newEnd)) {
    ui.alert("Invalid date format. Please use dd/mm/yyyy.");
    return;
  }

  // 3) Find current last date in column B (rows 5,7,9…)
  let lastDate = null;
  const lastRow = sheet.getLastRow();
  for (let r = 5; r <= lastRow; r += 2) {
    const v = sheet.getRange(r, 2).getValue();
    if (v instanceof Date && !isNaN(v.valueOf())) {
      lastDate = v;
    }
  }
  if (!lastDate) {
    ui.alert("Could not find a valid last date in the rota.");
    return;
  }
  if (newEnd <= lastDate) {
    ui.alert("The new end date must be after the current last date.");
    return;
  }

  // 4) Determine how many staff‐columns exist
  const tz             = ss.getSpreadsheetTimeZone();
  const shiftLabels    = sheet
    .getRange(4, 3, 1, sheet.getLastColumn() - 2)
    .getValues()[0];
  const totalStaffCols = shiftLabels.length;
  const totalCols      = totalStaffCols + 2;  // including Day & Date

  // LOGGING: check counts
  Logger.log("totalStaffCols=%s, totalCols=%s", totalStaffCols, totalCols);

  // 5) Append new rows two at a time, draw border on each pair
  let rowIndex  = sheet.getLastRow() + 1;
  const current = new Date(lastDate);

  while (current < newEnd) {
    current.setDate(current.getDate() + 1);
    const dayName = Utilities.formatDate(current, tz, "EEEE");
    const dateStr = Utilities.formatDate(current, tz, "dd/MM/yyyy");

    // — Day row —
    sheet
      .getRange(rowIndex, 1)
      .setValue(dayName)
      .setBackground("#fff2cc");
    sheet
      .getRange(rowIndex, 2)
      .setValue(dateStr)
      .setBackground("#fff2cc");
    sheet
      .getRange(rowIndex, 3, 1, totalStaffCols)
      .setBackground("#ffffff")
      .setFontColor("#000000");

    // — REF row —
    sheet
      .getRange(rowIndex + 1, 1)
      .setValue("REF")
      .setBackground("#fff2cc");
    sheet
      .getRange(rowIndex + 1, 2)
      .setValue("")
      .setBackground("#fff2cc");
    sheet
      .getRange(rowIndex + 1, 3, 1, totalStaffCols)
      .setBackground("#ffffff")
      .setFontColor("#000000");

    // — Border around this new 2×totalCols block —
    const blockRange = sheet.getRange(rowIndex, 1, 2, totalCols);

    // LOGGING: which range is being bordered
    Logger.log("Applying border to range %s", blockRange.getA1Notation());

    blockRange.setBorder(
      true,  // top
      true,  // left
      true,  // bottom
      true,  // right
      true,  // inner vertical borders
      false, // no inner horizontal borders
      "black",
      SpreadsheetApp.BorderStyle.SOLID
    );

    rowIndex += 2;
  }

  ui.alert(
    "Rota successfully extended to! " +
    Utilities.formatDate(newEnd, tz, "dd/MM/yyyy")
  );
  // ⚠️ No call to applyRotaFormatting here.
}

/*************************************************
 * GET CANDIDATE LIST ROW DATA
 *************************************************/
function getCandidateListRowData(fullName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const cSheet = ss.getSheetByName("Candidate List");
  if (!cSheet) return null;

  const data = cSheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const surname   = (row[0] || "").toString().trim();
    const firstname = (row[1] || "").toString().trim();
    const combined = (surname + " " + firstname).toLowerCase();
    if (combined === fullName.toLowerCase()) {
      return {
        rowIndex: i+1,
        rawRow: row.slice(0,6) // columns A..F
      };
    }
  }
  return null;
}


