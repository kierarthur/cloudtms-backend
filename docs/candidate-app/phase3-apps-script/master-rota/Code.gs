/**
 * Fetch Documents API once and return an "APPROVED-only" view.
 * - Keeps each document in the array, but filters its files to APPROVED only.
 * - Repoints doc.activeFile to the newest APPROVED file (by `created`) when available.
 * - Adds flags for clarity: `hasApproved` and `approvedCount`.
 * - Preserves the original `files` as `allFilesOriginal` for audit/debug (optional but useful).
 *
 * Usage:
 *   const docsApproved = fetchDocumentsApproved_(publicId, ctx);
 *   // Downstream code should only read doc.activeFile and/or doc.files (now APPROVED-only).
 *
 * Assumptions:
 *   - A helper `httpGetJson_(url, ctx)` exists and returns { ok, data, error }.
 *   - Global `API_BASE` is defined.
 *   - Each file may contain an array `verifications`, where an item having `verificationType === 'APPROVED'`
 *     marks that file as approved.
 */
function fetchDocumentsApproved_(publicId, ctx) {
  const stepCtx = { ...(ctx || {}), step: 'Documents API: fetch & filter APPROVED' };

  // 1) Fetch raw documents once (corrected endpoint)
  const url = `${API_BASE}/employees/${encodeURIComponent(String(publicId || ''))}/documents?includeFiles=true`;
  const res = httpGetJson_(url, stepCtx);

  if (!res || !res.ok || !Array.isArray(res.data)) {
    // Return an empty list on failure to keep callers simple and predictable
    return [];
  }

  const rawDocs = res.data;

  // 2) Build APPROVED-only view per document
  const approvedDocs = [];
  for (const doc of rawDocs) {
    if (!doc || typeof doc !== 'object') continue;

    // Normalize files list: include doc.files[] and doc.activeFile (if not already in files[])
    const originalFiles = Array.isArray(doc.files) ? doc.files.slice() : [];
    const activeFile = doc.activeFile && typeof doc.activeFile === 'object' ? doc.activeFile : null;

    // Some APIs don't guarantee activeFile is in files[]; include it if it's distinct by id
    if (activeFile && !originalFiles.some(f => String(f?.id || '') === String(activeFile.id))) {
      originalFiles.push(activeFile);
    }

    // Helper: does a file have at least one APPROVED verification?
    const isApprovedFile = (fileObj) => {
      const verifs = (fileObj && Array.isArray(fileObj.verifications)) ? fileObj.verifications : [];
      for (let i = 0; i < verifs.length; i++) {
        const vt = String(verifs[i]?.verificationType || '').toUpperCase();
        if (vt === 'APPROVED') return true;
      }
      return false;
    };

    // Filter to APPROVED-only files
    const filesApproved = originalFiles.filter(isApprovedFile);

    // Sort APPROVED files newest first by `created` (fallback to id if missing)
    filesApproved.sort((a, b) => {
      const da = a?.created ? new Date(a.created).getTime() : 0;
      const db = b?.created ? new Date(b.created).getTime() : 0;
      if (db !== da) return db - da;
      // Tiebreaker: numeric id desc if possible
      const ia = parseInt(a?.id, 10), ib = parseInt(b?.id, 10);
      if (!Number.isNaN(ib) && !Number.isNaN(ia) && ib !== ia) return ib - ia;
      // Stable fallback
      return 0;
    });

    // Repoint activeFile to newest APPROVED (or null if none)
    const approvedActive = filesApproved.length ? filesApproved[0] : null;

    // Build a clean document view
    const cleaned = {
      ...doc,
      // Preserve original files for audit/debug (optional)
      allFilesOriginal: originalFiles,
      // Replace files[] with APPROVED-only set for all downstream selectors
      files: filesApproved,
      // Repoint activeFile to an approved one (or null)
      activeFile: approvedActive,
      // Convenience flags
      hasApproved: filesApproved.length > 0,
      approvedCount: filesApproved.length,
    };

    approvedDocs.push(cleaned);
  }

  return approvedDocs;
}



