function getOutputFolder_() {
  const propId = PropertiesService.getScriptProperties().getProperty('OUTPUT_FOLDER_ID');
  if (propId) {
    try {
      const folder = DriveApp.getFolderById(propId);
      // Touch a property to ensure it's accessible
      void folder.getName();
      return folder;
    } catch (e) {
      throw new Error('getOutputFolder_: Cannot access folder with OUTPUT_FOLDER_ID. Verify the ID and sharing.');
    }
  }

  // Fallback to legacy behavior (My Drive by name). Kept for backward compatibility.
  const name = GENERATED_CHECKLIST_FOLDER_PATH || 'Generated Checklists';
  const maxAttempts = 3;
  let lastErr = '';
  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    try {
      const it = DriveApp.getFoldersByName(name);
      if (it.hasNext()) {
        const f = it.next();
        return f;
      }
      const f = DriveApp.createFolder(name);
      return f;
    } catch (e) {
      lastErr = String(e);
      Utilities.sleep(400 * attempt);
    }
  }
  throw new Error('getOutputFolder_: Unable to resolve output folder.');
}

/**
 * Send the original blob (image OR PDF) to the Cloud Run headshot service.
 * Returns { ok:boolean, blob?:Blob } where blob is a JPEG headshot.
 *
 * Requires Script Property: HEADSHOT_SERVICE_URL = "https://.../process"
 * Your Cloud Run service is currently unauthenticated, so no token needed.
 */


function callHeadshotService_(sourceBlob, ctx) {
  const step = (ctx && ctx.step) || 'DOC IMAGE: service';
  const url = (PropertiesService.getScriptProperties().getProperty('HEADSHOT_SERVICE_URL') || '').trim();
  if (!url) {
    return { ok: false };
  }

  try {
    // Let UrlFetchApp build multipart/form-data with a Blob payload automatically.
    // DO NOT set contentType manually; let it add the boundary.
    const resp = UrlFetchApp.fetch(url, {
      method: 'post',
      payload: { file: sourceBlob },
      followRedirects: true,
      muteHttpExceptions: true,
    });

    const code = resp.getResponseCode();
    const ct = String(resp.getHeaders()['Content-Type'] || resp.getHeaders()['content-type'] || '').toLowerCase();
    if (code >= 200 && code < 300 && ct.indexOf('image/jpeg') === 0) {
      const jpeg = resp.getBlob();
      try { jpeg.setContentType('image/jpeg'); } catch (_) {}
      try { jpeg.setName('headshot.jpg'); } catch (_) {}
      return { ok: true, blob: jpeg };
    }

    return { ok: false };
  } catch (e) {
    return { ok: false };
  }
}

/**
 * If no face is found or the headshot service fails, 
 * center-crop to the 35x45 aspect (W:H ≈ 0.78).
 * Returns a JPEG Blob.
 */
function centerCropToIdAspect_(imgBlob) {
  const targetWH = 0.78; // target width:height ratio (35/45)
  const img = ImagesService.openImage(imgBlob);
  const W = img.getWidth(), H = img.getHeight();
  const currentWH = W / H;

  let w, h, x, y;
  if (currentWH > targetWH) {
    // Image too wide → reduce width
    h = H;
    w = Math.round(h * targetWH);
    x = Math.round((W - w) / 2);
    y = 0;
  } else {
    // Image too tall → reduce height
    w = W;
    h = Math.round(w / targetWH);
    x = 0;
    y = Math.round((H - h) / 2);
  }

  const cropped = ImagesService.openImage(imgBlob).crop(x, y, w, h).getBlob();
  try { cropped.setContentType('image/jpeg'); } catch (_) {}
  try {
    const base = (imgBlob.getName && imgBlob.getName()) || 'headshot';
    cropped.setName(base.replace(/\.[^.]+$/, '') + '_center.jpg');
  } catch (_) {}
  return cropped;
}

/**
