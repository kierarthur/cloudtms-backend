  return { ok: true, blob: res.blob };
}

/**
 * Convert a date string from YYYY-MM-DD to DD-MM-YYYY when possible.
 * If format is unknown, try pickDate() (DD/MM/YYYY) then convert slashes to hyphens.
 * Returns '' on failure.
 */
function formatDobHyphen_(value) {
  const s = String(value || '').trim();
  if (!s) return '';
  const m = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (m) return `${m[3]}-${m[2]}-${m[1]}`;
  const ddmmyyyy = pickDate(s);               // DD/MM/YYYY (best effort)
  return ddmmyyyy ? ddmmyyyy.replace(/\//g, '-') : '';
}
