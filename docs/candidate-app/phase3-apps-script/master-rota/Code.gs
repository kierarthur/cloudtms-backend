/**
 * If occupant name is now blank, color occupant cell red if occupant hasn't 
 * been removed from EmailHistory, or white if occupant is fully canceled. 
 * For now, we default to red and rely on refreshAllPatientSheetColors() 
 * after sending updates to finalize coloring to white if occupant is truly canceled.
 */
function colorVacantShiftsIfCanceled(e) {
  const sheet     = e.range.getSheet();
  const sheetName = sheet.getName();
  if (!isPatientSheetName(sheetName)) return;
  const row0 = e.range.getRow();
  const col0 = e.range.getColumn();
  if (row0 <= 4 || col0 <= 2) return;
  if (!sheet.getRange(3, col0).getValue()) return;

  const oldDataMap = loadOldEmailHistory();
  const tz         = sheet.getParent().getSpreadsheetTimeZone();

  const startRow = row0;
  const endRow   = row0 + e.range.getNumRows() - 1;
  const startCol = col0;
  const endCol   = col0 + e.range.getNumColumns() - 1;

  for (let row = startRow; row <= endRow; row++) {
    const isNameRow = row >= 5 && ((row - 5) % 2 === 0);
    if (!isNameRow) continue;
    if (!sheet.getRange(row, 1).getValue()) continue;

    // precompute dateKey
    const dateVal = sheet.getRange(row, 2).getValue();
    if (!dateVal) continue;
    const dateObj = new Date(dateVal);
    if (isNaN(dateObj)) continue;
    const dateStrFormatted = Utilities.formatDate(dateObj, tz, "dd/MM/yyyy");

    for (let col = startCol; col <= endCol; col++) {
      const cell = sheet.getRange(row, col);
      const newVal = cell.getValue().toString().trim();
      if (newVal !== "") continue;  // only care about blanks

      // who was in oldValue?
      const oldNameRaw = (e.oldValue || "").toString().trim().toLowerCase();

      if (!oldNameRaw) {
        // was blank before, so truly nothing → white + reset ref below
        cell.setBackground("#ffffff");
        const refCell = sheet.getRange(row + 1, col);
        if (!refCell.getValue().toString().trim()) {
          // only reset to black if there's no text
          refCell.setBackground("#ffffff");
        }
        continue;
      }

      // figure shiftType for this column
      const shiftLabel = sheet.getRange(4, col).getValue().toString().toLowerCase();
      const shiftType  = shiftLabel.includes("night") ? "night" : "day";

      // were they ever notified?
      const history = oldDataMap[oldNameRaw] || [];
      const wasNotified = history.some(s =>
        s.date.trim() === dateStrFormatted &&
        s.shift.toLowerCase().includes(shiftType)
      );

      if (wasNotified) {
        // real cancellation → red (leave ref alone)
        cell.setBackground("#ff9999");
      } else {
        // never notified → back to white + reset reference cell
        cell.setBackground("#ffffff");
        const refCell = sheet.getRange(row + 1, col);
        if (!refCell.getValue().toString().trim()) {
  const bg = cell.getBackground();
  const fc = cell.getFontColor();
  refCell.setBackground(bg).setFontColor(fc);
}
        }
      }
    }
  }




/*************************************************
 * CONFLICT CHECK – BEFORE SENDING EMAILS
 *************************************************/
function detectAnyRotaConflicts(occupantMap) {
  const timezone = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone();

  for (const occupantKey in occupantMap) {
    const shifts = occupantMap[occupantKey];
    const seen = {};

    for (let i = 0; i < shifts.length; i++) {
      const s = shifts[i];
      const d = parseDateDDMMYYYY(s.date);
      if (isNaN(d)) continue;

      const dateKey = Utilities.formatDate(d, timezone, "yyyyMMdd");
      const prevDate = new Date(d);
      const nextDate = new Date(d);
      prevDate.setDate(prevDate.getDate() - 1);
      nextDate.setDate(nextDate.getDate() + 1);

      // Force shiftType => day/night
      const labelLower = String(s.shift || "").toLowerCase();
      const shiftType = labelLower.includes("night") ? "night" : "day";

      // same-day double booking?
      if (seen[dateKey]) {
        return `${occupantKey} has multiple shifts on ${s.date}.`;
      }

      // night → day conflict next day
      if (shiftType === "night" && seen[Utilities.formatDate(nextDate, timezone, "yyyyMMdd")] === "day") {
        return `${occupantKey} has NIGHT on ${s.date} and DAY on ${Utilities.formatDate(nextDate, timezone, "dd/MM/yyyy")}.`;
      }

      // day → night conflict previous day
      if (shiftType === "day" && seen[Utilities.formatDate(prevDate, timezone, "yyyyMMdd")] === "night") {
        return `${occupantKey} has NIGHT on ${Utilities.formatDate(prevDate, timezone, "dd/MM/yyyy")} and DAY on ${s.date}.`;
      }

      // Mark usage
      seen[dateKey] = shiftType;
    }
  }

  return null;
}


/*************************************************
 * LOG CHANGES
 *************************************************/
/**
 * Logs every booking/cancellation/reference change with sheet name and cell.
 */
function logChanges(eOrEvents) {
  // Normalize input to an array
  const events = Array.isArray(eOrEvents) ? eOrEvents : [eOrEvents];
  if (!events.length) return;

  const ss        = SpreadsheetApp.getActiveSpreadsheet();
  const tz        = ss.getSpreadsheetTimeZone();
  const logsSheet = ss.getSheetByName("Logs") || ss.insertSheet("Logs");
  const userEmail = Session.getActiveUser().getEmail();

  // Accumulate log rows and ref cells to clear (batched per sheet)
  const rowsToAppend = [];
  const clearRefBySheetId = new Map(); // sheetId -> array of A1 notations

  for (const e of events) {
    if (!e || !e.range) continue;

    const sheet     = e.range.getSheet();
    const sheetName = sheet.getName();
    if (!isPatientSheetName(sheetName)) continue;

    const row = e.range.getRow();
    const col = e.range.getColumn();
    const a1  = e.range.getA1Notation();

    const oldValue = e.oldValue || "";
    const newValue = e.value || "";

    const isNameRow      = row >= 5 && ((row - 5) % 2 === 0);
    const isReferenceRow = row >= 6 && ((row - 6) % 2 === 0);

    // Hospital / Ward from B1
    const hw = sheet.getRange(1, 2).getValue() || "";
    let hospital = "", ward = "";
    if (typeof hw === "string" && hw.includes(":")) {
      const parts = hw.split(":");
      hospital = String(parts[0] || "").trim();
      ward     = String(parts[1] || "").trim();
    } else {
      hospital = String(hw || "").trim();
    }

    // Shift date (col B of name row; or the row above for ref rows)
    let rawDate = isNameRow
      ? sheet.getRange(row, 2).getValue()
      : isReferenceRow
        ? sheet.getRange(row - 1, 2).getValue()
        : null;

    let dateObj;
    if (rawDate instanceof Date) {
      dateObj = rawDate;
    } else if (typeof rawDate === "string" && rawDate) {
      const [dd, mm, yyyy] = rawDate.split("/").map(Number);
      if (!isNaN(dd) && !isNaN(mm) && !isNaN(yyyy)) {
        dateObj = new Date(yyyy, mm - 1, dd);
      }
    }
    const dateString = dateObj
      ? Utilities.formatDate(dateObj, tz, "EEE d MMMM yyyy")
      : "";

    // Shift type from header row 4
    const headerVal = sheet.getRange(4, col).getValue() || "";
    const shiftType = String(headerVal).toLowerCase().includes("night") ? "Night" : "Long Day";

    // Helper to push one log row
    const pushRow = (reason, candidate, bookingRef) => {
      rowsToAppend.push([
        new Date(),      // timestamp
        reason,          // CANCELLATION / BOOKING / REFERENCE
        sheetName,       // sheet
        a1,              // A1 notation
        dateString,      // shift date (pretty)
        shiftType,       // shift
        candidate,       // name
        bookingRef,      // reference
        hospital,        // hospital
        ward,            // ward
        userEmail        // actor
      ]);
    };

    if (isNameRow) {
      // cancellation
      if (oldValue && !newValue) {
        const refA1 = sheet.getRange(row + 1, col).getA1Notation();
        const refVal = sheet.getRange(row + 1, col).getValue() || "";
        pushRow("CANCELLATION", oldValue, refVal);

        // batch clear the REF cell
        const shId = String(sheet.getSheetId ? sheet.getSheetId() : sheetName);
        if (!clearRefBySheetId.has(shId)) clearRefBySheetId.set(shId, { sheet, a1s: [] });
        clearRefBySheetId.get(shId).a1s.push(refA1);
      }
      // booking
      else if (!oldValue && newValue) {
        const bookingRef = sheet.getRange(row + 1, col).getValue() || "";
        pushRow("BOOKING", newValue, bookingRef);
      }
      // changed name -> cancel + book
      else if (oldValue && newValue && oldValue !== newValue) {
        const refVal = sheet.getRange(row + 1, col).getValue() || "";
        pushRow("CANCELLATION", oldValue, refVal);
        pushRow("BOOKING",      newValue, refVal);
      }
    } else if (isReferenceRow) {
      // reference change
      if (oldValue !== newValue) {
        const candidateName = sheet.getRange(row - 1, col).getValue() || "";
        pushRow("REFERENCE", candidateName, newValue);
      }
    }
  }

  // Batch-append all log rows in one write
  if (rowsToAppend.length) {
    const startRow = logsSheet.getLastRow() + 1;
    const numCols  = 11;
    logsSheet.getRange(startRow, 1, rowsToAppend.length, numCols).setValues(rowsToAppend);
  }

  // Batch-clear all queued REF cells (grouped per sheet)
  for (const { sheet, a1s } of clearRefBySheetId.values()) {
    if (a1s && a1s.length) {
      sheet.getRangeList(a1s).clearContent();
    }
  }
}


