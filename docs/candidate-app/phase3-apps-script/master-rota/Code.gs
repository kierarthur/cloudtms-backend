function appendWorkersToRota(sheet, counts) {
  // 1) Find rightmost existing RMN/HCA header in row 3
  const headers        = sheet.getRange(3, 1, 1, sheet.getMaxColumns()).getValues()[0];
  const staffCols      = headers
    .map((txt, i) => (txt && (txt.includes('RMN') || txt.includes('HCA'))) ? i + 1 : null)
    .filter(c => c);
  const lastStaffCol   = staffCols.length ? Math.max(...staffCols) : 2;
  const insertColStart = lastStaffCol + 1;

  // 2) Figure out how many date blocks we have (rows 5..last REF)
  const colA           = sheet.getRange(1, 1, sheet.getMaxRows()).getValues().flat();
  const lastRefRow     = colA.reduce((last, v, i) => v === 'REF' ? i + 1 : last, 0);
  if (lastRefRow < 5) throw new Error('Could not find any REF rows – is this a valid rota sheet?');
  const dataRowsCount  = lastRefRow - 4;  // number of “day+REF” pairs

  // 3) Build the new staff layout
  const staffLayout = [];
  function push(role, gender, n) {
    for (let i = 0; i < n; i++) staffLayout.push({ role, gender });
  }
  push('RMN', 'Male',      counts.maleRMN);
  push('RMN', 'Female',    counts.femaleRMN);
  push('RMN', 'NoGender',  counts.anyRMN);
  push('HCA', 'Male',      counts.maleHCA);
  push('HCA', 'Female',    counts.femaleHCA);
  push('HCA', 'NoGender',  counts.anyHCA);

  const newColsCount = staffLayout.length * 2;
  if (newColsCount === 0) return; // nothing to add

  // ─────────────────────────────────────────────────────────────
  // DEFAULT LOOK: ONLY TOUCH THE NEW COLUMNS
  // ─────────────────────────────────────────────────────────────
  const STD_WIDTH = 160;
  const YELLOW    = '#FFF2CC';
  const WHITE     = '#FFFFFF';
  const BLACK     = '#000000';

  // 4) Write headers & subheaders (rows 3–4) for the new columns
  let insertCol = insertColStart;
  staffLayout.forEach(st => {
    const headerText = (st.gender === 'NoGender')
      ? `${st.role} (Male or Female)`
      : `${st.gender} ${st.role}`;

    // two columns per staff slot
    sheet.getRange(3, insertCol).setValue(headerText);
    sheet.getRange(3, insertCol + 1).setValue(headerText);
    sheet.getRange(4, insertCol).setValue('Long Day 0730-2000hrs');
    sheet.getRange(4, insertCol + 1).setValue('Night 1930-0800hrs');

    insertCol += 2;
  });

  // 5) Apply default header band & borders ONLY to new columns (rows 3–4)
  sheet
    .getRange(3, insertColStart, 2, newColsCount)
    .setBackground(YELLOW);
  for (let c = insertColStart; c < insertColStart + newColsCount; c++) {
    sheet.getRange(3, c, 2, 1).setBorder(
      true,  true,  true,  true,  // top, left, bottom, right
      null,  null,
      BLACK, SpreadsheetApp.BorderStyle.SOLID
    );
  }

  // 6) Set default column widths ONLY for new columns
  for (let c = insertColStart; c < insertColStart + newColsCount; c++) {
    sheet.setColumnWidth(c, STD_WIDTH);
  }

  // 7) Default body styling ONLY for new columns (rows 5..lastRefRow)
  sheet
    .getRange(5, insertColStart, dataRowsCount, newColsCount)
    .clearContent()
    .setBackground(WHITE)
    .setFontColor(BLACK)
    .setFontWeight('normal');

  // 8) Draw default borders per day+REF block ONLY over the new columns
  colA.forEach((val, idx) => {
    if (val === 'REF') {
      const rowRef     = idx + 1;
      const rowDay     = rowRef - 1;
      const groupRange = sheet.getRange(rowDay, insertColStart, 2, newColsCount);
      groupRange.setBorder(
        true,   // top
        true,   // left
        true,   // bottom
        true,   // right
        true,   // inner vertical borders
        false,  // inner horizontal borders
        BLACK,
        SpreadsheetApp.BorderStyle.SOLID
      );
    }
  });

  // 9) Done — only the new columns were styled/updated.
}





