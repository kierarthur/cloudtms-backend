  const url    = `https://eu-api.wati.io/${tenant}/api/v2/sendTemplateMessages`;

  // Build receivers array with only the two params
  const receivers = selected.map(o => ({
    whatsappNumber: o.phone,
    customParams: [
      { name: "forename",          value: o.firstname },
      { name: "nextshifthospital", value: form.hospital }
    ]
  }));

  // Build the full payload
  const payload = {
    template_namespace: "your_template_namespace_here",
    template_name: form.mode === "Immediate Start"
                     ? "susseximmediate1"
                     : "sussextonight",
    broadcast_name: `Emergency_${form.ward}_${Utilities.formatDate(now, tz, "yyyyMMdd_HHmmss")}`,
    receivers: receivers
  };

  // Send it
  const options = {
    method: "post",
    contentType: "application/json",
    headers: { Authorization: WATI_TOKEN },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };
  const resp = UrlFetchApp.fetch(url, options);

  // ─────────────────────────────────────────────────────────────
  // Additional logic: track the "active" cohort and (re)start the timer.
  // - Merge this send's phones with any existing active cohort (de-dupe).
  // - Record LAST_WATI_SEND_TS (epoch ms) so the timer window is restarted.
  // - Admin sets WATI_EXPIRY_TIME (minutes) separately; we only read it later.
  // ─────────────────────────────────────────────────────────────
  try {
    const props = PropertiesService.getScriptProperties();

    // existing active cohort (array of phone strings) or []
    const existingJson = props.getProperty('ACTIVE_WATI_CONTACTS_JSON') || '[]';
    let active = [];
    try { active = JSON.parse(existingJson) || []; } catch (_) { active = []; }

    // normalize to strings and merge + de-dupe
    const justSent = receivers.map(r => String(r.whatsappNumber || '')).filter(Boolean);
    const merged   = Array.from(new Set([].concat(active, justSent)));

    // write back cohort + restart timer
    props.setProperty('ACTIVE_WATI_CONTACTS_JSON', JSON.stringify(merged));
    props.setProperty('LAST_WATI_SEND_TS', String(Date.now()));
    // (Do not touch WATI_EXPIRY_TIME here; it’s configured elsewhere.)
  } catch (e) {
    // Swallow any bookkeeping errors so the original function contract remains.
  }

  return resp;
}



