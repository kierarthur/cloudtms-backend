function showChangeHospitalWardDialog() {
  var html = HtmlService.createHtmlOutputFromFile('ChangeHospitalWard')
    .setWidth(520)
    .setHeight(450);
  SpreadsheetApp.getUi().showModalDialog(html, 'Change Hospital & Ward');
}

function getCurrentHospitalWardContext() {
  var ss    = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getActiveSheet();
  var sheetName = sheet.getName();

  if (!/^Patient_/.test(sheetName)) {
    throw new Error('Please open a Patient_* rota sheet before using "Change Hospital & Ward".');
  }

  var headerVal = String(sheet.getRange('B1').getValue() || '');
  var idx = headerVal.lastIndexOf(': ');
  if (idx < 0) {
    throw new Error('Unexpected header format in B1. Expected "Hospital: Ward".');
  }

  var hospital = headerVal.substring(0, idx);
  var ward     = headerVal.substring(idx + 2);

  return {
    sheetName: sheetName,
    header: headerVal,
    hospital: hospital,
    ward: ward
  };
}

/**
 * Unified change function: supports two modes selected in HTML:
 *
 *   mode === 'hospitalWard'  → change hospital & ward (hospital REQUIRED)
 *   mode === 'wardOnly'      → change ward only (hospital is kept identical)
 *
 * Uses _mapHospitalString, _parseWardDisplay, _maxPForHospitalWardBase
 * to ensure (hospital, wardBase) is unique via P1/P2/P3 if needed.
 *
 * Payload shape:
 *   { mode: 'hospitalWard'|'wardOnly', hospitalRaw: string, wardRaw: string }
 */
function changeHospitalAndWardFromPayload(payload) {
  var ss    = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getActiveSheet();
  var sheetName = sheet.getName();

  if (!/^Patient_/.test(sheetName)) {
    throw new Error('Please open a Patient_* rota sheet before using "Change Hospital & Ward".');
  }

  // Parse current header B1: "Hospital: Ward"
  var headerVal = String(sheet.getRange('B1').getValue() || '');
  var idx = headerVal.lastIndexOf(': ');
  if (idx < 0) {
    throw new Error('Unexpected header format in B1. Expected "Hospital: Ward".');
  }

  var oldHospital = headerVal.substring(0, idx);
  var oldWard     = headerVal.substring(idx + 2);

  if (!payload) {
    throw new Error('Missing update payload.');
  }

  // Normalise mode; default to hospitalWard if anything odd
  var modeRaw = String(payload.mode || '');
  var mode = (modeRaw === 'wardOnly') ? 'wardOnly' : 'hospitalWard';

  var wardRaw = String(payload.wardRaw || '').trim();
  if (!wardRaw) {
    throw new Error('Ward is required.');
  }

  var hospitalRaw = String(payload.hospitalRaw || '').trim();
  var newHospital;

  if (mode === 'wardOnly') {
    // ALWAYS keep the hospital identical in ward-only mode, ignoring any hospitalRaw.
    newHospital = oldHospital;
  } else {
    // hospitalWard mode: hospital is REQUIRED
    if (!hospitalRaw) {
      throw new Error('Hospital is required when changing hospital & ward.');
    }
    newHospital = _mapHospitalString(hospitalRaw);
  }

  // Enforce uniqueness of (newHospital, wardBase) using P1/P2/P3
  var parsedWard   = _parseWardDisplay(wardRaw);
  var wardBase     = parsedWard && parsedWard.base ? parsedWard.base : wardRaw;
  var maxPOrNull   = _maxPForHospitalWardBase(newHospital, wardBase);
  var newWardFinal = (maxPOrNull == null)
    ? wardBase
    : wardBase + ' P' + (maxPOrNull + 1);

  // If no change, short-circuit
  if (newHospital === oldHospital && newWardFinal === oldWard) {
    return {
      changed: false,
      message: 'No change – hospital and ward already have these values.',
      oldHospital: oldHospital,
      oldWard: oldWard,
      newHospital: newHospital,
      newWard: newWardFinal,
      emailRowsUpdated: 0,
      logRowsUpdated: 0
    };
  }

  // 1) Update header B1 on the rota
  sheet.getRange('B1').setValue(newHospital + ': ' + newWardFinal);

  // 2) Update EmailHistory: F (col 6) = hospital, G (col 7) = ward
  var emailRowsUpdated = 0;
  var emailS = ss.getSheetByName('EmailHistory');
  if (emailS) {
    var vals = emailS.getDataRange().getValues();
    for (var i = 1; i < vals.length; i++) { // start at 1 to skip header row
      var rowHospital = vals[i][5]; // col F (0-based index 5)
      var rowWard     = vals[i][6]; // col G (0-based index 6)

      if (rowHospital === oldHospital && rowWard === oldWard) {
        emailS.getRange(i + 1, 6).setValue(newHospital);  // F
        emailS.getRange(i + 1, 7).setValue(newWardFinal); // G
        emailRowsUpdated++;
      }
    }
  }

  // 3) Update TSO_Log: D (col 4) = hospital, E (col 5) = ward
  var logRowsUpdated = 0;
  var logS = ss.getSheetByName('TSO_Log');
  if (logS) {
    var logVals = logS.getDataRange().getValues();

    var normalize = function(str) {
      return String(str || '')
        .replace(/[^A-Za-z0-9]/g, '_')
        .replace(/_+/g, '_')
        .replace(/^_|_$/g, '');
    };

    var normSheet = normalize(sheetName);

    for (var j = 1; j < logVals.length; j++) { // skip header row
      var rowHospital  = logVals[j][3]; // D (0-based index 3)
      var rowWard      = logVals[j][4]; // E (0-based index 4)
      var rowSheetName = logVals[j][8]; // I (0-based index 8) – stored sheet name

      if (
        rowHospital === oldHospital &&
        rowWard     === oldWard &&
        normalize(rowSheetName) === normSheet
      ) {
        logS.getRange(j + 1, 4).setValue(newHospital);  // D
        logS.getRange(j + 1, 5).setValue(newWardFinal); // E
        logRowsUpdated++;
      }
    }
  }

  return {
    changed: true,
    oldHospital: oldHospital,
    oldWard: oldWard,
    newHospital: newHospital,
    newWard: newWardFinal,
    emailRowsUpdated: emailRowsUpdated,
    logRowsUpdated: logRowsUpdated
  };
}



function changeWard() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getActiveSheet();
  const ui = SpreadsheetApp.getUi();
  const sheetName = sheet.getName();

  // 1) Ensure we're on a Patient_* sheet
  if (!/^Patient_/.test(sheetName)) {
    ui.alert('Please open a Patient_* rota sheet before choosing Change Ward.');
    return;
  }

  // 2) Parse current header (B1)
  const header = sheet.getRange('B1').getValue().toString();
  const idx = header.lastIndexOf(': ');
  if (idx < 0) {
    ui.alert('Unexpected header format in B1.');
    return;
  }
  const hospital = header.substring(0, idx);
  const oldWard  = header.substring(idx + 2);

  // 3) Prompt user for new ward name
  const prompt = ui.prompt(
    'Change Ward',
    'Existing Hospital: ' + hospital + '\n' +
    'Existing Ward: '      + oldWard + '\n\n' +
    'Enter new ward name:',
    ui.ButtonSet.OK_CANCEL
  );
  if (prompt.getSelectedButton() !== ui.Button.OK) return;
  const newWard = prompt.getResponseText().trim();

  // 3.1) Validation: non-blank
  if (!newWard) {
    ui.alert('Ward name cannot be blank.');
    return;
  }

  // 3.2) No-change check
  if (newWard === oldWard) {
    ui.alert('No change detected—ward name remains unchanged.');
    return;
  }

  // 3.3) Uniqueness + suffix logic
  let baseWard = newWard
    .replace(/[^\w]/g, '_')
    .replace(/_+/g, '_')
    .replace(/^_|_$/g, '');

  const dateMatch = sheetName.match(/^Patient_(\d+)_.*_(\d{8})$/);
  if (!dateMatch) {
    ui.alert('Unexpected sheet name format.');
    return;
  }
  const idxNum    = dateMatch[1];
  const dateStamp = dateMatch[2];

  const sheets = ss.getSheets();
  const regex   = new RegExp('^Patient_\\d+_' + baseWard + '(?:_P(\\d+))?_\\d{8}$');
  let maxSuffix = -1;

  sheets.forEach(s => {
    const n = s.getName();
    if (n === sheetName) return;
    const m = n.match(regex);
    if (m) {
      const num = m[1] ? parseInt(m[1], 10) : 0;
      if (num > maxSuffix) maxSuffix = num;
    }
  });

  let nextSuffix = maxSuffix + 1;
  let wardLabel  = baseWard + (nextSuffix > 0 ? '_P' + nextSuffix : '');
  let newSheetName = `Patient_${idxNum}_${wardLabel}_${dateStamp}`;

  while (ss.getSheetByName(newSheetName)) {
    nextSuffix++;
    wardLabel    = baseWard + '_P' + nextSuffix;
    newSheetName = `Patient_${idxNum}_${wardLabel}_${dateStamp}`;
  }

  // 4.1) Update header B1
  sheet.getRange('B1').setValue(hospital + ': ' + newWard);

  // 4.2) (Sheet tab remains unchanged)

  // 4.3) Update EmailHistory
  const emailS = ss.getSheetByName('EmailHistory');
  if (emailS) {
    const vals = emailS.getDataRange().getValues();
    for (let i = 1; i < vals.length; i++) {
      if (vals[i][5] === hospital && vals[i][6] === oldWard) {
        emailS.getRange(i + 1, 7).setValue(newWard);
      }
    }
  }

  // 4.4) Update TSO_Log (only rows from this sheet, normalizing names)
  const logS = ss.getSheetByName('TSO_Log');
  if (logS) {
    const logVals = logS.getDataRange().getValues();
    // helper to normalize names: non-alphanumerics → '_', collapse multiples
    const normalize = str =>
      str
        .replace(/[^A-Za-z0-9]/g, '_')
        .replace(/_+/g, '_')
        .replace(/^_|_$/g, '');

    const normSheet = normalize(sheetName);
    for (let i = 1; i < logVals.length; i++) {
      const rowHospital  = logVals[i][3];
      const rowWard      = logVals[i][4];
      const rowSheetName = logVals[i][8];

      if (
        rowHospital === hospital &&
        rowWard     === oldWard &&
        normalize(rowSheetName) === normSheet
      ) {
        logS.getRange(i + 1, 5).setValue(newWard);
      }
    }
  }

  // 5) Confirmation
  ui.alert(
    `Ward name updated from “${oldWard}” to “${newWard}”.\n` +
    `Header updated, and matching entries in EmailHistory and TSO_Log have been changed.`
  );
}


