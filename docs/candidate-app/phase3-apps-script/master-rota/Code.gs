/** Maps the “3 known” hospital labels to full addresses */
function _mapHospitalString(hospitalRaw) {
  const label = String(hospitalRaw || '').trim();
  if (/^worthing$/i.test(label)) {
    return "Worthing Hospital, Lyndhurst Road, Worthing, BN11 2DH";
  }
  if (/^st\s*richards$/i.test(label)) {
    return "St Richards Hospital, Spitalfield Lane, Chichester, PO19 6SE";
  }
  if (/^royal\s+alexandra$/i.test(label)) {
    return "Royal Alexandra Children's Hospital, North Drive, Brighton and Hove, Brighton, BN2 5BE";
  }
  // Otherwise, use as-is (covers “Other”)
  return label;
}

/** Parse ward display to { base, pNum }, stripping only a terminal " P#". */
function _parseWardDisplay(wardDisplay) {
  const wd = String(wardDisplay || '').trim().replace(/\s+/g, ' ');
  const m = wd.match(/^(.*?)(?:\s+P(\d+))?$/i);
  if (!m) return { base: wd, pNum: null };
  const base = String(m[1] || '').trim().replace(/\s+/g, ' ');
  const pNum = m[2] ? parseInt(m[2], 10) : null;
  return { base, pNum };
}

/** Normalise a display string for comparisons: case-insensitive, single spaces. */
function _norm(s) {
  return String(s || '').trim().replace(/\s+/g, ' ').toLowerCase();
}

function _maxPForHospitalWardBase(hospitalString, wardBase) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets();
  const targetHosp = String(hospitalString || '').trim();
  const targetBaseNorm = _norm(wardBase);

  let foundAny = false;
  let maxP = 0;

  for (const sh of sheets) {
    const name = sh.getName();
    if (!/^Patient_\d+_.+_\d{8}$/.test(name)) continue; // only Patient_* sheets

    // Read B1 safely
    const b1 = String(sh.getRange('B1').getDisplayValue() || '').trim();
    if (!b1) continue;
    const parts = b1.split(':');
    if (parts.length < 2) continue;

    const hosp = parts[0].trim();
    const wardDisplay = parts.slice(1).join(':').trim(); // in case ':' appears in hospital text

    if (hosp !== targetHosp) continue;

    const { base, pNum } = _parseWardDisplay(wardDisplay);
    if (_norm(base) !== targetBaseNorm) continue;

    foundAny = true;
    const p = (pNum == null ? 1 : pNum); // no-P counts as P=1
    if (p > maxP) maxP = p;
  }

  return foundAny ? maxP : null;
}


function _formatDDMMYYYY(date, tz) {
  return Utilities.formatDate(date, tz, 'dd/MM/yyyy');
}

/** Format a date to DDMMYYYY (no slashes) */
function _dateStamp(date, tz) {
  return Utilities.formatDate(date, tz, 'ddMMyyyy');
}

/** Build staff layout [{role, gender}, ...] based on counts */
function _buildStaffLayout(payload) {
  const staffLayout = [];
  function pushStaff(role, gender, count) {
    const n = parseInt(count, 10);
    if (!isFinite(n) || n <= 0) return;
    for (let i = 0; i < n; i++) staffLayout.push({ role, gender });
  }
  pushStaff('RMN', 'Male', payload.maleRMNs);
  pushStaff('RMN', 'Female', payload.femaleRMNs);
  pushStaff('HCA', 'Male', payload.maleHCAs);
  pushStaff('HCA', 'Female', payload.femaleHCAs);
  pushStaff('RMN', 'NoGender', payload.rmnNoGender);
  pushStaff('HCA', 'NoGender', payload.hcaNoGender);
  return staffLayout;
}

function createRotaFromPayload(payload) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();

  // Normalised labels
  const hospitalString = _mapHospitalString(payload && payload.hospitalRaw);
  const { base: wardBase } = _parseWardDisplay(String(payload && payload.wardRaw || ''));
  const maxPOrNull = _maxPForHospitalWardBase(hospitalString, wardBase);
  const wardDisplayFinal = (maxPOrNull == null) ? wardBase : `${wardBase} P${maxPOrNull + 1}`;

  // Date stamp from startDate
  const startDateIso = String(payload && payload.startDate || '').trim();
  const startDate = startDateIso ? new Date(startDateIso + 'T00:00:00') : new Date();
  const dateStamp = _dateStamp(startDate, tz);

  // Create sheet with consistent name
  const { sheet, sheetName } = _createRotaSheetWithConsistentName(wardDisplayFinal, dateStamp);

  // Stamp B1
  sheet.getRange("A1").setValue("Hospital and Ward:");
  sheet.getRange("B1").setValue(`${hospitalString}: ${wardDisplayFinal}`);

  // Build full rota grid (headers, dates, REF rows, bands)
  _populateRotaGrid(sheet, payload, tz);

  // Same styling pass as before
  if (typeof applyRotaFormatting === 'function') {
    try { applyRotaFormatting(sheet); } catch (_) {}
  }

  return { sheetName, wardDisplayFinal, hospitalString, created: true };
}

/**
 * Changes both hospital and ward for the active Patient_* rota sheet.
 * Enforces uniqueness of (hospital, wardBase) across all rotas using P1/P2/P3.
 *
 * Expects payload of shape:
 *   { hospitalRaw: string, wardRaw: string }
 *
 * Returns an object summarising changes for the client dialog.
 */

function _createRotaSheetWithConsistentName(wardDisplayFinal, dateStamp) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const wardNameForSheet = wardDisplayFinal.replace(/\s+/g, '_'); // “Bluefin P3” -> “Bluefin_P3”
  let idx = 1, sheetName;
  do {
    sheetName = `Patient_${idx}_${wardNameForSheet}_${dateStamp}`;
    idx++;
  } while (ss.getSheetByName(sheetName));
  const sheet = ss.insertSheet(sheetName);
  return { sheet, sheetName };
}

function _populateRotaGrid(sheet, payload, tz) {
  // 1) Build staff layout
  const staffLayout = _buildStaffLayout(payload); // [{role, gender}, ...]
  const totalStaffCols = staffLayout.length * 2;

  // 2) Write column headers (rows 3–4)
  let colIndex = 3;
  for (let i = 0; i < staffLayout.length; i++) {
    const st = staffLayout[i];
    const colHeader = (st.gender === 'NoGender')
      ? `${st.role} (Male or Female)`
      : `${st.gender} ${st.role}`;

    sheet.getRange(3, colIndex).setValue(colHeader);
    sheet.getRange(3, colIndex + 1).setValue(colHeader);
    sheet.getRange(4, colIndex).setValue("Long Day 0730-2000hrs");
    sheet.getRange(4, colIndex + 1).setValue("Night 1930-0800hrs");
    colIndex += 2;
  }

  // 3) Write dates + REF rows (from row 5)
  const startDateIso = String(payload && payload.startDate || '').trim();
  const start = startDateIso ? new Date(startDateIso + 'T00:00:00') : new Date();
  const totalDays = parseInt(payload && payload.duration, 10) || 0;

  let rowIndex = 5;
  for (let d = 0; d < totalDays; d++) {
    const thisDate = new Date(start);
    thisDate.setDate(thisDate.getDate() + d);
    const dayName = Utilities.formatDate(thisDate, tz, "EEEE");
    const dateStr = _formatDDMMYYYY(thisDate, tz);

    // Day row
    sheet.getRange(rowIndex, 1).setValue(dayName);
    sheet.getRange(rowIndex, 2).setValue(dateStr);

    // REF row
    sheet.getRange(rowIndex + 1, 1).setValue("REF");
    sheet.getRange(rowIndex + 1, 2).setValue("");

    // Initialise staff cells on REF row
    if (totalStaffCols > 0) {
      sheet.getRange(rowIndex + 1, 3, 1, totalStaffCols)
        .clearContent()
        .setBackground("white")
        .setFontColor("black");
    }

    rowIndex += 2;
  }

  // 4) Colour bands (match your legacy look)
  const yellow = "#FFF2CC";
  sheet.getRange("A1:B1").setBackground(yellow); // title band
  // header band (rows 3–4)
  const headerWidth = 2 + (totalStaffCols > 0 ? totalStaffCols : 0);
  sheet.getRange(3, 1, 2, Math.max(2, headerWidth)).setBackground(yellow);
  // date column band (cols A–B over all day rows)
  if (totalDays > 0) {
    sheet.getRange(5, 1, totalDays * 2, 2).setBackground(yellow);
  }
}


