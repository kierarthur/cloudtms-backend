/** Injects a <script>window.__FORM_PROPS__ = {...}</script> before </body>. */
function injectWindowProps(htmlString, obj) {
  const payload = JSON.stringify(obj || {});
  const script  = `<script>window.__FORM_PROPS__ = ${payload};</script>`;
  if (htmlString.includes('</body>')) {
    return htmlString.replace('</body>', `${script}\n</body>`);
  }
  return htmlString + script;
}

