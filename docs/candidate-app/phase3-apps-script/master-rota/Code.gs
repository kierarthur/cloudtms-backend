function _saveTextFileToDrive_(folderId, filename, content) {
  const f = DriveApp.getFolderById(String(folderId));
  // Overwrite if a file with this exact name already exists
  const it = f.getFilesByName(String(filename));
  if (it.hasNext()) {
    const file = it.next();
    file.setContent(String(content || ''));
    // Optional hygiene: delete any additional duplicates
    while (it.hasNext()) {
      try { it.next().setTrashed(true); } catch (_) {}
    }
    return file.getId();
  }
  const file = f.createFile(filename, String(content || ''), MimeType.PLAIN_TEXT);
  return file.getId();
}
