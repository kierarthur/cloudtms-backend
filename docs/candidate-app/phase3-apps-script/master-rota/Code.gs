/** Build live header map from Availability row 1 (col G → end) */
function _buildAvailabilityHeaderMap() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(typeof SH_AVAIL === 'string' ? SH_AVAIL : 'Availability');
  if (!sh) throw new Error('Availability sheet missing');

  const lastCol = sh.getLastColumn();
  if (lastCol < 7) return { ymdToCol: {}, colToYmd: {}, orderedYmds: [] };

  const headers = sh.getRange(1, 7, 1, lastCol - 6).getDisplayValues()[0];
  const ymdToCol = {};
  const colToYmd = {};
  const orderedYmds = [];

  for (let i = 0; i < headers.length; i++) {
    const col = 7 + i;
    const ymd = _parseHeaderToYmd(headers[i]);
    if (!ymd) continue;
    ymdToCol[ymd] = col;
    colToYmd[col] = ymd;
    orderedYmds.push(ymd);
  }
  return { ymdToCol, colToYmd, orderedYmds };
}

/** Parse header like "Wed 13/08/2025" or "13/08/2025" → "yyyy-MM-dd" */
function _parseHeaderToYmd(headerText) {
  const s = String(headerText || '').trim();
  // Extract dd/MM/yyyy wherever it appears
  const m = s.match(/(\d{2})\/(\d{2})\/(\d{4})/);
  if (!m) return '';
  const d = new Date(+m[3], +m[2] - 1, +m[1]);
  if (isNaN(d)) return '';
  const tz = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone();
  return Utilities.formatDate(d, tz, 'yyyy-MM-dd');
}

/** Normalize to UK local: "0XXXXXXXXXX" or "" if not normalizable */
function _normalizeMsisdnLocal(raw) {
  const digits = String(raw || '').replace(/\D/g, '');
  if (!digits) return '';
  if (digits.startsWith('44')  && digits.length === 12) return '0' + digits.slice(2);
  if (digits.startsWith('0044')&& digits.length === 14) return '0' + digits.slice(4);
  if (digits.startsWith('0')   && digits.length === 11) return digits;
  if (digits.length === 10 && digits.startsWith('7'))   return '0' + digits;
  return '';
}

/** On-edit hook for the Availability sheet only: enqueue partial updates */
function partialUpdate_onAvailabilityEdit(e) {
  try {
    const range = e && e.range;
    if (!range) return;
    const sheet = range.getSheet();
    const sheetName = sheet.getName();
    const avName = (typeof SH_AVAIL === 'string' ? SH_AVAIL : 'Availability');
    if (sheetName !== avName) return; // only Availability

    // Header guard: we only care about G..end columns
    const headerMap = _buildAvailabilityHeaderMap();
    if (!headerMap.orderedYmds.length) return;

    // Rows being edited → collect their msisdn (col D)
    const r0 = range.getRow();
    const c0 = range.getColumn();
    const nr = range.getNumRows();
    const nc = range.getNumColumns();

    // Ignore header row edits and A..F edits
    if (r0 <= 1) return;
    const minCol = 7;
    if (c0 + nc - 1 < minCol) return;

    // Build msisdn → Set(ymd)
    const touchedYmds = _collectTouchedYmdsFromEdit(e, headerMap);
    if (!touchedYmds.size) return;

    // For each row in the edit, resolve msisdn and enqueue
    for (let i = 0; i < nr; i++) {
      const rowIdx = r0 + i;
      const msisdn = _collectRowMsisdn(sheet, rowIdx);
      if (!msisdn) continue;
      partialUpdate_enqueue(msisdn, Array.from(touchedYmds), 'Rota.onEdit.Availability');
    }

    // Debounced flush
    partialUpdate_scheduleFlush();
  } catch (err) {
    try { _log('AV-PARTIAL', 'partialUpdate_onAvailabilityEdit error: ' + String(err && err.message || err)); } catch (_) {}
  }
}

/** Enqueue (merge) msisdn + ymds for partial update; stored in ScriptProperties */
function partialUpdate_enqueue(msisdn, ymds, source) {
  const sp  = PropertiesService.getScriptProperties();
  const key = 'AV_PARTIAL_QUEUE';
  const lock = LockService.getScriptLock();
  lock.tryLock(500);

  try {
    const raw = sp.getProperty(key);
    const q = raw ? JSON.parse(raw) : { items: {}, meta: { source: source || '' } };
    if (!q.items) q.items = {};

    const tel = _normalizeMsisdnLocal(msisdn);
    if (!tel) return;

    const set = new Set(q.items[tel] || []);
    (Array.isArray(ymds) ? ymds : []).forEach(y => {
      if (y && /^\d{4}-\d{2}-\d{2}$/.test(String(y))) set.add(String(y));
    });
    q.items[tel] = Array.from(set);
    q.meta.source = source || q.meta.source || '';

    sp.setProperty(key, JSON.stringify(q));
  } finally {
    lock.releaseLock();
  }
}

/** Time-driven flush: send AVAILABILITY_PARTIAL_UPDATED in a single batch */
function partialUpdate_flush() {
  const sp   = PropertiesService.getScriptProperties();
  const key  = 'AV_PARTIAL_QUEUE';
  const tkey = 'AV_PARTIAL_TRIGGER_ID';

  // Clear any scheduled trigger(s) for this handler
  try {
    const tid = sp.getProperty(tkey);
    const triggers = ScriptApp.getProjectTriggers();
    triggers.forEach(tr => {
      if (tr.getHandlerFunction && tr.getHandlerFunction() === 'partialUpdate_flush') {
        ScriptApp.deleteTrigger(tr);
      }
    });
    sp.deleteProperty(tkey);
  } catch (_) {}

  const lock = LockService.getScriptLock();
  lock.tryLock(500);

  try {
    const raw = sp.getProperty(key);
    if (!raw) return;
    sp.deleteProperty(key); // consume

    let q = null;
    try { q = JSON.parse(raw); } catch (_) { q = null; }
    if (!q || !q.items) return;

    const items = Object.keys(q.items).map(msisdn => ({
      msisdn,
      ymds: Array.from(new Set((q.items[msisdn] || []).map(String)))
                .filter(y => /^\d{4}-\d{2}-\d{2}$/.test(y))
    })).filter(x => x.msisdn && x.ymds.length);

    if (!items.length) return;

    const source = (q.meta && q.meta.source) || 'Rota.onEdit.Availability';
    const res = _emitAvailabilityPartialUpdated(items, source);
    _log('AV-PARTIAL', `Flushed ${items.length} candidate(s). HTTP ${res && res.httpCode}`);
  } finally {
    lock.releaseLock();
  }
}

/** Schedule a single debounced flush (default 2s). Multiple calls coalesce. */
function partialUpdate_scheduleFlush(delayMs) {
  const sp   = PropertiesService.getScriptProperties();
  const tkey = 'AV_PARTIAL_TRIGGER_ID';
  const existing = ScriptApp.getProjectTriggers().some(tr => tr.getHandlerFunction && tr.getHandlerFunction() === 'partialUpdate_flush');
  if (existing) return; // already scheduled

  const ms = Number(delayMs || sp.getProperty('AV_PARTIAL_FLUSH_DELAY_MS') || 2000);
  const tr = ScriptApp.newTrigger('partialUpdate_flush').timeBased().after(ms).create();
  sp.setProperty(tkey, tr.getUniqueId ? tr.getUniqueId() : Utilities.getUuid());
}

/** Helper for run IDs */
function _newRunId(prefix) {
  const tag = prefix ? String(prefix) + ':' : '';
  return tag + Utilities.formatDate(new Date(), Session.getScriptTimeZone() || 'Etc/GMT', "yyyyMMdd'T'HHmmssSSS") + ':' + Utilities.getUuid();
}

/** Read & normalize msisdn from the Availability sheet row (column D) */
function _collectRowMsisdn(sheet, rowIndex) {
  try {
    const v = sheet.getRange(rowIndex, 4).getDisplayValue(); // Column D
    return _normalizeMsisdnLocal(v);
  } catch (_) {
    return '';
  }
}

/** Map edited columns → set of touched YMDs using the live header map */
function _collectTouchedYmdsFromEdit(e, headerMap) {
  const set = new Set();
  const range = e && e.range;
  if (!range) return set;
  const c0 = range.getColumn();
  const nc = range.getNumColumns();
  for (let dc = 0; dc < nc; dc++) {
    const col = c0 + dc;
    const ymd = headerMap.colToYmd[col];
    if (ymd) set.add(ymd);
  }
  return set;
}

/**
 * Build compact EH| lines from EmailHistory’s bookingsBySiteWard map.
 *
 * Input shape (from _1readEmailHistoryCompact):
 *   bookingsBySiteWard: {
 *     "Site A|Ward X": {
 *        "2025-09-10|L": ["cid1","cid2"],
 *        "2025-09-10|N": ["cid3"]
 *     },
 *     "Site B|Ward Y": {
 *        "2025-09-11|L": ["cid7"]
 *     }
 *   }
 *
 * Output:
 *   [
 *     "EH|250910|L|site=Site A|ward=Ward X|cids=cid1;cid2",
 *     "EH|250910|N|site=Site A|ward=Ward X|cids=cid3",
 *     "EH|250911|L|site=Site B|ward=Ward Y|cids=cid7"
 *   ]
 *
 * Notes:
 * - Dates are converted to yymmdd using _1fmtYYMMDD(new Date(ymd)).
 * - CID lists are de-duplicated and kept in stable order of first appearance.
 * - If a key has no cids, "cids=?" is emitted.
 * - Lines are sorted by (date asc, shift L before N, site asc, ward asc).
 */


/************************************
 * Global Edit Lock — Core Settings *
 ************************************/

// ScriptProperties keys
var PKEY_EDIT_ENABLED     = 'EDIT_ENABLED';              // "true" | "false"
var PKEY_EDIT_LAST_SET_AT = 'EDIT_LAST_SET_AT';          // ISO string
var PKEY_EDIT_LAST_SET_BY = 'EDIT_LAST_SET_BY';          // email

// We will store IDs of protections we created here (JSON array of {sheetId, protectionId})
var PKEY_EDIT_PROTECTIONS = 'EDIT_LOCK_PROTECTIONS';

// Whitelist (always editable even when Edit = OFF)
var EDIT_WHITELIST_SHEETS = [
  'Logs',
  'Accommodation Info',
  'Old Rotas',
  'Healthroster',
  'Candidate List',
  'New Patient Form'
];

// Optional: restrict who can flip the toggle
var EDIT_TOGGLE_ALLOWED_EMAILS = null; // e.g. ['you@domain.com','ops@domain.com']; or leave null to allow anyone with access


/*******************************
 * Public — Called by the UI   *
 *******************************/

/**
 * Returns current edit lock state and audit info.
 * Used by the wizard to paint the pill.
 */
function getEditState() {
  var props = PropertiesService.getScriptProperties();
  var enabled = props.getProperty(PKEY_EDIT_ENABLED);
  var lastAt  = props.getProperty(PKEY_EDIT_LAST_SET_AT);
  var lastBy  = props.getProperty(PKEY_EDIT_LAST_SET_BY);
  return {
    enabled: String(enabled || 'true') === 'true',
    lastSetAt: lastAt || '',
    lastSetBy: lastBy || ''
  };
}

/**
 * Sets the global edit lock state, applies/removes protections,
 * and records who/when made the change.
 */
function setEditState(enabled) {
  try {
    _assertCanToggle_(); // may throw
    var boolEnabled = !!enabled;
    var props = PropertiesService.getScriptProperties();
    props.setProperty(PKEY_EDIT_ENABLED, String(boolEnabled));

    recordEditStateAudit_(boolEnabled);
    if (boolEnabled) {
      removeEditLockProtections_();
    } else {
      applyEditLockProtections_();
    }
    return getEditState();
  } catch (err) {
    throw new Error('setEditState failed: ' + (err && err.message ? err.message : String(err)));
  }
}


/***********************************
 * Trigger — Entry for all edits   *
 ***********************************/

/**
 * Gatekeeper for user edits.
 * - If sheet is whitelisted -> allow normal flow.
 * - Else if Edit OFF -> simply return (protections block user edits anyway).
 * - Else -> call handleEdit(e) as usual.
 *
 * NOTE: We no longer attempt to revert user changes here.
 *       When Edit = OFF, sheet-level protections enforce the lock.
 */
function onEdit(e) {
  try {
    if (!e || !e.range) return;

    var sh = e.range.getSheet();
    var sheetName = sh.getName();

    // Always let whitelisted sheets run as normal
    if (_isWhitelistedSheet_(sheetName)) {
      if (typeof handleEdit === 'function') handleEdit(e);
      return;
    }

    // When Edit = OFF: protections will block user writes,
    // but we still call handleEdit for side-effects/metrics.
    if (!isEditEnabled_()) {
      if (typeof handleEdit === 'function') {
        e.editLocked = true;         // flag so your handler can skip any writes
        handleEdit(e);
      }
      return;                        // no manual revert; protections handle it
    }

    // Edit = ON: normal flow
    if (typeof handleEdit === 'function') handleEdit(e);

  } catch (err) {
    try {
      if (e && e.source && typeof e.source.toast === 'function') {
        e.source.toast('Edit guard error: ' + (err && err.message ? err.message : String(err)), 'Error', 5);
      }
    } catch (_) {}
  }
}


/*****************************************
 * Helpers — Protections & Revert Logic  *
 *****************************************/

/**
 * Quick boolean check for the lock.
 */
function isEditEnabled_() {
  var enabled = PropertiesService.getScriptProperties().getProperty(PKEY_EDIT_ENABLED);
  // Default to true (editing allowed) if never set
  return String(enabled || 'true') === 'true';
}

/**
 * Apply protections to all non-whitelisted sheets.
 * Scripts (this project) keep edit rights; users are blocked.
 * Idempotent: clears our previous protections before re-applying.
 */
function applyEditLockProtections_() {
  // 0) De-dup: clear protections we previously added so we don't stack multiples
  removeEditLockProtections_();

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var allSheets = ss.getSheets();

  var created = [];
  allSheets.forEach(function(sh) {
    var name = sh.getName();
    if (_isWhitelistedSheet_(name)) return;

    // Add our own protection so we can later remove it cleanly
    var p = sh.protect();
    p.setDescription('Global Edit Lock (auto) — ' + new Date().toISOString());

    // Ensure users are blocked while scripts can still write
    try {
      var editors = p.getEditors();
      if (editors && editors.length) p.removeEditors(editors);
      if (p.canDomainEdit()) p.setDomainEdit(false);
    } catch (_) {}

    // Keep record (even though removal also uses the description heuristic)
    created.push({ sheetId: sh.getSheetId(), protectionId: p.getId && p.getId() });
  });

  // Save what we created so we can remove it later
  var props = PropertiesService.getScriptProperties();
  if (created.length) {
    props.setProperty(PKEY_EDIT_PROTECTIONS, JSON.stringify(created));
  } else {
    props.deleteProperty(PKEY_EDIT_PROTECTIONS);
  }
}

/**
 * Remove only the protections we previously added.
 */
function removeEditLockProtections_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var props = PropertiesService.getScriptProperties();
  var raw = props.getProperty(PKEY_EDIT_PROTECTIONS);
  if (!raw) return;

  try {
    var list = JSON.parse(raw) || [];
    list.forEach(function(rec) {
      try {
        var sheet = _findSheetById_(ss, rec.sheetId);
        if (!sheet) return;
        var protections = sheet.getProtections(SpreadsheetApp.ProtectionType.SHEET) || [];
        protections.forEach(function(p) {
          // We can't compare IDs directly via API; use description heuristic to remove only ours
          var desc = (p.getDescription && p.getDescription()) || '';
          if (desc && desc.indexOf('Global Edit Lock (auto)') !== -1) {
            p.remove();
          }
        });
      } catch (_) {}
    });
  } catch (_) {
    // no-op
  } finally {
    props.deleteProperty(PKEY_EDIT_PROTECTIONS);
  }
}

/**
 * DEPRECATED — no longer used.
 * With protections in place, we do not try to revert the user's change.
 */
function reverseChangeIfLocked_(e) {
  // intentionally left blank
}


/****************************
 * Helpers — Misc utilities *
 ****************************/

/**
 * Write audit trail for the toggle.
 */
function recordEditStateAudit_(enabled) {
  var props = PropertiesService.getScriptProperties();
  props.setProperty(PKEY_EDIT_LAST_SET_AT, new Date().toISOString());

  try {
    var email = Session.getActiveUser().getEmail() || '';
    props.setProperty(PKEY_EDIT_LAST_SET_BY, email);
  } catch (_) {
    props.setProperty(PKEY_EDIT_LAST_SET_BY, '');
  }

  props.setProperty(PKEY_EDIT_ENABLED, String(!!enabled));
}

/**
 * True if the sheet name is in the whitelist.
 */
function _isWhitelistedSheet_(sheetName) {
  var name = String(sheetName || '').trim();
  return EDIT_WHITELIST_SHEETS.indexOf(name) !== -1;
}

/**
 * Find a sheet by its numeric ID.
 */
function _findSheetById_(ss, sheetId) {
  var all = ss.getSheets();
  for (var i = 0; i < all.length; i++) {
    if (all[i].getSheetId && all[i].getSheetId() === sheetId) return all[i];
  }
  return null;
}

/**
 * Optional: enforce who can flip the toggle.
 * Throws if user not allowed.
 */
function _assertCanToggle_() {
  if (!EDIT_TOGGLE_ALLOWED_EMAILS || !EDIT_TOGGLE_ALLOWED_EMAILS.length) return;

  var me = '';
  try { me = Session.getActiveUser().getEmail() || ''; } catch (_) {}
  if (!me) throw new Error('Cannot determine your identity to authorize toggle.');

  var ok = EDIT_TOGGLE_ALLOWED_EMAILS.indexOf(me) !== -1;
  if (!ok) throw new Error('You are not allowed to change the Edit state.');
}


/**********************************************
