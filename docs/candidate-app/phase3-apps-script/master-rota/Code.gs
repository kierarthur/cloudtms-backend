function openEmailTsoDialog(cells) {
  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const ui    = SpreadsheetApp.getUi();
  const sheet = ss.getActiveSheet();
  const tz    = ss.getSpreadsheetTimeZone();

  // Load webhook URL from Script Properties
  const webhookUrl = PropertiesService
    .getScriptProperties()
    .getProperty('TSO_WEBHOOK_MAP');
  if (!webhookUrl) {
    ui.alert(
      'Webhook URL is not configured.\n\n' +
      'Please ask the script owner to set the TSO_WEBHOOK_MAP script property.'
    );
    return;
  }

  // 0) derive hospital & ward
  let [hospital, ward] = ("" + sheet.getRange("B1").getValue())
    .split(":")
    .map(s => s.trim());
  ward = ward || "";

  // load EmailHistory
  const hist    = ss.getSheetByName("EmailHistory");
  const rows    = hist.getDataRange().getValues();
  const headers = rows[0].map(h => String(h).trim().toLowerCase());
  let noteIdx   = headers.indexOf("notes");
  if (noteIdx < 0) {
    // fallback to last column if header lookup failed
    noteIdx = rows[0].length - 1;
  }

  function normDate(d) {
    return d instanceof Date
      ? Utilities.formatDate(d, tz, "dd/MM/yyyy")
      : ("" + d).trim();
  }

  // get today's midnight
  const now    = new Date();
  const today0 = new Date(now.getFullYear(), now.getMonth(), now.getDate());

  // 3) load/create TSO_Log (so we can detect cancellations on blank cells)
  let logS = ss.getSheetByName("TSO_Log");
  if (!logS) {
    logS = ss.insertSheet("TSO_Log").hideSheet();
    logS.appendRow([
      "Timestamp","Date","Shift","Hospital","Ward","Candidate","Notifier","WebhookResp","SheetName","Row","Col"
    ]);
  }
  const rawLogRows = logS.getDataRange().getValues();
  const logRows = rawLogRows.slice(1).map(r => {
    const d = normDate(r[1]);
    return {
      timestamp:  r[0],
      date:       d,
      shiftLabel: r[2],
      hospital:   r[3],
      ward:       r[4],
      // HARDEN: always coerce candidate to string (prevents .toLowerCase errors later)
      candidate:  (r[5] == null ? "" : String(r[5]).trim()),
      sheetName:  r[8],
      rowIndex:   r[9],
      colIndex:   r[10]
    };
  });

  // 1) iterate over each selected cell
  const nonBlankSlots     = [];
  const cancellationSlots = [];

  cells.forEach(c => {
    const sheetName = sheet.getName();
    const rowIndex  = c.row;
    const colIndex  = c.col;
    const candidate = c.name || "";

    // --- extract Role from row 3 of this column ---
    const rawHeader = sheet.getRange(3, colIndex).getValue().toString();
    const match     = rawHeader.match(/\b(RMN|HCA)\b/i);
    const role      = match ? match[1].toUpperCase() : "";

    if (!candidate) {
      // blank cell → check cancellations
      const matches = logRows.filter(r =>
        r.sheetName === sheetName &&
        r.rowIndex  === rowIndex &&
        r.colIndex  === colIndex
      );
      if (matches.length) {
        const last = matches[matches.length - 1];
        if (last.candidate) {
          cancellationSlots.push({
            date:         last.date,
            shiftLabel:   last.shiftLabel,
            hospital:     last.hospital,
            ward:         last.ward,
            role:         role,
            oldCandidate: last.candidate,
            newCandidate: null,
            sheetName,
            rowIndex,
            colIndex,
            timestamp:    Utilities.formatDate(last.timestamp, tz, "dd/MM/yyyy HH:mm") + "hrs"
          });
        }
      }
    } else {
      // build provisional slot
      const date          = normDate(c.date);
      const originalShift = c.shift;
      let shiftLabel      = originalShift;
      const rotaNote      = String(sheet.getRange(rowIndex, colIndex).getNote() || "").trim();
      if (rotaNote) shiftLabel = rotaNote;

      nonBlankSlots.push({
        date,
        shiftLabel,
        rotaNote,
        originalShift,
        hospital,
        ward,
        role,
        candidate,
        sheetName,
        rowIndex,
        colIndex
      });
    }
  });

  // 2) validate non-blank slots against EmailHistory
  const historyErrors = [];
  nonBlankSlots.forEach(slot => {
    // parse slot date
    const [dd,mm,yyyy] = slot.date.split('/');
    const slotDateObj  = new Date(+yyyy, +mm - 1, +dd);

    if (slotDateObj < today0) {
      // Past-shift path: fetch header row-4 shift
      const headerShift = String(sheet.getRange(4, slot.colIndex).getDisplayValue() || "").trim();
      const matches = rows.slice(1).map((r,i) => ({r,i})).filter(({r}) =>
        normDate(r[1]) === slot.date &&
        String(r[5]).trim() === slot.hospital &&
        String(r[6]).trim() === slot.ward
      );
      const histShifts = matches.map(({r}) => String(r[2]).trim());
      const match      = histShifts.includes(headerShift);
      if (matches.length === 0) {
        historyErrors.push(
          `${slot.candidate}: Missing history for ${slot.date} ${headerShift}`
        );
      } else if (!match) {
        const seen = histShifts[0] || '';
        historyErrors.push(
          `${slot.candidate}: Time mismatch for ${slot.date} ${headerShift}: ` +
          `expected "${headerShift}" but history shows "${seen}".`
        );
      }
    } else {
      // Current/Future-shift path (unchanged)
      const matches = rows.slice(1).filter(r =>
        normDate(r[1]) === slot.date &&
        String(r[5]).trim() === slot.hospital &&
        String(r[6]).trim() === slot.ward
      );
      if (matches.length === 0) {
        historyErrors.push(
          `${slot.candidate}: Missing history for ${slot.date} ${slot.shiftLabel}`
        );
      } else {
        const expectIsNote = Boolean(slot.rotaNote);
        const expected     = expectIsNote ? slot.rotaNote : slot.originalShift;
        const timeMatches = matches.filter(r => {
          const histNote  = String(r[noteIdx] || '').trim();
          const histShift = String(r[2]).trim();
          return expectIsNote
            ? (histNote === slot.rotaNote)
            : (!histNote && histShift === slot.originalShift);
        });
        if (timeMatches.length === 0) {
          const first = matches[0];
          const seen  = expectIsNote
            ? String(first[noteIdx] || '').trim()
            : String(first[2]).trim();
          historyErrors.push(
            `${slot.candidate}: Time mismatch for ${slot.date} ${slot.shiftLabel}: ` +
            `expected "${expected}" but history shows "${seen}".`
          );
        } else {
          // HARDEN: coerce both sides to lowercased strings before comparing
          const slotNameLower = String(slot.candidate || '').trim().toLowerCase();
          const candOk = timeMatches.some(r =>
            String(r[0] || '').trim().toLowerCase() === slotNameLower
          );
          if (!candOk) {
            const seenName = String(matches[0][0] || '').trim();
            historyErrors.push(
              `${slot.candidate}: Candidate mismatch for ${slot.date} ${slot.shiftLabel}: ` +
              `rota="${slot.candidate}" but history has "${seenName}".`
            );
          }
        }
      }
    }
  });

  if (historyErrors.length) {
    ui.alert(
      'Cannot prepare TSO email – the following validation errors occurred:\n\n' +
      historyErrors.join("\n"),
      ui.ButtonSet.OK
    );
    return;
  }

  // 4) partition non-blank slots into new / changed / notified
  const changedSlots  = cancellationSlots.slice();
  const notifiedSlots = [];
  const newSlots      = [];

  nonBlankSlots.forEach(slot => {
    const matches = logRows.filter(r =>
      r.sheetName === slot.sheetName &&
      r.rowIndex  === slot.rowIndex &&
      r.colIndex  === slot.colIndex
    );
    if (!matches.length) {
      newSlots.push(slot);
    } else {
      const last = matches[matches.length - 1];
      const ts   = Utilities.formatDate(last.timestamp, tz, "dd/MM/yyyy HH:mm") + "hrs";

      // ── SAFE comparison of candidate/shift (prevents .toLowerCase() on non-strings)
      const toSafeLower  = v => (v == null ? "" : String(v).trim().toLowerCase());
      const toSafeString = v => (v == null ? "" : String(v));

      const lastCandLower = toSafeLower(last.candidate);
      const slotCandLower = toSafeLower(slot.candidate);

      const lastShift = toSafeString(last.shiftLabel);
      const currShift = toSafeString(slot.shiftLabel);

      if (lastCandLower === slotCandLower && lastShift === currShift) {
        notifiedSlots.push(Object.assign({}, slot, { timestamp: ts }));
      } else {
        changedSlots.push(Object.assign({}, slot, {
          oldCandidate:  toSafeString(last.candidate),
          newCandidate:  toSafeString(slot.candidate),
          oldShiftLabel: lastShift,
          newShiftLabel: currShift,
          timestamp:     ts
        }));
      }
    }
  });

  // 5) if nothing to review, open full draft
  if (!newSlots.length && !changedSlots.length && !notifiedSlots.length) {
    const draftTpl = HtmlService.createTemplateFromFile("TSO_EmailDraft");
    draftTpl.entries     = nonBlankSlots.concat(cancellationSlots);
    draftTpl.defaultTo   = PropertiesService.getScriptProperties().getProperty('TSO_EMAIL');
    draftTpl.defaultSubj = "Shifts on Healthroster";
    draftTpl.webhookUrl  = webhookUrl;
    ui.showModalDialog(draftTpl.evaluate().setWidth(700).setHeight(500), "Draft TSO Email");
    return;
  }

  // 6) otherwise show summary
  const tpl = HtmlService.createTemplateFromFile("TSO_Summary");
  tpl.newSlots      = newSlots;
  tpl.changedSlots  = changedSlots;
  tpl.notifiedSlots = notifiedSlots;
  tpl.defaultTo     = PropertiesService.getScriptProperties().getProperty('TSO_EMAIL');
  tpl.defaultSubj   = "Shifts on Healthroster";
  tpl.webhookUrl    = webhookUrl;
  ui.showModalDialog(tpl.evaluate().setWidth(700).setHeight(500), "Review TSO Email");
}




function openTsoDraftAfterSummary(payload) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();

  // Load webhook URL from Script Properties
  const webhookUrl = PropertiesService
    .getScriptProperties()
    .getProperty('TSO_WEBHOOK_MAP');
  if (!webhookUrl) {
    throw new Error('Webhook URL is not configured.');
  }

  // 1) Re-parse if any of the arrays came in as JSON strings
  let newSlots  = payload.newSlots;
  let changed   = payload.changed;
  let reconfirm = payload.reconfirm;
  if (typeof newSlots  === 'string') newSlots  = JSON.parse(newSlots);
  if (typeof changed   === 'string') changed   = JSON.parse(changed);
  if (typeof reconfirm === 'string') reconfirm = JSON.parse(reconfirm);

  // 2) Coerce into arrays
  newSlots  = Array.isArray(newSlots)  ? newSlots  : (newSlots  ? [newSlots]  : []);
  changed   = Array.isArray(changed)   ? changed   : (changed   ? [changed]   : []);
  reconfirm = Array.isArray(reconfirm) ? reconfirm : (reconfirm ? [reconfirm] : []);

  // 3) Dedupe the "changed" array
  const seen = {};
  changed = changed.filter(function(c) {
    const shiftKey = c.oldShiftLabel || c.shiftLabel || "";
    const key = [
      c.date || "",
      shiftKey,
      c.hospital || "",
      c.ward || "",
      c.oldCandidate || ""
    ].join("|");
    if (seen[key]) return false;
    seen[key] = true;
    return true;
  });

  // 4) Unified entries
  const entries = [
    ...newSlots,
    ...changed,
    ...reconfirm
  ];

  // 5) Render the draft dialog
  const tpl = HtmlService.createTemplateFromFile("TSO_EmailDraft");
  tpl.entries     = entries;
  tpl.defaultTo   = payload.to;
  tpl.defaultSubj = payload.subject;
  // no tpl.webhookUrl anymore

  SpreadsheetApp.getUi()
    .showModalDialog(
      tpl.evaluate().setWidth(700).setHeight(500),
      "Draft TSO Email"
    );
}


function finalizeTsoEmail(payload) {
  const ss   = SpreadsheetApp.getActiveSpreadsheet();
  const tz   = ss.getSpreadsheetTimeZone();

  // Load webhook URL from Script Properties
  const webhookUrl = PropertiesService
    .getScriptProperties()
    .getProperty('TSO_WEBHOOK_MAP');
  if (!webhookUrl) return { success: false };

  function fmt(d) {
    return d instanceof Date
      ? Utilities.formatDate(d, tz, "dd/MM/yyyy")
      : ("" + d).split(" ")[0];
  }

  // 1) Parse inputs: include newSlots alongside changed and reconfirm
  let newSlots   = payload.newSlots;
  let changed    = payload.changed;
  let reconfirm  = payload.reconfirm;
  if (typeof newSlots   === 'string') newSlots   = JSON.parse(newSlots);
  if (typeof changed    === 'string') changed    = JSON.parse(changed);
  if (typeof reconfirm  === 'string') reconfirm  = JSON.parse(reconfirm);
  newSlots   = Array.isArray(newSlots)   ? newSlots   : (newSlots   ? [newSlots]   : []);
  changed    = Array.isArray(changed)    ? changed    : (changed    ? [changed]    : []);
  reconfirm  = Array.isArray(reconfirm)  ? reconfirm  : (reconfirm  ? [reconfirm]  : []);

  // combine all slots to log: new bookings first, then changes, then reconfirm
  const slotsToLog = newSlots.concat(changed, reconfirm);

  // 2) Render HTML body from template
  const tpl = HtmlService.createTemplateFromFile("TSO_EmailDraft");
  tpl.entries     = slotsToLog;
  tpl.defaultTo   = payload.to;
  tpl.defaultSubj = payload.subject;
  // tpl.webhookUrl not needed anymore
  let bodyHtml    = tpl.evaluate().getContent();

  // 3) Inject full table formatting on ALL tables
  bodyHtml = bodyHtml.replace(
    /<table(\s*)>/gi,
    `<table$1 border="1" cellpadding="5" cellspacing="0" style="border-collapse:collapse; width:100%;">`
  );

  // 4) Fire the webhook
  let success = false;
  try {
    const resp = UrlFetchApp.fetch(webhookUrl, {
      method:             "post",
      contentType:        "application/json",
      muteHttpExceptions: true,
      payload:            JSON.stringify({
        to:      payload.to,
        subject: payload.subject,
        body:    bodyHtml
      })
    });
    success = resp.getResponseCode() >= 200 && resp.getResponseCode() < 300;
  } catch (e) { /* swallow */ }
  if (!success) return { success: false };

  // 5) Update TSO_Log (remove old entries based solely on sheetName/rowIndex/colIndex, then append new)
  let logS = ss.getSheetByName("TSO_Log");
  if (!logS) {
    logS = ss.insertSheet("TSO_Log").hideSheet();
    logS.appendRow([
      "Timestamp","Date","Shift","Hospital","Ward","Candidate","Notifier","WebhookResp","SheetName","Row","Col"
    ]);
  }
  const allRows = logS.getDataRange().getValues();

  const keep = allRows.slice(1).filter(row => {
    const sheetNm = row[8],
          rIdx    = row[9],
          cIdx    = row[10];
    return !slotsToLog.some(s =>
      sheetNm === s.sheetName &&
      rIdx    === s.rowIndex &&
      cIdx    === s.colIndex
    );
  });

  logS.clearContents();
  logS.appendRow([
    "Timestamp","Date","Shift","Hospital","Ward","Candidate","Notifier","WebhookResp","SheetName","Row","Col"
  ]);
  keep.forEach(r => logS.appendRow(r));

  const me = Session.getActiveUser().getEmail().split("@")[0];
  slotsToLog.forEach(s => {
    logS.appendRow([
      new Date(),
      s.date,
      s.shiftLabel,
      s.hospital,
      s.ward,
      s.newCandidate || s.candidate,
      me,
      "OK",
      s.sheetName,
      s.rowIndex,
      s.colIndex
    ]);
  });

  return { success: true };
}






