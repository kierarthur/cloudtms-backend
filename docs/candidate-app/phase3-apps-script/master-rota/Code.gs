function processCurrentBookingsRequest(phone) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const histSheet = ss.getSheetByName("EmailHistory");
  const historyData = histSheet.getDataRange().getValues();

  let matchedRow = null;
  const candidates = ss.getSheetByName("Candidate List").getDataRange().getValues();
  for (let i = 1; i < candidates.length; i++) {
    const raw = String(candidates[i][3] || "").replace(/\D/g, "");
    const cleaned = raw.startsWith("44") ? raw : "44" + raw.replace(/^0/, "");
    if (cleaned === phone) {
      matchedRow = candidates[i];
      break;
    }
  }

  if (!matchedRow) {
    trySendSessionWA(phone, "Hi, you are not currently approved to work in Sussex. Please contact our office to update your compliance.");
    return;
  }

  const surname = String(matchedRow[0] || "").trim();
  const firstname = String(matchedRow[1] || "").trim();
  const fullKey = `${surname.toLowerCase()} ${firstname.toLowerCase()}`;
  const email = String(matchedRow[2] || "").trim();

  const today = new Date();
  const todayNoTime = new Date(today.getFullYear(), today.getMonth(), today.getDate());

  const confirmedShifts = historyData.filter(row => {
    const rowKey = `${String(row[0] || "").toLowerCase().trim()}`;
    if (rowKey !== fullKey) return false;

    const dateRaw = row[1];
    let shiftDate;

    if (dateRaw instanceof Date) {
      shiftDate = new Date(dateRaw.getFullYear(), dateRaw.getMonth(), dateRaw.getDate());
    } else if (typeof dateRaw === 'string') {
      const [dd, mm, yyyy] = dateRaw.split("/").map(Number);
      shiftDate = new Date(yyyy, mm - 1, dd);
    } else {
      return false;
    }

    return shiftDate >= todayNoTime;
  });

  if (confirmedShifts.length === 0) {
    trySendSessionWA(phone, `Hi ${firstname}, you are not currently booked for any shifts in Sussex.`);
    return;
  }

  // Sort shifts by date
  confirmedShifts.sort((a, b) => {
    const getDate = d => (d[1] instanceof Date)
      ? new Date(d[1].getFullYear(), d[1].getMonth(), d[1].getDate())
      : new Date(...d[1].split("/").reverse().map(Number));
    return getDate(a) - getDate(b);
  });

  const weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

  // —— WATI lines —— only this block changed —— 
  const lines = confirmedShifts.map(s => {
    const dateRaw = s[1];
    const note    = String(s[9] || "").trim();
    let shiftDate = dateRaw instanceof Date
      ? dateRaw
      : (() => { const [dd, mm, yyyy] = dateRaw.split("/").map(Number);
                return new Date(yyyy, mm - 1, dd); })();

    const dayName   = weekdays[shiftDate.getDay()];
    const shortDate = `${dayName} ${shiftDate.getDate()}/${shiftDate.getMonth()+1}`;

    // if there's a note in column J, use it; otherwise fall back
    let shiftDisplay;
    if (note) {
      shiftDisplay = note;
    } else {
      const isNight = String(s[2]||"").toLowerCase().includes("night");
      const times   = isNight ? "1930–0800" : "0730–2000";
      const code    = isNight ? "N" : "LD";
      shiftDisplay = `${code} ${times}`;
    }

    const hospCode = getHospitalCode(s[5]);
    const ward     = s[6] || "";
    const refPart  = s[3] ? `Ref ${s[3]}` : "";

    return `${shortDate} ${shiftDisplay} ${hospCode} ${ward} ${refPart}`;
  });

  const fullMessage = [
    `Hi ${firstname},`,
    ``,
    `Here are your confirmed bookings for Sussex:`,
    ``,
    ...lines,
    ``,
    `Please contact us if anything is incorrect.`,
    ``,
    `An email has been sent to you with full details.`,
    `Sussex Bookings Team`,
    `Arthur Rai Medical Services`
  ].join("\n");

  // —— Email tableRows —— only this block changed ——
  const tableRows = confirmedShifts.map(s => {
    const dateRaw = s[1];
    const note    = String(s[9] || "").trim();
    let shiftDate = dateRaw instanceof Date
      ? dateRaw
      : (() => { const [dd, mm, yyyy] = dateRaw.split("/").map(Number);
                return new Date(yyyy, mm - 1, dd); })();

    const dayName   = Utilities.formatDate(shiftDate, ss.getSpreadsheetTimeZone(), "EEEE");
    const dateStr   = Utilities.formatDate(shiftDate, ss.getSpreadsheetTimeZone(), "dd/MM/yyyy");

    // if there's a note, prefix with Non standard shift – otherwise show original shiftType
    const displayShift = note
      ? `Non standard shift – ${note}`
      : (s[2] || "");

    const jobTitle = s[7] || "";
    const hospital = s[5] || "";
    const ward     = s[6] || "";
    const ref      = s[3] || "";

    return `<tr>
      <td>${dayName}</td>
      <td>${dateStr}</td>
      <td>${displayShift}</td>
      <td>${jobTitle}</td>
      <td>${hospital}</td>
      <td>${ward}</td>
      <td>${ref}</td>
    </tr>`;
  }).join("\n");

  const emailBody = 
    `<p>Hi ${firstname},</p>
     <p>Here are your confirmed bookings for Sussex:</p>
     <table border="1" cellpadding="6" cellspacing="0" style="border-collapse: collapse;">
       <tr>
         <th>Day</th><th>Date</th><th>Shift Type</th><th>Job Title</th>
         <th>Hospital</th><th>Ward</th><th>Ref No.</th>
       </tr>
       ${tableRows}
     </table>
     <p>Please contact us if anything is incorrect.</p>
     <p>PLEASE CONTACT US URGENTLY IF ANY OF THE INFORMATION APPEARS INCORRECT</p>
     <p>Sussex Bookings Team</p>
     <p>Arthur Rai Medical Services</p>`;

  if (email) {
    const subject = "Your Confirmed Bookings – Sussex";
    postToDoPostSendEmail(email, subject, "", { htmlBody: emailBody });

  }

  // send WATI in chunks
  const chunks = [];
  let temp = "";
  for (let line of fullMessage.split("\n")) {
    if ((temp + "\n" + line).length > 1000) {
      chunks.push(temp.trim());
      temp = line;
    } else {
      temp += "\n" + line;
    }
  }
  if (temp.trim()) chunks.push(temp.trim());

  for (let i = 0; i < chunks.length; i++) {
    trySendSessionWA(phone, chunks[i]);
    if (i < chunks.length - 1) Utilities.sleep(5000);
  }
}


// New renamed date parser to avoid conflict with other functions
function parseDateFromEmailHistory(value) {
  if (value instanceof Date && !isNaN(value.valueOf())) {
    return value;
  }
  if (typeof value !== "string") return new Date("Invalid");

  const [d, m, y] = value.split("/").map(Number);
  if (!d || !m || !y) return new Date("Invalid");
  return new Date(y, m - 1, d);
}



