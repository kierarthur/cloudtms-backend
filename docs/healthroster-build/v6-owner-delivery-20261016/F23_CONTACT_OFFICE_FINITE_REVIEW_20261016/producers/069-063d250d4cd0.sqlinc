declare intent public.weekly_message_intents%rowtype;facts jsonb;selected uuid[];pairs jsonb;generation jsonb;original_pairs jsonb;
begin
 select * into strict intent from public.weekly_message_intents where id=p_intent;
 if intent.audience_kind='CANDIDATE' then
  generation:=private.weekly_contact_source_generation_scope_facts_v1(intent.candidate_generation_id,
   (select candidate_id from public.weekly_candidate_outreach_generations where id=intent.candidate_generation_id));
  return jsonb_build_object('version','CONTACT_INTENT_COMPOSITION_SCOPE_FACTS_V1','intent',to_jsonb(intent),'native_facts',generation,
   'pairs',generation->'pairs');
 elsif intent.audience_kind<>'MANAGER' then raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
 if exists(select 1 from public.weekly_contact_source_intent_captures where message_intent_id=intent.id) then
  select array_agg(distinct member.incident_id order by member.incident_id) into selected
   from public.weekly_contact_source_intent_capture_members member where member.message_intent_id=intent.id;
  original_pairs:=private.weekly_contact_source_capture_pairs_v1(intent.id);
 elsif exists(select 1 from public.weekly_message_renders where message_intent_id=intent.id) then
  select array_agg(distinct item.incident_id order by item.incident_id) into selected from public.weekly_message_renders render
   join public.weekly_manager_review_batches batch on batch.message_render_id=render.id
   join public.weekly_manager_review_items item on item.review_batch_id=batch.id where render.message_intent_id=intent.id
    and render.render_sequence=(select max(render_sequence) from public.weekly_message_renders where message_intent_id=intent.id);
 else
  select array_agg(distinct member.incident_id order by member.incident_id) into selected
   from public.weekly_manager_recipient_memberships member where member.recipient_generation_id=intent.recipient_generation_id;
 end if;
 facts:=private.weekly_contact_source_manager_selection_scope_facts_v1(coalesce(selected,'{}'));
 generation:=private.weekly_contact_source_route_scope_facts_v1(intent.recipient_route_id);
 select coalesce(jsonb_agg(jsonb_build_object('candidate_id',candidate_id,'client_id',client_id)order by candidate_id,client_id),'[]') into pairs
  from(select distinct(value->>'candidate_id')::uuid candidate_id,(value->>'client_id')::uuid client_id
   from jsonb_array_elements((facts->'pairs')||(generation->'pairs')||coalesce(original_pairs,'[]')))actual;
 return jsonb_build_object('version','CONTACT_INTENT_COMPOSITION_SCOPE_FACTS_V1','intent',to_jsonb(intent),'native_facts',facts,
  'original_route',generation,'pairs',pairs);
end;