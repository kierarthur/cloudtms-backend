create or replace function private.timesheet_contract_move_accepting_v1(p_operation_id uuid)
returns boolean language sql stable security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
 select exists(select 1 from private.timesheet_contract_move_operations o
  join private.timesheet_contract_move_reviews r on r.operation_id=o.id and r.id=o.accepted_review_id
  where o.id=p_operation_id and o.purpose='CONTRACT_CORRECTION' and o.state='REVIEWED'
   and o.accept_request_id is null and o.receipt_json is null and o.completed_at_utc is null
   and o.accepted_review_digest=r.review_digest and o.to_timesheet_id is not null and o.billing_revision>0
   and o.expected_scope_hash=r.scope_hash and o.before_pay_cut_hash=r.pay_cut_hash and o.before_invoice_hash=r.invoice_hash
   and o.placement_receipt_json->>'version'='CONTRACT_MOVE_PLACEMENT_RECEIPT_V1'
   and o.placement_receipt_json->>'operation_id'=o.id::text
   and o.placement_receipt_json->>'review_id'=r.id::text
   and o.placement_receipt_json->>'current_timesheet_id'=o.to_timesheet_id::text
   and o.unchanged_work_sha256=private.timesheet_contract_move_row_hash_v1(r.manifest_json#>'{physical,members}')
   and (select count(*) from private.timesheet_contract_move_members m where m.operation_id=o.id)
      =jsonb_array_length(r.manifest_json#>'{physical,members}')
   and exists(select 1 from private.timesheet_contract_move_members m where m.operation_id=o.id)
   and not exists(select 1 from private.timesheet_contract_move_members m
    left join public.timesheets old_t on old_t.timesheet_id=m.from_timesheet_id
    left join public.timesheets new_t on new_t.timesheet_id=m.to_timesheet_id
    left join private.timesheet_contract_current_placements p on p.operation_id=m.operation_id and p.member_key=m.member_key
    where m.operation_id=o.id and (old_t.timesheet_id is null or new_t.timesheet_id is null
     or m.member_hash is distinct from private.timesheet_contract_move_row_hash_v1(
      (select value from jsonb_array_elements(r.manifest_json#>'{physical,members}') value where value->>'member_key'=m.member_key))
     or old_t.is_current or old_t.archived_at_utc is null or old_t.archived_reason_code is distinct from 'CONTRACT_MOVE'
     or not new_t.is_current or new_t.archived_at_utc is not null or new_t.contract_id is distinct from o.to_contract_id
     or new_t.version is distinct from m.to_version or m.to_financial_id is null
     or p.current_timesheet_id is distinct from new_t.timesheet_id or p.family_root_id is distinct from m.family_root_id
     or p.placement_receipt_id::text is distinct from o.placement_receipt_json->>'receipt_id'
     or not exists(select 1 from private.timesheet_contract_move_capability_consumptions k
      where k.operation_id=o.id and k.member_key=m.member_key and k.phase='ACCEPT_PLACEMENT'
       and k.backend_pid=pg_backend_pid() and k.transaction_id=pg_current_xact_id_if_assigned()
       and k.billing_revision=o.billing_revision and k.guard_name='public.timesheet_archive_row_guard_v1'
       and k.relation_oid='public.timesheets'::regclass and k.row_operation='UPDATE'
       and k.authority_receipt_id::text=o.placement_receipt_json->>'receipt_id'
       and k.row_sha256=private.timesheet_contract_move_row_hash_v1(to_jsonb(old_t)))))
 )
$function$;
