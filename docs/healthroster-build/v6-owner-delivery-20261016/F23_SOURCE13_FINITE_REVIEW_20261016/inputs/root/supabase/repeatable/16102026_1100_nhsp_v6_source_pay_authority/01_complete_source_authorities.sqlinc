-- Complete reviewed d863 Health functions, native adapters and retained ACL/effects.
-- Banking-owned forward18 and forward19 suffix are explicitly excluded.

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/01_health_metadata_guards.sqlinc
-- Health-owned lifecycle constraints. Mount after all eleven tables and before RPCs.
-- No mutable GUC, browser token, or service-role table grant is an owner capability.
create or replace function private.weekly_source_pay_decision_metadata_guard_v1()
returns trigger language plpgsql security definer
set search_path=pg_catalog,private,public as $function$
declare
 old_row jsonb:=case when TG_OP<>'INSERT' then to_jsonb(OLD) end;
 new_row jsonb:=case when TG_OP<>'DELETE' then to_jsonb(NEW) end;
 mutable_keys text[];
 old_state text;
 new_state text;
begin
 if TG_OP='DELETE' then
  raise exception 'SOURCE_PAY_DECISION_METADATA_RETAINED' using errcode='55000';
 end if;
 if TG_OP='INSERT' then
  if TG_TABLE_NAME='weekly_source_pay_decision_acceptance_applications' then
   if NEW.state<>'PREVALIDATED' or NEW.backend_pid<>pg_backend_pid() or NEW.transaction_id<>pg_current_xact_id() then
    raise exception 'SOURCE_PAY_DECISION_APPLICATION_MUST_BEGIN' using errcode='55000';
   end if;
  elsif TG_TABLE_NAME='weekly_source_pay_decision_unprotect_preparations' then
   if NEW.state<>'RUN_PREPARED' then
    raise exception 'SOURCE_PAY_DECISION_PREPARATION_MUST_BEGIN' using errcode='55000';
   end if;
  end if;
  return NEW;
 end if;
 if new_row=old_row then return NEW; end if;
 old_state:=old_row->>'state';new_state:=new_row->>'state';
 case TG_TABLE_NAME
 when 'weekly_source_pay_decision_requests' then
  mutable_keys:=array['review_id','metadata_state','receipt_json'];
  if not ((OLD.metadata_state='ASSEMBLING' and NEW.metadata_state in('SEALED','CANCELLED','EXPIRED','STALE'))
   or (OLD.metadata_state='CONFIRMED' and NEW.metadata_state='COMMITTED'))
   or (OLD.review_id is not null and NEW.review_id is distinct from OLD.review_id)
   or OLD.receipt_json is not null then
   raise exception 'SOURCE_PAY_DECISION_REQUEST_TRANSITION_INVALID' using errcode='55000';
  end if;
 when 'weekly_source_pay_decision_preview_assemblies' then
  mutable_keys:=array['state','assembly_sha256','review_id'];
  if old_state='ASSEMBLING' and new_state='ASSEMBLING' and not(OLD.draft_scope_json ? 'cut_id')
    and NEW.draft_scope_json ? 'cut_id'
    and OLD.draft_scope_json is not distinct from NEW.draft_scope_json-array['cut_id','cut_no','pay_cut_hash']
    and exists(select 1 from private.bpay_next_source_pay_decision_cut c
      where c.id=(NEW.draft_scope_json->>'cut_id')::uuid and c.decision_id=NEW.decision_id
       and c.preview_assembly_id=NEW.id and c.review_id is null
       and c.cut_no::text=NEW.draft_scope_json->>'cut_no'
       and encode(c.pay_cut_sha256,'hex')=NEW.draft_scope_json->>'pay_cut_hash') then
   mutable_keys:=array['draft_scope_json','draft_scope_sha256'];
  elsif not ((old_state='ASSEMBLING' and new_state in('READY','CANCELLED','EXPIRED','STALE'))
    or (old_state='READY' and new_state in('SEALED','CANCELLED','EXPIRED','STALE')))
    or (OLD.assembly_sha256 is not null and NEW.assembly_sha256 is distinct from OLD.assembly_sha256)
    or (OLD.review_id is not null and NEW.review_id is distinct from OLD.review_id) then
   raise exception 'SOURCE_PAY_DECISION_ASSEMBLY_TRANSITION_INVALID' using errcode='55000';
  end if;
 when 'weekly_source_pay_decision_unprotect_preparations' then
  mutable_keys:=array['source_phase','source_revision','native_source_sha256','source_observation_sha256',
   'placement_certificate_sha256','context_sha256','reviewed_target_sha256','payload_sha256','payload_json',
   'state','native_receipt_json'];
  if not ((old_state='RUN_PREPARED' and new_state in('PREPARED','STALE'))
    or (old_state='PREPARED' and new_state in('CONSUMED','STALE')))
    or (old_state='PREPARED' and old_row-array['state','native_receipt_json']
      is distinct from new_row-array['state','native_receipt_json'])
    or (new_state='STALE' and old_row-'state' is distinct from new_row-'state') then
   raise exception 'SOURCE_PAY_DECISION_PREPARATION_TRANSITION_INVALID' using errcode='55000';
  end if;
 when 'weekly_source_pay_decision_acceptance_applications' then
  mutable_keys:=array['state','application_sha256','completed_at_utc'];
  if OLD.backend_pid<>pg_backend_pid() or OLD.transaction_id<>pg_current_xact_id()
    or not ((old_state='PREVALIDATED' and new_state='STAGED') or (old_state='STAGED' and new_state='COMMITTED')) then
   raise exception 'SOURCE_PAY_DECISION_APPLICATION_TRANSITION_INVALID' using errcode='55000';
  end if;
 when 'weekly_source_pay_decisions' then
  mutable_keys:=array['accept_request_id','accept_request_hash','decision_kind','accepted_selection_sha256',
   'supersedes_decision_id','prior_dispositions_sha256','reason','evidence_refs_json','invoice_before_hash',
   'invoice_after_hash','issue_before_hash','receipt_json','current_financial_cut_id','state_revision'];
  if (OLD.receipt_json is not null and NEW.receipt_json is distinct from OLD.receipt_json)
   or NEW.state_revision<OLD.state_revision or NEW.state_revision>OLD.state_revision+1
   or (NEW.current_financial_cut_id is distinct from OLD.current_financial_cut_id and NEW.state_revision<>OLD.state_revision+1)
   or (OLD.accept_request_id is not null and old_row-array['state_revision','current_financial_cut_id','receipt_json']
       is distinct from new_row-array['state_revision','current_financial_cut_id','receipt_json']) then
   raise exception 'SOURCE_PAY_DECISION_ACCEPTED_TERMS_IMMUTABLE' using errcode='55000';
  end if;
 else
  raise exception 'SOURCE_PAY_DECISION_EVIDENCE_IMMUTABLE' using errcode='55000';
 end case;
 if old_row-mutable_keys is distinct from new_row-mutable_keys then
  raise exception 'SOURCE_PAY_DECISION_IDENTITY_IMMUTABLE' using errcode='55000';
 end if;
 return NEW;
end;
$function$;
revoke all on function private.weekly_source_pay_decision_metadata_guard_v1() from public,anon,authenticated,service_role;

create or replace function private.weekly_source_pay_decision_application_commit_guard_v1()
returns trigger language plpgsql security definer
set search_path=pg_catalog,private,public as $function$
declare app private.weekly_source_pay_decision_acceptance_applications%rowtype;
begin
 select a.* into strict app from private.weekly_source_pay_decision_acceptance_applications a where a.id=NEW.id;
 if app.state<>'COMMITTED' or app.backend_pid<>pg_backend_pid() or app.transaction_id<>pg_current_xact_id()
  or app.application_sha256 is null or app.completed_at_utc is null
  or not exists(select 1 from private.weekly_source_pay_decision_requests r
    where r.request_id=app.request_id and r.decision_id=app.decision_id and r.review_id=app.review_id
      and r.actor_user_id=app.actor_user_id and r.metadata_state='COMMITTED' and r.receipt_json is not null)
  or not exists(select 1 from private.weekly_source_pay_decisions d where d.id=app.decision_id
    and d.current_financial_cut_id=app.cut_id and d.invoice_before_hash=d.invoice_after_hash)
  or not exists(select 1 from private.bpay_next_source_pay_decision_cut c
    join private.weekly_source_pay_decision_reviews r on r.id=c.review_id and r.decision_id=c.decision_id
      and r.preview_assembly_id=c.preview_assembly_id
    join private.weekly_source_pay_decision_preview_assemblies a on a.id=c.preview_assembly_id
      and a.decision_id=c.decision_id and a.review_id=r.id and a.state='SEALED'
    where c.id=app.cut_id and c.decision_id=app.decision_id and c.review_id=app.review_id
      and c.pay_cut_sha256=app.pre_cut_sha256) then
  raise exception 'SOURCE_PAY_DECISION_HALF_APPLICATION' using errcode='23514';
 end if;
 perform private.weekly_source_pay_decision_publication_adoptions_assert_v1(app.id);
 return null;
end;
$function$;
revoke all on function private.weekly_source_pay_decision_application_commit_guard_v1() from public,anon,authenticated,service_role;




create or replace function private.weekly_source_pay_decision_assembly_commit_guard_v1()
returns trigger language plpgsql security definer
set search_path=pg_catalog,private,public as $function$
declare a private.weekly_source_pay_decision_preview_assemblies%rowtype;
begin
 select current_assembly.* into strict a from private.weekly_source_pay_decision_preview_assemblies current_assembly where current_assembly.id=NEW.id;
 if not exists(select 1 from private.bpay_next_source_pay_decision_cut c
  where c.decision_id=a.decision_id and c.preview_assembly_id=a.id
    and c.id::text=a.draft_scope_json->>'cut_id'
    and c.cut_no::text=a.draft_scope_json->>'cut_no'
    and encode(c.pay_cut_sha256,'hex')=a.draft_scope_json->>'pay_cut_hash'
    and ((a.state='SEALED' and c.review_id=a.review_id and exists(
      select 1 from private.weekly_source_pay_decision_reviews r where r.id=c.review_id
       and r.decision_id=c.decision_id and r.preview_assembly_id=a.id and r.pay_cut_hash=c.pay_cut_sha256))
      or (a.state<>'SEALED' and c.review_id is null))) then
  raise exception 'SOURCE_PAY_DECISION_ASSEMBLY_INCOMPLETE' using errcode='23514';
 end if;
 return null;
end;
$function$;
revoke all on function private.weekly_source_pay_decision_assembly_commit_guard_v1()
 from public,anon,authenticated,service_role;


-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/01_health_metadata_guards.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/02_atomic_source_run_birth.sqlinc
-- Requires the real Banking four-argument cut owner. No replacement cut/valuer.
create or replace function public.weekly_source_pay_decision_unprotect_run_prepare_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path=pg_catalog,private,public
set lock_timeout='2500ms' as $function$
declare
 v_confirm jsonb;v_actor uuid;v_decision uuid;v_review_id uuid;v_request_id uuid;v_member text;
 v_review private.weekly_source_pay_decision_reviews%rowtype;
 v_assembly private.weekly_source_pay_decision_preview_assemblies%rowtype;
 v_parent private.weekly_source_pay_decisions%rowtype;
 v_journal private.weekly_source_pay_decision_requests%rowtype;
 v_stub private.weekly_source_pay_decision_unprotect_preparations%rowtype;
 v_quote private.weekly_source_pay_decision_preview_quotes%rowtype;
 v_family public.weekly_exceptional_pay_target_families%rowtype;
 v_active public.weekly_exceptional_pending_reconciliation_targets%rowtype;
 v_approval public.weekly_exceptional_payment_approvals%rowtype;
 v_run public.weekly_exceptional_orchestration_runs%rowtype;
 v_confirm_hash bytea;v_prepare_hash bytea;v_prepared jsonb;v_native_request jsonb;
 v_child text;v_reason text;v_route text;v_count integer;v_kind text;v_keys text[];
begin
 if coalesce(current_setting('request.jwt.claim.role',true),
  nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
 end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,
   array['version','actor_user_id','confirmation_request','member_key'])
  or not(p_request ?& array['version','actor_user_id','confirmation_request','member_key'])
  or p_request->>'version' is distinct from 'SOURCE_UNPROTECT_RUN_PREPARE_V1' then
  raise exception 'SOURCE_UNPROTECT_RUN_PREPARE_INVALID' using errcode='22023';
 end if;
 v_actor:=(p_request->>'actor_user_id')::uuid;
 v_member:=p_request->>'member_key';v_confirm:=p_request->'confirmation_request';
 if v_actor is null or jsonb_typeof(p_request->'member_key')<>'string' or char_length(v_member) not between 1 and 512
   or not private.weekly_source_pay_actor_allowed_v1(v_actor) then
  raise exception 'SOURCE_PAY_DECISION_ACTOR_REQUIRED' using errcode='42501';
 end if;
 v_kind:=v_confirm->>'action';
 if v_kind='ACCEPT' then
  v_keys:=array['version','action','decision_id','request_id','review_id','review_digest','decision',
   'supersedes_decision_id','expected_prior_dispositions','expected_prior_dispositions_sha256','invoice_policy',
   'contact_policy','reason','evidence_refs','expected_pay_cut_hash','expected_source_invoice_hash','expected_issue_set_hash'];
 elsif v_kind='RESUME_FINANCIAL' then
  v_keys:=array['version','action','decision_id','request_id','expected_state_revision','review_id','review_digest',
    'expected_pay_cut_hash','evidence_refs','expected_prior_dispositions','expected_prior_dispositions_sha256'];
 else raise exception 'SOURCE_UNPROTECT_CONFIRMATION_INVALID' using errcode='22023';
 end if;
 if not private.weekly_exceptional_json_keys_exact_v1(v_confirm,v_keys) or not(v_confirm ?& v_keys)
  or v_confirm->>'version' is distinct from 'SOURCE_PAY_DECISION_V1'
  or jsonb_typeof(v_confirm->'evidence_refs')<>'array'
  or jsonb_typeof(v_confirm->'expected_prior_dispositions')<>'array' then
  raise exception 'SOURCE_UNPROTECT_CONFIRMATION_INVALID' using errcode='22023';
 end if;
 v_decision:=(v_confirm->>'decision_id')::uuid;v_review_id:=(v_confirm->>'review_id')::uuid;
 v_request_id:=(v_confirm->>'request_id')::uuid;
 if v_decision is null or v_review_id is null or v_request_id is null then
  raise exception 'SOURCE_UNPROTECT_CONFIRMATION_INVALID' using errcode='22023';
 end if;
 v_confirm_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_CONFIRMATION_V1',v_confirm);
 -- Resolve only. No existing shared metadata row lock precedes native cut gates.
 select d.* into strict v_parent from private.weekly_source_pay_decisions d where d.id=v_decision;
 select r.* into strict v_review from private.weekly_source_pay_decision_reviews r
  where r.id=v_review_id and r.decision_id=v_decision;
 select a.* into strict v_assembly from private.weekly_source_pay_decision_preview_assemblies a
  where a.id=v_review.preview_assembly_id and a.decision_id=v_decision and a.review_id=v_review.id and a.state='SEALED';
 if v_assembly.actor_user_id<>v_actor or v_assembly.decision_kind<>'EXCLUDE_FUTURE_WORK_PAY'
  or v_review.review_digest is distinct from private.weekly_exceptional_hex_sha256_v1(v_confirm->>'review_digest')
  or v_review.pay_cut_hash is distinct from private.weekly_exceptional_hex_sha256_v1(v_confirm->>'expected_pay_cut_hash')
  or v_confirm->'expected_prior_dispositions' is distinct from v_review.private_manifest_json->'prior_dispositions'
  or v_confirm->>'expected_prior_dispositions_sha256' is distinct from v_review.private_manifest_json->>'prior_dispositions_sha256' then
  raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';
 end if;
 if v_kind='ACCEPT' then
  v_reason:=btrim(v_confirm->>'reason');
  if v_confirm->>'decision' is distinct from 'EXCLUDE_FUTURE_WORK_PAY'
   or v_confirm->>'invoice_policy' is distinct from 'KEEP_SOURCE_INVOICE'
   or v_confirm->>'contact_policy' is distinct from 'DO_NOT_QUERY_SELECTED_ISSUES'
   or v_reason is null or char_length(v_reason) not between 1 and 1000
   or v_review.source_invoice_hash is distinct from private.weekly_exceptional_hex_sha256_v1(v_confirm->>'expected_source_invoice_hash')
   or v_review.issue_set_hash is distinct from private.weekly_exceptional_hex_sha256_v1(v_confirm->>'expected_issue_set_hash') then
   raise exception 'SOURCE_UNPROTECT_CONFIRMATION_INVALID' using errcode='22023';
  end if;
  if v_confirm->'supersedes_decision_id' is distinct from v_review.private_manifest_json->'supersedes_decision_id'
   or (v_parent.accept_request_id is not null and v_parent.accept_request_id<>v_request_id) then
   raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';
  end if;
 else
  v_reason:=v_parent.reason;
  if v_parent.accept_request_id is null or v_parent.decision_kind<>'EXCLUDE_FUTURE_WORK_PAY'
    or coalesce(v_confirm->>'expected_state_revision','') !~ '^[1-9][0-9]{0,18}$' then
   raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';
  end if;
 end if;
 -- An already-born run is replayed before comparison with facts changed by an
 -- accepted result. Its immutable body/actor binding still has to match exactly.
 select s.* into v_stub from private.weekly_source_pay_decision_unprotect_preparations s
  where s.decision_id=v_decision and s.member_key=v_member and s.accept_or_resume_request_id=v_request_id;
 if found then
  if v_stub.confirmation_request_sha256<>v_confirm_hash or v_stub.actor_user_id<>v_actor or v_stub.review_id<>v_review_id then
   raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';
  end if;
 else
  -- A retained exact run must remain recoverable after its own acceptance has
  -- advanced state_revision. Only a genuinely new birth compares mutable state.
  if v_kind='RESUME_FINANCIAL' and
    (v_confirm->>'expected_state_revision')::bigint is distinct from v_parent.state_revision then
   raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';
  end if;
  if v_assembly.expires_at_utc<=transaction_timestamp() then
   raise exception 'SOURCE_PAY_DECISION_PREVIEW_EXPIRED' using errcode='P0001';
  end if;
  -- This exact owner revalidates every financial/source/invoice/issue/rate and
  -- native witness and obtains real native gates before any metadata lock.
  perform private.bpay_next_source_pay_decision_cut_v1(v_decision,null,v_review_id,true);
  select a.* into strict v_assembly from private.weekly_source_pay_decision_preview_assemblies a
    where a.id=v_review.preview_assembly_id for update;
  select d.* into strict v_parent from private.weekly_source_pay_decisions d where d.id=v_decision for update;
  if v_kind='RESUME_FINANCIAL' and
    (v_confirm->>'expected_state_revision')::bigint is distinct from v_parent.state_revision then
   raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';
  end if;
  select q.* into strict v_quote from private.weekly_source_pay_decision_preview_quotes q
    where q.assembly_id=v_assembly.id and q.member_key=v_member;
  if v_quote.quote_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_PREVIEW_QUOTE_V1',v_quote.quote_json)
   or v_quote.economic_target_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_ECONOMIC_TARGET_V1',v_quote.quote_json->'economic_target')
   or encode(v_quote.economic_target_sha256,'hex') is distinct from v_quote.quote_json->>'economic_target_sha256' then
   raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';
  end if;
  select f.* into strict v_family from public.weekly_exceptional_pay_target_families f
    where f.id=(v_quote.quote_json#>>'{economic_target,family_id}')::uuid;
  if v_family.ownership_state<>'TARGET_MANAGED' then
   raise exception 'SOURCE_UNPROTECT_MEMBER_INVALID' using errcode='23514';
  end if;
  -- Require actual still-active pending protection. No quote/positive/no-active
  -- member silently becomes a native WITHDRAW instruction.
  select t.* into strict v_active from public.weekly_exceptional_pending_reconciliation_targets t
    where t.family_id=v_family.id and t.durable_work_event_id=(v_quote.quote_json#>>'{economic_target,work_event_id}')::uuid
      and t.state='ACTIVE';
  select a.* into strict v_approval from public.weekly_exceptional_payment_approvals a
    where a.id=v_active.approval_id and a.pay_target_family_id=v_family.id
      and a.work_event_id=v_active.durable_work_event_id and a.candidate_id=v_family.candidate_id
      and a.client_id=v_parent.actual_client_id and a.contract_id=v_family.contract_id
      and a.week_ending=v_family.week_ending_date and a.withdrawn_at_utc is null;
  select r.* into v_journal from private.weekly_source_pay_decision_requests r where r.request_id=v_request_id for update;
  if found then
   if v_journal.decision_id<>v_decision or v_journal.actor_user_id<>v_actor
    or v_journal.request_kind<>v_kind or v_journal.request_hash<>v_confirm_hash
    or v_journal.request_json<>v_confirm or v_journal.review_id<>v_review_id then
    raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';
   end if;
  else
   insert into private.weekly_source_pay_decision_requests(request_id,decision_id,request_kind,request_hash,
    request_json,actor_user_id,review_id,metadata_state)
    values(v_request_id,v_decision,v_kind,v_confirm_hash,v_confirm,v_actor,v_review_id,'CONFIRMED');
  end if;
  -- Another member call can have completed while this call waited on native
  -- gates. Replay its one retained stub; never call native prepare a second time.
  select s.* into v_stub from private.weekly_source_pay_decision_unprotect_preparations s
    where s.decision_id=v_decision and s.member_key=v_member and s.accept_or_resume_request_id=v_request_id;
  if not found then
   v_child:='source-pay-unprotect-v1:'||v_decision::text||':'||encode(extensions.digest(convert_to(v_member,'UTF8'),'sha256'),'hex')||':'||v_request_id::text;
   if exists(select 1 from public.weekly_exceptional_orchestration_runs run where run.idempotency_key=v_child) then
    raise exception 'SOURCE_UNPROTECT_RUN_OWNERSHIP_CONFLICT' using errcode='23514';
   end if;
   v_route:=private.bpay_next_protected_owner_route_v1(v_family.id);
   v_native_request:=jsonb_build_object('schema_version','WEEKLY_PROTECTED_ACTION_PREPARE_V1',
    'actor_user_id',v_actor,'family_id',v_family.id,'source_cycle_id',v_approval.source_cycle_id,
    'work_event_id',v_quote.quote_json#>'{economic_target,work_event_id}','action','WITHDRAW',
    'expected_family_bound_version',v_family.bound_version::text,'protected_schedule',null,
    'reason',v_reason,'idempotency_key',v_child);
   v_prepare_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_PREPARE_ACTION_REQUEST_V1',v_native_request);
   v_prepared:=public.weekly_exceptional_pay_prepare_action_v1(v_native_request);
   select run.* into strict v_run from public.weekly_exceptional_orchestration_runs run
    where run.id=(v_prepared->>'orchestration_run_id')::uuid;
   if v_prepared->>'outcome' is distinct from 'PREPARED' or v_prepared->'ok' is distinct from 'true'::jsonb
    or v_run.family_id<>v_family.id or v_run.request_kind<>'WITHDRAW' or v_run.requested_by_user_id<>v_actor
    or v_run.idempotency_key<>v_child or v_run.request_fingerprint<>v_prepare_hash then
    raise exception 'SOURCE_UNPROTECT_RUN_OWNERSHIP_CONFLICT' using errcode='23514';
   end if;
   v_prepared:=v_prepared||jsonb_build_object('family_bound_version',v_family.bound_version::text);
   insert into private.weekly_source_pay_decision_unprotect_preparations(id,decision_id,member_key,review_id,
    accept_or_resume_request_id,actor_user_id,family_id,orchestration_run_id,child_idempotency_key,route,
    family_bound_version,confirmation_request_sha256,native_prepare_request_json,native_prepare_request_sha256,
    native_prepared_json,native_prepared_sha256,state,expires_at_utc)
   values(gen_random_uuid(),v_decision,v_member,v_review_id,v_request_id,v_actor,v_family.id,v_run.id,v_child,v_route,
    v_family.bound_version,v_confirm_hash,v_native_request,v_prepare_hash,v_prepared,
    private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_PREPARED_ACTION_V1',v_prepared),'RUN_PREPARED',
    transaction_timestamp()+interval '10 minutes') returning * into v_stub;
  end if;
 end if;
 if v_stub.confirmation_request_sha256<>v_confirm_hash or v_stub.actor_user_id<>v_actor or v_stub.review_id<>v_review_id then
  raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';
 end if;
 return jsonb_build_object('version','SOURCE_UNPROTECT_RUN_PREPARED_V1','preparation_id',v_stub.id,
  'decision_id',v_stub.decision_id,'member_key',v_stub.member_key,'review_id',v_stub.review_id,
  'accept_or_resume_request_id',v_stub.accept_or_resume_request_id,'route',v_stub.route,
  'preparation_state',v_stub.state,'expires_at_utc',v_stub.expires_at_utc,'prepared',v_stub.native_prepared_json);
exception when no_data_found or too_many_rows or invalid_text_representation or numeric_value_out_of_range then
 raise exception 'SOURCE_UNPROTECT_RUN_PREPARE_SCOPE_INVALID' using errcode='22023';
end;
$function$;
revoke all on function public.weekly_source_pay_decision_unprotect_run_prepare_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_unprotect_run_prepare_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/02_atomic_source_run_birth.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/03_normal_native_source_gate.sqlinc
-- Health normal-entry adapter; canonical native status remains Banking-owned.
create or replace function private.weekly_source_pay_decision_native_normal_gate_v1(
 p_family_id uuid,p_run_id uuid,p_actor_user_id uuid,p_native_entry text
) returns jsonb language plpgsql stable security definer
set search_path=pg_catalog,private,public as $function$
declare
 v_source jsonb;v_status jsonb;v_detail jsonb;
 v_decision_id uuid;v_request_id uuid;
 v_stub private.weekly_source_pay_decision_unprotect_preparations%rowtype;
begin
 if p_native_entry not in('STATUS','PUBLISH_NEXT','STAGE_LOCAL','COMPLETE_LOCAL') then
  raise exception 'SOURCE_NATIVE_ENTRY_INVALID' using errcode='22023';
 end if;
 v_source:=private.bpay_next_source_decision_native_status_v1(p_family_id,p_run_id,p_actor_user_id);
 select s.* into v_stub from private.weekly_source_pay_decision_unprotect_preparations s
  where s.orchestration_run_id=p_run_id;
 if v_source is null then
  if v_stub.id is not null then
   raise exception 'SOURCE_NATIVE_OWNERSHIP_CONTRADICTION' using errcode='55000';
  end if;
  return null;
 end if;
 if v_stub.id is null and v_source->>'kind'='NATIVE_STATUS' then
  -- A genuine normal receipt adopted from the strict prestate remains owned
  -- by its original normal run. Its canonical reader has just proved reuse.
  select app.decision_id,app.request_id into strict v_decision_id,v_request_id
   from private.weekly_source_pay_decision_native_adoptions adoption
   join private.weekly_source_pay_decision_acceptance_applications app on app.id=adoption.application_id
   where adoption.orchestration_run_id=p_run_id and adoption.origin='ADOPTED_EXISTING' and app.state='COMMITTED';
 elsif v_stub.id is null or v_stub.family_id is distinct from p_family_id
  or v_stub.actor_user_id is distinct from p_actor_user_id then
  raise exception 'SOURCE_NATIVE_OWNERSHIP_CONTRADICTION' using errcode='55000';
 else
  v_decision_id:=v_stub.decision_id;v_request_id:=v_stub.accept_or_resume_request_id;
 end if;
 if v_source->>'kind'='SOURCE_RESULT_REQUIRED' then
  if not private.weekly_exceptional_json_keys_exact_v1(v_source,array['kind','decision_id','request_id','reason'])
   or not(v_source ?& array['kind','decision_id','request_id','reason'])
   or v_source->>'decision_id' is distinct from v_stub.decision_id::text
   or v_source->>'request_id' is distinct from v_stub.accept_or_resume_request_id::text
   or coalesce(v_source->>'reason','') not in('NOT_APPLIED_DEPENDENCY','APPLICATION_INCOMPLETE','NATIVE_RESULT_UNKNOWN') then
   raise exception 'SOURCE_NATIVE_STATUS_INVALID' using errcode='55000';
  end if;
  v_detail:=jsonb_build_object('version','SOURCE_NATIVE_CONTINUATION_V1','decision_id',v_stub.decision_id,
   'request_id',v_stub.accept_or_resume_request_id,'reason',v_source->>'reason');
 elsif v_source->>'kind'='NATIVE_STATUS' then
  v_status:=v_source->'status';
  if not private.weekly_exceptional_json_keys_exact_v1(v_source,array['kind','status'])
   or not(v_source ?& array['kind','status'])
   or not private.weekly_exceptional_json_keys_exact_v1(v_status,array['ok','route','published','receipt'])
   or not(v_status ?& array['ok','route','published','receipt'])
   or v_status->'ok' is distinct from 'true'::jsonb
   or coalesce(v_status->>'route','') not in('NEXT','SOURCE_LOCAL')
   or jsonb_typeof(v_status->'published') is distinct from 'boolean'
   or jsonb_typeof(v_status->'receipt') is distinct from 'object'
   or v_status#>>'{receipt,family_id}' is distinct from p_family_id::text
   or v_status#>>'{receipt,orchestration_run_id}' is distinct from p_run_id::text then
   raise exception 'SOURCE_NATIVE_STATUS_INVALID' using errcode='55000';
  end if;
  if p_native_entry='STATUS' then return v_status;
  elsif p_native_entry='PUBLISH_NEXT' and v_status->>'route'='NEXT' and v_status->'published'='true'::jsonb then
   return v_status->'receipt';
  elsif p_native_entry='COMPLETE_LOCAL' and v_status->>'route'='SOURCE_LOCAL' then
   return v_status#>'{receipt,result}';
  end if;
  -- STAGE never recreates an accepted Source generation. Route mismatch also
  -- returns this original request's deliberate saved-result continuation.
  v_detail:=jsonb_build_object('version','SOURCE_NATIVE_CONTINUATION_V1','decision_id',v_decision_id,
   'request_id',v_request_id,'reason','APPLICATION_INCOMPLETE');
 else raise exception 'SOURCE_NATIVE_STATUS_INVALID' using errcode='55000';
 end if;
 raise exception 'SOURCE_PAY_DECISION_RESULT_REQUIRED' using errcode='P0001',detail=v_detail::text;
exception when no_data_found or too_many_rows then
 raise exception 'SOURCE_NATIVE_OWNERSHIP_CONTRADICTION' using errcode='55000';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_native_normal_gate_v1(uuid,uuid,uuid,text)
 from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/03_normal_native_source_gate.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/04_exact_publication_adoption_bridge.sqlinc
-- The canonical publication/member/cut DDL and its bodies belong to Banking.
-- This is only Health's four-column immutable adoption bridge and full-set proof.
create or replace function private.weekly_source_pay_decision_publication_adoption_guard_v1()
returns trigger language plpgsql security definer
set search_path=pg_catalog,private,public as $function$
declare
 v_app private.weekly_source_pay_decision_acceptance_applications%rowtype;
 v_adopt private.weekly_source_pay_decision_native_adoptions%rowtype;
 v_components jsonb;
begin
 select a.* into strict v_app from private.weekly_source_pay_decision_acceptance_applications a
  where a.id=NEW.application_id and a.state='STAGED' and a.backend_pid=pg_backend_pid() and a.transaction_id=pg_current_xact_id();
 select n.* into strict v_adopt from private.weekly_source_pay_decision_native_adoptions n
  where n.application_id=v_app.id and n.member_key=NEW.member_key and n.decision_id=v_app.decision_id
   and n.review_id=v_app.review_id and n.origin<>'NOT_APPLIED_DEPENDENCY';
 select coalesce(jsonb_agg(jsonb_build_object('cut_id',m.cut_id,'member_no',m.member_no::text,
  'member_sha256',encode(m.member_sha256,'hex')) order by m.member_no),'[]'::jsonb) into v_components
  from private.bpay_next_source_pay_decision_cut_member m where m.cut_id=v_app.cut_id and m.member_key=v_adopt.member_key;
 if jsonb_array_length(v_components)=0 or v_adopt.cut_components_json is distinct from v_components
  or not exists(select 1 from private.bpay_next_source_pay_decision_publication p
   join private.bpay_next_source_pay_decision_publication_member pm on pm.command_id=p.command_id
   join private.bpay_next_source_pay_decision_cut_member cm on cm.cut_id=pm.cut_id and cm.member_no=pm.cut_member_no
   join private.bpay_next_command cmd on cmd.id=p.command_id
   join private.bpay_next_command_member native_member on native_member.command_id=cmd.id and native_member.candidate_id=p.candidate_id
   where p.command_id=NEW.command_id and p.decision_id=v_app.decision_id and p.cut_id=v_app.cut_id
    and p.application_id=v_app.id and pm.member_no=NEW.publication_member_no and pm.cut_id=v_app.cut_id
    and cm.member_key=v_adopt.member_key and cm.candidate_id=p.candidate_id
    and cmd.command_kind='SOURCE_PAY_DECISION_APPLY' and cmd.sealed_at_utc is not null
    and cmd.status in('SEALED','COMPLETE') and cmd.agency_sequence>0) then
  raise exception 'SOURCE_PAY_DECISION_PUBLICATION_ADOPTION_MISMATCH' using errcode='23514';
 end if;
 return NEW;
exception when no_data_found or too_many_rows then
 raise exception 'SOURCE_PAY_DECISION_PUBLICATION_ADOPTION_MISMATCH' using errcode='23514';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_publication_adoption_guard_v1()
 from public,anon,authenticated,service_role;


create or replace function private.weekly_source_pay_decision_publication_adoptions_assert_v1(p_application_id uuid)
returns void language plpgsql stable security definer
set search_path=pg_catalog,private,public as $function$
declare
 v_app private.weekly_source_pay_decision_acceptance_applications%rowtype;
 v_adopt private.weekly_source_pay_decision_native_adoptions%rowtype;
 v_cut_components jsonb;v_published_components jsonb;v_count integer;v_expected integer;
begin
 select a.* into strict v_app from private.weekly_source_pay_decision_acceptance_applications a where a.id=p_application_id;
 for v_adopt in select n.* from private.weekly_source_pay_decision_native_adoptions n
  where n.application_id=v_app.id and n.origin<>'NOT_APPLIED_DEPENDENCY' order by n.member_key loop
  select coalesce(jsonb_agg(jsonb_build_object('cut_id',cm.cut_id,'member_no',cm.member_no::text,
   'member_sha256',encode(cm.member_sha256,'hex')) order by cm.member_no),'[]'::jsonb) into v_cut_components
   from private.bpay_next_source_pay_decision_cut_member cm where cm.cut_id=v_app.cut_id and cm.member_key=v_adopt.member_key;
  select coalesce(jsonb_agg(jsonb_build_object('cut_id',cm.cut_id,'member_no',cm.member_no::text,
   'member_sha256',encode(cm.member_sha256,'hex')) order by cm.member_no),'[]'::jsonb) into v_published_components
   from private.weekly_source_pay_decision_publication_adoptions bridge
   join private.bpay_next_source_pay_decision_publication_member pm on pm.command_id=bridge.command_id and pm.member_no=bridge.publication_member_no
   join private.bpay_next_source_pay_decision_publication p on p.command_id=pm.command_id and p.application_id=bridge.application_id
   join private.bpay_next_source_pay_decision_cut_member cm on cm.cut_id=pm.cut_id and cm.member_no=pm.cut_member_no
   where bridge.application_id=v_app.id and bridge.member_key=v_adopt.member_key and cm.member_key=v_adopt.member_key
    and p.decision_id=v_app.decision_id and p.cut_id=v_app.cut_id and cm.cut_id=v_app.cut_id and cm.candidate_id=p.candidate_id;
  if jsonb_array_length(v_cut_components)=0 or v_adopt.cut_components_json is distinct from v_cut_components
    or v_published_components is distinct from v_cut_components then
   raise exception 'SOURCE_PAY_DECISION_PUBLICATION_ADOPTION_SET_INCOMPLETE' using errcode='23514';
  end if;
 end loop;
 -- Reject extras as well as omissions, including a bridge to a different cut,
 -- Candidate, logical member or dependency rollback masquerading as publication.
 if exists(select 1 from private.weekly_source_pay_decision_publication_adoptions bridge
  join private.weekly_source_pay_decision_native_adoptions n on n.application_id=bridge.application_id and n.member_key=bridge.member_key
  join private.bpay_next_source_pay_decision_publication_member pm on pm.command_id=bridge.command_id and pm.member_no=bridge.publication_member_no
  join private.bpay_next_source_pay_decision_cut_member cm on cm.cut_id=pm.cut_id and cm.member_no=pm.cut_member_no
  where bridge.application_id=v_app.id and (n.origin='NOT_APPLIED_DEPENDENCY' or cm.cut_id<>v_app.cut_id or cm.member_key<>n.member_key)) then
  raise exception 'SOURCE_PAY_DECISION_PUBLICATION_ADOPTION_EXTRA_MEMBER' using errcode='23514';
 end if;
 for v_count,v_expected in select count(pm.*)::integer,p.member_count
   from private.bpay_next_source_pay_decision_publication p
   left join private.bpay_next_source_pay_decision_publication_member pm on pm.command_id=p.command_id
   where p.application_id=v_app.id group by p.command_id,p.member_count loop
  if v_count<>v_expected then raise exception 'SOURCE_PAY_DECISION_PUBLICATION_MANIFEST_INCOMPLETE' using errcode='23514';end if;
 end loop;
end;
$function$;
revoke all on function private.weekly_source_pay_decision_publication_adoptions_assert_v1(uuid)
 from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/04_exact_publication_adoption_bridge.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/05_application_final_receipt.sqlinc
create or replace function private.weekly_source_pay_decision_application_finish_v1(p_application_id uuid)
returns bytea language plpgsql volatile security definer
set search_path=pg_catalog,private,public as $function$
declare
 v_app private.weekly_source_pay_decision_acceptance_applications%rowtype;
 v_request private.weekly_source_pay_decision_requests%rowtype;
 v_decision private.weekly_source_pay_decisions%rowtype;
 v_member jsonb;v_member_row private.weekly_source_pay_decision_members%rowtype;v_review_member jsonb;
 v_issue uuid;v_native jsonb;v_publications jsonb;v_links jsonb;v_contact jsonb;v_hash bytea;
begin
 select a.* into strict v_app from private.weekly_source_pay_decision_acceptance_applications a
  where a.id=p_application_id and a.state='STAGED' and a.backend_pid=pg_backend_pid()
   and a.transaction_id=pg_current_xact_id() for update;
 select r.* into strict v_request from private.weekly_source_pay_decision_requests r
  where r.request_id=v_app.request_id and r.decision_id=v_app.decision_id and r.review_id=v_app.review_id
   and r.actor_user_id=v_app.actor_user_id and r.metadata_state='COMMITTED' and r.receipt_json is not null;
 select d.* into strict v_decision from private.weekly_source_pay_decisions d
  where d.id=v_app.decision_id and d.accept_request_id is not null and d.current_financial_cut_id=v_app.cut_id
   and d.invoice_before_hash=d.invoice_after_hash;
 if v_request.receipt_json->>'version' is distinct from 'SOURCE_PAY_DECISION_RECEIPT_V1'
  or v_request.receipt_json->>'decision_id' is distinct from v_app.decision_id::text
  or v_request.receipt_json->>'request_id' is distinct from v_app.request_id::text
  or v_request.receipt_json->>'review_id' is distinct from v_app.review_id::text
  or jsonb_typeof(v_request.receipt_json->'members') is distinct from 'array'
  or not exists(select 1 from private.bpay_next_source_pay_decision_cut c
    join private.weekly_source_pay_decision_reviews r on r.id=c.review_id and r.decision_id=c.decision_id
     and r.preview_assembly_id=c.preview_assembly_id
    join private.weekly_source_pay_decision_preview_assemblies a on a.id=c.preview_assembly_id
     and a.review_id=r.id and a.decision_id=c.decision_id and a.state='SEALED'
    where c.id=v_app.cut_id and c.decision_id=v_app.decision_id and c.review_id=v_app.review_id
     and r.pay_cut_hash=v_app.pre_cut_sha256) then
  raise exception 'SOURCE_PAY_DECISION_FINAL_RECEIPT_INVALID' using errcode='23514';
 end if;
 perform private.weekly_source_pay_decision_publication_adoptions_assert_v1(v_app.id);
 -- Every logical member of this exact immutable cut appears once. A short or
 -- duplicated public receipt cannot hide an unverified invoice/contact outcome.
 if (select count(*) from jsonb_array_elements(v_request.receipt_json->'members'))
    <> (select count(distinct m.value->>'member_key') from jsonb_array_elements(v_request.receipt_json->'members') m)
  or (select coalesce(jsonb_agg(m.value->>'member_key' order by m.value->>'member_key'),'[]'::jsonb)
       from jsonb_array_elements(v_request.receipt_json->'members') m)
    is distinct from (select coalesce(jsonb_agg(s.member_key order by s.member_key),'[]'::jsonb)
       from (select distinct c.member_key from private.bpay_next_source_pay_decision_cut_member c where c.cut_id=v_app.cut_id) s) then
  raise exception 'SOURCE_PAY_DECISION_FINAL_MEMBER_SET_INVALID' using errcode='23514';
 end if;
 if exists(select 1 from private.bpay_next_source_pay_decision_publication p
  left join private.bpay_next_command c on c.id=p.command_id
  left join private.bpay_next_command_member cm on cm.command_id=c.id and cm.candidate_id=p.candidate_id
  where p.application_id=v_app.id and (p.decision_id<>v_app.decision_id or p.cut_id<>v_app.cut_id
    or c.id is null or cm.command_id is null or c.command_kind<>'SOURCE_PAY_DECISION_APPLY'
    or c.status not in('SEALED','COMPLETE') or c.sealed_at_utc is null)) then
  raise exception 'SOURCE_PAY_DECISION_FINAL_PUBLICATION_INVALID' using errcode='23514';
 end if;
 for v_member in select m.value from jsonb_array_elements(v_request.receipt_json->'members') m loop
  select m.* into strict v_member_row from private.weekly_source_pay_decision_members m
   where m.decision_id=v_app.decision_id and m.member_key=v_member->>'member_key';
  select selected.value into strict v_review_member from private.weekly_source_pay_decision_reviews review,
    lateral jsonb_array_elements(review.private_manifest_json->'selection') selected
   where review.id=v_app.review_id and review.decision_id=v_app.decision_id and selected.value->>'member_key'=v_member_row.member_key;
  -- A fresh RESUME may follow a legitimate original Source invoice lifecycle.
  -- Keep the first accepted member/receipt immutable; this exact request's
  -- fresh reviewed certificate is independently asserted unchanged atomically.
  if v_member->'invoice_certificate' is distinct from v_review_member->'invoice_certificate' then
   raise exception 'SOURCE_PAY_DECISION_FINAL_INVOICE_CERTIFICATE_INVALID' using errcode='23514';
  end if;
  -- The invoice owner reads original immutable allocation/amount/document facts.
  -- All required native locks were acquired by acceptance_begin; no new late
  -- invoice lock is taken while an application metadata row is held.
  perform private.weekly_source_invoice_certificate_assert_v1(v_member->'invoice_certificate',false);
  if jsonb_typeof(v_member->'retired_issue_ids') is distinct from 'array' then
   raise exception 'SOURCE_PAY_DECISION_CONTACT_RECEIPT_INVALID' using errcode='23514';
  end if;
  if (select count(*) from jsonb_array_elements_text(v_member->'retired_issue_ids'))
    <> (select count(distinct i.value) from jsonb_array_elements_text(v_member->'retired_issue_ids') i) then
   raise exception 'SOURCE_PAY_DECISION_CONTACT_RECEIPT_INVALID' using errcode='23514';
  end if;
  for v_issue in select value::text::uuid from jsonb_array_elements_text(v_member->'retired_issue_ids') loop
   if not(v_issue=any(v_member_row.contact_issue_ids)) or not exists(select 1 from public.weekly_discrepancy_incidents i
    where i.id=v_issue and i.candidate_id=v_member_row.candidate_id and i.client_id=v_member_row.actual_client_id
     and i.state='RESOLVED') then
    raise exception 'SOURCE_PAY_DECISION_CONTACT_RECEIPT_INVALID' using errcode='23514';
   end if;
  end loop;
 end loop;
 select coalesce(jsonb_agg(to_jsonb(n) order by n.member_key),'[]'::jsonb) into v_native
  from private.weekly_source_pay_decision_native_adoptions n where n.application_id=v_app.id;
 select coalesce(jsonb_agg(jsonb_build_object('publication',to_jsonb(p),'members',(
   select coalesce(jsonb_agg(to_jsonb(pm) order by pm.member_no),'[]'::jsonb)
    from private.bpay_next_source_pay_decision_publication_member pm where pm.command_id=p.command_id))
   order by p.candidate_id),'[]'::jsonb) into v_publications
  from private.bpay_next_source_pay_decision_publication p where p.application_id=v_app.id;
 select coalesce(jsonb_agg(to_jsonb(b) order by b.command_id,b.publication_member_no,b.member_key),'[]'::jsonb) into v_links
  from private.weekly_source_pay_decision_publication_adoptions b where b.application_id=v_app.id;
 select coalesce(jsonb_agg(to_jsonb(i) order by i.id),'[]'::jsonb) into v_contact
  from public.weekly_discrepancy_incidents i where i.id in(
   select retired.value::uuid from jsonb_array_elements(v_request.receipt_json->'members') m,
    lateral jsonb_array_elements_text(m.value->'retired_issue_ids') retired);
 v_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_ACCEPTANCE_APPLICATION_V1',
  jsonb_build_object('application_id',v_app.id,'decision_id',v_app.decision_id,'review_id',v_app.review_id,
   'cut_id',v_app.cut_id,'request_id',v_app.request_id,'actor_user_id',v_app.actor_user_id,
   'pre_cut_sha256',encode(v_app.pre_cut_sha256,'hex'),'pre_witness_sha256',encode(v_app.pre_witness_sha256,'hex'),
   'pre_witness_manifest',v_app.pre_witness_manifest_json,'native_adoptions',v_native,
   'publications',v_publications,'publication_adoptions',v_links,'selected_contact_outcomes',v_contact,
   'invoice_before_hash',encode(v_decision.invoice_before_hash,'hex'),
   'invoice_after_hash',encode(v_decision.invoice_after_hash,'hex'),'receipt',v_request.receipt_json));
 update private.weekly_source_pay_decision_acceptance_applications a set state='COMMITTED',
  application_sha256=v_hash,completed_at_utc=transaction_timestamp()
  where a.id=v_app.id and a.state='STAGED' and a.request_id=v_request.request_id
   and a.backend_pid=pg_backend_pid() and a.transaction_id=pg_current_xact_id();
 if not found then raise exception 'SOURCE_PAY_DECISION_APPLICATION_CAS_FAILED' using errcode='40001'; end if;
 return v_hash;
exception when no_data_found or too_many_rows then
 raise exception 'SOURCE_PAY_DECISION_FINAL_RECEIPT_INVALID' using errcode='23514';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_application_finish_v1(uuid)
 from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/05_application_final_receipt.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/06_confirmation_run_preparation.sqlinc
-- Bounded Health internal composition for a fresh Worker confirmation. It reads
-- the genuine sealed review; no browser member list, cached preview or new
-- browser route/field is introduced. Per-member run-birth ABI stays unchanged.
create or replace function private.weekly_source_pay_decision_confirmation_context_v1(p_request jsonb,p_version text)
returns jsonb language plpgsql volatile security definer
set search_path=pg_catalog,private,public
set lock_timeout='2500ms' as $function$
declare
 v_actor uuid;v_body jsonb;v_kind text;v_keys text[];v_decision uuid;v_review_id uuid;v_request_id uuid;
 v_parent private.weekly_source_pay_decisions%rowtype;
 v_review private.weekly_source_pay_decision_reviews%rowtype;
 v_assembly private.weekly_source_pay_decision_preview_assemblies%rowtype;
 v_journal private.weekly_source_pay_decision_requests%rowtype;
 v_required jsonb;v_manifest_required jsonb;
 v_detail jsonb;v_hash bytea;v_reason text;v_scope jsonb;
begin
 if coalesce(current_setting('request.jwt.claim.role',true),
  nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
 end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['version','actor_user_id','confirmation_request'])
  or not(p_request ?& array['version','actor_user_id','confirmation_request'])
  or p_version is null or p_version not in('SOURCE_PAY_DECISION_CONFIRMATION_PREPARE_V1','SOURCE_PAY_DECISION_CONFIRMATION_CONTEXT_V1')
  or p_request->>'version' is distinct from p_version then
  raise exception 'SOURCE_PAY_DECISION_CONFIRMATION_INVALID' using errcode='22023';
 end if;
 v_actor:=(p_request->>'actor_user_id')::uuid;v_body:=p_request->'confirmation_request';v_kind:=v_body->>'action';
 if v_actor is null or not private.weekly_source_pay_actor_allowed_v1(v_actor) then
  raise exception 'SOURCE_PAY_DECISION_ACTOR_REQUIRED' using errcode='42501';
 end if;
 if v_kind='ACCEPT' then
  v_reason:=btrim(v_body->>'reason');
  v_keys:=array['version','action','decision_id','request_id','review_id','review_digest','decision','supersedes_decision_id',
   'expected_prior_dispositions','expected_prior_dispositions_sha256','invoice_policy','contact_policy','reason','evidence_refs',
   'expected_pay_cut_hash','expected_source_invoice_hash','expected_issue_set_hash'];
 elsif v_kind='RESUME_FINANCIAL' then
  v_keys:=array['version','action','decision_id','request_id','expected_state_revision','review_id','review_digest',
   'expected_pay_cut_hash','evidence_refs','expected_prior_dispositions','expected_prior_dispositions_sha256'];
 else raise exception 'SOURCE_PAY_DECISION_CONFIRMATION_INVALID' using errcode='22023';
 end if;
 if not private.weekly_exceptional_json_keys_exact_v1(v_body,v_keys) or not(v_body ?& v_keys)
  or v_body->>'version' is distinct from 'SOURCE_PAY_DECISION_V1'
  or jsonb_typeof(v_body->'evidence_refs') is distinct from 'array'
  or jsonb_typeof(v_body->'expected_prior_dispositions') is distinct from 'array' then
  raise exception 'SOURCE_PAY_DECISION_CONFIRMATION_INVALID' using errcode='22023';
 end if;
 v_body:=private.weekly_source_pay_decision_request_v1(v_body,v_kind);
 v_decision:=(v_body->>'decision_id')::uuid;v_review_id:=(v_body->>'review_id')::uuid;v_request_id:=(v_body->>'request_id')::uuid;
 if v_decision is null or v_review_id is null or v_request_id is null then
  raise exception 'SOURCE_PAY_DECISION_CONFIRMATION_INVALID' using errcode='22023';
 end if;
 -- All identity reads are initially lock-free. The canonical cut takes the
 -- complete native Candidate/family/financial gates before shared metadata.
 select d.* into strict v_parent from private.weekly_source_pay_decisions d where d.id=v_decision;
 select r.* into strict v_review from private.weekly_source_pay_decision_reviews r where r.id=v_review_id and r.decision_id=v_decision;
 select a.* into strict v_assembly from private.weekly_source_pay_decision_preview_assemblies a
  where a.id=v_review.preview_assembly_id and a.decision_id=v_decision and a.review_id=v_review.id and a.state='SEALED';
 for v_scope in select value from jsonb_array_elements(v_review.private_manifest_json->'selection') loop
  perform private.weekly_source_pay_decision_scope_access_v1(v_actor,(v_scope->>'source_group_id')::uuid,
   (v_scope->>'actual_client_id')::uuid,(v_scope->>'scope_date')::date);
 end loop;
 if v_assembly.actor_user_id<>v_actor
  or v_review.review_digest is distinct from private.weekly_exceptional_hex_sha256_v1(v_body->>'review_digest')
  or v_review.pay_cut_hash is distinct from private.weekly_exceptional_hex_sha256_v1(v_body->>'expected_pay_cut_hash')
  or v_body->'expected_prior_dispositions' is distinct from v_review.private_manifest_json->'prior_dispositions'
  or v_body->>'expected_prior_dispositions_sha256' is distinct from v_review.private_manifest_json->>'prior_dispositions_sha256' then
  raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';
 end if;
 if v_kind='ACCEPT' then
  if v_body->>'decision' is distinct from v_assembly.decision_kind
   or v_body->>'invoice_policy' is distinct from 'KEEP_SOURCE_INVOICE'
   or v_body->>'contact_policy' is distinct from 'DO_NOT_QUERY_SELECTED_ISSUES'
   or v_body->>'reason' is null or char_length(btrim(v_body->>'reason')) not between 1 and 1000
   or v_body->'supersedes_decision_id' is distinct from v_review.private_manifest_json->'supersedes_decision_id'
   or v_review.source_invoice_hash is distinct from private.weekly_exceptional_hex_sha256_v1(v_body->>'expected_source_invoice_hash')
   or v_review.issue_set_hash is distinct from private.weekly_exceptional_hex_sha256_v1(v_body->>'expected_issue_set_hash')
   or (v_parent.accept_request_id is not null and v_parent.accept_request_id<>v_request_id) then
   raise exception 'SOURCE_PAY_DECISION_CONFIRMATION_INVALID' using errcode='22023';
  end if;
 elsif v_parent.accept_request_id is null or v_parent.decision_kind is distinct from v_assembly.decision_kind then
  raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';
 else
  v_reason:=v_parent.reason;
 end if;
 if v_reason is null or char_length(v_reason) not between 1 and 1000 then
  raise exception 'SOURCE_PAY_DECISION_CONFIRMATION_INVALID' using errcode='22023';end if;
 v_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_CONFIRMATION_V1',v_body);
 select r.* into v_journal from private.weekly_source_pay_decision_requests r where r.request_id=v_request_id;
 if found then
  if v_journal.decision_id<>v_decision or v_journal.actor_user_id<>v_actor or v_journal.request_kind<>v_kind
    or v_journal.request_hash<>v_hash or v_journal.request_json<>v_body or v_journal.review_id<>v_review_id then
   raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';
  end if;
  if v_journal.metadata_state='COMMITTED' then
   v_detail:=jsonb_build_object('version','SOURCE_NATIVE_CONTINUATION_V1','decision_id',v_decision,
    'request_id',v_request_id,'reason','APPLICATION_INCOMPLETE');
   raise exception 'SOURCE_PAY_DECISION_RESULT_REQUIRED' using errcode='P0001',detail=v_detail::text;
  end if;
 end if;
 if v_kind='RESUME_FINANCIAL' and (coalesce(v_body->>'expected_state_revision','') !~ '^[1-9][0-9]{0,18}$'
  or (v_body->>'expected_state_revision')::bigint is distinct from v_parent.state_revision) then
  raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';
 end if;
 if v_assembly.expires_at_utc<=transaction_timestamp() then
  raise exception 'SOURCE_PAY_DECISION_PREVIEW_EXPIRED' using errcode='P0001';
 end if;
 perform private.bpay_next_source_pay_decision_cut_v1(v_decision,null,v_review_id,true);
 -- Rederive after any native wait, before taking metadata row locks.
 if not private.weekly_source_pay_actor_allowed_v1(v_actor) then
  raise exception 'SOURCE_PAY_DECISION_ACTOR_REQUIRED' using errcode='42501';
 end if;
 for v_scope in select value from jsonb_array_elements(v_review.private_manifest_json->'selection') loop
  perform private.weekly_source_pay_decision_scope_access_v1(v_actor,(v_scope->>'source_group_id')::uuid,
   (v_scope->>'actual_client_id')::uuid,(v_scope->>'scope_date')::date);
 end loop;
 select a.* into strict v_assembly from private.weekly_source_pay_decision_preview_assemblies a
  where a.id=v_review.preview_assembly_id and a.review_id=v_review.id and a.state='SEALED' for update;
 select d.* into strict v_parent from private.weekly_source_pay_decisions d where d.id=v_decision for update;
 if v_kind='RESUME_FINANCIAL' and v_reason is distinct from v_parent.reason then
  raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';end if;
 select r.* into v_journal from private.weekly_source_pay_decision_requests r where r.request_id=v_request_id for update;
 if v_journal.request_id is not null then
  if v_journal.decision_id<>v_decision or v_journal.actor_user_id<>v_actor or v_journal.request_kind<>v_kind
   or v_journal.request_hash<>v_hash or v_journal.request_json<>v_body or v_journal.review_id<>v_review_id then
   raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';
  end if;
  if v_journal.metadata_state='COMMITTED' then
   v_detail:=jsonb_build_object('version','SOURCE_NATIVE_CONTINUATION_V1','decision_id',v_decision,
    'request_id',v_request_id,'reason','APPLICATION_INCOMPLETE');
   raise exception 'SOURCE_PAY_DECISION_RESULT_REQUIRED' using errcode='P0001',detail=v_detail::text;
  end if;
 end if;
 if v_kind='RESUME_FINANCIAL' and (v_body->>'expected_state_revision')::bigint is distinct from v_parent.state_revision then
  raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';
 end if;
 select coalesce(jsonb_agg(jsonb_build_object('member_key',q.member_key,
   'family_id',q.quote_json#>'{economic_target,family_id}','work_event_id',q.quote_json#>'{economic_target,work_event_id}')
   order by q.member_key),'[]'::jsonb) into v_required
  from private.weekly_source_pay_decision_preview_quotes q where q.assembly_id=v_assembly.id;
 if jsonb_typeof(v_review.private_manifest_json->'required_quote_members') is distinct from 'array' then
  raise exception 'SOURCE_PAY_DECISION_QUOTE_MANIFEST_INVALID' using errcode='23514';
 end if;
 select coalesce(jsonb_agg(x.value order by x.value->>'member_key'),'[]'::jsonb) into v_manifest_required
  from jsonb_array_elements(v_review.private_manifest_json->'required_quote_members') x;
 if v_required is distinct from v_manifest_required
  or (v_assembly.decision_kind='ACCEPT_FINAL_SOURCE_PAY' and jsonb_array_length(v_required)<>0) then
  raise exception 'SOURCE_PAY_DECISION_QUOTE_MANIFEST_INVALID' using errcode='23514';
 end if;
 return jsonb_build_object('version','SOURCE_PAY_DECISION_CONFIRMATION_CONTEXT_RESULT_V1','decision_id',v_decision,
  'review_id',v_review_id,'request_id',v_request_id,'confirmation_reason',v_reason,'required_members',v_required);
exception when no_data_found or too_many_rows or invalid_text_representation or numeric_value_out_of_range then
 raise exception 'SOURCE_PAY_DECISION_CONFIRMATION_SCOPE_INVALID' using errcode='22023';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_confirmation_context_v1(jsonb,text)
 from public,anon,authenticated,service_role;

-- Bounded same saved-review lookup used only when the actual metadata prepare
-- RPC could not return a batch. It allocates no run, preparation or journal and
-- cannot authorize a financial effect. Every lock ends with this RPC.
create or replace function public.weekly_source_pay_decision_confirmation_context_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public
set lock_timeout='2500ms' as $function$
begin
 return private.weekly_source_pay_decision_confirmation_context_v1(p_request,'SOURCE_PAY_DECISION_CONFIRMATION_CONTEXT_V1');
end;
$function$;
revoke all on function public.weekly_source_pay_decision_confirmation_context_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_confirmation_context_v1(jsonb) to service_role;

create or replace function public.weekly_source_pay_decision_confirmation_prepare_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public
set lock_timeout='2500ms' as $function$
declare v_context jsonb;v_actor uuid;v_body jsonb;v_kind text;v_hash bytea;v_decision uuid;v_review_id uuid;v_request_id uuid;
 v_quote record;v_required jsonb;v_result jsonb;v_results jsonb:='[]'::jsonb;v_reason text;
begin
 v_context:=private.weekly_source_pay_decision_confirmation_context_v1(p_request,'SOURCE_PAY_DECISION_CONFIRMATION_PREPARE_V1');
 v_actor:=(p_request->>'actor_user_id')::uuid;v_body:=p_request->'confirmation_request';v_kind:=v_body->>'action';
 v_decision:=(v_context->>'decision_id')::uuid;v_review_id:=(v_context->>'review_id')::uuid;v_request_id:=(v_context->>'request_id')::uuid;
 v_reason:=v_context->>'confirmation_reason';v_required:=v_context->'required_members';
 v_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_CONFIRMATION_V1',v_body);
 -- The shared context retains all native/metadata locks and proved any exact
 -- existing request. Only actual batch run birth creates CONFIRMED metadata.
 if not exists(select 1 from private.weekly_source_pay_decision_requests r where r.request_id=v_request_id) then
  insert into private.weekly_source_pay_decision_requests(request_id,decision_id,request_kind,request_hash,
   request_json,actor_user_id,review_id,metadata_state)
   values(v_request_id,v_decision,v_kind,v_hash,v_body,v_actor,v_review_id,'CONFIRMED');
 end if;
 for v_quote in select q.value->>'member_key' as member_key,f.candidate_id,f.id as family_id
  from jsonb_array_elements(v_required) q
  join public.weekly_exceptional_pay_target_families f on f.id=(q.value->>'family_id')::uuid
  order by f.candidate_id,f.id,q.value->>'member_key' loop
  v_result:=public.weekly_source_pay_decision_unprotect_run_prepare_v1(jsonb_build_object(
   'version','SOURCE_UNPROTECT_RUN_PREPARE_V1','actor_user_id',v_actor,'confirmation_request',v_body,'member_key',v_quote.member_key));
  if v_result->>'version' is distinct from 'SOURCE_UNPROTECT_RUN_PREPARED_V1'
   or v_result->>'decision_id' is distinct from v_decision::text or v_result->>'review_id' is distinct from v_review_id::text
   or v_result->>'accept_or_resume_request_id' is distinct from v_request_id::text
   or v_result->>'member_key' is distinct from v_quote.member_key
   or v_result#>>'{prepared,family_id}' is distinct from v_quote.family_id::text then
   raise exception 'SOURCE_UNPROTECT_RUN_PREPARED_INVALID' using errcode='23514';
  end if;
  v_results:=v_results||jsonb_build_array(v_result);
 end loop;
 if jsonb_array_length(v_results)<>jsonb_array_length(v_required) then
  raise exception 'SOURCE_PAY_DECISION_QUOTE_MANIFEST_INVALID' using errcode='23514';
 end if;
 return jsonb_build_object('version','SOURCE_PAY_DECISION_CONFIRMATION_PREPARED_V1','decision_id',v_decision,
  'review_id',v_review_id,'request_id',v_request_id,'confirmation_reason',v_reason,'members',v_results);
exception when no_data_found or too_many_rows or invalid_text_representation or numeric_value_out_of_range then
 raise exception 'SOURCE_PAY_DECISION_CONFIRMATION_SCOPE_INVALID' using errcode='22023';
end;
$function$;
revoke all on function public.weekly_source_pay_decision_confirmation_prepare_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_confirmation_prepare_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/06_confirmation_run_preparation.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/07_exact_preparation_application.sqlinc
-- Shared by Health's non-NULL native implementations and actual unprotect
-- dispatcher. It resolves only the UNIQUE original request binding, never a
-- decision-wide/latest application. It neither stages nor values money.
create or replace function private.weekly_source_pay_decision_unprotect_application_v1(p_preparation_id uuid)
returns uuid language plpgsql stable security definer
set search_path=pg_catalog,private,public as $function$
declare
 p private.weekly_source_pay_decision_unprotect_preparations%rowtype;
 a private.weekly_source_pay_decision_acceptance_applications%rowtype;
 r private.weekly_source_pay_decision_requests%rowtype;
 review private.weekly_source_pay_decision_reviews%rowtype;
 assembly private.weekly_source_pay_decision_preview_assemblies%rowtype;
 quote private.weekly_source_pay_decision_preview_quotes%rowtype;
 run public.weekly_exceptional_orchestration_runs%rowtype;
begin
 select s.* into strict p from private.weekly_source_pay_decision_unprotect_preparations s where s.id=p_preparation_id;
 select app.* into strict a from private.weekly_source_pay_decision_acceptance_applications app
  where app.request_id=p.accept_or_resume_request_id;
 select request.* into strict r from private.weekly_source_pay_decision_requests request where request.request_id=a.request_id;
 select saved.* into strict review from private.weekly_source_pay_decision_reviews saved where saved.id=a.review_id;
 select saved.* into strict assembly from private.weekly_source_pay_decision_preview_assemblies saved where saved.id=review.preview_assembly_id;
 select saved.* into strict quote from private.weekly_source_pay_decision_preview_quotes saved
  where saved.assembly_id=assembly.id and saved.member_key=p.member_key;
 select native_run.* into strict run from public.weekly_exceptional_orchestration_runs native_run where native_run.id=p.orchestration_run_id;
 if p.state<>'PREPARED' or p.expires_at_utc<=transaction_timestamp()
  or a.state<>'PREVALIDATED' or a.backend_pid<>pg_backend_pid() or a.transaction_id<>pg_current_xact_id()
  or a.decision_id<>p.decision_id or a.review_id<>p.review_id or a.actor_user_id<>p.actor_user_id
  or r.decision_id is distinct from a.decision_id or r.review_id is distinct from a.review_id or r.actor_user_id is distinct from a.actor_user_id
  or r.metadata_state<>'CONFIRMED' or r.receipt_json is not null
  or r.request_kind not in('ACCEPT','RESUME_FINANCIAL')
  or r.request_hash<>p.confirmation_request_sha256
  or r.request_hash is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_CONFIRMATION_V1',r.request_json)
  or review.decision_id<>a.decision_id or review.pay_cut_hash<>a.pre_cut_sha256
  or assembly.decision_id is distinct from a.decision_id or assembly.review_id is distinct from review.id or assembly.state<>'SEALED'
  or assembly.actor_user_id<>a.actor_user_id or assembly.decision_kind<>'EXCLUDE_FUTURE_WORK_PAY'
  or quote.economic_target_sha256 is distinct from p.reviewed_target_sha256
  or p.payload_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_NATIVE_PAYLOAD_V1',p.payload_json)
  or p.native_prepare_request_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_PREPARE_ACTION_REQUEST_V1',p.native_prepare_request_json)
  or p.native_prepared_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_PREPARED_ACTION_V1',p.native_prepared_json)
  or p.native_prepare_request_json is distinct from p.payload_json->'prepare_request'
  or p.payload_json->>'route' is distinct from p.route
  or run.family_id<>p.family_id or run.requested_by_user_id<>p.actor_user_id or run.request_kind<>'WITHDRAW'
  or run.idempotency_key<>p.child_idempotency_key or run.request_fingerprint<>p.native_prepare_request_sha256
  or run.state<>'RUNNING' or not private.weekly_source_pay_actor_allowed_v1(p.actor_user_id)
  or not exists(select 1 from private.bpay_next_source_pay_decision_cut cut where cut.id=a.cut_id
    and cut.decision_id=a.decision_id and cut.review_id=a.review_id and cut.preview_assembly_id=assembly.id
    and cut.pay_cut_sha256=a.pre_cut_sha256) then
  raise exception 'SOURCE_UNPROTECT_APPLICATION_MISMATCH' using errcode='23514';
 end if;
 return a.id;
exception when no_data_found or too_many_rows then
 raise exception 'SOURCE_UNPROTECT_APPLICATION_MISMATCH' using errcode='23514';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_unprotect_application_v1(uuid)
 from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/07_exact_preparation_application.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/08_protected_current_placement.sqlinc
-- Genuine current physical/evidence/Work certificate. No financial write or
-- arbitrary archive flag. Requires the physical H103 and original Source
-- invoice certificate owners plus Banking's actual move publication schema.
create or replace function private.weekly_source_protected_current_placement_v1(
 p_family_id uuid,p_work_event_id uuid,p_lock boolean
) returns jsonb language plpgsql volatile security definer
set search_path=pg_catalog,private,public as $function$
declare
 family public.weekly_exceptional_pay_target_families%rowtype;
 original public.timesheets%rowtype;current_ts public.timesheets%rowtype;
 original_contract public.contracts%rowtype;current_contract public.contracts%rowtype;
 event public.weekly_work_events%rowtype;financial public.timesheets_financials%rowtype;
 alias private.timesheet_contract_family_aliases%rowtype;
 placement private.timesheet_contract_current_placements%rowtype;
 operation private.timesheet_contract_move_operations%rowtype;
 archive_operation private.timesheet_contract_move_operations%rowtype;
 member private.timesheet_contract_move_members%rowtype;
 bank_member private.bpay_next_move_publication_member%rowtype;
 original_work private.bpay_next_work%rowtype;current_work private.bpay_next_work%rowtype;
 revision private.bpay_next_work_revision%rowtype;
 physical jsonb;evidence jsonb;saved_invoice jsonb;current_invoice jsonb;result jsonb;
 evidence_hash bytea;member_key text;original_work_id uuid;current_work_id uuid;operation_id uuid;
 invoice_ts uuid[];source_rows uuid[];moved boolean;scope_root uuid;count_rows integer;
begin
 if p_family_id is null or p_work_event_id is null or p_lock is null then
  raise exception 'PROTECTED_CURRENT_PLACEMENT_UNBOUND' using errcode='22023';
 end if;
 select f.* into strict family from public.weekly_exceptional_pay_target_families f where f.id=p_family_id;
 select t.* into strict original from public.timesheets t where t.timesheet_id=family.root_timesheet_id;
 select c.* into strict original_contract from public.contracts c where c.id=family.contract_id;
 select e.* into strict event from public.weekly_work_events e where e.id=p_work_event_id;
 if original.contract_id is distinct from family.contract_id
  or original.booking_id is distinct from family.root_family_booking_id
  or original.week_ending_date is distinct from family.week_ending_date
  or original_contract.candidate_id is distinct from family.candidate_id
  or event.candidate_id is distinct from family.candidate_id or event.client_id is distinct from original_contract.client_id
  or event.work_date not between family.week_start_date and family.week_ending_date then
  raise exception 'PROTECTED_CURRENT_PLACEMENT_UNBOUND' using errcode='55000';
 end if;
 -- Resolve the certified flat physical identity, never max(version), a booking
 -- suffix, a caller-selected B, or recursive traversal of previous moves.
 if p_lock then physical:=private.timesheet_contract_move_family_lock_v1(original.timesheet_id);
 else physical:=private.timesheet_contract_current_placement_v1(original.timesheet_id);end if;
 if not private.weekly_exceptional_json_keys_exact_v1(physical,array['version','requested_timesheet_id','family_root_id',
   'current_timesheet_id','current_contract_id','placement_revision','placement_receipt_id','legacy_origin'])
  or not(physical ?& array['version','requested_timesheet_id','family_root_id','current_timesheet_id',
   'current_contract_id','placement_revision','placement_receipt_id','legacy_origin'])
  or physical->>'version' is distinct from 'CURRENT_CONTRACT_PLACEMENT_V1'
  or physical->>'requested_timesheet_id' is distinct from original.timesheet_id::text then
  raise exception 'PROTECTED_CURRENT_PLACEMENT_UNBOUND' using errcode='55000';
 end if;
 scope_root:=(physical->>'family_root_id')::uuid;
 moved:=physical->'legacy_origin'='false'::jsonb;
 if physical->'legacy_origin' not in('true'::jsonb,'false'::jsonb) then
  raise exception 'PROTECTED_CURRENT_PLACEMENT_UNBOUND' using errcode='55000';end if;
 select t.* into strict current_ts from public.timesheets t where t.timesheet_id=(physical->>'current_timesheet_id')::uuid;
 select c.* into strict current_contract from public.contracts c where c.id=current_ts.contract_id;
 if current_ts.contract_id is distinct from (physical->>'current_contract_id')::uuid
  or not current_ts.is_current or current_ts.archived_at_utc is not null or current_ts.revoked_at is not null
  or current_ts.week_ending_date is distinct from family.week_ending_date
  or current_contract.candidate_id is distinct from family.candidate_id or current_contract.client_id is distinct from event.client_id
  or (current_contract.start_date is not null and event.work_date<current_contract.start_date)
  or (current_contract.end_date is not null and event.work_date>current_contract.end_date) then
  raise exception 'PROTECTED_CURRENT_PLACEMENT_UNBOUND' using errcode='55000';end if;
 evidence:=private.timesheet_contract_move_evidence_v1(original.timesheet_id);
 if evidence is null then raise exception 'PROTECTED_CURRENT_PLACEMENT_EVIDENCE_UNBOUND' using errcode='55000';end if;
 evidence_hash:=private.timesheet_contract_move_row_hash_v1(evidence);
 if moved then
  -- Existing moved protection must retain its exact genuine event association.
  -- An unmoved first native APPROVE has no approval/family-event row yet and
  -- retains the original native event/actor authority at its wrapper.
  if not(exists(select 1 from public.weekly_exceptional_payment_approvals a
    where a.pay_target_family_id=family.id and a.work_event_id=event.id
     and a.candidate_id=family.candidate_id and a.client_id=event.client_id and a.contract_id=family.contract_id)
   or exists(select 1 from public.weekly_exceptional_pay_family_events e
    where e.family_id=family.id and e.durable_work_event_id=event.id)) then
   raise exception 'PROTECTED_CURRENT_PLACEMENT_EVIDENCE_UNBOUND' using errcode='55000';end if;
  select a.* into strict alias from private.timesheet_contract_family_aliases a where a.timesheet_id=original.timesheet_id;
  select p.* into strict placement from private.timesheet_contract_current_placements p
   where p.family_root_id=alias.family_root_id and p.member_key=alias.member_key;
  select o.* into strict operation from private.timesheet_contract_move_operations o where o.id=placement.operation_id;
  select o.* into strict archive_operation from private.timesheet_contract_move_operations o where o.id=alias.accepted_operation_id;
  select m.* into strict member from private.timesheet_contract_move_members m
   where m.operation_id=operation.id and m.member_key=alias.member_key;
  if alias.original_timesheet_id is distinct from original.timesheet_id
   or alias.family_root_id is distinct from scope_root or alias.member_role is distinct from member.role
   or placement.current_timesheet_id is distinct from current_ts.timesheet_id
   or placement.candidate_id is distinct from family.candidate_id or placement.actual_client_id is distinct from event.client_id
   or placement.placement_revision::text is distinct from physical->>'placement_revision'
   or placement.placement_receipt_id::text is distinct from physical->>'placement_receipt_id'
   or operation.state<>'COMPLETE' or operation.purpose<>'CONTRACT_CORRECTION'
   or operation.candidate_id is distinct from family.candidate_id or operation.actual_client_id is distinct from event.client_id
   or operation.family_root_id is distinct from scope_root or operation.accepted_review_id is null
   or operation.placement_receipt_json->>'version' is distinct from 'CONTRACT_MOVE_PLACEMENT_RECEIPT_V1'
   or operation.placement_receipt_json->>'receipt_id' is distinct from placement.placement_receipt_id::text
   or operation.placement_receipt_json->>'operation_id' is distinct from operation.id::text
   or member.to_timesheet_id is distinct from current_ts.timesheet_id or member.to_version is distinct from current_ts.version
   or member.to_contract_id is distinct from current_ts.contract_id
   or member.immutable_evidence_hash is distinct from evidence_hash
   or member.approval_evidence_hash is distinct from private.timesheet_contract_move_row_hash_v1(evidence->'workflows')
   or archive_operation.state not in('COMPLETE','SUPERSEDED') or archive_operation.purpose<>'CONTRACT_CORRECTION'
   or original.archived_at_utc is null or original.archived_reason_code is distinct from 'CONTRACT_MOVE'
   or original.archived_by_user_id is distinct from archive_operation.created_by_user_id
   or not exists(select 1 from private.timesheet_contract_move_members m where m.operation_id=archive_operation.id
      and m.member_key=alias.member_key and m.from_timesheet_id=original.timesheet_id and m.family_root_id=scope_root)
   or not exists(select 1 from private.timesheet_contract_move_capability_consumptions c
      where c.operation_id=archive_operation.id and c.member_key=alias.member_key and c.phase='ACCEPT_PLACEMENT'
       and c.guard_name='public.timesheet_archive_row_guard_v1' and c.relation_oid='public.timesheets'::regclass::oid
       and c.row_operation='UPDATE' and c.authority_receipt_id=(archive_operation.placement_receipt_json->>'receipt_id')::uuid
       and c.row_sha256=private.timesheet_contract_move_row_hash_v1(to_jsonb(original))) then
   raise exception 'PROTECTED_CURRENT_PLACEMENT_EVIDENCE_UNBOUND' using errcode='55000';end if;
  select count(*) into count_rows from jsonb_array_elements(operation.placement_receipt_json->'members') m
   where m.value->>'member_key'=alias.member_key and m.value->>'original_timesheet_id'=original.timesheet_id::text
    and m.value->>'to_timesheet_id'=current_ts.timesheet_id::text
    and m.value->>'to_version'=current_ts.version::text and m.value->>'immutable_evidence_hash'=encode(evidence_hash,'hex');
  if count_rows<>1 then raise exception 'PROTECTED_CURRENT_PLACEMENT_EVIDENCE_UNBOUND' using errcode='55000';end if;
  member_key:=alias.member_key;operation_id:=operation.id;
  -- Saved original invoice identity proves the move's Source preservation. It
  -- is not operation.before_invoice_hash (which may seal MIXED billing).
  saved_invoice:=private.invoice_contract_move_source_certificate_v1(operation.id,false);
  if saved_invoice is null or not private.weekly_exceptional_json_keys_exact_v1(saved_invoice,array['phase','hash','source_row_ids',
    'accepted_final_member_ids','original_invoice_timesheet_ids','invoice_ids','net','vat','gross'])
   or not(saved_invoice ?& array['phase','hash','source_row_ids','accepted_final_member_ids','original_invoice_timesheet_ids','invoice_ids','net','vat','gross'])
   or coalesce(saved_invoice->>'hash','')!~'^[0-9a-f]{64}$'
   or jsonb_typeof(saved_invoice->'original_invoice_timesheet_ids') is distinct from 'array'
   or jsonb_typeof(saved_invoice->'source_row_ids') is distinct from 'array' then
   raise exception 'PROTECTED_CURRENT_PLACEMENT_INVOICE_UNBOUND' using errcode='55000';end if;
  select coalesce(array_agg(x::uuid order by x),'{}'::uuid[]) into invoice_ts
   from jsonb_array_elements_text(saved_invoice->'original_invoice_timesheet_ids') x;
  select coalesce(array_agg(x::uuid order by x),'{}'::uuid[]) into source_rows
   from jsonb_array_elements_text(saved_invoice->'source_row_ids') x;
  if not(original.timesheet_id=any(invoice_ts)) then
   raise exception 'PROTECTED_CURRENT_PLACEMENT_INVOICE_UNBOUND' using errcode='55000';end if;
  -- Exact canonical/current Work binding comes from this actual accepted move
  -- publication member. Absent producer evidence is not certified absent Work.
  select m.* into strict bank_member from private.bpay_next_move_publication_member m
   join private.bpay_next_move_publication p on p.command_id=m.command_id and p.operation_id=m.operation_id and p.cut_id=m.cut_id
   join private.bpay_next_command command on command.id=p.command_id and command.status in('SEALED','COMPLETE')
   join private.bpay_next_command_member cm on cm.command_id=command.id and cm.candidate_id=family.candidate_id
   where m.operation_id=operation.id and m.cut_id=operation.current_financial_cut_id
    and m.physical_member_key=member_key and m.family_root_id=scope_root and p.candidate_id=family.candidate_id;
  original_work_id:=bank_member.canonical_work_id;
  if bank_member.to_revision_id is not null and not exists(select 1 from private.bpay_next_work_revision r
    where r.id=bank_member.to_revision_id and r.work_id=bank_member.to_work_id
     and r.physical_timesheet_id=member.to_timesheet_id and r.physical_timesheet_version=member.to_version and r.sealed_at_utc is not null) then
   raise exception 'PROTECTED_CURRENT_PLACEMENT_WORK_UNBOUND' using errcode='55000';end if;
  if bank_member.to_revision_id is null and bank_member.member_kind<>'PENDING_FACTUAL' then
   raise exception 'PROTECTED_CURRENT_PLACEMENT_WORK_UNBOUND' using errcode='55000';end if;
  -- A later genuine approval/revision at this exact accepted B is current
  -- authority. The move's immutable original revision is retained above; it
  -- does not freeze every future current revision to its acceptance value.
  select w.* into current_work from private.bpay_next_work w where w.original_timesheet_id=current_ts.timesheet_id;
  if bank_member.to_work_id is not null and current_work.id is distinct from bank_member.to_work_id then
   raise exception 'PROTECTED_CURRENT_PLACEMENT_WORK_UNBOUND' using errcode='55000';end if;
  if current_work.approval_state='APPROVED' then current_work_id:=current_work.id;end if;
 else
  if original.timesheet_id is distinct from current_ts.timesheet_id or original.contract_id is distinct from current_ts.contract_id
   or original.archived_at_utc is not null or not original.is_current
   or physical->>'placement_revision' is distinct from '0' or physical->'placement_receipt_id' is distinct from 'null'::jsonb then
   raise exception 'PROTECTED_CURRENT_PLACEMENT_UNBOUND' using errcode='55000';end if;
  member_key:=original.timesheet_id::text;invoice_ts:=array[original.timesheet_id];
  select coalesce(array_agg(distinct r.upload_row_id order by r.upload_row_id),'{}'::uuid[]) into source_rows
   from public.weekly_source_row_timesheet_lineages l join public.weekly_source_row_resolutions r on r.id=l.row_resolution_id
   where (l.timesheet_id=original.timesheet_id or l.family_booking_id=family.root_family_booking_id)
    and l.candidate_id=family.candidate_id and l.client_id=event.client_id and l.contract_id=family.contract_id
    and l.week_ending_date=family.week_ending_date;
  select w.* into original_work from private.bpay_next_work w where w.original_timesheet_id=original.timesheet_id;
  original_work_id:=original_work.id;
  if original_work.approval_state='APPROVED' then current_work_id:=original_work.id;end if;
  if exists(select 1 from private.bpay_next_work w where w.booking_id=original.booking_id
     and w.original_timesheet_id<>original.timesheet_id) then
   raise exception 'PROTECTED_CURRENT_PLACEMENT_WORK_UNBOUND' using errcode='55000';end if;
 end if;
 if p_lock then
  perform 1 from public.contracts c where c.id in(original.contract_id,current_ts.contract_id) order by c.id for share;
  perform 1 from public.timesheets_financials f where f.timesheet_id=current_ts.timesheet_id and f.is_current order by f.id for share;
  perform 1 from private.bpay_next_work w where w.id in(original_work_id,current_work_id) order by w.id for share;
 end if;
 select count(*) into count_rows from public.timesheets_financials f where f.timesheet_id=current_ts.timesheet_id and f.is_current;
 if count_rows>1 then raise exception 'PROTECTED_CURRENT_PLACEMENT_FINANCIAL_UNBOUND' using errcode='55000';end if;
 select f.* into financial from public.timesheets_financials f where f.timesheet_id=current_ts.timesheet_id and f.is_current;
 if financial.id is not null and (financial.timesheet_version is distinct from current_ts.version or financial.is_stale
   or financial.candidate_id is distinct from family.candidate_id or financial.client_id is distinct from event.client_id) then
  raise exception 'PROTECTED_CURRENT_PLACEMENT_FINANCIAL_UNBOUND' using errcode='55000';end if;
 if original_work_id is not null then
  select w.* into strict original_work from private.bpay_next_work w where w.id=original_work_id;
  if original_work.original_timesheet_id is distinct from original.timesheet_id or original_work.contract_id is distinct from original.contract_id
   or original_work.candidate_id is distinct from family.candidate_id or original_work.week_ending_date is distinct from family.week_ending_date then
   raise exception 'PROTECTED_CURRENT_PLACEMENT_WORK_UNBOUND' using errcode='55000';end if;
 end if;
 if current_work_id is not null then
  select w.* into strict current_work from private.bpay_next_work w where w.id=current_work_id;
  select r.* into strict revision from private.bpay_next_work_revision r where r.id=current_work.current_revision_id and r.work_id=current_work.id;
  if current_work.candidate_id is distinct from family.candidate_id or current_work.contract_id is distinct from current_ts.contract_id
   or current_work.approval_state<>'APPROVED' or revision.sealed_at_utc is null
   or revision.physical_timesheet_id is distinct from current_ts.timesheet_id or revision.physical_timesheet_version is distinct from current_ts.version
   or (revision.financial_snapshot_id is not null and revision.financial_snapshot_id is distinct from financial.id) then
   raise exception 'PROTECTED_CURRENT_PLACEMENT_WORK_UNBOUND' using errcode='55000';end if;
 elsif exists(select 1 from private.bpay_next_work w where w.original_timesheet_id=current_ts.timesheet_id and w.approval_state='APPROVED') then
  raise exception 'PROTECTED_CURRENT_PLACEMENT_WORK_UNBOUND' using errcode='55000';end if;
 -- Invoice lifecycle changes after the move are legitimate. Read current
 -- original invoice facts afresh; their changed digest invalidates an older
 -- reviewed placement certificate without rewriting the move receipt.
 current_invoice:=private.weekly_source_invoice_certificate_v1(invoice_ts,source_rows,p_lock);
 if not(private.weekly_exceptional_json_keys_exact_v1(current_invoice,array['phase','hash','source_row_ids',
    'accepted_final_member_ids','original_invoice_timesheet_ids','invoice_ids','net','vat','gross']))
   or coalesce(current_invoice->>'hash','')!~'^[0-9a-f]{64}$' then
  raise exception 'PROTECTED_CURRENT_PLACEMENT_INVOICE_UNBOUND' using errcode='55000';end if;
 result:=jsonb_build_object('version','PROTECTED_CURRENT_PLACEMENT_V1','moved',moved,'family_id',family.id,
  'family_root_id',scope_root,'member_key',member_key,'original_root_timesheet_id',original.timesheet_id,
  'original_contract_id',original.contract_id,'current_timesheet_id',current_ts.timesheet_id,'current_contract_id',current_ts.contract_id,
  'current_financial_id',financial.id,'current_timesheet_version',current_ts.version,'current_approval_work_id',current_work_id,
  'original_canonical_work_id',original_work_id,'move_operation_id',operation_id,'placement_revision',physical->>'placement_revision',
  'immutable_original_evidence_sha256',encode(evidence_hash,'hex'),'source_invoice_certificate_sha256',current_invoice->>'hash');
 -- The closed transport omits private financial/approval rows. Their exact
 -- current witnesses still belong in the digest so a later financial/Work
 -- revision invalidates the reviewed certificate even if the Work ID is stable.
 return result||jsonb_build_object('placement_certificate_sha256',encode(
  private.weekly_source_sha256_jsonb_v1('PROTECTED_CURRENT_PLACEMENT_V1',jsonb_build_object(
   'certificate',result,'current_financial',to_jsonb(financial),'current_approval_work',to_jsonb(current_work),
   'current_approval_revision',to_jsonb(revision),'native_event',to_jsonb(event))),'hex'));
exception when no_data_found or too_many_rows or invalid_text_representation or numeric_value_out_of_range then
 raise exception 'PROTECTED_CURRENT_PLACEMENT_UNBOUND' using errcode='55000';
end;
$function$;
revoke all on function private.weekly_source_protected_current_placement_v1(uuid,uuid,boolean)
 from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/08_protected_current_placement.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/09_certified_native_signed_evidence.sqlinc
create or replace function private.weekly_source_protected_signed_evidence_v1(
  p_timesheet_id uuid,p_family_id uuid,p_work_event_id uuid
) returns jsonb
language plpgsql stable security definer
set search_path to 'public','private','extensions','pg_temp'
as $function$
declare
  v_timesheet public.timesheets%rowtype;
  v_workflow public.candidate_submission_workflows%rowtype;
  v_hash bytea;
  v_signed_at timestamptz;
  v_kind text;
  v_certificate jsonb;v_certified_evidence boolean:=false;
  v_alias private.timesheet_contract_family_aliases%rowtype;
  v_placement private.timesheet_contract_current_placements%rowtype;
  v_member private.timesheet_contract_move_members%rowtype;
  v_operation private.timesheet_contract_move_operations%rowtype;
begin
  select t.* into strict v_timesheet from public.timesheets t where t.timesheet_id=p_timesheet_id;
  if v_timesheet.archived_at_utc is null then
    return private.weekly_exceptional_candidate_signed_evidence_v1(p_timesheet_id);
  end if;
  v_certificate:=private.weekly_source_protected_current_placement_v1(p_family_id,p_work_event_id,false);
  select a.* into strict v_alias from private.timesheet_contract_family_aliases a where a.timesheet_id=p_timesheet_id;
  select p.* into strict v_placement from private.timesheet_contract_current_placements p
    where p.family_root_id=v_alias.family_root_id and p.member_key=v_alias.member_key;
  select m.* into strict v_member from private.timesheet_contract_move_members m
    where m.operation_id=v_placement.operation_id and m.member_key=v_alias.member_key;
  select o.* into strict v_operation from private.timesheet_contract_move_operations o where o.id=v_alias.accepted_operation_id;
  if v_certificate->'moved' is distinct from 'true'::jsonb
    or v_alias.family_root_id::text is distinct from v_certificate->>'family_root_id'
    or v_alias.original_timesheet_id is distinct from p_timesheet_id
    or v_operation.state not in('COMPLETE','SUPERSEDED') or v_operation.purpose<>'CONTRACT_CORRECTION'
    or v_timesheet.archived_reason_code is distinct from 'CONTRACT_MOVE'
    or v_timesheet.archived_by_user_id is distinct from v_operation.created_by_user_id
    or v_member.immutable_evidence_hash is distinct from private.timesheet_contract_move_row_hash_v1(
      private.timesheet_contract_move_evidence_v1(p_timesheet_id))
    or not exists(select 1 from public.weekly_exceptional_payment_approvals a
      join public.weekly_exceptional_pay_target_families f on f.id=a.pay_target_family_id
      where a.pay_target_family_id=p_family_id and a.work_event_id=p_work_event_id and a.evidence_timesheet_id=p_timesheet_id
       and a.candidate_id=f.candidate_id and a.contract_id=f.contract_id and a.client_id=v_operation.actual_client_id)
    or not exists(select 1 from private.timesheet_contract_move_members m where m.operation_id=v_operation.id
      and m.member_key=v_alias.member_key and m.from_timesheet_id=p_timesheet_id)
    or not exists(select 1 from private.timesheet_contract_move_capability_consumptions c
      where c.operation_id=v_operation.id and c.member_key=v_alias.member_key and c.phase='ACCEPT_PLACEMENT'
       and c.guard_name='public.timesheet_archive_row_guard_v1' and c.relation_oid='public.timesheets'::regclass::oid
       and c.row_operation='UPDATE' and c.authority_receipt_id=(v_operation.placement_receipt_json->>'receipt_id')::uuid
       and c.row_sha256=private.timesheet_contract_move_row_hash_v1(to_jsonb(v_timesheet))) then
    raise exception 'WEEKLY_PROTECTED_EVIDENCE_INVALID' using errcode='55000';end if;
  v_certified_evidence:=true;
  select timesheet.* into strict v_timesheet
  from public.timesheets timesheet
  where timesheet.timesheet_id=p_timesheet_id
    and timesheet.sheet_scope='WEEKLY'::public.timesheet_scope_enum
    and (timesheet.is_current or v_certified_evidence)
    and timesheet.revoked_at is null
    and (timesheet.archived_at_utc is null or v_certified_evidence);

  if v_timesheet.candidate_workflow_id is not null then
    select workflow.* into v_workflow
    from public.candidate_submission_workflows workflow
    where workflow.id=v_timesheet.candidate_workflow_id
      and workflow.generation=v_timesheet.candidate_workflow_generation
      and workflow.scope='WEEKLY'
      and workflow.contract_id=v_timesheet.contract_id
      and workflow.week_ending_date=v_timesheet.week_ending_date
      and workflow.candidate_signature_component_id is not null
      and workflow.candidate_signature_sha256 is not null
      and workflow.candidate_signed_at_utc is not null
      and workflow.worker_submitted_at_utc is not null
      and workflow.state not in (
        'CREATED','WORKER_DRAFT','REFUSED','REJECTED','CANCELLED','EXPIRED','SUPERSEDED'
      )
      and (
        workflow.target_timesheet_id=v_timesheet.timesheet_id
        or workflow.anchor_timesheet_id=v_timesheet.timesheet_id
      );
    if found then
      v_hash:=v_workflow.candidate_signature_sha256;
      v_signed_at:=v_workflow.candidate_signed_at_utc;
      v_kind:='CANDIDATE_WORKFLOW';
    end if;
  end if;

  if v_hash is null
     and v_timesheet.qr_status='USED'::public.timesheet_qr_status_enum
     and v_timesheet.qr_scanned_at is not null
     and v_timesheet.qr_signed_at_utc is not null
     and coalesce(v_timesheet.qr_signed_hash,'')~'^[0-9a-fA-F]{64}$' then
    v_hash:=pg_catalog.decode(pg_catalog.lower(v_timesheet.qr_signed_hash),'hex');
    v_signed_at:=v_timesheet.qr_signed_at_utc;
    v_kind:='SIGNED_QR';
  end if;

  if v_hash is null
     and nullif(pg_catalog.btrim(coalesce(v_timesheet.r2_nurse_key,'')),'') is not null
     and coalesce(v_timesheet.img_sha256_nurse,'')~'^[0-9a-fA-F]{64}$' then
    v_hash:=pg_catalog.decode(pg_catalog.lower(v_timesheet.img_sha256_nurse),'hex');
    v_signed_at:=v_timesheet.created_at;
    v_kind:='CANDIDATE_SIGNATURE_ASSET';
  end if;

  if v_hash is null or v_signed_at is null then
    raise exception 'WEEKLY_PROTECTED_EVIDENCE_UNSIGNED' using errcode='55000';
  end if;

  return pg_catalog.jsonb_build_object(
    'timesheet_id',v_timesheet.timesheet_id,
    'contract_id',v_timesheet.contract_id,
    'week_ending_date',v_timesheet.week_ending_date,
    'timesheet_version',v_timesheet.version,
    'signature_kind',v_kind,
    'signature_sha256',pg_catalog.encode(v_hash,'hex'),
    'signed_at_utc',v_signed_at
  );
exception
  when no_data_found or too_many_rows then
    raise exception 'WEEKLY_PROTECTED_EVIDENCE_INVALID' using errcode='55000';
end;
$function$;

revoke all on function private.weekly_source_protected_signed_evidence_v1(uuid,uuid,uuid)
 from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/09_certified_native_signed_evidence.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/10_shared_native_context.sqlinc
-- Complete isolated source proposal. Root review and native proofs pending.
create or replace function private.weekly_source_protected_action_facts_v1(
  p_request jsonb,p_request_kind text
) returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','extensions','pg_catalog','pg_temp'
as $function$
declare
  v_keys constant text[]:=array[
    'schema_version','actor_user_id','family_id',
    'source_cycle_id','work_event_id','protected_schedule','evidence_timesheet_id'
  ];
  v_schedule_keys constant text[]:=array[
    'work_date','start_at_local','end_at_local','break_minutes'
  ];
  v_actor uuid;
  v_family_id uuid;
  v_cycle_id uuid;
  v_event_id uuid;
  v_evidence_id uuid;
  v_family public.weekly_exceptional_pay_target_families%rowtype;
  v_lock_family jsonb; v_lock_group uuid;
  v_placement jsonb;v_checked_placement jsonb;v_current_entitlement jsonb;
  v_ent_root public.timesheets%rowtype;v_ent_fin public.timesheets_financials%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_contract public.contracts%rowtype;
  v_contract_week public.contract_weeks%rowtype;
  v_root public.timesheets%rowtype;
  -- WP-30 (WP-27 sweep finding N4), standing rule 3.  The expense-authority
  -- selection below decides which SOURCE_EXPENSE authorities belong to this
  -- protected root through the source-row lineage binding, which is a fact
  -- about the Timesheet FAMILY.  Keyed on the physical root id a rotated
  -- family's authorities were SILENTLY DROPPED from the projection rather than
  -- refused — fail open by omission.  EXECUTED on a rotated family: 0
  -- authorities selected by the physical id against 4 by the family.
  v_root_family uuid[];
  v_fin public.timesheets_financials%rowtype;
  v_event public.weekly_work_events%rowtype;
  v_schedule jsonb;
  v_work_date date;
  v_start timestamp without time zone;
  v_end timestamp without time zone;
  v_break integer;
  v_policy jsonb;
  v_root_policy jsonb;
  v_settings jsonb;
  v_source_mode text; v_activated_source_mode text;
  v_source_segments jsonb:='[]'::jsonb;
  v_client_sources jsonb:='[]'::jsonb;
  v_decisions jsonb:='[]'::jsonb;
  v_source_expenses jsonb:='[]'::jsonb;
  v_current_final uuid;
  v_comparison uuid;
  v_signed jsonb;
  v_candidate_submission jsonb;
  v_selected_source_present boolean:=false;
  v_selected_source_minutes integer:=0;
  v_selected_source_revision text;
  v_selected_source_hash text;
  v_source_head_revision uuid;
  v_source_head_count integer:=0;
  v_ambiguous_event_count integer:=0;
  v_fin_hash text;
  v_provider_hash text;
  v_rate_refs jsonb;
  v_component_identity_inventory jsonb;
  v_component_identity_components jsonb;
  v_final_source jsonb;
  v_next_context boolean:=false;
begin
  if pg_catalog.jsonb_typeof(p_request)<>'object'
     or not private.weekly_exceptional_json_keys_exact_v1(p_request,v_keys)
     or not (p_request ?& v_keys)
     or p_request->>'schema_version'<>'WEEKLY_PROTECTED_ACTION_FACTS_V1'
     or pg_catalog.jsonb_typeof(p_request->'protected_schedule')<>'object'
     or not private.weekly_exceptional_json_keys_exact_v1(
       p_request->'protected_schedule',v_schedule_keys
     )
     or not ((p_request->'protected_schedule') ?& v_schedule_keys) then
    raise exception 'WEEKLY_PROTECTED_ACTION_CONTEXT_INVALID' using errcode='22023';
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_family_id:=(p_request->>'family_id')::uuid;
    v_cycle_id:=(p_request->>'source_cycle_id')::uuid;
    v_event_id:=(p_request->>'work_event_id')::uuid;
    v_evidence_id:=nullif(p_request->>'evidence_timesheet_id','')::uuid;
    v_schedule:=p_request->'protected_schedule';
    v_work_date:=(v_schedule->>'work_date')::date;
    v_start:=(v_schedule->>'start_at_local')::timestamp without time zone;
    v_end:=(v_schedule->>'end_at_local')::timestamp without time zone;
    v_break:=(v_schedule->>'break_minutes')::integer;
  exception when others then
    raise exception 'WEEKLY_PROTECTED_ACTION_CONTEXT_INVALID' using errcode='22023';
  end;
  if v_end<=v_start or v_start::date<>v_work_date or v_break<0
     or v_break>=extract(epoch from (v_end-v_start))/60 then
    raise exception 'WEEKLY_PROTECTED_ACTION_CONTEXT_INVALID' using errcode='22023';
  end if;

  -- Fresh context has no immutable decision receipt exemption. Admission
  -- precedes its first family/business lock and is reentrant for an owner.
  perform private.weekly_source_pay_query_admit_v2();

  v_placement:=private.weekly_source_protected_current_placement_v1(v_family_id,v_event_id,false);
  if v_placement->'moved'='true'::jsonb then
    perform private.timesheet_contract_move_family_lock_v1((v_placement->>'original_root_timesheet_id')::uuid);
    select jsonb_build_object('root_timesheet_id',f.root_timesheet_id,'candidate_id',f.candidate_id,
      'contract_id',f.contract_id,'week_ending_date',f.week_ending_date) into strict v_lock_family
      from public.weekly_exceptional_pay_target_families f where f.id=v_family_id;
  else
    v_lock_family:=private.weekly_source_protected_family_lock_v1(v_family_id);
  end if;
  v_checked_placement:=private.weekly_source_protected_current_placement_v1(v_family_id,v_event_id,false);
  if v_checked_placement is distinct from v_placement then
    raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001';end if;
  select t.* into strict v_ent_root from public.timesheets t where t.timesheet_id=(v_placement->>'current_timesheet_id')::uuid;
  select f.* into v_ent_fin from public.timesheets_financials f where f.id=(v_placement->>'current_financial_id')::uuid;
  select family.* into strict v_family
  from public.weekly_exceptional_pay_target_families family
  where family.id=v_family_id for share;
  if (v_family.root_timesheet_id::text,v_family.candidate_id::text,v_family.contract_id::text,v_family.week_ending_date::text)
    is distinct from (v_lock_family->>'root_timesheet_id',v_lock_family->>'candidate_id',
      v_lock_family->>'contract_id',v_lock_family->>'week_ending_date') then
    raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001'; end if;
  v_lock_group:=private.weekly_source_protected_group_lock_v1(v_cycle_id);
  select cycle.* into strict v_cycle
  from public.weekly_source_cycles cycle where cycle.id=v_cycle_id for share;
  if v_cycle.source_group_id is distinct from v_lock_group then
    raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001'; end if;
  select source_group.* into strict v_group
  from public.weekly_source_groups source_group
  where source_group.id=v_cycle.source_group_id and source_group.active for share;
  select contract.* into strict v_contract
  from public.contracts contract where contract.id=v_family.contract_id for share;
  select contract_week.* into strict v_contract_week
  from public.contract_weeks contract_week
  where contract_week.contract_id=v_family.contract_id
    and contract_week.week_ending_date=v_family.week_ending_date
    and contract_week.additional_seq=0 for share;
  -- WP-30, standing rule 3.  The family is resolved and its rows are locked
  -- BEFORE the family-scoped state below is read, in the SAME mode and the same
  -- timesheet_id order the installed code here already uses (`for share`), and
  -- before the root's own `for share` so no new lock ordering is introduced.
  v_next_context:=(select active_owner from private.bpay_next_module_control where id=1)='NEXT'
    and private.bpay_next_protected_owner_route_v1(v_family.id)='NEXT';
  if v_next_context then
    v_root_family:=array[v_family.root_timesheet_id];
  else
    v_root_family:=private.weekly_source_invoice_family_timesheet_ids_v1(v_family.root_timesheet_id);
  end if;
  -- Standing rule 3's fail-closed branch: an explicit cardinality test, never a
  -- `limit`.  This owner already refuses on every other unprovable scope fact.
  if v_root_family is null or pg_catalog.cardinality(v_root_family)=0 then
    raise exception 'WEEKLY_PROTECTED_ACTION_CONTEXT_FAMILY_UNRESOLVED'
      using errcode='55000';
  end if;
  perform 1 from public.timesheets lock_row
  where lock_row.timesheet_id=any(v_root_family)
  order by lock_row.timesheet_id for share;
  select timesheet.* into strict v_root
  from public.timesheets timesheet
  where timesheet.timesheet_id=v_family.root_timesheet_id for share;
  select financial.* into v_fin
  from public.timesheets_financials financial
  where financial.timesheet_id=v_root.timesheet_id and financial.is_current
  order by financial.computed_at_utc desc nulls last,
           financial.updated_at desc nulls last,financial.id desc limit 1;
  select work_event.* into strict v_event
  from public.weekly_work_events work_event
  where work_event.id=v_event_id
    and work_event.candidate_id=v_family.candidate_id
    and work_event.client_id=v_contract.client_id for share;

  perform private.weekly_source_office_authority_v1(
    v_actor,'APPROVE_PROTECTED_PAY',v_group.id,v_contract.client_id,v_event.work_date
  );
  v_policy:=private._weekly_source_effective_policy_v1(
    v_contract.client_id,v_contract.id,v_event.work_date
  );
  -- The selected shift uses its work-date policy, but the zero-value root
  -- financial is a weekly Timesheet. Its rate-source fingerprint must match
  -- the root prepare owner's week-ending policy exactly.
  v_root_policy:=private._weekly_source_effective_policy_v1(
    v_contract.client_id,v_contract.id,v_family.week_ending_date
  );
  v_settings:=(private._timesheet_settings_authority_frozen_v1(v_root.timesheet_id)->'values')
    -'resolved_at_utc';
  v_activated_source_mode:=private.weekly_source_protected_non_self_bill_mode_v1(v_contract.client_id,v_contract.id,v_event.work_date,v_cycle.id,v_actor,v_event.id);
  v_source_mode:=coalesce(v_policy->>'c1_source_mode',v_activated_source_mode);
  if p_request_kind not in ('APPROVE','AMEND','WITHDRAW','WAIT','RECONCILE','RECORD_NOT_WORKED')
     or v_family.agency_id is distinct from v_group.agency_id
     or v_contract.candidate_id is distinct from v_family.candidate_id
     or v_contract_week.timesheet_id is distinct from v_root.timesheet_id
     or v_root.contract_id is distinct from v_contract.id
     or (v_next_context and v_root.booking_id is distinct from v_family.root_family_booking_id)
     or v_root.week_ending_date is distinct from v_family.week_ending_date
     or (not v_root.is_current and v_placement->'moved'<>'true'::jsonb) or v_root.is_adjustment
     or v_root.revoked_at is not null or (v_root.archived_at_utc is not null and v_placement->'moved'<>'true'::jsonb)
     or v_event.work_date<>v_work_date
     or v_work_date not between v_family.week_start_date and v_family.week_ending_date
     or v_policy->>'authority_mode'<>'SOURCE_AUTHORITY'
     or (coalesce((v_policy->>'self_bill_enabled')::boolean,false) is not true and v_activated_source_mode is null)
     or v_source_mode not in ('NHSP_WEEKLY','HEALTHROSTER_WEEKLY')
     or (v_group.source_family='NHSP') is distinct from (v_source_mode='NHSP_WEEKLY') then
    raise exception 'WEEKLY_PROTECTED_ACTION_CONTEXT_SCOPE_INVALID' using errcode='55000';
  end if;

  -- Read the same final-source authority shown in the Office review.
  v_final_source:=private.weekly_source_protected_final_source_context_v1(v_family.id,v_cycle.id,v_event.id);
  v_source_segments:=v_final_source->'source_segments';
  v_client_sources:=v_final_source->'client_sources';
  v_current_final:=(v_final_source->>'current_final_revision_id')::uuid;
  v_selected_source_present:=(v_final_source#>>'{source_proposal,source_present}')::boolean;
  v_selected_source_minutes:=(v_final_source#>>'{source_proposal,source_minutes}')::integer;
  v_selected_source_revision:=v_final_source#>>'{source_proposal,source_revision}';
  v_selected_source_hash:=v_final_source#>>'{source_proposal,source_hash}';

  with latest as (
    select family_event.*,
      pg_catalog.row_number() over (
        partition by family_event.durable_work_event_id
        order by family_event.event_sequence desc
      ) as event_rank
    from public.weekly_exceptional_pay_family_events family_event
    where family_event.family_id=v_family.id
  ), decisions as (
    select latest.durable_work_event_id as work_event_id,
      case when latest.durable_work_event_id=v_event.id then case
        when p_request_kind in ('APPROVE','AMEND','WAIT') then 'WAIT'
        when p_request_kind in ('WITHDRAW','RECONCILE') then 'ACCEPTED_SOURCE'
        else 'NOT_WORKED' end
      else latest.state end as decision_state,
      case when latest.durable_work_event_id=v_event.id
             and p_request_kind in ('APPROVE','AMEND','WAIT')
        then v_schedule
        else pg_catalog.jsonb_build_object(
          'work_date',latest.work_date,'start_at_local',latest.start_at_local,
          'end_at_local',latest.end_at_local,'break_minutes',latest.break_minutes
        ) end as fixed_schedule
    from latest where latest.event_rank=1
  )
  select coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
    'work_event_id',decision.work_event_id,'state',decision.decision_state,
    'fixed_schedule',case when decision.decision_state='WAIT' then pg_catalog.jsonb_build_object(
      'date',decision.fixed_schedule->>'work_date',
      'start',pg_catalog.to_char((decision.fixed_schedule->>'start_at_local')::timestamp,'HH24:MI'),
      'end',pg_catalog.to_char((decision.fixed_schedule->>'end_at_local')::timestamp,'HH24:MI'),
      'break_mins',(decision.fixed_schedule->>'break_minutes')::integer
    ) else null end
  ) order by decision.work_event_id),'[]'::jsonb)
  into v_decisions from decisions decision;
  if not exists(
    select 1 from pg_catalog.jsonb_array_elements(v_decisions) d(value)
    where (d.value->>'work_event_id')::uuid=v_event.id
  ) then
    v_decisions:=v_decisions||pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
      'work_event_id',v_event.id,
      'state',case when p_request_kind in ('APPROVE','AMEND','WAIT') then 'WAIT'
        when p_request_kind in ('WITHDRAW','RECONCILE') then 'ACCEPTED_SOURCE'
        else 'NOT_WORKED' end,
      'fixed_schedule',case when p_request_kind in ('APPROVE','AMEND','WAIT')
        then pg_catalog.jsonb_build_object(
          'date',v_work_date,'start',pg_catalog.to_char(v_start,'HH24:MI'),
          'end',pg_catalog.to_char(v_end,'HH24:MI'),'break_mins',v_break
        ) else null end
    ));
  end if;

  if p_request_kind='RECORD_NOT_WORKED' and v_selected_source_present then
    raise exception 'WEEKLY_PROTECTED_NOT_WORKED_SOURCE_PRESENT' using errcode='55000';
  end if;

  select comparison.id into v_comparison
  from public.weekly_issue_comparison_revisions comparison
  join public.weekly_discrepancy_incidents incident on incident.id=comparison.incident_id
  where incident.work_event_id=v_event.id and incident.candidate_id=v_family.candidate_id
    and incident.client_id=v_contract.client_id
  order by comparison.created_at_utc desc,comparison.id desc limit 1;

  if v_evidence_id is null then
    select approval.evidence_timesheet_id into v_evidence_id
    from public.weekly_exceptional_payment_approvals approval
    where approval.pay_target_family_id=v_family.id
      and approval.work_event_id=v_event.id
    order by approval.approved_at_utc desc,approval.id desc limit 1;
  end if;
  if v_evidence_id is not null then
    v_signed:=private.weekly_source_protected_signed_evidence_v1(v_evidence_id,v_family.id,v_event.id);
    v_candidate_submission:=pg_catalog.jsonb_build_object(
      'source_system','CLOUDTMS_CANDIDATE_TIMESHEET',
      'external_identity',v_evidence_id::text,
      'external_revision',v_signed->>'timesheet_version',
      'document_sha256',v_signed->>'signature_sha256',
      'work_date',v_event.work_date,'submitted_by_candidate_id',v_family.candidate_id,
      'submission_id',v_evidence_id,'submitted_at_utc',v_signed->>'signed_at_utc',
      'submitted_minutes',extract(epoch from (v_end-v_start))::integer/60-v_break
    );
  end if;

  select coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
    'expense_code','SOURCE_SUPPLIED:'||authority.work_event_id::text,
    'authority_kind','SOURCE_EXPENSE','source_expense_id',authority.id,
    'document_sha256',pg_catalog.encode(authority.authority_hash,'hex'),
    'pay_ex_vat',authority.candidate_reimbursement_ex_vat::text,
    'charge_ex_vat',authority.client_charge_ex_vat::text
  )||case when v_final_source ? 'next_source_segments'
    then pg_catalog.jsonb_build_object('work_event_id',authority.work_event_id,
      'final_revision_id',authority.final_revision_id,
      'source_observation_kind',authority.source_observation_kind) else '{}'::jsonb end
   order by authority.work_event_id),'[]'::jsonb)
  into v_source_expenses
  from (
    select authority.*,
      pg_catalog.row_number() over (
        partition by authority.work_event_id order by source_cycle.finalisation_week_ending desc,
          revision.finalised_at_utc desc,authority.generation desc,authority.id desc
      ) as event_rank
    from public.weekly_expense_authority_generations authority
    join public.weekly_source_final_revisions revision
      on revision.id=authority.final_revision_id and revision.state='CURRENT'
    join public.weekly_source_cycles source_cycle on source_cycle.id=revision.source_cycle_id
    where authority.contract_id=v_family.contract_id and authority.state='CURRENT'
      and source_cycle.source_group_id=v_group.id
      and ((not v_next_context and authority.source_expense_pence>0 and exists(
          select 1 from public.weekly_source_row_timesheet_lineages lineage
          where lineage.work_event_id=authority.work_event_id and lineage.contract_id=authority.contract_id
            and lineage.timesheet_id=any(v_root_family)))
        or (v_next_context and exists(
          select 1 from public.weekly_work_events event where event.id=authority.work_event_id
            and event.candidate_id=v_family.candidate_id and event.client_id=v_contract.client_id
            and event.work_date between v_family.week_start_date and v_family.week_ending_date
        ) and ((authority.source_observation_kind='OMITTED_IN_COMPLETE_COVERAGE' and authority.source_expense_pence=0)
          or exists(
            select 1 from public.weekly_source_row_expense_policy_snapshots expense_snapshot
            join public.weekly_source_row_timesheet_lineages lineage on lineage.row_resolution_id=expense_snapshot.row_resolution_id
            where expense_snapshot.id=authority.row_expense_policy_snapshot_id
              and lineage.family_booking_id=v_family.root_family_booking_id
              and lineage.work_event_id=authority.work_event_id and lineage.candidate_id=v_family.candidate_id
              and lineage.client_id=v_contract.client_id and lineage.contract_id=v_family.contract_id
              and lineage.week_ending_date=v_family.week_ending_date))))
  ) authority where authority.event_rank=1 and authority.source_expense_pence>0;

  v_fin_hash:=case when v_fin.id is null then null else pg_catalog.encode(
    private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_PROTECTED_ROOT_FINANCIAL_V1',pg_catalog.to_jsonb(v_fin)
    ),'hex') end;
  v_provider_hash:=pg_catalog.encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_PROVIDER_V1',
    pg_catalog.jsonb_build_object(
      'contract_id',v_contract.id,'pay_method',v_contract.pay_method_snapshot,
      'umbrella_id',pg_catalog.to_jsonb(v_contract)->>'umbrella_id',
      'candidate_id',v_contract.candidate_id
    )
  ),'hex');
  v_rate_refs:=pg_catalog.jsonb_build_object(
    'schema_version','WEEKLY_SOURCE_TARGET_MANAGED_ZERO_RATE_SOURCE_V1',
    'source_cycle_id',v_cycle.id,'source_group_id',v_group.id,
    'source_family',v_group.source_family,'source_mode',v_source_mode,
    'source_profile_domain',case when v_source_mode='NHSP_WEEKLY'
      then 'NHSP_TRUST_BACKING_REPORT' else 'ROSTER_FINAL_AUTHORITY' end,
    'target_family_id',v_family.id,'root_timesheet_id',v_root.timesheet_id,
    'effective_policy_sha256',v_root_policy->>'policy_sha256'
  );

  -- Local/common identity admission is independent of Banking work completion.
  -- An already authorised root requires its genuine complete current I1 basis;
  -- an actual unauthorised first Save must not invent that approved basis.
  if v_family.target_domain_version='C1_V1' then
    if v_ent_root.authorised_at_server is not null then
      v_component_identity_inventory:=private.weekly_source_effective_inventory_v1(v_ent_root.timesheet_id);
      if v_component_identity_inventory->>'ok' is distinct from 'true'
         or v_component_identity_inventory#>>'{approval_basis,coverage_complete}' is distinct from 'true'
         or v_component_identity_inventory#>>'{approval_basis,scope,root_timesheet_id}'
              is distinct from v_ent_root.timesheet_id::text
         or jsonb_typeof(v_component_identity_inventory->'components') is distinct from 'array' then
        raise exception 'WEEKLY_PROTECTED_COMPONENT_APPROVED_BASIS_UNAVAILABLE' using errcode='55000'; end if;
      v_component_identity_components:=v_component_identity_inventory->'components';
    else
      if exists(select 1 from public.weekly_source_root_authorisations a
          where a.family_booking_id=v_ent_root.booking_id)
         or exists(select 1 from public.weekly_source_entitlement_heads h
          where h.root_family_booking_id=v_ent_root.booking_id and h.state='COMMITTED_CURRENT') then
        raise exception 'WEEKLY_PROTECTED_COMPONENT_APPROVED_BASIS_UNAVAILABLE' using errcode='55000'; end if;
      v_component_identity_components:='[]'::jsonb;
    end if;
  end if;

  select jsonb_build_object('timesheet',to_jsonb(t),'contract_record',to_jsonb(c),
    'current_financial',(select to_jsonb(f) from public.timesheets_financials f
      where f.id=(v_placement->>'current_financial_id')::uuid),
    'current_approval_work_id',v_placement->'current_approval_work_id') into strict v_current_entitlement
    from public.timesheets t join public.contracts c on c.id=t.contract_id
    where t.timesheet_id=(v_placement->>'current_timesheet_id')::uuid;
  return pg_catalog.jsonb_build_object(
    'action',p_request_kind,'family_id',v_family.id,
    'family_bound_version',v_family.bound_version::text,
    'current_target_vector_sha256',case
      when v_family.current_complete_target_vector_hash is null then null
      else pg_catalog.encode(v_family.current_complete_target_vector_hash,'hex') end,
    'source_cycle_id',v_cycle.id,'source_group_id',v_group.id,
    'agency_id',v_group.agency_id,'candidate_id',v_family.candidate_id,
    'client_id',v_contract.client_id,'contract_id',v_contract.id,
    'contract_week_id',v_contract_week.id,'root_timesheet_id',v_root.timesheet_id,
    'work_event_id',v_event.id,'week_ending_date',v_family.week_ending_date,
    'source_mode',v_source_mode,'policy',v_settings,
    'timesheet',pg_catalog.to_jsonb(v_root),'contract_week',pg_catalog.to_jsonb(v_contract_week),
    'contract_record',pg_catalog.to_jsonb(v_contract),
    'current_financial',case when v_fin.id is null then null else pg_catalog.to_jsonb(v_fin) end,
    'approved_component_identity_components',v_component_identity_components,
    'requires_zero_financial',v_ent_fin.id is null,
    'protected_schedule',v_schedule,'source_segments',v_source_segments,
    'protected_decisions',v_decisions,'source_proposal',pg_catalog.jsonb_build_object(
      'selected_work_event_id',v_event.id,'source_present',v_selected_source_present,
      'source_minutes',v_selected_source_minutes,'source_revision',v_selected_source_revision,
      'source_hash',v_selected_source_hash,'source_segments',v_source_segments
    ),
    'client_sources',v_client_sources,'source_expenses',v_source_expenses,
    'candidate_submission',v_candidate_submission,
    'current_comparison_revision_id',v_comparison,
    'current_final_revision_id',v_current_final,
    'root_financial',case when v_fin.id is null then null else private.weekly_source_protected_root_financial_fact_v1(to_jsonb(v_fin),v_root.version) end,
    'provider',pg_catalog.jsonb_build_object(
      'source_system','CLOUDTMS_CONTRACT_PROVIDER','external_identity',v_contract.id::text,
      'external_revision',v_root.version::text,'document_sha256',v_provider_hash,
      'source_pay_method',v_contract.pay_method_snapshot,
      'umbrella_id',nullif(pg_catalog.to_jsonb(v_contract)->>'umbrella_id','')::uuid,
      'provider_authority_sha256',v_provider_hash,
      'target_pay_method',v_current_entitlement#>>'{contract_record,pay_method_snapshot}',
      'target_umbrella_id',nullif(v_current_entitlement#>>'{contract_record,umbrella_id}','')::uuid,
      'target_enabled',true,'target_vat_chargeable',null
    ),
    'expected_head_revision',coalesce((
      select generation.generation_number::bigint
      from private.weekly_source_local_protected_decision_receipts receipt
      join public.weekly_exceptional_pay_generations generation on generation.id=receipt.generation_id
      where receipt.family_id=v_family.id and receipt.state='COMPLETE'
        and generation.id=v_family.current_generation_id
    ),(
      select request.c1_head_revision
      from public.weekly_exceptional_c1_publication_requests request
      where request.family_id=v_family.id and request.state='PUBLISHED'
      order by request.request_sequence desc limit 1
    ),0)::text,
    'request_sequence',(v_family.current_generation_number+1)::text,
    'zero_rate_source_refs',v_rate_refs,'next_source_segments',v_final_source->'next_source_segments',
    'protected_current_placement',v_placement,'current_entitlement',v_current_entitlement
  );
exception
  when no_data_found or too_many_rows then
    raise exception 'WEEKLY_PROTECTED_ACTION_CONTEXT_SCOPE_INVALID' using errcode='55000';
end;
$function$;

revoke all on function private.weekly_source_protected_action_facts_v1(jsonb,text)
 from public,anon,authenticated,service_role;

-- Existing public native DTO and genuine run authority are preserved. Only its
-- read-only fact projection is shared with Source PREVIEW.
create or replace function public.weekly_exceptional_pay_action_context_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path=pg_catalog,private,public as $function$
declare run public.weekly_exceptional_orchestration_runs%rowtype;actor uuid;facts jsonb;
 keys constant text[]:=array['schema_version','actor_user_id','family_id','orchestration_run_id',
  'source_cycle_id','work_event_id','protected_schedule','evidence_timesheet_id'];
begin
 if coalesce(current_setting('request.jwt.claim.role',true),
  nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,keys) or not(p_request ?& keys)
  or p_request->>'schema_version' is distinct from 'WEEKLY_PROTECTED_ACTION_CONTEXT_V1' then
  raise exception 'WEEKLY_PROTECTED_ACTION_CONTEXT_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;
 if actor is null or not private.weekly_source_pay_actor_allowed_v1(actor) then
  raise exception 'WEEKLY_PROTECTED_ACTION_CONTEXT_ACTOR_REQUIRED' using errcode='42501';end if;
 select r.* into strict run from public.weekly_exceptional_orchestration_runs r
  where r.id=(p_request->>'orchestration_run_id')::uuid and r.family_id=(p_request->>'family_id')::uuid;
 if run.requested_by_user_id is distinct from actor or run.state not in('RUNNING','COMPLETE')
  or run.request_kind not in('APPROVE','AMEND','WITHDRAW','WAIT','RECONCILE','RECORD_NOT_WORKED') then
  raise exception 'WEEKLY_PROTECTED_ACTION_CONTEXT_SCOPE_INVALID' using errcode='55000';end if;
 facts:=private.weekly_source_protected_action_facts_v1((p_request-'orchestration_run_id')
  ||jsonb_build_object('schema_version','WEEKLY_PROTECTED_ACTION_FACTS_V1'),run.request_kind);
 -- Recheck the genuine run after native locks. No fabricated preview run.
 perform 1 from public.weekly_exceptional_orchestration_runs r where r.id=run.id
  and r.family_id=run.family_id and r.requested_by_user_id=actor and r.request_kind=run.request_kind
  and r.request_fingerprint=run.request_fingerprint and r.state in('RUNNING','COMPLETE') for share;
 if not found then raise exception 'WEEKLY_PROTECTED_ACTION_CONTEXT_SCOPE_INVALID' using errcode='55000';end if;
 -- Preserve the normal Local context's pre-existing scalar/optional-field
 -- representation; the private run-free fact projection is canonical instead.
 if facts->'next_source_segments'='null'::jsonb and not exists(
   select 1 from private.weekly_source_pay_decision_unprotect_preparations p where p.orchestration_run_id=run.id) then
  facts:=(facts-'next_source_segments')||jsonb_build_object('family_bound_version',(facts->>'family_bound_version')::bigint);
 end if;
 return facts||jsonb_build_object('ok',true,'contract','WEEKLY_PROTECTED_ACTION_CONTEXT_V1','orchestration_run_id',run.id);
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'WEEKLY_PROTECTED_ACTION_CONTEXT_SCOPE_INVALID' using errcode='55000';
end;
$function$;
revoke all on function public.weekly_exceptional_pay_action_context_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_exceptional_pay_action_context_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/10_shared_native_context.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/11_native_source_observation.sqlinc
-- Shared server-only observation: absence is a sealed observation of authentic
-- source rows/report scope, not a made-up final revision or zero commitment.
create or replace function private.weekly_source_unprotect_source_observation_v1(
 p_family_id uuid,p_source_cycle_id uuid,p_work_event_id uuid,p_context jsonb
) returns jsonb language plpgsql stable security definer
set search_path=pg_catalog,private,public as $function$
declare family public.weekly_exceptional_pay_target_families%rowtype;
 cycle public.weekly_source_cycles%rowtype;event public.weekly_work_events%rowtype;
 phase text;proposal jsonb;facts jsonb;links jsonb;revision uuid;source_hash bytea;
begin
 select f.* into strict family from public.weekly_exceptional_pay_target_families f where f.id=p_family_id;
 select c.* into strict cycle from public.weekly_source_cycles c where c.id=p_source_cycle_id;
 select e.* into strict event from public.weekly_work_events e where e.id=p_work_event_id;
 proposal:=p_context->'source_proposal';
 if p_context->>'family_id' is distinct from family.id::text
  or p_context->>'work_event_id' is distinct from event.id::text
  or p_context->>'source_cycle_id' is distinct from cycle.id::text
  or p_context->>'family_bound_version' is distinct from family.bound_version::text
  or event.candidate_id is distinct from family.candidate_id
  or event.work_date not between family.week_start_date and family.week_ending_date
  or jsonb_typeof(proposal) is distinct from 'object'
  or (proposal->>'source_revision' is null)<>(proposal->>'source_hash' is null) then
  raise exception 'SOURCE_UNPROTECT_SOURCE_OBSERVATION_INVALID' using errcode='55000';end if;
 if proposal->>'source_revision' is null then phase:='NO_FINAL_REPORT_YET';
 else
  revision:=(proposal->>'source_revision')::uuid;
  source_hash:=private.weekly_exceptional_hex_sha256_v1(proposal->>'source_hash');
  if not exists(select 1 from public.weekly_source_final_revisions r
    join public.weekly_source_cycles c on c.id=r.source_cycle_id
    where r.id=revision and r.state='CURRENT' and c.source_group_id=cycle.source_group_id) then
   raise exception 'SOURCE_UNPROTECT_SOURCE_OBSERVATION_INVALID' using errcode='55000';end if;
  phase:='FINAL_SOURCE_OBSERVED';
 end if;
 if (select count(*) from public.weekly_work_event_source_links l where l.work_event_id=event.id)>500 then
  raise exception 'SOURCE_UNPROTECT_SOURCE_OBSERVATION_BOUND' using errcode='54000';end if;
 select coalesce(jsonb_agg(jsonb_build_object('link',to_jsonb(l),'resolution',to_jsonb(r),'row',to_jsonb(source_row))
  order by l.upload_row_id,l.row_resolution_id,l.id),'[]'::jsonb) into links
  from public.weekly_work_event_source_links l
  join public.weekly_source_row_resolutions r on r.id=l.row_resolution_id and r.upload_row_id=l.upload_row_id
  join public.weekly_source_upload_rows source_row on source_row.id=l.upload_row_id
  where l.work_event_id=event.id;
 facts:=jsonb_build_object('phase',phase,'family_id',family.id,'family_bound_version',family.bound_version::text,
  'root_timesheet_id',family.root_timesheet_id,'original_contract_id',family.contract_id,'work_event',to_jsonb(event),
  'source_cycle',to_jsonb(cycle),'source_proposal',proposal,'checking_source',links,
  'policy',p_context->'policy','source_mode',p_context->'source_mode');
 return jsonb_build_object('source_phase',phase,'source_revision',revision,'native_source_sha256',encode(source_hash,'hex'),
  'source_observation_sha256',encode(private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_SOURCE_OBSERVATION_V1',facts),'hex'));
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'SOURCE_UNPROTECT_SOURCE_OBSERVATION_INVALID' using errcode='55000';
end;
$function$;
revoke all on function private.weekly_source_unprotect_source_observation_v1(uuid,uuid,uuid,jsonb)
 from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/11_native_source_observation.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/12_run_free_review_context.sqlinc
create or replace function public.weekly_source_pay_decision_unprotect_review_context_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path=pg_catalog,private,public
set lock_timeout='2500ms' as $function$
declare actor uuid;v_assembly_id uuid;v_decision_id uuid;v_member_key text;
 assembly private.weekly_source_pay_decision_preview_assemblies%rowtype;
 parent private.weekly_source_pay_decisions%rowtype;
 cut private.bpay_next_source_pay_decision_cut%rowtype;
 selected record;facts jsonb;observation jsonb;request jsonb;context_hash bytea;
begin
 if coalesce(current_setting('request.jwt.claim.role',true),
  nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['version','assembly_id','decision_id','member_key','actor_user_id'])
  or not(p_request ?& array['version','assembly_id','decision_id','member_key','actor_user_id'])
  or p_request->>'version' is distinct from 'SOURCE_UNPROTECT_REVIEW_CONTEXT_V1'
  or jsonb_typeof(p_request->'member_key') is distinct from 'string' then
  raise exception 'SOURCE_UNPROTECT_REVIEW_CONTEXT_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;v_assembly_id:=(p_request->>'assembly_id')::uuid;
 v_decision_id:=(p_request->>'decision_id')::uuid;v_member_key:=p_request->>'member_key';
 if actor is null or not private.weekly_source_pay_actor_allowed_v1(actor) then
  raise exception 'SOURCE_PAY_DECISION_ACTOR_REQUIRED' using errcode='42501';end if;
 select a.* into strict assembly from private.weekly_source_pay_decision_preview_assemblies a
  where a.id=v_assembly_id and a.decision_id=v_decision_id and a.actor_user_id=actor
   and a.decision_kind='EXCLUDE_FUTURE_WORK_PAY' and a.state in('ASSEMBLING','READY');
 select d.* into strict parent from private.weekly_source_pay_decisions d where d.id=assembly.decision_id;
 if assembly.expires_at_utc<=transaction_timestamp() then
  raise exception 'SOURCE_PAY_DECISION_PREVIEW_EXPIRED' using errcode='P0001';end if;
 -- Complete native gates precede shared metadata locks; no Worker/network call
 -- is made while this SQL transaction retains them.
 perform private.bpay_next_source_pay_decision_cut_v1(parent.id,assembly.id,null,true);
 select a.* into strict assembly from private.weekly_source_pay_decision_preview_assemblies a
  where a.id=assembly.id and a.decision_id=parent.id and a.actor_user_id=actor
   and a.state in('ASSEMBLING','READY') for share;
 select c.* into strict cut from private.bpay_next_source_pay_decision_cut c
  where c.preview_assembly_id=assembly.id and c.decision_id=parent.id and c.review_id is null
   and c.id::text=assembly.draft_scope_json->>'cut_id' and c.cut_no::text=assembly.draft_scope_json->>'cut_no'
   and encode(c.pay_cut_sha256,'hex')=assembly.draft_scope_json->>'pay_cut_hash';
 -- Duplicate cut components collapse only when their genuine native owner
 -- tuple is identical. Ambiguous family/event/approval is refused by STRICT.
 select distinct f.id as family_id,a.source_cycle_id,a.work_event_id,a.evidence_timesheet_id,
  a.protected_work_date,a.protected_start_at_local,a.protected_end_at_local,a.protected_break_minutes
 into strict selected from private.bpay_next_source_pay_decision_cut_member m
 join public.weekly_exceptional_pending_reconciliation_targets t on t.durable_work_event_id=m.source_work_event_id and t.state='ACTIVE'
 join public.weekly_exceptional_payment_approvals a on a.id=t.approval_id and a.pay_target_family_id=t.family_id
  and a.work_event_id=t.durable_work_event_id and a.withdrawn_at_utc is null
 join public.weekly_exceptional_pay_target_families f on f.id=t.family_id and f.candidate_id=m.candidate_id
  and f.contract_id=a.contract_id and f.ownership_state='TARGET_MANAGED'
 where m.cut_id=cut.id and m.member_key=v_member_key and m.actual_client_id=parent.actual_client_id
  and a.candidate_id=m.candidate_id and a.client_id=m.actual_client_id
  and (m.family_root_id is null or m.family_root_id=f.root_timesheet_id or exists(
    select 1 from private.timesheet_contract_family_aliases alias where alias.timesheet_id=f.root_timesheet_id and alias.family_root_id=m.family_root_id));
 request:=jsonb_build_object('schema_version','WEEKLY_PROTECTED_ACTION_FACTS_V1','actor_user_id',actor,
  'family_id',selected.family_id,'source_cycle_id',selected.source_cycle_id,'work_event_id',selected.work_event_id,
  'evidence_timesheet_id',selected.evidence_timesheet_id,'protected_schedule',jsonb_build_object(
   'work_date',selected.protected_work_date,'start_at_local',selected.protected_start_at_local,
   'end_at_local',selected.protected_end_at_local,'break_minutes',selected.protected_break_minutes));
 facts:=private.weekly_source_protected_action_facts_v1(request,'WITHDRAW');
 if facts->'requires_zero_financial' is distinct from 'false'::jsonb
  or jsonb_typeof(facts#>'{current_entitlement,current_financial}') is distinct from 'object' then
  raise exception 'SOURCE_NATIVE_PREREQUISITE_NOT_PREPARED' using errcode='55000';end if;
 observation:=private.weekly_source_unprotect_source_observation_v1(selected.family_id,selected.source_cycle_id,selected.work_event_id,facts);
 context_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_NATIVE_CONTEXT_V1',facts);
 return jsonb_build_object('version','SOURCE_UNPROTECT_REVIEW_CONTEXT_RESULT_V1','assembly_id',assembly.id,
  'decision_id',parent.id,'member_key',v_member_key,'source_phase',observation->>'source_phase',
  'source_observation_sha256',observation->>'source_observation_sha256','context_sha256',encode(context_hash,'hex'),'context',facts);
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'SOURCE_UNPROTECT_REVIEW_CONTEXT_INVALID' using errcode='22023';
end;
$function$;
revoke all on function public.weekly_source_pay_decision_unprotect_review_context_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_unprotect_review_context_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/12_run_free_review_context.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/13_preview_quote_operands.sqlinc
-- Health-only internal read completion. Existing browser, BEGIN and native
-- review_context DTOs remain unchanged. No Banking owner or cut is rewritten.
create or replace function public.weekly_source_pay_decision_preview_quote_context_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path=pg_catalog,private,public as $function$
declare context jsonb;cut private.bpay_next_source_pay_decision_cut%rowtype;quantities jsonb;
begin
 if coalesce(current_setting('request.jwt.claim.role',true),
  nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['version','assembly_id','decision_id','member_key','actor_user_id'])
  or not(p_request ?& array['version','assembly_id','decision_id','member_key','actor_user_id'])
  or p_request->>'version' is distinct from 'SOURCE_PAY_DECISION_PREVIEW_QUOTE_CONTEXT_V1' then
  raise exception 'SOURCE_PAY_DECISION_QUOTE_CONTEXT_INVALID' using errcode='22023';end if;
 context:=public.weekly_source_pay_decision_unprotect_review_context_v1(p_request
  ||jsonb_build_object('version','SOURCE_UNPROTECT_REVIEW_CONTEXT_V1'));
 select c.* into strict cut from private.bpay_next_source_pay_decision_cut c
  join private.weekly_source_pay_decision_preview_assemblies a on a.id=c.preview_assembly_id and a.decision_id=c.decision_id
  join private.weekly_source_pay_decision_requests r on r.request_id=a.preview_request_id and r.decision_id=a.decision_id
  where c.preview_assembly_id=(context->>'assembly_id')::uuid and c.decision_id=(context->>'decision_id')::uuid
   and a.actor_user_id=(p_request->>'actor_user_id')::uuid and r.actor_user_id=a.actor_user_id and r.request_kind='PREVIEW'
   and r.request_hash=a.preview_request_hash and a.state in('ASSEMBLING','READY') and c.review_id is null;
 select coalesce(jsonb_agg(jsonb_build_object('cut_id',m.cut_id,'cut_member_no',m.member_no::text,
   'member_sha256',encode(m.member_sha256,'hex'),'family_root_id',m.family_root_id,'source_row_id',m.original_source_row_id,
   'source_work_event_id',m.source_work_event_id,'canonical_work_id',m.canonical_work_id,'canonical_component_key',m.canonical_component_key,
   'scope_kind',m.scope_kind,'scope_mode',m.scope_mode,'work_dates',to_jsonb(m.work_dates),
   'supported_quantity_json',m.supported_quantity_json,'excluded_quantity_json',m.excluded_quantity_json) order by m.member_no),'[]'::jsonb)
 into quantities from private.bpay_next_source_pay_decision_cut_member m
 where m.cut_id=cut.id and m.member_key=context->>'member_key';
 if jsonb_array_length(quantities) not between 1 and 1000 then
  raise exception 'SOURCE_PAY_DECISION_QUOTE_CONTEXT_INVALID' using errcode='55000';end if;
 return jsonb_build_object('version','SOURCE_PAY_DECISION_PREVIEW_QUOTE_CONTEXT_RESULT_V1','review_context',context,
  'quantity_partition',quantities,'prior_commitment_cut_sha256',encode(cut.pay_cut_sha256,'hex'));
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'SOURCE_PAY_DECISION_QUOTE_CONTEXT_INVALID' using errcode='55000';
end;
$function$;
revoke all on function public.weekly_source_pay_decision_preview_quote_context_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_preview_quote_context_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/13_preview_quote_operands.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/14_native_preparation_request_scope.sqlinc
-- Private native engine admission. Read-only validation has no application and
-- cannot reach a write. Actual Source effect requires the one exact live app.
create or replace function private.weekly_source_pay_decision_native_request_scope_v1(
 p_preparation_id uuid,p_request jsonb,p_kind text,p_effect boolean
) returns uuid language plpgsql stable security definer
set search_path=pg_catalog,private,public as $function$
declare p private.weekly_source_pay_decision_unprotect_preparations%rowtype;
 r private.weekly_source_pay_decision_requests%rowtype;
 run public.weekly_exceptional_orchestration_runs%rowtype;
 request public.weekly_exceptional_c1_publication_requests%rowtype;
 payload_key text;suffix text;
begin
 if p_kind='NEXT' then payload_key:='publish_request';suffix:=':next';
 elsif p_kind='STAGE_LOCAL' then payload_key:='stage_request';suffix:=':stage';
 elsif p_kind='COMPLETE_LOCAL' then payload_key:='complete_request';suffix:=':local-complete';
 else raise exception 'SOURCE_NATIVE_REQUEST_SCOPE_INVALID' using errcode='22023';end if;
 if p_preparation_id is null or p_effect is null or (not p_effect and p_kind='COMPLETE_LOCAL') then
  raise exception 'SOURCE_NATIVE_REQUEST_SCOPE_INVALID' using errcode='22023';end if;
 select x.* into strict p from private.weekly_source_pay_decision_unprotect_preparations x where x.id=p_preparation_id;
 select x.* into strict r from private.weekly_source_pay_decision_requests x where x.request_id=p.accept_or_resume_request_id;
 select x.* into strict run from public.weekly_exceptional_orchestration_runs x where x.id=p.orchestration_run_id;
 if p.state not in('RUN_PREPARED','PREPARED') or p.expires_at_utc<=transaction_timestamp()
  or p_request->>'actor_user_id' is distinct from p.actor_user_id::text
  or p_request->>'idempotency_key' is distinct from p.child_idempotency_key||suffix
  or not private.weekly_source_pay_actor_allowed_v1(p.actor_user_id)
  or (p_kind='NEXT') is distinct from (p.route='NEXT')
  or r.decision_id is distinct from p.decision_id or r.review_id is distinct from p.review_id
  or r.actor_user_id is distinct from p.actor_user_id or r.metadata_state<>'CONFIRMED'
  or r.request_hash is distinct from p.confirmation_request_sha256 or r.receipt_json is not null
  or run.family_id is distinct from p.family_id or run.request_kind<>'WITHDRAW' or run.state<>'RUNNING'
  or run.requested_by_user_id is distinct from p.actor_user_id or run.idempotency_key is distinct from p.child_idempotency_key
  or run.request_fingerprint is distinct from p.native_prepare_request_sha256 then
  raise exception 'SOURCE_NATIVE_REQUEST_SCOPE_INVALID' using errcode='23514';end if;
 if p_kind='COMPLETE_LOCAL' then
  select x.* into strict request from public.weekly_exceptional_c1_publication_requests x
   where x.id=(p_request->>'publication_request_id')::uuid;
  if request.family_id is distinct from p.family_id or request.orchestration_run_id is distinct from p.orchestration_run_id
   or encode(request.request_sha256,'hex') is distinct from p_request->>'expected_request_sha256' then
   raise exception 'SOURCE_NATIVE_REQUEST_SCOPE_INVALID' using errcode='23514';end if;
 elsif p_request->>'family_id' is distinct from p.family_id::text
  or p_request->>'orchestration_run_id' is distinct from p.orchestration_run_id::text
  or p_request->>'source_cycle_id' is distinct from p.native_prepare_request_json->>'source_cycle_id'
  or p_request->>'work_event_id' is distinct from p.native_prepare_request_json->>'work_event_id'
  or p_request->>'reason' is distinct from p.native_prepare_request_json->>'reason' then
  raise exception 'SOURCE_NATIVE_REQUEST_SCOPE_INVALID' using errcode='23514';end if;
 if p.state='PREPARED' and p.payload_json->payload_key is distinct from p_request then
  raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';end if;
 if p_effect then return private.weekly_source_pay_decision_unprotect_application_v1(p.id);end if;
 return p.id;
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'SOURCE_NATIVE_REQUEST_SCOPE_INVALID' using errcode='23514';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_native_request_scope_v1(uuid,jsonb,text,boolean)
 from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/14_native_preparation_request_scope.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/15_record_owned_native_adoption.sqlinc
-- Called only by the actual private native implementation after its real
-- writes. Every identifier/hash is re-read from native rows under the exact
-- prevalidated request application; input JSON alone is never a receipt.
create or replace function private.weekly_source_pay_decision_record_native_adoption_v1(
 p_preparation_id uuid,p_application_id uuid,p_control jsonb
) returns jsonb language plpgsql volatile security definer
set search_path=pg_catalog,private,public as $function$
declare p private.weekly_source_pay_decision_unprotect_preparations%rowtype;
 app private.weekly_source_pay_decision_acceptance_applications%rowtype;
 family public.weekly_exceptional_pay_target_families%rowtype;
 run public.weekly_exceptional_orchestration_runs%rowtype;
 approval public.weekly_exceptional_payment_approvals%rowtype;
 generation public.weekly_exceptional_pay_generations%rowtype;
 work private.bpay_next_work%rowtype;revision private.bpay_next_work_revision%rowtype;
 local_receipt private.weekly_source_local_protected_decision_receipts%rowtype;
 local_request public.weekly_exceptional_c1_publication_requests%rowtype;
 head public.weekly_source_entitlement_heads%rowtype;
 head_receipt private.weekly_source_entitlement_publication_receipts%rowtype;
 pending public.weekly_source_pending_entitlement_bundles%rowtype;
 components jsonb;post_witness jsonb;result jsonb;result_hash bytea;
 kind text;bundle uuid;bundle_revision bigint;pending_id uuid;head_id uuid;head_receipt_id uuid;financial_id uuid;
begin
 select x.* into strict p from private.weekly_source_pay_decision_unprotect_preparations x where x.id=p_preparation_id for update;
 select x.* into strict app from private.weekly_source_pay_decision_acceptance_applications x where x.id=p_application_id;
 select x.* into strict family from public.weekly_exceptional_pay_target_families x where x.id=p.family_id;
 select x.* into strict run from public.weekly_exceptional_orchestration_runs x where x.id=p.orchestration_run_id;
 select x.* into strict approval from public.weekly_exceptional_payment_approvals x where x.id=(p_control->>'approval_id')::uuid;
 select x.* into strict generation from public.weekly_exceptional_pay_generations x where x.id=(p_control->>'generation_id')::uuid;
 if p.state<>'PREPARED' or app.state<>'PREVALIDATED' or app.backend_pid<>pg_backend_pid() or app.transaction_id<>pg_current_xact_id()
  or app.request_id is distinct from p.accept_or_resume_request_id or app.decision_id is distinct from p.decision_id
  or app.review_id is distinct from p.review_id or app.actor_user_id is distinct from p.actor_user_id
  or not private.weekly_source_pay_actor_allowed_v1(p.actor_user_id)
  or p_control->>'family_id' is distinct from p.family_id::text
  or p_control->>'orchestration_run_id' is distinct from p.orchestration_run_id::text
  or p_control->>'new_family_bound_version' is distinct from family.bound_version::text
  or run.state<>'COMPLETE' or run.request_kind<>'WITHDRAW' or run.family_id is distinct from family.id
  or run.requested_by_user_id is distinct from p.actor_user_id or run.idempotency_key is distinct from p.child_idempotency_key
  or run.request_fingerprint is distinct from p.native_prepare_request_sha256
  or approval.creation_orchestration_run_id is distinct from run.id or approval.pay_target_family_id is distinct from family.id
  or approval.candidate_id is distinct from family.candidate_id or approval.contract_id is distinct from family.contract_id
  or approval.work_event_id::text is distinct from p.native_prepare_request_json->>'work_event_id'
  or generation.family_id is distinct from family.id
  or not exists(select 1 from public.weekly_exceptional_pay_family_events e
    where e.family_id=family.id and e.durable_work_event_id=approval.work_event_id and e.evidence_approval_id=approval.id
     and e.state='ACCEPTED_SOURCE')
  or exists(select 1 from public.weekly_exceptional_pending_reconciliation_targets t
    where t.family_id=family.id and t.durable_work_event_id=approval.work_event_id and t.state='ACTIVE')
  or not exists(select 1 from public.weekly_exceptional_pending_reconciliation_targets t
    where t.family_id=family.id and t.durable_work_event_id=approval.work_event_id and t.state='WITHDRAWN'
     and t.completed_at_utc>=app.created_at_utc) then
  raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';end if;
 if p.route='NEXT' then
  if not private.weekly_exceptional_json_keys_exact_v1(p_control,array['family_id','orchestration_run_id','approval_id','generation_id',
    'work_id','revision_id','new_family_bound_version','approved_pay_ex_vat','source_manifest_sha256'])
   or not(p_control ?& array['family_id','orchestration_run_id','approval_id','generation_id','work_id','revision_id',
    'new_family_bound_version','approved_pay_ex_vat','source_manifest_sha256']) then
   raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';end if;
  select x.* into strict work from private.bpay_next_work x where x.id=(p_control->>'work_id')::uuid;
  select x.* into strict revision from private.bpay_next_work_revision x where x.work_id=work.id and x.id=(p_control->>'revision_id')::uuid;
  if generation.lifecycle_state<>'PUBLISHED' or generation.published_at_utc is null or family.current_generation_id is distinct from generation.id
   or generation.result_hash is distinct from run.after_state_fingerprint
   or generation.result_hash is distinct from private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_NEXT_PUBLISH_V1',p.payload_json->'publish_request')
   or generation.fixed_target_source_state_fingerprint is distinct from private.weekly_exceptional_hex_sha256_v1(p_control->>'source_manifest_sha256')
   or (p_control->>'approved_pay_ex_vat')::numeric is distinct from approval.approved_target_gross
   or work.candidate_id is distinct from family.candidate_id
   or revision.source_kind<>'PROTECTED' or revision.source_event_id is distinct from approval.id
   or revision.source_head_id is not null or revision.financial_snapshot_id is not null
   or revision.revision_no is distinct from work.current_revision_no+1
   or revision.sealed_at_utc is not null or revision.approved_at_utc is not null
   or revision.approved_source_ex_vat is distinct from approval.approved_target_gross
   or revision.expected_line_count is distinct from jsonb_array_length(p.payload_json#>'{publish_request,target_snapshot,components}')
   or revision.expected_line_count<>(select count(*) from private.bpay_next_approved_line l where l.revision_id=revision.id)
   or exists(select 1 from private.bpay_next_protected_source_receipt r where r.orchestration_run_id=run.id)
   or exists(select 1 from private.bpay_next_publication publication where publication.work_id=work.id and publication.revision_id=revision.id) then
   raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';end if;
 else
  if not private.weekly_exceptional_json_keys_exact_v1(p_control,array['family_id','orchestration_run_id','approval_id','generation_id',
    'publication_request_id','new_family_bound_version','local_state','authority','requires_first_authorisation',
    'timesheet_financials_id','entitlement','local_receipt_sha256','native_result_sha256'])
   or not(p_control ?& array['family_id','orchestration_run_id','approval_id','generation_id','publication_request_id',
    'new_family_bound_version','local_state','authority','requires_first_authorisation','timesheet_financials_id','entitlement',
    'local_receipt_sha256','native_result_sha256']) then
   raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';end if;
  select x.* into strict local_request from public.weekly_exceptional_c1_publication_requests x where x.id=(p_control->>'publication_request_id')::uuid;
  select x.* into strict local_receipt from private.weekly_source_local_protected_decision_receipts x where x.publication_request_id=local_request.id;
  if local_request.family_id is distinct from family.id or local_request.orchestration_run_id is distinct from run.id
   or local_request.generation_id is distinct from generation.id or local_request.state<>'RETIRED'
   or local_receipt.family_id is distinct from family.id or local_receipt.generation_id is distinct from generation.id
   or local_receipt.actor_user_id is distinct from p.actor_user_id or local_receipt.state not in('COMPLETE','PENDING_FREEZE')
   or local_receipt.preparing_transaction_id is distinct from pg_current_xact_id()
   or local_receipt.result_json is distinct from local_request.typed_result_json
   or local_receipt.state is distinct from p_control->>'local_state'
   or local_receipt.result_json->>'authority' is distinct from p_control->>'authority'
   or local_receipt.result_json->'requires_first_authorisation' is distinct from p_control->'requires_first_authorisation'
   or private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_LOCAL_RESULT_V1',local_receipt.result_json)
       is distinct from private.weekly_exceptional_hex_sha256_v1(p_control->>'native_result_sha256')
   or run.after_state_fingerprint is distinct from private.weekly_exceptional_hex_sha256_v1(p_control->>'native_result_sha256')
   or private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_LOCAL_RECEIPT_ROW_V1',to_jsonb(local_receipt))
       is distinct from private.weekly_exceptional_hex_sha256_v1(p_control->>'local_receipt_sha256') then
   raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';end if;
  if p_control->>'authority'='UNAUTHORISED_TSFIN' then
   financial_id:=(p_control->>'timesheet_financials_id')::uuid;
   if local_receipt.state<>'COMPLETE' or p_control->'requires_first_authorisation' is distinct from 'true'::jsonb
    or p_control->'entitlement' is distinct from 'null'::jsonb
    or local_receipt.result_json->>'timesheet_financials_id' is distinct from financial_id::text
    or not exists(select 1 from public.timesheets_financials f where f.id=financial_id
      and f.timesheet_id=local_receipt.root_timesheet_id and f.is_current and f.authorised_at_utc is null
      and f.processing_status='PENDING_AUTH' and f.paid_at_utc is null and f.locked_by_invoice_id is null) then
    raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';end if;
  elsif p_control->>'authority'='COMMON_ENTITLEMENT_HEAD' then
   if p_control->'requires_first_authorisation' is distinct from 'false'::jsonb
    or p_control->'timesheet_financials_id' is distinct from 'null'::jsonb then
    raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';end if;
   kind:=p_control#>>'{entitlement,kind}';bundle:=(p_control#>>'{entitlement,decision_bundle_id}')::uuid;
   bundle_revision:=(p_control#>>'{entitlement,bundle_revision}')::bigint;
   if bundle is distinct from local_receipt.common_decision_bundle_id or bundle_revision is distinct from local_receipt.common_bundle_revision then
    raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';end if;
   if local_receipt.state='PENDING_FREEZE' then
    pending_id:=(p_control#>>'{entitlement,pending_bundle_id}')::uuid;
    select x.* into strict pending from public.weekly_source_pending_entitlement_bundles x where x.id=pending_id;
    if kind is distinct from 'PENDING_BUNDLE' or not private.weekly_exceptional_json_keys_exact_v1(p_control->'entitlement',
      array['kind','pending_bundle_id','decision_bundle_id','bundle_revision'])
     or pending.id::text is distinct from local_receipt.result_json#>>'{publication,pending_bundle_verified}'
     or pending.decision_bundle_id is distinct from bundle or pending.bundle_revision is distinct from bundle_revision
     or pending.candidate_id is distinct from family.candidate_id or pending.decided_by_user_id is distinct from p.actor_user_id
     or not(local_receipt.root_timesheet_id=any(pending.member_root_ids)) or pending.state<>'PENDING' then
     raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';end if;
   else
    head_id:=(p_control#>>'{entitlement,source_head_id}')::uuid;head_receipt_id:=(p_control#>>'{entitlement,publication_receipt_id}')::uuid;
    select x.* into strict head from public.weekly_source_entitlement_heads x where x.id=head_id;
    select x.* into strict head_receipt from private.weekly_source_entitlement_publication_receipts x where x.id=head_receipt_id;
    if kind is distinct from 'COMMITTED_HEAD' or not private.weekly_exceptional_json_keys_exact_v1(p_control->'entitlement',
      array['kind','decision_bundle_id','bundle_revision','source_head_id','publication_receipt_id'])
     or head.decision_bundle_id is distinct from bundle or head.bundle_revision is distinct from bundle_revision
     or head.root_timesheet_id is distinct from local_receipt.root_timesheet_id or head.state<>'COMMITTED_CURRENT'
     or head_receipt.decision_bundle_id is distinct from bundle or head_receipt.bundle_revision is distinct from bundle_revision
     or head_receipt.candidate_id is distinct from family.candidate_id or not(head.id=any(head_receipt.head_ids))
     or not(local_receipt.root_timesheet_id=any(head_receipt.member_root_ids)) then
     raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';end if;
   end if;
  else raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';end if;
 end if;
 select coalesce(jsonb_agg(jsonb_build_object('cut_id',m.cut_id,'member_no',m.member_no::text,
   'member_sha256',encode(m.member_sha256,'hex')) order by m.member_no),'[]'::jsonb) into components
  from private.bpay_next_source_pay_decision_cut_member m where m.cut_id=app.cut_id and m.member_key=p.member_key;
 if jsonb_array_length(components)=0 then raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';end if;
 result:=jsonb_build_object('version','SOURCE_NATIVE_COMPOSED_RESULT_V1','application_id',app.id,'decision_id',p.decision_id,
  'request_id',p.accept_or_resume_request_id,'review_id',p.review_id,'member_key',p.member_key,'preparation_id',p.id,
  'route',p.route,'origin','APPLIED_IN_THIS_TRANSACTION','control_status','WITHDRAWN','native_receipt',p_control,'failure_code',null);
 result_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_COMPOSED_RESULT_V1',result);
 if p.route='NEXT' then
  if not exists(select 1 from public.weekly_exceptional_orchestration_steps s where s.orchestration_run_id=run.id
    and s.step_kind='PUBLISH_NEXT' and s.idempotency_key=p.child_idempotency_key||':next'
    and s.allowlisted_owner_name='private.weekly_exceptional_pay_publish_next_impl_v1' and s.allowlisted_owner_signature='jsonb,uuid->jsonb'
    and s.bounded_request_hash=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_NEXT_PUBLISH_V1',p.payload_json->'publish_request')
    and s.before_state_fingerprint=run.before_state_fingerprint and s.bounded_owner_response_json=result
    and s.owner_response_hash=result_hash and s.after_state_fingerprint=run.after_state_fingerprint
    and s.outcome='COMPLETE' and s.completed_at_utc is not null) then
   raise exception 'SOURCE_NATIVE_ADOPTION_STEP_INVALID' using errcode='23514';end if;
 else
  if not exists(select 1 from public.weekly_exceptional_orchestration_steps s where s.orchestration_run_id=run.id
    and s.step_kind='COMPLETE_LOCAL_PROTECTED_DECISION' and s.idempotency_key=p.child_idempotency_key||':local-complete'
    and s.allowlisted_owner_name='CloudTMS.weekly_exceptional_pay_complete_local_v1' and s.allowlisted_owner_signature='jsonb'
    and s.bounded_request_hash=local_receipt.request_sha256 and s.before_state_fingerprint=run.before_state_fingerprint
    and s.bounded_owner_response_json=local_receipt.result_json
    and s.owner_response_hash=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_LOCAL_RESULT_V1',local_receipt.result_json)
    and s.after_state_fingerprint=run.after_state_fingerprint and s.completed_at_utc is not null
    and s.outcome=case when local_receipt.state='PENDING_FREEZE' then 'PENDING' else 'COMPLETE' end) then
   raise exception 'SOURCE_NATIVE_ADOPTION_STEP_INVALID' using errcode='23514';end if;
 end if;
 post_witness:=jsonb_build_object('family',to_jsonb(family),'run',to_jsonb(run),'approval',to_jsonb(approval),'generation',to_jsonb(generation),
  'work',case when p.route='NEXT' then to_jsonb(work) else null end,'revision',case when p.route='NEXT' then to_jsonb(revision) else null end,
  'local_request',case when p.route='SOURCE_LOCAL' then to_jsonb(local_request) else null end,
  'local_receipt',case when p.route='SOURCE_LOCAL' then to_jsonb(local_receipt) else null end,
  'head',case when head_id is not null then to_jsonb(head) else null end,
  'publication_receipt',case when head_receipt_id is not null then to_jsonb(head_receipt) else null end,
  'pending_bundle',case when pending_id is not null then to_jsonb(pending) else null end,
  'steps',(select coalesce(jsonb_agg(to_jsonb(s) order by s.sequence),'[]'::jsonb)
    from public.weekly_exceptional_orchestration_steps s where s.orchestration_run_id=run.id));
 insert into private.weekly_source_pay_decision_native_adoptions(application_id,decision_id,review_id,member_key,preparation_id,
  route,origin,orchestration_run_id,approval_id,generation_id,next_work_id,next_revision_id,local_publication_request_id,local_financial_id,
  reviewed_economic_target_sha256,pre_witness_sha256,post_witness_manifest_json,native_result_json,native_result_sha256,
  cut_components_json,cut_components_sha256,local_entitlement_kind,committed_decision_bundle_id,committed_bundle_revision,
  committed_source_head_id,committed_publication_receipt_id,pending_bundle_id,pending_decision_bundle_id,pending_bundle_revision)
 values(app.id,p.decision_id,p.review_id,p.member_key,p.id,p.route,'APPLIED_IN_THIS_TRANSACTION',run.id,approval.id,generation.id,
  work.id,revision.id,local_receipt.publication_request_id,financial_id,p.reviewed_target_sha256,app.pre_witness_sha256,post_witness,result,result_hash,
  components,private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_CUT_COMPONENTS_V1',components),kind,
  case when kind='COMMITTED_HEAD' then bundle end,case when kind='COMMITTED_HEAD' then bundle_revision end,head_id,head_receipt_id,
  pending_id,case when kind='PENDING_BUNDLE' then bundle end,case when kind='PENDING_BUNDLE' then bundle_revision end);
 update private.weekly_source_pay_decision_unprotect_preparations x set state='CONSUMED',native_receipt_json=result
  where x.id=p.id and x.state='PREPARED';
 if not found then raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='40001';end if;
 return result;
exception when no_data_found or too_many_rows or invalid_text_representation or numeric_value_out_of_range then
 raise exception 'SOURCE_NATIVE_ADOPTION_PROOF_INVALID' using errcode='23514';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_record_native_adoption_v1(uuid,uuid,jsonb)
 from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/15_record_owned_native_adoption.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/16_native_next_implementation.sqlinc
create or replace function private.weekly_source_protected_next_engine_v1(p_request jsonb,p_source_decision_preparation_id uuid,p_validate_only boolean)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public
as $function$
declare
  v_source_gate jsonb;v_source_application_id uuid;v_source_result jsonb;v_source_control jsonb;
  v_keys constant text[]:=array['schema_version','actor_user_id','family_id','orchestration_run_id',
    'source_cycle_id','client_id','work_event_id','evidence_timesheet_id','expected_family_bound_version',
    'protected_schedule','rate_classification','source_proposal','target_snapshot',
    'current_comparison_revision_id','current_final_revision_id','reason','idempotency_key'];
  v_request_hash bytea;
  v_source_hash bytea;
  v_target_hash bytea;
  v_schedule_hash bytea;
  v_policy_hash bytea;
  v_approval_hash bytea;
  v_prior_vector jsonb;
  v_prior_vector_hash bytea;
  v_family public.weekly_exceptional_pay_target_families%rowtype;
  v_run public.weekly_exceptional_orchestration_runs%rowtype;
  v_receipt private.bpay_next_protected_source_receipt%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_contract public.contracts%rowtype;
  v_root public.timesheets%rowtype;
  v_evidence_row public.timesheets%rowtype;
  v_approval public.weekly_exceptional_payment_approvals%rowtype;
  v_generation public.weekly_exceptional_pay_generations%rowtype;
  v_context jsonb;
  v_policy jsonb;
  v_signed jsonb;
  v_components jsonb;
  v_component jsonb;
  v_source jsonb;
  v_break jsonb;
  v_actor uuid;
  v_event uuid;
  v_evidence uuid;
  v_work_date date;
  v_key text;
  v_total numeric:=0;
  v_match integer;
  v_n integer;
  v_issue_ids uuid[];
  v_issue_hash bytea;
  v_reason text;
  v_generation_reason text;
  v_state text;
  v_lifecycle text;
  v_event_sequence bigint;
  v_family_event_id uuid;
  v_prior_event_hash bytea;
  v_event_hash bytea;
  v_target_sequence bigint;
  v_prior_target_hash bytea;
  v_audit_hash bytea;
  v_step integer;
  v_stage record;
  v_publication record;
  v_bucket text;
  v_rate numeric;
  v_charge_rate numeric;
  v_hours numeric;
  v_local jsonb;
begin
  if p_validate_only is null or (p_validate_only and p_source_decision_preparation_id is null) then
    raise exception 'SOURCE_NATIVE_VALIDATION_SCOPE_REQUIRED' using errcode='22023';end if;
  if coalesce(nullif(pg_catalog.current_setting('request.jwt.claim.role',true),''),
      nullif(pg_catalog.current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception using errcode='42501',message='BPAY_NEXT_SERVICE_REQUIRED';
  end if;
  if pg_catalog.jsonb_typeof(p_request)<>'object'
     or not private.weekly_exceptional_json_keys_exact_v1(p_request,v_keys) or not (p_request ?& v_keys)
     or p_request->>'schema_version'<>'WEEKLY_PROTECTED_NEXT_PUBLISH_V1'
     or pg_catalog.octet_length(p_request::text)>128000
     or pg_catalog.jsonb_typeof(p_request->'target_snapshot')<>'object'
     or not private.weekly_exceptional_json_keys_exact_v1(p_request->'target_snapshot',array['schema_version','components'])
     or p_request#>>'{target_snapshot,schema_version}'<>'WEEKLY_PROTECTED_NEXT_TARGET_V1'
     or pg_catalog.jsonb_typeof(p_request#>'{target_snapshot,components}')<>'array'
     or pg_catalog.jsonb_array_length(p_request#>'{target_snapshot,components}')>100 then
    raise exception using errcode='22023',message='BPAY_NEXT_PROTECTED_REQUEST_INVALID';
  end if;
  v_actor:=(p_request->>'actor_user_id')::uuid; v_event:=(p_request->>'work_event_id')::uuid;
  v_evidence:=nullif(p_request->>'evidence_timesheet_id','')::uuid;
  v_work_date:=(p_request#>>'{protected_schedule,work_date}')::date;
  v_key:=p_request->>'idempotency_key'; v_reason:=p_request->>'reason';
  if pg_catalog.char_length(v_key) not between 16 and 240 or pg_catalog.char_length(btrim(v_reason)) not between 1 and 1000
     or not private.weekly_source_pay_actor_allowed_v1(v_actor) then
    raise exception using errcode='42501',message='BPAY_NEXT_PROTECTED_ACTOR_REFUSED';
  end if;
  v_request_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_NEXT_PUBLISH_V1',p_request);
  -- Immutable exact replay precedes mutable current-root checks. A later
  -- legitimate physical rotation cannot invalidate this accepted receipt.
  select f.* into strict v_family from public.weekly_exceptional_pay_target_families f
    where f.id=(p_request->>'family_id')::uuid;
  select r.* into strict v_run from public.weekly_exceptional_orchestration_runs r
    where r.id=(p_request->>'orchestration_run_id')::uuid and r.family_id=v_family.id;
  if v_run.requested_by_user_id is distinct from v_actor then
    raise exception using errcode='42501',message='BPAY_NEXT_PROTECTED_ACTOR_REFUSED';
  end if;
  if p_source_decision_preparation_id is null then
    v_source_gate:=private.weekly_source_pay_decision_native_normal_gate_v1(v_family.id,v_run.id,v_actor,'PUBLISH_NEXT');
    if v_source_gate is not null then return v_source_gate; end if;
  else
    v_source_application_id:=private.weekly_source_pay_decision_native_request_scope_v1(
      p_source_decision_preparation_id,p_request,'NEXT',not p_validate_only);
  end if;
  select r.* into v_receipt from private.bpay_next_protected_source_receipt r where r.orchestration_run_id=v_run.id;
  if found then
    if v_receipt.publication_request_sha256<>v_request_hash or v_receipt.actor_user_id<>v_actor
       or v_receipt.family_id<>v_family.id or v_run.state<>'COMPLETE'
       or v_receipt.prepared_request_sha256 is distinct from v_run.request_fingerprint
       or exists(select 1 from private.weekly_source_local_protected_decision_receipts l
         join public.weekly_exceptional_c1_publication_requests request on request.id=l.publication_request_id
         where request.orchestration_run_id=v_run.id) then
      raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_REPLAY_CONFLICT';
    end if;
    select a.* into strict v_approval from public.weekly_exceptional_payment_approvals a where a.id=v_receipt.approval_id;
    select c.* into strict v_cycle from public.weekly_source_cycles c where c.id=v_approval.source_cycle_id;
    perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',v_cycle.source_group_id,
      v_approval.client_id,v_approval.protected_work_date);
    return private.bpay_next_protected_receipt_json_v1(v_run.id,true);
  end if;
  -- BEGIN QUERY V2 DIRECT NEXT ADMISSION
  -- Exact immutable receipt replay above is lock-free. Fresh acceptance must
  -- admit before the protected booking/root lock; propagate exact 55P03.
  perform private.weekly_source_pay_query_admit_v2();
  -- END QUERY V2 DIRECT NEXT ADMISSION

  -- Accepted Local cannot be republished by the direct financial owner.
  -- Its status route exposes the actual original common-HEAD mapping instead.
  v_local:=private.bpay_next_protected_local_receipt_v1(v_family.id,v_run.id,v_actor);
  if v_local is not null then
    raise exception using errcode='55000',message='BPAY_NEXT_PROTECTED_LOCAL_OWNER_REQUIRED';
  end if;

  -- Actual first acceptance retains the Source advisory ordering, then only
  -- the exact current physical root, family and run mutexes. Recheck receipt
  -- after those locks for simultaneous identical first requests.
  begin
    perform private.bpay_next_protected_lock_current_root_v1(v_family.root_timesheet_id,v_family.candidate_id,
      v_family.contract_id,v_family.week_ending_date,v_family.root_family_booking_id);
  exception when sqlstate '55000' then
    if sqlerrm<>'BPAY_NEXT_PROTECTED_ROOT_NOT_EXACT' then raise;end if;
    -- A concurrent identical first call may have committed while this call
    -- waited on the booking key, followed by a legitimate root rotation.
    -- Read only the immutable receipt; never retry an owner or adopt a root.
    select r.* into v_receipt from private.bpay_next_protected_source_receipt r where r.orchestration_run_id=v_run.id;
    if not found then raise;end if;
    select r.* into strict v_run from public.weekly_exceptional_orchestration_runs r
      where r.id=v_run.id and r.family_id=v_family.id;
    if v_run.requested_by_user_id is distinct from v_actor
       or v_receipt.publication_request_sha256<>v_request_hash or v_receipt.actor_user_id<>v_actor
       or v_receipt.family_id<>v_family.id or v_run.state<>'COMPLETE'
       or v_receipt.prepared_request_sha256 is distinct from v_run.request_fingerprint
       or exists(select 1 from private.weekly_source_local_protected_decision_receipts l
         join public.weekly_exceptional_c1_publication_requests request on request.id=l.publication_request_id
         where request.orchestration_run_id=v_run.id) then
      raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_REPLAY_CONFLICT';
    end if;
    select a.* into strict v_approval from public.weekly_exceptional_payment_approvals a where a.id=v_receipt.approval_id;
    select c.* into strict v_cycle from public.weekly_source_cycles c where c.id=v_approval.source_cycle_id;
    perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',v_cycle.source_group_id,
      v_approval.client_id,v_approval.protected_work_date);
    return private.bpay_next_protected_receipt_json_v1(v_run.id,true);
  end;
  select f.* into strict v_family from public.weekly_exceptional_pay_target_families f where f.id=v_family.id for update;
  select r.* into strict v_run from public.weekly_exceptional_orchestration_runs r
    where r.id=(p_request->>'orchestration_run_id')::uuid and r.family_id=v_family.id for update;
  if v_run.requested_by_user_id is distinct from v_actor then
    raise exception using errcode='42501',message='BPAY_NEXT_PROTECTED_ACTOR_REFUSED';
  end if;
  select r.* into v_receipt from private.bpay_next_protected_source_receipt r where r.orchestration_run_id=v_run.id;
  if found then
    if v_receipt.publication_request_sha256<>v_request_hash or v_receipt.actor_user_id<>v_actor
       or v_receipt.prepared_request_sha256 is distinct from v_run.request_fingerprint
       or v_receipt.family_id is distinct from v_family.id or v_run.state<>'COMPLETE'
       or exists(select 1 from private.weekly_source_local_protected_decision_receipts l
         join public.weekly_exceptional_c1_publication_requests request on request.id=l.publication_request_id
         where request.orchestration_run_id=v_run.id) then
      raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_REPLAY_CONFLICT';
    end if;
    select a.* into strict v_approval from public.weekly_exceptional_payment_approvals a
      where a.id=v_receipt.approval_id;
    select c.* into strict v_cycle from public.weekly_source_cycles c where c.id=v_approval.source_cycle_id;
    perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',v_cycle.source_group_id,
      v_approval.client_id,v_approval.protected_work_date);
    return private.bpay_next_protected_receipt_json_v1(v_run.id,true);
  end if;
  perform 1 from private.bpay_next_module_control where id=1 and active_owner='NEXT' for share;
  if not found then raise exception using errcode='55000',message='BPAY_NEXT_MODULE_NOT_ACTIVE'; end if;
  -- Recheck after the same family/run locks: no lane switch can occur between
  -- the pure status choice and fresh financial staging. First Authorise is an
  -- actual independent owner, never an approval metadata or saved-hour label.
  v_local:=private.bpay_next_protected_local_receipt_v1(v_family.id,v_run.id,v_actor);
  if v_local is not null or private.bpay_next_protected_owner_route_v1(v_family.id)<>'NEXT' then
    raise exception using errcode='55000',message='BPAY_NEXT_PROTECTED_LOCAL_OWNER_REQUIRED';
  end if;
  perform private.bpay_next_protected_require_authorised_root_v1(v_family.root_timesheet_id);
  select c.* into strict v_cycle from public.weekly_source_cycles c where c.id=(p_request->>'source_cycle_id')::uuid for share;
  select g.* into strict v_group from public.weekly_source_groups g where g.id=v_cycle.source_group_id and g.active for share;
  select c.* into strict v_contract from public.contracts c where c.id=v_family.contract_id for share;
  select t.* into strict v_root from public.timesheets t where t.timesheet_id=v_family.root_timesheet_id for key share;
  perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',v_group.id,
    v_contract.client_id,v_work_date);
  if v_run.state<>'RUNNING' or v_run.request_kind not in ('APPROVE','AMEND','WITHDRAW','RECONCILE','RECORD_NOT_WORKED')
     or v_family.bound_version<>(p_request->>'expected_family_bound_version')::bigint
     or v_run.request_fingerprint is null or v_family.agency_id<>v_group.agency_id
     or (v_family.current_generation_id is not null and v_family.target_domain_version<>'NEXT_V1')
     or v_family.c1_publication_state<>'NONE'
     or (p_request->>'client_id')::uuid<>v_contract.client_id
     or exists(select 1 from public.weekly_exceptional_c1_publication_requests r where r.family_id=v_family.id) then
    raise exception using errcode='55000',message='BPAY_NEXT_PROTECTED_SCOPE_INVALID';
  end if;
  v_policy:=private._weekly_source_effective_policy_v1(v_contract.client_id,v_contract.id,v_work_date);
  if v_policy->>'authority_mode'<>'SOURCE_AUTHORITY' or coalesce((v_policy->>'self_bill_enabled')::boolean,false) is not true
     or v_policy->>'c1_source_mode' not in ('NHSP_WEEKLY','HEALTHROSTER_WEEKLY')
     or (v_group.source_family='NHSP') is distinct from (v_policy->>'c1_source_mode'='NHSP_WEEKLY') then
    raise exception using errcode='55000',message='BPAY_NEXT_PROTECTED_POLICY_INVALID';
  end if;
  v_context:=public.weekly_exceptional_pay_action_context_v1(pg_catalog.jsonb_build_object(
    'schema_version','WEEKLY_PROTECTED_ACTION_CONTEXT_V1','actor_user_id',v_actor,
    'family_id',v_family.id,'orchestration_run_id',v_run.id,'source_cycle_id',v_cycle.id,
    'work_event_id',v_event,'protected_schedule',p_request->'protected_schedule','evidence_timesheet_id',v_evidence));
  perform private.weekly_source_protected_action_placement_assert_v1(p_request,v_context->'protected_current_placement');
  if v_context->'source_proposal' is distinct from p_request->'source_proposal'
     or v_context->>'current_comparison_revision_id' is distinct from p_request->>'current_comparison_revision_id'
     or v_context->>'current_final_revision_id' is distinct from p_request->>'current_final_revision_id'
     or v_context->'protected_schedule' is distinct from p_request->'protected_schedule' then
    raise exception using errcode='55000',message='BPAY_NEXT_PROTECTED_SOURCE_CHANGED';
  end if;
  if p_request->'rate_classification' is distinct from pg_catalog.jsonb_build_object(
      'schema_version','WEEKLY_PROTECTED_SERVER_CALCULATION_V1',
      'calculator_owner','buildWeeklyScheduleSegmentsSnapshot',
      'policy_sha256',v_context#>>'{zero_rate_source_refs,effective_policy_sha256}')
     or v_context#>>'{candidate_submission,submission_id}' is distinct from v_evidence::text
     or pg_catalog.jsonb_typeof(p_request->'expected_family_bound_version') is distinct from 'string'
     or p_request->>'expected_family_bound_version' !~ '^[1-9][0-9]{0,18}$' then
    raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_PREVIEW_SCOPE_NOT_EXACT';
  end if;
  v_components:=p_request#>'{target_snapshot,components}';
  if pg_catalog.jsonb_array_length(v_components)<>(
      select pg_catalog.count(*) from pg_catalog.jsonb_array_elements(v_context->'protected_decisions') d(value)
      where d.value->>'state'='WAIT')+(
      select pg_catalog.count(*) from pg_catalog.jsonb_array_elements(v_context->'next_source_segments') s(value)
      where not exists(select 1 from pg_catalog.jsonb_array_elements(v_context->'protected_decisions') d(value)
        where d.value->>'work_event_id'=s.value#>>'{weekly_source,work_event_id}'
          and d.value->>'state' in ('WAIT','NOT_WORKED')))
      +pg_catalog.jsonb_array_length(v_context->'source_expenses') then
    raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_MANIFEST_NOT_EXACT';
  end if;
  if exists(select 1 from pg_catalog.jsonb_array_elements(v_components) x(value)
      group by x.value->>'kind',x.value->>'work_event_id' having pg_catalog.count(*)<>1) then
    raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_COMPONENT_DUPLICATE';
  end if;
  for v_component in select value from pg_catalog.jsonb_array_elements(v_components) loop
    if pg_catalog.jsonb_typeof(v_component)<>'object' or v_component->>'kind' not in ('WORK','EXPENSE')
       or pg_catalog.jsonb_typeof(v_component->'pay_ex_vat')<>'string'
       or pg_catalog.jsonb_typeof(v_component->'charge_ex_vat')<>'string'
       or (v_component->>'pay_ex_vat') !~ '^-?(0|[1-9][0-9]*)\.[0-9]{2}$'
       or (v_component->>'charge_ex_vat') !~ '^-?(0|[1-9][0-9]*)\.[0-9]{2}$' then
      raise exception using errcode='22023',message='BPAY_NEXT_PROTECTED_COMPONENT_INVALID';
    end if;
    if v_component->>'kind'='EXPENSE' then
      if not private.weekly_exceptional_json_keys_exact_v1(v_component,array['kind','work_event_id','source_expense_id',
          'final_revision_id','source_observation_kind','authority_sha256','pay_ex_vat','charge_ex_vat'])
         or not (v_component ?& array['kind','work_event_id','source_expense_id','final_revision_id',
          'source_observation_kind','authority_sha256','pay_ex_vat','charge_ex_vat']) then
        raise exception using errcode='22023',message='BPAY_NEXT_PROTECTED_EXPENSE_INVALID';
      end if;
      select pg_catalog.count(*)::integer into v_match from pg_catalog.jsonb_array_elements(v_context->'source_expenses') e(value)
        where e.value->>'work_event_id'=v_component->>'work_event_id'
          and e.value->>'source_expense_id'=v_component->>'source_expense_id'
          and e.value->>'final_revision_id'=v_component->>'final_revision_id'
          and e.value->>'source_observation_kind'=v_component->>'source_observation_kind'
          and e.value->>'document_sha256'=v_component->>'authority_sha256'
          and (e.value->>'pay_ex_vat')::numeric=(v_component->>'pay_ex_vat')::numeric
          and (e.value->>'charge_ex_vat')::numeric=(v_component->>'charge_ex_vat')::numeric;
      if v_match<>1 then raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_EXPENSE_NOT_EXACT'; end if;
    else
      if not private.weekly_exceptional_json_keys_exact_v1(v_component,array['kind','work_event_id','protected',
        'date','start','end','overnight','start_at_utc','end_at_utc','break_minutes','breaks','hours','rates',
        'charge_rates','pay_ex_vat','charge_ex_vat','source_provenance'])
        or not (v_component ?& array['kind','work_event_id','protected','date','start','end','overnight',
          'start_at_utc','end_at_utc','break_minutes','breaks','hours','rates','charge_rates','pay_ex_vat',
          'charge_ex_vat','source_provenance'])
        or pg_catalog.jsonb_typeof(v_component->'protected')<>'boolean'
        or pg_catalog.jsonb_typeof(v_component->'overnight')<>'boolean'
        or pg_catalog.jsonb_typeof(v_component->'breaks')<>'array'
        or pg_catalog.jsonb_array_length(v_component->'breaks')>100
        or v_component->>'start' !~ '^([01][0-9]|2[0-3]):[0-5][0-9]$'
        or v_component->>'end' !~ '^([01][0-9]|2[0-3]):[0-5][0-9]$'
        or (v_component->>'break_minutes')::integer<0 then
        raise exception using errcode='22023',message='BPAY_NEXT_PROTECTED_SHIFT_INVALID';
      end if;
      if (v_component->>'protected')::boolean then
        select pg_catalog.count(*)::integer into v_match from pg_catalog.jsonb_array_elements(v_context->'protected_decisions') d(value)
          where d.value->>'work_event_id'=v_component->>'work_event_id' and d.value->>'state'='WAIT'
            and d.value#>>'{fixed_schedule,date}'=v_component->>'date'
            and d.value#>>'{fixed_schedule,start}'=v_component->>'start'
            and d.value#>>'{fixed_schedule,end}'=v_component->>'end'
            and (d.value#>>'{fixed_schedule,break_mins}')::integer=(v_component->>'break_minutes')::integer;
        if v_match<>1 or v_component->'source_provenance'<>'null'::jsonb then
          raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_SCHEDULE_NOT_APPROVED';
        end if;
      else
        select pg_catalog.count(*)::integer,pg_catalog.jsonb_agg(s.value)->0 into v_match,v_source
          from pg_catalog.jsonb_array_elements(v_context->'next_source_segments') s(value)
          where s.value#>>'{weekly_source,work_event_id}'=v_component->>'work_event_id'
            and s.value->>'date'=v_component->>'date' and s.value->>'start'=v_component->>'start'
            and s.value->>'end'=v_component->>'end' and s.value->>'overnight'=v_component->>'overnight'
            and (s.value->>'break_mins')::integer=(v_component->>'break_minutes')::integer
            and (s.value#>>'{weekly_source,pay_vector,total_pence}')::numeric/100=(v_component->>'pay_ex_vat')::numeric
            and (s.value#>>'{weekly_source,charge_vector,total_pence}')::numeric/100=(v_component->>'charge_ex_vat')::numeric
            and not exists(select 1 from pg_catalog.jsonb_array_elements(v_context->'protected_decisions') d(value)
              where d.value->>'work_event_id'=v_component->>'work_event_id' and d.value->>'state' in ('WAIT','NOT_WORKED'));
        if v_match<>1 or v_component->'source_provenance' is distinct from pg_catalog.jsonb_build_object(
          'movement_id',v_source#>>'{weekly_source,movement_id}','final_revision_id',v_source#>>'{weekly_source,final_revision_id}',
          'row_resolution_id',v_source#>>'{weekly_source,row_resolution_id}','economic_snapshot_id',v_source#>>'{weekly_source,economic_snapshot_id}',
          'calculation_fingerprint',v_source#>>'{weekly_source,calculation_fingerprint}') then
          raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_IMPORTED_SOURCE_NOT_EXACT';
        end if;
      end if;
      foreach v_bucket in array array['hours','rates','charge_rates'] loop
        if pg_catalog.jsonb_typeof(v_component->v_bucket)<>'object'
           or not private.weekly_exceptional_json_keys_exact_v1(v_component->v_bucket,array['day','night','sat','sun','bh'])
           or not ((v_component->v_bucket) ?& array['day','night','sat','sun','bh']) then
          raise exception using errcode='22023',message='BPAY_NEXT_PROTECTED_BUCKET_INVALID';
        end if;
      end loop;
      foreach v_bucket in array array['day','night','sat','sun','bh'] loop
        if pg_catalog.jsonb_typeof(v_component#>array['hours',v_bucket]) is distinct from 'string'
           or v_component#>>array['hours',v_bucket] !~ '^(0|[1-9][0-9]*)\.[0-9]{6}$'
           or pg_catalog.jsonb_typeof(v_component#>array['rates',v_bucket]) not in ('string','null')
           or pg_catalog.jsonb_typeof(v_component#>array['charge_rates',v_bucket]) not in ('string','null')
           or (v_component#>array['rates',v_bucket]<>'null'::jsonb
             and v_component#>>array['rates',v_bucket] !~ '^-?(0|[1-9][0-9]*)\.[0-9]{6}$')
           or (v_component#>array['charge_rates',v_bucket]<>'null'::jsonb
             and v_component#>>array['charge_rates',v_bucket] !~ '^-?(0|[1-9][0-9]*)\.[0-9]{6}$') then
          raise exception using errcode='22023',message='BPAY_NEXT_PROTECTED_DECIMAL_TEXT_REQUIRED';
        end if;
        v_hours:=(v_component#>>array['hours',v_bucket])::numeric;
        v_rate:=(v_component#>>array['rates',v_bucket])::numeric;
        v_charge_rate:=(v_component#>>array['charge_rates',v_bucket])::numeric;
        if pg_catalog.jsonb_typeof(v_component#>array['hours',v_bucket])<>'string'
           or v_hours is null or v_hours<0 or v_hours<>pg_catalog.round(v_hours,6)
           or ((v_component->>'protected')::boolean and v_hours<>0 and v_rate is null)
           or (v_rate is not null and v_rate<>pg_catalog.round(v_rate,6))
           or (v_charge_rate is not null and v_charge_rate<>pg_catalog.round(v_charge_rate,6)) then
          raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_USED_RATE_INVALID';
        end if;
        if not (v_component->>'protected')::boolean then
          if v_hours is distinct from (v_source#>>array['weekly_source','pay_vector','hours',v_bucket])::numeric
             or v_rate is distinct from (v_source#>>array['weekly_source','pay_vector','rates',v_bucket])::numeric
             or v_charge_rate is distinct from (v_source#>>array['weekly_source','charge_vector','rates',v_bucket])::numeric then
            raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_IMPORTED_RATE_NOT_EXACT';
          end if;
        else
          if v_hours<>0 and not exists(select 1 from private.bpay_next_contract_rate_rows_v1(
            v_contract.rates_json,v_contract.bucket_labels_json,v_contract.additional_rates_json,
            v_contract.mileage_pay_rate,v_contract.mileage_charge_rate) r where r.rate_family='STANDARD'
              and r.rate_code=upper(v_bucket) and v_rate=case upper(v_contract.pay_method_snapshot)
                when 'PAYE' then r.paye_rate else r.umbrella_rate end and v_charge_rate=r.charge_rate) then
            raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_CALCULATED_RATE_NOT_EXACT';
          end if;
        end if;
      end loop;
      v_n:=0;
      for v_break in select value from pg_catalog.jsonb_array_elements(v_component->'breaks') loop
        if not private.weekly_exceptional_json_keys_exact_v1(v_break,array['start','end','minutes'])
           or not (v_break ?& array['start','end','minutes'])
           or v_break->>'start' !~ '^([01][0-9]|2[0-3]):[0-5][0-9]$'
           or v_break->>'end' !~ '^([01][0-9]|2[0-3]):[0-5][0-9]$'
           or (v_break->>'minutes')::integer<=0 then
          raise exception using errcode='22023',message='BPAY_NEXT_PROTECTED_BREAK_INVALID';
        end if;
        if (v_break->>'minutes')::integer is distinct from
          ((extract(epoch from ((v_break->>'end')::time-(v_break->>'start')::time))/60)::integer
            +case when (v_break->>'end')::time<(v_break->>'start')::time then 1440 else 0 end) then
          raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_BREAK_DURATION_NOT_EXACT';
        end if;
        v_n:=v_n+(v_break->>'minutes')::integer;
      end loop;
      if v_n<>0 and v_n<>(v_component->>'break_minutes')::integer then
        raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_BREAK_NOT_EXACT';
      end if;
    end if;
    v_total:=v_total+(v_component->>'pay_ex_vat')::numeric;
  end loop;
  if v_evidence is not null then
    select t.* into strict v_evidence_row from public.timesheets t where t.timesheet_id=v_evidence
      and t.contract_id=v_family.contract_id and t.week_ending_date=v_family.week_ending_date
      and t.sheet_scope='WEEKLY'::public.timesheet_scope_enum and t.is_current
      and t.revoked_at is null and t.archived_at_utc is null for key share;
    v_signed:=private.weekly_exceptional_candidate_signed_evidence_v1(v_evidence);
  end if;
  select coalesce(pg_catalog.array_agg(i.id order by i.id),'{}'::uuid[]) into v_issue_ids
    from public.weekly_discrepancy_incidents i where i.source_group_id=v_group.id
      and i.work_event_id=v_event and i.candidate_id=v_family.candidate_id and i.client_id=v_contract.client_id;
  v_issue_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_ISSUE_SET_V1',pg_catalog.to_jsonb(v_issue_ids));
  v_schedule_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_SCHEDULE_V1',p_request->'protected_schedule');
  v_source_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_SOURCE_PROPOSAL_V1',p_request->'source_proposal');
  v_policy_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_RATE_POLICY_V1',pg_catalog.jsonb_build_object(
    'contract_id',v_contract.id,'rates_json',v_contract.rates_json,'policy',v_policy,'classification',p_request->'rate_classification'));
  v_target_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',p_request->'target_snapshot');
  v_approval_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_NEXT_APPROVAL_V1',pg_catalog.jsonb_build_object(
    'family_id',v_family.id,'work_event_id',v_event,'schedule_hash',pg_catalog.encode(v_schedule_hash,'hex'),
    'source_hash',pg_catalog.encode(v_source_hash,'hex'),'policy_hash',pg_catalog.encode(v_policy_hash,'hex'),
    'target_hash',pg_catalog.encode(v_target_hash,'hex'),'actor_user_id',v_actor,'reason',v_reason));
  if v_family.current_generation_id is null then
    if v_run.request_kind<>'APPROVE' then raise exception using errcode='55000',message='BPAY_NEXT_PROTECTED_INITIAL_ACTION_INVALID'; end if;
    v_prior_vector:=pg_catalog.jsonb_build_object('schema_version','WEEKLY_PROTECTED_NEXT_TARGET_V1','components','[]'::jsonb);
    v_generation_reason:='INITIAL_APPROVAL';
  else
    select g.complete_next_vector_json into strict v_prior_vector from public.weekly_exceptional_pay_generations g
      where g.id=v_family.current_generation_id and g.family_id=v_family.id and g.lifecycle_state='PUBLISHED' for share;
    v_generation_reason:=case v_run.request_kind when 'AMEND' then 'OFFICE_AMENDMENT' else v_run.request_kind end;
  end if;
  v_prior_vector_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',v_prior_vector);
  v_state:=case when v_run.request_kind in ('APPROVE','AMEND') then 'WAIT'
    when v_run.request_kind in ('WITHDRAW','RECONCILE') then 'ACCEPTED_SOURCE' else 'NOT_WORKED' end;
  v_lifecycle:=case when exists(select 1 from pg_catalog.jsonb_array_elements(v_context->'protected_decisions') d(value)
      where d.value->>'state'='WAIT') then 'WAITING_SOURCE' when v_state='NOT_WORKED' then 'NOT_WORKED' else 'RECONCILED' end;
  if p_validate_only then
    return jsonb_build_object('version','SOURCE_NATIVE_VALIDATED_REQUEST_V1','route','NEXT',
      'family_id',v_family.id,'orchestration_run_id',v_run.id,'native_request_sha256',encode(v_request_hash,'hex'),
      'target_snapshot',p_request->'target_snapshot');
  end if;
  insert into public.weekly_exceptional_payment_approvals(pay_target_family_id,work_event_id,evidence_timesheet_id,
    candidate_id,client_id,contract_id,week_ending,protected_work_date,protected_start_at_local,protected_end_at_local,
    protected_break_minutes,signed_submission_timesheet_id,signed_submission_revision,signed_submission_hash,signed_at_utc,
    contributing_issue_episode_ids,contributing_issue_episode_ids_hash,signed_schedule_fact_hash,
    contract_rate_policy_source_fingerprint,approved_by_user_id,approval_reason,source_cycle_id,comparison_revision_id,
    final_revision_id,approved_target_pay_components_json,approved_target_gross,creation_orchestration_run_id,
    approval_hash,creation_idempotency_key)
  values(v_family.id,v_event,v_evidence,v_family.candidate_id,v_contract.client_id,v_contract.id,v_family.week_ending_date,
    v_work_date,(p_request#>>'{protected_schedule,start_at_local}')::timestamp,(p_request#>>'{protected_schedule,end_at_local}')::timestamp,
    (p_request#>>'{protected_schedule,break_minutes}')::integer,v_evidence,(v_signed->>'timesheet_version')::integer,
    case when v_evidence is null then null else private.weekly_exceptional_hex_sha256_v1(v_signed->>'signature_sha256') end,
    (v_signed->>'signed_at_utc')::timestamptz,
    v_issue_ids,v_issue_hash,v_schedule_hash,v_policy_hash,v_actor,v_reason,v_cycle.id,
    nullif(p_request->>'current_comparison_revision_id','')::uuid,nullif(p_request->>'current_final_revision_id','')::uuid,
    p_request->'target_snapshot',v_total,v_run.id,v_approval_hash,v_key||':approval') returning * into v_approval;
  insert into public.weekly_exceptional_pay_generations(family_id,generation_number,prior_generation_id,prior_generation_hash,
    request_idempotency_key,reason,complete_prior_vector_json,complete_prior_vector_hash,complete_next_vector_json,
    complete_next_vector_hash,fixed_target_source_state_fingerprint,lifecycle_state)
  values(v_family.id,v_family.current_generation_number+1,v_family.current_generation_id,
    case when v_family.current_generation_id is null then null else v_prior_vector_hash end,v_key||':generation',
    v_generation_reason,v_prior_vector,v_prior_vector_hash,p_request->'target_snapshot',v_target_hash,v_source_hash,'READY_TO_STAGE')
  returning * into v_generation;
  -- Existing UNIQUE(family_id,event_sequence) indexes provide a one-row
  -- backward tail probe while the exact family mutex is held; no history aggregate.
  select e.event_sequence,e.event_hash into v_event_sequence,v_prior_event_hash
    from public.weekly_exceptional_pay_family_events e where e.family_id=v_family.id
    order by e.event_sequence desc limit 1;
  v_event_sequence:=coalesce(v_event_sequence,0)+1;
  v_event_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_FAMILY_EVENT_V1',pg_catalog.jsonb_build_object(
    'family_id',v_family.id,'event_sequence',v_event_sequence,'work_event_id',v_event,'approval_id',v_approval.id,
    'target_vector_hash',pg_catalog.encode(v_target_hash,'hex'),'prior_event_hash',pg_catalog.encode(v_prior_event_hash,'hex')));
  insert into public.weekly_exceptional_pay_family_events(family_id,event_sequence,durable_work_event_id,evidence_approval_id,
    work_date,start_at_local,end_at_local,break_minutes,rate_classification_json,source_proposal_snapshot_json,source_proposal_hash,
    fixed_office_target_snapshot_json,fixed_office_target_hash,state,current_comparison_revision_id,current_final_revision_id,
    office_actor_user_id,office_reason,prior_event_hash,event_hash)
  values(v_family.id,v_event_sequence,v_event,v_approval.id,v_work_date,v_approval.protected_start_at_local,
    v_approval.protected_end_at_local,v_approval.protected_break_minutes,p_request->'rate_classification',p_request->'source_proposal',
    v_source_hash,p_request->'protected_schedule',v_schedule_hash,v_state,v_approval.comparison_revision_id,v_approval.final_revision_id,
    v_actor,v_reason,v_prior_event_hash,v_event_hash) returning id into v_family_event_id;
  if (select active_owner from private.bpay_next_module_control where id=1)='NEXT' then
    perform private.bpay_next_protected_current_decision_capture_v1(v_family_event_id);
  end if;
  select e.event_sequence,e.event_hash into v_target_sequence,v_prior_target_hash
    from public.weekly_exceptional_pay_target_events e where e.family_id=v_family.id
    order by e.event_sequence desc limit 1;
  v_target_sequence:=coalesce(v_target_sequence,0)+1;
  v_audit_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_NEXT_TARGET_EVENT_V1',pg_catalog.jsonb_build_object(
    'family_id',v_family.id,'approval_id',v_approval.id,'generation_id',v_generation.id,'prior_hash',pg_catalog.encode(v_prior_target_hash,'hex'),
    'target_hash',pg_catalog.encode(v_target_hash,'hex')));
  insert into public.weekly_exceptional_pay_target_events(family_id,approval_id,event_sequence,triggering_comparison_revision_id,
    triggering_final_revision_id,prior_event_fingerprint,fixed_target_component_snapshot,current_source_proposal_snapshot,
    complete_prior_family_vector_fingerprint,complete_next_family_vector_fingerprint,reason,resulting_lifecycle_state,
    financial_generation_id,actor_user_id,event_hash,idempotency_key)
  values(v_family.id,v_approval.id,v_target_sequence,v_approval.comparison_revision_id,v_approval.final_revision_id,v_prior_target_hash,
    p_request->'target_snapshot',p_request->'source_proposal',v_prior_vector_hash,v_target_hash,v_generation_reason,v_lifecycle,
    v_generation.id,v_actor,v_audit_hash,v_key||':target-event');
  update public.weekly_exceptional_pending_reconciliation_targets t set state=case when v_run.request_kind='WITHDRAW'
    then 'WITHDRAWN' else 'CONSUMED' end,completed_at_utc=pg_catalog.transaction_timestamp()
    where t.family_id=v_family.id and t.durable_work_event_id=v_event and t.state='ACTIVE';
  if v_state='WAIT' then
    insert into public.weekly_exceptional_pending_reconciliation_targets(family_id,approval_id,durable_work_event_id,incident_id,
      current_final_revision_id,intended_outcome,source_action_policy_target_fingerprint,state)
    values(v_family.id,v_approval.id,v_event,(select i.id from public.weekly_discrepancy_incidents i
      where i.source_group_id=v_group.id and i.work_event_id=v_event order by i.episode_number desc limit 1),
      v_approval.final_revision_id,'WAIT',v_source_hash,'ACTIVE');
  end if;
  select s.* into strict v_stage from private.bpay_next_stage_protected_source_v1(
    v_approval.id,v_generation.id,v_root.timesheet_id,v_components) s;
  -- All Source/family/work/revision locks precede the agency clock receipt.
  if p_source_decision_preparation_id is null then
    select p.* into strict v_publication from private.bpay_next_publish_source_staged_pair_v1(
      array[v_stage.work_id],array[v_stage.revision_id],array[v_approval.id]) p;
  end if;
  if v_family.current_generation_id is not null then
    update public.weekly_exceptional_pay_generations set lifecycle_state='SUPERSEDED',
      superseded_by_generation_id=v_generation.id,superseded_at_utc=pg_catalog.transaction_timestamp()
      where id=v_family.current_generation_id and lifecycle_state='PUBLISHED';
  end if;
  update public.weekly_exceptional_pay_generations set lifecycle_state='PUBLISHED',
    published_at_utc=pg_catalog.transaction_timestamp(),result_hash=v_request_hash where id=v_generation.id;
  update public.weekly_exceptional_pay_target_families set ownership_state='TARGET_MANAGED',target_domain_version='NEXT_V1',
    current_generation_id=v_generation.id,current_generation_number=v_generation.generation_number,
    current_complete_target_vector_hash=v_target_hash,current_source_proposal_hash=v_source_hash,
    current_lifecycle_state=v_lifecycle,current_component_count=pg_catalog.jsonb_array_length(v_components),
    bound_version=bound_version+1 where id=v_family.id;
  update public.weekly_exceptional_orchestration_runs set state='COMPLETE',after_state_fingerprint=v_request_hash,
    completed_at_utc=pg_catalog.transaction_timestamp() where id=v_run.id;
  if p_source_decision_preparation_id is null then
  insert into private.bpay_next_protected_source_receipt(orchestration_run_id,family_id,actor_user_id,approval_id,generation_id,
    work_id,revision_id,command_id,agency_sequence,accepted_family_bound_version,prepared_request_sha256,
    publication_request_sha256,source_manifest_sha256)
  values(v_run.id,v_family.id,v_actor,v_approval.id,v_generation.id,v_stage.work_id,v_stage.revision_id,v_publication.command_id,
    v_publication.agency_sequence,v_family.bound_version+1,v_run.request_fingerprint,v_request_hash,v_source_hash);
  else
    v_source_control:=jsonb_build_object('family_id',v_family.id,'orchestration_run_id',v_run.id,
      'approval_id',v_approval.id,'generation_id',v_generation.id,'work_id',v_stage.work_id,'revision_id',v_stage.revision_id,
      'new_family_bound_version',(v_family.bound_version+1)::text,
      'approved_pay_ex_vat',to_char(v_total,'FM9999999999999990.00'),'source_manifest_sha256',encode(v_source_hash,'hex'));
    select jsonb_build_object('version','SOURCE_NATIVE_COMPOSED_RESULT_V1','application_id',v_source_application_id,
      'decision_id',p.decision_id,'request_id',p.accept_or_resume_request_id,'review_id',p.review_id,
      'member_key',p.member_key,'preparation_id',p.id,'route','NEXT','origin','APPLIED_IN_THIS_TRANSACTION',
      'control_status','WITHDRAWN','native_receipt',v_source_control,'failure_code',null)
      into strict v_source_result from private.weekly_source_pay_decision_unprotect_preparations p where p.id=p_source_decision_preparation_id;
    insert into public.weekly_exceptional_payment_events(family_id,approval_id,event_kind,lifecycle_view,bounded_payload_json,idempotency_key)
      values(v_family.id,v_approval.id,'PROTECTED_STATE_OBSERVED','LIVE',v_source_result,v_key||':payment-event');
    select coalesce(max(s.sequence),0)+1 into v_step from public.weekly_exceptional_orchestration_steps s where s.orchestration_run_id=v_run.id;
    insert into public.weekly_exceptional_orchestration_steps(orchestration_run_id,sequence,step_kind,idempotency_key,
      allowlisted_owner_name,allowlisted_owner_signature,bounded_request_hash,before_state_fingerprint,bounded_owner_response_json,
      owner_response_hash,after_state_fingerprint,outcome,completed_at_utc)
      values(v_run.id,v_step,'PUBLISH_NEXT',v_key,'private.weekly_exceptional_pay_publish_next_impl_v1','jsonb,uuid->jsonb',
        v_request_hash,v_run.before_state_fingerprint,v_source_result,
        private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_COMPOSED_RESULT_V1',v_source_result),v_request_hash,'COMPLETE',transaction_timestamp());
    return private.weekly_source_pay_decision_record_native_adoption_v1(
      p_source_decision_preparation_id,v_source_application_id,v_source_control);
  end if;
  insert into public.weekly_exceptional_payment_events(family_id,approval_id,event_kind,lifecycle_view,bounded_payload_json,idempotency_key)
  values(v_family.id,v_approval.id,case when v_state='WAIT' then 'APPROVED' when v_state='NOT_WORKED' then 'RECORDED_NOT_WORKED'
    else 'MATCH_ACCEPTED' end,'NEXT_PUBLISHED',pg_catalog.jsonb_build_object('work_event_id',v_event,'generation_id',v_generation.id,
      'approval_id',v_approval.id,'revision_id',v_stage.revision_id,'command_id',v_publication.command_id,
      'approved_pay_ex_vat',v_total::text),v_key||':payment-event');
  select coalesce(max(s.sequence),0)+1 into v_step from public.weekly_exceptional_orchestration_steps s where s.orchestration_run_id=v_run.id;
  insert into public.weekly_exceptional_orchestration_steps(orchestration_run_id,sequence,step_kind,idempotency_key,
    allowlisted_owner_name,allowlisted_owner_signature,bounded_request_hash,before_state_fingerprint,bounded_owner_response_json,
    owner_response_hash,after_state_fingerprint,outcome,completed_at_utc)
  values(v_run.id,v_step,'PUBLISH_NEXT',v_key,'public.weekly_exceptional_pay_publish_next_v1','jsonb->jsonb',v_request_hash,
    v_run.before_state_fingerprint,private.bpay_next_protected_receipt_json_v1(v_run.id,false),v_request_hash,v_request_hash,
    'COMPLETE',pg_catalog.transaction_timestamp());
  if (select active_owner from private.bpay_next_module_control where id=1)='NEXT' then
    perform private.bpay_next_workbench_refresh_work_v1(v_stage.work_id);
  end if;
  return private.bpay_next_protected_receipt_json_v1(v_run.id,false);
exception when no_data_found or too_many_rows then
  raise exception using errcode='55000',message='BPAY_NEXT_PROTECTED_SCOPE_INVALID';
end
$function$;

revoke all on function private.weekly_source_protected_next_engine_v1(jsonb,uuid,boolean)
 from public,anon,authenticated,service_role;

create or replace function private.weekly_source_pay_decision_native_next_payload_validate_v1(p_request jsonb,p_preparation_id uuid)
returns jsonb language sql volatile security definer set search_path=pg_catalog,private,public as $function$
 select private.weekly_source_protected_next_engine_v1(p_request,p_preparation_id,true);
$function$;
revoke all on function private.weekly_source_pay_decision_native_next_payload_validate_v1(jsonb,uuid)
 from public,anon,authenticated,service_role;

create or replace function private.weekly_exceptional_pay_publish_next_impl_v1(p_request jsonb,p_source_decision_preparation_id uuid)
returns jsonb language sql volatile security definer set search_path=pg_catalog,private,public as $function$
 select private.weekly_source_protected_next_engine_v1(p_request,p_source_decision_preparation_id,false);
$function$;
revoke all on function private.weekly_exceptional_pay_publish_next_impl_v1(jsonb,uuid)
 from public,anon,authenticated,service_role;

create or replace function public.weekly_exceptional_pay_publish_next_v1(p_request jsonb)
returns jsonb language sql volatile security definer set search_path=pg_catalog,private,public as $function$
 select private.weekly_exceptional_pay_publish_next_impl_v1(p_request,null);
$function$;
revoke all on function public.weekly_exceptional_pay_publish_next_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_exceptional_pay_publish_next_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/16_native_next_implementation.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/17_source_composed_owner_route.sqlinc
-- Pure owner discrimination for a real Source-composed current generation.
-- This is not normal native status and does not assert published money before
-- the canonical Source application/publication has committed.
create or replace function private.weekly_source_pay_decision_family_native_route_v1(p_family_id uuid,p_generation_id uuid)
returns text language plpgsql stable security definer
set search_path=pg_catalog,private,public as $function$
declare adoption private.weekly_source_pay_decision_native_adoptions%rowtype;
 app private.weekly_source_pay_decision_acceptance_applications%rowtype;
 prep private.weekly_source_pay_decision_unprotect_preparations%rowtype;
 family public.weekly_exceptional_pay_target_families%rowtype;
 run public.weekly_exceptional_orchestration_runs%rowtype;
 approval public.weekly_exceptional_payment_approvals%rowtype;
 generation public.weekly_exceptional_pay_generations%rowtype;
 revision private.bpay_next_work_revision%rowtype;work private.bpay_next_work%rowtype;placement jsonb;
begin
 if not exists(select 1 from private.weekly_source_pay_decision_native_adoptions a
   join private.weekly_source_pay_decision_unprotect_preparations p on p.id=a.preparation_id
   where a.generation_id=p_generation_id and p.family_id=p_family_id and a.origin='APPLIED_IN_THIS_TRANSACTION') then return null;end if;
 select a.* into strict adoption from private.weekly_source_pay_decision_native_adoptions a
  join private.weekly_source_pay_decision_unprotect_preparations p on p.id=a.preparation_id
  where a.generation_id=p_generation_id and p.family_id=p_family_id and a.origin='APPLIED_IN_THIS_TRANSACTION';
 select x.* into strict app from private.weekly_source_pay_decision_acceptance_applications x where x.id=adoption.application_id;
 select x.* into strict prep from private.weekly_source_pay_decision_unprotect_preparations x where x.id=adoption.preparation_id;
 select x.* into strict family from public.weekly_exceptional_pay_target_families x where x.id=p_family_id;
 select x.* into strict run from public.weekly_exceptional_orchestration_runs x where x.id=adoption.orchestration_run_id;
 select x.* into strict approval from public.weekly_exceptional_payment_approvals x where x.id=adoption.approval_id;
 select x.* into strict generation from public.weekly_exceptional_pay_generations x where x.id=p_generation_id;
 select x.* into strict revision from private.bpay_next_work_revision x where x.id=adoption.next_revision_id and x.work_id=adoption.next_work_id;
 select x.* into strict work from private.bpay_next_work x where x.id=revision.work_id;
 if adoption.route<>'NEXT' or prep.route<>'NEXT' or prep.state<>'CONSUMED'
  or prep.native_receipt_json is distinct from adoption.native_result_json
  or adoption.native_result_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_COMPOSED_RESULT_V1',adoption.native_result_json)
  or adoption.native_result_json->>'application_id' is distinct from app.id::text
  or adoption.native_result_json->>'preparation_id' is distinct from prep.id::text
  or adoption.native_result_json->>'control_status' is distinct from 'WITHDRAWN'
  or app.request_id is distinct from prep.accept_or_resume_request_id or app.decision_id is distinct from prep.decision_id
  or app.review_id is distinct from prep.review_id or app.actor_user_id is distinct from prep.actor_user_id
  or (app.state<>'COMMITTED' and (app.state not in('PREVALIDATED','STAGED')
    or app.backend_pid<>pg_backend_pid() or app.transaction_id is distinct from pg_current_xact_id_if_assigned()))
  or family.current_generation_id is distinct from generation.id or family.target_domain_version<>'NEXT_V1'
  or generation.family_id is distinct from family.id or generation.lifecycle_state<>'PUBLISHED'
  or generation.published_at_utc is null or generation.result_hash is distinct from run.after_state_fingerprint
  or generation.result_hash is distinct from private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_NEXT_PUBLISH_V1',prep.payload_json->'publish_request')
  or run.id is distinct from prep.orchestration_run_id or run.family_id is distinct from family.id or run.state<>'COMPLETE'
  or run.requested_by_user_id is distinct from prep.actor_user_id or run.request_fingerprint is distinct from prep.native_prepare_request_sha256
  or approval.creation_orchestration_run_id is distinct from run.id or approval.pay_target_family_id is distinct from family.id
  or revision.source_kind<>'PROTECTED' or revision.source_event_id is distinct from approval.id or revision.source_head_id is not null
  or revision.financial_snapshot_id is not null or work.candidate_id is distinct from family.candidate_id
  or exists(select 1 from private.bpay_next_protected_source_receipt r where r.generation_id=generation.id)
  or exists(select 1 from private.weekly_source_local_protected_decision_receipts r where r.generation_id=generation.id) then
  raise exception 'SOURCE_NATIVE_OWNER_CONFLICT' using errcode='23514';end if;
 placement:=private.weekly_source_protected_current_placement_v1(family.id,approval.work_event_id,false);
 if work.contract_id::text is distinct from placement->>'current_contract_id'
  or revision.physical_timesheet_id::text is distinct from placement->>'current_timesheet_id' then
  raise exception 'SOURCE_NATIVE_OWNER_CONFLICT' using errcode='23514';end if;
 if app.state='COMMITTED' then
  perform private.weekly_source_pay_decision_publication_adoptions_assert_v1(app.id);
  if not exists(select 1 from private.bpay_next_source_pay_decision_publication p
    join private.bpay_next_command c on c.id=p.command_id
    join private.bpay_next_command_member cm on cm.command_id=c.id and cm.candidate_id=p.candidate_id
    where p.application_id=app.id and p.decision_id=app.decision_id and p.cut_id=app.cut_id and p.candidate_id=family.candidate_id
     and c.command_kind='SOURCE_PAY_DECISION_APPLY' and c.status in('SEALED','COMPLETE') and c.sealed_at_utc is not null) then
   raise exception 'SOURCE_NATIVE_OWNER_CONFLICT' using errcode='23514';end if;
 end if;
 return 'NEXT';
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'SOURCE_NATIVE_OWNER_CONFLICT' using errcode='23514';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_family_native_route_v1(uuid,uuid)
 from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/17_source_composed_owner_route.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/19_exact_local_head_capture.sqlinc
-- This predicate runs at the actual native receipt INSERT, before adoption can
-- exist. It grants no financial authority and never stages/publishes/binds.
create or replace function private.weekly_source_pay_decision_local_head_owned_v1(p_receipt_id uuid)
returns boolean language plpgsql stable security definer
set search_path=pg_catalog,private,public as $function$
declare receipt private.weekly_source_entitlement_publication_receipts%rowtype;
 head public.weekly_source_entitlement_heads%rowtype;
 local_row private.weekly_source_local_protected_decision_receipts%rowtype;
 request public.weekly_exceptional_c1_publication_requests%rowtype;
 run public.weekly_exceptional_orchestration_runs%rowtype;
 family public.weekly_exceptional_pay_target_families%rowtype;
 prep private.weekly_source_pay_decision_unprotect_preparations%rowtype;
 app private.weekly_source_pay_decision_acceptance_applications%rowtype;
 adoption private.weekly_source_pay_decision_native_adoptions%rowtype;
 pending public.weekly_source_pending_entitlement_bundles%rowtype;
 step public.weekly_exceptional_orchestration_steps%rowtype;
 physical public.timesheets%rowtype;placement jsonb;origin jsonb;components jsonb;
 original_local jsonb;expected_control jsonb;count_rows integer;
begin
 select x.* into strict receipt from private.weekly_source_entitlement_publication_receipts x where x.id=p_receipt_id;
 -- Inspect the ENTIRE actual head set. A Source-owned head cannot hide inside
 -- an unrelated or two-root receipt and fall through to POSITION_APPLY.
 select count(*) into count_rows from public.weekly_source_entitlement_heads h
  join public.weekly_exceptional_c1_publication_requests r
   on r.id::text=h.source_origin_json->>'publication_request_id'
  join private.weekly_source_pay_decision_unprotect_preparations p on p.orchestration_run_id=r.orchestration_run_id
  where h.id=any(receipt.head_ids);
 if count_rows=0 then
  if exists(select 1 from private.weekly_source_local_protected_decision_receipts l
   join public.weekly_exceptional_c1_publication_requests r on r.id=l.publication_request_id
   join private.weekly_source_pay_decision_unprotect_preparations p on p.orchestration_run_id=r.orchestration_run_id
   where l.common_decision_bundle_id=receipt.decision_bundle_id and l.common_bundle_revision=receipt.bundle_revision) then
   raise exception 'SOURCE_LOCAL_HEAD_CAPTURE_INVALID' using errcode='23514';end if;
  return false;
 end if;
 if count_rows<>1 or cardinality(receipt.member_root_ids)<>1 or cardinality(receipt.head_ids)<>1
  or cardinality(receipt.member_family_booking_ids)<>1 or cardinality(receipt.member_root_versions)<>1 then
  raise exception 'SOURCE_LOCAL_HEAD_CAPTURE_INVALID' using errcode='23514';end if;
 select h.* into strict head from public.weekly_source_entitlement_heads h where h.id=receipt.head_ids[1];
 origin:=head.source_origin_json;
 select r.* into strict request from public.weekly_exceptional_c1_publication_requests r where r.id::text=origin->>'publication_request_id';
 select l.* into strict local_row from private.weekly_source_local_protected_decision_receipts l where l.publication_request_id=request.id;
 select p.* into strict prep from private.weekly_source_pay_decision_unprotect_preparations p where p.orchestration_run_id=request.orchestration_run_id;
 select a.* into strict app from private.weekly_source_pay_decision_acceptance_applications a where a.request_id=prep.accept_or_resume_request_id;
 select r.* into strict run from public.weekly_exceptional_orchestration_runs r where r.id=request.orchestration_run_id;
 select f.* into strict family from public.weekly_exceptional_pay_target_families f where f.id=prep.family_id;
 select t.* into strict physical from public.timesheets t where t.timesheet_id=local_row.root_timesheet_id;
 -- The same reviewed original family A remains immutable. The genuine current
 -- native financial placement B is separately certified by the direct H103.
 placement:=private.timesheet_contract_current_placement_v1(family.root_timesheet_id);
 if prep.route<>'SOURCE_LOCAL' or prep.family_id is distinct from request.family_id
  or prep.actor_user_id is distinct from local_row.actor_user_id or prep.actor_user_id is distinct from run.requested_by_user_id
  or prep.orchestration_run_id is distinct from run.id or request.generation_id is distinct from local_row.generation_id
  or local_row.family_id is distinct from family.id or run.family_id is distinct from family.id or run.request_kind<>'WITHDRAW'
  or run.idempotency_key is distinct from prep.child_idempotency_key or run.request_fingerprint is distinct from prep.native_prepare_request_sha256
  or app.decision_id is distinct from prep.decision_id or app.review_id is distinct from prep.review_id or app.actor_user_id is distinct from prep.actor_user_id
  or prep.payload_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_NATIVE_PAYLOAD_V1',prep.payload_json)
  or request.request_sha256 is distinct from private.weekly_exceptional_hex_sha256_v1(prep.payload_json#>>'{complete_request,expected_request_sha256}')
  or request.id::text is distinct from prep.payload_json#>>'{complete_request,publication_request_id}'
  or local_row.request_sha256 is distinct from request.request_sha256
  or local_row.idempotency_key is distinct from prep.child_idempotency_key||':local-complete'
  or physical.timesheet_id::text is distinct from placement->>'current_timesheet_id'
  or physical.contract_id::text is distinct from placement->>'current_contract_id'
  or physical.timesheet_id is distinct from receipt.member_root_ids[1]
  or physical.booking_id is distinct from receipt.member_family_booking_ids[1]
  or physical.version is distinct from receipt.member_root_versions[1]
  or request.root_timesheet_id is distinct from physical.timesheet_id or request.contract_id is distinct from physical.contract_id
  or receipt.candidate_id is distinct from family.candidate_id or request.candidate_id is distinct from family.candidate_id
  or head.candidate_id is distinct from family.candidate_id or head.contract_id is distinct from physical.contract_id
  or head.root_timesheet_id is distinct from physical.timesheet_id or head.root_family_booking_id is distinct from physical.booking_id
  or head.root_timesheet_version is distinct from physical.version or head.week_ending_date is distinct from family.week_ending_date
  or head.authority_kind<>'PROTECTED' or head.state not in('COMMITTED_CURRENT','SUPERSEDED')
  or head.decision_bundle_id is distinct from receipt.decision_bundle_id or head.bundle_revision is distinct from receipt.bundle_revision
  or local_row.common_decision_bundle_id is distinct from receipt.decision_bundle_id or local_row.common_bundle_revision is distinct from receipt.bundle_revision
  or local_row.publication_origin_kind<>'PROTECTED_LOCAL_DECISION_V1'
  or origin is distinct from private.weekly_source_local_origin_canonical_v2(local_row.approved_snapshot_json->'local_publication_origin')
  or origin->>'generation_id' is distinct from request.generation_id::text
  or origin->>'request_sha256' is distinct from encode(request.request_sha256,'hex')
  or origin->>'source_qualification_digest' is distinct from encode(local_row.source_qualification_digest,'hex')
  or head.source_generation_digest is distinct from local_row.publication_origin_digest
  or local_row.publication_origin_digest is distinct from private.weekly_source_publication_request_digest_v1(origin)
  or local_row.source_qualification_digest is distinct from private.weekly_source_sha256_jsonb_v1(
    'PROTECTED_LOCAL_SOURCE_QUALIFICATION_V2',local_row.approved_snapshot_json->'local_source_qualification')
  or local_row.approved_snapshot_json#>>'{local_source_qualification,publication_request_id}' is distinct from request.id::text
  or local_row.approved_snapshot_json#>>'{local_source_qualification,generation_id}' is distinct from request.generation_id::text
  or not exists(select 1 from public.weekly_exceptional_pay_generations g where g.id=request.generation_id and g.family_id=family.id
   and g.complete_next_vector_hash=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',g.complete_next_vector_json)
   and g.complete_next_vector_json#>'{target_snapshot,tsfin_snapshot_json}'=prep.payload_json#>'{stage_request,target_snapshot,tsfin_snapshot_json}') then
  raise exception 'SOURCE_LOCAL_HEAD_CAPTURE_INVALID' using errcode='23514';end if;
 select coalesce(jsonb_agg(private.weekly_source_publication_component_canonical_v1(
   (to_jsonb(c)-array['id','head_id','decision_bundle_id','bundle_revision','component_sha256','created_at_utc'])
   ||jsonb_build_object('work_date',to_char(c.work_date,'YYYY-MM-DD'),'hours_day',c.hours_day::text,'hours_night',c.hours_night::text,
    'hours_sat',c.hours_sat::text,'hours_sun',c.hours_sun::text,'hours_bh',c.hours_bh::text,'unit_count',c.unit_count::text,
    'unit_pay_rate',c.unit_pay_rate::text,'unit_charge_rate',c.unit_charge_rate::text,'pay_ex_vat',c.pay_ex_vat::text,
    'charge_ex_vat',c.charge_ex_vat::text),'source.local.capture.component') order by c.component_ordinal),'[]'::jsonb)
  into components from public.weekly_source_entitlement_head_components c where c.head_id=head.id;
 if jsonb_array_length(components)<>head.component_count or local_row.approved_snapshot_json->>'common_components_digest'
  is distinct from encode(private.weekly_source_publication_request_digest_v1(components),'hex') then
  raise exception 'SOURCE_LOCAL_HEAD_CAPTURE_INVALID' using errcode='23514';end if;
 if local_row.state='PREPARING' then
  if prep.state<>'PREPARED' or receipt.publication_mode<>'IMMEDIATE' or receipt.pending_bundle_id is not null
   or local_row.preparing_transaction_id is distinct from pg_current_xact_id()
   or request.state<>'READY' or run.state<>'RUNNING'
   or private.weekly_source_pay_decision_native_request_scope_v1(prep.id,prep.payload_json->'complete_request','COMPLETE_LOCAL',true)
      is distinct from app.id then raise exception 'SOURCE_LOCAL_HEAD_CAPTURE_INVALID' using errcode='23514';end if;
 else
  -- The native coordinator inserts the real receipt while its leased pending
  -- row is RELEASING. Its own later RELEASED callback proves/completes the same
  -- receipt in this outer transaction; no fresh Office decision is invented.
  select a.* into strict adoption from private.weekly_source_pay_decision_native_adoptions a
   where a.application_id=app.id and a.member_key=prep.member_key;
  select p.* into strict pending from public.weekly_source_pending_entitlement_bundles p where p.id=adoption.pending_bundle_id;
  select s.* into strict step from public.weekly_exceptional_orchestration_steps s
   where s.orchestration_run_id=run.id and s.step_kind='COMPLETE_LOCAL_PROTECTED_DECISION';
  expected_control:=adoption.native_result_json->'native_receipt';
  original_local:=to_jsonb(local_row)||jsonb_build_object('state','PENDING_FREEZE','result_json',step.bounded_owner_response_json);
  if app.state<>'COMMITTED' or prep.state<>'CONSUMED' or adoption.origin<>'APPLIED_IN_THIS_TRANSACTION'
   or adoption.route<>'SOURCE_LOCAL' or adoption.local_entitlement_kind<>'PENDING_BUNDLE'
   or adoption.preparation_id is distinct from prep.id or adoption.local_publication_request_id is distinct from request.id
   or local_row.state<>'PENDING_FREEZE' or request.state<>'RETIRED' or run.state<>'COMPLETE'
   or receipt.publication_mode<>'DEFERRED' or receipt.pending_bundle_id is distinct from pending.id
   or pending.state<>'RELEASING' or pending.lease_owner is distinct from receipt.released_by_worker_id
   or pending.lease_worker_run_id is distinct from receipt.released_by_worker_run_id or pending.lease_expires_at_utc<=statement_timestamp()
   or pending.decision_bundle_id is distinct from receipt.decision_bundle_id or pending.bundle_revision is distinct from receipt.bundle_revision
   or pending.request_digest is distinct from receipt.request_digest or pending.candidate_id is distinct from receipt.candidate_id
   or pending.member_root_ids is distinct from receipt.member_root_ids or pending.member_family_booking_ids is distinct from receipt.member_family_booking_ids
   or pending.member_root_versions is distinct from receipt.member_root_versions or pending.proposed_head_ids is distinct from receipt.head_ids
   or step.outcome<>'PENDING' or step.idempotency_key is distinct from local_row.idempotency_key
   or step.allowlisted_owner_name<>'CloudTMS.weekly_exceptional_pay_complete_local_v1' or step.allowlisted_owner_signature<>'jsonb'
   or step.bounded_request_hash is distinct from request.request_sha256 or step.before_state_fingerprint is distinct from run.before_state_fingerprint
   or step.completed_at_utc is null or step.bounded_owner_response_json is distinct from local_row.result_json
   or step.bounded_owner_response_json#>>'{publication,pending_bundle_verified}' is distinct from pending.id::text
   or step.owner_response_hash is distinct from private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_LOCAL_RESULT_V1',step.bounded_owner_response_json)
   or step.owner_response_hash is distinct from private.weekly_exceptional_hex_sha256_v1(expected_control->>'native_result_sha256')
   or step.after_state_fingerprint is distinct from step.owner_response_hash or run.after_state_fingerprint is distinct from step.owner_response_hash
   or private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_COMPOSED_RESULT_V1',adoption.native_result_json) is distinct from adoption.native_result_sha256
   or private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_LOCAL_RECEIPT_ROW_V1',original_local)
      is distinct from private.weekly_exceptional_hex_sha256_v1(expected_control->>'local_receipt_sha256') then
   raise exception 'SOURCE_LOCAL_HEAD_CAPTURE_INVALID' using errcode='23514';end if;
 end if;
 return true;
exception when no_data_found or too_many_rows or invalid_text_representation or numeric_value_out_of_range then
 raise exception 'SOURCE_LOCAL_HEAD_CAPTURE_INVALID' using errcode='23514';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_local_head_owned_v1(uuid) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/19_exact_local_head_capture.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/20_native_local_stage_implementation.sqlinc
create or replace function private.weekly_source_protected_local_stage_engine_v1(
  p_request jsonb,p_source_decision_preparation_id uuid,p_validate_only boolean
) returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','extensions','pg_temp'
as $function$
declare
  v_source_gate jsonb;v_source_application_id uuid;v_placement jsonb;v_checked_placement jsonb;
  v_top_keys constant text[]:=array[
    'schema_version','actor_user_id','family_id','orchestration_run_id',
    'source_cycle_id','client_id','work_event_id','evidence_timesheet_id',
    'expected_family_bound_version','protected_schedule','rate_classification',
    'source_proposal','target_snapshot','current_comparison_revision_id',
    'current_final_revision_id','c1_request','c1_sources','c1_components',
    'reason','idempotency_key'
  ];
  v_c1_keys constant text[]:=array[
    'request_id','request_sequence','actor_user_id','candidate_id','contract_id',
    'root_timesheet_id','week_ending_date','source_mode',
    'expected_head_revision','expected_source_count','expected_component_count',
    'expected_payload_bytes','source_manifest_sha256','entitlement_sha256',
    'approval_sha256','is_zero_entitlement','financial_row_id','request_sha256'
  ];
  v_source_keys constant text[]:=array[
    'source_ordinal','source_id','authority_kind','source_system',
    'external_identity','external_revision','source_document_sha256',
    'payload_bytes','part_count','work_date','root_timesheet_id','candidate_id',
    'contract_id','source_row_sha256','record_type','parts'
  ];
  v_part_keys constant text[]:=array[
    'source_ordinal','part_ordinal','payload_utf8','fragment_sha256','record_type'
  ];
  v_component_keys constant text[]:=array[
    'component_ordinal','component_id','source_ordinal','source_key',
    'component_kind','economic_key_type','economic_key_value',
    'component_member_identity','segment_id','segment_key','segment_stable_key',
    'work_date','reference_number','hours_day','hours_night','hours_sat',
    'hours_sun','hours_bh','additional_code_raw','unit_count','unit_pay_rate',
    -- S7 (WB-007, WB-013, 24 section 5): `adjustment_id` is deliberately absent
    -- from this exact-key allowlist and from the C1 component relation.  An
    -- adjustment is never copied into a head, because an adjustment created
    -- later would make the snapshot stale and create a second owner.  A caller
    -- that still sends the key now fails closed here.
    'unit_charge_rate','expense_code','pay_ex_vat',
    'charge_ex_vat','exclude_from_pay','origin','component_sha256','record_type'
  ];
  v_schedule_keys constant text[]:=array[
    'work_date','start_at_local','end_at_local','break_minutes'
  ];
  v_actor_user_id uuid;
  v_family_id uuid;
  v_run_id uuid;
  v_source_cycle_id uuid;
  v_client_id uuid;
  v_work_event_id uuid;
  v_evidence_timesheet_id uuid;
  v_expected_bound_version bigint;
  v_comparison_revision_id uuid;
  v_final_revision_id uuid;
  v_reason text;
  v_idempotency_key text;
  v_schedule jsonb;
  v_rate_classification jsonb;
  v_source_proposal jsonb;
  v_selected_source_witness jsonb;
  v_target_snapshot jsonb;
  v_component_identity_context jsonb;
  v_component_identity_basis jsonb;
  v_bulk_signed_proof jsonb;
  v_automatic_reconcile_proof jsonb;
  v_start jsonb;
  v_sources jsonb;
  v_components jsonb;
  v_family public.weekly_exceptional_pay_target_families%rowtype;
  v_lock_family jsonb; v_lock_group uuid;
  v_run public.weekly_exceptional_orchestration_runs%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_root public.timesheets%rowtype;
  v_fin public.timesheets_financials%rowtype;
  v_evidence public.timesheets%rowtype;
  v_signed_evidence jsonb;
  v_event public.weekly_work_events%rowtype;
  v_prior_generation public.weekly_exceptional_pay_generations%rowtype;
  v_approval public.weekly_exceptional_payment_approvals%rowtype;
  v_generation public.weekly_exceptional_pay_generations%rowtype;
  v_publication public.weekly_exceptional_c1_publication_requests%rowtype;
  v_policy jsonb;
  v_source_mode text; v_activated_source_mode text;
  v_work_date date;
  v_start_at timestamp without time zone;
  v_end_at timestamp without time zone;
  v_break_minutes integer;
  v_expected_source_count integer;
  v_expected_component_count integer;
  v_expected_payload_bytes integer;
  v_request_sequence bigint;
  v_expected_head_revision bigint;
  v_financial_row_id uuid;
  v_request_id uuid;
  v_source_manifest_hash bytea;
  v_entitlement_hash bytea;
  v_outer_approval_hash bytea;
  v_c1_request_hash bytea;
  v_rate_policy_hash bytea;
  v_schedule_hash bytea;
  v_source_proposal_hash bytea;
  v_prior_vector jsonb;
  v_prior_vector_hash bytea;
  v_next_vector jsonb;
  v_next_vector_hash bytea;
  v_fixed_source_hash bytea;
  v_local_approval_hash bytea;
  v_family_event_hash bytea;
  v_target_event_hash bytea;
  v_prior_family_event_hash bytea;
  v_prior_target_event_hash bytea;
  v_issue_ids uuid[]:='{}'::uuid[];
  v_issue_ids_hash bytea;
  v_signed_revision integer;
  v_signed_hash bytea;
  v_signed_at timestamptz;
  v_generation_number integer;
  v_generation_reason text;
  v_family_event_state text;
  v_resulting_lifecycle_state text;
  v_pending_outcome text;
  v_payment_event_kind text;
  v_other_wait_count integer:=0;
  v_family_event_sequence bigint;
  v_family_event_id uuid;
  v_target_event_sequence bigint;
  v_total_pay numeric(12,2):=0;
  v_payload_total bigint:=0;
  v_previous_source_key text:=null;
  v_source_entry jsonb;
  v_part_entry jsonb;
  v_component_entry jsonb;
  v_source_id uuid;
  v_source_ordinal integer;
  v_source_counter integer:=0;
  v_part_ordinal integer;
  v_component_ordinal integer;
  v_part_payload bytea;
  v_part_concat bytea;
  v_source_part_count integer;
  v_source_payload_bytes integer;
  v_source_kind text;
  v_source_document jsonb;
  v_count_client integer:=0;
  v_count_candidate integer:=0;
  v_count_root integer:=0;
  v_count_provider integer:=0;
  v_count_office integer:=0;
  v_step_sequence integer;
  v_request_body_hash bytea;
  v_before_hash bytea;
  v_after_hash bytea;
begin
  if p_validate_only is null or (p_validate_only and p_source_decision_preparation_id is null) then
    raise exception 'SOURCE_NATIVE_VALIDATION_SCOPE_REQUIRED' using errcode='22023';end if;
  if not private.weekly_exceptional_json_keys_exact_v1(p_request,v_top_keys||array['bulk_signed_selection_proof','automatic_reconcile_selection_sha256'])
     or not (p_request ?& v_top_keys)
     or p_request->>'schema_version'<>'WEEKLY_PROTECTED_C1_STAGE_REQUEST_V1'
     or pg_catalog.jsonb_typeof(p_request->'protected_schedule')<>'object'
     or pg_catalog.jsonb_typeof(p_request->'rate_classification')<>'object'
     or pg_catalog.jsonb_typeof(p_request->'source_proposal')<>'object'
     or pg_catalog.jsonb_typeof(p_request->'target_snapshot')<>'object'
     or pg_catalog.jsonb_typeof(p_request->'c1_request')<>'object'
     or pg_catalog.jsonb_typeof(p_request->'c1_sources')<>'array'
     or pg_catalog.jsonb_typeof(p_request->'c1_components')<>'array' then
    raise exception 'WEEKLY_PROTECTED_C1_STAGE_REQUEST_INVALID' using errcode='22023';
  end if;
  if pg_catalog.octet_length(pg_catalog.convert_to(p_request::text,'UTF8'))>4194304 then
    raise exception 'WEEKLY_PROTECTED_C1_STAGE_REQUEST_TOO_LARGE' using errcode='54000';
  end if;
  begin
    v_actor_user_id:=(p_request->>'actor_user_id')::uuid;
    v_family_id:=(p_request->>'family_id')::uuid;
    v_run_id:=(p_request->>'orchestration_run_id')::uuid;
    v_source_cycle_id:=(p_request->>'source_cycle_id')::uuid;
    v_client_id:=(p_request->>'client_id')::uuid;
    v_work_event_id:=(p_request->>'work_event_id')::uuid;
    v_evidence_timesheet_id:=nullif(p_request->>'evidence_timesheet_id','')::uuid;
    v_expected_bound_version:=(p_request->>'expected_family_bound_version')::bigint;
    v_comparison_revision_id:=nullif(p_request->>'current_comparison_revision_id','')::uuid;
    v_final_revision_id:=nullif(p_request->>'current_final_revision_id','')::uuid;
  exception when others then
    raise exception 'WEEKLY_PROTECTED_C1_STAGE_REQUEST_INVALID' using errcode='22023';
  end;
  v_reason:=pg_catalog.btrim(coalesce(p_request->>'reason',''));
  v_idempotency_key:=pg_catalog.btrim(coalesce(p_request->>'idempotency_key',''));
  if pg_catalog.char_length(v_reason) not between 1 and 1000
     or pg_catalog.char_length(v_idempotency_key) not between 16 and 240 then
    raise exception 'WEEKLY_PROTECTED_C1_STAGE_REQUEST_INVALID' using errcode='22023';
  end if;

  v_schedule:=p_request->'protected_schedule';
  if not private.weekly_exceptional_json_keys_exact_v1(v_schedule,v_schedule_keys)
     or not (v_schedule ?& v_schedule_keys) then
    raise exception 'WEEKLY_PROTECTED_SCHEDULE_INVALID' using errcode='22023';
  end if;
  begin
    v_work_date:=(v_schedule->>'work_date')::date;
    v_start_at:=(v_schedule->>'start_at_local')::timestamp without time zone;
    v_end_at:=(v_schedule->>'end_at_local')::timestamp without time zone;
    v_break_minutes:=(v_schedule->>'break_minutes')::integer;
  exception when others then
    raise exception 'WEEKLY_PROTECTED_SCHEDULE_INVALID' using errcode='22023';
  end;
  if v_end_at<=v_start_at or v_start_at::date<>v_work_date
     or v_break_minutes<0
     or v_break_minutes>=extract(epoch from (v_end_at-v_start_at))/60 then
    raise exception 'WEEKLY_PROTECTED_SCHEDULE_INVALID' using errcode='22023';
  end if;
  v_rate_classification:=p_request->'rate_classification';
  v_source_proposal:=p_request->'source_proposal';
  v_target_snapshot:=p_request->'target_snapshot';
  if pg_catalog.octet_length(pg_catalog.convert_to(v_rate_classification::text,'UTF8'))>65536
     or pg_catalog.octet_length(pg_catalog.convert_to(v_source_proposal::text,'UTF8'))>65536
     or pg_catalog.octet_length(pg_catalog.convert_to(v_target_snapshot::text,'UTF8'))>1048576 then
    raise exception 'WEEKLY_PROTECTED_TARGET_TOO_LARGE' using errcode='54000';
  end if;

  v_start:=p_request->'c1_request';
  v_sources:=p_request->'c1_sources';
  v_components:=p_request->'c1_components';
  if not private.weekly_exceptional_json_keys_exact_v1(v_start,v_c1_keys)
     or not (v_start ?& v_c1_keys)
     or pg_catalog.jsonb_array_length(v_sources) not between 1 and 65536
     or pg_catalog.jsonb_array_length(v_components)>65536 then
    raise exception 'WEEKLY_PROTECTED_C1_STREAM_INVALID' using errcode='22023';
  end if;
  begin
    v_request_id:=(v_start->>'request_id')::uuid;
    v_request_sequence:=(v_start->>'request_sequence')::bigint;
    v_expected_head_revision:=(v_start->>'expected_head_revision')::bigint;
    v_expected_source_count:=(v_start->>'expected_source_count')::integer;
    v_expected_component_count:=(v_start->>'expected_component_count')::integer;
    v_expected_payload_bytes:=(v_start->>'expected_payload_bytes')::integer;
    v_financial_row_id:=(v_start->>'financial_row_id')::uuid;
    v_source_manifest_hash:=private.weekly_exceptional_hex_sha256_v1(v_start->>'source_manifest_sha256');
    v_entitlement_hash:=private.weekly_exceptional_hex_sha256_v1(v_start->>'entitlement_sha256');
    v_outer_approval_hash:=private.weekly_exceptional_hex_sha256_v1(v_start->>'approval_sha256');
    v_c1_request_hash:=private.weekly_exceptional_hex_sha256_v1(v_start->>'request_sha256');
  exception when others then
    raise exception 'WEEKLY_PROTECTED_C1_STREAM_INVALID' using errcode='22023';
  end;
  if v_request_sequence<1 or v_expected_head_revision<0
     or v_expected_source_count<>pg_catalog.jsonb_array_length(v_sources)
     or v_expected_component_count<>pg_catalog.jsonb_array_length(v_components)
     or v_expected_payload_bytes<1
     or ((v_start->>'is_zero_entitlement')::boolean is distinct from
         (v_expected_component_count=0)) then
    raise exception 'WEEKLY_PROTECTED_C1_STREAM_COUNT_INVALID' using errcode='22023';
  end if;

  -- Source ownership is checked before BOTH native staged-request replay
  -- branches. Their original ordinary behavior remains byte-for-byte below.
  if p_source_decision_preparation_id is not null then
    v_source_application_id:=private.weekly_source_pay_decision_native_request_scope_v1(
      p_source_decision_preparation_id,p_request,'STAGE_LOCAL',not p_validate_only);
  elsif exists(select 1 from private.weekly_source_pay_decision_unprotect_preparations p where p.orchestration_run_id=v_run_id)
    or exists(select 1 from private.weekly_source_pay_decision_native_adoptions a where a.orchestration_run_id=v_run_id) then
    perform private.weekly_source_pay_decision_native_normal_gate_v1(v_family_id,v_run_id,v_actor_user_id,'STAGE_LOCAL');
  end if;
  -- SP-12: existing admission only; no producer/version evidence.
  if (select active_owner from private.bpay_next_module_control where id=1)='NEXT' then
    perform private.weekly_source_pay_query_admit_v2();
  end if;

  -- An exact staged request is the idempotency authority even after the family
  -- version advances.  A UUID collision with different bytes always refuses.
  select request.* into v_publication
  from public.weekly_exceptional_c1_publication_requests request
  where request.id=v_request_id;
  if found then
    if v_publication.family_id is distinct from v_family_id
       or v_publication.orchestration_run_id is distinct from v_run_id
       or v_publication.request_sha256 is distinct from v_c1_request_hash then
      raise exception 'WEEKLY_PROTECTED_C1_REQUEST_ID_COLLISION' using errcode='23505';
    end if;
    perform private.weekly_source_bulk_stage_replay_assert_v1(v_publication.id,p_request);
    perform private.weekly_source_automatic_reconcile_stage_replay_assert_v1(v_publication.id,p_request);
    return pg_catalog.jsonb_build_object(
      'ok',true,'outcome','STAGED','idempotent_replay',true,
      'family_id',v_publication.family_id,'generation_id',v_publication.generation_id,
      'publication_request_id',v_publication.id,'request_sha256',
      pg_catalog.encode(v_publication.request_sha256,'hex'),
      'state',v_publication.state
    );
  end if;

  v_placement:=private.weekly_source_protected_current_placement_v1(v_family_id,v_work_event_id,false);
  if v_placement->'moved'='true'::jsonb then
    perform private.timesheet_contract_move_family_lock_v1((v_placement->>'original_root_timesheet_id')::uuid);
    select jsonb_build_object('root_timesheet_id',f.root_timesheet_id,'candidate_id',f.candidate_id,
      'contract_id',f.contract_id,'week_ending_date',f.week_ending_date) into strict v_lock_family
      from public.weekly_exceptional_pay_target_families f where f.id=v_family_id;
  else v_lock_family:=private.weekly_source_protected_family_lock_v1(v_family_id);end if;
  v_checked_placement:=private.weekly_source_protected_current_placement_v1(v_family_id,v_work_event_id,false);
  if v_checked_placement is distinct from v_placement then
    raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001';end if;
  -- An exact staged request is the idempotency authority even after the family
  -- version advances.  A UUID collision with different bytes always refuses.
  select request.* into v_publication
  from public.weekly_exceptional_c1_publication_requests request
  where request.id=v_request_id
  for update;
  if found then
    if v_publication.family_id is distinct from v_family_id
       or v_publication.orchestration_run_id is distinct from v_run_id
       or v_publication.request_sha256 is distinct from v_c1_request_hash then
      raise exception 'WEEKLY_PROTECTED_C1_REQUEST_ID_COLLISION' using errcode='23505';
    end if;
    perform private.weekly_source_bulk_stage_replay_assert_v1(v_publication.id,p_request);
    perform private.weekly_source_automatic_reconcile_stage_replay_assert_v1(v_publication.id,p_request);
    return pg_catalog.jsonb_build_object(
      'ok',true,'outcome','STAGED','idempotent_replay',true,
      'family_id',v_publication.family_id,'generation_id',v_publication.generation_id,
      'publication_request_id',v_publication.id,'request_sha256',
      pg_catalog.encode(v_publication.request_sha256,'hex'),
      'state',v_publication.state
    );
  end if;

  select family.* into strict v_family
  from public.weekly_exceptional_pay_target_families family
  where family.id=v_family_id
  for update;
  select run.* into strict v_run
  from public.weekly_exceptional_orchestration_runs run
  where run.id=v_run_id and run.family_id=v_family.id
  for update;
  if (v_family.root_timesheet_id::text,v_family.candidate_id::text,v_family.contract_id::text,v_family.week_ending_date::text)
    is distinct from (v_lock_family->>'root_timesheet_id',v_lock_family->>'candidate_id',
      v_lock_family->>'contract_id',v_lock_family->>'week_ending_date') then
    raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001'; end if;
  v_lock_group:=private.weekly_source_protected_group_lock_v1(v_source_cycle_id);
  if p_request ? 'bulk_signed_selection_proof' or p_request ? 'automatic_reconcile_selection_sha256' then
    -- The new one-shift round seals one pending proof at a time using the
    -- existing cycle mutex; the individual path retains its native SHARE.
    select cycle.* into strict v_cycle from public.weekly_source_cycles cycle
      where cycle.id=v_source_cycle_id for update;
  else
  select cycle.* into strict v_cycle
  from public.weekly_source_cycles cycle
  where cycle.id=v_source_cycle_id
  for share;
  end if;
  if v_cycle.source_group_id is distinct from v_lock_group then
    raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001'; end if;
  select source_group.* into strict v_group
  from public.weekly_source_groups source_group
  where source_group.id=v_cycle.source_group_id and source_group.active
  for share;
  perform private.weekly_source_office_authority_v1(
    v_actor_user_id,'APPROVE_PROTECTED_PAY',v_group.id,v_client_id,v_work_date
  );

  if p_source_decision_preparation_id is null then
    perform private.weekly_source_pay_decision_native_normal_gate_v1(v_family.id,v_run.id,v_actor_user_id,'STAGE_LOCAL');
  else
    v_source_application_id:=private.weekly_source_pay_decision_native_request_scope_v1(
      p_source_decision_preparation_id,p_request,'STAGE_LOCAL',not p_validate_only);
  end if;
  if v_run.requested_by_user_id is distinct from v_actor_user_id
     or v_run.state<>'RUNNING'
     or v_run.request_kind not in (
       'APPROVE','AMEND','WITHDRAW','RECONCILE','RECORD_NOT_WORKED'
     )
     or v_family.bound_version<>v_expected_bound_version
     or v_family.c1_publication_state in ('PENDING','PUBLISHING')
     or v_family.agency_id is distinct from v_group.agency_id
     or v_family.root_timesheet_id is null
     or v_work_date not between v_family.week_start_date and v_family.week_ending_date
     or not exists(
       select 1 from public.weekly_source_group_clients membership
       where membership.source_group_id=v_group.id
         and membership.client_id=v_client_id
         and v_work_date between membership.valid_from
           and coalesce(membership.valid_to,'infinity'::date)
     ) then
    raise exception 'WEEKLY_PROTECTED_C1_STAGE_SCOPE_INVALID' using errcode='55000';
  end if;

  select timesheet.* into strict v_root
  from public.timesheets timesheet
  where timesheet.timesheet_id=(v_placement->>'current_timesheet_id')::uuid
  for share;
  select financial.* into strict v_fin
  from public.timesheets_financials financial
  where financial.id=v_financial_row_id
    and financial.timesheet_id=v_root.timesheet_id
    and financial.is_current
  for share;
  select event.* into strict v_event
  from public.weekly_work_events event
  where event.id=v_work_event_id
    and event.candidate_id=v_family.candidate_id
    and event.client_id=v_client_id
    and event.work_date=v_work_date
  for share;
  if v_root.contract_id::text is distinct from v_placement->>'current_contract_id'
     or v_root.week_ending_date is distinct from v_family.week_ending_date
     or v_root.sheet_scope<>'WEEKLY'::public.timesheet_scope_enum
     or v_root.line_type<>'HOURS'::public.timesheet_line_type_enum
     or v_root.is_adjustment or not v_root.is_current
     or v_root.revoked_at is not null or v_root.archived_at_utc is not null then
    raise exception 'WEEKLY_PROTECTED_C1_ROOT_INVALID' using errcode='55000';
  end if;

  perform private.weekly_source_protected_action_placement_assert_v1(p_request,v_placement);
  v_policy:=private._weekly_source_effective_policy_v1(
    v_client_id,v_family.contract_id,v_work_date
  );
  v_activated_source_mode:=private.weekly_source_protected_non_self_bill_mode_v1(v_client_id,v_family.contract_id,v_work_date,v_cycle.id,v_actor_user_id,v_work_event_id);
  v_source_mode:=coalesce(v_policy->>'c1_source_mode',v_activated_source_mode);
  if v_policy->>'authority_mode'<>'SOURCE_AUTHORITY'
     or (coalesce((v_policy->>'self_bill_enabled')::boolean,false) is not true and v_activated_source_mode is null)
     or v_source_mode not in ('NHSP_WEEKLY','HEALTHROSTER_WEEKLY')
     or (v_group.source_family='NHSP') is distinct from (v_source_mode='NHSP_WEEKLY') then
    raise exception 'WEEKLY_PROTECTED_C1_POLICY_INVALID' using errcode='55000';
  end if;

  -- Existing WITHDRAW/RECONCILE actions accept actual Source, including
  -- certified absence; this does not define any other removal action. A
  -- Final-only synthetic zero proposal is not proof that Source is absent.
  -- Keep replay above this fresh admission check; do not reinterpret a saved
  -- decision after subsequent imports or change the Banking publication owner.
  if v_run.request_kind in ('WITHDRAW','RECONCILE') then
    v_selected_source_witness:=private.weekly_source_selected_source_witness_v1(
      v_family.id,v_cycle.id,v_event.id
    );
    if v_selected_source_witness is null
       or v_selected_source_witness->'source_proposal' is distinct from v_source_proposal
       or (v_selected_source_witness->>'kind'='CURRENT_ROW' and (
         v_selected_source_witness#>>'{basis,final_revision_id}' is null
         or v_selected_source_witness#>>'{basis,final_revision_id}' is distinct from v_source_proposal->>'source_revision'
         or v_source_proposal->'source_present' is distinct from 'true'::jsonb
       ))
       or (v_selected_source_witness->>'kind'='CERTIFIED_ABSENCE' and (
         v_source_proposal->'source_present' is distinct from 'false'::jsonb
         or v_source_proposal->>'source_minutes' is distinct from '0'
       ))
       or coalesce(v_selected_source_witness->>'kind' not in ('CURRENT_ROW','CERTIFIED_ABSENCE'),true) then
      raise exception 'WEEKLY_PROTECTED_C1_SELECTED_SOURCE_UNAVAILABLE' using errcode='55000';
    end if;
  end if;

  if (v_start->>'actor_user_id')::uuid is distinct from v_actor_user_id
     or (v_start->>'candidate_id')::uuid is distinct from v_family.candidate_id
     or (v_start->>'contract_id')::uuid is distinct from v_root.contract_id
     or (v_start->>'root_timesheet_id')::uuid is distinct from v_root.timesheet_id
     or (v_start->>'week_ending_date')::date is distinct from v_family.week_ending_date
     or v_start->>'source_mode'<>v_source_mode
     or v_financial_row_id is distinct from v_fin.id
     or v_request_sequence<>v_family.current_generation_number+1 then
    raise exception 'WEEKLY_PROTECTED_C1_START_SCOPE_INVALID' using errcode='55000';
  end if;
  if v_family.current_generation_id is null then
    if v_expected_head_revision<>0 then
      raise exception 'WEEKLY_PROTECTED_C1_HEAD_INVALID' using errcode='55000';
    end if;
  else
    select generation.* into strict v_prior_generation
    from public.weekly_exceptional_pay_generations generation
    where generation.id=v_family.current_generation_id
      and generation.family_id=v_family.id
      and generation.lifecycle_state='PUBLISHED'
    for share;
    select request.* into strict v_publication
    from public.weekly_exceptional_c1_publication_requests request
    where request.generation_id=v_prior_generation.id
      and request.family_id=v_family.id
      and (request.state='PUBLISHED' or (request.state='RETIRED' and exists(
        select 1 from private.weekly_source_local_protected_decision_receipts receipt
        where receipt.publication_request_id=request.id and receipt.generation_id=v_prior_generation.id
          and receipt.state='COMPLETE')));
    if (case when v_publication.state='RETIRED' then v_prior_generation.generation_number::bigint
             else v_publication.c1_head_revision end) is distinct from v_expected_head_revision then
      raise exception 'WEEKLY_PROTECTED_C1_HEAD_INVALID' using errcode='55000';
    end if;
    v_publication.id:=null;
  end if;

  if v_evidence_timesheet_id is not null then
    select evidence.* into strict v_evidence
    from public.timesheets evidence
    where evidence.timesheet_id=v_evidence_timesheet_id
      and evidence.contract_id=v_family.contract_id
      and evidence.week_ending_date=v_family.week_ending_date
      and evidence.sheet_scope='WEEKLY'::public.timesheet_scope_enum
      and (evidence.is_current or v_placement->'moved'='true'::jsonb) and evidence.revoked_at is null
      and (evidence.archived_at_utc is null or v_placement->'moved'='true'::jsonb);
    v_signed_evidence:=private.weekly_source_protected_signed_evidence_v1(v_evidence_timesheet_id,v_family.id,v_event.id);
    v_signed_at:=(v_signed_evidence->>'signed_at_utc')::timestamptz;
    v_signed_revision:=(v_signed_evidence->>'timesheet_version')::integer;
    v_signed_hash:=private.weekly_exceptional_hex_sha256_v1(
      v_signed_evidence->>'signature_sha256'
    );
  end if;

  select coalesce(pg_catalog.array_agg(incident.id order by incident.id),'{}'::uuid[])
    into v_issue_ids
  from public.weekly_discrepancy_incidents incident
  where incident.source_group_id=v_group.id
    and incident.work_event_id=v_work_event_id
    and incident.candidate_id=v_family.candidate_id
    and incident.client_id=v_client_id;
  v_issue_ids_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_ISSUE_SET_V1',pg_catalog.to_jsonb(v_issue_ids)
  );
  v_schedule_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_SCHEDULE_V1',v_schedule
  );
  v_rate_policy_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_RATE_POLICY_V1',
    pg_catalog.jsonb_build_object(
      'contract_id',v_family.contract_id,
      'rates_json',(select contract.rates_json from public.contracts contract where contract.id=v_family.contract_id),
      'policy',v_policy,'classification',v_rate_classification
    )
  );
  v_source_proposal_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_SOURCE_PROPOSAL_V1',v_source_proposal
  );

  if v_comparison_revision_id is not null and not exists(
    select 1
    from public.weekly_issue_comparison_revisions comparison
    join public.weekly_discrepancy_incidents incident on incident.id=comparison.incident_id
    where comparison.id=v_comparison_revision_id
      and comparison.contract_id=v_family.contract_id
      and incident.source_group_id=v_group.id
      and incident.work_event_id=v_work_event_id
      and incident.candidate_id=v_family.candidate_id
      and incident.client_id=v_client_id
  ) then
    raise exception 'WEEKLY_PROTECTED_COMPARISON_SCOPE_INVALID' using errcode='55000';
  end if;
  if v_final_revision_id is not null and not exists(
    select 1 from public.weekly_source_final_revisions final_revision
    where final_revision.id=v_final_revision_id
      and final_revision.source_cycle_id=v_source_cycle_id
      and final_revision.state='CURRENT'
  ) then
    raise exception 'WEEKLY_PROTECTED_FINAL_SCOPE_INVALID' using errcode='55000';
  end if;

  -- Validate and persist the complete normalized C1 source stream.  The C1
  -- owner independently replays its TLV hashes before certification; these
  -- local checks prevent truncation, reordering or cross-root substitution.
  for v_source_entry in
    select value from pg_catalog.jsonb_array_elements(v_sources)
  loop
    v_source_counter:=v_source_counter+1;
    if not private.weekly_exceptional_json_keys_exact_v1(v_source_entry,v_source_keys)
       or not (v_source_entry ?& v_source_keys)
       or v_source_entry->>'record_type'<>'SOURCE'
       or pg_catalog.jsonb_typeof(v_source_entry->'parts')<>'array' then
      raise exception 'WEEKLY_PROTECTED_C1_SOURCE_INVALID' using errcode='22023';
    end if;
    begin
      v_source_ordinal:=(v_source_entry->>'source_ordinal')::integer;
      v_source_id:=(v_source_entry->>'source_id')::uuid;
      v_source_payload_bytes:=(v_source_entry->>'payload_bytes')::integer;
      v_source_part_count:=(v_source_entry->>'part_count')::integer;
    exception when others then
      raise exception 'WEEKLY_PROTECTED_C1_SOURCE_INVALID' using errcode='22023';
    end;
    if v_source_ordinal<>v_source_counter
       or v_source_ordinal not between 1 and v_expected_source_count
       or (v_source_entry->>'root_timesheet_id')::uuid is distinct from v_root.timesheet_id
       or (v_source_entry->>'candidate_id')::uuid is distinct from v_family.candidate_id
       or (v_source_entry->>'contract_id')::uuid is distinct from v_root.contract_id
       or v_source_payload_bytes not between 1 and 16384
       or v_source_part_count<>pg_catalog.jsonb_array_length(v_source_entry->'parts')
       or v_source_part_count not between 1 and 6 then
      raise exception 'WEEKLY_PROTECTED_C1_SOURCE_SCOPE_INVALID' using errcode='55000';
    end if;
    v_source_kind:=v_source_entry->>'authority_kind';
    if v_source_kind not in (
      'CANDIDATE_SUBMISSION','CLIENT_SOURCE','OFFICE_APPROVAL','ROOT_FINANCIAL',
      'PROVIDER','SOURCE_EXPENSE','ORDINARY_EXPENSE','APPROVED_COMPONENT'
    ) then
      raise exception 'WEEKLY_PROTECTED_C1_SOURCE_KIND_INVALID' using errcode='22023';
    end if;
    v_count_client:=v_count_client+(v_source_kind='CLIENT_SOURCE')::integer;
    v_count_candidate:=v_count_candidate+(v_source_kind='CANDIDATE_SUBMISSION')::integer;
    v_count_root:=v_count_root+(v_source_kind='ROOT_FINANCIAL')::integer;
    v_count_provider:=v_count_provider+(v_source_kind='PROVIDER')::integer;
    v_count_office:=v_count_office+(v_source_kind='OFFICE_APPROVAL')::integer;
    v_part_concat:=''::bytea;
    v_part_ordinal:=0;
    for v_part_entry in
      select value from pg_catalog.jsonb_array_elements(v_source_entry->'parts')
    loop
      v_part_ordinal:=v_part_ordinal+1;
      if not private.weekly_exceptional_json_keys_exact_v1(v_part_entry,v_part_keys)
         or not (v_part_entry ?& v_part_keys)
         or v_part_entry->>'record_type'<>'PART'
         or (v_part_entry->>'source_ordinal')::integer<>v_source_ordinal
         or (v_part_entry->>'part_ordinal')::integer<>v_part_ordinal
         or coalesce(v_part_entry->>'payload_utf8','')!~'^(?:[0-9a-f]{2})+$' then
        raise exception 'WEEKLY_PROTECTED_C1_PART_INVALID' using errcode='22023';
      end if;
      v_part_payload:=pg_catalog.decode(v_part_entry->>'payload_utf8','hex');
      if pg_catalog.octet_length(v_part_payload) not between 1 and 3072
         or extensions.digest(v_part_payload,'sha256') is distinct from
            private.weekly_exceptional_hex_sha256_v1(v_part_entry->>'fragment_sha256') then
        raise exception 'WEEKLY_PROTECTED_C1_PART_HASH_INVALID' using errcode='22023';
      end if;
      v_part_concat:=v_part_concat||v_part_payload;
    end loop;
    if v_part_ordinal<>v_source_part_count
       or pg_catalog.octet_length(v_part_concat)<>v_source_payload_bytes then
      raise exception 'WEEKLY_PROTECTED_C1_SOURCE_PAYLOAD_INVALID' using errcode='22023';
    end if;
    begin
      v_source_document:=pg_catalog.convert_from(v_part_concat,'UTF8')::jsonb;
    exception when others then
      raise exception 'WEEKLY_PROTECTED_C1_SOURCE_DOCUMENT_INVALID' using errcode='22023';
    end;
    if pg_catalog.jsonb_typeof(v_source_document)<>'object'
       or (v_source_document->>'root_timesheet_id')::uuid is distinct from v_root.timesheet_id
       or (v_source_document->>'candidate_id')::uuid is distinct from v_family.candidate_id
       or (v_source_document->>'contract_id')::uuid is distinct from v_root.contract_id
       or (v_source_document->>'week_ending_date')::date is distinct from v_family.week_ending_date
       or v_source_document->>'document_sha256' is distinct from
          v_source_entry->>'source_document_sha256' then
      raise exception 'WEEKLY_PROTECTED_C1_SOURCE_DOCUMENT_SCOPE_INVALID' using errcode='55000';
    end if;
    if v_source_kind='CLIENT_SOURCE'
       and coalesce((v_source_document->>'source_complete')::boolean,false) is not true then
      raise exception 'WEEKLY_PROTECTED_C1_CLIENT_SOURCE_INCOMPLETE' using errcode='55000';
    elsif v_source_kind='ROOT_FINANCIAL' and (
       (v_source_document->>'financial_row_id')::uuid is distinct from v_fin.id
       or (v_placement->'moved'='true'::jsonb and (
        v_source_document->>'financial_revision_digest' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_PROTECTED_ROOT_FINANCIAL_V1',to_jsonb(v_fin)),'hex')
        or v_source_entry->>'source_document_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_PROTECTED_ROOT_FINANCIAL_V1',to_jsonb(v_fin)),'hex')
        or v_source_document->>'root_version' is distinct from v_root.version::text
        or v_source_document->>'financial_timesheet_version' is distinct from v_fin.timesheet_version::text))) then
      raise exception 'WEEKLY_PROTECTED_C1_ROOT_FINANCIAL_INVALID' using errcode='55000';
    elsif v_source_kind='OFFICE_APPROVAL'
       and (
         (v_source_document->>'actor_user_id')::uuid is distinct from v_actor_user_id
         or (v_source_document->>'request_id')::uuid is distinct from v_request_id
         or v_source_document->>'entitlement_sha256' is distinct from
            v_start->>'entitlement_sha256'
         or v_source_document->>'decision'<>'APPROVE_ENTITLEMENT'
       ) then
      raise exception 'WEEKLY_PROTECTED_C1_OFFICE_SOURCE_INVALID' using errcode='55000';
    end if;
    v_payload_total:=v_payload_total+v_source_payload_bytes;
  end loop;
  if v_source_counter<>v_expected_source_count
     or v_count_client<1 or v_count_root<>1 or v_count_provider<>1 or v_count_office<>1
     or (v_evidence_timesheet_id is null and v_count_candidate<>0)
     or (v_evidence_timesheet_id is not null and v_count_candidate<>1)
     or v_payload_total<>v_expected_payload_bytes then
    raise exception 'WEEKLY_PROTECTED_C1_SOURCE_CARDINALITY_INVALID' using errcode='55000';
  end if;

  v_component_ordinal:=0;
  for v_component_entry in
    select value from pg_catalog.jsonb_array_elements(v_components)
  loop
    v_component_ordinal:=v_component_ordinal+1;
    if not private.weekly_exceptional_json_keys_exact_v1(v_component_entry,v_component_keys)
       or not (v_component_entry ?& v_component_keys)
       or v_component_entry->>'record_type'<>'COMPONENT'
       or (v_component_entry->>'component_ordinal')::integer<>v_component_ordinal
       or (v_component_entry->>'source_ordinal')::integer not between 1 and v_expected_source_count
       or coalesce(v_component_entry->>'source_key','')=''
       or (v_previous_source_key is not null and v_component_entry->>'source_key'<=v_previous_source_key) then
      raise exception 'WEEKLY_PROTECTED_C1_COMPONENT_INVALID' using errcode='22023';
    end if;
    if nullif(v_component_entry->>'work_date','') is not null
       and (v_component_entry->>'work_date')::date not between
           v_family.week_start_date and v_family.week_ending_date then
      raise exception 'WEEKLY_PROTECTED_C1_COMPONENT_WEEK_INVALID' using errcode='55000';
    end if;
    v_total_pay:=v_total_pay+(v_component_entry->>'pay_ex_vat')::numeric;
    perform private.weekly_exceptional_hex_sha256_v1(v_component_entry->>'component_sha256');
    v_previous_source_key:=v_component_entry->>'source_key';
  end loop;
  if v_component_ordinal<>v_expected_component_count then
    raise exception 'WEEKLY_PROTECTED_C1_COMPONENT_COUNT_INVALID' using errcode='22023';
  end if;
  v_total_pay:=pg_catalog.round(v_total_pay,2);

  if v_family.current_generation_id is null then
    -- Before the prepare owner distinguished empty from published families,
    -- a retry could be recorded as AMEND even though nothing was published.
    -- Preserve that immutable request and permit only its first generation;
    -- never treat an existing staged/published entitlement as an initial one.
    if v_run.request_kind not in ('APPROVE','AMEND')
       or v_family.current_generation_number<>0
       or v_family.current_lifecycle_state<>'PENDING_APPROVAL'
       or exists(select 1 from public.weekly_exceptional_pay_generations existing
         where existing.family_id=v_family.id) then
      raise exception 'WEEKLY_PROTECTED_C1_INITIAL_ACTION_INVALID' using errcode='55000';
    end if;
    v_prior_vector:=pg_catalog.jsonb_build_object(
      'schema_version','WEEKLY_PROTECTED_TARGET_VECTOR_V1',
      'components',pg_catalog.jsonb_build_array(),
      'component_count',0,'is_zero_entitlement',true
    );
    v_generation_number:=1;
    v_generation_reason:='INITIAL_APPROVAL';
  else
    v_prior_vector:=v_prior_generation.complete_next_vector_json;
    v_generation_number:=v_prior_generation.generation_number+1;
    v_generation_reason:=case v_run.request_kind
      when 'AMEND' then 'OFFICE_AMENDMENT'
      when 'WITHDRAW' then 'WITHDRAW'
      when 'RECONCILE' then 'RECONCILE'
      when 'RECORD_NOT_WORKED' then 'RECORD_NOT_WORKED'
      else null end;
    if v_generation_reason is null then
      raise exception 'WEEKLY_PROTECTED_C1_ACTION_INVALID' using errcode='55000';
    end if;
  end if;
  v_family_event_state:=case
    when v_run.request_kind in ('APPROVE','AMEND') then 'WAIT'
    when v_run.request_kind in ('WITHDRAW','RECONCILE') then 'ACCEPTED_SOURCE'
    else 'NOT_WORKED' end;
  if v_run.request_kind='RECORD_NOT_WORKED'
     and coalesce((v_source_proposal->>'source_present')::boolean,true) then
    raise exception 'WEEKLY_PROTECTED_NOT_WORKED_SOURCE_PRESENT' using errcode='55000';
  end if;
  with latest as (
    select family_event.durable_work_event_id,family_event.state,
      pg_catalog.row_number() over (
        partition by family_event.durable_work_event_id
        order by family_event.event_sequence desc
      ) as event_rank
    from public.weekly_exceptional_pay_family_events family_event
    where family_event.family_id=v_family.id
      and family_event.durable_work_event_id<>v_work_event_id
  )
  select pg_catalog.count(*)::integer into v_other_wait_count
  from latest where event_rank=1 and state='WAIT';
  v_resulting_lifecycle_state:=case
    when v_family_event_state='WAIT' or v_other_wait_count>0 then 'WAITING_SOURCE'
    when v_run.request_kind='RECORD_NOT_WORKED' then 'NOT_WORKED'
    else 'RECONCILED' end;
  v_pending_outcome:=case v_family_event_state
    when 'WAIT' then 'WAIT'
    when 'ACCEPTED_SOURCE' then 'ACCEPT_SOURCE'
    else 'RECORD_NOT_WORKED' end;
  v_payment_event_kind:=case v_run.request_kind
    when 'APPROVE' then 'APPROVED'
    when 'AMEND' then 'APPROVED'
    when 'RECORD_NOT_WORKED' then 'RECORDED_NOT_WORKED'
    else 'MATCH_ACCEPTED' end;
  v_prior_vector_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',v_prior_vector
  );
  v_next_vector:=pg_catalog.jsonb_build_object(
    'schema_version','WEEKLY_PROTECTED_TARGET_VECTOR_V1',
    'target_snapshot',v_target_snapshot,
    'components',v_components,
    'component_count',v_expected_component_count,
    'is_zero_entitlement',(v_expected_component_count=0),
    'entitlement_sha256',v_start->>'entitlement_sha256',
    'approved_pay_ex_vat',pg_catalog.to_char(v_total_pay,'FM9999999990.00')
  );
  -- Identity metadata is admitted only against this fresh, actual server
  -- context under the established stage locks, never the caller's manifest.
  -- Matching clocks are not a historical identity-derivation fallback.
  v_component_identity_context:=public.weekly_exceptional_pay_action_context_v1(
    jsonb_build_object('schema_version','WEEKLY_PROTECTED_ACTION_CONTEXT_V1',
      'actor_user_id',v_actor_user_id,'family_id',v_family.id,
      'orchestration_run_id',v_run.id,'source_cycle_id',v_cycle.id,
      'work_event_id',v_event.id,'protected_schedule',v_schedule,
      'evidence_timesheet_id',v_evidence_timesheet_id));
  v_component_identity_context:=private.weekly_source_protected_entitlement_projection_v1(v_component_identity_context);
  if v_component_identity_context->>'root_timesheet_id' is distinct from v_root.timesheet_id::text
     or v_component_identity_context#>>'{current_financial,id}' is distinct from v_fin.id::text
     or v_component_identity_context->>'family_bound_version' is distinct from v_expected_bound_version::text
     or v_component_identity_context->'source_proposal' is distinct from v_source_proposal then
    raise exception 'WEEKLY_PROTECTED_COMPONENT_MANIFEST_UNAVAILABLE' using errcode='55000'; end if;
  v_component_identity_basis:=private.weekly_source_protected_component_manifest_v1(
    v_component_identity_context,v_target_snapshot);
  v_next_vector:=v_next_vector||jsonb_build_object(
    'protected_component_identity_basis',v_component_identity_basis);
  if v_placement->'moved'='true'::jsonb then
    v_next_vector:=v_next_vector||jsonb_build_object('accepted_current_placement',v_placement);end if;
  -- Seal the common before-position at approval. A later authorised amendment
  -- must not silently replace an entitlement published after this calculation.
  if v_root.authorised_at_server is not null then
    v_next_vector:=v_next_vector||pg_catalog.jsonb_build_object(
      'prior_effective_inventory',private.weekly_source_effective_inventory_v1(v_root.timesheet_id));
  end if;
  if p_request ? 'bulk_signed_selection_proof' then
    v_bulk_signed_proof:=private.weekly_source_bulk_stage_proof_v1(p_request,v_fin.id);
    v_next_vector:=v_next_vector||jsonb_build_object('bulk_signed_selection_proof',v_bulk_signed_proof);
  end if;
  if p_request ? 'automatic_reconcile_selection_sha256' then
    v_automatic_reconcile_proof:=private.weekly_source_automatic_reconcile_stage_proof_v1(p_request);
    v_next_vector:=v_next_vector||jsonb_build_object('automatic_reconcile_proof',v_automatic_reconcile_proof);
  end if;
  v_next_vector_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',v_next_vector
  );
  v_fixed_source_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_FIXED_SOURCE_STATE_V1',
    pg_catalog.jsonb_build_object(
      'source_cycle_id',v_source_cycle_id,
      'comparison_revision_id',v_comparison_revision_id,
      'final_revision_id',v_final_revision_id,
      'source_proposal_hash',pg_catalog.encode(v_source_proposal_hash,'hex'),
      'financial_row_id',v_fin.id,'financial_timesheet_version',v_fin.timesheet_version
    )
  );
  v_local_approval_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_APPROVAL_V1',
    pg_catalog.jsonb_build_object(
      'family_id',v_family.id,'work_event_id',v_work_event_id,
      'candidate_id',v_family.candidate_id,'client_id',v_client_id,
      'contract_id',v_family.contract_id,'week_ending_date',v_family.week_ending_date,
      'schedule_hash',pg_catalog.encode(v_schedule_hash,'hex'),
      'evidence_timesheet_id',v_evidence_timesheet_id,
      'signed_hash',case when v_signed_hash is null then null else pg_catalog.encode(v_signed_hash,'hex') end,
      'issue_ids_hash',pg_catalog.encode(v_issue_ids_hash,'hex'),
      'rate_policy_hash',pg_catalog.encode(v_rate_policy_hash,'hex'),
      'target_vector_hash',pg_catalog.encode(v_next_vector_hash,'hex'),
      'actor_user_id',v_actor_user_id,'reason',v_reason
    )
  );

  if p_validate_only then
    return jsonb_build_object('version','SOURCE_NATIVE_VALIDATED_REQUEST_V1','route','SOURCE_LOCAL',
      'family_id',v_family.id,'orchestration_run_id',v_run.id,
      'native_request_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_C1_STAGE_REQUEST_BODY_V1',p_request),'hex'),
      'target_snapshot',v_target_snapshot,'component_identity_basis',v_component_identity_basis);
  end if;
  insert into public.weekly_exceptional_payment_approvals(
    pay_target_family_id,work_event_id,evidence_timesheet_id,candidate_id,
    client_id,contract_id,week_ending,protected_work_date,
    protected_start_at_local,protected_end_at_local,protected_break_minutes,
    signed_submission_timesheet_id,signed_submission_revision,
    signed_submission_hash,signed_at_utc,contributing_issue_episode_ids,
    contributing_issue_episode_ids_hash,signed_schedule_fact_hash,
    contract_rate_policy_source_fingerprint,approved_by_user_id,
    approval_reason,source_cycle_id,comparison_revision_id,final_revision_id,
    approved_target_pay_components_json,approved_target_gross,
    creation_orchestration_run_id,approval_hash,creation_idempotency_key
  ) values (
    v_family.id,v_work_event_id,v_evidence_timesheet_id,v_family.candidate_id,
    v_client_id,v_family.contract_id,v_family.week_ending_date,v_work_date,
    v_start_at,v_end_at,v_break_minutes,
    v_evidence_timesheet_id,v_signed_revision,v_signed_hash,v_signed_at,v_issue_ids,
    v_issue_ids_hash,v_schedule_hash,v_rate_policy_hash,v_actor_user_id,
    v_reason,v_source_cycle_id,v_comparison_revision_id,v_final_revision_id,
    v_target_snapshot,v_total_pay,v_run.id,v_local_approval_hash,
    v_idempotency_key||':approval'
  ) returning * into v_approval;

  insert into public.weekly_exceptional_pay_generations(
    family_id,generation_number,prior_generation_id,prior_generation_hash,
    request_idempotency_key,reason,complete_prior_vector_json,
    complete_prior_vector_hash,complete_next_vector_json,complete_next_vector_hash,
    fixed_target_source_state_fingerprint,lifecycle_state
  ) values (
    v_family.id,v_generation_number,v_family.current_generation_id,
    case when v_family.current_generation_id is null then null else v_prior_vector_hash end,
    v_idempotency_key||':generation',v_generation_reason,v_prior_vector,
    v_prior_vector_hash,v_next_vector,v_next_vector_hash,v_fixed_source_hash,'PENDING_C1'
  ) returning * into v_generation;

  select coalesce(max(event_sequence),0)+1,
         (array_agg(event_hash order by event_sequence desc))[1]
    into v_family_event_sequence,v_prior_family_event_hash
  from public.weekly_exceptional_pay_family_events
  where family_id=v_family.id;
  v_family_event_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_FAMILY_EVENT_V1',
    pg_catalog.jsonb_build_object(
      'family_id',v_family.id,'event_sequence',v_family_event_sequence,
      'work_event_id',v_work_event_id,'approval_id',v_approval.id,
      'schedule',v_schedule,'source_proposal_hash',pg_catalog.encode(v_source_proposal_hash,'hex'),
      'target_vector_hash',pg_catalog.encode(v_next_vector_hash,'hex'),
      'prior_event_hash',case when v_prior_family_event_hash is null then null
        else pg_catalog.encode(v_prior_family_event_hash,'hex') end
    )
  );
  insert into public.weekly_exceptional_pay_family_events(
    family_id,event_sequence,durable_work_event_id,evidence_approval_id,
    work_date,start_at_local,end_at_local,break_minutes,rate_classification_json,
    source_proposal_snapshot_json,source_proposal_hash,
    fixed_office_target_snapshot_json,fixed_office_target_hash,state,
    current_comparison_revision_id,current_final_revision_id,office_actor_user_id,
    office_reason,prior_event_hash,event_hash
  ) values (
    v_family.id,v_family_event_sequence,v_work_event_id,v_approval.id,
    v_work_date,v_start_at,v_end_at,v_break_minutes,v_rate_classification,
    v_source_proposal,v_source_proposal_hash,v_schedule,v_schedule_hash,v_family_event_state,
    v_comparison_revision_id,v_final_revision_id,v_actor_user_id,v_reason,
    v_prior_family_event_hash,v_family_event_hash
  ) returning id into v_family_event_id;
  if (select active_owner from private.bpay_next_module_control where id=1)='NEXT' then
    perform private.bpay_next_protected_current_decision_capture_v1(v_family_event_id);
  end if;

  select coalesce(max(event_sequence),0)+1,
         (array_agg(event_hash order by event_sequence desc))[1]
    into v_target_event_sequence,v_prior_target_event_hash
  from public.weekly_exceptional_pay_target_events
  where family_id=v_family.id;
  v_target_event_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_TARGET_EVENT_V1',
    pg_catalog.jsonb_build_object(
      'family_id',v_family.id,'event_sequence',v_target_event_sequence,
      'approval_id',v_approval.id,'generation_id',v_generation.id,
      'prior_vector_hash',pg_catalog.encode(v_prior_vector_hash,'hex'),
      'next_vector_hash',pg_catalog.encode(v_next_vector_hash,'hex'),
      'reason',v_generation_reason,'actor_user_id',v_actor_user_id
    )
  );
  insert into public.weekly_exceptional_pay_target_events(
    family_id,approval_id,event_sequence,triggering_comparison_revision_id,
    triggering_final_revision_id,prior_event_fingerprint,
    fixed_target_component_snapshot,current_source_proposal_snapshot,
    complete_prior_family_vector_fingerprint,
    complete_next_family_vector_fingerprint,reason,resulting_lifecycle_state,
    financial_generation_id,actor_user_id,event_hash,idempotency_key
  ) values (
    v_family.id,v_approval.id,v_target_event_sequence,v_comparison_revision_id,
    v_final_revision_id,v_prior_target_event_hash,v_target_snapshot,v_source_proposal,
    v_prior_vector_hash,v_next_vector_hash,v_generation_reason,v_resulting_lifecycle_state,
    v_generation.id,v_actor_user_id,v_target_event_hash,v_idempotency_key||':target-event'
  );
  update public.weekly_exceptional_pending_reconciliation_targets target
  set state=case when v_run.request_kind='WITHDRAW' then 'WITHDRAWN' else 'CONSUMED' end,
      completed_at_utc=pg_catalog.statement_timestamp()
  where target.family_id=v_family.id
    and target.durable_work_event_id=v_work_event_id
    and target.state='ACTIVE';
  if v_family_event_state='WAIT' then
    insert into public.weekly_exceptional_pending_reconciliation_targets(
      family_id,approval_id,durable_work_event_id,incident_id,current_final_revision_id,
      intended_outcome,source_action_policy_target_fingerprint,state
    ) values (
      v_family.id,v_approval.id,v_work_event_id,
      (select incident.id from public.weekly_discrepancy_incidents incident
       where incident.source_group_id=v_group.id and incident.work_event_id=v_work_event_id
       order by incident.episode_number desc limit 1),
      v_final_revision_id,v_pending_outcome,v_fixed_source_hash,'ACTIVE'
    );
  end if;
  insert into public.weekly_exceptional_payment_events(
    family_id,approval_id,event_kind,lifecycle_view,bounded_payload_json,
    idempotency_key
  ) values (
    v_family.id,v_approval.id,v_payment_event_kind,'PENDING_C1',
    pg_catalog.jsonb_build_object(
      'work_event_id',v_work_event_id,'generation_id',v_generation.id,
      'target_vector_hash',pg_catalog.encode(v_next_vector_hash,'hex'),
      'approved_pay_ex_vat',pg_catalog.to_char(v_total_pay,'FM9999999990.00')
    ),v_idempotency_key||':payment-event'
  );

  insert into public.weekly_exceptional_c1_publication_requests(
    id,family_id,generation_id,orchestration_run_id,agency_id,candidate_id,
    contract_id,root_timesheet_id,week_ending_date,source_mode,request_sequence,
    expected_head_revision,expected_source_count,expected_component_count,
    expected_payload_bytes,source_manifest_sha256,entitlement_sha256,
    approval_sha256,is_zero_entitlement,financial_row_id,request_sha256,state
  ) values (
    v_request_id,v_family.id,v_generation.id,v_run.id,v_family.agency_id,
    v_family.candidate_id,v_root.contract_id,v_root.timesheet_id,
    v_family.week_ending_date,v_source_mode,v_request_sequence,
    v_expected_head_revision,v_expected_source_count,v_expected_component_count,
    v_expected_payload_bytes,v_source_manifest_hash,v_entitlement_hash,
    v_outer_approval_hash,(v_expected_component_count=0),v_fin.id,
    v_c1_request_hash,'READY'
  ) returning * into v_publication;

  for v_source_entry in select value from pg_catalog.jsonb_array_elements(v_sources)
  loop
    v_source_ordinal:=(v_source_entry->>'source_ordinal')::integer;
    v_source_id:=(v_source_entry->>'source_id')::uuid;
    insert into public.weekly_exceptional_c1_source_records(
      id,publication_request_id,source_ordinal,authority_kind,source_system,
      external_identity,external_revision,source_document_sha256,payload_bytes,
      part_count,work_date,root_timesheet_id,candidate_id,contract_id,
      source_row_sha256
    ) values (
      v_source_id,v_publication.id,v_source_ordinal,v_source_entry->>'authority_kind',
      v_source_entry->>'source_system',v_source_entry->>'external_identity',
      v_source_entry->>'external_revision',
      private.weekly_exceptional_hex_sha256_v1(v_source_entry->>'source_document_sha256'),
      (v_source_entry->>'payload_bytes')::integer,
      (v_source_entry->>'part_count')::integer,
      nullif(v_source_entry->>'work_date','')::date,v_root.timesheet_id,
      v_family.candidate_id,v_root.contract_id,
      private.weekly_exceptional_hex_sha256_v1(v_source_entry->>'source_row_sha256')
    );
    for v_part_entry in select value from pg_catalog.jsonb_array_elements(v_source_entry->'parts')
    loop
      insert into public.weekly_exceptional_c1_source_parts(
        publication_request_id,source_record_id,source_ordinal,part_ordinal,
        payload_utf8,fragment_sha256
      ) values (
        v_publication.id,v_source_id,v_source_ordinal,
        (v_part_entry->>'part_ordinal')::integer,
        pg_catalog.decode(v_part_entry->>'payload_utf8','hex'),
        private.weekly_exceptional_hex_sha256_v1(v_part_entry->>'fragment_sha256')
      );
    end loop;
  end loop;

  for v_component_entry in select value from pg_catalog.jsonb_array_elements(v_components)
  loop
    insert into public.weekly_exceptional_c1_component_records(
      publication_request_id,component_ordinal,component_id,source_ordinal,
      source_key,component_kind,economic_key_type,economic_key_value,
      component_member_identity,segment_id,segment_key,segment_stable_key,
      work_date,reference_number,hours_day,hours_night,hours_sat,hours_sun,
      hours_bh,additional_code_raw,unit_count,unit_pay_rate,unit_charge_rate,
      expense_code,pay_ex_vat,charge_ex_vat,exclude_from_pay,
      origin,component_sha256
    ) values (
      v_publication.id,(v_component_entry->>'component_ordinal')::integer,
      (v_component_entry->>'component_id')::uuid,
      (v_component_entry->>'source_ordinal')::integer,
      v_component_entry->>'source_key',v_component_entry->>'component_kind',
      v_component_entry->>'economic_key_type',v_component_entry->>'economic_key_value',
      v_component_entry->>'component_member_identity',nullif(v_component_entry->>'segment_id',''),
      nullif(v_component_entry->>'segment_key',''),nullif(v_component_entry->>'segment_stable_key',''),
      nullif(v_component_entry->>'work_date','')::date,nullif(v_component_entry->>'reference_number',''),
      nullif(v_component_entry->>'hours_day','')::numeric,
      nullif(v_component_entry->>'hours_night','')::numeric,
      nullif(v_component_entry->>'hours_sat','')::numeric,
      nullif(v_component_entry->>'hours_sun','')::numeric,
      nullif(v_component_entry->>'hours_bh','')::numeric,
      nullif(v_component_entry->>'additional_code_raw',''),
      nullif(v_component_entry->>'unit_count','')::numeric,
      nullif(v_component_entry->>'unit_pay_rate','')::numeric,
      nullif(v_component_entry->>'unit_charge_rate','')::numeric,
      nullif(v_component_entry->>'expense_code',''),
      (v_component_entry->>'pay_ex_vat')::numeric,
      nullif(v_component_entry->>'charge_ex_vat','')::numeric,
      (v_component_entry->>'exclude_from_pay')::boolean,
      v_component_entry->>'origin',
      private.weekly_exceptional_hex_sha256_v1(v_component_entry->>'component_sha256')
    );
  end loop;

  update public.weekly_exceptional_pay_target_families
  set c1_publication_state='PENDING',bound_version=bound_version+1
  where id=v_family.id;

  v_request_body_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_C1_STAGE_REQUEST_BODY_V1',p_request
  );
  v_before_hash:=v_run.before_state_fingerprint;
  v_after_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_C1_STAGED_STATE_V1',
    pg_catalog.jsonb_build_object(
      'family_id',v_family.id,'generation_id',v_generation.id,
      'publication_request_id',v_publication.id,'request_sha256',
      pg_catalog.encode(v_c1_request_hash,'hex'),'new_bound_version',v_family.bound_version+1
    )
  );
  select coalesce(max(sequence),0)+1 into v_step_sequence
  from public.weekly_exceptional_orchestration_steps where orchestration_run_id=v_run.id;
  insert into public.weekly_exceptional_orchestration_steps(
    orchestration_run_id,sequence,step_kind,idempotency_key,
    allowlisted_owner_name,allowlisted_owner_signature,bounded_request_hash,
    before_state_fingerprint,bounded_owner_response_json,owner_response_hash,
    after_state_fingerprint,outcome,completed_at_utc
  ) values (
    v_run.id,v_step_sequence,'STAGE_C1_REQUEST',v_idempotency_key,
    'public.weekly_exceptional_pay_stage_c1_request_v1','jsonb->jsonb',
    v_request_body_hash,v_before_hash,
    pg_catalog.jsonb_build_object(
      'publication_request_id',v_publication.id,'generation_id',v_generation.id,
      'request_sha256',pg_catalog.encode(v_c1_request_hash,'hex')
    ),v_after_hash,v_after_hash,'COMPLETE',pg_catalog.statement_timestamp()
  );

  if p_request ? 'automatic_reconcile_selection_sha256' then
    -- The assertion reads the actual sealed complete vector and native rows.
    -- Any refusal rolls back this entire stage, including its unaccepted event.
    perform private.weekly_source_automatic_reconcile_certificate_v1(v_publication.id,v_actor_user_id,v_cycle.id);
  end if;
  return pg_catalog.jsonb_build_object(
    'ok',true,'outcome','STAGED','idempotent_replay',false,
    'family_id',v_family.id,'generation_id',v_generation.id,
    'approval_id',v_approval.id,'publication_request_id',v_publication.id,
    'request_sha256',pg_catalog.encode(v_publication.request_sha256,'hex'),
    'source_count',v_expected_source_count,
    'component_count',v_expected_component_count,
    'approved_pay_ex_vat',pg_catalog.to_char(v_total_pay,'FM9999999990.00'),
    'new_family_bound_version',v_family.bound_version+1,'state','READY'
  );
exception
  when no_data_found or too_many_rows then
    raise exception 'WEEKLY_PROTECTED_C1_STAGE_SCOPE_INVALID' using errcode='55000';
end;
$function$;

revoke all on function private.weekly_source_protected_local_stage_engine_v1(jsonb,uuid,boolean)
 from public,anon,authenticated,service_role;

create or replace function private.weekly_source_pay_decision_native_local_payload_validate_v1(p_request jsonb,p_preparation_id uuid)
returns jsonb language sql volatile security definer set search_path=pg_catalog,private,public as $function$
 select private.weekly_source_protected_local_stage_engine_v1(p_request,p_preparation_id,true);
$function$;
revoke all on function private.weekly_source_pay_decision_native_local_payload_validate_v1(jsonb,uuid)
 from public,anon,authenticated,service_role;

create or replace function private.weekly_exceptional_pay_stage_c1_request_impl_v1(p_request jsonb,p_source_decision_preparation_id uuid)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public as $function$
declare result jsonb;prep private.weekly_source_pay_decision_unprotect_preparations%rowtype;
begin
 result:=private.weekly_source_protected_local_stage_engine_v1(p_request,p_source_decision_preparation_id,false);
 if p_source_decision_preparation_id is null then return result;end if;
 select p.* into strict prep from private.weekly_source_pay_decision_unprotect_preparations p where p.id=p_source_decision_preparation_id;
 if result->'ok' is distinct from 'true'::jsonb
  or result->>'publication_request_id' is distinct from prep.payload_json#>>'{complete_request,publication_request_id}'
  or result->>'request_sha256' is distinct from prep.payload_json#>>'{complete_request,expected_request_sha256}' then
  raise exception 'SOURCE_NATIVE_LOCAL_STAGE_RESULT_INVALID' using errcode='23514';end if;
 -- Both real native owners share this one outer ACCEPT transaction. Source
 -- callers receive only the final exact composed result, never a staged label.
 return private.weekly_exceptional_pay_complete_local_impl_v1(prep.payload_json->'complete_request',prep.id);
end;
$function$;
revoke all on function private.weekly_exceptional_pay_stage_c1_request_impl_v1(jsonb,uuid)
 from public,anon,authenticated,service_role;

create or replace function public.weekly_exceptional_pay_stage_c1_request_v1(p_request jsonb)
returns jsonb language sql volatile security definer set search_path=pg_catalog,private,public as $function$
 select private.weekly_exceptional_pay_stage_c1_request_impl_v1(p_request,null);
$function$;
revoke all on function public.weekly_exceptional_pay_stage_c1_request_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_exceptional_pay_stage_c1_request_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/20_native_local_stage_implementation.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/21_native_local_complete_implementation.sqlinc
create or replace function private.weekly_exceptional_pay_complete_local_impl_v1(p_request jsonb,p_source_decision_preparation_id uuid)
returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','pg_catalog','pg_temp'
set lock_timeout to '2500ms'
set statement_timeout to '30s'
as $function$
declare
  v_source_gate jsonb;v_source_application_id uuid;v_source_control jsonb;v_source_entitlement jsonb;
  v_placement jsonb;v_checked_placement jsonb;
  v_source_head public.weekly_source_entitlement_heads%rowtype;
  v_source_receipt private.weekly_source_entitlement_publication_receipts%rowtype;
  v_source_pending public.weekly_source_pending_entitlement_bundles%rowtype;
  v_keys constant text[]:=array['schema_version','actor_user_id','publication_request_id',
    'expected_request_sha256','idempotency_key'];
  v_actor uuid;
  v_request_id uuid;
  v_hash bytea;
  v_key text;
  v_request public.weekly_exceptional_c1_publication_requests%rowtype;
  v_generation public.weekly_exceptional_pay_generations%rowtype;
  v_family public.weekly_exceptional_pay_target_families%rowtype;
  v_run public.weekly_exceptional_orchestration_runs%rowtype;
  v_approval public.weekly_exceptional_payment_approvals%rowtype;
  v_root public.timesheets%rowtype;
  v_fin public.timesheets_financials%rowtype;
  v_receipt private.weekly_source_local_protected_decision_receipts%rowtype;
  v_locks jsonb;
  v_snapshot jsonb;
  v_result jsonb;
  v_write jsonb;
  v_proposal jsonb;
  v_components jsonb;
  v_automatic_components jsonb;
  v_expenses jsonb;
  v_head_request jsonb;
  v_target_state text;
  v_source_hash bytea;
  v_result_hash bytea;
  v_live_authorisations integer;
  v_bundle_id uuid;
  v_local_context jsonb;
  v_local_origin jsonb;
  v_pending boolean:=false;
  v_manual_review_id uuid;
  v_rate_policy_hash bytea;
  v_scope_date date; v_scope_group uuid; v_scope_client uuid;
begin
  if coalesce(pg_catalog.current_setting('request.jwt.claim.role',true),
       nullif(pg_catalog.current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
  end if;
  if not private.weekly_exceptional_json_keys_exact_v1(p_request,v_keys)
     or not (p_request ?& v_keys)
     or p_request->>'schema_version'<>'WEEKLY_PROTECTED_LOCAL_COMPLETE_V1' then
    raise exception 'WEEKLY_PROTECTED_LOCAL_COMPLETE_INVALID' using errcode='22023';
  end if;
  v_actor:=(p_request->>'actor_user_id')::uuid;
  v_request_id:=(p_request->>'publication_request_id')::uuid;
  v_hash:=private.weekly_exceptional_hex_sha256_v1(p_request->>'expected_request_sha256');
  v_key:=pg_catalog.btrim(coalesce(p_request->>'idempotency_key',''));
  if v_actor is null or v_request_id is null or pg_catalog.char_length(v_key) not between 16 and 240
     or not private.weekly_source_pay_actor_allowed_v1(v_actor) then
    raise exception 'WEEKLY_PROTECTED_LOCAL_COMPLETE_SCOPE_INVALID' using errcode='42501';
  end if;

  -- Exact committed receipt precedes freshness checks, locks and publication.
  select * into v_receipt from private.weekly_source_local_protected_decision_receipts
    where publication_request_id=v_request_id;
  -- The retained action's own report cutoff remains the Office authority,
  -- including exact replay. Work date and a later unrelated upload are not it.
  select c.finalisation_week_ending,c.source_group_id,a.client_id
    into strict v_scope_date,v_scope_group,v_scope_client
    from public.weekly_exceptional_c1_publication_requests r
    join public.weekly_exceptional_payment_approvals a
      on a.creation_orchestration_run_id=r.orchestration_run_id and a.pay_target_family_id=r.family_id
    join public.weekly_source_cycles c on c.id=a.source_cycle_id
    where r.id=v_request_id;
  perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',
    v_scope_group,v_scope_client,v_scope_date);
  select * into strict v_request from public.weekly_exceptional_c1_publication_requests where id=v_request_id;
  if p_source_decision_preparation_id is null then
    v_source_gate:=private.weekly_source_pay_decision_native_normal_gate_v1(
      v_request.family_id,v_request.orchestration_run_id,v_actor,'COMPLETE_LOCAL');
    if v_source_gate is not null then return v_source_gate; end if;
  else
    v_source_application_id:=private.weekly_source_pay_decision_native_request_scope_v1(
      p_source_decision_preparation_id,p_request,'COMPLETE_LOCAL',true);
  end if;
  -- SELECT INTO above changes FOUND; test the retained receipt identity itself.
  if v_receipt.publication_request_id is not null then
    if v_receipt.actor_user_id is distinct from v_actor or v_receipt.request_sha256 is distinct from v_hash
       or v_receipt.idempotency_key is distinct from v_key or v_receipt.state='PREPARING' then
      raise exception 'WEEKLY_PROTECTED_LOCAL_REPLAY_CONFLICT' using errcode='55000';
    end if;
    return v_receipt.result_json||jsonb_build_object('idempotent_replay',true);
  end if;
  perform private.weekly_source_pay_query_admit_v2();
  select * into strict v_request from public.weekly_exceptional_c1_publication_requests where id=v_request_id;
  -- I-1: Candidate serial gate, then all canonical family members, then rows.
  v_placement:=private.weekly_source_protected_current_placement_v1(v_request.family_id,
    (select a.work_event_id from public.weekly_exceptional_payment_approvals a
     where a.creation_orchestration_run_id=v_request.orchestration_run_id and a.pay_target_family_id=v_request.family_id),false);
  if v_placement->'moved'='true'::jsonb then
    perform private.timesheet_contract_move_family_lock_v1((v_placement->>'original_root_timesheet_id')::uuid);
    v_locks:=jsonb_build_object('ok',true);
  else
    v_locks:=private.weekly_source_lock_and_resolve_families_v1(v_request.candidate_id,
      array[v_request.root_timesheet_id],'WORKBENCH_CANDIDATE_ENTITLEMENT_PUBLICATION',
      v_request.id,'WEEKLY_SOURCE_ENTITLEMENT_PUBLICATION');
  end if;
  v_checked_placement:=private.weekly_source_protected_current_placement_v1(v_request.family_id,
    (select a.work_event_id from public.weekly_exceptional_payment_approvals a
     where a.creation_orchestration_run_id=v_request.orchestration_run_id and a.pay_target_family_id=v_request.family_id),false);
  if v_checked_placement is distinct from v_placement then
    raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001';end if;
  if coalesce((v_locks->>'ok')::boolean,false) is not true then
    return v_locks||jsonb_build_object('ok',false);
  end if;
  select * into v_receipt from private.weekly_source_local_protected_decision_receipts
    where publication_request_id=v_request_id;
  if found then
    if v_receipt.actor_user_id is distinct from v_actor or v_receipt.request_sha256 is distinct from v_hash
       or v_receipt.idempotency_key is distinct from v_key or v_receipt.state='PREPARING' then
      raise exception 'WEEKLY_PROTECTED_LOCAL_REPLAY_CONFLICT' using errcode='55000';
    end if;
    return v_receipt.result_json||jsonb_build_object('idempotent_replay',true);
  end if;
  select * into strict v_family from public.weekly_exceptional_pay_target_families
    where id=v_request.family_id for update;
  select * into strict v_request from public.weekly_exceptional_c1_publication_requests
    where id=v_request_id for update;
  select * into strict v_generation from public.weekly_exceptional_pay_generations
    where id=v_request.generation_id and family_id=v_family.id for update;
  select * into strict v_run from public.weekly_exceptional_orchestration_runs
    where id=v_request.orchestration_run_id and family_id=v_family.id for update;
  select * into strict v_approval from public.weekly_exceptional_payment_approvals
    where creation_orchestration_run_id=v_run.id and pay_target_family_id=v_family.id for share;
  select * into strict v_root from public.timesheets where timesheet_id=(v_placement->>'current_timesheet_id')::uuid for update;
  select * into strict v_fin from public.timesheets_financials
    where timesheet_id=v_root.timesheet_id and is_current for update;
  if v_hash is distinct from v_request.request_sha256 or v_run.requested_by_user_id is distinct from v_actor
     or v_request.state<>'READY' or v_run.state<>'RUNNING' or v_generation.lifecycle_state<>'PENDING_C1'
     or v_request.c1_operation_id is not null or v_request.c1_publication_id is not null
     or v_request.c1_head_revision is not null or v_request.c1_receipt_sha256 is not null
     or exists(select 1 from public.weekly_exceptional_c1_publication_checkpoints c where c.publication_request_id=v_request.id)
     or exists(select 1 from public.weekly_exceptional_c1_unknown_outcomes u
                where u.publication_request_id=v_request.id and u.state='RECOVERY_REQUIRED')
     or v_family.current_generation_id is distinct from v_generation.prior_generation_id
     or v_family.current_generation_number+1 is distinct from v_generation.generation_number
     or v_fin.id is distinct from v_request.financial_row_id
     or not v_root.is_current or v_root.revoked_at is not null or v_root.archived_at_utc is not null
     or v_root.contract_id::text is distinct from v_placement->>'current_contract_id'
     or v_request.root_timesheet_id is distinct from v_root.timesheet_id or v_request.contract_id is distinct from v_root.contract_id
     or v_root.week_ending_date is distinct from v_family.week_ending_date
     or v_root.version is distinct from (v_generation.complete_next_vector_json#>>'{target_snapshot,tsfin_snapshot_json,timesheet_version}')::integer
     or v_approval.withdrawn_at_utc is not null
     or exists(select 1 from private.weekly_source_local_protected_decision_receipts r
               where r.family_id=v_family.id and r.state='PENDING_FREEZE') then
    raise exception 'WEEKLY_PROTECTED_LOCAL_STATE_CHANGED' using errcode='55000';
  end if;
  select target.resulting_lifecycle_state into strict v_target_state
    from public.weekly_exceptional_pay_target_events target
    where target.financial_generation_id=v_generation.id and target.family_id=v_family.id;
  select event.source_proposal_hash into strict v_source_hash
    from public.weekly_exceptional_pay_family_events event
    where event.evidence_approval_id=v_approval.id and event.family_id=v_family.id;
  select private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_RATE_POLICY_V1',
    jsonb_build_object('contract_id',v_family.contract_id,'rates_json',contract.rates_json,
      'policy',private._weekly_source_effective_policy_v1(v_approval.client_id,v_family.contract_id,
        v_approval.protected_work_date),'classification',event.rate_classification_json))
    into strict v_rate_policy_hash
    from public.weekly_exceptional_pay_family_events event
    join public.contracts contract on contract.id=v_family.contract_id
    where event.evidence_approval_id=v_approval.id and event.family_id=v_family.id;
  if v_rate_policy_hash is distinct from v_approval.contract_rate_policy_source_fingerprint then
    raise exception 'WEEKLY_PROTECTED_LOCAL_RATE_POLICY_CHANGED' using errcode='40001';
  end if;
  v_snapshot:=v_generation.complete_next_vector_json#>'{target_snapshot,tsfin_snapshot_json}';
  if jsonb_typeof(v_snapshot) is distinct from 'object'
     or private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',
        v_generation.complete_next_vector_json) is distinct from v_generation.complete_next_vector_hash
     or v_snapshot is distinct from v_approval.approved_target_pay_components_json->'tsfin_snapshot_json' then
    raise exception 'WEEKLY_PROTECTED_LOCAL_SNAPSHOT_INVALID' using errcode='55000';
  end if;
  v_snapshot:=v_snapshot||jsonb_build_object('timesheet_id',v_root.timesheet_id::text,
    'timesheet_version',v_root.version,'actual_schedule_json',
    v_generation.complete_next_vector_json#>'{target_snapshot,actual_schedule_json}');
  -- Reconfirm the staged identity proof before either mutable first-approval
  -- TSFIN or the common HEAD writer. Immutable old requests without this new
  -- metadata retain their existing route; they are not silently remapped.
  if v_generation.complete_next_vector_json ? 'protected_component_identity_basis'
     or exists(select 1 from jsonb_array_elements(v_snapshot#>'{invoice_breakdown_json,segments}') r
       where r ? 'weekly_protected_component_identity') then
    if v_generation.complete_next_vector_json#>>'{protected_component_identity_basis,schema_version}'
          is distinct from 'WEEKLY_PROTECTED_COMPONENT_MANIFEST_V1'
       or v_generation.complete_next_vector_json#>>'{protected_component_identity_basis,family_id}'
          is distinct from v_family.id::text
       or v_generation.complete_next_vector_json#>>'{protected_component_identity_basis,root_timesheet_id}'
          is distinct from v_root.timesheet_id::text
       or v_generation.complete_next_vector_json#>>'{protected_component_identity_basis,contract_id}'
          is distinct from v_root.contract_id::text
       or v_generation.complete_next_vector_json#>>'{protected_component_identity_basis,candidate_id}'
          is distinct from v_family.candidate_id::text
       or v_generation.complete_next_vector_json#>>'{protected_component_identity_basis,accepted_schedule_sha256}'
          is distinct from encode(private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_PROTECTED_COMPONENT_ACCEPTED_SCHEDULE_V1',v_snapshot->'actual_schedule_json'),'hex')
       or v_generation.complete_next_vector_json#>>'{protected_component_identity_basis,calculated_segments_sha256}'
          is distinct from encode(private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_PROTECTED_COMPONENT_CALCULATED_SEGMENTS_V1',v_snapshot#>'{invoice_breakdown_json,segments}'),'hex')
       or v_generation.complete_next_vector_json#>>'{protected_component_identity_basis,approved_components_sha256}'
          is distinct from encode(private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_PROTECTED_COMPONENT_APPROVED_COMPONENTS_V1',
            case when v_generation.complete_next_vector_json ? 'prior_effective_inventory'
              then v_generation.complete_next_vector_json#>'{prior_effective_inventory,components}'
              else '[]'::jsonb end),'hex') then
      raise exception 'WEEKLY_PROTECTED_COMPONENT_MANIFEST_UNAVAILABLE' using errcode='55000'; end if;
  end if;
  -- A manually invoked native Local owner cannot bypass the sealed automatic
  -- request's per-component zero-delta proof. This is before PREPARING insert.
  if v_generation.complete_next_vector_json ? 'automatic_reconcile_proof' then
    perform private.weekly_source_automatic_reconcile_delta_assert_v1(v_request.id,v_actor);
  end if;
  select count(*) into v_live_authorisations from public.weekly_source_root_authorisations authority
    where authority.root_timesheet_id=v_root.timesheet_id and authority.withdrawn_at_utc is null;
  -- Exact accepted replay has already returned. Before admitting a NEW
  -- authorised decision, hold the existing owner share lock and require the
  -- same actual NEXT Local writer capabilities as the winning common core.
  -- Otherwise an old freeze could park a decision that cannot later publish.
  -- First Save remains the unauthorised TSFIN path and needs no Bank owner.
  if v_live_authorisations=1 and v_root.authorised_at_server is not null then
    if pg_catalog.to_regclass('private.bpay_next_module_control') is null
       or pg_catalog.to_regprocedure('private.bpay_next_legacy_callback_enabled_v1()') is null then
      raise exception 'WEEKLY_PROTECTED_LOCAL_PUBLICATION_OWNER_NOT_READY' using errcode='55000';
    end if;
    perform private.bpay_next_legacy_callback_enabled_v1();
    if (select active_owner from private.bpay_next_module_control where id=1) is distinct from 'NEXT'
       or pg_catalog.to_regprocedure(
         'private.weekly_source_local_publication_context_v2(uuid,uuid,uuid)') is null
       or pg_catalog.to_regprocedure(
         'private.weekly_source_entitlement_proposal_request_v2(uuid,jsonb,text,uuid,bigint,uuid,uuid,jsonb,text)') is null
       or pg_catalog.to_regprocedure(
         'private.bpay_next_capture_local_source_detail_v1(uuid,uuid,bigint,uuid,uuid,uuid,jsonb)') is null then
      raise exception 'WEEKLY_PROTECTED_LOCAL_PUBLICATION_OWNER_NOT_READY' using errcode='55000';
    end if;
  end if;
  insert into private.weekly_source_local_protected_decision_receipts(
    publication_request_id,generation_id,family_id,root_timesheet_id,actor_user_id,
    request_sha256,idempotency_key,preparing_transaction_id,prior_financial_id,approved_snapshot_json,state
  ) values(v_request.id,v_generation.id,v_family.id,v_root.timesheet_id,v_actor,
    v_hash,v_key,pg_current_xact_id(),v_fin.id,v_snapshot,'PREPARING');
  if v_live_authorisations=0 and v_root.authorised_at_server is null then
    -- 24 section 4.1: mutable unauthorised TSFIN, not a fabricated Authorise.
    if v_fin.authorised_at_utc is not null or v_fin.processing_status<>'PENDING_AUTH'
       or v_snapshot->>'processing_status' is distinct from 'PENDING_AUTH'
       or nullif(v_snapshot->>'authorised_at_utc','') is not null then
      raise exception 'WEEKLY_PROTECTED_LOCAL_AUTHORISATION_CONTRADICTION' using errcode='55000';
    end if;
    v_write:=public.tsfin_write_current_snapshot_single_bounded(v_root.timesheet_id,
      v_root.version,v_snapshot,v_actor,statement_timestamp());
    if coalesce((v_write->>'ok')::boolean,false) is not true then
      raise exception 'WEEKLY_PROTECTED_LOCAL_SNAPSHOT_WRITE_REFUSED' using errcode='55000';
    end if;
    -- V4 permits display of this confirmed decision before first Authorise,
    -- but never admission to Banking. Seal the actual written row, not the
    -- proposed input or an hours-only total. Old receipts are not backfilled.
    select * into strict v_fin from public.timesheets_financials financial
      where financial.id=(v_write->>'timesheet_financials_id')::uuid
        and financial.timesheet_id=v_root.timesheet_id and financial.is_current;
    if v_fin.authorised_at_utc is not null or v_fin.processing_status<>'PENDING_AUTH'
       or v_fin.paid_at_utc is not null or v_fin.locked_by_invoice_id is not null then
      raise exception 'WEEKLY_PROTECTED_LOCAL_SAVED_BASIS_INVALID' using errcode='55000';
    end if;
    update private.weekly_source_local_protected_decision_receipts
      set approved_snapshot_json=v_snapshot||jsonb_build_object('saved_unauthorised_basis',
        jsonb_build_object('schema_version','SAVED_UNAUTHORISED_LOCAL_V1',
          'financial_snapshot_id',v_fin.id,
          'financial_snapshot_sha256',encode(private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_SOURCE_SAVED_UNAUTHORISED_FINANCIAL_V1',to_jsonb(v_fin)),'hex'),
          'detail_sha256',encode(private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_SOURCE_SAVED_UNAUTHORISED_DETAIL_V1',jsonb_build_object(
              'segments',v_fin.invoice_breakdown_json->'segments',
              'actual_schedule',v_fin.actual_schedule_json,
              'additional_units',v_fin.additional_units_json)),'hex'),
          'inventory_sha256',encode(v_generation.complete_next_vector_hash,'hex'),
          'root_version',v_root.version,'family_booking_id',v_root.booking_id))
      where publication_request_id=v_request.id and state='PREPARING'
        and preparing_transaction_id=pg_current_xact_id();
    if not found then
      raise exception 'WEEKLY_PROTECTED_LOCAL_SAVED_BASIS_INVALID' using errcode='55000';
    end if;
    v_result:=jsonb_build_object('authority','UNAUTHORISED_TSFIN',
      'timesheet_financials_id',v_write->'timesheet_financials_id','requires_first_authorisation',true);
  elsif v_live_authorisations=1 and v_root.authorised_at_server is not null then
    -- Already authorised: the only later entitlement writer is the existing
    -- common-head publisher. Never rotate TSFIN, change Drafts or invoke C1.
    -- The real stage advances its own family bound version after sealing the
    -- old entitlement. The factual context proves that exact stage and the
    -- unchanged whole inventory, rather than treating the own increment as
    -- an unrelated intervening financial change.
    v_local_context:=private.weekly_source_local_publication_context_v2(v_request.id,v_generation.id,v_root.timesheet_id);
    if v_local_context is null then
      raise exception 'WEEKLY_PROTECTED_LOCAL_SOURCE_QUALIFICATION_UNAVAILABLE' using errcode='55000'; end if;
    if v_generation.complete_next_vector_json ? 'automatic_reconcile_proof' then
      -- Exactly the producer used by delta_assert; no separately guessed vector.
      v_automatic_components:=private.weekly_source_staged_entitlement_components_v1(v_request.id,v_actor);
      v_components:=v_automatic_components->'components';
      v_expenses:=v_automatic_components->'expenses';
    else
    select coalesce(jsonb_agg(jsonb_build_object('work_event_id',expense.work_event_id,
      'source_observation_kind',expense.source_observation_kind,
      'candidate_reimbursement_ex_vat',expense.candidate_reimbursement_ex_vat,
      'client_charge_ex_vat',expense.client_charge_ex_vat) order by expense.work_event_id),'[]'::jsonb)
      into v_expenses from (
        select authority.*,row_number() over(partition by authority.work_event_id
          order by cycle.finalisation_week_ending desc,revision.finalised_at_utc desc,
            authority.generation desc,authority.id desc) event_rank
        from public.weekly_expense_authority_generations authority
        join public.weekly_source_final_revisions revision on revision.id=authority.final_revision_id and revision.state='CURRENT'
        join public.weekly_source_cycles cycle on cycle.id=revision.source_cycle_id
        join public.weekly_source_cycles action_cycle on action_cycle.id=v_approval.source_cycle_id
        where authority.contract_id=v_family.contract_id and authority.state='CURRENT'
          and cycle.source_group_id=action_cycle.source_group_id
          and exists(select 1 from public.weekly_source_row_timesheet_lineages lineage
            where lineage.work_event_id=authority.work_event_id and lineage.contract_id=authority.contract_id
              and lineage.timesheet_id=any(private.weekly_source_invoice_family_timesheet_ids_v1(v_root.timesheet_id)))
      ) expense where expense.event_rank=1 and expense.source_expense_pence>0;
    v_components:=private.weekly_source_entitlement_components_v1(
      v_snapshot#>'{invoice_breakdown_json,segments}',v_expenses);
    -- Reuse the existing pure approved-additional mapper on the sealed
    -- calculator snapshot. It validates exact saved units/rates/totals and
    -- booking-family identity; it does not read or reprice live financial data.
    v_components:=private.weekly_source_initial_additional_components_v2(v_components,
      v_snapshot->'additional_units_json',
      (v_snapshot->>'additional_pay_ex_vat')::numeric,
      (v_snapshot->>'additional_charge_ex_vat')::numeric,v_root.booking_id);
    end if;
    -- Source expenses must be the same approved observations and money, not
    -- a newer expense silently composed into an older protected decision.
    if (select coalesce(sum((item.value->>'pay_ex_vat')::numeric)
        filter(where not (item.value->>'exclude_from_pay')::boolean),0)
        from jsonb_array_elements(v_components) item(value)) is distinct from v_approval.approved_target_gross
       or (select coalesce(jsonb_agg(jsonb_build_object('code',upper('SOURCE_SUPPLIED:'||(item.value->>'work_event_id')),
          'pay',(item.value->>'candidate_reimbursement_ex_vat')::numeric,
          'charge',(item.value->>'client_charge_ex_vat')::numeric) order by item.value->>'work_event_id'),'[]'::jsonb)
          from jsonb_array_elements(v_expenses) item(value)) is distinct from
          (select coalesce(jsonb_agg(jsonb_build_object('code',upper(component.expense_code),
            'pay',component.pay_ex_vat,'charge',component.charge_ex_vat)
            order by component.expense_code),'[]'::jsonb)
            from public.weekly_exceptional_c1_component_records component
            where component.publication_request_id=v_request.id and component.component_kind='EXPENSE') then
      raise exception 'WEEKLY_PROTECTED_LOCAL_COMPLETE_ENTITLEMENT_CHANGED' using errcode='40001';
    end if;
    v_local_origin:=private.weekly_source_local_origin_canonical_v2(jsonb_build_object(
      'origin_kind','PROTECTED_LOCAL_DECISION_V1','publication_request_id',v_request.id,
      'generation_id',v_generation.id,'request_sha256',encode(v_request.request_sha256,'hex'),
      'source_qualification_digest',v_local_context->'source_qualification_digest',
      'policy_fingerprint',v_local_context->'policy_fingerprint','before_origin',v_local_context->'before_origin',
      'before_inventory_digest',v_local_context->'before_inventory_digest'));
    v_bundle_id:=pg_catalog.gen_random_uuid();
    update private.weekly_source_local_protected_decision_receipts set approved_snapshot_json=v_snapshot||jsonb_build_object(
      'common_decision_bundle_id',v_bundle_id,
      'local_source_qualification',v_local_context->'qualification','local_publication_origin',v_local_origin,
      'common_components_digest',encode(private.weekly_source_publication_request_digest_v1(
        (select coalesce(jsonb_agg(private.weekly_source_publication_component_canonical_v1(item.value,'protected.component')
          order by item.ordinality),'[]'::jsonb) from jsonb_array_elements(v_components) with ordinality item(value,ordinality))),'hex')),
      common_decision_bundle_id=v_bundle_id,common_bundle_revision=1,
      publication_origin_kind='PROTECTED_LOCAL_DECISION_V1',
      publication_origin_digest=private.weekly_source_publication_request_digest_v1(v_local_origin),
      source_qualification_digest=decode(v_local_context->>'source_qualification_digest','hex')
      where publication_request_id=v_request.id and state='PREPARING' and preparing_transaction_id=pg_current_xact_id();
    if not found then raise exception 'WEEKLY_PROTECTED_LOCAL_ORIGIN_SEAL_REFUSED' using errcode='55000'; end if;
    v_head_request:=private.weekly_source_entitlement_proposal_request_v2(v_root.timesheet_id,
      v_local_origin,'PROTECTED',v_bundle_id,1,pg_catalog.gen_random_uuid(),
      pg_catalog.gen_random_uuid(),v_components);
    v_proposal:=private.weekly_source_entitlement_proposal_record_v1(v_head_request,v_family.agency_id,
      v_family.contract_id,v_family.week_ending_date,v_actor);
    if coalesce((v_proposal->>'ok')::boolean,false) is not true then
      raise exception 'WEEKLY_PROTECTED_LOCAL_PROPOSAL_REFUSED' using errcode='55000';
    end if;
    v_write:=private.weekly_source_entitlement_publish_immediate_v1(v_head_request);
    if coalesce((v_write->>'ok')::boolean,false) is not true then
      raise exception '%',coalesce(v_write->>'code','WEEKLY_PROTECTED_LOCAL_HEAD_REFUSED') using errcode='55000';
    end if;
    v_pending:=coalesce((v_write->>'published')::boolean,false) is not true;
    if v_pending and v_write->>'code'<>'WEEKLY_SOURCE_PUBLICATION_DEFERRED_PENDING_FREEZE' then
      raise exception 'WEEKLY_PROTECTED_LOCAL_HEAD_RESULT_INVALID' using errcode='55000';
    end if;
    v_result:=jsonb_build_object('authority','COMMON_ENTITLEMENT_HEAD',
      'decision_bundle_id',v_bundle_id,'publication',v_write,'requires_first_authorisation',false);
  else
    raise exception 'WEEKLY_PROTECTED_LOCAL_AUTHORISATION_CONTRADICTION' using errcode='55000';
  end if;

  v_result:=v_result||jsonb_build_object('ok',true,'outcome',case when v_pending
    then 'SAVED_PENDING_FREEZE' else 'PUBLISHED' end,'idempotent_replay',false,
    'family_id',v_family.id,'generation_id',v_generation.id,'publication_request_id',v_request.id,
    'state',case when v_pending then 'PENDING' else 'LIVE' end,
    'family_bound_version',v_family.bound_version+1);
  v_result_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_LOCAL_RESULT_V1',v_result);
  if not v_pending then
    if v_family.current_generation_id is not null then
      update public.weekly_exceptional_pay_generations set lifecycle_state='SUPERSEDED',
        superseded_by_generation_id=v_generation.id,superseded_at_utc=statement_timestamp()
        where id=v_family.current_generation_id and lifecycle_state='PUBLISHED';
      if not found then raise exception 'WEEKLY_PROTECTED_LOCAL_PRIOR_GENERATION_INVALID' using errcode='55000'; end if;
    end if;
    update public.weekly_exceptional_pay_generations set lifecycle_state='PUBLISHED',
      published_at_utc=statement_timestamp(),result_hash=v_result_hash where id=v_generation.id;
    update public.weekly_exceptional_pay_target_families set current_generation_id=v_generation.id,
      current_generation_number=v_generation.generation_number,
      current_complete_target_vector_hash=v_generation.complete_next_vector_hash,
      current_source_proposal_hash=v_source_hash,current_lifecycle_state=v_target_state,
      current_component_count=v_request.expected_component_count,c1_publication_state='NONE',
      bound_version=bound_version+1 where id=v_family.id;
  else
    -- Previous effective family/head remains current while the existing frozen
    -- bundle owner holds the newly approved decision. No pretend live receipt.
    update public.weekly_exceptional_pay_target_families set c1_publication_state='NONE',
      bound_version=bound_version+1 where id=v_family.id;
  end if;
  update public.weekly_exceptional_c1_publication_requests set state='RETIRED',
    typed_result_json=v_result,completed_at_utc=statement_timestamp() where id=v_request.id;
  update public.weekly_exceptional_orchestration_runs set state='COMPLETE',
    after_state_fingerprint=v_result_hash,completed_at_utc=statement_timestamp() where id=v_run.id;
  update private.weekly_source_local_protected_decision_receipts set state=case when v_pending
    then 'PENDING_FREEZE' else 'COMPLETE' end,result_json=v_result,completed_at_utc=statement_timestamp()
    where publication_request_id=v_request.id;
  -- Finish the existing manual pay query atomically with its approved decision.
  -- The UI needs no second query command: only this accepted publication can
  -- clear the hold, using its exact retained approval and generation evidence.
  select review.id into v_manual_review_id from private.weekly_source_manual_reviews review
    join public.weekly_source_cycles cycle on cycle.id=v_approval.source_cycle_id
    where review.source_group_id=cycle.source_group_id
      and review.work_event_id=v_approval.work_event_id and review.state='OPEN'
      and review.contract_id=v_family.contract_id and review.candidate_id=v_family.candidate_id;
  insert into public.weekly_exceptional_payment_events(family_id,approval_id,event_kind,
    lifecycle_view,bounded_payload_json,idempotency_key) values(v_family.id,v_approval.id,
    'PROTECTED_STATE_OBSERVED',case when v_pending then 'PENDING' else 'LIVE' end,v_result,v_key||':payment-event');
  insert into public.weekly_exceptional_orchestration_steps(orchestration_run_id,sequence,
    step_kind,idempotency_key,allowlisted_owner_name,allowlisted_owner_signature,bounded_request_hash,
    before_state_fingerprint,bounded_owner_response_json,owner_response_hash,after_state_fingerprint,outcome,completed_at_utc)
    select v_run.id,coalesce(max(step.sequence),0)+1,'COMPLETE_LOCAL_PROTECTED_DECISION',v_key,
      'CloudTMS.weekly_exceptional_pay_complete_local_v1','jsonb',v_hash,v_run.before_state_fingerprint,
      v_result,v_result_hash,v_result_hash,case when v_pending then 'PENDING' else 'COMPLETE' end,statement_timestamp()
    from public.weekly_exceptional_orchestration_steps step where step.orchestration_run_id=v_run.id;
  if p_source_decision_preparation_id is not null then
    -- Actual native result/step are complete. Source's selected contact/query
    -- retirement follows canonical Source publication in the outer owner.
    select r.* into strict v_receipt from private.weekly_source_local_protected_decision_receipts r
      where r.publication_request_id=v_request.id;
    if v_result->>'authority'='COMMON_ENTITLEMENT_HEAD' then
      if v_pending then
        select p.* into strict v_source_pending from public.weekly_source_pending_entitlement_bundles p
          where p.id::text=v_result#>>'{publication,pending_bundle_verified}';
        v_source_entitlement:=jsonb_build_object('kind','PENDING_BUNDLE','pending_bundle_id',v_source_pending.id,
          'decision_bundle_id',v_source_pending.decision_bundle_id,'bundle_revision',v_source_pending.bundle_revision::text);
      else
        select r.* into strict v_source_receipt from private.weekly_source_entitlement_publication_receipts r
          where r.decision_bundle_id=v_receipt.common_decision_bundle_id and r.bundle_revision=v_receipt.common_bundle_revision
            and r.member_root_ids=array[v_receipt.root_timesheet_id] and r.candidate_id=v_family.candidate_id;
        select h.* into strict v_source_head from public.weekly_source_entitlement_heads h
          where h.id=v_source_receipt.head_ids[1] and h.root_timesheet_id=v_receipt.root_timesheet_id;
        v_source_entitlement:=jsonb_build_object('kind','COMMITTED_HEAD','decision_bundle_id',v_source_receipt.decision_bundle_id,
          'bundle_revision',v_source_receipt.bundle_revision::text,'source_head_id',v_source_head.id,'publication_receipt_id',v_source_receipt.id);
      end if;
    end if;
    v_source_control:=jsonb_build_object('family_id',v_family.id,'orchestration_run_id',v_run.id,'approval_id',v_approval.id,
      'generation_id',v_generation.id,'publication_request_id',v_request.id,'new_family_bound_version',v_result->>'family_bound_version',
      'local_state',v_receipt.state,'authority',v_result->>'authority','requires_first_authorisation',v_result->'requires_first_authorisation',
      'timesheet_financials_id',v_result->'timesheet_financials_id','entitlement',v_source_entitlement,
      'local_receipt_sha256',encode(private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_LOCAL_RECEIPT_ROW_V1',to_jsonb(v_receipt)),'hex'),
      'native_result_sha256',encode(v_result_hash,'hex'));
    return private.weekly_source_pay_decision_record_native_adoption_v1(
      p_source_decision_preparation_id,v_source_application_id,v_source_control);
  end if;
  -- Finish the actual completion evidence before any query resolution or
  -- accepted-status read, in this same outer transaction; a refusal rolls back
  -- the decision, publication, completion step and query together.
  if v_manual_review_id is not null and v_run.request_kind in ('APPROVE','AMEND') then
    perform public.weekly_source_manual_review_resolve_v1(jsonb_build_object('actor_user_id',v_actor,
      'review_id',v_manual_review_id,'resolution_kind','PROTECTED_PAY',
      'command_id',v_request.id,'accepted_approval_id',v_approval.id,
      'accepted_generation_id',v_generation.id));
  elsif v_manual_review_id is not null and v_run.request_kind in ('WITHDRAW','RECONCILE') then
    perform public.weekly_source_manual_review_resolve_v1(jsonb_build_object('actor_user_id',v_actor,
      'review_id',v_manual_review_id,'resolution_kind','OFFICE_ACCEPTED_SOURCE',
      'command_id',v_request.id,'accepted_approval_id',v_approval.id,
      'accepted_generation_id',v_generation.id));
  end if;
  -- Accepted pending approval is not publication. The existing release
  -- trigger retires its contacts only after the deferred receipt is proved.
  if not v_pending then
    perform private.weekly_source_protected_contact_retire_v1(v_family.id,v_approval.work_event_id);
  end if;
  if v_manual_review_id is null or v_run.request_kind not in ('APPROVE','AMEND','WITHDRAW','RECONCILE') then
    perform private.bpay_next_source_query_refresh_v1(v_family.contract_id,v_approval.work_event_id);
  end if;
  return v_result;
exception when no_data_found or too_many_rows then
  raise exception 'WEEKLY_PROTECTED_LOCAL_COMPLETE_SCOPE_INVALID' using errcode='55000';
end;
$function$;

revoke all on function private.weekly_exceptional_pay_complete_local_impl_v1(jsonb,uuid) from public,anon,authenticated,service_role;
create or replace function public.weekly_exceptional_pay_complete_local_v1(p_request jsonb)
returns jsonb language sql volatile security definer set search_path=pg_catalog,private,public as $function$
 select private.weekly_exceptional_pay_complete_local_impl_v1(p_request,null);
$function$;
revoke all on function public.weekly_exceptional_pay_complete_local_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_exceptional_pay_complete_local_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/21_native_local_complete_implementation.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/22_full_native_payload_preparation.sqlinc
create or replace function public.weekly_source_pay_decision_unprotect_prepare_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public as $function$
declare prep private.weekly_source_pay_decision_unprotect_preparations%rowtype;
 review private.weekly_source_pay_decision_reviews%rowtype;assembly private.weekly_source_pay_decision_preview_assemblies%rowtype;
 quote private.weekly_source_pay_decision_preview_quotes%rowtype;cut private.bpay_next_source_pay_decision_cut%rowtype;
 confirmation private.weekly_source_pay_decision_requests%rowtype;
 payload jsonb;facts jsonb;observation jsonb;validated jsonb;economic jsonb;quantities jsonb;components jsonb;
 context_hash bytea;payload_hash bytea;target_hash bytea;placement_hash bytea;policy_hash bytea;actor uuid;native_request jsonb;
begin
 if coalesce(current_setting('request.jwt.claim.role',true),nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['version','decision_id','member_key','review_id','review_digest',
  'accept_or_resume_request_id','actor_user_id','native_payload']) or not(p_request ?& array['version','decision_id','member_key','review_id',
  'review_digest','accept_or_resume_request_id','actor_user_id','native_payload'])
  or p_request->>'version' is distinct from 'SOURCE_UNPROTECT_PREPARATION_V1' then
  raise exception 'SOURCE_UNPROTECT_PREPARATION_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;
 if actor is null or not private.weekly_source_pay_actor_allowed_v1(actor) then
  raise exception 'SOURCE_PAY_DECISION_ACTOR_REQUIRED' using errcode='42501';end if;
 select p.* into strict prep from private.weekly_source_pay_decision_unprotect_preparations p
  where p.decision_id=(p_request->>'decision_id')::uuid and p.member_key=p_request->>'member_key'
   and p.accept_or_resume_request_id=(p_request->>'accept_or_resume_request_id')::uuid;
 select r.* into strict review from private.weekly_source_pay_decision_reviews r where r.id=prep.review_id;
 select a.* into strict assembly from private.weekly_source_pay_decision_preview_assemblies a where a.id=review.preview_assembly_id;
 select q.* into strict quote from private.weekly_source_pay_decision_preview_quotes q where q.assembly_id=assembly.id and q.member_key=prep.member_key;
 select r.* into strict confirmation from private.weekly_source_pay_decision_requests r where r.request_id=prep.accept_or_resume_request_id;
 payload:=p_request->'native_payload';payload_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_NATIVE_PAYLOAD_V1',payload);
 if prep.actor_user_id is distinct from actor or prep.review_id::text is distinct from p_request->>'review_id'
  or review.decision_id is distinct from prep.decision_id or review.review_digest is distinct from private.weekly_exceptional_hex_sha256_v1(p_request->>'review_digest')
  or assembly.actor_user_id is distinct from actor or assembly.state<>'SEALED' or assembly.decision_kind<>'EXCLUDE_FUTURE_WORK_PAY'
  or confirmation.review_id is distinct from review.id or confirmation.actor_user_id is distinct from actor
  or confirmation.request_hash is distinct from prep.confirmation_request_sha256
  or payload->>'route' is distinct from prep.route or payload->'prepare_request' is distinct from prep.native_prepare_request_json
  or not private.weekly_exceptional_json_keys_exact_v1(payload,case when prep.route='NEXT'
   then array['route','prepare_request','publish_request'] else array['route','prepare_request','stage_request','complete_request'] end)
  or not(payload ?& case when prep.route='NEXT' then array['route','prepare_request','publish_request']
   else array['route','prepare_request','stage_request','complete_request'] end) then
  raise exception 'SOURCE_UNPROTECT_PREPARATION_INVALID' using errcode='23514';end if;
 -- Exact registration replay checks the whole immutable authored bundle. It
 -- never allocates another run, extends expiry, recalculates or consumes it.
 if prep.state in('PREPARED','CONSUMED') then
  if prep.payload_json is distinct from payload or prep.payload_sha256 is distinct from payload_hash then
   raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';end if;
 else
  if prep.state<>'RUN_PREPARED' or prep.expires_at_utc<=transaction_timestamp() or confirmation.metadata_state<>'CONFIRMED'
   or confirmation.receipt_json is not null or assembly.expires_at_utc<=transaction_timestamp() then
   raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';end if;
  perform private.bpay_next_source_pay_decision_cut_v1(prep.decision_id,null,review.id,true);
  select c.* into strict cut from private.bpay_next_source_pay_decision_cut c
   where c.decision_id=prep.decision_id and c.review_id=review.id and c.preview_assembly_id=assembly.id and c.pay_cut_sha256=review.pay_cut_hash;
  facts:=private.weekly_source_protected_action_facts_v1(jsonb_build_object('schema_version','WEEKLY_PROTECTED_ACTION_FACTS_V1',
   'actor_user_id',actor,'family_id',prep.family_id,'source_cycle_id',prep.native_prepared_json->'source_cycle_id',
   'work_event_id',prep.native_prepared_json->'work_event_id','protected_schedule',prep.native_prepared_json->'protected_schedule',
   'evidence_timesheet_id',null),'WITHDRAW');
  if facts->'requires_zero_financial' is distinct from 'false'::jsonb or jsonb_typeof(facts#>'{current_entitlement,current_financial}') is distinct from 'object' then
   raise exception 'SOURCE_NATIVE_PREREQUISITE_NOT_PREPARED' using errcode='55000';end if;
  observation:=private.weekly_source_unprotect_source_observation_v1(prep.family_id,(facts->>'source_cycle_id')::uuid,(facts->>'work_event_id')::uuid,facts);
  context_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_NATIVE_CONTEXT_V1',facts);
  policy_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_CALCULATION_POLICY_V1',jsonb_build_object('context_sha256',encode(context_hash,'hex')));
  placement_hash:=private.weekly_exceptional_hex_sha256_v1(facts#>>'{protected_current_placement,placement_certificate_sha256}');
  if context_hash is distinct from private.weekly_exceptional_hex_sha256_v1(quote.quote_json->>'context_sha256')
   or quote.quote_json->>'calculation_policy_sha256' is distinct from encode(policy_hash,'hex')
   or quote.quote_json#>>'{economic_target,policy_sha256}' is distinct from encode(policy_hash,'hex')
   or observation->>'source_observation_sha256' is distinct from quote.quote_json->>'source_observation_sha256'
   or facts->>'family_bound_version' is distinct from prep.family_bound_version::text then
   raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';end if;
  -- Run-bearing validation invokes the complete actual native preflight and
  -- returns before its first financial/control INSERT. No ensure fallback.
  perform private.weekly_source_pay_decision_native_snapshot_assert_v1(quote.quote_json#>'{economic_target,tsfin_snapshot_json}',facts);
  if prep.route='NEXT' then
   native_request:=payload->'publish_request';
   validated:=private.weekly_source_pay_decision_native_next_payload_validate_v1(native_request,prep.id);
   components:=native_request#>'{target_snapshot,components}';
  else
   native_request:=payload->'stage_request';
   validated:=private.weekly_source_pay_decision_native_local_payload_validate_v1(native_request,prep.id);
   if not private.weekly_exceptional_json_keys_exact_v1(payload->'complete_request',array['schema_version','actor_user_id','publication_request_id','expected_request_sha256','idempotency_key'])
    or not(payload->'complete_request' ?& array['schema_version','actor_user_id','publication_request_id','expected_request_sha256','idempotency_key'])
    or payload#>>'{complete_request,schema_version}' is distinct from 'WEEKLY_PROTECTED_LOCAL_COMPLETE_V1'
    or payload#>>'{complete_request,actor_user_id}' is distinct from actor::text
    or payload#>>'{complete_request,publication_request_id}' is distinct from native_request#>>'{c1_request,request_id}'
    or payload#>>'{complete_request,expected_request_sha256}' is distinct from native_request#>>'{c1_request,request_sha256}'
    or payload#>>'{complete_request,idempotency_key}' is distinct from prep.child_idempotency_key||':local-complete' then
    raise exception 'SOURCE_UNPROTECT_PREPARATION_INVALID' using errcode='23514';end if;
   select coalesce(jsonb_agg(jsonb_build_object('component',item.value-array['record_type','component_id','component_ordinal','source_ordinal','component_sha256'],
     'authority',case when native_request->'c1_sources'->((item.value->>'source_ordinal')::integer-1)->>'authority_kind'
       =quote.quote_json#>'{economic_target,component_economics}'->(item.ordinality::integer-1)#>>'{authority,kind}'
      then quote.quote_json#>'{economic_target,component_economics}'->(item.ordinality::integer-1)->'authority' else 'null'::jsonb end)
     order by item.ordinality),'[]'::jsonb)
    into components from jsonb_array_elements(native_request->'c1_components') with ordinality item(value,ordinality);
  end if;
  if validated->>'version' is distinct from 'SOURCE_NATIVE_VALIDATED_REQUEST_V1' or validated->>'route' is distinct from prep.route
   or validated->>'family_id' is distinct from prep.family_id::text or validated->>'orchestration_run_id' is distinct from prep.orchestration_run_id::text then
   raise exception 'SOURCE_UNPROTECT_PREPARATION_INVALID' using errcode='23514';end if;
  select coalesce(jsonb_agg(jsonb_build_object('cut_id',m.cut_id,'cut_member_no',m.member_no::text,'member_sha256',encode(m.member_sha256,'hex'),
   'family_root_id',m.family_root_id,'source_row_id',m.original_source_row_id,'source_work_event_id',m.source_work_event_id,
   'canonical_work_id',m.canonical_work_id,'canonical_component_key',m.canonical_component_key,'scope_kind',m.scope_kind,'scope_mode',m.scope_mode,
   'work_dates',to_jsonb(m.work_dates),'supported_quantity_json',m.supported_quantity_json,'excluded_quantity_json',m.excluded_quantity_json)
   order by m.member_no),'[]'::jsonb) into quantities from private.bpay_next_source_pay_decision_cut_member m
   where m.cut_id=cut.id and m.member_key=prep.member_key;
  if jsonb_array_length(quantities)=0 then raise exception 'SOURCE_UNPROTECT_PREPARATION_INVALID' using errcode='23514';end if;
  -- The saved quote came from the same native calculator. Reconstruct ALL its
  -- economic fields from the admitted complete bundle + unchanged native facts,
  -- retaining the new Source policy witness independently authored above from
  -- the exact opaque current server context hash. Existing native hashes stay.
  economic:=jsonb_build_object('version','SOURCE_UNPROTECT_ECONOMIC_TARGET_V1','family_id',prep.family_id,
   'root_timesheet_id',facts->'root_timesheet_id','work_event_id',facts->'work_event_id',
   'accepted_placement_sha256',case when facts#>'{protected_current_placement,moved}'='true'::jsonb
    then facts#>'{protected_current_placement,placement_certificate_sha256}' else 'null'::jsonb end,
   'actual_schedule_json',case when prep.route='NEXT' then quote.quote_json#>'{economic_target,actual_schedule_json}'
     else validated#>'{target_snapshot,actual_schedule_json}' end,
   'tsfin_snapshot_json',case when prep.route='NEXT' then quote.quote_json#>'{economic_target,tsfin_snapshot_json}'
     else validated#>'{target_snapshot,tsfin_snapshot_json}' end,'component_economics',components,
   'quantity_partition',quantities,'provider',facts->'provider','policy_sha256',quote.quote_json->'calculation_policy_sha256',
   'source_observation_sha256',observation->'source_observation_sha256',
   'approval_evidence_sha256',facts#>'{protected_current_placement,immutable_original_evidence_sha256}',
   'prior_commitment_cut_sha256',encode(cut.pay_cut_sha256,'hex'));
  -- Numeric JSONB scale is not a selection/economic difference. Hash the exact
  -- saved Worker-authored quote after full native semantic equality; native
  -- receipt domains below continue to hash actual server rows verbatim.
  target_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_ECONOMIC_TARGET_V1',quote.quote_json->'economic_target');
  if economic is distinct from quote.quote_json->'economic_target' or target_hash is distinct from quote.economic_target_sha256
   or encode(target_hash,'hex') is distinct from quote.quote_json->>'economic_target_sha256'
   or quote.quote_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_PREVIEW_QUOTE_V1',quote.quote_json) then
   raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='P0001';end if;
  select p.* into strict prep from private.weekly_source_pay_decision_unprotect_preparations p where p.id=prep.id for update;
  if prep.state='RUN_PREPARED' then
   update private.weekly_source_pay_decision_unprotect_preparations p set state='PREPARED',source_phase=observation->>'source_phase',
    source_revision=(observation->>'source_revision')::uuid,native_source_sha256=decode(observation->>'native_source_sha256','hex'),
    source_observation_sha256=decode(observation->>'source_observation_sha256','hex'),placement_certificate_sha256=placement_hash,
    context_sha256=context_hash,reviewed_target_sha256=target_hash,payload_sha256=payload_hash,payload_json=payload
    where p.id=prep.id and p.state='RUN_PREPARED' and p.expires_at_utc>transaction_timestamp() returning p.* into strict prep;
  elsif prep.state not in('PREPARED','CONSUMED') or prep.payload_json is distinct from payload or prep.payload_sha256 is distinct from payload_hash then
   raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';end if;
 end if;
 return jsonb_build_object('version','SOURCE_UNPROTECT_PREPARATION_RESULT_V1','preparation_id',prep.id,'decision_id',prep.decision_id,
  'member_key',prep.member_key,'review_id',prep.review_id,'accept_or_resume_request_id',prep.accept_or_resume_request_id,
  'orchestration_run_id',prep.orchestration_run_id,'payload_sha256',encode(prep.payload_sha256,'hex'),'expires_at_utc',prep.expires_at_utc);
exception when no_data_found or too_many_rows or invalid_text_representation or numeric_value_out_of_range then
 raise exception 'SOURCE_UNPROTECT_PREPARATION_INVALID' using errcode='23514';
end;
$function$;
revoke all on function public.weekly_source_pay_decision_unprotect_prepare_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_unprotect_prepare_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/22_full_native_payload_preparation.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/23_same_transaction_native_dispatch.sqlinc
-- Actual nested dispatcher: no network, alternate price calculation or native
-- standalone financial command. Unexpected errors roll back the outer ACCEPT.
create or replace function private.weekly_source_pay_decision_unprotect_apply_v1(
 p_preparation_id uuid,p_decision_id uuid,p_member_key text,p_request_id uuid
) returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public as $function$
declare prep private.weekly_source_pay_decision_unprotect_preparations%rowtype;
 app private.weekly_source_pay_decision_acceptance_applications%rowtype;
 adoption private.weekly_source_pay_decision_native_adoptions%rowtype;
 application_id uuid;result jsonb;before_native jsonb;native_message text;
begin
 select p.* into strict prep from private.weekly_source_pay_decision_unprotect_preparations p where p.id=p_preparation_id;
 select a.* into strict app from private.weekly_source_pay_decision_acceptance_applications a where a.request_id=p_request_id;
 if prep.decision_id is distinct from p_decision_id or prep.member_key is distinct from p_member_key
  or prep.accept_or_resume_request_id is distinct from p_request_id or app.decision_id is distinct from prep.decision_id
  or app.review_id is distinct from prep.review_id or app.actor_user_id is distinct from prep.actor_user_id
  or not private.weekly_source_pay_actor_allowed_v1(prep.actor_user_id) then
  raise exception 'SOURCE_UNPROTECT_APPLICATION_MISMATCH' using errcode='23514';end if;
 if prep.state='CONSUMED' then
  select a.* into strict adoption from private.weekly_source_pay_decision_native_adoptions a
   where a.application_id=app.id and a.member_key=prep.member_key and a.preparation_id=prep.id;
  if app.state<>'COMMITTED' and (app.backend_pid<>pg_backend_pid() or app.transaction_id<>pg_current_xact_id() or app.state<>'PREVALIDATED')
   or adoption.origin<>'APPLIED_IN_THIS_TRANSACTION' or adoption.native_result_json is distinct from prep.native_receipt_json
   or adoption.native_result_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_COMPOSED_RESULT_V1',adoption.native_result_json) then
   raise exception 'SOURCE_UNPROTECT_APPLICATION_MISMATCH' using errcode='23514';end if;
  return adoption.native_result_json;
 end if;
 application_id:=private.weekly_source_pay_decision_unprotect_application_v1(prep.id);
 if application_id is distinct from app.id then raise exception 'SOURCE_UNPROTECT_APPLICATION_MISMATCH' using errcode='23514';end if;
 before_native:=private.weekly_source_pay_decision_native_rollback_witness_v1(prep.id);
 begin
 if prep.route='NEXT' then
  result:=private.weekly_exceptional_pay_publish_next_impl_v1(prep.payload_json->'publish_request',prep.id);
 elsif prep.route='SOURCE_LOCAL' then
  -- This real private stage owner also invokes the real complete owner before
  -- returning. A successful STAGED-only label cannot escape this transaction.
  result:=private.weekly_exceptional_pay_stage_c1_request_impl_v1(prep.payload_json->'stage_request',prep.id);
 else raise exception 'SOURCE_UNPROTECT_ROUTE_INVALID' using errcode='23514';end if;
 exception when sqlstate '55000' then
  get stacked diagnostics native_message=MESSAGE_TEXT;
  -- The one actual native missing-publication-owner refusal is the bounded
  -- dependency allowlist. Stale, permission, identity, integrity and all other
  -- programming errors propagate and roll back the complete outer envelope.
  if native_message is distinct from 'WEEKLY_PROTECTED_LOCAL_PUBLICATION_OWNER_NOT_READY' or prep.route<>'SOURCE_LOCAL' then raise;end if;
  -- PostgreSQL has rolled back this ENTIRE native stage+complete subtransaction.
  return private.weekly_source_pay_decision_native_dependency_v1(prep.id,before_native);
 end;
 select a.* into strict adoption from private.weekly_source_pay_decision_native_adoptions a
  where a.application_id=app.id and a.member_key=prep.member_key and a.preparation_id=prep.id;
 select p.* into strict prep from private.weekly_source_pay_decision_unprotect_preparations p where p.id=prep.id;
 if prep.state<>'CONSUMED' or result is distinct from prep.native_receipt_json or result is distinct from adoption.native_result_json
  or result->>'version' is distinct from 'SOURCE_NATIVE_COMPOSED_RESULT_V1' or result->>'application_id' is distinct from app.id::text
  or result->>'decision_id' is distinct from app.decision_id::text or result->>'request_id' is distinct from app.request_id::text
  or result->>'review_id' is distinct from app.review_id::text or result->>'member_key' is distinct from prep.member_key
  or result->>'preparation_id' is distinct from prep.id::text or result->>'route' is distinct from prep.route
  or result->>'origin' is distinct from 'APPLIED_IN_THIS_TRANSACTION' or result->>'control_status' is distinct from 'WITHDRAWN'
  or result->'failure_code' is distinct from 'null'::jsonb
  or adoption.native_result_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_COMPOSED_RESULT_V1',result) then
  raise exception 'SOURCE_UNPROTECT_NATIVE_RESULT_INVALID' using errcode='23514';end if;
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'SOURCE_UNPROTECT_APPLICATION_MISMATCH' using errcode='23514';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_unprotect_apply_v1(uuid,uuid,text,uuid)
 from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/23_same_transaction_native_dispatch.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/24_genuine_local_deferred_release_proof.sqlinc
-- Read-only derivation of the final contract's exact release proof. NULL means
-- the same genuine native result has not evolved; it never means no ownership.
create or replace function private.weekly_source_pay_decision_local_release_proof_v1(p_preparation_id uuid)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,private,public as $function$
declare prep private.weekly_source_pay_decision_unprotect_preparations%rowtype;
 app private.weekly_source_pay_decision_acceptance_applications%rowtype;
 adoption private.weekly_source_pay_decision_native_adoptions%rowtype;
 local_row private.weekly_source_local_protected_decision_receipts%rowtype;
 request public.weekly_exceptional_c1_publication_requests%rowtype;
 run public.weekly_exceptional_orchestration_runs%rowtype;
 generation public.weekly_exceptional_pay_generations%rowtype;
 step public.weekly_exceptional_orchestration_steps%rowtype;
 pending public.weekly_source_pending_entitlement_bundles%rowtype;
 receipt private.weekly_source_entitlement_publication_receipts%rowtype;
 control jsonb;original_row jsonb;current_hash bytea;
begin
 select p.* into strict prep from private.weekly_source_pay_decision_unprotect_preparations p where p.id=p_preparation_id;
 select a.* into strict app from private.weekly_source_pay_decision_acceptance_applications a where a.request_id=prep.accept_or_resume_request_id;
 select a.* into strict adoption from private.weekly_source_pay_decision_native_adoptions a
  where a.application_id=app.id and a.member_key=prep.member_key and a.preparation_id=prep.id;
 select l.* into strict local_row from private.weekly_source_local_protected_decision_receipts l where l.publication_request_id=adoption.local_publication_request_id;
 select r.* into strict request from public.weekly_exceptional_c1_publication_requests r where r.id=local_row.publication_request_id;
 select r.* into strict run from public.weekly_exceptional_orchestration_runs r where r.id=prep.orchestration_run_id;
 select g.* into strict generation from public.weekly_exceptional_pay_generations g where g.id=local_row.generation_id and g.family_id=prep.family_id;
 select s.* into strict step from public.weekly_exceptional_orchestration_steps s
  where s.orchestration_run_id=run.id and s.step_kind='COMPLETE_LOCAL_PROTECTED_DECISION';
 control:=adoption.native_result_json->'native_receipt';
 if prep.state<>'CONSUMED' or prep.route<>'SOURCE_LOCAL' or adoption.origin<>'APPLIED_IN_THIS_TRANSACTION'
  or adoption.route<>'SOURCE_LOCAL' or adoption.native_result_json is distinct from prep.native_receipt_json
  or adoption.native_result_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_COMPOSED_RESULT_V1',adoption.native_result_json)
  or app.decision_id is distinct from prep.decision_id or app.review_id is distinct from prep.review_id or app.actor_user_id is distinct from prep.actor_user_id
  or app.state<>'COMMITTED' and (app.state not in('PREVALIDATED','STAGED') or app.backend_pid<>pg_backend_pid() or app.transaction_id<>pg_current_xact_id())
  or local_row.family_id is distinct from prep.family_id or local_row.actor_user_id is distinct from prep.actor_user_id
  or request.family_id is distinct from prep.family_id or request.orchestration_run_id is distinct from run.id
  or request.generation_id is distinct from local_row.generation_id or request.request_sha256 is distinct from local_row.request_sha256
  or request.state<>'RETIRED' or request.typed_result_json is distinct from local_row.result_json
  or run.state<>'COMPLETE' or run.family_id is distinct from prep.family_id or run.requested_by_user_id is distinct from prep.actor_user_id
  or run.request_kind<>'WITHDRAW' or run.request_fingerprint is distinct from prep.native_prepare_request_sha256
  or step.idempotency_key is distinct from local_row.idempotency_key or step.idempotency_key is distinct from prep.child_idempotency_key||':local-complete'
  or step.allowlisted_owner_name<>'CloudTMS.weekly_exceptional_pay_complete_local_v1' or step.allowlisted_owner_signature<>'jsonb'
  or step.bounded_request_hash is distinct from local_row.request_sha256 or step.before_state_fingerprint is distinct from run.before_state_fingerprint
  or step.completed_at_utc is null or not isfinite(step.completed_at_utc)
  or step.owner_response_hash is distinct from private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_LOCAL_RESULT_V1',step.bounded_owner_response_json)
  or step.owner_response_hash is distinct from private.weekly_exceptional_hex_sha256_v1(control->>'native_result_sha256')
  or step.after_state_fingerprint is distinct from step.owner_response_hash then
  raise exception 'SOURCE_NATIVE_LOCAL_RECEIPT_PROOF_INVALID' using errcode='23514';end if;
 if local_row.result_json is not distinct from step.bounded_owner_response_json then
  if local_row.state is distinct from control->>'local_state'
   or run.after_state_fingerprint is distinct from step.owner_response_hash
   or private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_LOCAL_RECEIPT_ROW_V1',to_jsonb(local_row))
    is distinct from private.weekly_exceptional_hex_sha256_v1(control->>'local_receipt_sha256') then
   raise exception 'SOURCE_NATIVE_LOCAL_RECEIPT_PROOF_INVALID' using errcode='23514';end if;
  return null;
 end if;
 select p.* into strict pending from public.weekly_source_pending_entitlement_bundles p where p.id=adoption.pending_bundle_id;
 select r.* into strict receipt from private.weekly_source_entitlement_publication_receipts r where r.id=pending.released_receipt_id;
 original_row:=to_jsonb(local_row)||jsonb_build_object('state','PENDING_FREEZE','result_json',step.bounded_owner_response_json);
 current_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_LOCAL_RESULT_V1',local_row.result_json);
 if app.state<>'COMMITTED' or adoption.local_entitlement_kind<>'PENDING_BUNDLE' or control->>'local_state'<>'PENDING_FREEZE'
  or step.outcome<>'PENDING' or step.bounded_owner_response_json->>'outcome'<>'SAVED_PENDING_FREEZE'
  or step.bounded_owner_response_json->>'state'<>'PENDING' or step.bounded_owner_response_json->'idempotent_replay' is distinct from 'false'::jsonb
  or step.bounded_owner_response_json#>>'{publication,pending_bundle_verified}' is distinct from pending.id::text
  or pending.state<>'RELEASED' or pending.decision_bundle_id is distinct from adoption.pending_decision_bundle_id
  or pending.bundle_revision is distinct from adoption.pending_bundle_revision
  or pending.decision_bundle_id is distinct from local_row.common_decision_bundle_id or pending.bundle_revision is distinct from local_row.common_bundle_revision
  or pending.candidate_id is distinct from request.candidate_id or pending.decided_by_user_id is distinct from local_row.actor_user_id
  or pending.request_digest is distinct from private.weekly_source_publication_request_digest_v1(
    private.weekly_source_publication_request_canonical_v1(pending.request_json,'DEFERRED',pending.id))
  or receipt.pending_bundle_id is distinct from pending.id or receipt.publication_mode<>'DEFERRED'
  or receipt.decision_bundle_id is distinct from pending.decision_bundle_id or receipt.bundle_revision is distinct from pending.bundle_revision
  or receipt.request_digest is distinct from pending.released_receipt_digest or receipt.request_digest is distinct from pending.request_digest
  or receipt.member_root_ids is distinct from pending.member_root_ids or receipt.member_family_booking_ids is distinct from pending.member_family_booking_ids
  or receipt.member_root_versions is distinct from pending.member_root_versions or receipt.head_ids is distinct from pending.proposed_head_ids
  or cardinality(receipt.member_root_ids)<>1 or receipt.member_root_ids[1] is distinct from local_row.root_timesheet_id
  or receipt.candidate_id is distinct from request.candidate_id or receipt.decided_by_user_id is distinct from local_row.actor_user_id
  or local_row.state<>'COMPLETE' or local_row.result_json->>'deferred_release_receipt_id' is distinct from receipt.id::text
  or local_row.result_json is distinct from (step.bounded_owner_response_json||jsonb_build_object('outcome','PUBLISHED','state','LIVE',
    'deferred_release_receipt_id',receipt.id,'publication',jsonb_build_object('ok',true,'published',true,'replayed',false,
      'receipt',private.weekly_source_publication_receipt_json_v1(receipt.id)),
    'family_bound_version',local_row.result_json->'family_bound_version'))
  or coalesce(local_row.result_json->>'family_bound_version','')!~'^[1-9][0-9]{0,18}$'
  or (local_row.result_json->>'family_bound_version')::numeric<= (step.bounded_owner_response_json->>'family_bound_version')::numeric
  or run.after_state_fingerprint is distinct from current_hash or generation.result_hash is distinct from current_hash
  or generation.lifecycle_state not in('PUBLISHED','SUPERSEDED') or generation.published_at_utc is null
  or private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_LOCAL_RECEIPT_ROW_V1',original_row)
    is distinct from private.weekly_exceptional_hex_sha256_v1(control->>'local_receipt_sha256')
  or not exists(select 1 from public.weekly_source_entitlement_heads h where h.id=receipt.head_ids[1]
   and h.root_timesheet_id=local_row.root_timesheet_id and h.root_timesheet_version=receipt.member_root_versions[1]
   and h.root_family_booking_id=receipt.member_family_booking_ids[1] and h.contract_id=request.contract_id
   and h.candidate_id=request.candidate_id and h.week_ending_date=request.week_ending_date and h.authority_kind='PROTECTED'
   and h.state in('COMMITTED_CURRENT','SUPERSEDED') and h.decision_bundle_id=receipt.decision_bundle_id and h.bundle_revision=receipt.bundle_revision
   and h.source_origin_json=local_row.approved_snapshot_json->'local_publication_origin') then
  raise exception 'SOURCE_NATIVE_LOCAL_RECEIPT_PROOF_INVALID' using errcode='23514';end if;
 perform private.weekly_source_pay_decision_publication_adoptions_assert_v1(app.id);
 return jsonb_build_object('version','SOURCE_NATIVE_DEFERRED_RELEASE_PROOF_V1','application_id',app.id,'member_key',prep.member_key,
  'local_publication_request_id',request.id,'orchestration_run_id',run.id,'generation_id',generation.id,'pending_bundle_id',pending.id,
  'decision_bundle_id',pending.decision_bundle_id,'bundle_revision',pending.bundle_revision::text,'original_pending_step_id',step.id,
  'released_receipt_id',receipt.id,'released_receipt_digest',encode(receipt.request_digest,'hex'),'head_ids',to_jsonb(receipt.head_ids),
  'current_local_receipt_sha256',encode(private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_LOCAL_RECEIPT_ROW_V1',to_jsonb(local_row)),'hex'),
  'current_native_result_sha256',encode(current_hash,'hex'));
exception when no_data_found or too_many_rows or invalid_text_representation or numeric_value_out_of_range then
 raise exception 'SOURCE_NATIVE_LOCAL_RECEIPT_PROOF_INVALID' using errcode='23514';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_local_release_proof_v1(uuid) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/24_genuine_local_deferred_release_proof.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/25_actual_local_release_and_saved_status.sqlinc
create or replace function private.weekly_source_local_protected_pending_released_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_local private.weekly_source_local_protected_decision_receipts%rowtype;
  v_generation public.weekly_exceptional_pay_generations%rowtype;
  v_family public.weekly_exceptional_pay_target_families%rowtype;
  v_work_event_id uuid;
  v_target_state text;
  v_source_hash bytea;
  v_result jsonb;
  v_hash bytea;
begin
  if new.state<>'RELEASED' or old.state='RELEASED' then return new; end if;
  select * into v_local from private.weekly_source_local_protected_decision_receipts local_receipt
    where local_receipt.state='PENDING_FREEZE'
      and local_receipt.result_json->>'decision_bundle_id'=new.decision_bundle_id::text for update;
  if not found then return new; end if;
  if not exists(select 1 from private.weekly_source_entitlement_publication_receipts receipt
    where receipt.id=new.released_receipt_id and receipt.decision_bundle_id=new.decision_bundle_id
      and receipt.bundle_revision=new.bundle_revision
      and receipt.request_digest=new.released_receipt_digest
      and v_local.root_timesheet_id=any(receipt.member_root_ids)) then
    raise exception 'WEEKLY_PROTECTED_LOCAL_DEFERRED_RECEIPT_INVALID' using errcode='55000';
  end if;
  select * into strict v_family from public.weekly_exceptional_pay_target_families
    where id=v_local.family_id for update;
  select * into strict v_generation from public.weekly_exceptional_pay_generations
    where id=v_local.generation_id and family_id=v_family.id for update;
  if v_family.current_generation_id is distinct from v_generation.prior_generation_id
     or v_generation.lifecycle_state<>'PENDING_C1' then
    raise exception 'WEEKLY_PROTECTED_LOCAL_DEFERRED_GENERATION_CHANGED' using errcode='55000';
  end if;
  select target.resulting_lifecycle_state,event.source_proposal_hash,event.durable_work_event_id
    into strict v_target_state,v_source_hash,v_work_event_id
    from public.weekly_exceptional_pay_target_events target
    join public.weekly_exceptional_pay_family_events event on event.evidence_approval_id=target.approval_id
    where target.financial_generation_id=v_generation.id and target.family_id=v_family.id;
  v_result:=v_local.result_json||jsonb_build_object('outcome','PUBLISHED','state','LIVE',
    'deferred_release_receipt_id',new.released_receipt_id,
    'publication',jsonb_build_object('ok',true,'published',true,'replayed',false,
      'receipt',private.weekly_source_publication_receipt_json_v1(new.released_receipt_id)),
    'family_bound_version',v_family.bound_version+1);
  v_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_LOCAL_RESULT_V1',v_result);
  if v_family.current_generation_id is not null then
    update public.weekly_exceptional_pay_generations set lifecycle_state='SUPERSEDED',
      superseded_by_generation_id=v_generation.id,superseded_at_utc=statement_timestamp()
      where id=v_family.current_generation_id and lifecycle_state='PUBLISHED';
    if not found then raise exception 'WEEKLY_PROTECTED_LOCAL_PRIOR_GENERATION_INVALID' using errcode='55000'; end if;
  end if;
  update public.weekly_exceptional_pay_generations set lifecycle_state='PUBLISHED',
    published_at_utc=statement_timestamp(),result_hash=v_hash where id=v_generation.id;
  update public.weekly_exceptional_pay_target_families set current_generation_id=v_generation.id,
    current_generation_number=v_generation.generation_number,
    current_complete_target_vector_hash=v_generation.complete_next_vector_hash,
    current_source_proposal_hash=v_source_hash,current_lifecycle_state=v_target_state,
    current_component_count=(v_generation.complete_next_vector_json->>'component_count')::integer,
    c1_publication_state='NONE',bound_version=bound_version+1 where id=v_family.id;
  update private.weekly_source_local_protected_decision_receipts set state='COMPLETE',result_json=v_result
    where publication_request_id=v_local.publication_request_id;
  -- The accepted run remains the SAME completed Office request. Keep its
  -- result fingerprint correlated with the newly released result, without
  -- changing its actor/request/identity or first completion time. The original
  -- pending result remains in its existing completion step as audit evidence.
  -- Never backfill a missing/conflicting run or fabricate a successful release.
  update public.weekly_exceptional_orchestration_runs run
    set after_state_fingerprint=v_hash
    from public.weekly_exceptional_c1_publication_requests request
    where request.id=v_local.publication_request_id and request.state='RETIRED'
      and request.family_id=v_local.family_id and request.generation_id=v_generation.id
      and request.request_sha256=v_local.request_sha256
      and request.typed_result_json=v_local.result_json
      and run.id=request.orchestration_run_id and run.family_id=v_local.family_id
      and run.requested_by_user_id=v_local.actor_user_id and run.state='COMPLETE'
      and run.completed_at_utc is not null
      and run.after_state_fingerprint=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_PROTECTED_LOCAL_RESULT_V1',v_local.result_json)
      and exists(select 1 from public.weekly_exceptional_orchestration_steps step
        where step.orchestration_run_id=run.id
          and step.step_kind='COMPLETE_LOCAL_PROTECTED_DECISION' and step.outcome='PENDING'
          and step.idempotency_key=v_local.idempotency_key
          and step.bounded_owner_response_json=v_local.result_json
          and step.owner_response_hash=run.after_state_fingerprint
          and step.after_state_fingerprint=run.after_state_fingerprint);
  if not found then
    raise exception 'WEEKLY_PROTECTED_LOCAL_DEFERRED_RUN_INVALID' using errcode='55000';
  end if;
  update public.weekly_exceptional_c1_publication_requests set typed_result_json=v_result
    where id=v_local.publication_request_id and state='RETIRED';
  perform private.weekly_source_protected_contact_retire_v1(v_family.id,v_work_event_id);
  -- Same native callback, original immutable Source application/adoption.
  -- Derive the exact original-step/current-row proof after the real native
  -- release checks and atomic result/run/request updates have all completed.
  perform private.weekly_source_pay_decision_local_release_proof_v1(p.id)
    from private.weekly_source_pay_decision_unprotect_preparations p
    join public.weekly_exceptional_c1_publication_requests r on r.orchestration_run_id=p.orchestration_run_id
    where r.id=v_local.publication_request_id;
  return new;
end;
$function$;
create or replace function private.weekly_source_local_saved_status_native_v1(
  p_family_id uuid,p_orchestration_run_id uuid,p_actor_user_id uuid
) returns jsonb
language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_scope jsonb;
  v_approval public.weekly_exceptional_payment_approvals%rowtype;
  v_generation public.weekly_exceptional_pay_generations%rowtype;
  v_local private.weekly_source_local_protected_decision_receipts%rowtype;
  v_request public.weekly_exceptional_c1_publication_requests%rowtype;
  v_run public.weekly_exceptional_orchestration_runs%rowtype;
  v_event public.weekly_exceptional_pay_family_events%rowtype;
  v_original_event public.weekly_exceptional_pay_family_events%rowtype;
  v_publication private.weekly_source_entitlement_publication_receipts%rowtype;
  v_pending public.weekly_source_pending_entitlement_bundles%rowtype;
  v_head public.weekly_source_entitlement_heads%rowtype;
  v_canonical jsonb;
  v_choice jsonb;
  v_entitlement jsonb;
  v_components jsonb;
  v_origin jsonb;
  v_basis jsonb;
  v_snapshot jsonb;
  v_publication_root public.timesheets%rowtype;
  v_publication_version integer;
  v_prior_inventory jsonb;
  v_before_origin jsonb;
  v_qualification jsonb;
  v_result_hash bytea;
  v_member integer;
  v_count integer;
  v_cycle public.weekly_source_cycles%rowtype;
  v_step public.weekly_exceptional_orchestration_steps%rowtype;
  p_approval_id uuid;
  p_generation_id uuid;v_placement jsonb;
begin
  if p_family_id is null or p_orchestration_run_id is null or p_actor_user_id is null then
    raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_IDENTITY_REQUIRED' using errcode='22023';
  end if;
  -- NULL means no Local evidence at all, never a malformed or partial receipt.
  -- Do not inspect current WAIT, financial authorisation or generation pointers.
  select count(*) into v_count from public.weekly_exceptional_c1_publication_requests r
    where r.family_id=p_family_id and r.orchestration_run_id=p_orchestration_run_id;
  if v_count=0 then
    if exists(select 1 from private.weekly_source_local_protected_decision_receipts l
      join public.weekly_exceptional_c1_publication_requests r on r.id=l.publication_request_id
      where r.orchestration_run_id=p_orchestration_run_id)
    then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    return null;
  end if;
  if v_count<>1 then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  select r.* into strict v_request from public.weekly_exceptional_c1_publication_requests r
    where r.family_id=p_family_id and r.orchestration_run_id=p_orchestration_run_id;
  select l.* into v_local from private.weekly_source_local_protected_decision_receipts l
    where l.publication_request_id=v_request.id;
  if not found then
    if v_request.state='RETIRED'
       or v_request.typed_result_json->>'authority' in ('UNAUTHORISED_TSFIN','COMMON_ENTITLEMENT_HEAD')
    then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    return null;
  end if;
  if v_local.family_id is distinct from p_family_id
     or v_local.actor_user_id is distinct from p_actor_user_id
     or v_local.generation_id is distinct from v_request.generation_id
     or v_request.orchestration_run_id is distinct from p_orchestration_run_id then
    raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
  end if;
  v_placement:=private.weekly_source_protected_saved_placement_v1(v_local.generation_id,v_local.root_timesheet_id,v_request.contract_id);
  select count(*) into v_count from public.weekly_exceptional_payment_approvals a
    where a.creation_orchestration_run_id=p_orchestration_run_id and a.pay_target_family_id=p_family_id;
  if v_count<>1 then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  select a.id into strict p_approval_id from public.weekly_exceptional_payment_approvals a
    where a.creation_orchestration_run_id=p_orchestration_run_id and a.pay_target_family_id=p_family_id;
  p_generation_id:=v_local.generation_id;
  select jsonb_build_object('root_timesheet_id',t.timesheet_id,'root_version',
      v_local.approved_snapshot_json->'timesheet_version','family_booking_id',t.booking_id,
      'target_family_id',p_family_id,'candidate_id',a.candidate_id,'client_id',a.client_id,
      'contract_id',coalesce((v_placement->>'current_contract_id')::uuid,a.contract_id),'week_ending_date',to_char(a.week_ending,'YYYY-MM-DD'),
      'family_bound_version',v_local.result_json->'family_bound_version')
    into strict v_scope
    from public.timesheets t
    join public.weekly_exceptional_payment_approvals a on a.id=p_approval_id
    join public.contracts c on c.id=t.contract_id
    join public.weekly_exceptional_pay_target_families family on family.id=p_family_id
    where t.timesheet_id=v_local.root_timesheet_id
      and c.candidate_id=a.candidate_id and c.client_id=a.client_id
      and family.candidate_id=a.candidate_id and family.contract_id=a.contract_id
      and family.week_ending_date=a.week_ending
      and t.contract_id=v_request.contract_id and t.week_ending_date=v_request.week_ending_date;
  select a.* into v_approval from public.weekly_exceptional_payment_approvals a
    where a.id=p_approval_id;
  if not found or v_approval.pay_target_family_id::text is distinct from v_scope->>'target_family_id'
     or v_approval.candidate_id::text is distinct from v_scope->>'candidate_id'
     or v_approval.client_id::text is distinct from v_scope->>'client_id'
     or (v_placement is null and v_approval.contract_id::text is distinct from v_scope->>'contract_id')
     or to_char(v_approval.week_ending,'YYYY-MM-DD') is distinct from v_scope->>'week_ending_date'
     or v_approval.protected_work_date not between
        (v_scope->>'week_ending_date')::date-6 and (v_scope->>'week_ending_date')::date then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  if not exists(select 1 from public.weekly_work_events w
    where w.id=v_approval.work_event_id and w.candidate_id=v_approval.candidate_id
      and w.client_id=v_approval.client_id and w.work_date=v_approval.protected_work_date) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  -- Original report cutoff is the Office permission boundary, not today's
  -- work week or the report most recently imported for another shift.
  select c.* into strict v_cycle from public.weekly_source_cycles c
    where c.id=v_approval.source_cycle_id;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'APPROVE_PROTECTED_PAY',
    v_cycle.source_group_id,v_approval.client_id,v_cycle.finalisation_week_ending);
  select g.* into v_generation from public.weekly_exceptional_pay_generations g
    where g.id=p_generation_id and g.family_id=v_approval.pay_target_family_id;
  if not found or private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',
       v_generation.complete_next_vector_json) is distinct from v_generation.complete_next_vector_hash
     or not exists(select 1 from public.weekly_exceptional_pay_target_events t
       where t.family_id=v_approval.pay_target_family_id and t.approval_id=v_approval.id
         and t.financial_generation_id=v_generation.id
         and t.complete_next_family_vector_fingerprint=v_generation.complete_next_vector_hash) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  select l.* into v_local from private.weekly_source_local_protected_decision_receipts l
    where l.generation_id=v_generation.id;
  if not found or v_local.family_id is distinct from v_approval.pay_target_family_id
     or v_local.actor_user_id is distinct from v_approval.approved_by_user_id
     or v_local.state not in ('COMPLETE','PENDING_FREEZE')
     or v_local.completed_at_utc is null or not isfinite(v_local.completed_at_utc) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  -- Accepted evidence belongs to its original physical root/version. A lawful
  -- later rotation must not invalidate the same raw booking family's receipt.
  -- Point-read that pinned root; never choose an arbitrary historical winner.
  select t.* into v_publication_root from public.timesheets t
    where t.timesheet_id=v_local.root_timesheet_id;
  if not found or v_publication_root.booking_id is distinct from v_scope->>'family_booking_id'
     or v_publication_root.contract_id is distinct from coalesce((v_placement->>'current_contract_id')::uuid,v_approval.contract_id)
     or v_publication_root.week_ending_date is distinct from v_approval.week_ending
     or v_publication_root.sheet_scope is distinct from 'WEEKLY'
     or v_publication_root.line_type is distinct from 'HOURS'
     or v_publication_root.is_adjustment is distinct from false
     or v_local.approved_snapshot_json->>'timesheet_id' is distinct from v_local.root_timesheet_id::text
     or jsonb_typeof(v_local.approved_snapshot_json->'timesheet_version') is distinct from 'number'
     or coalesce(v_local.approved_snapshot_json->>'timesheet_version','') !~ '^[1-9][0-9]*$'
     or (v_local.approved_snapshot_json->>'timesheet_version')::numeric>2147483647 then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  v_publication_version:=(v_local.approved_snapshot_json->>'timesheet_version')::integer;
  select r.* into v_request from public.weekly_exceptional_c1_publication_requests r
    where r.id=v_local.publication_request_id;
  if not found or v_request.state is distinct from 'RETIRED'
     or v_request.completed_at_utc is null or not isfinite(v_request.completed_at_utc)
     or v_request.family_id is distinct from v_local.family_id
     or v_request.generation_id is distinct from v_generation.id
     or v_request.orchestration_run_id is distinct from v_approval.creation_orchestration_run_id
     or v_request.root_timesheet_id is distinct from v_local.root_timesheet_id
     or v_request.candidate_id is distinct from v_approval.candidate_id
     or v_request.contract_id is distinct from coalesce((v_placement->>'current_contract_id')::uuid,v_approval.contract_id)
     or v_request.week_ending_date is distinct from v_approval.week_ending
     or v_request.request_sha256 is distinct from v_local.request_sha256
     or v_request.typed_result_json is distinct from v_local.result_json
     or v_request.c1_operation_id is not null or v_request.c1_publication_id is not null
     or v_request.c1_head_revision is not null or v_request.c1_receipt_sha256 is not null then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  select r.* into v_run from public.weekly_exceptional_orchestration_runs r
    where r.id=v_approval.creation_orchestration_run_id;
  v_result_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_LOCAL_RESULT_V1',v_local.result_json);
  if not found or v_run.family_id is distinct from v_local.family_id
     or v_run.requested_by_user_id is distinct from v_local.actor_user_id
     or v_run.state is distinct from 'COMPLETE' or v_run.completed_at_utc is null
     or not isfinite(v_run.completed_at_utc)
     or v_run.after_state_fingerprint is distinct from v_result_hash
     or v_local.result_json->'ok' is distinct from 'true'::jsonb
     or v_local.result_json->'idempotent_replay' is distinct from 'false'::jsonb
     or v_local.result_json->>'family_id' is distinct from v_local.family_id::text
     or v_local.result_json->>'generation_id' is distinct from v_generation.id::text
     or v_local.result_json->>'publication_request_id' is distinct from v_request.id::text
     or coalesce(v_local.result_json->>'family_bound_version','') !~ '^[1-9][0-9]*$'
     or (v_local.result_json->>'family_bound_version')::numeric>
          (v_scope->>'family_bound_version')::numeric then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  v_snapshot:=v_generation.complete_next_vector_json#>'{target_snapshot,tsfin_snapshot_json}';
  if jsonb_typeof(v_snapshot) is distinct from 'object'
     or v_snapshot is distinct from v_approval.approved_target_pay_components_json->'tsfin_snapshot_json' then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  if v_local.state='COMPLETE' then
    -- A different sibling may have superseded this accepted generation. Its
    -- immutable published proof is still needed for this unchanged WAIT event.
    if v_generation.lifecycle_state not in ('PUBLISHED','SUPERSEDED')
       or v_generation.published_at_utc is null or not isfinite(v_generation.published_at_utc)
       or v_generation.result_hash is distinct from v_result_hash
       or v_local.result_json->>'outcome' is distinct from 'PUBLISHED'
       or v_local.result_json->>'state' is distinct from 'LIVE' then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  elsif v_generation.lifecycle_state not in ('PENDING_C1','SUPERSEDED')
     or v_generation.published_at_utc is not null or v_generation.result_hash is not null
     or v_local.result_json->>'outcome' is distinct from 'SAVED_PENDING_FREEZE'
     or v_local.result_json->>'state' is distinct from 'PENDING' then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
  end if;
  if v_local.result_json->>'authority'='UNAUTHORISED_TSFIN' then
    if v_local.state<>'COMPLETE'
       or v_local.result_json->'requires_first_authorisation' is distinct from 'true'::jsonb then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    v_basis:=v_local.approved_snapshot_json->'saved_unauthorised_basis';
    if private.weekly_exceptional_json_keys_exact_v1(v_basis,array['schema_version',
       'financial_snapshot_id','financial_snapshot_sha256','detail_sha256','inventory_sha256',
       'root_version','family_booking_id']) is distinct from true
       or not (v_basis ?& array['schema_version','financial_snapshot_id','financial_snapshot_sha256',
          'detail_sha256','inventory_sha256','root_version','family_booking_id'])
       or v_basis->>'schema_version' is distinct from 'SAVED_UNAUTHORISED_LOCAL_V1'
       or v_basis->>'family_booking_id' is distinct from v_scope->>'family_booking_id'
       or v_basis->>'root_version' is distinct from v_publication_version::text
       or v_basis->>'financial_snapshot_id' is distinct from v_local.result_json->>'timesheet_financials_id'
       or coalesce(v_basis->>'financial_snapshot_sha256','') !~ '^[0-9a-f]{64}$'
       or coalesce(v_basis->>'detail_sha256','') !~ '^[0-9a-f]{64}$'
       or v_basis->>'inventory_sha256' is distinct from encode(v_generation.complete_next_vector_hash,'hex')
       or (v_local.approved_snapshot_json-'saved_unauthorised_basis') is distinct from
          (v_snapshot||jsonb_build_object('timesheet_id',v_local.root_timesheet_id::text,
           'timesheet_version',v_publication_version,'actual_schedule_json',
           v_generation.complete_next_vector_json#>'{target_snapshot,actual_schedule_json}'))
       or not exists(select 1 from public.timesheets_financials f
         where f.id::text=v_basis->>'financial_snapshot_id'
           and f.timesheet_id=v_local.root_timesheet_id
           and f.timesheet_version=v_publication_version
           and f.candidate_id=v_approval.candidate_id and f.client_id=v_approval.client_id) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    -- This is accepted decision evidence, not current financial eligibility.
    -- First Authorise can legitimately change current TSFIN. Do not compare
    -- today's mutable finance row to the original sealed pre-authorise hash.
  elsif v_local.result_json->>'authority'='COMMON_ENTITLEMENT_HEAD' then
    if v_local.result_json->'requires_first_authorisation' is distinct from 'false'::jsonb
       or v_local.approved_snapshot_json->>'common_decision_bundle_id'
          is distinct from v_local.result_json->>'decision_bundle_id'
       or v_local.common_decision_bundle_id::text is distinct from v_local.result_json->>'decision_bundle_id'
       or v_local.common_bundle_revision is null
       or v_local.publication_origin_kind is distinct from 'PROTECTED_LOCAL_DECISION_V1'
       or v_local.publication_origin_digest is null
       or v_local.source_qualification_digest is null then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    if v_local.state='PENDING_FREEZE' then
      select p.* into v_pending from public.weekly_source_pending_entitlement_bundles p
        where p.id::text=v_local.result_json#>>'{publication,pending_bundle_verified}';
      if not found or v_pending.state not in ('PENDING','RELEASING','MANUAL_REVIEW','SUPERSEDED')
         or v_pending.decision_bundle_id::text is distinct from v_local.result_json->>'decision_bundle_id'
         or v_pending.bundle_revision is distinct from v_local.common_bundle_revision
         or v_pending.decided_by_user_id is distinct from v_local.actor_user_id
         or v_pending.candidate_id is distinct from v_approval.candidate_id
         or v_local.result_json#>'{publication,ok}' is distinct from 'true'::jsonb
         or v_local.result_json#>'{publication,published}' is distinct from 'false'::jsonb
         or v_local.result_json#>>'{publication,code}' is distinct from 'WEEKLY_SOURCE_PUBLICATION_DEFERRED_PENDING_FREEZE'
         or v_pending.request_digest is distinct from private.weekly_source_publication_request_digest_v1(
             private.weekly_source_publication_request_canonical_v1(v_pending.request_json,'DEFERRED',v_pending.id)) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      v_member:=array_position(v_pending.member_root_ids,v_local.root_timesheet_id);
      if v_member is null or v_pending.member_family_booking_ids[v_member] is distinct from v_scope->>'family_booking_id'
         or v_pending.member_root_versions[v_member] is distinct from v_publication_version then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      v_canonical:=private.weekly_source_publication_request_canonical_v1(v_pending.request_json,'DEFERRED',v_pending.id);
      -- A self-consistent request digest does not prove that its identities
      -- agree with the separately stored pending row. Bind the complete member
      -- mapping before using the pending row's ordinal to select an entitlement.
      if v_canonical->>'decision_bundle_id' is distinct from v_pending.decision_bundle_id::text
         or (v_canonical->>'bundle_revision')::bigint is distinct from v_pending.bundle_revision
         or v_canonical->>'candidate_id' is distinct from v_pending.candidate_id::text
         or v_canonical->'member_root_ids' is distinct from to_jsonb(v_pending.member_root_ids)
         or v_canonical->'member_family_booking_ids' is distinct from to_jsonb(v_pending.member_family_booking_ids)
         or v_canonical->'member_root_versions' is distinct from to_jsonb(v_pending.member_root_versions)
         or v_canonical->'head_ids' is distinct from to_jsonb(v_pending.proposed_head_ids)
         or v_canonical->>'decision_id' is distinct from v_pending.decision_id::text
         or v_canonical->'member_root_ids'->>(v_member-1) is distinct from v_local.root_timesheet_id::text
         or v_canonical->'member_family_booking_ids'->>(v_member-1) is distinct from v_scope->>'family_booking_id'
         or (v_canonical->'member_root_versions'->>(v_member-1))::integer
            is distinct from v_publication_version then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      select c.value into strict v_choice from jsonb_array_elements(
        v_canonical#>'{financial_request,contract_choices}') c(value)
        where (c.value->>'root_ordinal')::integer=v_member;
      if v_choice->>'contract_id' is distinct from v_scope->>'contract_id'
         or v_choice->>'week_ending_date' is distinct from v_scope->>'week_ending_date' then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      select e.value into strict v_entitlement from jsonb_array_elements(
        v_canonical#>'{financial_request,member_entitlements}') e(value)
        where (e.value->>'root_ordinal')::integer=v_member;
      if v_entitlement->>'authority_kind' is distinct from 'PROTECTED'
         or (v_entitlement->>'component_count')::integer is distinct from jsonb_array_length(v_entitlement->'components') then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      v_components:=v_entitlement->'components';
      v_origin:=v_canonical#>'{financial_request,source_revision}';
    else
      select r.* into v_publication from private.weekly_source_entitlement_publication_receipts r
        where r.id::text=v_local.result_json#>>'{publication,receipt,id}';
      if not found or v_publication.decision_bundle_id::text is distinct from v_local.result_json->>'decision_bundle_id'
         or v_publication.bundle_revision is distinct from v_local.common_bundle_revision
         or v_publication.candidate_id is distinct from v_approval.candidate_id
         or v_publication.decided_by_user_id is distinct from v_local.actor_user_id
         or v_local.result_json#>'{publication,ok}' is distinct from 'true'::jsonb
         or v_local.result_json#>'{publication,published}' is distinct from 'true'::jsonb
         or v_local.result_json#>'{publication,receipt}' is distinct from
            private.weekly_source_publication_receipt_json_v1(v_publication.id) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      v_member:=array_position(v_publication.member_root_ids,v_local.root_timesheet_id);
      if v_member is null or v_publication.member_family_booking_ids[v_member] is distinct from v_scope->>'family_booking_id'
         or v_publication.member_root_versions[v_member] is distinct from v_publication_version
         or not exists(select 1 from public.weekly_source_entitlement_heads h
           where h.id=v_publication.head_ids[v_member] and h.root_timesheet_id=v_local.root_timesheet_id
             and h.root_family_booking_id=v_scope->>'family_booking_id'
             and h.root_timesheet_version=v_publication_version
             and h.decision_bundle_id=v_publication.decision_bundle_id
             and h.bundle_revision=v_publication.bundle_revision
             and h.state in ('COMMITTED_CURRENT','SUPERSEDED')) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      select h.* into strict v_head from public.weekly_source_entitlement_heads h
        where h.id=v_publication.head_ids[v_member];
      if v_head.authority_kind is distinct from 'PROTECTED'
         or v_head.candidate_id is distinct from v_approval.candidate_id
         or v_head.contract_id is distinct from coalesce((v_placement->>'current_contract_id')::uuid,v_approval.contract_id)
         or v_head.week_ending_date is distinct from v_approval.week_ending then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      select coalesce(jsonb_agg(private.weekly_source_publication_component_canonical_v1(
        (to_jsonb(c)-array['id','head_id','decision_bundle_id','bundle_revision','component_sha256','created_at_utc'])
          ||jsonb_build_object('work_date',to_char(c.work_date,'YYYY-MM-DD'),
            'hours_day',c.hours_day::text,'hours_night',c.hours_night::text,
            'hours_sat',c.hours_sat::text,'hours_sun',c.hours_sun::text,
            'hours_bh',c.hours_bh::text,'unit_count',c.unit_count::text,
            'unit_pay_rate',c.unit_pay_rate::text,'unit_charge_rate',c.unit_charge_rate::text,
            'pay_ex_vat',c.pay_ex_vat::text,'charge_ex_vat',c.charge_ex_vat::text),
        'query.local.accepted_component') order by c.component_ordinal),'[]'::jsonb)
        into v_components from public.weekly_source_entitlement_head_components c where c.head_id=v_head.id;
      if jsonb_array_length(v_components) is distinct from v_head.component_count
         or exists(select 1 from public.weekly_source_entitlement_head_components c
           where c.head_id=v_head.id and c.component_sha256 is distinct from
             private.weekly_source_publication_request_digest_v1(private.weekly_source_publication_component_content_v1(
               private.weekly_source_publication_component_canonical_v1((to_jsonb(c)-array['id','head_id',
                 'decision_bundle_id','bundle_revision','component_sha256','created_at_utc'])
                   ||jsonb_build_object('work_date',to_char(c.work_date,'YYYY-MM-DD'),
                     'hours_day',c.hours_day::text,'hours_night',c.hours_night::text,
                     'hours_sat',c.hours_sat::text,'hours_sun',c.hours_sun::text,
                     'hours_bh',c.hours_bh::text,'unit_count',c.unit_count::text,
                     'unit_pay_rate',c.unit_pay_rate::text,'unit_charge_rate',c.unit_charge_rate::text,
                     'pay_ex_vat',c.pay_ex_vat::text,'charge_ex_vat',c.charge_ex_vat::text),
                 'query.local.accepted_component')))) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      v_origin:=v_head.source_origin_json;
      if v_head.source_generation_digest is distinct from private.weekly_source_publication_request_digest_v1(v_origin) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    end if;
    -- Compatible V4 local publisher must supply this real closed origin.
    -- The old current-Final constructor is deliberately NOT an accepted
    -- substitute, even if it published a genuine same-root/actor Source HEAD.
    if private.weekly_exceptional_json_keys_exact_v1(v_origin,array['origin_kind','publication_request_id',
       'generation_id','request_sha256','source_qualification_digest','policy_fingerprint',
       'before_origin','before_inventory_digest']) is distinct from true
       or not (v_origin ?& array['origin_kind','publication_request_id','generation_id','request_sha256',
          'source_qualification_digest','policy_fingerprint','before_origin','before_inventory_digest'])
       or v_origin->>'origin_kind' is distinct from 'PROTECTED_LOCAL_DECISION_V1'
       or v_origin->>'publication_request_id' is distinct from v_request.id::text
       or v_origin->>'generation_id' is distinct from v_generation.id::text
       or v_origin->>'request_sha256' is distinct from encode(v_request.request_sha256,'hex')
       or private.weekly_source_publication_request_digest_v1(v_origin)
          is distinct from v_local.publication_origin_digest
       or v_origin->>'source_qualification_digest'
          is distinct from encode(v_local.source_qualification_digest,'hex')
       or coalesce(v_origin->>'source_qualification_digest','') !~ '^[0-9a-f]{64}$'
       or coalesce(v_origin->>'policy_fingerprint','') !~ '^[0-9a-f]{64}$'
       or coalesce(v_origin->>'before_inventory_digest','') !~ '^[0-9a-f]{64}$'
       or jsonb_typeof(v_origin->'before_origin') is distinct from 'object'
       or v_local.approved_snapshot_json->'local_publication_origin' is distinct from v_origin
       or private.weekly_source_sha256_jsonb_v1('PROTECTED_LOCAL_SOURCE_QUALIFICATION_V2',
          v_local.approved_snapshot_json->'local_source_qualification')
          is distinct from v_local.source_qualification_digest
       or coalesce(v_local.approved_snapshot_json->>'common_components_digest','') !~ '^[0-9a-f]{64}$'
       or v_local.approved_snapshot_json->>'common_components_digest' is distinct from encode(
          private.weekly_source_publication_request_digest_v1(v_components),'hex') then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    -- The retained qualification must belong to this exact accepted action.
    -- A later WAIT can reuse this approval with a different source proposal:
    -- point-read the original immutable event, never compare it to latest WAIT.
    v_qualification:=v_local.approved_snapshot_json->'local_source_qualification';
    if private.weekly_exceptional_json_keys_exact_v1(v_qualification,array[
         'schema_version','publication_request_id','generation_id','scope','source_cycle_id',
         'work_event_id','approval_id','actor_user_id','family_event_sequence','source_proposal_hash',
         'complete_vector_hash','rate_policy_fingerprint','prepared_sources']) is distinct from true
       or not (v_qualification ?& array['schema_version','publication_request_id','generation_id',
         'scope','source_cycle_id','work_event_id','approval_id','actor_user_id','family_event_sequence',
         'source_proposal_hash','complete_vector_hash','rate_policy_fingerprint','prepared_sources'])
       or v_qualification->>'schema_version' is distinct from 'PROTECTED_LOCAL_SOURCE_QUALIFICATION_V2'
       or v_qualification->>'publication_request_id' is distinct from v_request.id::text
       or v_qualification->>'generation_id' is distinct from v_generation.id::text
       or v_qualification->>'source_cycle_id' is distinct from v_approval.source_cycle_id::text
       or v_qualification->>'work_event_id' is distinct from v_approval.work_event_id::text
       or v_qualification->>'approval_id' is distinct from v_approval.id::text
       or v_qualification->>'actor_user_id' is distinct from v_local.actor_user_id::text
       or v_qualification->>'complete_vector_hash' is distinct from encode(v_generation.complete_next_vector_hash,'hex')
       or v_qualification->>'rate_policy_fingerprint' is distinct from encode(v_approval.contract_rate_policy_source_fingerprint,'hex')
       or v_origin->>'policy_fingerprint' is distinct from v_qualification->>'rate_policy_fingerprint'
       or v_qualification#>>'{scope,root_timesheet_id}' is distinct from v_local.root_timesheet_id::text
       or v_qualification#>>'{scope,root_version}' is distinct from v_publication_version::text
       or v_qualification#>>'{scope,family_booking_id}' is distinct from v_scope->>'family_booking_id'
       or v_qualification#>>'{scope,target_family_id}' is distinct from v_local.family_id::text
       or v_qualification#>>'{scope,candidate_id}' is distinct from v_approval.candidate_id::text
       or v_qualification#>>'{scope,client_id}' is distinct from v_approval.client_id::text
       or v_qualification#>>'{scope,contract_id}' is distinct from coalesce(v_placement->>'current_contract_id',v_approval.contract_id::text)
       or v_qualification#>>'{scope,week_ending_date}' is distinct from to_char(v_approval.week_ending,'YYYY-MM-DD')
       or coalesce(v_qualification->>'family_event_sequence','') !~ '^[1-9][0-9]*$'
       or (v_qualification->>'family_event_sequence')::numeric>9223372036854775807
       or coalesce(v_qualification->>'source_proposal_hash','') !~ '^[0-9a-f]{64}$'
       or jsonb_typeof(v_qualification->'prepared_sources') is distinct from 'array' then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    select e.* into v_original_event from public.weekly_exceptional_pay_family_events e
      where e.family_id=v_local.family_id
        and e.event_sequence=(v_qualification->>'family_event_sequence')::bigint;
    if not found or v_original_event.durable_work_event_id is distinct from v_approval.work_event_id
       or v_original_event.evidence_approval_id is distinct from v_approval.id
       or v_original_event.office_actor_user_id is distinct from v_local.actor_user_id
       or v_original_event.work_date is distinct from v_approval.protected_work_date
       or v_original_event.source_proposal_hash is distinct from decode(v_qualification->>'source_proposal_hash','hex')
       or v_original_event.source_proposal_hash is distinct from private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_PROTECTED_SOURCE_PROPOSAL_V1',v_original_event.source_proposal_snapshot_json) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    -- Qualify the original sealed before-position, never today's HEAD/root.
    -- The complete vector was sealed by the actual stage owner. A later
    -- sibling amendment or physical rotation cannot replace this evidence.
    v_prior_inventory:=v_generation.complete_next_vector_json->'prior_effective_inventory';
    v_before_origin:=v_prior_inventory#>'{approval_basis,origin}';
    if v_prior_inventory->'ok' is distinct from 'true'::jsonb
       or v_prior_inventory#>'{approval_basis,coverage_complete}' is distinct from 'true'::jsonb
       or coalesce(v_before_origin->>'kind','') not in ('INITIAL_AUTHORISED_TSFIN_V1','COMMITTED_SOURCE_HEAD_V1')
       or v_prior_inventory#>>'{approval_basis,scope,root_timesheet_id}' is distinct from v_local.root_timesheet_id::text
       or v_prior_inventory#>>'{approval_basis,scope,root_version}' is distinct from v_publication_version::text
       or v_prior_inventory#>>'{approval_basis,scope,family_booking_id}' is distinct from v_scope->>'family_booking_id'
       or v_prior_inventory#>>'{approval_basis,scope,target_family_id}' is distinct from v_local.family_id::text
       or v_prior_inventory#>>'{approval_basis,scope,candidate_id}' is distinct from v_scope->>'candidate_id'
       or v_prior_inventory#>>'{approval_basis,scope,client_id}' is distinct from v_scope->>'client_id'
       or v_prior_inventory#>>'{approval_basis,scope,contract_id}' is distinct from v_scope->>'contract_id'
       or v_prior_inventory#>>'{approval_basis,scope,week_ending_date}' is distinct from v_scope->>'week_ending_date'
       or v_origin->>'before_inventory_digest' is distinct from v_prior_inventory->>'inventory_digest' then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    if v_before_origin->>'kind'='COMMITTED_SOURCE_HEAD_V1' then
      v_before_origin:=v_before_origin-'source_revision';
    end if;
    if v_origin->'before_origin' is distinct from v_before_origin
       or private.weekly_source_local_origin_canonical_v2(v_origin) is distinct from v_origin then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  else raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
  end if;
  -- The original completion step is immutable. Pending release updates the
  -- Local/run/request result together, but does not rewrite that original step.
  select count(*) into v_count from public.weekly_exceptional_orchestration_steps step
    where step.orchestration_run_id=v_run.id and step.step_kind='COMPLETE_LOCAL_PROTECTED_DECISION';
  if v_count<>1 then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  select step.* into strict v_step from public.weekly_exceptional_orchestration_steps step
    where step.orchestration_run_id=v_run.id and step.step_kind='COMPLETE_LOCAL_PROTECTED_DECISION';
  if v_step.idempotency_key is distinct from v_local.idempotency_key
     or v_step.allowlisted_owner_name is distinct from 'CloudTMS.weekly_exceptional_pay_complete_local_v1'
     or v_step.allowlisted_owner_signature is distinct from 'jsonb'
     or v_step.bounded_request_hash is distinct from v_local.request_sha256
     or v_step.before_state_fingerprint is distinct from v_run.before_state_fingerprint
     or v_step.completed_at_utc is null or not isfinite(v_step.completed_at_utc)
     or v_step.owner_response_hash is distinct from private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_PROTECTED_LOCAL_RESULT_V1',v_step.bounded_owner_response_json)
     or v_step.after_state_fingerprint is distinct from v_step.owner_response_hash then
    raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
  end if;
  if v_local.result_json ? 'deferred_release_receipt_id' then
    if v_local.state<>'COMPLETE' or v_step.outcome is distinct from 'PENDING'
       or v_step.bounded_owner_response_json->>'outcome' is distinct from 'SAVED_PENDING_FREEZE'
       or v_step.bounded_owner_response_json->>'state' is distinct from 'PENDING'
       or v_local.result_json is distinct from (v_step.bounded_owner_response_json||jsonb_build_object(
         'outcome','PUBLISHED','state','LIVE',
         'deferred_release_receipt_id',v_local.result_json->'deferred_release_receipt_id',
         'publication',v_local.result_json->'publication',
         'family_bound_version',v_local.result_json->'family_bound_version'))
       or not exists(select 1 from public.weekly_source_pending_entitlement_bundles p
         where p.id::text=v_step.bounded_owner_response_json#>>'{publication,pending_bundle_verified}'
           and p.state='RELEASED' and p.decision_bundle_id=v_local.common_decision_bundle_id
           and p.bundle_revision=v_local.common_bundle_revision
           and p.released_receipt_id::text=v_local.result_json->>'deferred_release_receipt_id'
           and p.released_receipt_id=v_publication.id
           and p.released_receipt_digest=v_publication.request_digest) then
      raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
    end if;
  elsif v_step.bounded_owner_response_json is distinct from v_local.result_json
     or v_step.outcome is distinct from (case when v_local.state='PENDING_FREEZE' then 'PENDING' else 'COMPLETE' end) then
    raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
  end if;
  return jsonb_build_object('family_id',v_local.family_id,'orchestration_run_id',v_run.id,
    'publication_request_id',v_request.id,'request_sha256',encode(v_local.request_sha256,'hex'),
    'generation_id',v_generation.id,'state',v_local.state,
    'requires_first_authorisation',v_local.result_json->'requires_first_authorisation',
    'idempotent_replay',true,'result',v_local.result_json||jsonb_build_object('idempotent_replay',true));
exception when no_data_found or too_many_rows or invalid_text_representation or numeric_value_out_of_range then
  raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
end;
$function$;
revoke all on function private.weekly_source_local_protected_pending_released_v1() from public,anon,authenticated,service_role;
revoke all on function private.weekly_source_local_saved_status_native_v1(uuid,uuid,uuid) from public,anon,authenticated,service_role;
create or replace function private.weekly_source_local_saved_status_v1(p_family_id uuid,p_orchestration_run_id uuid,p_actor_user_id uuid)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,private,public as $function$
declare result jsonb;prep private.weekly_source_pay_decision_unprotect_preparations%rowtype;
begin
 -- Keep every existing genuine native origin/snapshot/component/step/release
 -- check, and its current Office actor/financial/source permission boundary.
 result:=private.weekly_source_local_saved_status_native_v1(p_family_id,p_orchestration_run_id,p_actor_user_id);
 select p.* into prep from private.weekly_source_pay_decision_unprotect_preparations p where p.orchestration_run_id=p_orchestration_run_id;
 if found and result is not null then
  if prep.family_id is distinct from p_family_id or prep.actor_user_id is distinct from p_actor_user_id or prep.route<>'SOURCE_LOCAL' then
   raise exception 'SOURCE_NATIVE_LOCAL_RECEIPT_PROOF_INVALID' using errcode='23514';end if;
  perform private.weekly_source_pay_decision_local_release_proof_v1(prep.id);
 end if;
 return result;
end;
$function$;
revoke all on function private.weekly_source_local_saved_status_v1(uuid,uuid,uuid) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/25_actual_local_release_and_saved_status.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/26_confirmed_quote_operands.sqlinc
-- Internal completion of the saved-review read seam. The genuine NEXT native
-- request has component authority, not a TSFIN calculator snapshot. The trusted
-- Worker compares the complete recalculated economics before registration;
-- SQL separately validates current native facts and the actual native bundle.
create or replace function public.weekly_source_pay_decision_unprotect_quote_context_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public as $function$
declare prep private.weekly_source_pay_decision_unprotect_preparations%rowtype;
 review private.weekly_source_pay_decision_reviews%rowtype;quote private.weekly_source_pay_decision_preview_quotes%rowtype;
 cut private.bpay_next_source_pay_decision_cut%rowtype;quantities jsonb;actor uuid;
begin
 if coalesce(current_setting('request.jwt.claim.role',true),nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['version','actor_user_id','decision_id','review_id','member_key','accept_or_resume_request_id'])
  or not(p_request ?& array['version','actor_user_id','decision_id','review_id','member_key','accept_or_resume_request_id'])
  or p_request->>'version' is distinct from 'SOURCE_UNPROTECT_QUOTE_CONTEXT_V1' then
  raise exception 'SOURCE_UNPROTECT_QUOTE_CONTEXT_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;
 if actor is null or not private.weekly_source_pay_actor_allowed_v1(actor) then
  raise exception 'SOURCE_PAY_DECISION_ACTOR_REQUIRED' using errcode='42501';end if;
 select p.* into strict prep from private.weekly_source_pay_decision_unprotect_preparations p
  join private.weekly_source_pay_decision_requests r on r.request_id=p.accept_or_resume_request_id and r.decision_id=p.decision_id
  where p.decision_id=(p_request->>'decision_id')::uuid and p.review_id=(p_request->>'review_id')::uuid
   and p.member_key=p_request->>'member_key' and p.accept_or_resume_request_id=(p_request->>'accept_or_resume_request_id')::uuid
   and p.actor_user_id=actor and r.actor_user_id=actor and r.review_id=p.review_id and r.metadata_state='CONFIRMED'
   and r.request_hash=p.confirmation_request_sha256 and p.state in('RUN_PREPARED','PREPARED') and p.expires_at_utc>transaction_timestamp();
 perform private.bpay_next_source_pay_decision_cut_v1(prep.decision_id,null,prep.review_id,true);
 select r.* into strict review from private.weekly_source_pay_decision_reviews r
  join private.weekly_source_pay_decision_preview_assemblies a on a.id=r.preview_assembly_id and a.review_id=r.id
  where r.id=prep.review_id and r.decision_id=prep.decision_id and a.state='SEALED' and a.actor_user_id=actor;
 select q.* into strict quote from private.weekly_source_pay_decision_preview_quotes q where q.assembly_id=review.preview_assembly_id and q.member_key=prep.member_key;
 select c.* into strict cut from private.bpay_next_source_pay_decision_cut c
  where c.decision_id=prep.decision_id and c.review_id=review.id and c.preview_assembly_id=review.preview_assembly_id and c.pay_cut_sha256=review.pay_cut_hash;
 select coalesce(jsonb_agg(jsonb_build_object('cut_id',m.cut_id,'cut_member_no',m.member_no::text,'member_sha256',encode(m.member_sha256,'hex'),
  'family_root_id',m.family_root_id,'source_row_id',m.original_source_row_id,'source_work_event_id',m.source_work_event_id,
  'canonical_work_id',m.canonical_work_id,'canonical_component_key',m.canonical_component_key,'scope_kind',m.scope_kind,'scope_mode',m.scope_mode,
  'work_dates',to_jsonb(m.work_dates),'supported_quantity_json',m.supported_quantity_json,'excluded_quantity_json',m.excluded_quantity_json)
  order by m.member_no),'[]'::jsonb) into quantities from private.bpay_next_source_pay_decision_cut_member m
  where m.cut_id=cut.id and m.member_key=prep.member_key;
 if jsonb_array_length(quantities) not between 1 and 1000
  or quote.quote_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_PREVIEW_QUOTE_V1',quote.quote_json)
  or quote.economic_target_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_ECONOMIC_TARGET_V1',quote.quote_json->'economic_target')
  or quote.quote_json#>'{economic_target,quantity_partition}' is distinct from quantities
  or quote.quote_json#>>'{economic_target,prior_commitment_cut_sha256}' is distinct from encode(cut.pay_cut_sha256,'hex') then
  raise exception 'SOURCE_UNPROTECT_QUOTE_CONTEXT_INVALID' using errcode='23514';end if;
 return jsonb_build_object('version','SOURCE_UNPROTECT_QUOTE_CONTEXT_RESULT_V1','preparation_id',prep.id,'decision_id',prep.decision_id,
  'review_id',prep.review_id,'member_key',prep.member_key,'accept_or_resume_request_id',prep.accept_or_resume_request_id,
  'orchestration_run_id',prep.orchestration_run_id,'context_sha256',quote.quote_json->'context_sha256',
  'source_observation_sha256',quote.quote_json->'source_observation_sha256','economic_target_sha256',encode(quote.economic_target_sha256,'hex'),
  'quantity_partition',quantities,'prior_commitment_cut_sha256',encode(cut.pay_cut_sha256,'hex'));
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'SOURCE_UNPROTECT_QUOTE_CONTEXT_INVALID' using errcode='23514';
end;
$function$;
revoke all on function public.weekly_source_pay_decision_unprotect_quote_context_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_unprotect_quote_context_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/26_confirmed_quote_operands.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/27_certified_current_native_scope.sqlinc
create or replace function private.weekly_source_target_family_for_root_v1(
  p_root_timesheet_id uuid
) returns public.weekly_exceptional_pay_target_families
language plpgsql stable security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_identity jsonb;
  v_family public.weekly_exceptional_pay_target_families%rowtype;
  v_count integer;v_placement jsonb;
begin
  v_identity:=private.weekly_source_resolve_root_identity_v1(p_root_timesheet_id);
  if coalesce((v_identity->>'ok')::boolean,false) is not true then
    raise exception 'WEEKLY_SOURCE_ROOT_INTEGRITY_FAILURE'
      using errcode='55000',detail=coalesce(v_identity,'{}'::jsonb)::text;
  end if;

  select pg_catalog.count(*)::integer into v_count
  from public.weekly_exceptional_pay_target_families family
  where pg_catalog.btrim(family.root_family_booking_id)
        =pg_catalog.btrim(v_identity->>'family_booking_id');
  if v_count>1 then
    raise exception 'WEEKLY_SOURCE_TARGET_FAMILY_AMBIGUOUS'
      using errcode='55000',
            detail=pg_catalog.jsonb_build_object(
              'family_booking_id',v_identity->>'family_booking_id',
              'family_row_count',v_count)::text;
  end if;
  if v_count=0 then
    -- Direct certified physical alias only. Keep the genuine original target
    -- family A; never create/reparent one or derive it by booking ancestry.
    select count(*) into v_count from public.weekly_exceptional_pay_target_families f
      join private.timesheet_contract_family_aliases original_alias on original_alias.timesheet_id=f.root_timesheet_id
      join private.timesheet_contract_family_aliases current_alias on current_alias.family_root_id=original_alias.family_root_id
        and current_alias.member_key=original_alias.member_key and current_alias.timesheet_id=p_root_timesheet_id
      where f.ownership_state='TARGET_MANAGED';
    if v_count=0 then return null;end if;
    if v_count<>1 then raise exception 'WEEKLY_SOURCE_TARGET_FAMILY_AMBIGUOUS' using errcode='55000';end if;
    select f.* into strict v_family from public.weekly_exceptional_pay_target_families f
      join private.timesheet_contract_family_aliases original_alias on original_alias.timesheet_id=f.root_timesheet_id
      join private.timesheet_contract_family_aliases current_alias on current_alias.family_root_id=original_alias.family_root_id
        and current_alias.member_key=original_alias.member_key and current_alias.timesheet_id=p_root_timesheet_id
      where f.ownership_state='TARGET_MANAGED';
    v_placement:=private.timesheet_contract_current_placement_v1(v_family.root_timesheet_id);
    if v_placement->>'current_timesheet_id' is distinct from p_root_timesheet_id::text
      or v_placement->'legacy_origin' is distinct from 'false'::jsonb
      or not exists(select 1 from public.timesheets t join public.contracts c on c.id=t.contract_id
       where t.timesheet_id=p_root_timesheet_id and t.is_current and t.archived_at_utc is null and t.revoked_at is null
        and c.candidate_id=v_family.candidate_id and t.week_ending_date=v_family.week_ending_date
        and c.id::text=v_placement->>'current_contract_id') then
      raise exception 'WEEKLY_SOURCE_ROOT_INTEGRITY_FAILURE' using errcode='55000';end if;
    return v_family;
  end if;

  select family.* into v_family
  from public.weekly_exceptional_pay_target_families family
  where pg_catalog.btrim(family.root_family_booking_id)
        =pg_catalog.btrim(v_identity->>'family_booking_id');
  return v_family;
end;
$function$;
revoke all on function private.weekly_source_target_family_for_root_v1(uuid) from public,anon,authenticated,service_role;

create or replace function private.weekly_source_pay_query_scope_v1(
  p_root_timesheet_id uuid
) returns jsonb
language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_root public.timesheets%rowtype;
  v_contract public.contracts%rowtype;
  v_family public.weekly_exceptional_pay_target_families%rowtype;
  v_identity jsonb;
  v_booking text;
  v_source boolean;
  v_count integer;v_placement jsonb;
begin
  if p_root_timesheet_id is null then
    raise exception 'WEEKLY_SOURCE_PAY_QUERY_ROOT_REQUIRED' using errcode='22023';
  end if;
  -- This existing identity owner refuses raw/trimmed collisions, multiple
  -- current roots and duplicate family versions. Do not guess a successor.
  v_identity:=private.weekly_source_resolve_root_identity_v1(p_root_timesheet_id);
  if (v_identity->>'ok') is distinct from 'true'
     or (v_identity->>'canonical_timesheet_id')::uuid is distinct from p_root_timesheet_id
     or (v_identity->>'requested_is_canonical') is distinct from 'true'
     or (v_identity->>'family_is_current') is distinct from 'true' then return null; end if;
  select t.* into v_root from public.timesheets t where t.timesheet_id=p_root_timesheet_id;
  if not found or v_root.is_current is distinct from true
     or v_root.revoked_at is not null or v_root.archived_at_utc is not null
     or v_root.sheet_scope is distinct from 'WEEKLY'
     or v_root.line_type is distinct from 'HOURS'
     or v_root.is_adjustment is distinct from false
     or v_root.week_ending_date is null or v_root.version is null or v_root.version<1
     or nullif(btrim(v_root.booking_id),'') is null then return null; end if;
  v_booking:=btrim(v_root.booking_id);
  if btrim(v_identity->>'family_booking_id') is distinct from v_booking then return null; end if;
  select c.* into v_contract from public.contracts c where c.id=v_root.contract_id;
  if not found or v_contract.candidate_id is null or v_contract.client_id is null then return null; end if;
  -- Preserve the established Source route's self-bill domain, including real
  -- first-authorisation transitions. Always execute the installed classifier:
  -- its integrity/permission errors must not be short-circuited or swallowed.
  v_source:=private._candidate_expense_source_family_v1(p_root_timesheet_id);
  if v_source is distinct from true and exists(select 1 from private.timesheet_contract_family_aliases a where a.timesheet_id=p_root_timesheet_id) then
    v_family:=private.weekly_source_target_family_for_root_v1(p_root_timesheet_id);
    if v_family.id is not null and v_family.root_timesheet_id is distinct from p_root_timesheet_id then
      v_placement:=private.timesheet_contract_current_placement_v1(v_family.root_timesheet_id);
      if v_placement->>'current_timesheet_id' is distinct from p_root_timesheet_id::text
       or v_placement->>'current_contract_id' is distinct from v_root.contract_id::text then
       raise exception 'WEEKLY_SOURCE_ROOT_INTEGRITY_FAILURE' using errcode='55000';end if;
      -- Source classification stays with the real immutable original owner;
      -- this certified current financial B scope does not change that owner.
      v_source:=private._candidate_expense_source_family_v1(v_family.root_timesheet_id);
    end if;
  end if;
  if v_contract.self_bill is distinct from true and v_source is distinct from true then
    return null;
  end if;
  select count(*) into v_count from public.contract_weeks cw
    where cw.contract_id=v_root.contract_id and cw.week_ending_date=v_root.week_ending_date
      and cw.additional_seq=0 and cw.is_adjustment is false
      and cw.timesheet_id=p_root_timesheet_id;
  if v_count<>1 then return null; end if;
  select count(*) into v_count from public.weekly_exceptional_pay_target_families f
    where btrim(f.root_family_booking_id)=v_booking;
  if v_count>1 then return null; end if;
  if v_count=1 then
    select f.* into strict v_family from public.weekly_exceptional_pay_target_families f
      where btrim(f.root_family_booking_id)=v_booking;
    if v_family.root_timesheet_id is distinct from p_root_timesheet_id
       or v_family.root_family_booking_id is distinct from v_root.booking_id
       or v_family.candidate_id is distinct from v_contract.candidate_id
       or v_family.contract_id is distinct from v_root.contract_id
       or v_family.week_ending_date is distinct from v_root.week_ending_date
       or v_family.week_start_date is distinct from (v_root.week_ending_date-6)
       or v_family.bound_version is null or v_family.bound_version<1 then return null; end if;
  end if;
  if v_count=0 then
    v_family:=private.weekly_source_target_family_for_root_v1(p_root_timesheet_id);
    if v_family.id is not null then
      v_placement:=private.timesheet_contract_current_placement_v1(v_family.root_timesheet_id);
      if v_placement->>'current_timesheet_id' is distinct from p_root_timesheet_id::text
        or v_placement->>'current_contract_id' is distinct from v_contract.id::text
        or v_placement->'legacy_origin' is distinct from 'false'::jsonb
        or v_family.candidate_id is distinct from v_contract.candidate_id
        or v_family.week_ending_date is distinct from v_root.week_ending_date or v_family.bound_version<1 then
        raise exception 'WEEKLY_SOURCE_ROOT_INTEGRITY_FAILURE' using errcode='55000';end if;
    end if;
  end if;
  -- Ordinary Source publication does not create an exceptional target family.
  -- Its absence remains NULL on both genuine initial TSFIN and normal HEAD
  -- paths. Never manufacture protected identity to satisfy a query reader.
  return jsonb_build_object('root_timesheet_id',v_root.timesheet_id,
    'family_booking_id',v_root.booking_id,'target_family_id',v_family.id,
    'candidate_id',v_contract.candidate_id,'client_id',v_contract.client_id,
    'contract_id',v_contract.id,'week_ending_date',v_root.week_ending_date,
    'root_version',v_root.version::text,'family_bound_version',v_family.bound_version::text);
end;
$function$;
revoke all on function private.weekly_source_pay_query_scope_v1(uuid) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/27_certified_current_native_scope.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/28_current_native_entitlement_projection.sqlinc
-- Pure projection of already certified native facts for the existing native
-- component manifest. Original context is retained by its caller unchanged.
create or replace function private.weekly_source_protected_entitlement_projection_v1(p_context jsonb)
returns jsonb language plpgsql immutable set search_path=pg_catalog as $function$
declare placement jsonb:=p_context->'protected_current_placement';current_facts jsonb:=p_context->'current_entitlement';
begin
 if jsonb_typeof(placement) is distinct from 'object' or placement->>'version' is distinct from 'PROTECTED_CURRENT_PLACEMENT_V1'
  or placement->>'family_id' is distinct from p_context->>'family_id'
  or placement->>'original_root_timesheet_id' is distinct from p_context->>'root_timesheet_id'
  or placement->>'current_timesheet_id' is distinct from current_facts#>>'{timesheet,timesheet_id}'
  or placement->>'current_contract_id' is distinct from current_facts#>>'{contract_record,id}'
  or current_facts#>>'{timesheet,contract_id}' is distinct from placement->>'current_contract_id'
  or current_facts#>>'{timesheet,version}' is distinct from placement->>'current_timesheet_version'
  or current_facts#>>'{current_financial,id}' is distinct from placement->>'current_financial_id'
  or current_facts#>>'{contract_record,candidate_id}' is distinct from p_context->>'candidate_id'
  or current_facts#>>'{contract_record,client_id}' is distinct from p_context->>'client_id' then
  raise exception 'PROTECTED_CURRENT_ENTITLEMENT_UNBOUND' using errcode='23514';end if;
 return p_context||jsonb_build_object('root_timesheet_id',placement->'current_timesheet_id','contract_id',placement->'current_contract_id',
  'timesheet',current_facts->'timesheet','contract_record',current_facts->'contract_record','current_financial',current_facts->'current_financial');
end;
$function$;
revoke all on function private.weekly_source_protected_entitlement_projection_v1(jsonb) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/28_current_native_entitlement_projection.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/29_current_local_native_context.sqlinc
create or replace function private.weekly_source_local_preauthorisation_write_allowed_v1(
  p_root_timesheet_id uuid, p_snapshot jsonb
) returns boolean
language sql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
  select count(*)=1
  from private.weekly_source_local_protected_decision_receipts receipt
  join public.weekly_exceptional_pay_target_families family on family.id=receipt.family_id
  join public.weekly_exceptional_pay_generations generation on generation.id=receipt.generation_id
  join public.timesheets root on root.timesheet_id=receipt.root_timesheet_id
  where receipt.root_timesheet_id=p_root_timesheet_id
    and receipt.state='PREPARING'
    and receipt.preparing_transaction_id=pg_catalog.pg_current_xact_id()
    and (family.root_timesheet_id=root.timesheet_id or (
      private.timesheet_contract_current_placement_v1(family.root_timesheet_id)->>'current_timesheet_id'=root.timesheet_id::text
      and private.timesheet_contract_current_placement_v1(family.root_timesheet_id)->>'current_contract_id'=root.contract_id::text
      and exists(select 1 from public.contracts c where c.id=root.contract_id and c.candidate_id=family.candidate_id)
      and root.week_ending_date=family.week_ending_date))
    and family.ownership_state='TARGET_MANAGED'
    and generation.family_id=family.id and generation.lifecycle_state='PENDING_C1'
    and root.is_current and root.revoked_at is null and root.archived_at_utc is null
    and root.authorised_at_server is null
    and not exists(select 1 from public.weekly_source_root_authorisations authority
                   where authority.root_timesheet_id=root.timesheet_id and authority.withdrawn_at_utc is null)
    and (select count(*) from public.timesheets_financials financial
         where financial.timesheet_id=root.timesheet_id and financial.is_current)=1
    and exists(select 1 from public.timesheets_financials financial
      where financial.id=receipt.prior_financial_id and financial.is_current
        and financial.timesheet_id=root.timesheet_id and financial.authorised_at_utc is null
        and financial.processing_status='PENDING_AUTH'
        and financial.paid_at_utc is null and financial.locked_by_invoice_id is null)
    and (p_snapshot is null or p_snapshot=receipt.approved_snapshot_json);
$function$;
revoke all on function private.weekly_source_local_preauthorisation_write_allowed_v1(uuid,jsonb) from public,anon,authenticated,service_role;
grant execute on function private.weekly_source_local_preauthorisation_write_allowed_v1(uuid,jsonb) to service_role;

create or replace function private.weekly_source_local_publication_context_v2(
  p_publication_request_id uuid,p_generation_id uuid,p_root_timesheet_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_local private.weekly_source_local_protected_decision_receipts%rowtype;
  v_request public.weekly_exceptional_c1_publication_requests%rowtype;
  v_generation public.weekly_exceptional_pay_generations%rowtype;
  v_family public.weekly_exceptional_pay_target_families%rowtype;
  v_run public.weekly_exceptional_orchestration_runs%rowtype;
  v_approval public.weekly_exceptional_payment_approvals%rowtype;
  v_event public.weekly_exceptional_pay_family_events%rowtype;
  v_stage public.weekly_exceptional_orchestration_steps%rowtype;
  v_complete public.weekly_exceptional_orchestration_steps%rowtype;
  v_scope jsonb;
  v_inventory jsonb;
  v_prior_inventory jsonb;
  v_basis jsonb;
  v_before_origin jsonb;
  v_snapshot jsonb;
  v_sources jsonb;
  v_source_count integer;
  v_context jsonb;
  v_qualification jsonb;
  v_policy_hash bytea;
  v_before_bound bigint;
  v_staged_bound bigint;
  v_stage_hash bytea;v_placement jsonb;
begin
  if p_publication_request_id is null or p_generation_id is null or p_root_timesheet_id is null then
    raise exception 'WEEKLY_PROTECTED_LOCAL_PUBLICATION_IDENTITY_REQUIRED' using errcode='22023'; end if;
  select r.* into v_local from private.weekly_source_local_protected_decision_receipts r
    where r.publication_request_id=p_publication_request_id;
  if not found or v_local.generation_id is distinct from p_generation_id
     or v_local.root_timesheet_id is distinct from p_root_timesheet_id
     or (v_local.state='PREPARING' and v_local.preparing_transaction_id is distinct from pg_current_xact_id())
     or v_local.state not in ('PREPARING','PENDING_FREEZE') then return null; end if;
  v_scope:=private.weekly_source_pay_query_scope_v1(p_root_timesheet_id);
  if v_scope is null or v_scope->>'target_family_id' is distinct from v_local.family_id::text then return null; end if;
  select r.* into v_request from public.weekly_exceptional_c1_publication_requests r
    where r.id=v_local.publication_request_id;
  if not found or v_request.generation_id is distinct from v_local.generation_id
     or v_request.family_id is distinct from v_local.family_id
     or v_request.root_timesheet_id is distinct from p_root_timesheet_id
     or v_request.request_sha256 is distinct from v_local.request_sha256
     or v_request.financial_row_id is distinct from v_local.prior_financial_id
     or v_request.agency_id is distinct from (select f.agency_id from public.weekly_exceptional_pay_target_families f where f.id=v_local.family_id)
     or v_request.candidate_id::text is distinct from v_scope->>'candidate_id'
     or v_request.contract_id::text is distinct from v_scope->>'contract_id'
     or to_char(v_request.week_ending_date,'YYYY-MM-DD') is distinct from v_scope->>'week_ending_date'
     or v_request.c1_operation_id is not null or v_request.c1_publication_id is not null
     or v_request.c1_head_revision is not null or v_request.c1_receipt_sha256 is not null
     or (v_local.state='PREPARING' and v_request.state<>'READY')
     or (v_local.state='PENDING_FREEZE' and v_request.state<>'RETIRED') then return null; end if;
  select r.* into v_run from public.weekly_exceptional_orchestration_runs r
    where r.id=v_request.orchestration_run_id;
  if not found or v_run.family_id is distinct from v_local.family_id
     or v_run.requested_by_user_id is distinct from v_local.actor_user_id
     or (v_local.state='PREPARING' and v_run.state<>'RUNNING')
     or (v_local.state='PENDING_FREEZE' and v_run.state<>'COMPLETE') then return null; end if;
  if v_local.state='PENDING_FREEZE' and (v_run.completed_at_utc is null
     or v_request.completed_at_utc is null or v_local.completed_at_utc is null
     or v_request.typed_result_json is distinct from v_local.result_json
     or v_run.after_state_fingerprint is distinct from private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_PROTECTED_LOCAL_RESULT_V1',v_local.result_json)
     or v_local.result_json->>'outcome' is distinct from 'SAVED_PENDING_FREEZE'
     or v_local.result_json->>'family_bound_version' is distinct from v_scope->>'family_bound_version') then return null; end if;
  select f.* into v_family from public.weekly_exceptional_pay_target_families f
    where f.id=v_local.family_id;
  if found and v_family.root_timesheet_id is distinct from p_root_timesheet_id then
    v_placement:=private.weekly_source_protected_current_placement_v1(v_family.id,
      (select a.work_event_id from public.weekly_exceptional_payment_approvals a
       where a.creation_orchestration_run_id=v_run.id and a.pay_target_family_id=v_family.id),false);
    if v_placement->'moved' is distinct from 'true'::jsonb
      or v_placement->>'current_timesheet_id' is distinct from p_root_timesheet_id::text
      or v_placement->>'current_contract_id' is distinct from v_request.contract_id::text then return null;end if;
  end if;
  if v_family.id is null or (v_placement is null and (
       v_family.root_timesheet_id is distinct from p_root_timesheet_id
       or v_family.root_family_booking_id is distinct from v_scope->>'family_booking_id'
       or v_family.contract_id is distinct from v_request.contract_id))
     or v_family.candidate_id is distinct from v_request.candidate_id
     or v_family.week_ending_date is distinct from v_request.week_ending_date then return null; end if;
  select g.* into v_generation from public.weekly_exceptional_pay_generations g
    where g.id=v_local.generation_id and g.family_id=v_local.family_id;
  if not found or v_generation.lifecycle_state<>'PENDING_C1'
     or private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',
        v_generation.complete_next_vector_json) is distinct from v_generation.complete_next_vector_hash
     or v_family.current_generation_id is distinct from v_generation.prior_generation_id then return null; end if;
  select a.* into strict v_approval from public.weekly_exceptional_payment_approvals a
    where a.creation_orchestration_run_id=v_run.id and a.pay_target_family_id=v_family.id;
  if v_approval.withdrawn_at_utc is not null or v_approval.approved_by_user_id is distinct from v_local.actor_user_id
     or v_approval.candidate_id is distinct from v_family.candidate_id
     or v_approval.client_id::text is distinct from v_scope->>'client_id'
     or v_approval.contract_id is distinct from v_family.contract_id
     or v_approval.week_ending is distinct from v_family.week_ending_date
     or v_approval.protected_work_date not between v_family.week_ending_date-6 and v_family.week_ending_date
     or not exists(select 1 from public.weekly_work_events e
       where e.id=v_approval.work_event_id and e.candidate_id=v_family.candidate_id
         and e.client_id=v_approval.client_id and e.work_date=v_approval.protected_work_date) then return null; end if;
  select e.* into v_event from public.weekly_exceptional_pay_family_events e
    where e.family_id=v_family.id and e.durable_work_event_id=v_approval.work_event_id
    order by e.event_sequence desc limit 1;
  if not found or v_event.evidence_approval_id is distinct from v_approval.id
     or v_event.office_actor_user_id is distinct from v_local.actor_user_id
     or v_event.work_date is distinct from v_approval.protected_work_date
     or private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_SOURCE_PROPOSAL_V1',
        v_event.source_proposal_snapshot_json) is distinct from v_event.source_proposal_hash
     or not exists(select 1 from public.weekly_exceptional_pay_target_events e
       where e.family_id=v_family.id and e.approval_id=v_approval.id
         and e.financial_generation_id=v_generation.id
         and e.complete_next_family_vector_fingerprint=v_generation.complete_next_vector_hash) then return null; end if;
  v_snapshot:=v_generation.complete_next_vector_json#>'{target_snapshot,tsfin_snapshot_json}';
  if jsonb_typeof(v_snapshot) is distinct from 'object'
     or v_snapshot is distinct from v_approval.approved_target_pay_components_json->'tsfin_snapshot_json'
     or (v_local.approved_snapshot_json-array['common_decision_bundle_id','common_components_digest',
           'local_source_qualification','local_publication_origin'])
        is distinct from (v_snapshot||jsonb_build_object('timesheet_id',p_root_timesheet_id::text,
          'timesheet_version',(v_scope->>'root_version')::integer,'actual_schedule_json',
          v_generation.complete_next_vector_json#>'{target_snapshot,actual_schedule_json}')) then return null; end if;
  v_inventory:=private.weekly_source_effective_inventory_v1(p_root_timesheet_id);
  v_prior_inventory:=v_generation.complete_next_vector_json->'prior_effective_inventory';
  -- The actual stage owner sealed the old entitlement at K, then advanced
  -- only its own family version to K+1. Prove that exact successful stage
  -- step before normalising this nonmonetary transition. No unrelated change
  -- to the complete before-position is accepted.
  if coalesce(v_prior_inventory#>>'{approval_basis,scope,family_bound_version}','') !~ '^(0|[1-9][0-9]*)$'
     or v_prior_inventory#>>'{approval_basis,scope,target_family_id}' is distinct from v_family.id::text then return null; end if;
  v_before_bound:=(v_prior_inventory#>>'{approval_basis,scope,family_bound_version}')::bigint;
  v_staged_bound:=v_before_bound+1;
  select s.* into strict v_stage from public.weekly_exceptional_orchestration_steps s
    where s.orchestration_run_id=v_run.id and s.step_kind='STAGE_C1_REQUEST';
  v_stage_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_C1_STAGED_STATE_V1',
    jsonb_build_object('family_id',v_family.id,'generation_id',v_generation.id,
      'publication_request_id',v_request.id,'request_sha256',encode(v_request.request_sha256,'hex'),
      'new_bound_version',v_staged_bound));
  if v_stage.outcome is distinct from 'COMPLETE' or v_stage.completed_at_utc is null
     or v_stage.allowlisted_owner_name is distinct from 'public.weekly_exceptional_pay_stage_c1_request_v1'
     or v_stage.allowlisted_owner_signature is distinct from 'jsonb->jsonb'
     or v_stage.before_state_fingerprint is distinct from v_run.before_state_fingerprint
     or v_stage.after_state_fingerprint is distinct from v_stage_hash
     or v_stage.owner_response_hash is distinct from v_stage_hash
     or v_stage.bounded_owner_response_json is distinct from jsonb_build_object(
       'publication_request_id',v_request.id,'generation_id',v_generation.id,
       'request_sha256',encode(v_request.request_sha256,'hex'))
     or (v_local.state='PREPARING' and v_family.bound_version is distinct from v_staged_bound)
     or (v_local.state='PENDING_FREEZE' and v_family.bound_version is distinct from v_staged_bound+1) then return null; end if;
  v_inventory:=jsonb_set(v_inventory,'{approval_basis,scope,family_bound_version}',
    v_prior_inventory#>'{approval_basis,scope,family_bound_version}',false);
  if v_local.state='PENDING_FREEZE' then
    select s.* into strict v_complete from public.weekly_exceptional_orchestration_steps s
      where s.orchestration_run_id=v_run.id and s.step_kind='COMPLETE_LOCAL_PROTECTED_DECISION'
        and s.idempotency_key=v_local.idempotency_key;
    if v_complete.sequence<=v_stage.sequence or v_complete.completed_at_utc is null
       or v_complete.outcome is distinct from 'PENDING'
       or v_complete.allowlisted_owner_name is distinct from 'CloudTMS.weekly_exceptional_pay_complete_local_v1'
       or v_complete.allowlisted_owner_signature is distinct from 'jsonb'
       or v_complete.bounded_request_hash is distinct from v_local.request_sha256
       or v_complete.before_state_fingerprint is distinct from v_run.before_state_fingerprint
       or v_complete.bounded_owner_response_json is distinct from v_local.result_json
       or v_complete.owner_response_hash is distinct from v_run.after_state_fingerprint
       or v_complete.after_state_fingerprint is distinct from v_run.after_state_fingerprint then return null; end if;
    -- Acceptance adds one further, independently proved own increment. Keep
    -- the qualified publication scope as it was at stage/Save, not today's
    -- accepted version; the original entitlement witness remains untouched.
    v_scope:=jsonb_set(v_scope,'{family_bound_version}',
      to_jsonb(v_staged_bound::text),false);
  end if;
  v_basis:=v_inventory->'approval_basis';
  if v_inventory->>'ok' is distinct from 'true'
     or v_basis->>'coverage_complete' is distinct from 'true'
     or coalesce(v_basis#>>'{origin,kind}','') not in ('INITIAL_AUTHORISED_TSFIN_V1','COMMITTED_SOURCE_HEAD_V1')
     or v_prior_inventory is distinct from v_inventory
     or v_basis#>>'{scope,root_timesheet_id}' is distinct from p_root_timesheet_id::text
     or v_basis#>>'{scope,family_booking_id}' is distinct from v_scope->>'family_booking_id'
     or v_basis#>>'{scope,root_version}' is distinct from v_scope->>'root_version'
     or v_basis#>>'{scope,candidate_id}' is distinct from v_scope->>'candidate_id'
     or v_basis#>>'{scope,client_id}' is distinct from v_scope->>'client_id'
     or v_basis#>>'{scope,contract_id}' is distinct from v_scope->>'contract_id'
     or v_basis#>>'{scope,week_ending_date}' is distinct from v_scope->>'week_ending_date' then return null; end if;
  -- Actual Source proposal owner, not a made-up current Final for a local save.
  v_context:=private.weekly_source_protected_final_source_context_v1(
    v_family.id,v_approval.source_cycle_id,v_approval.work_event_id);
  if v_context->'source_proposal' is distinct from v_event.source_proposal_snapshot_json then return null; end if;
  select private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_RATE_POLICY_V1',
    jsonb_build_object('contract_id',v_family.contract_id,'rates_json',c.rates_json,
      'policy',private._weekly_source_effective_policy_v1(v_approval.client_id,v_family.contract_id,
        v_approval.protected_work_date),'classification',v_event.rate_classification_json))
    into strict v_policy_hash from public.contracts c where c.id=v_family.contract_id;
  if v_policy_hash is distinct from v_approval.contract_rate_policy_source_fingerprint then return null; end if;
  select count(*)::integer,coalesce(jsonb_agg(jsonb_build_object(
    'source_ordinal',s.source_ordinal,'authority_kind',s.authority_kind,'source_system',s.source_system,
    'external_identity',s.external_identity,'external_revision',s.external_revision,
    'source_document_sha256',encode(s.source_document_sha256,'hex'),
    'payload_bytes',s.payload_bytes,'part_count',s.part_count,'work_date',s.work_date,
    'root_timesheet_id',s.root_timesheet_id,'candidate_id',s.candidate_id,'contract_id',s.contract_id,
    'source_row_sha256',encode(s.source_row_sha256,'hex')) order by s.source_ordinal),'[]'::jsonb)
    into v_source_count,v_sources from public.weekly_exceptional_c1_source_records s
    where s.publication_request_id=v_request.id;
  if v_source_count is distinct from v_request.expected_source_count
     or not exists(select 1 from public.weekly_exceptional_c1_source_records s
       where s.publication_request_id=v_request.id and s.authority_kind='CLIENT_SOURCE')
     or exists(select 1 from public.weekly_exceptional_c1_source_records s
       where s.publication_request_id=v_request.id and (s.root_timesheet_id is distinct from p_root_timesheet_id
         or s.candidate_id is distinct from v_family.candidate_id
         or s.contract_id is distinct from v_request.contract_id)) then return null; end if;
  v_qualification:=jsonb_build_object('schema_version','PROTECTED_LOCAL_SOURCE_QUALIFICATION_V2',
    'publication_request_id',v_request.id,'generation_id',v_generation.id,'scope',v_scope,
    'source_cycle_id',v_approval.source_cycle_id,'work_event_id',v_approval.work_event_id,
    'approval_id',v_approval.id,'actor_user_id',v_local.actor_user_id,
    'family_event_sequence',v_event.event_sequence::text,
    'source_proposal_hash',encode(v_event.source_proposal_hash,'hex'),
    'complete_vector_hash',encode(v_generation.complete_next_vector_hash,'hex'),
    'rate_policy_fingerprint',encode(v_approval.contract_rate_policy_source_fingerprint,'hex'),
    'prepared_sources',v_sources);
  -- Keep the complete live-versus-sealed I1 comparison above unchanged. Only
  -- this Local publication witness is flattened, after genuine qualification.
  -- Generic I1 retains the referenced HEAD's full Source/Final lineage.
  v_before_origin:=v_basis->'origin';
  if v_before_origin->>'kind'='COMMITTED_SOURCE_HEAD_V1' then
    v_before_origin:=v_before_origin-'source_revision';
  end if;
  return jsonb_build_object('scope',v_scope,'agency_id',v_family.agency_id,
    'actor_user_id',v_local.actor_user_id,'before_origin',v_before_origin,
    'before_inventory_digest',v_inventory->'inventory_digest',
    'source_qualification_digest',encode(private.weekly_source_sha256_jsonb_v1(
      'PROTECTED_LOCAL_SOURCE_QUALIFICATION_V2',v_qualification),'hex'),
    'policy_fingerprint',encode(v_approval.contract_rate_policy_source_fingerprint,'hex'),
    'qualification',v_qualification);
end;
$function$;
revoke all on function private.weekly_source_local_publication_context_v2(uuid,uuid,uuid) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/29_current_local_native_context.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/30_native_saved_placement_proof.sqlinc
-- Validate the genuine placement sealed by the actual native stage. A later
-- B-to-C move does not rewrite an already accepted Local B receipt to C.
create or replace function private.weekly_source_protected_saved_placement_v1(p_generation_id uuid,p_root_timesheet_id uuid,p_contract_id uuid)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,private,public as $function$
declare generation public.weekly_exceptional_pay_generations%rowtype;family public.weekly_exceptional_pay_target_families%rowtype;
 request public.weekly_exceptional_c1_publication_requests%rowtype;placement jsonb;physical public.timesheets%rowtype;
 alias private.timesheet_contract_family_aliases%rowtype;member private.timesheet_contract_move_members%rowtype;
 operation private.timesheet_contract_move_operations%rowtype;
begin
 select g.* into strict generation from public.weekly_exceptional_pay_generations g where g.id=p_generation_id;
 select f.* into strict family from public.weekly_exceptional_pay_target_families f where f.id=generation.family_id;
 select r.* into strict request from public.weekly_exceptional_c1_publication_requests r where r.generation_id=generation.id and r.family_id=family.id;
 if family.root_timesheet_id=p_root_timesheet_id and family.contract_id=p_contract_id then return null;end if;
 placement:=generation.complete_next_vector_json->'accepted_current_placement';
 select t.* into strict physical from public.timesheets t where t.timesheet_id=p_root_timesheet_id;
 select a.* into strict alias from private.timesheet_contract_family_aliases a where a.timesheet_id=family.root_timesheet_id;
 select o.* into strict operation from private.timesheet_contract_move_operations o where o.id=(placement->>'move_operation_id')::uuid;
 select m.* into strict member from private.timesheet_contract_move_members m where m.operation_id=operation.id and m.member_key=alias.member_key;
 if placement->>'version' is distinct from 'PROTECTED_CURRENT_PLACEMENT_V1' or placement->'moved' is distinct from 'true'::jsonb
  or placement->>'family_id' is distinct from family.id::text or placement->>'original_root_timesheet_id' is distinct from family.root_timesheet_id::text
  or placement->>'original_contract_id' is distinct from family.contract_id::text or placement->>'current_timesheet_id' is distinct from physical.timesheet_id::text
  or placement->>'current_contract_id' is distinct from p_contract_id::text or physical.contract_id is distinct from p_contract_id
  or placement->>'family_root_id' is distinct from alias.family_root_id::text or placement->>'member_key' is distinct from alias.member_key
  or physical.week_ending_date is distinct from family.week_ending_date or request.root_timesheet_id is distinct from physical.timesheet_id
  or request.contract_id is distinct from physical.contract_id or request.candidate_id is distinct from family.candidate_id
  or private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',generation.complete_next_vector_json) is distinct from generation.complete_next_vector_hash
  or alias.original_timesheet_id is distinct from family.root_timesheet_id or operation.state not in('COMPLETE','SUPERSEDED')
  or operation.purpose<>'CONTRACT_CORRECTION' or operation.family_root_id is distinct from alias.family_root_id
  or operation.candidate_id is distinct from family.candidate_id or operation.accepted_review_id is null
  or operation.placement_receipt_json->>'version' is distinct from 'CONTRACT_MOVE_PLACEMENT_RECEIPT_V1'
  or operation.placement_receipt_json->>'operation_id' is distinct from operation.id::text
  or member.to_timesheet_id is distinct from physical.timesheet_id or member.to_contract_id is distinct from physical.contract_id
  or member.to_version::text is distinct from placement->>'current_timesheet_version'
  or member.immutable_evidence_hash is distinct from private.weekly_exceptional_hex_sha256_v1(placement->>'immutable_original_evidence_sha256')
  or member.immutable_evidence_hash is distinct from private.timesheet_contract_move_row_hash_v1(
    private.timesheet_contract_move_evidence_v1(family.root_timesheet_id))
  or exists(select 1 from private.weekly_source_pay_decision_unprotect_preparations p where p.orchestration_run_id=request.orchestration_run_id
    and p.placement_certificate_sha256 is distinct from private.weekly_exceptional_hex_sha256_v1(placement->>'placement_certificate_sha256')) then
  raise exception 'PROTECTED_SAVED_PLACEMENT_UNBOUND' using errcode='23514';end if;
 return placement;
exception when no_data_found or too_many_rows or invalid_text_representation or numeric_value_out_of_range then
 raise exception 'PROTECTED_SAVED_PLACEMENT_UNBOUND' using errcode='23514';
end;
$function$;
revoke all on function private.weekly_source_protected_saved_placement_v1(uuid,uuid,uuid) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/30_native_saved_placement_proof.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/31_current_financial_native_source.sqlinc
-- Root-authorized narrow INTERNAL read. Original context root_financial stays
-- original A. Only the real B stream consumes this native financial source.
-- One exact native fact projection is reused for original A and actual B.
create or replace function private.weekly_source_protected_root_financial_fact_v1(p_financial jsonb,p_root_version integer)
returns jsonb language plpgsql immutable security definer set search_path=pg_catalog,private,public as $function$
declare row_hash bytea;
begin
 if p_financial is null or p_financial='null'::jsonb then return null;end if;
 if jsonb_typeof(p_financial) is distinct from 'object' or (p_financial->>'id')::uuid is null
  or p_root_version is null or p_root_version<1 or (p_financial->>'timesheet_version')::integer<1 then
  raise exception 'SOURCE_ROOT_FINANCIAL_FACT_INVALID' using errcode='23514';end if;
 row_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_ROOT_FINANCIAL_V1',p_financial);
 return jsonb_build_object('source_system','CLOUDTMS_TIMESHEET_FINANCIAL','external_identity',p_financial->>'id',
  'external_revision',p_financial->>'timesheet_version','document_sha256',encode(row_hash,'hex'),'financial_row_id',p_financial->'id',
  'root_version',p_root_version,'financial_timesheet_version',p_financial->'timesheet_version','financial_revision_digest',encode(row_hash,'hex'));
end;
$function$;
revoke all on function private.weekly_source_protected_root_financial_fact_v1(jsonb,integer) from public,anon,authenticated,service_role;

create or replace function public.weekly_source_protected_current_financial_source_v1(p_request jsonb)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,private,public as $function$
declare actor uuid;family public.weekly_exceptional_pay_target_families%rowtype;
 event public.weekly_work_events%rowtype;cycle public.weekly_source_cycles%rowtype;
 physical public.timesheets%rowtype;financial public.timesheets_financials%rowtype;
 certificate jsonb;source_fact jsonb;
begin
 if coalesce(current_setting('request.jwt.claim.role',true),nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['version','actor_user_id','family_id','work_event_id','source_cycle_id','expected_placement_certificate_sha256'])
  or not(p_request ?& array['version','actor_user_id','family_id','work_event_id','source_cycle_id','expected_placement_certificate_sha256'])
  or p_request->>'version' is distinct from 'SOURCE_CURRENT_FINANCIAL_SOURCE_REQUEST_V1' then
  raise exception 'SOURCE_CURRENT_FINANCIAL_SOURCE_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;
 if actor is null or not private.weekly_source_pay_actor_allowed_v1(actor) then
  raise exception 'SOURCE_PAY_DECISION_ACTOR_REQUIRED' using errcode='42501';end if;
 select f.* into strict family from public.weekly_exceptional_pay_target_families f where f.id=(p_request->>'family_id')::uuid;
 select e.* into strict event from public.weekly_work_events e where e.id=(p_request->>'work_event_id')::uuid and e.candidate_id=family.candidate_id;
 select c.* into strict cycle from public.weekly_source_cycles c where c.id=(p_request->>'source_cycle_id')::uuid;
 if not exists(select 1 from public.weekly_source_groups g where g.id=cycle.source_group_id and g.agency_id=family.agency_id and g.active) then
  raise exception 'SOURCE_CURRENT_FINANCIAL_SOURCE_INVALID' using errcode='23514';end if;
 perform private.weekly_source_office_authority_v1(actor,'APPROVE_PROTECTED_PAY',cycle.source_group_id,event.client_id,cycle.finalisation_week_ending);
 certificate:=private.weekly_source_protected_current_placement_v1(family.id,event.id,false);
 if certificate->'moved' is distinct from 'true'::jsonb or certificate->>'placement_certificate_sha256'
   is distinct from p_request->>'expected_placement_certificate_sha256' then
  raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
 select t.* into strict physical from public.timesheets t where t.timesheet_id=(certificate->>'current_timesheet_id')::uuid;
 select f.* into strict financial from public.timesheets_financials f where f.id=(certificate->>'current_financial_id')::uuid;
 if not financial.is_current or financial.is_stale or financial.timesheet_id is distinct from physical.timesheet_id
  or financial.timesheet_version is distinct from physical.version or financial.candidate_id is distinct from family.candidate_id
  or financial.client_id is distinct from event.client_id then
  raise exception 'SOURCE_CURRENT_FINANCIAL_SOURCE_INVALID' using errcode='23514';end if;
 -- Exact same native owner/domain/projection as the retained original A fact.
 source_fact:=private.weekly_source_protected_root_financial_fact_v1(to_jsonb(financial),physical.version);
 return jsonb_build_object('version','SOURCE_CURRENT_FINANCIAL_SOURCE_RESULT_V1','family_id',family.id,'work_event_id',event.id,
  'source_cycle_id',cycle.id,'placement_certificate_sha256',certificate->'placement_certificate_sha256',
  'current_timesheet_id',physical.timesheet_id,'current_contract_id',physical.contract_id,'root_financial',source_fact);
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'SOURCE_CURRENT_FINANCIAL_SOURCE_INVALID' using errcode='23514';
end;
$function$;
revoke all on function public.weekly_source_protected_current_financial_source_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_protected_current_financial_source_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/31_current_financial_native_source.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/32_source_request_and_scope_guards.sqlinc
-- Health request validation and access: browser facts never grant money/actor authority.
create or replace function private.weekly_source_pay_decision_request_v1(p_body jsonb,p_kind text)
returns jsonb language plpgsql immutable security definer set search_path=pg_catalog,private,public as $function$
declare keys text[];entry jsonb;ref jsonb;k text[];seen text[]:='{}';identity text;d text;components text[];
begin
 if p_kind='PREVIEW' then
  keys:=array['version','decision_id','request_id','decision','selection','evidence_refs','financial_history_refs'];
  if not(p_body ?& array['version','decision_id','request_id','decision','selection']) then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
  p_body:=jsonb_build_object('evidence_refs','[]'::jsonb,'financial_history_refs','[]'::jsonb)||p_body;
 elsif p_kind='ACCEPT' then
  keys:=array['version','action','decision_id','request_id','review_id','review_digest','decision','supersedes_decision_id',
   'expected_prior_dispositions','expected_prior_dispositions_sha256','invoice_policy','contact_policy','reason','evidence_refs',
   'expected_pay_cut_hash','expected_source_invoice_hash','expected_issue_set_hash'];
 elsif p_kind='RESUME_FINANCIAL' then
  keys:=array['version','action','decision_id','request_id','expected_state_revision','review_id','review_digest','expected_pay_cut_hash',
   'evidence_refs','expected_prior_dispositions','expected_prior_dispositions_sha256'];
 elsif p_kind='READ_RESULT' then keys:=array['version','action','decision_id','request_id'];
 else raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_body,keys) or not(p_body ?& keys)
  or p_body->>'version' is distinct from 'SOURCE_PAY_DECISION_V1' or (p_body->>'decision_id')::uuid is null
  or (p_body->>'request_id')::uuid is null or (p_kind<>'PREVIEW' and p_body->>'action' is distinct from p_kind) then
  raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 if p_kind='READ_RESULT' then return p_body;end if;
 if p_kind in('PREVIEW','ACCEPT') and coalesce(p_body->>'decision','') not in('EXCLUDE_FUTURE_WORK_PAY','ACCEPT_FINAL_SOURCE_PAY') then
  raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 if jsonb_typeof(p_body->'evidence_refs') is distinct from 'array' or jsonb_array_length(p_body->'evidence_refs')>250 then
  raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 for ref in select value from jsonb_array_elements(p_body->'evidence_refs') loop
  if not private.weekly_exceptional_json_keys_exact_v1(ref,array['kind','id','version','sha256']) or not(ref ?& array['kind','id','version','sha256'])
   or coalesce(ref->>'kind','') not in('SOURCE_ROW','WORKER_RESPONSE','SIGNED_DOCUMENT','OFFICE_NOTE') or (ref->>'id')::uuid is null
   or (ref->'version'<>'null'::jsonb and (jsonb_typeof(ref->'version')<>'string' or char_length(ref->>'version') not between 1 and 512))
   or (ref->'sha256'<>'null'::jsonb and (jsonb_typeof(ref->'sha256')<>'string' or coalesce(ref->>'sha256','') !~ '^[0-9a-f]{64}$')) then
   raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
  identity:=jsonb_build_array(ref->'kind',ref->'id',ref->'version')::text;
  if identity=any(seen) then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;seen:=array_append(seen,identity);
 end loop;
 seen:='{}';
 if p_kind='PREVIEW' then
  if jsonb_typeof(p_body->'selection') is distinct from 'array' or jsonb_array_length(p_body->'selection') not between 1 and 250 then
   raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
  for entry in select value from jsonb_array_elements(p_body->'selection') loop
   k:=array['scope_kind','scope_mode','family_root_id','source_work_event_id','source_row_id','component_keys','work_dates','expected_work_revision'];
   if not private.weekly_exceptional_json_keys_exact_v1(entry,k) or not(entry ?& k)
    or coalesce(entry->>'scope_kind','') not in('TIMESHEET_FAMILY','SOURCE_ROW') or coalesce(entry->>'scope_mode','') not in('COMPONENT_QUANTITIES','WHOLE_SHIFT')
    or (entry->>'source_row_id')::uuid is null or (entry->>'family_root_id')::uuid is null and entry->>'scope_kind'='TIMESHEET_FAMILY'
    or jsonb_typeof(entry->'component_keys') is distinct from 'array' or jsonb_typeof(entry->'work_dates') is distinct from 'array'
    or jsonb_array_length(entry->'work_dates') not between 1 and 366
    or (entry->>'scope_mode'='COMPONENT_QUANTITIES' and jsonb_array_length(entry->'component_keys')=0)
    or (entry->'expected_work_revision'<>'null'::jsonb and (jsonb_typeof(entry->'expected_work_revision')<>'string'
      or coalesce(entry->>'expected_work_revision','') !~ '^[1-9][0-9]{0,18}$' or (entry->>'expected_work_revision')::bigint<1)) then
    raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
   perform (entry->>'source_work_event_id')::uuid;perform (entry->>'family_root_id')::uuid;
   if exists(select 1 from jsonb_array_elements(entry->'component_keys') c where jsonb_typeof(c.value)<>'string' or char_length(c.value#>>'{}') not between 1 and 512)
    or (select count(*) from jsonb_array_elements(entry->'component_keys'))<>(select count(distinct value) from jsonb_array_elements(entry->'component_keys'))
    or (select count(*) from jsonb_array_elements(entry->'work_dates'))<>(select count(distinct value) from jsonb_array_elements(entry->'work_dates'))
    or exists(select 1 from jsonb_array_elements(entry->'work_dates') dt where jsonb_typeof(dt.value)<>'string'
      or dt.value#>>'{}' !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' or to_char((dt.value#>>'{}')::date,'YYYY-MM-DD')<>dt.value#>>'{}')
    or entry->'work_dates' is distinct from (select jsonb_agg(value order by value#>>'{}') from jsonb_array_elements(entry->'work_dates')) then
    raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
   -- Selections for one original row may be disjoint genuine components only.
   -- WHOLE_SHIFT overlaps any member of that original subject, across scope labels.
   for ref in select value from jsonb_array_elements(p_body->'selection') where value<>entry
     and value->>'source_row_id'=entry->>'source_row_id' loop
    if ref->>'scope_mode'='WHOLE_SHIFT' or entry->>'scope_mode'='WHOLE_SHIFT'
      or exists(select 1 from jsonb_array_elements_text(ref->'component_keys') c
        join jsonb_array_elements_text(entry->'component_keys') other on other.value=c.value)
      then raise exception 'SOURCE_PAY_DECISION_SELECTION_OVERLAP' using errcode='22023';end if;
   end loop;
   identity:=entry::text;if identity=any(seen) then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;seen:=array_append(seen,identity);
  end loop;
  -- Native evidence keys are structurally closed here; the genuine cut owner
  -- re-reads their exact native records, associations and hashes.
  if jsonb_typeof(p_body->'financial_history_refs') is distinct from 'array' or jsonb_array_length(p_body->'financial_history_refs')>250 then
   raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
  seen:='{}';
  for ref in select value from jsonb_array_elements(p_body->'financial_history_refs') loop
   if not private.weekly_exceptional_json_keys_exact_v1(ref,array['kind','key','record_sha256']) or not(ref ?& array['kind','key','record_sha256'])
     or jsonb_typeof(ref->'record_sha256') is distinct from 'string' or coalesce(ref->>'record_sha256','') !~ '^[0-9a-f]{64}$' then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
   if ref->>'kind' in('RUN_LINE','FINANCIAL_EFFECT','WORK_HOLD','RECOVERY_HOLD','TRANSFER','TRANSFER_OUTCOME','EXPENSE_COMPONENT','LEGACY_PAY_ITEM','LEGACY_SNAPSHOT','LEGACY_BREAKDOWN','LEGACY_BANK_TRANSFER') then
    k:=array['id'];perform (ref#>>'{key,id}')::uuid;
   elsif ref->>'kind'='APPROVED_LINE' then k:=array['revision_id','line_id','component_key'];
    perform (ref#>>'{key,revision_id}')::uuid;perform (ref#>>'{key,line_id}')::uuid;
   elsif ref->>'kind'='APPROVED_SEGMENT' then k:=array['revision_id','segment_id','component_key','segment_key'];
    perform (ref#>>'{key,revision_id}')::uuid;perform (ref#>>'{key,segment_id}')::uuid;
   elsif ref->>'kind'='LEGACY_V8_COMPONENT' then k:=array['certificate_uuid','constituent_ordinal','evidence_kind','evidence_ordinal'];
    perform (ref#>>'{key,certificate_uuid}')::uuid;
    if (ref#>>'{key,constituent_ordinal}')::integer not between 0 and 49999 or (ref#>>'{key,evidence_ordinal}')::integer<0
      or ref#>>'{key,evidence_kind}' not in('ALL_SAME_ECONOMIC_KEY','FULL_SIGNED_PRE_SIGNATURE','DECISIVE_SIGNED_EVIDENCE') then
     raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
   else raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
   if not private.weekly_exceptional_json_keys_exact_v1(ref->'key',k) or not(ref->'key' ?& k)
     or exists(select 1 from jsonb_each(ref->'key') e where e.value='null'::jsonb) then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
   identity:=jsonb_build_array(ref->'kind',ref->'key')::text;
   if identity=any(seen) then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;seen:=array_append(seen,identity);
  end loop;
 else
  if exists(select 1 from unnest(array['review_digest','expected_pay_cut_hash','expected_prior_dispositions_sha256']) key where jsonb_typeof(p_body->key) is distinct from 'string')
   or (p_body->>'review_id')::uuid is null or coalesce(p_body->>'review_digest','') !~ '^[0-9a-f]{64}$'
   or coalesce(p_body->>'expected_pay_cut_hash','') !~ '^[0-9a-f]{64}$' or coalesce(p_body->>'expected_prior_dispositions_sha256','') !~ '^[0-9a-f]{64}$'
   or jsonb_typeof(p_body->'expected_prior_dispositions') is distinct from 'array' then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
  for ref in select value from jsonb_array_elements(p_body->'expected_prior_dispositions') loop
   k:=array['member_key','component_key','disposition_id','decision_id','disposition_version'];
   if not private.weekly_exceptional_json_keys_exact_v1(ref,k) or not(ref ?& k) or jsonb_typeof(ref->'member_key') is distinct from 'string' or char_length(coalesce(ref->>'member_key','')) not between 1 and 512
    or (ref->'component_key'<>'null'::jsonb and (jsonb_typeof(ref->'component_key')<>'string' or char_length(coalesce(ref->>'component_key','')) not between 1 and 512))
    or ((ref->'disposition_id'='null'::jsonb)::integer+(ref->'decision_id'='null'::jsonb)::integer+(ref->'disposition_version'='null'::jsonb)::integer) not in(0,3) then
    raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
   if ref->'disposition_id'<>'null'::jsonb then
    perform (ref->>'disposition_id')::uuid;perform (ref->>'decision_id')::uuid;
    if jsonb_typeof(ref->'disposition_version')<>'string' or coalesce(ref->>'disposition_version','') !~ '^[1-9][0-9]{0,18}$'
      or (ref->>'disposition_version')::bigint<1 then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
   end if;
   identity:=jsonb_build_array(ref->'member_key',ref->'component_key')::text;
   if identity=any(seen) then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;seen:=array_append(seen,identity);
  end loop;
  if p_kind='ACCEPT' then
   if p_body->>'invoice_policy' is distinct from 'KEEP_SOURCE_INVOICE' or p_body->>'contact_policy' is distinct from 'DO_NOT_QUERY_SELECTED_ISSUES'
    or jsonb_typeof(p_body->'reason')<>'string' or char_length(btrim(p_body->>'reason')) not between 1 and 1000
    or jsonb_typeof(p_body->'expected_source_invoice_hash') is distinct from 'string' or jsonb_typeof(p_body->'expected_issue_set_hash') is distinct from 'string'
    or coalesce(p_body->>'expected_source_invoice_hash','') !~ '^[0-9a-f]{64}$' or coalesce(p_body->>'expected_issue_set_hash','') !~ '^[0-9a-f]{64}$' then
    raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;perform (p_body->>'supersedes_decision_id')::uuid;
  elsif jsonb_typeof(p_body->'expected_state_revision')<>'string' or coalesce(p_body->>'expected_state_revision','') !~ '^[1-9][0-9]{0,18}$'
    or (p_body->>'expected_state_revision')::bigint<1 then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 end if;
 return p_body;
exception when invalid_text_representation or numeric_value_out_of_range or datetime_field_overflow then
 raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_request_v1(jsonb,text) from public,anon,authenticated,service_role;

create or replace function private.weekly_source_pay_decision_scope_access_v1(p_actor uuid,p_group uuid,p_client uuid,p_date date)
returns void language plpgsql stable security definer set search_path=pg_catalog,private,public as $function$
begin
 if p_actor is null or not private.weekly_source_pay_actor_allowed_v1(p_actor) then
  raise exception 'SOURCE_PAY_DECISION_ACTOR_REQUIRED' using errcode='42501';end if;
 if p_group is null or p_client is null or p_date is null or not exists(select 1 from public.weekly_source_groups g
   join public.weekly_source_group_clients c on c.source_group_id=g.id and c.client_id=p_client
    and p_date between c.valid_from and coalesce(c.valid_to,'infinity'::date) where g.id=p_group and g.active) then
  raise exception 'SOURCE_PAY_DECISION_SCOPE_DENIED' using errcode='42501';end if;
end;
$function$;
revoke all on function private.weekly_source_pay_decision_scope_access_v1(uuid,uuid,uuid,date) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/32_source_request_and_scope_guards.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/33_genuine_source_subject_and_scope.sqlinc
-- Exact native source generation/authority. Extends known subject discovery to
-- authentic prefinancial checking rows; it never manufactures Contract/Work.
create or replace function private.weekly_source_pay_decision_source_subject_v1(p_row uuid)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,private,public as $function$
declare r public.weekly_source_upload_rows%rowtype;u public.weekly_source_uploads%rowtype;c public.weekly_source_cycles%rowtype;
 s public.weekly_source_report_scopes%rowtype;f public.weekly_source_final_revisions%rowtype;
 p public.weekly_source_projection_publications%rowtype;m public.weekly_source_row_resolutions%rowtype;
 resolution_id uuid;matches integer;generation integer;
begin
 select x.* into strict r from public.weekly_source_upload_rows x where x.id=p_row;
 select x.* into strict u from public.weekly_source_uploads x where x.id=r.upload_id;
 select x.* into strict c from public.weekly_source_cycles x where x.id=u.source_cycle_id;
 if u.report_scope_id is not null then
  select x.* into strict s from public.weekly_source_report_scopes x where x.id=u.report_scope_id
   and x.source_cycle_id=c.id and x.source_group_id=c.source_group_id and x.cutoff_at_utc=c.cutoff_at_utc;
 end if;
 select x.* into f from public.weekly_source_final_revisions x where x.id=case when u.report_scope_id is null
  then c.current_final_revision_id else s.current_final_revision_id end and x.source_cycle_id=c.id and x.state='CURRENT'
  and x.report_scope_id is not distinct from u.report_scope_id;
 if (case when u.report_scope_id is null then c.current_final_revision_id else s.current_final_revision_id end) is not null and f.id is null
  or (select count(*) from public.weekly_source_final_revisions x where x.source_cycle_id=c.id and x.report_scope_id is not distinct from u.report_scope_id
    and x.state='CURRENT')>1 then raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
 if f.id is not null then
  if f.upload_id<>u.id or f.finalised_at_utc is null or not isfinite(f.finalised_at_utc)
   or (f.authority_scope_kind='CYCLE' and u.report_scope_id is not null)
   or (f.authority_scope_kind='NHSP_REPORT_SCOPE' and u.report_scope_id is null)
   or f.authority_scope_kind not in('CYCLE','NHSP_REPORT_SCOPE') then
   raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
  select count(*),(array_agg(x.row_resolution_id))[1] into matches,resolution_id
   from private.weekly_source_manual_review_final_rows_v2(f.id) x where x.upload_row_id=r.id;
  if matches>1 then raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
 end if;
 if resolution_id is null then
  -- A selected checking/unfinalised row may coexist with an accepted report
  -- which did not accept this row. Keep that report fact; do not label absence
  -- NO_FINAL or select the maximum resolution generation.
  select x.* into strict p from public.weekly_source_projection_publications x
   where x.id=case when u.report_scope_id is null then c.current_projection_publication_id else s.current_projection_publication_id end
    and x.source_cycle_id=c.id and x.report_scope_id is not distinct from u.report_scope_id and x.upload_id=u.id and x.state='CURRENT';
  if u.state<>'CURRENT' or p.published_at_utc is null or not isfinite(p.published_at_utc)
   or (p.authority_scope_kind='CYCLE' and (u.report_scope_id is not null or c.current_complete_upload_id<>u.id
    or c.version<>p.authority_scope_version or c.projection_state<>'CURRENT'))
   or (p.authority_scope_kind='NHSP_REPORT_SCOPE' and (s.id is null or s.current_complete_upload_id<>u.id
    or s.version<>p.authority_scope_version or s.projection_state<>'CURRENT'))
   or p.authority_scope_kind not in('CYCLE','NHSP_REPORT_SCOPE') then
   raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
  generation:=coalesce(p.projection_generation,p.authority_scope_version::integer);
  select x.* into strict m from public.weekly_source_row_resolutions x where x.upload_row_id=r.id and x.generation=generation;
 else select x.* into strict m from public.weekly_source_row_resolutions x where x.id=resolution_id and x.upload_row_id=r.id;
 end if;
 if m.candidate_id is null or m.client_id is null then
  raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
 if m.work_event_id is not null and not exists(select 1 from public.weekly_work_events e
   where e.id=m.work_event_id and e.candidate_id=m.candidate_id and e.client_id=m.client_id and e.work_date=r.work_date) then
  raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
 if m.contract_id is not null and not exists(select 1 from public.contracts ct
   where ct.id=m.contract_id and ct.candidate_id=m.candidate_id and ct.client_id=m.client_id) then
  raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
 return jsonb_build_object('source_row_id',r.id,'candidate_id',m.candidate_id,'actual_client_id',m.client_id,
  'source_work_event_id',m.work_event_id,'source_resolution_id',m.id,'source_cycle_id',c.id,'source_group_id',c.source_group_id,
  'work_date',r.work_date,'scope_date',c.finalisation_week_ending,'contract_id',m.contract_id,
  'source_phase',case when f.id is null then 'NO_FINAL_REPORT_YET' else 'FINAL' end,
  'source_witness',jsonb_build_object('row',to_jsonb(r),'resolution',to_jsonb(m),'upload_id',u.id,'upload_state',u.state,
   'scope_id',u.report_scope_id,'scope_version',case when s.id is null then c.version else s.version end,
   'projection',case when p.id is null then null else to_jsonb(p) end,'final_revision',case when f.id is null then null else to_jsonb(f) end));
exception when no_data_found or too_many_rows then
 raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_source_subject_v1(uuid) from public,anon,authenticated,service_role;

create or replace function private.weekly_source_pay_decision_selection_identity_v1(p_selection jsonb)
returns jsonb language sql immutable set search_path=pg_catalog as $function$
 select jsonb_build_object('scope_kind',p_selection->'scope_kind','scope_mode',p_selection->'scope_mode',
  'source_row_id',p_selection->'source_row_id','family_root_id',case when p_selection->>'scope_kind'='TIMESHEET_FAMILY' then p_selection->'family_root_id' else 'null'::jsonb end,
  'component_keys',(select coalesce(jsonb_agg(value order by value::text),'[]'::jsonb) from jsonb_array_elements(p_selection->'component_keys')),
  'work_dates',p_selection->'work_dates');
$function$;
revoke all on function private.weekly_source_pay_decision_selection_identity_v1(jsonb) from public,anon,authenticated,service_role;

create or replace function private.weekly_source_pay_decision_resolved_scope_v1(p_browser jsonb,p_actor uuid,p_lock boolean)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public as $function$
declare body jsonb;selection jsonb:='[]';entry jsonb;subject jsonb;resolved jsonb;first_client uuid;root uuid;
 family public.weekly_exceptional_pay_target_families%rowtype;lineage public.weekly_source_row_timesheet_lineages%rowtype;
 primary_scope jsonb;required jsonb:='[]';active record;issues jsonb;issue_ids jsonb;invoice jsonb;
 invoices uuid[];prior jsonb:='[]';old_member record;component text;member_key text;old_decisions uuid[]:='{}';
 candidate uuid;scope_item jsonb;witnesses jsonb:='[]';invoice_witnesses jsonb:='[]';prior_count integer;original_row uuid;selection_identity jsonb;
begin
 body:=private.weekly_source_pay_decision_request_v1(p_browser,'PREVIEW');
 -- Pure discovery first. Do not take a metadata/FK parent lock before all
 -- Candidate gates and real roots have been acquired in their native order.
 for entry in select value from jsonb_array_elements(body->'selection') loop
  subject:=private.weekly_source_pay_decision_source_subject_v1((entry->>'source_row_id')::uuid);
  select count(distinct d.original_source_row_id),(array_agg(distinct d.original_source_row_id))[1] into prior_count,original_row
   from private.bpay_next_worker_pay_disposition_subject_binding binding join private.bpay_next_worker_pay_disposition d on d.id=binding.disposition_id
   where binding.accepted_source_resolution_id=(subject->>'source_resolution_id')::uuid
    and binding.original_source_row_id=d.original_source_row_id and d.candidate_id=(subject->>'candidate_id')::uuid
    and d.actual_client_id=(subject->>'actual_client_id')::uuid;
  if prior_count>1 then raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
  subject:=subject||jsonb_build_object('observed_source_row_id',subject->'source_row_id',
    'source_row_id',coalesce(original_row,(subject->>'source_row_id')::uuid));
  perform private.weekly_source_pay_decision_scope_access_v1(p_actor,(subject->>'source_group_id')::uuid,
   (subject->>'actual_client_id')::uuid,(subject->>'scope_date')::date);
  if first_client is null then first_client:=(subject->>'actual_client_id')::uuid;
  elsif first_client::text is distinct from subject->>'actual_client_id' then
   raise exception 'SOURCE_PAY_DECISION_CROSS_CLIENT_SELECTION' using errcode='22023';end if;
  if (entry->'source_work_event_id' is distinct from subject->'source_work_event_id'
      and not(entry->>'scope_kind'='SOURCE_ROW' and entry->'source_work_event_id'='null'::jsonb))
    or not(entry->'work_dates' @> jsonb_build_array(subject->>'work_date')) then
   raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
  root:=(entry->>'family_root_id')::uuid;
  if root is not null then
   -- Exact accepted lineage/native event membership only; no date/name join
   -- creates a subject association. Direct physical H103 resolves moved roots.
   primary_scope:=private.timesheet_contract_current_placement_v1(root);
   if primary_scope->>'family_root_id' is null then raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
   select l.* into lineage from public.weekly_source_row_timesheet_lineages l
    where l.row_resolution_id=(subject->>'source_resolution_id')::uuid and l.upload_row_id=(subject->>'observed_source_row_id')::uuid
     and l.candidate_id=(subject->>'candidate_id')::uuid and l.client_id=first_client;
   if (select count(*) from public.weekly_exceptional_pay_target_families f where f.root_timesheet_id=(primary_scope->>'family_root_id')::uuid
     and f.candidate_id=(subject->>'candidate_id')::uuid)>1 then raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
   select f.* into family from public.weekly_exceptional_pay_target_families f
    where f.root_timesheet_id=(primary_scope->>'family_root_id')::uuid and f.candidate_id=(subject->>'candidate_id')::uuid;
   if not((lineage.id is not null and (private.timesheet_contract_current_placement_v1(lineage.timesheet_id)->>'family_root_id')
      =primary_scope->>'family_root_id') or (family.id is not null and exists(
      select 1 from public.weekly_exceptional_pay_family_events e where e.family_id=family.id
       and e.durable_work_event_id=(subject->>'source_work_event_id')::uuid))) then
    raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
   root:=(primary_scope->>'family_root_id')::uuid;
  else lineage:=null;family:=null;primary_scope:=null;
  end if;
  selection_identity:=private.weekly_source_pay_decision_selection_identity_v1(entry||subject||jsonb_build_object('family_root_id',root));
  member_key:='source:'||encode(private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_MEMBER_ID_V1',selection_identity),'hex');
  resolved:=entry||subject||jsonb_build_object('member_key',member_key,'family_root_id',root,
   'current_placement',primary_scope,'native_family_id',family.id);
  selection:=selection||jsonb_build_array(resolved);
 end loop;
 if exists(select 1 from jsonb_array_elements(selection) lhs join jsonb_array_elements(selection) rhs
   on lhs.value->>'member_key'<rhs.value->>'member_key' and lhs.value->>'source_row_id'=rhs.value->>'source_row_id'
   where lhs.value->>'scope_mode'='WHOLE_SHIFT' or rhs.value->>'scope_mode'='WHOLE_SHIFT' or exists(
    select 1 from jsonb_array_elements_text(lhs.value->'component_keys') l join jsonb_array_elements_text(rhs.value->'component_keys') r on r.value=l.value)) then
  raise exception 'SOURCE_PAY_DECISION_SELECTION_OVERLAP' using errcode='22023';end if;
 if p_lock then
  perform private.weekly_source_pay_query_admit_v2();
  for candidate in select distinct (x.value->>'candidate_id')::uuid from jsonb_array_elements(selection) x order by 1 loop
   perform private.weekly_source_candidate_serial_gate_v1(candidate,'WORKBENCH_CANDIDATE_ENTITLEMENT_PUBLICATION',
    (body->>'decision_id')::uuid,'SOURCE_PAY_DECISION');
  end loop;
  for scope_item in select distinct jsonb_build_object('root',x.value->'family_root_id','candidate',x.value->'candidate_id')
    from jsonb_array_elements(selection) x where x.value->>'family_root_id' is not null order by 1 loop
   perform private.timesheet_contract_move_family_lock_v1((scope_item->>'root')::uuid);
  end loop;
  -- Fresh exact facts after any native wait, before own metadata locks.
  for scope_item in select value from jsonb_array_elements(selection) loop
   subject:=private.weekly_source_pay_decision_source_subject_v1((scope_item->>'observed_source_row_id')::uuid);
   if scope_item->'source_witness' is distinct from subject->'source_witness' then
    raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
  end loop;
 end if;
 -- Enrich only factual invoice/contact/protection and current aggregate facts.
 -- Native financial quantities/amounts remain the genuine Banking cut's owner.
 resolved:='[]';
 for scope_item in select value from jsonb_array_elements(selection) order by value->>'member_key' loop
  perform private.weekly_source_pay_decision_scope_access_v1(p_actor,(scope_item->>'source_group_id')::uuid,
   first_client,(scope_item->>'scope_date')::date);
  select coalesce(array_agg(distinct l.timesheet_id order by l.timesheet_id),'{}'::uuid[]) into invoices
   from public.weekly_source_row_timesheet_lineages l where l.upload_row_id=any(array[(scope_item->>'source_row_id')::uuid,(scope_item->>'observed_source_row_id')::uuid])
    and l.candidate_id=(scope_item->>'candidate_id')::uuid and l.client_id=first_client;
  invoice:=private.weekly_source_invoice_certificate_v1(invoices,array(select distinct x from unnest(array[(scope_item->>'source_row_id')::uuid,(scope_item->>'observed_source_row_id')::uuid]) x),p_lock);
  select coalesce(jsonb_agg(jsonb_build_object('incident',to_jsonb(i),'comparison',to_jsonb(c)) order by i.id),'[]'::jsonb),
    coalesce(jsonb_agg(i.id order by i.id),'[]'::jsonb) into issues,issue_ids
   from public.weekly_discrepancy_incidents i join public.weekly_issue_comparison_revisions c on c.id=i.current_comparison_revision_id
   where i.candidate_id=(scope_item->>'candidate_id')::uuid and i.client_id=first_client and i.state='OPEN'
    and i.source_cycle_id=(scope_item->>'source_cycle_id')::uuid and c.source_row_id=(scope_item->>'observed_source_row_id')::uuid
    and i.work_event_id=(scope_item->>'source_work_event_id')::uuid
    and (not exists(select 1 from private.weekly_source_pay_decisions accepted_decision where accepted_decision.id=(body->>'decision_id')::uuid and accepted_decision.accept_request_id is not null)
      or exists(select 1 from private.weekly_source_pay_decision_members accepted_member where accepted_member.decision_id=(body->>'decision_id')::uuid
       and accepted_member.member_key=scope_item->>'member_key' and i.id=any(accepted_member.contact_issue_ids)))
    and c.issue_family in('SOURCE_MISSING_OR_NOT_AUTHORISED','SOURCE_HOURS_DIFFER','HEALTHROSTER_NOT_FINALISED')
    and (scope_item->>'scope_mode'='WHOLE_SHIFT' or exists(
     select 1 from private.bpay_next_approved_line line join private.bpay_next_work work on work.current_revision_id=line.revision_id
      join public.contracts contract on contract.id=work.contract_id
     where work.candidate_id=i.candidate_id and contract.client_id=i.client_id and line.component_kind in('WORK','PROTECTED_WORK')
      and line.work_date=(scope_item->>'work_date')::date and scope_item->'component_keys' ? line.component_key
      and (private.timesheet_contract_current_placement_v1(work.original_timesheet_id)->>'family_root_id')=scope_item->>'family_root_id')
     or exists(select 1 from public.weekly_source_entitlement_heads head join public.weekly_source_entitlement_head_components component on component.head_id=head.id
      where head.state='COMMITTED_CURRENT' and component.component_kind='WORKED_TIME'
       and component.component_member_identity=scope_item->>'source_work_event_id'
       and scope_item->'component_keys' ? ('SOURCE:'||component.component_id::text)
       and (private.timesheet_contract_current_placement_v1(head.root_timesheet_id)->>'family_root_id')=scope_item->>'family_root_id'));
  if body->>'decision'='EXCLUDE_FUTURE_WORK_PAY' and scope_item->>'source_work_event_id' is not null then
   for active in select distinct f.id as family_id,t.durable_work_event_id as work_event_id
     from public.weekly_exceptional_pending_reconciliation_targets t
     join public.weekly_exceptional_payment_approvals a on a.id=t.approval_id and a.pay_target_family_id=t.family_id
      and a.work_event_id=t.durable_work_event_id and a.withdrawn_at_utc is null
     join public.weekly_exceptional_pay_target_families f on f.id=t.family_id and f.ownership_state='TARGET_MANAGED'
      and f.candidate_id=(scope_item->>'candidate_id')::uuid and a.client_id=first_client
     where t.state='ACTIVE' and t.durable_work_event_id=(scope_item->>'source_work_event_id')::uuid loop
    if scope_item->>'family_root_id' is not null and not exists(select 1 from public.weekly_exceptional_pay_target_families f
      where f.id=active.family_id and (private.timesheet_contract_current_placement_v1(f.root_timesheet_id)->>'family_root_id')=scope_item->>'family_root_id') then
     raise exception 'SOURCE_PAY_DECISION_PROTECTION_SCOPE_INVALID' using errcode='23514';end if;
    if exists(select 1 from jsonb_array_elements(required) q where q.value->>'member_key'=scope_item->>'member_key') then
     raise exception 'SOURCE_PAY_DECISION_PROTECTION_SCOPE_AMBIGUOUS' using errcode='23514';end if;
    required:=required||jsonb_build_array(jsonb_build_object('member_key',scope_item->'member_key','family_id',active.family_id,'work_event_id',active.work_event_id));
   end loop;
  end if;
  for component in select value from jsonb_array_elements_text(case when jsonb_array_length(scope_item->'component_keys')=0
    then '[null]'::jsonb else scope_item->'component_keys' end) loop
   select count(*) into prior_count from (select distinct p.id,m.member_decision_id,p.current_version
    from private.bpay_next_worker_pay_disposition p join private.bpay_next_worker_pay_disposition_member m
      on m.disposition_id=p.id and m.version_no=p.current_version
    where p.candidate_id=(scope_item->>'candidate_id')::uuid and p.actual_client_id=first_client
     and p.original_source_row_id=(scope_item->>'source_row_id')::uuid and m.component_key is not distinct from component) native_prior;
   if prior_count>1 then raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
   select distinct p.id as disposition_id,m.member_decision_id as decision_id,p.current_version into old_member
    from private.bpay_next_worker_pay_disposition p join private.bpay_next_worker_pay_disposition_member m
      on m.disposition_id=p.id and m.version_no=p.current_version
    where p.candidate_id=(scope_item->>'candidate_id')::uuid and p.actual_client_id=first_client
     and p.original_source_row_id=(scope_item->>'source_row_id')::uuid and m.component_key is not distinct from component;
   if found then old_decisions:=array_append(old_decisions,old_member.decision_id);end if;
   prior:=prior||jsonb_build_array(jsonb_build_object('member_key',scope_item->'member_key','component_key',component,
    'disposition_id',old_member.disposition_id,'decision_id',old_member.decision_id,'disposition_version',old_member.current_version::text));
  end loop;
  resolved:=resolved||jsonb_build_array(scope_item||jsonb_build_object('invoice_certificate',invoice,
   'selected_issue_ids',issue_ids,'issue_witnesses',issues));
  invoice_witnesses:=invoice_witnesses||jsonb_build_array(jsonb_build_object('member_key',scope_item->'member_key','certificate',invoice));
  witnesses:=witnesses||jsonb_build_array(jsonb_build_object('member_key',scope_item->'member_key','issues',issues));
 end loop;
 return jsonb_build_object('version','SOURCE_PAY_DECISION_DRAFT_SCOPE_V1','decision',body->'decision','selection',resolved,
  'selection_sha256',encode(private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_ACCEPTED_SELECTION_V1',
    (select jsonb_agg(private.weekly_source_pay_decision_selection_identity_v1(x.value) order by x.value->>'member_key') from jsonb_array_elements(resolved) x)),'hex'),
  'evidence_refs',body->'evidence_refs','financial_history_refs',body->'financial_history_refs','actual_client_id',first_client,
  'required_quote_members',required,'prior_dispositions',prior,
  'prior_dispositions_sha256',encode(private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_PRIOR_DISPOSITIONS_V1',prior),'hex'),
  'supersedes_decision_id',case when cardinality(array(select distinct x from unnest(old_decisions) x))=1 then old_decisions[1] else null end,
  'source_invoice_witness_sha256',encode(private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_INVOICE_SET_V1',invoice_witnesses),'hex'),
  'issue_witness_sha256',encode(private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_ISSUE_SET_V1',witnesses),'hex'));
exception when no_data_found or too_many_rows then
 raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_resolved_scope_v1(jsonb,uuid,boolean) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/33_genuine_source_subject_and_scope.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/34_atomic_preview_assembly.sqlinc
-- Public metadata protocol. Every native gate/cut call precedes existing
-- metadata row locks. No run, financial row, publication or contact write here.
create or replace function private.weekly_source_pay_decision_assembly_assert_v1(p_assembly uuid,p_actor uuid)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public as $function$
declare a private.weekly_source_pay_decision_preview_assemblies%rowtype;r private.weekly_source_pay_decision_requests%rowtype;
 c private.bpay_next_source_pay_decision_cut%rowtype;scope jsonb;quotes jsonb;required jsonb;actual jsonb;q record;
begin
 select x.* into strict a from private.weekly_source_pay_decision_preview_assemblies x where x.id=p_assembly and x.actor_user_id=p_actor;
 select x.* into strict r from private.weekly_source_pay_decision_requests x where x.request_id=a.preview_request_id
  and x.decision_id=a.decision_id and x.actor_user_id=p_actor and x.request_kind='PREVIEW' and x.request_hash=a.preview_request_hash;
 if a.state not in('ASSEMBLING','READY') then raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
 if a.expires_at_utc<=transaction_timestamp() then raise exception 'SOURCE_PAY_DECISION_PREVIEW_EXPIRED' using errcode='55000';end if;
 scope:=private.weekly_source_pay_decision_resolved_scope_v1(r.request_json,p_actor,true);
 if scope is distinct from a.draft_scope_json-array['cut_id','cut_no','pay_cut_hash'] then
  raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
 perform private.bpay_next_source_pay_decision_cut_v1(a.decision_id,a.id,null,true);
 select x.* into strict c from private.bpay_next_source_pay_decision_cut x where x.id=(a.draft_scope_json->>'cut_id')::uuid
  and x.decision_id=a.decision_id and x.preview_assembly_id=a.id and x.review_id is null
  and x.cut_no::text=a.draft_scope_json->>'cut_no' and encode(x.pay_cut_sha256,'hex')=a.draft_scope_json->>'pay_cut_hash';
 if a.draft_scope_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_DRAFT_SCOPE_V1',a.draft_scope_json)
  or exists(select 1 from private.bpay_next_source_pay_decision_cut_member cm where cm.cut_id=c.id
   and not exists(select 1 from jsonb_array_elements(scope->'selection') s where s.value->>'member_key'=cm.member_key
    and (s.value->>'candidate_id')::uuid=cm.candidate_id and (s.value->>'actual_client_id')::uuid=cm.actual_client_id
    and (s.value->>'source_row_id')::uuid=cm.original_source_row_id and (s.value->>'family_root_id')::uuid is not distinct from cm.family_root_id
    and (s.value->>'source_work_event_id')::uuid is not distinct from cm.source_work_event_id
    and s.value->>'scope_kind'=cm.scope_kind and s.value->>'scope_mode'=cm.scope_mode))
  or exists(select 1 from jsonb_array_elements(scope->'selection') s where not exists(
    select 1 from private.bpay_next_source_pay_decision_cut_member cm where cm.cut_id=c.id and cm.member_key=s.value->>'member_key')) then
  raise exception 'SOURCE_PAY_DECISION_CUT_SCOPE_INVALID' using errcode='23514';end if;
 select coalesce(jsonb_agg(jsonb_build_object('member_key',q.member_key,'quote_id',q.id,
   'quote_sha256',encode(q.quote_sha256,'hex'),'economic_target_sha256',encode(q.economic_target_sha256,'hex'))
   order by q.member_key),'[]'::jsonb) into quotes from private.weekly_source_pay_decision_preview_quotes q where q.assembly_id=a.id;
 if exists(select 1 from private.weekly_source_pay_decision_preview_quotes q where q.assembly_id=a.id
  and (q.quote_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_PREVIEW_QUOTE_V1',q.quote_json)
   or q.economic_target_sha256 is distinct from private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_ECONOMIC_TARGET_V1',q.quote_json->'economic_target')
   or not exists(select 1 from jsonb_array_elements(scope->'required_quote_members') req
     where req.value->>'member_key'=q.member_key and req.value->>'family_id'=q.quote_json#>>'{economic_target,family_id}'
      and req.value->>'work_event_id'=q.quote_json#>>'{economic_target,work_event_id}'))) then
  raise exception 'SOURCE_PAY_DECISION_QUOTE_MANIFEST_INVALID' using errcode='23514';end if;
 for q in select x.* from private.weekly_source_pay_decision_preview_quotes x where x.assembly_id=a.id order by x.member_key loop
  actual:=public.weekly_source_pay_decision_unprotect_review_context_v1(jsonb_build_object(
   'version','SOURCE_UNPROTECT_REVIEW_CONTEXT_V1','assembly_id',a.id,'decision_id',a.decision_id,'member_key',q.member_key,'actor_user_id',p_actor));
  if actual->>'context_sha256' is distinct from q.quote_json->>'context_sha256'
    or actual->>'source_observation_sha256' is distinct from q.quote_json->>'source_observation_sha256' then
   raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
 end loop;
 return jsonb_build_object('version','SOURCE_PAY_DECISION_ASSEMBLY_MANIFEST_V1','decision_id',a.decision_id,
  'assembly_id',a.id,'preview_request_id',a.preview_request_id,'preview_request_hash',encode(a.preview_request_hash,'hex'),
  'draft_scope_sha256',encode(a.draft_scope_sha256,'hex'),'draft_scope',a.draft_scope_json,
  'cut_id',c.id,'cut_no',c.cut_no::text,'pay_cut_hash',encode(c.pay_cut_sha256,'hex'),'quote_manifest',quotes);
exception when no_data_found or too_many_rows then raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_assembly_assert_v1(uuid,uuid) from public,anon,authenticated,service_role;

create or replace function public.weekly_source_pay_decision_preview_begin_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public set lock_timeout='2500ms' as $function$
declare actor uuid;body jsonb;fingerprint bytea;scope jsonb;d private.weekly_source_pay_decisions%rowtype;
 r private.weekly_source_pay_decision_requests%rowtype;a private.weekly_source_pay_decision_preview_assemblies%rowtype;
 c private.bpay_next_source_pay_decision_cut%rowtype;uniform_candidate uuid;manifest jsonb;
begin
 if coalesce(current_setting('request.jwt.claim.role',true),nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['version','actor_user_id','browser_request'])
  or not(p_request ?& array['version','actor_user_id','browser_request']) or p_request->>'version' is distinct from 'SOURCE_PAY_DECISION_PREVIEW_BEGIN_V1' then
  raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;body:=private.weekly_source_pay_decision_request_v1(p_request->'browser_request','PREVIEW');
 fingerprint:=private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_PREVIEW_REQUEST_V1',body);
 if actor is null or not private.weekly_source_pay_actor_allowed_v1(actor) then raise exception 'SOURCE_PAY_DECISION_ACTOR_REQUIRED' using errcode='42501';end if;
 select x.* into r from private.weekly_source_pay_decision_requests x where x.request_id=(body->>'request_id')::uuid;
 if found then
  if r.decision_id is distinct from (body->>'decision_id')::uuid or r.actor_user_id<>actor or r.request_kind<>'PREVIEW'
    or r.request_hash<>fingerprint or r.request_json<>body then raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';end if;
  select x.* into strict a from private.weekly_source_pay_decision_preview_assemblies x where x.preview_request_id=r.request_id;
  -- Exact sealed replay checks current access but never revalues later facts.
  if a.state='SEALED' then
   for scope in select value from jsonb_array_elements(a.draft_scope_json->'selection') loop
    perform private.weekly_source_pay_decision_scope_access_v1(actor,(scope->>'source_group_id')::uuid,
     (scope->>'actual_client_id')::uuid,(scope->>'scope_date')::date);
   end loop;
  else
   if a.state='CANCELLED' then raise exception 'SOURCE_PAY_DECISION_PREVIEW_CANCELLED' using errcode='55000';
   elsif a.state='STALE' then raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';
   elsif a.state='EXPIRED' or a.expires_at_utc<=transaction_timestamp() then raise exception 'SOURCE_PAY_DECISION_PREVIEW_EXPIRED' using errcode='55000';end if;
   manifest:=private.weekly_source_pay_decision_assembly_assert_v1(a.id,actor);
  end if;
 else
  scope:=private.weekly_source_pay_decision_resolved_scope_v1(body,actor,true);
  select x.* into d from private.weekly_source_pay_decisions x where x.id=(body->>'decision_id')::uuid;
  if found then
   if d.actual_client_id is distinct from (scope->>'actual_client_id')::uuid
    or (d.accept_request_id is not null and (d.decision_kind is distinct from body->>'decision'
      or encode(d.accepted_selection_sha256,'hex') is distinct from scope->>'selection_sha256')) then
    raise exception 'SOURCE_PAY_DECISION_ACCEPTED_SELECTION_IMMUTABLE' using errcode='40001';end if;
  else
   select case when count(distinct x.value->>'candidate_id')=1 then (array_agg((x.value->>'candidate_id')::uuid))[1] end into uniform_candidate
    from jsonb_array_elements(scope->'selection') x;
   insert into private.weekly_source_pay_decisions(id,candidate_id,actual_client_id,created_by_user_id)
    values((body->>'decision_id')::uuid,uniform_candidate,(scope->>'actual_client_id')::uuid,actor) returning * into d;
  end if;
  insert into private.weekly_source_pay_decision_requests(request_id,decision_id,request_kind,request_hash,request_json,actor_user_id,metadata_state)
   values((body->>'request_id')::uuid,d.id,'PREVIEW',fingerprint,body,actor,'ASSEMBLING') returning * into r;
  insert into private.weekly_source_pay_decision_preview_assemblies(id,decision_id,preview_request_id,preview_request_hash,
   actor_user_id,decision_kind,state,draft_scope_json,draft_scope_sha256,expires_at_utc)
   values(gen_random_uuid(),d.id,r.request_id,fingerprint,actor,body->>'decision','ASSEMBLING',scope,
    private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_DRAFT_SCOPE_V1',scope),transaction_timestamp()+interval '15 minutes') returning * into a;
  perform private.bpay_next_source_pay_decision_cut_v1(d.id,a.id,null,true);
  select x.* into strict c from private.bpay_next_source_pay_decision_cut x where x.decision_id=d.id and x.preview_assembly_id=a.id and x.review_id is null;
  scope:=scope||jsonb_build_object('cut_id',c.id,'cut_no',c.cut_no::text,'pay_cut_hash',encode(c.pay_cut_sha256,'hex'));
  update private.weekly_source_pay_decision_preview_assemblies x set draft_scope_json=scope,
   draft_scope_sha256=private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_DRAFT_SCOPE_V1',scope)
   where x.id=a.id and x.state='ASSEMBLING' and not(x.draft_scope_json ? 'cut_id') returning * into strict a;
  manifest:=private.weekly_source_pay_decision_assembly_assert_v1(a.id,actor);
 end if;
 select x.* into strict c from private.bpay_next_source_pay_decision_cut x where x.id=(a.draft_scope_json->>'cut_id')::uuid
  and x.preview_assembly_id=a.id and x.decision_id=a.decision_id;
 return jsonb_build_object('version','SOURCE_PAY_DECISION_PREVIEW_BEGIN_RESULT_V1','decision_id',a.decision_id,
  'request_id',a.preview_request_id,'assembly_id',a.id,'assembly_state',a.state,'cut_id',c.id,'cut_no',c.cut_no::text,
  'expected_pay_cut_hash',encode(c.pay_cut_sha256,'hex'),'draft_scope_sha256',encode(a.draft_scope_sha256,'hex'),
  'expires_at_utc',a.expires_at_utc,'required_quote_members',a.draft_scope_json->'required_quote_members',
  'sealed_review',case when a.state='SEALED' then r.receipt_json else null end);
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'SOURCE_PAY_DECISION_PREVIEW_INVALID' using errcode='22023';
end;
$function$;
revoke all on function public.weekly_source_pay_decision_preview_begin_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_preview_begin_v1(jsonb) to service_role;

create or replace function public.weekly_source_pay_decision_preview_ready_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public set lock_timeout='2500ms' as $function$
declare actor uuid;a private.weekly_source_pay_decision_preview_assemblies%rowtype;manifest jsonb;hash bytea;
begin
 if coalesce(current_setting('request.jwt.claim.role',true),nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['version','assembly_id','actor_user_id','expected_draft_scope_sha256'])
  or not(p_request ?& array['version','assembly_id','actor_user_id','expected_draft_scope_sha256'])
  or p_request->>'version' is distinct from 'SOURCE_PAY_DECISION_PREVIEW_READY_V1' then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;
 manifest:=private.weekly_source_pay_decision_assembly_assert_v1((p_request->>'assembly_id')::uuid,actor);
 select x.* into strict a from private.weekly_source_pay_decision_preview_assemblies x where x.id=(p_request->>'assembly_id')::uuid and x.actor_user_id=actor for update;
 if encode(a.draft_scope_sha256,'hex') is distinct from p_request->>'expected_draft_scope_sha256'
   or (select coalesce(jsonb_agg(x.value->>'member_key' order by x.value->>'member_key'),'[]'::jsonb)
     from jsonb_array_elements(a.draft_scope_json->'required_quote_members') x)
    is distinct from (select coalesce(jsonb_agg(q.member_key order by q.member_key),'[]'::jsonb)
     from private.weekly_source_pay_decision_preview_quotes q where q.assembly_id=a.id) then
  raise exception 'SOURCE_PAY_DECISION_QUOTE_MANIFEST_INCOMPLETE' using errcode='40001';end if;
 hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_ASSEMBLY_MANIFEST_V1',manifest);
 if a.state='READY' then
  if a.assembly_sha256 is distinct from hash then raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
 else
  update private.weekly_source_pay_decision_preview_assemblies x set state='READY',assembly_sha256=hash where x.id=a.id and x.state='ASSEMBLING';
  if not found then raise exception 'SOURCE_PAY_DECISION_ASSEMBLY_CAS_FAILED' using errcode='40001';end if;
 end if;
 return jsonb_build_object('version','SOURCE_PAY_DECISION_PREVIEW_READY_RESULT_V1','assembly_id',a.id,'assembly_sha256',encode(hash,'hex'));
end;
$function$;
revoke all on function public.weekly_source_pay_decision_preview_ready_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_preview_ready_v1(jsonb) to service_role;

create or replace function public.weekly_source_pay_decision_preview_abandon_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public set lock_timeout='2500ms' as $function$
declare actor uuid;a private.weekly_source_pay_decision_preview_assemblies%rowtype;s jsonb;
begin
 if coalesce(current_setting('request.jwt.claim.role',true),nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['version','assembly_id','actor_user_id'])
  or not(p_request ?& array['version','assembly_id','actor_user_id'])
  or p_request->>'version' is distinct from 'SOURCE_PAY_DECISION_PREVIEW_ABANDON_V1' then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;
 select x.* into strict a from private.weekly_source_pay_decision_preview_assemblies x where x.id=(p_request->>'assembly_id')::uuid and x.actor_user_id=actor;
 for s in select value from jsonb_array_elements(a.draft_scope_json->'selection') loop
  perform private.weekly_source_pay_decision_scope_access_v1(actor,(s->>'source_group_id')::uuid,(s->>'actual_client_id')::uuid,(s->>'scope_date')::date);
 end loop;
 if a.state<>'SEALED' then
  -- Metadata-only cancellation takes no native mutation path. Parent lock
  -- serializes against atomic READY/seal; preserve any already-sealed review.
  select x.* into strict a from private.weekly_source_pay_decision_preview_assemblies x where x.id=a.id for update;
  if a.state in('ASSEMBLING','READY') then
   update private.weekly_source_pay_decision_preview_assemblies x set state='CANCELLED' where x.id=a.id and x.state in('ASSEMBLING','READY') returning * into strict a;
   update private.weekly_source_pay_decision_requests x set metadata_state='CANCELLED'
    where x.request_id=a.preview_request_id and x.metadata_state='ASSEMBLING';
  elsif a.state='EXPIRED' then raise exception 'SOURCE_PAY_DECISION_PREVIEW_EXPIRED' using errcode='55000';
  elsif a.state='STALE' then raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
 end if;
 return jsonb_build_object('version','SOURCE_PAY_DECISION_PREVIEW_ABANDON_RESULT_V1','assembly_id',a.id,'state',a.state);
end;
$function$;
revoke all on function public.weekly_source_pay_decision_preview_abandon_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_preview_abandon_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/34_atomic_preview_assembly.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/35_native_preview_quote_registration.sqlinc
create or replace function public.weekly_source_pay_decision_preview_quote_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public set lock_timeout='2500ms' as $function$
declare actor uuid;a private.weekly_source_pay_decision_preview_assemblies%rowtype;q private.weekly_source_pay_decision_preview_quotes%rowtype;
 quote jsonb;economic jsonb;operands jsonb;facts jsonb;manifest jsonb;quote_hash bytea;economic_hash bytea;context_hash bytea;policy_hash bytea;target jsonb;component jsonb;keys text[];
begin
 if coalesce(current_setting('request.jwt.claim.role',true),nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['version','assembly_id','actor_user_id','quote'])
  or not(p_request ?& array['version','assembly_id','actor_user_id','quote'])
  or p_request->>'version' is distinct from 'SOURCE_PAY_DECISION_PREVIEW_QUOTE_V1' then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;quote:=p_request->'quote';economic:=quote->'economic_target';
 keys:=array['member_key','context_sha256','source_observation_sha256','calculation_owner','calculation_policy_sha256','economic_target','economic_target_sha256'];
 if not private.weekly_exceptional_json_keys_exact_v1(quote,keys) or not(quote ?& keys)
  or quote->>'calculation_owner' is distinct from 'buildWeeklyScheduleSegmentsSnapshot' or char_length(coalesce(quote->>'member_key','')) not between 1 and 512
  or exists(select 1 from unnest(array['context_sha256','source_observation_sha256','calculation_policy_sha256','economic_target_sha256']) k
    where coalesce(quote->>k,'') !~ '^[0-9a-f]{64}$') then raise exception 'SOURCE_PAY_DECISION_QUOTE_INVALID' using errcode='22023';end if;
 quote_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_PREVIEW_QUOTE_V1',quote);
 economic_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_ECONOMIC_TARGET_V1',economic);
 if encode(economic_hash,'hex') is distinct from quote->>'economic_target_sha256' then raise exception 'SOURCE_PAY_DECISION_QUOTE_INVALID' using errcode='22023';end if;
 select x.* into strict a from private.weekly_source_pay_decision_preview_assemblies x where x.id=(p_request->>'assembly_id')::uuid and x.actor_user_id=actor;
 -- Exact live quote replay retains bytes. Current authority still applies.
 manifest:=private.weekly_source_pay_decision_assembly_assert_v1(a.id,actor);
 select x.* into q from private.weekly_source_pay_decision_preview_quotes x where x.assembly_id=a.id and x.member_key=quote->>'member_key';
 if found then
  if q.quote_json is distinct from quote or q.quote_sha256 is distinct from quote_hash or q.economic_target_sha256 is distinct from economic_hash then
   raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';end if;
 else
  if a.state<>'ASSEMBLING' or not exists(select 1 from jsonb_array_elements(a.draft_scope_json->'required_quote_members') required
    where required.value->>'member_key'=quote->>'member_key') then raise exception 'SOURCE_PAY_DECISION_QUOTE_INVALID' using errcode='22023';end if;
  operands:=public.weekly_source_pay_decision_preview_quote_context_v1(jsonb_build_object(
   'version','SOURCE_PAY_DECISION_PREVIEW_QUOTE_CONTEXT_V1','assembly_id',a.id,'decision_id',a.decision_id,
   'member_key',quote->'member_key','actor_user_id',actor));
  facts:=operands#>'{review_context,context}';
  keys:=array['version','family_id','root_timesheet_id','work_event_id','accepted_placement_sha256','actual_schedule_json',
   'tsfin_snapshot_json','component_economics','quantity_partition','provider','policy_sha256','source_observation_sha256',
   'approval_evidence_sha256','prior_commitment_cut_sha256'];
  if not private.weekly_exceptional_json_keys_exact_v1(economic,keys) or not(economic ?& keys)
   or economic->>'version' is distinct from 'SOURCE_UNPROTECT_ECONOMIC_TARGET_V1'
   or quote->>'context_sha256' is distinct from operands#>>'{review_context,context_sha256}'
   or quote->>'source_observation_sha256' is distinct from operands#>>'{review_context,source_observation_sha256}'
   or economic->'source_observation_sha256' is distinct from quote->'source_observation_sha256'
   or economic->'policy_sha256' is distinct from quote->'calculation_policy_sha256'
   or economic->'quantity_partition' is distinct from operands->'quantity_partition'
   or economic->'prior_commitment_cut_sha256' is distinct from operands->'prior_commitment_cut_sha256'
   or economic->'provider' is distinct from facts->'provider' or economic->'family_id' is distinct from facts->'family_id'
   or economic->'root_timesheet_id' is distinct from facts->'root_timesheet_id' or economic->'work_event_id' is distinct from facts->'work_event_id'
   or economic->'accepted_placement_sha256' is distinct from case when facts#>'{protected_current_placement,moved}'='true'::jsonb
      then facts#>'{protected_current_placement,placement_certificate_sha256}' else 'null'::jsonb end
   or economic->'approval_evidence_sha256' is distinct from facts#>'{protected_current_placement,immutable_original_evidence_sha256}'
   or jsonb_typeof(economic->'actual_schedule_json') is distinct from 'array'
   or jsonb_typeof(economic->'component_economics') is distinct from 'array'
   or jsonb_typeof(economic->'tsfin_snapshot_json') is distinct from 'object'
   or economic#>'{tsfin_snapshot_json,timesheet_id}' is distinct from facts#>'{current_entitlement,timesheet,timesheet_id}'
   or economic#>'{tsfin_snapshot_json,timesheet_version}' is distinct from facts#>'{current_entitlement,timesheet,version}'
   or economic#>'{tsfin_snapshot_json,candidate_id}' is distinct from facts->'candidate_id'
   or economic#>'{tsfin_snapshot_json,client_id}' is distinct from facts->'client_id'
   or economic#>>'{tsfin_snapshot_json,invoice_breakdown_json,mode}' is distinct from 'SEGMENTS'
   or jsonb_typeof(economic#>'{tsfin_snapshot_json,invoice_breakdown_json,segments}') is distinct from 'array'
   or octet_length(convert_to(quote::text,'UTF8'))>2097152 then
   raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
  perform private.weekly_source_pay_decision_native_snapshot_assert_v1(economic->'tsfin_snapshot_json',facts);
  context_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_NATIVE_CONTEXT_V1',facts);
  policy_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_UNPROTECT_CALCULATION_POLICY_V1',
    jsonb_build_object('context_sha256',encode(context_hash,'hex')));
  if quote->>'context_sha256' is distinct from encode(context_hash,'hex')
   or quote->>'calculation_policy_sha256' is distinct from encode(policy_hash,'hex')
   or economic->>'policy_sha256' is distinct from encode(policy_hash,'hex') then
   raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
  -- Existing pure native manifest validates complete source/protection schedule
  -- and actual calculator segment identity, with current B financial target.
  target:=jsonb_build_object('schema_version','WEEKLY_PROTECTED_TARGET_SNAPSHOT_V1',
    'actual_schedule_json',economic->'actual_schedule_json','tsfin_snapshot_json',economic->'tsfin_snapshot_json');
  perform private.weekly_source_protected_component_manifest_v1(
   private.weekly_source_protected_entitlement_projection_v1(facts||jsonb_build_object('ok',true,'contract','WEEKLY_PROTECTED_ACTION_CONTEXT_V1')),target);
  -- Provider/quantity/native snapshot are retained in full. No SQL substitute
  -- calculator or generated preview component identities are constructed.
  select x.* into strict a from private.weekly_source_pay_decision_preview_assemblies x where x.id=a.id and x.actor_user_id=actor for update;
  if a.state<>'ASSEMBLING' then raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
  insert into private.weekly_source_pay_decision_preview_quotes(id,assembly_id,member_key,quote_json,quote_sha256,economic_target_sha256)
   values(gen_random_uuid(),a.id,quote->>'member_key',quote,quote_hash,economic_hash) returning * into q;
 end if;
 return jsonb_build_object('version','SOURCE_PAY_DECISION_PREVIEW_QUOTE_RESULT_V1','assembly_id',a.id,
  'member_key',q.member_key,'quote_id',q.id,'quote_sha256',encode(q.quote_sha256,'hex'),'economic_target_sha256',encode(q.economic_target_sha256,'hex'));
exception when no_data_found or too_many_rows or invalid_text_representation then raise exception 'SOURCE_PAY_DECISION_QUOTE_INVALID' using errcode='22023';
end;
$function$;
revoke all on function public.weekly_source_pay_decision_preview_quote_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_preview_quote_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/35_native_preview_quote_registration.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/36_exact_source_review_and_seal.sqlinc
-- Source public projections read native typed cut columns, never revalue cash.
create or replace function private.weekly_source_pay_decision_quantity_union_v1(p_values jsonb,p_mode text)
returns jsonb language plpgsql immutable security definer set search_path=pg_catalog,private,public as $function$
declare q jsonb;s jsonb;slices jsonb:='[]';state text;keys text[];
begin
 if jsonb_typeof(p_values)<>'array' or jsonb_array_length(p_values)=0 then raise exception 'SOURCE_PAY_DECISION_QUANTITY_INVALID' using errcode='23514';end if;
 for q in select value from jsonb_array_elements(p_values) loop
  keys:=array['version','mode','quantity_state','slices'];
  if not private.weekly_exceptional_json_keys_exact_v1(q,keys) or not(q ?& keys) or q->>'version' is distinct from 'PAY_DISPOSITION_QUANTITY_V1'
   or q->>'mode' is distinct from p_mode or coalesce(q->>'quantity_state','') not in('PRE_FINANCIAL','QUALIFIED')
   or jsonb_typeof(q->'slices') is distinct from 'array' then raise exception 'SOURCE_PAY_DECISION_QUANTITY_INVALID' using errcode='23514';end if;
  if state is null then state:=q->>'quantity_state';elsif state is distinct from q->>'quantity_state' then
   raise exception 'SOURCE_PAY_DECISION_QUANTITY_INVALID' using errcode='23514';end if;
  if state='PRE_FINANCIAL' and (p_mode<>'WHOLE_SHIFT' or jsonb_array_length(q->'slices')<>0) then
   raise exception 'SOURCE_PAY_DECISION_QUANTITY_INVALID' using errcode='23514';end if;
  for s in select value from jsonb_array_elements(q->'slices') loop
   keys:=array['approved_line_id','component_key','segment_id','segment_key','work_date','unit_label','bucket','additional_code','quantity'];
   if not private.weekly_exceptional_json_keys_exact_v1(s,keys) or not(s ?& keys) or (s->>'approved_line_id')::uuid is null
    or char_length(coalesce(s->>'component_key','')) not between 1 and 512 or char_length(coalesce(s->>'unit_label','')) not between 1 and 200
    or (s->'bucket'<>'null'::jsonb and s->>'bucket' not in('DAY','NIGHT','SAT','SUN','BH'))
    or jsonb_typeof(s->'quantity') is distinct from 'string' or coalesce(s->>'quantity','') !~ '^-?(0|[1-9][0-9]*)([.][0-9]+)?$'
    or to_char((s->>'work_date')::date,'YYYY-MM-DD') is distinct from s->>'work_date' then
    raise exception 'SOURCE_PAY_DECISION_QUANTITY_INVALID' using errcode='23514';end if;
   perform (s->>'segment_id')::uuid;
   slices:=slices||jsonb_build_array(s);
  end loop;
 end loop;
 select coalesce(jsonb_agg(x.value order by x.value::text),'[]'::jsonb) into slices from (select distinct value from jsonb_array_elements(slices)) x;
 return jsonb_build_object('version','PAY_DISPOSITION_QUANTITY_V1','mode',p_mode,'quantity_state',state,'slices',slices);
end;
$function$;
revoke all on function private.weekly_source_pay_decision_quantity_union_v1(jsonb,text) from public,anon,authenticated,service_role;

create or replace function private.weekly_source_pay_decision_public_actions_v1(p_decision uuid,p_member jsonb,p_cut uuid)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,private,public as $function$
declare cm record;result jsonb:='[]';action jsonb;caption text;route text;cycle public.weekly_source_cycles%rowtype;
begin
 for cm in select distinct m.next_action,m.next_target_kind,m.next_target_id from private.bpay_next_source_pay_decision_cut_member m
   where m.cut_id=p_cut and m.member_key=p_member->>'member_key' and m.next_action is not null order by 1,2,3 loop
  caption:=case cm.next_action when 'OPEN_TIMESHEET' then 'Open Timesheet' when 'OPEN_DRAFT' then 'Open Draft'
    when 'CHECK_PAYMENT_RESULT' then 'Open payment' when 'REVIEW_EARLIER_PAYMENT' then 'Review earlier payment'
    when 'REVIEW_RECOVERY' then 'Review recovery' when 'REVIEW_RATES' then 'Review rates' when 'WAIT_FOR_FINAL_REPORT' then 'Open Imports'
    when 'OPEN_SOURCE_REVIEW' then 'Review shift' else null end;
  if caption is null then raise exception 'SOURCE_PAY_DECISION_ACTION_PRODUCER_INVALID' using errcode='23514';end if;
  if cm.next_action='WAIT_FOR_FINAL_REPORT' then
   select c.* into strict cycle from public.weekly_source_cycles c where c.id=(p_member->>'source_cycle_id')::uuid;
   if cm.next_target_kind<>'SOURCE_REPORT_PERIOD' or cm.next_target_id is not null then raise exception 'SOURCE_PAY_DECISION_ACTION_PRODUCER_INVALID' using errcode='23514';end if;
   action:=jsonb_build_object('kind',cm.next_action,'target_type','SOURCE_REPORT_PERIOD','target_id',null,'caption',caption,
    'url','/api/weekly-source/v1/workspace',
    'enabled',true,'disabled_reason',null,'client_id',p_member->'actual_client_id',
    'period_start',cycle.finalisation_week_ending-6,'period_end',cycle.finalisation_week_ending);
  else
   -- These are existing authorised read/command resources, not guessed GET
   -- /runs/:id or /transfers/:id endpoints. Office resolves each closed named
   -- native target through its existing modal; it never navigates arbitrary URL.
   route:=case when cm.next_action in('OPEN_TIMESHEET','REVIEW_RATES') and cm.next_target_kind='TIMESHEET'
      then '/api/weekly-source/v1/timesheets/'||cm.next_target_id::text||'/presentation'
     when cm.next_action='OPEN_DRAFT' and cm.next_target_kind='BANKING_RUN' then '/api/banking/pay/next/history-page'
     when cm.next_action='CHECK_PAYMENT_RESULT' and cm.next_target_kind='NATIVE_TRANSFER' then '/api/banking/pay/next/history-page'
     when cm.next_action='REVIEW_EARLIER_PAYMENT' and cm.next_target_kind='SOURCE_PAY_DECISION_HISTORY' then '/api/banking/pay/next/history-page'
     when cm.next_action='REVIEW_RECOVERY' and cm.next_target_kind='FINANCE_CASE' then '/api/banking/pay/next/history-page'
     when cm.next_action='OPEN_SOURCE_REVIEW' and cm.next_target_kind='SOURCE_ROW' then '/api/weekly-source/v1/commands' else null end;
   if route is null or cm.next_target_id is null then raise exception 'SOURCE_PAY_DECISION_ACTION_PRODUCER_INVALID' using errcode='23514';end if;
   action:=jsonb_build_object('kind',cm.next_action,'target_type',cm.next_target_kind,'target_id',cm.next_target_id,'caption',caption,
    'url',route,'enabled',true,'disabled_reason',null);
  end if;
  result:=result||jsonb_build_array(action);
 end loop;
 return result;
end;
$function$;
revoke all on function private.weekly_source_pay_decision_public_actions_v1(uuid,jsonb,uuid) from public,anon,authenticated,service_role;

create or replace function private.weekly_source_pay_decision_review_projection_v1(p_review uuid)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,private,public as $function$
declare r private.weekly_source_pay_decision_reviews%rowtype;a private.weekly_source_pay_decision_preview_assemblies%rowtype;
 d private.weekly_source_pay_decisions%rowtype;c private.bpay_next_source_pay_decision_cut%rowtype;
 m jsonb;members jsonb:='[]';actions jsonb;retained jsonb;support jsonb;exclude jsonb;branch text;qualification text;
begin
 select x.* into strict r from private.weekly_source_pay_decision_reviews x where x.id=p_review;
 select x.* into strict a from private.weekly_source_pay_decision_preview_assemblies x where x.id=r.preview_assembly_id and x.decision_id=r.decision_id;
 select x.* into strict d from private.weekly_source_pay_decisions x where x.id=r.decision_id;
 select x.* into strict c from private.bpay_next_source_pay_decision_cut x where x.decision_id=r.decision_id and x.preview_assembly_id=a.id
  and x.id=(a.draft_scope_json->>'cut_id')::uuid and x.review_id=r.id and x.pay_cut_sha256=r.pay_cut_hash;
 for m in select value from jsonb_array_elements(r.private_manifest_json->'selection') order by value->>'member_key' loop
  select private.weekly_source_pay_decision_quantity_union_v1(jsonb_agg(cm.supported_quantity_json order by cm.member_no),m->>'scope_mode'),
   private.weekly_source_pay_decision_quantity_union_v1(jsonb_agg(cm.excluded_quantity_json order by cm.member_no),m->>'scope_mode'),
   case when bool_or(cm.branch='RETAINED_FINANCIAL') then 'RETAINED_FINANCIAL' when bool_or(cm.branch='SIGNED_FINANCIAL') then 'SIGNED_FINANCIAL' else 'FUTURE_UNSIGNED' end,
   case when bool_or(cm.qualification_state='REVIEW_REQUIRED') then 'REVIEW_REQUIRED' when bool_or(cm.qualification_state='QUALIFIED') then 'QUALIFIED' else 'NOT_APPROVED' end
   into support,exclude,branch,qualification from private.bpay_next_source_pay_decision_cut_member cm where cm.cut_id=c.id and cm.member_key=m->>'member_key';
  select coalesce(jsonb_agg(jsonb_build_object('cut_id',f.cut_id,'member_no',f.member_no::text,'artifact_kind',f.artifact_kind,'artifact_id',f.artifact_id,
   'effect_id',f.effect_id,'work_hold_id',f.work_hold_id,'recovery_hold_id',f.recovery_hold_id,'case_event_id',f.case_event_id,
   'run_line_id',f.run_line_id,'transfer_id',f.transfer_id,'outcome_id',f.outcome_id,'original_work_id',f.original_work_id,
   'original_component_key',f.original_component_key,'original_run_line_id',f.original_run_line_id,'native_status',f.native_status,
   'source_amount',f.source_amount::text,'target_ex',f.target_ex::text,'target_vat',f.target_vat::text,'target_inc',f.target_inc::text,
   'artifact_digest',encode(f.artifact_digest,'hex')) order by f.member_no,f.artifact_kind,f.artifact_id),'[]'::jsonb) into retained
   from private.bpay_next_source_pay_decision_artifact f join private.bpay_next_source_pay_decision_cut_member cm
    on cm.cut_id=f.cut_id and cm.member_no=f.member_no where cm.cut_id=c.id and cm.member_key=m->>'member_key';
  actions:=private.weekly_source_pay_decision_public_actions_v1(d.id,m,c.id);
  members:=members||jsonb_build_array(jsonb_build_object('member_key',m->'member_key','scope_kind',m->'scope_kind','scope_mode',m->'scope_mode',
   'family_root_id',m->'family_root_id','candidate_id',m->'candidate_id','actual_client_id',m->'actual_client_id',
   'source_row_id',m->'source_row_id','source_work_event_id',m->'source_work_event_id','component_keys',m->'component_keys','work_dates',m->'work_dates',
   'expected_work_revision',m->'expected_work_revision','branch',branch,'qualification',qualification,'supported_quantities',support,
   'excluded_quantities',exclude,'retained_commitments',retained,'invoice_certificate',m->'invoice_certificate','selected_issue_ids',m->'selected_issue_ids','next_actions',actions));
 end loop;
 return jsonb_build_object('version','SOURCE_PAY_DECISION_REVIEW_V1','decision_id',d.id,'request_id',r.preview_request_id,'review_id',r.id,
  'review_digest',encode(r.review_digest,'hex'),'state_revision',(r.private_manifest_json->>'state_revision'),
  'expected_pay_cut_hash',encode(r.pay_cut_hash,'hex'),'expected_source_invoice_hash',encode(r.source_invoice_hash,'hex'),
  'expected_issue_set_hash',encode(r.issue_set_hash,'hex'),'decision',a.decision_kind,'supersedes_decision_id',r.private_manifest_json->'supersedes_decision_id',
  'prior_dispositions',r.private_manifest_json->'prior_dispositions','prior_dispositions_sha256',r.private_manifest_json->'prior_dispositions_sha256',
  'members',members,'next_actions','[]'::jsonb);
end;
$function$;
revoke all on function private.weekly_source_pay_decision_review_projection_v1(uuid) from public,anon,authenticated,service_role;

create or replace function public.weekly_source_pay_decision_preview_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public set lock_timeout='2500ms' as $function$
declare actor uuid;body jsonb;ref jsonb;fingerprint bytea;manifest jsonb;private_manifest jsonb;result jsonb;
 a private.weekly_source_pay_decision_preview_assemblies%rowtype;d private.weekly_source_pay_decisions%rowtype;
 r private.weekly_source_pay_decision_reviews%rowtype;j private.weekly_source_pay_decision_requests%rowtype;
 c private.bpay_next_source_pay_decision_cut%rowtype;review_id uuid;review_no bigint;review_hash bytea;scope jsonb;
begin
 if coalesce(current_setting('request.jwt.claim.role',true),nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not(p_request ?& array['actor_user_id','preview_assembly_ref','unprotect_preparations']) or p_request->'unprotect_preparations' is distinct from '[]'::jsonb then
  raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;ref:=p_request->'preview_assembly_ref';
 body:=private.weekly_source_pay_decision_request_v1(p_request-array['actor_user_id','preview_assembly_ref','unprotect_preparations'],'PREVIEW');
 if not private.weekly_exceptional_json_keys_exact_v1(ref,array['assembly_id','assembly_sha256']) or not(ref ?& array['assembly_id','assembly_sha256'])
   or coalesce(ref->>'assembly_sha256','') !~ '^[0-9a-f]{64}$' then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 fingerprint:=private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_PREVIEW_REQUEST_V1',body);
 select x.* into strict j from private.weekly_source_pay_decision_requests x where x.request_id=(body->>'request_id')::uuid
  and x.decision_id=(body->>'decision_id')::uuid and x.request_kind='PREVIEW' and x.actor_user_id=actor;
 if j.request_hash is distinct from fingerprint or j.request_json is distinct from body then raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';end if;
 select x.* into strict a from private.weekly_source_pay_decision_preview_assemblies x where x.id=(ref->>'assembly_id')::uuid and x.preview_request_id=j.request_id
  and x.decision_id=j.decision_id and x.actor_user_id=actor and x.assembly_sha256=decode(ref->>'assembly_sha256','hex');
 if a.state='SEALED' then
  for scope in select value from jsonb_array_elements(a.draft_scope_json->'selection') loop
   perform private.weekly_source_pay_decision_scope_access_v1(actor,(scope->>'source_group_id')::uuid,(scope->>'actual_client_id')::uuid,(scope->>'scope_date')::date);
  end loop;
  if j.metadata_state<>'SEALED' or j.receipt_json is null or j.review_id is distinct from a.review_id then raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='23514';end if;
  return j.receipt_json;
 end if;
 manifest:=private.weekly_source_pay_decision_assembly_assert_v1(a.id,actor);
 if a.state<>'READY' or private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_ASSEMBLY_MANIFEST_V1',manifest) is distinct from a.assembly_sha256 then
  raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
 select x.* into strict d from private.weekly_source_pay_decisions x where x.id=a.decision_id for update;
 select x.* into strict a from private.weekly_source_pay_decision_preview_assemblies x where x.id=a.id and x.state='READY' for update;
 select x.* into strict c from private.bpay_next_source_pay_decision_cut x where x.id=(a.draft_scope_json->>'cut_id')::uuid and x.preview_assembly_id=a.id and x.review_id is null;
 if d.accept_request_id is not null and (d.decision_kind<>a.decision_kind or encode(d.accepted_selection_sha256,'hex')<>a.draft_scope_json->>'selection_sha256') then
  raise exception 'SOURCE_PAY_DECISION_ACCEPTED_SELECTION_IMMUTABLE' using errcode='40001';end if;
 review_id:=gen_random_uuid();
 select coalesce(max(x.review_no),0)+1 into review_no from private.weekly_source_pay_decision_reviews x where x.decision_id=d.id;
 private_manifest:=a.draft_scope_json||jsonb_build_object('state_revision',d.state_revision::text,'assembly_manifest',manifest,'quote_manifest',manifest->'quote_manifest');
 review_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_REVIEW_V1',jsonb_build_object(
  'review_id',review_id,'decision_id',d.id,'preview_request_id',j.request_id,'preview_request_hash',encode(j.request_hash,'hex'),
  'assembly_id',a.id,'assembly_sha256',encode(a.assembly_sha256,'hex'),'cut_id',c.id,'manifest',private_manifest));
 insert into private.weekly_source_pay_decision_reviews(id,decision_id,preview_assembly_id,review_no,preview_request_id,preview_request_hash,
  review_digest,pay_cut_hash,source_invoice_hash,issue_set_hash,private_manifest_json,financial_history_refs_json,financial_history_manifest_sha256,history_qualification_json)
 values(review_id,d.id,a.id,review_no,j.request_id,j.request_hash,review_hash,c.pay_cut_sha256,c.source_invoice_sha256,c.issue_set_sha256,
  private_manifest,body->'financial_history_refs',private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_HISTORY_REFERENCE_MANIFEST_V1',body->'financial_history_refs'),
  jsonb_build_object('qualification_state',c.qualification_state,'issue_code',c.issue_code,'cut_id',c.id)) returning * into r;
 update private.bpay_next_source_pay_decision_cut x set review_id=r.id where x.id=c.id and x.review_id is null and x.preview_assembly_id=a.id and x.decision_id=d.id;
 if not found then raise exception 'SOURCE_PAY_DECISION_CUT_SEAL_CAS_FAILED' using errcode='40001';end if;
 update private.weekly_source_pay_decision_preview_assemblies x set state='SEALED',review_id=r.id where x.id=a.id and x.state='READY' and x.review_id is null;
 if not found then raise exception 'SOURCE_PAY_DECISION_ASSEMBLY_CAS_FAILED' using errcode='40001';end if;
 result:=private.weekly_source_pay_decision_review_projection_v1(r.id);
 update private.weekly_source_pay_decision_requests x set review_id=r.id,metadata_state='SEALED',receipt_json=result
  where x.request_id=j.request_id and x.metadata_state='ASSEMBLING' and x.receipt_json is null;
 if not found then raise exception 'SOURCE_PAY_DECISION_REQUEST_CAS_FAILED' using errcode='40001';end if;
 return result;
exception when no_data_found or too_many_rows or invalid_text_representation then raise exception 'SOURCE_PAY_DECISION_PREVIEW_INVALID' using errcode='22023';
end;
$function$;
revoke all on function public.weekly_source_pay_decision_preview_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_preview_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/36_exact_source_review_and_seal.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/37_selected_contact_retirement.sqlinc
-- One selected contact owner, only after genuine stage/publication/binding.
create or replace function private.weekly_source_pay_decision_incident_guard_v1()
returns trigger language plpgsql security definer set search_path=pg_catalog,private,public as $function$
begin
 if TG_OP='DELETE' then
  if OLD.resolution_kind='SOURCE_PAY_DECISION' then raise exception 'SOURCE_PAY_DECISION_CONTACT_HISTORY_RETAINED' using errcode='55000';end if;
  return OLD;
 end if;
 if TG_OP='UPDATE' and OLD.resolution_kind='SOURCE_PAY_DECISION' then
  if to_jsonb(NEW) is distinct from to_jsonb(OLD) then raise exception 'SOURCE_PAY_DECISION_CONTACT_HISTORY_IMMUTABLE' using errcode='55000';end if;
  return NEW;
 end if;
 if NEW.resolution_kind is distinct from 'SOURCE_PAY_DECISION' then return NEW;end if;
 if TG_OP<>'UPDATE' or OLD.state<>'OPEN' or NEW.state<>'RESOLVED' or NEW.resolved_at_utc is distinct from transaction_timestamp()
  or (to_jsonb(NEW)-array['state','reconciliation_state','candidate_action_state','manager_potential_state','manager_action_state','waiting_source_state','resolved_at_utc','resolution_kind'])
   is distinct from (to_jsonb(OLD)-array['state','reconciliation_state','candidate_action_state','manager_potential_state','manager_action_state','waiting_source_state','resolved_at_utc','resolution_kind'])
  or not exists(select 1 from private.weekly_source_pay_decision_acceptance_applications a
   join private.weekly_source_pay_decision_members m on m.decision_id=a.decision_id and OLD.id=any(m.contact_issue_ids)
   join private.weekly_source_pay_decision_reviews review on review.id=a.review_id and review.decision_id=a.decision_id
   join private.bpay_next_source_pay_decision_publication p on p.application_id=a.id and p.cut_id=a.cut_id and p.decision_id=a.decision_id
   join private.bpay_next_command cmd on cmd.id=p.command_id and cmd.status in('SEALED','COMPLETE') and cmd.sealed_at_utc is not null
   where a.state='STAGED' and a.backend_pid=pg_backend_pid() and a.transaction_id=pg_current_xact_id()
    and m.candidate_id=OLD.candidate_id and m.actual_client_id=OLD.client_id and m.source_work_event_id=OLD.work_event_id
    and exists(select 1 from jsonb_array_elements(review.private_manifest_json->'selection') s,
     lateral jsonb_array_elements(s.value->'issue_witnesses') issue
     where s.value->>'member_key'=m.member_key and issue.value->'incident'=to_jsonb(OLD))) then
  raise exception 'SOURCE_PAY_DECISION_CONTACT_APPLICATION_REQUIRED' using errcode='23514';end if;
 return NEW;
end;
$function$;
revoke all on function private.weekly_source_pay_decision_incident_guard_v1() from public,anon,authenticated,service_role;


create or replace function private.weekly_source_pay_decision_contact_retire_v1(p_application uuid)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public as $function$
declare a private.weekly_source_pay_decision_acceptance_applications%rowtype;m private.weekly_source_pay_decision_members%rowtype;
 r private.weekly_source_pay_decision_reviews%rowtype;i public.weekly_discrepancy_incidents%rowtype;c public.weekly_issue_comparison_revisions%rowtype;
 selected jsonb;saved jsonb;issue uuid;result jsonb:='[]';retired jsonb;completed uuid[];manager_completed uuid[];
begin
 select x.* into strict a from private.weekly_source_pay_decision_acceptance_applications x where x.id=p_application
  and x.state='STAGED' and x.backend_pid=pg_backend_pid() and x.transaction_id=pg_current_xact_id();
 perform private.weekly_source_pay_decision_publication_adoptions_assert_v1(a.id);
 if exists(select 1 from private.bpay_next_source_pay_decision_cut_member cm where cm.cut_id=a.cut_id and not exists(
   select 1 from private.bpay_next_source_pay_decision_publication p join private.bpay_next_source_pay_decision_publication_member pm on pm.command_id=p.command_id
    join private.bpay_next_command cmd on cmd.id=p.command_id and cmd.status in('SEALED','COMPLETE') and cmd.sealed_at_utc is not null
   where p.application_id=a.id and p.cut_id=cm.cut_id and pm.cut_id=cm.cut_id and pm.cut_member_no=cm.member_no)) then
  raise exception 'SOURCE_PAY_DECISION_CONTACT_PUBLICATION_REQUIRED' using errcode='23514';end if;
 select x.* into strict r from private.weekly_source_pay_decision_reviews x where x.id=a.review_id and x.decision_id=a.decision_id;
 for m in select x.* from private.weekly_source_pay_decision_members x where x.decision_id=a.decision_id order by x.member_key loop
  retired:='[]';
  select x.value into strict selected from jsonb_array_elements(r.private_manifest_json->'selection') x where x.value->>'member_key'=m.member_key;
  for issue in select value::uuid from jsonb_array_elements_text(selected->'selected_issue_ids') order by value loop
   if not(issue=any(m.contact_issue_ids)) then raise exception 'SOURCE_PAY_DECISION_CONTACT_SCOPE_INVALID' using errcode='23514';end if;
   select x.* into strict i from public.weekly_discrepancy_incidents x where x.id=issue and x.candidate_id=m.candidate_id and x.client_id=m.actual_client_id
     and x.work_event_id=m.source_work_event_id and x.source_cycle_id=(selected->>'source_cycle_id')::uuid for update;
   select x.* into strict c from public.weekly_issue_comparison_revisions x where x.id=i.current_comparison_revision_id
    and x.incident_id=i.id and x.source_row_id=(selected->>'observed_source_row_id')::uuid
    and x.issue_family in('SOURCE_MISSING_OR_NOT_AUTHORISED','SOURCE_HOURS_DIFFER','HEALTHROSTER_NOT_FINALISED');
   select x.value into strict saved from jsonb_array_elements(selected->'issue_witnesses') x where x.value#>>'{incident,id}'=i.id::text;
   if saved->'incident' is distinct from to_jsonb(i) or saved->'comparison' is distinct from to_jsonb(c) or i.state<>'OPEN' then
    raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
   update public.weekly_discrepancy_incidents x set state='RESOLVED',reconciliation_state='RECONCILED',
    candidate_action_state='NOT_REQUIRED',manager_potential_state='NOT_REQUIRED',manager_action_state='NOT_REQUIRED',
    waiting_source_state='NOT_WAITING',resolved_at_utc=transaction_timestamp(),resolution_kind='SOURCE_PAY_DECISION' where x.id=i.id and x.state='OPEN';
   if not found then raise exception 'SOURCE_PAY_DECISION_CONTACT_CAS_FAILED' using errcode='40001';end if;
   update public.weekly_candidate_outreach_memberships membership set state='RESOLVED'
    from public.weekly_candidate_outreach_generations generation where membership.incident_id=i.id
     and membership.state in('ACTIONABLE','ANSWERED') and generation.id=membership.candidate_generation_id and generation.request_kind='CHECK_HOURS';
   with finished as(update public.weekly_candidate_outreach_generations generation set state='COMPLETE'
    where generation.state='ACTIVE' and generation.request_kind='CHECK_HOURS' and exists(
      select 1 from public.weekly_candidate_outreach_memberships membership where membership.candidate_generation_id=generation.id and membership.incident_id=i.id)
     and not exists(select 1 from public.weekly_candidate_outreach_memberships membership where membership.candidate_generation_id=generation.id and membership.state='ACTIONABLE')
    returning generation.id) select array_agg(id) into completed from finished;
   update public.weekly_message_intents intent set state='RETIRED' where intent.candidate_generation_id=any(completed) and intent.state in('DUE','RENDERED');
   update public.weekly_manager_review_items item set response_state='FILTERED_RESOLVED'
    where item.incident_id=i.id and item.incident_episode=i.episode_number and item.response_state='UNANSWERED';
   update public.office_action_notifications notice set operational_state='RESOLVED',resolved_at_utc=transaction_timestamp()
    where notice.issue_id=i.id and notice.operational_state='OPEN';
   insert into public.weekly_discrepancy_events(incident_id,issue_episode,projection_publication_id,expected_comparison_fingerprint,event_kind,actor_kind,
    actor_user_id,bounded_payload_json,idempotency_key) values(i.id,i.episode_number,c.projection_publication_id,c.material_comparison_fingerprint,
    'RESOLVED','OFFICE',a.actor_user_id,jsonb_build_object('resolution','SOURCE_PAY_DECISION','decision_id',a.decision_id,'application_id',a.id,'member_key',m.member_key),
    'SOURCE_PAY_DECISION:'||a.id::text||':'||i.id::text) on conflict(event_kind,idempotency_key) do nothing;
   retired:=retired||jsonb_build_array(i.id);
  end loop;
  result:=result||jsonb_build_array(jsonb_build_object('member_key',m.member_key,'retired_issue_ids',retired));
 end loop;
 -- Mixed recipient generations keep their remaining actual questions. Immutable
 -- sent renders/accepted deliveries and missing-Timesheet/reference work remain.
 return result;
exception when no_data_found or too_many_rows then raise exception 'SOURCE_PAY_DECISION_CONTACT_SCOPE_INVALID' using errcode='23514';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_contact_retire_v1(uuid) from public,anon,authenticated,service_role;

create or replace function private.weekly_source_pay_decision_contact_suppressed_v1(p_group uuid,p_event uuid,p_issue jsonb)
returns boolean language sql stable security definer set search_path=pg_catalog,private,public as $function$
 select coalesce(upper(btrim(p_issue->>'issue_family')) in('SOURCE_MISSING_OR_NOT_AUTHORISED','SOURCE_HOURS_DIFFER','HEALTHROSTER_NOT_FINALISED')
  and exists(select 1 from private.bpay_next_worker_pay_disposition disposition
   join private.bpay_next_worker_pay_disposition_member current_member on current_member.disposition_id=disposition.id and current_member.version_no=disposition.current_version
   join private.weekly_source_pay_decisions decision on decision.id=current_member.member_decision_id and decision.accept_request_id is not null
    and decision.contact_policy='DO_NOT_QUERY_SELECTED_ISSUES'
   join private.weekly_source_pay_decision_members selected on selected.decision_id=decision.id and selected.source_row_id=disposition.original_source_row_id
   join private.weekly_source_pay_decision_requests accepted on accepted.request_id=decision.accept_request_id and accepted.metadata_state='COMMITTED'
   join private.weekly_source_pay_decision_reviews review on review.id=accepted.review_id
   where current_member.source_work_event_id=p_event and exists(select 1 from jsonb_array_elements(review.private_manifest_json->'selection') s
    where s.value->>'member_key'=selected.member_key and s.value->>'source_group_id'=p_group::text
     and (selected.scope_mode='WHOLE_SHIFT' or jsonb_array_length(s.value->'selected_issue_ids')>0)))
 ,false);
$function$;
revoke all on function private.weekly_source_pay_decision_contact_suppressed_v1(uuid,uuid,jsonb) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/37_selected_contact_retirement.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/38_source_owned_saved_result.sqlinc
-- Source-owned internal current projection. The final public READ_RESULT
-- wrapper and Banking financial-status child remain the exact B051 producer
-- seam. This private projection does not claim that unconsumed shape.
create or replace function private.weekly_source_pay_decision_read_source_v1(p_decision uuid,p_request uuid,p_actor uuid)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,private,public as $function$
declare d private.weekly_source_pay_decisions%rowtype;j private.weekly_source_pay_decision_requests%rowtype;
 r private.weekly_source_pay_decision_reviews%rowtype;m jsonb;applications jsonb;native jsonb;cut jsonb;
begin
 if p_actor is null or not private.weekly_source_pay_actor_allowed_v1(p_actor) then raise exception 'SOURCE_PAY_DECISION_ACTOR_REQUIRED' using errcode='42501';end if;
 select x.* into strict d from private.weekly_source_pay_decisions x where x.id=p_decision and x.accept_request_id is not null and x.receipt_json is not null;
 select x.* into strict j from private.weekly_source_pay_decision_requests x where x.request_id=p_request and x.decision_id=d.id
  and x.request_kind in('ACCEPT','RESUME_FINANCIAL') and x.metadata_state='COMMITTED' and x.receipt_json is not null;
 select x.* into strict r from private.weekly_source_pay_decision_reviews x where x.id=j.review_id and x.decision_id=d.id;
 for m in select value from jsonb_array_elements(r.private_manifest_json->'selection') loop
  perform private.weekly_source_pay_decision_scope_access_v1(p_actor,(m->>'source_group_id')::uuid,(m->>'actual_client_id')::uuid,(m->>'scope_date')::date);
 end loop;
 if j.receipt_json->>'version' is distinct from 'SOURCE_PAY_DECISION_RECEIPT_V1'
  or j.receipt_json->>'decision_id' is distinct from d.id::text or j.receipt_json->>'request_id' is distinct from j.request_id::text
  or j.receipt_json->>'review_id' is distinct from r.id::text then raise exception 'SOURCE_PAY_DECISION_SAVED_RECEIPT_INVALID' using errcode='23514';end if;
 select coalesce(jsonb_agg(jsonb_build_object('application_id',a.id,'request_id',a.request_id,'review_id',a.review_id,'cut_id',a.cut_id,
   'state',a.state,'application_sha256',encode(a.application_sha256,'hex'),'completed_at_utc',a.completed_at_utc) order by c.cut_no),'[]'::jsonb)
   into applications from private.weekly_source_pay_decision_acceptance_applications a
   join private.bpay_next_source_pay_decision_cut c on c.id=a.cut_id and c.decision_id=a.decision_id and c.review_id=a.review_id
   where a.decision_id=d.id and a.state='COMMITTED';
 if not exists(select 1 from private.weekly_source_pay_decision_acceptance_applications a where a.request_id=j.request_id and a.decision_id=d.id
   and a.review_id=j.review_id and a.state='COMMITTED' and a.application_sha256 is not null) then raise exception 'SOURCE_PAY_DECISION_SAVED_APPLICATION_INVALID' using errcode='23514';end if;
 select coalesce(jsonb_agg(jsonb_build_object('application_id',a.id,'request_id',a.request_id,'member_key',n.member_key,'preparation_id',n.preparation_id,
  'route',n.route,'origin',n.origin,'orchestration_run_id',n.orchestration_run_id,'native_result_sha256',encode(n.native_result_sha256,'hex'),
  'original_native_result',n.native_result_json,'failure_code',n.failure_code,
  'current_local_release_proof',case when n.route='SOURCE_LOCAL' and n.origin<>'NOT_APPLIED_DEPENDENCY'
    then private.weekly_source_pay_decision_local_release_proof_v1(n.preparation_id) else null end)
  order by c.cut_no,n.member_key),'[]'::jsonb) into native
  from private.weekly_source_pay_decision_native_adoptions n
   join private.weekly_source_pay_decision_acceptance_applications a on a.id=n.application_id and a.decision_id=d.id and a.state='COMMITTED'
   join private.bpay_next_source_pay_decision_cut c on c.id=a.cut_id
  where n.native_result_sha256 is null or n.native_result_sha256=private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_COMPOSED_RESULT_V1',n.native_result_json);
 if exists(select 1 from private.weekly_source_pay_decision_native_adoptions n join private.weekly_source_pay_decision_acceptance_applications a
   on a.id=n.application_id where a.decision_id=d.id and (a.state<>'COMMITTED' or n.native_result_sha256 is distinct from
    case when n.native_result_json is null then null else private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_COMPOSED_RESULT_V1',n.native_result_json) end)) then
  raise exception 'SOURCE_PAY_DECISION_SAVED_NATIVE_RESULT_INVALID' using errcode='23514';end if;
 select jsonb_build_object('cut_id',c.id,'cut_no',c.cut_no::text,'review_id',c.review_id,'qualification_state',c.qualification_state,
  'pay_cut_sha256',encode(c.pay_cut_sha256,'hex'),'source_invoice_sha256',encode(c.source_invoice_sha256,'hex'),'issue_set_sha256',encode(c.issue_set_sha256,'hex'))
  into strict cut from private.bpay_next_source_pay_decision_cut c where c.id=d.current_financial_cut_id and c.decision_id=d.id and c.review_id is not null;
 return jsonb_build_object('version','SOURCE_PAY_DECISION_INTERNAL_SOURCE_READ_V1','decision_id',d.id,'request_id',j.request_id,
  'accepted_receipt',d.receipt_json,'request_receipt',j.receipt_json,'state_revision',d.state_revision::text,'current_cut',cut,'applications',applications,'native_members',native);
exception when no_data_found or too_many_rows then raise exception 'SOURCE_PAY_DECISION_SAVED_RESULT_NOT_FOUND' using errcode='22023';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_read_source_v1(uuid,uuid,uuid) from public,anon,authenticated,service_role;

create or replace function public.weekly_source_pay_decision_read_source_v1(p_request jsonb)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,private,public as $function$
begin
 if coalesce(current_setting('request.jwt.claim.role',true),nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['version','actor_user_id','decision_id','request_id'])
  or not(p_request ?& array['version','actor_user_id','decision_id','request_id'])
  or p_request->>'version' is distinct from 'SOURCE_PAY_DECISION_INTERNAL_SOURCE_READ_V1' then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 return private.weekly_source_pay_decision_read_source_v1((p_request->>'decision_id')::uuid,(p_request->>'request_id')::uuid,(p_request->>'actor_user_id')::uuid);
end;
$function$;
revoke all on function public.weekly_source_pay_decision_read_source_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_read_source_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/38_source_owned_saved_result.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/39_actual_native_dependency_rollback.sqlinc
-- Full genuine run-bound witness for a native subtransaction rollback.
create or replace function private.weekly_source_pay_decision_native_rollback_witness_v1(p_preparation uuid)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,private,public as $function$
declare p private.weekly_source_pay_decision_unprotect_preparations%rowtype;placement jsonb;result jsonb;
begin
 select x.* into strict p from private.weekly_source_pay_decision_unprotect_preparations x where x.id=p_preparation;
 placement:=private.weekly_source_protected_current_placement_v1(p.family_id,(p.native_prepare_request_json->>'work_event_id')::uuid,false);
 select jsonb_build_object('family',(select to_jsonb(f) from public.weekly_exceptional_pay_target_families f where f.id=p.family_id),
  'run',(select to_jsonb(r) from public.weekly_exceptional_orchestration_runs r where r.id=p.orchestration_run_id),
  'placement',placement,
  'current_financial',(select to_jsonb(f) from public.timesheets_financials f where f.id=(placement->>'current_financial_id')::uuid),
  'targets',(select coalesce(jsonb_agg(to_jsonb(t) order by t.id),'[]'::jsonb) from public.weekly_exceptional_pending_reconciliation_targets t where t.family_id=p.family_id),
  'approvals',(select coalesce(jsonb_agg(to_jsonb(a) order by a.id),'[]'::jsonb) from public.weekly_exceptional_payment_approvals a where a.creation_orchestration_run_id=p.orchestration_run_id),
  'generations',(select coalesce(jsonb_agg(to_jsonb(g) order by g.id),'[]'::jsonb) from public.weekly_exceptional_pay_generations g
    where g.request_idempotency_key=any(array[p.child_idempotency_key,p.payload_json#>>'{publish_request,idempotency_key}',p.payload_json#>>'{stage_request,idempotency_key}'])),
  'requests',(select coalesce(jsonb_agg(to_jsonb(r) order by r.id),'[]'::jsonb) from public.weekly_exceptional_c1_publication_requests r where r.orchestration_run_id=p.orchestration_run_id),
  'steps',(select coalesce(jsonb_agg(to_jsonb(s) order by s.sequence),'[]'::jsonb) from public.weekly_exceptional_orchestration_steps s where s.orchestration_run_id=p.orchestration_run_id))
 into result;
 return result;
end;
$function$;
revoke all on function private.weekly_source_pay_decision_native_rollback_witness_v1(uuid) from public,anon,authenticated,service_role;

create or replace function private.weekly_source_pay_decision_native_dependency_v1(p_preparation uuid,p_before jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public as $function$
declare p private.weekly_source_pay_decision_unprotect_preparations%rowtype;a private.weekly_source_pay_decision_acceptance_applications%rowtype;
 actual jsonb;components jsonb;result jsonb;application uuid;
begin
 application:=private.weekly_source_pay_decision_unprotect_application_v1(p_preparation);
 select x.* into strict p from private.weekly_source_pay_decision_unprotect_preparations x where x.id=p_preparation;
 select x.* into strict a from private.weekly_source_pay_decision_acceptance_applications x where x.id=application;
 actual:=private.weekly_source_pay_decision_native_rollback_witness_v1(p.id);
 if actual is distinct from p_before or actual#>>'{run,state}' is distinct from 'RUNNING'
  or not exists(select 1 from public.weekly_exceptional_pending_reconciliation_targets t where t.family_id=p.family_id
    and t.durable_work_event_id=(p.native_prepare_request_json->>'work_event_id')::uuid and t.state='ACTIVE')
  or exists(select 1 from private.weekly_source_pay_decision_native_adoptions n where n.application_id=a.id and n.member_key=p.member_key) then
  raise exception 'SOURCE_NATIVE_SUBTRANSACTION_ROLLBACK_NOT_PROVED' using errcode='23514';end if;
 select coalesce(jsonb_agg(jsonb_build_object('cut_id',m.cut_id,'member_no',m.member_no::text,'member_sha256',encode(m.member_sha256,'hex'))
  order by m.member_no),'[]'::jsonb) into components from private.bpay_next_source_pay_decision_cut_member m where m.cut_id=a.cut_id and m.member_key=p.member_key;
 if jsonb_array_length(components)=0 then raise exception 'SOURCE_NATIVE_SUBTRANSACTION_ROLLBACK_NOT_PROVED' using errcode='23514';end if;
 insert into private.weekly_source_pay_decision_native_adoptions(application_id,decision_id,review_id,member_key,preparation_id,route,origin,
  reviewed_economic_target_sha256,pre_witness_sha256,post_witness_manifest_json,failure_code,cut_components_json,cut_components_sha256)
 values(a.id,p.decision_id,p.review_id,p.member_key,p.id,p.route,'NOT_APPLIED_DEPENDENCY',p.reviewed_target_sha256,a.pre_witness_sha256,
  jsonb_build_object('native_rollback_witness',actual,'native_rollback_witness_sha256',encode(private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_ROLLBACK_WITNESS_V1',actual),'hex')),
  'DEPENDENCY_UNAVAILABLE',components,private.weekly_source_sha256_jsonb_v1('SOURCE_NATIVE_CUT_COMPONENTS_V1',components));
 return jsonb_build_object('version','SOURCE_NATIVE_COMPOSED_RESULT_V1','application_id',a.id,'decision_id',p.decision_id,'request_id',p.accept_or_resume_request_id,
  'review_id',p.review_id,'member_key',p.member_key,'preparation_id',p.id,'route',p.route,'origin','NOT_APPLIED_DEPENDENCY',
  'control_status','NOT_APPLIED','native_receipt',null,'failure_code','DEPENDENCY_UNAVAILABLE');
end;
$function$;
revoke all on function private.weekly_source_pay_decision_native_dependency_v1(uuid,jsonb) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/39_actual_native_dependency_rollback.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/40_actual_publication_and_source_binding.sqlinc
-- Factual native publication/lineage composition; no new Banking valuer.
create or replace function private.weekly_source_pay_decision_bind_publication_v1(p_application uuid)
returns void language plpgsql volatile security definer set search_path=pg_catalog,private,public as $function$
declare a private.weekly_source_pay_decision_acceptance_applications%rowtype;n record;component record;selected jsonb;
 binding record;matches integer;lineage public.weekly_source_row_timesheet_lineages%rowtype;member private.weekly_source_pay_decision_members%rowtype;
 old_binding private.weekly_source_pay_decision_bindings%rowtype;next_no bigint;certificate bytea;
begin
 select x.* into strict a from private.weekly_source_pay_decision_acceptance_applications x where x.id=p_application
  and x.state='STAGED' and x.backend_pid=pg_backend_pid() and x.transaction_id=pg_current_xact_id();
 insert into private.weekly_source_pay_decision_publication_adoptions(command_id,publication_member_no,application_id,member_key)
  select pm.command_id,pm.member_no,a.id,n.member_key from private.bpay_next_source_pay_decision_publication publication
   join private.bpay_next_source_pay_decision_publication_member pm on pm.command_id=publication.command_id
   join private.bpay_next_source_pay_decision_cut_member cm on cm.cut_id=pm.cut_id and cm.member_no=pm.cut_member_no
   join private.weekly_source_pay_decision_native_adoptions n on n.application_id=a.id and n.member_key=cm.member_key and n.origin<>'NOT_APPLIED_DEPENDENCY'
  where publication.application_id=a.id and publication.decision_id=a.decision_id and publication.cut_id=a.cut_id
   and pm.cut_id=a.cut_id order by pm.command_id,pm.member_no,n.member_key;
 perform private.weekly_source_pay_decision_publication_adoptions_assert_v1(a.id);
 for n in select x.* from private.weekly_source_pay_decision_native_adoptions x where x.application_id=a.id
    and x.origin<>'NOT_APPLIED_DEPENDENCY' and x.local_entitlement_kind='COMMITTED_HEAD' order by x.member_key loop
  -- Banking owns its exact Source proof arm/components set. Normal two-argument
  -- binder semantics stay unchanged, and no old POSITION_APPLY row is forged.
  for component in select * from private.bpay_next_source_binding_components_v1(n.committed_publication_receipt_id) loop
   perform private.bpay_next_source_component_bind_v1(n.committed_publication_receipt_id,component.source_component_id);
  end loop;
 end loop;
 for member in select m.* from private.weekly_source_pay_decision_members m where m.decision_id=a.decision_id order by m.member_key loop
  select s.value into strict selected from private.weekly_source_pay_decision_reviews r,
   lateral jsonb_array_elements(r.private_manifest_json->'selection') s where r.id=a.review_id and s.value->>'member_key'=member.member_key;
  select l.* into lineage from public.weekly_source_row_timesheet_lineages l where l.row_resolution_id=(selected->>'source_resolution_id')::uuid
   and l.upload_row_id=(selected->>'observed_source_row_id')::uuid and l.candidate_id=member.candidate_id and l.client_id=member.actual_client_id;
  if lineage.id is null then continue;end if;
  select count(*) into matches from private.bpay_next_worker_pay_disposition_subject_binding b
   where b.disposition_id=member.pay_disposition_id and b.accepted_source_resolution_id=lineage.row_resolution_id
    and b.original_source_row_id=member.source_row_id and b.source_work_event_id=lineage.work_event_id
    and b.family_root_id=(private.timesheet_contract_current_placement_v1(lineage.timesheet_id)->>'family_root_id')::uuid;
  if matches<>1 then
   if exists(select 1 from private.bpay_next_source_pay_decision_cut_member cm where cm.cut_id=a.cut_id and cm.member_key=member.member_key and cm.qualification_state='QUALIFIED') then
    raise exception 'SOURCE_PAY_DECISION_SOURCE_RESOLUTION_REQUIRED' using errcode='55000';end if;
   continue;
  end if;
  select b.* into strict binding from private.bpay_next_worker_pay_disposition_subject_binding b
   where b.disposition_id=member.pay_disposition_id and b.accepted_source_resolution_id=lineage.row_resolution_id
    and b.original_source_row_id=member.source_row_id and b.source_work_event_id=lineage.work_event_id
    and b.family_root_id=(private.timesheet_contract_current_placement_v1(lineage.timesheet_id)->>'family_root_id')::uuid;
  certificate:=private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_ACCEPTED_SOURCE_BINDING_V1',
   jsonb_build_object('decision_id',a.decision_id,'member_key',member.member_key,'native_lineage',to_jsonb(lineage),'native_subject_binding',to_jsonb(binding),
    'component_keys',member.component_keys));
  select x.* into old_binding from private.weekly_source_pay_decision_bindings x
   where x.decision_id=a.decision_id and x.member_key=member.member_key and x.row_resolution_id=lineage.row_resolution_id;
  if found then
   if old_binding.binding_certificate_hash is distinct from certificate or old_binding.banking_disposition_id is distinct from binding.disposition_id
     or old_binding.banking_disposition_binding_no is distinct from binding.binding_no then raise exception 'SOURCE_PAY_DECISION_BINDING_CONFLICT' using errcode='23514';end if;
  else
   select coalesce(max(x.binding_no),0)+1 into next_no from private.weekly_source_pay_decision_bindings x where x.decision_id=a.decision_id and x.member_key=member.member_key;
   insert into private.weekly_source_pay_decision_bindings(decision_id,member_key,row_resolution_id,binding_no,family_root_id,source_work_event_id,component_keys,
    banking_disposition_id,banking_disposition_binding_no,binding_certificate_hash)
   values(a.decision_id,member.member_key,lineage.row_resolution_id,next_no,binding.family_root_id,lineage.work_event_id,member.component_keys,
    binding.disposition_id,binding.binding_no,certificate);
  end if;
 end loop;
end;
$function$;
revoke all on function private.weekly_source_pay_decision_bind_publication_v1(uuid) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/40_actual_publication_and_source_binding.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/41_atomic_source_acceptance.sqlinc
create or replace function public.weekly_source_pay_decision_accept_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,private,public set lock_timeout='2500ms' as $function$
declare actor uuid;body jsonb;kind text;fingerprint bytea;required jsonb;ref jsonb;member jsonb;selected jsonb;review_public jsonb;native jsonb;
 d private.weekly_source_pay_decisions%rowtype;j private.weekly_source_pay_decision_requests%rowtype;
 r private.weekly_source_pay_decision_reviews%rowtype;a private.weekly_source_pay_decision_preview_assemblies%rowtype;
 app private.weekly_source_pay_decision_acceptance_applications%rowtype;prep private.weekly_source_pay_decision_unprotect_preparations%rowtype;
 adoption private.weekly_source_pay_decision_native_adoptions%rowtype;stored private.weekly_source_pay_decision_members%rowtype;
 cut private.bpay_next_source_pay_decision_cut%rowtype;application uuid;stage_result jsonb;publications jsonb;expected_commands jsonb;
 contacts jsonb;retired jsonb;receipt_members jsonb:='[]';release jsonb;actions jsonb;result jsonb;
 disposition uuid;qualification text;held boolean;recovery boolean;failure boolean;pay_result text;invoice_result text;
 scope jsonb;before_revision bigint;first_accept boolean;
begin
 if coalesce(current_setting('request.jwt.claim.role',true),nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
  raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
 if not(p_request ?& array['actor_user_id','preview_assembly_ref','unprotect_preparations'])
   or p_request->'preview_assembly_ref' is distinct from 'null'::jsonb or jsonb_typeof(p_request->'unprotect_preparations') is distinct from 'array' then
  raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;kind:=p_request->>'action';
 body:=private.weekly_source_pay_decision_request_v1(p_request-array['actor_user_id','preview_assembly_ref','unprotect_preparations'],kind);
 if actor is null or not private.weekly_source_pay_actor_allowed_v1(actor) then raise exception 'SOURCE_PAY_DECISION_ACTOR_REQUIRED' using errcode='42501';end if;
 if kind='READ_RESULT' then
  if p_request->'unprotect_preparations'<>'[]'::jsonb then raise exception 'SOURCE_PAY_DECISION_REQUEST_INVALID' using errcode='22023';end if;
  perform private.weekly_source_pay_decision_read_source_v1((body->>'decision_id')::uuid,(body->>'request_id')::uuid,actor);
  -- Exact public current-financial wrapper/child schema is still the named B051
  -- producer seam. Never add fields to the immutable15-key accepted receipt or
  -- return an unvalidated opaque Banking status as that public result.
  raise exception 'SOURCE_PAY_DECISION_READ_PROJECTION_DEPENDENCY_REQUIRED' using errcode='55000';
 end if;
 fingerprint:=private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_CONFIRMATION_V1',body);
 select x.* into j from private.weekly_source_pay_decision_requests x where x.request_id=(body->>'request_id')::uuid;
 if found then
  if j.decision_id is distinct from (body->>'decision_id')::uuid or j.actor_user_id<>actor or j.request_kind<>kind
    or j.request_hash is distinct from fingerprint or j.request_json is distinct from body or j.review_id is distinct from (body->>'review_id')::uuid then
   raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';end if;
  if j.metadata_state='COMMITTED' then
   -- Current access only, before revaluation or new native run/application.
   select x.* into strict r from private.weekly_source_pay_decision_reviews x where x.id=j.review_id and x.decision_id=j.decision_id;
   for scope in select value from jsonb_array_elements(r.private_manifest_json->'selection') loop
    perform private.weekly_source_pay_decision_scope_access_v1(actor,(scope->>'source_group_id')::uuid,(scope->>'actual_client_id')::uuid,(scope->>'scope_date')::date);
   end loop;
   return j.receipt_json;
  end if;
 end if;
 select x.* into strict d from private.weekly_source_pay_decisions x where x.id=(body->>'decision_id')::uuid;
 select x.* into strict r from private.weekly_source_pay_decision_reviews x where x.id=(body->>'review_id')::uuid and x.decision_id=d.id;
 select x.* into strict a from private.weekly_source_pay_decision_preview_assemblies x where x.id=r.preview_assembly_id and x.review_id=r.id
  and x.decision_id=d.id and x.actor_user_id=actor and x.state='SEALED';
 for scope in select value from jsonb_array_elements(r.private_manifest_json->'selection') loop
  perform private.weekly_source_pay_decision_scope_access_v1(actor,(scope->>'source_group_id')::uuid,(scope->>'actual_client_id')::uuid,(scope->>'scope_date')::date);
 end loop;
 if encode(r.review_digest,'hex') is distinct from body->>'review_digest' or encode(r.pay_cut_hash,'hex') is distinct from body->>'expected_pay_cut_hash'
  or r.private_manifest_json->'prior_dispositions' is distinct from body->'expected_prior_dispositions'
  or r.private_manifest_json->>'prior_dispositions_sha256' is distinct from body->>'expected_prior_dispositions_sha256'
  or a.expires_at_utc<=transaction_timestamp() then raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
 if kind='ACCEPT' then
  if a.decision_kind is distinct from body->>'decision' or d.accept_request_id is not null
   or encode(r.source_invoice_hash,'hex') is distinct from body->>'expected_source_invoice_hash'
   or encode(r.issue_set_hash,'hex') is distinct from body->>'expected_issue_set_hash'
   or r.private_manifest_json->'supersedes_decision_id' is distinct from body->'supersedes_decision_id' then
   raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
 elsif kind<>'RESUME_FINANCIAL' or d.accept_request_id is null or a.decision_kind is distinct from d.decision_kind
  or body->>'expected_state_revision' is distinct from d.state_revision::text
  or r.private_manifest_json->>'selection_sha256' is distinct from encode(d.accepted_selection_sha256,'hex') then
  raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
 -- Native Source/Candidate/root/Work/Position/Case/hold gates first, before
 -- existing Health metadata locks. This is a strict PRESTATE call only.
 perform private.bpay_next_source_pay_decision_cut_v1(d.id,null,r.id,true);
 select x.* into strict d from private.weekly_source_pay_decisions x where x.id=d.id for update;
 select x.* into strict a from private.weekly_source_pay_decision_preview_assemblies x where x.id=a.id and x.state='SEALED' for share;
 if not private.weekly_source_pay_actor_allowed_v1(actor) or d.state_revision::text is distinct from r.private_manifest_json->>'state_revision' then
  raise exception 'SOURCE_PAY_DECISION_REVIEW_CHANGED' using errcode='40001';end if;
 before_revision:=d.state_revision;first_accept:=d.accept_request_id is null;
 select x.* into j from private.weekly_source_pay_decision_requests x where x.request_id=(body->>'request_id')::uuid for update;
 if found then
  if j.decision_id<>d.id or j.actor_user_id<>actor or j.request_kind<>kind or j.request_hash<>fingerprint or j.request_json<>body or j.review_id<>r.id
   or j.metadata_state<>'CONFIRMED' or j.receipt_json is not null then raise exception 'SOURCE_PAY_DECISION_REQUEST_CONFLICT' using errcode='23505';end if;
 else
  insert into private.weekly_source_pay_decision_requests(request_id,decision_id,request_kind,request_hash,request_json,actor_user_id,review_id,metadata_state)
   values((body->>'request_id')::uuid,d.id,kind,fingerprint,body,actor,r.id,'CONFIRMED') returning * into j;
 end if;
 required:=case when a.decision_kind='EXCLUDE_FUTURE_WORK_PAY' then r.private_manifest_json->'required_quote_members' else '[]'::jsonb end;
 if jsonb_typeof(required) is distinct from 'array' or (select count(*) from jsonb_array_elements(p_request->'unprotect_preparations'))
  <>(select count(distinct x.value->>'member_key') from jsonb_array_elements(p_request->'unprotect_preparations') x)
  or (select coalesce(jsonb_agg(x.value->>'member_key' order by x.value->>'member_key'),'[]'::jsonb) from jsonb_array_elements(required) x)
   is distinct from (select coalesce(jsonb_agg(x.value->>'member_key' order by x.value->>'member_key'),'[]'::jsonb) from jsonb_array_elements(p_request->'unprotect_preparations') x) then
  raise exception 'SOURCE_UNPROTECT_PREPARATION_SET_INVALID' using errcode='22023';end if;
 for ref in select value from jsonb_array_elements(p_request->'unprotect_preparations') order by value->>'member_key' loop
  if ref->>'status'='READY' then
   if not private.weekly_exceptional_json_keys_exact_v1(ref,array['member_key','status','preparation_id','payload_sha256'])
    or not(ref ?& array['member_key','status','preparation_id','payload_sha256']) then raise exception 'SOURCE_UNPROTECT_PREPARATION_SET_INVALID' using errcode='22023';end if;
   select x.* into strict prep from private.weekly_source_pay_decision_unprotect_preparations x where x.id=(ref->>'preparation_id')::uuid
    and x.decision_id=d.id and x.review_id=r.id and x.accept_or_resume_request_id=j.request_id and x.member_key=ref->>'member_key'
    and x.actor_user_id=actor and x.confirmation_request_sha256=fingerprint and x.state='PREPARED' and x.expires_at_utc>transaction_timestamp()
    and x.payload_sha256=decode(ref->>'payload_sha256','hex');
  elsif ref->>'status'='NOT_PREPARED' then
   if not private.weekly_exceptional_json_keys_exact_v1(ref,array['member_key','status','failure_code'])
    or not(ref ?& array['member_key','status','failure_code']) or ref->>'failure_code' not in('DEPENDENCY_UNAVAILABLE','RESULT_UNKNOWN') then
    raise exception 'SOURCE_UNPROTECT_PREPARATION_SET_INVALID' using errcode='22023';end if;
   -- This branch performs no native attempt. The strict application prestate
   -- and retained actual run/preparation fences remain; no applied IDs/receipt.
   if exists(select 1 from private.weekly_source_pay_decision_unprotect_preparations x
     where x.decision_id=d.id and x.member_key=ref->>'member_key' and x.accept_or_resume_request_id=j.request_id and x.state='CONSUMED') then
    raise exception 'SOURCE_NATIVE_RESULT_MUST_RECOVER' using errcode='55000';end if;
  else raise exception 'SOURCE_UNPROTECT_PREPARATION_SET_INVALID' using errcode='22023';end if;
 end loop;
 application:=private.bpay_next_source_pay_decision_acceptance_begin_v1(d.id,r.id,j.request_id,r.pay_cut_hash);
 select x.* into strict app from private.weekly_source_pay_decision_acceptance_applications x where x.id=application and x.decision_id=d.id
  and x.review_id=r.id and x.request_id=j.request_id and x.actor_user_id=actor and x.state='PREVALIDATED'
  and x.backend_pid=pg_backend_pid() and x.transaction_id=pg_current_xact_id() and x.pre_cut_sha256=r.pay_cut_hash;
 if first_accept then
  update private.weekly_source_pay_decisions x set accept_request_id=j.request_id,accept_request_hash=fingerprint,decision_kind=a.decision_kind,
   accepted_selection_sha256=decode(r.private_manifest_json->>'selection_sha256','hex'),supersedes_decision_id=(body->>'supersedes_decision_id')::uuid,
   prior_dispositions_sha256=decode(body->>'expected_prior_dispositions_sha256','hex'),reason=btrim(body->>'reason'),evidence_refs_json=body->'evidence_refs',
   invoice_before_hash=r.source_invoice_hash,invoice_after_hash=r.source_invoice_hash,issue_before_hash=r.issue_set_hash
   where x.id=d.id and x.accept_request_id is null and x.state_revision=before_revision returning * into strict d;
 end if;
 for ref in select value from jsonb_array_elements(p_request->'unprotect_preparations') where value->>'status'='READY' order by value->>'member_key' loop
  native:=private.weekly_source_pay_decision_unprotect_apply_v1((ref->>'preparation_id')::uuid,d.id,ref->>'member_key',j.request_id);
 end loop;
 -- Stage consumes this PREVALIDATED application/adoptions and genuine native
 -- poststate. Never run strict old-cut comparison after our owned native writes.
 stage_result:=private.bpay_next_source_pay_decision_stage_v1(d.id,r.id,r.pay_cut_hash,app.id);
 if not private.weekly_exceptional_json_keys_exact_v1(stage_result,array['cut_id','qualification_state','financial_result','member_results','publication_required','next_actions'])
   or not(stage_result ?& array['cut_id','qualification_state','financial_result','member_results','publication_required','next_actions'])
   or stage_result->>'cut_id' is distinct from app.cut_id::text then raise exception 'SOURCE_PAY_DECISION_STAGE_PRODUCER_INVALID' using errcode='23514';end if;
 -- No opaque stage financial_result/member_results child is projected or used
 -- as authority. Read the actual sealed cut/disposition/publication rows below.
 select x.* into strict app from private.weekly_source_pay_decision_acceptance_applications x where x.id=app.id and x.state='STAGED'
  and x.backend_pid=pg_backend_pid() and x.transaction_id=pg_current_xact_id();
 select x.* into strict d from private.weekly_source_pay_decisions x where x.id=d.id and x.current_financial_cut_id=app.cut_id and x.state_revision=before_revision+1;
 select x.* into strict cut from private.bpay_next_source_pay_decision_cut x where x.id=app.cut_id and x.review_id=r.id and x.decision_id=d.id;
 review_public:=private.weekly_source_pay_decision_review_projection_v1(r.id);
 for member in select value from jsonb_array_elements(review_public->'members') order by value->>'member_key' loop
  select x.id into strict disposition from private.bpay_next_worker_pay_disposition x where x.candidate_id=(member->>'candidate_id')::uuid
   and x.actual_client_id=(member->>'actual_client_id')::uuid and x.original_source_row_id=(member->>'source_row_id')::uuid;
  if not exists(select 1 from private.bpay_next_worker_pay_disposition p join private.bpay_next_worker_pay_disposition_member pm on pm.disposition_id=p.id and pm.version_no=p.current_version
    join private.bpay_next_source_pay_decision_cut_member cm on cm.cut_id=pm.qualification_cut_id and cm.member_no=pm.cut_member_no
    where p.id=disposition and pm.member_decision_id=d.id and pm.member_decision_kind=d.decision_kind and cm.cut_id=app.cut_id and cm.member_key=member->>'member_key') then
   raise exception 'SOURCE_PAY_DECISION_DISPOSITION_PRODUCER_INVALID' using errcode='23514';end if;
  select x.* into stored from private.weekly_source_pay_decision_members x where x.decision_id=d.id and x.member_key=member->>'member_key';
  if found then
   if stored.pay_disposition_id is distinct from disposition or stored.candidate_id is distinct from (member->>'candidate_id')::uuid
    or stored.actual_client_id is distinct from (member->>'actual_client_id')::uuid or stored.source_row_id is distinct from (member->>'source_row_id')::uuid
    or stored.scope_kind is distinct from member->>'scope_kind' or stored.scope_mode is distinct from member->>'scope_mode' then
    raise exception 'SOURCE_PAY_DECISION_ACCEPTED_SELECTION_IMMUTABLE' using errcode='40001';end if;
  else
   if not first_accept then raise exception 'SOURCE_PAY_DECISION_ACCEPTED_SELECTION_IMMUTABLE' using errcode='40001';end if;
   insert into private.weekly_source_pay_decision_members(decision_id,member_key,scope_kind,scope_mode,candidate_id,actual_client_id,family_root_id,source_work_event_id,
    source_row_id,component_keys,supported_quantity_json,excluded_quantity_json,branch,source_invoice_certificate_json,contact_issue_ids,pay_disposition_id)
   values(d.id,member->>'member_key',member->>'scope_kind',member->>'scope_mode',(member->>'candidate_id')::uuid,(member->>'actual_client_id')::uuid,
    (member->>'family_root_id')::uuid,(member->>'source_work_event_id')::uuid,(member->>'source_row_id')::uuid,
    array(select value from jsonb_array_elements_text(member->'component_keys')),member->'supported_quantities',member->'excluded_quantities',member->>'branch',
    member->'invoice_certificate',array(select value::uuid from jsonb_array_elements_text(member->'selected_issue_ids')),disposition);
  end if;
 end loop;
 publications:=private.bpay_next_source_pay_decision_publish_v1(d.id);
 if not private.weekly_exceptional_json_keys_exact_v1(publications,array['decision_id','cut_id','commands','publication_digest'])
   or not(publications ?& array['decision_id','cut_id','commands','publication_digest']) or publications->>'decision_id' is distinct from d.id::text
   or publications->>'cut_id' is distinct from app.cut_id::text or jsonb_typeof(publications->'commands') is distinct from 'array'
   or coalesce(publications->>'publication_digest','') !~ '^[0-9a-f]{64}$' then raise exception 'SOURCE_PAY_DECISION_PUBLICATION_PRODUCER_INVALID' using errcode='23514';end if;
 select coalesce(jsonb_agg(jsonb_build_object('candidate_id',p.candidate_id,'command_id',p.command_id,'member_count',p.member_count,'manifest_sha256',encode(p.manifest_sha256,'hex'))
  order by p.candidate_id),'[]'::jsonb) into expected_commands from private.bpay_next_source_pay_decision_publication p
  join private.bpay_next_command cmd on cmd.id=p.command_id and cmd.command_kind='SOURCE_PAY_DECISION_APPLY' and cmd.status in('SEALED','COMPLETE') and cmd.sealed_at_utc is not null
  join private.bpay_next_command_member cm on cm.command_id=cmd.id and cm.candidate_id=p.candidate_id where p.application_id=app.id and p.cut_id=app.cut_id and p.decision_id=d.id;
 if publications->'commands' is distinct from expected_commands then raise exception 'SOURCE_PAY_DECISION_PUBLICATION_PRODUCER_INVALID' using errcode='23514';end if;
 perform private.weekly_source_pay_decision_bind_publication_v1(app.id);
 contacts:=private.weekly_source_pay_decision_contact_retire_v1(app.id);
 for member in select value from jsonb_array_elements(review_public->'members') order by value->>'member_key' loop
  select x.value into strict selected from jsonb_array_elements(r.private_manifest_json->'selection') x where x.value->>'member_key'=member->>'member_key';
  select x.* into strict stored from private.weekly_source_pay_decision_members x where x.decision_id=d.id and x.member_key=member->>'member_key';
  select x.* into adoption from private.weekly_source_pay_decision_native_adoptions x where x.application_id=app.id and x.member_key=stored.member_key;
  select x.value into ref from jsonb_array_elements(p_request->'unprotect_preparations') x where x.value->>'member_key'=stored.member_key;
  failure:=coalesce(ref->>'status'='NOT_PREPARED',false) or coalesce(adoption.origin='NOT_APPLIED_DEPENDENCY',false);
  if failure then
   select x.* into prep from private.weekly_source_pay_decision_unprotect_preparations x where x.decision_id=d.id and x.member_key=stored.member_key and x.accept_or_resume_request_id=j.request_id;
   actions:=jsonb_build_object('kind','READ_RESULT','target_type','SOURCE_PAY_DECISION','target_id',d.id,'caption','Check saved result',
    'url','/api/weekly-source/pay-decisions/'||d.id::text||'?request_id='||j.request_id::text,'enabled',true,'disabled_reason',null);
   if prep.orchestration_run_id is not null then
    actions:=actions||jsonb_build_object('target_type','NATIVE_UNPROTECT_RUN','target_id',prep.orchestration_run_id,
      'caption','Check saved Unprotect result','decision_id',d.id,'member_key',stored.member_key);
   end if;
   release:=jsonb_build_object('status','PROTECTION_RELEASE_REQUIRED','preparation_id',prep.id,'orchestration_run_id',prep.orchestration_run_id,'native_receipt_hash',null,'next_action',actions);
  elsif adoption.application_id is not null then
   release:=jsonb_build_object('status','RELEASED','preparation_id',adoption.preparation_id,'orchestration_run_id',adoption.orchestration_run_id,
    'native_receipt_hash',encode(adoption.native_result_sha256,'hex'),'next_action',null);
  else release:=jsonb_build_object('status','NOT_REQUIRED','preparation_id',null,'orchestration_run_id',null,'native_receipt_hash',null,'next_action',null);end if;
  select case when bool_or(cm.qualification_state='REVIEW_REQUIRED') then 'REVIEW_REQUIRED' when bool_or(cm.qualification_state='QUALIFIED') then 'QUALIFIED' else 'NOT_APPROVED' end,
   coalesce(bool_or(cm.next_action='OPEN_DRAFT' or cm.comparable_held>0),false),coalesce(bool_or(cm.next_action='REVIEW_RECOVERY'),false)
   into qualification,held,recovery from private.bpay_next_source_pay_decision_cut_member cm where cm.cut_id=app.cut_id and cm.member_key=stored.member_key;
  pay_result:=case when failure or qualification='REVIEW_REQUIRED' or adoption.local_entitlement_kind='PENDING_BUNDLE' then 'FINANCIAL_PENDING'
   when recovery then 'EXISTING_RECOVERY_REQUIRED' when held then 'FROZEN_COMMITMENT_RETAINED'
   when d.decision_kind='ACCEPT_FINAL_SOURCE_PAY' then 'SOURCE_PAY_REVIEW_ACCEPTED' else 'FUTURE_PAY_EXCLUDED' end;
  invoice_result:=case member#>>'{invoice_certificate,phase}' when 'NO_FINAL_REPORT_YET' then 'NO_FINAL_REPORT_YET'
   when 'UNRESOLVED' then 'INVOICE_EVIDENCE_REQUIRED' when 'INVOICED' then 'UNCHANGED_SOURCE_INVOICE' else 'UNCHANGED_SOURCE_ALLOCATION' end;
  select x.value->'retired_issue_ids' into strict retired from jsonb_array_elements(contacts) x where x.value->>'member_key'=stored.member_key;
  receipt_members:=receipt_members||jsonb_build_array(jsonb_build_object('member_key',stored.member_key,'scope_kind',member->'scope_kind','scope_mode',member->'scope_mode',
   'family_root_id',member->'family_root_id','source_row_id',member->'source_row_id','source_work_event_id',member->'source_work_event_id','pay_disposition_id',stored.pay_disposition_id,
   'pay_result',pay_result,'invoice_result',invoice_result,'invoice_certificate',member->'invoice_certificate','protection_release',release,
   'retired_issue_ids',retired,'next_actions',member->'next_actions'));
 end loop;
 result:=jsonb_build_object('version','SOURCE_PAY_DECISION_RECEIPT_V1','decision_id',d.id,'request_id',j.request_id,'review_id',r.id,'state_revision',d.state_revision::text,
  'accepted_at_utc',transaction_timestamp(),'actor_user_id',actor,'reason',d.reason,'decision',d.decision_kind,'supersedes_decision_id',d.supersedes_decision_id,
  'prior_dispositions',body->'expected_prior_dispositions','prior_dispositions_sha256',body->'expected_prior_dispositions_sha256','members',receipt_members,
  'financial_publications',publications,'read_result_url','/api/weekly-source/pay-decisions/'||d.id::text||'?request_id='||j.request_id::text);
 update private.weekly_source_pay_decision_requests x set metadata_state='COMMITTED',receipt_json=result where x.request_id=j.request_id and x.metadata_state='CONFIRMED' and x.receipt_json is null;
 if not found then raise exception 'SOURCE_PAY_DECISION_REQUEST_CAS_FAILED' using errcode='40001';end if;
 if first_accept then
  update private.weekly_source_pay_decisions x set receipt_json=result where x.id=d.id and x.accept_request_id=j.request_id and x.receipt_json is null;
  if not found then raise exception 'SOURCE_PAY_DECISION_RECEIPT_CAS_FAILED' using errcode='40001';end if;
 end if;
 -- Original Source invoice equality + every final native/canonical/contact
 -- witness and request receipt, then COMMITTED, all in this same transaction.
 perform private.weekly_source_pay_decision_application_finish_v1(app.id);
 return result;
exception when no_data_found or too_many_rows or invalid_text_representation or numeric_value_out_of_range then
 raise exception 'SOURCE_PAY_DECISION_ACCEPT_SCOPE_INVALID' using errcode='23514';
end;
$function$;
revoke all on function public.weekly_source_pay_decision_accept_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_pay_decision_accept_v1(jsonb) to service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/41_atomic_source_acceptance.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/42_native_contact_reimport_match.sqlinc
create or replace function private.weekly_source_query_resolved_decision_matches_v1(
  p_source_group_id uuid,p_work_event_id uuid,p_issue jsonb
) returns boolean language sql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
  with latest as (
    select incident.state,incident.resolution_kind,incident.current_comparison_revision_id
    from public.weekly_discrepancy_incidents incident
    where incident.source_group_id=p_source_group_id and incident.work_event_id=p_work_event_id
    order by incident.episode_number desc,incident.id desc limit 1
  )
  select private.weekly_source_pay_decision_contact_suppressed_v1(p_source_group_id,p_work_event_id,p_issue)
    or coalesce((select latest.state='RESOLVED'
    and latest.resolution_kind in ('OFFICE_ACCEPTED_SYSTEM_HOURS','MANAGER_CONFIRMED_SYSTEM_HOURS','CANDIDATE_CORRECTED')
    and comparison.contract_id is not distinct from nullif(p_issue->>'contract_id','')::uuid
    and comparison.issue_family is not distinct from upper(btrim(p_issue->>'issue_family'))
    and comparison.source_presence is not distinct from upper(btrim(p_issue->>'source_presence'))
    and comparison.candidate_start_at_local is not distinct from nullif(p_issue->>'candidate_start_at_local','')::timestamp
    and comparison.candidate_end_at_local is not distinct from nullif(p_issue->>'candidate_end_at_local','')::timestamp
    and comparison.candidate_break_minutes is not distinct from nullif(p_issue->>'candidate_break_minutes','')::integer
    and comparison.system_start_at_local is not distinct from nullif(p_issue->>'system_start_at_local','')::timestamp
    and comparison.system_end_at_local is not distinct from nullif(p_issue->>'system_end_at_local','')::timestamp
    and comparison.system_break_minutes is not distinct from nullif(p_issue->>'system_break_minutes','')::integer
    from latest join public.weekly_issue_comparison_revisions comparison
      on comparison.id=latest.current_comparison_revision_id),false);
$function$;
revoke all on function private.weekly_source_query_resolved_decision_matches_v1(uuid,uuid,jsonb) from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/42_native_contact_reimport_match.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/43_current_native_action_preparation.sqlinc
create or replace function public.weekly_exceptional_pay_prepare_action_v1(
  p_request jsonb
) returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','extensions','pg_catalog','pg_temp'
as $function$
declare
  v_keys constant text[]:=array[
    'schema_version','actor_user_id','family_id','source_cycle_id','work_event_id',
    'action','expected_family_bound_version','protected_schedule','reason',
    'idempotency_key'
  ];
  v_schedule_keys constant text[]:=array[
    'work_date','start_at_local','end_at_local','break_minutes'
  ];
  v_actor uuid;
  v_family_id uuid;
  v_cycle_id uuid;
  v_event_id uuid;
  v_expected_version bigint;
  v_action text;
  v_reason text;
  v_key text;
  v_family public.weekly_exceptional_pay_target_families%rowtype;
  v_lock_family jsonb; v_lock_group uuid;
  v_cycle public.weekly_source_cycles%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_contract public.contracts%rowtype;
  v_event public.weekly_work_events%rowtype;
  v_latest_event public.weekly_exceptional_pay_family_events%rowtype;
  v_run public.weekly_exceptional_orchestration_runs%rowtype;
  v_request_hash bytea;
  v_before bytea;
  v_source_mode text; v_activated_source_mode text;
  v_policy jsonb;
  v_schedule jsonb;
  v_work_date date;
  v_start timestamp without time zone;
  v_end timestamp without time zone;
  v_break integer;
  v_replay boolean:=false;
  v_review_source jsonb;
  v_saved_route jsonb;v_placement jsonb;v_checked_placement jsonb;
begin
  if pg_catalog.jsonb_typeof(p_request)<>'object'
     or not private.weekly_exceptional_json_keys_exact_v1(p_request,
       v_keys||array['expected_source_hash','expected_source_revision'])
     or not (p_request ?& v_keys)
     or p_request->>'schema_version'<>'WEEKLY_PROTECTED_ACTION_PREPARE_V1' then
    raise exception 'WEEKLY_PROTECTED_ACTION_REQUEST_INVALID' using errcode='22023';
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_family_id:=(p_request->>'family_id')::uuid;
    v_cycle_id:=(p_request->>'source_cycle_id')::uuid;
    v_event_id:=(p_request->>'work_event_id')::uuid;
    v_expected_version:=(p_request->>'expected_family_bound_version')::bigint;
  exception when others then
    raise exception 'WEEKLY_PROTECTED_ACTION_REQUEST_INVALID' using errcode='22023';
  end;
  v_action:=pg_catalog.upper(pg_catalog.btrim(coalesce(p_request->>'action','')));
  v_reason:=pg_catalog.btrim(coalesce(p_request->>'reason',''));
  v_key:=pg_catalog.btrim(coalesce(p_request->>'idempotency_key',''));
  v_request_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_PREPARE_ACTION_REQUEST_V1',p_request
  );
  if v_action not in ('AMEND','WITHDRAW','WAIT','RECONCILE','RECORD_NOT_WORKED')
     or v_expected_version<1
     or pg_catalog.char_length(v_reason) not between 1 and 1000
     or pg_catalog.char_length(v_key) not between 16 and 200 then
    raise exception 'WEEKLY_PROTECTED_ACTION_REQUEST_INVALID' using errcode='22023';
  end if;

  v_saved_route:=private.weekly_source_protected_saved_prepare_route_v1(p_request,
    'WEEKLY_PROTECTED_PREPARE_ACTION_REQUEST_V1',v_action);
  if v_saved_route is not null then return v_saved_route; end if;
  perform private.weekly_source_pay_query_admit_v2();
  v_placement:=private.weekly_source_protected_current_placement_v1(v_family_id,v_event_id,false);
  if v_placement->'moved'='true'::jsonb then
    perform private.timesheet_contract_move_family_lock_v1((v_placement->>'original_root_timesheet_id')::uuid);
    select jsonb_build_object('root_timesheet_id',f.root_timesheet_id,'candidate_id',f.candidate_id,
      'contract_id',f.contract_id,'week_ending_date',f.week_ending_date) into strict v_lock_family
      from public.weekly_exceptional_pay_target_families f where f.id=v_family_id;
  else v_lock_family:=private.weekly_source_protected_family_lock_v1(v_family_id);end if;
  v_checked_placement:=private.weekly_source_protected_current_placement_v1(v_family_id,v_event_id,false);
  if v_checked_placement is distinct from v_placement then
    raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001';end if;
  -- Share the same global idempotency lock as first approval.  Concurrent
  -- first attempts for one key therefore become one write plus one exact
  -- replay instead of leaking the ledger's unique constraint.
  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended(
    'weekly-exceptional-orchestration|'||v_key,0
  ));

  select run.* into v_run
  from public.weekly_exceptional_orchestration_runs run
  where run.idempotency_key=v_key for update;
  v_replay:=found;

  select family.* into strict v_family
  from public.weekly_exceptional_pay_target_families family
  where family.id=v_family_id for update;
  if (v_family.root_timesheet_id::text,v_family.candidate_id::text,v_family.contract_id::text,v_family.week_ending_date::text)
    is distinct from (v_lock_family->>'root_timesheet_id',v_lock_family->>'candidate_id',
      v_lock_family->>'contract_id',v_lock_family->>'week_ending_date') then
    raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001'; end if;
  v_lock_group:=private.weekly_source_protected_group_lock_v1(v_cycle_id);
  select cycle.* into strict v_cycle
  from public.weekly_source_cycles cycle where cycle.id=v_cycle_id for share;
  if v_cycle.source_group_id is distinct from v_lock_group then
    raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001'; end if;
  select source_group.* into strict v_group
  from public.weekly_source_groups source_group
  where source_group.id=v_cycle.source_group_id and source_group.active for share;
  select contract.* into strict v_contract
  from public.contracts contract where contract.id=v_family.contract_id for share;
  select work_event.* into strict v_event
  from public.weekly_work_events work_event
  where work_event.id=v_event_id
    and work_event.candidate_id=v_family.candidate_id
    and work_event.client_id=v_contract.client_id
    and work_event.work_date between v_family.week_start_date and v_family.week_ending_date
  for share;
  select family_event.* into strict v_latest_event
  from public.weekly_exceptional_pay_family_events family_event
  where family_event.family_id=v_family.id
    and family_event.durable_work_event_id=v_event.id
  order by family_event.event_sequence desc
  limit 1
  for share;

  if v_action='AMEND' then
    if pg_catalog.jsonb_typeof(p_request->'protected_schedule')<>'object'
       or not private.weekly_exceptional_json_keys_exact_v1(
         p_request->'protected_schedule',v_schedule_keys
       )
       or not ((p_request->'protected_schedule') ?& v_schedule_keys) then
      raise exception 'WEEKLY_PROTECTED_ACTION_SCHEDULE_INVALID' using errcode='22023';
    end if;
    v_schedule:=p_request->'protected_schedule';
    begin
      v_work_date:=(v_schedule->>'work_date')::date;
      v_start:=(v_schedule->>'start_at_local')::timestamp without time zone;
      v_end:=(v_schedule->>'end_at_local')::timestamp without time zone;
      v_break:=(v_schedule->>'break_minutes')::integer;
    exception when others then
      raise exception 'WEEKLY_PROTECTED_ACTION_SCHEDULE_INVALID' using errcode='22023';
    end;
    if v_work_date<>v_event.work_date or v_start::date<>v_work_date
       or v_end<=v_start or v_break<0
       or v_break>=extract(epoch from (v_end-v_start))/60 then
      raise exception 'WEEKLY_PROTECTED_ACTION_SCHEDULE_INVALID' using errcode='22023';
    end if;
  else
    if p_request->'protected_schedule'<>'null'::jsonb then
      raise exception 'WEEKLY_PROTECTED_ACTION_SCHEDULE_FORBIDDEN' using errcode='22023';
    end if;
    v_schedule:=pg_catalog.jsonb_build_object(
      'work_date',v_latest_event.work_date,
      'start_at_local',v_latest_event.start_at_local,
      'end_at_local',v_latest_event.end_at_local,
      'break_minutes',v_latest_event.break_minutes
    );
  end if;
  perform private.weekly_source_office_authority_v1(
    v_actor,'APPROVE_PROTECTED_PAY',v_group.id,v_contract.client_id,v_cycle.finalisation_week_ending
  );
  v_policy:=private._weekly_source_effective_policy_v1(
    v_contract.client_id,v_contract.id,v_event.work_date
  );
  v_activated_source_mode:=private.weekly_source_protected_non_self_bill_mode_v1(v_contract.client_id,v_contract.id,v_event.work_date,v_cycle.id,v_actor,v_event.id);
  v_source_mode:=coalesce(v_policy->>'c1_source_mode',v_activated_source_mode);
  if v_family.agency_id is distinct from v_group.agency_id
     or v_family.root_timesheet_id is null
     or v_family.ownership_state<>'TARGET_MANAGED'
     or v_contract.candidate_id is distinct from v_family.candidate_id
     or not exists(
       select 1 from public.weekly_source_group_clients membership
       where membership.source_group_id=v_group.id
         and membership.client_id=v_contract.client_id
         and v_cycle.finalisation_week_ending between membership.valid_from and coalesce(membership.valid_to,'infinity'::date)
     )
     or v_policy->>'authority_mode'<>'SOURCE_AUTHORITY'
     or (coalesce((v_policy->>'self_bill_enabled')::boolean,false) is not true and v_activated_source_mode is null)
     or v_source_mode not in ('NHSP_WEEKLY','HEALTHROSTER_WEEKLY')
     or (v_group.source_family='NHSP') is distinct from (v_source_mode='NHSP_WEEKLY')
     or v_latest_event.id is null then
    raise exception 'WEEKLY_PROTECTED_ACTION_SCOPE_INVALID' using errcode='55000';
  end if;

  if v_replay then
    if v_run.family_id is distinct from v_family.id
       or v_run.request_kind is distinct from v_action
       or v_run.requested_by_user_id is distinct from v_actor
       or v_run.request_fingerprint is distinct from v_request_hash then
      raise exception 'WEEKLY_PROTECTED_ACTION_IDEMPOTENCY_COLLISION' using errcode='23505';
    end if;
    return pg_catalog.jsonb_build_object(
      'ok',true,'outcome','PREPARED','family_id',v_family.id,
      'orchestration_run_id',v_run.id,'source_cycle_id',v_cycle.id,
      'source_group_id',v_group.id,'agency_id',v_group.agency_id,
      'candidate_id',v_family.candidate_id,'client_id',v_contract.client_id,
      'contract_id',v_family.contract_id,'root_timesheet_id',v_family.root_timesheet_id,
      'work_event_id',v_event.id,'week_start_date',v_family.week_start_date,
      'week_ending_date',v_family.week_ending_date,'source_mode',v_source_mode,
      'family_bound_version',v_expected_version,'request_kind',v_action,
      'protected_schedule',v_schedule,'run_state',v_run.state,
      'idempotent_replay',true
    );
  end if;

  if v_family.current_generation_id is null
     or v_family.current_lifecycle_state not in (
       'PROTECTED','WAITING_SOURCE','READY_TO_RECONCILE','RECONCILED','NOT_WORKED','ACTION_REQUIRED'
     )
     or v_family.c1_publication_state in ('PENDING','PUBLISHING')
     or v_family.bound_version<>v_expected_version then
    -- A business-version refusal is not a retryable PostgreSQL serialization
    -- failure. PostgREST 14 retries 40001, so return the same refusal as HTTP
    -- conflict without repeating the request or creating an orchestration run.
    raise exception 'WEEKLY_PROTECTED_ACTION_STALE' using errcode='PT409';
  end if;

  -- A new Office review is bound to the exact final-source observation shown.
  -- Refuse before creating a run; old callers and exact saved replays retain
  -- their original request shape and fingerprint.
  if p_request ? 'expected_source_hash' or p_request ? 'expected_source_revision' then
    if v_action<>'RECONCILE'
      or coalesce(p_request->>'expected_source_hash','') !~ '^[0-9a-f]{64}$'
      or coalesce(p_request->>'expected_source_revision','') !~ '^[0-9a-f-]{36}$' then
      raise exception 'WEEKLY_PROTECTED_ACTION_REQUEST_INVALID' using errcode='22023';
    end if;
    v_review_source:=private.weekly_source_protected_final_source_context_v1(v_family.id,v_cycle.id,v_event.id);
    if not coalesce((v_review_source->>'source_observed')::boolean,false)
      or v_review_source#>>'{source_proposal,source_hash}' is distinct from p_request->>'expected_source_hash'
      or v_review_source#>>'{source_proposal,source_revision}' is distinct from p_request->>'expected_source_revision' then
      raise exception 'WEEKLY_PROTECTED_REVIEW_SOURCE_CHANGED' using errcode='40001';
    end if;
  end if;

  v_before:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_PROTECTED_ACTION_PREPARE_BEFORE_V1',
    pg_catalog.jsonb_build_object(
      'family_id',v_family.id,'family_bound_version',v_family.bound_version,
      'current_generation_id',v_family.current_generation_id,
      'current_generation_number',v_family.current_generation_number,
      'current_target_vector_hash',pg_catalog.encode(v_family.current_complete_target_vector_hash,'hex'),
      'source_cycle_id',v_cycle.id,'source_group_id',v_group.id,
      'work_event_id',v_event.id,'action',v_action,'actor_user_id',v_actor,
      'protected_schedule',v_schedule,'reason',v_reason
    )||case when v_placement->'moved'='true'::jsonb
      then jsonb_build_object('accepted_current_placement',v_placement) else '{}'::jsonb end
  );
  insert into public.weekly_exceptional_orchestration_runs(
    family_id,request_kind,idempotency_key,requested_by_user_id,state,
    request_fingerprint,before_state_fingerprint
  ) values (
    v_family.id,v_action,v_key,v_actor,'RUNNING',v_request_hash,v_before
  ) returning * into v_run;
  return pg_catalog.jsonb_build_object(
    'ok',true,'outcome','PREPARED','family_id',v_family.id,
    'orchestration_run_id',v_run.id,'source_cycle_id',v_cycle.id,
    'source_group_id',v_group.id,'agency_id',v_group.agency_id,
    'candidate_id',v_family.candidate_id,'client_id',v_contract.client_id,
    'contract_id',v_family.contract_id,'root_timesheet_id',v_family.root_timesheet_id,
    'work_event_id',v_event.id,'week_start_date',v_family.week_start_date,
    'week_ending_date',v_family.week_ending_date,'source_mode',v_source_mode,
    'family_bound_version',v_family.bound_version,'request_kind',v_action,
    'protected_schedule',v_schedule,'run_state',v_run.state,
    'idempotent_replay',v_replay
  );
exception
  when no_data_found or too_many_rows then
    raise exception 'WEEKLY_PROTECTED_ACTION_SCOPE_INVALID' using errcode='55000';
end;
$function$;
revoke all on function public.weekly_exceptional_pay_prepare_action_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_exceptional_pay_prepare_action_v1(jsonb) to service_role;

-- Existing native action prepare before-state domain, with the actual moved
-- certificate sealed only for the new moved branch. No existing native receipt
-- or unmoved hash semantics changes. First APPROVE has its own prepare owner;
-- its different before-state hash is not reinterpreted by this helper.
create or replace function private.weekly_source_protected_action_placement_assert_v1(p_request jsonb,p_placement jsonb)
returns void language plpgsql volatile security definer set search_path=pg_catalog,private,public as $function$
declare run public.weekly_exceptional_orchestration_runs%rowtype;
 family public.weekly_exceptional_pay_target_families%rowtype;
 cycle public.weekly_source_cycles%rowtype;before_hash bytea;
begin
 if p_placement->'moved' is distinct from 'true'::jsonb then return;end if;
 select r.* into strict run from public.weekly_exceptional_orchestration_runs r where r.id=(p_request->>'orchestration_run_id')::uuid;
 if run.request_kind='APPROVE' then return;end if;
 select f.* into strict family from public.weekly_exceptional_pay_target_families f where f.id=run.family_id;
 select c.* into strict cycle from public.weekly_source_cycles c where c.id=(p_request->>'source_cycle_id')::uuid;
 if run.request_kind not in('AMEND','WITHDRAW','WAIT','RECONCILE','RECORD_NOT_WORKED')
  or run.state<>'RUNNING' or run.requested_by_user_id::text is distinct from p_request->>'actor_user_id'
  or family.id::text is distinct from p_request->>'family_id'
  or family.bound_version::text is distinct from p_request->>'expected_family_bound_version'
  or p_placement is distinct from private.weekly_source_protected_current_placement_v1(
    family.id,(p_request->>'work_event_id')::uuid,false) then
  raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001';end if;
 before_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_ACTION_PREPARE_BEFORE_V1',jsonb_build_object(
   'family_id',family.id,'family_bound_version',family.bound_version,
   'current_generation_id',family.current_generation_id,'current_generation_number',family.current_generation_number,
   'current_target_vector_hash',encode(family.current_complete_target_vector_hash,'hex'),
   'source_cycle_id',cycle.id,'source_group_id',cycle.source_group_id,
   'work_event_id',(p_request->>'work_event_id')::uuid,'action',run.request_kind,'actor_user_id',run.requested_by_user_id,
   'protected_schedule',p_request->'protected_schedule','reason',btrim(p_request->>'reason'),
   'accepted_current_placement',p_placement));
 if before_hash is distinct from run.before_state_fingerprint then
  raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001';end if;
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'WEEKLY_SOURCE_PROTECTED_LOCK_SCOPE_CHANGED' using errcode='40001';
end;
$function$;
revoke all on function private.weekly_source_protected_action_placement_assert_v1(jsonb,jsonb)
 from public,anon,authenticated,service_role;
notify pgrst,'reload schema';

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/43_current_native_action_preparation.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/44_strict_native_snapshot_validation.sqlinc
-- Pure structural/current-input validation of the actual native calculator
-- snapshot. Does not calculate financial values or author a policy/receipt hash.
create or replace function private.weekly_source_pay_decision_native_snapshot_assert_v1(p_snapshot jsonb,p_facts jsonb)
returns void language plpgsql immutable security definer set search_path=pg_catalog,private,public as $function$
declare required constant text[]:=array['timesheet_id','timesheet_version','basis','candidate_id','client_id','role','band','pay_method','policy_snapshot_json','rate_source_refs_json','hours_day','hours_night','hours_sat','hours_sun','hours_bh','total_hours','pay_day','pay_night','pay_sat','pay_sun','pay_bh','charge_day','charge_night','charge_sat','charge_sun','charge_bh','additional_units_json','additional_pay_ex_vat','additional_charge_ex_vat','additional_margin_ex_vat','total_pay_ex_vat','total_charge_ex_vat','margin_ex_vat','expenses_pay_ex_vat','expenses_charge_ex_vat','expenses_description','expenses_evidence_r2_key','expenses_evidence_manifest','mileage_units','mileage_pay_ex_vat','mileage_charge_ex_vat','mileage_evidence_r2_key','mileage_evidence_manifest','mileage_pay_rate','mileage_charge_rate','candidate_assignment','processing_status','invoice_breakdown_json'];
 policy jsonb;breakdown jsonb;segment jsonb;item jsonb;identity jsonb;event text;seen text[]:='{}';
 keys text[];next_route boolean;preview jsonb;bucket text;
begin
 policy:=case when p_facts#>'{protected_current_placement,moved}'='true'::jsonb
  then p_facts#>'{current_entitlement,timesheet,settings_authority_json,values}' else p_facts->'policy' end;
 policy:=policy-'resolved_at_utc';next_route:=p_facts->'next_source_segments' is distinct from 'null'::jsonb;
 if not private.weekly_exceptional_json_keys_exact_v1(p_snapshot,required||array['hr_crosscheck_status','hr_crosscheck_issues','external_source_rows_json'])
  or not(p_snapshot ?& required) or jsonb_typeof(policy) is distinct from 'object'
  or p_snapshot->'timesheet_id' is distinct from p_facts#>'{current_entitlement,timesheet,timesheet_id}'
  or p_snapshot->'timesheet_version' is distinct from p_facts#>'{current_entitlement,timesheet,version}'
  or p_snapshot->'candidate_id' is distinct from p_facts->'candidate_id' or p_snapshot->'client_id' is distinct from p_facts->'client_id'
  or p_snapshot->'policy_snapshot_json' is distinct from policy
  or p_snapshot->'rate_source_refs_json' is distinct from jsonb_build_object('mode','CONTRACT_RATES_JSON',
    'contract_id',p_facts#>'{current_entitlement,contract_record,id}')
  or jsonb_typeof(p_snapshot->'basis') is distinct from 'string' or char_length(p_snapshot->>'basis')<1
  or p_snapshot->>'candidate_assignment' is distinct from 'ASSIGNED'
  or coalesce(p_snapshot->>'processing_status','') not in('PENDING_AUTH','READY_FOR_INVOICE')
  or jsonb_typeof(p_snapshot->'additional_units_json') is distinct from 'object'
  or exists(select 1 from unnest(array['total_hours','hours_day','hours_night','hours_sat','hours_sun','hours_bh','additional_pay_ex_vat','additional_charge_ex_vat','additional_margin_ex_vat','total_pay_ex_vat','total_charge_ex_vat','margin_ex_vat','expenses_pay_ex_vat','expenses_charge_ex_vat','mileage_units','mileage_pay_ex_vat','mileage_charge_ex_vat']) k where jsonb_typeof(p_snapshot->k) is distinct from 'number')
  or exists(select 1 from unnest(array['pay_day','charge_day','pay_night','charge_night','pay_sat','charge_sat','pay_sun','charge_sun','pay_bh','charge_bh']) k where jsonb_typeof(p_snapshot->k) not in('number','null'))
  or exists(select 1 from unnest(array['role','band','pay_method','expenses_description','expenses_evidence_r2_key','mileage_evidence_r2_key']) k
    where jsonb_typeof(p_snapshot->k) not in('string','null'))
  or exists(select 1 from unnest(array['expenses_evidence_manifest','mileage_evidence_manifest']) k
    where jsonb_typeof(p_snapshot->k) not in('object','array','null'))
  or exists(select 1 from unnest(array['mileage_pay_rate','mileage_charge_rate']) k where jsonb_typeof(p_snapshot->k) not in('number','string','null')
    or (jsonb_typeof(p_snapshot->k)='string' and (p_snapshot->>k) !~ '^-?(0|[1-9][0-9]*)(\.[0-9]+)?$'))
  or (p_snapshot ? 'hr_crosscheck_status' and jsonb_typeof(p_snapshot->'hr_crosscheck_status') not in('string','null'))
  or (p_snapshot ? 'external_source_rows_json' and jsonb_typeof(p_snapshot->'external_source_rows_json') is distinct from 'object') then
  raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
 if p_snapshot ? 'hr_crosscheck_issues' and p_snapshot->'hr_crosscheck_issues'<>'null'::jsonb then
  if jsonb_typeof(p_snapshot->'hr_crosscheck_issues') is distinct from 'array' then
   raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
  if exists(select 1 from jsonb_array_elements(p_snapshot->'hr_crosscheck_issues') x where jsonb_typeof(x) is distinct from 'string') then
   raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
 end if;
 breakdown:=p_snapshot->'invoice_breakdown_json';
 if not private.weekly_exceptional_json_keys_exact_v1(breakdown,array['mode','segments','totals','additional'])
  or not(breakdown ?& array['mode','segments','totals']) or breakdown->>'mode' is distinct from 'SEGMENTS'
  or jsonb_typeof(breakdown->'segments') is distinct from 'array'
  or not private.weekly_exceptional_json_keys_exact_v1(breakdown->'totals',array['total_pay_ex_vat','total_charge_ex_vat','margin_ex_vat'])
  or not((breakdown->'totals') ?& array['total_pay_ex_vat','total_charge_ex_vat','margin_ex_vat'])
  or exists(select 1 from unnest(array['total_pay_ex_vat','total_charge_ex_vat','margin_ex_vat']) k
    where jsonb_typeof(breakdown->'totals'->k) is distinct from 'number' or breakdown->'totals'->k is distinct from p_snapshot->k) then
  raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
 if breakdown ? 'additional' then
  item:=breakdown->'additional';
  if not private.weekly_exceptional_json_keys_exact_v1(item,array['units','pay_ex_vat','charge_ex_vat','margin_ex_vat'])
   or not(item ?& array['units','pay_ex_vat','charge_ex_vat','margin_ex_vat']) or item->'units' is distinct from p_snapshot->'additional_units_json'
   or exists(select 1 from unnest(array['pay_ex_vat','charge_ex_vat','margin_ex_vat']) k
    where jsonb_typeof(item->k) is distinct from 'number' or item->k is distinct from p_snapshot->('additional_'||k)) then
   raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
 end if;
 for segment in select value from jsonb_array_elements(breakdown->'segments') loop
  keys:=array['segment_id','date','start','end','overnight','start_utc','end_utc','break_mins','ref_num','breaks','hours_day','hours_night','hours_sat','hours_sun','hours_bh','pay_amount','charge_amount','is_reversal','exclude_from_pay']||case when next_route then array['work_event_id','protected_target_state'] else array['weekly_protected_component_identity'] end;
  if not private.weekly_exceptional_json_keys_exact_v1(segment,keys||array['invoice_target_week_start','invoice_locked_invoice_id']
    ||case when next_route then array['protected_next_preview'] else '{}'::text[] end) or not(segment ?& keys)
   or jsonb_typeof(segment->'segment_id') is distinct from 'string' or char_length(segment->>'segment_id')<1
   or coalesce(segment->>'date','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
   or coalesce(segment->>'start','') !~ '^([01][0-9]|2[0-3]):[0-5][0-9]$' or coalesce(segment->>'end','') !~ '^([01][0-9]|2[0-3]):[0-5][0-9]$'
   or coalesce(segment->>'start_utc','') !~ '(Z|[+-][0-9]{2}:[0-9]{2})$' or coalesce(segment->>'end_utc','') !~ '(Z|[+-][0-9]{2}:[0-9]{2})$'
   or exists(select 1 from unnest(array['overnight','is_reversal','exclude_from_pay']) k where jsonb_typeof(segment->k) is distinct from 'boolean')
   or jsonb_typeof(segment->'break_mins') is distinct from 'number' or coalesce(segment->>'break_mins','') !~ '^(0|[1-9][0-9]*)$'
   or jsonb_typeof(segment->'ref_num') not in('string','null') or jsonb_typeof(segment->'breaks') is distinct from 'array'
   or exists(select 1 from unnest(array['hours_day','hours_night','hours_sat','hours_sun','hours_bh','pay_amount','charge_amount']) k where jsonb_typeof(segment->k) is distinct from 'number') then
   raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
  perform (segment->>'date')::date;perform (segment->>'start_utc')::timestamptz;perform (segment->>'end_utc')::timestamptz;
  if segment ? 'invoice_target_week_start' then
   if jsonb_typeof(segment->'invoice_target_week_start') is distinct from 'string' or coalesce(segment->>'invoice_target_week_start','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' then
    raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
   perform (segment->>'invoice_target_week_start')::date;end if;
  if segment ? 'invoice_locked_invoice_id' then
   if jsonb_typeof(segment->'invoice_locked_invoice_id') is distinct from 'string' or coalesce(segment->>'invoice_locked_invoice_id','') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then
    raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
   perform (segment->>'invoice_locked_invoice_id')::uuid;end if;
  for item in select value from jsonb_array_elements(segment->'breaks') loop
   if not private.weekly_exceptional_json_keys_exact_v1(item,array['start','end']) or not(item ?& array['start','end'])
    or coalesce(item->>'start','') !~ '^([01][0-9]|2[0-3]):[0-5][0-9]$' or coalesce(item->>'end','') !~ '^([01][0-9]|2[0-3]):[0-5][0-9]$' then
    raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
  end loop;
  identity:=segment->'weekly_protected_component_identity';
  event:=case when next_route then segment->>'work_event_id' else identity->>'work_event_id' end;
  if coalesce(event,'') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' or event=any(seen) then
   raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;seen:=array_append(seen,event);
  if not next_route then
   if not private.weekly_exceptional_json_keys_exact_v1(identity,array['schema_version','work_event_id']) or not(identity ?& array['schema_version','work_event_id'])
    or identity->>'schema_version' is distinct from 'WEEKLY_PROTECTED_COMPONENT_IDENTITY_V1' or segment->>'segment_id' is distinct from 'weekly-source-event:'||event then
    raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
  elsif coalesce(segment->>'protected_target_state','') not in('WAIT','SOURCE','ACCEPTED_SOURCE') then
   raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';
  elsif segment->>'protected_target_state'='WAIT' then
   preview:=segment->'protected_next_preview';
   keys:=array['schema_version','calculator_owner','calculator_version','mode','category','sign','bucket_minutes','paid_minutes','break_minutes','hours','rates','charge_rates','pay_ex_vat','charge_ex_vat'];
   if not private.weekly_exceptional_json_keys_exact_v1(preview,keys) or not(preview ?& keys)
    or preview->>'schema_version' is distinct from 'WEEKLY_PROTECTED_NEXT_PREVIEW_V1' or preview->>'calculator_owner' is distinct from 'buildWeeklyScheduleSegmentsSnapshot'
    or preview->>'calculator_version' is distinct from 'WEEKLY_SHIFT_FINANCIAL_SEGMENT_V1' or coalesce(preview->>'mode','') not in('SPLIT_RATE_WINDOWS','WHOLE_SHIFT_START_DAY')
    or (preview->>'mode'='SPLIT_RATE_WINDOWS' and preview->'category' is distinct from 'null'::jsonb)
    or (preview->>'mode'='WHOLE_SHIFT_START_DAY' and coalesce(preview->>'category','') not in('day','night','sat','sun','bh'))
    or preview->'sign' not in('1'::jsonb,'-1'::jsonb)
    or exists(select 1 from unnest(array['paid_minutes','break_minutes']) k where jsonb_typeof(preview->k) is distinct from 'number' or coalesce(preview->>k,'') !~ '^(0|[1-9][0-9]*)$')
    or exists(select 1 from unnest(array['pay_ex_vat','charge_ex_vat']) k where jsonb_typeof(preview->k) is distinct from 'string' or coalesce(preview->>k,'') !~ '^-?(0|[1-9][0-9]*)\.[0-9]{2}$') then
    raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
   foreach bucket in array array['bucket_minutes','hours','rates','charge_rates'] loop
    if not private.weekly_exceptional_json_keys_exact_v1(preview->bucket,array['day','night','sat','sun','bh'])
     or not((preview->bucket) ?& array['day','night','sat','sun','bh']) then raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
   end loop;
   foreach bucket in array array['day','night','sat','sun','bh'] loop
    if jsonb_typeof(preview->'bucket_minutes'->bucket) is distinct from 'number' or coalesce(preview->'bucket_minutes'->>bucket,'') !~ '^(0|[1-9][0-9]*)$'
     or jsonb_typeof(preview->'hours'->bucket) is distinct from 'string' or coalesce(preview->'hours'->>bucket,'') !~ '^-?(0|[1-9][0-9]*)(\.[0-9]+)?$'
     or exists(select 1 from unnest(array['rates','charge_rates']) k where jsonb_typeof(preview->k->bucket) not in('string','null')
       or (jsonb_typeof(preview->k->bucket)='string' and (preview->k->>bucket) !~ '^-?(0|[1-9][0-9]*)(\.[0-9]+)?$')) then
     raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
   end loop;
  elsif segment ? 'protected_next_preview' then raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';end if;
 end loop;
exception when invalid_text_representation or datetime_field_overflow or numeric_value_out_of_range then
 raise exception 'SOURCE_NATIVE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_native_snapshot_assert_v1(jsonb,jsonb)
 from public,anon,authenticated,service_role;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/forward/44_strict_native_snapshot_validation.sqlinc

-- BEGIN exact selected d863577918ce7d439206296e91ad78de298e98b2:docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/native-entry/weekly_exceptional_pay_next_publication_status_v1.sqlinc
create or replace function public.weekly_exceptional_pay_next_publication_status_v1(
  p_request jsonb
) returns jsonb language plpgsql stable security definer
set search_path=pg_catalog,private,public
as $function$
declare
  v_source_gate jsonb;
  v_run public.weekly_exceptional_orchestration_runs%rowtype;
  v_family public.weekly_exceptional_pay_target_families%rowtype;
  v_receipt private.bpay_next_protected_source_receipt%rowtype;
  v_actor uuid;
  v_approval public.weekly_exceptional_payment_approvals%rowtype;
  v_group uuid;
  v_local jsonb;
begin
  if coalesce(nullif(pg_catalog.current_setting('request.jwt.claim.role',true),''),
      nullif(pg_catalog.current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception using errcode='42501',message='BPAY_NEXT_SERVICE_REQUIRED';
  end if;
  if pg_catalog.jsonb_typeof(p_request)<>'object'
     or not private.weekly_exceptional_json_keys_exact_v1(p_request,
       array['schema_version','actor_user_id','family_id','orchestration_run_id'])
     or not (p_request ?& array['schema_version','actor_user_id','family_id','orchestration_run_id'])
     or p_request->>'schema_version'<>'WEEKLY_PROTECTED_NEXT_STATUS_V1' then
    raise exception using errcode='22023',message='BPAY_NEXT_PROTECTED_STATUS_INVALID';
  end if;
  v_actor:=(p_request->>'actor_user_id')::uuid;
  select f.* into strict v_family from public.weekly_exceptional_pay_target_families f
    where f.id=(p_request->>'family_id')::uuid;
  select r.* into strict v_run from public.weekly_exceptional_orchestration_runs r
    where r.id=(p_request->>'orchestration_run_id')::uuid and r.family_id=v_family.id;
  if v_run.requested_by_user_id is distinct from v_actor or not exists(
      select 1 from public.tms_users u where u.id=v_actor and u.is_active
        and (u.payment_authoriser or u.payment_golden_key)) then
    raise exception using errcode='42501',message='BPAY_NEXT_PROTECTED_ACTOR_REFUSED';
  end if;
  v_source_gate:=private.weekly_source_pay_decision_native_normal_gate_v1(v_family.id,v_run.id,v_actor,'STATUS');
  if v_source_gate is not null then return v_source_gate; end if;
  select r.* into v_receipt from private.bpay_next_protected_source_receipt r
    where r.orchestration_run_id=v_run.id;
  if found then
    if v_receipt.family_id<>v_family.id or v_receipt.actor_user_id<>v_actor
       or v_receipt.prepared_request_sha256 is distinct from v_run.request_fingerprint
       or v_run.state<>'COMPLETE'
       or exists(select 1 from private.weekly_source_local_protected_decision_receipts l
         join public.weekly_exceptional_c1_publication_requests request on request.id=l.publication_request_id
         where request.orchestration_run_id=v_run.id) then
      raise exception using errcode='23514',message='BPAY_NEXT_PROTECTED_RECEIPT_NOT_EXACT';
    end if;
    select a.* into strict v_approval from public.weekly_exceptional_payment_approvals a
      where a.id=v_receipt.approval_id;
    select c.source_group_id into strict v_group from public.weekly_source_cycles c
      where c.id=v_approval.source_cycle_id;
    perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',
      v_group,v_approval.client_id,v_approval.protected_work_date);
    return pg_catalog.jsonb_build_object('ok',true,'route','NEXT','published',true,
      'receipt',private.bpay_next_protected_receipt_json_v1(v_run.id,true));
  end if;
  -- Retain LEGACY fresh routing; accepted Local replay is independent of the
  -- current module. Its real Source helper, not a C1 staging-row label, owns it.
  if (select active_owner from private.bpay_next_module_control where id=1)<>'NEXT'
     and not exists(select 1 from private.weekly_source_local_protected_decision_receipts l
       join public.weekly_exceptional_c1_publication_requests request on request.id=l.publication_request_id
       where request.orchestration_run_id=v_run.id) then
    return pg_catalog.jsonb_build_object('ok',true,'route','C1','published',false,'receipt',null);
  end if;
  v_local:=private.bpay_next_protected_local_receipt_v1(v_family.id,v_run.id,v_actor);
  if v_local is not null then
    return pg_catalog.jsonb_build_object('ok',true,'route','SOURCE_LOCAL',
      'published',v_local->'banking_receipt'<>'null'::jsonb,'receipt',v_local);
  end if;
  if v_run.state<>'RUNNING' then
    raise exception using errcode='55000',message='BPAY_NEXT_PROTECTED_DOMAIN_UNSUPPORTED';
  end if;
  return pg_catalog.jsonb_build_object('ok',true,
    'route',private.bpay_next_protected_owner_route_v1(v_family.id),'published',false,'receipt',null);
exception when no_data_found or too_many_rows then
  raise exception using errcode='55000',message='BPAY_NEXT_PROTECTED_STATUS_SCOPE_INVALID';
end
$function$;

-- END exact selected docs/healthroster-build/proposals/source-pay-decision-v5-foundation-20261015/native-entry/weekly_exceptional_pay_next_publication_status_v1.sqlinc

