-- FINAL COMPLETE FUNCTION UNION. Mutually exclusive with component runtime modules.
create or replace function private.weekly_source_identical_rekey_prior_v1(p_upload_row_id uuid)
returns uuid language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_row public.weekly_source_upload_rows%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_profile public.weekly_source_format_profiles%rowtype;
  v_choice private.weekly_source_office_row_choices%rowtype;
  v_client uuid; v_candidate uuid; v_candidates uuid[];
  v_source_name text; v_source_id text; v_source_id_2 text; v_source_id_3 text;
  v_source_client text; v_norm_name text; v_norm_compact text;
  v_count bigint; v_prior uuid;
begin
  if p_upload_row_id is null then return null; end if;
  select * into v_row from public.weekly_source_upload_rows where id=p_upload_row_id;
  if not found then return null; end if;
  select * into strict v_upload from public.weekly_source_uploads where id=v_row.upload_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_upload.source_cycle_id;
  select * into strict v_profile from public.weekly_source_format_profiles where id=v_upload.source_format_profile_id;
  if not v_profile.active or v_profile.version<>1
    or not exists(select 1 from public.weekly_source_groups g where g.id=v_cycle.source_group_id and g.active and g.source_family='ROSTER')
    or v_upload.report_scope_id is not null
    or v_upload.state not in ('CURRENT','CORRECTION_READY') or v_upload.row_manifest_hash is null
    or v_upload.coverage_state is distinct from 'COMPLETE' or v_upload.coverage_timezone is distinct from 'Europe/London'
    or v_upload.confirmed_coverage_start_local_date is null or v_upload.confirmed_coverage_end_local_date is null
    or v_row.work_date not between v_upload.confirmed_coverage_start_local_date and v_upload.confirmed_coverage_end_local_date
    or nullif(btrim(v_row.external_source_key),'') is null or v_row.row_finalisation_state is distinct from 'SOURCE_WORKED'
    or v_row.start_at_local is null or v_row.end_at_local is null or v_row.end_at_local<=v_row.start_at_local
    or v_row.break_minutes is null or v_row.actual_net_minutes is null or v_row.actual_net_minutes<=0 then return null; end if;

  -- Real profile/normalizer ownership differs: HealthRoster requires literal
  -- finaliser indicators; a generic summary is a complete-file snapshot.
  if v_profile.profile_code in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1') then
    if v_profile.final_authority_kind is distinct from 'HEALTHROSTER_ACTUAL_ROWS'
      or v_profile.row_finalisation_capability is distinct from 'FINALISED_ROW_ONLY'
      or nullif(btrim(v_row.finalised_by),'') is null
      or v_row.bounded_raw_columns_json->>'finalised_by' is distinct from v_row.finalised_by then return null; end if;
  elsif v_profile.profile_code='ROSTER_WEEKLY_SUMMARY_ACTUAL_V1' then
    if v_profile.final_authority_kind is distinct from 'GENERIC_COMPLETE_SNAPSHOT'
      or v_profile.row_finalisation_capability is distinct from 'COMPLETE_FILE_ROWS' then return null; end if;
  else return null; end if;

  if exists(select 1 from public.weekly_work_events e
    where e.first_source_group_id=v_cycle.source_group_id and e.source_format_profile_id=v_profile.id
      and e.identity_kind='PROFILE_EXTERNAL_KEY' and e.profile_external_key=v_row.external_source_key) then return null; end if;

  select * into v_choice from private.weekly_source_office_row_choices
    where upload_row_id=v_row.id order by id desc limit 1;
  -- BUILD_PROJECTION's actual upload Client hint is first authority, including
  -- its existing sole-membership fallback. An Office row choice is explicit.
  begin v_client:=nullif(v_upload.file_metadata_json->>'client_id','')::uuid;
  exception when invalid_text_representation then return null; end;
  if v_client is null then
    select count(*),min(gc.client_id::text)::uuid into v_count,v_client
    from public.weekly_source_group_clients gc join public.clients c on c.id=gc.client_id
    where gc.source_group_id=v_cycle.source_group_id and v_cycle.finalisation_week_ending between gc.valid_from and coalesce(gc.valid_to,'infinity'::date);
    if v_count<>1 then v_client:=null; end if;
  end if;
  if v_choice.client_id is not null then v_client:=v_choice.client_id; end if;
  if v_client is null or (v_cycle.scope_client_id is not null and v_cycle.scope_client_id is distinct from v_client)
    or not private.weekly_source_upload_client_eligible_v1(v_upload.id,v_client,v_row.work_date)
    or not exists(select 1 from public.weekly_source_group_clients gc where gc.source_group_id=v_cycle.source_group_id
      and gc.client_id=v_client and v_cycle.finalisation_week_ending between gc.valid_from and coalesce(gc.valid_to,'infinity'::date)) then return null; end if;

  -- These literal saved-identity comparisons are the current upload-context
  -- comparisons, not a new Candidate name/key normalization authority.
  v_source_name:=nullif(btrim(coalesce(v_row.bounded_raw_columns_json->>'worker_name',v_row.bounded_raw_columns_json->>'candidate',v_row.source_candidate_identity)),'');
  v_source_id:=nullif(btrim(coalesce(v_row.bounded_raw_columns_json->>'worker_unique_id',v_row.bounded_raw_columns_json->>'candidate_id','')),'');
  v_source_id_2:=nullif(btrim(coalesce(v_row.bounded_raw_columns_json->>'candidate_uid','')),'');
  v_source_id_3:=nullif(btrim(coalesce(v_row.bounded_raw_columns_json->>'payroll_number','')),'');
  v_source_client:=nullif(btrim(coalesce(v_row.bounded_raw_columns_json->>'trust',v_row.source_client_identity)),'');
  v_norm_name:=lower(regexp_replace(btrim(coalesce(v_source_name,'')),'[[:space:]]+',' ','g'));
  v_norm_compact:=regexp_replace(v_norm_name,'[^a-z0-9]+','','g');
  select coalesce(array_agg(candidate_id order by candidate_id),'{}'::uuid[]) into v_candidates from (
    select distinct c.id candidate_id from public.candidates c where c.active and (
      (v_source_id is not null and lower(btrim(c.tms_ref))=lower(v_source_id))
      or (v_source_id_2 is not null and lower(btrim(c.tms_ref))=lower(v_source_id_2))
      or (v_source_id_3 is not null and lower(btrim(c.tms_ref))=lower(v_source_id_3))
      or exists(select 1 from jsonb_array_elements_text(case when jsonb_typeof(c.nhsp_hr_name_aliases)='array' then c.nhsp_hr_name_aliases else '[]'::jsonb end) alias(value)
        where lower(btrim(alias.value))=v_norm_name or regexp_replace(lower(alias.value),'[^a-z0-9]+','','g')=v_norm_compact)
      or exists(select 1 from public.hr_name_mappings m where m.active and m.candidate_id=c.id
        and (lower(btrim(m.hr_name_norm))=v_norm_name or regexp_replace(lower(m.hr_name_norm),'[^a-z0-9]+','','g')=v_norm_compact)
        and (nullif(btrim(coalesce(m.hospital_or_trust,'')),'') is null or lower(btrim(m.hospital_or_trust))=lower(btrim(coalesce(v_source_client,'')))))
    )
  ) saved;
  if v_choice.candidate_id is not null then
    select coalesce(array_agg(id),'{}'::uuid[]) into v_candidates from public.candidates where id=v_choice.candidate_id and active;
  end if;
  if cardinality(v_candidates)<>1 then return null; end if;
  v_candidate:=v_candidates[1];

  select count(*),min(e.id::text)::uuid into v_count,v_prior
  from public.weekly_work_events e
  join lateral(select r.* from public.weekly_source_row_resolutions r where r.work_event_id=e.id and r.mapping_state='RESOLVED'
    order by r.created_at_utc desc,r.id desc limit 1) prior on true
  join public.weekly_source_upload_rows old_row on old_row.id=prior.upload_row_id
  join public.contracts contract on contract.id=prior.contract_id and contract.candidate_id=v_candidate and contract.client_id=v_client
    and v_row.work_date between contract.start_date and coalesce(contract.end_date,'infinity'::date)
  where e.first_source_group_id=v_cycle.source_group_id and e.source_format_profile_id=v_profile.id
    and e.identity_kind='PROFILE_EXTERNAL_KEY' and e.candidate_id=v_candidate and e.client_id=v_client
    and prior.candidate_id=v_candidate and prior.client_id=v_client
    and e.work_date=v_row.work_date and old_row.work_date=v_row.work_date
    and old_row.start_at_local is not distinct from v_row.start_at_local
    and old_row.end_at_local is not distinct from v_row.end_at_local
    and old_row.break_minutes is not distinct from v_row.break_minutes
    and (v_choice.contract_id is null or prior.contract_id=v_choice.contract_id)
    and not exists(select 1 from public.weekly_source_upload_rows in_file
      where in_file.upload_id=v_upload.id and (in_file.external_source_key=e.profile_external_key
        or in_file.external_source_key=old_row.external_source_key
        or exists(select 1 from public.weekly_work_event_source_links prior_link
          join public.weekly_source_row_resolutions prior_resolution on prior_resolution.id=prior_link.row_resolution_id
            and prior_resolution.upload_row_id=prior_link.upload_row_id and prior_resolution.work_event_id=e.id
            and prior_resolution.mapping_state='RESOLVED' and prior_resolution.candidate_id=e.candidate_id and prior_resolution.client_id=e.client_id
          join public.weekly_source_upload_rows prior_row on prior_row.id=prior_link.upload_row_id
            and prior_row.external_source_key=in_file.external_source_key
          join public.weekly_source_uploads prior_upload on prior_upload.id=prior_row.upload_id
            and prior_upload.source_format_profile_id=v_profile.id
          join public.weekly_source_cycles prior_cycle on prior_cycle.id=prior_upload.source_cycle_id and prior_cycle.source_group_id=v_cycle.source_group_id
          where prior_link.work_event_id=e.id and prior_link.link_hash=private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_SOURCE_WORK_EVENT_LINK_V1',jsonb_build_object('work_event_id',prior_link.work_event_id,
              'upload_row_id',prior_link.upload_row_id,'resolution_id',prior_link.row_resolution_id,'link_kind',prior_link.link_kind)))));
  if v_count>1 then
    raise exception 'WEEKLY_SOURCE_IDENTICAL_REKEY_AMBIGUOUS' using errcode='55000',
      detail=jsonb_build_object('upload_row_id',v_row.id,'source_row_ordinal',v_row.source_row_ordinal,
        'candidate_id',v_candidate,'client_id',v_client,'work_date',v_row.work_date,
        'identical_prior_work_event_count',v_count)::text;
  end if;
  if v_count=0 then return null; end if;
  return v_prior;
end;
$function$;

create or replace function public.weekly_source_upload_context_v1(
  p_request jsonb
) returns jsonb
language plpgsql
stable
security definer
set search_path to 'public','private','extensions','pg_catalog','pg_temp'
as $function$
declare
  v_allowed constant text[]:=array[
    'operation','actor_user_id','source_group_id','source_cycle_id',
    'report_scope_id','client_id','upload_id'
  ]::text[];
  v_operation text;
  v_actor uuid;
  v_group_id uuid;
  v_cycle_id uuid;
  v_report_scope_id uuid;
  v_client_id uuid;
  v_row_client_id uuid;
  v_upload_id uuid;
  v_group public.weekly_source_groups%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_scope public.weekly_source_report_scopes%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_profile public.weekly_source_format_profiles%rowtype;
  v_source_row public.weekly_source_upload_rows%rowtype;
  v_office_choice private.weekly_source_office_row_choices%rowtype;
  v_paid_choice jsonb;v_paid_inputs jsonb;
  v_source_name text;
  v_source_id text;
  v_source_id_2 text;
  v_source_id_3 text;
  v_source_client text;
  v_norm_name text;
  v_norm_compact text;
  v_candidate_ids uuid[];
  v_candidate_id uuid;
  v_candidate_matches jsonb;
  v_contracts jsonb;
  v_prior_contract_id uuid;
  v_prior_work_event_id uuid;
  -- WP-37: the `24 §9` step-2 compatible-schedule set, counted explicitly.
  v_prior_candidate_count integer;
  v_rows jsonb:='[]'::jsonb;
  v_client_name text;
  v_client_choices jsonb:='[]'::jsonb;
  v_client_choice_count integer:=0;
  v_unknown text;
  v_coverage_context jsonb;
begin
  if coalesce(current_setting('request.jwt.claim.role',true),
       nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
  end if;
  if p_request is null or pg_catalog.jsonb_typeof(p_request)<>'object' then
    raise exception 'WEEKLY_SOURCE_CONTEXT_REQUEST_INVALID' using errcode='22023';
  end if;
  select key into v_unknown
  from pg_catalog.jsonb_object_keys(p_request) key
  where not key=any(v_allowed)
  order by key limit 1;
  if v_unknown is not null then
    raise exception 'WEEKLY_SOURCE_CONTEXT_UNKNOWN_FIELD'
      using errcode='22023',detail=v_unknown;
  end if;
  begin
    v_operation:=pg_catalog.upper(pg_catalog.btrim(coalesce(p_request->>'operation','')));
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_group_id:=nullif(p_request->>'source_group_id','')::uuid;
    v_cycle_id:=nullif(p_request->>'source_cycle_id','')::uuid;
    v_report_scope_id:=nullif(p_request->>'report_scope_id','')::uuid;
    v_client_id:=nullif(p_request->>'client_id','')::uuid;
    v_upload_id:=nullif(p_request->>'upload_id','')::uuid;
  exception when invalid_text_representation then
    raise exception 'WEEKLY_SOURCE_CONTEXT_REQUEST_INVALID' using errcode='22023';
  end;
  if v_actor is null or v_operation not in ('DISCOVER_SCOPE','BUILD_PROJECTION') then
    raise exception 'WEEKLY_SOURCE_CONTEXT_REQUEST_INVALID' using errcode='22023';
  end if;

  if v_operation='BUILD_PROJECTION' then
    if v_upload_id is null then
      raise exception 'WEEKLY_SOURCE_CONTEXT_UPLOAD_REQUIRED' using errcode='22023';
    end if;
    select * into v_upload from public.weekly_source_uploads where id=v_upload_id;
    if not found or v_upload.state not in ('CURRENT','CORRECTION_READY')
       or v_upload.row_manifest_hash is null then
      raise exception 'WEEKLY_SOURCE_CONTEXT_UPLOAD_NOT_SEALED' using errcode='55000';
    end if;
    v_cycle_id:=v_upload.source_cycle_id;
    v_report_scope_id:=v_upload.report_scope_id;
  elsif v_cycle_id is null then
    raise exception 'WEEKLY_SOURCE_CONTEXT_SCOPE_REQUIRED' using errcode='22023';
  end if;

  select * into v_cycle from public.weekly_source_cycles where id=v_cycle_id;
  if not found then
    raise exception 'WEEKLY_SOURCE_CONTEXT_CYCLE_NOT_FOUND' using errcode='22023';
  end if;
  select * into v_group from public.weekly_source_groups where id=v_cycle.source_group_id;
  if not found or not v_group.active
     or (v_group_id is not null and v_group.id is distinct from v_group_id) then
    raise exception 'WEEKLY_SOURCE_CONTEXT_GROUP_MISMATCH' using errcode='22023';
  end if;
  v_group_id:=v_group.id;

  if v_report_scope_id is not null then
    select * into v_scope
    from public.weekly_source_report_scopes where id=v_report_scope_id;
    if not found or not ((v_group.source_family='NHSP' and v_scope.self_bill_report_id is null)
      or (v_group.source_family='ROSTER' and v_scope.self_bill_report_id is not null))
       or v_scope.source_cycle_id is distinct from v_cycle.id
       or v_scope.source_group_id is distinct from v_group.id
       or v_scope.environment is distinct from v_group.environment
       or v_scope.agency_id is distinct from v_group.agency_id
       or v_scope.cutoff_at_utc is distinct from v_cycle.cutoff_at_utc
       or (v_client_id is not null and v_scope.client_id is distinct from v_client_id) then
      raise exception 'WEEKLY_SOURCE_CONTEXT_REPORT_SCOPE_MISMATCH' using errcode='22023';
    end if;
    v_client_id:=v_scope.client_id;
    if v_scope.self_bill_report_id is not null then
      perform private.weekly_source_self_bill_report_rules_assert_v1(v_client_id,v_cycle.id);
    end if;
  else
    if v_group.source_family='NHSP' and v_operation='BUILD_PROJECTION'
       and exists(
         select 1 from public.weekly_source_format_profiles profile
         where profile.id=v_upload.source_format_profile_id
           and profile.profile_code='NHSP_FINAL_BACKING_V1'
       ) then
      raise exception 'WEEKLY_SOURCE_CONTEXT_REPORT_SCOPE_REQUIRED' using errcode='22023';
    end if;
    if v_operation='BUILD_PROJECTION' then
      begin
        v_client_id:=nullif(v_upload.file_metadata_json->>'client_id','')::uuid;
      exception when invalid_text_representation then
        raise exception 'WEEKLY_SOURCE_CONTEXT_CLIENT_INVALID' using errcode='55000';
      end;
    end if;
    if v_client_id is not null and not exists(
      select 1 from public.weekly_source_group_clients membership
      where membership.source_group_id=v_group.id
        and membership.client_id=v_client_id
        and v_cycle.finalisation_week_ending between membership.valid_from
          and coalesce(membership.valid_to,'infinity'::date)
    ) then
      raise exception 'WEEKLY_SOURCE_CONTEXT_CLIENT_SCOPE_MISMATCH' using errcode='22023';
    end if;
  end if;
  if v_client_id is not null then
    if v_operation='BUILD_PROJECTION' and v_cycle.scope_client_id is not null and v_cycle.scope_client_id<>v_client_id then
      raise exception 'WEEKLY_SOURCE_CONTEXT_CLIENT_SCOPE_MISMATCH' using errcode='22023';
    end if;
    select client.name into strict v_client_name
    from public.clients client where client.id=v_client_id;
  elsif v_group.source_family='ROSTER' then
    select pg_catalog.count(*),coalesce(pg_catalog.jsonb_agg(
      pg_catalog.jsonb_build_object('client_id',client.id,'client_name',client.name)
      order by client.name,client.id
    ),'[]'::jsonb)
      into v_client_choice_count,v_client_choices
    from public.weekly_source_group_clients membership
    join public.clients client on client.id=membership.client_id
    where membership.source_group_id=v_group.id
      and v_cycle.finalisation_week_ending between membership.valid_from
        and coalesce(membership.valid_to,'infinity'::date);
    if v_client_choice_count=1 then
      v_client_id:=(v_client_choices->0->>'client_id')::uuid;
      v_client_name:=v_client_choices->0->>'client_name';
    elsif v_client_choice_count=0 then
      raise exception 'WEEKLY_SOURCE_CONTEXT_CLIENT_NOT_FOUND' using errcode='22023';
    end if;
  end if;
  perform private.weekly_source_office_authority_v1(
    v_actor,
    case when v_operation='DISCOVER_SCOPE' then 'UPLOAD_SOURCE' else 'RECHECK_SOURCE' end,
    v_group.id,v_client_id,v_cycle.finalisation_week_ending
  );

  if v_operation='BUILD_PROJECTION' and v_scope.self_bill_report_id is not null then
    perform private.weekly_source_self_bill_report_seal_assert_v1(v_upload.id);
    select * into strict v_publication from public.weekly_source_projection_publications
      where upload_id=v_upload.id and authority_scope_kind='SELF_BILL_REPORT_SCOPE'
        and report_scope_id=v_scope.id and authority_scope_version=v_scope.version and state in ('BUILDING','CURRENT');
    return jsonb_build_object('ok',true,'context_version','WEEKLY_SOURCE_UPLOAD_CONTEXT_V1',
      'environment',v_group.environment,'agency_id',v_group.agency_id,'source_family',v_group.source_family,
      'source_group_id',v_group.id,'source_cycle_id',v_cycle.id,'report_scope_id',v_scope.id,
      'client_id',v_client_id,'client_name',v_client_name,'upload_id',v_upload.id,
      'authority_scope_kind','SELF_BILL_REPORT_SCOPE','authority_scope_version',v_scope.version,
      'profile_id','ACACIUM_SELF_BILL_REPORT_V1','self_bill_report_id',v_scope.self_bill_report_id,
      'effective_rule_set',private.weekly_source_effective_rule_set_v1(v_client_id,v_cycle.id),
      'row_manifest_hash',encode(v_upload.row_manifest_hash,'hex'),
      'projection_publication_id',v_publication.id,'projection_state',v_publication.state,
      'comparison_manifest_hash',encode(v_publication.comparison_manifest_hash,'hex'),
      'issue_set_hash',encode(v_publication.issue_set_hash,'hex'),'invoice_only',true,'rows','[]'::jsonb);
  end if;
  if v_operation='DISCOVER_SCOPE' then
    if v_scope.self_bill_report_id is null then
      v_coverage_context:=private.weekly_source_upload_coverage_context_v1(v_client_id,v_cycle.id);
    end if;
    return pg_catalog.jsonb_build_object(
      'ok',true,'context_version','WEEKLY_SOURCE_UPLOAD_CONTEXT_V1',
      'environment',v_group.environment,'agency_id',v_group.agency_id,
      'source_group_id',v_group.id,'source_group_code',v_group.code,
      'source_group_name',v_group.display_name,'source_family',v_group.source_family,
      'source_cycle_id',v_cycle.id,'finalisation_week_ending',v_cycle.finalisation_week_ending,
      'cutoff_at_utc',v_cycle.cutoff_at_utc,'cycle_state',v_cycle.state,
      'previous_coverage',(
        select pg_catalog.jsonb_build_object(
          'start_local_date',prior.confirmed_coverage_start_local_date,
          'end_local_date',prior.confirmed_coverage_end_local_date
        )
        from public.weekly_source_uploads prior
        where prior.id=case when v_report_scope_id is null then v_cycle.current_complete_upload_id else v_scope.current_complete_upload_id end
          and prior.state='CURRENT'
      ),
      'report_scope_id',v_report_scope_id,'client_id',v_client_id,
      'client_name',v_client_name,'nhsp_report_heading_name',v_group.nhsp_report_heading_name,
      'effective_rule_set',private.weekly_source_effective_rule_set_v1(v_client_id,v_cycle.id),
      'client_selection_required',v_group.source_family='ROSTER' and v_client_id is null,
      'client_choices',v_client_choices,
      'authority_scope_version',case when v_report_scope_id is null then v_cycle.version else v_scope.version end,
      'authority_scope_kind',case when v_report_scope_id is null then 'CYCLE'
        when v_scope.self_bill_report_id is null then 'NHSP_REPORT_SCOPE' else 'SELF_BILL_REPORT_SCOPE' end
    )||case when v_scope.self_bill_report_id is null then '{}'::jsonb
      else jsonb_build_object('self_bill_report_id',v_scope.self_bill_report_id) end
      ||case when v_coverage_context is null then '{}'::jsonb
      else jsonb_build_object('coverage_context',v_coverage_context) end;
  end if;

  select * into strict v_profile
  from public.weekly_source_format_profiles where id=v_upload.source_format_profile_id;

  if v_profile.profile_code='NHSP_FINAL_BACKING_V1' and v_upload.purpose='FINAL_SOURCE_CORRECTION' then
    perform private.weekly_source_paid_match_correction_scope_v1(v_upload.id,v_actor,false);
    select publication.* into strict v_publication
      from public.weekly_final_source_correction_sessions correction
      join public.weekly_source_projection_publications publication on publication.id=correction.replacement_projection_publication_id
      where correction.id=v_upload.correction_session_id and correction.replacement_correction_upload_id=v_upload.id
        and publication.upload_id=v_upload.id and publication.source_cycle_id=v_cycle.id
        and publication.report_scope_id=v_scope.id and publication.authority_scope_kind='NHSP_REPORT_SCOPE'
        and publication.authority_scope_version=v_scope.version and publication.correction_session_id=correction.id
        and publication.state in ('BUILDING','CORRECTION_READY');
  elsif v_profile.profile_code='NHSP_FINAL_BACKING_V1' and v_upload.purpose='ORDINARY' then
    select * into strict v_publication from public.weekly_source_projection_publications publication
      where publication.upload_id=v_upload.id and publication.source_cycle_id=v_cycle.id
        and publication.report_scope_id=v_scope.id and publication.authority_scope_kind='NHSP_REPORT_SCOPE'
        and publication.authority_scope_version=v_scope.version and publication.correction_session_id is null
        and publication.state in ('BUILDING','CURRENT');
  end if;

  for v_source_row in
    select source_row.*
    from public.weekly_source_upload_rows source_row
    where source_row.upload_id=v_upload.id
    order by source_row.source_row_ordinal,source_row.id
  loop
    -- Released reports identify the client on each row. A legacy upload-level
    -- client hint must not silently assign every row to that one client.
    v_row_client_id:=case when v_profile.profile_code='NHSP_PREFINAL_RELEASED_V1'
      then null else v_client_id end;
    select * into v_office_choice from private.weekly_source_office_row_choices
      where upload_row_id=v_source_row.id order by id desc limit 1;
    v_source_name:=nullif(pg_catalog.btrim(coalesce(
      v_source_row.bounded_raw_columns_json->>'worker_name',
      v_source_row.bounded_raw_columns_json->>'candidate',
      v_source_row.source_candidate_identity
    )), '');
    v_source_id:=nullif(pg_catalog.btrim(coalesce(
      v_source_row.bounded_raw_columns_json->>'worker_unique_id',
      v_source_row.bounded_raw_columns_json->>'candidate_id',''
    )), '');
    v_source_id_2:=nullif(pg_catalog.btrim(coalesce(
      v_source_row.bounded_raw_columns_json->>'candidate_uid',''
    )), '');
    v_source_id_3:=nullif(pg_catalog.btrim(coalesce(
      v_source_row.bounded_raw_columns_json->>'payroll_number',''
    )), '');
    v_source_client:=nullif(pg_catalog.btrim(coalesce(
      v_source_row.bounded_raw_columns_json->>'trust',
      v_source_row.source_client_identity
    )), '');
    if v_row_client_id is null and v_profile.profile_code='NHSP_PREFINAL_RELEASED_V1' then
      select case when pg_catalog.count(*)=1 then pg_catalog.min(client.id::text)::uuid end
        into v_row_client_id
      from public.clients client
      where private.weekly_source_upload_client_eligible_v1(
          v_upload.id,client.id,v_source_row.work_date)
        and pg_catalog.lower(pg_catalog.btrim(client.name))=
          pg_catalog.lower(pg_catalog.btrim(coalesce(v_source_client,'')));
    end if;
    if v_office_choice.client_id is not null then
      select client.id into v_row_client_id
      from public.clients client
      where client.id=v_office_choice.client_id
        and private.weekly_source_upload_client_eligible_v1(
          v_upload.id,client.id,v_source_row.work_date);
    end if;
    v_norm_name:=pg_catalog.lower(pg_catalog.regexp_replace(
      pg_catalog.btrim(coalesce(v_source_name,'')),'[[:space:]]+',' ','g'
    ));
    v_norm_compact:=pg_catalog.regexp_replace(v_norm_name,'[^a-z0-9]+','','g');

    select coalesce(pg_catalog.array_agg(candidate_id order by candidate_id),'{}'::uuid[])
      into v_candidate_ids
    from (
      select distinct candidate.id as candidate_id
      from public.candidates candidate
      where candidate.active
        and (
          (v_source_id is not null and pg_catalog.lower(pg_catalog.btrim(candidate.tms_ref))=
             pg_catalog.lower(v_source_id))
          or (v_source_id_2 is not null and pg_catalog.lower(pg_catalog.btrim(candidate.tms_ref))=
             pg_catalog.lower(v_source_id_2))
          or (v_source_id_3 is not null and pg_catalog.lower(pg_catalog.btrim(candidate.tms_ref))=
             pg_catalog.lower(v_source_id_3))
          or exists(
            select 1
            from pg_catalog.jsonb_array_elements_text(
              case when pg_catalog.jsonb_typeof(candidate.nhsp_hr_name_aliases)='array'
                then candidate.nhsp_hr_name_aliases else '[]'::jsonb end
            ) alias(value)
            where pg_catalog.lower(pg_catalog.btrim(alias.value))=v_norm_name
               or pg_catalog.regexp_replace(pg_catalog.lower(alias.value),'[^a-z0-9]+','','g')=v_norm_compact
          )
          or exists(
            select 1 from public.hr_name_mappings mapping
            where mapping.active and mapping.candidate_id=candidate.id
              and (
                pg_catalog.lower(pg_catalog.btrim(mapping.hr_name_norm))=v_norm_name
                or pg_catalog.regexp_replace(pg_catalog.lower(mapping.hr_name_norm),'[^a-z0-9]+','','g')=v_norm_compact
              )
              and (nullif(pg_catalog.btrim(coalesce(mapping.hospital_or_trust,'')),'') is null
                or pg_catalog.lower(pg_catalog.btrim(mapping.hospital_or_trust))=
                   pg_catalog.lower(pg_catalog.btrim(coalesce(v_source_client,''))))
          )
        )
    ) exact_saved;
    if v_office_choice.candidate_id is not null then
      select coalesce(pg_catalog.array_agg(id),'{}'::uuid[]) into v_candidate_ids
        from public.candidates where id=v_office_choice.candidate_id and active;
    end if;
    v_candidate_id:=case when pg_catalog.cardinality(v_candidate_ids)=1 then v_candidate_ids[1] end;
    select coalesce(pg_catalog.jsonb_agg(
      pg_catalog.jsonb_build_object(
        'candidate_id',candidate.id,'display_name',coalesce(nullif(candidate.display_name,''),
          pg_catalog.btrim(coalesce(candidate.first_name,'')||' '||coalesce(candidate.last_name,''))),
        'tms_ref',candidate.tms_ref
      ) order by candidate.id
    ),'[]'::jsonb) into v_candidate_matches
    from public.candidates candidate where candidate.id=any(v_candidate_ids);

    v_paid_choice:=null;v_paid_inputs:=null;
    v_contracts:='[]'::jsonb;
    v_prior_contract_id:=null;
    v_prior_work_event_id:=null;
    v_prior_candidate_count:=0;
    if v_candidate_id is not null and v_row_client_id is not null then
      select coalesce(pg_catalog.jsonb_agg(contract_item order by contract_item->>'contract_id'),'[]'::jsonb)
        into v_contracts
      from (
        select pg_catalog.jsonb_build_object(
          'contract_id',contract.id,
          'candidate_id',contract.candidate_id,
          'client_id',contract.client_id,
          'valid_from',contract.start_date,
          'valid_to',contract.end_date,
          'display_label',pg_catalog.concat_ws(' · ',nullif(contract.role,''),nullif(contract.band,''),nullif(contract.display_site,'')),
          'role',contract.role,'band',contract.band,
          'pay_type',contract.pay_method_snapshot,
          'rates_json',contract.rates_json,
          'contract_updated_at',contract.updated_at,
          'weekly_source_applicable',true,
          'schedule_compatible',private.weekly_source_schedule_compatible_v1(
            contract.std_schedule_json,v_source_row.work_date
          ),
          'verified_role_band_match',private.weekly_source_verified_role_band_match_v1(
            case when v_profile.profile_code in ('NHSP_PREFINAL_RELEASED_V1','NHSP_FINAL_BACKING_V1')
              then 'NHSP' else 'HR_WEEKLY' end,
            v_source_row.role_band_source,v_candidate_id,v_row_client_id,
            contract.id,contract.band,v_source_row.work_date
          ),
          'effective_policy',private._weekly_source_effective_policy_v1(
            v_row_client_id,contract.id,v_source_row.work_date
          ),
          'effective_rule_set',private.weekly_source_effective_rule_set_v1(v_row_client_id,v_cycle.id),
          'settings_authority',private._contract_settings_effective_core_v1(
            v_row_client_id,contract.id,v_source_row.work_date,'IMPORT',null
          )
        ) contract_item
        from public.contracts contract
        where contract.candidate_id=v_candidate_id
          and contract.client_id=v_row_client_id
          and v_source_row.work_date between contract.start_date and coalesce(contract.end_date,'infinity'::date)
      ) eligible;

      -- G6-13 / XSG-010.  Only the three roster profiles use the source
      -- system's own line identity as the durable work-event key.  An NHSP
      -- Reference Number is evidence, never sole durable identity
      -- (`24 §9`; `25 §7` Removed), so NHSP lineage resolves through the
      -- schedule tuple below, exactly as the publication owner now keys it.
      if v_profile.profile_code in (
        'HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1',
        'HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1',
        'ROSTER_WEEKLY_SUMMARY_ACTUAL_V1'
      ) and nullif(pg_catalog.btrim(coalesce(v_source_row.external_source_key,'')),'') is not null then
        select event.id,resolution.contract_id
          into v_prior_work_event_id,v_prior_contract_id
        from public.weekly_work_events event
        left join lateral (
          select saved.contract_id
          from public.weekly_source_row_resolutions saved
          where saved.work_event_id=event.id and saved.mapping_state='RESOLVED'
          order by saved.created_at_utc desc,saved.id desc limit 1
        ) resolution on true
        where event.first_source_group_id=v_group.id
          and event.source_format_profile_id=v_profile.id
          and event.identity_kind='PROFILE_EXTERNAL_KEY'
          and event.profile_external_key=v_source_row.external_source_key
          and event.candidate_id=v_candidate_id and event.client_id=v_row_client_id
        order by event.created_at_utc,event.id limit 1;
        -- Primary03 section6.1: unmatched finalised external keys use one
        -- native exact-tuple/absent-old-key proof, not schedule compatibility.
        if v_prior_work_event_id is null then
          begin
            v_prior_work_event_id:=private.weekly_source_known_source_key_v1(v_source_row.id,v_candidate_id,v_row_client_id);
            if v_prior_work_event_id is null then
              v_prior_work_event_id:=private.weekly_source_identical_rekey_prior_v1(v_source_row.id);
            end if;
          exception when sqlstate '55000' then
            if SQLERRM not in ('WEEKLY_SOURCE_IDENTICAL_REKEY_AMBIGUOUS','WEEKLY_SOURCE_SOURCE_KEY_ALIAS_AMBIGUOUS') then raise; end if;
            -- Keep discovery usable, but expose a real ambiguity. The native
            -- projection independently repeats the helper and refuses it.
            v_prior_candidate_count:=2; v_prior_work_event_id:=null;
          end;
          if v_prior_work_event_id is not null then
            select saved.contract_id into v_prior_contract_id
            from public.weekly_source_row_resolutions saved
            where saved.work_event_id=v_prior_work_event_id and saved.mapping_state='RESOLVED'
            order by saved.created_at_utc desc,saved.id desc limit 1;
          end if;
        end if;
      else
        -- WP-37, against `24 §9` step 2.  The pack keys identity on "exact
        -- Candidate, actual Client, worked date and **compatible** schedule",
        -- so lineage must NOT demand exact Actual start and end: `24 §6.2`
        -- ("Paid eight hours becomes nine") is a later source change on ONE
        -- root, and an NHSP correction routinely moves the times.  The
        -- cardinality is checked explicitly: none means new work, and more than
        -- one is `24 §9` step 4 (Office confirmation), where nothing is
        -- suggested and the server refuses to guess.
        select pg_catalog.count(*)::integer,
               pg_catalog.min(event.id::text)::uuid
          into v_prior_candidate_count,v_prior_work_event_id
        from public.weekly_work_events event
        where event.first_source_group_id=v_group.id
          and event.source_format_profile_id=v_profile.id
          and event.identity_kind='SCHEDULE_TUPLE'
          and event.candidate_id=v_candidate_id and event.client_id=v_row_client_id
          and event.work_date=v_source_row.work_date
          and private.weekly_source_work_event_schedule_compatible_v1(
                event.id,v_source_row.start_at_local,v_source_row.end_at_local
              );
        if v_prior_candidate_count<>1 then
          v_prior_work_event_id:=null;
        else
          -- The Contract is a SUGGESTION only: `weekly_source_projection_build_v1`
          -- re-proves DURABLE_LINEAGE against a prior RESOLVED resolution for
          -- this same work event before it will accept the selection method.
          select saved.contract_id into v_prior_contract_id
          from public.weekly_source_row_resolutions saved
          where saved.work_event_id=v_prior_work_event_id
            and saved.mapping_state='RESOLVED'
          order by saved.created_at_utc desc,saved.id desc limit 1;
        end if;
      end if;
    end if;

    if v_candidate_id is not null and v_row_client_id is not null and v_upload.purpose in ('ORDINARY','FINAL_SOURCE_CORRECTION')
      and (v_profile.profile_code in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1','ROSTER_WEEKLY_SUMMARY_ACTUAL_V1')
        or (v_profile.profile_code='NHSP_FINAL_BACKING_V1' and v_upload.purpose in ('ORDINARY','FINAL_SOURCE_CORRECTION')
          and v_source_row.source_shift_charge_pence>=0))
      and v_source_row.row_finalisation_state='SOURCE_WORKED' then
      v_paid_inputs:=private.weekly_source_paid_overlap_candidates_v1(v_source_row.id,v_actor,v_candidate_id,v_row_client_id);
      if v_profile.profile_code='NHSP_FINAL_BACKING_V1' and v_publication.state='BUILDING' then
        v_paid_choice:=private.weekly_source_nhsp_projection_lock_input_v1(v_source_row.id,v_actor,v_publication.id);
      else
      v_paid_choice:=private.weekly_source_paid_overlap_choice_current_v1(v_source_row.id,v_actor);
      end if;
      if v_paid_choice is not null then
        if v_paid_choice->>'candidate_id' is distinct from v_candidate_id::text
          or v_paid_choice->>'client_id' is distinct from v_row_client_id::text then
          raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_SCOPE_CHANGED' using errcode='40001';end if;
        v_prior_work_event_id:=case when v_paid_choice->>'pay_effect'='NONE'
          then (v_paid_choice->>'paid_overlap_target_work_event_id')::uuid else null end;
        v_prior_contract_id:=case when v_paid_choice->>'pay_effect'='NONE'
          then (v_paid_choice->>'contract_id')::uuid else null end;
      end if;
    end if;
    v_rows:=v_rows||pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
      'upload_row_id',v_source_row.id,
      'source_row_ordinal',v_source_row.source_row_ordinal,
      'external_source_key',v_source_row.external_source_key,
      'source_candidate_identity',v_source_row.source_candidate_identity,
      'source_client_identity',v_source_row.source_client_identity,
      'work_date',v_source_row.work_date,
      'start_at_local',v_source_row.start_at_local,
      'end_at_local',v_source_row.end_at_local,
      'break_minutes',v_source_row.break_minutes,
      'actual_net_minutes',v_source_row.actual_net_minutes,
      'row_finalisation_state',v_source_row.row_finalisation_state,
      'role_band_source',v_source_row.role_band_source,
      'source_commission_pence',v_source_row.source_commission_pence,
      'source_total_cost_pence',v_source_row.source_total_cost_pence,
      'source_shift_charge_pence',v_source_row.source_shift_charge_pence,
      'source_gross_pence',v_source_row.source_gross_pence,'source_vat_pence',v_source_row.source_vat_pence,
      'finalised_at_utc',v_source_row.finalised_at_utc,
      'source_money_parse_state',v_source_row.source_money_parse_state,
      'source_expense_pence',v_source_row.source_expense_pence,
      'source_expense_parse_state',v_source_row.source_expense_parse_state,
      'candidate_match_count',pg_catalog.cardinality(v_candidate_ids),
      'candidate_matches',v_candidate_matches,
      'candidate_id',v_candidate_id,
      'office_selected_contract_id',v_office_choice.contract_id,
      'office_selected_work_event_id',v_office_choice.work_event_id,
      'office_separate_shift',coalesce(v_office_choice.separate_shift,false),
      'paid_overlap_inputs',v_paid_inputs,'paid_overlap_choice',v_paid_choice,
      'protected_matches',private.weekly_source_protected_match_candidates_v1(v_source_row.id,v_candidate_id,v_row_client_id),
      'client_id',v_row_client_id,
      'contracts',v_contracts,
      'prior_accepted_contract_id',v_prior_contract_id,
      'prior_work_event_id',v_prior_work_event_id,
      -- `24 §9` step 4.  True means more than one plausible existing work
      -- record remains, so Office must confirm the relationship; the server
      -- refuses to publish the row until it does.
      'prior_work_event_ambiguous',v_prior_candidate_count>1
    ));
  end loop;

  if v_profile.profile_code<>'NHSP_FINAL_BACKING_V1' or v_upload.purpose not in ('ORDINARY','FINAL_SOURCE_CORRECTION') then
  if v_upload.correction_session_id is not null then
    select publication.* into v_publication
    from public.weekly_final_source_correction_sessions correction
    join public.weekly_source_projection_publications publication
      on publication.id=correction.replacement_projection_publication_id
    where correction.id=v_upload.correction_session_id
      and correction.replacement_correction_upload_id=v_upload.id
      and publication.upload_id=v_upload.id
      and publication.correction_session_id=correction.id
      and publication.state='CORRECTION_READY';
  else
    select publication.* into v_publication
    from public.weekly_source_projection_publications publication
    where publication.upload_id=v_upload.id
      and publication.state='CURRENT'
    order by publication.published_at_utc desc nulls last,publication.id desc
    limit 1;
  end if;

  end if;

  return pg_catalog.jsonb_build_object(
    'ok',true,'context_version','WEEKLY_SOURCE_PROJECTION_CONTEXT_V1',
    'environment',v_group.environment,'agency_id',v_group.agency_id,
    'source_group_id',v_group.id,'source_family',v_group.source_family,
    'source_cycle_id',v_cycle.id,'report_scope_id',v_report_scope_id,
    'client_id',v_client_id,'client_name',v_client_name,
    'profile_id',v_profile.profile_code,'profile_version',v_profile.version,
    'upload_id',v_upload.id,
    'row_manifest_hash',case when v_upload.row_manifest_hash is null then null
      else pg_catalog.encode(v_upload.row_manifest_hash,'hex') end,
    'projection_publication_id',v_publication.id,
    'projection_state',v_publication.state,
    'comparison_manifest_hash',case when v_publication.comparison_manifest_hash is null then null
      else pg_catalog.encode(v_publication.comparison_manifest_hash,'hex') end,
    'issue_set_hash',case when v_publication.issue_set_hash is null then null
      else pg_catalog.encode(v_publication.issue_set_hash,'hex') end,
    'correction_session_id',v_upload.correction_session_id,
    'correction_session_version',case when v_upload.correction_session_id is null then null else (
      select correction.version
      from public.weekly_final_source_correction_sessions correction
      where correction.id=v_upload.correction_session_id
    ) end,
    'authority_scope_kind',case when v_report_scope_id is null then 'CYCLE' else 'NHSP_REPORT_SCOPE' end,
    'authority_scope_version',coalesce(v_scope.version,v_cycle.version),
    'rows',v_rows
  );
end;
$function$;

create or replace function public.weekly_source_projection_rows_apply_atomic_v1(
  p_actor_user_id uuid,
  p_publication_id uuid,
  p_rows jsonb
) returns jsonb
language plpgsql
security definer
set search_path to 'public','private','extensions','pg_temp'
as $function$
declare
  v_publication public.weekly_source_projection_publications%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_profile public.weekly_source_format_profiles%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_scope public.weekly_source_report_scopes%rowtype;
  v_correction public.weekly_final_source_correction_sessions%rowtype;
  v_row_json jsonb;
  v_paid_choices jsonb;v_paid_recheck jsonb;v_paid_choice jsonb;v_paid_inputs jsonb;v_pay_effect text;v_paid_choice_id bigint;
  v_nhsp_paid_separate boolean;v_nhsp_phased_projection boolean;v_nhsp_lock_input jsonb;
  v_source_row public.weekly_source_upload_rows%rowtype;
  v_contract public.contracts%rowtype;
  v_work_event public.weekly_work_events%rowtype;
  v_resolution_id uuid;
  v_work_event_id uuid;
  v_mapping_state text;
  v_selection_method text;
  v_candidate_id uuid;
  v_client_id uuid;
  v_contract_id uuid;
  v_prior_work_event_id uuid;
  v_identical_rekey_prior uuid;
  v_identity_kind text;
  v_link_kind text;
  v_work_event_match_kind text;
  v_work_event_match_fingerprint bytea;
  v_work_event_was_present boolean;
  v_profile_external_key text;
  v_durable_identity_hash bytea;
  -- WP-37: the `24 §9` step-2 candidate set, counted explicitly.  Safety is
  -- never expressed through `limit`/`order by` here: anything other than
  -- exactly one compatible root takes a named branch.
  v_compatible_count integer;
  v_compatible_event_id uuid;
  v_protected_matches jsonb;
  v_protected_choice uuid;
  v_protected_count integer;
  v_protected_separate boolean;
  v_eligible_ids jsonb;
  v_eligible_hash bytea;
  v_generation integer;
  v_applied integer:=0;
  v_expected integer;
  v_existing integer;
  v_qualification jsonb;
  v_charge jsonb;
  v_economic jsonb;
  v_effective_policy jsonb;
  v_invoice_rules jsonb;
  v_source_amount boolean;
  v_contract_settings_authority jsonb;
  v_canonical_economic jsonb;
  v_contract_rate_fingerprint bytea;
  v_effective_policy_fingerprint bytea;
  v_invoice_vat_policy_fingerprint bytea;
  v_calculation_fingerprint bytea;
  v_expense_policy_snapshot_hash bytea;
  v_source_mode text;
  v_row_sign smallint;
  v_invoice_vat_chargeable boolean;
  v_invoice_vat_rate_pct numeric;
  v_source_expense_vat_enabled boolean;
  v_source_authority boolean;
  v_has_worked_tuple boolean;
  v_expected_pay_pence bigint;
  v_expected_charge_pence bigint;
  v_result text;
  v_passed boolean;
  v_charge_source_pence bigint;
  v_charge_calculated_pence bigint;
  v_charge_difference_pence bigint;
  v_charge_row_sign_kind text;
  v_charge_claimed_result text;
  v_charge_expected_result text;
  v_charge_expected_sign_kind text;
  v_mode_a_policy jsonb;
begin
  if coalesce(current_setting('request.jwt.claim.role',true),
       nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
  end if;
  if p_actor_user_id is null or p_publication_id is null
     or pg_catalog.jsonb_typeof(p_rows)<>'array' then
    raise exception 'WEEKLY_SOURCE_PROJECTION_INPUT_INVALID' using errcode='22023';
  end if;

  -- Read immutable identity first, then enter the same scope lock order as
  -- begin/publish before taking any row lock. Exact retries can therefore race
  -- safely without forming a publication-to-scope lock cycle.
  select * into v_publication
  from public.weekly_source_projection_publications
  where id=p_publication_id;
  if not found then
    raise exception 'WEEKLY_SOURCE_PUBLICATION_NOT_FOUND' using errcode='22023';
  end if;
  select * into strict v_upload
  from public.weekly_source_uploads
  where id=v_publication.upload_id;
  select * into strict v_cycle
  from public.weekly_source_cycles
  where id=v_publication.source_cycle_id;
  select * into strict v_group
  from public.weekly_source_groups
  where id=v_cycle.source_group_id;
  perform private.weekly_source_pay_query_admit_v2();
  if v_publication.authority_scope_kind='SELF_BILL_REPORT_SCOPE' then
    return private.weekly_source_self_bill_report_projection_rows_v1(p_actor_user_id,p_publication_id,p_rows);
  end if;
  v_paid_choices:=private.weekly_source_paid_overlap_projection_lock_v1(v_upload.id,p_actor_user_id,p_publication_id);
  v_nhsp_phased_projection:=exists(select 1 from jsonb_array_elements(v_paid_choices) c
    where c->>'schema_version'='WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_INPUT_V1');
  perform pg_catalog.pg_advisory_xact_lock(
    pg_catalog.hashtextextended(
      pg_catalog.encode(v_upload.declared_scope_fingerprint,'hex'),73241837
    )
  );
  if jsonb_array_length(v_paid_choices)>0 then
    perform 1 from public.weekly_source_groups where id=v_group.id for update;
  end if;

  if v_publication.authority_scope_kind='NHSP_REPORT_SCOPE' then
    select * into strict v_cycle
    from public.weekly_source_cycles
    where id=v_publication.source_cycle_id;
    select * into strict v_scope
    from public.weekly_source_report_scopes
    where id=v_publication.report_scope_id
    for update;
  else
    select * into strict v_cycle
    from public.weekly_source_cycles
    where id=v_publication.source_cycle_id
    for update;
  end if;
  select * into strict v_publication
  from public.weekly_source_projection_publications
  where id=p_publication_id
  for update;
  if v_publication.state not in ('BUILDING','CORRECTION_READY')
     or (v_publication.state='CORRECTION_READY'
         and v_publication.correction_session_id is null) then
    raise exception 'WEEKLY_SOURCE_PUBLICATION_NOT_BUILDING' using errcode='55000';
  end if;
  select * into strict v_upload
  from public.weekly_source_uploads
  where id=v_publication.upload_id
  for share;
  select * into strict v_profile
  from public.weekly_source_format_profiles profile
  where profile.id=v_upload.source_format_profile_id and profile.active;

  if v_publication.authority_scope_kind='NHSP_REPORT_SCOPE' then
    if v_scope.version is distinct from v_publication.authority_scope_version
       or (
         v_publication.correction_session_id is null
         and (v_scope.current_complete_upload_id is distinct from v_upload.id
              or v_scope.projection_state<>'REBUILDING')
       ) then
      raise exception 'WEEKLY_SOURCE_PUBLICATION_STALE' using errcode='40001';
    end if;
  elsif v_cycle.version is distinct from v_publication.authority_scope_version
        or (
          v_publication.correction_session_id is null
          and (v_cycle.current_complete_upload_id is distinct from v_upload.id
               or v_cycle.projection_state<>'REBUILDING')
        ) then
    raise exception 'WEEKLY_SOURCE_PUBLICATION_STALE' using errcode='40001';
  end if;

  if v_publication.correction_session_id is not null then
    select * into v_correction
    from public.weekly_final_source_correction_sessions
    where id=v_publication.correction_session_id for update;
    if not found
       or v_correction.source_cycle_id is distinct from v_cycle.id
       or v_correction.authority_scope_kind is distinct from v_publication.authority_scope_kind
       or v_correction.report_scope_id is distinct from v_publication.report_scope_id
       or v_correction.replacement_correction_upload_id is distinct from v_upload.id
       or v_correction.actor_user_id is distinct from p_actor_user_id
       or v_upload.purpose<>'FINAL_SOURCE_CORRECTION'
       or v_upload.state<>'CORRECTION_READY'
       or (v_publication.state='BUILDING'
         and v_publication.rebuild_idempotency_key is null and (
         v_correction.state<>'READY'
         or v_correction.replacement_projection_publication_id is not null
       ))
       or (v_publication.state='BUILDING'
         and v_publication.rebuild_idempotency_key is not null and (
         v_publication.projection_generation is null
         or v_publication.ready_session_version is null
         or v_correction.state<>'REVIEWED'
         or v_correction.version<>v_publication.ready_session_version
         or v_correction.replacement_projection_publication_id is null
         or v_correction.replacement_projection_publication_id=v_publication.id
       ))
       or (v_publication.state='CORRECTION_READY'
         and v_correction.replacement_projection_publication_id
               is distinct from v_publication.id)
       or coalesce(v_scope.current_final_revision_id,v_cycle.current_final_revision_id)
            is distinct from v_correction.expected_current_final_revision_id then
      raise exception 'WEEKLY_SOURCE_CORRECTION_PUBLICATION_STALE' using errcode='40001';
    end if;
  elsif v_upload.purpose<>'ORDINARY' or v_upload.state<>'CURRENT' then
    raise exception 'WEEKLY_SOURCE_PUBLICATION_STALE' using errcode='40001';
  end if;

  perform private.weekly_source_office_authority_v1(
    p_actor_user_id,'RECHECK_SOURCE',v_group.id,
    case when v_publication.authority_scope_kind='NHSP_REPORT_SCOPE' then v_scope.client_id else null end,
    v_cycle.finalisation_week_ending
  );

  if v_publication.authority_scope_version>2147483647
     or coalesce(v_publication.projection_generation,0)>2147483647 then
    raise exception 'WEEKLY_SOURCE_PROJECTION_GENERATION_OVERFLOW' using errcode='22003';
  end if;
  v_generation:=coalesce(
    v_publication.projection_generation,
    v_publication.authority_scope_version::integer
  );

  select pg_catalog.count(*)::integer into v_expected
  from public.weekly_source_upload_rows source_row
  where source_row.upload_id=v_upload.id;
  if pg_catalog.jsonb_array_length(p_rows)<>v_expected then
    raise exception 'WEEKLY_SOURCE_PROJECTION_ROW_CENSUS_MISMATCH'
      using errcode='22023',detail=pg_catalog.jsonb_build_object(
        'expected',v_expected,'received',pg_catalog.jsonb_array_length(p_rows)
      )::text;
  end if;

  select pg_catalog.count(*)::integer into v_existing
  from public.weekly_source_row_resolutions resolution
  join public.weekly_source_upload_rows source_row
    on source_row.id=resolution.upload_row_id
  where source_row.upload_id=v_upload.id
    and resolution.generation=v_generation;
  if v_publication.state='CORRECTION_READY' or v_existing>0 then
    if v_existing<>v_expected or exists(
      select 1
      from public.weekly_source_upload_rows source_row
      where source_row.upload_id=v_upload.id
        and not exists(
          select 1
          from public.weekly_source_row_resolutions resolution
          where resolution.upload_row_id=source_row.id
            and resolution.generation=v_generation
            and resolution.source_row_fingerprint=source_row.normalised_row_hash
        )
    ) then
      raise exception 'WEEKLY_SOURCE_PROJECTION_RESOLUTION_CENSUS_INCOMPLETE'
        using errcode='55000';
    end if;
    return pg_catalog.jsonb_build_object(
      'ok',true,'publication_id',v_publication.id,'upload_id',v_upload.id,
      'authority_scope_version',v_publication.authority_scope_version,
      'generation',v_generation,'applied_row_count',v_existing,'idempotent',true
    );
  end if;

  if not v_nhsp_phased_projection then
  -- Re-read all current choices after the same scope/group/cycle order.
  -- No second I-1 acquisition is attempted while holding business locks.
  select coalesce(jsonb_agg(private.weekly_source_paid_overlap_choice_current_v1(r.id,p_actor_user_id) order by r.id),'[]'::jsonb)
    into v_paid_recheck from public.weekly_source_upload_rows r
    join lateral(select c.* from private.weekly_source_office_row_choices c
      where c.upload_row_id=r.id order by c.id desc limit 1) choice on true
    where r.upload_id=v_upload.id and choice.paid_overlap_target_work_event_id is not null;
  if v_paid_recheck is distinct from v_paid_choices then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_CHANGED' using errcode='40001';end if;
  end if;
  for v_row_json in
    select item.value from pg_catalog.jsonb_array_elements(p_rows) with ordinality item(value,ordinal)
    order by case when v_profile.profile_code='NHSP_FINAL_BACKING_V1' and exists(
      select 1 from public.weekly_source_upload_rows physical
      where physical.id=case when item.value->>'upload_row_id' ~* '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'
        then (item.value->>'upload_row_id')::uuid else null end
        and physical.upload_id=v_upload.id and physical.source_shift_charge_pence<0) then 0 else 1 end,item.ordinal
  loop
    if pg_catalog.jsonb_typeof(v_row_json)<>'object' then
      raise exception 'WEEKLY_SOURCE_PROJECTION_ROW_INVALID' using errcode='22023';
    end if;
    select * into strict v_source_row
    from public.weekly_source_upload_rows source_row
    where source_row.id=(v_row_json->>'upload_row_id')::uuid
      and source_row.upload_id=v_upload.id
    for share;

    if exists(
      select 1 from public.weekly_source_row_resolutions resolution
      where resolution.upload_row_id=v_source_row.id and resolution.generation=v_generation
    ) then
      raise exception 'WEEKLY_SOURCE_PROJECTION_ROW_ALREADY_APPLIED' using errcode='23505';
    end if;

    if v_row_json ?| array['pay_effect','paid_overlap_choice_id','paid_overlap_choice','paid_overlap_inputs'] then
      raise exception 'WEEKLY_SOURCE_CALLER_PAY_EFFECT_FORBIDDEN' using errcode='22023';end if;
    v_paid_choice:=null;v_paid_inputs:=null;v_pay_effect:='NORMAL';v_paid_choice_id:=null;
    v_nhsp_paid_separate:=false;
    -- Native negative-first classification. The Worker supplies a qualified
    -- C1 proposal only; current generation negative resolutions, current native
    -- position and paid facts decide whether the positive must remain blocked.
    if v_profile.profile_code='NHSP_FINAL_BACKING_V1' and v_upload.purpose in ('ORDINARY','FINAL_SOURCE_CORRECTION')
      and v_source_row.row_finalisation_state='SOURCE_WORKED' and v_source_row.source_shift_charge_pence>=0
      and pg_catalog.upper(pg_catalog.btrim(coalesce(v_row_json->>'mapping_state','')))='RESOLVED'
      and private._weekly_source_effective_policy_v1((v_row_json->>'client_id')::uuid,
        (v_row_json->>'contract_id')::uuid,v_source_row.work_date)->>'authority_mode'='SOURCE_AUTHORITY'
      and not exists(select 1 from jsonb_array_elements(v_paid_choices) c
        where c->>'upload_row_id'=v_source_row.id::text) then
      v_paid_inputs:=private.weekly_source_paid_overlap_candidates_v1(v_source_row.id,p_actor_user_id,
        (v_row_json->>'candidate_id')::uuid,(v_row_json->>'client_id')::uuid);
      v_protected_matches:=private.weekly_source_protected_match_candidates_v1(v_source_row.id,
        (v_row_json->>'candidate_id')::uuid,(v_row_json->>'client_id')::uuid);
      if exists(select 1 from jsonb_array_elements(v_paid_inputs->'overlaps') item
        where item#>'{native_payment_facts,paid}' is distinct from 'false'::jsonb
          and not exists(select 1 from jsonb_array_elements(v_protected_matches) protected
            where protected->>'work_event_id'=item->>'work_event_id')
          and (item#>>'{current_native_position,state}' is distinct from 'CURRENT_NATIVE_POSITION'
            or item#>'{nhsp_negative_population,no_reversal_proved}' is distinct from 'false'::jsonb)) then
        v_row_json:=(v_row_json-'economic_snapshot'-'charge_check')||jsonb_build_object('mapping_state','SOURCE_ROW_BLOCKED',
          'blocker_code','PAID_SHIFT_OVERLAP_CONFIRMATION_REQUIRED');
      end if;
    end if;
    v_mapping_state:=pg_catalog.upper(pg_catalog.btrim(coalesce(v_row_json->>'mapping_state','')));
    if v_mapping_state not in (
      'RESOLVED','CANDIDATE_NOT_FOUND','CLIENT_NOT_FOUND','NO_ELIGIBLE_CONTRACT',
      'AMBIGUOUS_CONTRACT','CONTRACT_SELECTION_REQUIRED','SOURCE_ROW_BLOCKED'
    ) then
      raise exception 'WEEKLY_SOURCE_MAPPING_STATE_INVALID' using errcode='22023';
    end if;
    v_candidate_id:=nullif(v_row_json->>'candidate_id','')::uuid;
    v_client_id:=nullif(v_row_json->>'client_id','')::uuid;
    v_contract_id:=nullif(v_row_json->>'contract_id','')::uuid;
    v_prior_work_event_id:=nullif(v_row_json->>'prior_work_event_id','')::uuid;
    v_selection_method:=nullif(pg_catalog.upper(pg_catalog.btrim(coalesce(v_row_json->>'contract_selection_method',''))),'');
    v_work_event_id:=null;
    v_link_kind:=null;
    v_work_event_match_kind:=null;
    v_work_event_match_fingerprint:=null;
    v_work_event_was_present:=false;
    v_compatible_count:=0;
    v_compatible_event_id:=null;
    v_economic:=v_row_json->'economic_snapshot';
    v_effective_policy:=null;
    v_invoice_rules:=null; v_source_amount:=false;
    v_contract_settings_authority:=null;
    v_canonical_economic:=null;
    v_contract_rate_fingerprint:=null;
    v_effective_policy_fingerprint:=null;
    v_invoice_vat_policy_fingerprint:=null;
    v_calculation_fingerprint:=null;
    v_expense_policy_snapshot_hash:=null;
    v_source_mode:=null;
    v_row_sign:=null;
    v_invoice_vat_chargeable:=null;
    v_invoice_vat_rate_pct:=null;
    v_source_expense_vat_enabled:=null;
    v_source_authority:=false;
    v_has_worked_tuple:=false;

    v_eligible_ids:=coalesce((
      select pg_catalog.jsonb_agg(contract_id order by contract_id)
      from (
        select distinct value as contract_id
        from pg_catalog.jsonb_array_elements_text(coalesce(v_row_json->'qualifying_contract_ids','[]'::jsonb))
      ) ordered
    ),'[]'::jsonb);
    v_eligible_hash:=private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_QUALIFYING_CONTRACT_SET_V1',v_eligible_ids
    );

    if v_mapping_state='RESOLVED' then
      if v_candidate_id is null or v_client_id is null or v_contract_id is null
         or v_selection_method not in ('AUTO_UNIQUE','OFFICE_SELECTED','DURABLE_LINEAGE') then
        raise exception 'WEEKLY_SOURCE_RESOLVED_MAPPING_INCOMPLETE' using errcode='22023';
      end if;
      select * into strict v_contract
      from public.contracts contract
      where contract.id=v_contract_id
        and contract.candidate_id=v_candidate_id
        and contract.client_id=v_client_id
        and v_source_row.work_date between contract.start_date and coalesce(contract.end_date,'infinity'::date);
      if not (v_eligible_ids ? v_contract_id::text) then
        raise exception 'WEEKLY_SOURCE_SELECTED_CONTRACT_NOT_QUALIFIED' using errcode='22023';
      end if;
      -- G6-4: the selection method must be provable from server-derived
      -- facts, not asserted by the caller. Authority: 24 §8 ("If one Contract
      -- remains, the system selects it… The system must never offer a chooser
      -- when only one Contract is eligible"), 24 §9 (unique prior lineage),
      -- 25 §7, XSG-011, XSG-012.
      if v_selection_method='AUTO_UNIQUE'
         and pg_catalog.jsonb_array_length(v_eligible_ids)<>1 then
        raise exception 'WEEKLY_SOURCE_AUTO_UNIQUE_NOT_UNIQUE' using errcode='22023',
          detail=pg_catalog.jsonb_build_object(
            'source_row_ordinal',v_source_row.source_row_ordinal,
            'qualifying_contract_count',pg_catalog.jsonb_array_length(v_eligible_ids)
          )::text;
      end if;
      if v_selection_method='OFFICE_SELECTED'
         and pg_catalog.jsonb_array_length(v_eligible_ids)<2 then
        raise exception 'WEEKLY_SOURCE_OFFICE_CHOICE_NOT_WARRANTED' using errcode='22023',
          detail=pg_catalog.jsonb_build_object(
            'source_row_ordinal',v_source_row.source_row_ordinal,
            'qualifying_contract_count',pg_catalog.jsonb_array_length(v_eligible_ids)
          )::text;
      end if;
      if v_selection_method='DURABLE_LINEAGE' then
        if v_prior_work_event_id is null then
          raise exception 'WEEKLY_SOURCE_DURABLE_LINEAGE_UNPROVEN' using errcode='22023',
            detail=pg_catalog.jsonb_build_object(
              'source_row_ordinal',v_source_row.source_row_ordinal,
              'reason','PRIOR_WORK_EVENT_ABSENT'
            )::text;
        end if;
        perform 1
        from public.weekly_work_events prior_event
        join public.weekly_source_row_resolutions prior_resolution
          on prior_resolution.work_event_id=prior_event.id
        where prior_event.id=v_prior_work_event_id
          and prior_event.candidate_id=v_candidate_id
          and prior_event.client_id=v_client_id
          and prior_event.first_source_group_id=v_group.id
          and prior_resolution.mapping_state='RESOLVED'
          and prior_resolution.contract_id=v_contract_id
          and (prior_resolution.upload_row_id<>v_source_row.id
            or (prior_resolution.generation<v_generation
              and prior_resolution.source_row_fingerprint=v_source_row.normalised_row_hash
              and exists(select 1 from public.weekly_source_projection_publications prior_publication
                where prior_publication.upload_id=v_upload.id
                  and coalesce(prior_publication.projection_generation,prior_publication.authority_scope_version)=prior_resolution.generation
                  and prior_publication.published_at_utc is not null
                  and prior_publication.state in ('CURRENT','STALE'))));
        if not found then
          raise exception 'WEEKLY_SOURCE_DURABLE_LINEAGE_UNPROVEN' using errcode='22023',
            detail=pg_catalog.jsonb_build_object(
              'source_row_ordinal',v_source_row.source_row_ordinal,
              'reason','NO_PRIOR_RESOLVED_CONTRACT_FOR_WORK_EVENT'
            )::text;
        end if;
      end if;

      v_effective_policy:=private._weekly_source_effective_policy_v1(
        v_client_id,v_contract_id,v_source_row.work_date
      );
      v_effective_policy_fingerprint:=private.weekly_source_projection_hex32_v1(
        v_effective_policy->>'policy_sha256','WEEKLY_SOURCE_POLICY_FINGERPRINT_INVALID'
      );
      if nullif(v_row_json->>'effective_policy_fingerprint','') is not null
         and private.weekly_source_projection_hex32_v1(
           v_row_json->>'effective_policy_fingerprint','WEEKLY_SOURCE_POLICY_FINGERPRINT_INVALID'
         ) is distinct from v_effective_policy_fingerprint then
        raise exception 'WEEKLY_SOURCE_POLICY_STALE' using errcode='40001';
      end if;
      v_invoice_rules:=private.weekly_source_effective_rule_set_v1(v_client_id,v_cycle.id)->'values';
      perform private.weekly_source_magnit_contract_price_assert_v1(v_invoice_rules,v_effective_policy);
      v_source_amount:=v_invoice_rules is not null and v_invoice_rules->>'invoice_sender'='CLIENT_SELF_BILL' and v_invoice_rules->>'invoice_amount_basis'='SOURCE_AMOUNT' and v_invoice_rules->>'source_amount_basis'='EXPORT_ACTUAL_COST_INC_VAT_NET_AGENCY_WORKER_PAY';
      v_source_authority:=coalesce(v_effective_policy->>'authority_mode','')='SOURCE_AUTHORITY';
      v_source_mode:=nullif(v_effective_policy->>'c1_source_mode','');
      if v_source_authority and (
           coalesce((v_effective_policy->>'self_bill_enabled')::boolean,false) is not true
           or v_source_mode not in ('NHSP_WEEKLY','HEALTHROSTER_WEEKLY')
         ) then
        raise exception 'WEEKLY_SOURCE_C1_MODE_UNRESOLVED' using errcode='55000';
      end if;
      if not v_source_authority and v_source_mode is not null then
        raise exception 'WEEKLY_SOURCE_TIMESHEET_AUTHORITY_C1_MODE_FORBIDDEN' using errcode='55000';
      end if;
      if (v_profile.profile_code in ('NHSP_PREFINAL_RELEASED_V1','NHSP_FINAL_BACKING_V1'))
           is distinct from (v_source_mode='NHSP_WEEKLY')
         and v_source_authority then
        raise exception 'WEEKLY_SOURCE_PROFILE_MODE_MISMATCH' using errcode='55000';
      end if;

      v_contract_settings_authority:=private._contract_settings_effective_core_v1(
        v_client_id,v_contract_id,v_source_row.work_date,'IMPORT',null
      );
      v_invoice_vat_chargeable:=coalesce(
        (v_contract_settings_authority#>>'{values,client_vat_chargeable}')::boolean,true
      );
      v_invoice_vat_rate_pct:=case when v_invoice_vat_chargeable then
        coalesce((v_contract_settings_authority#>>'{values,vat_rate_pct}')::numeric,20)
        else 0::numeric end;
      if v_invoice_vat_rate_pct<0 or v_invoice_vat_rate_pct>100 then
        raise exception 'WEEKLY_SOURCE_INVOICE_VAT_RATE_INVALID' using errcode='22023';
      end if;
      v_source_expense_vat_enabled:=coalesce(
        (v_effective_policy->>'source_expense_vat_enabled')::boolean,false
      );
      v_invoice_vat_policy_fingerprint:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_INVOICE_VAT_POLICY_V1',
        pg_catalog.jsonb_build_object(
          'client_id',v_client_id,'contract_id',v_contract_id,'work_date',v_source_row.work_date,
          'client_settings_id',v_contract_settings_authority->>'client_settings_id',
          'client_settings_effective_from',v_contract_settings_authority->>'client_settings_effective_from',
          'finance_settings_id',v_contract_settings_authority->>'finance_settings_id',
          'finance_settings_date_from',v_contract_settings_authority->>'finance_settings_date_from',
          'client_vat_chargeable',v_invoice_vat_chargeable,
          'vat_rate_pct',v_invoice_vat_rate_pct,
          'source_expense_vat_enabled',v_source_expense_vat_enabled,
          'settings_authority_fingerprint',v_contract_settings_authority->>'authority_fingerprint'
        )
      );

      -- G8-1/G8-2 (XSG-009).  `24 §14` and `25 §9`: a signed-Timesheet-authority
      -- row belongs to the established validation-only Mode A journey, never to
      -- source finalisation, and "merely labelling the row as Timesheet evidence
      -- is insufficient".  The unified upload owner therefore records the
      -- resolved Mode A authority as production data on the
      -- `weekly_timesheet_authority_resolutions` relation, which until now had
      -- no writer outside a verification fixture.
      -- `Reference required before pay` and `require_reference_to_invoice` come
      -- from the installed contract-settings authority and default to false;
      -- the auto-authorisation decision is taken from the established resolver
      -- `public.import_auto_authorise_policy_resolve_v2` in validation context,
      -- exactly as `public._import_review_auto_authorise_targets_core_v1` reads
      -- it, so no second policy engine is introduced.
      if not v_source_authority then
        if coalesce(v_effective_policy->>'document_mode','')<>'INVOICE_EVIDENCE_REQUIRED'
           or coalesce((v_effective_policy->>'self_bill_enabled')::boolean,false) then
          raise exception 'WEEKLY_SOURCE_TIMESHEET_AUTHORITY_POLICY_INVALID' using errcode='55000',
            detail=pg_catalog.jsonb_build_object(
              'source_row_ordinal',v_source_row.source_row_ordinal,
              'document_mode',v_effective_policy->>'document_mode',
              'self_bill_enabled',v_effective_policy->>'self_bill_enabled'
            )::text;
        end if;
        v_mode_a_policy:=public.import_auto_authorise_policy_resolve_v2(
          case when v_profile.profile_code in ('NHSP_PREFINAL_RELEASED_V1','NHSP_FINAL_BACKING_V1')
            then 'NHSP'::public.hr_source_enum
            else 'HEALTHROSTER'::public.hr_source_enum end,
          v_client_id,v_contract_id,null,v_source_row.work_date,true
        );
        insert into public.weekly_timesheet_authority_resolutions(
          source_cycle_id,client_id,contract_id,work_date,authority_mode,document_mode,
          require_reference_to_pay,require_reference_to_invoice,auto_authorise_enabled,
          effective_policy_fingerprint
        ) values (
          v_cycle.id,v_client_id,v_contract_id,v_source_row.work_date,
          'TIMESHEET_AUTHORITY','INVOICE_EVIDENCE_REQUIRED',
          coalesce((v_contract_settings_authority#>>'{values,require_reference_to_pay}')::boolean,false),
          coalesce((v_contract_settings_authority#>>'{values,require_reference_to_invoice}')::boolean,false),
          coalesce((v_mode_a_policy->>'effective_value')::boolean,false),
          v_effective_policy_fingerprint
        ) on conflict (source_cycle_id,contract_id,work_date,effective_policy_fingerprint) do nothing;
      end if;

      v_has_worked_tuple:=v_source_row.start_at_local is not null
        and v_source_row.end_at_local is not null
        and v_source_row.break_minutes is not null
        and coalesce(v_source_row.actual_net_minutes,0)>0;

      v_identity_kind:=pg_catalog.upper(pg_catalog.btrim(coalesce(v_row_json->>'identity_kind','')));
      if v_identity_kind not in ('PROFILE_EXTERNAL_KEY','SCHEDULE_TUPLE') then
        raise exception 'WEEKLY_SOURCE_WORK_EVENT_IDENTITY_INVALID' using errcode='22023';
      end if;
      if v_profile.profile_code in (
        'HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1',
        'HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1',
        'ROSTER_WEEKLY_SUMMARY_ACTUAL_V1'
      ) and v_identity_kind<>'PROFILE_EXTERNAL_KEY' then
        raise exception 'WEEKLY_SOURCE_PROFILE_EXTERNAL_EVENT_KEY_REQUIRED' using errcode='22023';
      end if;
      -- WP-58 / WP-50 finding F7, the mirror image of the guard above.
      -- Pack 24 section 1 supersedes "the NHSP Reference Number is the durable
      -- identity of the real shift", and 24 section 9 states the Reference
      -- Number is "not sole durable work identity": it, the ward and the
      -- location may all change during a correction. An NHSP shift is the same
      -- shift as another by the schedule tuple
      -- (private.weekly_source_work_event_schedule_compatible_v1), never by the
      -- reference. Reference-keyed identity on an NHSP row makes a reversal and
      -- its re-issue three separate work events for one corrected shift, which
      -- is what WP-50 executed. Until this guard existed, the only thing
      -- sending SCHEDULE_TUPLE for NHSP was one ternary in the broker
      -- (broker/src/weekly-source/upload-publication-owner.mjs), so the rule
      -- held on exactly one route. It is enforced here, where no caller can go
      -- round it.
      if v_profile.profile_code in (
        'NHSP_PREFINAL_RELEASED_V1',
        'NHSP_FINAL_BACKING_V1'
      ) and v_identity_kind<>'SCHEDULE_TUPLE' then
        raise exception 'WEEKLY_SOURCE_SCHEDULE_TUPLE_EVENT_KEY_REQUIRED' using errcode='22023';
      end if;
      v_profile_external_key:=case when v_identity_kind='PROFILE_EXTERNAL_KEY'
        then nullif(pg_catalog.btrim(coalesce(v_row_json->>'profile_external_key','')),'') end;
      if v_identity_kind='PROFILE_EXTERNAL_KEY'
         and (v_profile_external_key is null
              or v_profile_external_key is distinct from nullif(pg_catalog.btrim(v_source_row.external_source_key),'')) then
        raise exception 'WEEKLY_SOURCE_EXTERNAL_EVENT_KEY_REQUIRED' using errcode='22023';
      end if;

      if v_source_authority then
        select item into v_paid_choice from jsonb_array_elements(v_paid_choices) item
          where item->>'upload_row_id'=v_source_row.id::text;
        if v_paid_choice->>'schema_version'='WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_INPUT_V1' then
          v_nhsp_lock_input:=v_paid_choice;
          v_paid_choice:=private.weekly_source_paid_overlap_choice_current_v1(v_source_row.id,p_actor_user_id);
          perform private.weekly_source_nhsp_projection_choice_recheck_v1(v_nhsp_lock_input,v_paid_choice,p_actor_user_id,p_publication_id);
          select jsonb_agg(case when c->>'upload_row_id'=v_source_row.id::text then v_paid_choice else c end order by ord)
            into v_paid_choices from jsonb_array_elements(v_paid_choices) with ordinality choices(c,ord);
        end if;
        if v_paid_choice is not null then
          if v_paid_choice->>'candidate_id' is distinct from v_candidate_id::text
            or v_paid_choice->>'client_id' is distinct from v_client_id::text
            or v_paid_choice->>'contract_id' is distinct from v_contract_id::text
            or v_prior_work_event_id is distinct from case when v_paid_choice->>'pay_effect'='NONE'
              then (v_paid_choice->>'paid_overlap_target_work_event_id')::uuid else null end then
            raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_SCOPE_CHANGED' using errcode='40001';end if;
          v_pay_effect:=v_paid_choice->>'pay_effect';v_paid_choice_id:=(v_paid_choice->>'choice_id')::bigint;
          if v_identity_kind='SCHEDULE_TUPLE' and v_pay_effect='NORMAL' then
            if v_profile.profile_code<>'NHSP_FINAL_BACKING_V1'
              or v_publication.authority_scope_kind<>'NHSP_REPORT_SCOPE'
              or v_upload.purpose not in ('ORDINARY','FINAL_SOURCE_CORRECTION') or v_group.source_family<>'NHSP'
              or v_source_row.row_finalisation_state<>'SOURCE_WORKED'
              or v_source_row.source_shift_charge_pence is null or v_source_row.source_shift_charge_pence<0
              or v_paid_choice_id is null or v_prior_work_event_id is not null then
              raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_SEPARATE_SCOPE_INVALID' using errcode='55000';end if;
            -- The actual paid-choice owner already proved actor/Contract,
            -- paid target, no protection, full facts and I-1 membership. The
            -- same current-choice recheck also proved its entire native
            -- negative population. No caller boolean creates this event.
            v_nhsp_paid_separate:=true;
          end if;
        elsif v_identity_kind='PROFILE_EXTERNAL_KEY' and v_source_row.row_finalisation_state='SOURCE_WORKED'
          and not exists(select 1 from public.weekly_work_events key_event where key_event.first_source_group_id=v_group.id
            and key_event.source_format_profile_id=v_upload.source_format_profile_id and key_event.identity_kind='PROFILE_EXTERNAL_KEY'
            and key_event.profile_external_key=v_profile_external_key)
          and private.weekly_source_known_source_key_v1(v_source_row.id,v_candidate_id,v_client_id) is null
          and private.weekly_source_identical_rekey_prior_v1(v_source_row.id) is null then
          v_paid_inputs:=private.weekly_source_paid_overlap_candidates_v1(v_source_row.id,p_actor_user_id,v_candidate_id,v_client_id);
          if exists(select 1 from jsonb_array_elements(v_paid_inputs->'overlaps') item
            where item#>'{native_payment_facts,paid}' is distinct from 'false'::jsonb) then
            raise exception 'WEEKLY_SOURCE_PAID_SHIFT_MATCH_REQUIRED' using errcode='55000';end if;
        end if;
      end if;
      if v_source_authority and v_paid_choice is null then
        v_protected_matches:=private.weekly_source_protected_match_candidates_v1(v_source_row.id,v_candidate_id,v_client_id);
        select choice.work_event_id,choice.separate_shift into v_protected_choice,v_protected_separate
          from private.weekly_source_office_row_choices choice
          where choice.upload_row_id=v_source_row.id and choice.candidate_id=v_candidate_id
            and choice.client_id=v_client_id and choice.contract_id=v_contract_id
          order by choice.id desc limit 1;
        if v_protected_choice is not null then
          if v_prior_work_event_id is distinct from v_protected_choice
            or not exists(select 1 from jsonb_array_elements(v_protected_matches) match
              where match->>'work_event_id'=v_protected_choice::text and match->>'contract_id'=v_contract_id::text) then
            raise exception 'WEEKLY_SOURCE_PROTECTED_MATCH_NOT_ELIGIBLE' using errcode='40001';
          end if;
        elsif not coalesce(v_protected_separate,false) then
          if exists(select 1 from jsonb_array_elements(v_protected_matches) match
            where match->>'contract_id'=v_contract_id::text and (match->>'retained_source_identity')::boolean) then
            select coalesce(jsonb_agg(match),'[]'::jsonb) into v_protected_matches
              from jsonb_array_elements(v_protected_matches) match
              where match->>'contract_id'=v_contract_id::text and (match->>'retained_source_identity')::boolean;
          elsif exists(select 1 from jsonb_array_elements(v_protected_matches) match
            where match->>'contract_id'=v_contract_id::text and (match->>'schedule_compatible')::boolean) then
            select coalesce(jsonb_agg(match),'[]'::jsonb) into v_protected_matches
              from jsonb_array_elements(v_protected_matches) match
              where match->>'contract_id'=v_contract_id::text and (match->>'schedule_compatible')::boolean;
          end if;
          select count(*) into v_protected_count from jsonb_array_elements(v_protected_matches) match
            where match->>'contract_id'=v_contract_id::text;
          if v_protected_count>0 and (v_protected_count<>1 or not exists(
            select 1 from jsonb_array_elements(v_protected_matches) match
            where match->>'contract_id'=v_contract_id::text
              and ((match->>'schedule_compatible')::boolean or (match->>'retained_source_identity')::boolean)
              and match->>'work_event_id'=v_prior_work_event_id::text)) then
            raise exception 'WEEKLY_SOURCE_PROTECTED_MATCH_REQUIRED' using errcode='55000';
          end if;
        end if;
      end if;
      -- A new external key may reuse an old event only through the native
      -- identical proof or the independently admitted explicit Office choice.
      -- The current protected choice above was re-proved, never caller flags.
      if v_source_authority and v_identity_kind='PROFILE_EXTERNAL_KEY'
        and not exists(select 1 from public.weekly_work_events key_event
          where key_event.first_source_group_id=v_group.id
            and key_event.source_format_profile_id=v_upload.source_format_profile_id
            and key_event.identity_kind='PROFILE_EXTERNAL_KEY'
            and key_event.profile_external_key=v_profile_external_key)
        and v_paid_choice is null
        and not (v_source_authority and v_protected_choice is not null
          and v_protected_choice=v_prior_work_event_id) then
        v_identical_rekey_prior:=private.weekly_source_known_source_key_v1(v_source_row.id,v_candidate_id,v_client_id);
        if v_identical_rekey_prior is null then
          v_identical_rekey_prior:=private.weekly_source_identical_rekey_prior_v1(v_source_row.id);
        end if;
        if v_identical_rekey_prior is distinct from v_prior_work_event_id
          or (v_identical_rekey_prior is not null and (select saved.contract_id from public.weekly_source_row_resolutions saved
            where saved.work_event_id=v_prior_work_event_id and saved.mapping_state='RESOLVED'
            order by saved.created_at_utc desc,saved.id desc limit 1) is distinct from v_contract_id) then
          raise exception 'WEEKLY_SOURCE_REKEY_MATCH_UNPROVEN' using errcode='40001';
        end if;
      end if;
      if v_prior_work_event_id is not null then
        select * into strict v_work_event
        from public.weekly_work_events work_event
        where work_event.id=v_prior_work_event_id
          and work_event.candidate_id=v_candidate_id
          and work_event.client_id=v_client_id
          and work_event.first_source_group_id=v_group.id;
        if v_identity_kind='PROFILE_EXTERNAL_KEY'
           and exists(
             select 1
             from public.weekly_work_events other_event
             where other_event.first_source_group_id=v_group.id
               and other_event.source_format_profile_id=v_upload.source_format_profile_id
               and other_event.identity_kind='PROFILE_EXTERNAL_KEY'
               and other_event.profile_external_key=v_profile_external_key
               and other_event.id<>v_work_event.id
           ) then
          raise exception 'WEEKLY_SOURCE_PROFILE_EVENT_KEY_CONFLICT' using errcode='55000';
        end if;
        v_work_event_id:=v_work_event.id;
        v_work_event_match_kind:='EXACT_DURABLE_LINEAGE';
      else
        if v_identity_kind='PROFILE_EXTERNAL_KEY' then
          v_durable_identity_hash:=private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_WORK_EVENT_PROFILE_KEY_V1',
            pg_catalog.jsonb_build_object(
              'source_group_id',v_group.id,
              'source_format_profile_id',v_upload.source_format_profile_id,
              'profile_external_key',v_profile_external_key
            )
          );
        else
          -- WP-37 / `24 §9` step 2 and step 4.  The guarded set is read only
          -- after the family lock is held, so a concurrent publication cannot
          -- create a second root for the same work between this read and the
          -- insert below.
          perform pg_catalog.pg_advisory_xact_lock(
            pg_catalog.hashtextextended(
              v_group.id::text||'|'||v_upload.source_format_profile_id::text||'|'
                ||v_candidate_id::text||'|'||v_client_id::text||'|'
                ||v_source_row.work_date::text,
              17092026
            )
          );
          select pg_catalog.count(*)::integer,
                 pg_catalog.min(work_event.id::text)::uuid
            into v_compatible_count,v_compatible_event_id
          from public.weekly_work_events work_event
          where work_event.first_source_group_id=v_group.id
            and work_event.source_format_profile_id=v_upload.source_format_profile_id
            and work_event.identity_kind='SCHEDULE_TUPLE'
            and work_event.candidate_id=v_candidate_id
            and work_event.client_id=v_client_id
            and work_event.work_date=v_source_row.work_date
            and private.weekly_source_work_event_schedule_compatible_v1(
                  work_event.id,v_source_row.start_at_local,v_source_row.end_at_local
                );
          if v_compatible_count>1 and not v_nhsp_paid_separate then
            -- `24 §9`: "Office confirmation when more than one plausible
            -- relationship remains.  It never guesses."  No root is chosen.
            raise exception 'WEEKLY_SOURCE_WORK_EVENT_IDENTITY_AMBIGUOUS' using errcode='55000',
              detail=pg_catalog.jsonb_build_object(
                'source_row_ordinal',v_source_row.source_row_ordinal,
                'candidate_id',v_candidate_id,'client_id',v_client_id,
                'work_date',v_source_row.work_date,
                'compatible_work_event_count',v_compatible_count
              )::text;
          end if;
          -- The hash still carries this row's own schedule, so a genuinely
          -- different, non-overlapping shift on the same date gets its own
          -- durable identity.  It is a uniqueness token for a NEW root, not
          -- the identity rule: the rule is the compatible-schedule set above.
          v_durable_identity_hash:=private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_WORK_EVENT_SCHEDULE_TUPLE_V1',
            pg_catalog.jsonb_build_object(
              'source_group_id',v_group.id,'source_format_profile_id',v_upload.source_format_profile_id,
              'candidate_id',v_candidate_id,'client_id',v_client_id,'work_date',v_source_row.work_date,
              'start_at_local',v_source_row.start_at_local,'end_at_local',v_source_row.end_at_local
            )||case when v_nhsp_paid_separate then
              -- This is the persisted native Office choice identity. It
              -- creates a distinct event without rewriting any old key,
              -- treating Ref Num as identity, or creating an economic key.
              pg_catalog.jsonb_build_object('office_separate_choice_id',v_paid_choice_id,
                'office_separate_target_work_event_id',v_paid_choice->>'paid_overlap_target_work_event_id')
              else '{}'::jsonb end
          );
        end if;
        if v_identity_kind='SCHEDULE_TUPLE' and v_compatible_count=1 and not v_nhsp_paid_separate then
          select * into strict v_work_event
          from public.weekly_work_events work_event
          where work_event.id=v_compatible_event_id;
          v_work_event_was_present:=true;
        else
          select exists(
            select 1 from public.weekly_work_events work_event
            where work_event.durable_identity_hash=v_durable_identity_hash
          ) into v_work_event_was_present;
          insert into public.weekly_work_events(
            candidate_id,client_id,work_date,identity_kind,profile_external_key,
            durable_identity_hash,first_source_group_id,source_format_profile_id
          ) values (
            v_candidate_id,v_client_id,v_source_row.work_date,v_identity_kind,
            v_profile_external_key,v_durable_identity_hash,v_group.id,v_upload.source_format_profile_id
          ) on conflict (durable_identity_hash) do nothing;
          select * into strict v_work_event
          from public.weekly_work_events work_event
          where work_event.durable_identity_hash=v_durable_identity_hash;
        end if;
        if v_work_event.candidate_id is distinct from v_candidate_id
           or v_work_event.client_id is distinct from v_client_id
           or v_work_event.identity_kind is distinct from v_identity_kind
           or v_work_event.profile_external_key is distinct from v_profile_external_key
           or v_work_event.first_source_group_id is distinct from v_group.id
           or v_work_event.source_format_profile_id is distinct from v_upload.source_format_profile_id
           or (v_identity_kind='SCHEDULE_TUPLE' and v_work_event.work_date is distinct from v_source_row.work_date) then
          raise exception 'WEEKLY_SOURCE_WORK_EVENT_IDENTITY_COLLISION' using errcode='55000';
        end if;
        v_work_event_id:=v_work_event.id;
        v_work_event_match_kind:=case
          when v_identity_kind='PROFILE_EXTERNAL_KEY' and v_work_event_was_present then 'REUSED_PROFILE_KEY'
          when v_identity_kind='PROFILE_EXTERNAL_KEY' then 'NEW_PROFILE_KEY'
          when v_work_event_was_present then 'EXACT_DURABLE_LINEAGE'
          else 'NEW_SCHEDULE_TUPLE'
        end;
      end if;
      v_work_event_match_fingerprint:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_WORK_EVENT_MATCH_V1',
        pg_catalog.jsonb_build_object(
          'upload_row_id',v_source_row.id,'work_event_id',v_work_event_id,
          'match_kind',v_work_event_match_kind,'prior_work_event_id',v_prior_work_event_id,
          'source_row_fingerprint',pg_catalog.encode(v_source_row.normalised_row_hash,'hex')
        )
      );
    end if;

    -- Only a resolved, source-authoritative worked row owns a C1 economic
    -- snapshot.  Timesheet-authoritative validation rows, unfinished rows and
    -- explicit source-zero positions must never cross the pay boundary.
    if v_mapping_state='RESOLVED'
       and v_source_authority
       and v_source_row.row_finalisation_state in ('NOT_APPLICABLE','SOURCE_WORKED') then
      if not v_has_worked_tuple then
        raise exception 'WEEKLY_SOURCE_WORKED_TUPLE_REQUIRED' using errcode='22023';
      end if;
      if pg_catalog.jsonb_typeof(v_economic)<>'object'
         or v_economic->>'schema_version' is distinct from 'WEEKLY_SOURCE_CANONICAL_ECONOMIC_SNAPSHOT_V1'
         or v_economic->>'calculator_version' is distinct from 'WEEKLY_SHIFT_FINANCIAL_SEGMENT_V1'
         or pg_catalog.upper(coalesce(v_economic->>'source_mode','')) is distinct from v_source_mode
         or pg_catalog.upper(coalesce(v_economic->>'rate_method',''))
              is distinct from v_effective_policy->>'weekly_rate_classification_method'
         or pg_catalog.jsonb_typeof(v_economic->'bucket_minutes')<>'object'
         or pg_catalog.jsonb_typeof(v_economic->'hours')<>'object'
         or pg_catalog.jsonb_typeof(v_economic->'pay_rates')<>'object'
         or pg_catalog.jsonb_typeof(v_economic->'charge_rates')<>'object' then
        raise exception 'WEEKLY_SOURCE_ECONOMIC_SNAPSHOT_INVALID' using errcode='22023';
      end if;

      -- A structurally valid NHSP £0 line is still a worked row.  Source money
      -- decides whether a physical row is a reversal only when it is negative;
      -- zero therefore keeps the positive worked-time/pay sign while the
      -- invoice movement retains the exact £0 source value.
      v_row_sign:=case when v_source_mode='NHSP_WEEKLY' then
        case when coalesce(v_source_row.source_shift_charge_pence,0)<0 then -1 else 1 end
        else 1 end;
      if v_row_sign not in (-1,1)
         or coalesce(v_economic->>'sign','')!~'^[-]?[0-9]+$'

         or (v_economic->>'sign')::smallint is distinct from v_row_sign
         or coalesce(v_economic->>'paid_minutes','')!~'^[0-9]+$'

         or (v_economic->>'paid_minutes')::integer is distinct from v_source_row.actual_net_minutes
         or coalesce(v_economic->>'break_minutes','')!~'^[0-9]+$'

         or (v_economic->>'break_minutes')::integer is distinct from v_source_row.break_minutes then
        raise exception 'WEEKLY_SOURCE_ECONOMIC_SOURCE_TUPLE_MISMATCH' using errcode='22023';
      end if;

      if exists(
        select 1
        from (values ('day'),('night'),('sat'),('sun'),('bh')) bucket(name)
        where coalesce(v_economic#>>array['bucket_minutes',bucket.name],'')!~'^[0-9]+$'

           or coalesce(v_economic#>>array['hours',bucket.name],'')!~'^[+-]?[0-9]+([.][0-9]+)?$'

           or coalesce(v_economic#>>array['pay_rates',bucket.name],'')!~'^[+]?[0-9]+([.][0-9]+)?$'

           or coalesce(v_economic#>>array['charge_rates',bucket.name],'')!~'^[+]?[0-9]+([.][0-9]+)?$'

           or (v_economic#>>array['pay_rates',bucket.name])::numeric<=0
           or (v_economic#>>array['charge_rates',bucket.name])::numeric<=0
      ) then
        raise exception 'WEEKLY_SOURCE_ECONOMIC_BUCKET_INVALID' using errcode='22023';
      end if;
      if (
        (v_economic#>>'{bucket_minutes,day}')::integer+
        (v_economic#>>'{bucket_minutes,night}')::integer+
        (v_economic#>>'{bucket_minutes,sat}')::integer+
        (v_economic#>>'{bucket_minutes,sun}')::integer+
        (v_economic#>>'{bucket_minutes,bh}')::integer
      ) is distinct from v_source_row.actual_net_minutes then
        raise exception 'WEEKLY_SOURCE_ECONOMIC_MINUTES_MISMATCH' using errcode='22023';
      end if;
      if exists(
        select 1
        from (values ('day'),('night'),('sat'),('sun'),('bh')) bucket(name)
        where (v_economic#>>array['hours',bucket.name])::numeric is distinct from
          pg_catalog.round(
            ((v_economic#>>array['bucket_minutes',bucket.name])::numeric/60)*v_row_sign,2
          )
      ) then
        raise exception 'WEEKLY_SOURCE_ECONOMIC_HOURS_MISMATCH' using errcode='22023';
      end if;
      if coalesce(v_economic->>'total_pay_pence','')!~'^[-]?[0-9]+$'

         or coalesce(v_economic->>'calculated_charge_pence','')!~'^[-]?[0-9]+$'
 then
        raise exception 'WEEKLY_SOURCE_ECONOMIC_TOTAL_INVALID' using errcode='22023';
      end if;

      v_expected_pay_pence:=(pg_catalog.round(
        pg_catalog.round(
          pg_catalog.abs((v_economic#>>'{hours,day}')::numeric)*(v_economic#>>'{pay_rates,day}')::numeric+
          pg_catalog.abs((v_economic#>>'{hours,night}')::numeric)*(v_economic#>>'{pay_rates,night}')::numeric+
          pg_catalog.abs((v_economic#>>'{hours,sat}')::numeric)*(v_economic#>>'{pay_rates,sat}')::numeric+
          pg_catalog.abs((v_economic#>>'{hours,sun}')::numeric)*(v_economic#>>'{pay_rates,sun}')::numeric+
          pg_catalog.abs((v_economic#>>'{hours,bh}')::numeric)*(v_economic#>>'{pay_rates,bh}')::numeric,2
        )*100,0
      )::bigint)*v_row_sign;
      v_expected_charge_pence:=(pg_catalog.round(
        pg_catalog.round(
          pg_catalog.abs((v_economic#>>'{hours,day}')::numeric)*(v_economic#>>'{charge_rates,day}')::numeric+
          pg_catalog.abs((v_economic#>>'{hours,night}')::numeric)*(v_economic#>>'{charge_rates,night}')::numeric+
          pg_catalog.abs((v_economic#>>'{hours,sat}')::numeric)*(v_economic#>>'{charge_rates,sat}')::numeric+
          pg_catalog.abs((v_economic#>>'{hours,sun}')::numeric)*(v_economic#>>'{charge_rates,sun}')::numeric+
          pg_catalog.abs((v_economic#>>'{hours,bh}')::numeric)*(v_economic#>>'{charge_rates,bh}')::numeric,2
        )*100,0
      )::bigint)*v_row_sign;
      if (v_economic->>'total_pay_pence')::bigint is distinct from v_expected_pay_pence
         or (v_economic->>'calculated_charge_pence')::bigint is distinct from v_expected_charge_pence then
        raise exception 'WEEKLY_SOURCE_ECONOMIC_TOTAL_MISMATCH' using errcode='22023';
      end if;

      perform private.weekly_source_magnit_bucket_assert_v1(v_invoice_rules,v_economic);
      v_contract_rate_fingerprint:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_CONTRACT_RATE_AUTHORITY_V1',
        pg_catalog.jsonb_build_object(
          'contract_id',v_contract.id,'contract_updated_at',v_contract.updated_at,
          'rates_json',v_contract.rates_json,'additional_rates_json',v_contract.additional_rates_json,
          'rate_method',v_effective_policy->>'weekly_rate_classification_method',
          'duration_break_tie_rule',v_effective_policy->>'duration_break_tie_rule',
          'canonical_pay_rates',v_economic->'pay_rates',
          'canonical_charge_rates',v_economic->'charge_rates',
          'settings_authority_fingerprint',v_contract_settings_authority->>'authority_fingerprint'
        )
      );
      v_canonical_economic:=pg_catalog.jsonb_build_object(
        'schema_version','WEEKLY_SOURCE_CANONICAL_ECONOMIC_SNAPSHOT_V1',
        'calculator_version','WEEKLY_SHIFT_FINANCIAL_SEGMENT_V1',
        'source_mode',v_source_mode,
        'rate_method',v_effective_policy->>'weekly_rate_classification_method',
        'sign',v_row_sign,
        'paid_minutes',v_source_row.actual_net_minutes,
        'break_minutes',v_source_row.break_minutes,
        'bucket_minutes',v_economic->'bucket_minutes',
        'hours',v_economic->'hours',
        'pay_rates',v_economic->'pay_rates',
        'charge_rates',v_economic->'charge_rates',
        'total_pay_pence',v_expected_pay_pence::text,
        'calculated_charge_pence',v_expected_charge_pence::text,
        'invoice_vat_chargeable',v_invoice_vat_chargeable,
        'invoice_vat_rate_pct',v_invoice_vat_rate_pct,
        'source_expense_vat_enabled',v_source_expense_vat_enabled,
        'contract_and_rate_fingerprint',pg_catalog.encode(v_contract_rate_fingerprint,'hex'),
        'effective_policy_fingerprint',pg_catalog.encode(v_effective_policy_fingerprint,'hex'),
        'invoice_vat_policy_fingerprint',pg_catalog.encode(v_invoice_vat_policy_fingerprint,'hex'),
        'break_allocation',v_economic->'break_allocation'
      );
      v_calculation_fingerprint:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_CANONICAL_ECONOMIC_SNAPSHOT_V1',v_canonical_economic
      );
    else
      if pg_catalog.jsonb_typeof(v_economic)='object' then
        raise exception 'WEEKLY_SOURCE_ECONOMIC_SNAPSHOT_NOT_APPLICABLE' using errcode='22023';
      end if;
      if v_mapping_state='RESOLVED' and v_source_authority
         and v_source_row.row_finalisation_state='SOURCE_ABSENT_ZERO'
         and coalesce(v_source_row.actual_net_minutes,-1)<>0 then
        raise exception 'WEEKLY_SOURCE_SOURCE_ZERO_INVALID' using errcode='22023';
      end if;
    end if;

    if v_mapping_state='RESOLVED' then
      v_link_kind:=case
        when not v_source_authority then 'TIMESHEET_EVIDENCE'
        when v_profile.profile_code='NHSP_PREFINAL_RELEASED_V1'
          or v_source_row.row_finalisation_state='SOURCE_UNFINALISED' then 'PROVISIONAL_SOURCE'
        when v_source_row.row_finalisation_state='SOURCE_ABSENT_ZERO' then 'ZERO_SOURCE'
        when v_source_mode='NHSP_WEEKLY' and v_row_sign=-1 then 'FULL_NEGATIVE_SOURCE'
        else 'POSITIVE_SOURCE'
      end;
      if nullif(pg_catalog.upper(pg_catalog.btrim(coalesce(v_row_json->>'link_kind',''))),'')
           is distinct from v_link_kind then
        raise exception 'WEEKLY_SOURCE_LINK_KIND_MISMATCH' using errcode='22023';
      end if;
    elsif nullif(pg_catalog.btrim(coalesce(v_row_json->>'link_kind','')),'') is not null then
      raise exception 'WEEKLY_SOURCE_LINK_NOT_APPLICABLE' using errcode='22023';
    end if;

    insert into public.weekly_source_row_resolutions(
      upload_row_id,generation,candidate_id,client_id,contract_id,work_event_id,
      paid_minutes,rate_classifications_json,mapping_state,blocker_code,
      contract_selection_method,work_event_match_kind,work_event_match_fingerprint,
      qualification_profile_fingerprint,
      qualifying_contract_count,qualifying_contract_set_hash,source_row_fingerprint,
      contract_and_rate_fingerprint,effective_policy_fingerprint,pay_effect,paid_overlap_choice_id
    ) values (
      v_source_row.id,v_generation,v_candidate_id,v_client_id,v_contract_id,v_work_event_id,
      v_source_row.actual_net_minutes,v_canonical_economic,
      v_mapping_state,nullif(v_row_json->>'blocker_code',''),v_selection_method,
      v_work_event_match_kind,v_work_event_match_fingerprint,
      private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_QUALIFICATION_PROFILE_V1',
        pg_catalog.jsonb_build_object(
          'upload_row_id',v_source_row.id,'generation',v_generation,
          'qualifying_contract_ids',v_eligible_ids,'mapping_state',v_mapping_state
        )
      ),
      pg_catalog.jsonb_array_length(v_eligible_ids),v_eligible_hash,
      v_source_row.normalised_row_hash,
      case when v_mapping_state='RESOLVED' then coalesce(
        v_contract_rate_fingerprint,
        private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_SOURCE_NON_ECONOMIC_CONTRACT_AUTHORITY_V1',
          pg_catalog.jsonb_build_object(
            'contract_id',v_contract.id,'contract_updated_at',v_contract.updated_at,
            'rates_json',v_contract.rates_json,'additional_rates_json',v_contract.additional_rates_json,
            'source_row_state',v_source_row.row_finalisation_state
          )
        )
      ) end,
      case when v_mapping_state='RESOLVED' then v_effective_policy_fingerprint end,
      v_pay_effect,v_paid_choice_id
    ) returning id into v_resolution_id;

    if v_canonical_economic is not null then
      insert into public.weekly_source_row_economic_snapshots(
        row_resolution_id,upload_row_id,generation,work_event_id,
        candidate_id,client_id,contract_id,calculator_version,source_mode,rate_method,row_sign,
        paid_minutes,break_minutes,minutes_day,minutes_night,minutes_sat,minutes_sun,minutes_bh,
        hours_day,hours_night,hours_sat,hours_sun,hours_bh,
        pay_day,pay_night,pay_sat,pay_sun,pay_bh,
        charge_day,charge_night,charge_sat,charge_sun,charge_bh,
        total_pay_pence,calculated_charge_pence,
        invoice_vat_chargeable,invoice_vat_rate_pct,source_expense_vat_enabled,
        canonical_result_json,contract_and_rate_fingerprint,effective_policy_fingerprint,
        invoice_vat_policy_fingerprint,calculation_fingerprint
      ) values (
        v_resolution_id,v_source_row.id,v_generation,v_work_event_id,
        v_candidate_id,v_client_id,v_contract_id,'WEEKLY_SHIFT_FINANCIAL_SEGMENT_V1',
        v_source_mode,v_effective_policy->>'weekly_rate_classification_method',v_row_sign,
        v_source_row.actual_net_minutes,v_source_row.break_minutes,
        (v_economic#>>'{bucket_minutes,day}')::integer,
        (v_economic#>>'{bucket_minutes,night}')::integer,
        (v_economic#>>'{bucket_minutes,sat}')::integer,
        (v_economic#>>'{bucket_minutes,sun}')::integer,
        (v_economic#>>'{bucket_minutes,bh}')::integer,
        (v_economic#>>'{hours,day}')::numeric,
        (v_economic#>>'{hours,night}')::numeric,
        (v_economic#>>'{hours,sat}')::numeric,
        (v_economic#>>'{hours,sun}')::numeric,
        (v_economic#>>'{hours,bh}')::numeric,
        (v_economic#>>'{pay_rates,day}')::numeric,
        (v_economic#>>'{pay_rates,night}')::numeric,
        (v_economic#>>'{pay_rates,sat}')::numeric,
        (v_economic#>>'{pay_rates,sun}')::numeric,
        (v_economic#>>'{pay_rates,bh}')::numeric,
        (v_economic#>>'{charge_rates,day}')::numeric,
        (v_economic#>>'{charge_rates,night}')::numeric,
        (v_economic#>>'{charge_rates,sat}')::numeric,
        (v_economic#>>'{charge_rates,sun}')::numeric,
        (v_economic#>>'{charge_rates,bh}')::numeric,
        v_expected_pay_pence,v_expected_charge_pence,
        v_invoice_vat_chargeable,v_invoice_vat_rate_pct,v_source_expense_vat_enabled,
        v_canonical_economic,v_contract_rate_fingerprint,v_effective_policy_fingerprint,
        v_invoice_vat_policy_fingerprint,v_calculation_fingerprint
      );
    end if;

    if v_mapping_state='RESOLVED'
       and v_source_authority
       and v_profile.profile_code='ROSTER_WEEKLY_SUMMARY_ACTUAL_V1'
       and coalesce((v_effective_policy->>'source_fixed_expenses_enabled')::boolean,false) then
      if v_source_row.source_expense_pence is null
         or v_source_row.source_expense_parse_state not in ('VALID','OMITTED_ZERO')
         or (v_source_row.source_expense_parse_state='OMITTED_ZERO'
             and v_source_row.source_expense_pence<>0) then
        raise exception 'WEEKLY_SOURCE_EXPENSE_POLICY_SNAPSHOT_INPUT_INVALID'
          using errcode='22023';
      end if;
      if v_source_row.source_expense_pence>0 and (
           v_source_row.start_at_local is null or v_source_row.end_at_local is null
           or v_source_row.end_at_local<=v_source_row.start_at_local
           or v_source_row.break_minutes is null
         ) then
        raise exception 'WEEKLY_SOURCE_EXPENSE_DISPLAY_TUPLE_REQUIRED'
          using errcode='22023';
      end if;
      v_expense_policy_snapshot_hash:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_ROW_EXPENSE_POLICY_SNAPSHOT_V1',
        pg_catalog.jsonb_build_object(
          'row_resolution_id',v_resolution_id,'upload_row_id',v_source_row.id,
          'generation',v_generation,'work_event_id',v_work_event_id,
          'candidate_id',v_candidate_id,'client_id',v_client_id,
          'contract_id',v_contract_id,'row_finalisation_state',v_source_row.row_finalisation_state,
          'source_expense_pence',v_source_row.source_expense_pence,
          'source_expense_parse_state',v_source_row.source_expense_parse_state,
          'source_expense_vat_enabled',v_source_expense_vat_enabled,
          'invoice_vat_chargeable',v_invoice_vat_chargeable,
          'invoice_vat_rate_pct',v_invoice_vat_rate_pct,
          'correction_presentation',v_effective_policy->>'self_bill_correction_presentation',
          'effective_policy_fingerprint',pg_catalog.encode(v_effective_policy_fingerprint,'hex'),
          'invoice_vat_policy_fingerprint',pg_catalog.encode(v_invoice_vat_policy_fingerprint,'hex')
        )
      );
      insert into public.weekly_source_row_expense_policy_snapshots(
        row_resolution_id,upload_row_id,generation,work_event_id,
        candidate_id,client_id,contract_id,source_expense_pence,
        source_expense_parse_state,source_expense_vat_enabled,
        invoice_vat_chargeable,invoice_vat_rate_pct,correction_presentation,effective_policy_fingerprint,
        invoice_vat_policy_fingerprint,snapshot_hash
      ) values (
        v_resolution_id,v_source_row.id,v_generation,v_work_event_id,
        v_candidate_id,v_client_id,v_contract_id,v_source_row.source_expense_pence,
        v_source_row.source_expense_parse_state,v_source_expense_vat_enabled,
        v_invoice_vat_chargeable,v_invoice_vat_rate_pct,
        v_effective_policy->>'self_bill_correction_presentation',v_effective_policy_fingerprint,
        v_invoice_vat_policy_fingerprint,v_expense_policy_snapshot_hash
      );
    end if;

    if v_mapping_state='RESOLVED' then
      insert into public.weekly_work_event_source_links(
        work_event_id,upload_row_id,row_resolution_id,link_kind,link_hash
      ) values (
        v_work_event_id,v_source_row.id,v_resolution_id,
        v_link_kind,
        private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_SOURCE_WORK_EVENT_LINK_V1',
          pg_catalog.jsonb_build_object(
            'work_event_id',v_work_event_id,'upload_row_id',v_source_row.id,
            'resolution_id',v_resolution_id,'link_kind',v_link_kind
          )
        )
      );
    end if;

    for v_qualification in
      select value from pg_catalog.jsonb_array_elements(coalesce(v_row_json->'qualification_observations','[]'::jsonb))
    loop
      if v_profile.profile_code not in ('NHSP_PREFINAL_RELEASED_V1','NHSP_FINAL_BACKING_V1') then
        raise exception 'WEEKLY_SOURCE_QUALIFICATION_PROFILE_NOT_APPLICABLE' using errcode='22023';
      end if;
      v_result:=pg_catalog.upper(coalesce(v_qualification->>'comparison_result',''));
      -- G6-2/G6-4: a per-Contract qualification verdict is re-derived here
      -- from the immutable source pence and the caller's canonical pence for
      -- that Contract, using the same symmetric NHSP_TWO_COMPONENT_PENCE_V1
      -- rule (25 §6; 24 §8, §13; 14 §4.3 items 1 and 5; NHSP-BR-013). The
      -- eligible set that the selection method is proved against is therefore
      -- the set the server itself would admit. UNVERIFIABLE stays available
      -- as the fail-closed verdict and is never upgraded.
      v_charge_source_pence:=nullif(v_qualification->>'source_shift_charge_pence','')::bigint;
      v_charge_calculated_pence:=nullif(v_qualification->>'canonical_calculated_pence','')::bigint;
      if v_charge_source_pence is distinct from v_source_row.source_shift_charge_pence then
        raise exception 'WEEKLY_SOURCE_QUALIFICATION_SOURCE_PENCE_MISMATCH' using errcode='22023',
          detail=pg_catalog.jsonb_build_object(
            'source_row_ordinal',v_source_row.source_row_ordinal,
            'contract_id',v_qualification->>'contract_id'
          )::text;
      end if;
      v_charge_difference_pence:=case
        when v_charge_source_pence is null or v_charge_calculated_pence is null then null
        else v_charge_source_pence-v_charge_calculated_pence end;
      v_charge_expected_result:=case
        when v_charge_source_pence is null or v_charge_calculated_pence is null then 'UNVERIFIABLE'
        when v_charge_source_pence=0 and v_charge_calculated_pence<>0 then 'ZERO_SOURCE_CHARGE'
        when v_charge_calculated_pence=0 then 'MISMATCH'
        when v_charge_difference_pence=0 then 'EXACT'
        when (v_charge_difference_pence=1 or v_charge_difference_pence=-1)
          and ((v_charge_source_pence>0 and v_charge_calculated_pence>0)
            or (v_charge_source_pence<0 and v_charge_calculated_pence<0))
          then 'SOURCE_ROUNDING_EQUIVALENT'
        else 'MISMATCH' end;
      if v_result<>'UNVERIFIABLE' and v_result is distinct from v_charge_expected_result then
        raise exception 'WEEKLY_SOURCE_QUALIFICATION_RESULT_NOT_REDERIVED' using errcode='22023',
          detail=pg_catalog.jsonb_build_object(
            'source_row_ordinal',v_source_row.source_row_ordinal,
            'contract_id',v_qualification->>'contract_id',
            'claimed_result',v_result,'rederived_result',v_charge_expected_result,
            'signed_difference_pence',v_charge_difference_pence
          )::text;
      end if;
      -- Price does not decide Contract identity. Every safe canonical
      -- observation remains in the reliable base set; warning admission is a
      -- separate Office decision after Contract resolution.
      v_passed:=v_result in ('EXACT','SOURCE_ROUNDING_EQUIVALENT','MISMATCH','ZERO_SOURCE_CHARGE');
      perform 1
      from public.contracts contract
      where contract.id=(v_qualification->>'contract_id')::uuid
        and contract.candidate_id=v_candidate_id
        and contract.client_id=v_client_id
        and v_source_row.work_date between contract.start_date and coalesce(contract.end_date,'infinity'::date)
        and v_eligible_ids ? contract.id::text;
      if not found then
        raise exception 'WEEKLY_SOURCE_QUALIFICATION_CONTRACT_OUT_OF_SCOPE' using errcode='22023';
      end if;
      insert into public.weekly_source_contract_qualification_observations(
        upload_row_id,generation,candidate_id,client_id,contract_id,
        source_format_profile_id,qualification_profile_version,
        qualification_profile_fingerprint,contract_revision_fingerprint,
        source_shift_charge_pence,canonical_calculated_pence,
        source_charge_difference_pence,comparison_result,qualification_passed,
        ordered_reason_codes,evidence_fingerprint
      ) values (
        v_source_row.id,v_generation,v_candidate_id,v_client_id,
        (v_qualification->>'contract_id')::uuid,v_upload.source_format_profile_id,
        'NHSP_TWO_COMPONENT_PENCE_V1',
        private.weekly_source_sha256_jsonb_v1('NHSP_QUALIFICATION_PROFILE_V1',v_qualification),
        private.weekly_source_projection_hex32_v1(
          v_qualification->>'contract_revision_fingerprint','WEEKLY_SOURCE_CONTRACT_REVISION_FINGERPRINT_INVALID'
        ),
        v_charge_source_pence,
        v_charge_calculated_pence,
        v_charge_difference_pence,
        v_result,v_passed,
        coalesce(array(select pg_catalog.jsonb_array_elements_text(v_qualification->'reason_codes')),'{}'::text[]),
        private.weekly_source_sha256_jsonb_v1('NHSP_CONTRACT_QUALIFICATION_EVIDENCE_V1',v_qualification)
      );
    end loop;

    v_charge:=v_row_json->'charge_check';
    if v_source_amount and v_calculation_fingerprint is not null and jsonb_typeof(v_charge) is distinct from 'object' then
      raise exception 'WEEKLY_SOURCE_INVOICE_SOURCE_PRICE_MISSING' using errcode='55000'; end if;
    if v_charge is not null and pg_catalog.jsonb_typeof(v_charge)='object' then
      if (v_profile.profile_code not in ('NHSP_PREFINAL_RELEASED_V1','NHSP_FINAL_BACKING_V1') and not coalesce(v_source_amount,false))
         or v_mapping_state<>'RESOLVED' then
        raise exception 'WEEKLY_SOURCE_CHARGE_CHECK_NOT_APPLICABLE' using errcode='22023';
      end if;
      if v_calculation_fingerprint is null then
        raise exception 'WEEKLY_SOURCE_CHARGE_FINGERPRINT_MISSING' using errcode='55000';
      end if;
      if nullif(v_charge->>'charge_calculation_fingerprint','') is not null
         and private.weekly_source_projection_hex32_v1(
               v_charge->>'charge_calculation_fingerprint',
               'WEEKLY_SOURCE_CHARGE_FINGERPRINT_INVALID'
             ) is distinct from v_calculation_fingerprint then
        raise exception 'WEEKLY_SOURCE_CHARGE_FINGERPRINT_MISMATCH' using errcode='22023';
      end if;
      if nullif(v_charge->>'source_commission_pence','')::bigint
            is distinct from v_source_row.source_commission_pence
         or nullif(v_charge->>'source_total_cost_pence','')::bigint
            is distinct from v_source_row.source_total_cost_pence
         or nullif(v_charge->>'source_shift_charge_pence','')::bigint
            is distinct from v_source_row.source_shift_charge_pence
         or nullif(v_charge->>'calculated_segment_charge_pence','')::bigint
            is distinct from v_expected_charge_pence then
        raise exception 'WEEKLY_SOURCE_CHARGE_CHECK_ECONOMIC_MISMATCH' using errcode='22023';
      end if;
      -- G6-2: server-side re-derivation of the NHSP_TWO_COMPONENT_PENCE_V1
      -- verdict. Authority: 25 §6; 24 §13; 14 §4.3 items 1 and 5;
      -- NHSP-BR-013; PRC-006, PRC-007, PRC-020, NHSBR-019, NHSBR-020.
      -- The four inputs are already anchored above to the immutable upload
      -- row and to this server's own canonical calculation, so the verdict
      -- is recomputed here from those facts. A caller may never upgrade a
      -- verdict: anything other than the fail-closed UNVERIFIABLE must equal
      -- the re-derived result, and the sign kind must equal the re-derived
      -- sign kind. EXACT is a zero difference. SOURCE_ROUNDING_EQUIVALENT is
      -- the same non-zero sign on the source and calculated pence with an
      -- absolute difference of exactly one penny in either arithmetic
      -- direction; no directional constraint is permitted.
      v_charge_source_pence:=v_source_row.source_shift_charge_pence;
      v_charge_calculated_pence:=v_expected_charge_pence;
      v_charge_difference_pence:=case
        when v_charge_source_pence is null or v_charge_calculated_pence is null then null
        else v_charge_source_pence-v_charge_calculated_pence end;
      v_charge_expected_sign_kind:=case
        when v_charge_source_pence is null then null
        when v_charge_source_pence>0 then 'POSITIVE'
        when v_charge_source_pence<0 then 'FULL_NEGATIVE'
        when v_charge_calculated_pence>0 then 'POSITIVE'
        when v_charge_calculated_pence<0 then 'FULL_NEGATIVE' end;
      if v_source_amount then
        if v_source_row.source_money_parse_state<>'VALID' or v_charge_source_pence is null or v_charge_source_pence<0 or v_charge_calculated_pence is null or v_charge_calculated_pence<=0 then
          raise exception 'WEEKLY_SOURCE_INVOICE_SOURCE_PRICE_INVALID' using errcode='55000'; end if;
        v_charge_expected_result:=case when v_charge_difference_pence=0 then 'EXACT' when abs(v_charge_difference_pence)=1 then 'SOURCE_ROUNDING_EQUIVALENT' else 'SOURCE_AMOUNT_DIFFERS' end;
        v_charge_expected_sign_kind:='POSITIVE';
      else
      v_charge_expected_result:=case
        when v_source_row.source_commission_pence is null
          or v_source_row.source_total_cost_pence is null
          or v_charge_source_pence is null
          or v_charge_calculated_pence is null then 'UNVERIFIABLE'
        when v_charge_source_pence=0 and v_charge_calculated_pence<>0 then 'ZERO_SOURCE_CHARGE'
        when v_charge_calculated_pence=0 then 'MISMATCH'
        when v_charge_difference_pence=0 then 'EXACT'
        when (v_charge_difference_pence=1 or v_charge_difference_pence=-1)
          and ((v_charge_source_pence>0 and v_charge_calculated_pence>0)
            or (v_charge_source_pence<0 and v_charge_calculated_pence<0))
          then 'SOURCE_ROUNDING_EQUIVALENT'
        else 'MISMATCH' end;
      end if;
      v_charge_claimed_result:=pg_catalog.upper(pg_catalog.btrim(
        coalesce(v_charge->>'comparison_result','')));
      v_charge_row_sign_kind:=pg_catalog.upper(pg_catalog.btrim(
        coalesce(v_charge->>'row_sign_kind','')));
      if (v_source_amount or v_charge_claimed_result<>'UNVERIFIABLE')
         and v_charge_claimed_result is distinct from v_charge_expected_result then
        raise exception 'WEEKLY_SOURCE_CHARGE_CHECK_RESULT_NOT_REDERIVED'
          using errcode='22023',
            detail=pg_catalog.jsonb_build_object(
              'source_row_ordinal',v_source_row.source_row_ordinal,
              'claimed_result',v_charge_claimed_result,
              'rederived_result',v_charge_expected_result,
              'signed_difference_pence',v_charge_difference_pence
            )::text;
      end if;
      if v_charge_claimed_result<>'UNVERIFIABLE'
         and v_charge_row_sign_kind is distinct from v_charge_expected_sign_kind then
        raise exception 'WEEKLY_SOURCE_CHARGE_CHECK_SIGN_NOT_REDERIVED'
          using errcode='22023',
            detail=pg_catalog.jsonb_build_object(
              'source_row_ordinal',v_source_row.source_row_ordinal,
              'claimed_row_sign_kind',v_charge_row_sign_kind,
              'rederived_row_sign_kind',v_charge_expected_sign_kind
            )::text;
      end if;
      insert into public.weekly_source_charge_checks(
        upload_row_id,row_resolution_id,generation,row_sign_kind,
        source_commission_pence,source_total_cost_pence,source_shift_charge_pence,
        calculated_segment_charge_pence,source_charge_difference_pence,
        comparison_profile_version,comparison_result,comparison_reason_code,
        phase_severity,blocker_code,charge_calculation_fingerprint
      ) values (
        v_source_row.id,v_resolution_id,v_generation,
        coalesce(v_charge_expected_sign_kind,v_charge_row_sign_kind),
        v_source_row.source_commission_pence,
        v_source_row.source_total_cost_pence,
        v_charge_source_pence,
        v_charge_calculated_pence,
        v_charge_difference_pence,
        case when v_source_amount then 'SOURCE_INVOICE_MONEY_PENCE_V1' else 'NHSP_TWO_COMPONENT_PENCE_V1' end,v_charge_claimed_result,
        coalesce(v_charge->>'comparison_reason_code',''),pg_catalog.upper(v_charge->>'phase_severity'),
        nullif(v_charge->>'blocker_code',''),
        v_calculation_fingerprint
      );
    end if;

    v_applied:=v_applied+1;
  end loop;

  if v_nhsp_phased_projection then
    select coalesce(jsonb_agg(private.weekly_source_paid_overlap_choice_current_v1(r.id,p_actor_user_id) order by r.id),'[]'::jsonb)
      into v_paid_recheck from public.weekly_source_upload_rows r
      join lateral(select c.* from private.weekly_source_office_row_choices c
        where c.upload_row_id=r.id order by c.id desc limit 1) choice on true
      where r.upload_id=v_upload.id and choice.paid_overlap_target_work_event_id is not null;
    if v_paid_recheck is distinct from v_paid_choices then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_CHANGED' using errcode='40001';end if;
  end if;

  if v_applied<>v_expected or exists(
    select 1 from public.weekly_source_upload_rows source_row
    where source_row.upload_id=v_upload.id
      and not exists(
        select 1 from public.weekly_source_row_resolutions resolution
        where resolution.upload_row_id=source_row.id and resolution.generation=v_generation
      )
  ) then
    raise exception 'WEEKLY_SOURCE_PROJECTION_RESOLUTION_CENSUS_INCOMPLETE' using errcode='55000';
  end if;

  return pg_catalog.jsonb_build_object(
    'ok',true,'publication_id',v_publication.id,'upload_id',v_upload.id,
    'authority_scope_version',v_publication.authority_scope_version,
    'generation',v_generation,'applied_row_count',v_applied
  );
exception
  when invalid_text_representation or numeric_value_out_of_range then
    raise exception 'WEEKLY_SOURCE_PROJECTION_VALUE_INVALID' using errcode='22023';
end;
$function$;

create or replace function private.weekly_source_kept_as_paid_facts_v1(p_work_event_id uuid,p_reason text)
returns bytea language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_event public.weekly_work_events%rowtype; v_publication uuid;
begin
  if p_work_event_id is null or p_reason is null or p_reason not in ('CREDITED','NOT_INVOICED_DISAPPEARED') then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_REASON_INVALID' using errcode='22023'; end if;
  select * into strict v_event from public.weekly_work_events where id=p_work_event_id;
  select publication.id into v_publication
  from public.weekly_source_projection_publications publication
  join public.weekly_source_uploads upload on upload.id=publication.upload_id
  join public.weekly_source_cycles cycle on cycle.id=upload.source_cycle_id
  join public.weekly_source_format_profiles profile on profile.id=upload.source_format_profile_id
  where cycle.source_group_id=v_event.first_source_group_id
    and (cycle.scope_client_id is null or cycle.scope_client_id=v_event.client_id)
    and publication.state='CURRENT' and upload.state='CURRENT'
    and publication.source_cycle_id=cycle.id and publication.report_scope_id is null
    and cycle.current_projection_publication_id=publication.id
    and ((upload.purpose='ORDINARY' and upload.correction_session_id is null
      and publication.correction_session_id is null)
      or (upload.purpose='FINAL_SOURCE_CORRECTION' and exists(
          select 1 from public.weekly_final_source_correction_sessions applied
          join public.weekly_source_final_revisions final on final.id=applied.applied_final_revision_id
          where applied.id=upload.correction_session_id and publication.correction_session_id=applied.id
            and applied.source_cycle_id=cycle.id and applied.authority_scope_kind='CYCLE'
            and applied.report_scope_id is null and applied.state='APPLIED'
            and applied.prepared_final_revision_id=applied.applied_final_revision_id
            and applied.replacement_correction_upload_id=upload.id
            and applied.replacement_projection_publication_id=publication.id
            and applied.completed_at_utc is not null
            and final.source_cycle_id=cycle.id and final.authority_scope_kind='CYCLE'
            and final.report_scope_id is null and final.upload_id=upload.id
            and final.reason='CORRECT_FINAL_SOURCE' and final.state='CURRENT'
            and final.predecessor_revision_id=applied.expected_current_final_revision_id
            and cycle.current_final_revision_id=final.id
            and applied.result_json->>'status'='CORRECTED'
            and applied.result_json->>'correction_session_id'=applied.id::text
            and applied.result_hash=private.weekly_source_sha256_jsonb_v1(
              'WEEKLY_SOURCE_CORRECT_FINAL_RESULT_V1',applied.result_json)
            and applied.review_result_hash=private.weekly_source_sha256_jsonb_v1(
              'WEEKLY_SOURCE_CORRECT_FINAL_REVIEW_RESULT_V1',applied.review_result_json))))
    and publication.authority_scope_kind='CYCLE' and upload.report_scope_id is null
    and profile.profile_code in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1',
      'HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1','ROSTER_WEEKLY_SUMMARY_ACTUAL_V1')
    and upload.row_manifest_hash is not null and upload.coverage_state='COMPLETE'
    and upload.coverage_timezone='Europe/London'
    and v_event.work_date between upload.confirmed_coverage_start_local_date and upload.confirmed_coverage_end_local_date
    and (upload.file_metadata_json->>'client_id'=v_event.client_id::text
      or (nullif(upload.file_metadata_json->>'client_id','') is null and
        (select count(*) from public.weekly_source_group_clients gc
          where gc.source_group_id=cycle.source_group_id
            and cycle.finalisation_week_ending between gc.valid_from and coalesce(gc.valid_to,'infinity'::date))=1
        and exists(select 1 from public.weekly_source_group_clients gc
          where gc.source_group_id=cycle.source_group_id and gc.client_id=v_event.client_id
            and cycle.finalisation_week_ending between gc.valid_from and coalesce(gc.valid_to,'infinity'::date))))
  order by publication.published_at_utc desc,publication.created_at_utc desc,publication.id desc limit 1;
  if not found then raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_EXPORT_UNAVAILABLE' using errcode='55000'; end if;
  return private.weekly_source_kept_as_paid_facts_for_publication_v1(v_event.id,p_reason,v_publication);
end;
$function$;

create or replace function private.weekly_source_kept_as_paid_context_v1(p_work_event_id uuid,p_actor_user_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_event public.weekly_work_events%rowtype; v_resolution public.weekly_source_row_resolutions%rowtype; v_publication uuid;
begin
  select * into strict v_event from public.weekly_work_events where id=p_work_event_id;
  select * into strict v_resolution from public.weekly_source_row_resolutions
    where work_event_id=v_event.id and mapping_state='RESOLVED'
    order by created_at_utc desc,id desc limit 1;
  if v_resolution.candidate_id is distinct from v_event.candidate_id or v_resolution.client_id is distinct from v_event.client_id
    or not exists(select 1 from public.contracts c where c.id=v_resolution.contract_id
      and c.candidate_id=v_event.candidate_id and c.client_id=v_event.client_id) then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_LINEAGE_UNBOUND' using errcode='55000'; end if;
  select publication.id into v_publication
  from public.weekly_source_projection_publications publication
  join public.weekly_source_uploads upload on upload.id=publication.upload_id
  join public.weekly_source_cycles cycle on cycle.id=upload.source_cycle_id
  join public.weekly_source_format_profiles profile on profile.id=upload.source_format_profile_id
  where cycle.source_group_id=v_event.first_source_group_id
    and (cycle.scope_client_id is null or cycle.scope_client_id=v_event.client_id)
    and publication.state='CURRENT' and upload.state='CURRENT'
    and publication.source_cycle_id=cycle.id and publication.report_scope_id is null
    and cycle.current_projection_publication_id=publication.id
    and ((upload.purpose='ORDINARY' and upload.correction_session_id is null
      and publication.correction_session_id is null)
      or (upload.purpose='FINAL_SOURCE_CORRECTION' and exists(
          select 1 from public.weekly_final_source_correction_sessions applied
          join public.weekly_source_final_revisions final on final.id=applied.applied_final_revision_id
          where applied.id=upload.correction_session_id and publication.correction_session_id=applied.id
            and applied.source_cycle_id=cycle.id and applied.authority_scope_kind='CYCLE'
            and applied.report_scope_id is null and applied.state='APPLIED'
            and applied.prepared_final_revision_id=applied.applied_final_revision_id
            and applied.replacement_correction_upload_id=upload.id
            and applied.replacement_projection_publication_id=publication.id
            and applied.completed_at_utc is not null
            and final.source_cycle_id=cycle.id and final.authority_scope_kind='CYCLE'
            and final.report_scope_id is null and final.upload_id=upload.id
            and final.reason='CORRECT_FINAL_SOURCE' and final.state='CURRENT'
            and final.predecessor_revision_id=applied.expected_current_final_revision_id
            and cycle.current_final_revision_id=final.id
            and applied.result_json->>'status'='CORRECTED'
            and applied.result_json->>'correction_session_id'=applied.id::text
            and applied.result_hash=private.weekly_source_sha256_jsonb_v1(
              'WEEKLY_SOURCE_CORRECT_FINAL_RESULT_V1',applied.result_json)
            and applied.review_result_hash=private.weekly_source_sha256_jsonb_v1(
              'WEEKLY_SOURCE_CORRECT_FINAL_REVIEW_RESULT_V1',applied.review_result_json))))
    and publication.authority_scope_kind='CYCLE' and upload.report_scope_id is null
    and profile.profile_code in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1',
      'HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1','ROSTER_WEEKLY_SUMMARY_ACTUAL_V1')
    and upload.row_manifest_hash is not null and upload.coverage_state='COMPLETE' and upload.coverage_timezone='Europe/London'
    and v_event.work_date between upload.confirmed_coverage_start_local_date and upload.confirmed_coverage_end_local_date
    and (upload.file_metadata_json->>'client_id'=v_event.client_id::text or
      (nullif(upload.file_metadata_json->>'client_id','') is null and
        (select count(*) from public.weekly_source_group_clients gc where gc.source_group_id=cycle.source_group_id
          and cycle.finalisation_week_ending between gc.valid_from and coalesce(gc.valid_to,'infinity'::date))=1
        and exists(select 1 from public.weekly_source_group_clients gc where gc.source_group_id=cycle.source_group_id
          and gc.client_id=v_event.client_id and cycle.finalisation_week_ending between gc.valid_from and coalesce(gc.valid_to,'infinity'::date))))
  order by publication.published_at_utc desc,publication.created_at_utc desc,publication.id desc limit 1;
  if v_publication is null then raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_EXPORT_UNAVAILABLE' using errcode='55000'; end if;
  return private.weekly_source_kept_as_paid_context_for_publication_v1(v_event.id,p_actor_user_id,v_publication);
end;
$function$;

create or replace function public.weekly_source_keep_as_paid_decide_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_keys constant text[]:=array['schema_version','actor_user_id','work_event_id','decision',
    'reason','credit_invoice_line_id','expected_facts_fingerprint','idempotency_key'];
  v_actor uuid; v_event_id uuid; v_credit uuid; v_reason text; v_key text; v_expected bytea; v_request_hash bytea;
  v_event public.weekly_work_events%rowtype; v_decision public.weekly_source_kept_as_paid_decisions%rowtype;
  v_audit public.audit_events%rowtype; v_context jsonb; v_roots uuid[]; v_locks jsonb;
  v_facts bytea; v_sequence bigint; v_acknowledged_at timestamptz; v_result jsonb; v_audit_payload jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if jsonb_typeof(p_request) is distinct from 'object' or not p_request ?& v_keys
    or p_request-v_keys<>'{}'::jsonb or p_request->>'schema_version' is distinct from 'WEEKLY_SOURCE_KEEP_AS_PAID_REQUEST_V1'
    or p_request->>'decision' is distinct from 'KEEP_AS_PAID'
    or jsonb_typeof(p_request->'actor_user_id') is distinct from 'string'
    or jsonb_typeof(p_request->'work_event_id') is distinct from 'string'
    or jsonb_typeof(p_request->'reason') is distinct from 'string'
    or jsonb_typeof(p_request->'idempotency_key') is distinct from 'string'
    or jsonb_typeof(p_request->'expected_facts_fingerprint') is distinct from 'string'
    or p_request->>'expected_facts_fingerprint' !~ '^[0-9a-f]{64}$' then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_REQUEST_INVALID' using errcode='22023'; end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid; v_event_id:=(p_request->>'work_event_id')::uuid;
    v_credit:=(p_request->>'credit_invoice_line_id')::uuid;
    v_expected:=decode(p_request->>'expected_facts_fingerprint','hex');
  exception when invalid_text_representation then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_REQUEST_INVALID' using errcode='22023'; end;
  v_reason:=p_request->>'reason'; v_key:=btrim(p_request->>'idempotency_key');
  if v_actor is null or v_event_id is null or v_reason not in ('CREDITED','NOT_INVOICED_DISAPPEARED')
    or char_length(v_key) not between 16 and 200
    or (v_reason='CREDITED') is distinct from (v_credit is not null)
    or (v_reason='CREDITED' and jsonb_typeof(p_request->'credit_invoice_line_id') is distinct from 'string')
    or (v_reason<>'CREDITED' and p_request->'credit_invoice_line_id' is distinct from 'null'::jsonb) then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_REQUEST_INVALID' using errcode='22023'; end if;
  -- Native active payment authority precedes even an exact historical replay.
  -- A former authoriser cannot use the service dispatcher to read its old ACK.
  if private.weekly_source_pay_actor_allowed_v1(v_actor) is distinct from true then
    raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
  -- Include the actual actor and complete reviewed request. Old-key collision
  -- never becomes a fresh acknowledgement or a different user's replay.
  v_request_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_KEEP_AS_PAID_REQUEST_V1',p_request);
  select audit.* into v_audit from public.audit_events audit
    where audit.action='WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED'
      and audit.object_type='weekly_source_kept_as_paid_decisions'
      and audit.after_json->>'idempotency_key'=v_key
    order by audit.ts_utc,audit.id limit 1;
  if found then
    if v_audit.actor_user_id is distinct from v_actor or v_audit.object_id_text is distinct from v_event_id::text
      or v_audit.after_json->>'schema_version' is distinct from 'WEEKLY_SOURCE_KEEP_AS_PAID_ACK_V1'
      or v_audit.after_json->>'request_sha256' is distinct from encode(v_request_hash,'hex')
      or v_audit.after_json->'request' is distinct from p_request then
      raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_IDEMPOTENCY_COLLISION' using errcode='22023'; end if;
    return v_audit.after_json->'result'||jsonb_build_object('idempotent_replay',true);
  end if;
  select * into strict v_event from public.weekly_work_events where id=v_event_id;
  v_context:=private.weekly_source_kept_as_paid_context_v1(v_event.id,v_actor);
  perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',v_event.first_source_group_id,
    v_event.client_id,(v_context->>'finalisation_week_ending')::date);
  perform private.weekly_source_pay_query_admit_v2();
  select coalesce(array_agg(value::uuid order by value::uuid),'{}'::uuid[]) into v_roots
    from jsonb_array_elements_text(v_context->'root_timesheet_ids') value;
  if cardinality(v_roots)=0 then raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_ROOT_UNAVAILABLE' using errcode='55000'; end if;
  -- Same native I-1 candidate/family boundary as accepted publication. The
  -- purpose-bound acknowledgement gates follow it, before any business rows.
  v_locks:=private.weekly_source_lock_and_resolve_families_v1(v_event.candidate_id,v_roots,
    'WORKBENCH_CANDIDATE_ENTITLEMENT_PUBLICATION',gen_random_uuid(),'WEEKLY_SOURCE_ENTITLEMENT_PUBLICATION');
  if v_locks->>'ok' is distinct from 'true' or v_locks->>'gate' is distinct from 'GRANTED' then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  perform pg_advisory_xact_lock(hashtextextended('weekly-source-kept-as-paid-request:'||v_key,0));
  perform pg_advisory_xact_lock(hashtextextended('weekly-source-kept-as-paid-event:'||v_event.id::text,0));
  select audit.* into v_audit from public.audit_events audit
    where audit.action='WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED'
      and audit.object_type='weekly_source_kept_as_paid_decisions' and audit.after_json->>'idempotency_key'=v_key
    order by audit.ts_utc,audit.id limit 1;
  if found then
    if v_audit.actor_user_id is distinct from v_actor or v_audit.object_id_text is distinct from v_event_id::text
      or v_audit.after_json->>'schema_version' is distinct from 'WEEKLY_SOURCE_KEEP_AS_PAID_ACK_V1'
      or v_audit.after_json->>'request_sha256' is distinct from encode(v_request_hash,'hex')
      or v_audit.after_json->'request' is distinct from p_request then
      raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_IDEMPOTENCY_COLLISION' using errcode='22023'; end if;
    return v_audit.after_json->'result'||jsonb_build_object('idempotent_replay',true);
  end if;
  perform 1 from public.weekly_source_groups where id=v_event.first_source_group_id for update;
  perform 1 from public.weekly_source_cycles where id=(v_context->>'source_cycle_id')::uuid for update;
  perform 1 from public.weekly_work_events where id=v_event.id for share;
  v_context:=private.weekly_source_kept_as_paid_context_v1(v_event.id,v_actor);
  if v_context->'root_timesheet_ids' is distinct from to_jsonb(v_roots) then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_SCOPE_CHANGED' using errcode='40001'; end if;
  perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',v_event.first_source_group_id,
    v_event.client_id,(v_context->>'finalisation_week_ending')::date);
  v_facts:=private.weekly_source_kept_as_paid_facts_v1(v_event.id,v_reason);
  if v_facts is distinct from v_expected or v_context->>'facts_fingerprint' is distinct from encode(v_facts,'hex')
    or v_context->>'reason' is distinct from v_reason then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_FACTS_CHANGED' using errcode='40001'; end if;
  if v_context->'source_present' is distinct from 'false'::jsonb
    or v_context->'current_pay_head_movement_id'='null'::jsonb
    or not (v_context->'invoiced'='true'::jsonb or v_context->'paid'='true'::jsonb)
    or (v_reason='NOT_INVOICED_DISAPPEARED' and v_context->'invoiced' is distinct from 'false'::jsonb)
    or (v_reason='CREDITED' and not exists(select 1 from jsonb_array_elements(v_context->'credit_lines') line
      where line->>'invoice_line_id'=v_credit::text)) then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_NOT_ELIGIBLE' using errcode='55000'; end if;
  insert into public.weekly_source_kept_as_paid_decisions(work_event_id,decision,reason,credit_invoice_line_id,
    facts_fingerprint,actor_user_id) values(v_event.id,'KEEP_AS_PAID',v_reason,v_credit,v_facts,v_actor)
    on conflict do nothing;
  select * into strict v_decision from public.weekly_source_kept_as_paid_decisions
    where work_event_id=v_event.id and reason=v_reason and credit_invoice_line_id is not distinct from v_credit
      and facts_fingerprint=v_facts;
  -- A→B→A with a NEW reviewed request links the immutable A decision but
  -- appends a new actual acknowledgement. No old record/timestamp is updated.
  select coalesce(max((audit.after_json->>'acknowledgement_sequence')::bigint),0)+1 into v_sequence
    from public.audit_events audit where audit.action='WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED'
      and audit.object_type='weekly_source_kept_as_paid_decisions' and audit.object_id_text=v_event.id::text;
  v_acknowledged_at:=clock_timestamp();
  v_result:=jsonb_build_object('ok',true,'decision','KEEP_AS_PAID','decision_id',v_decision.id,
    'work_event_id',v_event.id,'reason',v_reason,'credit_invoice_line_id',v_credit,
    'facts_fingerprint',encode(v_facts,'hex'),'actor_user_id',v_actor,'acknowledged_at_utc',v_acknowledged_at,
    'acknowledgement_sequence',v_sequence,'idempotent_replay',false,'pay_changed',false,'invoice_changed',false);
  v_audit_payload:=jsonb_build_object('schema_version','WEEKLY_SOURCE_KEEP_AS_PAID_ACK_V1','decision_id',v_decision.id,
    'work_event_id',v_event.id,'reason',v_reason,'credit_invoice_line_id',v_credit,'facts_fingerprint',encode(v_facts,'hex'),
    'actor_user_id',v_actor,'acknowledged_at_utc',v_acknowledged_at,'acknowledgement_sequence',v_sequence,
    'idempotency_key',v_key,'request_sha256',encode(v_request_hash,'hex'),'request',p_request,'result',v_result,
    'native_backend_pid',pg_backend_pid(),'native_transaction_id',txid_current()::text);
  perform public._audit_insert('weekly_source_kept_as_paid_decisions',v_event.id::text,
    'WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED',null,v_audit_payload,'Keep as paid',v_actor);
  return v_result;
end;
$function$;

create or replace function private.weekly_source_invoice_credited_targets_admit_v1(
  p_invoice_id uuid,p_payload jsonb,p_actor_user_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_invoice public.invoices%rowtype; v_authority jsonb; v_ids uuid[]; v_id uuid; v_candidate uuid;
  v_context jsonb; v_contexts jsonb:='[]'::jsonb; v_roots uuid[]; v_locks jsonb;
  v_group uuid; v_cycle uuid; v_before jsonb; v_after jsonb:='[]'::jsonb; v_observation jsonb;
  v_frame jsonb; v_frame_hash bytea; v_add_ids uuid[]; v_removal_lines jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if not exists(select 1 from public.tms_users where id=p_actor_user_id and is_active and lower(btrim(role))='admin') then
    raise exception 'WEEKLY_SOURCE_OFFICE_ADMIN_REQUIRED' using errcode='42501'; end if;
  select * into strict v_invoice from public.invoices where id=p_invoice_id;
  v_authority:=private.weekly_source_invoice_adjustment_authority_v1(p_invoice_id,null);
  if v_authority->>'allowed' is distinct from 'true' or v_invoice.type::text is distinct from 'INVOICE'
    or v_invoice.header_snapshot_json->>'schema_version' is distinct from 'WEEKLY_SOURCE_SELF_BILL_INVOICE_V1'
    or v_invoice.header_snapshot_json#>>'{meta,source}' is distinct from 'WEEKLY_FINAL_SOURCE' then
    raise exception 'WEEKLY_SOURCE_INVOICE_ADJUSTMENTS_NOT_ALLOWED' using errcode='55000'; end if;
  if jsonb_typeof(p_payload) is distinct from 'object'
    or (p_payload ? 'add_adjustments' and jsonb_typeof(p_payload->'add_adjustments') is distinct from 'array')
    or (p_payload ? 'remove_invoice_line_ids' and jsonb_typeof(p_payload->'remove_invoice_line_ids') is distinct from 'array') then
    raise exception 'WEEKLY_SOURCE_INVOICE_ADJUSTMENT_INVALID' using errcode='22023'; end if;
  if exists(select 1 from jsonb_array_elements(coalesce(p_payload->'add_adjustments','[]'::jsonb)) item
    where item ? 'credited_work_event_id' and (jsonb_typeof(item->'credited_work_event_id') is distinct from 'string'
      or pg_input_is_valid(item->>'credited_work_event_id','uuid') is distinct from true)) then
    raise exception 'WEEKLY_SOURCE_CREDITED_SHIFT_INVALID' using errcode='22023'; end if;
  select coalesce(array_agg(distinct (item->>'credited_work_event_id')::uuid order by (item->>'credited_work_event_id')::uuid),'{}'::uuid[])
    into v_add_ids from jsonb_array_elements(coalesce(p_payload->'add_adjustments','[]'::jsonb)) item where item ? 'credited_work_event_id';
  -- Capture genuine existing pointer lines BEFORE any own deletion. Removal-only
  -- historical edits need identity/facts scope, not fresh missing-shift eligibility.
  select coalesce(jsonb_agg(jsonb_build_object('invoice_line_id',line.id,'invoice_id',line.invoice_id,
    'work_event_id',(line.meta_json->>'credited_work_event_id')::uuid,
    'metadata_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CREDIT_REMOVAL_METADATA_V1',line.meta_json),'hex'))
    order by line.id),'[]'::jsonb) into v_removal_lines
  from public.invoice_lines line where line.invoice_id=p_invoice_id
    and line.id in(select value::uuid from jsonb_array_elements_text(coalesce(p_payload->'remove_invoice_line_ids','[]'::jsonb)) value)
    and line.meta_json ? 'credited_work_event_id';
  if exists(select 1 from public.invoice_lines line where line.invoice_id=p_invoice_id
    and line.id in(select value::uuid from jsonb_array_elements_text(coalesce(p_payload->'remove_invoice_line_ids','[]'::jsonb)) value)
    and line.meta_json ? 'credited_work_event_id'
    and private.weekly_source_invoice_adjustment_line_valid_v1(line.id,p_invoice_id) is distinct from true) then
    raise exception 'WEEKLY_SOURCE_INVOICE_EDIT_ADJUSTMENT_ONLY' using errcode='22023'; end if;
  select array_agg(distinct id order by id) into v_ids from (
    select unnest(v_add_ids) id union select (item->>'work_event_id')::uuid from jsonb_array_elements(v_removal_lines) item
  ) affected;
  if v_ids is null then return null; end if;
  if cardinality(v_ids)>100 then raise exception 'WEEKLY_SOURCE_CREDITED_SHIFT_SCOPE_EXCEEDS_BOUND' using errcode='22023'; end if;
  v_group:=(v_authority->>'source_group_id')::uuid;
  foreach v_id in array v_ids loop
    v_context:=private.weekly_source_kept_as_paid_context_v1(v_id,p_actor_user_id);
    if v_context->>'client_id' is distinct from v_invoice.client_id::text
      or v_context->>'source_group_id' is distinct from v_group::text
      or (v_id=any(v_add_ids) and (v_context->'source_present' is distinct from 'false'::jsonb
        or not (v_context->'invoiced'='true'::jsonb or v_context->'paid'='true'::jsonb)
        or v_context->'current_pay_head_movement_id'='null'::jsonb))
      or jsonb_array_length(v_context->'root_timesheet_ids')=0 then
      raise exception 'WEEKLY_SOURCE_CREDITED_SHIFT_NOT_ELIGIBLE' using errcode='55000'; end if;
    v_contexts:=v_contexts||jsonb_build_array(jsonb_build_object('work_event_id',v_id,
      'candidate_id',v_context->>'candidate_id','root_timesheet_ids',v_context->'root_timesheet_ids',
      'source_cycle_id',v_context->>'source_cycle_id',
      'facts_fingerprint',encode(private.weekly_source_kept_as_paid_facts_v1(v_id,'CREDITED'),'hex'),
      'native_paid_basis_sha256',encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_CREDIT_TARGET_NATIVE_PAID_BASIS_V1',v_context->'native_paid_basis'),'hex')));
  end loop;
  v_before:=v_contexts;
  -- Complete all Candidate root sets first, in native deterministic order,
  -- before source group/cycles and before the caller's first invoice row lock.
  for v_candidate in select distinct (item->>'candidate_id')::uuid from jsonb_array_elements(v_contexts) item
    order by (item->>'candidate_id')::uuid loop
    select array_agg(distinct root.value::uuid order by root.value::uuid) into v_roots
    from jsonb_array_elements(v_contexts) item cross join lateral jsonb_array_elements_text(item->'root_timesheet_ids') root(value)
    where item->>'candidate_id'=v_candidate::text;
    v_locks:=private.weekly_source_lock_and_resolve_families_v1(v_candidate,v_roots,
      'WORKBENCH_CANDIDATE_ENTITLEMENT_PUBLICATION',gen_random_uuid(),'WEEKLY_SOURCE_ENTITLEMENT_PUBLICATION');
    if v_locks->>'ok' is distinct from 'true' or v_locks->>'gate' is distinct from 'GRANTED' then
      raise exception 'WEEKLY_SOURCE_CREDITED_SHIFT_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  end loop;
  perform 1 from public.weekly_source_groups where id=v_group for update;
  for v_cycle in select distinct (item->>'source_cycle_id')::uuid from jsonb_array_elements(v_contexts) item
    order by (item->>'source_cycle_id')::uuid loop
    perform 1 from public.weekly_source_cycles where id=v_cycle for update;
  end loop;
  foreach v_id in array v_ids loop
    v_context:=private.weekly_source_kept_as_paid_context_v1(v_id,p_actor_user_id);
    if v_context->>'client_id' is distinct from v_invoice.client_id::text
      or v_context->>'source_group_id' is distinct from v_group::text
      or (v_id=any(v_add_ids) and (v_context->'source_present' is distinct from 'false'::jsonb
        or not (v_context->'invoiced'='true'::jsonb or v_context->'paid'='true'::jsonb))) then
      raise exception 'WEEKLY_SOURCE_CREDITED_SHIFT_FACTS_CHANGED' using errcode='40001'; end if;
    v_after:=v_after||jsonb_build_array(jsonb_build_object('work_event_id',v_id,
      'candidate_id',v_context->>'candidate_id','root_timesheet_ids',v_context->'root_timesheet_ids',
      'source_cycle_id',v_context->>'source_cycle_id',
      'facts_fingerprint',encode(private.weekly_source_kept_as_paid_facts_v1(v_id,'CREDITED'),'hex'),
      'native_paid_basis_sha256',encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_CREDIT_TARGET_NATIVE_PAID_BASIS_V1',v_context->'native_paid_basis'),'hex')));
  end loop;
  if v_before is distinct from v_after or v_authority is distinct from
    private.weekly_source_invoice_adjustment_authority_v1(p_invoice_id,null) then
    raise exception 'WEEKLY_SOURCE_CREDITED_SHIFT_FACTS_CHANGED' using errcode='40001'; end if;
  v_frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_CREDIT_TARGET_FRAME_V1',
    'invoice_id',p_invoice_id,'actor_user_id',p_actor_user_id,'source_group_id',v_group,'client_id',v_invoice.client_id,
    'native_backend_pid',pg_backend_pid(),'native_transaction_id',txid_current()::text,
    'payload_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CREDIT_TARGET_PAYLOAD_V1',p_payload),'hex'),
    'native_contexts',v_after,'add_target_ids',to_jsonb(v_add_ids),'removal_lines',v_removal_lines,'adjustment_authority',v_authority);
  v_frame_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CREDIT_TARGET_FRAME_V1',v_frame);
  perform set_config('cloudtms.weekly_source_credit_target_frame',
    (v_frame||jsonb_build_object('frame_sha256',encode(v_frame_hash,'hex')))::text,true);
  return v_frame;
end;
$function$;

CREATE OR REPLACE FUNCTION public.invoice_apply_edits(p_invoice_id uuid, p_payload jsonb, p_actor_user_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
declare
  v_now timestamptz := now();
  v_anchor_ymd date := (now() at time zone 'Europe/London')::date;


-- =====================================================
-- DEBUG (invoice_debug): single audit row per RPC call
-- =====================================================
v_invoice_debug boolean := false;
v_dbg_started_at timestamptz := now();
v_dbg_steps jsonb := '[]'::jsonb;
v_dbg_sqlstate text := null;
v_dbg_error text := null;
v_dbg_stats jsonb := '{}'::jsonb;


v_dbg_lines_deleted int := 0;
v_dbg_timesheets_unlocked int := 0;
v_dbg_seg_add_refs int := 0;
v_dbg_seg_remove_refs int := 0;
v_dbg_seg_tsfins int := 0;
v_dbg_seg_timesheets_rebuilt int := 0;
v_dbg_seg_timesheets_removed int := 0;
v_dbg_add_timesheets_found int := 0;
v_dbg_add_timesheets_skipped int := 0;

v_rc int := 0;

  v_inv record;
  v_week_start date;
  v_week_end date;

  v_remove_ids uuid[];
  v_add_ts_ids uuid[];

-- segment move payload (explicit segment add/remove)
v_remove_seg_refs jsonb;
v_add_seg_refs jsonb;
v_has_seg_ops boolean := false;
v_refresh_hr_cache boolean := false;
v_seg_tsfin_ids uuid[] := array[]::uuid[];
v_seg_ts_ids uuid[] := array[]::uuid[];
v_seg_refs_to_lock jsonb := '[]'::jsonb;
v_ref jsonb;
v_tsfin_id uuid;
v_seg_id text;
v_has_additional boolean;
v_has_expense_or_mileage boolean;

  -- reference updates (refs-to-issue)
  v_reference_updates jsonb;
  v_refupd jsonb;
  v_refupd_ts_id uuid;
  v_refupd_count int := 0;
  v_refupd_applied int := 0;
  v_refupd_set_refnum boolean;
  v_refupd_set_dayrefs boolean;
  v_refupd_set_sched boolean;
  v_refupd_dayrefs jsonb;
  v_refupd_sched jsonb;
  v_refupd_refnum text;

  -- timesheet hospital / ward source edits
  v_location_updates jsonb;
  v_location_update jsonb;
  v_location_ts_id uuid;
  v_location_count int := 0;
  v_location_applied int := 0;
  v_location_set_hospital boolean;
  v_location_set_ward boolean;
  v_location_hospital_norm text;
  v_location_ward_norm text;
  v_location_ts_ids uuid[] := array[]::uuid[];
  -- Source-edit contract state. Reference and location inputs are merged into
  -- one desired row per timesheet, then written by one statement so the
  -- statement-level invalidation trigger advances each source exactly once.
  v_source_updates_map jsonb := '{}'::jsonb;
  v_source_update jsonb;
  v_source_edit_key text;
  v_source_expected_revision bigint;
  v_source_changed_ts_ids uuid[] := array[]::uuid[];
  v_source_changed_revisions jsonb := '[]'::jsonb;
  v_source_edit_requested boolean := false;
  v_allowed_reference_fields text[]:=array[
    'timesheet_id','expected_document_revision','reference_number',
    'day_references_json','actual_schedule_json'];
  v_allowed_location_fields text[]:=array[
    'timesheet_id','expected_document_revision','hospital_norm','ward_norm'];
  v_allowed_reference_segment_fields text[]:=array[
    'segment_id','date','start_utc','end_utc','start','end','ref_num',
    'source_system'];
  v_source_unsupported_field text;
  v_source_financial_id uuid;
  v_source_mode text;
  v_source_ib jsonb;
  v_source_payload_schedule jsonb;
  v_source_canonical_schedule jsonb;
  v_source_new_segments jsonb;
  v_source_segment_updates jsonb;
  v_source_segment_reference_changed boolean;
  v_source_timesheet_row_changed boolean;
  v_source_match_count integer;
  v_source_match_segment jsonb;
  v_source_payload_segment jsonb;
  v_source_current_segment jsonb;
  v_source_payload_ord bigint;
  v_source_start timestamptz;
  v_source_end timestamptz;
  v_source_marker_rows jsonb:='{}'::jsonb;
  v_source_marker jsonb:='{}'::jsonb;
  v_source_edit_preexisting_preview boolean := false;
  v_source_edit_invoice_replacement_required boolean := false;
  v_pre_edit_invoice_revision bigint;
  v_pre_edit_preview_document_version_id uuid;
  v_pre_edit_active_document_operation_id uuid;
  v_expected_command_count int := 0;
  v_operation_result jsonb;
  v_operation_id uuid;
  v_document_version_id uuid;
  v_command_no int;
  v_command_type text;
  v_operation_status text;
  v_operation_input jsonb;
  v_validated_operations jsonb := '[]'::jsonb;
  v_document_commands jsonb := '[]'::jsonb;
  v_started_operations jsonb := '[]'::jsonb;

  -- reference update side-effects (meta refresh / segment ref sync)
  v_refupd_ts_ids uuid[] := array[]::uuid[];
  v_refupd_ts_ids_distinct uuid[] := array[]::uuid[];
  v_refupd_meta_rows_updated int := 0;
  v_refupd_tsfin_rows_updated int := 0;
  v_refupd_tsfin_segments_updated int := 0;
  v_refupd_invoice_fallback_invalidated boolean := false;

  -- temp vars for reference-derived meta and optional tsfin segment ref sync
  v_ref_ts_id uuid;
  v_ref_ts record;
  v_ref_schedule_refs jsonb := '[]'::jsonb;
  v_ref_schedule_refs_distinct jsonb := '[]'::jsonb;
  v_ref_sched_map jsonb := '{}'::jsonb;
  v_ref_seen_keys jsonb := '{}'::jsonb;
  v_ref_sched_key text;
  v_ref_sched_ref text;
  v_ref_tsfin_id uuid;
  v_ref_ib jsonb;
  v_ref_new_segments jsonb := '[]'::jsonb;
  v_ref_seg_obj jsonb;
  v_ref_seg_start text;
  v_ref_seg_end text;
    v_ref_seg_id text;
v_ref_seg_cur_ref text;
  v_ref_seg_new_ref text;
  v_ref_seg_has_update boolean := false;
  v_ref_seg_updates_this_ts int := 0;
  v_ref_seg_matches_this_ts int := 0;

  -- audit (history) accumulators (NOT debug-only)
  v_hist_adj jsonb := '[]'::jsonb;
  v_hist_seg_add jsonb := '[]'::jsonb;
  v_hist_seg_remove jsonb := '[]'::jsonb;
  v_hist_lines_removed jsonb := '[]'::jsonb;
  v_hist_add_ts jsonb := '[]'::jsonb;

  -- contract week status touch set
  v_cw_ts_ids uuid[] := array[]::uuid[];

  v_ts_ids_touched uuid[] := array[]::uuid[];
  -- FIX: timesheets fully removed from this invoice (no remaining invoice_lines) should be unlocked
  v_ts_ids_fully_removed uuid[] := array[]::uuid[];

  v_vat_chargeable boolean := true;
  v_vat_rate numeric := 0;

  -- adjustments
  adj jsonb;
  v_adj_token text;
  v_adj_desc text;
  v_adj_ex numeric;
  v_adj_vat numeric;
  v_adj_inc numeric;
  v_adj_source_key text;
  v_meta jsonb;

  -- timesheet loop
  tsid uuid;
  snap record;
  ts record;
  pc record;
  contract_id uuid;
  v_settings_authority jsonb;
  c_daily_calc boolean := false;
  c_bucket_labels jsonb := null;
  c_role text := null;
  c_display_site text := null;
  c_ward_hint text := null;

  -- segment filtering
  v_seg jsonb;
  segments jsonb := '[]'::jsonb;
  seg_target date;
  seg_date text;
  natural_start date;
  seg_locked text;
  seg_ref text;

  -- aggregation for weekly line
  h_day numeric; h_night numeric; h_sat numeric; h_sun numeric; h_bh numeric;
  pay_ex numeric; chg_ex numeric; margin_ex numeric;
  vat_amt numeric; inc_amt numeric;
  line_desc text;
  v_source_key text;
  v_exact_timesheet_document_r2_key text;

  -- daily aggregation record
  r_day record;

  -- segment refs for locking
  seg_refs jsonb := '[]'::jsonb;

  -- additional units
  kv record;
  ex jsonb;
  code text;
  unit_count numeric;
  bucket_name text;
  unit_name text;

  -- expenses notes
  v_note_travel text;
  v_note_accom text;
  v_note_other text;

  -- recompute totals
  v_new_ex numeric := 0;
  v_new_vat numeric := 0;
  v_new_inc numeric := 0;

  -- header meta counters (keep header_snapshot_json.meta in sync with current invoice state)
  v_hdr_ts_count_lines int := 0;
  v_hdr_ts_count_seglocks int := 0;
  v_hdr_seg_locked_count int := 0;
  v_hdr_meta_timesheet_count int := 0;
  v_hdr_meta_segment_count int := 0;

  v_manifest jsonb;
  v_correction_placement_only boolean:=false;
  v_correction_placement_ts_id uuid:=null;
  v_correction_placement_scope jsonb:='{}'::jsonb;
  v_correction_placement_states jsonb:='[]'::jsonb;
  v_service boolean:=coalesce(auth.role(),'')='service_role';
  v_actor_role text;
begin

  if not v_service
     and(auth.uid() is null or auth.uid() is distinct from p_actor_user_id) then
    raise exception using errcode='42501',
      message='AUTHENTICATED_ACTOR_MISMATCH';
  end if;
  select lower(btrim(coalesce(u.role,''))) into v_actor_role
  from public.tms_users u
  where u.id=p_actor_user_id and u.is_active;
  if(not found or v_actor_role<>'admin') and not v_service then
    raise exception using errcode='42501',
      message='INVOICE_ADMINISTRATOR_PERMISSION_REQUIRED';
  end if;

  -- Source F4 target admission takes complete native I-1 roots BEFORE the
  -- original first invoice mutability/row lock. Ordinary owners are untouched.
  if exists(select 1 from public.invoices invoice where invoice.id=p_invoice_id
    and invoice.header_snapshot_json->>'schema_version'='WEEKLY_SOURCE_SELF_BILL_INVOICE_V1'
    and invoice.header_snapshot_json#>>'{meta,source}'='WEEKLY_FINAL_SOURCE')
    and (exists(select 1 from jsonb_array_elements(case when jsonb_typeof(p_payload->'add_adjustments')='array'
      then p_payload->'add_adjustments' else '[]'::jsonb end) item where item ? 'credited_work_event_id')
    or exists(select 1 from public.invoice_lines removed where removed.invoice_id=p_invoice_id
      and removed.meta_json ? 'credited_work_event_id'
      and removed.id in(select case when pg_input_is_valid(value,'uuid') then value::uuid end
        from jsonb_array_elements_text(case when jsonb_typeof(p_payload->'remove_invoice_line_ids')='array'
          then p_payload->'remove_invoice_line_ids' else '[]'::jsonb end) value))) then
    perform private.weekly_source_invoice_credited_targets_admit_v1(p_invoice_id,p_payload,p_actor_user_id);
  end if;
  perform public._ctms_assert_invoice_mutable_draft_v1(
    p_invoice_id,'INVOICE_APPLY_EDITS',true
  );
  v_correction_placement_only:=
    jsonb_typeof(coalesce(p_payload,'{}'::jsonb))='object'
    and not exists(select 1 from jsonb_object_keys(coalesce(p_payload,'{}'::jsonb)) payload_key
      where payload_key not in ('remove_invoice_line_ids','add_timesheet_ids'))
    and coalesce(jsonb_array_length(case when jsonb_typeof(p_payload->'remove_invoice_line_ids')='array'
      then p_payload->'remove_invoice_line_ids' else '[]'::jsonb end),0)
      +coalesce(jsonb_array_length(case when jsonb_typeof(p_payload->'add_timesheet_ids')='array'
      then p_payload->'add_timesheet_ids' else '[]'::jsonb end),0)=1
    and (
      (case when coalesce(p_payload#>>'{remove_invoice_line_ids,0}','')
          ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then exists(
          select 1 from public.invoice_lines placement_line
          where placement_line.id=(p_payload#>>'{remove_invoice_line_ids,0}')::uuid
            and placement_line.invoice_id=p_invoice_id
            and coalesce((public._ctms_import_correction_classify_v1(placement_line.timesheet_id)
              ->>'is_import_authoritative_correction')::boolean,false)) else false end)
      or
      (case when coalesce(p_payload#>>'{add_timesheet_ids,0}','')
          ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then
        coalesce((public._ctms_import_correction_classify_v1(
          (p_payload#>>'{add_timesheet_ids,0}')::uuid)->>'is_import_authoritative_correction')::boolean,false)
        else false end)
    );
  if public._ctms_invoice_payload_has_financial_edit_v1(p_payload)
     and not v_correction_placement_only
     and not private.weekly_source_invoice_adjustment_payload_admit_v1(p_invoice_id,p_payload)
     and exists (
       select 1 from public.invoice_lines il
       where il.invoice_id=p_invoice_id and il.timesheet_id is not null
         and coalesce((public._ctms_import_correction_classify_v1(il.timesheet_id)
           ->>'is_import_authoritative_correction')::boolean,false)
     ) then
    raise exception 'IMPORT_CORRECTION_INVOICE_FINANCIAL_EDIT_FORBIDDEN'
      using errcode='P0001',detail=jsonb_build_object('invoice_id',p_invoice_id)::text;
  end if;
-- Load invoice_debug flag (safe even if column not yet present)
begin
  select coalesce(sd.invoice_debug, false)
  into v_invoice_debug
  from public.settings_defaults sd
  where sd.id = 1
  limit 1;
exception when undefined_column then
  v_invoice_debug := false;
end;

if v_invoice_debug then
  v_dbg_steps := v_dbg_steps || jsonb_build_array(
    jsonb_build_object(
      'step','start',
      'at_utc', public._inv_iso_utc(v_dbg_started_at),
      'invoice_id', p_invoice_id::text
    )
  );
end if;

  if p_invoice_id is null then
    raise exception 'invoice_id is required';
  end if;

  select *
  into v_inv
  from public.invoices i
  where i.id = p_invoice_id
  for update
  limit 1;

  if not found then
    raise exception 'Invoice not found';
  end if;

  -- Editable gate: DRAFT/ON_HOLD and unpaid
  if v_inv.status::text not in ('DRAFT','ON_HOLD') then
    raise exception 'Invoice is not editable (status=%)', v_inv.status::text;
  end if;

  if v_inv.paid_at_utc is not null then
    raise exception 'Invoice is not editable (already paid)';
  end if;



if v_invoice_debug then
  v_dbg_steps := v_dbg_steps || jsonb_build_array(
    jsonb_build_object(
      'step','invoice_loaded',
      'status', coalesce(v_inv.status::text,''),
      'paid_at_utc', case when v_inv.paid_at_utc is null then null else public._inv_iso_utc(v_inv.paid_at_utc) end
    )
  );
end if;

  -- F4: exact new Source header plus frozen S15 only. All ordinary code below
  -- remains the native owner, including older self-bill and NHSP refusal.
  if v_inv.header_snapshot_json->>'schema_version'='WEEKLY_SOURCE_SELF_BILL_INVOICE_V1'
     and v_inv.header_snapshot_json#>>'{meta,source}'='WEEKLY_FINAL_SOURCE' then
    if private.weekly_source_invoice_adjustment_authority_v1(p_invoice_id,null)->>'allowed'='true' then
      return private.weekly_source_invoice_adjustments_apply_v1(p_invoice_id,p_payload,p_actor_user_id);
    end if;
    if p_payload ? 'add_adjustments' or p_payload ? 'remove_invoice_line_ids' then
      raise exception 'WEEKLY_SOURCE_INVOICE_ADJUSTMENTS_NOT_ALLOWED' using errcode='55000';
    end if;
  end if;

  -- Require invoice_week_start in header_snapshot_json.meta
  if v_inv.header_snapshot_json is null
     or btrim(coalesce(v_inv.header_snapshot_json #>> '{meta,invoice_week_start}','')) = ''
     or (v_inv.header_snapshot_json #>> '{meta,invoice_week_start}') !~ '^\d{4}-\d{2}-\d{2}$'
  then
    raise exception 'Invoice header_snapshot_json.meta.invoice_week_start is required for edits';
  end if;

  v_week_start := (v_inv.header_snapshot_json #>> '{meta,invoice_week_start}')::date;
  v_week_end := (v_week_start + interval '6 days')::date;


if v_invoice_debug then
  v_dbg_steps := v_dbg_steps || jsonb_build_array(
    jsonb_build_object(
      'step','invoice_week_loaded',
      'invoice_week_start', v_week_start::text,
      'invoice_week_end', v_week_end::text
    )
  );
end if;

  -- VAT settings from invoice snapshot
  if jsonb_typeof(v_inv.header_snapshot_json->'vat_chargeable') = 'boolean' then
    v_vat_chargeable := (v_inv.header_snapshot_json->>'vat_chargeable')::boolean;
  else
    v_vat_chargeable := true;
  end if;

  if (v_inv.header_snapshot_json ? 'applied_vat_rate_pct') then
    begin
      v_vat_rate := (v_inv.header_snapshot_json->>'applied_vat_rate_pct')::numeric;
    exception when others then
      v_vat_rate := 0;
    end;
  else
    v_vat_rate := 0;
  end if;

  if v_vat_chargeable = false then
    v_vat_rate := 0;
  end if;

  -- Parse payload arrays
  v_remove_ids := null;
  if p_payload is not null and jsonb_typeof(p_payload) = 'object' and (p_payload ? 'remove_invoice_line_ids') then
    select array_agg((x)::uuid)
    into v_remove_ids
    from jsonb_array_elements_text(coalesce(p_payload->'remove_invoice_line_ids','[]'::jsonb)) x
    where nullif(btrim(coalesce(x,'')),'') is not null;
  end if;

  v_add_ts_ids := null;
  if p_payload is not null and jsonb_typeof(p_payload) = 'object' and (p_payload ? 'add_timesheet_ids') then
    select array_agg((x)::uuid)
    into v_add_ts_ids
    from jsonb_array_elements_text(coalesce(p_payload->'add_timesheet_ids','[]'::jsonb)) x
    where nullif(btrim(coalesce(x,'')),'') is not null;
  end if;

  IF v_correction_placement_only THEN
    IF COALESCE(cardinality(v_remove_ids),0)=1 THEN
      SELECT il.timesheet_id INTO v_correction_placement_ts_id
      FROM public.invoice_lines il
      WHERE il.id=v_remove_ids[1] AND il.invoice_id=p_invoice_id
      FOR UPDATE;
      IF v_correction_placement_ts_id IS NULL
         OR COALESCE((public._ctms_import_correction_classify_v1(v_correction_placement_ts_id)
             ->>'is_import_authoritative_correction')::boolean,false) IS NOT TRUE THEN
        RAISE EXCEPTION 'IMPORT_CORRECTION_PLACEMENT_ONLY_TARGET_INVALID' USING ERRCODE='P0001';
      END IF;
      v_correction_placement_scope:=public.invoice_correction_pair_scope_v1(
        v_correction_placement_ts_id,null::uuid,p_actor_user_id,true,100);
      IF COALESCE((v_correction_placement_scope->>'valid')::boolean,false) IS NOT TRUE
         OR v_correction_placement_scope->>'placement_state' NOT IN (
           'COMPLETE_SAME_INVOICE','COMPLETE_SPLIT_INVOICES') THEN
        RAISE EXCEPTION 'INVOICE_CORRECTION_PAIR_PLACEMENT_MOVE_NOT_STARTABLE'
          USING ERRCODE='P0001',DETAIL=v_correction_placement_scope::text;
      END IF;
    ELSIF COALESCE(cardinality(v_add_ts_ids),0)=1 THEN
      v_correction_placement_ts_id:=v_add_ts_ids[1];
      IF COALESCE((public._ctms_import_correction_classify_v1(v_correction_placement_ts_id)
             ->>'is_import_authoritative_correction')::boolean,false) IS NOT TRUE THEN
        RAISE EXCEPTION 'IMPORT_CORRECTION_PLACEMENT_ONLY_TARGET_INVALID' USING ERRCODE='P0001';
      END IF;
      v_correction_placement_scope:=public.invoice_correction_pair_scope_v1(
        v_correction_placement_ts_id,p_invoice_id,p_actor_user_id,true,100);
      IF COALESCE((v_correction_placement_scope->>'valid')::boolean,false) IS NOT TRUE
         OR v_correction_placement_scope->>'placement_state'<>'INCOMPLETE_MOVE'
         OR v_correction_placement_scope->>'missing_member_kind' IS DISTINCT FROM
              (SELECT t.correction_kind FROM public.timesheets t
               WHERE t.timesheet_id=v_correction_placement_ts_id)
         OR COALESCE((v_correction_placement_scope->>'target_appendable')::boolean,false) IS NOT TRUE THEN
        RAISE EXCEPTION 'INVOICE_CORRECTION_PAIR_PLACEMENT_TARGET_INVALID'
          USING ERRCODE='P0001',DETAIL=v_correction_placement_scope::text;
      END IF;
    ELSE
      RAISE EXCEPTION 'IMPORT_CORRECTION_PLACEMENT_ONLY_PAYLOAD_INVALID' USING ERRCODE='22023';
    END IF;
  END IF;


-- Parse segment move payloads (tsfin_id + segment_id)
v_remove_seg_refs := null;
if p_payload is not null and jsonb_typeof(p_payload) = 'object' and (p_payload ? 'remove_segment_refs') then
  v_remove_seg_refs := coalesce(p_payload->'remove_segment_refs','[]'::jsonb);
  if jsonb_typeof(v_remove_seg_refs) <> 'array' then
    v_remove_seg_refs := '[]'::jsonb;
  end if;
end if;

v_add_seg_refs := null;
if p_payload is not null and jsonb_typeof(p_payload) = 'object' and (p_payload ? 'add_segment_refs') then
  v_add_seg_refs := coalesce(p_payload->'add_segment_refs','[]'::jsonb);
  if jsonb_typeof(v_add_seg_refs) <> 'array' then
    v_add_seg_refs := '[]'::jsonb;
  end if;
end if;



-- Parse and strictly validate source edits. The expected source revision is
-- mandatory because values displayed by an older modal must never overwrite a
-- newer timesheet revision.
v_reference_updates := null;
if p_payload is not null and jsonb_typeof(p_payload)='object'
   and p_payload ? 'reference_updates' then
  v_reference_updates:=p_payload->'reference_updates';
  if jsonb_typeof(v_reference_updates)<>'array' then
    raise exception using errcode='22023',
      message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
      detail=jsonb_build_object('field','reference_updates','reason','ARRAY_REQUIRED')::text;
  end if;
  v_refupd_count:=jsonb_array_length(v_reference_updates);
  for v_refupd in select value from jsonb_array_elements(v_reference_updates) value loop
    if v_refupd is not null and jsonb_typeof(v_refupd)='object' then
      select min(field_name) into v_source_unsupported_field
      from jsonb_object_keys(v_refupd) field_name
      where not (field_name=any(v_allowed_reference_fields));
      if v_source_unsupported_field is not null then
        raise exception using errcode='22023',
          message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
          detail=jsonb_build_object(
            'field','reference_updates','reason','UNSUPPORTED_FIELD',
            'unsupported_field',v_source_unsupported_field)::text;
      end if;
    end if;
    if v_refupd is null or jsonb_typeof(v_refupd)<>'object'
       or nullif(btrim(coalesce(v_refupd->>'timesheet_id','')),'') is null
       or coalesce(v_refupd->>'timesheet_id','') !~
          '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
       or coalesce(v_refupd->>'expected_document_revision','') !~ '^[1-9][0-9]*$'
       or not (
         v_refupd ? 'reference_number'
         or v_refupd ? 'day_references_json'
         or v_refupd ? 'actual_schedule_json'
       )
       or (
         v_refupd ? 'reference_number'
         and jsonb_typeof(v_refupd->'reference_number') not in('string','null')
       )
       or (
         v_refupd ? 'day_references_json'
         and jsonb_typeof(v_refupd->'day_references_json') not in('object','null')
       )
       or (
         v_refupd ? 'actual_schedule_json'
         and jsonb_typeof(v_refupd->'actual_schedule_json') not in('array','null')
       )
    then
      raise exception using errcode='22023',
        message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
        detail=jsonb_build_object('field','reference_updates','reason','INVALID_ITEM')::text;
    end if;
    v_source_edit_key:=lower(v_refupd->>'timesheet_id');
    if v_source_updates_map ? v_source_edit_key then
      raise exception using errcode='22023',
        message='INVOICE_SOURCE_EDIT_DUPLICATE_TIMESHEET',
        detail=jsonb_build_object('timesheet_id',v_source_edit_key,'field','reference_updates')::text;
    end if;
    v_source_updates_map:=jsonb_set(
      v_source_updates_map,array[v_source_edit_key],
      jsonb_build_object(
        'timesheet_id',v_source_edit_key,
        'expected_document_revision',(v_refupd->>'expected_document_revision')::bigint,
        'has_reference_number',v_refupd ? 'reference_number',
        'reference_number',case when v_refupd ? 'reference_number'
          then to_jsonb(nullif(btrim(coalesce(v_refupd->>'reference_number','')),''))
          else 'null'::jsonb end,
        'has_day_references_json',v_refupd ? 'day_references_json',
        'day_references_json',case
          when not (v_refupd ? 'day_references_json') then 'null'::jsonb
          when jsonb_typeof(v_refupd->'day_references_json')='null' then 'null'::jsonb
          else v_refupd->'day_references_json' end,
        'has_actual_schedule_json',v_refupd ? 'actual_schedule_json',
        'actual_schedule_json',case
          when not (v_refupd ? 'actual_schedule_json') then 'null'::jsonb
          when jsonb_typeof(v_refupd->'actual_schedule_json')='null' then 'null'::jsonb
          else v_refupd->'actual_schedule_json' end,
        'has_hospital_norm',false,
        'has_ward_norm',false),
      true);
  end loop;
end if;

-- Hospital/ward edits merge into the same desired source row. A source may
-- appear once in each array, but both items must carry the same revision.
v_location_updates:=null;
if p_payload is not null and jsonb_typeof(p_payload)='object'
   and p_payload ? 'timesheet_location_updates' then
  v_location_updates:=p_payload->'timesheet_location_updates';
  if jsonb_typeof(v_location_updates)<>'array' then
    raise exception using errcode='22023',
      message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
      detail=jsonb_build_object('field','timesheet_location_updates','reason','ARRAY_REQUIRED')::text;
  end if;
  v_location_count:=jsonb_array_length(v_location_updates);
  for v_location_update in select value from jsonb_array_elements(v_location_updates) value loop
    if v_location_update is not null and jsonb_typeof(v_location_update)='object' then
      select min(field_name) into v_source_unsupported_field
      from jsonb_object_keys(v_location_update) field_name
      where not (field_name=any(v_allowed_location_fields));
      if v_source_unsupported_field is not null then
        raise exception using errcode='22023',
          message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
          detail=jsonb_build_object(
            'field','timesheet_location_updates','reason','UNSUPPORTED_FIELD',
            'unsupported_field',v_source_unsupported_field)::text;
      end if;
    end if;
    if v_location_update is null or jsonb_typeof(v_location_update)<>'object'
       or nullif(btrim(coalesce(v_location_update->>'timesheet_id','')),'') is null
       or coalesce(v_location_update->>'timesheet_id','') !~
          '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
       or coalesce(v_location_update->>'expected_document_revision','') !~ '^[1-9][0-9]*$'
       or not (v_location_update ? 'hospital_norm' or v_location_update ? 'ward_norm')
       or (
         v_location_update ? 'hospital_norm'
         and jsonb_typeof(v_location_update->'hospital_norm') not in('string','null')
       )
       or (
         v_location_update ? 'ward_norm'
         and jsonb_typeof(v_location_update->'ward_norm') not in('string','null')
       )
    then
      raise exception using errcode='22023',
        message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
        detail=jsonb_build_object('field','timesheet_location_updates','reason','INVALID_ITEM')::text;
    end if;
    v_source_edit_key:=lower(v_location_update->>'timesheet_id');
    v_source_expected_revision:=(v_location_update->>'expected_document_revision')::bigint;
    if v_source_updates_map ? v_source_edit_key
       and (
         coalesce((v_source_updates_map#>>
           array[v_source_edit_key,'has_hospital_norm'])::boolean,false)
         or coalesce((v_source_updates_map#>>
           array[v_source_edit_key,'has_ward_norm'])::boolean,false)
       ) then
      raise exception using errcode='22023',
        message='INVOICE_SOURCE_EDIT_DUPLICATE_TIMESHEET',
        detail=jsonb_build_object('timesheet_id',v_source_edit_key,'field','timesheet_location_updates')::text;
    end if;
    if v_source_updates_map ? v_source_edit_key
       and (v_source_updates_map#>>array[v_source_edit_key,'expected_document_revision'])::bigint
           is distinct from v_source_expected_revision then
      raise exception using errcode='40001',
        message='INVOICE_SOURCE_EDIT_STALE_REVISION',
        detail=jsonb_build_object('timesheet_id',v_source_edit_key,'reason','EXPECTED_REVISION_CONFLICT')::text;
    end if;
    v_source_update:=coalesce(v_source_updates_map->v_source_edit_key,
      jsonb_build_object(
        'timesheet_id',v_source_edit_key,
        'expected_document_revision',v_source_expected_revision,
        'has_reference_number',false,
        'has_day_references_json',false,
        'has_actual_schedule_json',false));
    v_source_update:=v_source_update||jsonb_build_object(
      'has_hospital_norm',v_location_update ? 'hospital_norm',
      'hospital_norm',case when v_location_update ? 'hospital_norm'
        then to_jsonb(lower(regexp_replace(
          btrim(coalesce(v_location_update->>'hospital_norm','')),
          '[[:space:]]+',' ','g')))
        else 'null'::jsonb end,
      'has_ward_norm',v_location_update ? 'ward_norm',
      'ward_norm',case when v_location_update ? 'ward_norm'
        then to_jsonb(lower(regexp_replace(
          btrim(coalesce(v_location_update->>'ward_norm','')),
          '[[:space:]]+',' ','g')))
        else 'null'::jsonb end);
    v_source_updates_map:=jsonb_set(v_source_updates_map,array[v_source_edit_key],v_source_update,true);
  end loop;
end if;
v_source_edit_requested:=v_source_updates_map<>'{}'::jsonb;
v_has_seg_ops :=
  (v_remove_seg_refs is not null and jsonb_typeof(v_remove_seg_refs)='array' and jsonb_array_length(v_remove_seg_refs) > 0)
  or (v_add_seg_refs is not null and jsonb_typeof(v_add_seg_refs)='array' and jsonb_array_length(v_add_seg_refs) > 0);

  v_refresh_hr_cache := (coalesce(array_length(v_add_ts_ids,1),0) > 0) or coalesce(v_has_seg_ops,false);

  if v_invoice_debug then
    v_dbg_stats := v_dbg_stats || jsonb_build_object(
      'remove_invoice_line_ids_count', coalesce(array_length(v_remove_ids,1),0),
      'add_timesheet_ids_count', coalesce(array_length(v_add_ts_ids,1),0),
      'add_adjustments_count', case when p_payload is not null and jsonb_typeof(p_payload)='object' and (p_payload ? 'add_adjustments') and jsonb_typeof(p_payload->'add_adjustments')='array' then jsonb_array_length(p_payload->'add_adjustments') else 0 end,
      'remove_segment_refs_count', case when v_remove_seg_refs is null then 0 else jsonb_array_length(coalesce(v_remove_seg_refs,'[]'::jsonb)) end,
      'add_segment_refs_count', case when v_add_seg_refs is null then 0 else jsonb_array_length(coalesce(v_add_seg_refs,'[]'::jsonb)) end,
      'timesheet_location_updates_count',v_location_count,
      'has_segment_ops', v_has_seg_ops
    );
    v_dbg_steps := v_dbg_steps || jsonb_build_array(jsonb_build_object('step','payload_parsed','stats',v_dbg_stats));
  end if;

  if v_source_edit_requested then
    -- Source edits are a narrower authority than ordinary draft edits.
    if v_inv.issued_at_utc is not null then
      raise exception using errcode='55000',
        message='INVOICE_SOURCE_EDIT_ISSUED';
    end if;
    if v_inv.paid_at_utc is not null then
      raise exception using errcode='55000',
        message='INVOICE_SOURCE_EDIT_PAID';
    end if;
    if v_inv.active_issue_operation_id is not null
       or upper(coalesce(v_inv.issue_state,'')) in
          ('VALIDATING','PREPARING_DOCUMENT','READY_TO_FINALISE')
       or exists(
         select 1
         from public.invoice_operation_chunks c
         where c.chunk_type='ISSUE_INVOICE'
           and c.entity_type='INVOICE'
           and c.entity_id=p_invoice_id
           and c.status in('QUEUED','RUNNING','WAITING','RETRY_WAIT','BLOCKED')
       )
    then
      raise exception using errcode='55000',
        message='INVOICE_SOURCE_EDIT_ISSUE_IN_PROGRESS';
    end if;

    v_pre_edit_invoice_revision:=v_inv.document_revision;
    v_pre_edit_preview_document_version_id:=v_inv.preview_document_version_id;
    v_pre_edit_active_document_operation_id:=v_inv.active_document_operation_id;

    -- Only an exact current-revision V8 preview is authoritative. Legacy PDF
    -- summary fields do not independently force or suppress replacement.
    select exists(
      select 1
      from public.invoice_document_versions dv
      left join public.invoice_operations op on op.id=dv.operation_id
      where dv.entity_type='INVOICE'
        and dv.entity_id=p_invoice_id
        and dv.purpose='DRAFT_PREVIEW'
        and dv.source_revision=v_pre_edit_invoice_revision::text
        and (
          (dv.status='READY'
            and nullif(btrim(coalesce(dv.r2_key,'')),'') is not null
            and nullif(btrim(coalesce(dv.sha256,'')),'') is not null
            and coalesce(dv.size_bytes,0)>0
            and coalesce(dv.page_count,0)>0)
          or (
            dv.id=v_pre_edit_preview_document_version_id
            and dv.status in(
              'PLANNING','WAITING_FOR_INPUTS','RENDERING',
              'ASSEMBLING','VERIFYING','READY'))
          or (
            dv.operation_id=v_pre_edit_active_document_operation_id
            and op.operation_type='BUILD_DOCUMENT'
            and op.entity_type='INVOICE'
            and op.entity_id=p_invoice_id
            and op.source_revision=v_pre_edit_invoice_revision::text
            and coalesce(op.input_json->>'purpose','')='DRAFT_PREVIEW'
            and op.status in('QUEUED','RUNNING','WAITING','RETRY_WAIT','BLOCKED'))
        )
    ) into v_source_edit_preexisting_preview;

    -- Clear any caller-controlled or earlier transaction-local value before
    -- establishing this function's exact-once invalidation marker.
    perform set_config('cloudtms.invoice_source_edit_marker','{}',true);

    -- Lock every target and its current financial snapshot in deterministic
    -- order before validating ownership, revisions or segment identities.
    for v_ref_ts in
      select t.*
      from public.timesheets t
      join jsonb_each(v_source_updates_map) desired on true
      where t.timesheet_id=(desired.value->>'timesheet_id')::uuid
      order by t.timesheet_id
      for update of t
    loop
      null;
    end loop;
    for v_ref_ts in
      select tf.id
      from public.timesheets_financials tf
      join jsonb_each(v_source_updates_map) desired
        on tf.timesheet_id=(desired.value->>'timesheet_id')::uuid
      where tf.is_current
      order by tf.timesheet_id,tf.id
      for update of tf
    loop
      null;
    end loop;

    if (
      select count(*)
      from public.timesheets t
      join jsonb_each(v_source_updates_map) desired
        on t.timesheet_id=(desired.value->>'timesheet_id')::uuid
      where t.is_current
    )<>(select count(*) from jsonb_each(v_source_updates_map)) then
      raise exception using errcode='55000',
        message='INVOICE_SOURCE_EDIT_SOURCE_NOT_CURRENT';
    end if;

    if exists(
      select 1
      from jsonb_each(v_source_updates_map) desired
      join public.timesheets t
        on t.timesheet_id=(desired.value->>'timesheet_id')::uuid
      where t.document_revision is distinct from
        (desired.value->>'expected_document_revision')::bigint
    ) then
      raise exception using errcode='40001',
        message='INVOICE_SOURCE_EDIT_STALE_REVISION';
    end if;

    if exists(
      select 1
      from jsonb_each(v_source_updates_map) desired
      where not exists(
        select 1
        from public.invoice_lines owned_line
        where owned_line.invoice_id=p_invoice_id
          and (
            owned_line.timesheet_id=(desired.value->>'timesheet_id')::uuid
            or (
              owned_line.timesheet_id is null
              and coalesce(owned_line.meta_json->>'timesheet_id','') ~
                '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
              and (owned_line.meta_json->>'timesheet_id')::uuid=
                  (desired.value->>'timesheet_id')::uuid
            )
          )
      )
    ) then
      raise exception using errcode='55000',
        message='INVOICE_SOURCE_EDIT_SOURCE_NOT_OWNED';
    end if;

    -- Preserve the established import-authoritative correction lock across
    -- both supported source carriers.
    if exists(
      select 1
      from jsonb_each(v_source_updates_map) desired
      where coalesce((
        public._ctms_import_correction_classify_v1(
          (desired.value->>'timesheet_id')::uuid)
          ->>'is_import_authoritative_correction')::boolean,false)
    ) then
      raise exception using errcode='55000',
        message='IMPORT_AUTHORITATIVE_CORRECTION_SOURCE_EDIT_FORBIDDEN';
    end if;

    -- Reject a mixed command that edits a source while removing every carrier
    -- for that source in the same Save.
    if coalesce(array_length(v_remove_ids,1),0)>0 and exists(
      select 1
      from jsonb_each(v_source_updates_map) desired
      where exists(
        select 1
        from public.invoice_lines carrier
        where carrier.invoice_id=p_invoice_id
          and (
            carrier.timesheet_id=(desired.value->>'timesheet_id')::uuid
            or (
              carrier.timesheet_id is null
              and coalesce(carrier.meta_json->>'timesheet_id','') ~
                '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
              and (carrier.meta_json->>'timesheet_id')::uuid=
                  (desired.value->>'timesheet_id')::uuid
            )
          )
      )
      and not exists(
        select 1
        from public.invoice_lines retained
        where retained.invoice_id=p_invoice_id
          and not (retained.id=any(v_remove_ids))
          and (
            retained.timesheet_id=(desired.value->>'timesheet_id')::uuid
            or (
              retained.timesheet_id is null
              and coalesce(retained.meta_json->>'timesheet_id','') ~
                '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
              and (retained.meta_json->>'timesheet_id')::uuid=
                  (desired.value->>'timesheet_id')::uuid
            )
          )
      )
    ) then
      raise exception using errcode='22023',
        message='INVOICE_SOURCE_EDIT_CONFLICTING_COMMAND';
    end if;

    -- Classify each source from the locked current financial snapshot. A
    -- SEGMENTS payload is an editable reference projection only: it can never
    -- replace timesheets.actual_schedule_json or any financial segment object.
    for v_ref_ts in
      select t.*,desired.value desired_value,
        tf.id financial_id,tf.invoice_breakdown_json financial_breakdown
      from public.timesheets t
      join jsonb_each(v_source_updates_map) desired
        on t.timesheet_id=(desired.value->>'timesheet_id')::uuid
      left join lateral(
        select f.id,f.invoice_breakdown_json
        from public.timesheets_financials f
        where f.timesheet_id=t.timesheet_id and f.is_current
        order by f.updated_at desc nulls last,f.created_at desc nulls last,f.id desc
        limit 1
      ) tf on true
      where t.is_current
      order by t.timesheet_id
    loop
      v_source_update:=v_ref_ts.desired_value;
      v_source_financial_id:=v_ref_ts.financial_id;
      v_source_ib:=v_ref_ts.financial_breakdown;
      v_source_mode:=upper(coalesce(v_source_ib->>'mode',''));
      v_source_payload_schedule:=v_source_update->'actual_schedule_json';
      v_source_canonical_schedule:=v_ref_ts.actual_schedule_json;
      v_source_new_segments:=null;
      v_source_segment_updates:='[]'::jsonb;
      v_source_segment_reference_changed:=false;

      if (v_source_update->>'has_actual_schedule_json')::boolean then
        if jsonb_typeof(v_source_payload_schedule)<>'array' then
          raise exception using errcode='22023',
            message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
            detail=jsonb_build_object(
              'field','actual_schedule_json','reason','ARRAY_REQUIRED',
              'timesheet_id',v_ref_ts.timesheet_id)::text;
        end if;

        if v_source_mode='SEGMENTS' then
          if v_source_financial_id is null
             or jsonb_typeof(v_source_ib->'segments')<>'array' then
            raise exception using errcode='55000',
              message='INVOICE_SOURCE_EDIT_SOURCE_NOT_CURRENT';
          end if;

          v_ref_seen_keys:='{}'::jsonb;
          for v_source_payload_segment,v_source_payload_ord in
            select value,ord
            from jsonb_array_elements(v_source_payload_schedule)
              with ordinality payload(value,ord)
          loop
            if jsonb_typeof(v_source_payload_segment)<>'object' then
              raise exception using errcode='22023',
                message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
                detail=jsonb_build_object(
                  'field','actual_schedule_json','reason','INVALID_SEGMENT',
                  'ordinal',v_source_payload_ord)::text;
            end if;
            select min(field_name) into v_source_unsupported_field
            from jsonb_object_keys(v_source_payload_segment) field_name
            where not (field_name=any(v_allowed_reference_segment_fields));
            if v_source_unsupported_field is not null then
              raise exception using errcode='22023',
                message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
                detail=jsonb_build_object(
                  'field','actual_schedule_json','reason','UNSUPPORTED_FIELD',
                  'unsupported_field',v_source_unsupported_field,
                  'ordinal',v_source_payload_ord)::text;
            end if;
            if not (v_source_payload_segment ? 'ref_num') then
              raise exception using errcode='22023',
                message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
                detail=jsonb_build_object(
                  'field','actual_schedule_json','reason','REFERENCE_REQUIRED',
                  'ordinal',v_source_payload_ord)::text;
            end if;

            v_ref_seg_id:=nullif(btrim(coalesce(
              v_source_payload_segment->>'segment_id','')),'');
            v_source_match_count:=0;
            v_source_match_segment:=null;
            if v_ref_seg_id is not null then
              select count(*),min(seg.value::text)::jsonb
              into v_source_match_count,v_source_match_segment
              from jsonb_array_elements(v_source_ib->'segments') seg(value)
              where nullif(btrim(coalesce(seg.value->>'segment_id','')),'')=v_ref_seg_id
                and nullif(btrim(coalesce(
                  seg.value->>'invoice_locked_invoice_id','')),'')=p_invoice_id::text;
            end if;

            if v_source_match_count=0 then
              begin
                v_source_start:=nullif(btrim(coalesce(
                  v_source_payload_segment->>'start_utc',
                  v_source_payload_segment->>'start','')),'')::timestamptz;
                v_source_end:=nullif(btrim(coalesce(
                  v_source_payload_segment->>'end_utc',
                  v_source_payload_segment->>'end','')),'')::timestamptz;
              exception when others then
                raise exception using errcode='22023',
                  message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
                  detail=jsonb_build_object(
                    'field','actual_schedule_json','reason','INVALID_SEGMENT_TIME',
                    'ordinal',v_source_payload_ord)::text;
              end;
              if v_source_start is null or v_source_end is null then
                raise exception using errcode='22023',
                  message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
                  detail=jsonb_build_object(
                    'field','actual_schedule_json','reason','SEGMENT_IDENTITY_REQUIRED',
                    'ordinal',v_source_payload_ord)::text;
              end if;
              select count(*),min(seg.value::text)::jsonb
              into v_source_match_count,v_source_match_segment
              from jsonb_array_elements(v_source_ib->'segments') seg(value)
              where nullif(btrim(coalesce(
                    seg.value->>'invoice_locked_invoice_id','')),'')=p_invoice_id::text
                and nullif(btrim(coalesce(
                    seg.value->>'start_utc',seg.value->>'start','')),'')::timestamptz
                    =v_source_start
                and nullif(btrim(coalesce(
                    seg.value->>'end_utc',seg.value->>'end','')),'')::timestamptz
                    =v_source_end;
            end if;

            if v_source_match_count<>1 or v_source_match_segment is null then
              raise exception using errcode='22023',
                message='INVOICE_SOURCE_EDIT_SEGMENT_REFERENCE_AMBIGUOUS',
                detail=jsonb_build_object(
                  'timesheet_id',v_ref_ts.timesheet_id,
                  'ordinal',v_source_payload_ord,
                  'match_count',v_source_match_count)::text;
            end if;

            v_ref_sched_key:=coalesce(
              'SID:'||nullif(btrim(coalesce(
                v_source_match_segment->>'segment_id','')),''),
              'SE:'||coalesce(v_source_match_segment->>'start_utc',
                v_source_match_segment->>'start','')||'|'||
                coalesce(v_source_match_segment->>'end_utc',
                  v_source_match_segment->>'end',''));
            if v_ref_seen_keys ? v_ref_sched_key then
              raise exception using errcode='22023',
                message='INVOICE_SOURCE_EDIT_SEGMENT_REFERENCE_AMBIGUOUS',
                detail=jsonb_build_object(
                  'timesheet_id',v_ref_ts.timesheet_id,
                  'reason','DUPLICATE_IDENTITY')::text;
            end if;
            v_ref_seen_keys:=jsonb_set(
              v_ref_seen_keys,array[v_ref_sched_key],'true'::jsonb,true);
            v_ref_seg_new_ref:=nullif(btrim(coalesce(
              v_source_payload_segment->>'ref_num','')),'');
            v_source_segment_reference_changed:=
              v_source_segment_reference_changed or (
                nullif(btrim(coalesce(
                  v_source_match_segment->>'ref_num','')),'')
                is distinct from v_ref_seg_new_ref);
            v_source_segment_updates:=v_source_segment_updates||
              jsonb_build_array(jsonb_build_object(
                'segment_id',nullif(btrim(coalesce(
                  v_source_match_segment->>'segment_id','')),''),
                'start_identity',coalesce(v_source_match_segment->>'start_utc',
                  v_source_match_segment->>'start'),
                'end_identity',coalesce(v_source_match_segment->>'end_utc',
                  v_source_match_segment->>'end'),
                'ref_num',v_ref_seg_new_ref));
          end loop;

          v_source_new_segments:='[]'::jsonb;
          for v_source_current_segment in
            select value
            from jsonb_array_elements(v_source_ib->'segments')
              with ordinality current_segment(value,ord)
            order by ord
          loop
            v_source_payload_segment:=null;
            select update_item.value into v_source_payload_segment
            from jsonb_array_elements(v_source_segment_updates) update_item(value)
            where (
              nullif(update_item.value->>'segment_id','') is not null
              and nullif(btrim(coalesce(
                v_source_current_segment->>'segment_id','')),'')
                  =nullif(update_item.value->>'segment_id','')
            ) or (
              nullif(update_item.value->>'segment_id','') is null
              and coalesce(v_source_current_segment->>'start_utc',
                    v_source_current_segment->>'start')
                  is not distinct from update_item.value->>'start_identity'
              and coalesce(v_source_current_segment->>'end_utc',
                    v_source_current_segment->>'end')
                  is not distinct from update_item.value->>'end_identity'
            )
            limit 1;
            if v_source_payload_segment is not null then
              v_source_current_segment:=jsonb_set(
                v_source_current_segment,'{ref_num}',
                coalesce(v_source_payload_segment->'ref_num','null'::jsonb),true);
            end if;
            v_source_new_segments:=v_source_new_segments||
              jsonb_build_array(v_source_current_segment);
          end loop;
        else
          v_source_canonical_schedule:=coalesce(
            v_ref_ts.actual_schedule_json,'[]'::jsonb);
          if jsonb_typeof(v_source_canonical_schedule)<>'array'
             or jsonb_array_length(v_source_payload_schedule)
                <>jsonb_array_length(v_source_canonical_schedule) then
            raise exception using errcode='22023',
              message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
              detail=jsonb_build_object(
                'field','actual_schedule_json','reason','STRUCTURE_MISMATCH',
                'timesheet_id',v_ref_ts.timesheet_id)::text;
          end if;
          v_ref_new_segments:='[]'::jsonb;
          for v_source_payload_segment,v_source_current_segment,v_source_payload_ord in
            select p.value,c.value,p.ord
            from jsonb_array_elements(v_source_payload_schedule)
              with ordinality p(value,ord)
            join jsonb_array_elements(v_source_canonical_schedule)
              with ordinality c(value,ord) using(ord)
            order by p.ord
          loop
            if jsonb_typeof(v_source_payload_segment)<>'object'
               or jsonb_typeof(v_source_current_segment)<>'object'
               or not (v_source_payload_segment ? 'ref_num')
               or (v_source_payload_segment-'ref_num') is distinct from
                  (v_source_current_segment-'ref_num') then
              raise exception using errcode='22023',
                message='INVOICE_SOURCE_EDIT_PAYLOAD_INVALID',
                detail=jsonb_build_object(
                  'field','actual_schedule_json','reason','STRUCTURE_MISMATCH',
                  'ordinal',v_source_payload_ord)::text;
            end if;
            v_ref_new_segments:=v_ref_new_segments||jsonb_build_array(
              jsonb_set(v_source_current_segment,'{ref_num}',
                coalesce(v_source_payload_segment->'ref_num','null'::jsonb),true));
          end loop;
          v_source_canonical_schedule:=v_ref_new_segments;
        end if;
      end if;

      v_source_timesheet_row_changed:=(
        ((v_source_update->>'has_reference_number')::boolean
          and v_ref_ts.reference_number is distinct from
            nullif(btrim(coalesce(v_source_update->>'reference_number','')),''))
        or ((v_source_update->>'has_day_references_json')::boolean
          and v_ref_ts.day_references_json is distinct from
            case when jsonb_typeof(v_source_update->'day_references_json')='null'
              then null else v_source_update->'day_references_json' end)
        or ((v_source_update->>'has_actual_schedule_json')::boolean
          and v_source_mode<>'SEGMENTS'
          and v_ref_ts.actual_schedule_json is distinct from
            v_source_canonical_schedule)
        or ((v_source_update->>'has_hospital_norm')::boolean
          and lower(regexp_replace(
                btrim(coalesce(v_ref_ts.hospital_norm,'')),
                '[[:space:]]+',' ','g')) is distinct from
            coalesce(v_source_update->>'hospital_norm',''))
        or ((v_source_update->>'has_ward_norm')::boolean
          and lower(regexp_replace(
                btrim(coalesce(v_ref_ts.ward_norm,'')),
                '[[:space:]]+',' ','g')) is distinct from
            coalesce(v_source_update->>'ward_norm',''))
      );
      v_source_update:=v_source_update||jsonb_build_object(
        'source_mode',v_source_mode,
        'financial_id',v_source_financial_id,
        'canonical_actual_schedule_json',v_source_canonical_schedule,
        'new_financial_segments',v_source_new_segments,
        'segment_updates',v_source_segment_updates,
        'segment_reference_changed',v_source_segment_reference_changed,
        'timesheet_row_changed',v_source_timesheet_row_changed);
      v_source_updates_map:=jsonb_set(
        v_source_updates_map,array[v_ref_ts.timesheet_id::text],
        v_source_update,true);
    end loop;

    select coalesce(array_agg(
      (desired.value->>'timesheet_id')::uuid order by desired.key),
      array[]::uuid[])
    into v_source_changed_ts_ids
    from jsonb_each(v_source_updates_map) desired
    where (desired.value->>'timesheet_row_changed')::boolean
       or (desired.value->>'segment_reference_changed')::boolean;

    select coalesce(array_agg(
      (desired.value->>'timesheet_id')::uuid order by desired.key),
      array[]::uuid[])
    into v_refupd_ts_ids
    from jsonb_each(v_source_updates_map) desired
    where (desired.value->>'timesheet_id')::uuid=any(v_source_changed_ts_ids)
      and (
        (desired.value->>'has_reference_number')::boolean
        or (desired.value->>'has_day_references_json')::boolean
        or (
          (desired.value->>'has_actual_schedule_json')::boolean
          and (
            (desired.value->>'timesheet_row_changed')::boolean
            or (desired.value->>'segment_reference_changed')::boolean
          )
        )
      );

    select coalesce(array_agg(
      (desired.value->>'timesheet_id')::uuid order by desired.key),
      array[]::uuid[])
    into v_location_ts_ids
    from jsonb_each(v_source_updates_map) desired
    where (desired.value->>'timesheet_row_changed')::boolean
      and (
        (desired.value->>'has_hospital_norm')::boolean
        or (desired.value->>'has_ward_norm')::boolean
      );

    if exists(
      select 1 from jsonb_each(v_source_updates_map) desired
      where (desired.value->>'timesheet_row_changed')::boolean
    ) then
      with desired as materialized(
        select (value->>'timesheet_id')::uuid as timesheet_id,value
        from jsonb_each(v_source_updates_map)
      )
      update public.timesheets t
      set updated_at=v_now,
          reference_number=case when (d.value->>'has_reference_number')::boolean
            then nullif(btrim(coalesce(d.value->>'reference_number','')),'')
            else t.reference_number end,
          day_references_json=case when (d.value->>'has_day_references_json')::boolean
            then case when jsonb_typeof(d.value->'day_references_json')='null'
              then null else d.value->'day_references_json' end
            else t.day_references_json end,
          actual_schedule_json=case
            when (d.value->>'has_actual_schedule_json')::boolean
              and d.value->>'source_mode'<>'SEGMENTS'
            then d.value->'canonical_actual_schedule_json'
            else t.actual_schedule_json end,
          hospital_norm=case when (d.value->>'has_hospital_norm')::boolean
            then coalesce(d.value->>'hospital_norm','') else t.hospital_norm end,
          ward_norm=case when (d.value->>'has_ward_norm')::boolean
            then coalesce(d.value->>'ward_norm','') else t.ward_norm end
      from desired d
      where t.timesheet_id=d.timesheet_id
        and (d.value->>'timesheet_row_changed')::boolean
        and t.is_current;
    end if;

    v_refupd_applied:=cardinality(v_refupd_ts_ids);
    v_location_applied:=cardinality(v_location_ts_ids);

    -- Marker rows exist only where the timesheet statement has already advanced
    -- the source revision and the following SEGMENTS ref update would otherwise
    -- invalidate the same source a second time.
    select coalesce(jsonb_object_agg(
      t.timesheet_id::text,
      jsonb_build_object('expected_revision',t.document_revision)),
      '{}'::jsonb)
    into v_source_marker_rows
    from jsonb_each(v_source_updates_map) desired
    join public.timesheets t
      on t.timesheet_id=(desired.value->>'timesheet_id')::uuid and t.is_current
    where (desired.value->>'timesheet_row_changed')::boolean
      and (desired.value->>'segment_reference_changed')::boolean
      and t.document_revision=
        (desired.value->>'expected_document_revision')::bigint+1;
    if (select count(*) from jsonb_each(v_source_marker_rows))<>(
      select count(*) from jsonb_each(v_source_updates_map) desired
      where (desired.value->>'timesheet_row_changed')::boolean
        and (desired.value->>'segment_reference_changed')::boolean
    ) then
      raise exception using errcode='55000',
        message='SOURCE_EDIT_REPLACEMENT_RESULT_INVALID',
        detail=jsonb_build_object(
          'reason','SOURCE_REVISION_ADVANCE_NOT_EXACT')::text;
    end if;
    v_source_marker:=jsonb_build_object(
      'txid',txid_current()::text,'rows',v_source_marker_rows);
    perform set_config(
      'cloudtms.invoice_source_edit_marker',v_source_marker::text,true);

    -- The legacy per-array loops below remain structurally compatible for old
    -- payload code, but the strict merged statement above is now the sole
    -- execution path for accepted source edits.
    v_reference_updates:=null;
    v_location_updates:=null;
  end if;





  -- 0) Apply reference updates to timesheets (does NOT recompute TSFIN; it updates the source timesheet refs)
  if v_reference_updates is not null and jsonb_typeof(v_reference_updates)='array' and jsonb_array_length(v_reference_updates) > 0 then
    for v_refupd in
      select value from jsonb_array_elements(v_reference_updates) value
    loop
      if v_refupd is null or jsonb_typeof(v_refupd) <> 'object' then
        continue;
      end if;

      if nullif(btrim(coalesce(v_refupd->>'timesheet_id','')), '') is null then
        continue;
      end if;

      v_refupd_ts_id := (v_refupd->>'timesheet_id')::uuid;

      v_refupd_set_refnum := (v_refupd ? 'reference_number');
      v_refupd_set_dayrefs := (v_refupd ? 'day_references_json');
      v_refupd_set_sched := (v_refupd ? 'actual_schedule_json');

      v_refupd_refnum := null;
      if v_refupd_set_refnum then
        v_refupd_refnum := nullif(btrim(coalesce(v_refupd->>'reference_number','')), '');
      end if;

      v_refupd_dayrefs := null;
      if v_refupd_set_dayrefs then
        v_refupd_dayrefs := v_refupd->'day_references_json';
        if v_refupd_dayrefs is not null and jsonb_typeof(v_refupd_dayrefs) = 'null' then
          v_refupd_dayrefs := null;
        end if;
      end if;

      v_refupd_sched := null;
      if v_refupd_set_sched then
        v_refupd_sched := v_refupd->'actual_schedule_json';
        if v_refupd_sched is not null and jsonb_typeof(v_refupd_sched) = 'null' then
          v_refupd_sched := null;
        end if;
      end if;

      update public.timesheets tsu
      set
        updated_at = v_now,
        reference_number = case when v_refupd_set_refnum then v_refupd_refnum else tsu.reference_number end,
        day_references_json = case when v_refupd_set_dayrefs then v_refupd_dayrefs else tsu.day_references_json end,
        actual_schedule_json = case when v_refupd_set_sched then v_refupd_sched else tsu.actual_schedule_json end
      where tsu.timesheet_id = v_refupd_ts_id
        and tsu.is_current = true
        and exists(
          select 1
          from public.invoice_lines owned_line
          where owned_line.invoice_id=p_invoice_id
            and (
              owned_line.timesheet_id=tsu.timesheet_id
              or (
                owned_line.timesheet_id is null
                and coalesce(owned_line.meta_json->>'timesheet_id','')
                  ~ '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
                and (owned_line.meta_json->>'timesheet_id')::uuid=tsu.timesheet_id
              )
            )
        )
        and (
          (v_refupd_set_refnum and tsu.reference_number is distinct from v_refupd_refnum)
          or (v_refupd_set_dayrefs and tsu.day_references_json is distinct from v_refupd_dayrefs)
          or (v_refupd_set_sched and tsu.actual_schedule_json is distinct from v_refupd_sched)
        );

      get diagnostics v_rc = row_count;
      if coalesce(v_rc,0) > 0 then
        v_refupd_applied := v_refupd_applied + 1;
        v_refupd_ts_ids := v_refupd_ts_ids || v_refupd_ts_id;
      end if;

    end loop;

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object('step','reference_updates_applied','count_requested',v_refupd_count,'count_applied',v_refupd_applied)
      );
    end if;
  end if;

  -- 0a) Apply only material hospital/ward changes to current timesheets that
  -- are owned by this invoice. Identical canonical values perform no UPDATE,
  -- so they cannot dirty documents or queue replacement work.
  if v_location_updates is not null
     and jsonb_typeof(v_location_updates)='array'
     and jsonb_array_length(v_location_updates)>0 then
    for v_location_update in
      select value from jsonb_array_elements(v_location_updates) value
    loop
      if v_location_update is null
         or jsonb_typeof(v_location_update)<>'object'
         or nullif(btrim(coalesce(v_location_update->>'timesheet_id','')),'') is null then
        continue;
      end if;

      v_location_ts_id := (v_location_update->>'timesheet_id')::uuid;
      v_location_set_hospital := v_location_update ? 'hospital_norm';
      v_location_set_ward := v_location_update ? 'ward_norm';
      if not v_location_set_hospital and not v_location_set_ward then
        continue;
      end if;

      v_location_hospital_norm := null;
      if v_location_set_hospital then
        v_location_hospital_norm := nullif(lower(regexp_replace(
          btrim(coalesce(v_location_update->>'hospital_norm','')),
          '[[:space:]]+',' ','g')), '');
      end if;
      v_location_ward_norm := null;
      if v_location_set_ward then
        v_location_ward_norm := nullif(lower(regexp_replace(
          btrim(coalesce(v_location_update->>'ward_norm','')),
          '[[:space:]]+',' ','g')), '');
      end if;

      update public.timesheets tsu
      set updated_at=v_now,
          hospital_norm=case when v_location_set_hospital
            then v_location_hospital_norm else tsu.hospital_norm end,
          ward_norm=case when v_location_set_ward
            then v_location_ward_norm else tsu.ward_norm end
      where tsu.timesheet_id=v_location_ts_id
        and tsu.is_current=true
        and exists(
          select 1
          from public.invoice_lines owned_line
          where owned_line.invoice_id=p_invoice_id
            and (
              owned_line.timesheet_id=tsu.timesheet_id
              or (
                owned_line.timesheet_id is null
                and coalesce(owned_line.meta_json->>'timesheet_id','')
                  ~ '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
                and (owned_line.meta_json->>'timesheet_id')::uuid=tsu.timesheet_id
              )
            )
        )
        and (
          (v_location_set_hospital
            and tsu.hospital_norm is distinct from v_location_hospital_norm)
          or (v_location_set_ward
            and tsu.ward_norm is distinct from v_location_ward_norm)
        );

      get diagnostics v_rc=row_count;
      if coalesce(v_rc,0)>0 then
        v_location_applied:=v_location_applied+1;
        v_location_ts_ids:=v_location_ts_ids||v_location_ts_id;
      end if;
    end loop;

    if v_invoice_debug then
      v_dbg_steps:=v_dbg_steps||jsonb_build_array(jsonb_build_object(
        'step','timesheet_location_updates_applied',
        'count_requested',v_location_count,
        'count_applied',v_location_applied));
    end if;
  end if;
  -- 0b) After reference updates: refresh invoice_lines meta (ts_reference_number / schedule_ref_nums) and
  -- synchronise only the approved ref_num fields into the locked SEGMENTS
  -- financial projection. The full financial objects and their order are
  -- preserved from the locked current snapshot.
  if v_refupd_ts_ids is not null and coalesce(array_length(v_refupd_ts_ids,1),0) > 0 then

    with desired as materialized(
      select value
      from jsonb_each(v_source_updates_map)
      where (value->>'segment_reference_changed')::boolean
    )
    update public.timesheets_financials tf
    set invoice_breakdown_json=jsonb_set(
      coalesce(tf.invoice_breakdown_json,'{}'::jsonb),
      '{segments}',d.value->'new_financial_segments',true)
    from desired d
    where tf.id=(d.value->>'financial_id')::uuid
      and tf.is_current
      and tf.timesheet_id=(d.value->>'timesheet_id')::uuid
      and upper(coalesce(tf.invoice_breakdown_json->>'mode',''))='SEGMENTS'
      and tf.invoice_breakdown_json->'segments'
        is distinct from d.value->'new_financial_segments';
    get diagnostics v_refupd_tsfin_rows_updated=row_count;
    select coalesce(sum(jsonb_array_length(
      coalesce(value->'segment_updates','[]'::jsonb))),0)::integer
    into v_refupd_tsfin_segments_updated
    from jsonb_each(v_source_updates_map)
    where (value->>'segment_reference_changed')::boolean;

    -- The marker has served its single synchronisation statement. Clear it so
    -- no later statement in this transaction can inherit suppression authority.
    perform set_config('cloudtms.invoice_source_edit_marker','{}',true);

    select array_agg(distinct x)
    into v_refupd_ts_ids_distinct
    from unnest(v_refupd_ts_ids) x
    where x is not null;

    v_refupd_ts_ids_distinct := coalesce(v_refupd_ts_ids_distinct, array[]::uuid[]);

    foreach v_ref_ts_id in array v_refupd_ts_ids_distinct loop
      if v_ref_ts_id is null then
        continue;
      end if;

      select tsu.*
      into v_ref_ts
      from public.timesheets tsu
      where tsu.timesheet_id = v_ref_ts_id
        and tsu.is_current = true
      limit 1;

      if not found then
        continue;
      end if;
      v_source_update:=v_source_updates_map->v_ref_ts_id::text;
      v_source_mode:=upper(coalesce(v_source_update->>'source_mode',''));
      v_source_canonical_schedule:=case when v_source_mode='SEGMENTS'
        then coalesce(v_source_update->'new_financial_segments','[]'::jsonb)
        else coalesce(v_ref_ts.actual_schedule_json,'[]'::jsonb) end;

      -- Build the cache from the exact authority used by this invoice. SEGMENTS
      -- refs come from invoice-owned financial segments; other modes use the
      -- structurally preserved timesheet schedule.
      v_ref_schedule_refs := '[]'::jsonb;

      if nullif(btrim(coalesce(v_ref_ts.reference_number,'')), '') is not null then
        v_ref_schedule_refs := v_ref_schedule_refs || jsonb_build_array(to_jsonb(nullif(btrim(v_ref_ts.reference_number),'')));
      end if;

      if v_ref_ts.day_references_json is not null and jsonb_typeof(v_ref_ts.day_references_json) = 'object' then
        for kv in
          select key as k, value as v
          from jsonb_each_text(v_ref_ts.day_references_json)
        loop
          if nullif(btrim(coalesce(kv.v,'')), '') is not null then
            v_ref_schedule_refs := v_ref_schedule_refs || jsonb_build_array(to_jsonb(nullif(btrim(kv.v),'')));
          end if;
        end loop;
      end if;

      if jsonb_typeof(v_source_canonical_schedule)='array' then
        for v_ref_seg_obj in
          select value
          from jsonb_array_elements(v_source_canonical_schedule) value
        loop
          if v_ref_seg_obj is null or jsonb_typeof(v_ref_seg_obj) <> 'object' then
            continue;
          end if;
          v_ref_sched_ref := nullif(btrim(coalesce(v_ref_seg_obj->>'ref_num','')), '');
          if v_ref_sched_ref is not null then
            v_ref_schedule_refs := v_ref_schedule_refs || jsonb_build_array(to_jsonb(v_ref_sched_ref));
          end if;
        end loop;
      end if;

      select coalesce(jsonb_agg(to_jsonb(x) order by x), '[]'::jsonb)
      into v_ref_schedule_refs_distinct
      from (
        select distinct btrim(t.x) as x
        from jsonb_array_elements_text(coalesce(v_ref_schedule_refs,'[]'::jsonb)) as t(x)
        where nullif(btrim(coalesce(t.x,'')), '') is not null
      ) q;

      -- Refresh meta_json on all invoice lines for this timesheet
      update public.invoice_lines ilu
      set meta_json = coalesce(ilu.meta_json, '{}'::jsonb) || jsonb_build_object(
        'ts_reference_number', nullif(btrim(coalesce(v_ref_ts.reference_number,'')), ''),
        'schedule_ref_nums', coalesce(v_ref_schedule_refs_distinct, '[]'::jsonb),
        'schedule_ref_count', jsonb_array_length(coalesce(v_ref_schedule_refs_distinct, '[]'::jsonb))
      )
      where ilu.invoice_id = p_invoice_id
        and (
          ilu.timesheet_id=v_ref_ts_id
          or (
            ilu.timesheet_id is null
            and coalesce(ilu.meta_json->>'timesheet_id','') ~
              '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
            and (ilu.meta_json->>'timesheet_id')::uuid=v_ref_ts_id
          )
        )
        and (
          ilu.meta_json->'ts_reference_number' is distinct from
            coalesce(to_jsonb(nullif(btrim(coalesce(v_ref_ts.reference_number,'')),'')),'null'::jsonb)
          or ilu.meta_json->'schedule_ref_nums' is distinct from
            coalesce(v_ref_schedule_refs_distinct,'[]'::jsonb)
          or ilu.meta_json->'schedule_ref_count' is distinct from
            to_jsonb(jsonb_array_length(coalesce(v_ref_schedule_refs_distinct,'[]'::jsonb)))
        );

      get diagnostics v_rc = row_count;
      v_refupd_meta_rows_updated := v_refupd_meta_rows_updated + coalesce(v_rc,0);

      -- Best-effort sync: update tsfin.invoice_breakdown_json segments[].ref_num by matching start/end fields
      v_ref_seg_updates_this_ts := 0;
      v_ref_seg_matches_this_ts := 0;
      v_ref_tsfin_id := null;
      v_ref_ib := null;

        select tfu.id, tfu.invoice_breakdown_json
      into v_ref_tsfin_id, v_ref_ib
      from public.timesheets_financials tfu
      where tfu.timesheet_id = v_ref_ts_id
        and tfu.is_current = true
      limit 1
      for update;


      if v_ref_tsfin_id is not null
         and v_source_mode<>'SEGMENTS'
         and v_ref_ib is not null
         and jsonb_typeof(v_ref_ib) = 'object'
         and upper(coalesce(v_ref_ib->>'mode','')) = 'SEGMENTS'
         and jsonb_typeof(v_ref_ib->'segments') = 'array'
         and v_ref_ts.actual_schedule_json is not null
         and jsonb_typeof(v_ref_ts.actual_schedule_json) = 'array'
       then
         -- Build a map of segment_id (preferred) or start|end -> ref_num from actual_schedule_json
        v_ref_sched_map := '{}'::jsonb;
        for v_ref_seg_obj in
          select value
          from jsonb_array_elements(v_ref_ts.actual_schedule_json) value
        loop
          if v_ref_seg_obj is null or jsonb_typeof(v_ref_seg_obj) <> 'object' then
            continue;
          end if;

          v_ref_sched_ref := nullif(btrim(coalesce(v_ref_seg_obj->>'ref_num','')), '');
          v_ref_seg_id := nullif(btrim(coalesce(v_ref_seg_obj->>'segment_id','')), '');
          if v_ref_seg_id is not null then
            v_ref_sched_key := 'SID:' || v_ref_seg_id;
            if v_ref_sched_map ? v_ref_sched_key then
              raise exception using errcode='22023',
                message='INVOICE_SOURCE_EDIT_SEGMENT_REFERENCE_AMBIGUOUS',
                detail=jsonb_build_object(
                  'timesheet_id',v_ref_ts_id,'identity',v_ref_sched_key,
                  'side','TIMESHEET_SCHEDULE')::text;
            end if;
            v_ref_sched_map := jsonb_set(v_ref_sched_map, array[v_ref_sched_key], case when v_ref_sched_ref is null then 'null'::jsonb else to_jsonb(v_ref_sched_ref) end, true);
            continue;
          end if;

          v_ref_seg_start := nullif(btrim(coalesce(v_ref_seg_obj->>'start_utc', v_ref_seg_obj->>'start', '')), '');
          v_ref_seg_end := nullif(btrim(coalesce(v_ref_seg_obj->>'end_utc', v_ref_seg_obj->>'end', '')), '');
          if v_ref_seg_start is null or v_ref_seg_end is null then
            continue;
          end if;

          v_ref_sched_key := 'SE:' || v_ref_seg_start || '|' || v_ref_seg_end;
          if v_ref_sched_map ? v_ref_sched_key then
            raise exception using errcode='22023',
              message='INVOICE_SOURCE_EDIT_SEGMENT_REFERENCE_AMBIGUOUS',
              detail=jsonb_build_object(
                'timesheet_id',v_ref_ts_id,'identity',v_ref_sched_key,
                'side','TIMESHEET_SCHEDULE')::text;
          end if;
          v_ref_sched_map := jsonb_set(v_ref_sched_map, array[v_ref_sched_key], case when v_ref_sched_ref is null then 'null'::jsonb else to_jsonb(v_ref_sched_ref) end, true);
        end loop;

        v_ref_new_segments := '[]'::jsonb;
        v_ref_seen_keys := '{}'::jsonb;
        for v_ref_seg_obj in
          select value
          from jsonb_array_elements(v_ref_ib->'segments') value
        loop
          if v_ref_seg_obj is null or jsonb_typeof(v_ref_seg_obj) <> 'object' then
            v_ref_new_segments := v_ref_new_segments || jsonb_build_array(v_ref_seg_obj);
            continue;
          end if;

          v_ref_seg_new_ref := null;
          v_ref_seg_has_update := false;

          v_ref_seg_id := nullif(btrim(coalesce(v_ref_seg_obj->>'segment_id','')), '');
          if v_ref_seg_id is not null then
            v_ref_sched_key := 'SID:' || v_ref_seg_id;
            if v_ref_seen_keys ? v_ref_sched_key then
              raise exception using errcode='22023',
                message='INVOICE_SOURCE_EDIT_SEGMENT_REFERENCE_AMBIGUOUS',
                detail=jsonb_build_object(
                  'timesheet_id',v_ref_ts_id,'identity',v_ref_sched_key,
                  'side','FINANCIAL_SEGMENTS')::text;
            end if;
            v_ref_seen_keys:=jsonb_set(v_ref_seen_keys,array[v_ref_sched_key],'true'::jsonb,true);
            if v_ref_sched_map ? v_ref_sched_key then
              v_ref_seg_new_ref := nullif(btrim(coalesce(v_ref_sched_map->>v_ref_sched_key,'')), '');
              v_ref_seg_has_update := true;
              v_ref_seg_matches_this_ts := v_ref_seg_matches_this_ts + 1;
            end if;
          end if;

          if not v_ref_seg_has_update then
            v_ref_seg_start := nullif(btrim(coalesce(v_ref_seg_obj->>'start_utc', v_ref_seg_obj->>'start', '')), '');
            v_ref_seg_end := nullif(btrim(coalesce(v_ref_seg_obj->>'end_utc', v_ref_seg_obj->>'end', '')), '');

            if v_ref_seg_start is not null and v_ref_seg_end is not null then
              v_ref_sched_key := 'SE:' || v_ref_seg_start || '|' || v_ref_seg_end;
              if v_ref_seen_keys ? v_ref_sched_key then
                raise exception using errcode='22023',
                  message='INVOICE_SOURCE_EDIT_SEGMENT_REFERENCE_AMBIGUOUS',
                  detail=jsonb_build_object(
                    'timesheet_id',v_ref_ts_id,'identity',v_ref_sched_key,
                    'side','FINANCIAL_SEGMENTS')::text;
              end if;
              v_ref_seen_keys:=jsonb_set(v_ref_seen_keys,array[v_ref_sched_key],'true'::jsonb,true);
              if v_ref_sched_map ? v_ref_sched_key then
                v_ref_seg_new_ref := nullif(btrim(coalesce(v_ref_sched_map->>v_ref_sched_key,'')), '');
                v_ref_seg_has_update := true;
                v_ref_seg_matches_this_ts := v_ref_seg_matches_this_ts + 1;
              end if;
            end if;
          end if;

          if v_ref_seg_has_update then
            v_ref_seg_cur_ref := nullif(btrim(coalesce(v_ref_seg_obj->>'ref_num','')), '');
            if v_ref_seg_cur_ref is distinct from v_ref_seg_new_ref then
              v_ref_seg_obj := jsonb_set(
                v_ref_seg_obj,
                '{ref_num}',
                case when v_ref_seg_new_ref is null then 'null'::jsonb else to_jsonb(v_ref_seg_new_ref) end,
                true
              );
              v_ref_seg_updates_this_ts := v_ref_seg_updates_this_ts + 1;
            end if;
          end if;

          v_ref_new_segments := v_ref_new_segments || jsonb_build_array(v_ref_seg_obj);
        end loop;



        if v_ref_sched_map is not null
           and jsonb_typeof(v_ref_sched_map) = 'object'
           and v_ref_sched_map <> '{}'::jsonb
           and coalesce(jsonb_array_length(coalesce(v_ref_ib->'segments','[]'::jsonb)),0) > 0
           and coalesce(v_ref_seg_matches_this_ts,0) = 0
        then
          raise exception 'SEGMENTS reference sync failed: no segments matched schedule keys (timesheet_id=% tsfin_id=%)', v_ref_ts_id, v_ref_tsfin_id;
        end if;

        if v_ref_seg_updates_this_ts > 0 then
              update public.timesheets_financials tfu2
          set invoice_breakdown_json = jsonb_set(coalesce(tfu2.invoice_breakdown_json, '{}'::jsonb), '{segments}', v_ref_new_segments, true)
          where tfu2.id = v_ref_tsfin_id
            and tfu2.is_current = true;


          get diagnostics v_rc = row_count;
          if coalesce(v_rc,0) > 0 then
            v_refupd_tsfin_rows_updated := v_refupd_tsfin_rows_updated + 1;
            v_refupd_tsfin_segments_updated := v_refupd_tsfin_segments_updated + v_ref_seg_updates_this_ts;
          end if;
        end if;

      end if;

    end loop;

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','reference_updates_meta_refreshed',
          'timesheets_count', coalesce(array_length(v_refupd_ts_ids_distinct,1),0),
          'invoice_line_rows_updated', v_refupd_meta_rows_updated,
          'tsfin_rows_updated', v_refupd_tsfin_rows_updated,
          'tsfin_segments_refnum_updated', v_refupd_tsfin_segments_updated
        )
      );
    end if;
  end if;

  -- 1) Removals (by invoice_line_id)
  if v_remove_ids is not null and coalesce(array_length(v_remove_ids,1),0) > 0 then
    -- collect timesheet_ids touched (any)
    select array_agg(distinct l.timesheet_id) filter (where l.timesheet_id is not null)
    into v_ts_ids_touched
    from public.invoice_lines l
    where l.invoice_id = p_invoice_id
      and l.id = any(v_remove_ids);

    -- record removed lines for history
    v_hist_lines_removed := coalesce(p_payload->'remove_invoice_line_ids','[]'::jsonb);

    -- Only unlock TSFIN when HOURS lines were removed (prevents accidental unlock when deleting only expenses/other lines)
    -- IMPORTANT: compute BEFORE deletion because we match on the removed invoice_line ids.
    select array_agg(distinct l.timesheet_id) filter (where l.timesheet_id is not null)
    into v_cw_ts_ids
    from public.invoice_lines l
    where l.invoice_id = p_invoice_id
      and l.id = any(v_remove_ids)
      and upper(coalesce(l.meta_json->>'line_type','')) in ('HOURS_WEEKLY','HOURS_DAILY');

    v_cw_ts_ids := coalesce(v_cw_ts_ids, array[]::uuid[]);



    if coalesce(array_length(v_cw_ts_ids,1),0) > 0 then
      v_refresh_hr_cache := true;
    end if;
delete from public.invoice_lines
    where invoice_id = p_invoice_id
      and id = any(v_remove_ids);
    get diagnostics v_rc = row_count;
    v_dbg_lines_deleted := v_dbg_lines_deleted + coalesce(v_rc,0);

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','lines_removed',
          'rows_deleted', coalesce(v_rc,0),
          'timesheets_touched', coalesce(array_length(v_ts_ids_touched,1),0),
          'timesheets_to_unlock_count', coalesce(array_length(v_cw_ts_ids,1),0)
        )
      );
    end if;

    -- FIX: if a touched timesheet now has NO remaining invoice_lines on this invoice,
    -- unlock it even if the removed lines were expenses/mileage/additional (expense-only/SEGMENTS-empty case).
    v_ts_ids_fully_removed := array[]::uuid[];
    select array_agg(distinct x)
    into v_ts_ids_fully_removed
    from unnest(coalesce(v_ts_ids_touched, array[]::uuid[])) x
    where x is not null
      and not exists (
        select 1
        from public.invoice_lines l2
        where l2.invoice_id = p_invoice_id
          and l2.timesheet_id = x
      );

    v_ts_ids_fully_removed := coalesce(v_ts_ids_fully_removed, array[]::uuid[]);

    if coalesce(array_length(v_ts_ids_fully_removed,1),0) > 0 then
      -- unlock any segments locked to this invoice (safe no-op for SEGMENTS-empty)
      perform public._inv_unlock_segments_for_invoice(p_invoice_id, v_ts_ids_fully_removed);

      -- clear whole-timesheet lock if it was set for this invoice (SEGMENTS-empty / non-segments / pseudo segment_id null locks)
      update public.timesheets_financials tfu_lock
      set
        locked_by_invoice_id = null,
        locked_at_utc = null,
        updated_at = v_now
      where tfu_lock.is_current = true
        and tfu_lock.timesheet_id = any(v_ts_ids_fully_removed)
        and tfu_lock.locked_by_invoice_id = p_invoice_id;

      get diagnostics v_rc = row_count;
      v_dbg_timesheets_unlocked := v_dbg_timesheets_unlocked + coalesce(v_rc,0);

      v_refresh_hr_cache := true;

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','timesheets_unlocked_after_full_removal',
            'timesheets_fully_removed_count', coalesce(array_length(v_ts_ids_fully_removed,1),0),
            'tsfin_rows_unlocked_count', coalesce(v_rc,0)
          )
        );
      end if;
    end if;

    v_cw_ts_ids := coalesce(v_cw_ts_ids, array[]::uuid[]);

    if v_cw_ts_ids is not null and coalesce(array_length(v_cw_ts_ids,1),0) > 0 then
      perform public._inv_unlock_segments_for_invoice(p_invoice_id, v_cw_ts_ids);
      v_dbg_timesheets_unlocked := v_dbg_timesheets_unlocked + coalesce(array_length(v_cw_ts_ids,1),0);

      -- Cleanup: if no segments remain on THIS invoice for a touched timesheet, remove ALL remaining invoice lines for that timesheet
      foreach tsid in array v_cw_ts_ids loop
        if tsid is null then continue; end if;

        -- detect if any segments are still locked to THIS invoice
        select tf.*
        into snap
        from public.timesheets_financials tf
        where tf.is_current = true
          and tf.timesheet_id = tsid
        limit 1;

        if not found then
          continue;
        end if;

        segments := '[]'::jsonb;
        if snap.invoice_breakdown_json is not null
           and jsonb_typeof(snap.invoice_breakdown_json)='object'
           and coalesce(snap.invoice_breakdown_json->>'mode','')='SEGMENTS'
           and jsonb_typeof(snap.invoice_breakdown_json->'segments')='array'
        then
          for v_seg in
            select value from jsonb_array_elements(snap.invoice_breakdown_json->'segments') value
          loop
            if v_seg is null or jsonb_typeof(v_seg) <> 'object' then
              continue;
            end if;
            seg_locked := nullif(btrim(coalesce(v_seg->>'invoice_locked_invoice_id','')), '');
            if seg_locked = p_invoice_id::text then
              segments := segments || jsonb_build_array(v_seg);
            end if;
          end loop;

          if jsonb_array_length(coalesce(segments,'[]'::jsonb)) = 0 then
            delete from public.invoice_lines
            where invoice_id = p_invoice_id
              and timesheet_id = tsid;
          end if;
        else
          -- Non-segments: if snapshot is no longer locked to this invoice, remove all remaining invoice lines for this timesheet
          if snap.locked_by_invoice_id is null then
            delete from public.invoice_lines
            where invoice_id = p_invoice_id
              and timesheet_id = tsid;
          end if;
        end if;
      end loop;
    end if;

    -- History event (always)
    perform public._audit_insert(
      'invoices',
      p_invoice_id::text,
      'INVOICE_LINES_REMOVED',
      null,
      jsonb_build_object('remove_invoice_line_ids', v_hist_lines_removed, 'timesheet_ids_touched', coalesce(to_jsonb(v_ts_ids_touched), '[]'::jsonb)),
      null,
      p_actor_user_id
    );

  end if;


  -- 1b) Segment edits (SEGMENTS mode only)
-- NOTE: Segment moves are NOT allowed when additional rates OR expenses/mileage exist on the TSFIN snapshot.
-- Payload contract uses tsfin_id + segment_id.
if v_has_seg_ops then

  v_dbg_seg_add_refs := case when v_add_seg_refs is null then 0 else jsonb_array_length(coalesce(v_add_seg_refs,'[]'::jsonb)) end;
  v_dbg_seg_remove_refs := case when v_remove_seg_refs is null then 0 else jsonb_array_length(coalesce(v_remove_seg_refs,'[]'::jsonb)) end;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','segment_ops_start',
        'add_segment_refs_count', v_dbg_seg_add_refs,
        'remove_segment_refs_count', v_dbg_seg_remove_refs
      )
    );
  end if;

  -- Collect distinct tsfin_ids involved in segment ops
  select array_agg(distinct (x->>'tsfin_id')::uuid)
  into v_seg_tsfin_ids
  from (
    select value as x
    from jsonb_array_elements(coalesce(v_remove_seg_refs,'[]'::jsonb))
    union all
    select value as x
    from jsonb_array_elements(coalesce(v_add_seg_refs,'[]'::jsonb))
  ) u
  where jsonb_typeof(x) = 'object'
    and nullif(btrim(coalesce(x->>'tsfin_id','')), '') is not null;

  v_seg_tsfin_ids := coalesce(v_seg_tsfin_ids, array[]::uuid[]);

  v_dbg_seg_tsfins := coalesce(array_length(v_seg_tsfin_ids,1),0);
  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(jsonb_build_object('step','segment_ops_targets','tsfin_count',v_dbg_seg_tsfins));
  end if;

  if coalesce(array_length(v_seg_tsfin_ids,1),0) > 0 then

    -- Validate that each snapshot is current SEGMENTS mode and has NO additional/expenses/mileage
    foreach v_tsfin_id in array v_seg_tsfin_ids loop
      select *
      into snap
      from public.timesheets_financials tf
      where tf.id = v_tsfin_id
      limit 1;

      if not found then
        raise exception 'Segment edit refers to unknown tsfin_id %', v_tsfin_id;
      end if;

      if snap.is_current is not true then
        raise exception 'Segment edit requires current tsfin snapshot (tsfin_id=%)', v_tsfin_id;
      end if;

      if snap.client_id is distinct from v_inv.client_id then
        raise exception 'Segment edit timesheet client mismatch (tsfin_id=%)', v_tsfin_id;
      end if;

      if snap.invoice_breakdown_json is null
         or jsonb_typeof(snap.invoice_breakdown_json) <> 'object'
         or upper(coalesce(snap.invoice_breakdown_json->>'mode','')) <> 'SEGMENTS'
         or jsonb_typeof(snap.invoice_breakdown_json->'segments') <> 'array'
      then
        raise exception 'Segment edit is only supported for SEGMENTS timesheets (tsfin_id=%)', v_tsfin_id;
      end if;

      v_has_additional :=
        public._inv_round2(coalesce(snap.additional_pay_ex_vat,0)) <> 0
        or public._inv_round2(coalesce(snap.additional_charge_ex_vat,0)) <> 0
        or (snap.additional_units_json is not null and jsonb_typeof(snap.additional_units_json)='object' and snap.additional_units_json <> '{}'::jsonb);

      v_has_expense_or_mileage :=
        public._inv_round2(coalesce(snap.expenses_pay_ex_vat,0)) <> 0
        or public._inv_round2(coalesce(snap.expenses_charge_ex_vat,0)) <> 0
        or public._inv_round2(coalesce(snap.mileage_pay_ex_vat,0)) <> 0
        or public._inv_round2(coalesce(snap.mileage_charge_ex_vat,0)) <> 0
        or public._inv_round2(coalesce(snap.mileage_units,0)) <> 0
        or public._inv_round2(coalesce(snap.travel_pay_ex_vat,0)) <> 0
        or public._inv_round2(coalesce(snap.travel_charge_ex_vat,0)) <> 0
        or public._inv_round2(coalesce(snap.accommodation_pay_ex_vat,0)) <> 0
        or public._inv_round2(coalesce(snap.accommodation_charge_ex_vat,0)) <> 0
        or public._inv_round2(coalesce(snap.other_pay_ex_vat,0)) <> 0
        or public._inv_round2(coalesce(snap.other_charge_ex_vat,0)) <> 0;

      if v_has_additional then
        raise exception 'Segments cannot be moved when additional rates exist (timesheet_id=% tsfin_id=%)', snap.timesheet_id, v_tsfin_id;
      end if;

      if v_has_expense_or_mileage then
        raise exception 'Segments cannot be moved when expenses or mileage exist (timesheet_id=% tsfin_id=%)', snap.timesheet_id, v_tsfin_id;
      end if;
    end loop;

    -- Validate and apply add_segment_refs (lock selected segments)
    v_seg_refs_to_lock := '[]'::jsonb;
    if v_add_seg_refs is not null and jsonb_typeof(v_add_seg_refs)='array' and jsonb_array_length(v_add_seg_refs) > 0 then
      for v_ref in
        select value from jsonb_array_elements(v_add_seg_refs) value
      loop
        if v_ref is null or jsonb_typeof(v_ref) <> 'object' then
          continue;
        end if;

        if nullif(btrim(coalesce(v_ref->>'tsfin_id','')), '') is null then
          continue;
        end if;

        v_tsfin_id := (v_ref->>'tsfin_id')::uuid;
        v_seg_id := nullif(btrim(coalesce(v_ref->>'segment_id','')), '');

        if v_seg_id is null then
          raise exception 'add_segment_refs requires segment_id (tsfin_id=%)', v_tsfin_id;
        end if;

          -- Load snapshot + timesheet + precheck (must be OK)
        select
          tf.*,
          tsr.sheet_scope::text as sheet_scope,
          coalesce(tsr.submission_mode::text,'') as submission_mode,
          tsr.day_references_json,
          tsr.actual_schedule_json,
          tsr.week_ending_date,
          cw.contract_id
        into snap
        from public.timesheets_financials tf
        join public.timesheets tsr on tsr.timesheet_id = tf.timesheet_id and tsr.is_current = true
        left join public.contract_weeks cw on cw.timesheet_id = tf.timesheet_id
        join public.v_ts_invoice_precheck pcv on pcv.timesheet_id = tf.timesheet_id
        where tf.id = v_tsfin_id
          and tf.is_current = true
          and tf.client_id = v_inv.client_id
          and upper(coalesce(pcv.precheck_status,''))
            in ('OK','BLOCK_NO_PDF')
        limit 1;

        if not found then
          raise exception 'Segment add failed eligibility (tsfin_id=% segment_id=%)', v_tsfin_id, v_seg_id;
        end if;

        natural_start := (snap.week_ending_date::date - 6);

        -- Locate the segment object
        v_seg := null;
        for v_seg in
          select value from jsonb_array_elements(snap.invoice_breakdown_json->'segments') value
        loop
          if v_seg is null or jsonb_typeof(v_seg) <> 'object' then
            continue;
          end if;
          if nullif(btrim(coalesce(v_seg->>'segment_id','')), '') = v_seg_id then
            exit;
          end if;
          v_seg := null;
        end loop;

        if v_seg is null then
          raise exception 'Segment not found (tsfin_id=% segment_id=%)', v_tsfin_id, v_seg_id;
        end if;

        seg_locked := nullif(btrim(coalesce(v_seg->>'invoice_locked_invoice_id','')), '');
        if seg_locked is not null then
          raise exception 'Segment already invoiced (tsfin_id=% segment_id=%)', v_tsfin_id, v_seg_id;
        end if;

        seg_target := nullif(btrim(coalesce(v_seg->>'invoice_target_week_start','')), '')::date;
        seg_ref := btrim(coalesce(v_seg->>'ref_num',''));

        -- segment-level ref gating if required
        select * into pc from public.v_ts_invoice_precheck where timesheet_id = snap.timesheet_id limit 1;
        if pc.require_reference_to_invoice is true and seg_ref = '' then
          raise exception 'Segment missing reference number (timesheet_id=% segment_id=%)', snap.timesheet_id, v_seg_id;
        end if;

        -- Week eligibility
        if seg_target is null or seg_target = natural_start then
          if v_week_start <> natural_start then
            raise exception 'Segment not eligible for this invoice week (timesheet_id=% segment_id=%)', snap.timesheet_id, v_seg_id;
          end if;
        else
          if v_week_start <> seg_target then
            raise exception 'Delayed segment not eligible for this invoice week (timesheet_id=% segment_id=%)', snap.timesheet_id, v_seg_id;
          end if;
          if seg_target > v_anchor_ymd then
            raise exception 'Delayed segment cannot be invoiced early (timesheet_id=% segment_id=%)', snap.timesheet_id, v_seg_id;
          end if;
        end if;

        v_seg_refs_to_lock := v_seg_refs_to_lock || jsonb_build_array(
          jsonb_build_object(
            'tsfin_id', v_tsfin_id::text,
            'segment_id', v_seg_id
          )
        );
      end loop;

      if jsonb_typeof(v_seg_refs_to_lock) = 'array' and jsonb_array_length(v_seg_refs_to_lock) > 0 then
        perform public._inv_lock_segments_for_invoice(p_invoice_id, v_seg_refs_to_lock);
      end if;
    end if;

      -- Apply remove_segment_refs (unlock selected segments on THIS invoice)
    if v_remove_seg_refs is not null and jsonb_typeof(v_remove_seg_refs)='array' and jsonb_array_length(v_remove_seg_refs) > 0 then
      perform public._inv_unlock_segment_refs_for_invoice(p_invoice_id, v_remove_seg_refs::jsonb, p_actor_user_id);
    end if;



    -- History: segment ops (always)
    if v_add_seg_refs is not null and jsonb_typeof(v_add_seg_refs)='array' and jsonb_array_length(v_add_seg_refs) > 0 then
      perform public._audit_insert(
        'invoices',
        p_invoice_id::text,
        'INVOICE_SEGMENTS_ADDED',
        null,
        jsonb_build_object('add_segment_refs', v_add_seg_refs),
        null,
        p_actor_user_id
      );
    end if;
    if v_remove_seg_refs is not null and jsonb_typeof(v_remove_seg_refs)='array' and jsonb_array_length(v_remove_seg_refs) > 0 then
      perform public._audit_insert(
        'invoices',
        p_invoice_id::text,
        'INVOICE_SEGMENTS_REMOVED',
        null,
        jsonb_build_object('remove_segment_refs', v_remove_seg_refs),
        null,
        p_actor_user_id
      );
    end if;

    -- Rebuild HOURS lines for touched timesheets on this invoice
    select array_agg(distinct tf.timesheet_id)
    into v_seg_ts_ids
    from public.timesheets_financials tf
    where tf.id = any(v_seg_tsfin_ids);

    v_seg_ts_ids := coalesce(v_seg_ts_ids, array[]::uuid[]);

    foreach tsid in array v_seg_ts_ids loop
      if tsid is null then
        continue;
      end if;

      -- Load snapshot + timesheet + contract (no READY_FOR_INVOICE restriction; this is an invoice edit)
      select
        tf.*,
        tsr.booking_id,
        tsr.week_ending_date,
        tsr.reference_number,
        tsr.sheet_scope::text as sheet_scope,
        coalesce(tsr.submission_mode::text,'') as submission_mode,
        tsr.day_references_json,
        tsr.actual_schedule_json,
        cw.contract_id
      into snap
      from public.timesheets_financials tf
      join public.timesheets tsr on tsr.timesheet_id = tf.timesheet_id and tsr.is_current = true
      left join public.contract_weeks cw on cw.timesheet_id = tf.timesheet_id
      where tf.timesheet_id = tsid
        and tf.is_current = true
      limit 1;

      if not found then
        v_dbg_add_timesheets_skipped := v_dbg_add_timesheets_skipped + 1;
        if v_invoice_debug then
          v_dbg_steps := v_dbg_steps || jsonb_build_array(jsonb_build_object('step','add_timesheet_skipped','timesheet_id',tsid::text));
        end if;
        continue;
      end if;

      v_dbg_add_timesheets_found := v_dbg_add_timesheets_found + 1;
      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(jsonb_build_object('step','add_timesheet_loaded','timesheet_id',tsid::text,'tsfin_id',snap.id::text));
      end if;

      select v.r2_key
      into v_exact_timesheet_document_r2_key
      from public.timesheets t
      join public.invoice_document_versions v
        on v.entity_type='TIMESHEET'
       and v.entity_id=t.timesheet_id
       and v.purpose='TIMESHEET'
       and v.source_revision=t.document_revision::text
       and v.status='READY'
       and nullif(v.r2_key,'') is not null
       and nullif(v.sha256,'') is not null
       and coalesce(v.size_bytes,0)>0
       and coalesce(v.page_count,0)>0
      where t.timesheet_id=tsid and t.is_current
      order by v.ready_at_utc desc nulls last,v.id desc
      limit 1;


      contract_id := snap.contract_id;
      c_daily_calc := false;
      c_bucket_labels := null;
      c_display_site := null;

      if contract_id is not null then
        select
          nullif(btrim(coalesce(display_site,'')), '')
        into
          c_display_site
        from public.contracts
        where id = contract_id
        limit 1;
      end if;

      v_settings_authority := private._timesheet_settings_authority_frozen_v1(tsid);
      c_daily_calc := coalesce(
        (v_settings_authority#>>'{values,daily_calc_of_invoices}')::boolean,
        false
      );
      c_bucket_labels := case
        when coalesce((v_settings_authority->>'override_client_settings')::boolean,false)
          then v_settings_authority#>'{values,bucket_labels_json}'
        else null
      end;

      if c_bucket_labels is null then
        c_bucket_labels := jsonb_build_object('day','Day','night','Night','sat','Sat','sun','Sun','bh','BH');
      end if;

      -- Build segment set locked to THIS invoice
      segments := '[]'::jsonb;
      if snap.invoice_breakdown_json is not null
         and jsonb_typeof(snap.invoice_breakdown_json)='object'
         and coalesce(snap.invoice_breakdown_json->>'mode','')='SEGMENTS'
         and jsonb_typeof(snap.invoice_breakdown_json->'segments')='array'
      then
        for v_seg in
          select value from jsonb_array_elements(snap.invoice_breakdown_json->'segments') value
        loop
          if v_seg is null or jsonb_typeof(v_seg) <> 'object' then
            continue;
          end if;

          seg_locked := nullif(btrim(coalesce(v_seg->>'invoice_locked_invoice_id','')), '');
          if seg_locked = p_invoice_id::text then
            segments := segments || jsonb_build_array(v_seg);
          end if;
        end loop;
      end if;

      if jsonb_array_length(coalesce(segments,'[]'::jsonb)) = 0 then
        -- If no segments remain on this invoice for this timesheet, remove ALL invoice lines for that timesheet
        delete from public.invoice_lines
        where invoice_id = p_invoice_id
          and timesheet_id = tsid;
        v_dbg_seg_timesheets_removed := v_dbg_seg_timesheets_removed + 1;
        continue;
      end if;

      v_dbg_seg_timesheets_rebuilt := v_dbg_seg_timesheets_rebuilt + 1;

      -- Replace HOURS lines for this timesheet on this invoice
      delete from public.invoice_lines
      where invoice_id = p_invoice_id
        and timesheet_id = tsid
        and upper(coalesce(meta_json->>'line_type','')) in ('HOURS_WEEKLY','HOURS_DAILY');
        -- HOURS lines
        if c_daily_calc then
          -- Daily: group by segment.date
          for r_day in
            with rows as (
              select
                nullif(btrim(coalesce(seg_el->>'date','')), '') as ymd,
                coalesce((seg_el->>'hours_day')::numeric,0)   as h_day,
                coalesce((seg_el->>'hours_night')::numeric,0) as h_night,
                coalesce((seg_el->>'hours_sat')::numeric,0)   as h_sat,
                coalesce((seg_el->>'hours_sun')::numeric,0)   as h_sun,
                coalesce((seg_el->>'hours_bh')::numeric,0)    as h_bh,
                coalesce((seg_el->>'pay_amount')::numeric,0)  as pay_ex,
                coalesce((seg_el->>'charge_amount')::numeric,0) as chg_ex
              from jsonb_array_elements(segments) seg_el
            ),
            agg as (
              select
                ymd,
                sum(rows.h_day)::numeric as hours_day,
                sum(rows.h_night)::numeric as hours_night,
                sum(rows.h_sat)::numeric as hours_sat,
                sum(rows.h_sun)::numeric as hours_sun,
                sum(rows.h_bh)::numeric as hours_bh,
                sum(rows.pay_ex)::numeric as pay_ex,
                sum(rows.chg_ex)::numeric as chg_ex
              from rows
              where ymd is not null and ymd ~ '^\d{4}-\d{2}-\d{2}$'
              group by ymd
            )
            select * from agg order by ymd
          loop
          chg_ex := public._inv_round2(r_day.chg_ex);
if chg_ex = 0 then continue; end if;

if (coalesce(r_day.hours_day,0)+coalesce(r_day.hours_night,0)+coalesce(r_day.hours_sat,0)+coalesce(r_day.hours_sun,0)+coalesce(r_day.hours_bh,0)) = 0 then
  continue;
end if;


            pay_ex := public._inv_round2(r_day.pay_ex);
            margin_ex := public._inv_round2(chg_ex - pay_ex);
            vat_amt := public._inv_round2(chg_ex * v_vat_rate / 100);
            inc_amt := public._inv_round2(chg_ex + vat_amt);

            line_desc := coalesce(nullif(btrim(coalesce(c_display_site,'')) ,''), ('TS '||tsid::text)) ||
                         ' – '|| r_day.ymd || ' – W/E '|| coalesce(snap.week_ending_date::text,'');

            v_meta := jsonb_build_object(
              'line_type','HOURS_DAILY',
              'timesheet_id', tsid::text,
              'tsfin_id', snap.id::text,
              'candidate_display', coalesce(nullif(btrim(coalesce(c_display_site,'')),''), null),
              'role', c_role,
              'hospital', c_display_site,
              'ward', c_ward_hint,
              'week_ending_date', snap.week_ending_date::text,
              'date', r_day.ymd,
              'bucket_labels', c_bucket_labels
            );

            v_source_key := 'TS:' || tsid::text || ':HOURS:' || r_day.ymd;

            insert into public.invoice_lines(
              invoice_id, timesheet_id, booking_id, description,
              hours_day, hours_night, hours_sat, hours_sun, hours_bh,
              pay_day, pay_night, pay_sat, pay_sun, pay_bh,
              charge_day, charge_night, charge_sat, charge_sun, charge_bh,
              total_pay_ex_vat, total_charge_ex_vat, margin_ex_vat,
              vat_rate_pct, vat_amount, total_inc_vat,
              paper_ts_r2_key, meta_json, source_key
            )
            values (
              p_invoice_id, tsid, snap.booking_id, line_desc,
              public._inv_round2(r_day.hours_day), public._inv_round2(r_day.hours_night), public._inv_round2(r_day.hours_sat), public._inv_round2(r_day.hours_sun), public._inv_round2(r_day.hours_bh),
              null,null,null,null,null,
              null,null,null,null,null,
              pay_ex, chg_ex, margin_ex,
              v_vat_rate, vat_amt, inc_amt,
              v_exact_timesheet_document_r2_key,
              v_meta,
              v_source_key
            )
            on conflict (invoice_id, source_key) do nothing;
          end loop;
        else
          -- Weekly hours line
          select
            public._inv_round2(coalesce(sum((seg_el->>'hours_day')::numeric),0)),
            public._inv_round2(coalesce(sum((seg_el->>'hours_night')::numeric),0)),
            public._inv_round2(coalesce(sum((seg_el->>'hours_sat')::numeric),0)),
            public._inv_round2(coalesce(sum((seg_el->>'hours_sun')::numeric),0)),
            public._inv_round2(coalesce(sum((seg_el->>'hours_bh')::numeric),0)),
            public._inv_round2(coalesce(sum((seg_el->>'pay_amount')::numeric),0)),
            public._inv_round2(coalesce(sum((seg_el->>'charge_amount')::numeric),0))
          into h_day, h_night, h_sat, h_sun, h_bh, pay_ex, chg_ex
          from jsonb_array_elements(segments) seg_el;

       if chg_ex <> 0 and (coalesce(h_day,0)+coalesce(h_night,0)+coalesce(h_sat,0)+coalesce(h_sun,0)+coalesce(h_bh,0)) <> 0 then
  margin_ex := public._inv_round2(chg_ex - pay_ex);
  vat_amt := public._inv_round2(chg_ex * v_vat_rate / 100);
  inc_amt := public._inv_round2(chg_ex + vat_amt);

  line_desc := coalesce(nullif(btrim(coalesce(c_display_site,'')) ,''), ('TS '||tsid::text)) ||
               ' – W/E '|| coalesce(snap.week_ending_date::text,'');

  v_meta := jsonb_build_object(
    'line_type','HOURS_WEEKLY',
    'timesheet_id', tsid::text,
    'tsfin_id', snap.id::text,
    'week_ending_date', snap.week_ending_date::text,
    'bucket_labels', c_bucket_labels
  );

  v_source_key := 'TS:' || tsid::text || ':HOURS:WEEK';

  insert into public.invoice_lines(
    invoice_id, timesheet_id, booking_id, description,
    hours_day, hours_night, hours_sat, hours_sun, hours_bh,
    pay_day, pay_night, pay_sat, pay_sun, pay_bh,
    charge_day, charge_night, charge_sat, charge_sun, charge_bh,
    total_pay_ex_vat, total_charge_ex_vat, margin_ex_vat,
    vat_rate_pct, vat_amount, total_inc_vat,
    paper_ts_r2_key, meta_json, source_key
  )
  values (
    p_invoice_id, tsid, snap.booking_id, line_desc,
    h_day, h_night, h_sat, h_sun, h_bh,
    null,null,null,null,null,
    null,null,null,null,null,
    pay_ex, chg_ex, margin_ex,
    v_vat_rate, vat_amt, inc_amt,
    v_exact_timesheet_document_r2_key,
    v_meta,
    v_source_key
  )
  on conflict (invoice_id, source_key) do nothing;
end if;

        end if;

        -- Additional rates


    end loop;
  end if;
end if;

  -- 2) Add adjustments
  if p_payload is not null and jsonb_typeof(p_payload) = 'object' and (p_payload ? 'add_adjustments') then
    if jsonb_typeof(p_payload->'add_adjustments') = 'array' then
      for adj in
        select value from jsonb_array_elements(p_payload->'add_adjustments') value
      loop
        if adj is null or jsonb_typeof(adj) <> 'object' then
          continue;
        end if;

        v_adj_token := nullif(btrim(coalesce(adj->>'client_token','')), '');
        v_adj_desc  := nullif(btrim(coalesce(adj->>'description','')), '');
        begin
          v_adj_ex := (adj->>'amount_ex_vat')::numeric;
        exception when others then
          v_adj_ex := null;
        end;

        if v_adj_token is null or v_adj_desc is null or v_adj_ex is null then
          continue;
        end if;

        v_adj_vat := public._inv_round2(v_adj_ex * v_vat_rate / 100);
        if v_vat_rate = 0 then v_adj_vat := 0; end if;
        v_adj_inc := public._inv_round2(v_adj_ex + v_adj_vat);

        v_adj_source_key := 'ADJ:' || v_adj_token;

        v_meta := jsonb_build_object(
          'line_type','ADJUSTMENT',
          'client_token', v_adj_token,
          'description', v_adj_desc,
          'amount_ex_vat', public._inv_round2(v_adj_ex),
          'vat_rate_pct', v_vat_rate,
          'vat_chargeable', v_vat_chargeable
        );

        v_hist_adj := v_hist_adj || jsonb_build_array(v_meta);

        insert into public.invoice_lines(
          invoice_id, timesheet_id, booking_id, description,
          hours_day, hours_night, hours_sat, hours_sun, hours_bh,
          pay_day, pay_night, pay_sat, pay_sun, pay_bh,
          charge_day, charge_night, charge_sat, charge_sun, charge_bh,
          total_pay_ex_vat, total_charge_ex_vat, margin_ex_vat,
          vat_rate_pct, vat_amount, total_inc_vat,
          paper_ts_r2_key, meta_json, source_key
        )
        values (
          p_invoice_id, null, null, v_adj_desc,
          0,0,0,0,0,
          null,null,null,null,null,
          null,null,null,null,null,
          0, public._inv_round2(v_adj_ex), public._inv_round2(v_adj_ex),
          v_vat_rate, v_adj_vat, v_adj_inc,
          null,
          v_meta,
          v_adj_source_key
        )
        on conflict (invoice_id, source_key) do nothing;
      end loop;
    end if;
  end if;

  -- History: adjustments added (always)
  if jsonb_typeof(v_hist_adj)='array' and jsonb_array_length(v_hist_adj) > 0 then
    perform public._audit_insert(
      'invoices',
      p_invoice_id::text,
      'INVOICE_ADJUSTMENTS_ADDED',
      null,
      jsonb_build_object('adjustments', v_hist_adj),
      null,
      p_actor_user_id
    );
  end if;


  -- 3) Add timesheets (full parity: hours + additional + expenses + mileage), for THIS invoice week_start
  if v_add_ts_ids is not null and coalesce(array_length(v_add_ts_ids,1),0) > 0 then
    foreach tsid in array v_add_ts_ids loop
      if tsid is null then
        continue;
      end if;

      -- Load snapshot + timesheet + precheck
      select
        tf.*,
        tsr.booking_id,
        tsr.week_ending_date,
        tsr.reference_number,
        tsr.sheet_scope::text as sheet_scope,
        coalesce(tsr.submission_mode::text,'') as submission_mode,
        tsr.day_references_json,
        tsr.actual_schedule_json,
        cw.contract_id
      into snap
      from public.timesheets_financials tf
      join public.timesheets tsr on tsr.timesheet_id = tf.timesheet_id and tsr.is_current = true
      left join public.contract_weeks cw on cw.timesheet_id = tf.timesheet_id
      join public.v_ts_invoice_precheck pcv on pcv.timesheet_id = tf.timesheet_id
      where tf.timesheet_id = tsid
        and tf.is_current = true
        and tf.locked_by_invoice_id is null
        and tf.processing_status = 'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum
        and upper(coalesce(pcv.precheck_status,''))
          in ('OK','BLOCK_NO_PDF')
        and tf.client_id = v_inv.client_id
        and (
          pcv.require_reference_to_invoice is not true
          or public._inv_timesheet_has_invoice_reference(
                tsr.sheet_scope::text,
                coalesce(tsr.submission_mode::text,''),
                tsr.reference_number,
                tsr.day_references_json,
                tsr.actual_schedule_json
             )
        )
      limit 1;

      if not found then
        v_dbg_add_timesheets_skipped := v_dbg_add_timesheets_skipped + 1;
        if v_invoice_debug then
          v_dbg_steps := v_dbg_steps || jsonb_build_array(jsonb_build_object('step','add_timesheet_skipped','timesheet_id',coalesce(tsid::text,'')));
        end if;
        continue;
      end if;

      v_dbg_add_timesheets_found := v_dbg_add_timesheets_found + 1;
      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(jsonb_build_object('step','add_timesheet_loaded','timesheet_id',coalesce(tsid::text,''),'tsfin_id',coalesce(snap.id::text,'')));
      end if;

      select v.r2_key
      into v_exact_timesheet_document_r2_key
      from public.timesheets t
      join public.invoice_document_versions v
        on v.entity_type='TIMESHEET'
       and v.entity_id=t.timesheet_id
       and v.purpose='TIMESHEET'
       and v.source_revision=t.document_revision::text
       and v.status='READY'
       and nullif(v.r2_key,'') is not null
       and nullif(v.sha256,'') is not null
       and coalesce(v.size_bytes,0)>0
       and coalesce(v.page_count,0)>0
      where t.timesheet_id=tsid and t.is_current
      order by v.ready_at_utc desc nulls last,v.id desc
      limit 1;
      contract_id := snap.contract_id;
      c_daily_calc := false;
      c_bucket_labels := null;
      c_role := null;
      c_display_site := null;
      c_ward_hint := null;

      if contract_id is not null then
        select
          nullif(btrim(coalesce(role,'')), ''),
          nullif(btrim(coalesce(display_site,'')), ''),
          nullif(btrim(coalesce(ward_hint,'')), '')
        into
          c_role, c_display_site, c_ward_hint
        from public.contracts
        where id = contract_id
        limit 1;
      end if;

      v_settings_authority := private._timesheet_settings_authority_frozen_v1(tsid);
      c_daily_calc := coalesce(
        (v_settings_authority#>>'{values,daily_calc_of_invoices}')::boolean,
        false
      );
      c_bucket_labels := case
        when coalesce((v_settings_authority->>'override_client_settings')::boolean,false)
          then v_settings_authority#>'{values,bucket_labels_json}'
        else null
      end;

      if c_bucket_labels is null then
        c_bucket_labels := jsonb_build_object('day','Day','night','Night','sat','Sat','sun','Sun','bh','BH');
      end if;

      natural_start := (snap.week_ending_date::date - 6);

      segments := '[]'::jsonb;

      -- Build invoiceable segment set for THIS invoice week_start
      if snap.invoice_breakdown_json is not null
         and jsonb_typeof(snap.invoice_breakdown_json)='object'
         and coalesce(snap.invoice_breakdown_json->>'mode','')='SEGMENTS'
         and jsonb_typeof(snap.invoice_breakdown_json->'segments')='array'
      then
        for v_seg in
          select value from jsonb_array_elements(snap.invoice_breakdown_json->'segments') value
        loop
          if v_seg is null or jsonb_typeof(v_seg) <> 'object' then
            continue;
          end if;

          seg_locked := nullif(btrim(coalesce(v_seg->>'invoice_locked_invoice_id','')), '');
          if seg_locked is not null then
            continue; -- already invoiced
          end if;

          seg_target := nullif(btrim(coalesce(v_seg->>'invoice_target_week_start','')), '')::date;
          seg_ref := btrim(coalesce(v_seg->>'ref_num',''));

          -- segment-level ref gating if required
          select * into pc from public.v_ts_invoice_precheck where timesheet_id = tsid limit 1;
          if pc.require_reference_to_invoice is true and seg_ref = '' then
            continue;
          end if;

          -- delayed detection
          if seg_target is null or seg_target = natural_start then
            -- not delayed: belongs to natural week only
            if v_week_start <> natural_start then
              continue;
            end if;
            -- allow early is implicit for invoice edits (invoice is already being edited)
            segments := segments || jsonb_build_array(v_seg);
          else
            -- delayed: only if this invoice week matches target AND target has arrived (no early invoicing for delayed)
            if v_week_start = seg_target and seg_target <= v_anchor_ymd then
              segments := segments || jsonb_build_array(v_seg);
            end if;
          end if;
        end loop;
      else
        -- Non-segments: include only when invoice week matches natural week
        if v_week_start = natural_start then
          segments := jsonb_build_array(
            jsonb_build_object(
              'segment_id', null,
              'date', coalesce(snap.week_ending_date::text, v_week_start::text),
              'hours_day', public._inv_round2(coalesce(snap.hours_day,0)),
              'hours_night', public._inv_round2(coalesce(snap.hours_night,0)),
              'hours_sat', public._inv_round2(coalesce(snap.hours_sat,0)),
              'hours_sun', public._inv_round2(coalesce(snap.hours_sun,0)),
              'hours_bh', public._inv_round2(coalesce(snap.hours_bh,0)),
              'pay_amount', public._inv_round2(
                coalesce(snap.total_pay_ex_vat,0)
                - coalesce(snap.additional_pay_ex_vat,0)
                - coalesce(snap.expenses_pay_ex_vat,0)
                - coalesce(snap.mileage_pay_ex_vat,0)
              ),
              'charge_amount', public._inv_round2(
                coalesce(snap.total_charge_ex_vat,0)
                - coalesce(snap.additional_charge_ex_vat,0)
                - coalesce(snap.expenses_charge_ex_vat,0)
                - coalesce(snap.mileage_charge_ex_vat,0)
              ),
              'ref_num', coalesce(snap.reference_number,'')
            )
          );
        end if;
      end if;

      if jsonb_array_length(coalesce(segments,'[]'::jsonb)) = 0 then
        continue;
      end if;

      -- Build the exact invoice-line economics from the frozen current financial snapshot.
      -- This mirrors Invoice Async V8 generation and never derives economics from mutable live rows.
      select p.vat_rate
      into v_vat_rate
      from private._invoice_generation_vat_policy_batch(jsonb_build_array(jsonb_build_object(
        'source_member_key','invoice-edit:'||tsid::text,
        'source_type','TIMESHEET',
        'source_id',tsid,
        'timesheet_id',tsid,
        'effective_date',snap.week_ending_date
      ))) p
      where p.source_member_key='invoice-edit:'||tsid::text
        and p.valid
        and p.vat_rate is not null
      limit 1;

      if not found then
        raise exception 'INVOICE_EDIT_VAT_POLICY_UNRESOLVED'
          using errcode='P0001',detail=jsonb_build_object(
            'invoice_id',p_invoice_id,'timesheet_id',tsid)::text;
      end if;

      insert into public.invoice_lines(
        invoice_id,timesheet_id,booking_id,description,
        hours_day,hours_night,hours_sat,hours_sun,hours_bh,
        pay_day,pay_night,pay_sat,pay_sun,pay_bh,
        charge_day,charge_night,charge_sat,charge_sun,charge_bh,
        total_pay_ex_vat,total_charge_ex_vat,margin_ex_vat,
        vat_rate_pct,vat_amount,total_inc_vat,
        paper_ts_r2_key,meta_json,source_key
      )
      with base as materialized (
        select coalesce(
          (select nullif(btrim(coalesce(cd.display_name,'')),'')
             from public.candidates cd where cd.id=snap.candidate_id limit 1),
          'TS '||tsid::text
        ) candidate_display
      ),
      segment_rows as materialized (
        select
          case when left(coalesce(s.value->>'date',''),10) ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
            then left(s.value->>'date',10) end work_date,
          case when pg_input_is_valid(s.value->>'hours_day','numeric') then (s.value->>'hours_day')::numeric else 0 end h_day,
          case when pg_input_is_valid(s.value->>'hours_night','numeric') then (s.value->>'hours_night')::numeric else 0 end h_night,
          case when pg_input_is_valid(s.value->>'hours_sat','numeric') then (s.value->>'hours_sat')::numeric else 0 end h_sat,
          case when pg_input_is_valid(s.value->>'hours_sun','numeric') then (s.value->>'hours_sun')::numeric else 0 end h_sun,
          case when pg_input_is_valid(s.value->>'hours_bh','numeric') then (s.value->>'hours_bh')::numeric else 0 end h_bh,
          case
            when pg_input_is_valid(s.value->>'pay_amount','numeric') then (s.value->>'pay_amount')::numeric
            when pg_input_is_valid(s.value->>'pay_ex_vat','numeric') then (s.value->>'pay_ex_vat')::numeric
            else 0 end pay_ex,
          case
            when pg_input_is_valid(s.value->>'charge_amount','numeric') then (s.value->>'charge_amount')::numeric
            when pg_input_is_valid(s.value->>'charge_ex_vat','numeric') then (s.value->>'charge_ex_vat')::numeric
            else 0 end charge_ex
        from jsonb_array_elements(segments) s(value)
      ),
      hour_daily as materialized (
        select s.work_date,sum(s.h_day) h_day,sum(s.h_night) h_night,sum(s.h_sat) h_sat,
          sum(s.h_sun) h_sun,sum(s.h_bh) h_bh,sum(s.pay_ex) pay_ex,sum(s.charge_ex) charge_ex
        from segment_rows s
        where c_daily_calc and s.work_date is not null
        group by s.work_date
      ),
      hour_weekly as materialized (
        select sum(s.h_day) h_day,sum(s.h_night) h_night,sum(s.h_sat) h_sat,
          sum(s.h_sun) h_sun,sum(s.h_bh) h_bh,sum(s.pay_ex) pay_ex,sum(s.charge_ex) charge_ex
        from segment_rows s
        having not c_daily_calc or not exists(select 1 from segment_rows d where d.work_date is not null)
      ),
      additional_source as materialized (
        select upper(a.key) code,a.value unit
        from jsonb_each(case when jsonb_typeof(snap.additional_units_json)='object'
          then snap.additional_units_json else '{}'::jsonb end) a
        where jsonb_typeof(a.value)='object' and btrim(a.key)<>''
      ),
      additional_daily as materialized (
        select a.code,left(d.key,10) work_date,
          case when pg_input_is_valid(d.value,'numeric') then d.value::numeric else 0 end units,
          case when pg_input_is_valid(a.unit->>'pay_rate','numeric') then (a.unit->>'pay_rate')::numeric else 0 end pay_rate,
          case when pg_input_is_valid(a.unit->>'charge_rate','numeric') then (a.unit->>'charge_rate')::numeric else 0 end charge_rate,
          coalesce(nullif(a.unit->>'bucket_name',''),a.code) bucket_name,
          coalesce(nullif(a.unit->>'unit_name',''),'units') unit_name,
          a.unit->'frequency' frequency
        from additional_source a
        cross join lateral jsonb_each_text(case when jsonb_typeof(a.unit->'days')='object'
          then a.unit->'days' else '{}'::jsonb end) d
        where c_daily_calc
          and left(d.key,10) ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
          and pg_input_is_valid(d.value,'numeric')
          and d.value::numeric<>0
          and exists(select 1 from segment_rows where work_date is not null)
      ),
      additional_weekly as materialized (
        select a.code,
          case when pg_input_is_valid(a.unit->>'unit_count','numeric') then (a.unit->>'unit_count')::numeric else 0 end units,
          case when pg_input_is_valid(a.unit->>'pay_rate','numeric') then (a.unit->>'pay_rate')::numeric else 0 end pay_rate,
          case when pg_input_is_valid(a.unit->>'charge_rate','numeric') then (a.unit->>'charge_rate')::numeric else 0 end charge_rate,
          case when pg_input_is_valid(a.unit->>'pay_ex_vat','numeric') then (a.unit->>'pay_ex_vat')::numeric else 0 end pay_ex,
          case when pg_input_is_valid(a.unit->>'charge_ex_vat','numeric') then (a.unit->>'charge_ex_vat')::numeric else 0 end charge_ex,
          coalesce(nullif(a.unit->>'bucket_name',''),a.code) bucket_name,
          coalesce(nullif(a.unit->>'unit_name',''),'units') unit_name,
          a.unit->'frequency' frequency
        from additional_source a
        where not(c_daily_calc
          and exists(select 1 from jsonb_each_text(case when jsonb_typeof(a.unit->'days')='object'
            then a.unit->'days' else '{}'::jsonb end) d
            where left(d.key,10) ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
              and pg_input_is_valid(d.value,'numeric') and d.value::numeric<>0))
          and (
            (case when pg_input_is_valid(a.unit->>'pay_ex_vat','numeric') then (a.unit->>'pay_ex_vat')::numeric else 0 end)<>0
            or (case when pg_input_is_valid(a.unit->>'charge_ex_vat','numeric') then (a.unit->>'charge_ex_vat')::numeric else 0 end)<>0
          )
      ),
      expense_lines as materialized (
        select e.code,e.pay_ex,e.charge_ex
        from (values
          ('TRAVEL',coalesce(snap.travel_pay_ex_vat,0),coalesce(snap.travel_charge_ex_vat,0)),
          ('ACCOMMODATION',coalesce(snap.accommodation_pay_ex_vat,0),coalesce(snap.accommodation_charge_ex_vat,0)),
          ('OTHER',coalesce(snap.other_pay_ex_vat,0),coalesce(snap.other_charge_ex_vat,0)),
          ('EXPENSES_FALLBACK',
            case when coalesce(snap.travel_pay_ex_vat,0)+coalesce(snap.accommodation_pay_ex_vat,0)+coalesce(snap.other_pay_ex_vat,0)=0
              then coalesce(snap.expenses_pay_ex_vat,0) else 0 end,
            case when coalesce(snap.travel_charge_ex_vat,0)+coalesce(snap.accommodation_charge_ex_vat,0)+coalesce(snap.other_charge_ex_vat,0)=0
              then coalesce(snap.expenses_charge_ex_vat,0) else 0 end),
          ('MILEAGE',coalesce(snap.mileage_pay_ex_vat,0),coalesce(snap.mileage_charge_ex_vat,0))
        ) e(code,pay_ex,charge_ex)
        where e.pay_ex<>0 or e.charge_ex<>0
      ),
      line_union as materialized (
        select b.candidate_display||' - '||h.work_date||' - W/E '||coalesce(snap.week_ending_date::text,'' ) description,
          h.h_day,h.h_night,h.h_sat,h.h_sun,h.h_bh,h.pay_ex,h.charge_ex,
          'HOURS_DAILY' line_type,'TS:'||tsid::text||':HOURS:'||h.work_date source_key,
          jsonb_build_object('date',h.work_date) detail
        from hour_daily h cross join base b
        union all
        select b.candidate_display||' - W/E '||coalesce(snap.week_ending_date::text,''),
          h.h_day,h.h_night,h.h_sat,h.h_sun,h.h_bh,h.pay_ex,h.charge_ex,
          'HOURS_WEEKLY','TS:'||tsid::text||':HOURS:WEEK','{}'::jsonb
        from hour_weekly h cross join base b
        union all
        select b.candidate_display||' - '||a.bucket_name||' - '||a.work_date||' - '||a.units||' '||a.unit_name,
          0,0,0,0,0,round(a.units*a.pay_rate,2),round(a.units*a.charge_rate,2),
          'ADDITIONAL_RATE_DAILY','TS:'||tsid::text||':ADD:'||a.code||':'||a.work_date,
          jsonb_build_object('date',a.work_date,'bucket',jsonb_build_object(
            'code',a.code,'bucket_name',a.bucket_name,'unit_name',a.unit_name,'frequency',a.frequency),
            'units',jsonb_build_object('unit_count',a.units,'pay_rate',a.pay_rate,'charge_rate',a.charge_rate))
        from additional_daily a cross join base b
        union all
        select b.candidate_display||' - '||a.bucket_name||' - '||a.units||' '||a.unit_name,
          0,0,0,0,0,a.pay_ex,a.charge_ex,
          'ADDITIONAL_RATE','TS:'||tsid::text||':ADD:'||a.code||':WEEK',
          jsonb_build_object('bucket',jsonb_build_object(
            'code',a.code,'bucket_name',a.bucket_name,'unit_name',a.unit_name,'frequency',a.frequency),
            'units',jsonb_build_object('unit_count',a.units,'pay_rate',a.pay_rate,'charge_rate',a.charge_rate))
        from additional_weekly a cross join base b
        union all
        select case when e.code='MILEAGE' then 'Mileage - '||coalesce(snap.mileage_units,0)||' miles (W/E '||coalesce(snap.week_ending_date::text,'')||')'
          when e.code='EXPENSES_FALLBACK' then 'Expenses (W/E '||coalesce(snap.week_ending_date::text,'')||')'
          else initcap(replace(e.code,'_',' '))||' expenses (W/E '||coalesce(snap.week_ending_date::text,'')||')' end,
          0,0,0,0,0,e.pay_ex,e.charge_ex,
          case when e.code='MILEAGE' then 'MILEAGE'
            when e.code='EXPENSES_FALLBACK' then 'EXPENSES_TOTAL'
            else 'EXPENSE_'||e.code end,
          case when e.code='MILEAGE' then 'TS:'||tsid::text||':MILEAGE'
            when e.code='EXPENSES_FALLBACK' then 'TS:'||tsid::text||':EXP:TOTAL'
            else 'TS:'||tsid::text||':EXP:'||e.code end,
          jsonb_build_object('expense',case when e.code='MILEAGE' then jsonb_build_object(
            'category','MILEAGE','mileage_units',snap.mileage_units,
            'pay_rate',snap.mileage_pay_rate,'charge_rate',snap.mileage_charge_rate,
            'evidence_r2_key',snap.mileage_evidence_r2_key,'evidence_manifest',snap.mileage_evidence_manifest)
            else jsonb_build_object('category',e.code,'note',snap.expenses_description,
              'evidence_r2_key',snap.expenses_evidence_r2_key,'evidence_manifest',snap.expenses_evidence_manifest) end)
        from expense_lines e
      )
      select p_invoice_id,tsid,snap.booking_id,l.description,
        round(l.h_day,2),round(l.h_night,2),round(l.h_sat,2),round(l.h_sun,2),round(l.h_bh,2),
        null,null,null,null,null,
        snap.charge_day,snap.charge_night,snap.charge_sat,snap.charge_sun,snap.charge_bh,
        round(l.pay_ex,2),round(l.charge_ex,2),round(l.charge_ex-l.pay_ex,2),v_vat_rate,
        round(l.charge_ex*v_vat_rate/100,2),round(l.charge_ex+(l.charge_ex*v_vat_rate/100),2),
        v_exact_timesheet_document_r2_key,
        jsonb_build_object('line_type',l.line_type,'timesheet_id',tsid,'tsfin_id',snap.id,
          'candidate_display',l.description,'week_ending_date',snap.week_ending_date,
          'role',c_role,'hospital',c_display_site,'ward',c_ward_hint,'bucket_labels',c_bucket_labels,
          'totals',jsonb_build_object('line_pay_ex_vat',round(l.pay_ex,2),
            'line_charge_ex_vat',round(l.charge_ex,2),'margin_ex_vat',round(l.charge_ex-l.pay_ex,2),
            'vat_rate_pct',v_vat_rate,'vat_amount',round(l.charge_ex*v_vat_rate/100,2),
            'total_inc_vat',round(l.charge_ex+(l.charge_ex*v_vat_rate/100),2)))||l.detail,
        l.source_key
      from line_union l
      on conflict(invoice_id,source_key) do nothing;
      -- Build segment refs to lock
      if snap.invoice_breakdown_json is not null
         and jsonb_typeof(snap.invoice_breakdown_json)='object'
         and coalesce(snap.invoice_breakdown_json->>'mode','')='SEGMENTS'
      then
        for v_seg in
          select value from jsonb_array_elements(segments) value
        loop
          if v_seg is null or jsonb_typeof(v_seg) <> 'object' then
            continue;
          end if;

          seg_refs := seg_refs || jsonb_build_array(
            jsonb_build_object(
              'tsfin_id', snap.id::text,
              'segment_id', nullif(btrim(coalesce(v_seg->>'segment_id','')), '')
            )
          );
        end loop;
      else
        -- lock whole for non-segments
        seg_refs := seg_refs || jsonb_build_array(
          jsonb_build_object('tsfin_id', snap.id::text, 'segment_id', null)
        );
      end if;
    end loop;

    -- Apply segment locks for the exact selected source rows.
    if jsonb_typeof(seg_refs) = 'array' and jsonb_array_length(seg_refs) > 0 then
      perform public._inv_lock_segments_for_invoice(p_invoice_id, seg_refs);
    end if;

    -- History: timesheets added (always; includes requested ids)
    perform public._audit_insert(
      'invoices',
      p_invoice_id::text,
      'INVOICE_TIMESHEETS_ADDED',
      null,
      jsonb_build_object('add_timesheet_ids', coalesce(to_jsonb(v_add_ts_ids), '[]'::jsonb)),
      null,
      p_actor_user_id
    );
  end if;

  -- 3c) Contract week status: set INVOICED only when timesheet is FULLY invoiced (segment-aware), and revert INVOICED -> AUTHORISED if no longer fully invoiced.
  -- Touch set = union of: add_timesheet_ids, line-removal touched (hours), segment-op touched.
  v_cw_ts_ids := array[]::uuid[];
  if v_add_ts_ids is not null and coalesce(array_length(v_add_ts_ids,1),0) > 0 then
    v_cw_ts_ids := v_cw_ts_ids || v_add_ts_ids;
  end if;
  if v_ts_ids_touched is not null and coalesce(array_length(v_ts_ids_touched,1),0) > 0 then
    v_cw_ts_ids := v_cw_ts_ids || v_ts_ids_touched;
  end if;
  if v_seg_ts_ids is not null and coalesce(array_length(v_seg_ts_ids,1),0) > 0 then
    v_cw_ts_ids := v_cw_ts_ids || v_seg_ts_ids;
  end if;

  -- de-dup
  select array_agg(distinct x)
  into v_cw_ts_ids
  from unnest(coalesce(v_cw_ts_ids, array[]::uuid[])) x
  where x is not null;

  v_cw_ts_ids := coalesce(v_cw_ts_ids, array[]::uuid[]);

  if coalesce(array_length(v_cw_ts_ids,1),0) > 0 then
    with src as (
      select
        cw.timesheet_id,
        cw.status as cw_status,
        tf.locked_by_invoice_id,
        tf.invoice_breakdown_json,
        (
          case
            when tf.invoice_breakdown_json is not null
             and jsonb_typeof(tf.invoice_breakdown_json)='object'
             and coalesce(tf.invoice_breakdown_json->>'mode','')='SEGMENTS'
             and jsonb_typeof(tf.invoice_breakdown_json->'segments')='array'
             and jsonb_array_length(tf.invoice_breakdown_json->'segments') > 0
            then
              not exists (
                select 1
                from jsonb_array_elements(tf.invoice_breakdown_json->'segments') s(seg)
                where nullif(btrim(coalesce(s.seg->>'invoice_locked_invoice_id','')), '') is null
              )
            else
              (tf.locked_by_invoice_id is not null)
          end
        ) as fully_invoiced
      from public.contract_weeks cw
      join public.timesheets_financials tf
        on tf.is_current = true
       and tf.timesheet_id = cw.timesheet_id
      where cw.timesheet_id = any(v_cw_ts_ids)
    )
    update public.contract_weeks cw
    set status = case
      when src.fully_invoiced then 'INVOICED'::public.contract_week_status_enum
      when cw.status = 'INVOICED'::public.contract_week_status_enum then 'AUTHORISED'::public.contract_week_status_enum
      else cw.status
    end
    from src
    where cw.timesheet_id = src.timesheet_id;
  end if;


  -- 4) Recompute invoice totals from invoice_lines and clear PDF key
  select
    public._inv_round2(coalesce(sum(coalesce(l.total_charge_ex_vat,0)),0)),
    public._inv_round2(coalesce(sum(coalesce(l.vat_amount,0)),0)),
    public._inv_round2(coalesce(sum(coalesce(l.total_inc_vat,0)),0))
  into v_new_ex, v_new_vat, v_new_inc
  from public.invoice_lines l
  where l.invoice_id = p_invoice_id;


  perform public.invoice_recompute_totals(p_invoice_id);

  -- Recompute header_snapshot_json.meta counters to avoid stale values after edits
  select count(distinct l.timesheet_id)
  into v_hdr_ts_count_lines
  from public.invoice_lines l
  where l.invoice_id = p_invoice_id
    and l.timesheet_id is not null;

  select count(*)
  into v_hdr_seg_locked_count
  from public.timesheets_financials tf
  cross join lateral jsonb_array_elements(coalesce(tf.invoice_breakdown_json->'segments','[]'::jsonb)) as seg(seg_obj)
  where tf.is_current = true
    and coalesce(seg.seg_obj->>'invoice_locked_invoice_id','') = p_invoice_id::text;

  select count(distinct tf.timesheet_id)
  into v_hdr_ts_count_seglocks
  from public.timesheets_financials tf
  where tf.is_current = true
    and exists (
      select 1
      from jsonb_array_elements(coalesce(tf.invoice_breakdown_json->'segments','[]'::jsonb)) as seg(seg_obj)
      where coalesce(seg.seg_obj->>'invoice_locked_invoice_id','') = p_invoice_id::text
    );

  if coalesce(v_hdr_seg_locked_count,0) > 0 then
    v_hdr_meta_timesheet_count := coalesce(v_hdr_ts_count_seglocks,0);
    v_hdr_meta_segment_count := coalesce(v_hdr_seg_locked_count,0);
  else
    v_hdr_meta_timesheet_count := coalesce(v_hdr_ts_count_lines,0);
    v_hdr_meta_segment_count := coalesce(v_hdr_meta_timesheet_count,0);
  end if;

  -- The statement triggers are the sole document/issue invalidation authority.
  -- This update changes only the authoritative business snapshot counters.
  update public.invoices invu
  set header_snapshot_json=jsonb_set(jsonb_set(coalesce(invu.header_snapshot_json,'{}'::jsonb),
      '{meta,timesheet_count}',to_jsonb(v_hdr_meta_timesheet_count),true),
      '{meta,segment_count}',to_jsonb(v_hdr_meta_segment_count),true),
    updated_at=now()
  where invu.id=p_invoice_id;

-- Refresh invoice-level NHSP/HR cache after timesheet/segment changes
  if coalesce(v_refresh_hr_cache,false) = true then
    perform 1
    from public.invoice_source_rows_collect(p_invoice_id, true) sr
    limit 1;
  end if;

  -- Revalidate ownership after every line and segment move in this Save. A
  -- source edit must not queue work for a source that was detached later in the
  -- same transaction, and every edited SEGMENTS identity must still be locked
  -- to this exact invoice.
  if cardinality(v_source_changed_ts_ids)>0 and exists(
    select 1
    from jsonb_each(v_source_updates_map) desired
    where (desired.value->>'timesheet_id')::uuid=any(v_source_changed_ts_ids)
      and not exists(
        select 1 from public.invoice_lines carrier
        where carrier.invoice_id=p_invoice_id
          and (
            carrier.timesheet_id=(desired.value->>'timesheet_id')::uuid
            or (
              carrier.timesheet_id is null
              and coalesce(carrier.meta_json->>'timesheet_id','')~
                '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
              and (carrier.meta_json->>'timesheet_id')::uuid=
                (desired.value->>'timesheet_id')::uuid
            )
          )
      )
      and not exists(
        select 1
        from public.timesheets_financials tf
        cross join lateral jsonb_array_elements(
          coalesce(tf.invoice_breakdown_json->'segments','[]'::jsonb)) seg(value)
        where tf.timesheet_id=(desired.value->>'timesheet_id')::uuid
          and tf.is_current
          and nullif(btrim(coalesce(
            seg.value->>'invoice_locked_invoice_id','')),'')=p_invoice_id::text
      )
  ) then
    raise exception using errcode='22023',
      message='INVOICE_SOURCE_EDIT_CONFLICTING_COMMAND',
      detail=jsonb_build_object('reason','POST_EDIT_SOURCE_DETACHED')::text;
  end if;

  if cardinality(v_source_changed_ts_ids)>0 and exists(
    select 1
    from jsonb_each(v_source_updates_map) desired
    cross join lateral jsonb_array_elements(
      coalesce(desired.value->'segment_updates','[]'::jsonb)) requested(value)
    where desired.value->>'source_mode'='SEGMENTS'
      and not exists(
        select 1
        from public.timesheets_financials tf
        cross join lateral jsonb_array_elements(
          coalesce(tf.invoice_breakdown_json->'segments','[]'::jsonb)) seg(value)
        where tf.id=(desired.value->>'financial_id')::uuid
          and tf.is_current
          and tf.timesheet_id=(desired.value->>'timesheet_id')::uuid
          and nullif(btrim(coalesce(
            seg.value->>'invoice_locked_invoice_id','')),'')=p_invoice_id::text
          and (
            (
              nullif(requested.value->>'segment_id','') is not null
              and nullif(btrim(coalesce(seg.value->>'segment_id','')),'')
                =nullif(requested.value->>'segment_id','')
            ) or (
              nullif(requested.value->>'segment_id','') is null
              and coalesce(seg.value->>'start_utc',seg.value->>'start')
                is not distinct from requested.value->>'start_identity'
              and coalesce(seg.value->>'end_utc',seg.value->>'end')
                is not distinct from requested.value->>'end_identity'
            )
          )
      )
  ) then
    raise exception using errcode='22023',
      message='INVOICE_SOURCE_EDIT_CONFLICTING_COMMAND',
      detail=jsonb_build_object('reason','POST_EDIT_SEGMENT_DETACHED')::text;
  end if;

  -- A material source edit always starts or reuses the exact replacement
  -- timesheet work. Replacement of an existing invoice preview is derived from
  -- the locked pre-edit V8 state; browser flags cannot suppress it.
  if cardinality(v_source_changed_ts_ids)>0 then
    select coalesce(jsonb_agg(jsonb_build_object(
      'command_type','VIEW_TIMESHEET_DOCUMENT',
      'timesheet_id',changed_id,
      'purpose','TIMESHEET',
      'priority_reason','SOURCE_EDIT_REPLACEMENT',
      'template_version','timesheet-professional-v2')
      order by changed_id),'[]'::jsonb)
    into v_document_commands
    from unnest(v_source_changed_ts_ids) changed_id;

    v_source_edit_invoice_replacement_required:=
      v_source_edit_preexisting_preview
      or lower(coalesce(p_payload->>'request_preview','false'))
           in('true','1','yes','on');
    if v_source_edit_invoice_replacement_required then
      v_document_commands:=v_document_commands||jsonb_build_array(
        jsonb_build_object(
          'command_type','VIEW_INVOICE_DOCUMENT',
          'invoice_id',p_invoice_id,
          'purpose','DRAFT_PREVIEW',
          'priority_reason',case when v_source_edit_preexisting_preview
            then 'SOURCE_EDIT_REPLACEMENT' else 'VIEW_NOW' end,
          'template_version','invoice-professional-v2'));
    end if;

    v_expected_command_count:=jsonb_array_length(v_document_commands);
    if v_expected_command_count>1000 then
      raise exception using errcode='22023',
        message='INVOICE_SOURCE_EDIT_TOO_MANY_REPLACEMENTS';
    end if;

    v_started_operations:=public.invoice_operation_start_batch(
      v_document_commands,p_actor_user_id,v_now);

    if jsonb_typeof(v_started_operations)<>'array'
       or jsonb_array_length(v_started_operations)<>v_expected_command_count then
      raise exception using errcode='55000',
        message='SOURCE_EDIT_REPLACEMENT_RESULT_INVALID',
        detail=jsonb_build_object(
          'reason','RESULT_COUNT',
          'expected',v_expected_command_count,
          'actual',case when jsonb_typeof(v_started_operations)='array'
            then jsonb_array_length(v_started_operations) else null end)::text;
    end if;

    for v_command_no in 1..v_expected_command_count loop
      select value into v_operation_result
      from jsonb_array_elements(v_started_operations) value
      where coalesce(value->>'command_no','')~'^[1-9][0-9]*$'
        and (value->>'command_no')::int=v_command_no;

      if not found or (
        select count(*)
        from jsonb_array_elements(v_started_operations) value
        where coalesce(value->>'command_no','')~'^[1-9][0-9]*$'
          and (value->>'command_no')::int=v_command_no
      )<>1 then
        raise exception using errcode='55000',
          message='SOURCE_EDIT_REPLACEMENT_RESULT_INVALID',
          detail=jsonb_build_object('reason','COMMAND_NO','command_no',v_command_no)::text;
      end if;

      v_source_update:=v_document_commands->(v_command_no-1);
      v_command_type:=v_source_update->>'command_type';
      if v_operation_result->>'command_type' is distinct from v_command_type
         or lower(coalesce(v_operation_result->>'accepted','false'))
              not in('true','1','yes','on')
         or lower(coalesce(v_operation_result->>'blocked','false'))
              in('true','1','yes','on') then
        raise exception using errcode='55000',
          message=case
            when lower(coalesce(v_operation_result->>'blocked','false'))
                   in('true','1','yes','on')
              then 'SOURCE_EDIT_REPLACEMENT_BLOCKED'
            else 'SOURCE_EDIT_REPLACEMENT_REJECTED' end,
          detail=jsonb_build_object(
            'command_no',v_command_no,
            'terminal_error',v_operation_result->'terminal_error')::text;
      end if;

      v_operation_status:=upper(coalesce(v_operation_result->>'status',''));
      v_operation_id:=case when coalesce(v_operation_result->>'operation_id','')~
        '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
        then (v_operation_result->>'operation_id')::uuid end;
      v_document_version_id:=case when coalesce(v_operation_result->>'document_version_id','')~
        '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
        then (v_operation_result->>'document_version_id')::uuid end;

      if v_operation_status='READY' then
        if v_document_version_id is null or v_operation_id is not null
           or not exists(
             select 1
             from public.invoice_document_versions dv
             where dv.id=v_document_version_id
               and dv.entity_type=case when v_command_type='VIEW_TIMESHEET_DOCUMENT'
                 then 'TIMESHEET' else 'INVOICE' end
               and dv.entity_id=case when v_command_type='VIEW_TIMESHEET_DOCUMENT'
                 then (v_source_update->>'timesheet_id')::uuid else p_invoice_id end
               and dv.purpose=case when v_command_type='VIEW_TIMESHEET_DOCUMENT'
                 then 'TIMESHEET' else 'DRAFT_PREVIEW' end
               and dv.source_revision=case when v_command_type='VIEW_TIMESHEET_DOCUMENT'
                 then (
                   select t.document_revision::text from public.timesheets t
                   where t.timesheet_id=(v_source_update->>'timesheet_id')::uuid
                     and t.is_current)
                 else (
                   select i.document_revision::text from public.invoices i
                   where i.id=p_invoice_id)
                 end
               and dv.template_version=v_source_update->>'template_version'
               and dv.status='READY'
               and nullif(btrim(coalesce(dv.r2_key,'')),'') is not null
               and nullif(btrim(coalesce(dv.sha256,'')),'') is not null
               and coalesce(dv.size_bytes,0)>0
               and coalesce(dv.page_count,0)>0
           ) then
          raise exception using errcode='55000',
            message='SOURCE_EDIT_REPLACEMENT_RESULT_INVALID',
            detail=jsonb_build_object(
              'reason','READY_IDENTITY','command_no',v_command_no)::text;
        end if;
      else
        if v_operation_id is null
           or v_operation_status not in('QUEUED','RUNNING','WAITING','RETRY_WAIT')
           or not exists(
             select 1
             from public.invoice_operations op
             where op.id=v_operation_id
               and op.operation_type='BUILD_DOCUMENT'
               and op.entity_type=case when v_command_type='VIEW_TIMESHEET_DOCUMENT'
                 then 'TIMESHEET' else 'INVOICE' end
               and op.entity_id=case when v_command_type='VIEW_TIMESHEET_DOCUMENT'
                 then (v_source_update->>'timesheet_id')::uuid else p_invoice_id end
               and op.source_revision=case when v_command_type='VIEW_TIMESHEET_DOCUMENT'
                 then (
                   select t.document_revision::text from public.timesheets t
                   where t.timesheet_id=(v_source_update->>'timesheet_id')::uuid
                     and t.is_current)
                 else (
                   select i.document_revision::text from public.invoices i
                   where i.id=p_invoice_id)
                 end
               and op.template_version=v_source_update->>'template_version'
               and coalesce(op.input_json->>'purpose','')=
                 case when v_command_type='VIEW_TIMESHEET_DOCUMENT'
                   then 'TIMESHEET' else 'DRAFT_PREVIEW' end
               and op.status in('QUEUED','RUNNING','WAITING','RETRY_WAIT')
           ) then
          raise exception using errcode='55000',
            message='SOURCE_EDIT_REPLACEMENT_RESULT_INVALID',
            detail=jsonb_build_object(
              'reason','ACTIVE_IDENTITY','command_no',v_command_no)::text;
        end if;
      end if;

      v_validated_operations:=v_validated_operations||jsonb_build_array(v_operation_result);
    end loop;

    select coalesce(jsonb_agg(jsonb_build_object(
      'timesheet_id',t.timesheet_id,
      'document_revision',t.document_revision)
      order by t.timesheet_id),'[]'::jsonb)
    into v_source_changed_revisions
    from public.timesheets t
    where t.timesheet_id=any(v_source_changed_ts_ids) and t.is_current;
  end if;

-- Return compact state only; never build a manifest or PDF here.
  select jsonb_build_object('invoice_id',i.id,'status',i.status,
    'subtotal_ex_vat',i.subtotal_ex_vat,'vat_amount',i.vat_amount,'total_inc_vat',i.total_inc_vat,
    'document_revision',i.document_revision,'document_state',i.document_state,
    'preview_document_version_id',i.preview_document_version_id,
    'active_document_operation_id',i.active_document_operation_id,
    'issue_state',i.issue_state,'active_issue_operation_id',i.active_issue_operation_id,
    'reference_updates_applied',v_refupd_applied,
    'timesheet_location_updates_applied',v_location_applied,
    'timesheet_source_changed',
      cardinality(v_source_changed_ts_ids)>0,
    'source_edit_queue_contract',case when v_source_edit_requested
      then 'INVOICE_SOURCE_EDIT_QUEUE_V1' else null end,
    'changed_timesheet_ids',coalesce(to_jsonb(v_source_changed_ts_ids),'[]'::jsonb),
    'changed_timesheet_revisions',coalesce(v_source_changed_revisions,'[]'::jsonb),
    'source_edit_preexisting_preview',v_source_edit_preexisting_preview,
    'invoice_replacement_required',v_source_edit_invoice_replacement_required,
    'accepted_operations',coalesce(v_validated_operations,'[]'::jsonb),
    'document_queue_requested',jsonb_array_length(v_document_commands)>0)
  into v_manifest from public.invoices i where i.id=p_invoice_id;

  if v_invoice_debug then
    begin
      -- attach finish marker (avoid extra heavy queries here)
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','finish',
          'at_utc', public._inv_iso_utc(now()),
          'invoice_total_charge_ex_vat', v_new_ex,
          'invoice_vat_amount', v_new_vat,
          'invoice_total_inc_vat', v_new_inc
        )
      );

      v_dbg_stats := v_dbg_stats || jsonb_build_object(
        'lines_deleted', v_dbg_lines_deleted,
        'timesheets_unlocked_via_line_removal', v_dbg_timesheets_unlocked,
        'segment_add_refs', v_dbg_seg_add_refs,
        'segment_remove_refs', v_dbg_seg_remove_refs,
        'segment_tsfin_count', v_dbg_seg_tsfins,
        'segment_timesheets_rebuilt', v_dbg_seg_timesheets_rebuilt,
        'segment_timesheets_removed', v_dbg_seg_timesheets_removed,
        'add_timesheets_found', v_dbg_add_timesheets_found,
        'add_timesheets_skipped', v_dbg_add_timesheets_skipped
      );

      perform public._inv_write_audit(
        p_actor_user_id,
        'INVOICE_APPLY_EDITS_DEBUG',
        jsonb_build_object(
          'invoice_id', p_invoice_id::text,
          'week_start', v_week_start::text,
          'week_end', v_week_end::text,
          'stats', v_dbg_stats,
          'steps', v_dbg_steps
        ),
        'invoices',
        p_invoice_id::text,
        null,
        'INVOICE_DEBUG',
        null, null, null
      );
    exception when others then
      null;
    end;
  end if;

  perform public._ctms_assert_invoice_correction_lines_v1(
    p_invoice_id,p_actor_user_id,false,'INVOICE_APPLY_EDITS_RESULT'
  );

  IF v_correction_placement_ts_id IS NOT NULL THEN
    v_correction_placement_scope:=public.invoice_correction_pair_scope_v1(
      v_correction_placement_ts_id,null::uuid,p_actor_user_id,false,100);
    IF COALESCE((v_correction_placement_scope->>'valid')::boolean,false) IS NOT TRUE
       OR v_correction_placement_scope->>'placement_state' NOT IN (
         'COMPLETE_SAME_INVOICE','COMPLETE_SPLIT_INVOICES','INCOMPLETE_MOVE','UNPLACED') THEN
      RAISE EXCEPTION 'INVOICE_CORRECTION_PAIR_PLACEMENT_RESULT_INVALID'
        USING ERRCODE='P0001',DETAIL=v_correction_placement_scope::text;
    END IF;
    v_correction_placement_states:=jsonb_build_array(jsonb_build_object(
      'correction_id',v_correction_placement_scope->>'correction_id',
      'pair_timesheet_ids',v_correction_placement_scope->'pair_timesheet_ids',
      'placement_state',v_correction_placement_scope->>'placement_state',
      'missing_member_kind',v_correction_placement_scope->>'missing_member_kind',
      'placement_invoices',v_correction_placement_scope->'placement_invoices'));
    v_manifest:=v_manifest||jsonb_build_object(
      'correction_pair_placement_states',v_correction_placement_states);
  END IF;

  return v_manifest;

exception when others then
  v_dbg_sqlstate := SQLSTATE;
  v_dbg_error := SQLERRM;

  if v_invoice_debug then
    begin
      perform public._inv_write_audit(
        p_actor_user_id,
        'INVOICE_APPLY_EDITS_ERROR',
        jsonb_build_object(
          'invoice_id', coalesce(p_invoice_id::text,''),
          'sqlstate', v_dbg_sqlstate,
          'error', v_dbg_error,
          'stats', v_dbg_stats,
          'steps', v_dbg_steps
        ),
        'invoices',
        coalesce(p_invoice_id::text,''),
        null,
        'INVOICE_DEBUG',
        null, null, null
      );
    exception when others then
      null;
    end;
  end if;

  raise;
end;
$function$;

create or replace function private.weekly_source_invoice_adjustments_apply_v1(p_invoice_id uuid,p_payload jsonb,p_actor_user_id uuid)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare inv public.invoices%rowtype; line public.invoice_lines%rowtype; v_authority jsonb; item jsonb; v_rate numeric;
  v_ex numeric; v_vat numeric; v_token text; v_description text; v_meta jsonb; v_ids uuid[]; v_id uuid; v_result jsonb;
  v_credit_frame jsonb; v_pg_context text; v_credit_context jsonb;
  v_current_context jsonb; v_target_ids uuid[]; v_frame_ids uuid[]; v_removal_lines jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if not exists(select 1 from public.tms_users where id=p_actor_user_id and is_active and lower(btrim(role))='admin') then
    raise exception 'WEEKLY_SOURCE_OFFICE_ADMIN_REQUIRED' using errcode='42501'; end if;
  if exists(select 1 from jsonb_array_elements(case when jsonb_typeof(p_payload->'add_adjustments')='array'
    then p_payload->'add_adjustments' else '[]'::jsonb end) requested where requested ? 'credited_work_event_id')
    or exists(select 1 from public.invoice_lines removed where removed.invoice_id=p_invoice_id
      and removed.meta_json ? 'credited_work_event_id'
      and removed.id in(select case when pg_input_is_valid(value,'uuid') then value::uuid end
        from jsonb_array_elements_text(case when jsonb_typeof(p_payload->'remove_invoice_line_ids')='array'
          then p_payload->'remove_invoice_line_ids' else '[]'::jsonb end) value)) then
    get diagnostics v_pg_context=PG_CONTEXT;
    v_credit_frame:=nullif(current_setting('cloudtms.weekly_source_credit_target_frame',true),'')::jsonb;
    if v_pg_context !~* 'PL/pgSQL function (public[.])?invoice_apply_edits[(]uuid,jsonb,uuid[)]'
      or jsonb_typeof(v_credit_frame) is distinct from 'object'
      or v_credit_frame->>'schema_version' is distinct from 'WEEKLY_SOURCE_CREDIT_TARGET_FRAME_V1'
      or v_credit_frame->>'invoice_id' is distinct from p_invoice_id::text
      or v_credit_frame->>'actor_user_id' is distinct from p_actor_user_id::text
      or v_credit_frame->>'native_backend_pid' is distinct from pg_backend_pid()::text
      or v_credit_frame->>'native_transaction_id' is distinct from txid_current()::text
      or v_credit_frame->>'payload_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_CREDIT_TARGET_PAYLOAD_V1',p_payload),'hex')
      or v_credit_frame->>'frame_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_CREDIT_TARGET_FRAME_V1',v_credit_frame-'frame_sha256'),'hex') then
      raise exception 'WEEKLY_SOURCE_CREDITED_SHIFT_NATIVE_FRAME_REQUIRED' using errcode='55000'; end if;
  end if;
  perform public._ctms_assert_invoice_mutable_draft_v1(p_invoice_id,'INVOICE_APPLY_EDITS',true);
  select * into strict inv from public.invoices where id=p_invoice_id for update;
  v_authority:=private.weekly_source_invoice_adjustment_authority_v1(p_invoice_id,null);
  if v_credit_frame is not null and v_credit_frame->'adjustment_authority' is distinct from v_authority then
    raise exception 'WEEKLY_SOURCE_CREDITED_SHIFT_FACTS_CHANGED' using errcode='40001'; end if;
  if v_authority->>'allowed' is distinct from 'true' then
    raise exception 'WEEKLY_SOURCE_INVOICE_ADJUSTMENTS_NOT_ALLOWED' using errcode='55000'; end if;
  if jsonb_typeof(p_payload) is distinct from 'object' or exists(select 1 from jsonb_object_keys(p_payload) k
    where k not in('add_adjustments','remove_invoice_line_ids')) then
    raise exception 'WEEKLY_SOURCE_INVOICE_EDIT_ADJUSTMENT_ONLY' using errcode='22023'; end if;
  -- KC1: validate the complete genuine pre-write census ONCE, after original
  -- invoice authority/lock admission and BEFORE any accepted own removal/add.
  -- The outer Source owner retains all native Candidate/family/group/cycle locks.
  if v_credit_frame is not null then
    select coalesce(array_agg(distinct id order by id),'{}'::uuid[]) into v_target_ids from (
      select (item->>'credited_work_event_id')::uuid id
        from jsonb_array_elements(coalesce(p_payload->'add_adjustments','[]'::jsonb)) item where item ? 'credited_work_event_id'
      union select (removed.meta_json->>'credited_work_event_id')::uuid
        from public.invoice_lines removed where removed.invoice_id=p_invoice_id and removed.meta_json ? 'credited_work_event_id'
          and removed.id in(select value::uuid from jsonb_array_elements_text(coalesce(p_payload->'remove_invoice_line_ids','[]'::jsonb)) value)
    ) affected;
    select coalesce(array_agg((saved->>'work_event_id')::uuid order by (saved->>'work_event_id')::uuid),'{}'::uuid[])
      into v_frame_ids from jsonb_array_elements(v_credit_frame->'native_contexts') saved;
    if v_frame_ids is distinct from v_target_ids then
      raise exception 'WEEKLY_SOURCE_CREDITED_SHIFT_FACTS_CHANGED' using errcode='40001'; end if;
    select coalesce(jsonb_agg(jsonb_build_object('invoice_line_id',removed.id,'invoice_id',removed.invoice_id,
      'work_event_id',(removed.meta_json->>'credited_work_event_id')::uuid,
      'metadata_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CREDIT_REMOVAL_METADATA_V1',removed.meta_json),'hex'))
      order by removed.id),'[]'::jsonb) into v_removal_lines from public.invoice_lines removed
      where removed.invoice_id=p_invoice_id and removed.meta_json ? 'credited_work_event_id'
        and removed.id in(select value::uuid from jsonb_array_elements_text(coalesce(p_payload->'remove_invoice_line_ids','[]'::jsonb)) value);
    if v_removal_lines is distinct from v_credit_frame->'removal_lines' then
      raise exception 'WEEKLY_SOURCE_CREDITED_SHIFT_FACTS_CHANGED' using errcode='40001'; end if;
    for v_credit_context in select value from jsonb_array_elements(v_credit_frame->'native_contexts') loop
      v_current_context:=private.weekly_source_kept_as_paid_context_v1((v_credit_context->>'work_event_id')::uuid,p_actor_user_id);
      if v_credit_context->>'facts_fingerprint' is distinct from encode(private.weekly_source_kept_as_paid_facts_v1(
          (v_credit_context->>'work_event_id')::uuid,'CREDITED'),'hex')
        or v_current_context->>'client_id' is distinct from inv.client_id::text
        or v_current_context->>'source_group_id' is distinct from v_credit_frame->>'source_group_id'
        or v_current_context->>'candidate_id' is distinct from v_credit_context->>'candidate_id'
        or v_current_context->>'source_cycle_id' is distinct from v_credit_context->>'source_cycle_id'
        or v_current_context->'root_timesheet_ids' is distinct from v_credit_context->'root_timesheet_ids'
        or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CREDIT_TARGET_NATIVE_PAID_BASIS_V1',
          v_current_context->'native_paid_basis'),'hex') is distinct from v_credit_context->>'native_paid_basis_sha256' then
        raise exception 'WEEKLY_SOURCE_CREDITED_SHIFT_FACTS_CHANGED' using errcode='40001'; end if;
    end loop;
  end if;
  if p_payload ? 'remove_invoice_line_ids' then
    if jsonb_typeof(p_payload->'remove_invoice_line_ids') is distinct from 'array' then
      raise exception 'WEEKLY_SOURCE_INVOICE_EDIT_ADJUSTMENT_ONLY' using errcode='22023'; end if;
    for v_id in select value::uuid from jsonb_array_elements_text(p_payload->'remove_invoice_line_ids') value loop
      select * into strict line from public.invoice_lines where id=v_id and invoice_id=p_invoice_id for update;
      if private.weekly_source_invoice_adjustment_line_valid_v1(line.id,p_invoice_id) is distinct from true then
        raise exception 'WEEKLY_SOURCE_INVOICE_EDIT_ADJUSTMENT_ONLY' using errcode='22023'; end if;
      delete from public.invoice_lines where id=line.id;
    end loop;
  end if;
  v_rate:=(v_authority->>'vat_rate_pct')::numeric;
  if p_payload ? 'add_adjustments' then
    if jsonb_typeof(p_payload->'add_adjustments') is distinct from 'array' then
      raise exception 'WEEKLY_SOURCE_INVOICE_ADJUSTMENT_INVALID' using errcode='22023'; end if;
    for item in select value from jsonb_array_elements(p_payload->'add_adjustments') loop
      if jsonb_typeof(item) is distinct from 'object' or exists(select 1 from jsonb_object_keys(item) k
        where k not in('client_token','description','amount_ex_vat','vat_amount','credited_work_event_id')) then
        raise exception 'WEEKLY_SOURCE_INVOICE_ADJUSTMENT_INVALID' using errcode='22023'; end if;
      if item ? 'credited_work_event_id' then
        if jsonb_typeof(item->'credited_work_event_id') is distinct from 'string'
          or pg_input_is_valid(item->>'credited_work_event_id','uuid') is distinct from true then
          raise exception 'WEEKLY_SOURCE_CREDITED_SHIFT_INVALID' using errcode='22023'; end if;
        -- The complete event/facts frame was validated before any own write.
        -- Same-event accepted additions/removals are not foreign CAS drift.
      end if;
      v_token:=btrim(item->>'client_token'); v_description:=btrim(item->>'description');
      if coalesce(v_token,'') !~ '^[A-Za-z0-9:_-]{1,200}$' or length(coalesce(v_description,'')) not between 1 and 1000
        or coalesce(item->>'amount_ex_vat','') !~ '^-[0-9]+([.][0-9]{1,2})?$'
        or (item ? 'vat_amount' and coalesce(item->>'vat_amount','') !~ '^[+-]?[0-9]+([.][0-9]{1,2})?$') then
        raise exception 'WEEKLY_SOURCE_INVOICE_ADJUSTMENT_INVALID' using errcode='22023'; end if;
      v_ex:=(item->>'amount_ex_vat')::numeric;
      v_vat:=case when item ? 'vat_amount' then (item->>'vat_amount')::numeric else public._inv_round2(v_ex*v_rate/100) end;
      if v_ex>=0 or abs(v_ex)>9999999999.99 or abs(v_vat)>9999999999.99 then
        raise exception 'WEEKLY_SOURCE_INVOICE_ADJUSTMENT_INVALID' using errcode='22023'; end if;
      v_meta:=jsonb_build_object('line_type','ADJUSTMENT','client_token',v_token,'description',v_description,
        'amount_ex_vat',v_ex,'vat_rate_pct',v_rate,'vat_amount',v_vat,'vat_chargeable',v_rate<>0,
        'vat_overridden',item ? 'vat_amount','weekly_source_adjustment_authority',v_authority)
        ||case when item ? 'credited_work_event_id' then jsonb_build_object('credited_work_event_id',(item->>'credited_work_event_id')::uuid) else '{}'::jsonb end;
      select * into line from public.invoice_lines where invoice_id=p_invoice_id and source_key='ADJ:'||v_token;
      if found then
        if line.meta_json is distinct from v_meta or private.weekly_source_invoice_adjustment_line_valid_v1(line.id,p_invoice_id) is distinct from true then
          raise exception 'WEEKLY_SOURCE_INVOICE_ADJUSTMENT_REPLAY_CONFLICT' using errcode='23505'; end if;
      else
        insert into public.invoice_lines(invoice_id,timesheet_id,booking_id,description,hours_day,hours_night,hours_sat,hours_sun,hours_bh,
          pay_day,pay_night,pay_sat,pay_sun,pay_bh,charge_day,charge_night,charge_sat,charge_sun,charge_bh,
          total_pay_ex_vat,total_charge_ex_vat,margin_ex_vat,vat_rate_pct,vat_amount,total_inc_vat,meta_json,source_key)
          values(p_invoice_id,null,null,v_description,0,0,0,0,0,null,null,null,null,null,null,null,null,null,null,
            0,v_ex,v_ex,v_rate,v_vat,round(v_ex+v_vat,2),v_meta,'ADJ:'||v_token);
      end if;
    end loop;
  end if;
  perform public.invoice_recompute_totals(p_invoice_id);
  perform private.weekly_source_invoice_allocation_assert_v1(p_invoice_id);
  perform public._audit_insert('invoices',p_invoice_id::text,'INVOICE_ADJUSTMENTS_APPLIED',null,
    jsonb_build_object('source','WEEKLY_FINAL_SOURCE','payload',p_payload),'Trust credit',p_actor_user_id);
  select jsonb_build_object('invoice_id',id,'status',status,'subtotal_ex_vat',subtotal_ex_vat,'vat_amount',vat_amount,'total_inc_vat',total_inc_vat,
    'document_revision',document_revision,'document_state',document_state,'preview_document_version_id',preview_document_version_id,
    'active_document_operation_id',active_document_operation_id,'issue_state',issue_state,'active_issue_operation_id',active_issue_operation_id,
    'reference_updates_applied',0,'timesheet_location_updates_applied',0,'timesheet_source_changed',false,
    'source_edit_queue_contract',null,'changed_timesheet_ids','[]'::jsonb,'changed_timesheet_revisions','[]'::jsonb,
    'source_edit_preexisting_preview',false,'invoice_replacement_required',false,'accepted_operations','[]'::jsonb,'document_queue_requested',false)
    into v_result from public.invoices where id=p_invoice_id;
  return v_result;
end;
$function$;

create or replace function private.weekly_source_invoice_adjustment_line_valid_v1(p_invoice_line_id uuid,p_invoice_id uuid)
returns boolean language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare line public.invoice_lines%rowtype; v_authority jsonb; v_actual jsonb; v_ids uuid[]; v_meta jsonb;
begin
  select * into line from public.invoice_lines where id=p_invoice_line_id and invoice_id=p_invoice_id;
  if not found or line.timesheet_id is not null or line.booking_id is not null or line.source_key not like 'ADJ:%'
    or line.meta_json->>'line_type' is distinct from 'ADJUSTMENT' or line.total_pay_ex_vat is distinct from 0
    or line.total_charge_ex_vat is null or line.total_charge_ex_vat>=0 or line.margin_ex_vat is distinct from line.total_charge_ex_vat
    or (line.hours_day,line.hours_night,line.hours_sat,line.hours_sun,line.hours_bh) is distinct from (0::numeric,0::numeric,0::numeric,0::numeric,0::numeric)
    or (line.pay_day,line.pay_night,line.pay_sat,line.pay_sun,line.pay_bh,line.charge_day,line.charge_night,line.charge_sat,line.charge_sun,line.charge_bh)
      is distinct from (null::numeric,null::numeric,null::numeric,null::numeric,null::numeric,null::numeric,null::numeric,null::numeric,null::numeric,null::numeric)
    or line.vat_amount is null or line.vat_rate_pct is null
    or line.total_inc_vat is distinct from round(line.total_charge_ex_vat+line.vat_amount,2)
    then return false; end if;
  v_authority:=line.meta_json->'weekly_source_adjustment_authority';
  if jsonb_typeof(v_authority) is distinct from 'object' or jsonb_typeof(v_authority->'binding_ids') is distinct from 'array' then return false; end if;
  select array_agg(value::uuid order by value::uuid) into v_ids from jsonb_array_elements_text(v_authority->'binding_ids') value;
  v_actual:=private.weekly_source_invoice_adjustment_authority_v1(p_invoice_id,v_ids);
  v_meta:=line.meta_json;
  if exists(select 1 from jsonb_object_keys(v_meta) k where k not in(
    'line_type','client_token','description','amount_ex_vat','vat_rate_pct','vat_amount','vat_chargeable',
    'vat_overridden','weekly_source_adjustment_authority','credited_work_event_id')) then return false; end if;
  -- A retained issued credit re-proves immutable actual target identity, not
  -- today's Keep availability. Changed facts cannot erase a genuine credit.
  if v_meta ? 'credited_work_event_id' and (jsonb_typeof(v_meta->'credited_work_event_id') is distinct from 'string'
    or pg_input_is_valid(v_meta->>'credited_work_event_id','uuid') is distinct from true
    or not exists(select 1 from public.weekly_work_events event
      join public.invoices invoice on invoice.id=p_invoice_id and invoice.client_id=event.client_id
        and invoice.header_snapshot_json#>>'{meta,source_group_id}'=event.first_source_group_id::text
      where event.id=(v_meta->>'credited_work_event_id')::uuid
        and exists(select 1 from public.weekly_source_row_resolutions resolution
          join public.contracts contract on contract.id=resolution.contract_id
          where resolution.work_event_id=event.id and resolution.mapping_state='RESOLVED'
            and resolution.candidate_id=event.candidate_id and resolution.client_id=event.client_id
            and contract.candidate_id=event.candidate_id and contract.client_id=event.client_id))) then return false; end if;
  return coalesce(v_actual->>'allowed'='true' and v_actual=v_authority
    and line.vat_rate_pct=(v_actual->>'vat_rate_pct')::numeric
    and line.source_key='ADJ:'||(v_meta->>'client_token') and line.description=v_meta->>'description'
    and line.total_charge_ex_vat=(v_meta->>'amount_ex_vat')::numeric and line.vat_amount=(v_meta->>'vat_amount')::numeric
    and jsonb_typeof(v_meta->'vat_overridden')='boolean'
    and jsonb_typeof(v_meta->'vat_chargeable')='boolean'
    and (v_meta->>'vat_chargeable')::boolean=(line.vat_rate_pct<>0)
    and ((v_meta->>'vat_overridden')::boolean or line.vat_amount=public._inv_round2(line.total_charge_ex_vat*line.vat_rate_pct/100)),false);
exception when invalid_text_representation or numeric_value_out_of_range or invalid_parameter_value then return false;
end;
$function$;

create or replace function private.weekly_source_keep_ack_native_guard_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_context text; v_after jsonb:=new.after_json; v_request jsonb;
  v_decision public.weekly_source_kept_as_paid_decisions%rowtype;
  v_event public.weekly_work_events%rowtype; v_sequence bigint; v_native_context jsonb;
begin
  if tg_op='DELETE' then
    if old.action='WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED' then
      raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_ACK_IMMUTABLE' using errcode='55000'; end if;
    return old;
  end if;
  if tg_op='UPDATE' and (old.action='WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED'
    or new.action='WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED') then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_ACK_IMMUTABLE' using errcode='55000'; end if;
  if new.action is distinct from 'WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED' then return new; end if;
  get diagnostics v_context=PG_CONTEXT;
  perform private.weekly_source_query_require_service_v1();
  if tg_op is distinct from 'INSERT' or tg_table_schema is distinct from 'public' or tg_table_name is distinct from 'audit_events'
    or v_context !~* 'PL/pgSQL function (public[.])?weekly_source_keep_as_paid_decide_atomic_v1[(]jsonb[)]'
    or new.object_type is distinct from 'weekly_source_kept_as_paid_decisions'
    or jsonb_typeof(v_after) is distinct from 'object'
    or not v_after ?& array['schema_version','decision_id','work_event_id','reason','credit_invoice_line_id',
      'facts_fingerprint','actor_user_id','acknowledged_at_utc','acknowledgement_sequence','idempotency_key',
      'request_sha256','request','result','native_backend_pid','native_transaction_id']
    or v_after-array['schema_version','decision_id','work_event_id','reason','credit_invoice_line_id',
      'facts_fingerprint','actor_user_id','acknowledged_at_utc','acknowledgement_sequence','idempotency_key',
      'request_sha256','request','result','native_backend_pid','native_transaction_id']<>'{}'::jsonb
    or v_after->>'schema_version' is distinct from 'WEEKLY_SOURCE_KEEP_AS_PAID_ACK_V1'
    or v_after->>'native_backend_pid' is distinct from pg_backend_pid()::text
    or v_after->>'native_transaction_id' is distinct from txid_current()::text
    or v_after->>'actor_user_id' is distinct from new.actor_user_id::text
    or v_after->>'work_event_id' is distinct from new.object_id_text then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_NATIVE_ACK_REQUIRED' using errcode='55000'; end if;
  v_request:=v_after->'request';
  if jsonb_typeof(v_request) is distinct from 'object'
    or v_after->>'request_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_KEEP_AS_PAID_REQUEST_V1',v_request),'hex')
    or (v_request->>'actor_user_id')::uuid is distinct from new.actor_user_id
    or (v_request->>'work_event_id')::uuid is distinct from new.object_id_text::uuid
    or v_request->>'decision' is distinct from 'KEEP_AS_PAID'
    or v_request->>'reason' is distinct from v_after->>'reason'
    or (v_request->>'credit_invoice_line_id')::uuid is distinct from (v_after->>'credit_invoice_line_id')::uuid
    or v_request->>'idempotency_key' is distinct from v_after->>'idempotency_key'
    or v_request->>'expected_facts_fingerprint' is distinct from v_after->>'facts_fingerprint'
    or not isfinite((v_after->>'acknowledged_at_utc')::timestamptz) then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_NATIVE_ACK_REQUIRED' using errcode='55000'; end if;
  select * into strict v_decision from public.weekly_source_kept_as_paid_decisions
    where id=(v_after->>'decision_id')::uuid;
  select * into strict v_event from public.weekly_work_events where id=v_decision.work_event_id;
  if v_decision.decision is distinct from 'KEEP_AS_PAID' or v_decision.work_event_id::text is distinct from new.object_id_text
    or v_decision.reason is distinct from v_after->>'reason'
    or to_jsonb(v_decision.credit_invoice_line_id) is distinct from nullif(v_after->'credit_invoice_line_id','null'::jsonb)
    or encode(v_decision.facts_fingerprint,'hex') is distinct from v_after->>'facts_fingerprint'
    or v_decision.facts_fingerprint is distinct from private.weekly_source_kept_as_paid_facts_v1(v_event.id,v_decision.reason) then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_FACTS_CHANGED' using errcode='40001'; end if;
  v_native_context:=private.weekly_source_kept_as_paid_context_v1(v_event.id,new.actor_user_id);
  perform private.weekly_source_office_authority_v1(new.actor_user_id,'APPROVE_PROTECTED_PAY',
    v_event.first_source_group_id,v_event.client_id,(v_native_context->>'finalisation_week_ending')::date);
  if v_native_context->'source_present' is distinct from 'false'::jsonb
    or not (v_native_context->'invoiced'='true'::jsonb or v_native_context->'paid'='true'::jsonb) then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_NOT_ELIGIBLE' using errcode='55000'; end if;
  select coalesce(max((audit.after_json->>'acknowledgement_sequence')::bigint),0)+1 into v_sequence
    from public.audit_events audit where audit.action='WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED'
      and audit.object_type='weekly_source_kept_as_paid_decisions' and audit.object_id_text=new.object_id_text;
  if (v_after->>'acknowledgement_sequence')::bigint is distinct from v_sequence
    or v_after#>>'{result,decision_id}' is distinct from v_decision.id::text
    or v_after#>>'{result,actor_user_id}' is distinct from new.actor_user_id::text
    or v_after#>>'{result,acknowledged_at_utc}' is distinct from v_after->>'acknowledged_at_utc'
    or v_after#>>'{result,acknowledgement_sequence}' is distinct from v_sequence::text
    or v_after#>'{result,pay_changed}' is distinct from 'false'::jsonb
    or v_after#>'{result,invoice_changed}' is distinct from 'false'::jsonb
    or exists(select 1 from public.audit_events audit where audit.action='WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED'
      and audit.after_json->>'idempotency_key'=v_after->>'idempotency_key') then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_NATIVE_ACK_REQUIRED' using errcode='55000'; end if;
  return new;
end;
$function$;

create or replace function private.weekly_source_kept_as_paid_facts_for_publication_v1(p_work_event_id uuid,p_reason text,p_projection_publication_id uuid)
returns bytea language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_event public.weekly_work_events%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_roots uuid[]; v_root uuid; v_revision uuid; v_segments jsonb; v_segment jsonb;
  v_movements uuid[]:='{}'::uuid[]; v_movement uuid; v_present boolean; v_credits uuid[];
begin
  if p_work_event_id is null or p_reason is null or p_reason not in ('CREDITED','NOT_INVOICED_DISAPPEARED') then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_REASON_INVALID' using errcode='22023'; end if;
  select * into strict v_event from public.weekly_work_events where id=p_work_event_id;
  -- Latest actual export publication covering this date. A report is never
  -- substituted for an export, and absence is distinct from an unreadable file.
  select publication.* into v_publication
  from public.weekly_source_projection_publications publication
  join public.weekly_source_uploads upload on upload.id=publication.upload_id
  join public.weekly_source_cycles cycle on cycle.id=upload.source_cycle_id
  join public.weekly_source_format_profiles profile on profile.id=upload.source_format_profile_id
  where publication.id=p_projection_publication_id
    and publication.source_cycle_id=cycle.id and publication.authority_scope_kind='CYCLE'
    and publication.report_scope_id is null and upload.report_scope_id is null
    and cycle.source_group_id=v_event.first_source_group_id
    and (cycle.scope_client_id is null or cycle.scope_client_id=v_event.client_id)
    and (
      (publication.state='CURRENT' and upload.state='CURRENT'
        and cycle.current_projection_publication_id=publication.id
        and ((upload.purpose='ORDINARY' and upload.correction_session_id is null
          and publication.correction_session_id is null)
          or (upload.purpose='FINAL_SOURCE_CORRECTION' and exists(
          select 1 from public.weekly_final_source_correction_sessions applied
          join public.weekly_source_final_revisions final on final.id=applied.applied_final_revision_id
          where applied.id=upload.correction_session_id and publication.correction_session_id=applied.id
            and applied.source_cycle_id=cycle.id and applied.authority_scope_kind='CYCLE'
            and applied.report_scope_id is null and applied.state='APPLIED'
            and applied.prepared_final_revision_id=applied.applied_final_revision_id
            and applied.replacement_correction_upload_id=upload.id
            and applied.replacement_projection_publication_id=publication.id
            and applied.completed_at_utc is not null
            and final.source_cycle_id=cycle.id and final.authority_scope_kind='CYCLE'
            and final.report_scope_id is null and final.upload_id=upload.id
            and final.reason='CORRECT_FINAL_SOURCE' and final.state='CURRENT'
            and final.predecessor_revision_id=applied.expected_current_final_revision_id
            and cycle.current_final_revision_id=final.id
            and applied.result_json->>'status'='CORRECTED'
            and applied.result_json->>'correction_session_id'=applied.id::text
            and applied.result_hash=private.weekly_source_sha256_jsonb_v1(
              'WEEKLY_SOURCE_CORRECT_FINAL_RESULT_V1',applied.result_json)
            and applied.review_result_hash=private.weekly_source_sha256_jsonb_v1(
              'WEEKLY_SOURCE_CORRECT_FINAL_REVIEW_RESULT_V1',applied.review_result_json)))))
      or
      (publication.state='CORRECTION_READY' and upload.state='CORRECTION_READY'
        and upload.purpose='FINAL_SOURCE_CORRECTION' and exists(
          select 1 from public.weekly_final_source_correction_sessions correction
          join public.weekly_source_final_revisions prior on prior.id=correction.expected_current_final_revision_id
          where correction.id=upload.correction_session_id and publication.correction_session_id=correction.id
            and correction.source_cycle_id=cycle.id and correction.authority_scope_kind='CYCLE'
            and correction.report_scope_id is null
            and correction.replacement_correction_upload_id=upload.id
            and correction.replacement_projection_publication_id=publication.id
            and correction.state in ('REVIEWED','PREPARING','PREPARED','COMMITTING')
            and prior.source_cycle_id=cycle.id and prior.authority_scope_kind='CYCLE'
            and prior.report_scope_id is null and prior.state='CURRENT'
            and prior.manifest_hash=correction.expected_final_manifest_hash
            and cycle.current_final_revision_id=prior.id
            and correction.review_result_hash=private.weekly_source_sha256_jsonb_v1(
              'WEEKLY_SOURCE_CORRECT_FINAL_REVIEW_RESULT_V1',correction.review_result_json)))
    )
    and profile.profile_code in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1',
      'HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1','ROSTER_WEEKLY_SUMMARY_ACTUAL_V1')
    and upload.row_manifest_hash is not null and upload.coverage_state='COMPLETE'
    and upload.coverage_timezone='Europe/London'
    and v_event.work_date between upload.confirmed_coverage_start_local_date and upload.confirmed_coverage_end_local_date
    and (upload.file_metadata_json->>'client_id'=v_event.client_id::text
      or (nullif(upload.file_metadata_json->>'client_id','') is null and
        (select count(*) from public.weekly_source_group_clients gc
          where gc.source_group_id=cycle.source_group_id
            and cycle.finalisation_week_ending between gc.valid_from and coalesce(gc.valid_to,'infinity'::date))=1
        and exists(select 1 from public.weekly_source_group_clients gc
          where gc.source_group_id=cycle.source_group_id and gc.client_id=v_event.client_id
            and cycle.finalisation_week_ending between gc.valid_from and coalesce(gc.valid_to,'infinity'::date))))
  order by publication.published_at_utc desc,publication.created_at_utc desc,publication.id desc limit 1;
  if not found then raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_EXPORT_UNAVAILABLE' using errcode='55000'; end if;
  select * into strict v_upload from public.weekly_source_uploads where id=v_publication.upload_id;
  v_present:=exists(select 1 from public.weekly_source_upload_rows row
    join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=row.id
      and resolution.generation=v_publication.projection_generation and resolution.mapping_state='RESOLVED'
    where row.upload_id=v_upload.id and resolution.work_event_id=v_event.id
      and resolution.candidate_id=v_event.candidate_id and resolution.client_id=v_event.client_id)
    or exists(select 1 from public.weekly_source_upload_rows row where row.upload_id=v_upload.id
      and row.external_source_key=v_event.profile_external_key
      and v_event.identity_kind='PROFILE_EXTERNAL_KEY');
  -- Actual current segments supply the pay-head movement identity. All real
  -- lineages/families are considered; zero is nullable, more than one refuses.
  select coalesce(array_agg(distinct scope.canonical_timesheet_id order by scope.canonical_timesheet_id),'{}'::uuid[])
    into v_roots from public.weekly_source_row_timesheet_lineages lineage
    cross join lateral public._pay_timesheet_rotation_scope(array[lineage.timesheet_id]) scope
    where lineage.work_event_id=v_event.id and lineage.candidate_id=v_event.candidate_id
      and lineage.client_id=v_event.client_id;
  foreach v_root in array v_roots loop
    select revision.id into v_revision from public.weekly_source_final_revisions revision
    join public.weekly_source_cycles cycle on cycle.id=revision.source_cycle_id
    where revision.state='CURRENT' and cycle.source_group_id=v_event.first_source_group_id
      and revision.authority_scope_kind='CYCLE'
      and (cycle.scope_client_id is null or cycle.scope_client_id=v_event.client_id)
    order by cycle.finalisation_week_ending desc,revision.finalised_at_utc desc,revision.revision_number desc,revision.id desc limit 1;
    if v_revision is not null then
      v_segments:=private.weekly_source_ordinary_projection_current_segments_v1(v_root,v_revision);
      for v_segment in select value from jsonb_array_elements(v_segments) loop
        if v_segment#>>'{weekly_source,work_event_id}'=v_event.id::text then
          v_movement:=(v_segment#>>'{weekly_source,movement_id}')::uuid;
          if v_movement is null or not exists(select 1 from public.weekly_source_billing_movements m
            join public.contracts c on c.id=m.contract_id
            where m.id=v_movement and m.work_event_id=v_event.id and m.candidate_id=v_event.candidate_id
              and m.actual_client_id=v_event.client_id and c.candidate_id=v_event.candidate_id and c.client_id=v_event.client_id
              and m.movement_role in ('POSITIVE','REPLACEMENT')
              and m.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION')) then
            raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_HEAD_UNBOUND' using errcode='55000'; end if;
          if not v_movement=any(v_movements) then v_movements:=array_append(v_movements,v_movement); end if;
        end if;
      end loop;
    end if;
  end loop;
  if cardinality(v_movements)>1 then raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_HEAD_AMBIGUOUS' using errcode='55000'; end if;
  -- Full real credit-line census: actual CURRENT bindings/line IDs, negative
  -- Report lines bound to this event, and native validated unbound Office ADJ.
  select coalesce(array_agg(distinct line_id order by line_id),'{}'::uuid[]) into v_credits from (
    select binding.invoice_line_id line_id
    from public.weekly_source_invoice_line_bindings binding
    join public.weekly_source_billing_movements movement on movement.id=binding.billing_movement_id
    join public.invoice_lines line on line.id=binding.invoice_line_id and line.invoice_id=binding.invoice_id
    join public.invoices invoice on invoice.id=line.invoice_id and invoice.client_id=v_event.client_id
    join public.weekly_source_final_revisions revision on revision.id=movement.final_revision_id
    join public.weekly_source_cycles cycle on cycle.id=revision.source_cycle_id and cycle.source_group_id=v_event.first_source_group_id
    join public.weekly_source_upload_rows report_row on report_row.id=movement.self_bill_report_row_id
      and report_row.upload_id=revision.upload_id and report_row.row_finalisation_state='SOURCE_REPORT_LINE'
      and report_row.source_shift_charge_pence<0
    where binding.state='CURRENT' and movement.work_event_id=v_event.id
      and movement.source_line_kind='SELF_BILL_REPORT_LINE' and movement.source_profile_kind='SELF_BILL_REPORT'
      and line.total_charge_ex_vat<0 and (exists(select 1 from public.weekly_source_self_bill_report_line_bindings report_binding
        where report_binding.report_row_id=report_row.id and report_binding.work_event_id=v_event.id)
        or exists(select 1 from public.weekly_source_billing_movements prior
          join public.weekly_source_upload_rows prior_report_row on prior_report_row.id=prior.self_bill_report_row_id
          where prior.id=movement.prior_movement_id and prior.work_event_id=v_event.id
            and prior.source_line_kind='SELF_BILL_REPORT_LINE' and prior_report_row.external_source_key=report_row.external_source_key))
    union
    select line.id from public.invoice_lines line join public.invoices invoice on invoice.id=line.invoice_id
    where invoice.client_id=v_event.client_id and line.meta_json->>'credited_work_event_id'=v_event.id::text
      and invoice.header_snapshot_json#>>'{meta,source_group_id}'=v_event.first_source_group_id::text
      and private.weekly_source_invoice_adjustment_line_valid_v1(line.id,invoice.id)
  ) actual;
  return private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_KEPT_AS_PAID_FACTS_V1',
    jsonb_build_object('work_event_id',v_event.id,'reason',p_reason,'present_in_latest_export',v_present,
      'current_pay_head_movement_id',v_movements[1],'credit_invoice_line_ids',to_jsonb(v_credits)));
end;
$function$;

create or replace function private.weekly_source_kept_as_paid_context_for_publication_v1(p_work_event_id uuid,p_actor_user_id uuid,p_projection_publication_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_event public.weekly_work_events%rowtype; v_resolution public.weekly_source_row_resolutions%rowtype;
  v_root uuid; v_roots uuid[]; v_revision uuid; v_segments jsonb; v_segment jsonb;
  v_movement uuid; v_movements uuid[]:='{}'::uuid[]; v_members uuid[];
  v_publication uuid; v_upload uuid; v_cycle uuid; v_week date; v_source_present boolean;
  v_invoiced boolean:=false; v_invoice_facts jsonb; v_invoice_row jsonb;
  v_credits jsonb; v_paid_state text:='UNKNOWN'; v_paid boolean; v_paid_basis jsonb:='[]'::jsonb;
  v_page jsonb; v_header jsonb; v_after jsonb:=null; v_rows jsonb; v_item jsonb; v_seen jsonb:='[]'::jsonb;
  v_pages integer; v_complete boolean; v_page_positive boolean; v_component uuid; v_component_count integer;
  v_matched_component_count integer;
  v_settlement jsonb; v_shift jsonb; v_reason text; v_facts bytea;
  v_unknown boolean:=false;v_payment_facts jsonb;
  v_ack public.audit_events%rowtype; v_decision public.weekly_source_kept_as_paid_decisions%rowtype;
  v_applies boolean:=false; v_ack_sequence bigint;
  v_accept_complete boolean:=false;v_accept_proofs jsonb:='[]'::jsonb;v_accept_current jsonb;v_result jsonb;
begin
  select * into strict v_event from public.weekly_work_events where id=p_work_event_id;
  select * into strict v_resolution from public.weekly_source_row_resolutions
    where work_event_id=v_event.id and mapping_state='RESOLVED'
    order by created_at_utc desc,id desc limit 1;
  if v_resolution.candidate_id is distinct from v_event.candidate_id or v_resolution.client_id is distinct from v_event.client_id
    or not exists(select 1 from public.contracts c where c.id=v_resolution.contract_id
      and c.candidate_id=v_event.candidate_id and c.client_id=v_event.client_id) then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_LINEAGE_UNBOUND' using errcode='55000'; end if;
  select publication.id,upload.id,cycle.id,cycle.finalisation_week_ending into v_publication,v_upload,v_cycle,v_week
  from public.weekly_source_projection_publications publication
  join public.weekly_source_uploads upload on upload.id=publication.upload_id
  join public.weekly_source_cycles cycle on cycle.id=upload.source_cycle_id
  join public.weekly_source_format_profiles profile on profile.id=upload.source_format_profile_id
  where publication.id=p_projection_publication_id
    and publication.source_cycle_id=cycle.id and publication.authority_scope_kind='CYCLE'
    and publication.report_scope_id is null and upload.report_scope_id is null
    and cycle.source_group_id=v_event.first_source_group_id
    and (cycle.scope_client_id is null or cycle.scope_client_id=v_event.client_id)
    and (
      (publication.state='CURRENT' and upload.state='CURRENT'
        and cycle.current_projection_publication_id=publication.id
        and ((upload.purpose='ORDINARY' and upload.correction_session_id is null
          and publication.correction_session_id is null)
          or (upload.purpose='FINAL_SOURCE_CORRECTION' and exists(
          select 1 from public.weekly_final_source_correction_sessions applied
          join public.weekly_source_final_revisions final on final.id=applied.applied_final_revision_id
          where applied.id=upload.correction_session_id and publication.correction_session_id=applied.id
            and applied.source_cycle_id=cycle.id and applied.authority_scope_kind='CYCLE'
            and applied.report_scope_id is null and applied.state='APPLIED'
            and applied.prepared_final_revision_id=applied.applied_final_revision_id
            and applied.replacement_correction_upload_id=upload.id
            and applied.replacement_projection_publication_id=publication.id
            and applied.completed_at_utc is not null
            and final.source_cycle_id=cycle.id and final.authority_scope_kind='CYCLE'
            and final.report_scope_id is null and final.upload_id=upload.id
            and final.reason='CORRECT_FINAL_SOURCE' and final.state='CURRENT'
            and final.predecessor_revision_id=applied.expected_current_final_revision_id
            and cycle.current_final_revision_id=final.id
            and applied.result_json->>'status'='CORRECTED'
            and applied.result_json->>'correction_session_id'=applied.id::text
            and applied.result_hash=private.weekly_source_sha256_jsonb_v1(
              'WEEKLY_SOURCE_CORRECT_FINAL_RESULT_V1',applied.result_json)
            and applied.review_result_hash=private.weekly_source_sha256_jsonb_v1(
              'WEEKLY_SOURCE_CORRECT_FINAL_REVIEW_RESULT_V1',applied.review_result_json)))))
      or
      (publication.state='CORRECTION_READY' and upload.state='CORRECTION_READY'
        and upload.purpose='FINAL_SOURCE_CORRECTION' and exists(
          select 1 from public.weekly_final_source_correction_sessions correction
          join public.weekly_source_final_revisions prior on prior.id=correction.expected_current_final_revision_id
          where correction.id=upload.correction_session_id and publication.correction_session_id=correction.id
            and correction.source_cycle_id=cycle.id and correction.authority_scope_kind='CYCLE'
            and correction.report_scope_id is null
            and correction.replacement_correction_upload_id=upload.id
            and correction.replacement_projection_publication_id=publication.id
            and correction.state in ('REVIEWED','PREPARING','PREPARED','COMMITTING')
            and (p_actor_user_id is null or correction.actor_user_id=p_actor_user_id)
            and prior.source_cycle_id=cycle.id and prior.authority_scope_kind='CYCLE'
            and prior.report_scope_id is null and prior.state='CURRENT'
            and prior.manifest_hash=correction.expected_final_manifest_hash
            and cycle.current_final_revision_id=prior.id
            and correction.review_result_hash=private.weekly_source_sha256_jsonb_v1(
              'WEEKLY_SOURCE_CORRECT_FINAL_REVIEW_RESULT_V1',correction.review_result_json)))
    )
    and profile.profile_code in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1',
      'HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1','ROSTER_WEEKLY_SUMMARY_ACTUAL_V1')
    and upload.row_manifest_hash is not null and upload.coverage_state='COMPLETE' and upload.coverage_timezone='Europe/London'
    and v_event.work_date between upload.confirmed_coverage_start_local_date and upload.confirmed_coverage_end_local_date
    and (upload.file_metadata_json->>'client_id'=v_event.client_id::text or
      (nullif(upload.file_metadata_json->>'client_id','') is null and
        (select count(*) from public.weekly_source_group_clients gc where gc.source_group_id=cycle.source_group_id
          and cycle.finalisation_week_ending between gc.valid_from and coalesce(gc.valid_to,'infinity'::date))=1
        and exists(select 1 from public.weekly_source_group_clients gc where gc.source_group_id=cycle.source_group_id
          and gc.client_id=v_event.client_id and cycle.finalisation_week_ending between gc.valid_from and coalesce(gc.valid_to,'infinity'::date))))
  order by publication.published_at_utc desc,publication.created_at_utc desc,publication.id desc limit 1;
  if v_publication is null then raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_EXPORT_UNAVAILABLE' using errcode='55000'; end if;
  if p_actor_user_id is not null then
    perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
      v_event.first_source_group_id,v_event.client_id,v_week); end if;
  v_source_present:=exists(select 1 from public.weekly_source_upload_rows row
    join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=row.id
      and resolution.generation=(select projection_generation from public.weekly_source_projection_publications where id=v_publication)
      and resolution.mapping_state='RESOLVED'
    where row.upload_id=v_upload and resolution.work_event_id=v_event.id
      and resolution.candidate_id=v_event.candidate_id and resolution.client_id=v_event.client_id)
    or exists(select 1 from public.weekly_source_upload_rows row where row.upload_id=v_upload
      and row.external_source_key=v_event.profile_external_key and v_event.identity_kind='PROFILE_EXTERNAL_KEY');
  v_payment_facts:=private.weekly_source_work_event_payment_facts_v1(v_event.id,p_actor_user_id,v_cycle);
  v_roots:=array(select value::uuid from jsonb_array_elements_text(v_payment_facts->'root_timesheet_ids') value);
  v_movements:=array(select value::uuid from jsonb_array_elements_text(v_payment_facts->'current_pay_head_movement_ids') value);
  v_invoiced:=(v_payment_facts->>'invoiced')::boolean;
  v_paid:=(v_payment_facts->>'paid')::boolean;
  v_paid_state:=v_payment_facts->>'paid_evidence_state';
  v_paid_basis:=v_payment_facts->'native_paid_basis';
  -- Exactly the same real credit-line membership as the planned facts hash.
  -- Presentations cannot admit a weaker Report predicate than the CAS writer.
  select coalesce(jsonb_agg(jsonb_build_object('invoice_line_id',line.id,'invoice_id',line.invoice_id,
    'net_pence',round(line.total_charge_ex_vat*100)::bigint) order by line.id),'[]'::jsonb) into v_credits from (
    select binding.invoice_line_id line_id
    from public.weekly_source_invoice_line_bindings binding
    join public.weekly_source_billing_movements movement on movement.id=binding.billing_movement_id
    join public.invoice_lines line on line.id=binding.invoice_line_id and line.invoice_id=binding.invoice_id
    join public.invoices invoice on invoice.id=line.invoice_id and invoice.client_id=v_event.client_id
    join public.weekly_source_final_revisions revision on revision.id=movement.final_revision_id
    join public.weekly_source_cycles cycle on cycle.id=revision.source_cycle_id and cycle.source_group_id=v_event.first_source_group_id
    join public.weekly_source_upload_rows report_row on report_row.id=movement.self_bill_report_row_id
      and report_row.upload_id=revision.upload_id and report_row.row_finalisation_state='SOURCE_REPORT_LINE'
      and report_row.source_shift_charge_pence<0
    where binding.state='CURRENT' and movement.work_event_id=v_event.id
      and movement.source_line_kind='SELF_BILL_REPORT_LINE' and movement.source_profile_kind='SELF_BILL_REPORT'
      and line.total_charge_ex_vat<0 and (exists(select 1 from public.weekly_source_self_bill_report_line_bindings report_binding
        where report_binding.report_row_id=report_row.id and report_binding.work_event_id=v_event.id)
        or exists(select 1 from public.weekly_source_billing_movements prior
          join public.weekly_source_upload_rows prior_report_row on prior_report_row.id=prior.self_bill_report_row_id
          where prior.id=movement.prior_movement_id and prior.work_event_id=v_event.id
            and prior.source_line_kind='SELF_BILL_REPORT_LINE' and prior_report_row.external_source_key=report_row.external_source_key))
    union
    select line.id from public.invoice_lines line join public.invoices invoice on invoice.id=line.invoice_id
    where invoice.client_id=v_event.client_id and line.meta_json->>'credited_work_event_id'=v_event.id::text
      and invoice.header_snapshot_json#>>'{meta,source_group_id}'=v_event.first_source_group_id::text
      and private.weekly_source_invoice_adjustment_line_valid_v1(line.id,invoice.id)
  ) actual join public.invoice_lines line on line.id=actual.line_id;
  v_reason:=case when jsonb_array_length(v_credits)>0 then 'CREDITED'
    when not v_invoiced then 'NOT_INVOICED_DISAPPEARED' else null end;
  if v_reason is not null then
    v_facts:=private.weekly_source_kept_as_paid_facts_for_publication_v1(v_event.id,v_reason,v_publication);
    -- Owner-approved recurrence: latest genuine ACK first, then current hash.
    -- Do not pre-filter acknowledgements by the present fingerprint.
    select audit.* into v_ack from public.audit_events audit
    where audit.object_type='weekly_source_kept_as_paid_decisions' and audit.object_id_text=v_event.id::text
      and audit.action='WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED'
      and audit.after_json->>'schema_version'='WEEKLY_SOURCE_KEEP_AS_PAID_ACK_V1'
      and audit.after_json->>'work_event_id'=v_event.id::text and audit.after_json->>'reason'=v_reason
    order by (audit.after_json->>'acknowledgement_sequence')::bigint desc,audit.id desc limit 1;
    if found then
      select * into v_decision from public.weekly_source_kept_as_paid_decisions
        where id=(v_ack.after_json->>'decision_id')::uuid and work_event_id=v_event.id and reason=v_reason;
      v_applies:=found and not v_source_present and v_decision.facts_fingerprint=v_facts
        and v_ack.after_json->>'facts_fingerprint'=encode(v_decision.facts_fingerprint,'hex')
        and v_ack.after_json->>'actor_user_id'=v_ack.actor_user_id::text;
    end if;
  end if;
  if not v_source_present and cardinality(v_roots)>0 then
    v_accept_complete:=true;
    foreach v_root in array v_roots loop
      v_accept_current:=private.weekly_source_missing_accept_current_removal_v1(v_event.id,v_root,v_publication,p_actor_user_id);
      if v_accept_current is null then v_accept_complete:=false;v_accept_proofs:='[]'::jsonb;exit;end if;
      v_accept_proofs:=v_accept_proofs||jsonb_build_array(v_accept_current);
    end loop;
  end if;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_KEPT_AS_PAID_CONTEXT_V1',
    'work_event_id',v_event.id,'candidate_id',v_event.candidate_id,'client_id',v_event.client_id,
    'contract_id',v_resolution.contract_id,'source_group_id',v_event.first_source_group_id,
    'source_cycle_id',v_cycle,'finalisation_week_ending',v_week,'projection_publication_id',v_publication,'upload_id',v_upload,
    'source_present',v_source_present,'root_timesheet_ids',to_jsonb(v_roots),'current_pay_head_movement_id',v_movements[1],
    'invoiced',v_invoiced,'paid',v_paid,'paid_evidence_state',v_paid_state,'native_paid_basis',v_paid_basis,
    'paid_quantity_known',false,'withheld_amount_known',false,'credit_lines',v_credits,'reason',v_reason,
    'kept_by_default',not v_accept_complete and not v_source_present and v_invoiced,
    'decision_available',not v_accept_complete and not v_source_present and (v_invoiced or v_paid is true),
    'decision_needed',case when v_accept_complete then false when not v_source_present and not v_invoiced and v_paid is null then null
      else not v_source_present and (jsonb_array_length(v_credits)>0 or (not v_invoiced and v_paid is true)) and not v_applies end,
    'facts_fingerprint',case when v_facts is null then null else encode(v_facts,'hex') end,'decision_applies',v_applies,
    'latest_acknowledgement',case when v_ack.id is null then null else jsonb_build_object('audit_id',v_ack.id,
      'decision_id',v_decision.id,'actor_user_id',v_ack.actor_user_id,'actor_display',v_ack.actor_display,
      'acknowledged_at_utc',v_ack.after_json->>'acknowledged_at_utc','acknowledgement_sequence',v_ack.after_json->>'acknowledgement_sequence') end,
    'holds_pay',case when v_accept_complete then false when not v_source_present and (v_invoiced or v_paid is true) then false else null end,
    'holds_invoice',case when v_accept_complete then false when not v_source_present and (v_invoiced or v_paid is true) then false else null end);
  if v_accept_complete then
    v_result:=v_result||jsonb_build_object('accepted_source_removed',true,'accepted_source_removal_proofs',v_accept_proofs);
  end if;
  return v_result;
end;
$function$;

create or replace function private.weekly_source_missing_snapshot_movement_v1(p_snapshot_line_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_requested public.weekly_source_final_snapshot_lines%rowtype;
  v_line public.weekly_source_final_snapshot_lines%rowtype;
  v_previous public.weekly_source_final_snapshot_lines%rowtype;
  v_t public.weekly_source_state_transitions%rowtype;
  v_m public.weekly_source_billing_movements%rowtype;
  v_resolution public.weekly_source_row_resolutions%rowtype;
  v_lineage public.weekly_source_row_timesheet_lineages%rowtype;
  v_requested_lineage public.weekly_source_row_timesheet_lineages%rowtype;
  v_economic public.weekly_source_row_economic_snapshots%rowtype;
  v_group uuid; v_cursor uuid; v_seen uuid[]:='{}'::uuid[];
  v_mapping uuid; v_ids uuid[]; v_cache_count integer;
  v_prior_subset jsonb; v_current_subset jsonb;
  v_prior_fingerprint bytea; v_current_fingerprint bytea;
  v_result jsonb;
begin
  if p_snapshot_line_id is null then
    raise exception 'WEEKLY_SOURCE_MISSING_BASIS_INPUT_INVALID' using errcode='22023';
  end if;
  select * into strict v_requested from public.weekly_source_final_snapshot_lines where id=p_snapshot_line_id;
  select * into strict v_requested_lineage from public.weekly_source_row_timesheet_lineages where row_resolution_id=v_requested.row_resolution_id;
  select cycle.source_group_id into strict v_group from public.weekly_source_final_revisions revision
    join public.weekly_source_cycles cycle on cycle.id=revision.source_cycle_id
    where revision.id=v_requested.final_revision_id;
  if not exists(select 1 from public.weekly_work_events event
      join public.contracts contract on contract.id=v_requested.contract_id
      where event.id=v_requested.work_event_id and event.first_source_group_id=v_group
        and event.candidate_id=v_requested.candidate_id and event.client_id=v_requested.client_id
        and event.work_date=v_requested.work_date
        and contract.candidate_id=event.candidate_id and contract.client_id=event.client_id) then
    raise exception 'WEEKLY_SOURCE_MISSING_BASIS_SCOPE_UNBOUND' using errcode='55000';
  end if;

  -- A captured snapshot mapping is the existing native producer's exact
  -- original-movement identity. Scope/lineage is re-proved, not ranked.
  select count(*),array_agg(mapping.movement_id) into v_cache_count,v_ids
  from private.bpay_next_source_current_snapshots mapping
  join private.bpay_next_source_current_scopes scope on scope.id=mapping.scope_id
  join public.weekly_source_row_timesheet_lineages lineage on lineage.row_resolution_id=v_requested.row_resolution_id
  where mapping.snapshot_line_id=v_requested.id and mapping.work_event_id=v_requested.work_event_id
    and scope.source_group_id=v_group and scope.family_booking_id=lineage.family_booking_id
    and scope.candidate_id=v_requested.candidate_id and scope.client_id=v_requested.client_id
    and scope.contract_id=v_requested.contract_id and scope.week_ending_date=lineage.week_ending_date
    and lineage.work_event_id=v_requested.work_event_id and lineage.candidate_id=v_requested.candidate_id
    and lineage.client_id=v_requested.client_id and lineage.contract_id=v_requested.contract_id;
  if v_cache_count>1 or (exists(select 1 from private.bpay_next_source_current_snapshots
       where snapshot_line_id=v_requested.id) and v_cache_count<>1) then
    raise exception 'WEEKLY_SOURCE_MISSING_BASIS_NATIVE_MAPPING_UNBOUND' using errcode='55000';
  end if;
  if v_cache_count=1 then v_mapping:=v_ids[1]; end if;

  -- Retained Legacy may never have captured NEXT mappings. Follow only the
  -- real immutable NO_CHANGE previous-snapshot edges to ADD/AMEND. The finite
  -- actual ancestry is traversed completely; a cycle refuses. There is no
  -- ledger timestamp/UUID order, economic tie-break or arbitrary depth limit.
  v_cursor:=v_requested.id;
  loop
    if v_cursor=any(v_seen) then
      raise exception 'WEEKLY_SOURCE_MISSING_BASIS_ANCESTRY_CYCLE' using errcode='55000';
    end if;
    v_seen:=array_append(v_seen,v_cursor);
    select * into strict v_line from public.weekly_source_final_snapshot_lines where id=v_cursor;
    if (v_line.work_event_id,v_line.candidate_id,v_line.client_id,v_line.contract_id,
        v_line.work_date,v_line.start_at_local,v_line.end_at_local,v_line.break_minutes)
      is distinct from (v_requested.work_event_id,v_requested.candidate_id,v_requested.client_id,v_requested.contract_id,
        v_requested.work_date,v_requested.start_at_local,v_requested.end_at_local,v_requested.break_minutes)
      or not exists(select 1 from public.weekly_source_final_revisions revision
        join public.weekly_source_cycles cycle on cycle.id=revision.source_cycle_id
        where revision.id=v_line.final_revision_id and cycle.source_group_id=v_group) then
      raise exception 'WEEKLY_SOURCE_MISSING_BASIS_ANCESTRY_SCOPE_CHANGED' using errcode='55000';
    end if;
    select array_agg(transition.id) into v_ids from public.weekly_source_state_transitions transition
      where transition.new_snapshot_line_id=v_line.id and transition.final_revision_id=v_line.final_revision_id
        and transition.work_event_id=v_line.work_event_id and transition.source_profile_kind=v_line.source_profile_kind
        and transition.new_present;
    if coalesce(cardinality(v_ids),0)<>1 then
      raise exception 'WEEKLY_SOURCE_MISSING_BASIS_TRANSITION_UNBOUND' using errcode='55000';
    end if;
    select * into strict v_t from public.weekly_source_state_transitions where id=v_ids[1];
    if v_t.outcome in ('ADD','AMEND') then
      select array_agg(movement.id) into v_ids from public.weekly_source_billing_movements movement
        where movement.transition_id=v_t.id and movement.final_revision_id=v_t.final_revision_id
          and movement.work_event_id=v_t.work_event_id
          and movement.source_profile_kind=v_t.source_profile_kind
          and movement.movement_role=case when v_t.outcome='ADD' then 'POSITIVE' else 'REPLACEMENT' end
          and movement.source_line_kind in ('SOURCE_ORDINARY','SOURCE_REPLACEMENT');
      if coalesce(cardinality(v_ids),0)<>1 then
        raise exception 'WEEKLY_SOURCE_MISSING_BASIS_MOVEMENT_UNBOUND' using errcode='55000';
      end if;
      select * into strict v_m from public.weekly_source_billing_movements where id=v_ids[1];
      exit;
    elsif v_t.outcome='NO_CHANGE' and v_t.previous_present and v_t.previous_snapshot_line_id is not null then
      select * into strict v_previous from public.weekly_source_final_snapshot_lines where id=v_t.previous_snapshot_line_id;
      v_prior_subset:=private.weekly_source_snapshot_authority_subset_v1(v_previous.id);
      v_current_subset:=private.weekly_source_snapshot_authority_subset_v1(v_line.id);
      -- Preserve FIN4's real pre-upgrade whole-hash compatibility arm.
      if v_prior_subset is null and v_current_subset is not null then
        if v_previous.policy_fingerprint is distinct from v_line.policy_fingerprint then
          raise exception 'WEEKLY_SOURCE_MISSING_BASIS_ANCESTRY_POLICY_CHANGED' using errcode='55000';
        end if;
        v_current_subset:=null;
      end if;
      v_prior_fingerprint:=private.weekly_source_snapshot_value_fingerprint_v1(v_previous.id,v_prior_subset);
      v_current_fingerprint:=private.weekly_source_snapshot_value_fingerprint_v1(v_line.id,v_current_subset);
      -- Earlier immutable NO_CHANGE records have no hash-version field.
      -- Preserve their original equal/non-null hashes as recorded; do not
      -- pretend they were encoded by today's F1 domain. Independently prove
      -- equivalent stored values through the one current native value owner.
      if v_t.prior_state_fingerprint is null or v_t.new_state_fingerprint is null
        or v_t.prior_state_fingerprint is distinct from v_t.new_state_fingerprint
        or v_prior_fingerprint is distinct from v_current_fingerprint then
        raise exception 'WEEKLY_SOURCE_MISSING_BASIS_ANCESTRY_VALUES_CHANGED' using errcode='55000';
      end if;
      v_cursor:=v_previous.id;
    else
      raise exception 'WEEKLY_SOURCE_MISSING_BASIS_ANCESTRY_NOT_POSITIVE' using errcode='55000';
    end if;
  end loop;
  if v_mapping is not null and v_mapping is distinct from v_m.id then
    raise exception 'WEEKLY_SOURCE_MISSING_BASIS_NATIVE_MAPPING_CHANGED' using errcode='55000';
  end if;
  if v_m.placement_state='VOIDED_BY_CORRECT_FINAL'
    or (v_m.work_event_id,v_m.candidate_id,v_m.actual_client_id,v_m.contract_id)
      is distinct from (v_requested.work_event_id,v_requested.candidate_id,v_requested.client_id,v_requested.contract_id)
    or v_m.source_facts_json->>'snapshot_line_id' is distinct from v_line.id::text
    or v_m.source_facts_json->>'row_resolution_id' is distinct from v_line.row_resolution_id::text
    or v_m.source_facts_json->>'upload_row_id' is distinct from v_line.upload_row_id::text then
    raise exception 'WEEKLY_SOURCE_MISSING_BASIS_ORIGINAL_MOVEMENT_CHANGED' using errcode='55000';
  end if;
  select * into strict v_resolution from public.weekly_source_row_resolutions where id=v_line.row_resolution_id;
  select * into strict v_lineage from public.weekly_source_row_timesheet_lineages where row_resolution_id=v_resolution.id;
  select * into strict v_economic from public.weekly_source_row_economic_snapshots where row_resolution_id=v_resolution.id;
  if v_resolution.mapping_state<>'RESOLVED'
    or v_resolution.upload_row_id is distinct from v_line.upload_row_id
    or v_economic.upload_row_id is distinct from v_line.upload_row_id
    or (v_resolution.work_event_id,v_resolution.candidate_id,v_resolution.client_id,v_resolution.contract_id)
      is distinct from (v_m.work_event_id,v_m.candidate_id,v_m.actual_client_id,v_m.contract_id)
    or (v_lineage.work_event_id,v_lineage.candidate_id,v_lineage.client_id,v_lineage.contract_id)
      is distinct from (v_m.work_event_id,v_m.candidate_id,v_m.actual_client_id,v_m.contract_id)
    or (v_lineage.family_booking_id,v_lineage.week_ending_date,v_lineage.work_event_id,
        v_lineage.candidate_id,v_lineage.client_id,v_lineage.contract_id)
      is distinct from (v_requested_lineage.family_booking_id,v_requested_lineage.week_ending_date,v_requested_lineage.work_event_id,
        v_requested_lineage.candidate_id,v_requested_lineage.client_id,v_requested_lineage.contract_id)
    or (v_economic.work_event_id,v_economic.candidate_id,v_economic.client_id,v_economic.contract_id)
      is distinct from (v_m.work_event_id,v_m.candidate_id,v_m.actual_client_id,v_m.contract_id)
    or v_m.invoice_timesheet_id is distinct from v_lineage.timesheet_id
    or not exists(select 1 from public.weekly_source_final_revisions revision
      join public.weekly_source_upload_rows source_row on source_row.id=v_line.upload_row_id
        and source_row.upload_id=revision.upload_id
      join public.weekly_source_cycles cycle on cycle.id=v_lineage.source_cycle_id
      where revision.id=v_line.final_revision_id and cycle.source_group_id=v_group) then
    raise exception 'WEEKLY_SOURCE_MISSING_BASIS_ORIGINAL_FACTS_UNBOUND' using errcode='55000';
  end if;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_SNAPSHOT_MOVEMENT_V1',
    'requested_snapshot_line_id',v_requested.id,'original_snapshot_line_id',v_line.id,
    'work_event_id',v_m.work_event_id,'source_group_id',v_group,'movement_id',v_m.id,
    'candidate_id',v_m.candidate_id,'client_id',v_m.actual_client_id,'contract_id',v_m.contract_id,
    'row_resolution_id',v_resolution.id,'lineage_id',v_lineage.id,'economic_snapshot_id',v_economic.id,
    'original_snapshot_hash',encode(v_line.snapshot_line_hash,'hex'),
    'movement_economic_hash',encode(v_m.movement_economic_hash,'hex'),
    'mapping_rate_policy_fingerprint',encode(v_m.mapping_rate_policy_fingerprint,'hex'),
    'timesheet_lineage_fingerprint',encode(v_lineage.lineage_fingerprint,'hex'),
    'original_economic_snapshot',to_jsonb(v_economic),
    'canonical_pay_vector',v_m.canonical_pay_vector_json,'canonical_charge_vector',v_m.canonical_charge_vector_json,
    'source_facts',v_m.source_facts_json,'ancestry_snapshot_ids',to_jsonb(v_seen));
  return v_result||jsonb_build_object('basis_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_MISSING_SNAPSHOT_MOVEMENT_V1',v_result),'hex'));
end;
$function$;

create or replace function private.weekly_source_missing_cancel_basis_v1(
  p_projection_publication_id uuid,p_previous_snapshot_line_id uuid,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_snapshot public.weekly_source_final_snapshot_lines%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_context jsonb; v_original jsonb; v_result jsonb; v_correction_baseline jsonb; v_accepted_removed boolean;
  v_roots uuid[]; v_locked uuid[]; v_operation uuid; v_lock_text text;
  v_disposition text; v_stack text;
begin
  if p_projection_publication_id is null or p_previous_snapshot_line_id is null or p_actor_user_id is null then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_INPUT_INVALID' using errcode='22023';
  end if;
  get diagnostics v_stack=pg_context;
  if v_stack !~* 'PL/pgSQL function (private[.])?weekly_source_finalise_engine_v1[(]jsonb,uuid,boolean,text[)]' then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_OWNER_REQUIRED' using errcode='42501';
  end if;
  select * into strict v_snapshot from public.weekly_source_final_snapshot_lines where id=p_previous_snapshot_line_id;
  select * into strict v_publication from public.weekly_source_projection_publications where id=p_projection_publication_id;
  v_context:=private.weekly_source_kept_as_paid_context_for_publication_v1(
    v_snapshot.work_event_id,p_actor_user_id,v_publication.id);
  if v_context->>'projection_publication_id' is distinct from v_publication.id::text
    or (v_context->>'candidate_id')::uuid is distinct from v_snapshot.candidate_id
    or (v_context->>'client_id')::uuid is distinct from v_snapshot.client_id
    or (v_context->>'contract_id')::uuid is distinct from v_snapshot.contract_id then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_SCOPE_CHANGED' using errcode='40001';
  end if;
  -- Raw unfinalised or unresolved membership is not genuine absence. Leave
  -- its existing native category/path intact; do not manufacture missing work
  -- or add a new whole-Finalise refusal for that row through this constructor.
  if v_context->'source_present' is distinct from 'false'::jsonb then
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_CANCEL_BASIS_V1',
      'exclude_cancel',false,'disposition','NOT_GENUINELY_ABSENT','basis',null);
  end if;
  select coalesce(array_agg(value::uuid order by value::uuid),'{}'::uuid[]) into v_roots
    from jsonb_array_elements_text(v_context->'root_timesheet_ids') value;
  if cardinality(v_roots)=0 then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_ROOT_UNAVAILABLE' using errcode='55000';
  end if;
  v_lock_text:=coalesce(current_setting('cloudtms.weekly_source_finalisation_lock_operation',true),'');
  if v_lock_text<>'' then
    begin v_operation:=v_lock_text::uuid;
    exception when invalid_text_representation then
      raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_LOCK_UNBOUND' using errcode='40001';
    end;
    perform private.bpay_next_source_current_lock_recheck_v1(v_operation);
    if not exists(select 1 from private.bpay_next_source_current_lock_operations operation
      where operation.id=v_operation and operation.transaction_id=pg_current_xact_id()
        and operation.projection_publication_id=v_publication.id and operation.upload_id=v_publication.upload_id
        and operation.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version::integer)
        and operation.source_group_id=(v_context->>'source_group_id')::uuid
        and operation.client_id=v_snapshot.client_id) then
      raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_LOCK_UNBOUND' using errcode='40001';
    end if;
    select coalesce(array_agg(root_timesheet_id order by root_timesheet_id),'{}'::uuid[]) into v_locked
      from private.bpay_next_source_current_lock_members where operation_id=v_operation;
  else
    v_lock_text:=coalesce(current_setting('cloudtms.weekly_source_finalisation_root_set',true),'');
    if v_lock_text in ('','EMPTY_LOCKED_SET') then
      raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_LOCK_UNBOUND' using errcode='40001';
    end if;
    begin v_locked:=string_to_array(v_lock_text,',')::uuid[];
    exception when invalid_text_representation then
      raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_LOCK_UNBOUND' using errcode='40001';
    end;
  end if;
  if not v_roots<@v_locked then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_ROOT_SET_CHANGED' using errcode='40001';
  end if;
  v_original:=private.weekly_source_missing_snapshot_movement_v1(v_snapshot.id);
  v_accepted_removed:=v_context->'accepted_source_removed'='true'::jsonb;
  v_disposition:=case
    when v_accepted_removed then 'ACCEPTED_SOURCE_REMOVED'
    when v_context->'invoiced'='true'::jsonb then 'KEEP_INVOICED'
    when v_context->'paid'='true'::jsonb then 'KEEP_PAID_NOT_INVOICED'
    when v_context->'paid'='false'::jsonb then 'CANCEL_NOT_PAID_OR_INVOICED'
    else null end;
  if v_disposition is null then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_PAID_EVIDENCE_UNAVAILABLE' using errcode='55000';
  end if;
  if not coalesce(v_accepted_removed,false)
    and v_original->>'movement_id' is distinct from v_context->>'current_pay_head_movement_id' then
    if v_disposition is distinct from 'CANCEL_NOT_PAID_OR_INVOICED' then
      raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_NATIVE_POSITION_CHANGED' using errcode='40001';
    end if;
    v_correction_baseline:=private.weekly_source_missing_correction_baseline_v1(
      v_publication.id,v_snapshot.id,p_actor_user_id);
  end if;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_CANCEL_BASIS_V1',
    'work_event_id',v_snapshot.work_event_id,'previous_snapshot_line_id',v_snapshot.id,
    'projection_publication_id',v_publication.id,'upload_id',v_publication.upload_id,
    'projection_generation',coalesce(v_publication.projection_generation,v_publication.authority_scope_version::integer),
    'comparison_manifest_hash',encode(v_publication.comparison_manifest_hash,'hex'),
    'issue_set_hash',encode(v_publication.issue_set_hash,'hex'),
    'candidate_id',v_snapshot.candidate_id,'client_id',v_snapshot.client_id,'contract_id',v_snapshot.contract_id,
    'actor_user_id',p_actor_user_id,'owner_transaction_id',pg_current_xact_id()::text,
    'owner_backend_pid',pg_backend_pid(),'disposition',v_disposition,'original_basis',v_original,
    'target_native_context',v_context);
  if v_accepted_removed then
    v_result:=v_result||jsonb_build_object('accepted_removals',v_context->'accepted_source_removal_proofs');
  end if;
  if v_correction_baseline is not null then
    v_result:=v_result||jsonb_build_object('correction_baseline',v_correction_baseline);
  end if;
  v_result:=v_result||jsonb_build_object('basis_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_MISSING_CANCEL_BASIS_V1',v_result),'hex'));
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_CANCEL_BASIS_V1',
    'exclude_cancel',v_disposition in ('KEEP_INVOICED','KEEP_PAID_NOT_INVOICED'),'disposition',v_disposition,'basis',v_result);
end;
$function$;

create or replace function private.weekly_source_missing_finalisation_roots_v1(
  p_upload_id uuid,p_generation integer,p_old_revision_id uuid,
  p_source_group_id uuid,p_client_id uuid,p_start date,p_end date
) returns table(root_timesheet_id uuid)
language sql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
  with target as materialized (
    select upload.id,cycle.finalisation_week_ending,profile.final_authority_kind
    from public.weekly_source_uploads upload
    join public.weekly_source_cycles cycle on cycle.id=upload.source_cycle_id
    join public.weekly_source_format_profiles profile on profile.id=upload.source_format_profile_id
    join public.weekly_source_projection_publications publication on publication.upload_id=upload.id
      and publication.authority_scope_kind='CYCLE' and publication.report_scope_id is null
      and publication.source_cycle_id=cycle.id
      and coalesce(publication.projection_generation,publication.authority_scope_version::integer)=p_generation
      and publication.state in ('CURRENT','CORRECTION_READY')
    where upload.id=p_upload_id and upload.report_scope_id is null
      and cycle.source_group_id=p_source_group_id
      and (cycle.scope_client_id is null or cycle.scope_client_id=p_client_id)
      and profile.final_authority_kind in ('GENERIC_COMPLETE_SNAPSHOT','HEALTHROSTER_ACTUAL_ROWS')
      and ((publication.state='CURRENT' and upload.state='CURRENT' and p_old_revision_id is null
          and cycle.current_projection_publication_id=publication.id)
        or (publication.state='CORRECTION_READY' and upload.state='CORRECTION_READY'
          and upload.purpose='FINAL_SOURCE_CORRECTION' and exists(
            select 1 from public.weekly_final_source_correction_sessions correction
            where correction.id=upload.correction_session_id
              and correction.id=publication.correction_session_id
              and correction.source_cycle_id=cycle.id and correction.authority_scope_kind='CYCLE'
              and correction.report_scope_id is null
              and correction.expected_current_final_revision_id=p_old_revision_id
              and correction.replacement_correction_upload_id=upload.id
              and correction.replacement_projection_publication_id=publication.id
              and correction.state in ('REVIEWED','PREPARING','PREPARED','COMMITTING'))))
      and upload.confirmed_coverage_start_local_date is not distinct from p_start
      and upload.confirmed_coverage_end_local_date is not distinct from p_end
  ), current_roots as (
    -- Same complete current Contract-Week discovery as the native FIN4 owner.
    select contract_week.timesheet_id
    from target
    join public.weekly_source_upload_rows source_row on source_row.upload_id=target.id
    join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=source_row.id
      and resolution.generation=p_generation
    join public.contracts contract on contract.id=resolution.contract_id
      and contract.client_id=p_client_id and contract.candidate_id=resolution.candidate_id
    join public.contract_weeks contract_week on contract_week.contract_id=contract.id
      and contract_week.additional_seq=0
      and contract_week.week_ending_date=source_row.work_date+
        ((coalesce(contract.week_ending_weekday_snapshot,0)-extract(dow from source_row.work_date)::integer+7)%7)
    where contract_week.timesheet_id is not null
  ), prior_states as (
    -- Mirror FIN4's real revision/transition chronology for membership only.
    -- Never use this order to choose the retained financial movement.
    select distinct on (transition.work_event_id) transition.work_event_id,
      coalesce(transition.new_snapshot_line_id,
        case when transition.exclude_cancel then transition.previous_snapshot_line_id end) as snapshot_line_id
    from public.weekly_source_state_transitions transition
    join public.weekly_source_final_revisions revision on revision.id=transition.final_revision_id
      and revision.state='CURRENT' and revision.authority_scope_kind='CYCLE' and revision.report_scope_id is null
    join public.weekly_source_cycles cycle on cycle.id=transition.finalisation_cycle_id
      and cycle.source_group_id=p_source_group_id
    join public.weekly_source_client_manifests manifest on manifest.final_revision_id=revision.id
      and coalesce(manifest.invoice_window_cycle_id,manifest.source_cycle_id)=manifest.source_cycle_id
      and manifest.client_id=p_client_id
    cross join target
    where transition.source_profile_kind=target.final_authority_kind
      and (cycle.finalisation_week_ending<target.finalisation_week_ending or revision.id=p_old_revision_id)
    order by transition.work_event_id,cycle.finalisation_week_ending desc,
      revision.finalised_at_utc desc,revision.revision_number desc,transition.created_at_utc desc,transition.id desc
  ), prior_roots as (
    select lineage.timesheet_id
    from prior_states prior
    join public.weekly_source_final_snapshot_lines snapshot on snapshot.id=prior.snapshot_line_id
      and snapshot.work_event_id=prior.work_event_id and snapshot.client_id=p_client_id
    join public.weekly_source_row_timesheet_lineages lineage on lineage.row_resolution_id=snapshot.row_resolution_id
      and lineage.work_event_id=snapshot.work_event_id and lineage.client_id=snapshot.client_id
      and lineage.candidate_id=snapshot.candidate_id and lineage.contract_id=snapshot.contract_id
    where snapshot.work_date between p_start and p_end or exists(
      select 1 from public.weekly_source_upload_rows source_row
      join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=source_row.id
        and resolution.generation=p_generation
      where source_row.upload_id=p_upload_id and resolution.work_event_id=prior.work_event_id)
  ), expense_roots as (
    -- Source-fixed expense-only omissions require the same pre-lock union.
    select lineage.timesheet_id
    from public.weekly_expense_authority_generations authority
    cross join target
    join public.weekly_work_events event on event.id=authority.work_event_id
      and event.first_source_group_id=p_source_group_id and event.client_id=p_client_id
      and (event.work_date between p_start and p_end or exists(
        select 1 from public.weekly_source_upload_rows source_row
        join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=source_row.id
          and resolution.generation=p_generation
        where source_row.upload_id=p_upload_id and resolution.work_event_id=event.id))
    join public.weekly_source_row_expense_policy_snapshots policy on policy.id=authority.row_expense_policy_snapshot_id
    join public.weekly_source_row_timesheet_lineages lineage on lineage.row_resolution_id=policy.row_resolution_id
      and lineage.work_event_id=event.id and lineage.client_id=event.client_id
      and lineage.candidate_id=event.candidate_id and lineage.contract_id=authority.contract_id
    where authority.state='CURRENT' and authority.source_expense_pence>0
    union
    -- CorrectFinal can restore the actual pre-mistake positive baseline even
    -- when the current mistaken authority is an omitted zero with no policy.
    select lineage.timesheet_id
    from public.weekly_expense_authority_generations authority
    cross join target
    join public.weekly_expense_authority_generations baseline
      on baseline.id=authority.prior_expense_authority_generation_id
      and baseline.work_event_id=authority.work_event_id
      and baseline.state in ('CURRENT','SUPERSEDED') and baseline.source_expense_pence>0
    join public.weekly_work_events event on event.id=authority.work_event_id
      and event.first_source_group_id=p_source_group_id and event.client_id=p_client_id
      and (event.work_date between p_start and p_end or exists(
        select 1 from public.weekly_source_upload_rows source_row
        join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=source_row.id
          and resolution.generation=p_generation
        where source_row.upload_id=p_upload_id and resolution.work_event_id=event.id))
    join public.weekly_source_row_expense_policy_snapshots policy on policy.id=baseline.row_expense_policy_snapshot_id
    join public.weekly_source_row_timesheet_lineages lineage on lineage.row_resolution_id=policy.row_resolution_id
      and lineage.work_event_id=event.id and lineage.client_id=event.client_id
      and lineage.candidate_id=event.candidate_id and lineage.contract_id=baseline.contract_id
    where authority.state='CURRENT' and authority.final_revision_id=p_old_revision_id
  ), all_members as (
    select timesheet_id from current_roots
    union select timesheet_id from prior_roots
    union select timesheet_id from expense_roots
  )
  select distinct rotation.canonical_timesheet_id
  from all_members member
  cross join lateral public._pay_timesheet_rotation_scope(array[member.timesheet_id]) rotation
  where rotation.canonical_timesheet_id is not null;
$function$;

create or replace function private.weekly_source_missing_cancel_transition_assert_v1(p_transition_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_t public.weekly_source_state_transitions%rowtype;
  v_revision public.weekly_source_final_revisions%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_snapshot public.weekly_source_final_snapshot_lines%rowtype;
  v_event public.weekly_work_events%rowtype;
  v_basis jsonb; v_original jsonb; v_census jsonb; v_group uuid;
begin
  select * into strict v_t from public.weekly_source_state_transitions where id=p_transition_id;
  if not v_t.exclude_cancel or v_t.outcome is distinct from 'CANCEL'
    or not v_t.previous_present or v_t.new_present
    or v_t.previous_snapshot_line_id is null or v_t.new_snapshot_line_id is not null
    or v_t.new_state_fingerprint is not null or v_t.prior_state_fingerprint is null
    or v_t.source_profile_kind not in ('GENERIC_COMPLETE_SNAPSHOT','HEALTHROSTER_ACTUAL_ROWS') then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_TRANSITION_INVALID' using errcode='55000';
  end if;
  select * into strict v_revision from public.weekly_source_final_revisions where id=v_t.final_revision_id;
  select * into strict v_snapshot from public.weekly_source_final_snapshot_lines where id=v_t.previous_snapshot_line_id;
  select * into strict v_event from public.weekly_work_events where id=v_t.work_event_id;
  select source_group_id into strict v_group from public.weekly_source_cycles where id=v_revision.source_cycle_id;
  v_basis:=v_t.cancel_exclusion_basis;
  v_census:=v_revision.missing_cancel_basis_census->v_t.work_event_id::text;
  if v_revision.authority_scope_kind is distinct from 'CYCLE' or v_revision.report_scope_id is not null
    or v_t.finalisation_cycle_id is distinct from v_revision.source_cycle_id
    or v_event.first_source_group_id is distinct from v_group
    or (v_snapshot.work_event_id,v_snapshot.candidate_id,v_snapshot.client_id,v_snapshot.work_date)
      is distinct from (v_event.id,v_event.candidate_id,v_event.client_id,v_event.work_date)
    or v_census->'exclude_cancel' is distinct from 'true'::jsonb
    or v_census->'basis' is distinct from v_basis
    or v_basis->>'schema_version' is distinct from 'WEEKLY_SOURCE_MISSING_CANCEL_BASIS_V1'
    or v_basis->>'work_event_id' is distinct from v_t.work_event_id::text
    or v_basis->>'previous_snapshot_line_id' is distinct from v_snapshot.id::text
    or v_basis->>'actor_user_id' is distinct from v_revision.finalised_by_user_id::text
    or v_basis->>'candidate_id' is distinct from v_snapshot.candidate_id::text
    or v_basis->>'client_id' is distinct from v_snapshot.client_id::text
    or v_basis->>'contract_id' is distinct from v_snapshot.contract_id::text
    or v_basis->>'basis_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_MISSING_CANCEL_BASIS_V1',v_basis-'basis_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_BASIS_UNBOUND' using errcode='55000';
  end if;
  select * into strict v_publication from public.weekly_source_projection_publications
    where id=(v_basis->>'projection_publication_id')::uuid;
  if v_publication.upload_id is distinct from v_revision.upload_id
    or v_basis->>'upload_id' is distinct from v_revision.upload_id::text
    or v_basis->>'projection_generation' is distinct from coalesce(v_publication.projection_generation,v_publication.authority_scope_version::integer)::text
    or v_basis->>'comparison_manifest_hash' is distinct from encode(v_publication.comparison_manifest_hash,'hex')
    or v_basis->>'issue_set_hash' is distinct from encode(v_publication.issue_set_hash,'hex')
    or v_basis#>>'{target_native_context,projection_publication_id}' is distinct from v_publication.id::text
    or v_basis#>>'{target_native_context,source_group_id}' is distinct from v_group::text
    or v_basis#>'{target_native_context,source_present}' is distinct from 'false'::jsonb
    or not coalesce(((v_basis->>'disposition'='KEEP_INVOICED'
        and v_basis#>'{target_native_context,invoiced}'='true'::jsonb)
      or (v_basis->>'disposition'='KEEP_PAID_NOT_INVOICED'
        and v_basis#>'{target_native_context,paid}'='true'::jsonb)),false) then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_PUBLICATION_UNBOUND' using errcode='55000';
  end if;
  -- The real raw upload, including unresolved/unfinalised profile-key rows,
  -- remains the sole export-membership authority. Retained money is separate.
  if exists(select 1 from public.weekly_source_upload_rows source_row
    join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=source_row.id
      and resolution.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version::integer)
    where source_row.upload_id=v_publication.upload_id and resolution.work_event_id=v_t.work_event_id)
    or (v_event.identity_kind='PROFILE_EXTERNAL_KEY' and exists(
      select 1 from public.weekly_source_upload_rows source_row where source_row.upload_id=v_publication.upload_id
        and source_row.external_source_key=v_event.profile_external_key))
    or exists(select 1 from public.weekly_source_billing_movements movement where movement.transition_id=v_t.id) then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_FINANCIAL_FOOTPRINT_INVALID' using errcode='55000';
  end if;
  v_original:=private.weekly_source_missing_snapshot_movement_v1(v_snapshot.id);
  if v_original is distinct from v_basis->'original_basis'
    or v_original->>'movement_id' is distinct from v_basis#>>'{target_native_context,current_pay_head_movement_id}'
    or v_t.transition_fingerprint is distinct from private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_STATE_TRANSITION_V1',jsonb_build_object(
        'final_revision_id',v_t.final_revision_id,'work_event_id',v_t.work_event_id,
        'previous_snapshot_line_id',v_t.previous_snapshot_line_id,'new_snapshot_line_id',null,
        'outcome','CANCEL','exclude_cancel',true,'cancel_exclusion_basis',v_basis,
        'prior_state_fingerprint',encode(v_t.prior_state_fingerprint,'hex'),'new_state_fingerprint',null)) then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_ORIGINAL_CHANGED' using errcode='55000';
  end if;
  return v_basis;
end;
$function$;

create or replace function private.weekly_source_missing_cancel_native_insert_guard_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_frame jsonb; v_stack text; v_basis jsonb;
  v_revision public.weekly_source_final_revisions%rowtype;
  v_keys constant text[]:=array['schema_version','owner_transaction_id','owner_backend_pid',
    'actor_user_id','projection_publication_id','upload_id','source_cycle_id','source_group_id',
    'client_id','census','census_sha256'];
begin
  if not new.exclude_cancel then return new; end if;
  perform private.weekly_source_query_require_service_v1();
  get diagnostics v_stack=pg_context;
  if tg_op is distinct from 'INSERT' or tg_when is distinct from 'AFTER'
    or tg_table_schema is distinct from 'public' or tg_table_name is distinct from 'weekly_source_state_transitions'
    or v_stack !~* 'PL/pgSQL function (private[.])?weekly_source_finalise_engine_v1[(]jsonb,uuid,boolean,text[)]' then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_NATIVE_OWNER_REQUIRED' using errcode='42501';
  end if;
  begin v_frame:=coalesce(nullif(current_setting('cloudtms.weekly_source_missing_cancel_frame',true),''),'null')::jsonb;
  exception when invalid_text_representation then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_NATIVE_FRAME_INVALID' using errcode='40001';
  end;
  select * into strict v_revision from public.weekly_source_final_revisions where id=new.final_revision_id;
  v_basis:=private.weekly_source_missing_cancel_transition_assert_v1(new.id);
  if jsonb_typeof(v_frame) is distinct from 'object' or not v_frame ?& v_keys or v_frame-v_keys<>'{}'::jsonb
    or v_frame->>'schema_version' is distinct from 'WEEKLY_SOURCE_MISSING_CANCEL_OWNER_FRAME_V1'
    or v_frame->>'owner_transaction_id' is distinct from pg_current_xact_id()::text
    or v_frame->>'owner_backend_pid' is distinct from pg_backend_pid()::text
    or v_basis->>'owner_transaction_id' is distinct from pg_current_xact_id()::text
    or v_basis->>'owner_backend_pid' is distinct from pg_backend_pid()::text
    or v_frame->>'actor_user_id' is distinct from v_revision.finalised_by_user_id::text
    or v_frame->>'actor_user_id' is distinct from v_basis->>'actor_user_id'
    or v_frame->>'upload_id' is distinct from v_revision.upload_id::text
    or v_frame->>'source_cycle_id' is distinct from v_revision.source_cycle_id::text
    or v_frame->>'projection_publication_id' is distinct from v_basis->>'projection_publication_id'
    or v_frame->>'source_group_id' is distinct from v_basis#>>'{target_native_context,source_group_id}'
    or v_frame->>'client_id' is distinct from v_basis->>'client_id'
    or v_frame->'census' is distinct from v_revision.missing_cancel_basis_census
    or v_frame->>'census_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_MISSING_CANCEL_CENSUS_V1',v_revision.missing_cancel_basis_census),'hex') then
    raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_NATIVE_FRAME_CHANGED' using errcode='40001';
  end if;
  return new;
end;
$function$;

create or replace function private.bpay_next_source_current_capture_transition_v1(p_transition uuid)
returns jsonb language plpgsql security definer
set search_path='pg_catalog','private','public','pg_temp' as $f$
declare v_t public.weekly_source_state_transitions%rowtype;v_line public.weekly_source_final_snapshot_lines%rowtype;
  v_origin private.bpay_next_source_current_origins%rowtype;v_revision record;v_scope uuid;v_movement uuid;
  v_lineage uuid;v_economic uuid;v_inserted boolean;v_reversal public.weekly_source_billing_movements%rowtype;
  v_origin_resolution uuid;v_missing_basis jsonb;v_paid_basis jsonb;
begin
  select t.* into v_t from public.weekly_source_state_transitions t where t.id=p_transition;
  if not found then raise exception 'BPAY_NEXT_SOURCE_TRANSITION_MISSING' using errcode='55000';end if;
  select o.* into v_origin from private.bpay_next_source_current_origins o where o.origin_kind='TRANSITION' and o.origin_id=p_transition;
  if found and v_origin.source_hash is distinct from v_t.transition_fingerprint then
    raise exception 'BPAY_NEXT_SOURCE_ORIGIN_CHANGED' using errcode='55000';end if;
  if found and (v_origin.active or v_origin.retracted_by_session_id is not null) then
    return jsonb_build_object('origin_id',p_transition,'active',v_origin.active,'idempotent',true);end if;
  select * into strict v_revision from private.bpay_next_source_current_revision_v1(v_t.final_revision_id);
  select l.* into strict v_line from public.weekly_source_final_snapshot_lines l
    where l.id=coalesce(v_t.new_snapshot_line_id,v_t.previous_snapshot_line_id);
  v_scope:=private.bpay_next_source_current_scope_v1(v_line.row_resolution_id,v_revision.source_group_id,v_t.work_event_id,v_line.contract_id);
  select l.id into strict v_lineage from public.weekly_source_row_timesheet_lineages l where l.row_resolution_id=v_line.row_resolution_id;
  select e.id into strict v_economic from public.weekly_source_row_economic_snapshots e where e.row_resolution_id=v_line.row_resolution_id;
  v_origin_resolution:=v_line.row_resolution_id;
  if v_t.outcome in ('ADD','AMEND') then
    select m.id into strict v_movement from public.weekly_source_billing_movements m
      where m.transition_id=p_transition and m.movement_role=case when v_t.outcome='ADD' then 'POSITIVE' else 'REPLACEMENT' end;
  elsif v_t.outcome='NO_CHANGE' then
    -- The real transition gives an exact previous snapshot, not an invitation
    -- to rank the ledger. Its producer-maintained mapping preserves the prior
    -- original movement even though the new report restates equivalent money.
    if v_t.pay_basis_kind='RETAINED_PAID_MATCH' then
      v_paid_basis:=private.weekly_source_paid_match_retained_transition_assert_v1(v_t.id);
    end if;
    select s.movement_id into v_movement from private.bpay_next_source_current_snapshots s
      where s.snapshot_line_id=v_t.previous_snapshot_line_id and s.scope_id=v_scope and s.work_event_id=v_t.work_event_id;
    if v_paid_basis is not null and (v_paid_basis->>'snapshot_line_id' is distinct from v_t.previous_snapshot_line_id::text
      or v_paid_basis->>'movement_id' is distinct from v_movement::text
      or v_paid_basis->>'row_resolution_id' is distinct from v_origin_resolution::text
      or v_paid_basis->>'lineage_id' is distinct from v_lineage::text
      or v_paid_basis->>'economic_snapshot_id' is distinct from v_economic::text) then
      raise exception 'BPAY_NEXT_SOURCE_RETAINED_PAID_BASIS_UNBOUND' using errcode='55000';end if;
    if v_movement is null then raise exception 'BPAY_NEXT_SOURCE_PREVIOUS_SNAPSHOT_UNCAPTURED' using errcode='55000';end if;
  elsif v_t.outcome='CANCEL' and v_t.exclude_cancel then
    -- Shared Banking owner proposal, not approved or mounted. The real
    -- Source transition stays absent: new_present=false and new snapshot=NULL.
    -- Financial selection retains exactly its immutable original basis.
    v_missing_basis:=private.weekly_source_missing_cancel_transition_assert_v1(v_t.id);
    v_movement:=(v_missing_basis#>>'{original_basis,movement_id}')::uuid;
    v_origin_resolution:=(v_missing_basis#>>'{original_basis,row_resolution_id}')::uuid;
    v_lineage:=(v_missing_basis#>>'{original_basis,lineage_id}')::uuid;
    v_economic:=(v_missing_basis#>>'{original_basis,economic_snapshot_id}')::uuid;
    if private.bpay_next_source_current_scope_v1(v_origin_resolution,v_revision.source_group_id,v_t.work_event_id,v_line.contract_id)
      is distinct from v_scope then
      raise exception 'BPAY_NEXT_SOURCE_MISSING_CANCEL_SCOPE_CHANGED' using errcode='55000';
    end if;
  end if;
  if v_t.outcome in ('AMEND','CANCEL') and not v_t.exclude_cancel then
    select m.* into strict v_reversal from public.weekly_source_billing_movements m
      where m.transition_id=p_transition and m.movement_role='REVERSAL';
    if v_reversal.prior_movement_id is null or not exists(
      select 1 from private.bpay_next_source_current_snapshots s where s.snapshot_line_id=v_t.previous_snapshot_line_id
        and s.scope_id=v_scope and s.work_event_id=v_t.work_event_id and s.movement_id=v_reversal.prior_movement_id) then
      raise exception 'BPAY_NEXT_SOURCE_PRIOR_MOVEMENT_UNBOUND' using errcode='55000';end if;
  end if;
  if v_movement is not null and not exists(select 1 from public.weekly_source_billing_movements m
    where m.id=v_movement and m.work_event_id=v_t.work_event_id and m.contract_id=v_line.contract_id
      and m.candidate_id=v_line.candidate_id and m.actual_client_id=v_line.client_id
      and m.movement_role in ('POSITIVE','REPLACEMENT')) then
    raise exception 'BPAY_NEXT_SOURCE_TRANSITION_MOVEMENT_UNBOUND' using errcode='55000';end if;
  if v_t.outcome='CANCEL' and v_t.exclude_cancel then
    -- Record the genuine retained previous snapshot, including pre-NEXT
    -- history. This is the existing native provenance map, not a new/current
    -- snapshot or export-presence claim. The same original movement has just
    -- passed the immutable Source basis, exact scope and subject checks.
    insert into private.bpay_next_source_current_snapshots(snapshot_line_id,scope_id,work_event_id,movement_id)
      values(v_t.previous_snapshot_line_id,v_scope,v_t.work_event_id,v_movement) on conflict do nothing;
    if not exists(select 1 from private.bpay_next_source_current_snapshots s
      where s.snapshot_line_id=v_t.previous_snapshot_line_id and s.scope_id=v_scope
        and s.work_event_id=v_t.work_event_id and s.movement_id=v_movement) then
      raise exception 'BPAY_NEXT_SOURCE_SNAPSHOT_MAPPING_CHANGED' using errcode='55000';
    end if;
  end if;
  if v_t.new_snapshot_line_id is not null then
    insert into private.bpay_next_source_current_snapshots(snapshot_line_id,scope_id,work_event_id,movement_id)
      values(v_t.new_snapshot_line_id,v_scope,v_t.work_event_id,v_movement) on conflict do nothing;
    if not exists(select 1 from private.bpay_next_source_current_snapshots s where s.snapshot_line_id=v_t.new_snapshot_line_id
      and s.scope_id=v_scope and s.work_event_id=v_t.work_event_id and s.movement_id=v_movement) then
      raise exception 'BPAY_NEXT_SOURCE_SNAPSHOT_MAPPING_CHANGED' using errcode='55000';end if;
  end if;
  insert into private.bpay_next_source_current_events(scope_id,work_event_id,source_kind,source_present,source_group_id,client_id,work_date)
    select v_scope,v_t.work_event_id,'HR',false,v_revision.source_group_id,w.client_id,w.work_date
    from public.weekly_work_events w where w.id=v_t.work_event_id on conflict do nothing;
  if not exists(select 1 from private.bpay_next_source_current_events e where e.scope_id=v_scope
    and e.work_event_id=v_t.work_event_id and e.source_kind='HR') then
    raise exception 'BPAY_NEXT_SOURCE_EVENT_KIND_CHANGED' using errcode='55000';end if;
  insert into private.bpay_next_source_current_origins(origin_kind,origin_id,transition_id,scope_id,work_event_id,
    final_revision_id,order_key,source_hash,row_resolution_id,lineage_id,economic_snapshot_id,
    selected_movement_id,snapshot_line_id,representative_created_at)
    values('TRANSITION',p_transition,p_transition,v_scope,v_t.work_event_id,v_t.final_revision_id,v_revision.order_key,
      v_t.transition_fingerprint,v_origin_resolution,v_lineage,v_economic,v_movement,v_t.new_snapshot_line_id,v_t.created_at_utc)
    on conflict do nothing;
  v_inserted:=found;
  perform private.bpay_next_source_current_toggle_v1('TRANSITION',p_transition,v_revision.is_current);
  return jsonb_build_object('origin_id',p_transition,'active',v_revision.is_current,'idempotent',not v_inserted and not v_revision.is_current);
end $f$;

create or replace function private.weekly_source_missing_current_selection_v1(
  p_work_event_id uuid,p_root_timesheet_id uuid,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_context jsonb; v_native jsonb; v_basis jsonb;
  v_transition public.weekly_source_state_transitions%rowtype;
begin
  v_context:=private.weekly_source_kept_as_paid_context_v1(p_work_event_id,p_actor_user_id);
  if p_root_timesheet_id is null or not (v_context->'root_timesheet_ids') @> jsonb_build_array(p_root_timesheet_id) then
    raise exception 'WEEKLY_SOURCE_MISSING_SELECTION_ROOT_OUTSIDE_SCOPE' using errcode='42501';
  end if;
  if not exists(select 1 from private.bpay_next_module_control where id=1 and active_owner='NEXT') then
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_CURRENT_SELECTION_V1',
      'work_event_id',p_work_event_id,'root_timesheet_id',p_root_timesheet_id,
      'projection_publication_id',v_context->'projection_publication_id',
      'raw_export_present',v_context->'source_present','financial_source_present',null,
      'excluded_cancel_transition_id',null,'exclusion_target_matches_current_export',null,
      'retained_financial_basis',null,'native_current_selection',null,'native_context',v_context,
      'native_selection_availability','NEXT_OWNER_NOT_ACTIVE');
  end if;
  v_native:=private.bpay_next_source_current_event_v1(p_root_timesheet_id,p_work_event_id);
  if v_native->>'work_event_id' is distinct from p_work_event_id::text
    or v_native->>'root_timesheet_id' is distinct from p_root_timesheet_id::text then
    raise exception 'WEEKLY_SOURCE_MISSING_SELECTION_NATIVE_UNBOUND' using errcode='55000';
  end if;
  if v_native->>'transition_id' is not null then
    select * into strict v_transition from public.weekly_source_state_transitions where id=(v_native->>'transition_id')::uuid;
    if v_transition.exclude_cancel then
      v_basis:=private.weekly_source_missing_cancel_transition_assert_v1(v_transition.id);
      if v_basis#>>'{original_basis,movement_id}' is distinct from v_native->>'movement_id'
        or v_native->'source_present' is distinct from 'true'::jsonb
        or v_transition.work_event_id is distinct from p_work_event_id then
        raise exception 'WEEKLY_SOURCE_MISSING_SELECTION_RETAINED_UNBOUND' using errcode='55000';
      end if;
    end if;
  end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_CURRENT_SELECTION_V1',
    'work_event_id',p_work_event_id,'root_timesheet_id',p_root_timesheet_id,
    'projection_publication_id',v_context->'projection_publication_id',
    'raw_export_present',v_context->'source_present','financial_source_present',v_native->'source_present',
    'excluded_cancel_transition_id',case when v_basis is null then null else v_transition.id end,
    'exclusion_target_matches_current_export',case when v_basis is null then null
      else v_basis->>'projection_publication_id' is not distinct from v_context->>'projection_publication_id' end,
    'retained_financial_basis',v_basis,'native_current_selection',v_native,'native_context',v_context,
    'native_selection_availability','AVAILABLE');
end;
$function$;

create or replace function private.weekly_source_finalise_engine_v1(
  p_request jsonb,
  p_correction_session_id uuid,
  p_prepare_only boolean
) returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_allowed_keys constant text[]:=array[
    'actor_user_id','source_cycle_id','authority_scope_kind','report_scope_id',
    'upload_id','projection_publication_id','expected_authority_scope_version',
    'expected_row_manifest_hash','expected_comparison_manifest_hash',
    'expected_issue_set_hash','exclude_unfinalised_acknowledged'
  ]::text[];
  v_unknown_key text;
  v_actor uuid;
  v_cycle_id uuid;
  v_scope_kind text;
  v_report_scope_id uuid;
  v_upload_id uuid;
  v_publication_id uuid;
  v_scope_version bigint;
  v_expected_row_hash bytea;
  v_expected_comparison_hash bytea;
  v_expected_issue_hash bytea;
  v_cycle public.weekly_source_cycles%rowtype;
  v_scope public.weekly_source_report_scopes%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_profile public.weekly_source_format_profiles%rowtype;
  v_existing_revision public.weekly_source_final_revisions%rowtype;
  v_correction public.weekly_final_source_correction_sessions%rowtype;
  v_guard jsonb;
  v_client_id uuid;
  v_resolved_client_id uuid;
  v_resolved_client_count integer;
  v_source_profile_kind text;
  v_source_mode text;
  v_generation integer;
  v_coverage_start date;
  v_coverage_end date;
  v_prior_revision_id uuid;
  v_revision_number integer;
  v_revision_id uuid;
  v_revision_manifest_hash bytea;
  v_policy_fingerprint bytea;
  v_finalised_at timestamptz:=pg_catalog.transaction_timestamp();
  v_row record;
  v_finalisation_root_ids uuid[];
  v_finalisation_root_recheck uuid[];
  v_finalisation_lock_result jsonb;
  v_lock_phase integer;
  v_lock_discovery jsonb;
  v_window_discovery jsonb; v_window_observed jsonb; v_window_lock record;
  v_invoice_window_ids uuid[]; v_round_scope record; v_round_id uuid;
  v_lock_observed jsonb;
  v_finalisation_lock_context boolean:=false;
  v_next_source_hooks boolean:=false;
  v_finalisation_lock_operation uuid;
  v_prior_finalisation_lock_operation text;
  v_prior_finalisation_root_set text;
  v_economic_id uuid;
  v_timesheet_id uuid;
  v_economic public.weekly_source_row_economic_snapshots%rowtype;
  v_snapshot_id uuid;
  v_snapshot_hash bytea;
  v_mapping_fingerprint bytea;
  v_pay_vector jsonb;
  v_charge_vector jsonb;
  v_transition record;
  v_prior_snapshot public.weekly_source_final_snapshot_lines%rowtype;
  v_current_snapshot public.weekly_source_final_snapshot_lines%rowtype;
  v_prior_state bytea;
  v_current_state bytea;
  v_outcome text;
  v_transition_id uuid;
  v_transition_fingerprint bytea;
  v_prior_movement public.weekly_source_billing_movements%rowtype;
  v_correction_unit_id uuid;
  v_charge_check public.weekly_source_charge_checks%rowtype;
  v_charge_acceptance public.weekly_source_charge_acceptances%rowtype;
  v_price_admission_result text;
  v_movement_id uuid;
  v_backing_report_number text;
  v_source_total_cost bigint;
  v_source_commission bigint;
  v_source_invoice_total bigint;
  v_line_count integer;
  v_manifest record;
  v_client_manifest_id uuid;
  v_client_manifest_hash bytea;
  v_completion_generation integer;
  v_completion_hash bytea;
  v_expense_observation record;
  v_target_expense_pence bigint;
  v_target_expense_vat boolean;
  v_target_expense_contract_id uuid;
  v_expense_observation_kind text;
  v_current_expense public.weekly_expense_authority_generations%rowtype;
  v_expense_policy public.weekly_source_row_expense_policy_snapshots%rowtype;
  v_expense_generation integer;
  v_expense_hash bytea;
  v_expense_authority_id uuid;
  v_prior_expense_authority_id uuid;
  v_expense_timesheet_id uuid;
  v_expense_policy_id uuid;
  v_expense_movement_result jsonb;
  v_rule_set jsonb;
  v_rule_values jsonb;
  v_rule_version uuid;
  v_invoice_amounts jsonb;
  v_invoice_correction jsonb;
  v_effective_policy jsonb;
  v_authority_subset jsonb;
  v_prior_authority_subset jsonb;
  v_current_authority_subset jsonb;
  v_comparison_current_authority jsonb;
  v_correction_presentation text;
  v_movement_count integer:=0;
  v_transition_count integer:=0;
  v_snapshot_count integer:=0;
  v_unchanged_count integer:=0;
  v_expense_generation_count integer:=0;
begin
  perform pg_catalog.set_config('lock_timeout','5s',true);
  if coalesce(current_setting('request.jwt.claim.role',true),
       nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
  end if;
  if p_prepare_only is null
     or (p_prepare_only and p_correction_session_id is null)
     or (not p_prepare_only and p_correction_session_id is not null) then
    raise exception 'WEEKLY_SOURCE_FINALISE_EXECUTION_MODE_INVALID' using errcode='22023';
  end if;
  if p_request is null or pg_catalog.jsonb_typeof(p_request)<>'object' then
    raise exception 'WEEKLY_SOURCE_FINALISE_REQUEST_INVALID' using errcode='22023';
  end if;
  select key into v_unknown_key
  from pg_catalog.jsonb_object_keys(p_request) key
  where not (key=any(v_allowed_keys))
  order by key limit 1;
  if v_unknown_key is not null then
    raise exception 'WEEKLY_SOURCE_FINALISE_REQUEST_UNKNOWN_FIELD'
      using errcode='22023',detail=v_unknown_key;
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_cycle_id:=(p_request->>'source_cycle_id')::uuid;
    v_scope_kind:=pg_catalog.upper(pg_catalog.btrim(coalesce(p_request->>'authority_scope_kind','')));
    v_report_scope_id:=nullif(p_request->>'report_scope_id','')::uuid;
    v_upload_id:=(p_request->>'upload_id')::uuid;
    v_publication_id:=(p_request->>'projection_publication_id')::uuid;
    v_scope_version:=(p_request->>'expected_authority_scope_version')::bigint;
  exception when invalid_text_representation or numeric_value_out_of_range then
    raise exception 'WEEKLY_SOURCE_FINALISE_REQUEST_INVALID' using errcode='22023';
  end;
  if v_actor is null or v_cycle_id is null or v_upload_id is null
     or v_publication_id is null or v_scope_version is null or v_scope_version<1
     or v_scope_kind not in ('CYCLE','NHSP_REPORT_SCOPE','SELF_BILL_REPORT_SCOPE')
     or (v_scope_kind in ('NHSP_REPORT_SCOPE','SELF_BILL_REPORT_SCOPE')) is distinct from (v_report_scope_id is not null) then
    raise exception 'WEEKLY_SOURCE_FINALISE_SCOPE_INVALID' using errcode='22023';
  end if;
  v_expected_row_hash:=private.weekly_source_finalisation_hex32_v1(
    p_request->>'expected_row_manifest_hash','WEEKLY_SOURCE_ROW_MANIFEST_HASH_REQUIRED'
  );
  v_expected_comparison_hash:=private.weekly_source_finalisation_hex32_v1(
    p_request->>'expected_comparison_manifest_hash','WEEKLY_SOURCE_COMPARISON_HASH_REQUIRED'
  );
  v_expected_issue_hash:=private.weekly_source_finalisation_hex32_v1(
    p_request->>'expected_issue_set_hash','WEEKLY_SOURCE_ISSUE_HASH_REQUIRED'
  );

  -- Fresh Final admission precedes the first cycle/business lock. Recursive
  -- lineage/current-publication owners inherit this transaction's admission.
  perform private.weekly_source_pay_query_admit_v2();

  -- Qualified operational Report arm AFTER unchanged payload/ID/hash/native admission.
  -- The exact explicit four-argument A/B qualification owner remains unchanged.
  if v_scope_kind='SELF_BILL_REPORT_SCOPE' then
    select * into v_scope from public.weekly_source_report_scopes where id=v_report_scope_id;
    select * into v_cycle from public.weekly_source_cycles where id=v_cycle_id;
    if v_scope.id is null or v_cycle.id is null or v_scope.self_bill_report_id is null
      or v_scope.source_cycle_id is distinct from v_cycle.id
      or v_scope.source_group_id is distinct from v_cycle.source_group_id then
      raise exception 'WEEKLY_SOURCE_REPORT_SCOPE_MISMATCH' using errcode='22023'; end if;
    perform private.weekly_source_office_authority_v1(v_actor,
      case when p_prepare_only then 'CORRECT_FINAL_SOURCE' else 'FINALISE_WEEK' end,
      v_cycle.source_group_id,v_scope.client_id,v_cycle.finalisation_week_ending);
    if p_prepare_only or p_correction_session_id is not null then
      raise exception 'WEEKLY_SOURCE_SELF_BILL_REPORT_CORRECT_FINAL_UNSUPPORTED' using errcode='55000'; end if;
    return private.weekly_source_report_fin_dispatch_v1(p_request);
  end if;

  -- All genuine ordinary callers share the one corrected complete FIN4 owner.
  -- The validated Report early arm and native payload/actor/error prefix above
  -- remain unchanged; rounding variant NULL is unused for ordinary scopes.
  return private.weekly_source_finalise_engine_v1(p_request,p_correction_session_id,p_prepare_only,null::text);

  -- G1 plain scope discovery -> native complete I-1 -> group -> cycle.
  -- Repeat the same guards under locks; changed source/rules/roots retry before any mutation.
  for v_lock_phase in 1..2 loop
  if v_lock_phase=2 then
    -- Use the discovered exact group, never a fresh group chosen after I-1.
    select * into v_group from public.weekly_source_groups
    where id=(v_lock_discovery#>>'{group,id}')::uuid for update;
    if not found or to_jsonb(v_group) is distinct from v_lock_discovery->'group' then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
    -- Complete source + candidate invoice windows were discovered BEFORE I-1.
    -- Take every cycle in UUID order, then compare full original row witnesses.
    for v_window_lock in select cycle.* from public.weekly_source_cycles cycle
      where cycle.id=any(v_invoice_window_ids) order by cycle.id for update
    loop
      if to_jsonb(v_window_lock) is distinct from v_window_discovery->'cycles'->v_window_lock.id::text then
        raise exception 'WEEKLY_SOURCE_INVOICE_WINDOW_SET_CHANGED_DURING_LOCK' using errcode='40001'; end if;
    end loop;
    if (select count(*) from public.weekly_source_cycles cycle where cycle.id=any(v_invoice_window_ids))<>cardinality(v_invoice_window_ids) then
      raise exception 'WEEKLY_SOURCE_INVOICE_WINDOW_SET_CHANGED_DURING_LOCK' using errcode='40001'; end if;
    select * into v_cycle from public.weekly_source_cycles where id=v_cycle_id;
    if not found or to_jsonb(v_cycle) is distinct from v_lock_discovery->'cycle' then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
  else
    select * into v_cycle from public.weekly_source_cycles where id=v_cycle_id;
  end if;
  if not found then
    raise exception 'WEEKLY_SOURCE_CYCLE_NOT_FOUND' using errcode='22023';
  end if;
  select * into strict v_group
  from public.weekly_source_groups where id=v_cycle.source_group_id;
  if v_scope_kind='NHSP_REPORT_SCOPE' then
  if v_lock_phase=2 then
    select * into v_scope from public.weekly_source_report_scopes where id=v_report_scope_id for update;
    if not found or to_jsonb(v_scope) is distinct from v_lock_discovery->'scope' then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
  else
    select * into v_scope from public.weekly_source_report_scopes where id=v_report_scope_id;
  end if;
    if not found or v_scope.source_cycle_id is distinct from v_cycle.id
       or v_scope.source_group_id is distinct from v_group.id
       or v_scope.environment is distinct from v_group.environment
       or v_scope.agency_id is distinct from v_group.agency_id
       or v_scope.cutoff_at_utc is distinct from v_cycle.cutoff_at_utc then
      raise exception 'WEEKLY_SOURCE_REPORT_SCOPE_MISMATCH' using errcode='22023';
    end if;
  end if;
  if v_lock_phase=2 then
    select * into v_upload from public.weekly_source_uploads where id=v_upload_id for share;
    if not found or to_jsonb(v_upload) is distinct from v_lock_discovery->'upload' then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
  else
    select * into v_upload from public.weekly_source_uploads where id=v_upload_id;
  end if;
  if not found then
    raise exception 'WEEKLY_SOURCE_UPLOAD_NOT_FOUND' using errcode='22023';
  end if;
  if v_lock_phase=2 then
    select * into v_publication from public.weekly_source_projection_publications where id=v_publication_id for share;
    if not found or to_jsonb(v_publication) is distinct from v_lock_discovery->'publication' then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
  else
    select * into strict v_publication from public.weekly_source_projection_publications where id=v_publication_id;
  end if;
  select * into strict v_profile
  from public.weekly_source_format_profiles where id=v_upload.source_format_profile_id;
  if v_lock_phase=2 and to_jsonb(v_profile) is distinct from v_lock_discovery->'profile' then
    raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;

  if p_prepare_only then
  if v_lock_phase=2 then
    select * into v_correction from public.weekly_final_source_correction_sessions where id=p_correction_session_id for share;
    if not found or to_jsonb(v_correction) is distinct from v_lock_discovery->'correction' then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
  else
    select * into v_correction from public.weekly_final_source_correction_sessions where id=p_correction_session_id;
  end if;
    if not found or v_correction.state<>'PREPARING'
       or v_correction.source_cycle_id is distinct from v_cycle.id
       or v_correction.authority_scope_kind is distinct from v_scope_kind
       or v_correction.report_scope_id is distinct from v_report_scope_id
       or v_correction.replacement_correction_upload_id is distinct from v_upload.id
       or v_correction.replacement_projection_publication_id is distinct from v_publication.id
       or v_upload.purpose<>'FINAL_SOURCE_CORRECTION'
       or v_upload.correction_session_id is distinct from v_correction.id
       or v_upload.state<>'CORRECTION_READY'
       or v_publication.state<>'CORRECTION_READY'
       or v_publication.correction_session_id is distinct from v_correction.id
       or v_publication.upload_id is distinct from v_upload.id
       or v_publication.authority_scope_version is distinct from v_scope_version then
      raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_STALE' using errcode='40001';
    end if;
    v_guard:=pg_catalog.jsonb_build_object(
      'row_manifest_hash',pg_catalog.encode(v_upload.row_manifest_hash,'hex'),
      'comparison_manifest_hash',pg_catalog.encode(v_publication.comparison_manifest_hash,'hex'),
      'issue_set_hash',pg_catalog.encode(v_publication.issue_set_hash,'hex')
    );
  else
    v_guard:=private.weekly_source_current_publication_guard_v1(
      v_cycle.id,v_scope_kind,v_report_scope_id,v_upload.id,v_publication.id,v_scope_version
    );
  end if;
  if private.weekly_source_finalisation_hex32_v1(
       v_guard->>'row_manifest_hash','WEEKLY_SOURCE_GUARD_ROW_HASH_INVALID'
     ) is distinct from v_expected_row_hash
     or private.weekly_source_finalisation_hex32_v1(
       v_guard->>'comparison_manifest_hash','WEEKLY_SOURCE_GUARD_COMPARISON_HASH_INVALID'
     ) is distinct from v_expected_comparison_hash
     or private.weekly_source_finalisation_hex32_v1(
       v_guard->>'issue_set_hash','WEEKLY_SOURCE_GUARD_ISSUE_HASH_INVALID'
     ) is distinct from v_expected_issue_hash then
    raise exception 'WEEKLY_SOURCE_FINALISE_PREVIEW_CHANGED' using errcode='40001';
  end if;

  v_client_id:=case when v_scope_kind='NHSP_REPORT_SCOPE' then v_scope.client_id
    else nullif(v_upload.file_metadata_json->>'client_id','')::uuid end;
  perform private.weekly_source_office_authority_v1(
    v_actor,case when p_prepare_only then 'CORRECT_FINAL_SOURCE' else 'FINALISE_WEEK' end,
    v_group.id,v_client_id,v_cycle.finalisation_week_ending
  );
  if p_correction_session_id is null then
    if v_upload.purpose<>'ORDINARY' or v_upload.correction_session_id is not null then
      raise exception 'WEEKLY_SOURCE_CORRECTION_REQUIRES_DEDICATED_OWNER' using errcode='55000';
    end if;
  else
    if v_correction.id is null or v_correction.state<>'PREPARING'
       or v_correction.source_cycle_id is distinct from v_cycle.id
       or v_correction.authority_scope_kind is distinct from v_scope_kind
       or v_correction.report_scope_id is distinct from v_report_scope_id
       or v_correction.replacement_correction_upload_id is distinct from v_upload.id
       or v_correction.replacement_projection_publication_id is distinct from v_publication.id
       or v_upload.purpose<>'FINAL_SOURCE_CORRECTION'
       or v_upload.correction_session_id is distinct from v_correction.id then
      raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_STALE' using errcode='40001';
    end if;
  end if;
  perform private.weekly_source_final_upload_assert_v1(v_upload.id);
  if not private.weekly_source_import_is_prepared_v1(v_upload.id) then
    raise exception 'WEEKLY_SOURCE_CHECKING_FILE_NOT_FINALISABLE' using errcode='55000';
  end if;
  if v_profile.profile_code in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1')
    and exists(select 1 from public.weekly_source_upload_rows source_row
      where source_row.upload_id=v_upload.id and source_row.row_finalisation_state='SOURCE_UNFINALISED')
    and p_request->'exclude_unfinalised_acknowledged' is distinct from 'true'::jsonb then
    raise exception 'WEEKLY_SOURCE_UNFINALISED_EXCLUSION_ACKNOWLEDGEMENT_REQUIRED' using errcode='55000';
  end if;
  if v_finalised_at<coalesce(v_scope.cutoff_at_utc,v_cycle.cutoff_at_utc)
    and v_profile.profile_code not in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1') then
    raise exception 'WEEKLY_SOURCE_CUTOFF_NOT_REACHED' using errcode='55000';
  end if;

  if v_upload.state<>(case when p_prepare_only then 'CORRECTION_READY' else 'CURRENT' end)
     or v_upload.row_manifest_hash is null
     or v_upload.blocked_count<>0 or v_upload.blocking_economic_duplicate_count<>0
     or v_upload.malformed_count<>0
     or v_upload.physical_row_count<>
       v_upload.header_count+v_upload.trailer_count+v_upload.continuation_count+
       v_upload.accepted_count+v_upload.blocking_economic_duplicate_count+v_upload.malformed_count
     or (select pg_catalog.count(*) from public.weekly_source_upload_rows
         where upload_id=v_upload.id)<>v_upload.accepted_count then
    raise exception 'WEEKLY_SOURCE_UPLOAD_NOT_FINALISABLE' using errcode='55000';
  end if;
  -- WP-54, pack 03 section 7: "Overlapping candidate work events are checked
  -- BEFORE FINALISATION.  The system does not assume two overlapping records
  -- are valid because their references differ."  The same guard runs at the
  -- seal, where a refused report never becomes CURRENT.  It runs again here
  -- because this is the owner the pack names and because the rows this engine
  -- is about to turn into movements are the rows that must satisfy it -- pack
  -- 14 section 8.1, the database decides source authority, never the browser.
  -- Deliberately NOT accompanied by a cutoff re-check: NHSP-BR-006 governs the
  -- cutoff occurrence Office confirms when the report is accepted, and the
  -- seal is where that confirmation is made authoritative.
  perform private.weekly_source_overlap_admission_assert_v1(v_upload.id);
  if v_scope_version>2147483647
     or coalesce(v_publication.projection_generation,0)>2147483647 then
    raise exception 'WEEKLY_SOURCE_GENERATION_OVERFLOW' using errcode='22003';
  end if;
  v_generation:=coalesce(
    v_publication.projection_generation,
    v_scope_version::integer
  );
  if (select pg_catalog.count(*)
      from public.weekly_source_row_resolutions resolution
      join public.weekly_source_upload_rows source_row on source_row.id=resolution.upload_row_id
      where source_row.upload_id=v_upload.id and resolution.generation=v_generation)
       <>v_upload.accepted_count
     or exists(
       select 1
       from public.weekly_source_upload_rows source_row
       left join public.weekly_source_row_resolutions resolution
         on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
       where source_row.upload_id=v_upload.id
         and (resolution.id is null or resolution.mapping_state<>'RESOLVED')
     )
     or (v_profile.final_authority_kind<>'NHSP_TRUST_BACKING_REPORT' and exists(
       select 1
       from public.weekly_source_row_resolutions resolution
       join public.weekly_source_upload_rows source_row on source_row.id=resolution.upload_row_id
       where source_row.upload_id=v_upload.id and resolution.generation=v_generation
       group by resolution.work_event_id having pg_catalog.count(*)<>1
     )) then
    raise exception 'WEEKLY_SOURCE_RESOLUTION_CENSUS_NOT_FINALISABLE' using errcode='55000';
  end if;
  if v_scope_kind='CYCLE' then
    select pg_catalog.count(distinct resolution.client_id)::integer,
           pg_catalog.min(resolution.client_id::text)::uuid
    into v_resolved_client_count,v_resolved_client_id
    from public.weekly_source_row_resolutions resolution
    join public.weekly_source_upload_rows source_row on source_row.id=resolution.upload_row_id
    where source_row.upload_id=v_upload.id and resolution.generation=v_generation;
    if v_resolved_client_count>1 then
      raise exception 'WEEKLY_SOURCE_SINGLE_CLIENT_RESOLUTION_REQUIRED' using errcode='55000';
    end if;
    if v_resolved_client_count=1 and v_client_id is not null
       and v_client_id is distinct from v_resolved_client_id then
      raise exception 'WEEKLY_SOURCE_UPLOAD_CLIENT_MISMATCH' using errcode='55000';
    end if;
    v_client_id:=coalesce(v_resolved_client_id,v_client_id);
    if v_cycle.scope_client_id is not null and v_cycle.scope_client_id is distinct from v_client_id then
      raise exception 'WEEKLY_SOURCE_FINAL_CLIENT_SCOPE_REQUIRED' using errcode='55000';
    end if;
    if v_client_id is null or not exists(
      select 1
      from public.weekly_source_group_clients group_client
      where group_client.source_group_id=v_group.id
        and group_client.client_id=v_client_id
        and v_cycle.finalisation_week_ending between group_client.valid_from
          and coalesce(group_client.valid_to,'infinity'::date)
    ) then
      raise exception 'WEEKLY_SOURCE_FINAL_CLIENT_SCOPE_REQUIRED' using errcode='55000';
    end if;
    perform private.weekly_source_office_authority_v1(
      v_actor,case when p_prepare_only then 'CORRECT_FINAL_SOURCE' else 'FINALISE_WEEK' end,
      v_group.id,v_client_id,v_cycle.finalisation_week_ending
    );
  elsif not exists(
    select 1
    from public.weekly_source_group_clients group_client
    where group_client.source_group_id=v_group.id
      and group_client.client_id=v_client_id
      and v_cycle.finalisation_week_ending between group_client.valid_from
        and coalesce(group_client.valid_to,'infinity'::date)
  ) then
    raise exception 'WEEKLY_SOURCE_FINAL_CLIENT_SCOPE_REQUIRED' using errcode='55000';
  end if;

  v_rule_set:=private.weekly_source_effective_rule_set_v1(v_client_id,v_cycle.id);
  v_rule_values:=v_rule_set->'values'; v_rule_version:=nullif(v_rule_set->>'rule_set_version_id','')::uuid;
  v_source_profile_kind:=v_profile.final_authority_kind;
  if v_profile.profile_code='NHSP_FINAL_BACKING_V1' then
    if v_scope_kind<>'NHSP_REPORT_SCOPE' or v_group.source_family<>'NHSP'
       or v_source_profile_kind<>'NHSP_TRUST_BACKING_REPORT'
       or v_profile.omission_meaning<>'NO_INFERENCE'
       or not v_profile.report_number_required or not v_profile.fmc_must_equal_zero
       or v_client_id is null
       or exists(select 1 from public.weekly_source_upload_rows source_row
         where source_row.upload_id=v_upload.id
           and (source_row.row_finalisation_state not in ('NOT_APPLICABLE','SOURCE_WORKED')
              or source_row.source_money_parse_state<>'VALID'
              or source_row.source_shift_charge_pence is null
              or source_row.source_expense_parse_state<>'NOT_APPLICABLE'
             or source_row.source_expense_pence is not null)) then
      raise exception 'WEEKLY_SOURCE_NHSP_FINAL_NOT_FINALISABLE' using errcode='55000';
    end if;
    v_source_mode:='NHSP_WEEKLY';
    v_coverage_start:=null;
    v_coverage_end:=null;
    v_backing_report_number:=private.weekly_source_canonical_report_number_v1(
      v_upload.file_metadata_json->>'nhsp_report_number'
    );
    if v_backing_report_number is null then
      raise exception 'WEEKLY_SOURCE_NHSP_REPORT_NUMBER_REQUIRED' using errcode='55000';
    end if;
  elsif v_profile.profile_code in (
    'HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1'
  ) then
    if v_scope_kind<>'CYCLE' or v_group.source_family<>'ROSTER'
       or v_source_profile_kind<>'HEALTHROSTER_ACTUAL_ROWS'
       or v_profile.omission_meaning<>'CANCEL_INSIDE_CONFIRMED_COVERAGE'
       or v_client_id is null
       or exists(select 1 from public.weekly_source_upload_rows source_row
         where source_row.upload_id=v_upload.id
           and (source_row.row_finalisation_state not in ('SOURCE_WORKED','SOURCE_UNFINALISED')
             or source_row.source_expense_parse_state<>'NOT_APPLICABLE'
             or source_row.source_expense_pence is not null)) then
      raise exception 'WEEKLY_SOURCE_HEALTHROSTER_NOT_FINALISABLE' using errcode='55000';
    end if;
    v_source_mode:='HEALTHROSTER_WEEKLY';
    v_coverage_start:=v_upload.confirmed_coverage_start_local_date;
    v_coverage_end:=v_upload.confirmed_coverage_end_local_date;
  elsif v_profile.profile_code='ROSTER_WEEKLY_SUMMARY_ACTUAL_V1' then
    if v_scope_kind<>'CYCLE' or v_group.source_family<>'ROSTER'
       or v_source_profile_kind<>'GENERIC_COMPLETE_SNAPSHOT'
       or v_profile.omission_meaning<>'CANCEL_INSIDE_CONFIRMED_COVERAGE'
       or v_client_id is null
       or exists(select 1 from public.weekly_source_upload_rows source_row
         where source_row.upload_id=v_upload.id
           and (source_row.row_finalisation_state not in ('NOT_APPLICABLE','SOURCE_WORKED','SOURCE_ABSENT_ZERO')
             or source_row.source_expense_parse_state not in ('NOT_APPLICABLE','VALID','OMITTED_ZERO')
             or (source_row.source_expense_parse_state='NOT_APPLICABLE')
                  is distinct from (source_row.source_expense_pence is null)
             or (source_row.source_expense_parse_state='OMITTED_ZERO'
                 and source_row.source_expense_pence<>0))) then
      raise exception 'WEEKLY_SOURCE_ROSTER_COMPLETE_NOT_FINALISABLE' using errcode='55000';
    end if;
    v_source_mode:='HEALTHROSTER_WEEKLY';
    v_coverage_start:=v_upload.confirmed_coverage_start_local_date;
    v_coverage_end:=v_upload.confirmed_coverage_end_local_date;
  else
    raise exception 'WEEKLY_SOURCE_PROFILE_NOT_FINAL_AUTHORITY' using errcode='55000';
  end if;
  if v_scope_kind='CYCLE' and (
    v_upload.coverage_state<>'COMPLETE' or v_upload.coverage_timezone<>'Europe/London'
    or v_coverage_start is null or v_coverage_end is null or v_coverage_start>v_coverage_end
  ) then
    raise exception 'WEEKLY_SOURCE_CONFIRMED_COVERAGE_REQUIRED' using errcode='55000';
  end if;
  if exists(
    select 1
    from public.weekly_source_row_resolutions resolution
    join public.weekly_source_upload_rows source_row on source_row.id=resolution.upload_row_id
    where source_row.upload_id=v_upload.id and resolution.generation=v_generation
      and (resolution.client_id is distinct from v_client_id
        or source_row.work_date<coalesce(v_coverage_start,source_row.work_date)
        or source_row.work_date>coalesce(v_coverage_end,source_row.work_date))
  ) then
    raise exception 'WEEKLY_SOURCE_RESOLUTION_OUTSIDE_FINAL_SCOPE' using errcode='55000';
  end if;

  v_window_observed:=private.weekly_source_invoice_window_lock_inventory_v1(v_upload.id,v_generation,v_cycle.id,v_client_id);
  if v_lock_phase=1 then
    v_window_discovery:=v_window_observed;
    select array_agg(key::uuid order by key::uuid) into v_invoice_window_ids
      from jsonb_object_keys(v_window_discovery->'cycles') key;
  elsif v_window_observed is distinct from v_window_discovery then
    raise exception 'WEEKLY_SOURCE_INVOICE_WINDOW_SET_CHANGED_DURING_LOCK' using errcode='40001'; end if;
  v_lock_observed:=jsonb_build_object(
    'group',to_jsonb(v_group),'cycle',to_jsonb(v_cycle),'scope',to_jsonb(v_scope),
    'upload',to_jsonb(v_upload),'publication',to_jsonb(v_publication),
    'profile',to_jsonb(v_profile),'correction',to_jsonb(v_correction),
    'client_id',v_client_id,'generation',v_generation,'coverage_start',v_coverage_start,
    'coverage_end',v_coverage_end,'source_profile_kind',v_source_profile_kind,
    'rule_set',v_rule_set,'resolutions',coalesce((select jsonb_agg(to_jsonb(r) order by r.id)
      from public.weekly_source_row_resolutions r join public.weekly_source_upload_rows s on s.id=r.upload_row_id
      where s.upload_id=v_upload.id and r.generation=v_generation),'[]'::jsonb));
  if v_lock_phase=1 then
    v_lock_discovery:=v_lock_observed;
  -- Review F2.  Finalisation calls the lineage ensure owner once per source row
  -- inside ONE transaction, so without this it accumulates family lock sets in
  -- source_row_ordinal order rather than the (btrim(booking_id), booking_id)
  -- order proof/32 section 6 step 2 fixes.  That is an A-B / B-A cycle against
  -- any sorted I-1 caller -- a publication, a release tick or a first
  -- authorisation -- and the I-1 caller was the victim (reproduction D3).
  --
  -- The complete set of roots this cycle will touch is therefore locked ONCE,
  -- up front, through the same helper, which sorts them.  Every later per-row
  -- call then re-enters locks this transaction already holds.
  --
  -- The Candidate serial gate is deliberately NOT taken here.  proof/32
  -- section 6 step 1 makes the gate per Candidate and pins it to four job
  -- types: first authorisation, first-authorisation withdrawal, entitlement
  -- publication and pending release.  Finalisation is none of them -- it
  -- authorises nothing and publishes no entitlement -- and one finalisation
  -- spans many Candidates, so a single gate call cannot cover it and a gate per
  -- Candidate would invent a lock ladder the pack does not describe.
  -- proof/34 section 5 asks this path only for the family lock set and the
  -- resolver, which is exactly what it takes.
  v_prior_finalisation_lock_operation:=coalesce(pg_catalog.current_setting('cloudtms.weekly_source_finalisation_lock_operation',true),'');
  v_prior_finalisation_root_set:=coalesce(pg_catalog.current_setting('cloudtms.weekly_source_finalisation_root_set',true),'');
  v_finalisation_lock_context:=true;
  select active_owner='NEXT' into v_next_source_hooks
  from private.bpay_next_module_control where id=1 for share;
  if coalesce(v_next_source_hooks,false) then

  -- Include prior-only CURRENT HR cancellation and positive-expense omission
  -- roots BEFORE taking any booking key. Current partial indexes provide the
  -- coverage inventory; only this upload/exact corrected revision contributes
  -- immutable emitted roots. No historical chooser is added here.
  v_finalisation_lock_operation:=private.bpay_next_source_current_lock_inventory_v1(
    v_upload.id,v_generation,case when p_prepare_only then v_correction.expected_current_final_revision_id else null end,
    v_group.id,v_client_id,v_coverage_start,v_coverage_end
  );
  perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_lock_operation',v_finalisation_lock_operation::text,true);
  perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_root_set','',true);
  else
  -- Retained default LEGACY / DISABLED Source path: no selector inventory,
  -- no assumption that pre-existing Source facts have been bootstrapped.
  select pg_catalog.array_agg(distinct contract_week.timesheet_id order by contract_week.timesheet_id)
  into v_finalisation_root_ids
  from public.weekly_source_upload_rows source_row
  join public.weekly_source_row_resolutions resolution
    on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
  join public.contract_weeks contract_week
    on contract_week.contract_id=resolution.contract_id
   and contract_week.additional_seq=0
   and contract_week.week_ending_date=source_row.work_date+
       ((coalesce((
          select contract.week_ending_weekday_snapshot
          from public.contracts contract where contract.id=resolution.contract_id
        ),0)-extract(dow from source_row.work_date)::integer+7)%7)
  where source_row.upload_id=v_upload.id
    and contract_week.timesheet_id is not null;

  if v_finalisation_root_ids is not null
     and pg_catalog.array_length(v_finalisation_root_ids,1) is not null then
    v_finalisation_lock_result:=private.weekly_source_lock_family_rows_v1(
      v_finalisation_root_ids,null
    );
    if coalesce((v_finalisation_lock_result->>'ok')::boolean,false) is not true then
      raise exception '%',v_finalisation_lock_result->>'code'
        using errcode='55000',detail=v_finalisation_lock_result::text;
    end if;
  end if;

  -- Review G2.  The set above was computed from an UNLOCKED read filtered on a
  -- non-null Contract Week Timesheet id, so a root another owner commits between
  -- that read and the loop would be locked later, in source-row order, out of
  -- the sorted order proof/32 section 6 step 2 fixes.  Recompute it under the
  -- family locks now held; if it grew, refuse retryably (40001) rather than take
  -- a second lock set out of order.  A retry recomputes the larger set up front.
  select pg_catalog.array_agg(distinct contract_week.timesheet_id order by contract_week.timesheet_id)
  into v_finalisation_root_recheck
  from public.weekly_source_upload_rows source_row
  join public.weekly_source_row_resolutions resolution
    on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
  join public.contract_weeks contract_week
    on contract_week.contract_id=resolution.contract_id
   and contract_week.additional_seq=0
   and contract_week.week_ending_date=source_row.work_date+
       ((coalesce((
          select contract.week_ending_weekday_snapshot
          from public.contracts contract where contract.id=resolution.contract_id
        ),0)-extract(dow from source_row.work_date)::integer+7)%7)
  where source_row.upload_id=v_upload.id
    and contract_week.timesheet_id is not null;

  if coalesce(v_finalisation_root_recheck,array[]::uuid[])
     <>coalesce(v_finalisation_root_ids,array[]::uuid[]) then
    raise exception 'WEEKLY_SOURCE_FINALISATION_ROOT_SET_CHANGED_DURING_LOCK'
      using errcode='40001',
        detail=pg_catalog.jsonb_build_object(
          'locked_root_count',
            coalesce(pg_catalog.array_length(v_finalisation_root_ids,1),0),
          'observed_root_count',
            coalesce(pg_catalog.array_length(v_finalisation_root_recheck,1),0)
        )::text;
  end if;

  -- Publish the locked set for the per-row calls.  The lineage ensure owner
  -- refuses 40001 when it discovers a root this set does not contain, so a root
  -- that appears after the recheck can never be locked out of order either.
  -- This is a Weekly-Source-private setting, never a Workbench-owned one.
  perform pg_catalog.set_config(
    'cloudtms.weekly_source_finalisation_root_set',
    coalesce(pg_catalog.array_to_string(v_finalisation_root_ids,','),'EMPTY_LOCKED_SET'),
    true
  );
  perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_lock_operation','',true);
  end if;


  else
    if v_lock_observed is distinct from v_lock_discovery then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
    if v_finalisation_lock_operation is not null then
      perform private.bpay_next_source_current_lock_recheck_v1(v_finalisation_lock_operation);
    else
  -- Review G2.  The set above was computed from an UNLOCKED read filtered on a
  -- non-null Contract Week Timesheet id, so a root another owner commits between
  -- that read and the loop would be locked later, in source-row order, out of
  -- the sorted order proof/32 section 6 step 2 fixes.  Recompute it under the
  -- family locks now held; if it grew, refuse retryably (40001) rather than take
  -- a second lock set out of order.  A retry recomputes the larger set up front.
  select pg_catalog.array_agg(distinct contract_week.timesheet_id order by contract_week.timesheet_id)
  into v_finalisation_root_recheck
  from public.weekly_source_upload_rows source_row
  join public.weekly_source_row_resolutions resolution
    on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
  join public.contract_weeks contract_week
    on contract_week.contract_id=resolution.contract_id
   and contract_week.additional_seq=0
   and contract_week.week_ending_date=source_row.work_date+
       ((coalesce((
          select contract.week_ending_weekday_snapshot
          from public.contracts contract where contract.id=resolution.contract_id
        ),0)-extract(dow from source_row.work_date)::integer+7)%7)
  where source_row.upload_id=v_upload.id
    and contract_week.timesheet_id is not null;

  if coalesce(v_finalisation_root_recheck,array[]::uuid[])
     <>coalesce(v_finalisation_root_ids,array[]::uuid[]) then
    raise exception 'WEEKLY_SOURCE_FINALISATION_ROOT_SET_CHANGED_DURING_LOCK'
      using errcode='40001',
        detail=pg_catalog.jsonb_build_object(
          'locked_root_count',
            coalesce(pg_catalog.array_length(v_finalisation_root_ids,1),0),
          'observed_root_count',
            coalesce(pg_catalog.array_length(v_finalisation_root_recheck,1),0)
        )::text;
  end if;


    end if;
  end if;
  end loop;

  -- One transaction at a time may decide the final order for a logical
  -- group/Client/source-authority history.  Both supported HealthRoster
  -- layouts share the same final_authority_kind and therefore the same lock.
  -- The lock is acquired only after the exact current publication and Client
  -- have been resolved; no other owner acquires this finaliser-only domain.
  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended(
    'weekly_source_finalise_order:'||v_group.id::text||':'||v_client_id::text||':'||v_source_profile_kind,
    0
  ));

  if p_prepare_only then
    if coalesce(v_scope.current_final_revision_id,v_cycle.current_final_revision_id)
         is distinct from v_correction.expected_current_final_revision_id then
      raise exception 'WEEKLY_SOURCE_CORRECTION_FINAL_REVISION_STALE' using errcode='40001';
    end if;
  elsif coalesce(v_scope.current_final_revision_id,v_cycle.current_final_revision_id) is not null then
    select * into strict v_existing_revision
    from public.weekly_source_final_revisions
    where id=coalesce(v_scope.current_final_revision_id,v_cycle.current_final_revision_id);
    if v_existing_revision.upload_id=v_upload.id
       and v_existing_revision.authority_scope_kind=v_scope_kind
       and v_existing_revision.report_scope_id is not distinct from v_report_scope_id
       and v_existing_revision.state='CURRENT' then
      -- Native operation is transaction-local, including exact immutable replay.
      if v_finalisation_lock_operation is not null then
        perform private.bpay_next_source_current_lock_release_v1(v_finalisation_lock_operation);
      end if;
      if v_finalisation_lock_context then
    perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_lock_operation',v_prior_finalisation_lock_operation,true);
    perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_root_set',v_prior_finalisation_root_set,true);
      end if;
      return pg_catalog.jsonb_build_object(
        'ok',true,'status','FINALISED','idempotent',true,
        'final_revision_id',v_existing_revision.id,'source_cycle_id',v_cycle.id,
        'authority_scope_kind',v_scope_kind,'report_scope_id',v_report_scope_id,
        'upload_id',v_upload.id
      );
    end if;
    raise exception 'WEEKLY_SOURCE_SCOPE_ALREADY_FINALISED' using errcode='55000';
  end if;

  if v_scope_kind='CYCLE' and exists(
    select 1
    from public.weekly_source_final_revisions later_revision
    join public.weekly_source_cycles later_cycle
      on later_cycle.id=later_revision.source_cycle_id
    join public.weekly_source_client_manifests later_manifest
      on coalesce(later_manifest.invoice_window_cycle_id,later_manifest.source_cycle_id)=later_manifest.source_cycle_id and later_manifest.final_revision_id=later_revision.id
     and later_manifest.client_id=v_client_id
    join public.weekly_source_uploads later_upload
      on later_upload.id=later_revision.upload_id
    join public.weekly_source_format_profiles later_profile
      on later_profile.id=later_upload.source_format_profile_id
    where later_revision.authority_scope_kind='CYCLE'
      and later_revision.state='CURRENT'
      and later_cycle.source_group_id=v_group.id
      and later_cycle.finalisation_week_ending>v_cycle.finalisation_week_ending
      and later_profile.final_authority_kind=v_source_profile_kind
  ) then
    raise exception 'WEEKLY_SOURCE_FINALISATION_OUT_OF_ORDER' using errcode='55000';
  end if;

  -- The source Timesheet owner is the only component permitted to create or
  -- reuse ordinary Timesheet lineage.  Finalisation calls it, then validates
  -- the resulting immutable binding; it never accepts a caller-owned id.
  for v_row in
    select resolution.id as resolution_id,source_row.row_finalisation_state
    from public.weekly_source_upload_rows source_row
    join public.weekly_source_row_resolutions resolution
      on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
    where source_row.upload_id=v_upload.id
      and (v_rule_values is null or v_rule_values->>'invoice_sender'<>'CLIENT_SELF_BILL' or v_rule_values->>'self_bill_source'<>'SAME_FILE'
          or coalesce((private.weekly_source_shift_on_self_bill_v1(resolution.work_event_id,v_cycle.id)->>'s25_pay_selected')::boolean,false))
      and (v_source_profile_kind='NHSP_TRUST_BACKING_REPORT'
        or source_row.row_finalisation_state='SOURCE_WORKED'
        or (v_source_profile_kind='GENERIC_COMPLETE_SNAPSHOT'
          and source_row.row_finalisation_state='NOT_APPLICABLE'))
    order by source_row.source_row_ordinal
  loop
    perform public.weekly_source_timesheet_lineage_ensure_atomic_v1(v_row.resolution_id,v_actor);
    v_economic_id:=private.weekly_source_finalisation_economic_assert_v1(
      v_row.resolution_id,v_cycle.id,v_source_mode
    );
    v_timesheet_id:=private.weekly_source_finalisation_lineage_assert_v1(
      v_row.resolution_id,v_cycle.id
    );
  end loop;

  if v_scope_kind='CYCLE' then
    select revision.id into v_prior_revision_id
    from public.weekly_source_final_revisions revision
    join public.weekly_source_cycles prior_cycle on prior_cycle.id=revision.source_cycle_id
    join public.weekly_source_client_manifests prior_manifest
      on coalesce(prior_manifest.invoice_window_cycle_id,prior_manifest.source_cycle_id)=prior_manifest.source_cycle_id and prior_manifest.final_revision_id=revision.id and prior_manifest.client_id=v_client_id
    join public.weekly_source_uploads prior_upload on prior_upload.id=revision.upload_id
    join public.weekly_source_format_profiles prior_profile
      on prior_profile.id=prior_upload.source_format_profile_id
    where revision.authority_scope_kind='CYCLE' and revision.state='CURRENT'
      and prior_cycle.source_group_id=v_group.id and prior_cycle.id<>v_cycle.id
      and prior_cycle.finalisation_week_ending<v_cycle.finalisation_week_ending
      and prior_profile.final_authority_kind=v_source_profile_kind
    order by prior_cycle.finalisation_week_ending desc,revision.finalised_at_utc desc,revision.id desc
    limit 1;
  end if;

  select coalesce(pg_catalog.max(revision.revision_number),0)+1 into v_revision_number
  from public.weekly_source_final_revisions revision
  where revision.source_cycle_id=v_cycle.id
    and revision.authority_scope_kind=v_scope_kind
    and revision.report_scope_id is not distinct from v_report_scope_id;
  select private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_FINAL_POLICY_SET_V1',
    pg_catalog.jsonb_build_object(
      'profile_code',v_profile.profile_code,'profile_version',v_profile.version,
      'source_profile_kind',v_source_profile_kind,'source_mode',v_source_mode,
      'economics',coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
        'row_resolution_id',resolution.id,
        'contract_and_rate_fingerprint',case when economic.id is null then null
          else pg_catalog.encode(economic.contract_and_rate_fingerprint,'hex') end,
        'effective_policy_fingerprint',case when economic.id is null then null
          else pg_catalog.encode(economic.effective_policy_fingerprint,'hex') end,
        'invoice_vat_policy_fingerprint',case when economic.id is null then null
          else pg_catalog.encode(economic.invoice_vat_policy_fingerprint,'hex') end,
        'calculation_fingerprint',case when economic.id is null then null
          else pg_catalog.encode(economic.calculation_fingerprint,'hex') end,
        'expense_policy_snapshot_id',expense_policy.id,
        'expense_policy_snapshot_hash',case when expense_policy.id is null then null
          else pg_catalog.encode(expense_policy.snapshot_hash,'hex') end
      ) order by source_row.source_row_ordinal),'[]'::jsonb)
    )
  ) into v_policy_fingerprint
  from public.weekly_source_upload_rows source_row
  join public.weekly_source_row_resolutions resolution
    on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
  left join public.weekly_source_row_economic_snapshots economic
    on economic.row_resolution_id=resolution.id
  left join public.weekly_source_row_expense_policy_snapshots expense_policy
    on expense_policy.row_resolution_id=resolution.id
  where source_row.upload_id=v_upload.id;
  v_revision_manifest_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_FINAL_REVISION_MANIFEST_V1',
    pg_catalog.jsonb_build_object(
      'source_cycle_id',v_cycle.id,'authority_scope_kind',v_scope_kind,
      'report_scope_id',v_report_scope_id,'revision_number',v_revision_number,
      'upload_id',v_upload.id,'authority_scope_version',v_scope_version,
      'row_manifest_hash',pg_catalog.encode(v_expected_row_hash,'hex'),
      'comparison_manifest_hash',pg_catalog.encode(v_expected_comparison_hash,'hex'),
      'issue_set_hash',pg_catalog.encode(v_expected_issue_hash,'hex'),
      'profile_code',v_profile.profile_code,'profile_version',v_profile.version,
      'coverage_start_local_date',v_coverage_start,'coverage_end_local_date',v_coverage_end,
      'reason',case when p_correction_session_id is null then 'INITIAL_FINALISATION'
        else 'CORRECT_FINAL_SOURCE' end,
      'predecessor_revision_id',case when p_correction_session_id is null then null
        else v_correction.expected_current_final_revision_id end,
      'prior_state_cutoff_revision_id',v_prior_revision_id,
      'policy_fingerprint',pg_catalog.encode(v_policy_fingerprint,'hex')
    )||case when v_rule_version is null then '{}'::jsonb else jsonb_build_object(
      'rule_set_version_id',v_rule_version,'rule_set_values_sha256',v_rule_set->>'values_sha256') end
  );
  insert into public.weekly_source_final_revisions(
    source_cycle_id,authority_scope_kind,report_scope_id,revision_number,upload_id,
    predecessor_revision_id,coverage_start_local_date,coverage_end_local_date,
    coverage_timezone,prior_state_cutoff_revision_id,reason,finalised_by_user_id,
    finalised_at_utc,manifest_hash,policy_fingerprint,state,rule_set_version_id
  ) values (
    v_cycle.id,v_scope_kind,v_report_scope_id,v_revision_number,v_upload.id,
    case when p_correction_session_id is null then null
      else v_correction.expected_current_final_revision_id end,
    v_coverage_start,v_coverage_end,
    case when v_scope_kind='CYCLE' then 'Europe/London' else null end,
    v_prior_revision_id,
    case when p_correction_session_id is null then 'INITIAL_FINALISATION'
      else 'CORRECT_FINAL_SOURCE' end,
    v_actor,v_finalised_at,
    v_revision_manifest_hash,v_policy_fingerprint,
    case when p_prepare_only then 'PREPARED' else 'CURRENT' end,v_rule_version
  ) returning id into v_revision_id;

  if v_source_profile_kind in ('GENERIC_COMPLETE_SNAPSHOT','HEALTHROSTER_ACTUAL_ROWS') then
    for v_row in
      select source_row.*,resolution.id as resolution_id,
             resolution.work_event_id,resolution.candidate_id,resolution.client_id,
             resolution.contract_id,resolution.work_event_match_kind,
             resolution.work_event_match_fingerprint
      from public.weekly_source_upload_rows source_row
      join public.weekly_source_row_resolutions resolution
        on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
      where source_row.upload_id=v_upload.id
        and (v_rule_values is null or v_rule_values->>'invoice_sender'<>'CLIENT_SELF_BILL' or v_rule_values->>'self_bill_source'<>'SAME_FILE'
          or coalesce((private.weekly_source_shift_on_self_bill_v1(resolution.work_event_id,v_cycle.id)->>'s25_pay_selected')::boolean,false))
        and (source_row.row_finalisation_state='SOURCE_WORKED'
          or (v_source_profile_kind='GENERIC_COMPLETE_SNAPSHOT'
            and source_row.row_finalisation_state='NOT_APPLICABLE'))
      order by source_row.source_row_ordinal
    loop
      v_economic_id:=private.weekly_source_finalisation_economic_assert_v1(
        v_row.resolution_id,v_cycle.id,'HEALTHROSTER_WEEKLY'
      );
      v_timesheet_id:=private.weekly_source_finalisation_lineage_assert_v1(
        v_row.resolution_id,v_cycle.id
      );
      select * into strict v_economic
      from public.weekly_source_row_economic_snapshots where id=v_economic_id;
      v_pay_vector:=private.weekly_source_finalisation_vector_v1(v_economic.id,'PAY',1::smallint);
      v_charge_vector:=private.weekly_source_finalisation_vector_v1(v_economic.id,'CHARGE',1::smallint);
      v_mapping_fingerprint:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_FINAL_MAPPING_V1',
        pg_catalog.jsonb_build_object(
          'work_event_id',v_row.work_event_id,'candidate_id',v_row.candidate_id,
          'client_id',v_row.client_id,'contract_id',v_row.contract_id
        )
      );
      -- Freeze only the four authority fields for this exact new snapshot.
      -- The full economic/provenance hashes remain unchanged below.
      v_effective_policy:=private._weekly_source_effective_policy_v1(
        v_row.client_id,v_row.contract_id,v_row.work_date
      );
      if (v_effective_policy->>'authority_mode') is distinct from 'SOURCE_AUTHORITY'
         or coalesce((v_effective_policy->>'self_bill_enabled')::boolean,false) is not true
         or (v_effective_policy->>'source_group_id')::uuid is distinct from v_group.id then
        raise exception 'WEEKLY_SOURCE_FINALISATION_POLICY_STALE' using errcode='40001';
      end if;
      v_authority_subset:=private.weekly_source_authority_subset_v1(v_effective_policy);
      v_snapshot_hash:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_FINAL_SNAPSHOT_LINE_V1',
        pg_catalog.jsonb_build_object(
          'final_revision_id',v_revision_id,'upload_row_id',v_row.id,
          'row_resolution_id',v_row.resolution_id,'work_event_id',v_row.work_event_id,
          'candidate_id',v_row.candidate_id,'client_id',v_row.client_id,
          'contract_id',v_row.contract_id,'work_date',v_row.work_date,
          'start_at_local',v_row.start_at_local,'end_at_local',v_row.end_at_local,
          'break_minutes',v_row.break_minutes,'actual_net_minutes',v_row.actual_net_minutes,
          'pay_vector',v_pay_vector,'charge_vector',v_charge_vector,
          'source_expense_pence',v_row.source_expense_pence,
          'source_fingerprint',pg_catalog.encode(v_row.normalised_row_hash,'hex'),
          'mapping_fingerprint',pg_catalog.encode(v_mapping_fingerprint,'hex'),
          'rate_fingerprint',pg_catalog.encode(v_economic.calculation_fingerprint,'hex'),
          'policy_fingerprint',pg_catalog.encode(v_economic.effective_policy_fingerprint,'hex')
        )
      );
      insert into public.weekly_source_final_snapshot_lines(
        final_revision_id,upload_row_id,row_resolution_id,charge_check_id,
        source_profile_kind,work_event_id,external_event_identity,candidate_id,
        client_id,contract_id,work_date,start_at_local,end_at_local,break_minutes,
        actual_net_minutes,source_classifications_json,pay_vector_json,charge_vector_json,
        source_expense_pence,source_fingerprint,mapping_fingerprint,rate_fingerprint,
        policy_fingerprint,snapshot_line_hash,authority_subset_json,authority_subset_sha256,invoice_economics_sha256
      ) values (
        v_revision_id,v_row.id,v_row.resolution_id,null,v_source_profile_kind,
        v_row.work_event_id,v_row.external_source_key,v_row.candidate_id,v_row.client_id,
        v_row.contract_id,v_row.work_date,v_row.start_at_local,v_row.end_at_local,
        v_row.break_minutes,v_row.actual_net_minutes,v_economic.canonical_result_json,
        v_pay_vector,v_charge_vector,v_row.source_expense_pence,v_row.normalised_row_hash,
        v_mapping_fingerprint,v_economic.calculation_fingerprint,
        v_economic.effective_policy_fingerprint,v_snapshot_hash,v_authority_subset,
        private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AUTHORITY_SUBSET_V1',v_authority_subset),
        case when v_rule_values is not null and v_rule_values->>'invoice_sender'='CLIENT_SELF_BILL' and v_rule_values->>'invoice_amount_basis'='SOURCE_AMOUNT' and v_rule_values->>'source_amount_basis'='EXPORT_ACTUAL_COST_INC_VAT_NET_AGENCY_WORKER_PAY'
          then private.weekly_source_invoice_economics_fingerprint_v1(jsonb_build_object('source_shift_charge_pence',v_row.source_shift_charge_pence,
            'source_gross_pence',v_row.source_gross_pence,'source_vat_pence',v_row.source_vat_pence),v_rule_values->>'line_vat_method',
            case when v_economic.invoice_vat_chargeable then v_economic.invoice_vat_rate_pct else 0 end) else null end
      ) returning id into v_snapshot_id;
      v_snapshot_count:=v_snapshot_count+1;
    end loop;

    for v_transition in
      with prior_states as (
        select distinct on (prior_transition.work_event_id)
               prior_transition.work_event_id,
               prior_transition.new_snapshot_line_id
        from public.weekly_source_state_transitions prior_transition
        join public.weekly_source_final_revisions prior_revision
          on prior_revision.id=prior_transition.final_revision_id
         and prior_revision.state='CURRENT'
        join public.weekly_source_cycles prior_cycle
          on prior_cycle.id=prior_transition.finalisation_cycle_id
        join public.weekly_source_client_manifests prior_manifest
          on coalesce(prior_manifest.invoice_window_cycle_id,prior_manifest.source_cycle_id)=prior_manifest.source_cycle_id and prior_manifest.final_revision_id=prior_revision.id
         and prior_manifest.client_id=v_client_id
        where prior_transition.source_profile_kind=v_source_profile_kind
          and prior_cycle.source_group_id=v_group.id
          and prior_cycle.finalisation_week_ending<v_cycle.finalisation_week_ending
        order by prior_transition.work_event_id,
                 prior_cycle.finalisation_week_ending desc,
                 prior_revision.finalised_at_utc desc,
                 prior_revision.revision_number desc,
                 prior_transition.created_at_utc desc,
                 prior_transition.id desc
      ), prior_lines as (
        select prior_line.id,prior_state.work_event_id
        from prior_states prior_state
        join public.weekly_source_final_snapshot_lines prior_line
          on prior_line.id=prior_state.new_snapshot_line_id
        where prior_line.client_id=v_client_id
          and not (v_rule_values is not null and v_rule_values->>'invoice_sender'='CLIENT_SELF_BILL' and v_rule_values->>'self_bill_source'='SAME_FILE'
            and coalesce((private.weekly_source_shift_on_self_bill_v1(prior_line.work_event_id,v_cycle.id)->>'bound_to_finalised_export')::boolean,false)
            and not coalesce((private.weekly_source_shift_on_self_bill_v1(prior_line.work_event_id,v_cycle.id)->>'s25_pay_selected')::boolean,false))
          and (
            prior_line.work_date between v_coverage_start and v_coverage_end
            or exists(
              select 1
              from public.weekly_source_row_resolutions current_resolution
              join public.weekly_source_upload_rows current_row
                on current_row.id=current_resolution.upload_row_id
              where current_row.upload_id=v_upload.id
                and current_resolution.generation=v_generation
                and current_resolution.work_event_id=prior_line.work_event_id
            )
          )
      ), current_lines as (
        select current_line.id,current_line.work_event_id
        from public.weekly_source_final_snapshot_lines current_line
        where current_line.final_revision_id=v_revision_id
      )
      select coalesce(prior_lines.work_event_id,current_lines.work_event_id) as work_event_id,
             prior_lines.id as prior_snapshot_id,current_lines.id as current_snapshot_id
      from prior_lines full join current_lines using(work_event_id)
      order by coalesce(prior_lines.work_event_id,current_lines.work_event_id)
    loop
      select * into v_prior_snapshot
      from public.weekly_source_final_snapshot_lines
      where id=v_transition.prior_snapshot_id;
      select * into v_current_snapshot
      from public.weekly_source_final_snapshot_lines
      where id=v_transition.current_snapshot_id;
      v_effective_policy:=private._weekly_source_effective_policy_v1(
        coalesce(v_current_snapshot.client_id,v_prior_snapshot.client_id),
        coalesce(v_current_snapshot.contract_id,v_prior_snapshot.contract_id),
        coalesce(v_current_snapshot.work_date,v_prior_snapshot.work_date)
      );
      if (v_effective_policy->>'authority_mode') is distinct from 'SOURCE_AUTHORITY'
         or coalesce((v_effective_policy->>'self_bill_enabled')::boolean,false) is not true
         or (v_effective_policy->>'source_group_id')::uuid is distinct from v_group.id then
        raise exception 'WEEKLY_SOURCE_FINALISATION_POLICY_STALE' using errcode='40001';
      end if;
      v_authority_subset:=private.weekly_source_authority_subset_v1(v_effective_policy);
      v_prior_authority_subset:=private.weekly_source_snapshot_authority_subset_v1(v_transition.prior_snapshot_id);
      v_current_authority_subset:=private.weekly_source_snapshot_authority_subset_v1(v_transition.current_snapshot_id);
      if (v_effective_policy->>'authority_mode') is distinct from 'SOURCE_AUTHORITY'
         or coalesce((v_effective_policy->>'self_bill_enabled')::boolean,false) is not true
         or (v_effective_policy->>'source_group_id')::uuid is distinct from v_group.id
         or (coalesce(v_current_authority_subset,v_prior_authority_subset) is not null
           and v_authority_subset is distinct from coalesce(v_current_authority_subset,v_prior_authority_subset))
         or (coalesce(v_current_authority_subset,v_prior_authority_subset) is null
           and private.weekly_source_finalisation_hex32_v1(
              v_effective_policy->>'policy_sha256','WEEKLY_SOURCE_POLICY_FINGERPRINT_INVALID'
            ) is distinct from coalesce(
              v_current_snapshot.policy_fingerprint,v_prior_snapshot.policy_fingerprint
            )) then
        raise exception 'WEEKLY_SOURCE_FINALISATION_POLICY_STALE' using errcode='40001';
      end if;
      v_correction_presentation:=pg_catalog.upper(pg_catalog.btrim(coalesce(
        v_effective_policy->>'self_bill_correction_presentation',''
      )));
      if v_correction_presentation not in (
        'FULL_REVERSAL_REPLACEMENT','NET_DIFFERENCE_PRESENTATION'
      ) then
        raise exception 'WEEKLY_SOURCE_SELF_BILL_CORRECTION_POLICY_REQUIRED'
          using errcode='55000';
      end if;
      -- Unknown pre-upgrade authority keeps the whole-hash fence. Equality
      -- proves compatibility without inventing historical four-field JSON.
      v_comparison_current_authority:=v_current_authority_subset;
      if v_transition.prior_snapshot_id is not null and v_prior_authority_subset is null
         and v_transition.current_snapshot_id is not null then
        if private.weekly_source_finalisation_hex32_v1(
             v_effective_policy->>'policy_sha256','WEEKLY_SOURCE_POLICY_FINGERPRINT_INVALID'
           ) is distinct from v_prior_snapshot.policy_fingerprint then
          raise exception 'WEEKLY_SOURCE_FINALISATION_POLICY_STALE' using errcode='40001';
        end if;
        v_comparison_current_authority:=null;
      end if;
      v_prior_state:=private.weekly_source_snapshot_value_fingerprint_v1(
        v_transition.prior_snapshot_id,v_prior_authority_subset
      );
      v_current_state:=private.weekly_source_snapshot_value_fingerprint_v1(
        v_transition.current_snapshot_id,v_comparison_current_authority
      );
      v_outcome:=case
        when v_transition.prior_snapshot_id is null then 'ADD'
        when v_transition.current_snapshot_id is null then 'CANCEL'
        when v_prior_state=v_current_state then 'NO_CHANGE'
        else 'AMEND' end;
      v_transition_fingerprint:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_STATE_TRANSITION_V1',
        pg_catalog.jsonb_build_object(
          'final_revision_id',v_revision_id,'work_event_id',v_transition.work_event_id,
          'previous_snapshot_line_id',v_transition.prior_snapshot_id,
          'new_snapshot_line_id',v_transition.current_snapshot_id,
          'outcome',v_outcome,
          'prior_state_fingerprint',case when v_prior_state is null then null
            else pg_catalog.encode(v_prior_state,'hex') end,
          'new_state_fingerprint',case when v_current_state is null then null
            else pg_catalog.encode(v_current_state,'hex') end
        )
      );
      insert into public.weekly_source_state_transitions(
        final_revision_id,finalisation_cycle_id,source_profile_kind,work_event_id,
        previous_present,new_present,previous_snapshot_line_id,new_snapshot_line_id,
        outcome,identity_match_kind,match_confidence,prior_state_fingerprint,
        new_state_fingerprint,transition_fingerprint,
        ordinary_source_entitlement_projection_state
      ) values (
        v_revision_id,v_cycle.id,v_source_profile_kind,v_transition.work_event_id,
        v_transition.prior_snapshot_id is not null,v_transition.current_snapshot_id is not null,
        v_transition.prior_snapshot_id,v_transition.current_snapshot_id,v_outcome,
        (select event.identity_kind from public.weekly_work_events event
          where event.id=v_transition.work_event_id),
        case when (select event.identity_kind from public.weekly_work_events event
          where event.id=v_transition.work_event_id)='PROFILE_EXTERNAL_KEY'
          then 'EXACT_PROFILE_KEY' else 'EXACT_DURABLE_LINEAGE' end,
        v_prior_state,v_current_state,v_transition_fingerprint,
        case when v_outcome='NO_CHANGE' then 'NOT_APPLICABLE' else 'PENDING' end
      ) returning id into v_transition_id;
      v_transition_count:=v_transition_count+1;

      if v_outcome='NO_CHANGE' then
        v_unchanged_count:=v_unchanged_count+1;
        if v_transition.new_snapshot_line_id is not null and v_transition.previous_snapshot_line_id is not null and exists(select 1 from public.weekly_source_final_snapshot_lines current_line join public.weekly_source_final_snapshot_lines prior_line on prior_line.id=v_transition.previous_snapshot_line_id where current_line.id=v_transition.new_snapshot_line_id and current_line.external_event_identity is distinct from prior_line.external_event_identity) then
          if private.weekly_source_rebill_movement_insert_v1(v_transition_id,v_revision_id) is not null then v_movement_count:=v_movement_count+1; end if;
        else
          v_invoice_correction:=private.weekly_source_invoice_correction_insert_v1(v_transition_id,v_transition.work_event_id,v_revision_id);
          v_movement_count:=v_movement_count+coalesce((v_invoice_correction->>'movement_count')::integer,0);
        end if;
      else
        if v_outcome in ('AMEND','CANCEL') then
          select movement.* into v_prior_movement
          from public.weekly_source_billing_movements movement
          join public.weekly_source_final_revisions movement_revision
            on movement_revision.id=movement.final_revision_id
          join public.weekly_source_cycles movement_cycle
            on movement_cycle.id=movement.finalisation_cycle_id
          where movement.work_event_id=v_transition.work_event_id
            and movement.source_profile_kind=v_source_profile_kind
            and movement.movement_role in ('POSITIVE','REPLACEMENT')
            and movement.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION')
            and movement.final_revision_id<>v_revision_id
            and movement_cycle.finalisation_week_ending<v_cycle.finalisation_week_ending
          order by movement_cycle.finalisation_week_ending desc,
                   movement_revision.finalised_at_utc desc,movement.created_at_utc desc,movement.id desc
          limit 1;
          if not found then
            raise exception 'WEEKLY_SOURCE_PRIOR_MOVEMENT_MISSING' using errcode='55000';
          end if;
          v_correction_unit_id:=pg_catalog.gen_random_uuid();
          v_movement_id:=private.weekly_source_finalisation_insert_reversal_v1(
            v_transition_id,v_revision_id,v_cycle.id,v_prior_movement.id,
            v_correction_unit_id,v_source_profile_kind,
            pg_catalog.jsonb_build_object(
              'schema_version','WEEKLY_SOURCE_GENERATED_REVERSAL_FACTS_V1',
              'outcome',v_outcome,'prior_snapshot_line_id',v_transition.prior_snapshot_id,
              'prior_movement_id',v_prior_movement.id,
              'correction_presentation',v_correction_presentation
            )
          );
          v_movement_count:=v_movement_count+1;
          if private.weekly_source_invoice_correction_unwind_v1(v_transition_id,v_transition.work_event_id,v_revision_id) is not null then v_movement_count:=v_movement_count+1; end if;
        else
          v_correction_unit_id:=null;
          v_prior_movement.id:=null;
        end if;
        if v_outcome in ('ADD','AMEND') then
          select resolution.id as resolution_id into strict v_row
          from public.weekly_source_row_resolutions resolution
          where resolution.id=v_current_snapshot.row_resolution_id;
          v_economic_id:=private.weekly_source_finalisation_economic_assert_v1(
            v_row.resolution_id,v_cycle.id,'HEALTHROSTER_WEEKLY'
          );
          v_timesheet_id:=private.weekly_source_finalisation_lineage_assert_v1(
            v_row.resolution_id,v_cycle.id
          );
          select * into strict v_economic
          from public.weekly_source_row_economic_snapshots where id=v_economic_id;
          v_invoice_amounts:=private.weekly_source_invoice_line_amounts_v1(v_row.resolution_id,v_revision_id);
          v_movement_id:=private.weekly_source_finalisation_insert_current_movement_v1(
            v_transition_id,null,v_revision_id,v_cycle.id,v_source_profile_kind,
            case when v_outcome='ADD' then 'POSITIVE' else 'REPLACEMENT' end,
            case when v_outcome='ADD' then 'SOURCE_ORDINARY' else 'SOURCE_REPLACEMENT' end,
            v_row.resolution_id,v_economic.id,v_timesheet_id,case when (v_invoice_amounts->>'source_amount')::boolean then (v_invoice_amounts->>'net_pence')::bigint else null end,
            (v_invoice_amounts->>'net_pence')::bigint,v_invoice_amounts->>'price_check_result',case when (v_invoice_amounts->>'source_amount')::boolean then v_economic.calculation_fingerprint else null end,
            nullif(v_invoice_amounts->>'charge_acceptance_id','')::uuid,
            pg_catalog.jsonb_build_object(
              'schema_version','WEEKLY_SOURCE_CURRENT_FACTS_V1','outcome',v_outcome,
              'snapshot_line_id',v_current_snapshot.id,
              'upload_row_id',v_current_snapshot.upload_row_id,
              'row_resolution_id',v_current_snapshot.row_resolution_id,
              'correction_presentation',v_correction_presentation
            ),v_correction_unit_id,
            case when v_outcome='AMEND' then v_prior_movement.id else null end
          );
          v_movement_count:=v_movement_count+1;
        end if;
      end if;

    end loop;

    if v_profile.profile_code='ROSTER_WEEKLY_SUMMARY_ACTUAL_V1' then
      -- The profile can serve Clients with or without source-fixed expenses.
      -- A snapshot is mandatory exactly where the sealed effective policy
      -- enables that route, and forbidden otherwise.  This prevents both a
      -- missing configured expense and accidental contamination of ordinary
      -- evidence-led expenses.
      for v_row in
        select source_row.work_date,resolution.id as resolution_id,
               resolution.client_id,resolution.contract_id,
               resolution.effective_policy_fingerprint,
               expense_policy.id as expense_policy_snapshot_id
        from public.weekly_source_upload_rows source_row
        join public.weekly_source_row_resolutions resolution
          on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
        left join public.weekly_source_row_expense_policy_snapshots expense_policy
          on expense_policy.row_resolution_id=resolution.id
        where source_row.upload_id=v_upload.id
        order by source_row.source_row_ordinal
      loop
        v_effective_policy:=private._weekly_source_effective_policy_v1(
          v_row.client_id,v_row.contract_id,v_row.work_date
        );
        if (v_effective_policy->>'authority_mode') is distinct from 'SOURCE_AUTHORITY'
           or coalesce((v_effective_policy->>'self_bill_enabled')::boolean,false) is not true
           or (v_effective_policy->>'source_group_id')::uuid is distinct from v_group.id
           or private.weekly_source_finalisation_hex32_v1(
                v_effective_policy->>'policy_sha256','WEEKLY_SOURCE_POLICY_FINGERPRINT_INVALID'
              ) is distinct from v_row.effective_policy_fingerprint then
          raise exception 'WEEKLY_SOURCE_FINALISATION_POLICY_STALE' using errcode='40001';
        end if;
        if coalesce((v_effective_policy->>'source_fixed_expenses_enabled')::boolean,false) then
          if v_row.expense_policy_snapshot_id is null
             or private.weekly_source_finalisation_expense_policy_assert_v1(
                  v_row.resolution_id,v_cycle.id
                ) is distinct from v_row.expense_policy_snapshot_id then
            raise exception 'WEEKLY_SOURCE_EXPENSE_POLICY_SNAPSHOT_CARDINALITY'
              using errcode='55000';
          end if;
        elsif v_row.expense_policy_snapshot_id is not null then
          raise exception 'WEEKLY_SOURCE_EXPENSE_POLICY_NOT_ENABLED' using errcode='55000';
        end if;
      end loop;

      for v_expense_observation in
        with current_observation as (
          select expense_policy.id as expense_policy_snapshot_id,
                 expense_policy.row_resolution_id,expense_policy.work_event_id,
                 expense_policy.contract_id,expense_policy.source_expense_pence,
                 expense_policy.source_expense_vat_enabled,
                 expense_policy.correction_presentation
          from public.weekly_source_row_expense_policy_snapshots expense_policy
          join public.weekly_source_row_resolutions resolution
            on resolution.id=expense_policy.row_resolution_id
          join public.weekly_source_upload_rows source_row
            on source_row.id=resolution.upload_row_id
          where source_row.upload_id=v_upload.id and resolution.generation=v_generation
        ), prior_authority as (
          select
                 case when p_prepare_only
                           and authority.final_revision_id=v_correction.expected_current_final_revision_id
                        then baseline.id else authority.id end as prior_authority_id,
                 authority.work_event_id,
                 case when p_prepare_only
                           and authority.final_revision_id=v_correction.expected_current_final_revision_id
                        then baseline.contract_id else authority.contract_id end as contract_id,
                 case when p_prepare_only
                           and authority.final_revision_id=v_correction.expected_current_final_revision_id
                        then baseline.source_expense_pence else authority.source_expense_pence end
                   as source_expense_pence,
                 case when p_prepare_only
                           and authority.final_revision_id=v_correction.expected_current_final_revision_id
                        then baseline.source_expense_vat_enabled
                        else authority.source_expense_vat_enabled end
                   as source_expense_vat_enabled,
                 case when p_prepare_only
                           and authority.final_revision_id=v_correction.expected_current_final_revision_id
                        then baseline.correction_presentation
                        else authority.correction_presentation end
                   as correction_presentation,
                 event.work_date
          from public.weekly_expense_authority_generations authority
          join public.weekly_work_events event on event.id=authority.work_event_id
          left join public.weekly_expense_authority_generations baseline
            on p_prepare_only
           and authority.final_revision_id=v_correction.expected_current_final_revision_id
           and baseline.id=authority.prior_expense_authority_generation_id
          where authority.state='CURRENT'
            and event.first_source_group_id=v_group.id
            and event.client_id=v_client_id
            and not (
              p_prepare_only
              and authority.final_revision_id=v_correction.expected_current_final_revision_id
              and baseline.id is null
            )
            and (
              event.work_date between v_coverage_start and v_coverage_end
              or exists(
                select 1 from current_observation current_match
                where current_match.work_event_id=authority.work_event_id
              )
            )
        )
        select coalesce(current_observation.work_event_id,prior_authority.work_event_id) as work_event_id,
               current_observation.expense_policy_snapshot_id,
               current_observation.row_resolution_id,
               current_observation.contract_id as current_contract_id,
               current_observation.source_expense_pence as current_expense_pence,
               current_observation.source_expense_vat_enabled as current_expense_vat_enabled,
               current_observation.correction_presentation as current_correction_presentation,
               prior_authority.prior_authority_id,
               prior_authority.contract_id as prior_contract_id,
               prior_authority.source_expense_pence as prior_expense_pence,
               prior_authority.source_expense_vat_enabled as prior_expense_vat_enabled,
               prior_authority.correction_presentation as prior_correction_presentation
        from current_observation
        full join prior_authority using(work_event_id)
        order by coalesce(current_observation.work_event_id,prior_authority.work_event_id)
      loop
        v_expense_policy_id:=v_expense_observation.expense_policy_snapshot_id;
        v_prior_expense_authority_id:=v_expense_observation.prior_authority_id;
        v_expense_authority_id:=null;
        v_expense_timesheet_id:=null;
        v_current_expense.id:=null;
        if v_expense_policy_id is not null then
          if private.weekly_source_finalisation_expense_policy_assert_v1(
               v_expense_observation.row_resolution_id,v_cycle.id
             ) is distinct from v_expense_policy_id then
            raise exception 'WEEKLY_SOURCE_EXPENSE_POLICY_SNAPSHOT_INVALID' using errcode='55000';
          end if;
          select * into strict v_expense_policy
          from public.weekly_source_row_expense_policy_snapshots
          where id=v_expense_policy_id;
          v_target_expense_pence:=v_expense_policy.source_expense_pence;
          v_target_expense_vat:=v_expense_policy.source_expense_vat_enabled;
          v_target_expense_contract_id:=v_expense_policy.contract_id;
          v_expense_observation_kind:='ROW_PRESENT';
          v_correction_presentation:=v_expense_policy.correction_presentation;
          if v_target_expense_pence>0 then
            perform public.weekly_source_timesheet_lineage_ensure_atomic_v1(
              v_expense_policy.row_resolution_id,v_actor
            );
            v_expense_timesheet_id:=private.weekly_source_finalisation_lineage_assert_v1(
              v_expense_policy.row_resolution_id,v_cycle.id
            );
          end if;
        else
          v_target_expense_pence:=0;
          v_target_expense_vat:=v_expense_observation.prior_expense_vat_enabled;
          v_target_expense_contract_id:=v_expense_observation.prior_contract_id;
          v_expense_observation_kind:='OMITTED_IN_COMPLETE_COVERAGE';
          v_correction_presentation:=v_expense_observation.prior_correction_presentation;
        end if;
        if v_prior_expense_authority_id is not null then
          select * into strict v_current_expense
          from public.weekly_expense_authority_generations expense
          where expense.id=v_prior_expense_authority_id
            and expense.state in ('CURRENT','SUPERSEDED')
            and expense.work_event_id=v_expense_observation.work_event_id
          for update;
        end if;
        if v_prior_expense_authority_id is null
           or v_current_expense.source_expense_pence is distinct from v_target_expense_pence
           or v_current_expense.source_expense_vat_enabled is distinct from v_target_expense_vat
           or v_current_expense.contract_id is distinct from v_target_expense_contract_id
           or v_current_expense.source_observation_kind is distinct from v_expense_observation_kind then
          if v_prior_expense_authority_id is not null then
            if not p_prepare_only then
              update public.weekly_expense_authority_generations
              set state='SUPERSEDED' where id=v_prior_expense_authority_id;
            end if;
          end if;
          select coalesce(pg_catalog.max(expense.generation),0)+1 into v_expense_generation
          from public.weekly_expense_authority_generations expense
          where expense.work_event_id=v_expense_observation.work_event_id;
          v_expense_hash:=private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_SOURCE_EXPENSE_AUTHORITY_GENERATION_V1',
            pg_catalog.jsonb_build_object(
              'final_revision_id',v_revision_id,
              'work_event_id',v_expense_observation.work_event_id,
              'contract_id',v_target_expense_contract_id,
              'row_expense_policy_snapshot_id',v_expense_policy_id,
              'prior_expense_authority_generation_id',v_prior_expense_authority_id,
              'generation',v_expense_generation,
              'source_observation_kind',v_expense_observation_kind,
              'correction_presentation',v_correction_presentation,
              'source_expense_pence',v_target_expense_pence,
              'source_expense_vat_enabled',v_target_expense_vat
            )
          );
          insert into public.weekly_expense_authority_generations(
            final_revision_id,work_event_id,contract_id,row_expense_policy_snapshot_id,
            prior_expense_authority_generation_id,generation,source_observation_kind,
            correction_presentation,source_expense_pence,source_expense_vat_enabled,
            candidate_reimbursement_ex_vat,client_charge_ex_vat,authority_hash,state
          ) values (
            v_revision_id,v_expense_observation.work_event_id,v_target_expense_contract_id,
            v_expense_policy_id,v_prior_expense_authority_id,v_expense_generation,
            v_expense_observation_kind,v_correction_presentation,v_target_expense_pence,
            v_target_expense_vat,v_target_expense_pence::numeric/100,
            v_target_expense_pence::numeric/100,v_expense_hash,
            case when p_prepare_only then 'PREPARED' else 'CURRENT' end
          ) returning id into v_expense_authority_id;
          v_expense_movement_result:=
            private.weekly_source_finalisation_materialise_expense_invoice_v1(
              v_revision_id,v_cycle.id,v_source_profile_kind,
              v_expense_authority_id,v_prior_expense_authority_id,
              v_expense_policy_id,v_expense_timesheet_id,
              v_correction_presentation
            );
          v_movement_count:=v_movement_count+
            coalesce((v_expense_movement_result->>'movement_count')::integer,0);
          v_expense_generation_count:=v_expense_generation_count+1;
        end if;
        v_current_expense.id:=null;
      end loop;
    end if;
  else
    v_source_total_cost:=0;
    v_source_commission:=0;
    v_source_invoice_total:=0;
    v_line_count:=0;
    for v_row in
      select source_row.*,resolution.id as resolution_id,
             resolution.work_event_id,resolution.candidate_id,resolution.client_id,
             resolution.contract_id
      from public.weekly_source_upload_rows source_row
      join public.weekly_source_row_resolutions resolution
        on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
      where source_row.upload_id=v_upload.id
      order by source_row.source_row_ordinal
    loop
      v_economic_id:=private.weekly_source_finalisation_economic_assert_v1(
        v_row.resolution_id,v_cycle.id,'NHSP_WEEKLY'
      );
      v_timesheet_id:=private.weekly_source_finalisation_lineage_assert_v1(
        v_row.resolution_id,v_cycle.id
      );
      select * into strict v_economic
      from public.weekly_source_row_economic_snapshots where id=v_economic_id;
      select * into v_charge_check
      from public.weekly_source_charge_checks charge_check
      where charge_check.upload_row_id=v_row.id
        and charge_check.row_resolution_id=v_row.resolution_id
        and charge_check.generation=v_generation;
      v_charge_acceptance.id:=null;
      if found and v_charge_check.comparison_result in ('MISMATCH','ZERO_SOURCE_CHARGE') then
        select * into v_charge_acceptance
        from public.weekly_source_charge_acceptances acceptance
        where acceptance.charge_check_id=v_charge_check.id
          and acceptance.upload_row_id=v_row.id
          and acceptance.row_resolution_id=v_row.resolution_id
          and acceptance.source_upload_id=v_upload.id
          and acceptance.contract_id=v_row.contract_id
          and acceptance.acceptance_kind=case v_charge_check.comparison_result
            when 'ZERO_SOURCE_CHARGE' then 'ACCEPTED_ZERO' else 'ACCEPTED_DISPARITY' end
          and acceptance.source_upload_hash=v_upload.content_sha256
          and acceptance.source_row_fingerprint=(select resolution.source_row_fingerprint
            from public.weekly_source_row_resolutions resolution where resolution.id=v_row.resolution_id)
          and acceptance.contract_and_rate_fingerprint=v_economic.contract_and_rate_fingerprint
          and acceptance.effective_policy_fingerprint=v_economic.effective_policy_fingerprint
          and acceptance.charge_calculation_fingerprint=v_economic.calculation_fingerprint
          and acceptance.acceptance_policy_fingerprint=
            private.weekly_source_charge_acceptance_policy_fingerprint_v1();
      end if;
      v_price_admission_result:=case v_charge_check.comparison_result
        when 'ZERO_SOURCE_CHARGE' then 'ACCEPTED_ZERO'
        when 'MISMATCH' then 'ACCEPTED_DISPARITY'
        else v_charge_check.comparison_result end;
      if not found or (select pg_catalog.count(*)
          from public.weekly_source_charge_checks charge_check
          where charge_check.upload_row_id=v_row.id
            and charge_check.row_resolution_id=v_row.resolution_id
            and charge_check.generation=v_generation)<>1
         or v_charge_check.source_commission_pence is distinct from v_row.source_commission_pence
         or v_charge_check.source_total_cost_pence is distinct from v_row.source_total_cost_pence
         or v_charge_check.source_shift_charge_pence is distinct from v_row.source_shift_charge_pence
         or v_charge_check.calculated_segment_charge_pence is distinct from v_economic.calculated_charge_pence
         or v_charge_check.source_charge_difference_pence is distinct from
              (v_row.source_shift_charge_pence-v_economic.calculated_charge_pence)
         or v_charge_check.charge_calculation_fingerprint is distinct from
              v_economic.calculation_fingerprint
         or v_charge_check.comparison_profile_version<>'NHSP_TWO_COMPONENT_PENCE_V1'
         or v_charge_check.comparison_result not in (
              'EXACT','SOURCE_ROUNDING_EQUIVALENT','MISMATCH','ZERO_SOURCE_CHARGE'
            )
         or not (
           (v_charge_check.comparison_result='EXACT'
             and v_charge_check.source_charge_difference_pence=0)
           or (v_charge_check.comparison_result='SOURCE_ROUNDING_EQUIVALENT'
             and v_charge_check.row_sign_kind in ('POSITIVE','FULL_NEGATIVE')
             and (v_charge_check.source_charge_difference_pence=1
               or v_charge_check.source_charge_difference_pence=-1)
             and ((v_charge_check.source_shift_charge_pence>0
                   and v_charge_check.calculated_segment_charge_pence>0)
               or (v_charge_check.source_shift_charge_pence<0
                   and v_charge_check.calculated_segment_charge_pence<0)))
           or (v_charge_check.comparison_result='MISMATCH'
             and v_charge_acceptance.id is not null
             and v_charge_acceptance.acceptance_kind='ACCEPTED_DISPARITY')
           or (v_charge_check.comparison_result='ZERO_SOURCE_CHARGE'
             and v_charge_check.source_commission_pence=0
             and v_charge_check.source_total_cost_pence=0
             and v_charge_check.source_shift_charge_pence=0
             and v_charge_check.calculated_segment_charge_pence>0
             and v_charge_acceptance.id is not null
             and v_charge_acceptance.acceptance_kind='ACCEPTED_ZERO')
         )
         or v_charge_check.row_sign_kind is distinct from (case
              when v_economic.row_sign=1 then 'POSITIVE' else 'FULL_NEGATIVE' end)
         or v_charge_check.phase_severity='FINALISATION_BLOCKER'
         or v_charge_check.blocker_code is not null then
        raise exception 'WEEKLY_SOURCE_NHSP_PRICE_GATE_FAILED'
          using errcode='55000',detail=v_row.source_row_ordinal::text;
      end if;
      v_movement_id:=private.weekly_source_finalisation_insert_current_movement_v1(
        null,v_row.id,v_revision_id,v_cycle.id,'NHSP_TRUST_BACKING_REPORT',
        case when v_economic.row_sign=1 then 'POSITIVE' else 'REVERSAL' end,
        case when v_economic.row_sign=1
          then 'NHSP_PHYSICAL_POSITIVE' else 'NHSP_PHYSICAL_FULL_NEGATIVE' end,
        v_row.resolution_id,v_economic.id,v_timesheet_id,
        v_row.source_shift_charge_pence,v_row.source_shift_charge_pence,
        v_price_admission_result,v_charge_check.charge_calculation_fingerprint,
        v_charge_acceptance.id,
        pg_catalog.jsonb_build_object(
          'schema_version','WEEKLY_SOURCE_NHSP_PHYSICAL_FACTS_V1',
          'backing_report_number',v_backing_report_number,
          'report_scope_id',v_report_scope_id,'source_row_ordinal',v_row.source_row_ordinal,
          'upload_row_id',v_row.id,'row_resolution_id',v_row.resolution_id,
          'work_date',v_row.work_date,'start_at_local',v_row.start_at_local,
          'end_at_local',v_row.end_at_local,'break_minutes',v_row.break_minutes,
          'actual_net_minutes',v_row.actual_net_minutes,
          'source_commission_pence',v_row.source_commission_pence,
          'source_total_cost_pence',v_row.source_total_cost_pence,
          'source_shift_charge_pence',v_row.source_shift_charge_pence,
          'calculated_comparison_charge_pence',v_economic.calculated_charge_pence,
          'comparison_result',v_charge_check.comparison_result,
          'price_admission_result',v_price_admission_result,
          'charge_acceptance_id',v_charge_acceptance.id,
          'physical_sign',case when v_economic.row_sign=1
            then 'POSITIVE' else 'FULL_NEGATIVE' end
        ),null,null
      );
      v_source_total_cost:=v_source_total_cost+v_row.source_total_cost_pence;
      v_source_commission:=v_source_commission+v_row.source_commission_pence;
      v_source_invoice_total:=v_source_invoice_total+v_row.source_shift_charge_pence;
      v_line_count:=v_line_count+1;
      v_movement_count:=v_movement_count+1;
    end loop;
    if v_line_count<>v_upload.accepted_count
       or v_source_invoice_total<>v_source_total_cost+v_source_commission then
      raise exception 'WEEKLY_SOURCE_NHSP_REPORT_TOTAL_INVALID' using errcode='55000';
    end if;
    insert into public.weekly_source_nhsp_backing_reports(
      report_scope_id,final_revision_id,upload_id,client_id,backing_report_number,
      cutoff_at_utc,physical_line_count,source_total_cost_pence,
      source_commission_pence,source_invoice_total_pence,row_manifest_hash
    ) values (
      v_report_scope_id,v_revision_id,v_upload.id,v_client_id,v_backing_report_number,
      v_scope.cutoff_at_utc,v_line_count,v_source_total_cost,v_source_commission,
      v_source_invoice_total,v_upload.row_manifest_hash
    );
  end if;

  for v_round_scope in select distinct movement.actual_client_id client_id,
      private.weekly_source_invoice_movement_window_id_v1(movement.id) invoice_window_cycle_id
    from public.weekly_source_billing_movements movement where movement.final_revision_id=v_revision_id
      and movement.source_line_kind<>'INVOICE_VAT_ROUNDING'
    order by client_id,invoice_window_cycle_id
  loop
    if not(v_round_scope.invoice_window_cycle_id=any(v_invoice_window_ids)) then
      raise exception 'WEEKLY_SOURCE_INVOICE_WINDOW_SET_GREW_AFTER_LOCK' using errcode='40001'; end if;
    v_round_id:=private.weekly_source_vat_rounding_movement_insert_v1(v_revision_id,v_round_scope.client_id,null,v_round_scope.invoice_window_cycle_id);
    if v_round_id is not null then v_movement_count:=v_movement_count+1; end if;
  end loop;
  for v_manifest in
    select scope.client_id,scope.invoice_window_cycle_id,actual.finalisation_week_ending as invoice_week_ending
    from (select movement.actual_client_id as client_id,
      private.weekly_source_invoice_movement_window_id_v1(movement.id) as invoice_window_cycle_id
      from public.weekly_source_billing_movements movement where movement.final_revision_id=v_revision_id
      union select v_client_id,v_cycle.id) scope
    join public.weekly_source_cycles actual on actual.id=scope.invoice_window_cycle_id
    where scope.client_id is not null order by scope.client_id,scope.invoice_window_cycle_id
  loop
    select private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_CLIENT_MANIFEST_V1',
      pg_catalog.jsonb_build_object(
        'final_revision_id',v_revision_id,'source_group_id',v_group.id,
        'source_cycle_id',v_cycle.id,'client_id',v_manifest.client_id,
        'finalisation_week_ending',v_manifest.invoice_week_ending,
        'backing_report_number',v_backing_report_number,
        'movements',coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
          'movement_id',movement.id,
          'movement_economic_hash',pg_catalog.encode(movement.movement_economic_hash,'hex')
        ) order by pg_catalog.encode(movement.movement_economic_hash,'hex')),
        '[]'::jsonb),
        'expense_authorities',coalesce((
          select pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
            'expense_authority_generation_id',expense.id,
            'authority_hash',pg_catalog.encode(expense.authority_hash,'hex')
          ) order by pg_catalog.encode(expense.authority_hash,'hex'))
          from public.weekly_expense_authority_generations expense
          join public.weekly_work_events event on event.id=expense.work_event_id
          where expense.final_revision_id=v_revision_id and event.client_id=v_manifest.client_id
            and v_manifest.invoice_window_cycle_id=v_cycle.id
        ),'[]'::jsonb)
      )||case when v_manifest.invoice_window_cycle_id=v_cycle.id then '{}'::jsonb else jsonb_build_object('invoice_window_cycle_id',v_manifest.invoice_window_cycle_id) end
      ||case when v_rule_version is null then '{}'::jsonb else jsonb_build_object('rule_set_version_id',v_rule_version,'rule_set_values_sha256',v_rule_set->>'values_sha256') end
    ) into v_client_manifest_hash
    from public.weekly_source_billing_movements movement
    where movement.final_revision_id=v_revision_id
      and movement.actual_client_id=v_manifest.client_id
      and private.weekly_source_invoice_movement_window_id_v1(movement.id)=v_manifest.invoice_window_cycle_id;
    insert into public.weekly_source_client_manifests(
      final_revision_id,source_group_id,source_cycle_id,invoice_window_cycle_id,client_id,
      finalisation_week_ending,backing_report_number,manifest_hash,movement_count,
      unchanged_snapshot_count,expense_line_count,invoice_state
    ) values (
      v_revision_id,v_group.id,v_cycle.id,case when v_manifest.invoice_window_cycle_id=v_cycle.id then null else v_manifest.invoice_window_cycle_id end,v_manifest.client_id,
      v_manifest.invoice_week_ending,v_backing_report_number,v_client_manifest_hash,
      (select pg_catalog.count(*)::integer
       from public.weekly_source_billing_movements movement
       where movement.final_revision_id=v_revision_id
         and movement.actual_client_id=v_manifest.client_id
         and private.weekly_source_invoice_movement_window_id_v1(movement.id)=v_manifest.invoice_window_cycle_id),
      (select pg_catalog.count(*)::integer
       from public.weekly_source_state_transitions transition_row
       join public.weekly_source_final_snapshot_lines snapshot_line
         on snapshot_line.id=transition_row.new_snapshot_line_id
       where transition_row.final_revision_id=v_revision_id
         and transition_row.outcome='NO_CHANGE'
         and snapshot_line.client_id=v_manifest.client_id
         and v_manifest.invoice_window_cycle_id=v_cycle.id),
      (select pg_catalog.count(*)::integer
       from public.weekly_expense_authority_generations expense
       join public.weekly_work_events event on event.id=expense.work_event_id
       where expense.final_revision_id=v_revision_id
         and event.client_id=v_manifest.client_id
         and v_manifest.invoice_window_cycle_id=v_cycle.id),
      'READY'
    ) returning id into v_client_manifest_id;
    insert into public.weekly_source_manifest_movements(
      client_manifest_id,billing_movement_id,manifest_ordinal,movement_hash
    )
    select v_client_manifest_id,movement.id,
           pg_catalog.row_number() over(
             order by pg_catalog.encode(movement.movement_economic_hash,'hex')
           )::integer,
           movement.movement_economic_hash
    from public.weekly_source_billing_movements movement
    where movement.final_revision_id=v_revision_id
      and movement.actual_client_id=v_manifest.client_id
      and private.weekly_source_invoice_movement_window_id_v1(movement.id)=v_manifest.invoice_window_cycle_id;
  end loop;


  if v_finalisation_lock_operation is not null then
    -- Includes the later positive-expense lineage calls. Advisory/row locks
    -- remain transaction-held; remove only this operation's working copies.
    perform private.bpay_next_source_current_lock_release_v1(v_finalisation_lock_operation);
  end if;
  if v_finalisation_lock_context then
    perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_lock_operation',v_prior_finalisation_lock_operation,true);
    perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_root_set',v_prior_finalisation_root_set,true);
  end if;

  if p_prepare_only then
    return pg_catalog.jsonb_build_object(
      'ok',true,'status','PREPARED','idempotent',false,
      'final_revision_id',v_revision_id,'source_cycle_id',v_cycle.id,
      'authority_scope_kind',v_scope_kind,'report_scope_id',v_report_scope_id,
      'upload_id',v_upload.id,'profile_code',v_profile.profile_code,
      'client_id',v_client_id,'snapshot_count',v_snapshot_count,
      'transition_count',v_transition_count,'movement_count',v_movement_count,
      'unchanged_count',v_unchanged_count,
      'expense_generation_count',v_expense_generation_count
    );
  end if;

  update public.weekly_source_client_cycle_completions completion
  set state='SUPERSEDED',superseded_at_utc=v_finalised_at
  where completion.source_cycle_id=v_cycle.id
    and completion.client_id=v_client_id and completion.state='CURRENT';
  select coalesce(pg_catalog.max(completion.completion_generation),0)+1
  into v_completion_generation
  from public.weekly_source_client_cycle_completions completion
  where completion.source_cycle_id=v_cycle.id and completion.client_id=v_client_id;
  v_completion_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_CLIENT_CYCLE_COMPLETION_V1',
    pg_catalog.jsonb_build_object(
      'source_cycle_id',v_cycle.id,'source_group_id',v_group.id,
      'client_id',v_client_id,'completion_generation',v_completion_generation,
      'completion_kind','FINAL_SOURCE','final_revision_id',v_revision_id,
      'actor_user_id',v_actor
    )
  );
  insert into public.weekly_source_client_cycle_completions(
    source_cycle_id,source_group_id,client_id,completion_generation,
    completion_kind,final_revision_id,attested_by_user_id,attested_at_utc,
    attestation_text,completion_hash,state
  ) values (
    v_cycle.id,v_group.id,v_client_id,v_completion_generation,
    'FINAL_SOURCE',v_revision_id,v_actor,v_finalised_at,null,v_completion_hash,'CURRENT'
  );

  if v_scope_kind='CYCLE' then
    update public.weekly_source_cycles
    set current_final_revision_id=v_revision_id,state='FINALISED',
        finalised_at_utc=v_finalised_at,finalised_by_user_id=v_actor
    where id=v_cycle.id and current_complete_upload_id=v_upload.id
      and current_projection_publication_id=v_publication.id
      and version=v_scope_version and current_final_revision_id is null;
    if not found then
      raise exception 'WEEKLY_SOURCE_FINALISE_CAS_LOST' using errcode='40001';
    end if;
  else
    update public.weekly_source_report_scopes
    set current_final_revision_id=v_revision_id,state='FINALISED',
        updated_at_utc=v_finalised_at
    where id=v_scope.id and current_complete_upload_id=v_upload.id
      and current_projection_publication_id=v_publication.id
      and version=v_scope_version and current_final_revision_id is null;
    if not found then
      raise exception 'WEEKLY_SOURCE_FINALISE_CAS_LOST' using errcode='40001';
    end if;
    if not exists(
      select 1
      from public.weekly_source_group_clients membership
      where membership.source_group_id=v_group.id
        and v_cycle.finalisation_week_ending between membership.valid_from
          and coalesce(membership.valid_to,'infinity'::date)
        and not exists(
          select 1
          from public.weekly_source_client_cycle_completions completion
          where completion.source_cycle_id=v_cycle.id
            and completion.client_id=membership.client_id
            and completion.state='CURRENT'
        )
    ) then
      update public.weekly_source_cycles
      set state='FINALISED',finalised_at_utc=v_finalised_at,
          finalised_by_user_id=v_actor
      where id=v_cycle.id;
    else
      update public.weekly_source_cycles
      set state='FINALISABLE'
      where id=v_cycle.id and state in ('OPEN','FINALISABLE');
    end if;
  end if;

  -- Only this genuine new CURRENT transition may resolve contained manual
  -- queries. PREPARED and retained Final replay returned earlier. Query-only
  -- resolution shares this transaction; it never changes frozen pay or money.
  perform private.weekly_source_manual_reviews_finalised_v1(v_revision_id,v_actor);

  -- PREPARED returned above and remains invisible. Capture only AFTER the
  -- real cycle/report CURRENT CAS; any failure rolls back Source and selector
  -- together. The same immutable economic/lineage facts remain authoritative.
  if coalesce(v_next_source_hooks,false) then
    perform private.bpay_next_source_current_publish_revision_v1(v_revision_id);
  end if;

  if p_correction_session_id is null and exists(
    select 1
    from public.weekly_source_cycles cycle
    where cycle.id=v_cycle.id and cycle.state='FINALISED'
  ) then
    perform private._weekly_source_settings_ensure_open_cycle_v1(
      v_group.id,v_finalised_at
    );
  end if;

  return pg_catalog.jsonb_build_object(
    'ok',true,'status',case when p_correction_session_id is null
      then 'FINALISED' else 'CORRECTED' end,'idempotent',false,
    'final_revision_id',v_revision_id,'source_cycle_id',v_cycle.id,
    'authority_scope_kind',v_scope_kind,'report_scope_id',v_report_scope_id,
    'upload_id',v_upload.id,'profile_code',v_profile.profile_code,
    'client_id',v_client_id,'snapshot_count',v_snapshot_count,
    'transition_count',v_transition_count,'movement_count',v_movement_count,
    'unchanged_count',v_unchanged_count,
    'expense_generation_count',v_expense_generation_count
  );
exception
  when invalid_text_representation or numeric_value_out_of_range or datetime_field_overflow then
    -- The function subtransaction already rolled back Source/cache/control
    -- writes on entry to this handler. Restore only the caller's exact GUCs.
    if v_finalisation_lock_context then
      perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_lock_operation',v_prior_finalisation_lock_operation,true);
      perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_root_set',v_prior_finalisation_root_set,true);
    end if;
    raise exception 'WEEKLY_SOURCE_FINALISE_VALUE_INVALID' using errcode='22023';
  when others then
    if v_finalisation_lock_context then
      perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_lock_operation',v_prior_finalisation_lock_operation,true);
      perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_root_set',v_prior_finalisation_root_set,true);
    end if;
    raise;
end;
$function$;

create or replace function private.weekly_source_invoice_duty_v1(p_root_timesheet_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_root public.timesheets%rowtype;
  v_contract public.contracts%rowtype;
  v_scope jsonb; v_ids uuid[]; v_groups uuid[]; v_invoices uuid[];
  v_movement public.weekly_source_billing_movements%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_profile public.weekly_source_format_profiles%rowtype;
  v_row public.weekly_source_upload_rows%rowtype;
  v_resolution public.weekly_source_row_resolutions%rowtype;
  v_session public.weekly_final_source_correction_sessions%rowtype;
  v_operation public.invoice_operations%rowtype;
  v_chunk public.invoice_operation_chunks%rowtype;
  v_member jsonb; v_members jsonb; v_context jsonb; v_guard jsonb; v_policy jsonb;
  v_basis jsonb:='[]'::jsonb; v_observation boolean;
  v_present boolean:=false; v_unknown boolean:=false;
  v_generation integer; v_count integer; v_invoice_id uuid; v_member_id uuid;
  v_linked_root uuid; v_text text; v_week date; v_relevant boolean;
  v_prior record;
begin
  select * into v_root from public.timesheets where timesheet_id=p_root_timesheet_id;
  if not found then return null; end if;
  select * into strict v_contract from public.contracts where id=v_root.contract_id;
  v_scope:=private.weekly_source_pay_query_scope_v1(p_root_timesheet_id);
  v_ids:=private.weekly_source_invoice_family_timesheet_ids_v1(p_root_timesheet_id);
  if v_scope is null or cardinality(v_ids) is null or cardinality(v_ids)=0 then return null; end if;
  select array_agg(distinct source_group_id) filter(where source_group_id is not null) into v_groups from (
    select c.source_group_id from public.weekly_source_row_timesheet_lineages l
      join public.weekly_source_cycles c on c.id=l.source_cycle_id where l.timesheet_id=any(v_ids)
    union select e.first_source_group_id from public.weekly_exceptional_pay_family_events fe
      join public.weekly_work_events e on e.id=fe.durable_work_event_id
      where fe.family_id=(v_scope->>'target_family_id')::uuid
    union select membership.source_group_id from public.weekly_source_group_clients membership
      where membership.client_id=v_contract.client_id
        and membership.valid_from<=v_root.week_ending_date
        and coalesce(membership.valid_to,'infinity'::date)>=v_root.week_ending_date-6
  ) groups;
  if cardinality(v_groups) is null or cardinality(v_groups)=0 then return null; end if;
  v_basis:=jsonb_build_array(jsonb_build_object('lane','DISCOVERY','groups',to_jsonb(v_groups),
    'scope',v_scope,'family_timesheet_ids',to_jsonb(v_ids)));
  select coalesce(array_agg(distinct l.invoice_id),'{}'::uuid[]) into v_invoices
    from public.invoice_lines l where l.timesheet_id=any(v_ids);

  -- Incomplete publication is not an empty invoice census. Discover across
  -- all cutoffs using client/group and actual work-date coverage, not the
  -- report's week. Nullable/unparsed date coverage remains relevant unknown.
  for v_upload in select u.* from public.weekly_source_uploads u
    join public.weekly_source_cycles c on c.id=u.source_cycle_id
    left join public.weekly_source_report_scopes s on s.id=u.report_scope_id
    where c.source_group_id=any(v_groups) and u.state not in ('CURRENT','SUPERSEDED','REJECTED')
      and (c.scope_client_id is null or c.scope_client_id=v_contract.client_id)
      and (s.client_id is null or s.client_id=v_contract.client_id)
      and (u.confirmed_coverage_start_local_date is null or u.confirmed_coverage_end_local_date is null
        or daterange(u.confirmed_coverage_start_local_date,u.confirmed_coverage_end_local_date+1,'[)')
          && daterange(v_root.week_ending_date-6,v_root.week_ending_date+1,'[)')
        or exists(select 1 from public.weekly_source_upload_rows r where r.upload_id=u.id
          and (r.work_date is null or r.work_date between v_root.week_ending_date-6 and v_root.week_ending_date)))
    order by u.id loop
    -- Prepared corrections have their complete old/new census below; they
    -- must not be permanently made unknown by their own CORRECTION_READY row.
    if v_upload.state='CORRECTION_READY' and exists(select 1 from public.weekly_final_source_correction_sessions s
      where s.id=v_upload.correction_session_id and s.replacement_correction_upload_id=v_upload.id
        and s.state in ('PREPARING','PREPARED','COMMITTING')) then continue; end if;
    v_unknown:=true;
    v_basis:=v_basis||jsonb_build_array(jsonb_build_object('lane','INCOMPLETE_IMPORT',
      'upload',to_jsonb(v_upload),'present',null));
  end loop;

  -- Placement remains a duty across report cutoffs. A historical issued
  -- document alone is not work waiting to be invoiced again.
  for v_movement in select * from public.weekly_source_billing_movements where invoice_timesheet_id=any(v_ids)
    order by id loop
    v_observation:=null;
    if v_movement.candidate_id=v_contract.candidate_id and v_movement.contract_id=v_contract.id
       and v_movement.actual_client_id=v_contract.client_id then
      if v_movement.placement_state in ('UNPLACED','PLACED') then
        -- Prepared replacements are not yet admitted invoice movements. Their
        -- complete union and current seals are qualified in CORRECTION below.
        if exists(select 1 from public.weekly_source_final_revisions f
          where f.id=v_movement.final_revision_id and f.state='PREPARED') then
          if exists(select 1 from public.weekly_final_source_correction_sessions s
            where s.prepared_final_revision_id=v_movement.final_revision_id
              and s.state in ('PREPARING','PREPARED','COMMITTING')) then continue; end if;
        end if;
        if exists(select 1 from public.weekly_source_final_revisions f
          where f.id=v_movement.final_revision_id and f.state='CURRENT'
            and f.finalised_at_utc is not null and isfinite(f.finalised_at_utc)) then v_observation:=true; end if;
      elsif v_movement.placement_state='VOIDED_BY_CORRECT_FINAL' then
        if not exists(select 1 from public.weekly_source_invoice_line_bindings b
          where b.billing_movement_id=v_movement.id and b.state='CURRENT') then v_observation:=false; end if;
      elsif v_movement.placement_state='ISSUED' and exists(
        select 1 from public.weekly_source_invoice_line_bindings b
        join public.invoice_lines l on l.id=b.invoice_line_id and l.invoice_id=b.invoice_id
        join public.invoices i on i.id=b.invoice_id
        where b.billing_movement_id=v_movement.id and b.state='CURRENT'
          and b.client_id=v_movement.actual_client_id and i.client_id=v_movement.actual_client_id
          and l.timesheet_id=v_movement.invoice_timesheet_id
          and (i.status::text='ISSUED' or i.issue_state='ISSUED')) then v_observation:=false; end if;
    end if;
    v_present:=v_present or v_observation is true; v_unknown:=v_unknown or v_observation is null;
    v_basis:=v_basis||jsonb_build_array(jsonb_build_object('lane','MOVEMENT','id',v_movement.id,
      'hash',encode(v_movement.movement_economic_hash,'hex'),'placement',v_movement.placement_state,'present',v_observation));
  end loop;

  -- Actual current imports, independent of their report/cutoff week. A
  -- checking-only NHSP import is positively excluded, not invoice authority.
  for v_upload in select u.* from public.weekly_source_uploads u
    join public.weekly_source_cycles c on c.id=u.source_cycle_id
    left join public.weekly_source_report_scopes s on s.id=u.report_scope_id
    where c.source_group_id=any(v_groups) and u.state='CURRENT'
      and (c.scope_client_id is null or c.scope_client_id=v_contract.client_id)
      and (s.client_id is null or s.client_id=v_contract.client_id) order by u.id
  loop
    v_basis:=v_basis||jsonb_build_array(jsonb_build_object('lane','CURRENT_IMPORT',
      'upload',to_jsonb(v_upload),'cycle',(select to_jsonb(c) from public.weekly_source_cycles c where c.id=v_upload.source_cycle_id),
      'report_scope',(select to_jsonb(s) from public.weekly_source_report_scopes s where s.id=v_upload.report_scope_id)));
    select * into strict v_profile from public.weekly_source_format_profiles where id=v_upload.source_format_profile_id;
    if v_profile.profile_code='NHSP_PREFINAL_RELEASED_V1' or v_profile.profile_json->>'purpose'='PREFINAL_CHECKING'
       or v_profile.row_finalisation_capability='CHECKING_ONLY' then continue; end if;
    -- A genuinely consumed Final already has its placement census above.
    if exists(select 1 from public.weekly_source_final_revisions f
      join public.weekly_source_cycles c on c.id=f.source_cycle_id
      left join public.weekly_source_report_scopes s on s.id=f.report_scope_id
      where f.upload_id=v_upload.id and f.source_cycle_id=v_upload.source_cycle_id
        and f.report_scope_id is not distinct from v_upload.report_scope_id
        and f.state='CURRENT' and f.finalised_at_utc is not null and isfinite(f.finalised_at_utc)
        and ((f.authority_scope_kind='CYCLE' and s.id is null and c.current_final_revision_id=f.id)
          or (f.authority_scope_kind in ('NHSP_REPORT_SCOPE','SELF_BILL_REPORT_SCOPE') and s.current_final_revision_id=f.id))) then continue; end if;
    select count(*) into v_count from public.weekly_source_projection_publications p
      where p.upload_id=v_upload.id and p.source_cycle_id=v_upload.source_cycle_id
        and p.report_scope_id is not distinct from v_upload.report_scope_id and p.state='CURRENT';
    if v_count<>1 then v_unknown:=true; continue; end if;
    select * into strict v_publication from public.weekly_source_projection_publications p
      where p.upload_id=v_upload.id and p.source_cycle_id=v_upload.source_cycle_id
        and p.report_scope_id is not distinct from v_upload.report_scope_id and p.state='CURRENT';
    begin
      v_guard:=private.weekly_source_current_publication_guard_v1(v_upload.source_cycle_id,
        v_publication.authority_scope_kind,v_upload.report_scope_id,v_upload.id,v_publication.id,v_publication.authority_scope_version);
    exception when sqlstate '55000' or sqlstate '22023' then v_unknown:=true; continue; end;
    if v_publication.authority_scope_version>2147483647 or coalesce(v_publication.projection_generation,0)>2147483647
       or v_publication.published_at_utc is null or not isfinite(v_publication.published_at_utc) then
      v_unknown:=true; continue; end if;
    v_generation:=coalesce(v_publication.projection_generation,v_publication.authority_scope_version::integer);
    -- Match the genuine roster Final owner's complete prior/current union.
    -- A prior root may own a reversal when its event is omitted inside coverage
    -- OR retained by a current row that moves it to another root/work week.
    -- NHSP NO_INFERENCE does not use roster omission authority.
    if v_profile.final_authority_kind in ('GENERIC_COMPLETE_SNAPSHOT','HEALTHROSTER_ACTUAL_ROWS')
       and v_profile.omission_meaning='CANCEL_INSIDE_CONFIRMED_COVERAGE' then
      for v_prior in
        with prior_states as (
          select distinct on(t.work_event_id) t.new_snapshot_line_id,t.id as transition_id
          from public.weekly_source_state_transitions t
          join public.weekly_source_final_revisions f on f.id=t.final_revision_id and f.state='CURRENT'
          join public.weekly_source_cycles c on c.id=t.finalisation_cycle_id
          join public.weekly_source_client_manifests m on coalesce(m.invoice_window_cycle_id,m.source_cycle_id)=m.source_cycle_id and m.final_revision_id=f.id and m.client_id=v_contract.client_id
          where t.source_profile_kind=v_profile.final_authority_kind
            and c.source_group_id=(select source_group_id from public.weekly_source_cycles where id=v_upload.source_cycle_id)
            and c.finalisation_week_ending<(select finalisation_week_ending from public.weekly_source_cycles where id=v_upload.source_cycle_id)
          order by t.work_event_id,c.finalisation_week_ending desc,f.finalised_at_utc desc,
            f.revision_number desc,t.created_at_utc desc,t.id desc
        ) select line.*,s.transition_id,
            exists(select 1 from public.weekly_source_row_resolutions r
              join public.weekly_source_upload_rows current_row on current_row.id=r.upload_row_id
              where current_row.upload_id=v_upload.id and r.generation=v_generation
                and r.work_event_id=line.work_event_id) as has_current_replacement
          from prior_states s
          join public.weekly_source_final_snapshot_lines line on line.id=s.new_snapshot_line_id
          where line.candidate_id=v_contract.candidate_id and line.contract_id=v_contract.id
            and line.client_id=v_contract.client_id
            and line.work_date between v_root.week_ending_date-6 and v_root.week_ending_date
          order by line.id
      loop
        v_observation:=null;
        if v_upload.coverage_state='COMPLETE' and v_upload.coverage_confirmed_by_user_id is not null
           and v_upload.coverage_confirmed_at_utc is not null and isfinite(v_upload.coverage_confirmed_at_utc)
           and v_upload.coverage_timezone='Europe/London'
           and v_upload.confirmed_coverage_start_local_date is not null
           and v_upload.confirmed_coverage_end_local_date is not null
           and (v_prior.work_date between v_upload.confirmed_coverage_start_local_date and v_upload.confirmed_coverage_end_local_date
             or v_prior.has_current_replacement) then
          begin
            v_policy:=private._weekly_source_effective_policy_v1(v_contract.client_id,v_contract.id,v_prior.work_date);
            v_linked_root:=private.weekly_source_finalisation_lineage_assert_v1(v_prior.row_resolution_id,
              (select source_cycle_id from public.weekly_source_final_revisions where id=v_prior.final_revision_id));
            if v_linked_root=p_root_timesheet_id and v_policy->>'authority_mode'='SOURCE_AUTHORITY'
               and v_policy->>'self_bill_enabled'='true'
               and v_policy->>'source_group_id'=(select source_group_id::text from public.weekly_source_cycles where id=v_upload.source_cycle_id)
              then v_observation:=true; end if;
          exception when sqlstate '55000' or sqlstate '40001' or sqlstate '22023' then null; end;
        elsif v_upload.coverage_state='COMPLETE'
           and v_upload.confirmed_coverage_start_local_date is not null
           and v_upload.confirmed_coverage_end_local_date is not null
           and not v_prior.has_current_replacement
           and v_prior.work_date not between v_upload.confirmed_coverage_start_local_date and v_upload.confirmed_coverage_end_local_date
          then v_observation:=false;
        end if;
        v_present:=v_present or v_observation is true; v_unknown:=v_unknown or v_observation is null;
        v_basis:=v_basis||jsonb_build_array(jsonb_build_object('lane','PREFINAL_ROSTER_PRIOR_CURRENT_UNION',
          'prior_snapshot',to_jsonb(v_prior),'publication',to_jsonb(v_publication),'present',v_observation));
      end loop;
    end if;
    for v_row in select * from public.weekly_source_upload_rows where upload_id=v_upload.id
      and (work_date is null or work_date between v_root.week_ending_date-6 and v_root.week_ending_date) order by id loop
      if v_row.row_finalisation_state='SOURCE_REPORT_LINE' then
        select rr.* into v_resolution from public.weekly_source_self_bill_report_line_bindings b
          join public.weekly_source_row_resolutions rr on rr.id=b.bound_row_resolution_id
          where b.report_row_id=v_row.id and b.state='CURRENT';
        if not found then
          -- A never-bound line may be this root's mapped Request. Its report
          -- obligation is unknown, never a fabricated Withdrawn/no-duty state.
          if exists(select 1 from public.weekly_work_events e where e.first_source_group_id=any(v_groups)
            and e.client_id=v_contract.client_id and e.candidate_id=v_contract.candidate_id
            and e.work_date=v_row.work_date and e.profile_external_key=v_row.external_source_key) then v_unknown:=true; end if;
        elsif v_resolution.candidate_id=v_contract.candidate_id and v_resolution.client_id=v_contract.client_id
          and v_resolution.contract_id=v_contract.id then
          v_present:=true;
          v_basis:=v_basis||jsonb_build_array(jsonb_build_object('lane','ACCEPTED_REPORT_ROW','report_row_id',v_row.id,
            'report_row_hash',encode(v_row.normalised_row_hash,'hex'),'bound_row_resolution_id',v_resolution.id,
            'publication',to_jsonb(v_publication),'present',true));
        end if;
        continue;
      end if;
      select * into v_resolution from public.weekly_source_row_resolutions
        where upload_row_id=v_row.id and generation=v_generation;
      v_basis:=v_basis||jsonb_build_array(jsonb_build_object('lane','CURRENT_ROW_DISCOVERY',
        'row_id',v_row.id,'row_hash',encode(v_row.normalised_row_hash,'hex'),
        'resolution',to_jsonb(v_resolution),'publication',to_jsonb(v_publication)));
      if not found then v_unknown:=true; continue; end if;
      if v_resolution.candidate_id is not null and v_resolution.candidate_id<>v_contract.candidate_id
         or v_resolution.client_id is not null and v_resolution.client_id<>v_contract.client_id
         or v_resolution.contract_id is not null and v_resolution.contract_id<>v_contract.id then continue; end if;
      if v_resolution.mapping_state<>'RESOLVED' or v_row.work_date is null
         or v_contract.week_ending_weekday_snapshot is null
         or v_contract.week_ending_weekday_snapshot not between 0 and 6
         or v_row.work_date<v_contract.start_date
         or (v_contract.end_date is not null and v_row.work_date>v_contract.end_date)
         or v_root.submission_mode is distinct from 'MANUAL' then v_unknown:=true; continue; end if;
      begin
        v_policy:=private._weekly_source_effective_policy_v1(v_contract.client_id,v_contract.id,v_row.work_date);
      exception when sqlstate '55000' or sqlstate '22023' then v_unknown:=true; continue; end;
      if v_policy->>'authority_mode' is distinct from 'SOURCE_AUTHORITY'
         or v_policy->>'self_bill_enabled' is distinct from 'true'
         or v_policy->>'source_group_id' is distinct from (
           select c.source_group_id::text from public.weekly_source_cycles c where c.id=v_upload.source_cycle_id)
         or encode(v_resolution.effective_policy_fingerprint,'hex') is distinct from v_policy->>'policy_sha256'
         then v_unknown:=true; continue; end if;
      v_week:=v_row.work_date+((v_contract.week_ending_weekday_snapshot-extract(dow from v_row.work_date)::integer+7)%7);
      if v_week<>v_root.week_ending_date then continue; end if;
      v_linked_root:=null;
      if exists(select 1 from public.weekly_source_row_timesheet_lineages where row_resolution_id=v_resolution.id) then
        begin
          v_linked_root:=private.weekly_source_finalisation_lineage_assert_v1(v_resolution.id,v_upload.source_cycle_id);
        exception when sqlstate '55000' or sqlstate '40001' then v_unknown:=true; continue; end;
      else
        select cw.timesheet_id into v_linked_root from public.contract_weeks cw
          where cw.contract_id=v_contract.id and cw.week_ending_date=v_week and cw.additional_seq=0
            and not cw.is_adjustment and cw.status<>'CANCELLED'
            and cw.submission_mode_snapshot='MANUAL';
      end if;
      if v_linked_root is distinct from p_root_timesheet_id
         or not v_root.is_current or v_root.is_adjustment or v_root.revoked_at is not null
         or v_root.archived_at_utc is not null or v_root.sheet_scope<>'WEEKLY' or v_root.line_type<>'HOURS' then
        v_unknown:=true; continue; end if;
      v_present:=true;
      v_basis:=v_basis||jsonb_build_array(jsonb_build_object('lane','PREFINAL','row_id',v_row.id,
        'resolution_id',v_resolution.id,'generation',v_generation,'publication_guard',v_guard));
    end loop;
  end loop;

  -- Correct Final's full old/new union includes removal of its last movement.
  -- Unprepared or stale relevant replacements stay unknown, not empty.
  for v_session in select s.* from public.weekly_final_source_correction_sessions s
    join public.weekly_source_cycles c on c.id=s.source_cycle_id
    where c.source_group_id=any(v_groups) and s.state in ('DRAFT','STAGING','READY','REVIEWED','PREPARING','PREPARED','COMMITTING')
      and exists(select 1 from public.weekly_source_client_manifests m where coalesce(m.invoice_window_cycle_id,m.source_cycle_id)=m.source_cycle_id and m.final_revision_id=s.expected_current_final_revision_id and m.client_id=v_contract.client_id) order by s.id
  loop
    v_basis:=v_basis||jsonb_build_array(jsonb_build_object('lane','CORRECTION_DISCOVERY','session',to_jsonb(v_session)));
    if exists(select 1 from public.weekly_source_ordinary_pay_projection_receipts r
      where r.final_revision_id=v_session.expected_current_final_revision_id and r.root_timesheet_id=any(v_ids)
        and r.outcome in ('PREPARED_FOR_AUTHORISATION','PROPOSED')) then
      if v_session.prepared_final_revision_id is null then v_unknown:=true; continue; end if;
    elsif v_session.prepared_final_revision_id is null then v_unknown:=true; continue; end if;
    begin v_context:=private.weekly_source_correct_final_prepared_context_v1(v_session.id);
    exception when sqlstate '55000' then v_unknown:=true; continue; end;
    if v_session.prepare_result_hash is distinct from private.weekly_source_sha256_jsonb_v1(
         'WEEKLY_SOURCE_CORRECT_FINAL_PREPARE_RESULT_V1',v_session.prepare_result_json)
       or v_context->'root_contexts' is distinct from v_session.prepare_result_json->'root_contexts'
      or coalesce(v_context->'missing_cancel_basis_census','{}'::jsonb)
        is distinct from coalesce(v_session.prepare_result_json->'missing_cancel_basis_census','{}'::jsonb)
       or not exists(select 1 from public.weekly_source_final_revisions f
         join public.weekly_source_cycles c on c.id=f.source_cycle_id
         left join public.weekly_source_report_scopes s on s.id=f.report_scope_id
         where f.id=v_session.expected_current_final_revision_id and f.state='CURRENT'
           and f.manifest_hash=v_session.expected_final_manifest_hash
           and f.finalised_at_utc is not null and isfinite(f.finalised_at_utc)
           and f.source_cycle_id=v_session.source_cycle_id and f.report_scope_id is not distinct from v_session.report_scope_id
           and ((f.authority_scope_kind='CYCLE' and c.current_final_revision_id=f.id)
             or (f.authority_scope_kind in ('NHSP_REPORT_SCOPE','SELF_BILL_REPORT_SCOPE') and s.current_final_revision_id=f.id)))
       or not exists(select 1 from public.weekly_source_projection_publications p
         join public.weekly_source_uploads u on u.id=p.upload_id
         join public.weekly_source_final_revisions f on f.id=v_session.prepared_final_revision_id
         join public.weekly_source_format_profiles profile on profile.id=u.source_format_profile_id
         join public.weekly_source_final_revisions prior on prior.id=v_session.expected_current_final_revision_id
         join public.weekly_source_uploads prior_upload on prior_upload.id=prior.upload_id
         join public.weekly_source_format_profiles prior_profile on prior_profile.id=prior_upload.source_format_profile_id
         join public.weekly_source_cycles cycle on cycle.id=v_session.source_cycle_id
         join public.weekly_source_groups source_group on source_group.id=cycle.source_group_id
         left join public.weekly_source_report_scopes report_scope on report_scope.id=v_session.report_scope_id
         where p.id=v_session.replacement_projection_publication_id and u.id=v_session.replacement_correction_upload_id
           and p.state='CORRECTION_READY' and u.state='CORRECTION_READY'
           and p.correction_session_id=v_session.id and u.correction_session_id=v_session.id
           and p.source_cycle_id=v_session.source_cycle_id and u.source_cycle_id=v_session.source_cycle_id
           and p.report_scope_id is not distinct from v_session.report_scope_id
           and u.report_scope_id is not distinct from v_session.report_scope_id
           and u.purpose='FINAL_SOURCE_CORRECTION'
           and p.authority_scope_kind=v_session.authority_scope_kind
           and u.row_manifest_hash is not null and p.comparison_manifest_hash is not null and p.issue_set_hash is not null
           and p.authority_scope_version=case when v_session.authority_scope_kind='NHSP_REPORT_SCOPE'
             then report_scope.version else cycle.version end
           and prior_upload.state='CURRENT'
           and exists(select 1 from public.weekly_source_projection_publications current_publication
             where current_publication.id=case when v_session.authority_scope_kind='NHSP_REPORT_SCOPE'
               then report_scope.current_projection_publication_id else cycle.current_projection_publication_id end
               and current_publication.state='CURRENT' and current_publication.upload_id=prior_upload.id)
           and profile.final_authority_kind=prior_profile.final_authority_kind
           and (profile.final_authority_kind='NHSP_TRUST_BACKING_REPORT')=(source_group.source_family='NHSP')
           and f.state='PREPARED' and f.reason='CORRECT_FINAL_SOURCE'
           and f.upload_id=u.id and f.source_cycle_id=cycle.id
           and f.report_scope_id is not distinct from v_session.report_scope_id
           and f.predecessor_revision_id=prior.id
           and v_session.prepare_result_json->>'final_revision_id'=f.id::text
           and f.manifest_hash=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_FINAL_REVISION_MANIFEST_V1',
             jsonb_build_object('source_cycle_id',cycle.id,'authority_scope_kind',v_session.authority_scope_kind,
               'report_scope_id',v_session.report_scope_id,'revision_number',f.revision_number,'upload_id',u.id,
               'authority_scope_version',p.authority_scope_version,'row_manifest_hash',encode(u.row_manifest_hash,'hex'),
               'comparison_manifest_hash',encode(p.comparison_manifest_hash,'hex'),'issue_set_hash',encode(p.issue_set_hash,'hex'),
               'profile_code',profile.profile_code,'profile_version',profile.version,
               'coverage_start_local_date',f.coverage_start_local_date,'coverage_end_local_date',f.coverage_end_local_date,
               'reason',f.reason,'predecessor_revision_id',f.predecessor_revision_id,
               'prior_state_cutoff_revision_id',f.prior_state_cutoff_revision_id,
               'policy_fingerprint',encode(f.policy_fingerprint,'hex'))
               ||case when f.missing_cancel_basis_census='{}'::jsonb then '{}'::jsonb else jsonb_build_object(
                 'missing_cancel_basis_census',f.missing_cancel_basis_census) end
               ||case when f.rule_set_version_id is null then '{}'::jsonb else jsonb_build_object(
                 'rule_set_version_id',f.rule_set_version_id,'rule_set_values_sha256',(
                   select version.values_sha256 from public.weekly_source_rule_set_versions version
                   where version.id=f.rule_set_version_id)) end)) then
      v_unknown:=true; continue; end if;
    v_guard:=private.weekly_source_correct_final_office_preview_v1(v_session.id);
    if v_session.prepare_result_json->'office_preview' is distinct from v_guard
       or v_session.review_result_json->'office_preview' is distinct from v_guard
       or jsonb_array_length(v_guard->'blockers')<>0 then v_unknown:=true; continue; end if;
    if not exists(select 1 from jsonb_array_elements(v_context->'root_contexts') r
      where (r->>'root_timesheet_id')::uuid=any(v_ids)) then continue; end if;
    v_present:=true;
    v_basis:=v_basis||jsonb_build_array(jsonb_build_object('lane','CORRECTION','session_id',v_session.id,
      'prepared_context',v_context,'prepare_result_hash',encode(v_session.prepare_result_hash,'hex')));
  end loop;

  -- Use actual committed member chunks, not a client-wide fence. Ordinary
  -- selection expanders already exclude Source-owned roots in their owner.
  for v_chunk in select c.* from public.invoice_operation_chunks c
    join public.invoice_operations o on o.id=c.operation_id
    where o.status in ('QUEUED','RUNNING','WAITING','RETRY_WAIT','BLOCKED')
      and c.status in ('QUEUED','RUNNING','WAITING','RETRY_WAIT','BLOCKED')
      and (not c.is_manifest_member or c.manifest_committed)
      and coalesce(c.payload_json->>'is_selection_expander','false')<>'true'
      and (not c.is_manifest_member or coalesce(c.entity_type,'')<>'OPERATION') order by c.id
  loop
    select * into strict v_operation from public.invoice_operations where id=v_chunk.operation_id;
    v_observation:=false;
    v_relevant:=(v_chunk.entity_type='TIMESHEET' and v_chunk.entity_id=any(v_ids))
      or (v_chunk.entity_type='INVOICE' and v_chunk.entity_id=any(v_invoices))
      or (v_operation.entity_type='TIMESHEET' and v_operation.entity_id=any(v_ids))
      or (v_operation.entity_type='INVOICE' and v_operation.entity_id=any(v_invoices));
    if v_chunk.entity_type='TIMESHEET' and v_chunk.entity_id=any(v_ids) then
      if v_operation.operation_type in ('GENERATE_INVOICES','ISSUE_INVOICES','RECONCILE_INVOICE_WORK') then v_observation:=true;
      elsif v_operation.operation_type='BUILD_DOCUMENT' then v_observation:=null; end if;
    end if;
    if v_chunk.payload_json->>'command_type'='GENERATE_CREDIT_NOTE' then
      v_text:=coalesce(v_chunk.payload_json->>'source_invoice_id',v_chunk.entity_id::text);
      if coalesce(v_text,'')!~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then
        if v_relevant then v_observation:=null; end if;
      else
        v_invoice_id:=v_text::uuid;
        if (v_chunk.entity_type='INVOICE' and v_chunk.entity_id=any(v_invoices)
          and v_chunk.entity_id is distinct from v_invoice_id) then
          v_observation:=null;
        elsif v_invoice_id=any(v_invoices) then
          v_relevant:=true;
          if v_chunk.entity_id is not null and v_chunk.entity_id<>v_invoice_id then v_observation:=null;
          else v_observation:=true; end if;
        end if;
      end if;
    elsif v_operation.operation_type='GENERATE_INVOICES' then
      v_members:=v_chunk.payload_json->'canonical_source_members';
      if v_chunk.payload_json ? 'canonical_source_members' and jsonb_typeof(v_members) is distinct from 'array' then
        -- A malformed primary manifest must not be replaced by fallback IDs.
        -- Fallback membership is discovery only, to qualify the relevant NULL.
        v_members:=coalesce(v_chunk.payload_json->'canonical_source_ids',v_chunk.payload_json->'source_ids','[]'::jsonb);
        if jsonb_typeof(v_members)='array' and exists(select 1 from jsonb_array_elements_text(v_members) s(value)
          where lower(s.value)=any(select id::text from unnest(v_ids) id)) then v_relevant:=true; end if;
        if v_relevant then v_observation:=null; end if;
        v_members:='[]'::jsonb;
      elsif v_members is null or jsonb_array_length(v_members)=0 then
        v_members:=coalesce(v_chunk.payload_json->'canonical_source_ids',v_chunk.payload_json->'source_ids','[]'::jsonb);
        if jsonb_typeof(v_members) is distinct from 'array' then
          if v_relevant then v_observation:=null; end if;
          v_members:='[]'::jsonb;
        else
          select coalesce(jsonb_agg(jsonb_build_object('source_type','TIMESHEET','source_id',s.value,
            'related_timesheet_id',s.value) order by s.ordinality),'[]'::jsonb) into v_members
            from jsonb_array_elements_text(v_members) with ordinality s(value,ordinality);
        end if;
      end if;
      -- Discover actual membership before validating ANY member, so malformed
      -- earlier evidence cannot disappear merely because the owned root is last.
      if exists(select 1 from jsonb_array_elements(v_members) m(value)
        where lower(m.value->>'related_timesheet_id')=any(select id::text from unnest(v_ids) id)
          or lower(m.value->>'source_id')=any(select id::text from unnest(v_ids) id)) then v_relevant:=true; end if;
      for v_member in select value from jsonb_array_elements(v_members) loop
        -- Canonical TIMESHEET members carry both independently valid identities.
        -- COALESCE cannot let a valid related ID conceal a malformed source ID.
        if upper(coalesce(v_member->>'source_type','TIMESHEET'))='TIMESHEET' then
          if coalesce(v_member->>'source_id','')!~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
             or coalesce(v_member->>'related_timesheet_id','')!~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then
            if v_relevant then v_observation:=null; end if;
            continue;
          end if;
          if (v_member->>'source_id')::uuid is distinct from (v_member->>'related_timesheet_id')::uuid then
            if v_relevant then v_observation:=null; end if;
            continue;
          end if;
        end if;
        v_text:=coalesce(v_member->>'related_timesheet_id',v_member->>'source_id');
        if coalesce(v_text,'')!~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then
          if v_relevant then v_observation:=null; end if;
          continue; end if;
        v_member_id:=v_text::uuid;
        if v_member_id=any(v_ids) then
          v_relevant:=true;
          if upper(coalesce(v_member->>'source_type','TIMESHEET'))='TIMESHEET' then
            if v_observation is not null then v_observation:=true; end if;
          else v_observation:=null; end if;
        end if;
      end loop;
    else
      v_text:=coalesce(v_chunk.payload_json->>'invoice_id',case when v_chunk.entity_type='INVOICE' then v_chunk.entity_id::text end);
      if v_chunk.entity_type='INVOICE' and v_chunk.entity_id=any(v_invoices)
         and v_text is distinct from v_chunk.entity_id::text then v_observation:=null;
      elsif v_text ~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' and v_text::uuid=any(v_invoices) then
        v_relevant:=true;
        if v_operation.operation_type='ISSUE_INVOICES' then v_observation:=true;
        elsif v_operation.operation_type='BUILD_DOCUMENT' then v_observation:=null; end if;
      end if;
    end if;
    if v_relevant then
      v_present:=v_present or v_observation is true; v_unknown:=v_unknown or v_observation is null;
      v_basis:=v_basis||jsonb_build_array(jsonb_build_object('lane','OPERATION_CHUNK',
        'operation',to_jsonb(v_operation),'chunk',to_jsonb(v_chunk),'present',v_observation));
    end if;
  end loop;
  -- ISSUE can be queued before its exact invoice chunks have been expanded.
  for v_operation in select * from public.invoice_operations where operation_type='ISSUE_INVOICES'
    and status in ('QUEUED','RUNNING','WAITING','RETRY_WAIT','BLOCKED') order by id loop
    v_relevant:=v_operation.entity_type='INVOICE' and v_operation.entity_id=any(v_invoices);
    v_observation:=case when v_relevant then true else false end;
    if v_operation.input_json ? 'invoice_ids' then
      if jsonb_typeof(v_operation.input_json->'invoice_ids') is distinct from 'array' then
        if v_relevant then v_observation:=null; end if;
      else
        v_members:=v_operation.input_json->'invoice_ids';
        if exists(select 1 from jsonb_array_elements_text(v_members) s(value)
          where lower(s.value)=any(select id::text from unnest(v_invoices) id)) then v_relevant:=true; end if;
        if v_relevant then
          if exists(select 1 from jsonb_array_elements_text(v_members) s(value)
            where coalesce(s.value,'')!~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
            then v_observation:=null; else v_observation:=true; end if;
        end if;
      end if;
    end if;
    if v_relevant then
      v_present:=v_present or v_observation is true; v_unknown:=v_unknown or v_observation is null;
      v_basis:=v_basis||jsonb_build_array(jsonb_build_object('lane','QUEUED_ISSUE',
        'operation',to_jsonb(v_operation),'present',v_observation));
    end if;
  end loop;
  return jsonb_build_object('scope',v_scope,'present',case when v_present then true when v_unknown then null else false end,
    'discovery_complete',not v_unknown,'basis',v_basis);
end;
$function$;

create or replace function private.weekly_source_missing_prepared_census_recheck_v1(
  p_final_revision_id uuid,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_revision public.weekly_source_final_revisions%rowtype;
  v_transition public.weekly_source_state_transitions%rowtype;
  v_entry record; v_basis jsonb; v_context jsonb; v_original jsonb; v_ids uuid[];
begin
  select * into strict v_revision from public.weekly_source_final_revisions where id=p_final_revision_id;
  if v_revision.missing_cancel_basis_census='{}'::jsonb then return '{}'::jsonb; end if;
  if p_actor_user_id is null or v_revision.state is distinct from 'PREPARED'
    or v_revision.reason is distinct from 'CORRECT_FINAL_SOURCE'
    or v_revision.finalised_by_user_id is distinct from p_actor_user_id then
    raise exception 'WEEKLY_SOURCE_MISSING_PREPARED_NATIVE_ACTOR_REQUIRED' using errcode='42501';
  end if;
  for v_entry in select key,value from jsonb_each(v_revision.missing_cancel_basis_census) order by key loop
    select array_agg(transition.id) into v_ids from public.weekly_source_state_transitions transition
      where transition.final_revision_id=v_revision.id and transition.work_event_id=v_entry.key::uuid;
    if coalesce(cardinality(v_ids),0)<>1 then
      raise exception 'WEEKLY_SOURCE_MISSING_PREPARED_TRANSITION_UNBOUND' using errcode='40001';
    end if;
    select * into strict v_transition from public.weekly_source_state_transitions where id=v_ids[1];
    v_basis:=v_entry.value->'basis';
    if v_basis is null or v_basis='null'::jsonb then
      -- A raw-present non-absence result is never promoted into an absent
      -- basis by this reader. Its distinct native path remains unchanged.
      if v_entry.value->>'disposition' is distinct from 'NOT_GENUINELY_ABSENT'
        or v_transition.exclude_cancel then
        raise exception 'WEEKLY_SOURCE_MISSING_PREPARED_BASIS_INVALID' using errcode='40001';
      end if;
      continue;
    end if;
    if v_basis->>'work_event_id' is distinct from v_transition.work_event_id::text
      or v_basis->>'previous_snapshot_line_id' is distinct from v_transition.previous_snapshot_line_id::text
      or v_basis->>'actor_user_id' is distinct from p_actor_user_id::text
      or v_basis->>'basis_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_MISSING_CANCEL_BASIS_V1',v_basis-'basis_sha256'),'hex') then
      raise exception 'WEEKLY_SOURCE_MISSING_PREPARED_BASIS_INVALID' using errcode='40001';
    end if;
    v_context:=private.weekly_source_kept_as_paid_context_for_publication_v1(
      v_transition.work_event_id,p_actor_user_id,(v_basis->>'projection_publication_id')::uuid);
    v_original:=private.weekly_source_missing_snapshot_movement_v1(v_transition.previous_snapshot_line_id);
    if v_context is distinct from v_basis->'target_native_context'
      or v_original is distinct from v_basis->'original_basis'
      or v_context->'source_present' is distinct from 'false'::jsonb then
      raise exception 'WEEKLY_SOURCE_MISSING_PREPARED_FACTS_CHANGED' using errcode='40001';
    end if;
    if v_basis ? 'correction_baseline' then
      if v_transition.exclude_cancel
        or v_entry.value->>'disposition' is distinct from 'CANCEL_NOT_PAID_OR_INVOICED'
        or private.weekly_source_missing_correction_baseline_v1(
          (v_basis->>'projection_publication_id')::uuid,v_transition.previous_snapshot_line_id,p_actor_user_id)
          is distinct from v_basis->'correction_baseline' then
        raise exception 'WEEKLY_SOURCE_MISSING_PREPARED_CORRECTION_BASELINE_CHANGED' using errcode='40001';
      end if;
    end if;
    if v_transition.exclude_cancel then
      perform private.weekly_source_missing_cancel_transition_assert_v1(v_transition.id);
    elsif v_entry.value->>'disposition'='ACCEPTED_SOURCE_REMOVED' then
      if v_context->'accepted_source_removed' is distinct from 'true'::jsonb
        or v_context->'accepted_source_removal_proofs' is distinct from v_basis->'accepted_removals' then
        raise exception 'WEEKLY_SOURCE_MISSING_PREPARED_ACCEPTED_REMOVAL_CHANGED' using errcode='40001';
      end if;
    elsif v_entry.value->>'disposition' is distinct from 'CANCEL_NOT_PAID_OR_INVOICED'
      or v_context->'paid' is distinct from 'false'::jsonb
      or v_context->'invoiced' is distinct from 'false'::jsonb then
      raise exception 'WEEKLY_SOURCE_MISSING_PREPARED_DISPOSITION_CHANGED' using errcode='40001';
    end if;
  end loop;
  return v_revision.missing_cancel_basis_census;
end;
$function$;

create or replace function private.weekly_source_correct_final_prepared_context_v1(
  p_correction_session_id uuid
) returns jsonb
language plpgsql stable security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_session public.weekly_final_source_correction_sessions%rowtype;
  v_revision public.weekly_source_final_revisions%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_profile public.weekly_source_format_profiles%rowtype;
  v_manifest public.weekly_source_client_manifests%rowtype;
  v_receipt public.weekly_source_ordinary_pay_projection_receipts%rowtype;
  v_root record;
  v_source_mode text;
  v_source_units jsonb;
  v_segments jsonb;
  v_expenses jsonb;
  v_actual jsonb;
  v_rate_refs jsonb;
  v_context jsonb;
  v_paid_choice_census jsonb;
  v_contexts jsonb:='[]'::jsonb;
  v_source_unit_hash bytea;
  v_source_expense_hash bytea;
  v_active_segment_hash bytea;
begin
  select * into v_session
  from public.weekly_final_source_correction_sessions
  where id=p_correction_session_id;
  if not found or v_session.state not in ('PREPARING','PREPARED','COMMITTING')
     or v_session.prepared_final_revision_id is null then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PREPARED_CONTEXT_UNAVAILABLE'
      using errcode='55000';
  end if;
  select * into strict v_revision
  from public.weekly_source_final_revisions
  where id=v_session.prepared_final_revision_id;
  select * into strict v_cycle
  from public.weekly_source_cycles where id=v_revision.source_cycle_id;
  select * into strict v_upload
  from public.weekly_source_uploads where id=v_revision.upload_id;
  select * into strict v_profile
  from public.weekly_source_format_profiles where id=v_upload.source_format_profile_id;
  select * into v_manifest
  from public.weekly_source_client_manifests
  where coalesce(invoice_window_cycle_id,source_cycle_id)=source_cycle_id and final_revision_id=v_revision.id;
  if not found or exists(
    select 1 from public.weekly_source_client_manifests other_manifest where coalesce(other_manifest.invoice_window_cycle_id,other_manifest.source_cycle_id)=other_manifest.source_cycle_id and other_manifest.final_revision_id=v_revision.id
      and other_manifest.id<>v_manifest.id
  ) or v_revision.state<>'PREPARED'
     or v_revision.reason<>'CORRECT_FINAL_SOURCE'
     or v_revision.predecessor_revision_id
          is distinct from v_session.expected_current_final_revision_id
     or v_upload.id is distinct from v_session.replacement_correction_upload_id
     or v_upload.state<>'CORRECTION_READY' then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PREPARED_CONTEXT_INVALID'
      using errcode='55000';
  end if;
  if v_revision.authority_scope_kind in ('CYCLE','NHSP_REPORT_SCOPE') or v_revision.paid_overlap_choice_census<>'{}'::jsonb then
    v_paid_choice_census:=private.weekly_source_paid_match_prepared_census_recheck_v1(v_revision.id,v_session.actor_user_id);
  end if;
  v_source_mode:=case when v_profile.final_authority_kind='NHSP_TRUST_BACKING_REPORT'
    then 'NHSP_WEEKLY' else 'HEALTHROSTER_WEEKLY' end;

  -- Rebuild the complete union, not merely roots published by the mistaken
  -- authority.  A valid complete replacement may add a root or remove the
  -- last movement from an old root; both need one exact ordinary projection.
  for v_root in
    with prior_roots as (
      select receipt.root_timesheet_id,receipt.id as prior_projection_receipt_id
      from public.weekly_source_ordinary_pay_projection_receipts receipt
      where receipt.final_revision_id=v_session.expected_current_final_revision_id
        and receipt.outcome in ('PREPARED_FOR_AUTHORISATION','PROPOSED')
    ), replacement_roots as (
      select distinct movement.invoice_timesheet_id as root_timesheet_id
      from public.weekly_source_billing_movements movement
      where movement.source_profile_kind<>'SELF_BILL_REPORT' and movement.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION')
        and (movement.pay_effect='NORMAL' or (movement.pay_effect='NONE'
          and movement.source_profile_kind='NHSP_TRUST_BACKING_REPORT' and movement.source_line_kind='NHSP_PHYSICAL_POSITIVE'
          and private.weekly_source_nhsp_none_invoice_origin_assert_v1(movement.id)->>'final_revision_id'=v_revision.id::text))
      and movement.final_revision_id=v_revision.id
    )
    select coalesce(replacement.root_timesheet_id,prior.root_timesheet_id)
             as root_timesheet_id,
           prior.prior_projection_receipt_id
    from prior_roots prior
    full join replacement_roots replacement using(root_timesheet_id)
    order by coalesce(replacement.root_timesheet_id,prior.root_timesheet_id)
  loop
    v_source_units:=private.weekly_source_ordinary_projection_source_units_v1(
      v_revision.id,v_root.root_timesheet_id
    );
    v_segments:=private.weekly_source_ordinary_projection_current_segments_v1(
      v_root.root_timesheet_id,v_revision.id
    );
    v_expenses:=private.weekly_source_ordinary_projection_current_expenses_v1(
      v_root.root_timesheet_id,v_revision.id
    );
    v_actual:=private.weekly_source_ordinary_projection_actual_schedule_v1(v_segments);
    v_source_unit_hash:=private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_ORDINARY_UNIT_MANIFEST_V1',v_source_units
    );
    v_source_expense_hash:=private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_ORDINARY_SOURCE_EXPENSE_MANIFEST_V1',v_expenses
    );
    v_active_segment_hash:=private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_ORDINARY_ACTIVE_SEGMENTS_V1',v_segments
    );
    v_rate_refs:=pg_catalog.jsonb_build_object(
      'schema_version','WEEKLY_SOURCE_FINAL_AUTHORITY_RATE_SOURCE_V1',
      'source_mode',v_source_mode,'root_timesheet_id',v_root.root_timesheet_id,
      'final_revision_id',v_revision.id,
      'final_manifest_hash',pg_catalog.encode(v_revision.manifest_hash,'hex'),
      'final_policy_fingerprint',pg_catalog.encode(v_revision.policy_fingerprint,'hex'),
      'client_manifest_hash',pg_catalog.encode(v_manifest.manifest_hash,'hex'),
      'source_unit_manifest_hash',pg_catalog.encode(v_source_unit_hash,'hex'),
      'source_expense_manifest_hash',pg_catalog.encode(v_source_expense_hash,'hex'),
      'active_segment_manifest_hash',pg_catalog.encode(v_active_segment_hash,'hex')
    );
    v_context:=pg_catalog.jsonb_build_object(
      'root_timesheet_id',v_root.root_timesheet_id,
      'prior_projection_receipt_id',v_root.prior_projection_receipt_id,
      'client_id',v_manifest.client_id,
      'source_profile_kind',v_profile.final_authority_kind,
      'source_mode',v_source_mode,
      'source_units',v_source_units,
      'expected_segments',v_segments,
      'expected_actual_schedule',v_actual,
      'expected_source_expenses',v_expenses,
      'expected_rate_source_refs',v_rate_refs,
      'root_state_hash',pg_catalog.encode(
         private.weekly_source_ordinary_projection_root_hash_v1(
          v_root.root_timesheet_id
        ),'hex'
      )
    );
    v_contexts:=v_contexts||pg_catalog.jsonb_build_array(
      v_context||pg_catalog.jsonb_build_object(
        'prepared_context_hash',pg_catalog.encode(
          private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_SOURCE_CORRECT_FINAL_PREPARED_ROOT_CONTEXT_V1',v_context
          ),'hex'
        )
      )
    );
  end loop;

  return pg_catalog.jsonb_build_object(
    'correction_session_id',v_session.id,
    'prepared_final_revision_id',v_revision.id,
    'prior_final_revision_id',v_session.expected_current_final_revision_id,
    'source_cycle_id',v_cycle.id,
    'client_id',v_manifest.client_id,
    'source_profile_kind',v_profile.final_authority_kind,
    'source_mode',v_source_mode,
    'root_contexts',v_contexts
  )||case when v_revision.missing_cancel_basis_census='{}'::jsonb then '{}'::jsonb else jsonb_build_object(
    'missing_cancel_basis_census',private.weekly_source_missing_prepared_census_recheck_v1(v_revision.id,v_session.actor_user_id)) end
    ||case when v_revision.paid_overlap_choice_census='{}'::jsonb then '{}'::jsonb else jsonb_build_object(
      'paid_overlap_choice_census',v_paid_choice_census) end;
end;
$function$;

create or replace function public.weekly_source_correct_final_prepare_atomic_v1(
  p_request jsonb
) returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_expected_keys text[]:=array[
    'actor_user_id','correction_session_id','expected_authority_scope_version',
    'expected_comparison_manifest_hash','expected_issue_set_hash',
    'expected_preview_hash','expected_row_manifest_hash','expected_session_version',
    'idempotency_key','reason','confirmation_text',
    'replacement_projection_publication_id','replacement_upload_id','schema_version'
  ];
  v_actual_keys text[];
  v_actor uuid;
  v_session_id uuid;
  v_upload_id uuid;
  v_publication_id uuid;
  v_expected_session_version bigint;
  v_scope_version bigint;
  v_expected_row_hash bytea;
  v_expected_comparison_hash bytea;
  v_expected_issue_hash bytea;
  v_expected_preview_hash bytea;
  v_idempotency_key text;
  v_reason text;
  v_confirmation_text text;
  v_request_hash bytea;
  v_session public.weekly_final_source_correction_sessions%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_scope public.weekly_source_report_scopes%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_prior_revision public.weekly_source_final_revisions%rowtype;
  v_prior_upload public.weekly_source_uploads%rowtype;
  v_prior_publication public.weekly_source_projection_publications%rowtype;
  v_prior_profile public.weekly_source_format_profiles%rowtype;
  v_replacement_upload public.weekly_source_uploads%rowtype;
  v_replacement_publication public.weekly_source_projection_publications%rowtype;
  v_replacement_profile public.weekly_source_format_profiles%rowtype;
  v_guard jsonb;
  v_guard_hash bytea;
  v_client_id uuid;
  v_core_result jsonb;
  v_context jsonb;
  v_result jsonb;
  v_result_hash bytea;
  v_prepared_revision_id uuid;
  v_prepared_session_version bigint;
  v_office_preview jsonb;
begin
  if p_request->>'authority_scope_kind'='SELF_BILL_REPORT_SCOPE'
    or exists(select 1 from public.weekly_source_report_scopes s where s.id=nullif(p_request->>'report_scope_id','')::uuid and s.self_bill_report_id is not null)
    or exists(select 1 from public.weekly_source_final_revisions r where r.id=nullif(p_request->>'expected_current_final_revision_id','')::uuid and r.authority_scope_kind='SELF_BILL_REPORT_SCOPE')
    or exists(select 1 from public.weekly_final_source_correction_sessions c where c.id=nullif(p_request->>'correction_session_id','')::uuid and c.authority_scope_kind='SELF_BILL_REPORT_SCOPE') then
    raise exception 'WEEKLY_SOURCE_SELF_BILL_REPORT_CORRECT_FINAL_UNSUPPORTED' using errcode='55000';
  end if;
  perform pg_catalog.set_config('lock_timeout','5s',true);
  if coalesce(current_setting('request.jwt.claim.role',true),
       nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
  end if;
  if pg_catalog.jsonb_typeof(p_request)<>'object' then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PREPARE_REQUEST_INVALID' using errcode='22023';
  end if;
  select pg_catalog.array_agg(key order by key) into v_actual_keys
  from pg_catalog.jsonb_object_keys(p_request) key;
  select pg_catalog.array_agg(key order by key) into v_expected_keys
  from pg_catalog.unnest(v_expected_keys) key;
  if v_actual_keys is distinct from v_expected_keys
     or p_request->>'schema_version'<>'WEEKLY_SOURCE_CORRECT_FINAL_PREPARE_V1' then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PREPARE_REQUEST_INVALID' using errcode='22023';
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_session_id:=(p_request->>'correction_session_id')::uuid;
    v_upload_id:=(p_request->>'replacement_upload_id')::uuid;
    v_publication_id:=(p_request->>'replacement_projection_publication_id')::uuid;
    v_expected_session_version:=(p_request->>'expected_session_version')::bigint;
    v_scope_version:=(p_request->>'expected_authority_scope_version')::bigint;
    v_expected_row_hash:=pg_catalog.decode(p_request->>'expected_row_manifest_hash','hex');
    v_expected_comparison_hash:=pg_catalog.decode(p_request->>'expected_comparison_manifest_hash','hex');
    v_expected_issue_hash:=pg_catalog.decode(p_request->>'expected_issue_set_hash','hex');
    v_expected_preview_hash:=pg_catalog.decode(p_request->>'expected_preview_hash','hex');
  exception when others then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PREPARE_VALUE_INVALID' using errcode='22023';
  end;
  v_idempotency_key:=pg_catalog.btrim(coalesce(p_request->>'idempotency_key',''));
  v_reason:=pg_catalog.btrim(coalesce(p_request->>'reason',''));
  v_confirmation_text:=pg_catalog.btrim(coalesce(p_request->>'confirmation_text',''));
  if v_actor is null or v_session_id is null or v_upload_id is null
     or v_publication_id is null or v_expected_session_version is null
     or v_scope_version is null or v_scope_version<1
     or pg_catalog.octet_length(v_expected_row_hash)<>32
     or pg_catalog.octet_length(v_expected_comparison_hash)<>32
     or pg_catalog.octet_length(v_expected_issue_hash)<>32
     or pg_catalog.octet_length(v_expected_preview_hash)<>32
     or pg_catalog.char_length(v_idempotency_key) not between 1 and 200
     or pg_catalog.char_length(v_reason) not between 1 and 1000
     or pg_catalog.char_length(v_confirmation_text) not between 1 and 500 then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PREPARE_VALUE_INVALID' using errcode='22023';
  end if;
  v_request_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_CORRECT_FINAL_PREPARE_V1',p_request-'idempotency_key'
  );
  select * into v_session
  from public.weekly_final_source_correction_sessions where id=v_session_id;
  if not found then
    raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_NOT_FOUND' using errcode='22023';
  end if;
  if v_session.state in ('PREPARED','COMMITTING','APPLIED') then
    if v_session.actor_user_id is distinct from v_actor
       or v_session.prepare_idempotency_key is distinct from v_idempotency_key
       or v_session.prepare_request_hash is distinct from v_request_hash then
      raise exception 'WEEKLY_SOURCE_CORRECTION_PREPARE_IDEMPOTENCY_COLLISION'
        using errcode='22023';
    end if;
    return v_session.prepare_result_json||pg_catalog.jsonb_build_object(
      'status','PREPARED','idempotent_replay',true
    );
  end if;

  -- Exact retained PREPARE replay above remains exempt. Fresh correction
  -- admission precedes the outer cycle lock and the nested Final engine.
  perform private.weekly_source_pay_query_admit_v2();

  select * into strict v_cycle from public.weekly_source_cycles
  where id=v_session.source_cycle_id for update;
  select * into strict v_group from public.weekly_source_groups
  where id=v_cycle.source_group_id;
  if v_session.authority_scope_kind='NHSP_REPORT_SCOPE' then
    select * into strict v_scope from public.weekly_source_report_scopes
    where id=v_session.report_scope_id for update;
  end if;
  select * into strict v_session from public.weekly_final_source_correction_sessions
  where id=v_session_id for update;
  if v_session.state<>'REVIEWED' or v_session.actor_user_id is distinct from v_actor
     or v_session.version<>v_expected_session_version
     or v_session.replacement_correction_upload_id is distinct from v_upload_id
     or v_session.replacement_projection_publication_id is distinct from v_publication_id
     or v_session.review_result_json is null
     or v_session.review_result_hash is distinct from private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_SOURCE_CORRECT_FINAL_REVIEW_RESULT_V1',v_session.review_result_json
        )
     or coalesce(v_scope.current_final_revision_id,v_cycle.current_final_revision_id)
          is distinct from v_session.expected_current_final_revision_id then
    raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_STALE' using errcode='40001';
  end if;
  select * into strict v_prior_revision from public.weekly_source_final_revisions
  where id=v_session.expected_current_final_revision_id for share;
  select * into strict v_prior_upload from public.weekly_source_uploads
  where id=v_prior_revision.upload_id for share;
  select * into strict v_prior_publication
  from public.weekly_source_projection_publications
  where id=coalesce(v_scope.current_projection_publication_id,
                    v_cycle.current_projection_publication_id)
  for share;
  select * into strict v_prior_profile from public.weekly_source_format_profiles
  where id=v_prior_upload.source_format_profile_id;
  select * into strict v_replacement_upload from public.weekly_source_uploads
  where id=v_upload_id for update;
  select * into strict v_replacement_publication
  from public.weekly_source_projection_publications where id=v_publication_id for update;
  select * into strict v_replacement_profile from public.weekly_source_format_profiles
  where id=v_replacement_upload.source_format_profile_id;
  if v_prior_revision.state<>'CURRENT'
     or v_prior_revision.manifest_hash is distinct from v_session.expected_final_manifest_hash
     or v_prior_upload.state<>'CURRENT'
     or v_prior_publication.state<>'CURRENT'
     or v_replacement_upload.state<>'CORRECTION_READY'
     or v_replacement_upload.purpose<>'FINAL_SOURCE_CORRECTION'
     or v_replacement_upload.correction_session_id is distinct from v_session.id
     or v_replacement_upload.source_cycle_id is distinct from v_cycle.id
     or v_replacement_upload.report_scope_id is distinct from v_session.report_scope_id
     or v_replacement_upload.row_manifest_hash is distinct from v_expected_row_hash
     or v_replacement_publication.state<>'CORRECTION_READY'
     or v_replacement_publication.correction_session_id is distinct from v_session.id
     or v_replacement_publication.upload_id is distinct from v_replacement_upload.id
     or v_replacement_publication.source_cycle_id is distinct from v_cycle.id
     or v_replacement_publication.authority_scope_kind is distinct from v_session.authority_scope_kind
     or v_replacement_publication.report_scope_id is distinct from v_session.report_scope_id
     or v_replacement_publication.authority_scope_version<>v_scope_version
     or v_replacement_publication.comparison_manifest_hash is distinct from v_expected_comparison_hash
     or v_replacement_publication.issue_set_hash is distinct from v_expected_issue_hash then
    raise exception 'WEEKLY_SOURCE_CORRECTION_REPLACEMENT_STALE' using errcode='40001';
  end if;
  if v_replacement_profile.final_authority_kind is distinct from v_prior_profile.final_authority_kind
     or (v_replacement_profile.final_authority_kind='NHSP_TRUST_BACKING_REPORT')
          is distinct from (v_group.source_family='NHSP') then
    raise exception 'WEEKLY_SOURCE_CORRECTION_SOURCE_FAMILY_MISMATCH'
      using errcode='55000';
  end if;
  select client_id into strict v_client_id
  from public.weekly_source_client_manifests where coalesce(invoice_window_cycle_id,source_cycle_id)=source_cycle_id and final_revision_id=v_prior_revision.id;
  perform private.weekly_source_office_authority_v1(
    v_actor,'CORRECT_FINAL_SOURCE',v_group.id,v_client_id,v_cycle.finalisation_week_ending
  );
  v_guard:=private.weekly_source_correct_final_preconditions_v1(
    v_prior_revision.id,v_actor,v_session.id,true
  );
  v_guard_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_CORRECT_FINAL_GUARD_V1',v_guard
  );
  if v_guard_hash is distinct from v_session.guard_fingerprint then
    raise exception 'WEEKLY_SOURCE_CORRECTION_GUARD_STALE' using errcode='40001';
  end if;
  v_office_preview:=private.weekly_source_correct_final_office_preview_v1(v_session.id);
  if v_session.review_result_json->'office_preview' is distinct from v_office_preview
     or private.weekly_source_finalisation_hex32_v1(
          v_office_preview->>'preview_hash','WEEKLY_SOURCE_CORRECTION_PREVIEW_HASH_INVALID'
        ) is distinct from v_expected_preview_hash
     or v_confirmation_text is distinct from v_office_preview->>'confirmation_text'
     or pg_catalog.jsonb_array_length(v_office_preview->'blockers')<>0 then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PREVIEW_STALE' using errcode='40001';
  end if;
  update public.weekly_final_source_correction_sessions
  set state='PREPARING',prepare_idempotency_key=v_idempotency_key,
      prepare_request_hash=v_request_hash,reason=v_reason,version=version+1,
      updated_at_utc=pg_catalog.transaction_timestamp()
  where id=v_session.id and state='REVIEWED' and version=v_expected_session_version;
  if not found then
    raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_CAS_LOST' using errcode='40001';
  end if;

  v_core_result:=private.weekly_source_finalise_engine_v1(
    pg_catalog.jsonb_build_object(
      'actor_user_id',v_actor,'source_cycle_id',v_cycle.id,
      'authority_scope_kind',v_session.authority_scope_kind,
      'report_scope_id',v_session.report_scope_id,
      'upload_id',v_replacement_upload.id,
      'projection_publication_id',v_replacement_publication.id,
      'expected_authority_scope_version',v_scope_version,
      'expected_row_manifest_hash',pg_catalog.encode(v_expected_row_hash,'hex'),
      'expected_comparison_manifest_hash',pg_catalog.encode(v_expected_comparison_hash,'hex'),
      'expected_issue_set_hash',pg_catalog.encode(v_expected_issue_hash,'hex')
    ),v_session.id,true
  );
  if coalesce((v_core_result->>'ok')::boolean,false) is not true
     or v_core_result->>'status'<>'PREPARED' then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PREPARE_FAILED'
      using errcode='55000',detail=v_core_result::text;
  end if;
  v_prepared_revision_id:=(v_core_result->>'final_revision_id')::uuid;
  update public.weekly_final_source_correction_sessions
  set prepared_final_revision_id=v_prepared_revision_id
  where id=v_session.id and state='PREPARING'
    and prepare_request_hash=v_request_hash;
  if not found then
    raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_CAS_LOST' using errcode='40001';
  end if;
  v_context:=private.weekly_source_correct_final_prepared_context_v1(v_session.id);
  v_office_preview:=private.weekly_source_correct_final_office_preview_v1(v_session.id);
  v_prepared_session_version:=v_expected_session_version+2;
  v_result:=v_core_result||pg_catalog.jsonb_build_object(
    'correction_session_id',v_session.id,
    'prior_final_revision_id',v_prior_revision.id,
    'root_contexts',v_context->'root_contexts',
    'office_preview',v_office_preview,
    'version',v_prepared_session_version,
    'idempotent_replay',false
  )||case when v_context ? 'missing_cancel_basis_census' then jsonb_build_object(
    'missing_cancel_basis_census',v_context->'missing_cancel_basis_census') else '{}'::jsonb end
    ||case when v_context ? 'paid_overlap_choice_census' then jsonb_build_object(
      'paid_overlap_choice_census',v_context->'paid_overlap_choice_census') else '{}'::jsonb end;
  v_result_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_CORRECT_FINAL_PREPARE_RESULT_V1',v_result
  );
  update public.weekly_final_source_correction_sessions
  set state='PREPARED',prepare_result_json=v_result,prepare_result_hash=v_result_hash,
      version=version+1,updated_at_utc=pg_catalog.transaction_timestamp()
  where id=v_session.id and state='PREPARING'
    and prepared_final_revision_id=v_prepared_revision_id
    and prepare_request_hash=v_request_hash;
  if not found then
    raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_CAS_LOST' using errcode='40001';
  end if;
  insert into public.audit_events(
    ts_utc,actor_user_id,actor_display,actor_role_at_time,object_type,
    object_id_text,action,before_json,after_json,reason
  )
  select pg_catalog.statement_timestamp(),v_actor,actor.display_name,actor.role,
         'weekly_final_source_correction_sessions',v_session.id::text,
         'WEEKLY_SOURCE_CORRECT_FINAL_PREPARED',
         pg_catalog.jsonb_build_object(
           'state','READY','current_final_revision_id',v_prior_revision.id
         ),
         pg_catalog.jsonb_build_object(
           'state','PREPARED','prepared_final_revision_id',v_prepared_revision_id,
           'replacement_upload_id',v_replacement_upload.id,
           'replacement_projection_publication_id',v_replacement_publication.id,
           'affected_root_count',pg_catalog.jsonb_array_length(v_context->'root_contexts'),
           'prepare_result_hash',pg_catalog.encode(v_result_hash,'hex')
         ),v_session.reason
  from public.tms_users actor where actor.id=v_actor;
  if not found then
    raise exception 'WEEKLY_SOURCE_ACTOR_NOT_FOUND' using errcode='55000';
  end if;
  return v_result;
end;
$function$;

create or replace function public.weekly_source_correct_final_apply_atomic_v1(
  p_request jsonb
) returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','extensions','pg_catalog','pg_temp'
as $function$
declare
  v_expected_keys text[]:=array[
    'actor_user_id','correction_session_id','expected_authority_scope_version',
    'expected_comparison_manifest_hash','expected_issue_set_hash',
    'expected_preview_hash','expected_row_manifest_hash','expected_session_version',
    'idempotency_key','reason','confirmation_text',
    'replacement_projection_publication_id','replacement_upload_id',
    'root_service_snapshots','schema_version'
  ];
  v_actual_keys text[];
  v_actor uuid;
  v_session_id uuid;
  v_upload_id uuid;
  v_publication_id uuid;
  v_expected_session_version bigint;
  v_scope_version bigint;
  v_expected_row_hash bytea;
  v_expected_comparison_hash bytea;
  v_expected_issue_hash bytea;
  v_expected_preview_hash bytea;
  v_idempotency_key text;
  v_reason text;
  v_confirmation_text text;
  v_apply_request_hash bytea;
  v_root_snapshots jsonb;
  v_session public.weekly_final_source_correction_sessions%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_scope public.weekly_source_report_scopes%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_prior_revision public.weekly_source_final_revisions%rowtype;
  v_prior_upload public.weekly_source_uploads%rowtype;
  v_prior_publication public.weekly_source_projection_publications%rowtype;
  v_replacement_upload public.weekly_source_uploads%rowtype;
  v_replacement_publication public.weekly_source_projection_publications%rowtype;
  v_prior_profile public.weekly_source_format_profiles%rowtype;
  v_replacement_profile public.weekly_source_format_profiles%rowtype;
  v_prepared_revision public.weekly_source_final_revisions%rowtype;
  v_guard jsonb;
  v_guard_hash bytea;
  v_prepared_context jsonb;
  v_live_preview jsonb;
  v_server_roots jsonb;
  v_client_id uuid;
  v_new_revision_id uuid;
  v_root record;
  v_snapshot jsonb;
  v_prior_receipt public.weekly_source_ordinary_pay_projection_receipts%rowtype;
  v_projection_result jsonb;
  v_root_preflight jsonb;
  v_impact_hash bytea;
  v_result jsonb;
  v_result_hash bytea;
  v_completion_generation integer;
  v_completion_hash bytea;
  v_voided_count integer;
  v_old_movement_count integer;
  v_cas_count integer;
  v_family uuid[];
  v_family_after_lock uuid[];
begin
  if p_request->>'authority_scope_kind'='SELF_BILL_REPORT_SCOPE'
    or exists(select 1 from public.weekly_source_report_scopes s where s.id=nullif(p_request->>'report_scope_id','')::uuid and s.self_bill_report_id is not null)
    or exists(select 1 from public.weekly_source_final_revisions r where r.id=nullif(p_request->>'expected_current_final_revision_id','')::uuid and r.authority_scope_kind='SELF_BILL_REPORT_SCOPE')
    or exists(select 1 from public.weekly_final_source_correction_sessions c where c.id=nullif(p_request->>'correction_session_id','')::uuid and c.authority_scope_kind='SELF_BILL_REPORT_SCOPE') then
    raise exception 'WEEKLY_SOURCE_SELF_BILL_REPORT_CORRECT_FINAL_UNSUPPORTED' using errcode='55000';
  end if;
  perform pg_catalog.set_config('lock_timeout','5s',true);
  if coalesce(current_setting('request.jwt.claim.role',true),
       nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
  end if;
  if pg_catalog.jsonb_typeof(p_request)<>'object' then
    raise exception 'WEEKLY_SOURCE_CORRECTION_APPLY_REQUEST_INVALID' using errcode='22023';
  end if;
  select pg_catalog.array_agg(key order by key) into v_actual_keys
  from pg_catalog.jsonb_object_keys(p_request) key;
  select pg_catalog.array_agg(key order by key) into v_expected_keys
  from pg_catalog.unnest(v_expected_keys) key;
  if v_actual_keys is distinct from v_expected_keys
     or p_request->>'schema_version'<>'WEEKLY_SOURCE_CORRECT_FINAL_APPLY_V1'
     or pg_catalog.jsonb_typeof(p_request->'root_service_snapshots')<>'array' then
    raise exception 'WEEKLY_SOURCE_CORRECTION_APPLY_REQUEST_INVALID' using errcode='22023';
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_session_id:=(p_request->>'correction_session_id')::uuid;
    v_upload_id:=(p_request->>'replacement_upload_id')::uuid;
    v_publication_id:=(p_request->>'replacement_projection_publication_id')::uuid;
    v_expected_session_version:=(p_request->>'expected_session_version')::bigint;
    v_scope_version:=(p_request->>'expected_authority_scope_version')::bigint;
    v_expected_row_hash:=pg_catalog.decode(p_request->>'expected_row_manifest_hash','hex');
    v_expected_comparison_hash:=pg_catalog.decode(p_request->>'expected_comparison_manifest_hash','hex');
    v_expected_issue_hash:=pg_catalog.decode(p_request->>'expected_issue_set_hash','hex');
    v_expected_preview_hash:=pg_catalog.decode(p_request->>'expected_preview_hash','hex');
  exception when others then
    raise exception 'WEEKLY_SOURCE_CORRECTION_APPLY_VALUE_INVALID' using errcode='22023';
  end;
  v_idempotency_key:=pg_catalog.btrim(coalesce(p_request->>'idempotency_key',''));
  v_reason:=pg_catalog.btrim(coalesce(p_request->>'reason',''));
  v_confirmation_text:=pg_catalog.btrim(coalesce(p_request->>'confirmation_text',''));
  v_root_snapshots:=p_request->'root_service_snapshots';
  if v_actor is null or v_session_id is null or v_upload_id is null
     or v_publication_id is null or v_expected_session_version is null
     or v_scope_version is null or v_scope_version<1
     or pg_catalog.octet_length(v_expected_row_hash)<>32
     or pg_catalog.octet_length(v_expected_comparison_hash)<>32
     or pg_catalog.octet_length(v_expected_issue_hash)<>32
     or pg_catalog.octet_length(v_expected_preview_hash)<>32
     or pg_catalog.char_length(v_idempotency_key) not between 1 and 200
     or pg_catalog.char_length(v_reason) not between 1 and 1000
     or pg_catalog.char_length(v_confirmation_text) not between 1 and 500 then
    raise exception 'WEEKLY_SOURCE_CORRECTION_APPLY_VALUE_INVALID' using errcode='22023';
  end if;
  v_apply_request_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_CORRECT_FINAL_APPLY_V1',p_request-'idempotency_key'
  );

  select * into v_session from public.weekly_final_source_correction_sessions
  where id=v_session_id;
  if not found then
    raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_NOT_FOUND' using errcode='22023';
  end if;
  if v_session.state='APPLIED' then
    if v_session.actor_user_id is distinct from v_actor
       or v_session.apply_idempotency_key is distinct from v_idempotency_key
       or v_session.apply_request_hash is distinct from v_apply_request_hash then
      raise exception 'WEEKLY_SOURCE_CORRECTION_APPLY_IDEMPOTENCY_COLLISION'
        using errcode='22023';
    end if;
    return v_session.result_json||pg_catalog.jsonb_build_object('idempotent_replay',true);
  end if;

  -- Exact retained APPLIED replay above remains exempt. Fresh correction
  -- admission precedes cycle/session locks and the CURRENT authority CAS.
  perform private.weekly_source_pay_query_admit_v2();

  select * into strict v_cycle from public.weekly_source_cycles
  where id=v_session.source_cycle_id for update;
  select * into strict v_group from public.weekly_source_groups
  where id=v_cycle.source_group_id;
  if v_session.authority_scope_kind='NHSP_REPORT_SCOPE' then
    select * into strict v_scope from public.weekly_source_report_scopes
    where id=v_session.report_scope_id for update;
  end if;
  select * into strict v_session from public.weekly_final_source_correction_sessions
  where id=v_session_id for update;
  if v_session.state<>'PREPARED' or v_session.actor_user_id is distinct from v_actor
     or v_session.version<>v_expected_session_version
     or v_session.replacement_correction_upload_id is distinct from v_upload_id
     or v_session.replacement_projection_publication_id is distinct from v_publication_id
     or coalesce(v_scope.current_final_revision_id,v_cycle.current_final_revision_id)
          is distinct from v_session.expected_current_final_revision_id then
    raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_STALE' using errcode='40001';
  end if;
  select * into strict v_prior_revision from public.weekly_source_final_revisions
  where id=v_session.expected_current_final_revision_id for update;
  select * into strict v_prepared_revision from public.weekly_source_final_revisions
  where id=v_session.prepared_final_revision_id for update;
  select * into strict v_prior_upload from public.weekly_source_uploads
  where id=v_prior_revision.upload_id for update;
  select * into strict v_prior_profile from public.weekly_source_format_profiles
  where id=v_prior_upload.source_format_profile_id;
  select * into strict v_prior_publication
  from public.weekly_source_projection_publications
  where id=coalesce(v_scope.current_projection_publication_id,v_cycle.current_projection_publication_id)
  for update;
  select * into strict v_replacement_upload from public.weekly_source_uploads
  where id=v_upload_id for update;
  select * into strict v_replacement_publication
  from public.weekly_source_projection_publications where id=v_publication_id for update;

  if v_prior_revision.state<>'CURRENT'
     or v_prior_revision.manifest_hash is distinct from v_session.expected_final_manifest_hash
     or v_prepared_revision.state<>'PREPARED'
     or v_prepared_revision.reason<>'CORRECT_FINAL_SOURCE'
     or v_prepared_revision.predecessor_revision_id is distinct from v_prior_revision.id
     or v_prepared_revision.source_cycle_id is distinct from v_cycle.id
     or v_prepared_revision.upload_id is distinct from v_replacement_upload.id
     or v_session.prepare_result_json->>'final_revision_id'
          is distinct from v_prepared_revision.id::text
     or v_session.prepare_result_hash is distinct from private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_SOURCE_CORRECT_FINAL_PREPARE_RESULT_V1',v_session.prepare_result_json
        )
     or v_prior_upload.state<>'CURRENT'
     or v_prior_publication.state<>'CURRENT'
     or v_replacement_upload.state<>'CORRECTION_READY'
     or v_replacement_upload.purpose<>'FINAL_SOURCE_CORRECTION'
     or v_replacement_upload.correction_session_id is distinct from v_session.id
     or v_replacement_upload.source_cycle_id is distinct from v_cycle.id
     or v_replacement_upload.report_scope_id is distinct from v_session.report_scope_id
     or v_replacement_upload.row_manifest_hash is distinct from v_expected_row_hash
     or v_replacement_publication.state<>'CORRECTION_READY'
     or v_replacement_publication.correction_session_id is distinct from v_session.id
     or v_replacement_publication.upload_id is distinct from v_replacement_upload.id
     or v_replacement_publication.source_cycle_id is distinct from v_cycle.id
     or v_replacement_publication.authority_scope_kind is distinct from v_session.authority_scope_kind
     or v_replacement_publication.report_scope_id is distinct from v_session.report_scope_id
     or v_replacement_publication.authority_scope_version<>v_scope_version
     or v_replacement_publication.comparison_manifest_hash is distinct from v_expected_comparison_hash
     or v_replacement_publication.issue_set_hash is distinct from v_expected_issue_hash then
    raise exception 'WEEKLY_SOURCE_CORRECTION_REPLACEMENT_STALE' using errcode='40001';
  end if;
  select * into strict v_replacement_profile from public.weekly_source_format_profiles
  where id=v_replacement_upload.source_format_profile_id;
  if v_replacement_profile.final_authority_kind is distinct from v_prior_profile.final_authority_kind
     or (v_replacement_profile.final_authority_kind='NHSP_TRUST_BACKING_REPORT')
          is distinct from (v_group.source_family='NHSP') then
    raise exception 'WEEKLY_SOURCE_CORRECTION_SOURCE_FAMILY_MISMATCH'
      using errcode='55000';
  end if;

  select client_id into strict v_client_id
  from public.weekly_source_client_manifests where coalesce(invoice_window_cycle_id,source_cycle_id)=source_cycle_id and final_revision_id=v_prior_revision.id;
  perform private.weekly_source_office_authority_v1(
    v_actor,'CORRECT_FINAL_SOURCE',v_group.id,v_client_id,v_cycle.finalisation_week_ending
  );
  v_guard:=private.weekly_source_correct_final_preconditions_v1(
    v_prior_revision.id,v_actor,v_session.id,true
  );
  v_guard_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_CORRECT_FINAL_GUARD_V1',v_guard
  );
  if v_guard_hash is distinct from v_session.guard_fingerprint then
    raise exception 'WEEKLY_SOURCE_CORRECTION_GUARD_STALE' using errcode='40001';
  end if;
  v_prepared_context:=private.weekly_source_correct_final_prepared_context_v1(v_session.id);
  v_server_roots:=v_prepared_context->'root_contexts';
  if v_server_roots is distinct from v_session.prepare_result_json->'root_contexts'
    or coalesce(v_prepared_context->'missing_cancel_basis_census','{}'::jsonb)
      is distinct from coalesce(v_session.prepare_result_json->'missing_cancel_basis_census','{}'::jsonb)
    or coalesce(v_prepared_context->'paid_overlap_choice_census','{}'::jsonb)
      is distinct from coalesce(v_session.prepare_result_json->'paid_overlap_choice_census','{}'::jsonb) then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PREPARED_CONTEXT_STALE'
      using errcode='40001';
  end if;
  v_live_preview:=private.weekly_source_correct_final_office_preview_v1(v_session.id);
  if v_session.prepare_result_json->'office_preview' is distinct from v_live_preview
     or private.weekly_source_finalisation_hex32_v1(
          v_live_preview->>'preview_hash','WEEKLY_SOURCE_CORRECTION_PREVIEW_HASH_INVALID'
        ) is distinct from v_expected_preview_hash
     or v_confirmation_text is distinct from v_live_preview->>'confirmation_text'
     or pg_catalog.jsonb_array_length(v_live_preview->'blockers')<>0 then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PREVIEW_STALE' using errcode='40001';
  end if;

  if exists(
    select 1 from pg_catalog.jsonb_array_elements(v_root_snapshots) supplied(value)
    where pg_catalog.jsonb_typeof(supplied.value)<>'object'
       or not (supplied.value ? 'root_timesheet_id'
               and supplied.value ? 'prepared_context_hash'
               and supplied.value ? 'service_snapshot')
       or (select pg_catalog.count(*) from pg_catalog.jsonb_object_keys(supplied.value))<>3
       or coalesce(supplied.value->>'root_timesheet_id','')
            !~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
       or coalesce(supplied.value->>'prepared_context_hash','') !~*'^[0-9a-f]{64}$'
       or pg_catalog.jsonb_typeof(supplied.value->'service_snapshot')<>'object'
  ) or (select pg_catalog.count(*) from pg_catalog.jsonb_array_elements(v_root_snapshots))
       <>pg_catalog.jsonb_array_length(v_server_roots)
     or exists(
       select 1
       from pg_catalog.jsonb_array_elements(v_root_snapshots) supplied(value)
       group by supplied.value->>'root_timesheet_id'
       having pg_catalog.count(*)<>1
     ) or exists(
       select 1 from pg_catalog.jsonb_array_elements(v_server_roots) server_root(value)
       where not exists(
         select 1 from pg_catalog.jsonb_array_elements(v_root_snapshots) supplied(value)
         where supplied.value->>'root_timesheet_id'=server_root.value->>'root_timesheet_id'
           and supplied.value->>'prepared_context_hash'=
                 server_root.value->>'prepared_context_hash'
       )
     ) then
    raise exception 'WEEKLY_SOURCE_CORRECTION_ROOT_SNAPSHOT_SET_MISMATCH'
      using errcode='40001';
  end if;

  -- PREPARE can create a replacement-only root that did not exist when OPEN
  -- froze the prior-root guard.  Apply the same invoice/Banking/Draft
  -- preconditions to every sealed union root immediately before COMMITTING so
  -- a newly created root cannot enter another owner between PREPARE and APPLY.
  for v_root in
    select (server_root.value->>'root_timesheet_id')::uuid as root_timesheet_id
    from pg_catalog.jsonb_array_elements(v_server_roots) server_root(value)
    order by server_root.value->>'root_timesheet_id'
  loop
    -- Gate 13 hostile review F5 / standing rule 3, at COMMITTING time.  Same
    -- family keying and same lock-before-read order as the OPEN-time
    -- preconditions above: name the family, lock its rows in a deterministic
    -- order, re-resolve, require the membership to be unchanged, and only then
    -- read the protected-family and invoice-line state that is being guarded.
    v_family:=private.weekly_source_invoice_family_timesheet_ids_v1(
      v_root.root_timesheet_id
    );
    if v_family is null or pg_catalog.cardinality(v_family)=0 then
      raise exception 'WEEKLY_SOURCE_CORRECTION_FAMILY_UNRESOLVED'
        using errcode='55000';
    end if;
    perform 1 from public.timesheets family_row
    where family_row.timesheet_id=any(v_family)
    order by family_row.timesheet_id
    for update;
    v_family_after_lock:=private.weekly_source_invoice_family_timesheet_ids_v1(
      v_root.root_timesheet_id
    );
    if v_family_after_lock is null
       or pg_catalog.cardinality(v_family_after_lock)=0
       or not (v_family_after_lock @> v_family and v_family @> v_family_after_lock)
    then
      raise exception 'WEEKLY_SOURCE_CORRECTION_FAMILY_UNRESOLVED'
        using errcode='40001';
    end if;
    v_family:=v_family_after_lock;
    if exists(
      select 1 from public.weekly_exceptional_pay_target_families family
      where family.root_timesheet_id=any(v_family)
        and family.ownership_state='TARGET_MANAGED'
    ) then
      raise exception 'WEEKLY_SOURCE_CORRECTION_PROTECTED_TARGET_EXISTS'
        using errcode='55000';
    end if;
    if exists(
      select 1 from public.invoice_lines invoice_line
      where invoice_line.timesheet_id=any(v_family)
    ) then
      raise exception 'WEEKLY_SOURCE_CORRECTION_INVOICE_LINE_EXISTS'
        using errcode='55000';
    end if;
    if exists(
      select 1 from public.timesheets timesheet_row
      where timesheet_row.timesheet_id=v_root.root_timesheet_id
        and timesheet_row.active_document_operation_id is not null
    ) or exists(
      select 1 from public.invoice_operations operation
      where operation.status in ('QUEUED','RUNNING','WAITING','RETRY_WAIT','BLOCKED')
        and operation.entity_type='TIMESHEET'
        and operation.entity_id=v_root.root_timesheet_id
    ) or exists(
      select 1 from public.invoice_operation_chunks chunk
      where chunk.status in ('QUEUED','RUNNING','WAITING','RETRY_WAIT','BLOCKED')
        and chunk.entity_type='TIMESHEET'
        and chunk.entity_id=v_root.root_timesheet_id
    ) then
      raise exception 'WEEKLY_SOURCE_CORRECTION_ACTIVE_INVOICE_OPERATION'
        using errcode='55000';
    end if;
    v_root_preflight:=public.import_timesheet_financial_preflight_v1(
      array[v_root.root_timesheet_id],
      'WEEKLY_SOURCE_CORRECT_FINAL_SOURCE',v_actor,'{}'::jsonb,true,1
    );
    if coalesce((v_root_preflight->>'blocking_batch_count')::integer,0)>0 then
      raise exception 'WEEKLY_SOURCE_CORRECTION_ACTIVE_PAY_DRAFT'
        using errcode='55000',detail=v_root_preflight::text;
    elsif coalesce((v_root_preflight->>'paid_count')::integer,0)>0 then
      raise exception 'WEEKLY_SOURCE_CORRECTION_ALREADY_PAID'
        using errcode='55000',detail=v_root_preflight::text;
    elsif coalesce((v_root_preflight->>'invoice_lined_count')::integer,0)>0 then
      raise exception 'WEEKLY_SOURCE_CORRECTION_INVOICE_LINE_EXISTS'
        using errcode='55000',detail=v_root_preflight::text;
    elsif coalesce((v_root_preflight->>'allowed')::boolean,false) is not true
       or v_root_preflight->>'required_path' not in (
         -- Gate 2 / XSG-032, the same rule at COMMITTING time.
         'DIRECT_AMEND_RECALCULATE'
       ) then
      raise exception 'WEEKLY_SOURCE_CORRECTION_ROOT_NOT_MUTABLE'
        using errcode='55000',detail=v_root_preflight::text;
    end if;
  end loop;

  if v_prepared_revision.authority_scope_kind in ('CYCLE','NHSP_REPORT_SCOPE') or v_prepared_revision.paid_overlap_choice_census<>'{}'::jsonb then
    perform private.weekly_source_paid_match_prepared_census_recheck_v1(v_prepared_revision.id,v_actor);
  end if;
  update public.weekly_final_source_correction_sessions
  set state='COMMITTING',apply_idempotency_key=v_idempotency_key,
      apply_request_hash=v_apply_request_hash,reason=v_reason,version=version+1,
      updated_at_utc=pg_catalog.transaction_timestamp()
  where id=v_session.id and state='PREPARED' and version=v_expected_session_version
    and prepared_final_revision_id=v_prepared_revision.id;
  if not found then
    raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_CAS_LOST' using errcode='40001';
  end if;

  update public.weekly_source_expense_materialisations materialisation
  set state='SUPERSEDED'
  where materialisation.state='MATERIALISED'
    and materialisation.expense_authority_generation_id in (
      select expense.id from public.weekly_expense_authority_generations expense
      where expense.final_revision_id=v_prior_revision.id and expense.state='CURRENT'
    );

  -- Expense authority is activated in the same CAS as source authority.  The
  -- prepared generation wins where one exists; otherwise correcting away an
  -- erroneous same-cycle generation restores its exact predecessor (or zero
  -- when there was no predecessor).
  update public.weekly_expense_authority_generations current_expense
  set state='SUPERSEDED'
  where current_expense.state='CURRENT'
    and current_expense.work_event_id in (
      select old_expense.work_event_id
      from public.weekly_expense_authority_generations old_expense
      where old_expense.final_revision_id=v_prior_revision.id
      union
      select prepared_expense.work_event_id
      from public.weekly_expense_authority_generations prepared_expense
      where prepared_expense.final_revision_id=v_prepared_revision.id
        and prepared_expense.state='PREPARED'
    );
  update public.weekly_expense_authority_generations prepared_expense
  set state='CURRENT'
  where prepared_expense.final_revision_id=v_prepared_revision.id
    and prepared_expense.state='PREPARED';
  update public.weekly_expense_authority_generations baseline_expense
  set state='CURRENT'
  where baseline_expense.state='SUPERSEDED'
    and baseline_expense.id in (
      select old_expense.prior_expense_authority_generation_id
      from public.weekly_expense_authority_generations old_expense
      where old_expense.final_revision_id=v_prior_revision.id
        and old_expense.prior_expense_authority_generation_id is not null
        and not exists(
          select 1
          from public.weekly_expense_authority_generations prepared_expense
          where prepared_expense.final_revision_id=v_prepared_revision.id
            and prepared_expense.work_event_id=old_expense.work_event_id
            and prepared_expense.state='CURRENT'
        )
    );

  perform pg_catalog.set_config(
    'cloudtms.weekly_source_correction_owner',
    'weekly_source_correct_final_apply_atomic_v1',true
  );
  select pg_catalog.count(*)::integer into v_old_movement_count
  from public.weekly_source_billing_movements
  where final_revision_id=v_prior_revision.id;
  if exists(
    select 1 from public.weekly_source_billing_movements
    where final_revision_id=v_prior_revision.id and placement_state<>'UNPLACED'
  ) or exists(
    select 1 from public.weekly_source_billing_movements
    where final_revision_id=v_prepared_revision.id and placement_state<>'UNPLACED'
  ) then
    raise exception 'WEEKLY_SOURCE_CORRECTION_MOVEMENT_STATE_STALE' using errcode='40001';
  end if;
  update public.weekly_source_billing_movements
  set placement_state='VOIDED_BY_CORRECT_FINAL'
  where final_revision_id=v_prior_revision.id and placement_state='UNPLACED';
  get diagnostics v_voided_count=row_count;
  if v_voided_count<>v_old_movement_count then
    raise exception 'WEEKLY_SOURCE_CORRECTION_MOVEMENT_CAS_LOST' using errcode='40001';
  end if;
  update public.weekly_source_final_revisions
  set state='SUPERSEDED' where id=v_prior_revision.id and state='CURRENT';
  if not found then
    raise exception 'WEEKLY_SOURCE_CORRECTION_FINAL_REVISION_CAS_LOST' using errcode='40001';
  end if;
  update public.weekly_source_final_revisions
  set state='CURRENT' where id=v_prepared_revision.id and state='PREPARED';
  if not found then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PREPARED_REVISION_CAS_LOST'
      using errcode='40001';
  end if;
  update public.weekly_source_uploads set state='SUPERSEDED'
  where id=v_prior_upload.id and state='CURRENT';
  get diagnostics v_cas_count=row_count;
  if v_cas_count<>1 then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PRIOR_UPLOAD_CAS_LOST'
      using errcode='40001';
  end if;
  update public.weekly_source_projection_publications
  set state='STALE',failure_code='SUPERSEDED_BY_CORRECT_FINAL_SOURCE'
  where id=v_prior_publication.id and state='CURRENT';
  get diagnostics v_cas_count=row_count;
  if v_cas_count<>1 then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PRIOR_PUBLICATION_CAS_LOST'
      using errcode='40001';
  end if;
  update public.weekly_source_uploads set state='CURRENT'
  where id=v_replacement_upload.id and state='CORRECTION_READY';
  get diagnostics v_cas_count=row_count;
  if v_cas_count<>1 then
    raise exception 'WEEKLY_SOURCE_CORRECTION_REPLACEMENT_UPLOAD_CAS_LOST'
      using errcode='40001';
  end if;
  update public.weekly_source_projection_publications set state='CURRENT'
  where id=v_replacement_publication.id and state='CORRECTION_READY';
  get diagnostics v_cas_count=row_count;
  if v_cas_count<>1 then
    raise exception 'WEEKLY_SOURCE_CORRECTION_REPLACEMENT_PUBLICATION_CAS_LOST'
      using errcode='40001';
  end if;

  if v_session.authority_scope_kind='CYCLE' then
    update public.weekly_source_cycles
    set current_complete_upload_id=v_replacement_upload.id,
        current_projection_publication_id=v_replacement_publication.id,
        current_final_revision_id=v_prepared_revision.id,projection_state='CURRENT',
        state='FINALISED',finalised_at_utc=pg_catalog.transaction_timestamp(),
        finalised_by_user_id=v_actor
    where id=v_cycle.id
      and current_complete_upload_id=v_prior_upload.id
      and current_projection_publication_id=v_prior_publication.id
      and current_final_revision_id=v_prior_revision.id
      and version=v_scope_version;
  else
    update public.weekly_source_report_scopes
    set current_complete_upload_id=v_replacement_upload.id,
        current_projection_publication_id=v_replacement_publication.id,
        current_final_revision_id=v_prepared_revision.id,projection_state='CURRENT',
        state='FINALISED',updated_at_utc=pg_catalog.transaction_timestamp()
    where id=v_scope.id
      and current_complete_upload_id=v_prior_upload.id
      and current_projection_publication_id=v_prior_publication.id
      and current_final_revision_id=v_prior_revision.id
      and version=v_scope_version;
  end if;
  if not found then
    raise exception 'WEEKLY_SOURCE_CORRECTION_AUTHORITY_CAS_LOST' using errcode='40001';
  end if;
  v_new_revision_id:=v_prepared_revision.id;

  -- APPLIED replay returned earlier; only the successful new CURRENT CAS
  -- resolves report-contained manual queries before the existing selector.
  -- Keep the completion receipt below that selector in its original order.
  perform private.weekly_source_manual_reviews_finalised_v1(v_new_revision_id,v_actor);

  -- Source old/new and cycle/report CURRENT CAS succeeded. Retract only the
  -- exact old captured revision, publish genuine new origins, and retain an
  -- explicit new observation even for an empty correction. Outside readers
  -- cannot observe this intermediate state: it is the same owner transaction.
  if (select active_owner from private.bpay_next_module_control where id=1)='NEXT' then
    perform private.bpay_next_source_current_apply_correction_v1(v_session.id);
  end if;

  update public.weekly_source_client_cycle_completions completion
  set state='SUPERSEDED',superseded_at_utc=pg_catalog.transaction_timestamp()
  where completion.source_cycle_id=v_cycle.id
    and completion.client_id=v_client_id and completion.state='CURRENT';
  select coalesce(pg_catalog.max(completion.completion_generation),0)+1
  into v_completion_generation
  from public.weekly_source_client_cycle_completions completion
  where completion.source_cycle_id=v_cycle.id and completion.client_id=v_client_id;
  v_completion_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_CLIENT_CYCLE_COMPLETION_V1',
    pg_catalog.jsonb_build_object(
      'source_cycle_id',v_cycle.id,'source_group_id',v_group.id,
      'client_id',v_client_id,'completion_generation',v_completion_generation,
      'completion_kind','FINAL_SOURCE','final_revision_id',v_new_revision_id,
      'actor_user_id',v_actor
    )
  );
  insert into public.weekly_source_client_cycle_completions(
    source_cycle_id,source_group_id,client_id,completion_generation,
    completion_kind,final_revision_id,attested_by_user_id,attested_at_utc,
    attestation_text,completion_hash,state
  ) values (
    v_cycle.id,v_group.id,v_client_id,v_completion_generation,
    'FINAL_SOURCE',v_new_revision_id,v_actor,pg_catalog.transaction_timestamp(),
    null,v_completion_hash,'CURRENT'
  );
  if v_session.authority_scope_kind='NHSP_REPORT_SCOPE' then
    if not exists(
      select 1
      from public.weekly_source_group_clients membership
      where membership.source_group_id=v_group.id
        and v_cycle.finalisation_week_ending between membership.valid_from
          and coalesce(membership.valid_to,'infinity'::date)
        and not exists(
          select 1
          from public.weekly_source_client_cycle_completions completion
          where completion.source_cycle_id=v_cycle.id
            and completion.client_id=membership.client_id
            and completion.state='CURRENT'
        )
    ) then
      update public.weekly_source_cycles
      set state='FINALISED',finalised_at_utc=pg_catalog.transaction_timestamp(),
          finalised_by_user_id=v_actor
      where id=v_cycle.id;
    else
      update public.weekly_source_cycles set state='FINALISABLE'
      where id=v_cycle.id;
    end if;
  end if;

  for v_root in
    select (server_root.value->>'root_timesheet_id')::uuid as root_timesheet_id,
           (server_root.value->>'prior_projection_receipt_id')::uuid as prior_receipt_id,
           server_root.value->>'source_profile_kind' as source_profile_kind,
           server_root.value->>'source_mode' as source_mode,
           supplied.value->'service_snapshot' as service_snapshot
    from pg_catalog.jsonb_array_elements(v_server_roots) server_root(value)
    join pg_catalog.jsonb_array_elements(v_root_snapshots) supplied(value)
      on supplied.value->>'root_timesheet_id'=server_root.value->>'root_timesheet_id'
    order by server_root.value->>'root_timesheet_id'
  loop
    v_prior_receipt:=null;
    if v_root.prior_receipt_id is not null then
      select * into strict v_prior_receipt
      from public.weekly_source_ordinary_pay_projection_receipts
      where id=v_root.prior_receipt_id;
      if v_prior_receipt.final_revision_id is distinct from v_prior_revision.id
         or v_prior_receipt.root_timesheet_id is distinct from v_root.root_timesheet_id
         or v_prior_receipt.outcome not in ('PREPARED_FOR_AUTHORISATION','PROPOSED') then
        raise exception 'WEEKLY_SOURCE_CORRECTION_PRIOR_ROOT_RECEIPT_STALE'
          using errcode='40001';
      end if;
    end if;
    v_impact_hash:=private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_CORRECT_FINAL_ROOT_IMPACT_V1',
      pg_catalog.jsonb_build_object(
        'correction_session_id',v_session.id,
        'prior_final_revision_id',v_prior_revision.id,
        'replacement_final_revision_id',v_new_revision_id,
        'root_timesheet_id',v_root.root_timesheet_id,
        'prior_projection_receipt_id',v_root.prior_receipt_id,
        'client_id',v_client_id,
        'source_profile_kind',v_root.source_profile_kind,
        'source_mode',v_root.source_mode,
        'submitted_service_snapshot_hash',pg_catalog.encode(
          private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_SOURCE_ORDINARY_SERVICE_SNAPSHOT_V1',v_root.service_snapshot
          ),'hex'
        )
      )
    );
    insert into public.weekly_final_source_correction_root_impacts(
      correction_session_id,prior_final_revision_id,replacement_final_revision_id,
      root_timesheet_id,prior_projection_receipt_id,client_id,source_profile_kind,
      source_mode,impact_kind,submitted_service_snapshot_hash,impact_hash
    ) values (
      v_session.id,v_prior_revision.id,v_new_revision_id,v_root.root_timesheet_id,
      v_root.prior_receipt_id,v_client_id,v_root.source_profile_kind,v_root.source_mode,
      case when v_root.prior_receipt_id is null
        then 'PUBLISHED_REPLACEMENT_ONLY_ROOT'
        when exists(
        select 1 from public.weekly_source_billing_movements movement
        where movement.final_revision_id=v_new_revision_id
          and movement.invoice_timesheet_id=v_root.root_timesheet_id
      ) then 'REPROJECTED_WITH_CURRENT_REVISION_MOVEMENTS'
        else 'REPROJECTED_WITHOUT_CURRENT_REVISION_MOVEMENTS' end,
      private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_ORDINARY_SERVICE_SNAPSHOT_V1',v_root.service_snapshot
      ),v_impact_hash
    );
    v_projection_result:=public.weekly_source_ordinary_pay_projection_apply_atomic_v1(
      pg_catalog.jsonb_build_object(
        'schema_version','WEEKLY_SOURCE_ORDINARY_PAY_PROJECTION_REQUEST_V1',
        'actor_user_id',v_actor,'final_revision_id',v_new_revision_id,
        'root_timesheet_id',v_root.root_timesheet_id,
        'idempotency_key','correct-final:'||v_session.id::text||':'||v_root.root_timesheet_id::text,
        'service_snapshot',v_root.service_snapshot
      )
    );
    -- Gate 2: the projection no longer publishes.  The only outcome reachable
    -- from here is PREPARED_FOR_AUTHORISATION, because the gates above now
    -- admit DIRECT_AMEND_RECALCULATE only, i.e. a root that is not yet
    -- authorised.  Anything else means the root moved under us.
    if v_projection_result->>'outcome'<>'PREPARED_FOR_AUTHORISATION' then
      raise exception 'WEEKLY_SOURCE_CORRECTION_ROOT_REPROJECT_FAILED'
        using errcode='55000',detail=v_projection_result::text;
    end if;
  end loop;

  v_result:=(v_session.prepare_result_json-'root_contexts')||pg_catalog.jsonb_build_object(
    'status','CORRECTED','correction_session_id',v_session.id,
    'prior_final_revision_id',v_prior_revision.id,
    'affected_root_count',pg_catalog.jsonb_array_length(v_server_roots),
    'version',v_expected_session_version+2,
    'idempotent_replay',false
  );
  v_result_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_CORRECT_FINAL_RESULT_V1',v_result
  );
  update public.weekly_final_source_correction_sessions
  set state='APPLIED',applied_final_revision_id=v_new_revision_id,
      result_json=v_result,result_hash=v_result_hash,version=version+1,
      updated_at_utc=pg_catalog.transaction_timestamp(),
      completed_at_utc=pg_catalog.transaction_timestamp()
  where id=v_session.id and state='COMMITTING';
  if not found then
    raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_CAS_LOST' using errcode='40001';
  end if;
  insert into public.audit_events(
    ts_utc,actor_user_id,actor_display,actor_role_at_time,object_type,
    object_id_text,action,before_json,after_json,reason
  )
  select pg_catalog.statement_timestamp(),v_actor,actor.display_name,actor.role,
         'weekly_final_source_correction_sessions',v_session.id::text,
         'WEEKLY_SOURCE_CORRECT_FINAL_APPLIED',
         pg_catalog.jsonb_build_object(
           'state','CURRENT','final_revision_id',v_prior_revision.id,
           'upload_id',v_prior_upload.id,'projection_publication_id',v_prior_publication.id
         ),
         pg_catalog.jsonb_build_object(
           'state','APPLIED','final_revision_id',v_new_revision_id,
           'upload_id',v_replacement_upload.id,
           'projection_publication_id',v_replacement_publication.id,
           'affected_root_count',pg_catalog.jsonb_array_length(v_server_roots),
           'voided_prior_movement_count',v_voided_count,
           'result_hash',pg_catalog.encode(v_result_hash,'hex')
         ),v_reason
  from public.tms_users actor where actor.id=v_actor;
  if not found then
    raise exception 'WEEKLY_SOURCE_ACTOR_NOT_FOUND' using errcode='55000';
  end if;
  return v_result;
end;
$function$;

create or replace function private.weekly_source_missing_correction_baseline_v1(
  p_projection_publication_id uuid,p_previous_snapshot_line_id uuid,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_publication public.weekly_source_projection_publications%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_session public.weekly_final_source_correction_sessions%rowtype;
  v_parent public.weekly_source_final_revisions%rowtype;
  v_parent_transition public.weekly_source_state_transitions%rowtype;
  v_snapshot public.weekly_source_final_snapshot_lines%rowtype;
  v_profile public.weekly_source_format_profiles%rowtype;
  v_context jsonb; v_original jsonb; v_baseline uuid; v_ids uuid[];
  v_root uuid; v_preflight jsonb; v_movements jsonb; v_parent_move uuid;
  v_roots jsonb:='[]'::jsonb; v_result jsonb;
begin
  if p_projection_publication_id is null or p_previous_snapshot_line_id is null or p_actor_user_id is null then
    raise exception 'WEEKLY_SOURCE_MISSING_CORRECTION_BASELINE_INPUT_INVALID' using errcode='22023';
  end if;
  select * into strict v_publication from public.weekly_source_projection_publications where id=p_projection_publication_id;
  select * into strict v_upload from public.weekly_source_uploads where id=v_publication.upload_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_publication.source_cycle_id;
  select * into strict v_snapshot from public.weekly_source_final_snapshot_lines where id=p_previous_snapshot_line_id;
  select * into strict v_profile from public.weekly_source_format_profiles where id=v_upload.source_format_profile_id;
  select * into strict v_session from public.weekly_final_source_correction_sessions where id=v_upload.correction_session_id;
  select * into strict v_parent from public.weekly_source_final_revisions where id=v_session.expected_current_final_revision_id;
  if v_upload.purpose is distinct from 'FINAL_SOURCE_CORRECTION' or v_upload.state is distinct from 'CORRECTION_READY'
    or v_publication.state is distinct from 'CORRECTION_READY'
    or v_publication.correction_session_id is distinct from v_session.id
    or v_session.state not in ('PREPARING','PREPARED','COMMITTING')
    or v_session.actor_user_id is distinct from p_actor_user_id
    or v_session.source_cycle_id is distinct from v_cycle.id
    or v_session.authority_scope_kind is distinct from 'CYCLE' or v_session.report_scope_id is not null
    or v_session.replacement_correction_upload_id is distinct from v_upload.id
    or v_session.replacement_projection_publication_id is distinct from v_publication.id
    or v_cycle.current_final_revision_id is distinct from v_parent.id
    or v_parent.source_cycle_id is distinct from v_cycle.id or v_parent.state is distinct from 'CURRENT'
    or v_parent.authority_scope_kind is distinct from 'CYCLE' or v_parent.report_scope_id is not null
    or v_parent.manifest_hash is distinct from v_session.expected_final_manifest_hash
    or v_session.review_result_hash is null
    or v_session.review_result_hash is distinct from private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_CORRECT_FINAL_REVIEW_RESULT_V1',v_session.review_result_json)
    or v_profile.final_authority_kind not in ('GENERIC_COMPLETE_SNAPSHOT','HEALTHROSTER_ACTUAL_ROWS') then
    raise exception 'WEEKLY_SOURCE_MISSING_CORRECTION_PARENT_CHANGED' using errcode='40001';
  end if;
  v_context:=private.weekly_source_kept_as_paid_context_for_publication_v1(v_snapshot.work_event_id,p_actor_user_id,v_publication.id);
  if v_context->'source_present' is distinct from 'false'::jsonb
    or v_context->'paid' is distinct from 'false'::jsonb or v_context->'invoiced' is distinct from 'false'::jsonb
    or v_context->>'source_group_id' is distinct from v_cycle.source_group_id::text
    or v_context->>'candidate_id' is distinct from v_snapshot.candidate_id::text
    or v_context->>'client_id' is distinct from v_snapshot.client_id::text
    or v_context->>'contract_id' is distinct from v_snapshot.contract_id::text then
    raise exception 'WEEKLY_SOURCE_MISSING_CORRECTION_UNPROTECTED_SCOPE_REQUIRED' using errcode='55000';
  end if;
  -- Exact existing FIN4 prior_states order. The mistaken target week is
  -- deliberately excluded, rather than replacing the native earlier baseline.
  select coalesce(t.new_snapshot_line_id,case when t.exclude_cancel then t.previous_snapshot_line_id end)
    into v_baseline
  from public.weekly_source_state_transitions t
  join public.weekly_source_final_revisions revision on revision.id=t.final_revision_id and revision.state='CURRENT'
  join public.weekly_source_cycles prior_cycle on prior_cycle.id=t.finalisation_cycle_id
  join public.weekly_source_client_manifests manifest
    on coalesce(manifest.invoice_window_cycle_id,manifest.source_cycle_id)=manifest.source_cycle_id
      and manifest.final_revision_id=revision.id and manifest.client_id=v_snapshot.client_id
  where t.work_event_id=v_snapshot.work_event_id and t.source_profile_kind=v_profile.final_authority_kind
    and prior_cycle.source_group_id=v_cycle.source_group_id
    and prior_cycle.finalisation_week_ending<v_cycle.finalisation_week_ending
  order by prior_cycle.finalisation_week_ending desc,revision.finalised_at_utc desc,
    revision.revision_number desc,t.created_at_utc desc,t.id desc limit 1;
  if v_baseline is distinct from v_snapshot.id then
    raise exception 'WEEKLY_SOURCE_MISSING_CORRECTION_BASELINE_CHANGED' using errcode='40001';
  end if;
  v_original:=private.weekly_source_missing_snapshot_movement_v1(v_snapshot.id);
  select array_agg(t.id) into v_ids from public.weekly_source_state_transitions t
    where t.final_revision_id=v_parent.id and t.work_event_id=v_snapshot.work_event_id
      and t.source_profile_kind=v_profile.final_authority_kind;
  if coalesce(cardinality(v_ids),0)<>1 then
    raise exception 'WEEKLY_SOURCE_MISSING_CORRECTION_PARENT_EVENT_UNBOUND' using errcode='40001';
  end if;
  select * into strict v_parent_transition from public.weekly_source_state_transitions where id=v_ids[1];
  v_parent_move:=(v_context->>'current_pay_head_movement_id')::uuid;
  if v_parent_move is not null and not exists(select 1 from public.weekly_source_billing_movements movement
    join public.weekly_source_final_snapshot_lines line on line.id=v_parent_transition.new_snapshot_line_id
    where movement.id=v_parent_move and movement.final_revision_id=v_parent.id
      and movement.transition_id=v_parent_transition.id and movement.work_event_id=v_snapshot.work_event_id
      and movement.candidate_id=v_snapshot.candidate_id and movement.actual_client_id=v_snapshot.client_id
      and movement.contract_id=v_snapshot.contract_id and movement.movement_role in ('POSITIVE','REPLACEMENT')
      and line.work_event_id=v_snapshot.work_event_id and line.candidate_id=v_snapshot.candidate_id
      and line.client_id=v_snapshot.client_id and line.contract_id=v_snapshot.contract_id
      and v_parent_transition.outcome in ('ADD','AMEND') and v_parent_transition.new_present)
    or (v_parent_move is null and (v_parent_transition.outcome is distinct from 'CANCEL'
      or v_parent_transition.new_present or v_parent_transition.new_snapshot_line_id is not null
      or v_parent_transition.exclude_cancel)) then
    raise exception 'WEEKLY_SOURCE_MISSING_CORRECTION_CURRENT_MOVEMENT_UNBOUND' using errcode='40001';
  end if;
  if jsonb_array_length(v_context->'root_timesheet_ids')=0 then
    raise exception 'WEEKLY_SOURCE_MISSING_CORRECTION_ROOT_UNAVAILABLE' using errcode='55000';
  end if;
  for v_root in select value::uuid from jsonb_array_elements_text(v_context->'root_timesheet_ids') value order by value::uuid loop
    -- Observe the existing native preflight under the caller's retained I-1
    -- scope. Do not acquire a second family/row lock order inside this reader.
    v_preflight:=public.import_timesheet_financial_preflight_v1(array[v_root],
      'WEEKLY_SOURCE_CORRECT_FINAL_SOURCE',p_actor_user_id,'{}'::jsonb,false,100);
    if v_preflight->'allowed' is distinct from 'true'::jsonb
      or v_preflight->>'required_path' is distinct from 'DIRECT_AMEND_RECALCULATE'
      or v_preflight->'authorised_count' is distinct from '0'::jsonb
      or v_preflight->'paid_count' is distinct from '0'::jsonb
      or v_preflight->'invoice_lined_count' is distinct from '0'::jsonb
      or v_preflight->'blocking_batch_count' is distinct from '0'::jsonb then
      raise exception 'WEEKLY_SOURCE_MISSING_CORRECTION_NATIVE_PATH_CHANGED' using errcode='40001';
    end if;
    select coalesce(jsonb_agg(to_jsonb(movement) order by movement.id),'[]'::jsonb) into v_movements
      from private.weekly_source_ordinary_projection_active_movements_v1(v_root,v_parent.id) movement
      where movement.work_event_id=v_snapshot.work_event_id;
    if (v_parent_move is null and jsonb_array_length(v_movements)<>0)
      or (v_parent_move is not null and (jsonb_array_length(v_movements)<>1
        or v_movements->0->>'id' is distinct from v_parent_move::text)) then
      raise exception 'WEEKLY_SOURCE_MISSING_CORRECTION_CURRENT_MOVEMENT_UNBOUND' using errcode='40001';
    end if;
    v_roots:=v_roots||jsonb_build_array(jsonb_build_object('root_timesheet_id',v_root,
      'native_preflight',v_preflight,'current_parent_movements',v_movements));
  end loop;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_CORRECTION_BASELINE_V1',
    'correction_session_id',v_session.id,'actor_user_id',p_actor_user_id,
    'source_cycle_id',v_cycle.id,'projection_publication_id',v_publication.id,'upload_id',v_upload.id,
    'review_result_hash',encode(v_session.review_result_hash,'hex'),
    'current_parent_revision',to_jsonb(v_parent),'current_parent_transition',to_jsonb(v_parent_transition),
    'earlier_baseline_snapshot_id',v_snapshot.id,'earlier_original_basis',v_original,
    'current_parent_movement_id',v_parent_move,'root_observations',v_roots);
  return v_result||jsonb_build_object('baseline_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_MISSING_CORRECTION_BASELINE_V1',v_result),'hex'));
end;
$function$;

create or replace function private.weekly_source_missing_revision_census_guard_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
begin
  if tg_table_schema is distinct from 'public' or tg_table_name is distinct from 'weekly_source_final_revisions' then
    raise exception 'WEEKLY_SOURCE_MISSING_REVISION_GUARD_TARGET_INVALID' using errcode='55000';
  end if;
  if tg_op='UPDATE' then
    if old.missing_cancel_basis_census is distinct from new.missing_cancel_basis_census then
      raise exception 'WEEKLY_SOURCE_MISSING_REVISION_CENSUS_IMMUTABLE' using errcode='55000';
    end if;
    return new;
  elsif tg_op='DELETE' then
    if old.missing_cancel_basis_census is distinct from '{}'::jsonb then
      raise exception 'WEEKLY_SOURCE_MISSING_REVISION_CENSUS_IMMUTABLE' using errcode='55000';
    end if;
    return old;
  elsif tg_op='TRUNCATE' then
    if exists(select 1 from public.weekly_source_final_revisions revision
      where revision.missing_cancel_basis_census is distinct from '{}'::jsonb) then
      raise exception 'WEEKLY_SOURCE_MISSING_REVISION_CENSUS_IMMUTABLE' using errcode='55000';
    end if;
    return null;
  end if;
  raise exception 'WEEKLY_SOURCE_MISSING_REVISION_GUARD_OPERATION_INVALID' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_missing_accept_inventory_inputs_v1(
  p_work_event_id uuid,p_root_timesheet_id uuid,p_projection_publication_id uuid,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_context jsonb; v_inventory jsonb; v_component record; v_value jsonb;
  v_before jsonb:='[]'::jsonb; v_after jsonb:='[]'::jsonb; v_removed jsonb:='[]'::jsonb;
  v_native_after jsonb; v_chosen_segments jsonb; v_source_segments jsonb; v_segment record;
  v_root public.timesheets%rowtype; v_contract public.contracts%rowtype;
  v_work public.weekly_work_events%rowtype; v_cycle public.weekly_source_cycles%rowtype;
  v_target_final_revision uuid;
  v_worked_count integer:=0; v_expense_count integer:=0; v_ordinal integer:=0;
  v_remove boolean; v_result jsonb;
begin
  if p_work_event_id is null or p_root_timesheet_id is null or p_projection_publication_id is null or p_actor_user_id is null then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_INPUT_INVALID' using errcode='22023';
  end if;
  v_context:=private.weekly_source_kept_as_paid_context_for_publication_v1(
    p_work_event_id,p_actor_user_id,p_projection_publication_id);
  select * into strict v_work from public.weekly_work_events where id=p_work_event_id;
  select * into strict v_root from public.timesheets where timesheet_id=p_root_timesheet_id;
  select * into strict v_contract from public.contracts where id=v_root.contract_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=(v_context->>'source_cycle_id')::uuid;
  select revision.id into v_target_final_revision from public.weekly_source_final_revisions revision
    join public.weekly_source_projection_publications publication on publication.upload_id=revision.upload_id
    where publication.id=p_projection_publication_id and publication.state='CURRENT'
      and v_cycle.current_projection_publication_id=publication.id
      and revision.id=v_cycle.current_final_revision_id and revision.state='CURRENT'
      and revision.authority_scope_kind='CYCLE' and revision.report_scope_id is null;
  if not (v_context->'root_timesheet_ids') @> jsonb_build_array(p_root_timesheet_id)
    or v_context->'source_present' is distinct from 'false'::jsonb
    or not coalesce(v_context->'decision_available'='true'::jsonb,false)
    or not v_root.is_current or v_root.sheet_scope is distinct from 'WEEKLY'::public.timesheet_scope_enum
    or (v_contract.candidate_id,v_contract.client_id,v_contract.id)
      is distinct from (v_work.candidate_id,v_work.client_id,(v_context->>'contract_id')::uuid)
    or v_cycle.source_group_id is distinct from v_work.first_source_group_id then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_SCOPE_UNBOUND' using errcode='42501';
  end if;
  -- This is the same genuine native approver purpose as the existing later
  -- change owner. Merely reading VIEW_PAY_WORK cannot prepare this operation.
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'APPROVE_PROTECTED_PAY',
    v_cycle.source_group_id,v_contract.client_id,v_cycle.finalisation_week_ending);
  v_inventory:=private.weekly_source_effective_inventory_v1(p_root_timesheet_id);
  if v_inventory->'ok' is distinct from 'true'::jsonb then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_INVENTORY_UNAVAILABLE' using errcode='55000';
  end if;
  for v_component in select value,ordinality from jsonb_array_elements(v_inventory->'components')
    with ordinality order by ordinality loop
    -- Strip only the readback hash field, then reuse the single current native
    -- scalar/canonical component owner. No amount/rate/hours recomputation.
    v_value:=private.weekly_source_publication_component_canonical_v1(
      v_component.value-'component_sha256','missing_accept.before_component');
    if v_value->>'component_id' is distinct from private.weekly_source_entitlement_component_id_v1(
      v_value->>'component_kind',v_value->>'economic_key_type',v_value->>'economic_key_value',
      v_value->>'component_member_identity')::text then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_COMPONENT_ID_UNBOUND' using errcode='55000';
    end if;
    v_before:=v_before||jsonb_build_array(v_value);
    -- Exact existing Source member identities only. An ordinary/unknown UUID
    -- or schedule overlap is not reclassified as a Source event here.
    v_remove:=v_value->>'component_member_identity'=v_work.id::text and (
      (v_value->>'component_kind'='WORKED_TIME' and v_value->>'economic_key_type'='SEGMENT'
        and v_value->>'economic_key_value'='weekly-source-event:'||v_work.id::text
        and v_value->>'segment_id'='weekly-source-event:'||v_work.id::text
        and v_value->>'work_date'=v_work.work_date::text and v_value->>'origin'='WEEKLY_SOURCE')
      or (v_value->>'component_kind'='SOURCE_FIXED_EXPENSE' and v_value->>'economic_key_type'='EXPENSE_AUTHORITY'
        and v_value->>'economic_key_value'='weekly-source-expense:'||v_work.id::text
        and v_value->>'origin'='WEEKLY_SOURCE_EXPENSE'));
    if coalesce(v_remove,false) then
      v_removed:=v_removed||jsonb_build_array(v_value);
      if v_value->>'component_kind'='WORKED_TIME' then v_worked_count:=v_worked_count+1;
      else v_expense_count:=v_expense_count+1; end if;
    else
      v_ordinal:=v_ordinal+1;
      v_after:=v_after||jsonb_build_array(private.weekly_source_publication_component_canonical_v1(
        v_value||jsonb_build_object('component_ordinal',v_ordinal),'missing_accept.after_component'));
    end if;
  end loop;
  if v_worked_count<>1 or v_expense_count>1 then
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_ACCEPT_INVENTORY_INPUTS_V1',
      'available',false,'reason','GENUINE_CURRENT_SOURCE_COMPONENT_UNAVAILABLE_OR_AMBIGUOUS',
      'work_event_id',v_work.id,'root_timesheet_id',v_root.timesheet_id,
      'current_inventory',v_inventory,'native_context',v_context,
      'paid_writer_permission',null,'publish_permission',null);
  end if;
  -- The real reviewed after-position is the native complete current Final
  -- proposal, not a fabricated prior-head-only amendment. Keep every other
  -- actual native update/addition/default-retained omission and Additional.
  if v_target_final_revision is not null then
    v_source_segments:=private.weekly_source_ordinary_projection_current_segments_v1(v_root.timesheet_id,v_target_final_revision);
    v_chosen_segments:='[]'::jsonb;
    for v_segment in select value,ordinality from jsonb_array_elements(v_source_segments) with ordinality order by ordinality loop
      if v_segment.value->>'segment_id'='weekly-source-event:'||v_work.id::text then
        if v_segment.value#>>'{weekly_source,work_event_id}' is distinct from v_work.id::text then
          raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_SOURCE_SEGMENT_UNBOUND' using errcode='55000';
        end if;
      else v_chosen_segments:=v_chosen_segments||jsonb_build_array(v_segment.value); end if;
    end loop;
    v_native_after:=private.weekly_source_entitlement_components_v1(v_source_segments,
      private.weekly_source_ordinary_projection_current_expenses_v1(v_root.timesheet_id,v_target_final_revision));
    v_native_after:=private.weekly_source_retain_approved_additional_v2(v_root.timesheet_id,v_native_after);
    v_after:='[]'::jsonb;v_ordinal:=0;v_worked_count:=0;v_expense_count:=0;
    for v_component in select value,ordinality from jsonb_array_elements(v_native_after) with ordinality order by ordinality loop
      v_value:=private.weekly_source_publication_component_canonical_v1(v_component.value,'missing_accept.native_after_component');
      v_remove:=v_value->>'component_member_identity'=v_work.id::text and (
        (v_value->>'component_kind'='WORKED_TIME' and v_value->>'economic_key_type'='SEGMENT'
          and v_value->>'economic_key_value'='weekly-source-event:'||v_work.id::text
          and v_value->>'segment_id'='weekly-source-event:'||v_work.id::text
          and v_value->>'work_date'=v_work.work_date::text and v_value->>'origin'='WEEKLY_SOURCE')
        or (v_value->>'component_kind'='SOURCE_FIXED_EXPENSE' and v_value->>'economic_key_type'='EXPENSE_AUTHORITY'
          and v_value->>'economic_key_value'='weekly-source-expense:'||v_work.id::text
          and v_value->>'origin'='WEEKLY_SOURCE_EXPENSE'));
      if coalesce(v_remove,false) then
        if v_value->>'component_kind'='WORKED_TIME' then v_worked_count:=v_worked_count+1;
        else v_expense_count:=v_expense_count+1;end if;
      else
        v_ordinal:=v_ordinal+1;
        v_after:=v_after||jsonb_build_array(private.weekly_source_publication_component_canonical_v1(
          v_value||jsonb_build_object('component_ordinal',v_ordinal),'missing_accept.after_component'));
      end if;
    end loop;
    if v_worked_count<>1 or v_expense_count>1 then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_FINAL_COMPONENT_UNAVAILABLE_OR_AMBIGUOUS' using errcode='55000';
    end if;
  end if;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_ACCEPT_INVENTORY_INPUTS_V1',
    'available',true,'work_event_id',v_work.id,'root_timesheet_id',v_root.timesheet_id,
    'candidate_id',v_contract.candidate_id,'client_id',v_contract.client_id,'contract_id',v_contract.id,
    'family_booking_id',v_root.booking_id,'root_version',v_root.version,
    'projection_publication_id',p_projection_publication_id,'source_cycle_id',v_cycle.id,
    'target_final_revision_id',v_target_final_revision,'final_source_ready',v_target_final_revision is not null,
    'facts_fingerprint',v_context->'facts_fingerprint','current_inventory',v_inventory,
    'before_components',v_before,'after_components',v_after,'removed_components',v_removed,
    'chosen_source_segments',v_chosen_segments,'native_final_components',v_native_after,
    'native_context',v_context,'paid_writer_permission',null,'publish_permission',null,
    'lock_scope_acquired',false);
  return v_result||jsonb_build_object('inputs_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_MISSING_ACCEPT_INVENTORY_INPUTS_V1',v_result),'hex'));
end;
$function$;

create or replace function private.weekly_source_missing_accept_prepare_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_actor uuid;v_event_id uuid;v_root_id uuid;v_publication_id uuid;v_key text;
  v_version bigint;v_request_hash bytea;v_inputs jsonb;v_initial jsonb;v_lock jsonb;
  v_event public.weekly_work_events%rowtype;v_publication public.weekly_source_projection_publications%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;v_root public.timesheets%rowtype;v_contract public.contracts%rowtype;
  v_group public.weekly_source_groups%rowtype;v_saved public.audit_events%rowtype;v_saved_count integer;
  v_bundle uuid;v_head uuid;v_decision uuid;v_proposal jsonb;v_canonical jsonb;v_recorded jsonb;
  v_proof jsonb;v_result jsonb;v_frame jsonb;
  v_old_frame text:=coalesce(current_setting('cloudtms.weekly_source_missing_accept_prepare_frame',true),'');
begin
  if coalesce(current_setting('request.jwt.claim.role',true),
    nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
  perform private.weekly_source_publication_require_keys_v1(p_request,array[
    'schema_version','actor_user_id','work_event_id','root_timesheet_id','projection_publication_id',
    'expected_root_version','expected_facts_fingerprint','expected_inventory_digest','idempotency_key'],
    'missing_accept.prepare');
  if p_request->>'schema_version' is distinct from 'WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE_V1' then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE_INVALID' using errcode='22023';end if;
  v_actor:=(private.weekly_source_publication_scalar_v1(p_request->'actor_user_id','actor_user_id','UUID')#>>'{}')::uuid;
  v_event_id:=(private.weekly_source_publication_scalar_v1(p_request->'work_event_id','work_event_id','UUID')#>>'{}')::uuid;
  v_root_id:=(private.weekly_source_publication_scalar_v1(p_request->'root_timesheet_id','root_timesheet_id','UUID')#>>'{}')::uuid;
  v_publication_id:=(private.weekly_source_publication_scalar_v1(p_request->'projection_publication_id','projection_publication_id','UUID')#>>'{}')::uuid;
  v_version:=(private.weekly_source_publication_scalar_v1(p_request->'expected_root_version','expected_root_version','INT')#>>'{}')::bigint;
  if v_version<1 or jsonb_typeof(p_request->'expected_facts_fingerprint') is distinct from 'string'
    or not coalesce(p_request->>'expected_facts_fingerprint'~'^[0-9a-f]{64}$',false)
    or jsonb_typeof(p_request->'expected_inventory_digest') is distinct from 'string'
    or not coalesce(p_request->>'expected_inventory_digest'~'^[0-9a-f]{64}$',false)
    or jsonb_typeof(p_request->'idempotency_key') is distinct from 'string' then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE_INVALID' using errcode='22023';end if;
  v_key:=btrim(p_request->>'idempotency_key');
  if char_length(v_key) not between 16 and 200 then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE_INVALID' using errcode='22023';end if;
  v_request_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE_V1',p_request-'idempotency_key');
  select * into strict v_event from public.weekly_work_events where id=v_event_id;
  select * into strict v_publication from public.weekly_source_projection_publications where id=v_publication_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_publication.source_cycle_id;
  if v_cycle.source_group_id is distinct from v_event.first_source_group_id then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_SCOPE_UNBOUND' using errcode='42501';end if;
  perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',
    v_cycle.source_group_id,v_event.client_id,v_cycle.finalisation_week_ending);
  -- Exact replay returns the real historical proposal; it does not claim that
  -- its former current position is still current or append another proof.
  select count(*) into v_saved_count from public.audit_events audit
    where audit.object_type='weekly_source_entitlement_decision_bundles'
      and audit.action='WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED' and audit.after_json->>'idempotency_key'=v_key;
  if v_saved_count>1 then raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PROOF_AMBIGUOUS' using errcode='55000';end if;
  if v_saved_count=1 then
    select * into strict v_saved from public.audit_events audit where audit.object_type='weekly_source_entitlement_decision_bundles'
      and audit.action='WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED' and audit.after_json->>'idempotency_key'=v_key;
    if v_saved.actor_user_id is distinct from v_actor or v_saved.after_json->>'request_hash' is distinct from encode(v_request_hash,'hex')
      or v_saved.after_json->'prepare_request' is distinct from p_request then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE_REPLAY_CONFLICT' using errcode='22023';end if;
    return v_saved.after_json->'result'||jsonb_build_object('idempotent_replay',true,'historical_proposal',true);
  end if;
  v_initial:=private.weekly_source_missing_accept_inventory_inputs_v1(v_event_id,v_root_id,v_publication_id,v_actor);
  if v_initial->'available' is distinct from 'true'::jsonb or v_initial->'final_source_ready' is distinct from 'true'::jsonb then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_FINAL_REQUIRED' using errcode='55000';end if;
  v_lock:=private.weekly_source_lock_and_resolve_families_v1((v_initial->>'candidate_id')::uuid,array[v_root_id],
    'WORKBENCH_CANDIDATE_ENTITLEMENT_PUBLICATION',gen_random_uuid(),'WEEKLY_SOURCE_ENTITLEMENT_PUBLICATION');
  if v_lock->>'ok' is distinct from 'true' or v_lock->>'gate' is distinct from 'GRANTED' then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_SCOPE_UNAVAILABLE' using errcode='55000';end if;
  select count(*) into v_saved_count from public.audit_events audit
    where audit.object_type='weekly_source_entitlement_decision_bundles'
      and audit.action='WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED' and audit.after_json->>'idempotency_key'=v_key;
  if v_saved_count>1 then raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PROOF_AMBIGUOUS' using errcode='55000';end if;
  if v_saved_count=1 then
    select * into strict v_saved from public.audit_events audit where audit.object_type='weekly_source_entitlement_decision_bundles'
      and audit.action='WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED' and audit.after_json->>'idempotency_key'=v_key;
    if v_saved.actor_user_id is distinct from v_actor or v_saved.after_json->>'request_hash' is distinct from encode(v_request_hash,'hex')
      or v_saved.after_json->'prepare_request' is distinct from p_request then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE_REPLAY_CONFLICT' using errcode='22023';end if;
    return v_saved.after_json->'result'||jsonb_build_object('idempotent_replay',true,'historical_proposal',true);
  end if;
  v_inputs:=private.weekly_source_missing_accept_inventory_inputs_v1(v_event_id,v_root_id,v_publication_id,v_actor);
  if v_inputs is distinct from v_initial or v_inputs->'available' is distinct from 'true'::jsonb
    or v_inputs->'final_source_ready' is distinct from 'true'::jsonb
    or v_inputs->>'root_version' is distinct from v_version::text
    or v_inputs->>'facts_fingerprint' is distinct from p_request->>'expected_facts_fingerprint'
    or v_inputs#>>'{current_inventory,inventory_digest}' is distinct from p_request->>'expected_inventory_digest' then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE_FACTS_CHANGED' using errcode='40001';end if;
  select * into strict v_root from public.timesheets where timesheet_id=v_root_id;
  select * into strict v_contract from public.contracts where id=v_root.contract_id;
  select * into strict v_group from public.weekly_source_groups where id=v_cycle.source_group_id;
  v_bundle:=gen_random_uuid();v_head:=gen_random_uuid();v_decision:=gen_random_uuid();
  v_proposal:=private.weekly_source_entitlement_proposal_request_v1(v_root_id,(v_inputs->>'target_final_revision_id')::uuid,
    'LOCKED_FINAL_SOURCE',v_bundle,1,v_head,v_decision,v_inputs->'after_components','UNCHANGED');
  v_canonical:=private.weekly_source_publication_request_canonical_v1(v_proposal,'IMMEDIATE',null::uuid);
  v_recorded:=private.weekly_source_entitlement_proposal_record_v1(v_proposal,v_group.agency_id,
    v_contract.id,v_root.week_ending_date,v_actor);
  if v_recorded->'ok' is distinct from 'true'::jsonb or v_recorded->'created' is distinct from 'true'::jsonb
    or v_recorded->>'decision_bundle_id' is distinct from v_bundle::text
    or v_recorded->>'state' is distinct from 'PROPOSED' then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE_RECORD_FAILED' using errcode='55000';end if;
  v_result:=jsonb_build_object('ok',true,'published',false,'decision_bundle_id',v_bundle,'bundle_revision',1,
    'proposed_head_id',v_head,'decision_id',v_decision,'final_revision_id',v_inputs->'target_final_revision_id',
    'work_event_id',v_event_id,'root_timesheet_id',v_root_id,'projection_publication_id',v_publication_id,
    'request_digest',encode(private.weekly_source_publication_request_digest_v1(v_canonical),'hex'),
    'before_inventory',v_inputs->'before_components','proposed_inventory',v_inputs->'after_components',
    'idempotent_replay',false);
  v_proof:=jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSAL_PROOF_V1',
    'idempotency_key',v_key,'request_hash',encode(v_request_hash,'hex'),'prepare_request',p_request,
    'actor_user_id',v_actor,'work_event_id',v_event_id,'root_timesheet_id',v_root_id,
    'projection_publication_id',v_publication_id,'decision_bundle_id',v_bundle,'bundle_revision',1,
    'inputs',v_inputs,'canonical_proposal',v_canonical,'proposal_control',v_proposal->'control',
    'native_lock_result',v_lock,'owner_transaction_id',pg_current_xact_id()::text,
    'owner_backend_pid',pg_backend_pid(),'result',v_result);
  v_proof:=v_proof||jsonb_build_object('proof_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSAL_PROOF_V1',v_proof),'hex'));
  v_frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE_FRAME_V1',
    'actor_user_id',v_actor,'owner_transaction_id',pg_current_xact_id()::text,'owner_backend_pid',pg_backend_pid(),
    'proof',v_proof);
  v_frame:=v_frame||jsonb_build_object('frame_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE_FRAME_V1',v_frame),'hex'));
  perform set_config('cloudtms.weekly_source_missing_accept_prepare_frame',v_frame::text,true);
  perform public._audit_insert('weekly_source_entitlement_decision_bundles',v_bundle::text,
    'WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED',v_inputs->'current_inventory',v_proof,
    'WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE',v_actor);
  perform set_config('cloudtms.weekly_source_missing_accept_prepare_frame',v_old_frame,true);
  return v_result;
exception when others then
  perform set_config('cloudtms.weekly_source_missing_accept_prepare_frame',v_old_frame,true);raise;
end;
$function$;

create or replace function private.weekly_source_missing_accept_proposal_v1(
  p_decision_bundle_id uuid,p_bundle_revision bigint,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_audit public.audit_events%rowtype;v_bundle public.weekly_source_entitlement_decision_bundles%rowtype;
  v_count integer;v_proof jsonb;v_inputs jsonb;v_rebuilt jsonb;v_canonical jsonb;v_prepare jsonb;
begin
  select count(*) into v_count from public.audit_events audit
    where audit.object_type='weekly_source_entitlement_decision_bundles'
      and audit.object_id_text=p_decision_bundle_id::text and audit.action='WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED'
      and audit.after_json->>'bundle_revision'=p_bundle_revision::text;
  if v_count=0 then return null;end if;
  if v_count<>1 then raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PROOF_AMBIGUOUS' using errcode='55000';end if;
  select * into strict v_audit from public.audit_events audit
    where audit.object_type='weekly_source_entitlement_decision_bundles'
      and audit.object_id_text=p_decision_bundle_id::text and audit.action='WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED'
      and audit.after_json->>'bundle_revision'=p_bundle_revision::text;
  v_proof:=v_audit.after_json;v_prepare:=v_proof->'prepare_request';
  if v_proof->>'schema_version' is distinct from 'WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSAL_PROOF_V1'
    or v_proof->>'proof_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSAL_PROOF_V1',v_proof-'proof_sha256'),'hex')
    or v_proof->>'request_hash' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_MISSING_ACCEPT_PREPARE_V1',v_prepare-'idempotency_key'),'hex')
    or v_proof->>'actor_user_id' is distinct from v_audit.actor_user_id::text
    or v_prepare->>'actor_user_id' is distinct from v_audit.actor_user_id::text
    or v_proof->>'decision_bundle_id' is distinct from p_decision_bundle_id::text
    or v_proof->>'bundle_revision' is distinct from p_bundle_revision::text then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PROOF_UNBOUND' using errcode='55000';end if;
  select * into strict v_bundle from public.weekly_source_entitlement_decision_bundles bundle
    where bundle.decision_bundle_id=p_decision_bundle_id and bundle.bundle_revision=p_bundle_revision;
  if v_bundle.state is distinct from 'PROPOSED' or v_bundle.bundle_kind is distinct from 'SINGLE_ROOT'
    or cardinality(v_bundle.proposed_head_ids)<>1
    or v_bundle.source_root_timesheet_id::text is distinct from v_proof->>'root_timesheet_id'
    or v_bundle.decided_by_user_id is distinct from v_audit.actor_user_id then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSAL_STALE' using errcode='40001';end if;
  v_inputs:=private.weekly_source_missing_accept_inventory_inputs_v1((v_proof->>'work_event_id')::uuid,
    v_bundle.source_root_timesheet_id,(v_proof->>'projection_publication_id')::uuid,p_actor_user_id);
  if v_inputs is distinct from v_proof->'inputs' or v_inputs->'available' is distinct from 'true'::jsonb
    or v_inputs->'final_source_ready' is distinct from 'true'::jsonb then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSAL_FACTS_CHANGED' using errcode='40001';end if;
  v_rebuilt:=private.weekly_source_entitlement_proposal_request_v1(v_bundle.source_root_timesheet_id,
    (v_inputs->>'target_final_revision_id')::uuid,'LOCKED_FINAL_SOURCE',v_bundle.decision_bundle_id,
    v_bundle.bundle_revision,v_bundle.proposed_head_ids[1],v_bundle.decision_id,v_inputs->'after_components','UNCHANGED');
  v_canonical:=private.weekly_source_publication_request_canonical_v1(v_rebuilt,'IMMEDIATE',null::uuid);
  if v_canonical is distinct from v_proof->'canonical_proposal' or v_rebuilt->'control' is distinct from v_proof->'proposal_control'
    or v_bundle.request_digest is distinct from private.weekly_source_publication_request_digest_v1(v_canonical) then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSAL_FACTS_CHANGED' using errcode='40001';end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSAL_READ_V1',
    'work_event_id',v_proof->'work_event_id','projection_publication_id',v_proof->'projection_publication_id',
    'inputs',v_inputs,'proposal',v_rebuilt,'reserved_proof',v_proof);
end;
$function$;

create or replace function private.weekly_source_missing_accept_current_removal_v1(
  p_work_event_id uuid,p_root_timesheet_id uuid,p_projection_publication_id uuid,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_event public.weekly_work_events%rowtype;v_root public.timesheets%rowtype;v_contract public.contracts%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;v_cycle public.weekly_source_cycles%rowtype;
  v_head public.weekly_source_entitlement_heads%rowtype;v_bundle public.weekly_source_entitlement_decision_bundles%rowtype;
  v_action private.weekly_source_accepted_publication_actions_v1%rowtype;
  v_receipt private.weekly_source_entitlement_publication_receipts%rowtype;v_audit public.audit_events%rowtype;
  v_current_head public.weekly_source_entitlement_heads%rowtype;
  v_chain jsonb;v_current_receipt jsonb;v_current_components jsonb;
  v_pending public.weekly_source_pending_entitlement_bundles%rowtype;v_deferred_canonical jsonb;
  v_count integer;v_inventory jsonb;v_identity jsonb;v_family uuid[];v_canonical jsonb;v_reviewed jsonb;
  v_proof jsonb;v_components jsonb:='[]'::jsonb;v_component record;v_value jsonb;v_result jsonb;
begin
  if p_actor_user_id is null then return null;end if;
  select * into strict v_event from public.weekly_work_events where id=p_work_event_id;
  select * into strict v_root from public.timesheets where timesheet_id=p_root_timesheet_id;
  select * into strict v_contract from public.contracts where id=v_root.contract_id;
  select * into strict v_publication from public.weekly_source_projection_publications where id=p_projection_publication_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_publication.source_cycle_id;
  -- Reuse exact genuine target-export validation, with no Source context
  -- recursion or preparer-actor substitution. This fact does not assert cash.
  perform private.weekly_source_kept_as_paid_facts_for_publication_v1(v_event.id,'NOT_INVOICED_DISAPPEARED',v_publication.id);
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
    v_event.first_source_group_id,v_event.client_id,v_cycle.finalisation_week_ending);
  if (v_contract.candidate_id,v_contract.client_id) is distinct from (v_event.candidate_id,v_event.client_id)
    or v_cycle.source_group_id is distinct from v_event.first_source_group_id or not v_root.is_current then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_SCOPE_UNBOUND' using errcode='42501';end if;
  if exists(select 1 from public.weekly_source_upload_rows row
    join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=row.id
      and resolution.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version::integer)
    where row.upload_id=v_publication.upload_id and resolution.work_event_id=v_event.id)
    or (v_event.identity_kind='PROFILE_EXTERNAL_KEY' and exists(select 1 from public.weekly_source_upload_rows row
      where row.upload_id=v_publication.upload_id and row.external_source_key=v_event.profile_external_key)) then return null;end if;
  v_identity:=private.weekly_source_resolve_root_identity_v1(v_root.timesheet_id);
  if v_identity->>'ok' is distinct from 'true' or v_identity->>'canonical_timesheet_id' is distinct from v_root.timesheet_id::text then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_SCOPE_UNBOUND' using errcode='55000';end if;
  v_inventory:=private.weekly_source_effective_inventory_v1(v_root.timesheet_id);
  if v_inventory->>'ok' is distinct from 'true' then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_INVENTORY_UNAVAILABLE' using errcode='55000';end if;
  if v_inventory->'head_id' is null or v_inventory->'head_id'='null'::jsonb then return null;end if;
  select * into strict v_head from public.weekly_source_entitlement_heads where id=(v_inventory->>'head_id')::uuid;
  v_family:=private.weekly_source_invoice_family_timesheet_ids_v1(v_root.timesheet_id);
  if v_head.state is distinct from 'COMMITTED_CURRENT' or v_head.authority_kind not in ('LOCKED_FINAL_SOURCE','PROTECTED')
    or not coalesce(v_head.root_timesheet_id=any(v_family),false)
    or (v_head.candidate_id,v_head.contract_id,v_head.week_ending_date,v_head.root_family_booking_id)
      is distinct from (v_contract.candidate_id,v_contract.id,v_root.week_ending_date,v_root.booking_id) then return null;end if;
  v_current_head:=v_head;
  v_chain:=private.weekly_source_missing_accept_head_chain_v1(v_current_head.id,v_event.id);
  if v_chain is null then return null;end if;
  if v_chain->>'current_head_id' is distinct from v_current_head.id::text or v_chain->>'work_event_id' is distinct from v_event.id::text then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_PROOF_UNBOUND' using errcode='55000';end if;
  select * into strict v_head from public.weekly_source_entitlement_heads where id=(v_chain->>'anchor_head_id')::uuid;
  if v_head.authority_kind is distinct from 'LOCKED_FINAL_SOURCE' then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_PROOF_UNBOUND' using errcode='55000';end if;
  v_current_receipt:=v_chain#>'{native_head_chain,0,native_receipt}';
  v_current_components:=v_chain#>'{native_head_chain,0,canonical_components}';
  select count(*) into v_count from private.weekly_source_accepted_publication_actions_v1 action
    where action.planned_head_id=v_head.id;
  if v_count=0 then return null;end if;
  if v_count<>1 then raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_ACTION_AMBIGUOUS' using errcode='55000';end if;
  select * into strict v_action from private.weekly_source_accepted_publication_actions_v1 where planned_head_id=v_head.id;
  select count(*) into v_count from public.audit_events audit
    where audit.action='WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED' and audit.object_type='weekly_source_entitlement_decision_bundles'
      and audit.object_id_text=v_action.decision_bundle_id::text
      and audit.after_json->>'bundle_revision'=(v_action.bundle_revision-1)::text
      and audit.after_json->>'work_event_id'=v_event.id::text;
  if v_count=0 then return null;end if;
  if v_count<>1 then raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_PROOF_AMBIGUOUS' using errcode='55000';end if;
  select * into strict v_audit from public.audit_events audit
    where audit.action='WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED' and audit.object_type='weekly_source_entitlement_decision_bundles'
      and audit.object_id_text=v_action.decision_bundle_id::text
      and audit.after_json->>'bundle_revision'=(v_action.bundle_revision-1)::text
      and audit.after_json->>'work_event_id'=v_event.id::text;
  v_proof:=v_audit.after_json;
  v_canonical:=private.weekly_source_publication_request_canonical_v1(v_action.accepted_canonical_json,'IMMEDIATE',null::uuid);
  v_reviewed:=jsonb_set(jsonb_set(v_canonical,'{bundle_revision}',to_jsonb(v_action.bundle_revision-1)),
    '{financial_request,source_revision}',v_canonical#>'{financial_request,source_revision}'-'origin_kind'-'accepted_action_id');
  if v_action.action is distinct from 'APPROVE_UPDATED_HOURS'
    or (v_action.decision_bundle_id,v_action.bundle_revision,v_action.actor_user_id,v_action.planned_head_id)
      is distinct from (v_head.decision_bundle_id,v_head.bundle_revision,v_head.decided_by_user_id,v_head.id)
    or (v_action.root_timesheet_id,v_action.family_booking_id,v_action.candidate_id,v_action.client_id,v_action.contract_id,v_action.week_ending_date)
      is distinct from (v_head.root_timesheet_id,v_head.root_family_booking_id,v_event.candidate_id,v_event.client_id,v_head.contract_id,v_head.week_ending_date)
    or v_action.accepted_canonical_sha256 is distinct from private.weekly_source_publication_request_digest_v1(v_canonical)
    or v_canonical is distinct from v_action.accepted_canonical_json
    or v_canonical#>>'{financial_request,source_revision,origin_kind}' is distinct from 'CURRENT_FINAL_SOURCE_V1'
    or v_canonical#>>'{financial_request,source_revision,accepted_action_id}' is distinct from v_action.action_id::text
    or v_canonical#>>'{financial_request,source_revision,final_revision_id}' is distinct from v_action.final_revision_id::text
    or v_action.expected_prior_origin is distinct from v_proof#>'{inputs,current_inventory,approval_basis,origin}'
    or encode(v_action.before_inventory_sha256,'hex') is distinct from v_proof#>>'{inputs,current_inventory,approval_basis,inventory_digest}'
    or encode(v_action.before_entitlement_sha256,'hex') is distinct from v_proof#>>'{inputs,current_inventory,approval_basis,entitlement_digest}'
    or v_reviewed is distinct from v_proof->'canonical_proposal'
    or v_proof->>'actor_user_id' is distinct from v_audit.actor_user_id::text
    or v_proof->>'proof_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSAL_PROOF_V1',v_proof-'proof_sha256'),'hex')
    or v_proof#>>'{inputs,work_event_id}' is distinct from v_event.id::text
    or v_proof#>>'{inputs,contract_id}' is distinct from v_head.contract_id::text then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_PROOF_UNBOUND' using errcode='55000';end if;
  select * into strict v_bundle from public.weekly_source_entitlement_decision_bundles bundle
    where bundle.decision_bundle_id=v_head.decision_bundle_id and bundle.bundle_revision=v_head.bundle_revision;
  select count(*) into v_count from private.weekly_source_entitlement_publication_receipts receipt
    where receipt.decision_bundle_id=v_head.decision_bundle_id and receipt.bundle_revision=v_head.bundle_revision
      and receipt.request_digest=v_head.publication_receipt_digest;
  if v_count<>1 then raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_RECEIPT_UNBOUND' using errcode='55000';end if;
  select * into strict v_receipt from private.weekly_source_entitlement_publication_receipts receipt
    where receipt.decision_bundle_id=v_head.decision_bundle_id and receipt.bundle_revision=v_head.bundle_revision
      and receipt.request_digest=v_head.publication_receipt_digest;
  if to_jsonb(v_receipt) is distinct from (v_chain->'native_head_chain'->(jsonb_array_length(v_chain->'native_head_chain')-1)->'native_receipt') then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_RECEIPT_UNBOUND' using errcode='55000';end if;
  if v_receipt.publication_mode='IMMEDIATE' then
    if v_receipt.pending_bundle_id is not null or v_receipt.request_digest is distinct from v_action.accepted_canonical_sha256 then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_RECEIPT_UNBOUND' using errcode='55000';end if;
  elsif v_receipt.publication_mode='DEFERRED' then
    select * into strict v_pending from public.weekly_source_pending_entitlement_bundles where id=v_receipt.pending_bundle_id;
    v_deferred_canonical:=private.weekly_source_publication_request_canonical_v1(v_pending.request_json,'DEFERRED',v_pending.id);
    if v_pending.state is distinct from 'RELEASED'
      or v_pending.released_receipt_id is distinct from v_receipt.id
      or v_pending.released_receipt_digest is distinct from v_receipt.request_digest
      or v_pending.request_digest is distinct from v_receipt.request_digest
      or (v_pending.decision_bundle_id,v_pending.bundle_revision,v_pending.candidate_id,v_pending.decision_id,v_pending.decided_by_user_id)
        is distinct from (v_receipt.decision_bundle_id,v_receipt.bundle_revision,v_receipt.candidate_id,v_receipt.decision_id,v_receipt.decided_by_user_id)
      or v_pending.member_root_ids is distinct from v_receipt.member_root_ids
      or v_pending.member_family_booking_ids is distinct from v_receipt.member_family_booking_ids
      or v_pending.member_root_versions is distinct from v_receipt.member_root_versions
      or v_pending.proposed_head_ids is distinct from v_receipt.head_ids
      or v_pending.source_revision_digest is distinct from v_bundle.source_revision_digest
      or v_pending.contract_choice_digest is distinct from v_bundle.contract_choice_digest
      or v_pending.released_by_worker_id is distinct from v_receipt.released_by_worker_id
      or v_pending.released_by_worker_run_id is distinct from v_receipt.released_by_worker_run_id
      or private.weekly_source_publication_request_digest_v1(v_deferred_canonical) is distinct from v_receipt.request_digest
      or private.weekly_source_publication_request_canonical_v1(v_pending.request_json,'IMMEDIATE',null::uuid) is distinct from v_canonical then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_RECEIPT_UNBOUND' using errcode='55000';end if;
  else raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_RECEIPT_UNBOUND' using errcode='55000';end if;
  if v_bundle.state is distinct from 'COMMITTED' or v_bundle.request_digest is distinct from v_action.accepted_canonical_sha256
    or v_bundle.decided_by_user_id is distinct from v_head.decided_by_user_id
    or (v_bundle.source_root_timesheet_id,v_bundle.source_root_family_booking_id,v_bundle.source_contract_id,v_bundle.week_ending_date)
      is distinct from (v_head.root_timesheet_id,v_head.root_family_booking_id,v_head.contract_id,v_head.week_ending_date)
    or v_receipt.member_root_ids is distinct from array[v_head.root_timesheet_id]
    or v_receipt.member_family_booking_ids is distinct from array[v_head.root_family_booking_id]
    or v_receipt.member_root_versions is distinct from array[v_head.root_timesheet_version]
    or to_jsonb(v_receipt.member_root_versions) is distinct from v_canonical->'member_root_versions'
    or v_receipt.head_ids is distinct from array[v_head.id]
    or v_receipt.candidate_id is distinct from v_head.candidate_id
    or v_receipt.decision_id is distinct from v_head.decision_id
    or v_receipt.decided_by_user_id is distinct from v_head.decided_by_user_id
    or v_receipt.scope_change_tx_token is distinct from v_head.scope_change_tx_token
    or v_head.publication_receipt_digest is distinct from v_receipt.request_digest then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_RECEIPT_UNBOUND' using errcode='55000';end if;
  if (v_chain->'native_head_chain'->(jsonb_array_length(v_chain->'native_head_chain')-1)->'canonical_components')
    is distinct from v_canonical#>'{financial_request,member_entitlements,0,components}' then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_COMPONENTS_CHANGED' using errcode='55000';end if;
  for v_component in select value,ordinality from jsonb_array_elements(v_inventory->'components') with ordinality order by ordinality loop
    v_value:=private.weekly_source_publication_component_canonical_v1(v_component.value-'component_sha256','missing_accept.current_component');
    if v_value->>'component_member_identity'=v_event.id::text and (
      v_value->>'economic_key_value'='weekly-source-event:'||v_event.id::text
      or v_value->>'economic_key_value'='weekly-source-expense:'||v_event.id::text) then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_COMPONENT_REINTRODUCED' using errcode='55000';end if;
    v_components:=v_components||jsonb_build_array(v_value);
  end loop;
  if v_components is distinct from v_current_components
    or v_current_head.component_count is distinct from jsonb_array_length(v_components)
    or v_current_head.certified_zero is distinct from (jsonb_array_length(v_components)=0) then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_COMPONENTS_CHANGED' using errcode='55000';end if;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_REMOVAL_V1',
    'work_event_id',v_event.id,'root_timesheet_id',v_root.timesheet_id,'projection_publication_id',v_publication.id,
    'accepted_source_removed',true,'head',to_jsonb(v_current_head),'accepted_action',to_jsonb(v_action),
    'native_publication_receipt',v_current_receipt,'current_inventory',v_inventory,'reserved_proof_sha256',v_proof->'proof_sha256',
    'cash_recovered',null,'paid_quantity_known',false,'withheld_quantity_known',false,'writer_permission',null);
  if v_receipt.publication_mode='DEFERRED' then
    v_result:=v_result||jsonb_build_object('deferred_acceptance_publication',jsonb_build_object(
      'pending_bundle_id',v_pending.id,'released_receipt_id',v_pending.released_receipt_id,
      'immediate_canonical',v_canonical,'deferred_canonical',v_deferred_canonical,
      'receipt_sha256',encode(v_receipt.request_digest,'hex')));
  end if;
  if v_current_head.id is distinct from v_head.id then
    v_result:=v_result||jsonb_build_object('acceptance_head',to_jsonb(v_head),'acceptance_publication_receipt',to_jsonb(v_receipt),
      'native_head_continuity',v_chain);
  end if;
  return v_result||jsonb_build_object('removal_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_REMOVAL_V1',v_result),'hex'));
end;
$function$;

create or replace function public.weekly_source_later_change_decide_atomic_v1(
  p_request jsonb
) returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','extensions','pg_catalog','pg_temp'
as $function$
declare
  v_keys constant text[]:=array[
    'actor_user_id','bundle_revision','decision','decision_bundle_id',
    'final_revision_id','idempotency_key','root_timesheet_id','schema_version'
  ];
  v_actual_keys text[];
  v_expected_keys text[];
  v_actor uuid;
  v_decision text;
  v_bundle_id uuid;
  v_bundle_revision bigint;
  v_root_timesheet_id uuid;
  v_final_revision_id uuid;
  v_idempotency_key text;
  v_identity jsonb;
  v_timesheet public.timesheets%rowtype;
  v_contract public.contracts%rowtype;
  v_revision public.weekly_source_final_revisions%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_bundle public.weekly_source_entitlement_decision_bundles%rowtype;
  v_head public.weekly_source_entitlement_heads%rowtype;
  v_head_found boolean:=false;
  v_head_family uuid[];
  v_head_count integer;
  v_authority_kind text;
  v_components jsonb;
  v_chosen_segments jsonb;
  v_request jsonb;
  v_result jsonb;
  v_published boolean:=false;
  v_request_hash bytea;
  v_request_hash_hex text;
  v_audit public.audit_events%rowtype;
  v_locks jsonb;
  v_inventory jsonb;
  v_accepted_action_id uuid;
  v_successor_revision bigint;
  v_recorded jsonb;
  v_missing_accept jsonb;
begin
  if coalesce(
       pg_catalog.current_setting('request.jwt.claim.role',true),
       nullif(pg_catalog.current_setting('request.jwt.claims',true),'')::jsonb->>'role',''
     )<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
  end if;
  if pg_catalog.jsonb_typeof(p_request)<>'object' then
    raise exception 'WEEKLY_SOURCE_LATER_CHANGE_REQUEST_INVALID' using errcode='22023';
  end if;
  select pg_catalog.array_agg(key order by key) into v_actual_keys
  from pg_catalog.jsonb_object_keys(p_request) key;
  select pg_catalog.array_agg(key order by key) into v_expected_keys
  from pg_catalog.unnest(v_keys) key;
  if v_actual_keys is distinct from v_expected_keys
     or p_request->>'schema_version'<>'WEEKLY_SOURCE_LATER_CHANGE_DECISION_V1' then
    raise exception 'WEEKLY_SOURCE_LATER_CHANGE_REQUEST_INVALID' using errcode='22023';
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_bundle_id:=(p_request->>'decision_bundle_id')::uuid;
    v_bundle_revision:=(p_request->>'bundle_revision')::bigint;
    v_root_timesheet_id:=(p_request->>'root_timesheet_id')::uuid;
    v_final_revision_id:=(p_request->>'final_revision_id')::uuid;
  exception when others then
    raise exception 'WEEKLY_SOURCE_LATER_CHANGE_REQUEST_INVALID' using errcode='22023';
  end;
  v_decision:=pg_catalog.upper(pg_catalog.btrim(coalesce(p_request->>'decision','')));
  v_idempotency_key:=pg_catalog.btrim(coalesce(p_request->>'idempotency_key',''));
  if v_actor is null or v_bundle_id is null or v_root_timesheet_id is null
     or v_final_revision_id is null or coalesce(v_bundle_revision,0)<1
     or v_decision not in ('APPROVE_UPDATED_HOURS','KEEP_CURRENTLY_APPROVED_HOURS')
     or pg_catalog.char_length(v_idempotency_key) not between 16 and 200 then
    raise exception 'WEEKLY_SOURCE_LATER_CHANGE_REQUEST_INVALID' using errcode='22023';
  end if;

  -- Exact replay, in the shape this file already uses for the other Office
  -- actions.  An Office decision is a money act: submitting it twice must
  -- return the first result, not take it again.  The advisory lock makes two
  -- concurrent first attempts one write plus one replay rather than two writes.
  v_request_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_LATER_CHANGE_DECISION_V1',p_request-'idempotency_key'
  );
  v_request_hash_hex:=pg_catalog.encode(v_request_hash,'hex');

  -- Exact original actor/full-payload audit replay precedes fresh admission.
  -- Keep the original lookup below the idempotency lock for a first-call race.
  select audit_row.* into v_audit
  from public.audit_events audit_row
  where audit_row.action='WEEKLY_SOURCE_LATER_CHANGE_DECIDED'
    and audit_row.after_json->>'idempotency_key'=v_idempotency_key
  order by audit_row.ts_utc,audit_row.id
  limit 1;
  if found then
    if v_audit.after_json->>'request_hash' is distinct from v_request_hash_hex then
      raise exception 'WEEKLY_SOURCE_LATER_CHANGE_IDEMPOTENCY_COLLISION'
        using errcode='22023';
    end if;
    return coalesce(v_audit.after_json->'result','{}'::jsonb)
      ||pg_catalog.jsonb_build_object('idempotent_replay',true);
  end if;
  perform private.weekly_source_pay_query_admit_v2();

  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended(
    'WEEKLY_SOURCE_LATER_CHANGE_DECISION|'||v_idempotency_key,0
  ));
  select audit_row.* into v_audit
  from public.audit_events audit_row
  where audit_row.action='WEEKLY_SOURCE_LATER_CHANGE_DECIDED'
    and audit_row.after_json->>'idempotency_key'=v_idempotency_key
  order by audit_row.ts_utc,audit_row.id
  limit 1;
  if found then
    if v_audit.after_json->>'request_hash' is distinct from v_request_hash_hex then
      raise exception 'WEEKLY_SOURCE_LATER_CHANGE_IDEMPOTENCY_COLLISION'
        using errcode='22023';
    end if;
    return coalesce(v_audit.after_json->'result','{}'::jsonb)
      ||pg_catalog.jsonb_build_object('idempotent_replay',true);
  end if;

  -- The root must be the canonical current member of its own family before any
  -- decision is even considered (proof/34 section 5; WB-016).
  v_identity:=private.weekly_source_resolve_root_identity_v1(v_root_timesheet_id);
  if coalesce((v_identity->>'ok')::boolean,false) is not true
     or (v_identity->>'canonical_timesheet_id')::uuid is distinct from v_root_timesheet_id then
    return pg_catalog.jsonb_build_object(
      'ok',false,'published',false,
      'code','WEEKLY_SOURCE_ROOT_INTEGRITY_FAILURE','retryable',false,
      'detail',coalesce(v_identity,'{}'::jsonb)
    );
  end if;

  select * into strict v_timesheet from public.timesheets
  where timesheet_id=v_root_timesheet_id;
  select * into strict v_contract from public.contracts
  where id=v_timesheet.contract_id;
  select * into strict v_revision from public.weekly_source_final_revisions
  where id=v_final_revision_id;
  select * into strict v_cycle from public.weekly_source_cycles
  where id=v_revision.source_cycle_id;
  select * into strict v_group from public.weekly_source_groups
  where id=v_cycle.source_group_id;

  -- Office authority.  A later-change decision is a pay decision, so it uses
  -- the existing APPROVE_PROTECTED_PAY operation, which already requires an
  -- active admin who is a payment authoriser.  No new whitelist entry.
  perform private.weekly_source_office_authority_v1(
    v_actor,'APPROVE_PROTECTED_PAY',v_group.id,v_contract.client_id,
    v_cycle.finalisation_week_ending
  );

  -- The accepted decision and publication share I-1's existing lock order.
  -- Take it before the bundle, then re-resolve the physical root under lock.
  -- An immutable proposal actor is never updated in place.
  v_locks:=private.weekly_source_lock_and_resolve_families_v1(
    v_contract.candidate_id,array[v_root_timesheet_id],
    'WORKBENCH_CANDIDATE_ENTITLEMENT_PUBLICATION',pg_catalog.gen_random_uuid(),
    'WEEKLY_SOURCE_ENTITLEMENT_PUBLICATION');
  if v_locks->>'ok' is distinct from 'true' or v_locks->>'gate' is distinct from 'GRANTED' then
    raise exception 'WEEKLY_SOURCE_LATER_CHANGE_SCOPE_UNAVAILABLE' using errcode='55000';
  end if;
  v_identity:=private.weekly_source_resolve_root_identity_v1(v_root_timesheet_id);
  if v_identity->>'ok' is distinct from 'true'
    or v_identity->>'canonical_timesheet_id' is distinct from v_root_timesheet_id::text then
    raise exception 'WEEKLY_SOURCE_LATER_CHANGE_SCOPE_STALE' using errcode='55000';
  end if;
  select * into strict v_timesheet from public.timesheets where timesheet_id=v_root_timesheet_id;
  select * into strict v_contract from public.contracts where id=v_timesheet.contract_id;
  if v_revision.state is distinct from 'CURRENT'
    or not exists(select 1 from public.weekly_source_final_revisions revision
      where revision.id=v_final_revision_id and revision.state='CURRENT'
        and revision.manifest_hash=v_revision.manifest_hash
        and revision.policy_fingerprint=v_revision.policy_fingerprint) then
    raise exception 'WEEKLY_SOURCE_LATER_CHANGE_SCOPE_STALE' using errcode='55000';
  end if;

  select * into v_bundle
  from public.weekly_source_entitlement_decision_bundles bundle_row
  where bundle_row.decision_bundle_id=v_bundle_id
    and bundle_row.bundle_revision=v_bundle_revision
  for update;
  if not found then
    return pg_catalog.jsonb_build_object(
      'ok',false,'published',false,
      'code','WEEKLY_SOURCE_DECISION_BUNDLE_NOT_FOUND','retryable',false,
      'detail',pg_catalog.jsonb_build_object(
        'decision_bundle_id',v_bundle_id,'bundle_revision',v_bundle_revision)
    );
  end if;
  -- Only a live PROPOSED bundle may be decided.  A COMMITTED bundle's decision
  -- has already been published, and admitting it would let an Office user
  -- re-decide published money while the actor stamp and the ABANDONED update
  -- (both `where state='PROPOSED'`) silently matched zero rows.
  if v_bundle.state<>'PROPOSED'
     or v_bundle.source_root_timesheet_id is distinct from v_root_timesheet_id
     or v_bundle.bundle_kind is distinct from 'SINGLE_ROOT'
     or v_bundle.candidate_id is distinct from v_contract.candidate_id
     or v_bundle.agency_id is distinct from v_group.agency_id
     or v_bundle.source_contract_id is distinct from v_contract.id
     or v_bundle.source_root_family_booking_id is distinct from v_timesheet.booking_id
     or v_bundle.week_ending_date is distinct from v_timesheet.week_ending_date
     or cardinality(v_bundle.proposed_head_ids)<>1 then
    return pg_catalog.jsonb_build_object(
      'ok',false,'published',false,
      'code','WEEKLY_SOURCE_DECISION_BUNDLE_NOT_PROPOSED','retryable',false,
      'detail',pg_catalog.jsonb_build_object('state',v_bundle.state)
    );
  end if;

  -- WP-30 (WP-27 sweep finding N4, second site), standing rule 3.  The
  -- committed current head is a fact about the FAMILY: the relation's own
  -- uniqueness after S8 is one head per trimmed family booking id, and the
  -- physical-root index is a second, weaker key.  Keyed on the physical id a
  -- rotated family's head was invisible, so `v_head_found` was false and the
  -- KEEP-CURRENT branch below abandoned the decision and reported
  -- `current_head_id=null, authority_kind=null` for a family that demonstrably
  -- holds a live LOCKED_FINAL_SOURCE head.
  --
  -- The cardinality is tested EXPLICITLY and contradictory evidence is refused;
  -- neither unique index is treated as making more than one impossible
  -- (Part 1 rule 5), and no `limit` decides anything.
  --
  -- I-1 above serialises the same canonical family before the bundle lock;
  -- the committed head is read within that existing rotation/identity boundary.
  v_head_family:=private.weekly_source_invoice_family_timesheet_ids_v1(
    v_root_timesheet_id
  );
  if v_head_family is null or pg_catalog.cardinality(v_head_family)=0 then
    return pg_catalog.jsonb_build_object(
      'ok',false,'published',false,
      'code','WEEKLY_SOURCE_ROOT_INTEGRITY_FAILURE','retryable',false,
      'detail',pg_catalog.jsonb_build_object(
        'reason','FAMILY_IDENTITY_UNRESOLVED',
        'root_timesheet_id',v_root_timesheet_id)
    );
  end if;
  select pg_catalog.count(*)::integer into v_head_count
  from public.weekly_source_entitlement_heads head
  where head.root_timesheet_id=any(v_head_family)
    and head.state='COMMITTED_CURRENT';
  if v_head_count>1 then
    return pg_catalog.jsonb_build_object(
      'ok',false,'published',false,
      'code','WEEKLY_SOURCE_ROOT_INTEGRITY_FAILURE','retryable',false,
      'detail',pg_catalog.jsonb_build_object(
        'reason','MULTIPLE_COMMITTED_CURRENT_HEADS_FOR_THE_FAMILY',
        'root_timesheet_id',v_root_timesheet_id,
        'committed_current_head_count',v_head_count)
    );
  end if;
  if v_head_count=1 then
    select head.* into strict v_head
    from public.weekly_source_entitlement_heads head
    where head.root_timesheet_id=any(v_head_family)
      and head.state='COMMITTED_CURRENT';
  end if;
  v_head_found:=(v_head_count=1);

  if v_decision='APPROVE_UPDATED_HOURS' then
    v_missing_accept:=private.weekly_source_missing_accept_proposal_v1(v_bundle_id,v_bundle_revision,v_actor);
  end if;

  if v_decision='APPROVE_UPDATED_HOURS' then
    -- The complete proposed entitlement, rebuilt from the server's own
    -- snapshot builders at the declared current source revision.
    v_authority_kind:='LOCKED_FINAL_SOURCE';
    v_chosen_segments:=private.weekly_source_ordinary_projection_current_segments_v1(
      v_root_timesheet_id,v_final_revision_id);
    v_components:=private.weekly_source_entitlement_components_v1(
      v_chosen_segments,
      private.weekly_source_ordinary_projection_current_expenses_v1(
        v_root_timesheet_id,v_final_revision_id)
    );
    v_components:=private.weekly_source_retain_approved_additional_v2(
      v_root_timesheet_id,v_components
    );
    if v_missing_accept is not null then
      if v_missing_accept#>>'{inputs,target_final_revision_id}' is distinct from v_final_revision_id::text then
        raise exception 'WEEKLY_SOURCE_LATER_CHANGE_REVIEW_STALE' using errcode='55000';
      end if;
      v_components:=v_missing_accept#>'{inputs,after_components}';
      v_chosen_segments:=v_missing_accept#>'{inputs,chosen_source_segments}';
    end if;
  else
    -- 24 section 4.2 and section 6.4: `Keep currently approved hours`
    -- PRESERVES the current complete entitlement.  The money never moves.
    v_authority_kind:='PROTECTED';
    if not v_head_found or v_head.authority_kind='PROTECTED' then
      -- Nothing to publish: what is currently approved stays exactly as it is
      -- (26 Gate 2: "keep-current publishes/retains complete PROTECTED").  The
      -- later proposal is abandoned, the old position remains current, and no
      -- head, receipt, invalidation or Banking Pay row is written.
      update public.weekly_source_entitlement_decision_bundles
      set state='ABANDONED'
      where decision_bundle_id=v_bundle.decision_bundle_id
        and bundle_revision=v_bundle.bundle_revision
        and state='PROPOSED';
      v_result:=pg_catalog.jsonb_build_object(
        'ok',true,'published',false,'retained',true,'decision',v_decision,
        'decision_bundle_id',v_bundle.decision_bundle_id,
        'bundle_revision',v_bundle.bundle_revision,
        'current_head_id',v_head.id,
        'authority_kind',case when v_head_found then v_head.authority_kind else null end
      );
      perform public._audit_insert(
        'weekly_source_entitlement_decision_bundles',v_bundle.decision_bundle_id::text,
        'WEEKLY_SOURCE_LATER_CHANGE_DECIDED',null,
        pg_catalog.jsonb_build_object(
          'decision',v_decision,'outcome','RETAINED',
          'bundle_revision',v_bundle.bundle_revision,
          'root_timesheet_id',v_root_timesheet_id,
          'final_revision_id',v_final_revision_id,
          'current_head_id',v_head.id,
          'idempotency_key',v_idempotency_key,
          'request_hash',v_request_hash_hex,
          'result',v_result
        ),'WEEKLY_SOURCE_KEEP_CURRENTLY_APPROVED_HOURS',v_actor
      );
      return v_result||pg_catalog.jsonb_build_object('idempotent_replay',false);
    end if;
    -- A committed LOCKED_FINAL_SOURCE head becomes PROTECTED with EXACTLY the
    -- same complete component set: the authority kind moves, the money does not.
    select coalesce(pg_catalog.jsonb_agg(
      pg_catalog.jsonb_build_object(
        'component_ordinal',component.component_ordinal,
        'component_id',component.component_id,
        'component_kind',component.component_kind,
        'economic_key_type',component.economic_key_type,
        'economic_key_value',component.economic_key_value,
        'component_member_identity',component.component_member_identity,
        'segment_id',component.segment_id,
        'segment_key',component.segment_key,
        'segment_stable_key',component.segment_stable_key,
        'work_date',component.work_date,
        'reference_number',component.reference_number,
        'hours_day',case when component.hours_day is null then null
          else pg_catalog.to_char(component.hours_day,'FM9999999999990.000000') end,
        'hours_night',case when component.hours_night is null then null
          else pg_catalog.to_char(component.hours_night,'FM9999999999990.000000') end,
        'hours_sat',case when component.hours_sat is null then null
          else pg_catalog.to_char(component.hours_sat,'FM9999999999990.000000') end,
        'hours_sun',case when component.hours_sun is null then null
          else pg_catalog.to_char(component.hours_sun,'FM9999999999990.000000') end,
        'hours_bh',case when component.hours_bh is null then null
          else pg_catalog.to_char(component.hours_bh,'FM9999999999990.000000') end,
        'additional_code_raw',component.additional_code_raw,
        'unit_count',case when component.unit_count is null then null
          else pg_catalog.to_char(component.unit_count,'FM9999999999990.000000') end,
        'unit_pay_rate',case when component.unit_pay_rate is null then null
          else pg_catalog.to_char(component.unit_pay_rate,'FM9999999999990.000000') end,
        'unit_charge_rate',case when component.unit_charge_rate is null then null
          else pg_catalog.to_char(component.unit_charge_rate,'FM9999999999990.000000') end,
        'expense_code',component.expense_code,
        'pay_ex_vat',pg_catalog.to_char(component.pay_ex_vat,'FM9999999999990.00'),
        'charge_ex_vat',case when component.charge_ex_vat is null then null
          else pg_catalog.to_char(component.charge_ex_vat,'FM9999999999990.00') end,
        'exclude_from_pay',component.exclude_from_pay,
        'origin',component.origin,
        -- Copy the committed values, do NOT null them: this arm promises the
        -- byte-identical component set, and a head that did carry movement ids
        -- must keep them.
        'movement_id',component.movement_id,
        'movement_group_id',component.movement_group_id
      ) order by component.component_ordinal
    ),'[]'::jsonb) into v_components
    from public.weekly_source_entitlement_head_components component
    where component.head_id=v_head.id;
  end if;

  v_request:=private.weekly_source_entitlement_proposal_request_v1(
    v_root_timesheet_id,v_final_revision_id,v_authority_kind,
    v_bundle.decision_bundle_id,v_bundle.bundle_revision,
    v_bundle.proposed_head_ids[1],v_bundle.decision_id,v_components
  );

  -- V4 I2: accepting an actual reviewed Final is an immutable successor, not
  -- an actor overwrite on a staged/KEEP proposal. First bind the original APP
  -- vector exactly to what Office reviewed, then add only accepted provenance.
  -- KEEP receives no normal-Final retained-content exception.
  if v_decision='APPROVE_UPDATED_HOURS' then
    if v_bundle.request_digest is distinct from private.weekly_source_publication_request_digest_v1(
        private.weekly_source_publication_request_canonical_v1(v_request,'IMMEDIATE',null::uuid)) then
      raise exception 'WEEKLY_SOURCE_LATER_CHANGE_REVIEW_STALE' using errcode='55000';
    end if;
    v_inventory:=private.weekly_source_effective_inventory_v1(v_root_timesheet_id);
    if v_inventory->>'ok' is distinct from 'true'
      or v_inventory#>>'{approval_basis,coverage_complete}' is distinct from 'true' then
      raise exception 'WEEKLY_SOURCE_LATER_CHANGE_SCOPE_UNAVAILABLE' using errcode='55000';
    end if;
    v_accepted_action_id:=pg_catalog.gen_random_uuid();
    v_request:=pg_catalog.jsonb_set(v_request,'{financial_request,source_revision}',
      (v_request#>'{financial_request,source_revision}')||pg_catalog.jsonb_build_object(
        'origin_kind','CURRENT_FINAL_SOURCE_V1','accepted_action_id',v_accepted_action_id));
  end if;
  if exists(select 1 from public.weekly_source_entitlement_decision_bundles later
    where later.decision_bundle_id=v_bundle.decision_bundle_id
      and later.bundle_revision>v_bundle.bundle_revision) then
    raise exception 'WEEKLY_SOURCE_LATER_CHANGE_REVIEW_STALE' using errcode='55000';
  end if;
  v_successor_revision:=v_bundle.bundle_revision+1;
  v_request:=pg_catalog.jsonb_set(v_request,'{bundle_revision}',to_jsonb(v_successor_revision));
  update public.weekly_source_entitlement_decision_bundles
  set state='ABANDONED'
  where decision_bundle_id=v_bundle.decision_bundle_id
    and bundle_revision=v_bundle.bundle_revision
    and state='PROPOSED';
  if not found then raise exception 'WEEKLY_SOURCE_LATER_CHANGE_REVIEW_STALE' using errcode='55000'; end if;
  v_recorded:=private.weekly_source_entitlement_proposal_record_v1(
    v_request,v_group.agency_id,v_contract.id,v_timesheet.week_ending_date,v_actor);
  if v_recorded->>'ok' is distinct from 'true' or v_recorded->>'created' is distinct from 'true' then
    raise exception 'WEEKLY_SOURCE_LATER_CHANGE_ACCEPTANCE_FAILED' using errcode='55000';
  end if;
  if v_decision='APPROVE_UPDATED_HOURS' then
    if private.weekly_source_accepted_publication_action_record_v1(
       p_request,v_request,v_inventory#>'{approval_basis,origin}') is distinct from v_accepted_action_id then
      raise exception 'WEEKLY_SOURCE_LATER_CHANGE_ACCEPTANCE_FAILED' using errcode='55000';
    end if;
  end if;

  -- Capture the actual accepted Source artifact before publication regardless
  -- of financial module owner. This writes only exact chosen detail; it neither
  -- activates Banking NEXT nor admits its financial producer. Missing capture
  -- authority refuses atomically. KEEP copies only genuine prior HEAD detail.
  perform private.bpay_next_capture_chosen_source_detail_v1(
    v_bundle.proposed_head_ids[1],v_bundle.decision_bundle_id,
    v_successor_revision,v_components,
    case when v_decision='APPROVE_UPDATED_HOURS' then v_chosen_segments end,
    case when v_decision='KEEP_CURRENTLY_APPROVED_HOURS' then v_head.id end);

  v_result:=private.weekly_source_entitlement_publish_immediate_v1(v_request);
  -- A real refusal rolls back acceptance/abandonment together. Do not audit a
  -- failed partial write as an idempotent decision that can never be retried.
  if v_result->>'ok' is distinct from 'true' then
    raise exception 'WEEKLY_SOURCE_LATER_CHANGE_PUBLICATION_REFUSED'
      using errcode='55000',detail=v_result::text;
  end if;
  v_published:=coalesce((v_result->>'published')::boolean,false);
  v_result:=v_result||pg_catalog.jsonb_build_object(
    'decision',v_decision,'retained',false,
    'decision_bundle_id',v_bundle.decision_bundle_id,
    'bundle_revision',v_successor_revision,
    'reviewed_bundle_revision',v_bundle.bundle_revision,
    'authority_kind',v_authority_kind
  );

  perform public._audit_insert(
    'weekly_source_entitlement_decision_bundles',v_bundle.decision_bundle_id::text,
    'WEEKLY_SOURCE_LATER_CHANGE_DECIDED',null,
    pg_catalog.jsonb_build_object(
      'decision',v_decision,
      'outcome',case when v_published then 'PUBLISHED' else 'NOT_PUBLISHED' end,
      'bundle_revision',v_successor_revision,
      'reviewed_bundle_revision',v_bundle.bundle_revision,
      'root_timesheet_id',v_root_timesheet_id,
      'final_revision_id',v_final_revision_id,
      'authority_kind',v_authority_kind,
      'component_count',pg_catalog.jsonb_array_length(v_components),
      'coordinator_code',v_result->>'code',
      'idempotency_key',v_idempotency_key,
      'request_hash',v_request_hash_hex,
      'result',v_result
    ),case when v_decision='APPROVE_UPDATED_HOURS'
      then 'WEEKLY_SOURCE_APPROVE_UPDATED_HOURS'
      else 'WEEKLY_SOURCE_KEEP_CURRENTLY_APPROVED_HOURS' end,v_actor
  );

  return v_result||pg_catalog.jsonb_build_object('idempotent_replay',false);
exception
  when no_data_found or too_many_rows then
    raise exception 'WEEKLY_SOURCE_LATER_CHANGE_SCOPE_INVALID' using errcode='55000';
end;
$function$;

create or replace function public.weekly_source_missing_accept_prepare_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
begin
  return private.weekly_source_missing_accept_prepare_v1(p_request);
end;
$function$;

create or replace function public.weekly_source_missing_accept_context_v1(p_request jsonb)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_actor uuid;v_event uuid;v_root uuid;v_publication uuid;
begin
  if coalesce(current_setting('request.jwt.claim.role',true),
    nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';end if;
  perform private.weekly_source_publication_require_keys_v1(p_request,array[
    'schema_version','actor_user_id','work_event_id','root_timesheet_id','projection_publication_id'],
    'missing_accept.context');
  if p_request->>'schema_version' is distinct from 'WEEKLY_SOURCE_MISSING_ACCEPT_CONTEXT_V1' then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CONTEXT_INVALID' using errcode='22023';end if;
  v_actor:=(private.weekly_source_publication_scalar_v1(p_request->'actor_user_id','actor_user_id','UUID')#>>'{}')::uuid;
  v_event:=(private.weekly_source_publication_scalar_v1(p_request->'work_event_id','work_event_id','UUID')#>>'{}')::uuid;
  v_root:=(private.weekly_source_publication_scalar_v1(p_request->'root_timesheet_id','root_timesheet_id','UUID')#>>'{}')::uuid;
  v_publication:=(private.weekly_source_publication_scalar_v1(p_request->'projection_publication_id','projection_publication_id','UUID')#>>'{}')::uuid;
  return private.weekly_source_missing_accept_inventory_inputs_v1(v_event,v_root,v_publication,v_actor);
end;
$function$;

create or replace function private.weekly_source_missing_accept_head_chain_v1(
  p_current_head_id uuid,p_work_event_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_current public.weekly_source_entitlement_heads%rowtype;
  v_head public.weekly_source_entitlement_heads%rowtype;
  v_child public.weekly_source_entitlement_heads%rowtype;
  v_bundle public.weekly_source_entitlement_decision_bundles%rowtype;
  v_receipt private.weekly_source_entitlement_publication_receipts%rowtype;
  v_event public.weekly_work_events%rowtype;
  v_root public.timesheets%rowtype;v_contract public.contracts%rowtype;
  v_pending public.weekly_source_pending_entitlement_bundles%rowtype;
  v_hashed jsonb;v_components jsonb;v_pairs jsonb;v_hashes jsonb;v_component record;v_value jsonb;v_canonical jsonb;
  v_cursor uuid;v_seen uuid[]:='{}'::uuid[];v_chain jsonb:='[]'::jsonb;v_count integer;v_stack text;
begin
  get diagnostics v_stack=pg_context;
  if v_stack !~* 'PL/pgSQL function (private[.])?weekly_source_missing_accept_current_removal_v1[(]uuid,uuid,uuid,uuid[)]' then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_CURRENT_READER_REQUIRED' using errcode='42501';end if;
  select * into strict v_event from public.weekly_work_events where id=p_work_event_id;
  select * into strict v_current from public.weekly_source_entitlement_heads where id=p_current_head_id;
  if v_current.state is distinct from 'COMMITTED_CURRENT' or v_current.candidate_id is distinct from v_event.candidate_id then
    raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_SCOPE_INVALID' using errcode='55000';end if;
  v_cursor:=v_current.id;
  while v_cursor is not null loop
    if v_cursor=any(v_seen) then raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_CYCLE' using errcode='55000';end if;
    v_seen:=array_append(v_seen,v_cursor);
    select * into strict v_head from public.weekly_source_entitlement_heads where id=v_cursor;
    if (v_head.candidate_id,v_head.contract_id,v_head.week_ending_date,v_head.root_family_booking_id)
      is distinct from (v_current.candidate_id,v_current.contract_id,v_current.week_ending_date,v_current.root_family_booking_id)
      or v_head.committed_at_utc is null or v_head.publication_receipt_digest is null then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_SCOPE_CHANGED' using errcode='55000';end if;
    select * into strict v_root from public.timesheets where timesheet_id=v_head.root_timesheet_id;
    select * into strict v_contract from public.contracts where id=v_root.contract_id;
    if (v_contract.candidate_id,v_contract.id,v_root.week_ending_date,v_root.booking_id)
      is distinct from (v_head.candidate_id,v_head.contract_id,v_head.week_ending_date,v_head.root_family_booking_id)
      or v_head.agency_id is distinct from v_current.agency_id then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_SCOPE_CHANGED' using errcode='55000';end if;
    if v_child.id is not null and (v_head.state is distinct from 'SUPERSEDED'
      or v_head.superseded_by_head_id is distinct from v_child.id
      or v_child.prior_head_id is distinct from v_head.id
      or v_child.head_revision is distinct from v_head.head_revision+1) then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_LINK_CHANGED' using errcode='55000';end if;
    -- A later genuine reintroduction breaks continuity even if subsequently
    -- absent again. An older matching acknowledgement is never resurrected.
    if exists(select 1 from public.weekly_source_entitlement_head_components component
      where component.head_id=v_head.id and component.component_member_identity=v_event.id::text
        and component.economic_key_value in ('weekly-source-event:'||v_event.id::text,
          'weekly-source-expense:'||v_event.id::text)) then return null;end if;
    select coalesce(pg_catalog.jsonb_agg(
             pg_catalog.jsonb_build_object(
               'component_ordinal',component.component_ordinal,
               'component_id',component.component_id,
               'component_sha256',pg_catalog.encode(component.component_sha256,'hex'),
               'component_kind',component.component_kind,
               'economic_key_type',component.economic_key_type,
               'economic_key_value',component.economic_key_value,
               'component_member_identity',component.component_member_identity,
               'segment_id',component.segment_id,
               'segment_key',component.segment_key,
               'segment_stable_key',component.segment_stable_key,
               'work_date',component.work_date,
               'reference_number',component.reference_number,
               'hours_day',case when component.hours_day is null then null
                 else pg_catalog.to_char(component.hours_day,'FM9999999999990.000000') end,
               'hours_night',case when component.hours_night is null then null
                 else pg_catalog.to_char(component.hours_night,'FM9999999999990.000000') end,
               'hours_sat',case when component.hours_sat is null then null
                 else pg_catalog.to_char(component.hours_sat,'FM9999999999990.000000') end,
               'hours_sun',case when component.hours_sun is null then null
                 else pg_catalog.to_char(component.hours_sun,'FM9999999999990.000000') end,
               'hours_bh',case when component.hours_bh is null then null
                 else pg_catalog.to_char(component.hours_bh,'FM9999999999990.000000') end,
               'additional_code_raw',component.additional_code_raw,
               'unit_count',case when component.unit_count is null then null
                 else pg_catalog.to_char(component.unit_count,'FM9999999999990.000000') end,
               'unit_pay_rate',case when component.unit_pay_rate is null then null
                 else pg_catalog.to_char(component.unit_pay_rate,'FM9999999999990.000000') end,
               'unit_charge_rate',case when component.unit_charge_rate is null then null
                 else pg_catalog.to_char(component.unit_charge_rate,'FM9999999999990.000000') end,
               'expense_code',component.expense_code,
               'pay_ex_vat',pg_catalog.to_char(component.pay_ex_vat,'FM9999999999990.00'),
               'charge_ex_vat',case when component.charge_ex_vat is null then null
                 else pg_catalog.to_char(component.charge_ex_vat,'FM9999999999990.00') end,
               'exclude_from_pay',component.exclude_from_pay,
               'origin',component.origin,
               'movement_id',component.movement_id,
               'movement_group_id',component.movement_group_id
             ) order by component.component_ordinal),'[]'::jsonb)
      into v_hashed
    from public.weekly_source_entitlement_head_components component
    where component.head_id=v_head.id;
    v_components:='[]'::jsonb;v_pairs:='[]'::jsonb;v_hashes:='[]'::jsonb;
    for v_component in select value,ordinality from jsonb_array_elements(v_hashed) with ordinality order by ordinality loop
      v_value:=private.weekly_source_publication_component_canonical_v1(v_component.value-'component_sha256','missing_accept.chain_component');
      if v_value->>'component_ordinal' is distinct from v_component.ordinality::text
        or v_component.value->>'component_sha256' is distinct from encode(private.weekly_source_publication_request_digest_v1(
          private.weekly_source_publication_component_content_v1(v_value)),'hex') then
        raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_COMPONENT_CHANGED' using errcode='55000';end if;
      v_components:=v_components||jsonb_build_array(v_value);
      v_pairs:=v_pairs||jsonb_build_array(jsonb_build_object('component_ordinal',v_value->'component_ordinal','component_id',v_value->'component_id'));
      v_hashes:=v_hashes||jsonb_build_array(v_component.value->'component_sha256');
    end loop;
    if v_head.component_count is distinct from jsonb_array_length(v_components)
      or v_head.certified_zero is distinct from (jsonb_array_length(v_components)=0)
      or v_head.inventory_digest is distinct from private.weekly_source_publication_request_digest_v1(jsonb_build_object('components',v_pairs))
      or v_head.entitlement_digest is distinct from private.weekly_source_publication_request_digest_v1(jsonb_build_object(
        'authority_kind',v_head.authority_kind,'certified_zero',v_head.certified_zero,'component_count',v_head.component_count,'components',v_hashes)) then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_COMPONENT_CHANGED' using errcode='55000';end if;
    select * into strict v_bundle from public.weekly_source_entitlement_decision_bundles bundle
      where bundle.decision_bundle_id=v_head.decision_bundle_id and bundle.bundle_revision=v_head.bundle_revision;
    select count(*) into v_count from private.weekly_source_entitlement_publication_receipts receipt
      where receipt.decision_bundle_id=v_head.decision_bundle_id and receipt.bundle_revision=v_head.bundle_revision
        and receipt.request_digest=v_head.publication_receipt_digest;
    if v_count<>1 or v_bundle.state is distinct from 'COMMITTED' then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_RECEIPT_UNBOUND' using errcode='55000';end if;
    select * into strict v_receipt from private.weekly_source_entitlement_publication_receipts receipt
      where receipt.decision_bundle_id=v_head.decision_bundle_id and receipt.bundle_revision=v_head.bundle_revision
        and receipt.request_digest=v_head.publication_receipt_digest;
    if v_receipt.publication_mode='IMMEDIATE' then
      if v_receipt.pending_bundle_id is not null or v_bundle.request_digest is distinct from v_receipt.request_digest then
        raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_RECEIPT_UNBOUND' using errcode='55000';end if;
    elsif v_receipt.publication_mode='DEFERRED' then
      select * into strict v_pending from public.weekly_source_pending_entitlement_bundles where id=v_receipt.pending_bundle_id;
      v_canonical:=private.weekly_source_publication_request_canonical_v1(v_pending.request_json,'DEFERRED',v_pending.id);
      if v_pending.state is distinct from 'RELEASED' or v_pending.released_receipt_id is distinct from v_receipt.id
        or v_pending.released_receipt_digest is distinct from v_receipt.request_digest
        or v_pending.request_digest is distinct from v_receipt.request_digest
        or (v_pending.decision_bundle_id,v_pending.bundle_revision) is distinct from (v_head.decision_bundle_id,v_head.bundle_revision)
        or private.weekly_source_publication_request_digest_v1(v_canonical) is distinct from v_receipt.request_digest
        or private.weekly_source_publication_request_digest_v1(private.weekly_source_publication_request_canonical_v1(
          v_pending.request_json,'IMMEDIATE',null::uuid)) is distinct from v_bundle.request_digest then
        raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_RECEIPT_UNBOUND' using errcode='55000';end if;
    else raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_RECEIPT_UNBOUND' using errcode='55000';end if;
    if v_bundle.candidate_id is distinct from v_head.candidate_id
      or v_bundle.agency_id is distinct from v_head.agency_id
      or v_bundle.week_ending_date is distinct from v_head.week_ending_date
      or v_bundle.decided_by_user_id is distinct from v_head.decided_by_user_id
      or v_bundle.decision_id is distinct from v_head.decision_id
      or v_bundle.source_revision_digest is distinct from v_head.source_generation_digest
      or not coalesce((v_head.root_timesheet_id,v_head.root_family_booking_id,v_head.contract_id)
        =(v_bundle.source_root_timesheet_id,v_bundle.source_root_family_booking_id,v_bundle.source_contract_id)
        or (v_head.root_timesheet_id,v_head.root_family_booking_id,v_head.contract_id)
        =(v_bundle.target_root_timesheet_id,v_bundle.target_root_family_booking_id,v_bundle.target_contract_id),false)
      or not coalesce(v_head.id=any(v_bundle.proposed_head_ids),false)
      or v_receipt.candidate_id is distinct from v_head.candidate_id
      or v_receipt.decided_by_user_id is distinct from v_head.decided_by_user_id
      or v_receipt.decision_id is distinct from v_head.decision_id
      or v_receipt.scope_change_tx_token is distinct from v_head.scope_change_tx_token
      or not exists(select 1 from unnest(v_receipt.head_ids) with ordinality member(head_id,ordinal)
        where member.head_id=v_head.id and v_receipt.member_root_ids[member.ordinal::integer]=v_head.root_timesheet_id
          and v_receipt.member_family_booking_ids[member.ordinal::integer]=v_head.root_family_booking_id
          and v_receipt.member_root_versions[member.ordinal::integer]=v_head.root_timesheet_version) then
      raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_RECEIPT_UNBOUND' using errcode='55000';end if;
    v_chain:=v_chain||jsonb_build_array(jsonb_build_object('head',to_jsonb(v_head),
      'native_receipt',to_jsonb(v_receipt),'decision_bundle',to_jsonb(v_bundle),'canonical_components',v_components)));
    select count(*) into v_count from private.weekly_source_accepted_publication_actions_v1 action
      where action.planned_head_id=v_head.id and exists(select 1 from public.audit_events audit
        where audit.action='WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED' and audit.object_type='weekly_source_entitlement_decision_bundles'
          and audit.object_id_text=action.decision_bundle_id::text
          and audit.after_json->>'bundle_revision'=(action.bundle_revision-1)::text
          and audit.after_json->>'work_event_id'=v_event.id::text);
    if v_count>1 then raise exception 'WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_ANCHOR_AMBIGUOUS' using errcode='55000';end if;
    if v_count=1 then
      return jsonb_build_object('schema_version','WEEKLY_SOURCE_MISSING_ACCEPT_HEAD_CHAIN_V1',
        'current_head_id',v_current.id,'anchor_head_id',v_head.id,'work_event_id',v_event.id,'native_head_chain',v_chain);
    end if;
    v_child:=v_head;v_cursor:=v_head.prior_head_id;
  end loop;
  return null;
end;
$function$;

create or replace function private.weekly_source_known_source_key_v1(
  p_upload_row_id uuid,p_candidate_id uuid,p_client_id uuid
) returns uuid language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_row public.weekly_source_upload_rows%rowtype;v_upload public.weekly_source_uploads%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;v_count integer;v_event uuid;v_foreign_owner boolean;
begin
  if p_upload_row_id is null or p_candidate_id is null or p_client_id is null then return null;end if;
  select * into strict v_row from public.weekly_source_upload_rows where id=p_upload_row_id;
  select * into strict v_upload from public.weekly_source_uploads where id=v_row.upload_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_upload.source_cycle_id;
  if nullif(btrim(v_row.external_source_key),'') is null
    or not exists(select 1 from public.weekly_source_groups g where g.id=v_cycle.source_group_id and g.active and g.source_family='ROSTER')
    or not exists(select 1 from public.weekly_source_format_profiles p where p.id=v_upload.source_format_profile_id and p.active
      and p.profile_code in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1','ROSTER_WEEKLY_SUMMARY_ACTUAL_V1'))
    or not private.weekly_source_upload_client_eligible_v1(v_upload.id,p_client_id,v_row.work_date) then return null;end if;
  -- Existing canonical-key ownership (including a foreign Candidate/Client)
  -- retains the normal native owner/refusal. A historical alias cannot override it.
  if exists(select 1 from public.weekly_work_events event where event.first_source_group_id=v_cycle.source_group_id
    and event.source_format_profile_id=v_upload.source_format_profile_id and event.identity_kind='PROFILE_EXTERNAL_KEY'
    and event.profile_external_key=v_row.external_source_key) then return null;end if;
  select count(distinct event.id),min(event.id::text)::uuid,
    bool_or(event.candidate_id is distinct from p_candidate_id or event.client_id is distinct from p_client_id)
    into v_count,v_event,v_foreign_owner
  from public.weekly_work_event_source_links link
  join public.weekly_source_row_resolutions resolution on resolution.id=link.row_resolution_id
    and resolution.upload_row_id=link.upload_row_id and resolution.work_event_id=link.work_event_id and resolution.mapping_state='RESOLVED'
  join public.weekly_source_upload_rows old_row on old_row.id=link.upload_row_id and old_row.external_source_key=v_row.external_source_key
  join public.weekly_source_uploads old_upload on old_upload.id=old_row.upload_id and old_upload.source_format_profile_id=v_upload.source_format_profile_id
  join public.weekly_source_cycles old_cycle on old_cycle.id=old_upload.source_cycle_id and old_cycle.source_group_id=v_cycle.source_group_id
  join public.weekly_work_events event on event.id=link.work_event_id and event.identity_kind='PROFILE_EXTERNAL_KEY'
    and event.first_source_group_id=v_cycle.source_group_id and event.source_format_profile_id=v_upload.source_format_profile_id
    and resolution.candidate_id=event.candidate_id and resolution.client_id=event.client_id
  where link.link_hash=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_WORK_EVENT_LINK_V1',jsonb_build_object(
    'work_event_id',link.work_event_id,'upload_row_id',link.upload_row_id,'resolution_id',link.row_resolution_id,'link_kind',link.link_kind));
  if v_count>1 then raise exception 'WEEKLY_SOURCE_SOURCE_KEY_ALIAS_AMBIGUOUS' using errcode='55000';end if;
  if v_count=0 then return null;end if;
  if v_foreign_owner then raise exception 'WEEKLY_SOURCE_SOURCE_KEY_ALIAS_OWNER_CONFLICT' using errcode='55000';end if;
  return v_event;
end;
$function$;

create or replace function private.weekly_source_work_event_payment_facts_v1(
  p_work_event_id uuid,p_actor_user_id uuid,p_source_cycle_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_event public.weekly_work_events%rowtype;v_resolution public.weekly_source_row_resolutions%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_root uuid;v_roots uuid[];v_revision uuid;v_segments jsonb;v_segment jsonb;
  v_movement uuid;v_movements uuid[]:='{}'::uuid[];v_members uuid[];
  v_invoiced boolean:=false;v_invoice_facts jsonb;v_invoice_row jsonb;
  v_paid_state text:='UNKNOWN';v_paid boolean;v_paid_basis jsonb:='[]'::jsonb;v_unknown boolean:=false;
  v_page jsonb;v_header jsonb;v_after jsonb:=null;v_rows jsonb;v_item jsonb;v_seen jsonb:='[]'::jsonb;
  v_pages integer;v_complete boolean;v_page_positive boolean;v_component uuid;v_component_count integer;
  v_matched_component_count integer;v_settlement jsonb;v_shift jsonb;v_legacy jsonb;v_legacy_member jsonb;
begin
  select * into strict v_event from public.weekly_work_events where id=p_work_event_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=p_source_cycle_id;
  if v_cycle.source_group_id is distinct from v_event.first_source_group_id
    or (v_cycle.scope_client_id is not null and v_cycle.scope_client_id is distinct from v_event.client_id) then
    raise exception 'WEEKLY_SOURCE_PAYMENT_FACTS_SCOPE_INVALID' using errcode='22023';end if;
  select * into strict v_resolution from public.weekly_source_row_resolutions
    where work_event_id=v_event.id and mapping_state='RESOLVED' order by created_at_utc desc,id desc limit 1;
  if v_resolution.candidate_id is distinct from v_event.candidate_id or v_resolution.client_id is distinct from v_event.client_id
    or not exists(select 1 from public.contracts c where c.id=v_resolution.contract_id
      and c.candidate_id=v_event.candidate_id and c.client_id=v_event.client_id) then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_LINEAGE_UNBOUND' using errcode='55000';end if;
  if p_actor_user_id is not null then perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
    v_event.first_source_group_id,v_event.client_id,v_cycle.finalisation_week_ending);end if;
  select coalesce(array_agg(distinct scope.canonical_timesheet_id order by scope.canonical_timesheet_id),'{}'::uuid[])
    into v_roots from public.weekly_source_row_timesheet_lineages lineage
    cross join lateral public._pay_timesheet_rotation_scope(array[lineage.timesheet_id]) scope
    where lineage.work_event_id=v_event.id and lineage.candidate_id=v_event.candidate_id and lineage.client_id=v_event.client_id;
  v_paid:=false; v_paid_state:='NOT_SETTLED';
  if cardinality(v_roots)=0 then v_paid:=null; v_paid_state:='UNKNOWN'; v_unknown:=true; end if;
  foreach v_root in array v_roots loop
    select revision.id into v_revision from public.weekly_source_final_revisions revision
    join public.weekly_source_cycles cycle on cycle.id=revision.source_cycle_id
    where revision.state='CURRENT' and cycle.source_group_id=v_event.first_source_group_id and revision.authority_scope_kind='CYCLE'
      and (cycle.scope_client_id is null or cycle.scope_client_id=v_event.client_id)
    order by cycle.finalisation_week_ending desc,revision.finalised_at_utc desc,revision.revision_number desc,revision.id desc limit 1;
    if v_revision is not null then
      v_segments:=private.weekly_source_ordinary_projection_current_segments_v1(v_root,v_revision);
      for v_segment in select value from jsonb_array_elements(v_segments) loop
        if v_segment#>>'{weekly_source,work_event_id}'=v_event.id::text then
          v_movement:=(v_segment#>>'{weekly_source,movement_id}')::uuid;
          if v_movement is null or not exists(select 1 from public.weekly_source_billing_movements m
            join public.contracts c on c.id=m.contract_id
            where m.id=v_movement and m.work_event_id=v_event.id and m.candidate_id=v_event.candidate_id
              and m.actual_client_id=v_event.client_id and c.candidate_id=v_event.candidate_id and c.client_id=v_event.client_id
              and m.movement_role in ('POSITIVE','REPLACEMENT')
              and m.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION')) then
            raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_HEAD_UNBOUND' using errcode='55000'; end if;
          if not v_movement=any(v_movements) then v_movements:=array_append(v_movements,v_movement); end if;
        end if;
      end loop;
    end if;
    v_members:=private.weekly_source_invoice_family_timesheet_ids_v1(v_root);
    v_invoice_facts:=private.weekly_source_office_invoice_movements_v1(v_members);
    if v_invoice_facts->'ok' is distinct from 'true'::jsonb then
      raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_INVOICE_UNAVAILABLE' using errcode='55000'; end if;
    for v_invoice_row in select value from jsonb_array_elements(v_invoice_facts->'movements') loop
      if v_invoice_row->>'work_event_id'=v_event.id::text and jsonb_typeof(v_invoice_row->'binding')='object'
        and v_invoice_row#>>'{binding,state}'='CURRENT' and v_invoice_row->>'movement_role' in ('POSITIVE','REPLACEMENT')
        and v_invoice_row->>'source_line_kind'<>'INVOICE_VAT_ROUNDING' then v_invoiced:=true; end if;
    end loop;
    if private.weekly_source_office_next_owner_v1() then
      -- Native component identity, not a date/rate/hours guess. Retained heads
      -- prove which Source component belongs to this exact work event.
      v_component:=private.weekly_source_entitlement_component_id_v1('WORKED_TIME','SEGMENT',
        'weekly-source-event:'||v_event.id::text,v_event.id::text);
      select count(*) into v_component_count from public.weekly_source_entitlement_head_components component
      join public.weekly_source_entitlement_heads head on head.id=component.head_id
      where head.root_timesheet_id=any(v_members) and component.component_id=v_component
        and component.component_kind='WORKED_TIME' and component.economic_key_type='SEGMENT'
        and component.economic_key_value='weekly-source-event:'||v_event.id::text
        and component.component_member_identity=v_event.id::text;
      if v_component_count=0 or p_actor_user_id is null or not exists(select 1 from public.tms_users
        where id=p_actor_user_id and is_active and lower(btrim(role))='admin') then
        -- The current Bank public reader has an admin-only authority boundary.
        -- A non-admin payment actor needs the reviewed native pure-kernel seam
        -- in SOURCE_NEXT_PAID_PERMISSION_SEAM.md; no actor substitution here.
        v_paid:=null; v_paid_state:='UNKNOWN'; v_unknown:=true;
      else
        v_after:=null; v_header:=null; v_pages:=0; v_complete:=false; v_page_positive:=false; v_seen:='[]'::jsonb;
        v_matched_component_count:=0;
        loop
          v_page:=private.weekly_source_office_next_paid_evidence_page_v1(p_actor_user_id,v_root,'COMPONENTS',null,v_after,100);
          if v_page->'available' is distinct from 'true'::jsonb then v_paid:=null; v_paid_state:='UNKNOWN'; v_unknown:=true; exit; end if;
          if v_header is null then v_header:=v_page#>'{page,header}';
          elsif v_header is distinct from v_page#>'{page,header}' then
            raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_PAID_HEADER_CHANGED' using errcode='40001'; end if;
          if v_header->>'quantity_authority_scope' is distinct from 'CURRENT'
            or v_header->>'current_origin_state' is distinct from 'APPLIED' then
            v_paid:=null; v_paid_state:='UNKNOWN'; v_unknown:=true; exit; end if;
          v_rows:=v_page#>'{page,rows}';
          for v_item in select value from jsonb_array_elements(v_rows) loop
            if v_seen ? (v_item->>'component_key') then
              raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_PAID_MEMBERSHIP_CHANGED' using errcode='23514'; end if;
            v_seen:=v_seen||jsonb_build_array(v_item->>'component_key');
            if v_item->>'source_component_id'=v_component::text then
              v_matched_component_count:=v_matched_component_count+1;
              v_paid_basis:=v_paid_basis||jsonb_build_array(jsonb_build_object('root_timesheet_id',v_root,
                'native_header',v_header,'native_component',v_item));
              if v_item->>'qualification_state'='READY' and v_item->'only_original_positive_payroll'='true'::jsonb
                and v_item->'original_cash'<>'null'::jsonb
                and v_item#>'{original_cash,original_settlement_posting_complete}'='true'::jsonb
                and (v_item->>'original_positive_source_ex_vat')::numeric>0
                and (v_item->>'realised_source_disposition_ex_vat')::numeric>0 then
                v_page_positive:=true;
              elsif v_item->>'qualification_state' not in ('NO_QUALIFIED_ORIGINAL') then
                v_paid:=null; v_paid_state:='UNKNOWN'; v_unknown:=true;
              end if;
            end if;
          end loop;
          v_pages:=v_pages+1;
          if v_page#>'{page,complete}'='true'::jsonb then v_complete:=true; exit; end if;
          if v_pages>=100 or v_page#>'{page,next_cursor}'='null'::jsonb
            or v_page#>'{page,next_cursor}' is not distinct from v_after then
            v_paid:=null; v_paid_state:='UNKNOWN'; v_unknown:=true; exit; end if;
          v_after:=v_page#>'{page,next_cursor}';
        end loop;
        if v_complete and v_matched_component_count=1 and v_page_positive then
          v_paid:=true; v_paid_state:='SETTLED_ORIGINAL';
        elsif v_complete and v_matched_component_count<>1 then
          -- Absence/duplicate of a genuine Source component in the complete
          -- native page cannot be converted into a certified unpaid fact.
          v_paid:=null; v_paid_state:='UNKNOWN'; v_unknown:=true;
        end if;
      end if;
    else
      if p_actor_user_id is null then
        v_paid:=null;v_paid_state:='UNKNOWN';v_unknown:=true;
      else
        v_legacy:=private.weekly_source_legacy_signed_source_membership_v1(v_root,v_event.id,p_actor_user_id,v_cycle.id);
        v_settlement:=v_legacy->'native_allocation';
        v_paid_basis:=v_paid_basis||jsonb_build_array(v_legacy);
        if v_legacy->>'state'='MEMBERSHIP_PRESENT' and jsonb_array_length(v_legacy->'signed_native_memberships')=1 then
          v_legacy_member:=v_legacy#>'{signed_native_memberships,0}';
          if jsonb_array_length(v_legacy_member->'native_current_financial_components')=1
            and v_legacy_member#>>'{native_component,key_type}'='TS_DAY'
            and v_legacy_member#>>'{native_component,key_value}'=v_event.work_date::text
            and v_legacy_member#>>'{native_current_financial_components,0,timesheet_id}'=v_root::text
            and v_legacy_member#>>'{native_current_financial_components,0,key_type}'='TS_DAY'
            and v_legacy_member#>>'{native_current_financial_components,0,key_value}'=v_event.work_date::text
            and coalesce(v_legacy_member#>>'{native_component,target_amount_ex_vat}','') ~ '^[0-9]+(\.[0-9]+)?$'
            and coalesce(v_legacy_member#>>'{native_current_financial_components,0,amount_ex_vat}','') ~ '^[0-9]+(\.[0-9]+)?$'
            and coalesce(v_legacy_member#>>'{signed_member,pay_amount}','') ~ '^[0-9]+(\.[0-9]+)?$'
            and (v_legacy_member#>>'{native_component,target_amount_ex_vat}')::numeric>0
            and (v_legacy_member#>>'{signed_member,pay_amount}')::numeric>0
            and (v_legacy_member#>>'{native_current_financial_components,0,amount_ex_vat}')::numeric
              =(v_legacy_member#>>'{native_component,target_amount_ex_vat}')::numeric then
            -- The native full day component is settled, its signed complete
            -- Source membership contains this event, and the existing native
            -- current financial position equals that full target. No cash is
            -- divided among shifts and no new amount is calculated.
            v_paid:=true;v_paid_state:='SETTLED_LEGACY_SOURCE_COMPONENT';
          else v_paid:=null;v_paid_state:='UNKNOWN';v_unknown:=true;end if;
        elsif v_settlement->>'state'='NO_SETTLEMENT'
          and v_legacy#>>'{native_module,active_owner}'='LEGACY'
          and v_legacy#>>'{native_terminal_census,result}'='RELEASABLE'
          and v_legacy#>'{native_terminal_census,class_counts,SETTLED_TERMINAL}'='0'::jsonb then
          -- Retain the existing native no-settlement disposition only when
          -- the complete terminal census also has no settled item.
          null;
        else v_paid:=null;v_paid_state:='UNKNOWN';v_unknown:=true;end if;
      end if;
    end if;
  end loop;
  if v_unknown then v_paid:=null; v_paid_state:='UNKNOWN'; end if;
  if cardinality(v_movements)>1 then raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_HEAD_AMBIGUOUS' using errcode='55000'; end if;
  -- Every native positive Report/window binding is an invoice fact, even when
  -- the native invoice is still DRAFT. It never asserts Candidate settlement.
  v_invoiced:=v_invoiced or exists(select 1 from public.weekly_source_invoice_line_bindings binding
    join public.weekly_source_billing_movements movement on movement.id=binding.billing_movement_id
    join public.invoice_lines line on line.id=binding.invoice_line_id and line.invoice_id=binding.invoice_id
    where binding.state='CURRENT' and movement.work_event_id=v_event.id and movement.actual_client_id=v_event.client_id
      and movement.movement_role in ('POSITIVE','REPLACEMENT') and line.total_charge_ex_vat>0);
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_WORK_EVENT_PAYMENT_FACTS_V1',
    'work_event_id',v_event.id,'candidate_id',v_event.candidate_id,'client_id',v_event.client_id,
    'source_group_id',v_event.first_source_group_id,'source_cycle_id',v_cycle.id,
    'root_timesheet_ids',to_jsonb(v_roots),'current_pay_head_movement_ids',to_jsonb(v_movements),
    'current_pay_head_movement_id',v_movements[1],'invoiced',v_invoiced,'paid',v_paid,
    'paid_evidence_state',v_paid_state,'native_paid_basis',v_paid_basis,
    'paid_quantity_known',false,'withheld_amount_known',false);
end;
$function$;

create or replace function private.weekly_source_paid_overlap_candidates_v1(
  p_upload_row_id uuid,p_actor_user_id uuid,p_candidate_id uuid,p_client_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_row public.weekly_source_upload_rows%rowtype;v_upload public.weekly_source_uploads%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;v_event public.weekly_work_events%rowtype;
  v_movement public.weekly_source_billing_movements%rowtype;v_snapshot public.weekly_source_final_snapshot_lines%rowtype;
  v_current_snapshot jsonb;v_nhsp_negative jsonb;v_nhsp_basis jsonb;v_nhsp_target jsonb;v_nhsp_position jsonb;
  v_nhsp_contract uuid;v_nhsp_start timestamp;v_nhsp_end timestamp;v_nhsp_break integer;
  v_nhsp_source_row public.weekly_source_upload_rows%rowtype;
  v_payment jsonb;v_items jsonb:='[]'::jsonb;v_result jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_upload_row_id is null or p_actor_user_id is null or p_candidate_id is null or p_client_id is null then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_REQUEST_INVALID' using errcode='22023';end if;
  select * into strict v_row from public.weekly_source_upload_rows where id=p_upload_row_id;
  select * into strict v_upload from public.weekly_source_uploads where id=v_row.upload_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_upload.source_cycle_id;
  if v_upload.purpose='FINAL_SOURCE_CORRECTION' then
    perform private.weekly_source_paid_match_correction_scope_v1(v_upload.id,p_actor_user_id,false);
  end if;
  if exists(select 1 from public.weekly_source_groups g where g.id=v_cycle.source_group_id and g.source_family='NHSP') then
    if v_upload.report_scope_id is null or v_upload.purpose not in ('ORDINARY','FINAL_SOURCE_CORRECTION')
      or (v_upload.purpose='ORDINARY' and (v_upload.correction_session_id is not null or v_upload.state<>'CURRENT'))
      or (v_upload.purpose='FINAL_SOURCE_CORRECTION' and v_upload.state<>'CORRECTION_READY') or not exists(select 1 from public.weekly_source_report_scopes scope
        where scope.id=v_upload.report_scope_id and scope.source_cycle_id=v_cycle.id
          and scope.source_group_id=v_cycle.source_group_id and scope.client_id=p_client_id
          and scope.self_bill_report_id is null
          and (v_upload.purpose='FINAL_SOURCE_CORRECTION' or scope.current_complete_upload_id=v_upload.id))
      or not exists(select 1 from public.weekly_source_format_profiles profile
        where profile.id=v_upload.source_format_profile_id and profile.active and profile.profile_code='NHSP_FINAL_BACKING_V1')
      or v_row.row_finalisation_state<>'SOURCE_WORKED' or v_row.source_money_parse_state is distinct from 'VALID'
      or v_row.source_shift_charge_pence is null or v_row.source_shift_charge_pence<0
      or v_row.start_at_local is null or v_row.end_at_local is null or v_row.end_at_local<=v_row.start_at_local
      or coalesce(v_row.actual_net_minutes,0)<=0 then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_SOURCE_SCOPE_INVALID' using errcode='22023';end if;
    if not exists(select 1 from public.candidates c where c.id=p_candidate_id and c.active)
      or not private.weekly_source_upload_client_eligible_v1(v_upload.id,p_client_id,v_row.work_date) then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_IDENTITY_NOT_ELIGIBLE' using errcode='22023';end if;
    perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
      v_cycle.source_group_id,p_client_id,v_cycle.finalisation_week_ending);
    for v_event in select event.* from public.weekly_work_events event
      where event.first_source_group_id=v_cycle.source_group_id
        and event.source_format_profile_id=v_upload.source_format_profile_id and event.identity_kind='SCHEDULE_TUPLE'
        and event.candidate_id=p_candidate_id and event.client_id=p_client_id and event.work_date=v_row.work_date
        -- C1 construction of this upload can create a distinct Separate event.
        -- A mapping/lineage alone is never a previous paid/current position.
        and exists(select 1 from public.weekly_source_billing_movements prior
          where prior.work_event_id=event.id and prior.source_profile_kind='NHSP_TRUST_BACKING_REPORT'
            and prior.source_line_kind='NHSP_PHYSICAL_POSITIVE' and prior.pay_effect='NORMAL'
            and prior.movement_role in ('POSITIVE','REPLACEMENT'))
      order by event.id
    loop
      v_nhsp_negative:=private.weekly_source_nhsp_negative_population_v1(v_upload.id,v_event.id,p_actor_user_id,v_cycle.id);
      v_nhsp_basis:=v_nhsp_negative->'native_current_basis';
      v_payment:=v_nhsp_basis->'native_payment_facts';
      if v_nhsp_basis->>'state'='NATIVE_POSITION_INPUTS' and not exists(
        select 1 from jsonb_array_elements(v_nhsp_basis->'native_current_rows') n
        where n#>'{native_current_event,source_present}'='true'::jsonb) then continue;end if;
      v_nhsp_position:=jsonb_build_object('schema_version','WEEKLY_SOURCE_NHSP_CURRENT_OVERLAP_POSITION_INPUT_V1',
        'state','UNAVAILABLE','reason','NATIVE_CURRENT_POSITION_UNAVAILABLE','work_event_id',v_event.id);
      v_nhsp_contract:=null;v_nhsp_start:=null;v_nhsp_end:=null;v_nhsp_break:=null;
      if v_nhsp_negative->'current_position_available'='true'::jsonb
        and jsonb_array_length(v_nhsp_negative->'current_targets')=1 then
        v_nhsp_target:=v_nhsp_negative#>'{current_targets,0}';
        select * into strict v_movement from public.weekly_source_billing_movements m
          where m.id=(v_nhsp_target->>'movement_id')::uuid and m.work_event_id=v_event.id
            and m.movement_economic_hash=decode(v_nhsp_target->>'movement_economic_hash','hex');
        select physical.* into strict v_nhsp_source_row from public.weekly_source_upload_rows physical
          join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=physical.id
          where resolution.id=(v_movement.source_facts_json->>'row_resolution_id')::uuid
            and resolution.work_event_id=v_event.id and resolution.contract_id=v_movement.contract_id;
        if v_nhsp_source_row.start_at_local is null or v_nhsp_source_row.end_at_local is null
          or v_nhsp_source_row.start_at_local>=v_nhsp_source_row.end_at_local then
          raise exception 'WEEKLY_SOURCE_NHSP_PAID_OVERLAP_CLOCK_UNBOUND' using errcode='55000';end if;
        if v_nhsp_source_row.start_at_local>=v_row.end_at_local or v_nhsp_source_row.end_at_local<=v_row.start_at_local then continue;end if;
        v_nhsp_contract:=v_movement.contract_id;v_nhsp_start:=v_nhsp_source_row.start_at_local;
        v_nhsp_end:=v_nhsp_source_row.end_at_local;v_nhsp_break:=v_nhsp_source_row.break_minutes;
        v_nhsp_position:=jsonb_build_object('schema_version','WEEKLY_SOURCE_NHSP_CURRENT_OVERLAP_POSITION_INPUT_V1',
          'state','CURRENT_NATIVE_POSITION','reason',null,'work_event_id',v_event.id,
          'candidate_id',p_candidate_id,'client_id',p_client_id,'contract_id',v_movement.contract_id,
          'movement_id',v_movement.id,'movement_economic_hash',encode(v_movement.movement_economic_hash,'hex'),
          'native_current_target',v_nhsp_target,'native_current_basis_sha256',v_nhsp_basis->'inputs_sha256');
      elsif not private.weekly_source_work_event_schedule_compatible_v1(v_event.id,v_row.start_at_local,v_row.end_at_local) then
        continue;
      end if;
      -- An unavailable native current position stays an explicit unknown in
      -- the complete overlap population. Historical clocks never certify it.
      v_items:=v_items||jsonb_build_array(jsonb_build_object('work_event_id',v_event.id,
        'candidate_id',v_event.candidate_id,'client_id',v_event.client_id,'contract_id',v_nhsp_contract,
        'work_date',v_event.work_date,'start_at_local',v_nhsp_start,'end_at_local',v_nhsp_end,'break_minutes',v_nhsp_break,
        'current_native_position',v_nhsp_position,'nhsp_negative_population',v_nhsp_negative,'native_payment_facts',v_payment));
    end loop;
  else
  if v_upload.report_scope_id is not null or v_upload.purpose not in ('ORDINARY','FINAL_SOURCE_CORRECTION')
    or not exists(select 1 from public.weekly_source_groups g
      where g.id=v_cycle.source_group_id and g.active and g.source_family='ROSTER')
    or not exists(select 1 from public.weekly_source_format_profiles p
      where p.id=v_upload.source_format_profile_id and p.active and p.profile_code in
      ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1','ROSTER_WEEKLY_SUMMARY_ACTUAL_V1'))
    or v_row.row_finalisation_state<>'SOURCE_WORKED' or v_row.start_at_local is null or v_row.end_at_local is null
    or v_row.end_at_local<=v_row.start_at_local or coalesce(v_row.actual_net_minutes,0)<=0 then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_SOURCE_SCOPE_INVALID' using errcode='22023';end if;
  if not exists(select 1 from public.candidates c where c.id=p_candidate_id and c.active)
    or not private.weekly_source_upload_client_eligible_v1(v_upload.id,p_client_id,v_row.work_date)
    or (v_cycle.scope_client_id is not null and v_cycle.scope_client_id<>p_client_id) then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_IDENTITY_NOT_ELIGIBLE' using errcode='22023';end if;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
    v_cycle.source_group_id,p_client_id,v_cycle.finalisation_week_ending);
  for v_event in select event.* from public.weekly_work_events event
    where event.first_source_group_id=v_cycle.source_group_id
      and event.source_format_profile_id=v_upload.source_format_profile_id
      and event.identity_kind='PROFILE_EXTERNAL_KEY' and event.candidate_id=p_candidate_id
      and event.client_id=p_client_id and event.work_date=v_row.work_date
    order by event.id
  loop
    v_payment:=private.weekly_source_work_event_payment_facts_v1(v_event.id,p_actor_user_id,v_cycle.id);
    -- A retained settlement is not a live positive. This exact current native
    -- movement must be present before a clock overlap can be supplied.
    if v_payment->>'current_pay_head_movement_id' is null then continue;end if;
    select movement.* into strict v_movement from public.weekly_source_billing_movements movement
      join public.weekly_source_final_revisions revision on revision.id=movement.final_revision_id
      join public.weekly_source_cycles cycle on cycle.id=revision.source_cycle_id
      where movement.id=(v_payment->>'current_pay_head_movement_id')::uuid
        and movement.work_event_id=v_event.id and movement.candidate_id=p_candidate_id
        and movement.actual_client_id=p_client_id and movement.movement_role in ('POSITIVE','REPLACEMENT')
        and movement.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION')
        and revision.state='CURRENT' and revision.authority_scope_kind='CYCLE' and revision.report_scope_id is null
        and cycle.source_group_id=v_cycle.source_group_id;
    v_current_snapshot:=private.weekly_source_paid_overlap_current_snapshot_for_cycle_v1(v_event.id,v_movement.id,
      p_candidate_id,p_client_id,v_movement.contract_id,v_cycle.source_group_id,
      array(select value::uuid from jsonb_array_elements_text(v_payment->'root_timesheet_ids') value),v_cycle.id);
    if v_current_snapshot->>'state'='CURRENT' then
      select snapshot.* into strict v_snapshot from public.weekly_source_final_snapshot_lines snapshot
        where snapshot.id=(v_current_snapshot->>'snapshot_line_id')::uuid and snapshot.work_event_id=v_event.id
          and snapshot.candidate_id=p_candidate_id and snapshot.client_id=p_client_id
          and snapshot.contract_id=v_movement.contract_id and snapshot.work_date=v_row.work_date;
    else
      -- Retain a factual unknown/legacy overlap rather than erasing it. Its
      -- original tuple never authorises Same/Separate without CURRENT proof.
      select snapshot.* into strict v_snapshot from public.weekly_source_final_snapshot_lines snapshot
        join public.weekly_source_state_transitions transition on transition.new_snapshot_line_id=snapshot.id
        where transition.id=v_movement.transition_id and transition.final_revision_id=v_movement.final_revision_id
          and snapshot.final_revision_id=v_movement.final_revision_id and snapshot.work_event_id=v_event.id
          and snapshot.candidate_id=p_candidate_id and snapshot.client_id=p_client_id
          and snapshot.contract_id=v_movement.contract_id and snapshot.work_date=v_row.work_date;
    end if;
    if v_snapshot.start_at_local>=v_row.end_at_local or v_snapshot.end_at_local<=v_row.start_at_local then continue;end if;
    v_items:=v_items||jsonb_build_array(jsonb_build_object('work_event_id',v_event.id,
      'candidate_id',v_event.candidate_id,'client_id',v_event.client_id,'contract_id',v_snapshot.contract_id,
      'original_profile_external_key',v_event.profile_external_key,'work_date',v_snapshot.work_date,
      'start_at_local',v_snapshot.start_at_local,'end_at_local',v_snapshot.end_at_local,'break_minutes',v_snapshot.break_minutes,
      'current_pay_head_movement_id',v_movement.id,'current_final_revision_id',v_movement.final_revision_id,
      'movement_economic_hash',encode(v_movement.movement_economic_hash,'hex'),
      'snapshot_line_id',v_snapshot.id,'snapshot_line_hash',encode(v_snapshot.snapshot_line_hash,'hex'),
      'current_pay_snapshot',v_current_snapshot,'native_payment_facts',v_payment));
  end loop;
  end if;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_OVERLAP_INPUTS_V1',
    'upload_row_id',v_row.id,'upload_id',v_upload.id,'source_cycle_id',v_cycle.id,
    'source_group_id',v_cycle.source_group_id,'source_format_profile_id',v_upload.source_format_profile_id,
    'normalised_row_hash',encode(v_row.normalised_row_hash,'hex'),
    'row_manifest_hash',encode(v_upload.row_manifest_hash,'hex'),'actor_user_id',p_actor_user_id,
    'candidate_id',p_candidate_id,'client_id',p_client_id,'overlaps',v_items);
  if v_upload.purpose='FINAL_SOURCE_CORRECTION' then
    v_result:=v_result||jsonb_build_object('correction_scope',
      private.weekly_source_paid_match_correction_scope_v1(v_upload.id,p_actor_user_id,false));
  end if;
  return v_result||jsonb_build_object('inputs_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_PAID_OVERLAP_INPUTS_V1',v_result),'hex'));
end;
$function$;

create or replace function private.weekly_source_paid_overlap_choice_admit_v1(p_request jsonb,p_discovery jsonb default null)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_actor uuid;v_request uuid;v_row_id uuid;v_candidate uuid;v_client uuid;v_contract uuid;v_target uuid;v_effect text;v_expected text;
  v_row public.weekly_source_upload_rows%rowtype;v_upload public.weekly_source_uploads%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;v_event public.weekly_work_events%rowtype;
  v_inputs jsonb;v_observed jsonb;v_item jsonb;v_match jsonb;v_roots uuid[];v_root uuid;v_lock jsonb;
  v_known uuid;v_auto uuid;v_reason text;v_native_paid jsonb;v_request_hash bytea;
begin
  if not (p_request ? 'pay_effect') then return null;end if;
  perform private.weekly_source_query_require_service_v1();
  if not p_request ?& array['actor_user_id','request_id','upload_id','upload_row_id','candidate_id','client_id',
    'contract_id','match_reason','pay_effect','paid_overlap_target_work_event_id','expected_paid_overlap_inputs_sha256']
    or jsonb_typeof(p_request->'pay_effect') is distinct from 'string'
    or jsonb_typeof(p_request->'match_reason') is distinct from 'string'
    or jsonb_typeof(p_request->'expected_paid_overlap_inputs_sha256') is distinct from 'string' then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_INVALID' using errcode='22023';end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;v_request:=(p_request->>'request_id')::uuid;v_row_id:=(p_request->>'upload_row_id')::uuid;
    v_candidate:=(p_request->>'candidate_id')::uuid;v_client:=(p_request->>'client_id')::uuid;
    v_contract:=(p_request->>'contract_id')::uuid;v_target:=(p_request->>'paid_overlap_target_work_event_id')::uuid;
  exception when invalid_text_representation then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_INVALID' using errcode='22023';end;
  v_effect:=p_request->>'pay_effect';v_expected:=p_request->>'expected_paid_overlap_inputs_sha256';
  v_reason:=btrim(p_request->>'match_reason');
  if v_actor is null or v_request is null or v_row_id is null or v_candidate is null or v_client is null or v_contract is null or v_target is null
    or v_effect not in ('NORMAL','NONE') or v_expected !~ '^[0-9a-f]{64}$' or char_length(v_reason) not between 1 and 1000
    or (v_effect='NONE' and (p_request ? 'separate_shift' or (p_request->>'work_event_id')::uuid is distinct from v_target))
    or (v_effect='NORMAL' and (p_request->'separate_shift' is distinct from 'true'::jsonb or p_request ? 'work_event_id')) then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_INVALID' using errcode='22023';end if;
  if private.weekly_source_pay_actor_allowed_v1(v_actor) is distinct from true then
    raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501';end if;
  select * into strict v_row from public.weekly_source_upload_rows where id=v_row_id;
  select * into strict v_upload from public.weekly_source_uploads where id=v_row.upload_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_upload.source_cycle_id;
  if v_upload.id is distinct from (p_request->>'upload_id')::uuid then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_INVALID' using errcode='22023';end if;
  perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',v_cycle.source_group_id,v_client,v_cycle.finalisation_week_ending);
  v_request_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFFICE_RECHECK_V1',p_request);
  if p_discovery is null then
  perform private.weekly_source_pay_query_admit_v2();
  v_inputs:=private.weekly_source_paid_overlap_candidates_v1(v_row_id,v_actor,v_candidate,v_client);
  select coalesce(array_agg(distinct value::uuid order by value::uuid),'{}'::uuid[]) into v_roots
    from jsonb_array_elements(v_inputs->'overlaps') item
    cross join lateral jsonb_array_elements_text(item#>'{native_payment_facts,root_timesheet_ids}') value;
  if cardinality(v_roots)=0 then raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_ROOT_UNAVAILABLE' using errcode='55000';end if;
  -- This is the unchanged native complete I-1/family admission used by the
  -- Source payment publication owner. It precedes every group/cycle lock.
  v_lock:=private.weekly_source_lock_and_resolve_families_v1(v_candidate,v_roots,
    'WORKBENCH_CANDIDATE_ENTITLEMENT_PUBLICATION',(p_request->>'request_id')::uuid,'WEEKLY_SOURCE_ENTITLEMENT_PUBLICATION');
  if v_lock->>'ok' is distinct from 'true' or v_lock->>'gate' is distinct from 'GRANTED' then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_SCOPE_UNAVAILABLE' using errcode='55000';end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_OVERLAP_LOCK_DISCOVERY_V1',
    'request_sha256',encode(v_request_hash,'hex'),'actor_user_id',v_actor,'source_cycle_id',v_cycle.id,
    'inputs',v_inputs,'native_root_ids',to_jsonb(v_roots),'native_lock_result',v_lock,
    'native_backend_pid',pg_backend_pid(),'native_transaction_id',pg_current_xact_id()::text);
  end if;
  -- Only the owner-generated same request/transaction frame is admitted after
  -- the caller's retained scope -> group -> cycle locks. No client flag enters.
  if p_discovery->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_LOCK_DISCOVERY_V1'
    or p_discovery->>'request_sha256' is distinct from encode(v_request_hash,'hex')
    or p_discovery->>'actor_user_id' is distinct from v_actor::text
    or p_discovery->>'source_cycle_id' is distinct from v_cycle.id::text
    or p_discovery->>'native_backend_pid' is distinct from pg_backend_pid()::text
    or p_discovery->>'native_transaction_id' is distinct from pg_current_xact_id()::text then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_LOCK_FRAME_UNBOUND' using errcode='55000';end if;
  v_inputs:=p_discovery->'inputs';v_lock:=p_discovery->'native_lock_result';
  v_roots:=array(select value::uuid from jsonb_array_elements_text(p_discovery->'native_root_ids') value);
  perform 1 from public.weekly_work_events event where event.id in
    (select (item->>'work_event_id')::uuid from jsonb_array_elements(v_inputs->'overlaps') item) order by event.id for share;
  v_observed:=private.weekly_source_paid_overlap_candidates_v1(v_row_id,v_actor,v_candidate,v_client);
  if v_observed is distinct from v_inputs or v_observed->>'inputs_sha256' is distinct from v_expected then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_FACTS_CHANGED' using errcode='40001';end if;
  select item into v_match from jsonb_array_elements(v_observed->'overlaps') item where item->>'work_event_id'=v_target::text;
  if v_match is null then raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_TARGET_NOT_ELIGIBLE' using errcode='55000';end if;
  v_native_paid:=v_match->'native_payment_facts';
  -- The existing Legacy allocation is HOURS provenance only. It does not
  -- become a new cash/write certificate. Until its true complete native seam
  -- exists, it refuses here. No paid_at/status/amount guess is substituted.
  if (case when v_match ? 'nhsp_negative_population' then
      v_match#>>'{current_native_position,schema_version}' is distinct from 'WEEKLY_SOURCE_NHSP_CURRENT_OVERLAP_POSITION_INPUT_V1'
      or v_match#>>'{current_native_position,state}' is distinct from 'CURRENT_NATIVE_POSITION'
      or v_match#>'{current_native_position,work_event_id}' is distinct from v_match->'work_event_id'
      or v_match#>'{current_native_position,contract_id}' is distinct from v_match->'contract_id'
      or v_match#>'{current_native_position,native_current_basis_sha256}' is distinct from v_match#>'{nhsp_negative_population,native_current_basis,inputs_sha256}'
      or v_match#>'{nhsp_negative_population,negative_population_complete}' is distinct from 'true'::jsonb
      or v_match#>'{nhsp_negative_population,current_position_available}' is distinct from 'true'::jsonb
      or v_match#>'{nhsp_negative_population,no_reversal_proved}' is distinct from 'true'::jsonb
      or v_match#>'{nhsp_negative_population,paid_writer_permission}' is distinct from 'null'::jsonb
      else v_match#>>'{current_pay_snapshot,state}' is distinct from 'CURRENT'
    or v_match#>>'{current_pay_snapshot,snapshot_line_id}' is distinct from v_match->>'snapshot_line_id'
    or v_match#>>'{current_pay_snapshot,movement_id}' is distinct from v_match->>'current_pay_head_movement_id' end)
    or v_native_paid->'paid' is distinct from 'true'::jsonb
    or (v_native_paid->>'paid_evidence_state') is null or (v_native_paid->>'paid_evidence_state') not in ('SETTLED_ORIGINAL','SETTLED_LEGACY_SOURCE_COMPONENT') then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_PAID_AUTHORITY_UNAVAILABLE' using errcode='55000';end if;
  if not exists(select 1 from public.contracts c where c.id=v_contract and c.candidate_id=v_candidate and c.client_id=v_client
    and v_row.work_date between c.start_date and coalesce(c.end_date,'infinity'::date))
    or (v_effect='NONE' and v_match->>'contract_id' is distinct from v_contract::text) then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CONTRACT_NOT_ELIGIBLE' using errcode='22023';end if;
  select * into strict v_event from public.weekly_work_events where id=v_target;
  if exists(select 1 from jsonb_array_elements(private.weekly_source_protected_match_candidates_v1(v_row_id,v_candidate,v_client)) item
    where item->>'work_event_id'=v_target::text) then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_PROTECTED_OWNER_REQUIRED' using errcode='55000';end if;
  if v_upload.report_scope_id is null then
  if exists(select 1 from public.weekly_work_events event where event.first_source_group_id=v_cycle.source_group_id
    and event.source_format_profile_id=v_upload.source_format_profile_id and event.identity_kind='PROFILE_EXTERNAL_KEY'
    and event.profile_external_key=v_row.external_source_key and (v_effect='NORMAL' or event.id<>v_target)) then
    raise exception 'WEEKLY_SOURCE_PROFILE_EVENT_KEY_CONFLICT' using errcode='55000';end if;
  v_known:=private.weekly_source_known_source_key_v1(v_row_id,v_candidate,v_client);
  if v_known is not null and (v_effect='NORMAL' or v_known<>v_target) then
    raise exception 'WEEKLY_SOURCE_PROFILE_EVENT_KEY_CONFLICT' using errcode='55000';end if;
  v_auto:=private.weekly_source_identical_rekey_prior_v1(v_row_id);
  if v_auto is not null then raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_AUTOMATIC_REKEY' using errcode='55000';end if;
  end if;
  v_request_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFFICE_RECHECK_V1',p_request);
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_ADMISSION_V1',
    'upload_row_id',v_row.id,'upload_id',v_upload.id,'source_cycle_id',v_cycle.id,'source_group_id',v_cycle.source_group_id,
    'candidate_id',v_candidate,'client_id',v_client,'contract_id',v_contract,'actor_user_id',v_actor,
    'request_id',p_request->>'request_id','request_sha256',encode(v_request_hash,'hex'),
    'paid_overlap_target_work_event_id',v_target,'pay_effect',v_effect,'reason',v_reason,
    'inputs',v_observed,'inputs_sha256',v_expected,'native_root_ids',to_jsonb(v_roots),
    'native_lock_result',v_lock,'native_backend_pid',pg_backend_pid(),'native_transaction_id',pg_current_xact_id()::text);
end;
$function$;

create or replace function public.weekly_source_office_recheck_begin_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_actor uuid;
  v_request_id uuid;
  v_hash bytea;
  v_upload public.weekly_source_uploads%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_scope public.weekly_source_report_scopes%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_prior private.weekly_source_office_rechecks%rowtype;
  v_row public.weekly_source_upload_rows%rowtype;
  v_choice private.weekly_source_office_row_choices%rowtype;
  v_resolution public.weekly_source_row_resolutions%rowtype;
  v_candidate uuid;
  v_client uuid;
  v_contract uuid;
  v_work_event uuid;
  v_match_reason text;
  v_separate_shift boolean:=false;
  v_version bigint;
  v_current_publication uuid;
  v_current_upload uuid;
  v_begin jsonb;v_paid_discovery jsonb;v_paid_choice jsonb;
  v_correction public.weekly_final_source_correction_sessions%rowtype;v_correct boolean:=false;
begin
  perform private.weekly_source_query_require_service_v1();
  perform pg_catalog.set_config('lock_timeout','5s',true);
  if p_request is null or pg_catalog.jsonb_typeof(p_request)<>'object'
    or exists(select 1 from pg_catalog.jsonb_object_keys(p_request) key where key not in
      ('actor_user_id','request_id','upload_id','projection_publication_id',
       'expected_authority_scope_version','expected_row_manifest_hash','upload_row_id',
       'candidate_id','client_id','contract_id','work_event_id','match_reason','separate_shift',
       'pay_effect','paid_overlap_target_work_event_id','expected_paid_overlap_inputs_sha256',
       'correction_session_id','expected_correction_session_version','expected_comparison_manifest_hash','expected_issue_set_hash'))
    or ((p_request ?| array['paid_overlap_target_work_event_id','expected_paid_overlap_inputs_sha256']) and not (p_request ? 'pay_effect')) then
    raise exception 'WEEKLY_SOURCE_RECHECK_REQUEST_INVALID' using errcode='22023';
  end if;
  v_actor:=(p_request->>'actor_user_id')::uuid;
  v_request_id:=(p_request->>'request_id')::uuid;
  if v_actor is null or v_request_id is null then
    raise exception 'WEEKLY_SOURCE_RECHECK_REQUEST_INVALID' using errcode='22023';
  end if;
  v_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFFICE_RECHECK_V1',p_request);
  select * into strict v_upload from public.weekly_source_uploads where id=(p_request->>'upload_id')::uuid;
  v_correct:=v_upload.purpose='FINAL_SOURCE_CORRECTION';
  if v_correct then
    if not p_request ?& array['pay_effect','correction_session_id','expected_correction_session_version',
      'expected_comparison_manifest_hash','expected_issue_set_hash']
      or (p_request->>'correction_session_id')::uuid is distinct from v_upload.correction_session_id then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_REQUEST_INVALID' using errcode='22023';end if;
    perform private.weekly_source_paid_match_correction_scope_v1(v_upload.id,v_actor,false);
  elsif p_request ?| array['correction_session_id','expected_correction_session_version',
    'expected_comparison_manifest_hash','expected_issue_set_hash'] then
    raise exception 'WEEKLY_SOURCE_RECHECK_REQUEST_INVALID' using errcode='22023';
  end if;
  -- Existing exact historical replay keeps the original result and native
  -- publication checks; current payment authority still precedes that read.
  if p_request ? 'pay_effect' and exists(select 1 from private.weekly_source_office_rechecks prior where prior.request_id=v_request_id) then
    if private.weekly_source_pay_actor_allowed_v1(v_actor) is distinct from true then
      raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501';end if;
    perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',
      (select source_group_id from public.weekly_source_cycles where id=v_upload.source_cycle_id),
      (p_request->>'client_id')::uuid,(select finalisation_week_ending from public.weekly_source_cycles where id=v_upload.source_cycle_id));
  else
    -- Native complete I-1 precedes the original scope gate. No business row
    -- or group/cycle lock is taken by this discovery phase.
    v_paid_discovery:=private.weekly_source_paid_overlap_choice_admit_v1(p_request);
  end if;
  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended(
    pg_catalog.encode(v_upload.declared_scope_fingerprint,'hex'),73241837));
  if v_paid_discovery is not null then
    perform 1 from public.weekly_source_groups where id=(v_paid_discovery#>>'{inputs,source_group_id}')::uuid for update;
  end if;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_upload.source_cycle_id for update;
  select * into strict v_upload from public.weekly_source_uploads where id=v_upload.id;
  if v_correct then
    select * into strict v_correction from public.weekly_final_source_correction_sessions
      where id=v_upload.correction_session_id for update;
    perform private.weekly_source_paid_match_correction_scope_v1(v_upload.id,v_actor,false);
    if v_upload.report_scope_id is null then v_version:=v_cycle.version;
    else
      select * into strict v_scope from public.weekly_source_report_scopes where id=v_upload.report_scope_id for update;
      v_version:=v_scope.version;
    end if;
    v_current_upload:=v_upload.id;
    v_current_publication:=v_correction.replacement_projection_publication_id;
  elsif v_upload.report_scope_id is null then
    v_version:=v_cycle.version; v_current_upload:=v_cycle.current_complete_upload_id;
    v_current_publication:=v_cycle.current_projection_publication_id;
  else
    select * into strict v_scope from public.weekly_source_report_scopes where id=v_upload.report_scope_id for update;
    v_version:=v_scope.version; v_current_upload:=v_scope.current_complete_upload_id;
    v_current_publication:=v_scope.current_projection_publication_id;
  end if;
  perform private.weekly_source_office_authority_v1(v_actor,'RECHECK_SOURCE',v_cycle.source_group_id,
    coalesce(v_scope.client_id,nullif(v_upload.file_metadata_json->>'client_id','')::uuid),v_cycle.finalisation_week_ending);
  if not v_correct and (v_upload.purpose<>'ORDINARY' or v_upload.state<>'CURRENT'
    or v_current_upload is distinct from v_upload.id or v_cycle.state in ('FINALISING','FINALISED')
    or v_scope.state in ('FINALISING','FINALISED')) then
    raise exception 'WEEKLY_SOURCE_RECHECK_NOT_CURRENT' using errcode='55000';
  end if;
  select * into v_prior from private.weekly_source_office_rechecks where request_id=v_request_id;
  if found then
    if v_prior.request_hash is distinct from v_hash or v_prior.actor_user_id<>v_actor then
      raise exception 'WEEKLY_SOURCE_RECHECK_REPLAY_CONFLICT' using errcode='23505';
    end if;
    select * into strict v_publication from public.weekly_source_projection_publications where id=v_prior.publication_id;
    if v_publication.authority_scope_version<>v_version
      or (not v_correct and v_publication.state not in ('BUILDING','CURRENT'))
      or (v_correct and (v_publication.state not in ('BUILDING','CORRECTION_READY')
        or v_publication.correction_session_id is distinct from v_correction.id
        or (v_publication.state='CORRECTION_READY' and v_correction.replacement_projection_publication_id is distinct from v_publication.id))) then
      raise exception 'WEEKLY_SOURCE_RECHECK_NOT_CURRENT' using errcode='55000';
    end if;
    return pg_catalog.jsonb_build_object('ok',true,'status',v_publication.state,
      'publication_id',v_publication.id,'upload_id',v_upload.id,'authority_scope_version',v_version,'idempotent',true)
      ||case when not v_correct then '{}'::jsonb else jsonb_build_object('purpose','FINAL_SOURCE_CORRECTION',
        'correction_session_id',v_correction.id,'ready_session_version',v_publication.ready_session_version,
        'comparison_manifest_hash',encode(v_publication.comparison_manifest_hash,'hex'),
        'issue_set_hash',encode(v_publication.issue_set_hash,'hex'),
        'correction_review_identity',jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_MATCH_CORRECTION_RECHECK_CONTEXT_V1',
          'correction_session_id',v_correction.id,'source_cycle_id',v_cycle.id,
          'expected_current_final_revision_id',v_correction.expected_current_final_revision_id,
          'expected_final_manifest_hash',encode(v_correction.expected_final_manifest_hash,'hex'))) end;
  end if;
  if v_correct then
    perform private.weekly_source_paid_match_correction_scope_v1(v_upload.id,v_actor,true);
    if v_correction.version is distinct from (p_request->>'expected_correction_session_version')::bigint then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
  end if;
  if v_version is distinct from (p_request->>'expected_authority_scope_version')::bigint
    or v_current_publication is distinct from (p_request->>'projection_publication_id')::uuid
    or v_upload.row_manifest_hash is distinct from private.weekly_source_hex32_v1(
      p_request->>'expected_row_manifest_hash','WEEKLY_SOURCE_ROW_MANIFEST_HASH_REQUIRED') then
    raise exception 'WEEKLY_SOURCE_PREVIEW_STALE' using errcode='40001';
  end if;
  select * into strict v_publication from public.weekly_source_projection_publications where id=v_current_publication for update;
  if v_publication.upload_id<>v_upload.id
    or (not v_correct and v_publication.state<>'CURRENT')
    or (v_correct and (v_publication.state<>'CORRECTION_READY'
      or v_publication.correction_session_id is distinct from v_correction.id
      or v_publication.comparison_manifest_hash is distinct from private.weekly_source_hex32_v1(
        p_request->>'expected_comparison_manifest_hash','WEEKLY_SOURCE_COMPARISON_MANIFEST_HASH_INVALID')
      or v_publication.issue_set_hash is distinct from private.weekly_source_hex32_v1(
        p_request->>'expected_issue_set_hash','WEEKLY_SOURCE_ISSUE_SET_HASH_INVALID'))) then
    raise exception 'WEEKLY_SOURCE_PREVIEW_STALE' using errcode='40001';
  end if;
  if p_request ?| array['candidate_id','client_id','contract_id','work_event_id','separate_shift'] then
    select * into strict v_row from public.weekly_source_upload_rows
      where id=(p_request->>'upload_row_id')::uuid and upload_id=v_upload.id;
    select * into v_choice from private.weekly_source_office_row_choices
      where upload_row_id=v_row.id order by id desc limit 1;
    select * into v_resolution from public.weekly_source_row_resolutions
      where upload_row_id=v_row.id order by generation desc,id desc limit 1;
    v_candidate:=coalesce((p_request->>'candidate_id')::uuid,v_choice.candidate_id,v_resolution.candidate_id);
    v_client:=coalesce((p_request->>'client_id')::uuid,v_choice.client_id,v_resolution.client_id);
    v_contract:=case when p_request ? 'contract_id' then (p_request->>'contract_id')::uuid
      when p_request ?| array['candidate_id','client_id'] then null else v_choice.contract_id end;
    if v_candidate is not null and not exists(select 1 from public.candidates where id=v_candidate and active) then
      raise exception 'WEEKLY_SOURCE_CANDIDATE_INACTIVE_OR_MISSING' using errcode='22023';
    end if;
    if v_client is not null and not private.weekly_source_upload_client_eligible_v1(
      v_upload.id,v_client,v_row.work_date) then
      raise exception 'WEEKLY_SOURCE_CLIENT_NOT_ELIGIBLE' using errcode='22023';
    end if;
    if v_scope.client_id is not null and v_client is distinct from v_scope.client_id then
      raise exception 'WEEKLY_SOURCE_CLIENT_NOT_ELIGIBLE' using errcode='22023';
    end if;
    if v_contract is not null and not exists(select 1 from public.contracts
      where id=v_contract and candidate_id=v_candidate and client_id=v_client
        and v_row.work_date between start_date and coalesce(end_date,'infinity'::date)) then
      raise exception 'WEEKLY_SOURCE_CONTRACT_NOT_ELIGIBLE' using errcode='22023';
    end if;
    if v_paid_discovery is not null then
      v_paid_choice:=private.weekly_source_paid_overlap_choice_admit_v1(p_request,v_paid_discovery);
    end if;
    if v_paid_choice is not null then
      if v_paid_choice->>'candidate_id' is distinct from v_candidate::text
        or v_paid_choice->>'client_id' is distinct from v_client::text
        or v_paid_choice->>'contract_id' is distinct from v_contract::text
        or v_paid_choice->>'upload_row_id' is distinct from v_row.id::text then
        raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_SCOPE_CHANGED' using errcode='40001';end if;
      v_work_event:=case when v_paid_choice->>'pay_effect'='NONE'
        then (v_paid_choice->>'paid_overlap_target_work_event_id')::uuid else null end;
      v_separate_shift:=v_paid_choice->>'pay_effect'='NORMAL';
      v_match_reason:=v_paid_choice->>'reason';
      if exists(select 1 from public.weekly_source_row_resolutions old_resolution
        where old_resolution.upload_row_id=v_row.id and (exists(
          select 1 from public.weekly_source_final_snapshot_lines final_line
          where final_line.row_resolution_id=old_resolution.id) or exists(
          select 1 from public.weekly_source_billing_movements movement
          where movement.source_facts_json->>'row_resolution_id'=old_resolution.id::text))) then
        raise exception 'WEEKLY_SOURCE_PROTECTED_MATCH_FINAL_AUTHORITY_CONFLICT' using errcode='55000';end if;
    elsif p_request ? 'separate_shift' then
      if p_request->'separate_shift'<>'true'::jsonb or p_request ? 'work_event_id' then
        raise exception 'WEEKLY_SOURCE_PROTECTED_MATCH_NOT_ELIGIBLE' using errcode='22023';
      end if;
      v_separate_shift:=true;
      v_match_reason:=btrim(p_request->>'match_reason');
      v_contract:=coalesce(v_contract,v_resolution.contract_id);
      if v_contract is null or v_match_reason is null or char_length(v_match_reason) not between 1 and 1000
        or jsonb_array_length(private.weekly_source_protected_match_candidates_v1(v_row.id,v_candidate,v_client))=0
        or exists(select 1 from public.weekly_exceptional_pay_family_events item
          where item.durable_work_event_id=v_resolution.work_event_id) then
        raise exception 'WEEKLY_SOURCE_PROTECTED_MATCH_NOT_ELIGIBLE' using errcode='22023';
      end if;
    elsif p_request ? 'work_event_id' then
      v_work_event:=(p_request->>'work_event_id')::uuid;
      v_match_reason:=btrim(p_request->>'match_reason');
      if v_work_event is null or v_match_reason is null or char_length(v_match_reason) not between 1 and 1000
        or not exists(select 1 from jsonb_array_elements(
          private.weekly_source_protected_match_candidates_v1(v_row.id,v_candidate,v_client)) choice
          where choice->>'work_event_id'=v_work_event::text
            and choice->>'contract_id'=coalesce(v_contract,v_resolution.contract_id)::text) then
        raise exception 'WEEKLY_SOURCE_PROTECTED_MATCH_NOT_ELIGIBLE' using errcode='22023';
      end if;
      v_contract:=coalesce(v_contract,v_resolution.contract_id);
      -- A source identity already included in final authority cannot be moved
      -- to another payable identity by this pre-finalisation choice.
      if exists(select 1 from public.weekly_source_row_resolutions old_resolution
        where old_resolution.upload_row_id=v_row.id and old_resolution.work_event_id<>v_work_event
          and (exists(select 1 from public.weekly_source_final_snapshot_lines final_line
            where final_line.work_event_id=old_resolution.work_event_id)
            or exists(select 1 from public.weekly_source_billing_movements movement
              where movement.work_event_id=old_resolution.work_event_id))) then
        raise exception 'WEEKLY_SOURCE_PROTECTED_MATCH_FINAL_AUTHORITY_CONFLICT' using errcode='55000';
      end if;
    elsif not (p_request ?| array['candidate_id','client_id','contract_id']) then
      v_work_event:=v_choice.work_event_id; v_match_reason:=v_choice.match_reason;
    end if;
    insert into private.weekly_source_office_row_choices(upload_row_id,candidate_id,client_id,contract_id,actor_user_id,work_event_id,match_reason,separate_shift,
      pay_effect,paid_overlap_target_work_event_id,paid_overlap_inputs_json,paid_overlap_inputs_sha256)
      values(v_row.id,v_candidate,v_client,v_contract,v_actor,v_work_event,v_match_reason,v_separate_shift,
        coalesce(v_paid_choice->>'pay_effect','NORMAL'),(v_paid_choice->>'paid_overlap_target_work_event_id')::uuid,
        v_paid_choice,case when v_paid_choice is null then null else decode(v_paid_choice->>'inputs_sha256','hex') end)
      returning * into v_choice;
    if v_paid_choice is not null then
      perform public._audit_insert('weekly_source_office_row_choices',v_choice.id::text,
        'WEEKLY_SOURCE_PAID_SHIFT_MATCH_CONFIRMED',null,
        jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_SHIFT_MATCH_CONFIRMATION_V1',
          'choice',to_jsonb(v_choice),'request',p_request,'request_sha256',encode(v_hash,'hex'),
          'admission',v_paid_choice,'actor_user_id',v_actor),v_match_reason,v_actor);
    end if;
  elsif p_request ? 'upload_row_id' then
    raise exception 'WEEKLY_SOURCE_RECHECK_REQUEST_INVALID' using errcode='22023';
  end if;
  if v_correct then
    -- Existing native rebuild derives its own next generation, owns session
    -- CAS/review invalidation, and leaves the actual CURRENT cycle heads alone.
    v_begin:=public.weekly_source_projection_begin_atomic_v1(jsonb_build_object(
      'actor_user_id',v_actor,'upload_id',v_upload.id,'expected_authority_scope_version',v_version,
      'correction_session_id',v_correction.id,'expected_correction_session_version',v_correction.version,
      'expected_projection_publication_id',v_publication.id,
      'expected_row_manifest_hash',encode(v_upload.row_manifest_hash,'hex'),
      'expected_comparison_manifest_hash',encode(v_publication.comparison_manifest_hash,'hex'),
      'expected_issue_set_hash',encode(v_publication.issue_set_hash,'hex'),
      'rebuild_idempotency_key',v_request_id::text));
    if v_begin->>'status' is distinct from 'BUILDING'
      or v_begin->>'publication_id' is not distinct from v_publication.id::text then
      raise exception 'WEEKLY_SOURCE_RECHECK_BEGIN_FAILED' using errcode='55000';end if;
    insert into private.weekly_source_office_rechecks(request_id,actor_user_id,upload_id,prior_publication_id,publication_id,request_hash,request_json)
      values(v_request_id,v_actor,v_upload.id,v_publication.id,(v_begin->>'publication_id')::uuid,v_hash,p_request);
    return v_begin||jsonb_build_object('purpose','FINAL_SOURCE_CORRECTION','correction_session_id',v_correction.id,
      'correction_review_identity',jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_MATCH_CORRECTION_RECHECK_CONTEXT_V1',
          'correction_session_id',v_correction.id,'source_cycle_id',v_cycle.id,
          'expected_current_final_revision_id',v_correction.expected_current_final_revision_id,
          'expected_final_manifest_hash',encode(v_correction.expected_final_manifest_hash,'hex')));
  end if;
  update public.weekly_source_projection_publications set state='STALE' where id=v_publication.id;
  if v_upload.report_scope_id is null then
    update public.weekly_source_cycles set version=version+1,projection_state='REBUILDING',current_projection_publication_id=null
      where id=v_cycle.id returning version into v_version;
  else
    update public.weekly_source_report_scopes set version=version+1,projection_state='REBUILDING',current_projection_publication_id=null,
      updated_at_utc=pg_catalog.transaction_timestamp() where id=v_scope.id returning version into v_version;
  end if;
  v_begin:=public.weekly_source_projection_begin_atomic_v1(pg_catalog.jsonb_build_object(
    'actor_user_id',v_actor,'upload_id',v_upload.id,'expected_authority_scope_version',v_version));
  if v_begin->>'status'<>'BUILDING' then
    raise exception 'WEEKLY_SOURCE_RECHECK_BEGIN_FAILED' using errcode='55000';
  end if;
  -- This is a new comparison of an existing immutable upload, not its first
  -- publication. Keep earlier resolutions as history and explicitly identify
  -- the new generation; the publisher must census this generation only.
  if v_version>2147483647 then
    raise exception 'WEEKLY_SOURCE_PROJECTION_GENERATION_OVERFLOW' using errcode='22003';
  end if;
  update public.weekly_source_projection_publications
    set projection_generation=v_version::integer
    where id=(v_begin->>'publication_id')::uuid and state='BUILDING';
  v_begin:=v_begin||pg_catalog.jsonb_build_object('projection_generation',v_version::integer);
  insert into private.weekly_source_office_rechecks(request_id,actor_user_id,upload_id,prior_publication_id,publication_id,request_hash,request_json)
    values(v_request_id,v_actor,v_upload.id,v_publication.id,(v_begin->>'publication_id')::uuid,v_hash,p_request);
  return v_begin;
end;
$function$;

create or replace function private.weekly_source_paid_overlap_choice_current_v1(
  p_upload_row_id uuid,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_choice private.weekly_source_office_row_choices%rowtype;
  v_journal private.weekly_source_office_rechecks%rowtype;
  v_audit public.audit_events%rowtype;v_count integer;
  v_saved jsonb;v_observed jsonb;v_match jsonb;v_result jsonb;v_recorded jsonb;v_immutable jsonb;
  v_revision public.weekly_source_final_revisions%rowtype;v_cycle public.weekly_source_cycles%rowtype;
  v_compare_side integer;v_compare_actor uuid;
  v_compare_inputs jsonb;v_compare_item jsonb;v_compare_basis jsonb;v_compare_bases jsonb;
  v_compare_overlaps jsonb;v_compare_observed jsonb;v_compare_saved jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_actor_user_id is null then raise exception 'WEEKLY_SOURCE_ACTOR_REQUIRED' using errcode='42501';end if;
  v_immutable:=private.weekly_source_paid_choice_immutable_v1(p_upload_row_id);
  if v_immutable is null then return null;end if;
  v_choice:=pg_catalog.jsonb_populate_record(null::private.weekly_source_office_row_choices,v_immutable->'choice');
  v_journal:=pg_catalog.jsonb_populate_record(null::private.weekly_source_office_rechecks,v_immutable->'journal');
  v_saved:=v_immutable->'admission';
  select revision.* into v_revision from public.weekly_source_final_revisions revision
    join public.weekly_source_cycles cycle on cycle.id=revision.source_cycle_id
    join public.weekly_source_uploads upload on upload.id=revision.upload_id and upload.source_cycle_id=cycle.id
    join public.weekly_source_upload_rows source_row on source_row.upload_id=upload.id
    left join public.weekly_source_report_scopes scope on scope.id=upload.report_scope_id
      and scope.source_cycle_id=cycle.id and scope.source_group_id=cycle.source_group_id
    where source_row.id=p_upload_row_id and revision.state='CURRENT'
      and ((revision.authority_scope_kind='CYCLE' and revision.report_scope_id is null
          and upload.report_scope_id is null and cycle.current_final_revision_id=revision.id)
        or (revision.authority_scope_kind='NHSP_REPORT_SCOPE' and scope.self_bill_report_id is null
          and revision.report_scope_id=scope.id and scope.current_final_revision_id=revision.id
          and exists(select 1 from public.weekly_source_format_profiles profile
            where profile.id=upload.source_format_profile_id and profile.profile_code='NHSP_FINAL_BACKING_V1')));
  if found then
    select * into strict v_cycle from public.weekly_source_cycles where id=v_revision.source_cycle_id;
    perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
      v_cycle.source_group_id,v_choice.client_id,v_cycle.finalisation_week_ending);
    v_recorded:=v_revision.paid_overlap_choice_census->p_upload_row_id::text;
    if v_recorded->>'choice_id' is distinct from v_choice.id::text
      or v_recorded->>'choice_proof_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1',v_recorded-'choice_proof_sha256'),'hex') then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_FINAL_CENSUS_UNBOUND' using errcode='55000';end if;
    -- Actual finalisation, capture and invoice admission may change current
    -- header/binding facts. This is its original recorded confirmation only;
    -- it is never accepted as fresh projection/finalisation admission.
    v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_OVERLAP_RECORDED_CHOICE_V1',
      'choice_id',v_choice.id,'upload_row_id',v_choice.upload_row_id,'candidate_id',v_choice.candidate_id,
      'client_id',v_choice.client_id,'contract_id',v_choice.contract_id,'pay_effect',v_choice.pay_effect,
      'paid_overlap_target_work_event_id',v_choice.paid_overlap_target_work_event_id,
      'confirmed_by_actor_user_id',v_choice.actor_user_id,'viewer_actor_user_id',p_actor_user_id,
      'recorded_final_revision_id',v_revision.id,'recorded_choice_proof',v_recorded,
      'confirmation_request_id',v_journal.request_id,'reason',v_choice.match_reason,'recorded_only',true);
    return v_result||jsonb_build_object('recorded_choice_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PAID_OVERLAP_RECORDED_CHOICE_V1',v_result),'hex'));
  end if;
  v_observed:=private.weekly_source_paid_overlap_candidates_v1(p_upload_row_id,p_actor_user_id,
    v_choice.candidate_id,v_choice.client_id);
  -- Validate both complete raw reader proofs before comparing facts. The
  -- immutable confirmation keeps its original actor; current native facts are
  -- read under this viewer's independently proved authority, never that actor.
  -- Only the two literal actor-bound fields of the existing Legacy INPUT
  -- producer are omitted for equality. Its whole native financial/member
  -- payload, unknown fields and every NEXT page remain byte-for-byte JSONB
  -- facts. This is not a recursive actor/key scrub or a new paid classifier.
  for v_compare_side in 0..1 loop
    v_compare_inputs:=case when v_compare_side=0 then v_observed else v_saved->'inputs' end;
    v_compare_actor:=case when v_compare_side=0 then p_actor_user_id else v_choice.actor_user_id end;
    if jsonb_typeof(v_compare_inputs) is distinct from 'object'
      or v_compare_inputs->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_INPUTS_V1'
      or v_compare_inputs->>'actor_user_id' is distinct from v_compare_actor::text
      or jsonb_typeof(v_compare_inputs->'overlaps') is distinct from 'array'
      or v_compare_inputs->>'inputs_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_PAID_OVERLAP_INPUTS_V1',v_compare_inputs-'inputs_sha256'),'hex') then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_UNBOUND' using errcode='55000';end if;
    v_compare_overlaps:='[]'::jsonb;
    for v_compare_item in select value from jsonb_array_elements(v_compare_inputs->'overlaps') loop
      if v_compare_item ? 'nhsp_negative_population' then
        -- Compare only the closed rederived NHSP semantic facts locally.
        -- Both raw witnesses/audit generations remain untouched below.
        v_compare_item:=jsonb_set(v_compare_item,'{nhsp_negative_population}',
          private.weekly_source_nhsp_negative_comparison_v1(v_compare_item->'nhsp_negative_population'),false);
      end if;
      if jsonb_typeof(v_compare_item#>'{native_payment_facts,native_paid_basis}') is distinct from 'array' then
        raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_UNBOUND' using errcode='55000';end if;
      v_compare_bases:='[]'::jsonb;
      for v_compare_basis in select value from jsonb_array_elements(v_compare_item#>'{native_payment_facts,native_paid_basis}') loop
        if v_compare_basis->>'schema_version'='WEEKLY_SOURCE_LEGACY_SIGNED_SOURCE_MEMBERSHIP_INPUT_V1' then
          if v_compare_basis->>'actor_user_id' is distinct from v_compare_actor::text
            or v_compare_basis->>'inputs_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
              'WEEKLY_SOURCE_LEGACY_SIGNED_SOURCE_MEMBERSHIP_INPUT_V1',v_compare_basis-'inputs_sha256'),'hex') then
            raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_UNBOUND' using errcode='55000';end if;
          v_compare_basis:=v_compare_basis-'actor_user_id'-'inputs_sha256';
        end if;
        v_compare_bases:=v_compare_bases||jsonb_build_array(v_compare_basis);
      end loop;
      v_compare_item:=jsonb_set(v_compare_item,'{native_payment_facts,native_paid_basis}',v_compare_bases,false);
      v_compare_overlaps:=v_compare_overlaps||jsonb_build_array(v_compare_item);
    end loop;
    v_compare_inputs:=jsonb_set(v_compare_inputs,'{overlaps}',v_compare_overlaps,false)-'actor_user_id'-'inputs_sha256';
    if v_compare_side=0 then v_compare_observed:=v_compare_inputs;else v_compare_saved:=v_compare_inputs;end if;
  end loop;
  if v_compare_observed is distinct from v_compare_saved then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_FACTS_CHANGED' using errcode='40001';end if;
  select item into v_match from jsonb_array_elements(v_observed->'overlaps') item
    where item->>'work_event_id'=v_choice.paid_overlap_target_work_event_id::text;
  if v_match is null or (case when v_match ? 'nhsp_negative_population' then
      v_match#>>'{current_native_position,schema_version}' is distinct from 'WEEKLY_SOURCE_NHSP_CURRENT_OVERLAP_POSITION_INPUT_V1'
      or v_match#>>'{current_native_position,state}' is distinct from 'CURRENT_NATIVE_POSITION'
      or v_match#>'{current_native_position,work_event_id}' is distinct from v_match->'work_event_id'
      or v_match#>'{current_native_position,contract_id}' is distinct from v_match->'contract_id'
      or v_match#>'{current_native_position,native_current_basis_sha256}' is distinct from v_match#>'{nhsp_negative_population,native_current_basis,inputs_sha256}'
      or v_match#>'{nhsp_negative_population,negative_population_complete}' is distinct from 'true'::jsonb
      or v_match#>'{nhsp_negative_population,current_position_available}' is distinct from 'true'::jsonb
      or v_match#>'{nhsp_negative_population,no_reversal_proved}' is distinct from 'true'::jsonb
      or v_match#>'{nhsp_negative_population,paid_writer_permission}' is distinct from 'null'::jsonb
      else v_match#>>'{current_pay_snapshot,state}' is distinct from 'CURRENT'
    or v_match#>>'{current_pay_snapshot,snapshot_line_id}' is distinct from v_match->>'snapshot_line_id'
    or v_match#>>'{current_pay_snapshot,movement_id}' is distinct from v_match->>'current_pay_head_movement_id' end)
    or v_match#>'{native_payment_facts,paid}' is distinct from 'true'::jsonb
    or (v_match#>>'{native_payment_facts,paid_evidence_state}') is null or (v_match#>>'{native_payment_facts,paid_evidence_state}') not in ('SETTLED_ORIGINAL','SETTLED_LEGACY_SOURCE_COMPONENT')
    or (v_choice.pay_effect='NONE' and (v_choice.work_event_id is distinct from v_choice.paid_overlap_target_work_event_id
      or v_match->>'contract_id' is distinct from v_choice.contract_id::text))
    or (v_choice.pay_effect='NORMAL' and (not v_choice.separate_shift or v_choice.work_event_id is not null)) then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_UNBOUND' using errcode='55000';end if;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1',
    'choice_id',v_choice.id,'upload_row_id',v_choice.upload_row_id,'candidate_id',v_choice.candidate_id,
    'client_id',v_choice.client_id,'contract_id',v_choice.contract_id,'pay_effect',v_choice.pay_effect,
    'paid_overlap_target_work_event_id',v_choice.paid_overlap_target_work_event_id,
    'confirmed_by_actor_user_id',v_choice.actor_user_id,'viewer_actor_user_id',p_actor_user_id,
    'confirmation_request_id',v_journal.request_id,'confirmation_request_sha256',encode(v_journal.request_hash,'hex'),
    'reason',v_choice.match_reason,'inputs',v_observed);
  return v_result||jsonb_build_object('choice_proof_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1',v_result),'hex'));
end;
$function$;

create or replace function private.weekly_source_paid_overlap_projection_lock_v1(
  p_upload_id uuid,p_actor_user_id uuid,p_publication_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_row uuid;v_choice jsonb;v_choices jsonb:='[]'::jsonb;v_candidate uuid;v_roots uuid[];v_lock jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  for v_row in select r.id from public.weekly_source_upload_rows r
    join lateral(select c.* from private.weekly_source_office_row_choices c
      where c.upload_row_id=r.id order by c.id desc limit 1) choice on true
    where r.upload_id=p_upload_id and choice.paid_overlap_target_work_event_id is not null order by r.id
  loop
    if exists(select 1 from public.weekly_source_uploads u join public.weekly_source_format_profiles p on p.id=u.source_format_profile_id
      where u.id=p_upload_id and u.report_scope_id is not null and p.profile_code='NHSP_FINAL_BACKING_V1') then
      v_choice:=private.weekly_source_nhsp_projection_lock_input_v1(v_row,p_actor_user_id,p_publication_id);
    else
    v_choice:=private.weekly_source_paid_overlap_choice_current_v1(v_row,p_actor_user_id);
    end if;
    if v_choice is null or coalesce(v_choice->>'schema_version','') not in
      ('WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1','WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_INPUT_V1') then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_CHANGED' using errcode='40001';end if;
    v_choices:=v_choices||jsonb_build_array(v_choice);
  end loop;
  if jsonb_array_length(v_choices)=0 then return '[]'::jsonb;end if;
  perform private.weekly_source_pay_query_admit_v2();
  for v_candidate in select distinct (c->>'candidate_id')::uuid from jsonb_array_elements(v_choices) c order by 1
  loop
    select array_agg(distinct root::uuid order by root::uuid) into v_roots
      from jsonb_array_elements(v_choices) c
      cross join lateral jsonb_array_elements(c#>'{inputs,overlaps}') item
      cross join lateral jsonb_array_elements_text(item#>'{native_payment_facts,root_timesheet_ids}') root
      where (c->>'candidate_id')::uuid=v_candidate;
    if coalesce(cardinality(v_roots),0)=0 then raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_ROOT_UNAVAILABLE' using errcode='55000';end if;
    v_lock:=private.weekly_source_lock_and_resolve_families_v1(v_candidate,v_roots,
      'WORKBENCH_CANDIDATE_ENTITLEMENT_PUBLICATION',p_publication_id,'WEEKLY_SOURCE_ENTITLEMENT_PUBLICATION');
    if v_lock->>'ok' is distinct from 'true' or v_lock->>'gate' is distinct from 'GRANTED' then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_SCOPE_UNAVAILABLE' using errcode='55000';end if;
  end loop;
  return v_choices;
end;
$function$;

create or replace function private.weekly_source_finalise_engine_v1(
  p_request jsonb,
  p_correction_session_id uuid,
  p_prepare_only boolean,
  p_report_vat_rounding_variant text
) returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_allowed_keys constant text[]:=array[
    'actor_user_id','source_cycle_id','authority_scope_kind','report_scope_id',
    'upload_id','projection_publication_id','expected_authority_scope_version',
    'expected_row_manifest_hash','expected_comparison_manifest_hash',
    'expected_issue_set_hash','exclude_unfinalised_acknowledged'
  ]::text[];
  v_unknown_key text;
  v_actor uuid;
  v_cycle_id uuid;
  v_scope_kind text;
  v_report_scope_id uuid;
  v_upload_id uuid;
  v_publication_id uuid;
  v_scope_version bigint;
  v_expected_row_hash bytea;
  v_expected_comparison_hash bytea;
  v_expected_issue_hash bytea;
  v_cycle public.weekly_source_cycles%rowtype;
  v_scope public.weekly_source_report_scopes%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_profile public.weekly_source_format_profiles%rowtype;
  v_existing_revision public.weekly_source_final_revisions%rowtype;
  v_correction public.weekly_final_source_correction_sessions%rowtype;
  v_guard jsonb;
  v_client_id uuid;
  v_resolved_client_id uuid;
  v_resolved_client_count integer;
  v_source_profile_kind text;
  v_source_mode text;
  v_generation integer;
  v_coverage_start date;
  v_coverage_end date;
  v_prior_revision_id uuid;
  v_revision_number integer;
  v_revision_id uuid;
  v_revision_manifest_hash bytea;
  v_policy_fingerprint bytea;
  v_finalised_at timestamptz:=pg_catalog.transaction_timestamp();
  v_row record;
  v_finalisation_root_ids uuid[];
  v_finalisation_root_recheck uuid[];
  v_finalisation_lock_result jsonb;
  v_report_native_context jsonb;
  v_report_native_command jsonb;
  v_report_native_frame jsonb;
  v_report_native_command_count integer;
  v_lock_phase integer;
  v_lock_discovery jsonb;
  v_window_discovery jsonb; v_window_observed jsonb; v_window_lock record;
  v_invoice_window_ids uuid[]; v_round_scope record; v_round_id uuid;
  v_lock_observed jsonb;
  v_finalisation_lock_context boolean:=false;
  v_next_source_hooks boolean:=false;
  v_finalisation_lock_operation uuid;
  v_prior_finalisation_lock_operation text;
  v_prior_finalisation_root_set text;
  v_economic_id uuid;
  v_timesheet_id uuid;
  v_economic public.weekly_source_row_economic_snapshots%rowtype;
  v_snapshot_id uuid;
  v_snapshot_hash bytea;
  v_paid_cache jsonb:='{}'::jsonb;v_paid_choice jsonb;v_paid_source_rows jsonb;
  v_mapping_fingerprint bytea;
  v_pay_vector jsonb;
  v_charge_vector jsonb;
  v_transition record;
  v_prior_snapshot public.weekly_source_final_snapshot_lines%rowtype;
  v_missing_row record;
  v_missing_candidate jsonb;
  v_missing_cache jsonb:='{}'::jsonb;
  v_prior_missing_cancel_frame text:=coalesce(current_setting('cloudtms.weekly_source_missing_cancel_frame',true),'');
  v_cancel_basis jsonb;
  v_exclude_cancel boolean;
  v_current_snapshot public.weekly_source_final_snapshot_lines%rowtype;
  v_prior_state bytea;
  v_current_state bytea;
  v_outcome text;
  v_transition_id uuid;
  v_transition_fingerprint bytea;
  v_prior_movement public.weekly_source_billing_movements%rowtype;
  v_correction_unit_id uuid;
  v_charge_check public.weekly_source_charge_checks%rowtype;
  v_charge_acceptance public.weekly_source_charge_acceptances%rowtype;
  v_price_admission_result text;
  v_nhsp_price_admission jsonb;
  v_movement_id uuid;
  v_backing_report_number text;
  v_source_total_cost bigint;
  v_source_commission bigint;
  v_source_invoice_total bigint;
  v_line_count integer;
  v_manifest record;
  v_client_manifest_id uuid;
  v_client_manifest_hash bytea;
  v_completion_generation integer;
  v_completion_hash bytea;
  v_expense_observation record;
  v_target_expense_pence bigint;
  v_target_expense_vat boolean;
  v_target_expense_contract_id uuid;
  v_expense_observation_kind text;
  v_current_expense public.weekly_expense_authority_generations%rowtype;
  v_expense_policy public.weekly_source_row_expense_policy_snapshots%rowtype;
  v_expense_generation integer;
  v_expense_hash bytea;
  v_expense_authority_id uuid;
  v_prior_expense_authority_id uuid;
  v_expense_timesheet_id uuid;
  v_expense_policy_id uuid;
  v_expense_movement_result jsonb;
  v_rule_set jsonb;
  v_rule_values jsonb;
  v_rule_version uuid;
  v_invoice_amounts jsonb;
  v_invoice_correction jsonb;
  v_effective_policy jsonb;
  v_authority_subset jsonb;
  v_prior_authority_subset jsonb;
  v_current_authority_subset jsonb;
  v_comparison_current_authority jsonb;
  v_correction_presentation text;
  v_movement_count integer:=0;
  v_transition_count integer:=0;
  v_snapshot_count integer:=0;
  v_unchanged_count integer:=0;
  v_expense_generation_count integer:=0;
begin
  perform pg_catalog.set_config('lock_timeout','5s',true);
  if coalesce(current_setting('request.jwt.claim.role',true),
       nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
  end if;
  if p_prepare_only is null
     or (p_prepare_only and p_correction_session_id is null)
     or (not p_prepare_only and p_correction_session_id is not null) then
    raise exception 'WEEKLY_SOURCE_FINALISE_EXECUTION_MODE_INVALID' using errcode='22023';
  end if;
  if p_request is null or pg_catalog.jsonb_typeof(p_request)<>'object' then
    raise exception 'WEEKLY_SOURCE_FINALISE_REQUEST_INVALID' using errcode='22023';
  end if;
  select key into v_unknown_key
  from pg_catalog.jsonb_object_keys(p_request) key
  where not (key=any(v_allowed_keys))
  order by key limit 1;
  if v_unknown_key is not null then
    raise exception 'WEEKLY_SOURCE_FINALISE_REQUEST_UNKNOWN_FIELD'
      using errcode='22023',detail=v_unknown_key;
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_cycle_id:=(p_request->>'source_cycle_id')::uuid;
    v_scope_kind:=pg_catalog.upper(pg_catalog.btrim(coalesce(p_request->>'authority_scope_kind','')));
    v_report_scope_id:=nullif(p_request->>'report_scope_id','')::uuid;
    v_upload_id:=(p_request->>'upload_id')::uuid;
    v_publication_id:=(p_request->>'projection_publication_id')::uuid;
    v_scope_version:=(p_request->>'expected_authority_scope_version')::bigint;
  exception when invalid_text_representation or numeric_value_out_of_range then
    raise exception 'WEEKLY_SOURCE_FINALISE_REQUEST_INVALID' using errcode='22023';
  end;
  if v_actor is null or v_cycle_id is null or v_upload_id is null
     or v_publication_id is null or v_scope_version is null or v_scope_version<1
     or v_scope_kind not in ('CYCLE','NHSP_REPORT_SCOPE','SELF_BILL_REPORT_SCOPE')
     or (v_scope_kind in ('NHSP_REPORT_SCOPE','SELF_BILL_REPORT_SCOPE')) is distinct from (v_report_scope_id is not null) then
    raise exception 'WEEKLY_SOURCE_FINALISE_SCOPE_INVALID' using errcode='22023';
  end if;
  v_expected_row_hash:=private.weekly_source_finalisation_hex32_v1(
    p_request->>'expected_row_manifest_hash','WEEKLY_SOURCE_ROW_MANIFEST_HASH_REQUIRED'
  );
  v_expected_comparison_hash:=private.weekly_source_finalisation_hex32_v1(
    p_request->>'expected_comparison_manifest_hash','WEEKLY_SOURCE_COMPARISON_HASH_REQUIRED'
  );
  v_expected_issue_hash:=private.weekly_source_finalisation_hex32_v1(
    p_request->>'expected_issue_set_hash','WEEKLY_SOURCE_ISSUE_HASH_REQUIRED'
  );

  -- Fresh Final admission precedes the first cycle/business lock. Recursive
  -- lineage/current-publication owners inherit this transaction's admission.
  perform private.weekly_source_pay_query_admit_v2();

  -- Internal Report delegate only AFTER unchanged payload/ID/hash/admission.
  -- This arm writes invoice-only Report authority and acquires no I-1 family
  -- locks. The native complete ordinary lock ladder below is unchanged.
  if v_scope_kind='SELF_BILL_REPORT_SCOPE' then
    select * into v_scope from public.weekly_source_report_scopes where id=v_report_scope_id;
    select * into v_cycle from public.weekly_source_cycles where id=v_cycle_id;
    if v_scope.id is null or v_cycle.id is null or v_scope.self_bill_report_id is null
      or v_scope.source_cycle_id is distinct from v_cycle.id
      or v_scope.source_group_id is distinct from v_cycle.source_group_id then
      raise exception 'WEEKLY_SOURCE_REPORT_SCOPE_MISMATCH' using errcode='22023'; end if;
    perform private.weekly_source_office_authority_v1(v_actor,
      case when p_prepare_only then 'CORRECT_FINAL_SOURCE' else 'FINALISE_WEEK' end,
      v_cycle.source_group_id,v_scope.client_id,v_cycle.finalisation_week_ending);
    if p_prepare_only or p_correction_session_id is not null then
      raise exception 'WEEKLY_SOURCE_SELF_BILL_REPORT_CORRECT_FINAL_UNSUPPORTED' using errcode='55000'; end if;
    -- NULL is a held operational variant, never an implicit A choice.
    return private.weekly_source_self_bill_report_finalise_v1(p_request,p_report_vat_rounding_variant);
  end if;

  -- G1 plain scope discovery -> native complete I-1 -> group -> cycle.
  -- Repeat the same guards under locks; changed source/rules/roots retry before any mutation.
  for v_lock_phase in 1..2 loop
  if v_lock_phase=2 then
    -- Use the discovered exact group, never a fresh group chosen after I-1.
    select * into v_group from public.weekly_source_groups
    where id=(v_lock_discovery#>>'{group,id}')::uuid for update;
    if not found or to_jsonb(v_group) is distinct from v_lock_discovery->'group' then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
    -- Complete source + candidate invoice windows were discovered BEFORE I-1.
    -- Take every cycle in UUID order, then compare full original row witnesses.
    for v_window_lock in select cycle.* from public.weekly_source_cycles cycle
      where cycle.id=any(v_invoice_window_ids) order by cycle.id for update
    loop
      if to_jsonb(v_window_lock) is distinct from v_window_discovery->'cycles'->v_window_lock.id::text then
        raise exception 'WEEKLY_SOURCE_INVOICE_WINDOW_SET_CHANGED_DURING_LOCK' using errcode='40001'; end if;
    end loop;
    if (select count(*) from public.weekly_source_cycles cycle where cycle.id=any(v_invoice_window_ids))<>cardinality(v_invoice_window_ids) then
      raise exception 'WEEKLY_SOURCE_INVOICE_WINDOW_SET_CHANGED_DURING_LOCK' using errcode='40001'; end if;
    select * into v_cycle from public.weekly_source_cycles where id=v_cycle_id;
    if not found or to_jsonb(v_cycle) is distinct from v_lock_discovery->'cycle' then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
  else
    select * into v_cycle from public.weekly_source_cycles where id=v_cycle_id;
  end if;
  if not found then
    raise exception 'WEEKLY_SOURCE_CYCLE_NOT_FOUND' using errcode='22023';
  end if;
  select * into strict v_group
  from public.weekly_source_groups where id=v_cycle.source_group_id;
  if v_scope_kind='NHSP_REPORT_SCOPE' then
  if v_lock_phase=2 then
    select * into v_scope from public.weekly_source_report_scopes where id=v_report_scope_id for update;
    if not found or to_jsonb(v_scope) is distinct from v_lock_discovery->'scope' then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
  else
    select * into v_scope from public.weekly_source_report_scopes where id=v_report_scope_id;
  end if;
    if not found or v_scope.source_cycle_id is distinct from v_cycle.id
       or v_scope.source_group_id is distinct from v_group.id
       or v_scope.environment is distinct from v_group.environment
       or v_scope.agency_id is distinct from v_group.agency_id
       or v_scope.cutoff_at_utc is distinct from v_cycle.cutoff_at_utc then
      raise exception 'WEEKLY_SOURCE_REPORT_SCOPE_MISMATCH' using errcode='22023';
    end if;
  end if;
  if v_lock_phase=2 then
    select * into v_upload from public.weekly_source_uploads where id=v_upload_id for share;
    if not found or to_jsonb(v_upload) is distinct from v_lock_discovery->'upload' then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
  else
    select * into v_upload from public.weekly_source_uploads where id=v_upload_id;
  end if;
  if not found then
    raise exception 'WEEKLY_SOURCE_UPLOAD_NOT_FOUND' using errcode='22023';
  end if;
  if v_lock_phase=2 then
    select * into v_publication from public.weekly_source_projection_publications where id=v_publication_id for share;
    if not found or to_jsonb(v_publication) is distinct from v_lock_discovery->'publication' then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
  else
    select * into strict v_publication from public.weekly_source_projection_publications where id=v_publication_id;
  end if;
  select * into strict v_profile
  from public.weekly_source_format_profiles where id=v_upload.source_format_profile_id;
  if v_lock_phase=2 and to_jsonb(v_profile) is distinct from v_lock_discovery->'profile' then
    raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;

  if p_prepare_only then
  if v_lock_phase=2 then
    select * into v_correction from public.weekly_final_source_correction_sessions where id=p_correction_session_id for share;
    if not found or to_jsonb(v_correction) is distinct from v_lock_discovery->'correction' then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
  else
    select * into v_correction from public.weekly_final_source_correction_sessions where id=p_correction_session_id;
  end if;
    if not found or v_correction.state<>'PREPARING'
       or v_correction.source_cycle_id is distinct from v_cycle.id
       or v_correction.authority_scope_kind is distinct from v_scope_kind
       or v_correction.report_scope_id is distinct from v_report_scope_id
       or v_correction.replacement_correction_upload_id is distinct from v_upload.id
       or v_correction.replacement_projection_publication_id is distinct from v_publication.id
       or v_upload.purpose<>'FINAL_SOURCE_CORRECTION'
       or v_upload.correction_session_id is distinct from v_correction.id
       or v_upload.state<>'CORRECTION_READY'
       or v_publication.state<>'CORRECTION_READY'
       or v_publication.correction_session_id is distinct from v_correction.id
       or v_publication.upload_id is distinct from v_upload.id
       or v_publication.authority_scope_version is distinct from v_scope_version then
      raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_STALE' using errcode='40001';
    end if;
    v_guard:=pg_catalog.jsonb_build_object(
      'row_manifest_hash',pg_catalog.encode(v_upload.row_manifest_hash,'hex'),
      'comparison_manifest_hash',pg_catalog.encode(v_publication.comparison_manifest_hash,'hex'),
      'issue_set_hash',pg_catalog.encode(v_publication.issue_set_hash,'hex')
    );
  else
    v_guard:=private.weekly_source_current_publication_guard_v1(
      v_cycle.id,v_scope_kind,v_report_scope_id,v_upload.id,v_publication.id,v_scope_version
    );
  end if;
  if private.weekly_source_finalisation_hex32_v1(
       v_guard->>'row_manifest_hash','WEEKLY_SOURCE_GUARD_ROW_HASH_INVALID'
     ) is distinct from v_expected_row_hash
     or private.weekly_source_finalisation_hex32_v1(
       v_guard->>'comparison_manifest_hash','WEEKLY_SOURCE_GUARD_COMPARISON_HASH_INVALID'
     ) is distinct from v_expected_comparison_hash
     or private.weekly_source_finalisation_hex32_v1(
       v_guard->>'issue_set_hash','WEEKLY_SOURCE_GUARD_ISSUE_HASH_INVALID'
     ) is distinct from v_expected_issue_hash then
    raise exception 'WEEKLY_SOURCE_FINALISE_PREVIEW_CHANGED' using errcode='40001';
  end if;

  v_client_id:=case when v_scope_kind='NHSP_REPORT_SCOPE' then v_scope.client_id
    else nullif(v_upload.file_metadata_json->>'client_id','')::uuid end;
  perform private.weekly_source_office_authority_v1(
    v_actor,case when p_prepare_only then 'CORRECT_FINAL_SOURCE' else 'FINALISE_WEEK' end,
    v_group.id,v_client_id,v_cycle.finalisation_week_ending
  );
  if p_correction_session_id is null then
    if v_upload.purpose<>'ORDINARY' or v_upload.correction_session_id is not null then
      raise exception 'WEEKLY_SOURCE_CORRECTION_REQUIRES_DEDICATED_OWNER' using errcode='55000';
    end if;
  else
    if v_correction.id is null or v_correction.state<>'PREPARING'
       or v_correction.source_cycle_id is distinct from v_cycle.id
       or v_correction.authority_scope_kind is distinct from v_scope_kind
       or v_correction.report_scope_id is distinct from v_report_scope_id
       or v_correction.replacement_correction_upload_id is distinct from v_upload.id
       or v_correction.replacement_projection_publication_id is distinct from v_publication.id
       or v_upload.purpose<>'FINAL_SOURCE_CORRECTION'
       or v_upload.correction_session_id is distinct from v_correction.id then
      raise exception 'WEEKLY_SOURCE_CORRECTION_SESSION_STALE' using errcode='40001';
    end if;
  end if;
  perform private.weekly_source_final_upload_assert_v1(v_upload.id);
  if not private.weekly_source_import_is_prepared_v1(v_upload.id) then
    raise exception 'WEEKLY_SOURCE_CHECKING_FILE_NOT_FINALISABLE' using errcode='55000';
  end if;
  if v_profile.profile_code in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1')
    and exists(select 1 from public.weekly_source_upload_rows source_row
      where source_row.upload_id=v_upload.id and source_row.row_finalisation_state='SOURCE_UNFINALISED')
    and p_request->'exclude_unfinalised_acknowledged' is distinct from 'true'::jsonb then
    raise exception 'WEEKLY_SOURCE_UNFINALISED_EXCLUSION_ACKNOWLEDGEMENT_REQUIRED' using errcode='55000';
  end if;
  if v_finalised_at<coalesce(v_scope.cutoff_at_utc,v_cycle.cutoff_at_utc)
    and v_profile.profile_code not in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1') then
    raise exception 'WEEKLY_SOURCE_CUTOFF_NOT_REACHED' using errcode='55000';
  end if;

  if v_upload.state<>(case when p_prepare_only then 'CORRECTION_READY' else 'CURRENT' end)
     or v_upload.row_manifest_hash is null
     or v_upload.blocked_count<>0 or v_upload.blocking_economic_duplicate_count<>0
     or v_upload.malformed_count<>0
     or v_upload.physical_row_count<>
       v_upload.header_count+v_upload.trailer_count+v_upload.continuation_count+
       v_upload.accepted_count+v_upload.blocking_economic_duplicate_count+v_upload.malformed_count
     or (select pg_catalog.count(*) from public.weekly_source_upload_rows
         where upload_id=v_upload.id)<>v_upload.accepted_count then
    raise exception 'WEEKLY_SOURCE_UPLOAD_NOT_FINALISABLE' using errcode='55000';
  end if;
  -- WP-54, pack 03 section 7: "Overlapping candidate work events are checked
  -- BEFORE FINALISATION.  The system does not assume two overlapping records
  -- are valid because their references differ."  The same guard runs at the
  -- seal, where a refused report never becomes CURRENT.  It runs again here
  -- because this is the owner the pack names and because the rows this engine
  -- is about to turn into movements are the rows that must satisfy it -- pack
  -- 14 section 8.1, the database decides source authority, never the browser.
  -- Deliberately NOT accompanied by a cutoff re-check: NHSP-BR-006 governs the
  -- cutoff occurrence Office confirms when the report is accepted, and the
  -- seal is where that confirmation is made authoritative.
  perform private.weekly_source_overlap_admission_assert_v1(v_upload.id);
  if v_scope_version>2147483647
     or coalesce(v_publication.projection_generation,0)>2147483647 then
    raise exception 'WEEKLY_SOURCE_GENERATION_OVERFLOW' using errcode='22003';
  end if;
  v_generation:=coalesce(
    v_publication.projection_generation,
    v_scope_version::integer
  );
  if (select pg_catalog.count(*)
      from public.weekly_source_row_resolutions resolution
      join public.weekly_source_upload_rows source_row on source_row.id=resolution.upload_row_id
      where source_row.upload_id=v_upload.id and resolution.generation=v_generation)
       <>v_upload.accepted_count
     or exists(
       select 1
       from public.weekly_source_upload_rows source_row
       left join public.weekly_source_row_resolutions resolution
         on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
       where source_row.upload_id=v_upload.id
         and (resolution.id is null or resolution.mapping_state<>'RESOLVED')
     )
     or (v_profile.final_authority_kind<>'NHSP_TRUST_BACKING_REPORT' and exists(
       select 1
       from public.weekly_source_row_resolutions resolution
       join public.weekly_source_upload_rows source_row on source_row.id=resolution.upload_row_id
       where source_row.upload_id=v_upload.id and resolution.generation=v_generation
       group by resolution.work_event_id having pg_catalog.count(*)<>1
     )) then
    raise exception 'WEEKLY_SOURCE_RESOLUTION_CENSUS_NOT_FINALISABLE' using errcode='55000';
  end if;
  if v_scope_kind='CYCLE' then
    select pg_catalog.count(distinct resolution.client_id)::integer,
           pg_catalog.min(resolution.client_id::text)::uuid
    into v_resolved_client_count,v_resolved_client_id
    from public.weekly_source_row_resolutions resolution
    join public.weekly_source_upload_rows source_row on source_row.id=resolution.upload_row_id
    where source_row.upload_id=v_upload.id and resolution.generation=v_generation;
    if v_resolved_client_count>1 then
      raise exception 'WEEKLY_SOURCE_SINGLE_CLIENT_RESOLUTION_REQUIRED' using errcode='55000';
    end if;
    if v_resolved_client_count=1 and v_client_id is not null
       and v_client_id is distinct from v_resolved_client_id then
      raise exception 'WEEKLY_SOURCE_UPLOAD_CLIENT_MISMATCH' using errcode='55000';
    end if;
    v_client_id:=coalesce(v_resolved_client_id,v_client_id);
    if v_cycle.scope_client_id is not null and v_cycle.scope_client_id is distinct from v_client_id then
      raise exception 'WEEKLY_SOURCE_FINAL_CLIENT_SCOPE_REQUIRED' using errcode='55000';
    end if;
    if v_client_id is null or not exists(
      select 1
      from public.weekly_source_group_clients group_client
      where group_client.source_group_id=v_group.id
        and group_client.client_id=v_client_id
        and v_cycle.finalisation_week_ending between group_client.valid_from
          and coalesce(group_client.valid_to,'infinity'::date)
    ) then
      raise exception 'WEEKLY_SOURCE_FINAL_CLIENT_SCOPE_REQUIRED' using errcode='55000';
    end if;
    perform private.weekly_source_office_authority_v1(
      v_actor,case when p_prepare_only then 'CORRECT_FINAL_SOURCE' else 'FINALISE_WEEK' end,
      v_group.id,v_client_id,v_cycle.finalisation_week_ending
    );
  elsif not exists(
    select 1
    from public.weekly_source_group_clients group_client
    where group_client.source_group_id=v_group.id
      and group_client.client_id=v_client_id
      and v_cycle.finalisation_week_ending between group_client.valid_from
        and coalesce(group_client.valid_to,'infinity'::date)
  ) then
    raise exception 'WEEKLY_SOURCE_FINAL_CLIENT_SCOPE_REQUIRED' using errcode='55000';
  end if;

  v_rule_set:=private.weekly_source_effective_rule_set_v1(v_client_id,v_cycle.id);
  v_rule_values:=v_rule_set->'values'; v_rule_version:=nullif(v_rule_set->>'rule_set_version_id','')::uuid;
  v_source_profile_kind:=v_profile.final_authority_kind;
  if v_profile.profile_code='NHSP_FINAL_BACKING_V1' then
    if v_scope_kind<>'NHSP_REPORT_SCOPE' or v_group.source_family<>'NHSP'
       or v_source_profile_kind<>'NHSP_TRUST_BACKING_REPORT'
       or v_profile.omission_meaning<>'NO_INFERENCE'
       or not v_profile.report_number_required or not v_profile.fmc_must_equal_zero
       or v_client_id is null
       or exists(select 1 from public.weekly_source_upload_rows source_row
         where source_row.upload_id=v_upload.id
           and (source_row.row_finalisation_state not in ('NOT_APPLICABLE','SOURCE_WORKED')
              or source_row.source_money_parse_state<>'VALID'
              or source_row.source_shift_charge_pence is null
              or source_row.source_expense_parse_state<>'NOT_APPLICABLE'
             or source_row.source_expense_pence is not null)) then
      raise exception 'WEEKLY_SOURCE_NHSP_FINAL_NOT_FINALISABLE' using errcode='55000';
    end if;
    v_source_mode:='NHSP_WEEKLY';
    v_coverage_start:=null;
    v_coverage_end:=null;
    v_backing_report_number:=private.weekly_source_canonical_report_number_v1(
      v_upload.file_metadata_json->>'nhsp_report_number'
    );
    if v_backing_report_number is null then
      raise exception 'WEEKLY_SOURCE_NHSP_REPORT_NUMBER_REQUIRED' using errcode='55000';
    end if;
  elsif v_profile.profile_code in (
    'HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1'
  ) then
    if v_scope_kind<>'CYCLE' or v_group.source_family<>'ROSTER'
       or v_source_profile_kind<>'HEALTHROSTER_ACTUAL_ROWS'
       or v_profile.omission_meaning<>'CANCEL_INSIDE_CONFIRMED_COVERAGE'
       or v_client_id is null
       or exists(select 1 from public.weekly_source_upload_rows source_row
         where source_row.upload_id=v_upload.id
           and (source_row.row_finalisation_state not in ('SOURCE_WORKED','SOURCE_UNFINALISED')
             or source_row.source_expense_parse_state<>'NOT_APPLICABLE'
             or source_row.source_expense_pence is not null)) then
      raise exception 'WEEKLY_SOURCE_HEALTHROSTER_NOT_FINALISABLE' using errcode='55000';
    end if;
    v_source_mode:='HEALTHROSTER_WEEKLY';
    v_coverage_start:=v_upload.confirmed_coverage_start_local_date;
    v_coverage_end:=v_upload.confirmed_coverage_end_local_date;
  elsif v_profile.profile_code='ROSTER_WEEKLY_SUMMARY_ACTUAL_V1' then
    if v_scope_kind<>'CYCLE' or v_group.source_family<>'ROSTER'
       or v_source_profile_kind<>'GENERIC_COMPLETE_SNAPSHOT'
       or v_profile.omission_meaning<>'CANCEL_INSIDE_CONFIRMED_COVERAGE'
       or v_client_id is null
       or exists(select 1 from public.weekly_source_upload_rows source_row
         where source_row.upload_id=v_upload.id
           and (source_row.row_finalisation_state not in ('NOT_APPLICABLE','SOURCE_WORKED','SOURCE_ABSENT_ZERO')
             or source_row.source_expense_parse_state not in ('NOT_APPLICABLE','VALID','OMITTED_ZERO')
             or (source_row.source_expense_parse_state='NOT_APPLICABLE')
                  is distinct from (source_row.source_expense_pence is null)
             or (source_row.source_expense_parse_state='OMITTED_ZERO'
                 and source_row.source_expense_pence<>0))) then
      raise exception 'WEEKLY_SOURCE_ROSTER_COMPLETE_NOT_FINALISABLE' using errcode='55000';
    end if;
    v_source_mode:='HEALTHROSTER_WEEKLY';
    v_coverage_start:=v_upload.confirmed_coverage_start_local_date;
    v_coverage_end:=v_upload.confirmed_coverage_end_local_date;
  else
    raise exception 'WEEKLY_SOURCE_PROFILE_NOT_FINAL_AUTHORITY' using errcode='55000';
  end if;
  if v_scope_kind='CYCLE' and (
    v_upload.coverage_state<>'COMPLETE' or v_upload.coverage_timezone<>'Europe/London'
    or v_coverage_start is null or v_coverage_end is null or v_coverage_start>v_coverage_end
  ) then
    raise exception 'WEEKLY_SOURCE_CONFIRMED_COVERAGE_REQUIRED' using errcode='55000';
  end if;
  if exists(
    select 1
    from public.weekly_source_row_resolutions resolution
    join public.weekly_source_upload_rows source_row on source_row.id=resolution.upload_row_id
    where source_row.upload_id=v_upload.id and resolution.generation=v_generation
      and (resolution.client_id is distinct from v_client_id
        or source_row.work_date<coalesce(v_coverage_start,source_row.work_date)
        or source_row.work_date>coalesce(v_coverage_end,source_row.work_date))
  ) then
    raise exception 'WEEKLY_SOURCE_RESOLUTION_OUTSIDE_FINAL_SCOPE' using errcode='55000';
  end if;

  v_window_observed:=private.weekly_source_invoice_window_lock_inventory_v1(v_upload.id,v_generation,v_cycle.id,v_client_id);
  if v_lock_phase=1 then
    v_window_discovery:=v_window_observed;
    select array_agg(key::uuid order by key::uuid) into v_invoice_window_ids
      from jsonb_object_keys(v_window_discovery->'cycles') key;
  elsif v_window_observed is distinct from v_window_discovery then
    raise exception 'WEEKLY_SOURCE_INVOICE_WINDOW_SET_CHANGED_DURING_LOCK' using errcode='40001'; end if;
  v_lock_observed:=jsonb_build_object(
    'group',to_jsonb(v_group),'cycle',to_jsonb(v_cycle),'scope',to_jsonb(v_scope),
    'upload',to_jsonb(v_upload),'publication',to_jsonb(v_publication),
    'profile',to_jsonb(v_profile),'correction',to_jsonb(v_correction),
    'client_id',v_client_id,'generation',v_generation,'coverage_start',v_coverage_start,
    'coverage_end',v_coverage_end,'source_profile_kind',v_source_profile_kind,
    'rule_set',v_rule_set,'resolutions',coalesce((select jsonb_agg(to_jsonb(r) order by r.id)
      from public.weekly_source_row_resolutions r join public.weekly_source_upload_rows s on s.id=r.upload_row_id
      where s.upload_id=v_upload.id and r.generation=v_generation),'[]'::jsonb));
  if v_lock_phase=1 then
    v_lock_discovery:=v_lock_observed;
  -- Review F2.  Finalisation calls the lineage ensure owner once per source row
  -- inside ONE transaction, so without this it accumulates family lock sets in
  -- source_row_ordinal order rather than the (btrim(booking_id), booking_id)
  -- order proof/32 section 6 step 2 fixes.  That is an A-B / B-A cycle against
  -- any sorted I-1 caller -- a publication, a release tick or a first
  -- authorisation -- and the I-1 caller was the victim (reproduction D3).
  --
  -- The complete set of roots this cycle will touch is therefore locked ONCE,
  -- up front, through the same helper, which sorts them.  Every later per-row
  -- call then re-enters locks this transaction already holds.
  --
  -- The Candidate serial gate is deliberately NOT taken here.  proof/32
  -- section 6 step 1 makes the gate per Candidate and pins it to four job
  -- types: first authorisation, first-authorisation withdrawal, entitlement
  -- publication and pending release.  Finalisation is none of them -- it
  -- authorises nothing and publishes no entitlement -- and one finalisation
  -- spans many Candidates, so a single gate call cannot cover it and a gate per
  -- Candidate would invent a lock ladder the pack does not describe.
  -- proof/34 section 5 asks this path only for the family lock set and the
  -- resolver, which is exactly what it takes.
  v_prior_finalisation_lock_operation:=coalesce(pg_catalog.current_setting('cloudtms.weekly_source_finalisation_lock_operation',true),'');
  v_prior_finalisation_root_set:=coalesce(pg_catalog.current_setting('cloudtms.weekly_source_finalisation_root_set',true),'');
  v_finalisation_lock_context:=true;
  select active_owner='NEXT' into v_next_source_hooks
  from private.bpay_next_module_control where id=1 for share;
  if coalesce(v_next_source_hooks,false) then

  -- Include prior-only CURRENT HR cancellation and positive-expense omission
  -- roots BEFORE taking any booking key. Current partial indexes provide the
  -- coverage inventory; only this upload/exact corrected revision contributes
  -- immutable emitted roots. No historical chooser is added here.
  v_finalisation_lock_operation:=private.bpay_next_source_current_lock_inventory_v1(
    v_upload.id,v_generation,case when p_prepare_only then v_correction.expected_current_final_revision_id else null end,
    v_group.id,v_client_id,v_coverage_start,v_coverage_end
  );
  perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_lock_operation',v_finalisation_lock_operation::text,true);
  perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_root_set','',true);
  else
  -- Retained default LEGACY / DISABLED Source path: no selector inventory,
  -- no assumption that pre-existing Source facts have been bootstrapped.
  select pg_catalog.array_agg(inventory.root_timesheet_id order by inventory.root_timesheet_id)
  into v_finalisation_root_ids
  from private.weekly_source_missing_finalisation_roots_v1(
    v_upload.id,v_generation,case when p_prepare_only then v_correction.expected_current_final_revision_id else null end,
    v_group.id,v_client_id,v_coverage_start,v_coverage_end
  ) inventory;

  if v_finalisation_root_ids is not null
     and pg_catalog.array_length(v_finalisation_root_ids,1) is not null then
    v_finalisation_lock_result:=private.weekly_source_lock_family_rows_v1(
      v_finalisation_root_ids,null
    );
    if coalesce((v_finalisation_lock_result->>'ok')::boolean,false) is not true then
      raise exception '%',v_finalisation_lock_result->>'code'
        using errcode='55000',detail=v_finalisation_lock_result::text;
    end if;
  end if;

  -- Review G2.  The set above was computed from an UNLOCKED read filtered on a
  -- non-null Contract Week Timesheet id, so a root another owner commits between
  -- that read and the loop would be locked later, in source-row order, out of
  -- the sorted order proof/32 section 6 step 2 fixes.  Recompute it under the
  -- family locks now held; if it grew, refuse retryably (40001) rather than take
  -- a second lock set out of order.  A retry recomputes the larger set up front.
  select pg_catalog.array_agg(inventory.root_timesheet_id order by inventory.root_timesheet_id)
  into v_finalisation_root_recheck
  from private.weekly_source_missing_finalisation_roots_v1(
    v_upload.id,v_generation,case when p_prepare_only then v_correction.expected_current_final_revision_id else null end,
    v_group.id,v_client_id,v_coverage_start,v_coverage_end
  ) inventory;

  if coalesce(v_finalisation_root_recheck,array[]::uuid[])
     <>coalesce(v_finalisation_root_ids,array[]::uuid[]) then
    raise exception 'WEEKLY_SOURCE_FINALISATION_ROOT_SET_CHANGED_DURING_LOCK'
      using errcode='40001',
        detail=pg_catalog.jsonb_build_object(
          'locked_root_count',
            coalesce(pg_catalog.array_length(v_finalisation_root_ids,1),0),
          'observed_root_count',
            coalesce(pg_catalog.array_length(v_finalisation_root_recheck,1),0)
        )::text;
  end if;

  -- Publish the locked set for the per-row calls.  The lineage ensure owner
  -- refuses 40001 when it discovers a root this set does not contain, so a root
  -- that appears after the recheck can never be locked out of order either.
  -- This is a Weekly-Source-private setting, never a Workbench-owned one.
  perform pg_catalog.set_config(
    'cloudtms.weekly_source_finalisation_root_set',
    coalesce(pg_catalog.array_to_string(v_finalisation_root_ids,','),'EMPTY_LOCKED_SET'),
    true
  );
  perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_lock_operation','',true);
  end if;


  else
    if v_lock_observed is distinct from v_lock_discovery then
      raise exception 'WEEKLY_SOURCE_FINALISATION_SCOPE_CHANGED_DURING_LOCK' using errcode='40001'; end if;
    if v_finalisation_lock_operation is not null then
      perform private.bpay_next_source_current_lock_recheck_v1(v_finalisation_lock_operation);
    else
  -- Review G2.  The set above was computed from an UNLOCKED read filtered on a
  -- non-null Contract Week Timesheet id, so a root another owner commits between
  -- that read and the loop would be locked later, in source-row order, out of
  -- the sorted order proof/32 section 6 step 2 fixes.  Recompute it under the
  -- family locks now held; if it grew, refuse retryably (40001) rather than take
  -- a second lock set out of order.  A retry recomputes the larger set up front.
  select pg_catalog.array_agg(inventory.root_timesheet_id order by inventory.root_timesheet_id)
  into v_finalisation_root_recheck
  from private.weekly_source_missing_finalisation_roots_v1(
    v_upload.id,v_generation,case when p_prepare_only then v_correction.expected_current_final_revision_id else null end,
    v_group.id,v_client_id,v_coverage_start,v_coverage_end
  ) inventory;

  if coalesce(v_finalisation_root_recheck,array[]::uuid[])
     <>coalesce(v_finalisation_root_ids,array[]::uuid[]) then
    raise exception 'WEEKLY_SOURCE_FINALISATION_ROOT_SET_CHANGED_DURING_LOCK'
      using errcode='40001',
        detail=pg_catalog.jsonb_build_object(
          'locked_root_count',
            coalesce(pg_catalog.array_length(v_finalisation_root_ids,1),0),
          'observed_root_count',
            coalesce(pg_catalog.array_length(v_finalisation_root_recheck,1),0)
        )::text;
  end if;


    end if;
  end if;
  end loop;

  -- Owner-only native observation at the actual under-lock recheck. The
  -- Report arm returned earlier; this captures the ordinary FIN4 ladder only.
  -- Existing command context validates the real OFF admission/XID/PID/stack.
  -- Normal calls have no context and acquire no additional audit/economic fact.
  v_report_native_context:=private.weekly_source_rule_qualification_context_v1(v_client_id,v_cycle.id);
  if v_report_native_context is not null then
    select count(*),jsonb_agg(audit.after_json)->0 into v_report_native_command_count,v_report_native_command
      from public.audit_events audit
      where audit.object_type='weekly_source_off_rule_command' and audit.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_ADMITTED'
        and audit.event_sequence_is_authoritative and audit.actor_user_id=v_actor
        and audit.after_json->>'transaction_id'=pg_current_xact_id_if_assigned()::text
        and audit.after_json->>'backend_pid'=pg_backend_pid()::text
        and not exists(select 1 from public.audit_events completed where completed.object_type=audit.object_type
          and completed.object_id_text=audit.object_id_text and completed.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_COMPLETED'
          and completed.event_sequence_is_authoritative);
    if v_report_native_command_count<>1 then
      raise exception 'REPORT_NATIVE_OFF_FIN_SCOPE_UNPROVED' using errcode='55000';
    end if;
    if v_report_native_command->>'native_operation'='weekly_source_finalise_atomic_v1' then
    if v_report_native_command->>'schema_version' is distinct from 'WEEKLY_SOURCE_OFF_RULE_COMMAND_V1'
      or v_report_native_command->>'native_operation' is distinct from 'weekly_source_finalise_atomic_v1'
      or v_report_native_command->>'actor_user_id' is distinct from v_actor::text
      or v_report_native_command->>'source_cycle_id' is distinct from v_cycle.id::text
      or v_report_native_command->'authorization' is distinct from v_report_native_context
      or v_report_native_command->'operational_ready' is distinct from 'false'::jsonb
      or v_report_native_command#>>'{native_parent_scope,schema_version}' is distinct from 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_SCOPE_V1'
      or v_report_native_command#>>'{native_parent_scope,source_cycle_id}' is distinct from v_cycle.id::text
      or v_report_native_command#>'{native_parent_scope,ambiguous}' is distinct from 'false'::jsonb
      or v_report_native_command->>'native_request_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_OFF_RULE_NATIVE_REQUEST_V1',p_request),'hex')
      or v_report_native_command->>'command_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_OFF_RULE_COMMAND_V1',v_report_native_command-'command_sha256'),'hex') then
      raise exception 'REPORT_NATIVE_OFF_FIN_SCOPE_UNPROVED' using errcode='55000';
    end if;
    v_report_native_frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_REPORT_FIN_NATIVE_LOCK_CONTEXT_V1',
      'execution',private.weekly_source_protected_qualification_release_v1(),
      'command_id',v_report_native_command->>'command_id','command_sha256',v_report_native_command->>'command_sha256',
      'authorization_sha256',v_report_native_context->>'authorization_sha256','native_operation',v_report_native_command->>'native_operation',
      'actor_user_id',v_actor,'source_cycle_id',v_cycle.id,'upload_id',v_upload.id,'projection_publication_id',v_publication.id,
      'generation',v_generation,'authority_scope_kind',v_scope_kind,'prepare_only',p_prepare_only,
      'native_argument_bytes',jsonb_build_object('p_request',p_request,'p_correction_session_id',p_correction_session_id,
        'p_prepare_only',p_prepare_only,'p_report_vat_rounding_variant',p_report_vat_rounding_variant)::text,
      'backend_pid',pg_backend_pid()::text,'transaction_id',pg_current_xact_id_if_assigned()::text,
      'active_owner',(select active_owner from private.bpay_next_module_control where id=1),
      'original_root_ids',to_jsonb(v_finalisation_root_ids),
      'rechecked_root_ids',to_jsonb(v_finalisation_root_recheck),
      'root_set_setting',current_setting('cloudtms.weekly_source_finalisation_root_set',true),
      'operation_id',v_finalisation_lock_operation,'operation_setting',current_setting('cloudtms.weekly_source_finalisation_lock_operation',true),
      'operation',(select to_jsonb(operation) from private.bpay_next_source_current_lock_operations operation where operation.id=v_finalisation_lock_operation),
      'operation_members',coalesce((select jsonb_agg(to_jsonb(member) order by member.canonical_booking_id,member.raw_booking_id,member.root_timesheet_id)
        from private.bpay_next_source_current_lock_members member where member.operation_id=v_finalisation_lock_operation),'[]'::jsonb),
      'lock_result',v_finalisation_lock_result,'source_lock_discovery',v_lock_discovery,'source_lock_observed',v_lock_observed,
      'window_lock_discovery',v_window_discovery,'window_lock_observed',v_window_observed,
      'source_cas',private.weekly_source_bulk_source_cas_v1(v_cycle.id,
        array(select value::uuid from jsonb_array_elements_text(v_report_native_context#>'{fixture_manifest,client_ids}') value)),
      'source_facts_bytes',private.weekly_source_bulk_source_facts_v1(v_cycle.id,
        array(select value::uuid from jsonb_array_elements_text(v_report_native_context#>'{fixture_manifest,client_ids}') value))::text,
      'operational_ready',false);
    v_report_native_frame:=v_report_native_frame||jsonb_build_object('frame_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_REPORT_FIN_NATIVE_LOCK_CONTEXT_V1',v_report_native_frame),'hex'));
    perform public._audit_insert('weekly_source_off_rule_native_fin',v_report_native_command->>'command_id',
      'WEEKLY_SOURCE_REPORT_FIN_NATIVE_LOCK_OBSERVED',v_report_native_command,v_report_native_frame,
      'Native ordinary FIN4 under-lock observation; non-operational fixture only',v_actor);
    end if;
  end if;

  -- One transaction at a time may decide the final order for a logical
  -- group/Client/source-authority history.  Both supported HealthRoster
  -- layouts share the same final_authority_kind and therefore the same lock.
  -- The lock is acquired only after the exact current publication and Client
  -- have been resolved; no other owner acquires this finaliser-only domain.
  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended(
    'weekly_source_finalise_order:'||v_group.id::text||':'||v_client_id::text||':'||v_source_profile_kind,
    0
  ));

  if p_prepare_only then
    if coalesce(v_scope.current_final_revision_id,v_cycle.current_final_revision_id)
         is distinct from v_correction.expected_current_final_revision_id then
      raise exception 'WEEKLY_SOURCE_CORRECTION_FINAL_REVISION_STALE' using errcode='40001';
    end if;
  elsif coalesce(v_scope.current_final_revision_id,v_cycle.current_final_revision_id) is not null then
    select * into strict v_existing_revision
    from public.weekly_source_final_revisions
    where id=coalesce(v_scope.current_final_revision_id,v_cycle.current_final_revision_id);
    if v_existing_revision.upload_id=v_upload.id
       and v_existing_revision.authority_scope_kind=v_scope_kind
       and v_existing_revision.report_scope_id is not distinct from v_report_scope_id
       and v_existing_revision.state='CURRENT' then
      -- Native operation is transaction-local, including exact immutable replay.
      if v_finalisation_lock_operation is not null then
        perform private.bpay_next_source_current_lock_release_v1(v_finalisation_lock_operation);
      end if;
      if v_finalisation_lock_context then
    perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_lock_operation',v_prior_finalisation_lock_operation,true);
    perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_root_set',v_prior_finalisation_root_set,true);
      end if;
      return pg_catalog.jsonb_build_object(
        'ok',true,'status','FINALISED','idempotent',true,
        'final_revision_id',v_existing_revision.id,'source_cycle_id',v_cycle.id,
        'authority_scope_kind',v_scope_kind,'report_scope_id',v_report_scope_id,
        'upload_id',v_upload.id
      );
    end if;
    raise exception 'WEEKLY_SOURCE_SCOPE_ALREADY_FINALISED' using errcode='55000';
  end if;

  if v_scope_kind='CYCLE' and exists(
    select 1
    from public.weekly_source_final_revisions later_revision
    join public.weekly_source_cycles later_cycle
      on later_cycle.id=later_revision.source_cycle_id
    join public.weekly_source_client_manifests later_manifest
      on coalesce(later_manifest.invoice_window_cycle_id,later_manifest.source_cycle_id)=later_manifest.source_cycle_id and later_manifest.final_revision_id=later_revision.id
     and later_manifest.client_id=v_client_id
    join public.weekly_source_uploads later_upload
      on later_upload.id=later_revision.upload_id
    join public.weekly_source_format_profiles later_profile
      on later_profile.id=later_upload.source_format_profile_id
    where later_revision.authority_scope_kind='CYCLE'
      and later_revision.state='CURRENT'
      and later_cycle.source_group_id=v_group.id
      and later_cycle.finalisation_week_ending>v_cycle.finalisation_week_ending
      and later_profile.final_authority_kind=v_source_profile_kind
  ) then
    raise exception 'WEEKLY_SOURCE_FINALISATION_OUT_OF_ORDER' using errcode='55000';
  end if;

  -- Actual immutable confirmations, re-proved under the existing complete
  -- I-1/root/source/window locks. No caller pay flag or second classifier.
  for v_row in select source_row.id,resolution.id as resolution_id,resolution.work_event_id,
      resolution.pay_effect,resolution.paid_overlap_choice_id
    from public.weekly_source_upload_rows source_row join public.weekly_source_row_resolutions resolution
      on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
    where source_row.upload_id=v_upload.id order by source_row.source_row_ordinal,source_row.id
  loop
    v_paid_choice:=private.weekly_source_paid_overlap_choice_current_v1(v_row.id,v_actor);
    if v_paid_choice is null then
      if v_row.pay_effect<>'NORMAL' or v_row.paid_overlap_choice_id is not null then
        raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_FINAL_CHOICE_UNBOUND' using errcode='55000';end if;
    else
      if v_paid_choice->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1'
        or v_row.paid_overlap_choice_id is distinct from (v_paid_choice->>'choice_id')::bigint
        or v_row.pay_effect is distinct from v_paid_choice->>'pay_effect'
        or (v_row.pay_effect='NONE' and v_row.work_event_id is distinct from
          (v_paid_choice->>'paid_overlap_target_work_event_id')::uuid) then
        raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_FINAL_CHOICE_UNBOUND' using errcode='55000';end if;
      -- NONE expense values retain the genuine raw policy snapshot. Its
      -- invoice companion delegates the existing native amount/vector owner;
      -- the old payable expense generation is never replaced by this row.
      v_paid_cache:=v_paid_cache||jsonb_build_object(v_row.id::text,v_paid_choice);
    end if;
  end loop;

  -- The source Timesheet owner is the only component permitted to create or
  -- reuse ordinary Timesheet lineage.  Finalisation calls it, then validates
  -- the resulting immutable binding; it never accepts a caller-owned id.
  for v_row in
    select resolution.id as resolution_id,source_row.row_finalisation_state
    from public.weekly_source_upload_rows source_row
    join public.weekly_source_row_resolutions resolution
      on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
    where source_row.upload_id=v_upload.id
      and (v_rule_values is null or v_rule_values->>'invoice_sender'<>'CLIENT_SELF_BILL' or v_rule_values->>'self_bill_source'<>'SAME_FILE'
          or coalesce((private.weekly_source_shift_on_self_bill_v1(resolution.work_event_id,v_cycle.id)->>'s25_pay_selected')::boolean,false))
      and (v_source_profile_kind='NHSP_TRUST_BACKING_REPORT'
        or source_row.row_finalisation_state='SOURCE_WORKED'
        or (v_source_profile_kind='GENERIC_COMPLETE_SNAPSHOT'
          and source_row.row_finalisation_state='NOT_APPLICABLE'))
    order by source_row.source_row_ordinal
  loop
    perform public.weekly_source_timesheet_lineage_ensure_atomic_v1(v_row.resolution_id,v_actor);
    v_economic_id:=private.weekly_source_finalisation_economic_assert_v1(
      v_row.resolution_id,v_cycle.id,v_source_mode
    );
    v_timesheet_id:=private.weekly_source_finalisation_lineage_assert_v1(
      v_row.resolution_id,v_cycle.id
    );
  end loop;

  if v_scope_kind='CYCLE' then
    select revision.id into v_prior_revision_id
    from public.weekly_source_final_revisions revision
    join public.weekly_source_cycles prior_cycle on prior_cycle.id=revision.source_cycle_id
    join public.weekly_source_client_manifests prior_manifest
      on coalesce(prior_manifest.invoice_window_cycle_id,prior_manifest.source_cycle_id)=prior_manifest.source_cycle_id and prior_manifest.final_revision_id=revision.id and prior_manifest.client_id=v_client_id
    join public.weekly_source_uploads prior_upload on prior_upload.id=revision.upload_id
    join public.weekly_source_format_profiles prior_profile
      on prior_profile.id=prior_upload.source_format_profile_id
    where revision.authority_scope_kind='CYCLE' and revision.state='CURRENT'
      and prior_cycle.source_group_id=v_group.id and prior_cycle.id<>v_cycle.id
      and prior_cycle.finalisation_week_ending<v_cycle.finalisation_week_ending
      and prior_profile.final_authority_kind=v_source_profile_kind
    order by prior_cycle.finalisation_week_ending desc,revision.finalised_at_utc desc,revision.id desc
    limit 1;
  end if;

  -- All genuinely missing dispositions share the retained native I-1/root
  -- scope and one pre-write current financial observation. No own-mutation CAS.
  if v_source_profile_kind in ('GENERIC_COMPLETE_SNAPSHOT','HEALTHROSTER_ACTUAL_ROWS') then
    for v_missing_row in
      with prior_states as (
        select prior.work_event_id,prior.snapshot_line_id as new_snapshot_line_id
        from private.weekly_source_roster_prior_states_v1(
          v_group.id,v_client_id,v_source_profile_kind,v_cycle.finalisation_week_ending) prior      ), prior_lines as (
        select prior_line.id,prior_state.work_event_id
        from prior_states prior_state
        join public.weekly_source_final_snapshot_lines prior_line
          on prior_line.id=prior_state.new_snapshot_line_id
        where prior_line.client_id=v_client_id
          and not (v_rule_values is not null and v_rule_values->>'invoice_sender'='CLIENT_SELF_BILL' and v_rule_values->>'self_bill_source'='SAME_FILE'
            and coalesce((private.weekly_source_shift_on_self_bill_v1(prior_line.work_event_id,v_cycle.id)->>'bound_to_finalised_export')::boolean,false)
            and not coalesce((private.weekly_source_shift_on_self_bill_v1(prior_line.work_event_id,v_cycle.id)->>'s25_pay_selected')::boolean,false))
          and (
            prior_line.work_date between v_coverage_start and v_coverage_end
            or exists(
              select 1
              from public.weekly_source_row_resolutions current_resolution
              join public.weekly_source_upload_rows current_row
                on current_row.id=current_resolution.upload_row_id
              where current_row.upload_id=v_upload.id
                and current_resolution.generation=v_generation
                and current_resolution.work_event_id=prior_line.work_event_id
            )
          )
      )
      select prior_lines.id as previous_snapshot_line_id,prior_lines.work_event_id
      from prior_lines join public.weekly_work_events event on event.id=prior_lines.work_event_id
      where not exists(select 1 from public.weekly_source_upload_rows source_row
        join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=source_row.id
          and resolution.generation=v_generation and resolution.mapping_state='RESOLVED'
        where source_row.upload_id=v_upload.id and resolution.work_event_id=prior_lines.work_event_id)
        and not (event.identity_kind='PROFILE_EXTERNAL_KEY' and exists(
          select 1 from public.weekly_source_upload_rows source_row
          where source_row.upload_id=v_upload.id and source_row.external_source_key=event.profile_external_key))
      order by prior_lines.work_event_id
    loop
      v_missing_candidate:=private.weekly_source_missing_cancel_basis_v1(
        v_publication.id,v_missing_row.previous_snapshot_line_id,v_actor);
      v_missing_cache:=jsonb_set(v_missing_cache,array[v_missing_row.work_event_id::text],v_missing_candidate,true);
    end loop;
    perform set_config('cloudtms.weekly_source_missing_cancel_frame',jsonb_build_object(
      'schema_version','WEEKLY_SOURCE_MISSING_CANCEL_OWNER_FRAME_V1',
      'owner_transaction_id',pg_current_xact_id()::text,'owner_backend_pid',pg_backend_pid(),
      'actor_user_id',v_actor,'projection_publication_id',v_publication.id,
      'upload_id',v_upload.id,'source_cycle_id',v_cycle.id,'source_group_id',v_group.id,
      'client_id',v_client_id,'census',v_missing_cache,
      'census_sha256',encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_MISSING_CANCEL_CENSUS_V1',v_missing_cache),'hex'))::text,true);
  end if;

  select coalesce(pg_catalog.max(revision.revision_number),0)+1 into v_revision_number
  from public.weekly_source_final_revisions revision
  where revision.source_cycle_id=v_cycle.id
    and revision.authority_scope_kind=v_scope_kind
    and revision.report_scope_id is not distinct from v_report_scope_id;
  select private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_FINAL_POLICY_SET_V1',
    pg_catalog.jsonb_build_object(
      'profile_code',v_profile.profile_code,'profile_version',v_profile.version,
      'source_profile_kind',v_source_profile_kind,'source_mode',v_source_mode,
      'economics',coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
        'row_resolution_id',resolution.id,
        'contract_and_rate_fingerprint',case when economic.id is null then null
          else pg_catalog.encode(economic.contract_and_rate_fingerprint,'hex') end,
        'effective_policy_fingerprint',case when economic.id is null then null
          else pg_catalog.encode(economic.effective_policy_fingerprint,'hex') end,
        'invoice_vat_policy_fingerprint',case when economic.id is null then null
          else pg_catalog.encode(economic.invoice_vat_policy_fingerprint,'hex') end,
        'calculation_fingerprint',case when economic.id is null then null
          else pg_catalog.encode(economic.calculation_fingerprint,'hex') end,
        'expense_policy_snapshot_id',expense_policy.id,
        'expense_policy_snapshot_hash',case when expense_policy.id is null then null
          else pg_catalog.encode(expense_policy.snapshot_hash,'hex') end
      ) order by source_row.source_row_ordinal),'[]'::jsonb)
    )
  ) into v_policy_fingerprint
  from public.weekly_source_upload_rows source_row
  join public.weekly_source_row_resolutions resolution
    on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
  left join public.weekly_source_row_economic_snapshots economic
    on economic.row_resolution_id=resolution.id
  left join public.weekly_source_row_expense_policy_snapshots expense_policy
    on expense_policy.row_resolution_id=resolution.id
  where source_row.upload_id=v_upload.id;
  v_revision_manifest_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_FINAL_REVISION_MANIFEST_V1',
    pg_catalog.jsonb_build_object(
      'source_cycle_id',v_cycle.id,'authority_scope_kind',v_scope_kind,
      'report_scope_id',v_report_scope_id,'revision_number',v_revision_number,
      'upload_id',v_upload.id,'authority_scope_version',v_scope_version,
      'row_manifest_hash',pg_catalog.encode(v_expected_row_hash,'hex'),
      'comparison_manifest_hash',pg_catalog.encode(v_expected_comparison_hash,'hex'),
      'issue_set_hash',pg_catalog.encode(v_expected_issue_hash,'hex'),
      'profile_code',v_profile.profile_code,'profile_version',v_profile.version,
      'coverage_start_local_date',v_coverage_start,'coverage_end_local_date',v_coverage_end,
      'reason',case when p_correction_session_id is null then 'INITIAL_FINALISATION'
        else 'CORRECT_FINAL_SOURCE' end,
      'predecessor_revision_id',case when p_correction_session_id is null then null
        else v_correction.expected_current_final_revision_id end,
      'prior_state_cutoff_revision_id',v_prior_revision_id,
      'policy_fingerprint',pg_catalog.encode(v_policy_fingerprint,'hex')
    )||case when v_missing_cache='{}'::jsonb then '{}'::jsonb else jsonb_build_object(
      'missing_cancel_basis_census',v_missing_cache) end
    ||case when v_paid_cache='{}'::jsonb then '{}'::jsonb else jsonb_build_object('paid_overlap_choice_census',v_paid_cache) end
    ||case when v_rule_version is null then '{}'::jsonb else jsonb_build_object(
      'rule_set_version_id',v_rule_version,'rule_set_values_sha256',v_rule_set->>'values_sha256') end
  );
  insert into public.weekly_source_final_revisions(
    source_cycle_id,authority_scope_kind,report_scope_id,revision_number,upload_id,
    predecessor_revision_id,coverage_start_local_date,coverage_end_local_date,
    coverage_timezone,prior_state_cutoff_revision_id,reason,finalised_by_user_id,
    finalised_at_utc,manifest_hash,policy_fingerprint,state,rule_set_version_id,missing_cancel_basis_census,paid_overlap_choice_census
  ) values (
    v_cycle.id,v_scope_kind,v_report_scope_id,v_revision_number,v_upload.id,
    case when p_correction_session_id is null then null
      else v_correction.expected_current_final_revision_id end,
    v_coverage_start,v_coverage_end,
    case when v_scope_kind='CYCLE' then 'Europe/London' else null end,
    v_prior_revision_id,
    case when p_correction_session_id is null then 'INITIAL_FINALISATION'
      else 'CORRECT_FINAL_SOURCE' end,
    v_actor,v_finalised_at,
    v_revision_manifest_hash,v_policy_fingerprint,
    case when p_prepare_only then 'PREPARED' else 'CURRENT' end,v_rule_version,v_missing_cache,v_paid_cache
  ) returning id into v_revision_id;

  if v_source_profile_kind in ('GENERIC_COMPLETE_SNAPSHOT','HEALTHROSTER_ACTUAL_ROWS') then
    for v_row in
      select source_row.*,resolution.id as resolution_id,
             resolution.work_event_id,resolution.candidate_id,resolution.client_id,
             resolution.contract_id,resolution.work_event_match_kind,
             resolution.work_event_match_fingerprint,resolution.pay_effect,resolution.paid_overlap_choice_id
      from public.weekly_source_upload_rows source_row
      join public.weekly_source_row_resolutions resolution
        on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
      where source_row.upload_id=v_upload.id
        and (v_rule_values is null or v_rule_values->>'invoice_sender'<>'CLIENT_SELF_BILL' or v_rule_values->>'self_bill_source'<>'SAME_FILE'
          or coalesce((private.weekly_source_shift_on_self_bill_v1(resolution.work_event_id,v_cycle.id)->>'s25_pay_selected')::boolean,false))
        and (source_row.row_finalisation_state='SOURCE_WORKED'
          or (v_source_profile_kind='GENERIC_COMPLETE_SNAPSHOT'
            and source_row.row_finalisation_state='NOT_APPLICABLE'))
      order by source_row.source_row_ordinal
    loop
      v_economic_id:=private.weekly_source_finalisation_economic_assert_v1(
        v_row.resolution_id,v_cycle.id,'HEALTHROSTER_WEEKLY'
      );
      v_timesheet_id:=private.weekly_source_finalisation_lineage_assert_v1(
        v_row.resolution_id,v_cycle.id
      );
      select * into strict v_economic
      from public.weekly_source_row_economic_snapshots where id=v_economic_id;
      v_pay_vector:=private.weekly_source_finalisation_vector_v1(v_economic.id,'PAY',1::smallint);
      v_charge_vector:=private.weekly_source_finalisation_vector_v1(v_economic.id,'CHARGE',1::smallint);
      v_mapping_fingerprint:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_FINAL_MAPPING_V1',
        pg_catalog.jsonb_build_object(
          'work_event_id',v_row.work_event_id,'candidate_id',v_row.candidate_id,
          'client_id',v_row.client_id,'contract_id',v_row.contract_id
        )
      );
      -- Freeze only the four authority fields for this exact new snapshot.
      -- The full economic/provenance hashes remain unchanged below.
      v_effective_policy:=private._weekly_source_effective_policy_v1(
        v_row.client_id,v_row.contract_id,v_row.work_date
      );
      if (v_effective_policy->>'authority_mode') is distinct from 'SOURCE_AUTHORITY'
         or coalesce((v_effective_policy->>'self_bill_enabled')::boolean,false) is not true
         or (v_effective_policy->>'source_group_id')::uuid is distinct from v_group.id then
        raise exception 'WEEKLY_SOURCE_FINALISATION_POLICY_STALE' using errcode='40001';
      end if;
      v_authority_subset:=private.weekly_source_authority_subset_v1(v_effective_policy);
      v_snapshot_hash:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_FINAL_SNAPSHOT_LINE_V1',
        pg_catalog.jsonb_build_object(
          'final_revision_id',v_revision_id,'upload_row_id',v_row.id,
          'row_resolution_id',v_row.resolution_id,'work_event_id',v_row.work_event_id,
          'candidate_id',v_row.candidate_id,'client_id',v_row.client_id,
          'contract_id',v_row.contract_id,'work_date',v_row.work_date,
          'start_at_local',v_row.start_at_local,'end_at_local',v_row.end_at_local,
          'break_minutes',v_row.break_minutes,'actual_net_minutes',v_row.actual_net_minutes,
          'pay_vector',v_pay_vector,'charge_vector',v_charge_vector,
          'source_expense_pence',v_row.source_expense_pence,
          'source_fingerprint',pg_catalog.encode(v_row.normalised_row_hash,'hex'),
          'mapping_fingerprint',pg_catalog.encode(v_mapping_fingerprint,'hex'),
          'rate_fingerprint',pg_catalog.encode(v_economic.calculation_fingerprint,'hex'),
          'policy_fingerprint',pg_catalog.encode(v_economic.effective_policy_fingerprint,'hex')
        )||case when v_row.paid_overlap_choice_id is null then '{}'::jsonb else jsonb_build_object(
          'pay_effect',v_row.pay_effect,'paid_overlap_choice_id',v_row.paid_overlap_choice_id,
          'paid_overlap_choice_proof_sha256',v_paid_cache#>>array[v_row.id::text,'choice_proof_sha256']) end
      );
      insert into public.weekly_source_final_snapshot_lines(
        final_revision_id,upload_row_id,row_resolution_id,charge_check_id,
        source_profile_kind,work_event_id,external_event_identity,candidate_id,
        client_id,contract_id,work_date,start_at_local,end_at_local,break_minutes,
        actual_net_minutes,source_classifications_json,pay_vector_json,charge_vector_json,
        source_expense_pence,source_fingerprint,mapping_fingerprint,rate_fingerprint,
        policy_fingerprint,snapshot_line_hash,authority_subset_json,authority_subset_sha256,invoice_economics_sha256,pay_effect,paid_overlap_choice_id
      ) values (
        v_revision_id,v_row.id,v_row.resolution_id,null,v_source_profile_kind,
        v_row.work_event_id,v_row.external_source_key,v_row.candidate_id,v_row.client_id,
        v_row.contract_id,v_row.work_date,v_row.start_at_local,v_row.end_at_local,
        v_row.break_minutes,v_row.actual_net_minutes,v_economic.canonical_result_json,
        v_pay_vector,v_charge_vector,v_row.source_expense_pence,v_row.normalised_row_hash,
        v_mapping_fingerprint,v_economic.calculation_fingerprint,
        v_economic.effective_policy_fingerprint,v_snapshot_hash,v_authority_subset,
        private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AUTHORITY_SUBSET_V1',v_authority_subset),
        case when v_rule_values is not null and v_rule_values->>'invoice_sender'='CLIENT_SELF_BILL' and v_rule_values->>'invoice_amount_basis'='SOURCE_AMOUNT' and v_rule_values->>'source_amount_basis'='EXPORT_ACTUAL_COST_INC_VAT_NET_AGENCY_WORKER_PAY'
          then private.weekly_source_invoice_economics_fingerprint_v1(jsonb_build_object('source_shift_charge_pence',v_row.source_shift_charge_pence,
            'source_gross_pence',v_row.source_gross_pence,'source_vat_pence',v_row.source_vat_pence),v_rule_values->>'line_vat_method',
            case when v_economic.invoice_vat_chargeable then v_economic.invoice_vat_rate_pct else 0 end) else null end,
        v_row.pay_effect,v_row.paid_overlap_choice_id
      ) returning id into v_snapshot_id;
      v_snapshot_count:=v_snapshot_count+1;
    end loop;

    for v_transition in
      with prior_states as (
        select prior.work_event_id,prior.snapshot_line_id as new_snapshot_line_id
        from private.weekly_source_roster_prior_states_v1(
          v_group.id,v_client_id,v_source_profile_kind,v_cycle.finalisation_week_ending) prior      ), prior_lines as (
        select prior_line.id,prior_state.work_event_id
        from prior_states prior_state
        join public.weekly_source_final_snapshot_lines prior_line
          on prior_line.id=prior_state.new_snapshot_line_id
        where prior_line.client_id=v_client_id
          and not (v_rule_values is not null and v_rule_values->>'invoice_sender'='CLIENT_SELF_BILL' and v_rule_values->>'self_bill_source'='SAME_FILE'
            and coalesce((private.weekly_source_shift_on_self_bill_v1(prior_line.work_event_id,v_cycle.id)->>'bound_to_finalised_export')::boolean,false)
            and not coalesce((private.weekly_source_shift_on_self_bill_v1(prior_line.work_event_id,v_cycle.id)->>'s25_pay_selected')::boolean,false))
          and (
            prior_line.work_date between v_coverage_start and v_coverage_end
            or exists(
              select 1
              from public.weekly_source_row_resolutions current_resolution
              join public.weekly_source_upload_rows current_row
                on current_row.id=current_resolution.upload_row_id
              where current_row.upload_id=v_upload.id
                and current_resolution.generation=v_generation
                and current_resolution.work_event_id=prior_line.work_event_id
            )
          )
      ), current_normal_lines as (
        select current_line.id,current_line.work_event_id
        from public.weekly_source_final_snapshot_lines current_line
        where current_line.final_revision_id=v_revision_id and current_line.pay_effect='NORMAL'
      ), none_basis as (
        select distinct companion.work_event_id,(item->>'snapshot_line_id')::uuid as id
        from public.weekly_source_final_snapshot_lines companion
        cross join lateral jsonb_array_elements(v_paid_cache#>array[companion.upload_row_id::text,'inputs','overlaps']) item
        where companion.final_revision_id=v_revision_id and companion.pay_effect='NONE'
          and item->>'work_event_id'=companion.work_event_id::text
          and companion.paid_overlap_choice_id=(v_paid_cache#>>array[companion.upload_row_id::text,'choice_id'])::bigint
      ), current_lines as (
        select id,work_event_id from current_normal_lines
        union all
        select basis.id,basis.work_event_id from none_basis basis
          join prior_lines prior on prior.work_event_id=basis.work_event_id and prior.id=basis.id
          where not exists(select 1 from current_normal_lines normal where normal.work_event_id=basis.work_event_id)
      )
      select coalesce(prior_lines.work_event_id,current_lines.work_event_id) as work_event_id,
             prior_lines.id as prior_snapshot_id,current_lines.id as current_snapshot_id
      from prior_lines full join current_lines using(work_event_id)
      order by coalesce(prior_lines.work_event_id,current_lines.work_event_id)
    loop
      select coalesce(jsonb_agg(jsonb_build_object('snapshot_line_id',companion.id,'upload_row_id',companion.upload_row_id,
        'paid_overlap_choice_id',companion.paid_overlap_choice_id,'snapshot_line_hash',encode(companion.snapshot_line_hash,'hex'))
        order by companion.upload_row_id),'[]'::jsonb) into v_paid_source_rows
        from public.weekly_source_final_snapshot_lines companion
        where companion.final_revision_id=v_revision_id and companion.work_event_id=v_transition.work_event_id
          and companion.pay_effect='NONE';
      if jsonb_array_length(v_paid_source_rows)>0 and v_transition.current_snapshot_id is null then
        raise exception 'WEEKLY_SOURCE_PAID_MATCH_PRIOR_PAY_BASIS_CHANGED' using errcode='40001';end if;
      -- Retained basis is lawful only because these actual current raw rows
      -- explicitly confirm SAME. Absence/CANCEL never enters this branch.
      select * into v_prior_snapshot
      from public.weekly_source_final_snapshot_lines
      where id=v_transition.prior_snapshot_id;
      select * into v_current_snapshot
      from public.weekly_source_final_snapshot_lines
      where id=v_transition.current_snapshot_id;
      v_effective_policy:=private._weekly_source_effective_policy_v1(
        coalesce(v_current_snapshot.client_id,v_prior_snapshot.client_id),
        coalesce(v_current_snapshot.contract_id,v_prior_snapshot.contract_id),
        coalesce(v_current_snapshot.work_date,v_prior_snapshot.work_date)
      );
      if (v_effective_policy->>'authority_mode') is distinct from 'SOURCE_AUTHORITY'
         or coalesce((v_effective_policy->>'self_bill_enabled')::boolean,false) is not true
         or (v_effective_policy->>'source_group_id')::uuid is distinct from v_group.id then
        raise exception 'WEEKLY_SOURCE_FINALISATION_POLICY_STALE' using errcode='40001';
      end if;
      v_authority_subset:=private.weekly_source_authority_subset_v1(v_effective_policy);
      v_prior_authority_subset:=private.weekly_source_snapshot_authority_subset_v1(v_transition.prior_snapshot_id);
      v_current_authority_subset:=private.weekly_source_snapshot_authority_subset_v1(v_transition.current_snapshot_id);
      if (v_effective_policy->>'authority_mode') is distinct from 'SOURCE_AUTHORITY'
         or coalesce((v_effective_policy->>'self_bill_enabled')::boolean,false) is not true
         or (v_effective_policy->>'source_group_id')::uuid is distinct from v_group.id
         or (coalesce(v_current_authority_subset,v_prior_authority_subset) is not null
           and v_authority_subset is distinct from coalesce(v_current_authority_subset,v_prior_authority_subset))
         or (coalesce(v_current_authority_subset,v_prior_authority_subset) is null
           and private.weekly_source_finalisation_hex32_v1(
              v_effective_policy->>'policy_sha256','WEEKLY_SOURCE_POLICY_FINGERPRINT_INVALID'
            ) is distinct from coalesce(
              v_current_snapshot.policy_fingerprint,v_prior_snapshot.policy_fingerprint
            )) then
        raise exception 'WEEKLY_SOURCE_FINALISATION_POLICY_STALE' using errcode='40001';
      end if;
      v_correction_presentation:=pg_catalog.upper(pg_catalog.btrim(coalesce(
        v_effective_policy->>'self_bill_correction_presentation',''
      )));
      if v_correction_presentation not in (
        'FULL_REVERSAL_REPLACEMENT','NET_DIFFERENCE_PRESENTATION'
      ) then
        raise exception 'WEEKLY_SOURCE_SELF_BILL_CORRECTION_POLICY_REQUIRED'
          using errcode='55000';
      end if;
      -- Unknown pre-upgrade authority keeps the whole-hash fence. Equality
      -- proves compatibility without inventing historical four-field JSON.
      v_comparison_current_authority:=v_current_authority_subset;
      if v_transition.prior_snapshot_id is not null and v_prior_authority_subset is null
         and v_transition.current_snapshot_id is not null then
        if private.weekly_source_finalisation_hex32_v1(
             v_effective_policy->>'policy_sha256','WEEKLY_SOURCE_POLICY_FINGERPRINT_INVALID'
           ) is distinct from v_prior_snapshot.policy_fingerprint then
          raise exception 'WEEKLY_SOURCE_FINALISATION_POLICY_STALE' using errcode='40001';
        end if;
        v_comparison_current_authority:=null;
      end if;
      v_prior_state:=private.weekly_source_snapshot_value_fingerprint_v1(
        v_transition.prior_snapshot_id,v_prior_authority_subset
      );
      v_current_state:=private.weekly_source_snapshot_value_fingerprint_v1(
        v_transition.current_snapshot_id,v_comparison_current_authority
      );
      v_outcome:=case
        when v_transition.prior_snapshot_id is null then 'ADD'
        when v_transition.current_snapshot_id is null then 'CANCEL'
        when v_prior_state=v_current_state then 'NO_CHANGE'
        else 'AMEND' end;
      v_exclude_cancel:=v_outcome='CANCEL' and coalesce((v_missing_cache#>>array[v_transition.work_event_id::text,'exclude_cancel'])::boolean,false);
      v_cancel_basis:=case when v_exclude_cancel then v_missing_cache#>array[v_transition.work_event_id::text,'basis'] else null end;
      if v_exclude_cancel and (v_cancel_basis->>'previous_snapshot_line_id' is distinct from v_transition.prior_snapshot_id::text
        or v_cancel_basis->>'work_event_id' is distinct from v_transition.work_event_id::text) then
        raise exception 'WEEKLY_SOURCE_MISSING_CANCEL_PREWRITE_CENSUS_CHANGED' using errcode='40001';
      end if;
      v_transition_fingerprint:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_STATE_TRANSITION_V1',
        pg_catalog.jsonb_build_object(
          'final_revision_id',v_revision_id,'work_event_id',v_transition.work_event_id,
          'previous_snapshot_line_id',v_transition.prior_snapshot_id,
          'new_snapshot_line_id',v_transition.current_snapshot_id,
          'outcome',v_outcome,
          'prior_state_fingerprint',case when v_prior_state is null then null
            else pg_catalog.encode(v_prior_state,'hex') end,
          'new_state_fingerprint',case when v_current_state is null then null
            else pg_catalog.encode(v_current_state,'hex') end
        )||case when v_exclude_cancel then jsonb_build_object(
          'exclude_cancel',true,'cancel_exclusion_basis',v_cancel_basis) else '{}'::jsonb end
        ||case when jsonb_array_length(v_paid_source_rows)>0 and v_transition.current_snapshot_id=v_transition.prior_snapshot_id
          then jsonb_build_object('pay_basis_kind','RETAINED_PAID_MATCH','paid_match_source_rows',v_paid_source_rows) else '{}'::jsonb end
      );
      insert into public.weekly_source_state_transitions(
        final_revision_id,finalisation_cycle_id,source_profile_kind,work_event_id,
        previous_present,new_present,previous_snapshot_line_id,new_snapshot_line_id,
        outcome,identity_match_kind,match_confidence,prior_state_fingerprint,
        new_state_fingerprint,transition_fingerprint,exclude_cancel,cancel_exclusion_basis,
        ordinary_source_entitlement_projection_state,pay_basis_kind,paid_match_source_rows
      ) values (
        v_revision_id,v_cycle.id,v_source_profile_kind,v_transition.work_event_id,
        v_transition.prior_snapshot_id is not null,v_transition.current_snapshot_id is not null,
        v_transition.prior_snapshot_id,v_transition.current_snapshot_id,v_outcome,
        (select event.identity_kind from public.weekly_work_events event
          where event.id=v_transition.work_event_id),
        case when (select event.identity_kind from public.weekly_work_events event
          where event.id=v_transition.work_event_id)='PROFILE_EXTERNAL_KEY'
          then 'EXACT_PROFILE_KEY' else 'EXACT_DURABLE_LINEAGE' end,
        v_prior_state,v_current_state,v_transition_fingerprint,v_exclude_cancel,v_cancel_basis,
        case when v_outcome='NO_CHANGE' or v_exclude_cancel then 'NOT_APPLICABLE' else 'PENDING' end,
        case when jsonb_array_length(v_paid_source_rows)>0 and v_transition.current_snapshot_id=v_transition.prior_snapshot_id
          then 'RETAINED_PAID_MATCH' else 'CURRENT_SOURCE_SNAPSHOT' end,
        case when jsonb_array_length(v_paid_source_rows)>0 and v_transition.current_snapshot_id=v_transition.prior_snapshot_id
          then v_paid_source_rows else null end
      ) returning id into v_transition_id;
      v_transition_count:=v_transition_count+1;

      if v_outcome='NO_CHANGE' then
        v_unchanged_count:=v_unchanged_count+1;
        if jsonb_array_length(v_paid_source_rows)>0 and v_transition.current_snapshot_id=v_transition.prior_snapshot_id then
          continue; -- New genuine invoice companions are materialised below.
        end if;
        if v_transition.current_snapshot_id is not null and v_transition.prior_snapshot_id is not null and exists(select 1 from public.weekly_source_final_snapshot_lines current_line join public.weekly_source_final_snapshot_lines prior_line on prior_line.id=v_transition.prior_snapshot_id where current_line.id=v_transition.current_snapshot_id and current_line.external_event_identity is distinct from prior_line.external_event_identity) then
          if private.weekly_source_rebill_movement_insert_v1(v_transition_id,v_revision_id) is not null then v_movement_count:=v_movement_count+1; end if;
        else
          v_invoice_correction:=private.weekly_source_invoice_correction_insert_v1(v_transition_id,v_transition.work_event_id,v_revision_id);
          v_movement_count:=v_movement_count+coalesce((v_invoice_correction->>'movement_count')::integer,0);
        end if;
      else
        if v_outcome in ('AMEND','CANCEL') and not v_exclude_cancel then
          select movement.* into v_prior_movement
          from public.weekly_source_billing_movements movement
          join public.weekly_source_final_revisions movement_revision
            on movement_revision.id=movement.final_revision_id
          join public.weekly_source_cycles movement_cycle
            on movement_cycle.id=movement.finalisation_cycle_id
          where movement.work_event_id=v_transition.work_event_id
            and movement.source_profile_kind=v_source_profile_kind
            and movement.movement_role in ('POSITIVE','REPLACEMENT')
            and movement.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION')
            and movement.final_revision_id<>v_revision_id
            and movement_cycle.finalisation_week_ending<v_cycle.finalisation_week_ending
          order by movement_cycle.finalisation_week_ending desc,
                   movement_revision.finalised_at_utc desc,movement.created_at_utc desc,movement.id desc
          limit 1;
          if not found then
            raise exception 'WEEKLY_SOURCE_PRIOR_MOVEMENT_MISSING' using errcode='55000';
          end if;
          v_correction_unit_id:=pg_catalog.gen_random_uuid();
          v_movement_id:=private.weekly_source_finalisation_insert_reversal_v1(
            v_transition_id,v_revision_id,v_cycle.id,v_prior_movement.id,
            v_correction_unit_id,v_source_profile_kind,
            pg_catalog.jsonb_build_object(
              'schema_version','WEEKLY_SOURCE_GENERATED_REVERSAL_FACTS_V1',
              'outcome',v_outcome,'prior_snapshot_line_id',v_transition.prior_snapshot_id,
              'prior_movement_id',v_prior_movement.id,
              'correction_presentation',v_correction_presentation
            )
          );
          v_movement_count:=v_movement_count+1;
          if private.weekly_source_invoice_correction_unwind_v1(v_transition_id,v_transition.work_event_id,v_revision_id) is not null then v_movement_count:=v_movement_count+1; end if;
        else
          v_correction_unit_id:=null;
          v_prior_movement.id:=null;
        end if;
        if v_outcome in ('ADD','AMEND') then
          select resolution.id as resolution_id into strict v_row
          from public.weekly_source_row_resolutions resolution
          where resolution.id=v_current_snapshot.row_resolution_id;
          v_economic_id:=private.weekly_source_finalisation_economic_assert_v1(
            v_row.resolution_id,v_cycle.id,'HEALTHROSTER_WEEKLY'
          );
          v_timesheet_id:=private.weekly_source_finalisation_lineage_assert_v1(
            v_row.resolution_id,v_cycle.id
          );
          select * into strict v_economic
          from public.weekly_source_row_economic_snapshots where id=v_economic_id;
          v_invoice_amounts:=private.weekly_source_invoice_line_amounts_v1(v_row.resolution_id,v_revision_id);
          v_movement_id:=private.weekly_source_finalisation_insert_current_movement_v1(
            v_transition_id,null,v_revision_id,v_cycle.id,v_source_profile_kind,
            case when v_outcome='ADD' then 'POSITIVE' else 'REPLACEMENT' end,
            case when v_outcome='ADD' then 'SOURCE_ORDINARY' else 'SOURCE_REPLACEMENT' end,
            v_row.resolution_id,v_economic.id,v_timesheet_id,case when (v_invoice_amounts->>'source_amount')::boolean then (v_invoice_amounts->>'net_pence')::bigint else null end,
            (v_invoice_amounts->>'net_pence')::bigint,v_invoice_amounts->>'price_check_result',case when (v_invoice_amounts->>'source_amount')::boolean then v_economic.calculation_fingerprint else null end,
            nullif(v_invoice_amounts->>'charge_acceptance_id','')::uuid,
            pg_catalog.jsonb_build_object(
              'schema_version','WEEKLY_SOURCE_CURRENT_FACTS_V1','outcome',v_outcome,
              'snapshot_line_id',v_current_snapshot.id,
              'upload_row_id',v_current_snapshot.upload_row_id,
              'row_resolution_id',v_current_snapshot.row_resolution_id,
              'correction_presentation',v_correction_presentation
            ),v_correction_unit_id,
            case when v_outcome='AMEND' then v_prior_movement.id else null end
          );
          v_movement_count:=v_movement_count+1;
        end if;
      end if;

    end loop;

    for v_row in select companion.id from public.weekly_source_final_snapshot_lines companion
      where companion.final_revision_id=v_revision_id and companion.pay_effect='NONE'
      order by companion.upload_row_id,companion.id
    loop
      v_movement_id:=private.weekly_source_paid_match_invoice_movement_insert_v1(v_row.id,v_revision_id);
      if v_movement_id is not null then v_movement_count:=v_movement_count+1;end if;
      v_movement_id:=private.weekly_source_paid_match_expense_invoice_insert_v1(v_row.id,v_revision_id);
      if v_movement_id is not null then v_movement_count:=v_movement_count+1;end if;
    end loop;
    if v_profile.profile_code='ROSTER_WEEKLY_SUMMARY_ACTUAL_V1' then
      -- The profile can serve Clients with or without source-fixed expenses.
      -- A snapshot is mandatory exactly where the sealed effective policy
      -- enables that route, and forbidden otherwise.  This prevents both a
      -- missing configured expense and accidental contamination of ordinary
      -- evidence-led expenses.
      for v_row in
        select source_row.work_date,resolution.id as resolution_id,
               resolution.client_id,resolution.contract_id,
               resolution.effective_policy_fingerprint,
               expense_policy.id as expense_policy_snapshot_id
        from public.weekly_source_upload_rows source_row
        join public.weekly_source_row_resolutions resolution
          on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
        left join public.weekly_source_row_expense_policy_snapshots expense_policy
          on expense_policy.row_resolution_id=resolution.id
        where source_row.upload_id=v_upload.id
        order by source_row.source_row_ordinal
      loop
        v_effective_policy:=private._weekly_source_effective_policy_v1(
          v_row.client_id,v_row.contract_id,v_row.work_date
        );
        if (v_effective_policy->>'authority_mode') is distinct from 'SOURCE_AUTHORITY'
           or coalesce((v_effective_policy->>'self_bill_enabled')::boolean,false) is not true
           or (v_effective_policy->>'source_group_id')::uuid is distinct from v_group.id
           or private.weekly_source_finalisation_hex32_v1(
                v_effective_policy->>'policy_sha256','WEEKLY_SOURCE_POLICY_FINGERPRINT_INVALID'
              ) is distinct from v_row.effective_policy_fingerprint then
          raise exception 'WEEKLY_SOURCE_FINALISATION_POLICY_STALE' using errcode='40001';
        end if;
        if coalesce((v_effective_policy->>'source_fixed_expenses_enabled')::boolean,false) then
          if v_row.expense_policy_snapshot_id is null
             or private.weekly_source_finalisation_expense_policy_assert_v1(
                  v_row.resolution_id,v_cycle.id
                ) is distinct from v_row.expense_policy_snapshot_id then
            raise exception 'WEEKLY_SOURCE_EXPENSE_POLICY_SNAPSHOT_CARDINALITY'
              using errcode='55000';
          end if;
        elsif v_row.expense_policy_snapshot_id is not null then
          raise exception 'WEEKLY_SOURCE_EXPENSE_POLICY_NOT_ENABLED' using errcode='55000';
        end if;
      end loop;

      for v_expense_observation in
        with current_observation as (
          select expense_policy.id as expense_policy_snapshot_id,
                 expense_policy.row_resolution_id,expense_policy.work_event_id,
                 expense_policy.contract_id,expense_policy.source_expense_pence,
                 expense_policy.source_expense_vat_enabled,
                 expense_policy.correction_presentation
          from public.weekly_source_row_expense_policy_snapshots expense_policy
          join public.weekly_source_row_resolutions resolution
            on resolution.id=expense_policy.row_resolution_id
          join public.weekly_source_upload_rows source_row
            on source_row.id=resolution.upload_row_id
          where source_row.upload_id=v_upload.id and resolution.generation=v_generation
            and resolution.pay_effect='NORMAL'
        ), prior_authority as (
          select
                 case when p_prepare_only
                           and authority.final_revision_id=v_correction.expected_current_final_revision_id
                        then baseline.id else authority.id end as prior_authority_id,
                 authority.work_event_id,
                 case when p_prepare_only
                           and authority.final_revision_id=v_correction.expected_current_final_revision_id
                        then baseline.contract_id else authority.contract_id end as contract_id,
                 case when p_prepare_only
                           and authority.final_revision_id=v_correction.expected_current_final_revision_id
                        then baseline.source_expense_pence else authority.source_expense_pence end
                   as source_expense_pence,
                 case when p_prepare_only
                           and authority.final_revision_id=v_correction.expected_current_final_revision_id
                        then baseline.source_expense_vat_enabled
                        else authority.source_expense_vat_enabled end
                   as source_expense_vat_enabled,
                 case when p_prepare_only
                           and authority.final_revision_id=v_correction.expected_current_final_revision_id
                        then baseline.correction_presentation
                        else authority.correction_presentation end
                   as correction_presentation,
                 event.work_date
          from public.weekly_expense_authority_generations authority
          join public.weekly_work_events event on event.id=authority.work_event_id
          left join public.weekly_expense_authority_generations baseline
            on p_prepare_only
           and authority.final_revision_id=v_correction.expected_current_final_revision_id
           and baseline.id=authority.prior_expense_authority_generation_id
          where authority.state='CURRENT'
            and event.first_source_group_id=v_group.id
            and event.client_id=v_client_id
            and not (
              p_prepare_only
              and authority.final_revision_id=v_correction.expected_current_final_revision_id
              and baseline.id is null
            )
            and (
              event.work_date between v_coverage_start and v_coverage_end
              or exists(
                select 1 from current_observation current_match
                where current_match.work_event_id=authority.work_event_id
              )
            )
        )
        select coalesce(current_observation.work_event_id,prior_authority.work_event_id) as work_event_id,
               current_observation.expense_policy_snapshot_id,
               current_observation.row_resolution_id,
               current_observation.contract_id as current_contract_id,
               current_observation.source_expense_pence as current_expense_pence,
               current_observation.source_expense_vat_enabled as current_expense_vat_enabled,
               current_observation.correction_presentation as current_correction_presentation,
               prior_authority.prior_authority_id,
               prior_authority.contract_id as prior_contract_id,
               prior_authority.source_expense_pence as prior_expense_pence,
               prior_authority.source_expense_vat_enabled as prior_expense_vat_enabled,
               prior_authority.correction_presentation as prior_correction_presentation
        from current_observation
        full join prior_authority using(work_event_id)
        order by coalesce(current_observation.work_event_id,prior_authority.work_event_id)
      loop
        -- Explicit real Same rows preserve the genuine previous PAY expense
        -- basis. This is source-present invoice-only evidence, not an absent
        -- observation and not an invented zero/current expense generation.
        if exists(select 1 from public.weekly_source_final_snapshot_lines companion
          where companion.final_revision_id=v_revision_id and companion.work_event_id=v_expense_observation.work_event_id
            and companion.pay_effect='NONE' and companion.paid_overlap_choice_id=
              (v_paid_cache#>>array[companion.upload_row_id::text,'choice_id'])::bigint)
          and not exists(select 1 from public.weekly_source_final_snapshot_lines payable
            where payable.final_revision_id=v_revision_id and payable.work_event_id=v_expense_observation.work_event_id
              and payable.pay_effect='NORMAL') then
          continue;
        end if;
        -- A kept genuinely absent worked event keeps its existing expense
        -- authority too. No fabricated ROW_PRESENT or zero/recovery generation.
        if v_expense_observation.expense_policy_snapshot_id is null
          and coalesce((v_missing_cache#>>array[v_expense_observation.work_event_id::text,'exclude_cancel'])::boolean,false) then
          continue;
        end if;
        v_expense_policy_id:=v_expense_observation.expense_policy_snapshot_id;
        v_prior_expense_authority_id:=v_expense_observation.prior_authority_id;
        v_expense_authority_id:=null;
        v_expense_timesheet_id:=null;
        v_current_expense.id:=null;
        if v_expense_policy_id is not null then
          if private.weekly_source_finalisation_expense_policy_assert_v1(
               v_expense_observation.row_resolution_id,v_cycle.id
             ) is distinct from v_expense_policy_id then
            raise exception 'WEEKLY_SOURCE_EXPENSE_POLICY_SNAPSHOT_INVALID' using errcode='55000';
          end if;
          select * into strict v_expense_policy
          from public.weekly_source_row_expense_policy_snapshots
          where id=v_expense_policy_id;
          v_target_expense_pence:=v_expense_policy.source_expense_pence;
          v_target_expense_vat:=v_expense_policy.source_expense_vat_enabled;
          v_target_expense_contract_id:=v_expense_policy.contract_id;
          v_expense_observation_kind:='ROW_PRESENT';
          v_correction_presentation:=v_expense_policy.correction_presentation;
          if v_target_expense_pence>0 then
            perform public.weekly_source_timesheet_lineage_ensure_atomic_v1(
              v_expense_policy.row_resolution_id,v_actor
            );
            v_expense_timesheet_id:=private.weekly_source_finalisation_lineage_assert_v1(
              v_expense_policy.row_resolution_id,v_cycle.id
            );
          end if;
        else
          v_target_expense_pence:=0;
          v_target_expense_vat:=v_expense_observation.prior_expense_vat_enabled;
          v_target_expense_contract_id:=v_expense_observation.prior_contract_id;
          v_expense_observation_kind:='OMITTED_IN_COMPLETE_COVERAGE';
          v_correction_presentation:=v_expense_observation.prior_correction_presentation;
        end if;
        if v_prior_expense_authority_id is not null then
          select * into strict v_current_expense
          from public.weekly_expense_authority_generations expense
          where expense.id=v_prior_expense_authority_id
            and expense.state in ('CURRENT','SUPERSEDED')
            and expense.work_event_id=v_expense_observation.work_event_id
          for update;
        end if;
        if v_prior_expense_authority_id is null
           or v_current_expense.source_expense_pence is distinct from v_target_expense_pence
           or v_current_expense.source_expense_vat_enabled is distinct from v_target_expense_vat
           or v_current_expense.contract_id is distinct from v_target_expense_contract_id
           or v_current_expense.source_observation_kind is distinct from v_expense_observation_kind then
          if v_prior_expense_authority_id is not null then
            if not p_prepare_only then
              update public.weekly_expense_authority_generations
              set state='SUPERSEDED' where id=v_prior_expense_authority_id;
            end if;
          end if;
          select coalesce(pg_catalog.max(expense.generation),0)+1 into v_expense_generation
          from public.weekly_expense_authority_generations expense
          where expense.work_event_id=v_expense_observation.work_event_id;
          v_expense_hash:=private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_SOURCE_EXPENSE_AUTHORITY_GENERATION_V1',
            pg_catalog.jsonb_build_object(
              'final_revision_id',v_revision_id,
              'work_event_id',v_expense_observation.work_event_id,
              'contract_id',v_target_expense_contract_id,
              'row_expense_policy_snapshot_id',v_expense_policy_id,
              'prior_expense_authority_generation_id',v_prior_expense_authority_id,
              'generation',v_expense_generation,
              'source_observation_kind',v_expense_observation_kind,
              'correction_presentation',v_correction_presentation,
              'source_expense_pence',v_target_expense_pence,
              'source_expense_vat_enabled',v_target_expense_vat
            )
          );
          insert into public.weekly_expense_authority_generations(
            final_revision_id,work_event_id,contract_id,row_expense_policy_snapshot_id,
            prior_expense_authority_generation_id,generation,source_observation_kind,
            correction_presentation,source_expense_pence,source_expense_vat_enabled,
            candidate_reimbursement_ex_vat,client_charge_ex_vat,authority_hash,state
          ) values (
            v_revision_id,v_expense_observation.work_event_id,v_target_expense_contract_id,
            v_expense_policy_id,v_prior_expense_authority_id,v_expense_generation,
            v_expense_observation_kind,v_correction_presentation,v_target_expense_pence,
            v_target_expense_vat,v_target_expense_pence::numeric/100,
            v_target_expense_pence::numeric/100,v_expense_hash,
            case when p_prepare_only then 'PREPARED' else 'CURRENT' end
          ) returning id into v_expense_authority_id;
          v_expense_movement_result:=
            private.weekly_source_finalisation_materialise_expense_invoice_v1(
              v_revision_id,v_cycle.id,v_source_profile_kind,
              v_expense_authority_id,v_prior_expense_authority_id,
              v_expense_policy_id,v_expense_timesheet_id,
              v_correction_presentation
            );
          v_movement_count:=v_movement_count+
            coalesce((v_expense_movement_result->>'movement_count')::integer,0);
          v_expense_generation_count:=v_expense_generation_count+1;
        end if;
        v_current_expense.id:=null;
      end loop;
    end if;
  else
    v_source_total_cost:=0;
    v_source_commission:=0;
    v_source_invoice_total:=0;
    v_line_count:=0;
    for v_row in
      select source_row.*,resolution.id as resolution_id,
             resolution.work_event_id,resolution.candidate_id,resolution.client_id,
             resolution.contract_id
      from public.weekly_source_upload_rows source_row
      join public.weekly_source_row_resolutions resolution
        on resolution.upload_row_id=source_row.id and resolution.generation=v_generation
      where source_row.upload_id=v_upload.id
      order by source_row.source_row_ordinal
    loop
      v_economic_id:=private.weekly_source_finalisation_economic_assert_v1(
        v_row.resolution_id,v_cycle.id,'NHSP_WEEKLY'
      );
      v_timesheet_id:=private.weekly_source_finalisation_lineage_assert_v1(
        v_row.resolution_id,v_cycle.id
      );
      select * into strict v_economic
      from public.weekly_source_row_economic_snapshots where id=v_economic_id;
      v_nhsp_price_admission:=private.weekly_source_nhsp_price_admission_v1(v_row.resolution_id,v_cycle.id);
      v_charge_check:=pg_catalog.jsonb_populate_record(null::public.weekly_source_charge_checks,v_nhsp_price_admission->'charge_check');
      v_charge_acceptance:=pg_catalog.jsonb_populate_record(null::public.weekly_source_charge_acceptances,v_nhsp_price_admission->'charge_acceptance');
      v_price_admission_result:=v_nhsp_price_admission->>'price_admission_result';
      v_movement_id:=private.weekly_source_finalisation_insert_current_movement_v1(
        null,v_row.id,v_revision_id,v_cycle.id,'NHSP_TRUST_BACKING_REPORT',
        case when v_economic.row_sign=1 then 'POSITIVE' else 'REVERSAL' end,
        case when v_economic.row_sign=1
          then 'NHSP_PHYSICAL_POSITIVE' else 'NHSP_PHYSICAL_FULL_NEGATIVE' end,
        v_row.resolution_id,v_economic.id,v_timesheet_id,
        v_row.source_shift_charge_pence,v_row.source_shift_charge_pence,
        v_price_admission_result,v_charge_check.charge_calculation_fingerprint,
        v_charge_acceptance.id,
        pg_catalog.jsonb_build_object(
          'schema_version','WEEKLY_SOURCE_NHSP_PHYSICAL_FACTS_V1',
          'backing_report_number',v_backing_report_number,
          'report_scope_id',v_report_scope_id,'source_row_ordinal',v_row.source_row_ordinal,
          'upload_row_id',v_row.id,'row_resolution_id',v_row.resolution_id,
          'work_date',v_row.work_date,'start_at_local',v_row.start_at_local,
          'end_at_local',v_row.end_at_local,'break_minutes',v_row.break_minutes,
          'actual_net_minutes',v_row.actual_net_minutes,
          'source_commission_pence',v_row.source_commission_pence,
          'source_total_cost_pence',v_row.source_total_cost_pence,
          'source_shift_charge_pence',v_row.source_shift_charge_pence,
          'calculated_comparison_charge_pence',v_economic.calculated_charge_pence,
          'comparison_result',v_charge_check.comparison_result,
          'price_admission_result',v_price_admission_result,
          'charge_acceptance_id',v_charge_acceptance.id,
          'physical_sign',case when v_economic.row_sign=1
            then 'POSITIVE' else 'FULL_NEGATIVE' end
        ),null,null
      );
      v_source_total_cost:=v_source_total_cost+v_row.source_total_cost_pence;
      v_source_commission:=v_source_commission+v_row.source_commission_pence;
      v_source_invoice_total:=v_source_invoice_total+v_row.source_shift_charge_pence;
      v_line_count:=v_line_count+1;
      v_movement_count:=v_movement_count+1;
    end loop;
    if v_line_count<>v_upload.accepted_count
       or v_source_invoice_total<>v_source_total_cost+v_source_commission then
      raise exception 'WEEKLY_SOURCE_NHSP_REPORT_TOTAL_INVALID' using errcode='55000';
    end if;
    insert into public.weekly_source_nhsp_backing_reports(
      report_scope_id,final_revision_id,upload_id,client_id,backing_report_number,
      cutoff_at_utc,physical_line_count,source_total_cost_pence,
      source_commission_pence,source_invoice_total_pence,row_manifest_hash
    ) values (
      v_report_scope_id,v_revision_id,v_upload.id,v_client_id,v_backing_report_number,
      v_scope.cutoff_at_utc,v_line_count,v_source_total_cost,v_source_commission,
      v_source_invoice_total,v_upload.row_manifest_hash
    );
  end if;

  for v_round_scope in select distinct movement.actual_client_id client_id,
      private.weekly_source_invoice_movement_window_id_v1(movement.id) invoice_window_cycle_id
    from public.weekly_source_billing_movements movement where movement.final_revision_id=v_revision_id
      and movement.source_line_kind<>'INVOICE_VAT_ROUNDING'
    order by client_id,invoice_window_cycle_id
  loop
    if not(v_round_scope.invoice_window_cycle_id=any(v_invoice_window_ids)) then
      raise exception 'WEEKLY_SOURCE_INVOICE_WINDOW_SET_GREW_AFTER_LOCK' using errcode='40001'; end if;
    v_round_id:=private.weekly_source_vat_rounding_movement_insert_v1(v_revision_id,v_round_scope.client_id,null,v_round_scope.invoice_window_cycle_id);
    if v_round_id is not null then v_movement_count:=v_movement_count+1; end if;
  end loop;
  for v_manifest in
    select scope.client_id,scope.invoice_window_cycle_id,actual.finalisation_week_ending as invoice_week_ending
    from (select movement.actual_client_id as client_id,
      private.weekly_source_invoice_movement_window_id_v1(movement.id) as invoice_window_cycle_id
      from public.weekly_source_billing_movements movement where movement.final_revision_id=v_revision_id
      union select v_client_id,v_cycle.id) scope
    join public.weekly_source_cycles actual on actual.id=scope.invoice_window_cycle_id
    where scope.client_id is not null order by scope.client_id,scope.invoice_window_cycle_id
  loop
    select private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_CLIENT_MANIFEST_V1',
      pg_catalog.jsonb_build_object(
        'final_revision_id',v_revision_id,'source_group_id',v_group.id,
        'source_cycle_id',v_cycle.id,'client_id',v_manifest.client_id,
        'finalisation_week_ending',v_manifest.invoice_week_ending,
        'backing_report_number',v_backing_report_number,
        'movements',coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
          'movement_id',movement.id,
          'movement_economic_hash',pg_catalog.encode(movement.movement_economic_hash,'hex')
        ) order by pg_catalog.encode(movement.movement_economic_hash,'hex')),
        '[]'::jsonb),
        'expense_authorities',coalesce((
          select pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
            'expense_authority_generation_id',expense.id,
            'authority_hash',pg_catalog.encode(expense.authority_hash,'hex')
          ) order by pg_catalog.encode(expense.authority_hash,'hex'))
          from public.weekly_expense_authority_generations expense
          join public.weekly_work_events event on event.id=expense.work_event_id
          where expense.final_revision_id=v_revision_id and event.client_id=v_manifest.client_id
            and v_manifest.invoice_window_cycle_id=v_cycle.id
        ),'[]'::jsonb)
      )||case when v_manifest.invoice_window_cycle_id=v_cycle.id then '{}'::jsonb else jsonb_build_object('invoice_window_cycle_id',v_manifest.invoice_window_cycle_id) end
      ||case when v_rule_version is null then '{}'::jsonb else jsonb_build_object('rule_set_version_id',v_rule_version,'rule_set_values_sha256',v_rule_set->>'values_sha256') end
    ) into v_client_manifest_hash
    from public.weekly_source_billing_movements movement
    where movement.final_revision_id=v_revision_id
      and movement.actual_client_id=v_manifest.client_id
      and private.weekly_source_invoice_movement_window_id_v1(movement.id)=v_manifest.invoice_window_cycle_id;
    insert into public.weekly_source_client_manifests(
      final_revision_id,source_group_id,source_cycle_id,invoice_window_cycle_id,client_id,
      finalisation_week_ending,backing_report_number,manifest_hash,movement_count,
      unchanged_snapshot_count,expense_line_count,invoice_state
    ) values (
      v_revision_id,v_group.id,v_cycle.id,case when v_manifest.invoice_window_cycle_id=v_cycle.id then null else v_manifest.invoice_window_cycle_id end,v_manifest.client_id,
      v_manifest.invoice_week_ending,v_backing_report_number,v_client_manifest_hash,
      (select pg_catalog.count(*)::integer
       from public.weekly_source_billing_movements movement
       where movement.final_revision_id=v_revision_id
         and movement.actual_client_id=v_manifest.client_id
         and private.weekly_source_invoice_movement_window_id_v1(movement.id)=v_manifest.invoice_window_cycle_id),
      (select pg_catalog.count(*)::integer
       from public.weekly_source_state_transitions transition_row
       join public.weekly_source_final_snapshot_lines snapshot_line
         on snapshot_line.id=transition_row.new_snapshot_line_id
       where transition_row.final_revision_id=v_revision_id
         and transition_row.outcome='NO_CHANGE'
         and snapshot_line.client_id=v_manifest.client_id
         and v_manifest.invoice_window_cycle_id=v_cycle.id),
      (select pg_catalog.count(*)::integer
       from public.weekly_expense_authority_generations expense
       join public.weekly_work_events event on event.id=expense.work_event_id
       where expense.final_revision_id=v_revision_id
         and event.client_id=v_manifest.client_id
         and v_manifest.invoice_window_cycle_id=v_cycle.id),
      'READY'
    ) returning id into v_client_manifest_id;
    insert into public.weekly_source_manifest_movements(
      client_manifest_id,billing_movement_id,manifest_ordinal,movement_hash
    )
    select v_client_manifest_id,movement.id,
           pg_catalog.row_number() over(
             order by pg_catalog.encode(movement.movement_economic_hash,'hex')
           )::integer,
           movement.movement_economic_hash
    from public.weekly_source_billing_movements movement
    where movement.final_revision_id=v_revision_id
      and movement.actual_client_id=v_manifest.client_id
      and private.weekly_source_invoice_movement_window_id_v1(movement.id)=v_manifest.invoice_window_cycle_id;
  end loop;


  if v_finalisation_lock_operation is not null then
    -- Includes the later positive-expense lineage calls. Advisory/row locks
    -- remain transaction-held; remove only this operation's working copies.
    perform private.bpay_next_source_current_lock_release_v1(v_finalisation_lock_operation);
  end if;
  if v_finalisation_lock_context then
    perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_lock_operation',v_prior_finalisation_lock_operation,true);
    perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_root_set',v_prior_finalisation_root_set,true);
  end if;

  if p_prepare_only then
    perform set_config('cloudtms.weekly_source_missing_cancel_frame',v_prior_missing_cancel_frame,true);
    return pg_catalog.jsonb_build_object(
      'ok',true,'status','PREPARED','idempotent',false,
      'final_revision_id',v_revision_id,'source_cycle_id',v_cycle.id,
      'authority_scope_kind',v_scope_kind,'report_scope_id',v_report_scope_id,
      'upload_id',v_upload.id,'profile_code',v_profile.profile_code,
      'client_id',v_client_id,'snapshot_count',v_snapshot_count,
      'transition_count',v_transition_count,'movement_count',v_movement_count,
      'unchanged_count',v_unchanged_count,
      'expense_generation_count',v_expense_generation_count
    );
  end if;

  update public.weekly_source_client_cycle_completions completion
  set state='SUPERSEDED',superseded_at_utc=v_finalised_at
  where completion.source_cycle_id=v_cycle.id
    and completion.client_id=v_client_id and completion.state='CURRENT';
  select coalesce(pg_catalog.max(completion.completion_generation),0)+1
  into v_completion_generation
  from public.weekly_source_client_cycle_completions completion
  where completion.source_cycle_id=v_cycle.id and completion.client_id=v_client_id;
  v_completion_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_CLIENT_CYCLE_COMPLETION_V1',
    pg_catalog.jsonb_build_object(
      'source_cycle_id',v_cycle.id,'source_group_id',v_group.id,
      'client_id',v_client_id,'completion_generation',v_completion_generation,
      'completion_kind','FINAL_SOURCE','final_revision_id',v_revision_id,
      'actor_user_id',v_actor
    )
  );
  insert into public.weekly_source_client_cycle_completions(
    source_cycle_id,source_group_id,client_id,completion_generation,
    completion_kind,final_revision_id,attested_by_user_id,attested_at_utc,
    attestation_text,completion_hash,state
  ) values (
    v_cycle.id,v_group.id,v_client_id,v_completion_generation,
    'FINAL_SOURCE',v_revision_id,v_actor,v_finalised_at,null,v_completion_hash,'CURRENT'
  );

  if v_scope_kind='CYCLE' then
    update public.weekly_source_cycles
    set current_final_revision_id=v_revision_id,state='FINALISED',
        finalised_at_utc=v_finalised_at,finalised_by_user_id=v_actor
    where id=v_cycle.id and current_complete_upload_id=v_upload.id
      and current_projection_publication_id=v_publication.id
      and version=v_scope_version and current_final_revision_id is null;
    if not found then
      raise exception 'WEEKLY_SOURCE_FINALISE_CAS_LOST' using errcode='40001';
    end if;
  else
    update public.weekly_source_report_scopes
    set current_final_revision_id=v_revision_id,state='FINALISED',
        updated_at_utc=v_finalised_at
    where id=v_scope.id and current_complete_upload_id=v_upload.id
      and current_projection_publication_id=v_publication.id
      and version=v_scope_version and current_final_revision_id is null;
    if not found then
      raise exception 'WEEKLY_SOURCE_FINALISE_CAS_LOST' using errcode='40001';
    end if;
    if not exists(
      select 1
      from public.weekly_source_group_clients membership
      where membership.source_group_id=v_group.id
        and v_cycle.finalisation_week_ending between membership.valid_from
          and coalesce(membership.valid_to,'infinity'::date)
        and not exists(
          select 1
          from public.weekly_source_client_cycle_completions completion
          where completion.source_cycle_id=v_cycle.id
            and completion.client_id=membership.client_id
            and completion.state='CURRENT'
        )
    ) then
      update public.weekly_source_cycles
      set state='FINALISED',finalised_at_utc=v_finalised_at,
          finalised_by_user_id=v_actor
      where id=v_cycle.id;
    else
      update public.weekly_source_cycles
      set state='FINALISABLE'
      where id=v_cycle.id and state in ('OPEN','FINALISABLE');
    end if;
  end if;

  -- Only this genuine new CURRENT transition may resolve contained manual
  -- queries. PREPARED and retained Final replay returned earlier. Query-only
  -- resolution shares this transaction; it never changes frozen pay or money.
  perform private.weekly_source_manual_reviews_finalised_v1(v_revision_id,v_actor);

  -- PREPARED returned above and remains invisible. Capture only AFTER the
  -- real cycle/report CURRENT CAS; any failure rolls back Source and selector
  -- together. The same immutable economic/lineage facts remain authoritative.
  if coalesce(v_next_source_hooks,false) then
    perform private.bpay_next_source_current_publish_revision_v1(v_revision_id);
  end if;

  if p_correction_session_id is null and exists(
    select 1
    from public.weekly_source_cycles cycle
    where cycle.id=v_cycle.id and cycle.state='FINALISED'
  ) then
    perform private._weekly_source_settings_ensure_open_cycle_v1(
      v_group.id,v_finalised_at
    );
  end if;

  perform set_config('cloudtms.weekly_source_missing_cancel_frame',v_prior_missing_cancel_frame,true);
  return pg_catalog.jsonb_build_object(
    'ok',true,'status',case when p_correction_session_id is null
      then 'FINALISED' else 'CORRECTED' end,'idempotent',false,
    'final_revision_id',v_revision_id,'source_cycle_id',v_cycle.id,
    'authority_scope_kind',v_scope_kind,'report_scope_id',v_report_scope_id,
    'upload_id',v_upload.id,'profile_code',v_profile.profile_code,
    'client_id',v_client_id,'snapshot_count',v_snapshot_count,
    'transition_count',v_transition_count,'movement_count',v_movement_count,
    'unchanged_count',v_unchanged_count,
    'expense_generation_count',v_expense_generation_count
  );
exception
  when invalid_text_representation or numeric_value_out_of_range or datetime_field_overflow then
    perform set_config('cloudtms.weekly_source_missing_cancel_frame',v_prior_missing_cancel_frame,true);
    -- The function subtransaction already rolled back Source/cache/control
    -- writes on entry to this handler. Restore only the caller's exact GUCs.
    if v_finalisation_lock_context then
      perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_lock_operation',v_prior_finalisation_lock_operation,true);
      perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_root_set',v_prior_finalisation_root_set,true);
    end if;
    raise exception 'WEEKLY_SOURCE_FINALISE_VALUE_INVALID' using errcode='22023';
  when others then
    perform set_config('cloudtms.weekly_source_missing_cancel_frame',v_prior_missing_cancel_frame,true);
    if v_finalisation_lock_context then
      perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_lock_operation',v_prior_finalisation_lock_operation,true);
      perform pg_catalog.set_config('cloudtms.weekly_source_finalisation_root_set',v_prior_finalisation_root_set,true);
    end if;
    raise;
end;
$function$;

create or replace function private.weekly_source_paid_choice_revision_guard_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
begin
  if tg_table_schema is distinct from 'public' or tg_table_name is distinct from 'weekly_source_final_revisions' then
    raise exception 'WEEKLY_SOURCE_PAID_CHOICE_REVISION_GUARD_TARGET_INVALID' using errcode='55000';end if;
  if tg_op='UPDATE' then
    if old.paid_overlap_choice_census is distinct from new.paid_overlap_choice_census then
      raise exception 'WEEKLY_SOURCE_PAID_CHOICE_REVISION_CENSUS_IMMUTABLE' using errcode='55000';end if;
    return new;
  elsif tg_op='DELETE' then
    if old.paid_overlap_choice_census is distinct from '{}'::jsonb then
      raise exception 'WEEKLY_SOURCE_PAID_CHOICE_REVISION_CENSUS_IMMUTABLE' using errcode='55000';end if;
    return old;
  elsif tg_op='TRUNCATE' then
    if exists(select 1 from public.weekly_source_final_revisions r where r.paid_overlap_choice_census is distinct from '{}'::jsonb) then
      raise exception 'WEEKLY_SOURCE_PAID_CHOICE_REVISION_CENSUS_IMMUTABLE' using errcode='55000';end if;
    return null;
  end if;
  raise exception 'WEEKLY_SOURCE_PAID_CHOICE_REVISION_GUARD_OPERATION_INVALID' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_paid_match_invoice_movement_insert_v1(
  p_snapshot_line_id uuid,p_final_revision_id uuid
) returns uuid language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  s public.weekly_source_final_snapshot_lines%rowtype;r public.weekly_source_row_resolutions%rowtype;
  e public.weekly_source_row_economic_snapshots%rowtype;revision public.weekly_source_final_revisions%rowtype;
  choice private.weekly_source_office_row_choices%rowtype;cycle public.weekly_source_cycles%rowtype;
  proof jsonb;rules jsonb;amounts jsonb;facts jsonb;pay jsonb;charge jsonb;state jsonb;
  mapping bytea;h bytea;id uuid;ts uuid;net bigint;vat bigint;window_id uuid;window_scope jsonb;
begin
  select * into strict revision from public.weekly_source_final_revisions where weekly_source_final_revisions.id=p_final_revision_id;
  select * into strict s from public.weekly_source_final_snapshot_lines where weekly_source_final_snapshot_lines.id=p_snapshot_line_id;
  select * into strict r from public.weekly_source_row_resolutions where weekly_source_row_resolutions.id=s.row_resolution_id;
  select * into strict choice from private.weekly_source_office_row_choices where weekly_source_office_row_choices.id=s.paid_overlap_choice_id;
  select * into strict cycle from public.weekly_source_cycles where weekly_source_cycles.id=revision.source_cycle_id;
  proof:=revision.paid_overlap_choice_census->s.upload_row_id::text;
  if revision.state not in ('CURRENT','PREPARED') or revision.authority_scope_kind<>'CYCLE' or revision.report_scope_id is not null
    or s.final_revision_id is distinct from revision.id or s.pay_effect<>'NONE' or r.pay_effect<>'NONE'
    or r.mapping_state<>'RESOLVED' or r.upload_row_id is distinct from s.upload_row_id
    or r.work_event_id is distinct from s.work_event_id or r.candidate_id is distinct from s.candidate_id
    or r.client_id is distinct from s.client_id or r.contract_id is distinct from s.contract_id
    or r.paid_overlap_choice_id is distinct from choice.id or choice.pay_effect<>'NONE'
    or choice.work_event_id is distinct from s.work_event_id or choice.paid_overlap_target_work_event_id is distinct from s.work_event_id
    or choice.upload_row_id is distinct from s.upload_row_id or choice.candidate_id is distinct from s.candidate_id
    or choice.client_id is distinct from s.client_id or choice.contract_id is distinct from s.contract_id
    or proof->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1'
    or proof->>'choice_id' is distinct from choice.id::text or proof->>'pay_effect' is distinct from 'NONE'
    or proof->>'choice_proof_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1',proof-'choice_proof_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_INVOICE_ORIGIN_UNBOUND' using errcode='55000';end if;
  if not exists(select 1 from public.weekly_source_upload_rows row where row.id=s.upload_row_id
    and row.upload_id=revision.upload_id and row.row_finalisation_state='SOURCE_WORKED'
    and row.normalised_row_hash=s.source_fingerprint and row.work_date=s.work_date
    and row.start_at_local=s.start_at_local and row.end_at_local=s.end_at_local and row.break_minutes=s.break_minutes) then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_INVOICE_SOURCE_UNBOUND' using errcode='55000';end if;
  rules:=private.weekly_source_frozen_rule_values_v1(revision.id);
  -- Report membership is handled by its actual Report row/binding owner.
  -- A companion never supplies a fabricated Report line or pay witness.
  if rules is null or rules->>'invoice_sender' is distinct from 'CLIENT_SELF_BILL'
    or rules->>'self_bill_source' is distinct from 'SAME_FILE' then return null;end if;
  window_id:=revision.source_cycle_id;
  if rules->>'invoice_membership'='FINALISED_IN_CYCLE_WINDOW' then
    window_id:=private.weekly_source_invoice_window_cycle_v1(s.upload_row_id,cycle.source_group_id);
    if window_id is null then return null;end if;
    window_scope:=private.weekly_source_invoice_window_scope_v1(revision.source_cycle_id,s.client_id,s.upload_row_id,window_id);
  end if;
  select m.id into id from public.weekly_source_billing_movements m where m.invoice_only_snapshot_line_id=s.id and m.source_line_kind='SOURCE_REBILL_LINE';
  if found then
    perform private.weekly_source_paid_match_invoice_origin_assert_v1(id);
    return id;
  end if;
  select * into strict e from public.weekly_source_row_economic_snapshots where row_resolution_id=r.id;
  ts:=private.weekly_source_finalisation_lineage_assert_v1(r.id,revision.source_cycle_id);
  amounts:=private.weekly_source_invoice_line_amounts_v1(r.id,revision.id);
  net:=(amounts->>'net_pence')::bigint;vat:=(amounts->>'vat_pence')::bigint;
  pay:=private.weekly_source_invoice_only_vector_v1('PAY',0);
  charge:=private.weekly_source_invoice_only_vector_v1('CHARGE',net);
  mapping:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_MAPPING_RATE_POLICY_V1',jsonb_build_object(
    'row_resolution_id',r.id,'work_event_id',r.work_event_id,'candidate_id',r.candidate_id,'client_id',r.client_id,'contract_id',r.contract_id,
    'contract_and_rate_fingerprint',encode(e.contract_and_rate_fingerprint,'hex'),'effective_policy_fingerprint',encode(e.effective_policy_fingerprint,'hex'),
    'invoice_vat_policy_fingerprint',encode(e.invoice_vat_policy_fingerprint,'hex'),'calculation_fingerprint',encode(e.calculation_fingerprint,'hex')));
  facts:=jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_MATCH_INVOICE_FACTS_V1',
    'snapshot_line_id',s.id,'snapshot_line_hash',encode(s.snapshot_line_hash,'hex'),'upload_row_id',s.upload_row_id,
    'bound_row_resolution_id',r.id,'paid_overlap_choice_id',choice.id,'paid_overlap_choice_proof',proof,
    'rule_set_version_id',revision.rule_set_version_id,'pay_effect','NONE',
    'invoice_hold',amounts->'invoice_hold','hold_release_id',amounts->'hold_release_id',
    'invoice_window_cycle_id',window_id,'invoice_window_scope',window_scope);
  state:=jsonb_build_object('invoice_only_snapshot_line_id',s.id,'pay_effect','NONE','final_revision_id',revision.id,
    'finalisation_cycle_id',revision.source_cycle_id,'actual_client_id',r.client_id,'candidate_id',r.candidate_id,
    'contract_id',r.contract_id,'work_event_id',r.work_event_id,'movement_role','POSITIVE','source_profile_kind',s.source_profile_kind,
    'source_line_kind','SOURCE_REBILL_LINE','source_facts',facts,'pay_vector',pay,'charge_vector',charge,'total_pay_pence',0,
    'calculated_comparison_charge_pence',e.calculated_charge_pence,'source_validation_charge_pence',case when (amounts->>'source_amount')::boolean then net else null end,
    'invoice_presentation_charge_pence',net,'vat_rate_pct',(amounts->>'vat_rate_pct')::numeric(5,2),'vat_amount',(vat::numeric/100)::numeric(12,2),
    'total_inc_vat',((net+vat)::numeric/100)::numeric(12,2),'price_check_result',amounts->>'price_check_result',
    'price_check_fingerprint',case when (amounts->>'source_amount')::boolean then encode(e.calculation_fingerprint,'hex') else null end,
    'charge_acceptance_id',amounts->'charge_acceptance_id','mapping_rate_policy_fingerprint',encode(mapping,'hex'),'invoice_timesheet_id',ts);
  h:=private.weekly_source_billing_movement_hash_v1(state);
  insert into public.weekly_source_billing_movements(invoice_only_snapshot_line_id,pay_effect,final_revision_id,finalisation_cycle_id,
    actual_client_id,candidate_id,contract_id,work_event_id,movement_role,source_profile_kind,source_line_kind,
    source_facts_json,canonical_pay_vector_json,canonical_charge_vector_json,total_pay_ex_vat,calculated_comparison_charge_pence,
    source_validation_charge_pence,invoice_presentation_charge_pence,vat_rate_pct,vat_amount,total_inc_vat,price_check_result,
    price_check_fingerprint,charge_acceptance_id,mapping_rate_policy_fingerprint,invoice_timesheet_id,original_cycle_key,movement_economic_hash)
  values(s.id,'NONE',revision.id,revision.source_cycle_id,r.client_id,r.candidate_id,r.contract_id,r.work_event_id,'POSITIVE',s.source_profile_kind,
    'SOURCE_REBILL_LINE',facts,pay,charge,0,e.calculated_charge_pence,case when (amounts->>'source_amount')::boolean then net else null end,
    net,(amounts->>'vat_rate_pct')::numeric,vat::numeric/100,(net+vat)::numeric/100,amounts->>'price_check_result',
    case when (amounts->>'source_amount')::boolean then e.calculation_fingerprint else null end,
    nullif(amounts->>'charge_acceptance_id','')::uuid,mapping,ts,revision.source_cycle_id::text,h)
  returning public.weekly_source_billing_movements.id into id;
  perform private.weekly_source_paid_match_invoice_origin_assert_v1(id);
  return id;
end;
$function$;

create or replace function private.weekly_source_paid_match_invoice_origin_assert_v1(p_movement_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare m public.weekly_source_billing_movements%rowtype;s public.weekly_source_final_snapshot_lines%rowtype;
  r public.weekly_source_row_resolutions%rowtype;e public.weekly_source_row_economic_snapshots%rowtype;
  revision public.weekly_source_final_revisions%rowtype;row public.weekly_source_upload_rows%rowtype;
  choice private.weekly_source_office_row_choices%rowtype;proof jsonb;facts jsonb;state jsonb;mapping bytea;
  audit_count integer;ts uuid;expected_snapshot_hash bytea;
begin
  select * into strict m from public.weekly_source_billing_movements where id=p_movement_id;
  if m.pay_effect='NONE' and m.source_profile_kind='NHSP_TRUST_BACKING_REPORT' and m.nhsp_upload_row_id is not null then
    return private.weekly_source_nhsp_none_invoice_origin_assert_v1(m.id);
  end if;
  if m.invoice_only_snapshot_line_id is not null and m.source_line_kind='SOURCE_FIXED_EXPENSE' then
    return private.weekly_source_paid_match_expense_invoice_origin_assert_v1(m.id);
  end if;
  if m.pay_effect<>'NONE' or m.invoice_only_snapshot_line_id is null or m.transition_id is not null
    or m.nhsp_upload_row_id is not null or m.self_bill_report_row_id is not null or m.vat_rounding_revision_id is not null
    or m.expense_authority_generation_id is not null or m.movement_role<>'POSITIVE' or m.source_line_kind<>'SOURCE_REBILL_LINE'
    or m.source_profile_kind not in ('HEALTHROSTER_ACTUAL_ROWS','GENERIC_COMPLETE_SNAPSHOT') then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_INVOICE_ORIGIN_UNBOUND' using errcode='55000';end if;
  select * into strict s from public.weekly_source_final_snapshot_lines where id=m.invoice_only_snapshot_line_id;
  select * into strict revision from public.weekly_source_final_revisions where id=m.final_revision_id;
  select * into strict r from public.weekly_source_row_resolutions where id=s.row_resolution_id;
  select * into strict e from public.weekly_source_row_economic_snapshots where row_resolution_id=r.id;
  select * into strict row from public.weekly_source_upload_rows where id=s.upload_row_id;
  select * into strict choice from private.weekly_source_office_row_choices where id=s.paid_overlap_choice_id;
  proof:=revision.paid_overlap_choice_census->s.upload_row_id::text;facts:=m.source_facts_json;
  if revision.authority_scope_kind<>'CYCLE' or revision.report_scope_id is not null
    or m.finalisation_cycle_id is distinct from revision.source_cycle_id or s.final_revision_id is distinct from revision.id
    or row.upload_id is distinct from revision.upload_id or row.row_finalisation_state<>'SOURCE_WORKED'
    or row.id is distinct from r.upload_row_id or s.source_fingerprint is distinct from row.normalised_row_hash
    or s.work_date is distinct from row.work_date or s.start_at_local is distinct from row.start_at_local
    or s.end_at_local is distinct from row.end_at_local or s.break_minutes is distinct from row.break_minutes
    or s.pay_effect<>'NONE' or r.pay_effect<>'NONE' or r.mapping_state<>'RESOLVED'
    or r.paid_overlap_choice_id is distinct from choice.id or choice.pay_effect<>'NONE'
    or choice.upload_row_id is distinct from row.id or choice.work_event_id is distinct from s.work_event_id
    or choice.paid_overlap_target_work_event_id is distinct from s.work_event_id
    or choice.candidate_id is distinct from s.candidate_id or choice.client_id is distinct from s.client_id
    or choice.contract_id is distinct from s.contract_id
    or r.work_event_id is distinct from s.work_event_id or r.candidate_id is distinct from s.candidate_id
    or r.client_id is distinct from s.client_id or r.contract_id is distinct from s.contract_id
    or m.work_event_id is distinct from s.work_event_id or m.candidate_id is distinct from s.candidate_id
    or m.actual_client_id is distinct from s.client_id or m.contract_id is distinct from s.contract_id
    or proof->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1'
    or proof->>'choice_id' is distinct from choice.id::text or proof->>'pay_effect' is distinct from 'NONE'
    or proof->>'choice_proof_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1',proof-'choice_proof_sha256'),'hex')
    or facts->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_MATCH_INVOICE_FACTS_V1'
    or facts->>'snapshot_line_id' is distinct from s.id::text or facts->>'snapshot_line_hash' is distinct from encode(s.snapshot_line_hash,'hex')
    or facts->>'upload_row_id' is distinct from row.id::text or facts->>'bound_row_resolution_id' is distinct from r.id::text
    or facts ? 'row_resolution_id' or facts->>'pay_effect' is distinct from 'NONE'
    or facts->>'paid_overlap_choice_id' is distinct from choice.id::text or facts->'paid_overlap_choice_proof' is distinct from proof
    or facts->>'rule_set_version_id' is distinct from revision.rule_set_version_id::text
    or s.pay_vector_json is distinct from private.weekly_source_finalisation_vector_v1(e.id,'PAY',1::smallint)
    or s.charge_vector_json is distinct from private.weekly_source_finalisation_vector_v1(e.id,'CHARGE',1::smallint)
    or m.total_pay_ex_vat<>0 or m.canonical_pay_vector_json is distinct from private.weekly_source_invoice_only_vector_v1('PAY',0)
    or m.canonical_charge_vector_json is distinct from private.weekly_source_invoice_only_vector_v1('CHARGE',m.invoice_presentation_charge_pence)
    or m.calculated_comparison_charge_pence is distinct from e.calculated_charge_pence then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_INVOICE_ORIGIN_UNBOUND' using errcode='55000';end if;
  select count(*) into audit_count from public.audit_events a
    join private.weekly_source_office_rechecks journal on journal.request_id=(choice.paid_overlap_inputs_json->>'request_id')::uuid
    where a.object_type='weekly_source_office_row_choices' and a.object_id_text=choice.id::text
      and a.action='WEEKLY_SOURCE_PAID_SHIFT_MATCH_CONFIRMED' and a.actor_user_id=choice.actor_user_id
      and a.after_json->'choice'=to_jsonb(choice) and a.after_json->'admission'=choice.paid_overlap_inputs_json
      and a.after_json->'request'=journal.request_json and journal.actor_user_id=choice.actor_user_id
      and journal.request_hash=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFFICE_RECHECK_V1',journal.request_json)
      and a.after_json->>'request_sha256'=encode(journal.request_hash,'hex')
      and proof->>'confirmation_request_sha256'=encode(journal.request_hash,'hex');
  if audit_count<>1 then raise exception 'WEEKLY_SOURCE_PAID_MATCH_INVOICE_AUDIT_UNBOUND' using errcode='55000';end if;
  expected_snapshot_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_FINAL_SNAPSHOT_LINE_V1',jsonb_build_object(
    'final_revision_id',revision.id,'upload_row_id',row.id,'row_resolution_id',r.id,'work_event_id',s.work_event_id,
    'candidate_id',s.candidate_id,'client_id',s.client_id,'contract_id',s.contract_id,'work_date',s.work_date,
    'start_at_local',s.start_at_local,'end_at_local',s.end_at_local,'break_minutes',s.break_minutes,'actual_net_minutes',s.actual_net_minutes,
    'pay_vector',s.pay_vector_json,'charge_vector',s.charge_vector_json,'source_expense_pence',s.source_expense_pence,
    'source_fingerprint',encode(s.source_fingerprint,'hex'),'mapping_fingerprint',encode(s.mapping_fingerprint,'hex'),
    'rate_fingerprint',encode(s.rate_fingerprint,'hex'),'policy_fingerprint',encode(s.policy_fingerprint,'hex'),
    'pay_effect',s.pay_effect,'paid_overlap_choice_id',s.paid_overlap_choice_id,
    'paid_overlap_choice_proof_sha256',proof->>'choice_proof_sha256'));
  if expected_snapshot_hash is distinct from s.snapshot_line_hash
    or e.upload_row_id is distinct from row.id or e.work_event_id is distinct from s.work_event_id
    or e.candidate_id is distinct from s.candidate_id or e.client_id is distinct from s.client_id
    or e.contract_id is distinct from s.contract_id or e.row_sign<>1
    or s.source_classifications_json is distinct from e.canonical_result_json
    or s.rate_fingerprint is distinct from e.calculation_fingerprint
    or s.policy_fingerprint is distinct from e.effective_policy_fingerprint
    or r.source_row_fingerprint is distinct from row.normalised_row_hash then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_INVOICE_SNAPSHOT_HASH_UNBOUND' using errcode='55000';end if;
  select lineage.timesheet_id into strict ts from public.weekly_source_row_timesheet_lineages lineage where lineage.row_resolution_id=r.id;
  mapping:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_MAPPING_RATE_POLICY_V1',jsonb_build_object(
    'row_resolution_id',r.id,'work_event_id',r.work_event_id,'candidate_id',r.candidate_id,'client_id',r.client_id,'contract_id',r.contract_id,
    'contract_and_rate_fingerprint',encode(e.contract_and_rate_fingerprint,'hex'),'effective_policy_fingerprint',encode(e.effective_policy_fingerprint,'hex'),
    'invoice_vat_policy_fingerprint',encode(e.invoice_vat_policy_fingerprint,'hex'),'calculation_fingerprint',encode(e.calculation_fingerprint,'hex')));
  if ts is distinct from m.invoice_timesheet_id or mapping is distinct from m.mapping_rate_policy_fingerprint then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_INVOICE_LINEAGE_UNBOUND' using errcode='55000';end if;
  state:=jsonb_build_object('invoice_only_snapshot_line_id',s.id,'pay_effect','NONE','final_revision_id',revision.id,
    'finalisation_cycle_id',revision.source_cycle_id,'actual_client_id',r.client_id,'candidate_id',r.candidate_id,
    'contract_id',r.contract_id,'work_event_id',r.work_event_id,'movement_role','POSITIVE','source_profile_kind',s.source_profile_kind,
    'source_line_kind','SOURCE_REBILL_LINE','source_facts',facts,'pay_vector',m.canonical_pay_vector_json,'charge_vector',m.canonical_charge_vector_json,'total_pay_pence',0,
    'calculated_comparison_charge_pence',m.calculated_comparison_charge_pence,'source_validation_charge_pence',m.source_validation_charge_pence,
    'invoice_presentation_charge_pence',m.invoice_presentation_charge_pence,'vat_rate_pct',m.vat_rate_pct,'vat_amount',m.vat_amount,
    'total_inc_vat',m.total_inc_vat,'price_check_result',m.price_check_result,
    'price_check_fingerprint',case when m.price_check_fingerprint is null then null else encode(m.price_check_fingerprint,'hex') end,
    'charge_acceptance_id',m.charge_acceptance_id,'mapping_rate_policy_fingerprint',encode(mapping,'hex'),'invoice_timesheet_id',ts);
  if private.weekly_source_billing_movement_hash_v1(state) is distinct from m.movement_economic_hash then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_INVOICE_HASH_UNBOUND' using errcode='55000';end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_MATCH_INVOICE_ORIGIN_V1','movement_id',m.id,
    'snapshot_line_id',s.id,'upload_row_id',row.id,'work_event_id',s.work_event_id,
    'row_resolution_id',r.id,'paid_overlap_choice_id',choice.id,'pay_effect','NONE');
end;
$function$;

create or replace function private.weekly_source_billing_movement_hash_v1(p_state jsonb)
returns bytea language plpgsql immutable set search_path to 'pg_catalog','pg_temp'
as $function$
begin
  if jsonb_typeof(p_state) is distinct from 'object' or exists(select 1 from jsonb_object_keys(p_state) k
    where k not in ('transition_id','nhsp_upload_row_id','expense_authority_generation_id','self_bill_report_row_id','vat_rounding_revision_id','invoice_window_cycle_id','invoice_only_snapshot_line_id','pay_effect',
      'final_revision_id','finalisation_cycle_id','actual_client_id','candidate_id','contract_id','work_event_id','movement_role',
      'correction_unit_id','prior_movement_id','source_profile_kind','source_line_kind','source_facts','pay_vector','charge_vector',
      'total_pay_pence','total_pay_ex_vat','calculated_comparison_charge_pence','source_validation_charge_pence',
      'invoice_presentation_charge_pence','vat_rate_pct','vat_amount','total_inc_vat','price_check_result','price_check_fingerprint',
      'charge_acceptance_id','mapping_rate_policy_fingerprint','invoice_timesheet_id','vector')) then
    raise exception 'WEEKLY_SOURCE_BILLING_HASH_INPUT_INVALID' using errcode='22023';
  end if;
  -- Keep the existing domain and each old producer's exact JSON field set.
  -- Newly present origins are added by their producer, never by NULL backfill.
  return private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_BILLING_MOVEMENT_V1',p_state);
end;
$function$;

create or replace function private.weekly_source_invoice_movement_window_id_v1(p_movement_id uuid)
returns uuid language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare m public.weekly_source_billing_movements%rowtype; target uuid;
begin
  select * into strict m from public.weekly_source_billing_movements where id=p_movement_id;
  target:=case when m.source_line_kind='INVOICE_VAT_ROUNDING' then coalesce(m.invoice_window_cycle_id,m.finalisation_cycle_id)
    when m.source_line_kind='SOURCE_INVOICE_CORRECTION' and m.movement_role in ('REVERSAL','REPLACEMENT')
      then nullif(m.source_facts_json->>'invoice_window_cycle_id','')::uuid
    when m.pay_effect='NONE' and m.invoice_only_snapshot_line_id is not null
      then nullif(m.source_facts_json->>'invoice_window_cycle_id','')::uuid else m.finalisation_cycle_id end;
  if target is null or not exists(select 1 from public.weekly_source_cycles actual join public.weekly_source_cycles original
    on original.id=m.finalisation_cycle_id and actual.source_group_id=original.source_group_id
    where actual.id=target and (actual.scope_client_id is null or actual.scope_client_id=m.actual_client_id)) then
    raise exception 'WEEKLY_SOURCE_INVOICE_MOVEMENT_WINDOW_INVALID' using errcode='55000'; end if;
  return target;
end;
$function$;

create or replace function private.weekly_source_invoice_source_amount_movement_valid_v1(p_movement_id uuid)
returns boolean language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare m public.weekly_source_billing_movements%rowtype; t public.weekly_source_state_transitions%rowtype;
  sn public.weekly_source_final_snapshot_lines%rowtype; source_row public.weekly_source_upload_rows%rowtype; resolution public.weekly_source_row_resolutions%rowtype;
  economic public.weekly_source_row_economic_snapshots%rowtype; charge public.weekly_source_charge_checks%rowtype;
  upload public.weekly_source_uploads%rowtype; rules jsonb; expected_price text;
begin
  select * into m from public.weekly_source_billing_movements where weekly_source_billing_movements.id=p_movement_id;
  if not found or m.source_profile_kind<>'HEALTHROSTER_ACTUAL_ROWS' or (m.transition_id is null and m.invoice_only_snapshot_line_id is null)
    or m.source_validation_charge_pence is null or m.invoice_presentation_charge_pence is distinct from m.source_validation_charge_pence then return false; end if;
  if m.invoice_only_snapshot_line_id is not null then
    perform private.weekly_source_paid_match_invoice_origin_assert_v1(m.id);
  else
    select * into t from public.weekly_source_state_transitions where weekly_source_state_transitions.id=m.transition_id;
    if not found or t.final_revision_id<>m.final_revision_id or t.work_event_id<>m.work_event_id then return false; end if;
  end if;
  rules:=private.weekly_source_frozen_rule_values_v1(m.final_revision_id);
  if rules is null or rules->>'invoice_sender' is distinct from 'CLIENT_SELF_BILL'
    or rules->>'invoice_amount_basis' is distinct from 'SOURCE_AMOUNT'
    or rules->>'source_amount_basis' is distinct from 'EXPORT_ACTUAL_COST_INC_VAT_NET_AGENCY_WORKER_PAY' then return false; end if;
  if m.source_line_kind='SOURCE_INVOICE_CORRECTION' then
    return m.total_pay_ex_vat=0 and m.canonical_pay_vector_json->>'total_pence'='0'
      and m.source_facts_json->>'schema_version' in ('WEEKLY_SOURCE_INVOICE_CORRECTION_FACTS_V1','WEEKLY_SOURCE_INVOICE_CORRECTION_UNWIND_V1')
      and ((m.movement_role in ('REVERSAL','REPLACEMENT') and t.outcome='NO_CHANGE')
        or (m.movement_role='CORRECTION_UNWIND' and t.outcome in ('AMEND','CANCEL')))
      and m.price_check_result='NOT_APPLICABLE' and m.price_check_fingerprint is null and m.charge_acceptance_id is null;
  end if;
  if not ((m.source_line_kind='SOURCE_ORDINARY' and t.outcome='ADD' and m.movement_role='POSITIVE')
    or (m.source_line_kind='SOURCE_REPLACEMENT' and t.outcome='AMEND' and m.movement_role='REPLACEMENT')
    or (m.source_line_kind='SOURCE_REBILL_LINE' and t.outcome='NO_CHANGE' and m.movement_role='POSITIVE' and m.total_pay_ex_vat=0)
    or (m.source_line_kind='SOURCE_REBILL_LINE' and m.pay_effect='NONE' and m.invoice_only_snapshot_line_id is not null
      and m.movement_role='POSITIVE' and m.total_pay_ex_vat=0)) then return false; end if;
  select * into sn from public.weekly_source_final_snapshot_lines where weekly_source_final_snapshot_lines.id=
    case when m.pay_effect='NONE' then m.invoice_only_snapshot_line_id else t.new_snapshot_line_id end;
  if not found or sn.final_revision_id<>m.final_revision_id or sn.client_id<>m.actual_client_id
    or sn.candidate_id<>m.candidate_id or sn.contract_id<>m.contract_id or sn.work_event_id<>m.work_event_id
    or sn.upload_row_id::text is distinct from m.source_facts_json->>'upload_row_id' then return false; end if;
  -- Historical admission validates the frozen producer facts, not today's
  -- Client policy/rates or a later Ignore receipt for this old movement.
  select * into resolution from public.weekly_source_row_resolutions where weekly_source_row_resolutions.id=sn.row_resolution_id;
  select * into source_row from public.weekly_source_upload_rows where weekly_source_upload_rows.id=sn.upload_row_id;
  select * into upload from public.weekly_source_uploads where weekly_source_uploads.id=source_row.upload_id;
  select * into economic from public.weekly_source_row_economic_snapshots where row_resolution_id=resolution.id;
  select * into charge from public.weekly_source_charge_checks where upload_row_id=source_row.id and row_resolution_id=resolution.id
    and generation=resolution.generation and comparison_profile_version='SOURCE_INVOICE_MONEY_PENCE_V1';
  if resolution.id is null or source_row.id is null or economic.id is null or charge.id is null
    or resolution.work_event_id is distinct from m.work_event_id or resolution.client_id is distinct from m.actual_client_id
    or resolution.candidate_id is distinct from m.candidate_id or resolution.contract_id is distinct from m.contract_id
    or source_row.source_money_parse_state<>'VALID' or source_row.source_qualification_profile_version<>'SOURCE_INVOICE_MONEY_PENCE_V1'
    or source_row.source_shift_charge_pence is null or source_row.source_gross_pence is null or source_row.source_vat_pence is null
    or source_row.source_shift_charge_pence+source_row.source_vat_pence<>source_row.source_gross_pence
    or m.invoice_presentation_charge_pence is distinct from source_row.source_shift_charge_pence
    or m.calculated_comparison_charge_pence is distinct from economic.calculated_charge_pence
    or m.price_check_fingerprint is distinct from economic.calculation_fingerprint
    or charge.charge_calculation_fingerprint is distinct from economic.calculation_fingerprint
    or charge.source_shift_charge_pence is distinct from source_row.source_shift_charge_pence
    or charge.calculated_segment_charge_pence is distinct from economic.calculated_charge_pence then return false; end if;
  expected_price:=case when source_row.source_shift_charge_pence=economic.calculated_charge_pence then 'EXACT'
    when abs(source_row.source_shift_charge_pence-economic.calculated_charge_pence)=1 then 'SOURCE_ROUNDING_EQUIVALENT' else 'SOURCE_AMOUNT_DIFFERS' end;
  if charge.comparison_result<>expected_price then return false; end if;
  if m.price_check_result=expected_price and m.charge_acceptance_id is null then return true; end if;
  return expected_price='SOURCE_AMOUNT_DIFFERS' and m.price_check_result='ACCEPTED_DISPARITY' and exists(
    select 1 from public.weekly_source_charge_acceptances acceptance where acceptance.id=m.charge_acceptance_id
      and acceptance.acceptance_kind='ACCEPTED_DISPARITY' and acceptance.charge_check_id=charge.id
      and acceptance.source_upload_id=upload.id and acceptance.source_upload_hash=upload.content_sha256
      and acceptance.upload_row_id=source_row.id and acceptance.row_resolution_id=resolution.id and acceptance.contract_id=resolution.contract_id
      and acceptance.source_row_fingerprint=resolution.source_row_fingerprint and acceptance.contract_and_rate_fingerprint=economic.contract_and_rate_fingerprint
      and acceptance.effective_policy_fingerprint=economic.effective_policy_fingerprint and acceptance.charge_calculation_fingerprint=economic.calculation_fingerprint
      and acceptance.acceptance_policy_fingerprint=private.weekly_source_source_amount_acceptance_policy_fingerprint_v1());
end;
$function$;

create or replace function public.weekly_source_invoice_admit_atomic_v1(
  p_request jsonb
) returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_allowed_keys constant text[]:=array[
    'actor_user_id','client_manifest_id','expected_manifest_hash'
  ]::text[];
  v_unknown text;
  v_actor uuid;
  v_manifest_id uuid;
  v_expected_hash bytea;
  v_manifest public.weekly_source_client_manifests%rowtype;
  v_invoice_window public.weekly_source_cycles%rowtype;
  v_receipt_map jsonb; v_round_authority jsonb; v_round_presentation jsonb;
  v_revision public.weekly_source_final_revisions%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_client public.clients%rowtype;
  v_defaults public.settings_defaults%rowtype;
  v_invoice_id uuid;
  v_header jsonb;
  v_group_row record;
  v_movement public.weekly_source_billing_movements%rowtype;
  v_snapshot public.weekly_source_final_snapshot_lines%rowtype;
  v_source_row public.weekly_source_upload_rows%rowtype;
  v_contract public.contracts%rowtype;
  v_candidate public.candidates%rowtype;
  v_ids uuid[];
  v_member_id uuid;
  v_member public.weekly_source_billing_movements%rowtype;
  v_presentation_id uuid;
  v_invoice_line_id uuid;
  v_binding_id uuid;
  v_line_kind text;
  v_origin_kind text;
  v_correction_role text;
  v_old_id uuid;
  v_new_id uuid;
  v_work_date date;
  v_start timestamp without time zone;
  v_end timestamp without time zone;
  v_break integer;
  v_reference text;
  v_description text;
  v_hours_day numeric;
  v_hours_night numeric;
  v_hours_sat numeric;
  v_hours_sun numeric;
  v_hours_bh numeric;
  v_pay_day numeric;
  v_pay_night numeric;
  v_pay_sat numeric;
  v_pay_sun numeric;
  v_pay_bh numeric;
  v_charge_day numeric;
  v_charge_night numeric;
  v_charge_sat numeric;
  v_charge_sun numeric;
  v_charge_bh numeric;
  v_total_pay numeric(12,2);
  v_total_charge numeric(12,2);
  v_calc_pence bigint;
  v_source_pence bigint;
  v_vat_rate numeric(5,2);
  v_vat numeric(12,2);
  v_total numeric(12,2);
  v_price_result text;
  v_price_fingerprint bytea;
  v_mapping_fingerprint bytea;
  v_source_hash bytea;
  v_presentation_hash bytea;
  v_materialised_hash bytea;
  v_placement_hash bytea;
  v_candidate_display text;
  v_client_display text;
  v_is_net boolean;
  v_is_expense boolean;
  v_is_rounding boolean;
  v_release_id uuid;
  v_release_authority jsonb;
  v_release_member uuid;
  v_release_money jsonb;
  v_identity_movement public.weekly_source_billing_movements%rowtype;
  v_count integer;
  v_is_report boolean:=false; v_report_scope public.weekly_source_report_scopes%rowtype;
  v_report_header public.weekly_source_self_bill_reports%rowtype;
begin
  perform pg_catalog.set_config('lock_timeout','5s',true);
  if coalesce(pg_catalog.current_setting('request.jwt.claim.role',true),
       nullif(pg_catalog.current_setting('request.jwt.claims',true),'')::jsonb->>'role','')
       <>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
  end if;
  if p_request is null or pg_catalog.jsonb_typeof(p_request)<>'object' then
    raise exception 'WEEKLY_SOURCE_INVOICE_ADMIT_REQUEST_INVALID' using errcode='22023';
  end if;
  select key into v_unknown from pg_catalog.jsonb_object_keys(p_request) key
  where not (key=any(v_allowed_keys)) order by key limit 1;
  if v_unknown is not null then
    raise exception 'WEEKLY_SOURCE_INVOICE_ADMIT_UNKNOWN_FIELD'
      using errcode='22023',detail=v_unknown;
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_manifest_id:=(p_request->>'client_manifest_id')::uuid;
    v_expected_hash:=pg_catalog.decode(p_request->>'expected_manifest_hash','hex');
  exception when others then
    raise exception 'WEEKLY_SOURCE_INVOICE_ADMIT_VALUE_INVALID' using errcode='22023';
  end;
  if pg_catalog.octet_length(v_expected_hash)<>32 then
    raise exception 'WEEKLY_SOURCE_INVOICE_ADMIT_HASH_INVALID' using errcode='22023';
  end if;

  select * into v_manifest from public.weekly_source_client_manifests where id=v_manifest_id;
  if not found then raise exception 'WEEKLY_SOURCE_INVOICE_MANIFEST_CHANGED' using errcode='40001'; end if;
  perform 1 from public.weekly_source_groups where id=v_manifest.source_group_id for update;
  perform 1 from public.weekly_source_cycles where id in (v_manifest.source_cycle_id,coalesce(v_manifest.invoice_window_cycle_id,v_manifest.source_cycle_id)) order by id for update;
  select * into v_manifest from public.weekly_source_client_manifests where id=v_manifest_id for update;
  if not found or v_manifest.manifest_hash is distinct from v_expected_hash then
    raise exception 'WEEKLY_SOURCE_INVOICE_MANIFEST_CHANGED' using errcode='40001';
  end if;
  select * into strict v_revision from public.weekly_source_final_revisions
  where id=v_manifest.final_revision_id for share;
  select * into strict v_cycle from public.weekly_source_cycles
  where id=v_manifest.source_cycle_id for share;
  v_is_report:=v_revision.authority_scope_kind='SELF_BILL_REPORT_SCOPE';
  if v_is_report then
    select * into strict v_report_scope from public.weekly_source_report_scopes where id=v_revision.report_scope_id for share;
    select * into strict v_report_header from public.weekly_source_self_bill_reports where id=v_report_scope.self_bill_report_id;
    if v_report_scope.current_final_revision_id is distinct from v_revision.id or v_report_scope.source_cycle_id<>v_cycle.id
      or v_report_scope.source_group_id<>v_manifest.source_group_id or v_report_scope.client_id<>v_manifest.client_id
      or v_report_scope.current_complete_upload_id is distinct from v_revision.upload_id or v_report_scope.state<>'FINALISED'
      or v_report_header.source_cycle_id<>v_cycle.id or v_report_header.source_group_id<>v_manifest.source_group_id
      or v_report_header.client_id<>v_manifest.client_id or v_revision.reason<>'INITIAL_FINALISATION'
      or coalesce(v_manifest.invoice_window_cycle_id,v_cycle.id)<>v_cycle.id then
      raise exception 'WEEKLY_SOURCE_REPORT_INVOICE_FINAL_AUTHORITY_STALE' using errcode='40001'; end if;
  end if;
  if v_revision.state<>'CURRENT'
     or v_revision.source_cycle_id is distinct from v_cycle.id
     or v_cycle.source_group_id is distinct from v_manifest.source_group_id
     or (not v_is_report and not exists(
       select 1 from public.weekly_source_client_cycle_completions completion
       where completion.source_cycle_id=v_cycle.id
         and completion.client_id=v_manifest.client_id
         and completion.final_revision_id=v_revision.id
         and completion.completion_kind='FINAL_SOURCE' and completion.state='CURRENT'
     )) then
    raise exception 'WEEKLY_SOURCE_INVOICE_FINAL_AUTHORITY_STALE' using errcode='40001';
  end if;
  select * into strict v_invoice_window from public.weekly_source_cycles
    where id=coalesce(v_manifest.invoice_window_cycle_id,v_manifest.source_cycle_id);
  if v_invoice_window.source_group_id<>v_manifest.source_group_id
    or v_invoice_window.finalisation_week_ending<>v_manifest.finalisation_week_ending
    or (v_invoice_window.scope_client_id is not null and v_invoice_window.scope_client_id<>v_manifest.client_id) then
    raise exception 'WEEKLY_SOURCE_INVOICE_WINDOW_SCOPE_INVALID' using errcode='55000'; end if;
  perform private.weekly_source_office_authority_v1(
    v_actor,'ADMIT_SOURCE_INVOICE',v_manifest.source_group_id,
    v_manifest.client_id,v_manifest.finalisation_week_ending
  );

  if (select pg_catalog.count(*) from public.weekly_source_manifest_movements mm
      where mm.client_manifest_id=v_manifest.id)<>v_manifest.movement_count
     or exists(
       select 1 from public.weekly_source_manifest_movements mm
       join public.weekly_source_billing_movements movement
         on movement.id=mm.billing_movement_id
       where mm.client_manifest_id=v_manifest.id
         and (mm.movement_hash is distinct from movement.movement_economic_hash
           or movement.final_revision_id is distinct from v_revision.id
           or movement.finalisation_cycle_id is distinct from v_cycle.id
           or movement.actual_client_id is distinct from v_manifest.client_id
           or private.weekly_source_invoice_movement_window_id_v1(movement.id)<>v_invoice_window.id
           or (v_invoice_window.id<>v_cycle.id and (movement.source_line_kind not in ('SOURCE_INVOICE_CORRECTION','INVOICE_VAT_ROUNDING')
             or movement.total_pay_ex_vat<>0 or exists(select 1 from jsonb_each_text(movement.canonical_pay_vector_json->'minutes') v where v.value::numeric<>0)
             or exists(select 1 from jsonb_each_text(movement.canonical_pay_vector_json->'hours') v where v.value::numeric<>0))))
     ) then
    raise exception 'WEEKLY_SOURCE_INVOICE_MANIFEST_INVALID' using errcode='55000';
  end if;

  if v_is_report then
    if exists(select 1 from public.weekly_source_manifest_movements mm
      join public.weekly_source_billing_movements movement on movement.id=mm.billing_movement_id
      left join public.weekly_source_upload_rows row_value on row_value.id=movement.self_bill_report_row_id
      where mm.client_manifest_id=v_manifest.id and
       (movement.source_profile_kind<>'SELF_BILL_REPORT' or movement.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING')
        or movement.total_pay_ex_vat<>0 or movement.canonical_pay_vector_json is distinct from private.weekly_source_invoice_only_vector_v1('PAY',0)
        or (movement.source_line_kind='SELF_BILL_REPORT_LINE' and (row_value.id is null or row_value.upload_id<>v_revision.upload_id
          or row_value.row_finalisation_state<>'SOURCE_REPORT_LINE'
          or movement.source_facts_json->>'upload_row_id' is distinct from row_value.id::text
          or movement.source_facts_json->>'source_row_ordinal' is distinct from row_value.source_row_ordinal::text
          or movement.source_facts_json->>'request_id' is distinct from row_value.external_source_key
          or movement.source_facts_json->>'report_scope_id' is distinct from v_report_scope.id::text
          or movement.source_facts_json->>'self_bill_report_id' is distinct from v_report_header.id::text
          or movement.source_facts_json->>'rule_set_version_id' is distinct from v_revision.rule_set_version_id::text
          or movement.invoice_presentation_charge_pence<>row_value.source_shift_charge_pence
          or movement.vat_amount*100<>row_value.source_vat_pence or movement.total_inc_vat*100<>row_value.source_gross_pence))
        or (movement.source_line_kind='INVOICE_VAT_ROUNDING' and movement.vat_rounding_revision_id is distinct from v_revision.id)))
      or exists(select 1 from public.weekly_source_upload_rows row_value where row_value.upload_id=v_revision.upload_id and
        (select count(*) from public.weekly_source_manifest_movements mm
          join public.weekly_source_billing_movements movement on movement.id=mm.billing_movement_id
          where mm.client_manifest_id=v_manifest.id and movement.self_bill_report_row_id=row_value.id)<>1)
      or (select count(*) from public.weekly_source_upload_rows row_value where row_value.upload_id=v_revision.upload_id)<>v_report_header.line_count
      or (select count(*) from public.weekly_source_manifest_movements mm join public.weekly_source_billing_movements movement on movement.id=mm.billing_movement_id
        where mm.client_manifest_id=v_manifest.id and movement.source_line_kind='INVOICE_VAT_ROUNDING')>1 then
      raise exception 'WEEKLY_SOURCE_REPORT_INVOICE_MANIFEST_INVALID' using errcode='55000'; end if;
  end if;
  if v_manifest.invoice_state='ADMITTED' then
    if exists(
      select 1 from public.weekly_source_manifest_movements mm
      where mm.client_manifest_id=v_manifest.id
        and not exists(
          select 1 from public.weekly_source_invoice_line_bindings binding
          where binding.billing_movement_id=mm.billing_movement_id
            and binding.state='CURRENT'
        )
    ) then
      raise exception 'WEEKLY_SOURCE_INVOICE_ADMITTED_INCOMPLETE' using errcode='55000';
    end if;
    return pg_catalog.jsonb_build_object(
      'ok',true,'status',case when v_manifest.movement_count=0 then 'NO_MOVEMENTS' else 'ADMITTED' end,
      'idempotent',true,'client_manifest_id',v_manifest.id,
      'invoice_ids',coalesce((
        select pg_catalog.jsonb_agg(distinct binding.invoice_id)
        from public.weekly_source_manifest_movements mm
        join public.weekly_source_invoice_line_bindings binding
          on binding.billing_movement_id=mm.billing_movement_id and binding.state='CURRENT'
        where mm.client_manifest_id=v_manifest.id
      ),'[]'::jsonb)
    );
  end if;
  if v_manifest.invoice_state<>'READY' then
    raise exception 'WEEKLY_SOURCE_INVOICE_MANIFEST_NOT_READY' using errcode='55000';
  end if;
  if v_manifest.movement_count=0 then
    update public.weekly_source_client_manifests set invoice_state='ADMITTED'
    where id=v_manifest.id and invoice_state='READY';
    return pg_catalog.jsonb_build_object(
      'ok',true,'status','NO_MOVEMENTS','idempotent',false,
      'client_manifest_id',v_manifest.id,'invoice_ids','[]'::jsonb
    );
  end if;
  if exists(
    select 1 from public.weekly_source_manifest_movements mm
    join public.weekly_source_billing_movements movement on movement.id=mm.billing_movement_id
    where mm.client_manifest_id=v_manifest.id
      and (movement.placement_state<>'UNPLACED'
        or exists(select 1 from public.weekly_source_invoice_line_bindings binding
                  where binding.billing_movement_id=movement.id and binding.state='CURRENT'))
  ) then
    raise exception 'WEEKLY_SOURCE_INVOICE_MOVEMENT_ALREADY_ADMITTED' using errcode='55000';
  end if;

  if exists(select 1 from public.weekly_source_manifest_movements mm join public.weekly_source_billing_movements m on m.id=mm.billing_movement_id
    where mm.client_manifest_id=v_manifest.id and m.source_facts_json->>'invoice_hold'='VAT_FIT'
      and not exists(select 1 from public.weekly_source_invoice_hold_releases receipt where receipt.upload_row_id::text=m.source_facts_json->>'upload_row_id' and receipt.hold_kind='VAT_FIT')) then
    raise exception 'WEEKLY_SOURCE_INVOICE_VAT_FIT_HELD' using errcode='55000'; end if;
  v_receipt_map:=private.weekly_source_invoice_admission_receipt_map_v1(v_manifest.id);
  v_round_authority:=private.weekly_source_invoice_rounding_receipt_set_v1(v_manifest.id,v_receipt_map);
  select * into strict v_client from public.clients where id=v_manifest.client_id for share;
  select * into strict v_defaults from public.settings_defaults where id=1 for share;
  v_header:=pg_catalog.jsonb_build_object(
    'schema_version','WEEKLY_SOURCE_SELF_BILL_INVOICE_V1',
    'client_id',v_client.id,'client_name',v_client.name,
    'client_invoice_address',v_client.invoice_address,
    'client_primary_invoice_email',v_client.primary_invoice_email,
    'payment_terms_days',coalesce(v_client.payment_terms_days,0),
    'agency_name',v_defaults.agency_name,'registered_address',v_defaults.registered_address,
    'company_reg_number',v_defaults.company_reg_number,
    'vat_registration_number',v_defaults.vat_registration_number,
    'meta',pg_catalog.jsonb_build_object(
      'source','WEEKLY_FINAL_SOURCE','self_bill',true,
      'source_group_id',v_manifest.source_group_id,
      'source_cycle_id',v_manifest.source_cycle_id,
      'final_revision_id',v_manifest.final_revision_id,
      'client_manifest_id',v_manifest.id,
      'finalisation_week_ending',v_manifest.finalisation_week_ending,
      'backing_report_numbers',case when v_manifest.backing_report_number is null
        then '[]'::jsonb else pg_catalog.jsonb_build_array(v_manifest.backing_report_number) end,
      'automatic_consolidation','ONE_CLIENT_ONE_FINALISED_CYCLE'
    )||case when not v_is_report then '{}'::jsonb else jsonb_build_object('self_bill_report_id',v_report_header.id,
      'report_scope_id',v_report_scope.id,'report_invoice_date',v_report_header.invoice_date) end||case when v_manifest.invoice_window_cycle_id is null then '{}'::jsonb else jsonb_build_object(
      'invoice_window_cycle_id',v_invoice_window.id,'source_finalisation_week_ending',v_cycle.finalisation_week_ending
    ) end
  );
  insert into public.invoices(
    type,client_id,status,status_date_utc,subtotal_ex_vat,vat_amount,total_inc_vat,
    notes,header_snapshot_json,do_not_send,document_revision,document_state,issue_state
  ) values (
    'INVOICE',v_manifest.client_id,'DRAFT',pg_catalog.transaction_timestamp(),0,0,0,
    case when v_manifest.backing_report_number is null then null
      else 'Backing report '||v_manifest.backing_report_number end,
    v_header,false,1,'STALE','NOT_STARTED'
  ) returning id into v_invoice_id;

  perform pg_catalog.set_config(
    'cloudtms.weekly_source_invoice_owner','ADMIT_SOURCE_INVOICE',true
  );

  for v_group_row in
    with member as (
      select movement.*,
             movement.source_facts_json->>'correction_presentation' as presentation_policy,
             case
               when movement.source_profile_kind<>'NHSP_TRUST_BACKING_REPORT'
                and movement.correction_unit_id is not null
                and movement.source_facts_json->>'correction_presentation'='NET_DIFFERENCE_PRESENTATION'
               then movement.correction_unit_id else movement.id
             end as presentation_group
      from public.weekly_source_manifest_movements mm
      join public.weekly_source_billing_movements movement
        on movement.id=mm.billing_movement_id
      where mm.client_manifest_id=v_manifest.id
    )
    select presentation_group,
           pg_catalog.array_agg(id order by movement_role,id) as movement_ids,
           pg_catalog.count(*)::integer as member_count,
           pg_catalog.bool_and(source_line_kind='SOURCE_FIXED_EXPENSE') as is_expense,
           pg_catalog.bool_and(presentation_policy='NET_DIFFERENCE_PRESENTATION') as requested_net
    from member
    group by presentation_group
    -- 24 section 12 requires a source-fixed expense presentation to declare the
    -- shift presentation it follows.  weekly_source_invoice_presentation_lines
    -- is IMMUTABLE_APPEND_ONLY, so that declaration has to be written at birth;
    -- every non-expense group is therefore materialised first and the expense
    -- group can then name its companion.  Within each of the two blocks the
    -- established creation order is unchanged.
    order by pg_catalog.bool_and(source_line_kind='SOURCE_FIXED_EXPENSE'),
             pg_catalog.min(created_at_utc),presentation_group
  loop
    v_ids:=v_group_row.movement_ids;
    v_count:=v_group_row.member_count;
    v_is_expense:=v_group_row.is_expense;
    v_is_net:=v_group_row.requested_net and v_count=2;
    if v_count>2
       or (v_count=2 and not v_is_net)
       or (v_is_net and exists(
         select 1 from public.weekly_source_billing_movements movement
         where movement.id=any(v_ids)
           and movement.source_profile_kind='NHSP_TRUST_BACKING_REPORT'
       ))
       or (v_is_net and (
         select pg_catalog.array_agg(movement.movement_role order by movement.movement_role)
         from public.weekly_source_billing_movements movement where movement.id=any(v_ids)
       ) not in (
         array['REPLACEMENT','REVERSAL']::text[],
         array['EXPENSE_REPLACEMENT','EXPENSE_REVERSAL']::text[]
       ))
       or (v_count=2 and (select pg_catalog.count(distinct movement.correction_unit_id)
           from public.weekly_source_billing_movements movement where movement.id=any(v_ids))<>1)
       or ((select pg_catalog.count(distinct movement.work_event_id)
           from public.weekly_source_billing_movements movement where movement.id=any(v_ids))<>1 and not(v_is_report and v_count=1))
       or (select pg_catalog.count(distinct movement.final_revision_id)
           from public.weekly_source_billing_movements movement where movement.id=any(v_ids))<>1
       or (select pg_catalog.count(distinct movement.actual_client_id)
           from public.weekly_source_billing_movements movement where movement.id=any(v_ids))<>1 then
      raise exception 'WEEKLY_SOURCE_INVOICE_PRESENTATION_GROUP_INVALID' using errcode='55000';
    end if;

    select * into strict v_movement
    from public.weekly_source_billing_movements movement
    where movement.id=case when v_is_net then (
      select candidate.id from public.weekly_source_billing_movements candidate
      where candidate.id=any(v_ids)
        and candidate.movement_role in ('REPLACEMENT','EXPENSE_REPLACEMENT')
      limit 1
    ) else v_ids[1] end;
    v_round_presentation:=null;
    v_is_rounding:=v_movement.source_line_kind='INVOICE_VAT_ROUNDING';
    v_release_id:=null; v_release_authority:=null; v_release_member:=null;
    if not ((v_is_rounding or (v_is_report and v_movement.source_line_kind='SELF_BILL_REPORT_LINE'
      and v_movement.movement_role='STANDALONE_NEGATIVE')) and v_movement.candidate_id is null) then
    select * into strict v_contract from public.contracts
    where id=v_movement.contract_id and client_id=v_manifest.client_id
      and candidate_id=v_movement.candidate_id for share;
    select * into strict v_candidate from public.candidates
    where id=v_movement.candidate_id for share;
    v_candidate_display:=coalesce(nullif(pg_catalog.btrim(v_candidate.display_name),''),
      nullif(pg_catalog.btrim(pg_catalog.concat_ws(' ',v_candidate.first_name,v_candidate.last_name)),''),
      v_candidate.tms_ref,v_candidate.id::text);
    else v_contract:=null; v_candidate:=null; v_candidate_display:=null; end if;
    v_client_display:=coalesce(nullif(pg_catalog.btrim(v_client.name),''),v_client.id::text);

    if v_is_rounding then
      v_work_date:=null; v_start:=null; v_end:=null; v_break:=null; v_reference:=null;
      if v_movement.prior_movement_id is not null then
        select * into strict v_identity_movement from public.weekly_source_billing_movements where id=v_movement.prior_movement_id;
        if v_is_report and v_identity_movement.source_line_kind='SELF_BILL_REPORT_LINE' then
          if v_identity_movement.source_facts_json->>'bound_pay_snapshot_line_id' is not null then
            select snapshot.* into strict v_snapshot from public.weekly_source_final_snapshot_lines snapshot
              where snapshot.id=coalesce((v_identity_movement.source_facts_json->>'bound_export_snapshot_line_id')::uuid,
                (v_identity_movement.source_facts_json->>'bound_pay_snapshot_line_id')::uuid)
              and snapshot.final_revision_id=coalesce((v_identity_movement.source_facts_json->>'bound_export_final_revision_id')::uuid,
                (v_identity_movement.source_facts_json->>'bound_pay_final_revision_id')::uuid)
              and (not (v_identity_movement.source_facts_json ? 'bound_export_snapshot_line_id') or (
                snapshot.pay_effect='NONE'
                and snapshot.row_resolution_id=(v_identity_movement.source_facts_json->>'bound_row_resolution_id')::uuid
                and snapshot.upload_row_id=(v_identity_movement.source_facts_json->>'bound_export_upload_row_id')::uuid
                and encode(snapshot.snapshot_line_hash,'hex')=v_identity_movement.source_facts_json->>'bound_export_snapshot_line_hash'
                and snapshot.paid_overlap_choice_id=(v_identity_movement.source_facts_json->>'bound_export_paid_overlap_choice_id')::bigint
                and v_identity_movement.source_facts_json->>'bound_export_pay_effect'='NONE'
                and v_identity_movement.source_facts_json#>>'{retained_pay_basis,snapshot_line_id}'=v_identity_movement.source_facts_json->>'bound_pay_snapshot_line_id'
                and v_identity_movement.source_facts_json#>>'{retained_pay_basis,final_revision_id}'=snapshot.final_revision_id::text
                and v_identity_movement.source_facts_json#>>'{retained_pay_basis,work_event_id}'=snapshot.work_event_id::text
                and exists(select 1 from jsonb_array_elements(v_identity_movement.source_facts_json#>'{retained_pay_basis,actual_present_invoice_rows}') item
                  where item=jsonb_build_object('snapshot_line_id',snapshot.id,'upload_row_id',snapshot.upload_row_id,
                    'paid_overlap_choice_id',snapshot.paid_overlap_choice_id,'snapshot_line_hash',encode(snapshot.snapshot_line_hash,'hex')))))
                and snapshot.client_id=v_manifest.client_id and snapshot.contract_id=v_identity_movement.contract_id
                and snapshot.work_event_id=v_identity_movement.work_event_id;
          else
            if v_identity_movement.movement_role<>'STANDALONE_NEGATIVE' then
              raise exception 'WEEKLY_SOURCE_REPORT_INVOICE_BOUND_PRESENTATION_REQUIRED' using errcode='55000'; end if;
            select * into strict v_source_row from public.weekly_source_upload_rows where id=v_identity_movement.self_bill_report_row_id and upload_id=v_revision.upload_id;
            v_snapshot.work_date:=v_source_row.work_date;v_snapshot.start_at_local:=v_source_row.start_at_local;
            v_snapshot.end_at_local:=v_source_row.end_at_local;v_snapshot.break_minutes:=null;v_snapshot.external_event_identity:=v_source_row.external_source_key;
          end if;
        else
        select snapshot.* into strict v_snapshot from public.weekly_source_state_transitions transition_row
          join public.weekly_source_final_snapshot_lines snapshot on snapshot.id=coalesce(transition_row.new_snapshot_line_id,transition_row.previous_snapshot_line_id)
          where transition_row.id=v_identity_movement.transition_id;
        end if;
        v_work_date:=v_snapshot.work_date; v_start:=v_snapshot.start_at_local; v_end:=v_snapshot.end_at_local;
        v_break:=v_snapshot.break_minutes; v_reference:=v_snapshot.external_event_identity;
      end if;
    elsif v_is_report and v_movement.source_line_kind='SELF_BILL_REPORT_LINE' then
      if v_movement.source_facts_json->>'bound_pay_snapshot_line_id' is not null then
        select snapshot.* into strict v_snapshot from public.weekly_source_final_snapshot_lines snapshot
          where snapshot.id=coalesce((v_movement.source_facts_json->>'bound_export_snapshot_line_id')::uuid,
                (v_movement.source_facts_json->>'bound_pay_snapshot_line_id')::uuid)
              and snapshot.final_revision_id=coalesce((v_movement.source_facts_json->>'bound_export_final_revision_id')::uuid,
                (v_movement.source_facts_json->>'bound_pay_final_revision_id')::uuid)
              and (not (v_movement.source_facts_json ? 'bound_export_snapshot_line_id') or (
                snapshot.pay_effect='NONE'
                and snapshot.row_resolution_id=(v_movement.source_facts_json->>'bound_row_resolution_id')::uuid
                and snapshot.upload_row_id=(v_movement.source_facts_json->>'bound_export_upload_row_id')::uuid
                and encode(snapshot.snapshot_line_hash,'hex')=v_movement.source_facts_json->>'bound_export_snapshot_line_hash'
                and snapshot.paid_overlap_choice_id=(v_movement.source_facts_json->>'bound_export_paid_overlap_choice_id')::bigint
                and v_movement.source_facts_json->>'bound_export_pay_effect'='NONE'
                and v_movement.source_facts_json#>>'{retained_pay_basis,snapshot_line_id}'=v_movement.source_facts_json->>'bound_pay_snapshot_line_id'
                and v_movement.source_facts_json#>>'{retained_pay_basis,final_revision_id}'=snapshot.final_revision_id::text
                and v_movement.source_facts_json#>>'{retained_pay_basis,work_event_id}'=snapshot.work_event_id::text
                and exists(select 1 from jsonb_array_elements(v_movement.source_facts_json#>'{retained_pay_basis,actual_present_invoice_rows}') item
                  where item=jsonb_build_object('snapshot_line_id',snapshot.id,'upload_row_id',snapshot.upload_row_id,
                    'paid_overlap_choice_id',snapshot.paid_overlap_choice_id,'snapshot_line_hash',encode(snapshot.snapshot_line_hash,'hex')))))
            and snapshot.client_id=v_manifest.client_id and snapshot.contract_id=v_movement.contract_id and snapshot.work_event_id=v_movement.work_event_id;
        v_work_date:=v_snapshot.work_date;v_start:=v_snapshot.start_at_local;v_end:=v_snapshot.end_at_local;
        v_break:=v_snapshot.break_minutes;v_reference:=v_snapshot.external_event_identity;
      else
        if v_movement.movement_role<>'STANDALONE_NEGATIVE' then
          raise exception 'WEEKLY_SOURCE_REPORT_INVOICE_BOUND_PRESENTATION_REQUIRED' using errcode='55000'; end if;
        select * into strict v_source_row from public.weekly_source_upload_rows where id=v_movement.self_bill_report_row_id and upload_id=v_revision.upload_id;
        v_work_date:=v_source_row.work_date;v_start:=v_source_row.start_at_local;v_end:=v_source_row.end_at_local;
        v_break:=null;v_reference:=v_source_row.external_source_key;
      end if;
    elsif v_movement.invoice_only_snapshot_line_id is not null then
      perform private.weekly_source_paid_match_invoice_origin_assert_v1(v_movement.id);
      if v_count<>1 or v_is_net then raise exception 'WEEKLY_SOURCE_PAID_MATCH_INVOICE_GROUP_INVALID' using errcode='55000';end if;
      select snapshot.* into strict v_snapshot from public.weekly_source_final_snapshot_lines snapshot
        where snapshot.id=v_movement.invoice_only_snapshot_line_id and snapshot.final_revision_id=v_revision.id;
      v_work_date:=v_snapshot.work_date;v_start:=v_snapshot.start_at_local;v_end:=v_snapshot.end_at_local;
      v_break:=v_snapshot.break_minutes;v_reference:=v_snapshot.external_event_identity;
      -- Genuine Source hours are presentation evidence. Native pay rates and
      -- total remain zero; no payable position is minted from these hours.
      v_hours_day:=(v_snapshot.pay_vector_json#>>'{hours,day}')::numeric;
      v_hours_night:=(v_snapshot.pay_vector_json#>>'{hours,night}')::numeric;
      v_hours_sat:=(v_snapshot.pay_vector_json#>>'{hours,sat}')::numeric;
      v_hours_sun:=(v_snapshot.pay_vector_json#>>'{hours,sun}')::numeric;
      v_hours_bh:=(v_snapshot.pay_vector_json#>>'{hours,bh}')::numeric;
    elsif v_is_expense then
      select source_row.* into strict v_source_row
      from public.weekly_expense_authority_generations expense_authority
      join public.weekly_source_row_expense_policy_snapshots expense_policy
        on expense_policy.id=expense_authority.row_expense_policy_snapshot_id
      join public.weekly_source_upload_rows source_row
        on source_row.id=expense_policy.upload_row_id
      where expense_authority.id=case
        when v_movement.movement_role='EXPENSE_REVERSAL' then (
          select prior_movement.expense_authority_generation_id
          from public.weekly_source_billing_movements prior_movement
          where prior_movement.id=v_movement.prior_movement_id
        ) else v_movement.expense_authority_generation_id end;
      v_work_date:=v_source_row.work_date;
      v_start:=v_source_row.start_at_local;
      v_end:=v_source_row.end_at_local;
      v_break:=coalesce(v_source_row.break_minutes,0);
      v_reference:=v_source_row.external_source_key;
    elsif v_movement.source_profile_kind='NHSP_TRUST_BACKING_REPORT' then
      if v_movement.pay_effect='NONE' then
        perform private.weekly_source_nhsp_none_invoice_origin_assert_v1(v_movement.id);
        if v_count<>1 or v_is_net then raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_GROUP_UNBOUND' using errcode='55000';end if;
      end if;
      select * into strict v_source_row from public.weekly_source_upload_rows
      where id=v_movement.nhsp_upload_row_id;
      v_work_date:=v_source_row.work_date;
      v_start:=v_source_row.start_at_local;
      v_end:=v_source_row.end_at_local;
      v_break:=v_source_row.break_minutes;
      v_reference:=v_source_row.external_source_key;
      if v_movement.pay_effect='NONE' then
        select e.hours_day,e.hours_night,e.hours_sat,e.hours_sun,e.hours_bh
          into strict v_hours_day,v_hours_night,v_hours_sat,v_hours_sun,v_hours_bh
          from public.weekly_source_row_economic_snapshots e
          where e.row_resolution_id=(v_movement.source_facts_json->>'bound_row_resolution_id')::uuid;
      end if;
    else
      select snapshot.* into strict v_snapshot
      from public.weekly_source_state_transitions transition_row
      join public.weekly_source_final_snapshot_lines snapshot
        on snapshot.id=case
          when v_is_net or v_movement.movement_role in (
            'POSITIVE','REPLACEMENT','EXPENSE_POSITIVE','EXPENSE_REPLACEMENT'
          ) then transition_row.new_snapshot_line_id
          else transition_row.previous_snapshot_line_id end
      where transition_row.final_revision_id=v_manifest.final_revision_id
        and transition_row.work_event_id=v_movement.work_event_id;
      v_work_date:=v_snapshot.work_date;
      v_start:=v_snapshot.start_at_local;
      v_end:=v_snapshot.end_at_local;
      v_break:=v_snapshot.break_minutes;
      v_reference:=v_snapshot.external_event_identity;
    end if;

    v_mapping_fingerprint:=v_movement.mapping_rate_policy_fingerprint;
    v_price_fingerprint:=case when v_count=1 then v_movement.price_check_fingerprint end;

    select
      coalesce(pg_catalog.sum((movement.canonical_pay_vector_json#>>'{hours,day}')::numeric),0),
      coalesce(pg_catalog.sum((movement.canonical_pay_vector_json#>>'{hours,night}')::numeric),0),
      coalesce(pg_catalog.sum((movement.canonical_pay_vector_json#>>'{hours,sat}')::numeric),0),
      coalesce(pg_catalog.sum((movement.canonical_pay_vector_json#>>'{hours,sun}')::numeric),0),
      coalesce(pg_catalog.sum((movement.canonical_pay_vector_json#>>'{hours,bh}')::numeric),0),
      pg_catalog.sum(movement.total_pay_ex_vat),
      pg_catalog.sum(movement.invoice_presentation_charge_pence)::numeric/100,
      pg_catalog.sum(movement.calculated_comparison_charge_pence),
      case when pg_catalog.count(movement.source_validation_charge_pence)=pg_catalog.count(*)
        then pg_catalog.sum(movement.source_validation_charge_pence) end,
      pg_catalog.sum(movement.vat_amount),pg_catalog.sum(movement.total_inc_vat),
      pg_catalog.min(movement.vat_rate_pct),
      case when pg_catalog.count(distinct movement.price_check_result)=1
        then pg_catalog.min(movement.price_check_result) else 'NOT_APPLICABLE' end,
      private.weekly_source_invoice_presentation_source_hash_v1(v_ids,null)
    into v_hours_day,v_hours_night,v_hours_sat,v_hours_sun,v_hours_bh,
         v_total_pay,v_total_charge,v_calc_pence,v_source_pence,v_vat,v_total,
         v_vat_rate,v_price_result,v_source_hash
    from public.weekly_source_billing_movements movement where movement.id=any(v_ids);
    select receipt.id,m.id into v_release_id,v_release_member from public.weekly_source_billing_movements m
      join public.weekly_source_invoice_hold_releases receipt on receipt.upload_row_id::text=m.source_facts_json->>'upload_row_id' and receipt.hold_kind='VAT_FIT'
      where m.id=any(v_ids) and m.movement_role in ('POSITIVE','REPLACEMENT')
        and m.source_line_kind in ('SOURCE_ORDINARY','SOURCE_REPLACEMENT','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION');
    if found then
      v_release_money:=private.weekly_source_invoice_movement_money_v1(v_release_member,v_release_id);
      v_release_authority:=v_release_money->'release_authority';
      select v_vat-m.vat_amount+(v_release_money->>'vat_pence')::numeric/100,
        v_total-m.total_inc_vat+(v_release_money->>'gross_pence')::numeric/100 into v_vat,v_total
        from public.weekly_source_billing_movements m where m.id=v_release_member;
      v_source_hash:=private.weekly_source_invoice_presentation_source_hash_v1(v_ids,v_release_id);
    end if;
    if v_is_rounding and v_round_authority is not null then
      if v_ids<>array[(v_round_authority->>'rounding_movement_id')::uuid] then
        raise exception 'WEEKLY_SOURCE_ROUNDING_PRESENTATION_MEMBER_INVALID' using errcode='55000'; end if;
      v_round_presentation:=v_round_authority;
      v_vat:=(v_round_authority->>'admitted_rounding_vat_pence')::numeric/100;
      v_total:=v_vat;
      v_source_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_INVOICE_ROUNDING_PRESENTATION_V1',
        jsonb_build_object('original_movement_source_hash',encode(v_source_hash,'hex'),
          'rounding_authority_sha256',v_round_authority->>'authority_sha256'));
      -- New authority hash is reproducible from exact stored native typmods.
      -- Retained ordinary/NULL-rule presentation hash inputs remain untouched.
      v_hours_day:=v_hours_day::numeric(7,2);v_hours_night:=v_hours_night::numeric(7,2);
      v_hours_sat:=v_hours_sat::numeric(7,2);v_hours_sun:=v_hours_sun::numeric(7,2);v_hours_bh:=v_hours_bh::numeric(7,2);
      v_total_pay:=v_total_pay::numeric(12,2);v_total_charge:=v_total_charge::numeric(12,2);
      v_vat_rate:=v_vat_rate::numeric(5,2);v_vat:=v_vat::numeric(12,2);v_total:=v_total::numeric(12,2);
    end if;
    if v_is_expense then
      v_hours_day:=0;v_hours_night:=0;v_hours_sat:=0;v_hours_sun:=0;v_hours_bh:=0;
      v_pay_day:=null;v_pay_night:=null;v_pay_sat:=null;v_pay_sun:=null;v_pay_bh:=null;
      v_charge_day:=null;v_charge_night:=null;v_charge_sat:=null;v_charge_sun:=null;v_charge_bh:=null;
    else
      v_pay_day:=(v_movement.canonical_pay_vector_json#>>'{rates,day}')::numeric;
      v_pay_night:=(v_movement.canonical_pay_vector_json#>>'{rates,night}')::numeric;
      v_pay_sat:=(v_movement.canonical_pay_vector_json#>>'{rates,sat}')::numeric;
      v_pay_sun:=(v_movement.canonical_pay_vector_json#>>'{rates,sun}')::numeric;
      v_pay_bh:=(v_movement.canonical_pay_vector_json#>>'{rates,bh}')::numeric;
      v_charge_day:=(v_movement.canonical_charge_vector_json#>>'{rates,day}')::numeric;
      v_charge_night:=(v_movement.canonical_charge_vector_json#>>'{rates,night}')::numeric;
      v_charge_sat:=(v_movement.canonical_charge_vector_json#>>'{rates,sat}')::numeric;
      v_charge_sun:=(v_movement.canonical_charge_vector_json#>>'{rates,sun}')::numeric;
      v_charge_bh:=(v_movement.canonical_charge_vector_json#>>'{rates,bh}')::numeric;
    end if;
    v_line_kind:=case
      when v_movement.source_line_kind in ('INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION','SELF_BILL_REPORT_LINE') then v_movement.source_line_kind
      when v_is_expense then 'SOURCE_FIXED_EXPENSE'
      when v_is_net then 'NON_NHSP_DIFFERENCE'
      when v_movement.movement_role='REPLACEMENT' then 'SOURCE_REPLACEMENT'
      when v_movement.movement_role='REVERSAL' then 'GENERATED_HISTORICAL_REVERSAL'
      else 'SOURCE_ORDINARY' end;
    v_origin_kind:=case
      when v_movement.invoice_only_snapshot_line_id is not null then 'SOURCE_INVOICE_ONLY_SNAPSHOT'
      when v_is_rounding then 'INVOICE_VAT_ROUNDING'
      when v_is_report and v_movement.source_line_kind='SELF_BILL_REPORT_LINE' then
        case when v_movement.movement_role='STANDALONE_NEGATIVE' then 'SELF_BILL_REPORT_STANDALONE_CREDIT' else 'SELF_BILL_REPORT_LINE' end
      when v_is_expense then 'SOURCE_FIXED_EXPENSE'
      when v_movement.source_profile_kind='NHSP_TRUST_BACKING_REPORT' then 'NHSP_PHYSICAL_ROW'
      when v_movement.source_profile_kind='HEALTHROSTER_ACTUAL_ROWS' then 'HEALTHROSTER_TRANSITION'
      else 'GENERIC_TRANSITION' end;
    v_correction_role:=case
      when v_is_net then 'NET_DIFFERENCE'
      when v_movement.movement_role in ('REVERSAL','EXPENSE_REVERSAL') then 'REVERSAL'
      when v_movement.movement_role in ('REPLACEMENT','EXPENSE_REPLACEMENT') then 'REPLACEMENT'
      else null end;
    v_old_id:=null;v_new_id:=null;
    select id into v_old_id from public.weekly_source_billing_movements
      where id=any(v_ids) and movement_role in ('REVERSAL','EXPENSE_REVERSAL') limit 1;
    select id into v_new_id from public.weekly_source_billing_movements
      where id=any(v_ids) and movement_role in ('REPLACEMENT','EXPENSE_REPLACEMENT') limit 1;
    v_description:=case when v_is_rounding then 'VAT rounding (matches the client''s self-bill)'
      when v_movement.source_line_kind='SOURCE_INVOICE_CORRECTION' then 'Source invoice correction'
      when v_is_expense then 'Source expense'
      else pg_catalog.concat_ws(' · ',coalesce(v_contract.role,'Shift'),
        pg_catalog.to_char(v_work_date,'Dy DD Mon YYYY'),
        pg_catalog.to_char(v_start,'HH24:MI')||'–'||pg_catalog.to_char(v_end,'HH24:MI'),
        case when v_break>0 then v_break::text||' min break' end) end;
    v_presentation_hash:=private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_INVOICE_PRESENTATION_V1',
      pg_catalog.jsonb_build_object(
        'client_manifest_id',v_manifest.id,'movement_ids',pg_catalog.to_jsonb(v_ids),
        'line_kind',v_line_kind,'source_shift_group_id',v_movement.work_event_id,
        'work_date',v_work_date,'start_at_local',v_start,'end_at_local',v_end,
        'break_minutes',v_break,'hours',pg_catalog.jsonb_build_array(
          v_hours_day,v_hours_night,v_hours_sat,v_hours_sun,v_hours_bh),
        'total_pay',v_total_pay,'total_charge',v_total_charge,
        'vat_rate',v_vat_rate,'vat',v_vat,'total',v_total,
        'charge_acceptance_id',v_movement.charge_acceptance_id,
        'source_hash',pg_catalog.encode(v_source_hash,'hex')
      )||case when v_release_authority is null then '{}'::jsonb else jsonb_build_object('invoice_hold_release_authority',v_release_authority) end||case when v_round_presentation is null then '{}'::jsonb else jsonb_build_object('weekly_source_rounding_authority',v_round_presentation) end
    );
    insert into public.weekly_source_invoice_presentation_lines(
      billing_movement_id,client_manifest_id,final_revision_id,
      original_finalisation_cycle_id,line_kind,origin_kind,correction_root_id,
      correction_role,old_internal_movement_id,new_internal_movement_id,
      client_id,candidate_id,contract_id,work_event_id,source_shift_group_id,
      role_snapshot,band_snapshot,candidate_display_snapshot,client_display_snapshot,
      work_date,start_at_local,end_at_local,break_minutes,booking_reference_snapshot,
      description_snapshot,hours_day,hours_night,hours_sat,hours_sun,hours_bh,
      pay_day,pay_night,pay_sat,pay_sun,pay_bh,
      charge_day,charge_night,charge_sat,charge_sun,charge_bh,
      total_pay_ex_vat,total_charge_ex_vat,calculated_comparison_charge_pence,
      source_validation_charge_pence,invoice_presentation_charge_pence,
      margin_ex_vat,vat_rate_pct,vat_amount,total_inc_vat,price_check_result,
      price_check_profile,charge_acceptance_id,mapping_rate_policy_fingerprint,source_hash,
      amount_authority,presentation_hash,invoice_hold_release_id,invoice_rounding_authority_json,companion_presentation_line_id
    ) values (
      v_movement.id,v_manifest.id,v_manifest.final_revision_id,v_manifest.source_cycle_id,
      v_line_kind,v_origin_kind,v_movement.correction_unit_id,v_correction_role,
      v_old_id,v_new_id,v_manifest.client_id,v_movement.candidate_id,v_movement.contract_id,
      v_movement.work_event_id,v_movement.work_event_id,v_contract.role,v_contract.band,
      v_candidate_display,v_client_display,v_work_date,v_start,v_end,v_break,v_reference,
      v_description,v_hours_day,v_hours_night,v_hours_sat,v_hours_sun,v_hours_bh,
      v_pay_day,v_pay_night,v_pay_sat,v_pay_sun,v_pay_bh,
      v_charge_day,v_charge_night,v_charge_sat,v_charge_sun,v_charge_bh,
      v_total_pay,v_total_charge,v_calc_pence,v_source_pence,(v_total_charge*100)::bigint,
      v_total_charge-v_total_pay,v_vat_rate,v_vat,v_total,v_price_result,
      case when v_movement.source_profile_kind='NHSP_TRUST_BACKING_REPORT'
        then 'NHSP_TWO_COMPONENT_PENCE_V1' when v_is_report and v_movement.source_line_kind='SELF_BILL_REPORT_LINE' then 'SOURCE_INVOICE_MONEY_PENCE_V1' when private.weekly_source_invoice_source_amount_movement_valid_v1(v_movement.id) then 'SOURCE_INVOICE_MONEY_PENCE_V1' else null end,
      v_movement.charge_acceptance_id,
      v_mapping_fingerprint,v_source_hash,
      case when v_movement.source_profile_kind='NHSP_TRUST_BACKING_REPORT' or v_is_expense
        or (v_is_report and v_movement.source_line_kind='SELF_BILL_REPORT_LINE')
        or private.weekly_source_invoice_source_amount_movement_valid_v1(v_movement.id)
        then 'VALIDATED_SOURCE_PENCE' else 'CLOUDTMS_CALCULATION' end,
      v_presentation_hash,v_release_id,v_round_presentation,
      -- 24 section 12: "a source-fixed expense declared as part of the same
      -- source presentation follows its defined companion relationship; no
      -- unrelated expense or work-event line moves accidentally."  Declared
      -- only when exactly one shift presentation of the same work event and the
      -- same correction role exists in this manifest, so the relationship is
      -- never guessed; null otherwise and the expense then moves on its own.
      -- PostgreSQL has no min(uuid), so the text form is aggregated and cast
      -- back after the having clause has proved the single-value cardinality.
      case when v_is_expense and v_movement.invoice_only_snapshot_line_id is not null then (
        select pg_catalog.min(shift_line.id::text)::uuid
        from public.weekly_source_invoice_presentation_lines shift_line
        join public.weekly_source_invoice_line_bindings hours_binding on hours_binding.presentation_line_id=shift_line.id
          and hours_binding.state='CURRENT' and hours_binding.invoice_id=v_invoice_id
        join public.weekly_source_billing_movements hours_movement on hours_movement.id=hours_binding.billing_movement_id
        where shift_line.client_manifest_id=v_manifest.id
          and hours_movement.invoice_only_snapshot_line_id=v_movement.invoice_only_snapshot_line_id
          and hours_movement.source_line_kind='SOURCE_REBILL_LINE' and hours_movement.pay_effect='NONE'
        having count(*)=1
      ) when v_is_expense then (
        select pg_catalog.min(shift_line.id::text)::uuid
        from public.weekly_source_invoice_presentation_lines shift_line
        where shift_line.client_manifest_id=v_manifest.id
          and shift_line.work_event_id=v_movement.work_event_id
          and shift_line.line_kind<>'SOURCE_FIXED_EXPENSE'
          and shift_line.correction_role is not distinct from v_correction_role
        having pg_catalog.count(*)=1
      ) end
    ) returning id into v_presentation_id;

    insert into public.invoice_lines(
      invoice_id,timesheet_id,booking_id,description,
      hours_day,hours_night,hours_sat,hours_sun,hours_bh,
      pay_day,pay_night,pay_sat,pay_sun,pay_bh,
      charge_day,charge_night,charge_sat,charge_sun,charge_bh,
      total_pay_ex_vat,total_charge_ex_vat,margin_ex_vat,vat_rate_pct,
      vat_amount,total_inc_vat,meta_json,source_key
    ) values (
      v_invoice_id,v_movement.invoice_timesheet_id,v_reference,v_description,
      v_hours_day,v_hours_night,v_hours_sat,v_hours_sun,v_hours_bh,
      v_pay_day,v_pay_night,v_pay_sat,v_pay_sun,v_pay_bh,
      v_charge_day,v_charge_night,v_charge_sat,v_charge_sun,v_charge_bh,
      v_total_pay,v_total_charge,v_total_charge-v_total_pay,v_vat_rate,v_vat,v_total,
      pg_catalog.jsonb_build_object(
        'line_type','WEEKLY_FINAL_SOURCE','presentation_line_id',v_presentation_id,
        'source_shift_group_id',v_movement.work_event_id,
        'client_manifest_id',v_manifest.id,'movement_ids',pg_catalog.to_jsonb(v_ids)
      )||case when v_release_authority is null then '{}'::jsonb else jsonb_build_object('invoice_hold_release_authority',v_release_authority) end||case when v_round_presentation is null then '{}'::jsonb else jsonb_build_object(
        'weekly_source_rounding_authority',v_round_presentation,
        'presentation_disposition',case when (v_round_presentation->>'suppress_visible_rounding_line')::boolean
          then 'SUPPRESS_ZERO_ROUNDING_AUTHORITY' else 'VISIBLE' end) end,'WEEKLY_SOURCE:'||v_presentation_id::text
    ) returning id into v_invoice_line_id;

    foreach v_member_id in array v_ids loop
      select * into strict v_member from public.weekly_source_billing_movements
      where id=v_member_id;
      v_materialised_hash:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_INVOICE_BINDING_V1',pg_catalog.jsonb_build_object(
          'movement_id',v_member.id,'presentation_line_id',v_presentation_id,
          'invoice_line_id',v_invoice_line_id,'invoice_id',v_invoice_id,
          'manifest_hash',pg_catalog.encode(v_manifest.manifest_hash,'hex'),'binding_version',1
        )
      );
      insert into public.weekly_source_invoice_line_bindings(
        billing_movement_id,presentation_line_id,invoice_line_id,invoice_id,
        original_final_revision_id,original_cycle_id,client_id,correction_root_id,
        correction_role,manifest_hash,materialised_line_hash,binding_version,state
      ) values (
        v_member.id,v_presentation_id,v_invoice_line_id,v_invoice_id,
        v_manifest.final_revision_id,v_manifest.source_cycle_id,v_manifest.client_id,
        v_member.correction_unit_id,v_correction_role,v_manifest.manifest_hash,
        v_materialised_hash,1,'CURRENT'
      ) returning id into v_binding_id;
      v_placement_hash:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_INVOICE_PLACEMENT_V1',pg_catalog.jsonb_build_object(
          'movement_id',v_member.id,'invoice_id',v_invoice_id,
          'invoice_line_id',v_invoice_line_id,'placement_revision',1,
          'placement_reason','AUTOMATIC_SOURCE_BATCH'
        )
      );
      insert into public.weekly_source_invoice_placements(
        billing_movement_id,source_shift_group_id,invoice_id,invoice_line_id,
        placement_revision,placement_state,is_current,original_automatic_cycle_id,
        current_target_cycle_id,placement_reason,actor_user_id,placement_hash
      ) values (
        v_member.id,v_member.work_event_id,v_invoice_id,v_invoice_line_id,1,
        'PLACED',true,v_invoice_window.id,v_invoice_window.id,
        'AUTOMATIC_SOURCE_BATCH',v_actor,v_placement_hash
      );
      update public.weekly_source_billing_movements
      set placement_state='PLACED' where id=v_member.id and placement_state='UNPLACED';
      if not found then
        raise exception 'WEEKLY_SOURCE_INVOICE_MOVEMENT_CAS_LOST' using errcode='40001';
      end if;
    end loop;
  end loop;

  insert into public.weekly_source_expense_materialisations(
    expense_authority_generation_id,billing_movement_id,
    invoice_presentation_line_id,expense_lineage_hash,state
  )
  select movement.expense_authority_generation_id,
         (pg_catalog.array_agg(
           movement.id
           order by (movement.movement_role not in (
             'EXPENSE_POSITIVE','EXPENSE_REPLACEMENT'
           )),movement.id
         ))[1],
         (pg_catalog.array_agg(
           binding.presentation_line_id
           order by (movement.movement_role not in (
             'EXPENSE_POSITIVE','EXPENSE_REPLACEMENT'
           )),movement.id
         ))[1],
         private.weekly_source_sha256_jsonb_v1(
           'WEEKLY_SOURCE_EXPENSE_INVOICE_MATERIALISATION_V1',
           pg_catalog.jsonb_build_object(
             'expense_authority_generation_id',movement.expense_authority_generation_id,
             'movement_ids',pg_catalog.jsonb_agg(movement.id order by movement.id),
             'presentation_ids',pg_catalog.jsonb_agg(binding.presentation_line_id order by movement.id)
           )
         ),'MATERIALISED'
  from public.weekly_source_manifest_movements mm
  join public.weekly_source_billing_movements movement on movement.id=mm.billing_movement_id
  join public.weekly_source_invoice_line_bindings binding
    on binding.billing_movement_id=movement.id and binding.state='CURRENT'
  where mm.client_manifest_id=v_manifest.id
    and movement.expense_authority_generation_id is not null
  group by movement.expense_authority_generation_id;

  perform private.weekly_source_invoice_header_refresh_v1(v_invoice_id);
  perform public.invoice_recompute_totals(v_invoice_id);
  perform private.weekly_source_invoice_allocation_assert_v1(v_invoice_id);
  if exists(
    select 1 from public.weekly_source_manifest_movements mm
    where mm.client_manifest_id=v_manifest.id
      and not exists(
        select 1 from public.weekly_source_invoice_line_bindings binding
        where binding.billing_movement_id=mm.billing_movement_id and binding.state='CURRENT'
      )
  ) then
    raise exception 'WEEKLY_SOURCE_INVOICE_MANIFEST_NOT_FULLY_ADMITTED' using errcode='55000';
  end if;
  update public.weekly_source_client_manifests set invoice_state='ADMITTED'
  where id=v_manifest.id and invoice_state='READY';
  if not found then
    raise exception 'WEEKLY_SOURCE_INVOICE_MANIFEST_CAS_LOST' using errcode='40001';
  end if;
  perform pg_catalog.set_config('cloudtms.weekly_source_invoice_owner','',true);

  insert into public.audit_events(
    ts_utc,actor_user_id,actor_display,actor_role_at_time,object_type,
    object_id_text,action,before_json,after_json,reason
  )
  select pg_catalog.statement_timestamp(),v_actor,actor.display_name,actor.role,
         'invoices',v_invoice_id::text,'WEEKLY_SOURCE_INVOICE_ADMITTED',null,
         pg_catalog.jsonb_build_object(
           'client_manifest_id',v_manifest.id,'source_cycle_id',v_manifest.source_cycle_id,
           'client_id',v_manifest.client_id,'movement_count',v_manifest.movement_count,
           'backing_report_number',v_manifest.backing_report_number
         ),'FINAL_SOURCE_MANIFEST'
  from public.tms_users actor where actor.id=v_actor;
  if not found then
    raise exception 'WEEKLY_SOURCE_ACTOR_NOT_FOUND' using errcode='55000';
  end if;

  return pg_catalog.jsonb_build_object(
    'ok',true,'status','ADMITTED','idempotent',false,
    'client_manifest_id',v_manifest.id,'invoice_ids',pg_catalog.jsonb_build_array(v_invoice_id),
    'movement_count',v_manifest.movement_count
  );
end;
$function$;

create or replace function private.weekly_source_shift_on_self_bill_v1(p_work_event_id uuid,p_cycle_or_report uuid)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare c public.weekly_source_cycles%rowtype; event_fact public.weekly_work_events%rowtype; scope_fact public.weekly_source_report_scopes%rowtype;
  rules jsonb; selected boolean:=false; bound boolean:=false; ready boolean:=false;
  r public.weekly_source_row_resolutions%rowtype; s public.weekly_source_upload_rows%rowtype; u public.weekly_source_uploads%rowtype;
  profile text; count_rows integer; ids uuid[]; v_selection_upload_id uuid; v_selection_publication_id uuid; preparing_count integer;
begin
  -- NULL is the existing legacy/no-Source arm. An explicit but missing or
  -- foreign mutation scope is an error, never four false admission facts.
  if p_work_event_id is null or p_cycle_or_report is null then
    return jsonb_build_object('on_accepted_report',false,'bound_to_finalised_export',false,'invoice_ready',false,'s25_pay_selected',false); end if;
  select * into event_fact from public.weekly_work_events where id=p_work_event_id;
  if not found then raise exception 'WEEKLY_SOURCE_SELF_BILL_EVENT_NOT_FOUND' using errcode='22023'; end if;
  select * into c from public.weekly_source_cycles where weekly_source_cycles.id=p_cycle_or_report;
  if not found then
    select * into scope_fact from public.weekly_source_report_scopes where id=p_cycle_or_report;
    if not found then raise exception 'WEEKLY_SOURCE_SELF_BILL_SCOPE_NOT_FOUND' using errcode='22023'; end if;
    select * into strict c from public.weekly_source_cycles where id=scope_fact.source_cycle_id;
    if scope_fact.client_id is distinct from event_fact.client_id or scope_fact.source_group_id is distinct from c.source_group_id
      or not exists(select 1 from public.weekly_source_groups source_group where source_group.id=c.source_group_id
        and source_group.agency_id=scope_fact.agency_id and source_group.environment=scope_fact.environment) then
      raise exception 'WEEKLY_SOURCE_SELF_BILL_SCOPE_MISMATCH' using errcode='22023'; end if;
  end if;
  if event_fact.first_source_group_id is distinct from c.source_group_id
    or (c.scope_client_id is not null and c.scope_client_id is distinct from event_fact.client_id) then
    raise exception 'WEEKLY_SOURCE_SELF_BILL_SCOPE_MISMATCH' using errcode='22023'; end if;
  rules:=private.weekly_source_effective_rule_set_v1(event_fact.client_id,c.id)->'values';
  if rules->>'invoice_sender'='CLIENT_SELF_BILL' and rules->>'self_bill_source'='SEPARATE_FINAL_REPORT' then
    if scope_fact.id is not null and scope_fact.self_bill_report_id is null then
      raise exception 'WEEKLY_SOURCE_SELF_BILL_REPORT_SCOPE_REQUIRED' using errcode='22023'; end if;
    return private.weekly_source_report_shift_facts_v1(event_fact.id,p_cycle_or_report);
  end if;
  if scope_fact.id is not null and scope_fact.self_bill_report_id is not null then
    raise exception 'WEEKLY_SOURCE_SELF_BILL_REPORT_RULE_MISMATCH' using errcode='22023'; end if;
  if rules is null or rules->>'invoice_sender' is distinct from 'CLIENT_SELF_BILL' or rules->>'self_bill_source' is distinct from 'SAME_FILE' then
    return jsonb_build_object('on_accepted_report',false,'bound_to_finalised_export',false,'invoice_ready',false,'s25_pay_selected',false); end if;
  v_selection_upload_id:=c.current_complete_upload_id; v_selection_publication_id:=c.current_projection_publication_id;
  select count(*) into preparing_count from public.weekly_final_source_correction_sessions correction
    where correction.source_cycle_id=c.id and correction.authority_scope_kind='CYCLE' and correction.state='PREPARING'
      and correction.expected_current_final_revision_id=c.current_final_revision_id;
  if preparing_count>1 then raise exception 'WEEKLY_SOURCE_SELF_BILL_CORRECTION_SCOPE_AMBIGUOUS' using errcode='55000'; end if;
  if preparing_count=1 then
    -- Only native PREPARE has this state. PREPARED stays hidden and ordinary
    -- readers retain the committed current pointer.
    select correction.replacement_correction_upload_id,correction.replacement_projection_publication_id
      into v_selection_upload_id,v_selection_publication_id from public.weekly_final_source_correction_sessions correction
      where correction.source_cycle_id=c.id and correction.authority_scope_kind='CYCLE' and correction.state='PREPARING'
        and correction.expected_current_final_revision_id=c.current_final_revision_id;
  end if;
  select array_agg(resolution.id),count(*) into ids,count_rows from public.weekly_source_row_resolutions resolution
    join public.weekly_source_upload_rows source_row on source_row.id=resolution.upload_row_id
    join public.weekly_source_uploads upload on upload.id=source_row.upload_id
    join public.weekly_source_projection_publications publication on publication.id=v_selection_publication_id and publication.upload_id=upload.id
      and publication.source_cycle_id=c.id and publication.report_scope_id is null and publication.authority_scope_kind='CYCLE'
      and publication.state=case when preparing_count=1 then 'CORRECTION_READY' else 'CURRENT' end
    join public.weekly_work_events actual_event on actual_event.id=resolution.work_event_id and actual_event.client_id=resolution.client_id
      and actual_event.candidate_id=resolution.candidate_id and actual_event.first_source_group_id=c.source_group_id
    where upload.source_cycle_id=c.id and upload.report_scope_id is null
      and upload.state=case when preparing_count=1 then 'CORRECTION_READY' else 'CURRENT' end
      and (c.scope_client_id is null or c.scope_client_id=resolution.client_id) and resolution.work_event_id=p_work_event_id and upload.id=v_selection_upload_id
      and resolution.generation=coalesce(publication.projection_generation,publication.authority_scope_version)
      and resolution.mapping_state='RESOLVED' and resolution.pay_effect='NORMAL';
  if count_rows=0 then
    -- This selects an actual immutable prior row as PAY basis, not as current
    -- upload membership. Real current NONE rows and their immutable confirmations
    -- are the independent source-presence evidence for this branch.
    select array_agg(distinct prior_resolution.id),count(distinct prior_resolution.id)
      into ids,count_rows
    from public.weekly_source_row_resolutions companion
    join public.weekly_source_upload_rows current_row on current_row.id=companion.upload_row_id
    join public.weekly_source_uploads current_upload on current_upload.id=current_row.upload_id
    join public.weekly_source_projection_publications current_publication
      on current_publication.id=v_selection_publication_id and current_publication.upload_id=current_upload.id
        and current_publication.source_cycle_id=c.id and current_publication.authority_scope_kind='CYCLE'
        and current_publication.state=case when preparing_count=1 then 'CORRECTION_READY' else 'CURRENT' end
    join private.weekly_source_office_row_choices choice on choice.id=companion.paid_overlap_choice_id
      and choice.upload_row_id=current_row.id and choice.pay_effect='NONE' and not choice.separate_shift
      and choice.work_event_id=event_fact.id and choice.paid_overlap_target_work_event_id=event_fact.id
      and choice.candidate_id=event_fact.candidate_id and choice.client_id=event_fact.client_id
    cross join lateral jsonb_array_elements(choice.paid_overlap_inputs_json#>'{inputs,overlaps}') item
    join public.weekly_source_final_snapshot_lines prior_snapshot
      on prior_snapshot.id=(item->>'snapshot_line_id')::uuid and prior_snapshot.work_event_id=event_fact.id
        and prior_snapshot.candidate_id=event_fact.candidate_id and prior_snapshot.client_id=event_fact.client_id
        and prior_snapshot.contract_id=choice.contract_id and prior_snapshot.pay_effect='NORMAL'
    join public.weekly_source_row_resolutions prior_resolution on prior_resolution.id=prior_snapshot.row_resolution_id
      and prior_resolution.work_event_id=event_fact.id and prior_resolution.pay_effect='NORMAL'
    join public.weekly_source_final_revisions prior_revision on prior_revision.id=prior_snapshot.final_revision_id
    join public.weekly_source_cycles prior_cycle on prior_cycle.id=prior_revision.source_cycle_id
      and prior_cycle.source_group_id=c.source_group_id and prior_cycle.finalisation_week_ending<c.finalisation_week_ending
    join public.weekly_source_billing_movements prior_movement on prior_movement.id=(item->>'current_pay_head_movement_id')::uuid
      and prior_movement.work_event_id=event_fact.id and prior_movement.candidate_id=event_fact.candidate_id
      and prior_movement.actual_client_id=event_fact.client_id and prior_movement.contract_id=prior_snapshot.contract_id
      and prior_movement.pay_effect='NORMAL' and prior_movement.movement_role in ('POSITIVE','REPLACEMENT')
      and prior_movement.source_line_kind in ('SOURCE_ORDINARY','SOURCE_REPLACEMENT')
    where current_upload.id=v_selection_upload_id and current_upload.source_cycle_id=c.id and current_upload.report_scope_id is null
      and current_upload.state=case when preparing_count=1 then 'CORRECTION_READY' else 'CURRENT' end
      and companion.generation=coalesce(current_publication.projection_generation,current_publication.authority_scope_version)
      and companion.mapping_state='RESOLVED' and companion.pay_effect='NONE' and companion.work_event_id=event_fact.id
      and companion.candidate_id=event_fact.candidate_id and companion.client_id=event_fact.client_id
      and companion.contract_id=choice.contract_id and item->>'work_event_id'=event_fact.id::text
      and current_row.row_finalisation_state='SOURCE_WORKED' and current_row.work_date=event_fact.work_date
      and item#>'{native_payment_facts,paid}'='true'::jsonb
      and item#>>'{native_payment_facts,paid_evidence_state}'='SETTLED_ORIGINAL'
      and item->>'snapshot_line_hash'=encode(prior_snapshot.snapshot_line_hash,'hex')
      and item->>'movement_economic_hash'=encode(prior_movement.movement_economic_hash,'hex')
      and exists(select 1 from public.audit_events a where a.object_type='weekly_source_office_row_choices'
        and a.object_id_text=choice.id::text and a.action='WEEKLY_SOURCE_PAID_SHIFT_MATCH_CONFIRMED'
        and a.actor_user_id=choice.actor_user_id and a.after_json->'choice'=to_jsonb(choice)
        and a.after_json->'admission'=choice.paid_overlap_inputs_json);
  end if;
  if count_rows>1 then raise exception 'WEEKLY_SOURCE_SELF_BILL_SHIFT_AMBIGUOUS' using errcode='55000'; end if;
  if count_rows=1 then
    select * into strict r from public.weekly_source_row_resolutions where weekly_source_row_resolutions.id=ids[1];
    select * into strict s from public.weekly_source_upload_rows where weekly_source_upload_rows.id=r.upload_row_id;
    select * into strict u from public.weekly_source_uploads where weekly_source_uploads.id=s.upload_id;
    select profile_code into strict profile from public.weekly_source_format_profiles where weekly_source_format_profiles.id=u.source_format_profile_id;
    if profile is distinct from rules->>'checking_profile_kind' then return jsonb_build_object('on_accepted_report',false,'bound_to_finalised_export',false,'invoice_ready',false,'s25_pay_selected',false); end if;
    bound:=s.row_finalisation_state='SOURCE_WORKED' or (profile='ROSTER_WEEKLY_SUMMARY_ACTUAL_V1' and s.row_finalisation_state='NOT_APPLICABLE');
    selected:=bound and s.work_date<=c.finalisation_week_ending and (profile='ROSTER_WEEKLY_SUMMARY_ACTUAL_V1'
      or (s.finalised_at_utc is not null and nullif(btrim(s.finalised_by),'') is not null and s.finalised_at_utc<=c.cutoff_at_utc));
    ready:=selected;
    if selected and rules->>'invoice_amount_basis'='SOURCE_AMOUNT' and rules->>'source_amount_basis'='EXPORT_ACTUAL_COST_INC_VAT_NET_AGENCY_WORKER_PAY' then
      ready:=s.source_money_parse_state='VALID' and s.source_shift_charge_pence is not null and s.source_gross_pence is not null and s.source_vat_pence is not null
        and (abs(5::numeric*s.source_gross_pence-6::numeric*s.source_shift_charge_pence)<=5
          or exists(select 1 from public.weekly_source_invoice_hold_releases receipt where receipt.upload_row_id=s.id and receipt.hold_kind='VAT_FIT'));
    end if;
  end if;
  return jsonb_build_object('on_accepted_report',false,'bound_to_finalised_export',coalesce(bound,false),
    'invoice_ready',coalesce(ready,false),'s25_pay_selected',coalesce(selected,false));
end;
$function$;

create or replace function private.weekly_source_ordinary_projection_source_units_v1(
  p_final_revision_id uuid,
  p_root_timesheet_id uuid
) returns jsonb
language sql stable security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
  select coalesce(pg_catalog.jsonb_agg(
    pg_catalog.jsonb_build_object(
      'manifest_ordinal',manifest_movement.manifest_ordinal,
      'movement_id',movement.id,
      'work_event_id',movement.work_event_id,
      'movement_role',movement.movement_role,
      'source_profile_kind',movement.source_profile_kind,
      'source_line_kind',movement.source_line_kind,
      'movement_economic_hash',pg_catalog.encode(movement.movement_economic_hash,'hex'),
      'mapping_rate_policy_fingerprint',
        pg_catalog.encode(movement.mapping_rate_policy_fingerprint,'hex'),
      'source_facts_hash',pg_catalog.encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_ORDINARY_UNIT_FACTS_V1',movement.source_facts_json
      ),'hex'),
      'first_plan6_negative',(
        movement.source_profile_kind='NHSP_TRUST_BACKING_REPORT'
        and movement.movement_role='REVERSAL'
        and not exists(
          select 1
          from public.weekly_source_billing_movements prior_movement
          join public.weekly_source_final_revisions prior_revision
            on prior_revision.id=prior_movement.final_revision_id
          join public.weekly_source_cycles prior_cycle
            on prior_cycle.id=prior_movement.finalisation_cycle_id
          -- WP-62 (executed on a rotated family): the outstanding positive may
          -- sit on ANOTHER physical member of the Timesheet family, because a
          -- movement keeps the member that was current when its report was
          -- finalised.  Keyed on the physical root alone, a reversal landing
          -- after a rotation was flagged as a first-activation negative, the
          -- projection returned NO_OP_FIRST_NEGATIVE and the Candidate stayed
          -- paid for a shift the Trust had withdrawn.  The search is therefore
          -- keyed on the FAMILY through the established adapter (standing
          -- rule 3); for an unrotated family the adapter returns exactly
          -- {invoice_timesheet_id}, so nothing changes there.
          where prior_movement.source_profile_kind<>'SELF_BILL_REPORT' and prior_movement.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION') and prior_movement.pay_effect='NORMAL'
      and prior_movement.invoice_timesheet_id=any(
            private.weekly_source_invoice_family_timesheet_ids_v1(
              movement.invoice_timesheet_id))
            and prior_movement.work_event_id=movement.work_event_id
            and prior_movement.source_profile_kind='NHSP_TRUST_BACKING_REPORT'
            and prior_movement.movement_role in ('POSITIVE','REPLACEMENT')
            and (
              revision.state<>'PREPARED'
              or prior_revision.id is distinct from revision.predecessor_revision_id
            )
            -- The positive must not stand LATER than this negative on the
            -- revision ladder.  A positive in the SAME revision counts,
            -- whatever physical row it occupied: 14 s4.2.5 says row order has
            -- no financial meaning, so this limb must not read
            -- `source_row_ordinal`, which is what it used to compare.
            and (
              prior_cycle.finalisation_week_ending<source_cycle.finalisation_week_ending
              or (
                prior_cycle.finalisation_week_ending=source_cycle.finalisation_week_ending
                and prior_revision.finalised_at_utc<=revision.finalised_at_utc
              )
            )
        )
      )
    ) order by manifest_movement.manifest_ordinal
  ),'[]'::jsonb)
  from public.weekly_source_billing_movements movement
  join public.weekly_source_manifest_movements manifest_movement
    on manifest_movement.billing_movement_id=movement.id
  join public.weekly_source_client_manifests client_manifest on coalesce(client_manifest.invoice_window_cycle_id,client_manifest.source_cycle_id)=client_manifest.source_cycle_id and client_manifest.id=manifest_movement.client_manifest_id
   and client_manifest.final_revision_id=movement.final_revision_id
   and client_manifest.client_id=movement.actual_client_id
  join public.weekly_source_final_revisions revision
    on revision.id=movement.final_revision_id
  join public.weekly_source_cycles source_cycle
    on source_cycle.id=movement.finalisation_cycle_id
  where movement.source_profile_kind<>'SELF_BILL_REPORT' and movement.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION') and movement.pay_effect='NORMAL'
      and movement.final_revision_id=p_final_revision_id
    and movement.invoice_timesheet_id=p_root_timesheet_id
    and movement.expense_authority_generation_id is null
    and movement.source_line_kind<>'SOURCE_FIXED_EXPENSE';
$function$;

create or replace function private.weekly_source_selected_source_witness_v1(
  p_family_id uuid,p_action_cycle_id uuid,p_work_event_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_family public.weekly_exceptional_pay_target_families%rowtype;
  v_contract public.contracts%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_event public.weekly_work_events%rowtype;
  v_protected public.weekly_exceptional_pay_family_events%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_mapping public.weekly_source_row_resolutions%rowtype;
  v_row public.weekly_source_upload_rows%rowtype;
  v_final public.weekly_source_final_revisions%rowtype;
  v_transition public.weekly_source_state_transitions%rowtype;
  v_snapshot public.weekly_source_final_snapshot_lines%rowtype;
  v_choice private.weekly_source_office_row_choices%rowtype;
  v_mode text; v_kind text; v_basis_kind text;
  v_source jsonb; v_selected jsonb; v_current_row jsonb;
  v_basis jsonb; v_scope jsonb; v_result jsonb; v_history jsonb;
  v_census jsonb:='[]'::jsonb;
  v_rows_checked jsonb;
  v_matches jsonb; v_root_ids uuid[];
  v_count integer; v_generation integer; v_has_positive boolean; v_has_negative boolean;
begin
  if p_family_id is null or p_action_cycle_id is null or p_work_event_id is null then
    raise exception 'WEEKLY_SOURCE_SELECTED_WITNESS_IDENTITY_REQUIRED' using errcode='22023'; end if;
  select * into strict v_family from public.weekly_exceptional_pay_target_families where id=p_family_id;
  select * into strict v_contract from public.contracts where id=v_family.contract_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=p_action_cycle_id;
  select * into strict v_event from public.weekly_work_events where id=p_work_event_id;
  if v_contract.candidate_id is distinct from v_family.candidate_id
     or v_event.candidate_id is distinct from v_family.candidate_id
     or v_event.client_id is distinct from v_contract.client_id
     or v_event.first_source_group_id is distinct from v_cycle.source_group_id
     or v_event.work_date not between v_family.week_start_date and v_family.week_ending_date
     or (v_cycle.scope_client_id is not null and v_cycle.scope_client_id<>v_contract.client_id)
     or v_family.agency_id is distinct from (select agency_id from public.weekly_source_groups where id=v_cycle.source_group_id)
     or v_contract.week_ending_weekday_snapshot not between 0 and 6
     or v_contract.week_ending_weekday_snapshot is null
     or v_event.work_date+((v_contract.week_ending_weekday_snapshot-extract(dow from v_event.work_date)::integer+7)%7)
          is distinct from v_family.week_ending_date then
    raise exception 'WEEKLY_SOURCE_SELECTED_WITNESS_SCOPE_INVALID' using errcode='55000'; end if;
  v_scope:=private.weekly_source_pay_query_scope_v1(v_family.root_timesheet_id);
  if v_scope is null or v_scope->>'target_family_id' is distinct from v_family.id::text then return null; end if;
  v_root_ids:=private.weekly_source_invoice_family_timesheet_ids_v1(v_family.root_timesheet_id);
  if cardinality(v_root_ids) is null or cardinality(v_root_ids)=0 then return null; end if;
  v_mode:=private._weekly_source_effective_policy_v1(v_contract.client_id,v_contract.id,v_event.work_date)->>'c1_source_mode';
  v_source:=private.weekly_source_protected_final_source_context_v1(v_family.id,v_cycle.id,v_event.id);
  select count(*),jsonb_agg(s.value)->0 into v_count,v_selected
    from jsonb_array_elements(v_source->'client_sources') s(value)
    where s.value->>'external_identity'=v_event.id::text;
  if v_count<>1 then return null; end if;

  -- Reuse the exact current-row reader, including Final precedence, original
  -- report scope, configured workweek and raw normalised-row hash domain.
  select count(*),jsonb_agg(s.source)->0 into v_count,v_current_row
    from public.weekly_source_row_resolutions r
    cross join lateral (select private.weekly_source_manual_review_source_v2(r.upload_row_id) source) s
    where r.work_event_id=v_event.id and r.candidate_id=v_family.candidate_id
      and r.client_id=v_contract.client_id and r.contract_id=v_contract.id
      and s.source is not null and s.source->>'row_resolution_id'=r.id::text
      and (v_source->'source_observed'='false'::jsonb
        or (v_mode='NHSP_WEEKLY' and exists(select 1 from public.weekly_source_billing_movements m
          where m.source_profile_kind<>'SELF_BILL_REPORT' and m.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION') and m.pay_effect='NORMAL'
      and m.id::text=v_selected->>'client_source_id' and m.nhsp_upload_row_id=r.upload_row_id))
        or (v_mode='HEALTHROSTER_WEEKLY' and exists(select 1 from public.weekly_source_state_transitions t
          join public.weekly_source_final_snapshot_lines sn on sn.id=t.new_snapshot_line_id
          where t.id::text=v_selected->>'client_source_id' and sn.upload_row_id=r.upload_row_id)));
  if v_count>1 then return null; end if;
  if v_count=1 then
    if v_current_row->>'source_group_id' is distinct from v_cycle.source_group_id::text then return null; end if;
    v_kind:='CURRENT_ROW';
    v_basis_kind:=case when v_current_row->>'final_revision_id' is null
      then 'CURRENT_PROVISIONAL_ROW' else 'CURRENT_FINAL_ROW' end;
    v_basis:=v_current_row;
  else
    -- Latest selected clocks belong to the actual family event. Other duties
    -- in the same Timesheet are not a whole-family absence veto.
    select * into v_protected from public.weekly_exceptional_pay_family_events e
      where e.family_id=v_family.id and e.durable_work_event_id=v_event.id
      order by e.event_sequence desc limit 1;
    if not found then return null; end if;
    -- Failed/rebuilding authority can exist before a logical upload/row does.
    -- No work-date or nullable unparsed identity proves that it is unrelated.
    if exists(select 1 from public.weekly_source_cycles c
      where c.source_group_id=v_cycle.source_group_id
        and (c.scope_client_id is null or c.scope_client_id=v_contract.client_id)
        and c.projection_state in ('REBUILDING','FAILED'))
      or exists(select 1 from public.weekly_source_report_scopes s
        where s.source_group_id=v_cycle.source_group_id and s.client_id=v_contract.client_id
          and s.projection_state in ('REBUILDING','FAILED'))
      or exists(select 1 from public.weekly_source_upload_attempts a
        left join public.weekly_source_cycles c on c.id=a.source_cycle_id
        left join public.weekly_source_report_scopes rs on rs.id=a.report_scope_id
        where a.agency_id=v_family.agency_id
          and (a.source_group_id is null or a.source_group_id=v_cycle.source_group_id)
          and (c.scope_client_id is null or c.scope_client_id=v_contract.client_id)
          and (rs.client_id is null or rs.client_id=v_contract.client_id)
          and a.logical_upload_id is null and a.result in ('PARTIAL','CORRUPT','FAILED','CONFLICT','REJECTED')
          and not exists(select 1 from public.weekly_source_uploads repaired
            where a.content_sha256 is not null and repaired.content_sha256=a.content_sha256
              and repaired.source_cycle_id=a.source_cycle_id
              and repaired.report_scope_id is not distinct from a.report_scope_id
              and repaired.purpose=a.purpose and repaired.declared_scope_fingerprint=a.declared_scope_fingerprint
              and repaired.uploaded_at_utc>=a.attempted_at_utc and repaired.state='CURRENT'
              and (repaired.coverage_state='COMPLETE' or (
                repaired.coverage_proof_kind='NHSP_TRUST_REPORT_SCOPE' and repaired.report_scope_id is not null
                and exists(select 1 from public.weekly_source_format_profiles p
                  where p.id=repaired.source_format_profile_id and p.final_authority_kind='NHSP_TRUST_BACKING_REPORT')
                and repaired.row_manifest_hash=private.weekly_source_upload_manifest_hash_v1(repaired.id)
              )))) then return null; end if;
    -- Census every potentially relevant non-superseded import across cutoffs.
    -- Nullable resolution identity is UNKNOWN, not evidence of another worker.
    for v_upload in select u.* from public.weekly_source_uploads u
      join public.weekly_source_cycles c on c.id=u.source_cycle_id
      left join public.weekly_source_report_scopes rs on rs.id=u.report_scope_id
      where c.source_group_id=v_cycle.source_group_id and u.state<>'SUPERSEDED'
        and (c.scope_client_id is null or c.scope_client_id=v_contract.client_id)
        and (rs.client_id is null or rs.client_id=v_contract.client_id)
        and (u.confirmed_coverage_start_local_date is null or u.confirmed_coverage_end_local_date is null
          or daterange(v_event.work_date-1,v_event.work_date+2,'[)') &&
            daterange(u.confirmed_coverage_start_local_date,u.confirmed_coverage_end_local_date+1,'[)')
          or exists(select 1 from public.weekly_source_upload_rows rr where rr.upload_id=u.id
            and (rr.work_date is null or rr.work_date between v_event.work_date-1 and v_event.work_date+1)))
      order by u.source_cycle_id,u.report_scope_id,u.id
    loop
      if v_upload.state in ('STAGING','SEALED','CORRECTION_READY','REJECTED') then return null; end if;
      if v_upload.state<>'CURRENT' or v_upload.row_manifest_hash is null then return null; end if;
      select count(*) into v_count from public.weekly_source_projection_publications p
        where p.upload_id=v_upload.id and p.source_cycle_id=v_upload.source_cycle_id
          and p.report_scope_id is not distinct from v_upload.report_scope_id and p.state='CURRENT';
      if v_count<>1 then return null; end if;
      select * into strict v_publication from public.weekly_source_projection_publications p
        where p.upload_id=v_upload.id and p.source_cycle_id=v_upload.source_cycle_id
          and p.report_scope_id is not distinct from v_upload.report_scope_id and p.state='CURRENT';
      if v_publication.published_at_utc is null or not isfinite(v_publication.published_at_utc)
         or (v_upload.report_scope_id is null and v_publication.authority_scope_kind is distinct from 'CYCLE')
         or (v_upload.report_scope_id is not null and (
           v_publication.authority_scope_kind is distinct from 'NHSP_REPORT_SCOPE'
           or not exists(select 1 from public.weekly_source_report_scopes rs
             join public.weekly_source_cycles c on c.id=rs.source_cycle_id
             where rs.id=v_upload.report_scope_id and rs.source_cycle_id=v_upload.source_cycle_id
               and rs.source_group_id=v_cycle.source_group_id and c.source_group_id=rs.source_group_id
               and rs.client_id=v_contract.client_id and rs.cutoff_at_utc=c.cutoff_at_utc)
         )) then return null; end if;
      if v_publication.authority_scope_version>2147483647
         or coalesce(v_publication.projection_generation,0)>2147483647 then
        raise exception 'WEEKLY_SOURCE_PROJECTION_GENERATION_OVERFLOW' using errcode='22003'; end if;
      v_generation:=coalesce(v_publication.projection_generation,v_publication.authority_scope_version::integer);
      if v_generation is null then return null; end if;
      -- Finalised authority deliberately uses its Final pointer, not equality
      -- with the provisional version that Finalisation legitimately advanced.
      if not exists(select 1 from public.weekly_source_final_revisions f
        join public.weekly_source_cycles c on c.id=f.source_cycle_id
        left join public.weekly_source_report_scopes rs on rs.id=f.report_scope_id
        where f.upload_id=v_upload.id and f.state='CURRENT'
          and f.source_cycle_id=v_upload.source_cycle_id
          and f.report_scope_id is not distinct from v_upload.report_scope_id
          and f.finalised_at_utc is not null and isfinite(f.finalised_at_utc)
          and ((f.authority_scope_kind='CYCLE' and f.report_scope_id is null and c.current_final_revision_id=f.id)
            or (f.authority_scope_kind='NHSP_REPORT_SCOPE' and rs.current_final_revision_id=f.id
              and rs.source_cycle_id=c.id and rs.source_group_id=c.source_group_id
              and rs.client_id=v_contract.client_id and rs.cutoff_at_utc=c.cutoff_at_utc))) then
        if not exists(select 1 from public.weekly_source_cycles c
          left join public.weekly_source_report_scopes rs on rs.id=v_upload.report_scope_id
          where c.id=v_upload.source_cycle_id and (
            (v_upload.report_scope_id is null and c.current_complete_upload_id=v_upload.id
              and c.current_projection_publication_id=v_publication.id and c.projection_state='CURRENT'
              and c.version=v_publication.authority_scope_version)
            or (rs.id is not null and rs.current_complete_upload_id=v_upload.id
              and rs.current_projection_publication_id=v_publication.id and rs.projection_state='CURRENT'
              and rs.version=v_publication.authority_scope_version))) then return null; end if;
      end if;
      v_rows_checked:='[]'::jsonb;
      for v_row in select * from public.weekly_source_upload_rows r where r.upload_id=v_upload.id
        and (r.work_date is null or r.work_date between v_event.work_date-1 and v_event.work_date+1)
        order by r.id
      loop
        select * into v_mapping from public.weekly_source_row_resolutions r
          where r.upload_row_id=v_row.id and r.generation=v_generation;
        if not found or v_mapping.mapping_state<>'RESOLVED' then return null; end if;
        v_rows_checked:=v_rows_checked||jsonb_build_array(jsonb_build_object(
          'upload_row_id',v_row.id,'source_row_hash',encode(v_row.normalised_row_hash,'hex'),
          'row_resolution_id',v_mapping.id,'generation',v_mapping.generation,
          'candidate_id',v_mapping.candidate_id,'client_id',v_mapping.client_id,
          'contract_id',v_mapping.contract_id,'work_event_id',v_mapping.work_event_id,
          'source_row_fingerprint',encode(v_mapping.source_row_fingerprint,'hex'),
          'work_event_match_fingerprint',encode(v_mapping.work_event_match_fingerprint,'hex'),
          'qualification_profile_fingerprint',encode(v_mapping.qualification_profile_fingerprint,'hex'),
          'qualifying_contract_set_hash',encode(v_mapping.qualifying_contract_set_hash,'hex'),
          'contract_and_rate_fingerprint',encode(v_mapping.contract_and_rate_fingerprint,'hex'),
          'effective_policy_fingerprint',encode(v_mapping.effective_policy_fingerprint,'hex')));
        if v_mapping.candidate_id<>v_family.candidate_id or v_mapping.client_id<>v_contract.client_id
           or v_mapping.contract_id<>v_contract.id then continue; end if;
        if v_mapping.candidate_id is null or v_mapping.client_id is null or v_mapping.contract_id is null
           or v_row.work_date is null then return null; end if;
        if v_mapping.work_event_id=v_event.id then
          -- Retained physical positive history is required for a genuine NHSP
          -- full reversal. It is not a surviving payable row: the active owner
          -- must already prove extinction, and the complete sealed physical
          -- history is qualified below. A provisional positive cannot pass.
          if not exists(select 1 from public.weekly_source_billing_movements m
            join public.weekly_source_final_revisions f on f.id=m.final_revision_id
              and f.upload_id=v_upload.id and f.source_cycle_id=v_upload.source_cycle_id
              and f.report_scope_id=v_upload.report_scope_id and f.state='CURRENT'
              and f.finalised_at_utc is not null and isfinite(f.finalised_at_utc)
            join public.weekly_source_report_scopes rs on rs.id=f.report_scope_id
              and rs.current_final_revision_id=f.id and rs.client_id=v_contract.client_id
            join public.weekly_source_client_manifests cm on coalesce(cm.invoice_window_cycle_id,cm.source_cycle_id)=cm.source_cycle_id and cm.final_revision_id=f.id
              and cm.client_id=v_contract.client_id and cm.source_group_id=v_cycle.source_group_id
              and cm.source_cycle_id=f.source_cycle_id
            join public.weekly_source_manifest_movements mm on mm.client_manifest_id=cm.id
              and mm.billing_movement_id=m.id and mm.movement_hash=m.movement_economic_hash
            where v_mode='NHSP_WEEKLY' and v_source->'source_observed'='true'::jsonb
              and v_source#>'{source_proposal,source_present}'='false'::jsonb
              and m.nhsp_upload_row_id=v_row.id and m.work_event_id=v_event.id
              and m.candidate_id=v_family.candidate_id and m.contract_id=v_contract.id
              and m.actual_client_id=v_contract.client_id and m.invoice_timesheet_id=any(v_root_ids)
              and m.source_profile_kind='NHSP_TRUST_BACKING_REPORT'
              and m.source_line_kind in ('NHSP_PHYSICAL_POSITIVE','NHSP_PHYSICAL_FULL_NEGATIVE'))
            and not exists(select 1 from public.weekly_source_final_snapshot_lines sn
              join public.weekly_source_final_revisions old_final on old_final.id=sn.final_revision_id
                and old_final.upload_id=v_upload.id and old_final.source_cycle_id=v_upload.source_cycle_id
                and old_final.report_scope_id is null and old_final.state='CURRENT'
                and old_final.finalised_at_utc is not null and isfinite(old_final.finalised_at_utc)
              join public.weekly_source_cycles old_cycle on old_cycle.id=old_final.source_cycle_id
                and old_cycle.current_final_revision_id=old_final.id and old_cycle.source_group_id=v_cycle.source_group_id
              join public.weekly_source_client_manifests cm on coalesce(cm.invoice_window_cycle_id,cm.source_cycle_id)=cm.source_cycle_id and cm.final_revision_id=old_final.id
                and cm.source_cycle_id=old_cycle.id and cm.source_group_id=old_cycle.source_group_id
                and cm.client_id=v_contract.client_id
              where v_mode='HEALTHROSTER_WEEKLY' and v_source->'source_observed'='true'::jsonb
                and v_source#>'{source_proposal,source_present}'='false'::jsonb
                and sn.upload_row_id=v_row.id and sn.row_resolution_id=v_mapping.id
                and sn.work_event_id=v_event.id and sn.candidate_id=v_family.candidate_id
                and sn.client_id=v_contract.client_id and sn.contract_id=v_contract.id
                and sn.work_date=v_event.work_date
                and exists(select 1 from public.weekly_source_state_transitions cancelled
                  join public.weekly_source_final_revisions cancel_final on cancel_final.id=cancelled.final_revision_id
                    and cancel_final.source_cycle_id=cancelled.finalisation_cycle_id
                    and cancel_final.state='CURRENT' and cancel_final.authority_scope_kind='CYCLE'
                  join public.weekly_source_cycles cancel_cycle on cancel_cycle.id=cancel_final.source_cycle_id
                    and cancel_cycle.current_final_revision_id=cancel_final.id
                    and cancel_cycle.source_group_id=v_cycle.source_group_id
                  where cancelled.id::text=v_selected->>'client_source_id' and cancelled.work_event_id=v_event.id
                    and cancelled.outcome='CANCEL' and cancelled.previous_present and not cancelled.new_present
                    and cancelled.previous_snapshot_line_id is not null and cancelled.new_snapshot_line_id is null))
            and not exists(select 1 from public.weekly_source_final_revisions cancel_final
              join public.weekly_source_format_profiles zero_profile on zero_profile.id=v_upload.source_format_profile_id
                and zero_profile.final_authority_kind in ('GENERIC_COMPLETE_SNAPSHOT','HEALTHROSTER_ACTUAL_ROWS')
                and zero_profile.omission_meaning='CANCEL_INSIDE_CONFIRMED_COVERAGE'
              join public.weekly_source_uploads actual_upload on actual_upload.id=cancel_final.upload_id
                and cancel_final.upload_id=v_upload.id and cancel_final.state='CURRENT'
                and cancel_final.authority_scope_kind='CYCLE' and cancel_final.report_scope_id is null
                and cancel_final.finalised_at_utc is not null and isfinite(cancel_final.finalised_at_utc)
              join public.weekly_source_cycles cancel_cycle on cancel_cycle.id=cancel_final.source_cycle_id
                and cancel_cycle.current_final_revision_id=cancel_final.id
                and cancel_cycle.source_group_id=v_cycle.source_group_id
              join public.weekly_source_client_manifests cm on coalesce(cm.invoice_window_cycle_id,cm.source_cycle_id)=cm.source_cycle_id and cm.final_revision_id=cancel_final.id
                and cm.source_cycle_id=cancel_cycle.id and cm.source_group_id=cancel_cycle.source_group_id
                and cm.client_id=v_contract.client_id
              where v_mode='HEALTHROSTER_WEEKLY'
                and v_source#>'{source_proposal,source_present}'='false'::jsonb
                and v_row.row_finalisation_state='SOURCE_ABSENT_ZERO'
                and v_upload.coverage_state='COMPLETE' and v_upload.coverage_timezone='Europe/London'
                and v_upload.coverage_confirmed_at_utc is not null and isfinite(v_upload.coverage_confirmed_at_utc)
                and v_upload.coverage_confirmed_by_user_id is not null
                and v_upload.confirmed_coverage_start_local_date=cancel_final.coverage_start_local_date
                and v_upload.confirmed_coverage_end_local_date=cancel_final.coverage_end_local_date
                and v_event.work_date between cancel_final.coverage_start_local_date and cancel_final.coverage_end_local_date)
          then return null; end if;
          continue;
        end if;
        select * into v_choice from private.weekly_source_office_row_choices c
          where c.upload_row_id=v_row.id and c.candidate_id=v_family.candidate_id
            and c.client_id=v_contract.client_id and c.contract_id=v_contract.id order by c.id desc limit 1;
        if found and v_choice.separate_shift and v_choice.work_event_id is null then continue; end if;
        v_matches:=private.weekly_source_protected_match_candidates_v1(v_row.id,v_family.candidate_id,v_contract.client_id);
        if exists(select 1 from jsonb_array_elements(v_matches) m
          where m->>'work_event_id'=v_event.id::text and m->>'contract_id'=v_contract.id::text
            and (m->'schedule_compatible'='true'::jsonb or m->'retained_source_identity'='true'::jsonb)) then return null; end if;
        if v_row.start_at_local is null or v_row.end_at_local is null
           or v_protected.start_at_local is null or v_protected.end_at_local is null
           or (v_row.start_at_local<v_protected.end_at_local and v_protected.start_at_local<v_row.end_at_local)
        then return null; end if;
      end loop;
      if exists(select 1 from public.weekly_source_format_profiles p
        where p.id=v_upload.source_format_profile_id and p.final_authority_kind='NHSP_TRUST_BACKING_REPORT') then
        -- NHSP completeness is the report's actual row/count/scope seal. It
        -- deliberately has no roster date-coverage attestation or inference.
        if v_upload.coverage_proof_kind is distinct from 'NHSP_TRUST_REPORT_SCOPE'
           or v_upload.report_scope_id is null
           or v_upload.row_manifest_hash is distinct from private.weekly_source_upload_manifest_hash_v1(v_upload.id)
        then return null; end if;
      elsif v_upload.coverage_state is distinct from 'COMPLETE' then return null; end if;
      v_census:=v_census||jsonb_build_array(jsonb_build_object(
        'upload_id',v_upload.id,'source_cycle_id',v_upload.source_cycle_id,'report_scope_id',v_upload.report_scope_id,
        'source_cycle_cutoff_at_utc',(select c.cutoff_at_utc from public.weekly_source_cycles c where c.id=v_upload.source_cycle_id),
        'publication_at_utc',v_publication.published_at_utc,'authority_scope_kind',v_publication.authority_scope_kind,
        'row_manifest_hash',encode(v_upload.row_manifest_hash,'hex'),
        'declared_scope_fingerprint',encode(v_upload.declared_scope_fingerprint,'hex'),
        'publication_id',v_publication.id,'authority_scope_version',v_publication.authority_scope_version,
        'projection_generation',v_generation,'comparison_manifest_hash',encode(v_publication.comparison_manifest_hash,'hex'),
        'issue_set_hash',encode(v_publication.issue_set_hash,'hex'),'rows_checked',v_rows_checked,
        'current_final_revisions',(select coalesce(jsonb_agg(jsonb_build_object('id',f.id,
          'manifest_hash',encode(f.manifest_hash,'hex'),'policy_fingerprint',encode(f.policy_fingerprint,'hex'))
          order by f.id),'[]'::jsonb) from public.weekly_source_final_revisions f where f.upload_id=v_upload.id and f.state='CURRENT')));
    end loop;

    if v_source#>'{source_proposal,source_present}' is distinct from 'false'::jsonb
       or v_source#>>'{source_proposal,source_minutes}' is distinct from '0' then return null; end if;
    if v_mode='NHSP_WEEKLY' and v_source->'source_observed'='true'::jsonb then
      -- The active-position owner has already proved this event extinguished.
      -- Keep the REAL physical positive/negative history, not its synthetic
      -- selected-event absence proposal encoding, as the certificate basis.
      select coalesce(jsonb_agg(jsonb_build_object('movement_id',m.id,'final_revision_id',f.id,
          'movement_hash',encode(m.movement_economic_hash,'hex'),'source_row_id',u.id,
          'source_row_hash',encode(u.normalised_row_hash,'hex'),'row_resolution_id',r.id,
          'backing_report_id',br.id,'row_manifest_hash',encode(br.row_manifest_hash,'hex'),
          'final_manifest_hash',encode(f.manifest_hash,'hex'),'client_manifest_id',cm.id,
          'client_manifest_hash',encode(cm.manifest_hash,'hex'),'manifest_movement_hash',encode(mm.movement_hash,'hex'))
          order by f.finalised_at_utc,m.id),'[]'::jsonb),
        bool_or(m.source_line_kind='NHSP_PHYSICAL_POSITIVE'),bool_or(m.source_line_kind='NHSP_PHYSICAL_FULL_NEGATIVE')
        into v_history,v_has_positive,v_has_negative
        from public.weekly_source_billing_movements m
        join public.weekly_source_final_revisions f on f.id=m.final_revision_id and f.state='CURRENT'
        join public.weekly_source_cycles c on c.id=f.source_cycle_id and c.source_group_id=v_cycle.source_group_id
        join public.weekly_source_report_scopes rs on rs.id=f.report_scope_id and rs.current_final_revision_id=f.id
          and rs.client_id=v_contract.client_id and rs.cutoff_at_utc=c.cutoff_at_utc
        join public.weekly_source_upload_rows u on u.id=m.nhsp_upload_row_id and u.upload_id=f.upload_id and u.work_date=v_event.work_date
        join public.weekly_source_row_resolutions r on r.id=(m.source_facts_json->>'row_resolution_id')::uuid
          and r.upload_row_id=u.id and r.mapping_state='RESOLVED' and r.work_event_id=v_event.id
          and r.candidate_id=v_family.candidate_id and r.client_id=v_contract.client_id and r.contract_id=v_contract.id
        join public.weekly_source_uploads up on up.id=f.upload_id and up.report_scope_id=rs.id and up.source_cycle_id=c.id
        join public.weekly_source_nhsp_backing_reports br on br.final_revision_id=f.id and br.upload_id=up.id
          and br.client_id=v_contract.client_id and br.report_scope_id=rs.id and br.cutoff_at_utc=rs.cutoff_at_utc
          and br.row_manifest_hash=up.row_manifest_hash
        join public.weekly_source_client_manifests cm on coalesce(cm.invoice_window_cycle_id,cm.source_cycle_id)=cm.source_cycle_id and cm.final_revision_id=f.id and cm.client_id=v_contract.client_id
          and cm.source_cycle_id=c.id and cm.source_group_id=c.source_group_id
        join public.weekly_source_manifest_movements mm on mm.client_manifest_id=cm.id
          and mm.billing_movement_id=m.id and mm.movement_hash=m.movement_economic_hash
        where m.source_profile_kind<>'SELF_BILL_REPORT' and m.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION') and m.pay_effect='NORMAL'
      and m.invoice_timesheet_id=any(v_root_ids) and m.work_event_id=v_event.id
          and m.candidate_id=v_family.candidate_id and m.contract_id=v_contract.id and m.actual_client_id=v_contract.client_id
          and m.source_profile_kind='NHSP_TRUST_BACKING_REPORT'
          and m.source_line_kind in ('NHSP_PHYSICAL_POSITIVE','NHSP_PHYSICAL_FULL_NEGATIVE');
      if v_has_positive is distinct from true or v_has_negative is distinct from true then return null; end if;
      if exists(select 1 from public.weekly_source_billing_movements m
        where m.source_profile_kind<>'SELF_BILL_REPORT' and m.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION') and m.pay_effect='NORMAL'
      and m.invoice_timesheet_id=any(v_root_ids) and m.work_event_id=v_event.id
          and m.source_profile_kind='NHSP_TRUST_BACKING_REPORT'
          and exists(select 1 from public.weekly_source_final_revisions f where f.id=m.final_revision_id and f.state='CURRENT')
          and not exists(select 1 from jsonb_array_elements(v_history) h where h->>'movement_id'=m.id::text)) then return null; end if;
      v_kind:='CERTIFIED_ABSENCE'; v_basis_kind:='NHSP_FULL_REVERSAL'; v_basis:=jsonb_build_object('physical_history',v_history);
    elsif v_mode='HEALTHROSTER_WEEKLY' then
      if v_source->'source_observed'='true'::jsonb then
        select * into v_transition from public.weekly_source_state_transitions t where t.id=(v_selected->>'client_source_id')::uuid
          and t.work_event_id=v_event.id and t.outcome='CANCEL' and t.previous_present and not t.new_present
          and t.previous_snapshot_line_id is not null and t.new_snapshot_line_id is null;
        if not found then return null; end if;
        select * into strict v_snapshot from public.weekly_source_final_snapshot_lines where id=v_transition.previous_snapshot_line_id;
        if v_snapshot.work_event_id is distinct from v_event.id or v_snapshot.candidate_id is distinct from v_family.candidate_id
           or v_snapshot.client_id is distinct from v_contract.client_id or v_snapshot.contract_id is distinct from v_contract.id
           or v_snapshot.work_date is distinct from v_event.work_date then return null; end if;
        if not exists(select 1 from public.weekly_source_upload_rows raw
          join public.weekly_source_row_resolutions resolution on resolution.id=v_snapshot.row_resolution_id
            and resolution.upload_row_id=raw.id and resolution.mapping_state='RESOLVED'
          join public.weekly_source_final_revisions previous_final on previous_final.id=v_snapshot.final_revision_id
            and previous_final.upload_id=raw.upload_id
          join public.weekly_source_cycles previous_cycle on previous_cycle.id=previous_final.source_cycle_id
            and previous_cycle.source_group_id=v_cycle.source_group_id
          where raw.id=v_snapshot.upload_row_id and raw.work_date=v_event.work_date
            and resolution.work_event_id=v_event.id and resolution.candidate_id=v_family.candidate_id
            and resolution.client_id=v_contract.client_id and resolution.contract_id=v_contract.id)
        then return null; end if;
        select * into v_final from public.weekly_source_final_revisions where id=v_transition.final_revision_id;
        if not found or v_transition.finalisation_cycle_id is distinct from v_final.source_cycle_id then return null; end if;
        v_basis_kind:='ROSTER_CANCEL';
      else
        select count(*),jsonb_agg(to_jsonb(f))->0 into v_count,v_basis
          from public.weekly_source_final_revisions f join public.weekly_source_cycles c on c.id=f.source_cycle_id
          join public.weekly_source_client_manifests m on coalesce(m.invoice_window_cycle_id,m.source_cycle_id)=m.source_cycle_id and m.final_revision_id=f.id and m.client_id=v_contract.client_id
          where c.source_group_id=v_cycle.source_group_id and f.state='CURRENT' and c.current_final_revision_id=f.id
            and f.authority_scope_kind='CYCLE' and v_event.work_date between f.coverage_start_local_date and f.coverage_end_local_date;
        if v_count>1 then return null; end if;
        if v_count=1 then
          select * into strict v_final from public.weekly_source_final_revisions where id=(v_basis->>'id')::uuid;
          v_basis_kind:='ROSTER_COVERAGE_OMISSION';
        end if;
      end if;
      if v_final.id is not null then
      select * into strict v_upload from public.weekly_source_uploads where id=v_final.upload_id;
      if v_final.state<>'CURRENT' or v_final.authority_scope_kind<>'CYCLE' or v_final.finalised_at_utc is null
         or not isfinite(v_final.finalised_at_utc) or v_final.coverage_timezone is distinct from 'Europe/London'
         or v_upload.coverage_timezone is distinct from 'Europe/London' or v_upload.coverage_state is distinct from 'COMPLETE'
         or v_upload.coverage_confirmed_at_utc is null or v_upload.coverage_confirmed_by_user_id is null
         or v_upload.confirmed_coverage_start_local_date is distinct from v_final.coverage_start_local_date
         or v_upload.confirmed_coverage_end_local_date is distinct from v_final.coverage_end_local_date
         or v_event.work_date not between v_final.coverage_start_local_date and v_final.coverage_end_local_date
         or not exists(select 1 from public.weekly_source_cycles c where c.id=v_final.source_cycle_id
           and c.source_group_id=v_cycle.source_group_id and c.current_final_revision_id=v_final.id)
         or not exists(select 1 from public.weekly_source_format_profiles p where p.id=v_upload.source_format_profile_id
           and p.final_authority_kind in ('GENERIC_COMPLETE_SNAPSHOT','HEALTHROSTER_ACTUAL_ROWS')
           and p.omission_meaning='CANCEL_INSIDE_CONFIRMED_COVERAGE')
         or not exists(select 1 from public.weekly_source_client_manifests m where coalesce(m.invoice_window_cycle_id,m.source_cycle_id)=m.source_cycle_id and m.final_revision_id=v_final.id
           and m.source_cycle_id=v_final.source_cycle_id and m.source_group_id=v_cycle.source_group_id and m.client_id=v_contract.client_id)
      then return null; end if;
      v_kind:='CERTIFIED_ABSENCE'; v_basis:=jsonb_build_object('final_revision_id',v_final.id,
        'manifest_hash',encode(v_final.manifest_hash,'hex'),'policy_fingerprint',encode(v_final.policy_fingerprint,'hex'),
        'upload_id',v_upload.id,'row_manifest_hash',encode(v_upload.row_manifest_hash,'hex'),
        'source_cycle_id',v_final.source_cycle_id,
        'source_cycle_cutoff_at_utc',(select c.cutoff_at_utc from public.weekly_source_cycles c where c.id=v_final.source_cycle_id),
        'declared_scope_fingerprint',encode(v_upload.declared_scope_fingerprint,'hex'),
        'client_manifests',(select jsonb_agg(jsonb_build_object('id',m.id,'manifest_hash',encode(m.manifest_hash,'hex'))
          order by m.id) from public.weekly_source_client_manifests m where coalesce(m.invoice_window_cycle_id,m.source_cycle_id)=m.source_cycle_id and m.final_revision_id=v_final.id
            and m.source_cycle_id=v_final.source_cycle_id and m.source_group_id=v_cycle.source_group_id and m.client_id=v_contract.client_id),
        'coverage_start',v_final.coverage_start_local_date,'coverage_end',v_final.coverage_end_local_date,
        'transition_id',v_transition.id,'transition_fingerprint',encode(v_transition.transition_fingerprint,'hex'),
        'previous_snapshot_id',v_snapshot.id,'previous_snapshot_hash',encode(v_snapshot.snapshot_line_hash,'hex'),
        'previous_upload_row_id',v_snapshot.upload_row_id,'previous_row_resolution_id',v_snapshot.row_resolution_id);
      end if;
    end if;
    if v_kind is null then
      if v_event.identity_kind<>'OFFICE_PROTECTED_SHIFT'
         or v_source->'source_observed' is distinct from 'false'::jsonb
         or exists(select 1 from public.weekly_source_row_resolutions r where r.work_event_id=v_event.id)
         or exists(select 1 from public.weekly_work_event_source_links l where l.work_event_id=v_event.id)
         or exists(select 1 from public.weekly_source_final_snapshot_lines s where s.work_event_id=v_event.id)
         or exists(select 1 from public.weekly_source_billing_movements m where m.source_profile_kind<>'SELF_BILL_REPORT' and m.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION') and m.pay_effect='NORMAL'
      and m.work_event_id=v_event.id)
      then return null; end if;
      v_kind:='CERTIFIED_ABSENCE'; v_basis_kind:='NO_IMPORT_YET';
      v_basis:=jsonb_build_object('work_event_id',v_event.id,'durable_identity_hash',encode(v_event.durable_identity_hash,'hex'),
        'first_source_group_id',v_event.first_source_group_id,'family_event_id',v_protected.id,
        'family_event_sequence',v_protected.event_sequence,'action_cycle_id',v_cycle.id,
        'action_cycle_version',v_cycle.version,'action_cycle_projection_state',v_cycle.projection_state);
    end if;
    v_basis:=v_basis||jsonb_build_object('checked_current_imports',v_census);
  end if;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_SELECTED_SOURCE_WITNESS_V1',
    'scope',v_scope||jsonb_build_object('work_event_id',v_event.id,'work_date',v_event.work_date,
      'source_group_id',v_cycle.source_group_id,'action_cycle_id',v_cycle.id),
    'kind',v_kind,'basis_kind',v_basis_kind,'source_proposal',v_source->'source_proposal','basis',v_basis);
  return v_result||jsonb_build_object('basis_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_SELECTED_SOURCE_WITNESS_V1',v_result),'hex'));
end;
$function$;

create or replace function public.weekly_source_finalisation_pay_open_atomic_v1(
  p_request jsonb
) returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_expected_keys text[]:=array['actor_user_id','final_revision_id','schema_version'];
  v_actual_keys text[];
  v_actor uuid;
  v_revision_id uuid;
  v_revision public.weekly_source_final_revisions%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_run public.weekly_source_finalisation_pay_runs%rowtype;
  v_contexts jsonb;
  v_task_manifest_hash bytea;
  v_run_hash bytea;
  v_task_count integer;
  v_context record;
begin
  if coalesce(
       pg_catalog.current_setting('request.jwt.claim.role',true),
       nullif(pg_catalog.current_setting('request.jwt.claims',true),'')::jsonb->>'role',''
     )<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
  end if;
  if pg_catalog.jsonb_typeof(p_request)<>'object' then
    raise exception 'WEEKLY_SOURCE_FINALISATION_PAY_OPEN_INVALID' using errcode='22023';
  end if;
  select pg_catalog.array_agg(key order by key) into v_actual_keys
  from pg_catalog.jsonb_object_keys(p_request) key;
  select pg_catalog.array_agg(key order by key) into v_expected_keys
  from pg_catalog.unnest(v_expected_keys) key;
  if v_actual_keys is distinct from v_expected_keys
     or p_request->>'schema_version'<>'WEEKLY_SOURCE_FINALISATION_PAY_OPEN_V1' then
    raise exception 'WEEKLY_SOURCE_FINALISATION_PAY_OPEN_CONTRACT_INVALID'
      using errcode='22023';
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_revision_id:=(p_request->>'final_revision_id')::uuid;
  exception when invalid_text_representation then
    raise exception 'WEEKLY_SOURCE_FINALISATION_PAY_OPEN_INVALID' using errcode='22023';
  end;
  perform 1 from public.tms_users actor
  where actor.id=v_actor and coalesce(actor.is_active,false);
  if v_actor is null or v_revision_id is null or not found then
    raise exception 'WEEKLY_SOURCE_FINALISATION_PAY_ACTOR_INVALID' using errcode='42501';
  end if;

  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended(
    'WEEKLY_SOURCE_FINALISATION_PAY_RUN|'||v_revision_id::text,0
  ));
  select * into v_revision
  from public.weekly_source_final_revisions revision
  where revision.id=v_revision_id for share;
  if not found or v_revision.state<>'CURRENT'
     or v_revision.reason<>'INITIAL_FINALISATION' then
    raise exception 'WEEKLY_SOURCE_FINALISATION_PAY_REVISION_INVALID'
      using errcode='55000';
  end if;
  select * into strict v_cycle
  from public.weekly_source_cycles cycle where cycle.id=v_revision.source_cycle_id;
  select * into strict v_group
  from public.weekly_source_groups source_group where source_group.id=v_cycle.source_group_id;
  for v_context in
    select distinct movement.actual_client_id as client_id
    from public.weekly_source_billing_movements movement
    where movement.source_profile_kind<>'SELF_BILL_REPORT' and movement.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION') and movement.pay_effect='NORMAL'
      and movement.final_revision_id=v_revision.id
    order by movement.actual_client_id
  loop
    perform private.weekly_source_office_authority_v1(
      v_actor,'FINALISE_WEEK',v_group.id,v_context.client_id,
      v_cycle.finalisation_week_ending
    );
  end loop;

  select * into v_run
  from public.weekly_source_finalisation_pay_runs run_row
  where run_row.final_revision_id=v_revision.id;
  if found then
    if v_run.requested_by_user_id is distinct from v_actor
       or v_run.final_revision_manifest_hash is distinct from v_revision.manifest_hash then
      raise exception 'WEEKLY_SOURCE_FINALISATION_PAY_RUN_IDENTITY_CHANGED'
        using errcode='40001';
    end if;
    v_run:=private.weekly_source_finalisation_pay_run_refresh_v1(v_run.id);
    return private.weekly_source_finalisation_pay_run_json_v1(v_run)
      ||pg_catalog.jsonb_build_object('idempotent_replay',true);
  end if;

  select coalesce(pg_catalog.jsonb_agg(context_value order by root_timesheet_id),'[]'::jsonb)
    into v_contexts
  from (
    select roots.root_timesheet_id,
           private.weekly_source_finalisation_pay_context_v1(
             v_revision.id,roots.root_timesheet_id
           ) as context_value
    from (
      select distinct movement.invoice_timesheet_id as root_timesheet_id
      from public.weekly_source_billing_movements movement
      where movement.source_profile_kind<>'SELF_BILL_REPORT' and movement.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION') and movement.pay_effect='NORMAL'
      and movement.final_revision_id=v_revision.id
        and movement.invoice_timesheet_id is not null
    ) roots
  ) prepared;
  v_task_count:=pg_catalog.jsonb_array_length(v_contexts);
  v_task_manifest_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_FINALISATION_PAY_TASK_MANIFEST_V1',v_contexts
  );
  v_run_hash:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_FINALISATION_PAY_RUN_V1',
    pg_catalog.jsonb_build_object(
      'final_revision_id',v_revision.id,
      'source_cycle_id',v_cycle.id,
      'requested_by_user_id',v_actor,
      'final_revision_manifest_hash',pg_catalog.encode(v_revision.manifest_hash,'hex'),
      'task_manifest_hash',pg_catalog.encode(v_task_manifest_hash,'hex'),
      'task_count',v_task_count
    )
  );
  insert into public.weekly_source_finalisation_pay_runs(
    final_revision_id,source_cycle_id,requested_by_user_id,orchestration_key,
    final_revision_manifest_hash,task_manifest_hash,task_count,
    terminal_task_count,action_required_task_count,state,run_hash,completed_at_utc
  ) values (
    v_revision.id,v_cycle.id,v_actor,'weekly-source-finalisation-pay:'||v_revision.id::text,
    v_revision.manifest_hash,v_task_manifest_hash,v_task_count,0,0,
    case when v_task_count=0 then 'COMPLETE' else 'READY' end,v_run_hash,
    case when v_task_count=0 then pg_catalog.transaction_timestamp() else null end
  ) returning * into v_run;
  -- S9 / WB-016: every task carries the Timesheet FAMILY identity and the
  -- version it was opened against, so a retry, recovery or delayed release
  -- resolves through the family instead of trusting a stored physical id.  The
  -- run-level uniqueness is now on the family, not on root_timesheet_id.
  insert into public.weekly_source_finalisation_pay_tasks(
    run_id,task_ordinal,client_manifest_id,root_timesheet_id,
    root_family_booking_id,root_timesheet_version,
    projection_idempotency_key,prepared_context_json,prepared_context_hash,state
  )
  select v_run.id,entry.ordinality::integer,
         (entry.value->>'client_manifest_id')::uuid,
         (entry.value->>'root_timesheet_id')::uuid,
         root_timesheet.booking_id,
         root_timesheet.version,
         'weekly-source-finalisation-pay:'||v_revision.id::text||':'||
           (entry.value->>'root_timesheet_id'),
         entry.value-(array['prepared_context_hash']::text[]),
         pg_catalog.decode(entry.value->>'prepared_context_hash','hex'),'READY'
  from pg_catalog.jsonb_array_elements(v_contexts) with ordinality entry(value,ordinality)
  join public.timesheets root_timesheet
    on root_timesheet.timesheet_id=(entry.value->>'root_timesheet_id')::uuid;
  -- The join above would silently drop a context whose root Timesheet is not
  -- present, so the manifest count is asserted rather than assumed.
  if (select pg_catalog.count(*)::integer
      from public.weekly_source_finalisation_pay_tasks task
      where task.run_id=v_run.id)<>v_task_count then
    raise exception 'WEEKLY_SOURCE_FINALISATION_PAY_TASK_MANIFEST_CHANGED'
      using errcode='55000';
  end if;
  return private.weekly_source_finalisation_pay_run_json_v1(v_run)
    ||pg_catalog.jsonb_build_object('idempotent_replay',false);
exception
  when no_data_found or too_many_rows then
    raise exception 'WEEKLY_SOURCE_FINALISATION_PAY_OPEN_SCOPE_INVALID'
      using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_invoice_allocation_assert_v1(
  p_invoice_id uuid
) returns jsonb
language plpgsql stable security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_invoice public.invoices%rowtype;
  v_line_count integer;
  v_binding_count integer;
  v_has_source_header boolean;
begin
  select * into v_invoice from public.invoices where id=p_invoice_id;
  if not found then
    raise exception 'WEEKLY_SOURCE_INVOICE_NOT_FOUND' using errcode='22023';
  end if;
  select pg_catalog.count(*)::integer into v_binding_count
  from public.weekly_source_invoice_line_bindings binding
  where binding.invoice_id=p_invoice_id and binding.state='CURRENT';
  v_has_source_header:=coalesce(
    v_invoice.header_snapshot_json#>>'{meta,source}'='WEEKLY_FINAL_SOURCE'
    and v_invoice.header_snapshot_json#>>'{meta,self_bill}'='true',false
  );
  if v_binding_count=0 then
    if not v_has_source_header then
      return pg_catalog.jsonb_build_object(
        'ok',true,'is_source_invoice',false,'invoice_id',p_invoice_id
      );
    end if;
    select pg_catalog.count(*)::integer into v_line_count
    from public.invoice_lines invoice_line where invoice_line.invoice_id=p_invoice_id;
    if exists(select 1 from public.invoice_lines invoice_line where invoice_line.invoice_id=p_invoice_id
      and private.weekly_source_invoice_adjustment_line_valid_v1(invoice_line.id,p_invoice_id) is distinct from true) then
      raise exception 'WEEKLY_SOURCE_INVOICE_EXTRA_LINE' using errcode='55000';
    end if;
    if v_invoice.subtotal_ex_vat is distinct from (select round(coalesce(sum(total_charge_ex_vat),0),2) from public.invoice_lines where invoice_id=p_invoice_id)
      or v_invoice.vat_amount is distinct from (select round(coalesce(sum(vat_amount),0),2) from public.invoice_lines where invoice_id=p_invoice_id)
      or v_invoice.total_inc_vat is distinct from (select round(coalesce(sum(total_inc_vat),0),2) from public.invoice_lines where invoice_id=p_invoice_id) then
      raise exception 'WEEKLY_SOURCE_INVOICE_TOTAL_MISMATCH' using errcode='55000';
    end if;
    return pg_catalog.jsonb_build_object(
      'ok',true,'is_source_invoice',true,'invoice_id',p_invoice_id,
      'line_count',v_line_count,'binding_count',0,'empty',v_line_count=0
    );
  end if;
  if not v_has_source_header then
    raise exception 'WEEKLY_SOURCE_INVOICE_HEADER_INVALID' using errcode='55000';
  end if;
  select pg_catalog.count(*)::integer into v_line_count
  from public.invoice_lines invoice_line where invoice_line.invoice_id=p_invoice_id;

  if exists(
    select 1 from public.invoice_lines invoice_line
    where invoice_line.invoice_id=p_invoice_id
      and not exists(
        select 1 from public.weekly_source_invoice_line_bindings binding
        where binding.invoice_line_id=invoice_line.id
          and binding.invoice_id=p_invoice_id and binding.state='CURRENT'
      )
      and private.weekly_source_invoice_adjustment_line_valid_v1(invoice_line.id,p_invoice_id) is distinct from true
  ) then
    raise exception 'WEEKLY_SOURCE_INVOICE_EXTRA_LINE' using errcode='55000';
  end if;

  perform private.weekly_source_invoice_receipt_projection_assert_v1(p_invoice_id);
  if exists(
    select 1
    from public.weekly_source_invoice_line_bindings binding
    join public.weekly_source_billing_movements movement
      on movement.id=binding.billing_movement_id
    join public.weekly_source_invoice_presentation_lines presentation
      on presentation.id=binding.presentation_line_id
    join public.invoice_lines invoice_line on invoice_line.id=binding.invoice_line_id
    join public.weekly_source_invoice_placements placement
      on placement.billing_movement_id=movement.id and placement.is_current
    join public.weekly_source_manifest_movements manifest_movement
      on manifest_movement.billing_movement_id=movement.id
    join public.weekly_source_client_manifests manifest
      on manifest.id=manifest_movement.client_manifest_id
    where binding.invoice_id=p_invoice_id and binding.state='CURRENT'
      and (
        invoice_line.invoice_id is distinct from p_invoice_id
        or placement.invoice_id is distinct from p_invoice_id
        or placement.invoice_line_id is distinct from invoice_line.id
        or placement.placement_state<>'PLACED'
        or placement.original_automatic_cycle_id is distinct from coalesce(manifest.invoice_window_cycle_id,manifest.source_cycle_id)
        or private.weekly_source_invoice_movement_window_id_v1(movement.id) is distinct from coalesce(manifest.invoice_window_cycle_id,manifest.source_cycle_id)
        or binding.client_id is distinct from v_invoice.client_id
        or movement.actual_client_id is distinct from v_invoice.client_id
        or presentation.client_id is distinct from v_invoice.client_id
        or manifest.client_id is distinct from v_invoice.client_id
        or manifest_movement.movement_hash is distinct from movement.movement_economic_hash
        or binding.manifest_hash is distinct from manifest.manifest_hash
        or presentation.client_manifest_id is distinct from manifest.id
        or presentation.final_revision_id is distinct from movement.final_revision_id
        or presentation.original_finalisation_cycle_id is distinct from movement.finalisation_cycle_id
        or invoice_line.timesheet_id is distinct from movement.invoice_timesheet_id
        or invoice_line.total_pay_ex_vat is distinct from presentation.total_pay_ex_vat
        or invoice_line.total_charge_ex_vat is distinct from presentation.total_charge_ex_vat
        or invoice_line.vat_rate_pct is distinct from presentation.vat_rate_pct
        or invoice_line.vat_amount is distinct from presentation.vat_amount
        or invoice_line.total_inc_vat is distinct from presentation.total_inc_vat
        or (presentation.invoice_hold_release_id is not null and (presentation.source_hash is distinct from
          private.weekly_source_invoice_presentation_source_hash_v1((select array_agg(b.billing_movement_id order by b.billing_movement_id)
            from public.weekly_source_invoice_line_bindings b where b.presentation_line_id=presentation.id and b.state='CURRENT'),presentation.invoice_hold_release_id)
          or invoice_line.meta_json->'invoice_hold_release_authority' is distinct from private.weekly_source_invoice_presentation_release_authority_v1(
            (select array_agg(b.billing_movement_id order by b.billing_movement_id) from public.weekly_source_invoice_line_bindings b
              where b.presentation_line_id=presentation.id and b.state='CURRENT'),presentation.invoice_hold_release_id)))
      )
  ) then
    raise exception 'WEEKLY_SOURCE_INVOICE_ALLOCATION_MISMATCH' using errcode='55000';
  end if;

  if exists(
    select 1
    from (
      select binding.invoice_line_id,
             pg_catalog.count(*)::integer as member_count,
             pg_catalog.count(distinct movement.correction_unit_id) as correction_count,
             pg_catalog.count(distinct movement.work_event_id) as event_count,
             pg_catalog.count(distinct movement.final_revision_id) as revision_count,
             pg_catalog.count(distinct movement.finalisation_cycle_id) as cycle_count,
             pg_catalog.count(distinct movement.actual_client_id) as client_count,
             pg_catalog.count(*) filter(where movement.source_profile_kind='NHSP_TRUST_BACKING_REPORT') as nhsp_count,
             pg_catalog.array_agg(movement.movement_role order by movement.movement_role) as roles,
             pg_catalog.min(presentation.correction_role) as correction_role
      from public.weekly_source_invoice_line_bindings binding
      join public.weekly_source_billing_movements movement
        on movement.id=binding.billing_movement_id
      join public.weekly_source_invoice_presentation_lines presentation
        on presentation.id=binding.presentation_line_id
      where binding.invoice_id=p_invoice_id and binding.state='CURRENT'
      group by binding.invoice_line_id
    ) grouped
    where grouped.member_count not in (1,2)
       or (grouped.member_count=2 and (
         grouped.correction_count<>1 or grouped.event_count<>1
         or grouped.revision_count<>1 or grouped.cycle_count<>1
         or grouped.client_count<>1 or grouped.nhsp_count<>0
         or grouped.correction_role is distinct from 'NET_DIFFERENCE'
         or grouped.roles not in (
           array['REPLACEMENT','REVERSAL']::text[],
           array['EXPENSE_REPLACEMENT','EXPENSE_REVERSAL']::text[]
         )
       ))
  ) then
    raise exception 'WEEKLY_SOURCE_INVOICE_NET_CARDINALITY_INVALID' using errcode='55000';
  end if;

  if v_invoice.subtotal_ex_vat is distinct from (
       select pg_catalog.round(coalesce(pg_catalog.sum(line.total_charge_ex_vat),0),2)
       from public.invoice_lines line where line.invoice_id=p_invoice_id
     )
     or v_invoice.vat_amount is distinct from (
       select pg_catalog.round(coalesce(pg_catalog.sum(line.vat_amount),0),2)
       from public.invoice_lines line where line.invoice_id=p_invoice_id
     )
     or v_invoice.total_inc_vat is distinct from (
       select pg_catalog.round(coalesce(pg_catalog.sum(line.total_inc_vat),0),2)
       from public.invoice_lines line where line.invoice_id=p_invoice_id
     ) then
    raise exception 'WEEKLY_SOURCE_INVOICE_TOTAL_MISMATCH' using errcode='55000';
  end if;

  perform private.weekly_source_paid_match_invoice_origin_assert_v1(movement.id)
    from public.weekly_source_invoice_line_bindings binding
    join public.weekly_source_billing_movements movement on movement.id=binding.billing_movement_id
    where binding.invoice_id=p_invoice_id and binding.state='CURRENT'
      and (movement.pay_effect='NONE' or movement.invoice_only_snapshot_line_id is not null);
  return pg_catalog.jsonb_build_object(
    'ok',true,'is_source_invoice',true,'invoice_id',p_invoice_id,
    'line_count',v_line_count,'binding_count',v_binding_count
  );
end;
$function$;

create or replace function private.weekly_source_paid_overlap_current_snapshot_v1(
  p_work_event_id uuid,p_movement_id uuid,p_candidate_id uuid,p_client_id uuid,p_contract_id uuid,p_source_group_id uuid,p_native_root_ids uuid[]
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_count integer;v_snapshot uuid;v_rows jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_work_event_id is null or p_movement_id is null or p_candidate_id is null or p_client_id is null
    or p_contract_id is null or p_source_group_id is null or cardinality(p_native_root_ids) is null then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_SNAPSHOT_SCOPE_INVALID' using errcode='22023';end if;
  with actual as materialized (
    select s.id,scope.id as scope_id,scope.root_timesheet_id,selected.selected_transition_id,
      selected.selected_order_key::text,origin.source_hash,origin.final_revision_id,
      transition.new_present as source_export_present,transition.exclude_cancel
    from private.bpay_next_source_current_events selected
    join private.bpay_next_source_current_scopes scope on scope.id=selected.scope_id
    join private.bpay_next_source_current_origins origin on origin.scope_id=scope.id and origin.work_event_id=selected.work_event_id
      and origin.origin_kind='TRANSITION' and origin.origin_id=selected.selected_transition_id
      and origin.transition_id=selected.selected_transition_id and origin.active
      and origin.selected_movement_id=selected.selected_movement_id and origin.order_key=selected.selected_order_key
    join public.weekly_source_state_transitions transition on transition.id=selected.selected_transition_id
      and transition.work_event_id=selected.work_event_id and transition.final_revision_id=origin.final_revision_id
      and transition.transition_fingerprint=origin.source_hash
    join public.weekly_source_final_revisions revision on revision.id=transition.final_revision_id and revision.state='CURRENT'
      and revision.authority_scope_kind='CYCLE' and revision.report_scope_id is null
    join public.weekly_source_cycles cycle on cycle.id=revision.source_cycle_id and cycle.source_group_id=p_source_group_id
      and cycle.current_final_revision_id=revision.id
    join public.weekly_source_final_snapshot_lines s on s.id=coalesce(transition.new_snapshot_line_id,
      case when transition.outcome='CANCEL' and transition.exclude_cancel then transition.previous_snapshot_line_id end)
      and s.work_event_id=selected.work_event_id and s.pay_effect='NORMAL'
    join private.bpay_next_source_current_snapshots mapping on mapping.snapshot_line_id=s.id and mapping.scope_id=scope.id
      and mapping.work_event_id=selected.work_event_id and mapping.movement_id=p_movement_id
    where selected.work_event_id=p_work_event_id and selected.source_kind='HR' and selected.source_present and not selected.ambiguous
      and selected.selected_movement_id=p_movement_id and scope.source_group_id=p_source_group_id
      and scope.candidate_id=p_candidate_id and scope.client_id=p_client_id and scope.contract_id=p_contract_id
      and scope.root_timesheet_id=any(p_native_root_ids)
      and (s.candidate_id,s.client_id,s.contract_id)=(p_candidate_id,p_client_id,p_contract_id)
      and s.work_date between scope.week_ending_date-6 and scope.week_ending_date
      and (transition.new_present or (transition.outcome='CANCEL' and transition.exclude_cancel
        and not transition.new_present and transition.new_snapshot_line_id is null
        and (case when transition.outcome='CANCEL' and transition.exclude_cancel
          then private.weekly_source_missing_cancel_transition_assert_v1(transition.id) end)#>>'{original_basis,movement_id}'=p_movement_id::text))
  ) select count(distinct id),max(id::text)::uuid,
    coalesce(jsonb_agg(jsonb_build_object('snapshot_line_id',id,'scope_id',scope_id,'root_timesheet_id',root_timesheet_id,
      'selected_transition_id',selected_transition_id,'selected_order_key',selected_order_key,
      'source_hash',encode(source_hash,'hex'),'selected_final_revision_id',final_revision_id,
      'source_export_present',source_export_present,'exclude_cancel',exclude_cancel) order by scope_id),'[]'::jsonb)
    into v_count,v_snapshot,v_rows from actual;
  if v_count>1 then raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_SNAPSHOT_AMBIGUOUS' using errcode='55000';end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_PAY_SNAPSHOT_V1',
    'state',case when v_count=1 then 'CURRENT' else 'UNAVAILABLE' end,'snapshot_line_id',v_snapshot,
    'work_event_id',p_work_event_id,'movement_id',p_movement_id,'native_current_selections',v_rows);
end;
$function$;

create or replace function private.weekly_source_paid_match_retained_transition_assert_v1(p_transition_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  t public.weekly_source_state_transitions%rowtype;r public.weekly_source_final_revisions%rowtype;
  old_line public.weekly_source_final_snapshot_lines%rowtype;b public.weekly_source_final_snapshot_lines%rowtype;
  m public.weekly_source_billing_movements%rowtype;choice private.weekly_source_office_row_choices%rowtype;
  journal private.weekly_source_office_rechecks%rowtype;resolution public.weekly_source_row_resolutions%rowtype;
  raw_row public.weekly_source_upload_rows%rowtype;audit public.audit_events%rowtype;
  proof jsonb;item jsonb;rows jsonb;expected jsonb;counted integer;movement_id uuid;lineage_id uuid;economic_id uuid;
  native_basis jsonb;legacy_current jsonb;native_roots uuid[];source_group_id uuid;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict t from public.weekly_source_state_transitions where id=p_transition_id;
  select * into strict r from public.weekly_source_final_revisions where id=t.final_revision_id;
  if t.pay_basis_kind is distinct from 'RETAINED_PAID_MATCH' or t.outcome<>'NO_CHANGE'
    or t.exclude_cancel or not t.previous_present or not t.new_present
    or t.previous_snapshot_line_id is null or t.new_snapshot_line_id is distinct from t.previous_snapshot_line_id
    or t.prior_state_fingerprint is null or t.new_state_fingerprint is distinct from t.prior_state_fingerprint
    or r.authority_scope_kind<>'CYCLE' or r.report_scope_id is not null or r.finalised_by_user_id is null
    or r.state not in ('PREPARED','CURRENT') then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_RETAINED_TRANSITION_UNBOUND' using errcode='55000';end if;
  select * into strict old_line from public.weekly_source_final_snapshot_lines where id=t.previous_snapshot_line_id;
  if old_line.pay_effect<>'NORMAL'
    or old_line.work_event_id is distinct from t.work_event_id or old_line.final_revision_id=t.final_revision_id then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_PRIOR_PAY_BASIS_CHANGED' using errcode='55000';end if;
  select coalesce(jsonb_agg(jsonb_build_object('snapshot_line_id',s.id,'upload_row_id',s.upload_row_id,
    'paid_overlap_choice_id',s.paid_overlap_choice_id,'snapshot_line_hash',encode(s.snapshot_line_hash,'hex'))
    order by s.upload_row_id),'[]'::jsonb) into rows from public.weekly_source_final_snapshot_lines s
    where s.final_revision_id=r.id and s.work_event_id=t.work_event_id and s.pay_effect='NONE';
  if jsonb_array_length(rows)=0 or rows is distinct from t.paid_match_source_rows
    or exists(select 1 from public.weekly_source_final_snapshot_lines s
      where s.final_revision_id=r.id and s.work_event_id=t.work_event_id and s.pay_effect='NORMAL') then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_SOURCE_ROWS_CHANGED' using errcode='55000';end if;
  for b in select * from public.weekly_source_final_snapshot_lines s
    where s.final_revision_id=r.id and s.work_event_id=t.work_event_id and s.pay_effect='NONE' order by s.upload_row_id
  loop
    select * into strict resolution from public.weekly_source_row_resolutions where id=b.row_resolution_id;
    select * into strict raw_row from public.weekly_source_upload_rows where id=b.upload_row_id;
    select * into strict choice from private.weekly_source_office_row_choices where id=b.paid_overlap_choice_id;
    proof:=r.paid_overlap_choice_census->b.upload_row_id::text;
    if proof->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1'
      or proof->>'choice_proof_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1',proof-'choice_proof_sha256'),'hex')
      or proof->>'viewer_actor_user_id' is distinct from r.finalised_by_user_id::text
      or proof->>'choice_id' is distinct from choice.id::text or proof->>'pay_effect' is distinct from 'NONE'
      or proof->>'upload_row_id' is distinct from b.upload_row_id::text
      or proof->>'paid_overlap_target_work_event_id' is distinct from t.work_event_id::text
      or (b.candidate_id,b.client_id,b.contract_id) is distinct from (old_line.candidate_id,old_line.client_id,old_line.contract_id)
      or (resolution.upload_row_id,resolution.work_event_id,resolution.candidate_id,resolution.client_id,resolution.contract_id,resolution.pay_effect,resolution.paid_overlap_choice_id)
        is distinct from (b.upload_row_id,t.work_event_id,b.candidate_id,b.client_id,b.contract_id,'NONE',choice.id)
      or raw_row.upload_id is distinct from r.upload_id or raw_row.row_finalisation_state<>'SOURCE_WORKED'
      or resolution.mapping_state<>'RESOLVED'
      or (b.work_date,b.start_at_local,b.end_at_local,b.break_minutes,b.actual_net_minutes,b.source_fingerprint)
        is distinct from (raw_row.work_date,raw_row.start_at_local,raw_row.end_at_local,raw_row.break_minutes,raw_row.actual_net_minutes,raw_row.normalised_row_hash)
      or (choice.upload_row_id,choice.work_event_id,choice.candidate_id,choice.client_id,choice.contract_id,choice.pay_effect)
        is distinct from (b.upload_row_id,t.work_event_id,b.candidate_id,b.client_id,b.contract_id,'NONE')
      or choice.paid_overlap_target_work_event_id is distinct from t.work_event_id or choice.separate_shift
      or proof->>'confirmed_by_actor_user_id' is distinct from choice.actor_user_id::text then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_RETAINED_CHOICE_UNBOUND' using errcode='55000';end if;
    select count(*),max(value->>'current_pay_head_movement_id')::uuid into counted,movement_id
      from jsonb_array_elements(proof#>'{inputs,overlaps}') value where value->>'work_event_id'=t.work_event_id::text;
    if counted<>1 then raise exception 'WEEKLY_SOURCE_PAID_MATCH_PRIOR_PAY_BASIS_CHANGED' using errcode='55000';end if;
    select value into strict item from jsonb_array_elements(proof#>'{inputs,overlaps}') value where value->>'work_event_id'=t.work_event_id::text;
    if item->>'snapshot_line_id' is distinct from old_line.id::text
      or item->>'snapshot_line_hash' is distinct from encode(old_line.snapshot_line_hash,'hex')
      or item#>>'{current_pay_snapshot,state}' is distinct from 'CURRENT'
      or item#>>'{current_pay_snapshot,snapshot_line_id}' is distinct from old_line.id::text
      or item#>>'{current_pay_snapshot,movement_id}' is distinct from movement_id::text
      or item#>'{native_payment_facts,paid}' is distinct from 'true'::jsonb
      or (item#>>'{native_payment_facts,paid_evidence_state}') is null or (item#>>'{native_payment_facts,paid_evidence_state}') not in ('SETTLED_ORIGINAL','SETTLED_LEGACY_SOURCE_COMPONENT') then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_PRIOR_PAY_BASIS_CHANGED' using errcode='55000';end if;
    select * into strict m from public.weekly_source_billing_movements where id=movement_id;
    if (m.work_event_id,m.candidate_id,m.actual_client_id,m.contract_id) is distinct from
      (t.work_event_id,old_line.candidate_id,old_line.client_id,old_line.contract_id)
      or m.pay_effect<>'NORMAL' or m.movement_role not in ('POSITIVE','REPLACEMENT')
      or m.source_profile_kind='SELF_BILL_REPORT'
      or m.source_line_kind in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION')
      or item->>'movement_economic_hash' is distinct from encode(m.movement_economic_hash,'hex')
      then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_PRIOR_MOVEMENT_UNBOUND' using errcode='55000';end if;
    if item#>>'{native_payment_facts,paid_evidence_state}'='SETTLED_ORIGINAL' then
      -- Keep the existing NEXT map predicate unchanged for NEXT proof.
      if not exists(select 1 from private.bpay_next_source_current_snapshots mapping
        join private.bpay_next_source_current_scopes scope on scope.id=mapping.scope_id
        where mapping.snapshot_line_id=old_line.id and mapping.movement_id=m.id and mapping.work_event_id=t.work_event_id
          and scope.source_group_id=(select source_group_id from public.weekly_source_cycles where id=r.source_cycle_id)
          and (scope.candidate_id,scope.client_id,scope.contract_id)=(old_line.candidate_id,old_line.client_id,old_line.contract_id)) then
        raise exception 'WEEKLY_SOURCE_PAID_MATCH_PRIOR_MOVEMENT_UNBOUND' using errcode='55000';end if;
    else
      -- LEGACY publish_revision returns before NEXT capture. Re-prove the
      -- genuine Source prior selection instead of manufacturing a NEXT map.
      select c.source_group_id into strict source_group_id from public.weekly_source_cycles c where c.id=r.source_cycle_id;
      if item#>>'{native_payment_facts,paid_evidence_state}' is distinct from 'SETTLED_LEGACY_SOURCE_COMPONENT'
        or (select control.active_owner from private.bpay_next_module_control control where control.id=1) is distinct from 'LEGACY'
        or item#>>'{native_payment_facts,schema_version}' is distinct from 'WEEKLY_SOURCE_WORK_EVENT_PAYMENT_FACTS_V1'
        or item#>>'{native_payment_facts,work_event_id}' is distinct from t.work_event_id::text
        or item#>>'{native_payment_facts,source_cycle_id}' is distinct from r.source_cycle_id::text
        or item#>>'{native_payment_facts,source_group_id}' is distinct from source_group_id::text
        or item#>>'{native_payment_facts,candidate_id}' is distinct from old_line.candidate_id::text
        or item#>>'{native_payment_facts,client_id}' is distinct from old_line.client_id::text
        or jsonb_typeof(item#>'{native_payment_facts,root_timesheet_ids}') is distinct from 'array'
        or jsonb_array_length(item#>'{native_payment_facts,root_timesheet_ids}') not between 1 and 200
        or jsonb_typeof(item#>'{native_payment_facts,native_paid_basis}') is distinct from 'array'
        or jsonb_array_length(item#>'{native_payment_facts,native_paid_basis}')
          is distinct from jsonb_array_length(item#>'{native_payment_facts,root_timesheet_ids}') then
        raise exception 'WEEKLY_SOURCE_PAID_MATCH_LEGACY_BASIS_UNBOUND' using errcode='55000';end if;
      native_roots:=array(select value::uuid from jsonb_array_elements_text(item#>'{native_payment_facts,root_timesheet_ids}') value order by value);
      if cardinality(native_roots) is distinct from (select count(distinct root) from unnest(native_roots) root) then
        raise exception 'WEEKLY_SOURCE_PAID_MATCH_LEGACY_BASIS_UNBOUND' using errcode='55000';end if;
      for native_basis in select value from jsonb_array_elements(item#>'{native_payment_facts,native_paid_basis}') value loop
        if native_basis->>'schema_version' is distinct from 'WEEKLY_SOURCE_LEGACY_SIGNED_SOURCE_MEMBERSHIP_INPUT_V1'
          or native_basis->>'inputs_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_SOURCE_LEGACY_SIGNED_SOURCE_MEMBERSHIP_INPUT_V1',native_basis-'inputs_sha256'),'hex')
          or native_basis->>'work_event_id' is distinct from t.work_event_id::text
          or native_basis->>'source_cycle_id' is distinct from r.source_cycle_id::text
          or native_basis->>'source_group_id' is distinct from source_group_id::text
          or native_basis->>'candidate_id' is distinct from old_line.candidate_id::text
          or native_basis->>'client_id' is distinct from old_line.client_id::text
          or native_basis->>'actor_user_id' is distinct from r.finalised_by_user_id::text
          or native_basis#>>'{native_module,active_owner}' is distinct from 'LEGACY'
          or not ((native_basis->>'root_timesheet_id')::uuid=any(native_roots)) then
          raise exception 'WEEKLY_SOURCE_PAID_MATCH_LEGACY_BASIS_UNBOUND' using errcode='55000';end if;
      end loop;
      if array(select (value->>'root_timesheet_id')::uuid
          from jsonb_array_elements(item#>'{native_payment_facts,native_paid_basis}') value order by value->>'root_timesheet_id')
        is distinct from native_roots then
        raise exception 'WEEKLY_SOURCE_PAID_MATCH_LEGACY_BASIS_UNBOUND' using errcode='55000';end if;
      legacy_current:=private.weekly_source_paid_overlap_current_snapshot_for_cycle_v1(t.work_event_id,m.id,
        old_line.candidate_id,old_line.client_id,old_line.contract_id,source_group_id,native_roots,r.source_cycle_id);
      if legacy_current is distinct from item->'current_pay_snapshot'
        or legacy_current->>'state' is distinct from 'CURRENT'
        or legacy_current->>'snapshot_line_id' is distinct from old_line.id::text
        or legacy_current->>'movement_id' is distinct from m.id::text then
        raise exception 'WEEKLY_SOURCE_PAID_MATCH_PRIOR_MOVEMENT_UNBOUND' using errcode='55000';end if;
    end if;
    select * into strict journal from private.weekly_source_office_rechecks
      where request_id=(proof->>'confirmation_request_id')::uuid;
    if journal.actor_user_id is distinct from choice.actor_user_id or journal.upload_id is distinct from raw_row.upload_id
      or proof->>'confirmation_request_sha256' is distinct from encode(journal.request_hash,'hex')
      or journal.request_hash is distinct from private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFFICE_RECHECK_V1',journal.request_json) then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_UNBOUND' using errcode='55000';end if;
    select count(*) into counted from public.audit_events a where a.object_type='weekly_source_office_row_choices'
      and a.object_id_text=choice.id::text and a.action='WEEKLY_SOURCE_PAID_SHIFT_MATCH_CONFIRMED';
    if counted<>1 then raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_AUDIT_UNBOUND' using errcode='55000';end if;
    select * into strict audit from public.audit_events a where a.object_type='weekly_source_office_row_choices'
      and a.object_id_text=choice.id::text and a.action='WEEKLY_SOURCE_PAID_SHIFT_MATCH_CONFIRMED';
    if audit.actor_user_id is distinct from choice.actor_user_id or audit.after_json->'choice' is distinct from to_jsonb(choice)
      or audit.after_json->'admission' is distinct from choice.paid_overlap_inputs_json
      or audit.after_json->'request' is distinct from journal.request_json
      or audit.after_json->>'request_sha256' is distinct from encode(journal.request_hash,'hex') then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_AUDIT_UNBOUND' using errcode='55000';end if;
  end loop;
  expected:=jsonb_build_object('final_revision_id',r.id,'work_event_id',t.work_event_id,
    'previous_snapshot_line_id',old_line.id,'new_snapshot_line_id',old_line.id,'outcome','NO_CHANGE',
    'prior_state_fingerprint',encode(t.prior_state_fingerprint,'hex'),'new_state_fingerprint',encode(t.new_state_fingerprint,'hex'),
    'pay_basis_kind','RETAINED_PAID_MATCH','paid_match_source_rows',rows);
  if t.transition_fingerprint is distinct from private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_STATE_TRANSITION_V1',expected) then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_RETAINED_TRANSITION_HASH_UNBOUND' using errcode='55000';end if;
  select id into strict lineage_id from public.weekly_source_row_timesheet_lineages where row_resolution_id=old_line.row_resolution_id;
  select id into strict economic_id from public.weekly_source_row_economic_snapshots where row_resolution_id=old_line.row_resolution_id;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_MATCH_RETAINED_PAY_BASIS_V1','transition_id',t.id,
    'final_revision_id',r.id,'work_event_id',t.work_event_id,'snapshot_line_id',old_line.id,'movement_id',movement_id,
    'row_resolution_id',old_line.row_resolution_id,'lineage_id',lineage_id,'economic_snapshot_id',economic_id,
    'actual_present_invoice_rows',rows);
end;
$function$;

create or replace function private.weekly_source_paid_match_question_v1(
  p_projection_publication_id uuid,p_upload_row_id uuid,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_publication public.weekly_source_projection_publications%rowtype;
  v_upload public.weekly_source_uploads%rowtype;v_cycle public.weekly_source_cycles%rowtype;
  v_row public.weekly_source_upload_rows%rowtype;v_resolution public.weekly_source_row_resolutions%rowtype;
  v_inputs jsonb;v_item jsonb;v_protected jsonb;v_choices jsonb:='[]'::jsonb;v_result jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_projection_publication_id is null or p_upload_row_id is null or p_actor_user_id is null then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_QUESTION_INVALID' using errcode='22023';end if;
  select * into strict v_publication from public.weekly_source_projection_publications where id=p_projection_publication_id;
  select * into strict v_upload from public.weekly_source_uploads where id=v_publication.upload_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_publication.source_cycle_id;
  if v_upload.purpose='FINAL_SOURCE_CORRECTION' then
    perform private.weekly_source_paid_match_correction_scope_v1(v_upload.id,p_actor_user_id,false);
    if v_publication.state is distinct from 'CORRECTION_READY'
      or v_publication.id is distinct from (select replacement_projection_publication_id
        from public.weekly_final_source_correction_sessions where id=v_upload.correction_session_id) then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
  else
    perform private.weekly_source_query_current_publication_v1(v_cycle.id,v_publication.id);
  end if;
  select * into strict v_row from public.weekly_source_upload_rows where id=p_upload_row_id and upload_id=v_upload.id;
  select * into v_resolution from public.weekly_source_row_resolutions
    where upload_row_id=v_row.id and generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version::integer)
    order by id desc limit 1;
  if not found or v_resolution.blocker_code is distinct from 'PAID_SHIFT_OVERLAP_CONFIRMATION_REQUIRED' then return null;end if;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_MATCH_QUESTION_V1',
    'state','UNAVAILABLE','reason_code','WEEKLY_SOURCE_PAID_OVERLAP_SCOPE_UNAVAILABLE',
    'upload_row_id',v_row.id,'upload_id',v_upload.id,'projection_publication_id',v_publication.id,
    'candidate_id',v_resolution.candidate_id,'client_id',v_resolution.client_id,'contract_id',v_resolution.contract_id,
    'expected_authority_scope_version',v_publication.authority_scope_version,
    'expected_row_manifest_hash',encode(v_upload.row_manifest_hash,'hex'),
    'expected_paid_overlap_inputs_sha256',null,'choices','[]'::jsonb);
  if not ((v_publication.authority_scope_kind='CYCLE' and v_publication.report_scope_id is null and v_upload.report_scope_id is null)
      or (v_publication.authority_scope_kind='NHSP_REPORT_SCOPE' and v_publication.report_scope_id=v_upload.report_scope_id
        and exists(select 1 from public.weekly_source_report_scopes scope
          join public.weekly_source_format_profiles profile on profile.id=v_upload.source_format_profile_id
          where scope.id=v_upload.report_scope_id and scope.source_cycle_id=v_cycle.id
            and scope.client_id=v_resolution.client_id and scope.self_bill_report_id is null
            and scope.current_projection_publication_id=v_publication.id and profile.profile_code='NHSP_FINAL_BACKING_V1')))
    or v_upload.purpose not in ('ORDINARY','FINAL_SOURCE_CORRECTION')
    or (v_upload.purpose='ORDINARY' and v_cycle.state<>'OPEN')
    or (v_upload.purpose='FINAL_SOURCE_CORRECTION' and not exists(select 1
      from public.weekly_final_source_correction_sessions session where session.id=v_upload.correction_session_id
        and session.state in ('READY','REVIEWED') and session.actor_user_id=p_actor_user_id))
    or v_resolution.candidate_id is null or v_resolution.client_id is null or v_resolution.contract_id is null then
    return v_result;end if;
  if private.weekly_source_pay_actor_allowed_v1(p_actor_user_id) is distinct from true then
    return v_result||jsonb_build_object('reason_code','WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED');end if;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',v_cycle.source_group_id,
    v_resolution.client_id,v_cycle.finalisation_week_ending);
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'APPROVE_PROTECTED_PAY',v_cycle.source_group_id,
    v_resolution.client_id,v_cycle.finalisation_week_ending);
  -- Preserve canonical/alias and identical-rekey precedence. The real alias
  -- owner censuses ALL same-namespace owners before Candidate/Client admission.
  if v_upload.report_scope_id is null and (private.weekly_source_known_source_key_v1(v_row.id,v_resolution.candidate_id,v_resolution.client_id) is not null
    or private.weekly_source_identical_rekey_prior_v1(v_row.id) is not null) then
    return v_result||jsonb_build_object('reason_code','WEEKLY_SOURCE_PAID_OVERLAP_AUTOMATIC_REKEY');end if;
  if not exists(select 1 from public.contracts contract where contract.id=v_resolution.contract_id
    and contract.candidate_id=v_resolution.candidate_id and contract.client_id=v_resolution.client_id
    and v_row.work_date between contract.start_date and coalesce(contract.end_date,'infinity'::date)) then
    return v_result||jsonb_build_object('reason_code','WEEKLY_SOURCE_PAID_OVERLAP_CONTRACT_NOT_ELIGIBLE');end if;
  v_inputs:=private.weekly_source_paid_overlap_candidates_v1(v_row.id,p_actor_user_id,v_resolution.candidate_id,v_resolution.client_id);
  if jsonb_array_length(v_inputs->'overlaps')>100 then
    return v_result||jsonb_build_object('reason_code','WEEKLY_SOURCE_PAID_MATCH_QUESTION_TOO_LARGE');end if;
  v_protected:=private.weekly_source_protected_match_candidates_v1(v_row.id,v_resolution.candidate_id,v_resolution.client_id);
  for v_item in select item from jsonb_array_elements(v_inputs->'overlaps') item order by item->>'work_event_id'
  loop
    -- Unknown/Legacy hours evidence is not a paid-write certificate. The
    -- same existing writer independently rederives this proof under I-1.
    if (case when v_item ? 'nhsp_negative_population' then
      v_item#>>'{current_native_position,schema_version}' is distinct from 'WEEKLY_SOURCE_NHSP_CURRENT_OVERLAP_POSITION_INPUT_V1'
      or v_item#>>'{current_native_position,state}' is distinct from 'CURRENT_NATIVE_POSITION'
      or v_item#>'{current_native_position,work_event_id}' is distinct from v_item->'work_event_id'
      or v_item#>'{current_native_position,contract_id}' is distinct from v_item->'contract_id'
      or v_item#>'{current_native_position,native_current_basis_sha256}' is distinct from v_item#>'{nhsp_negative_population,native_current_basis,inputs_sha256}'
      or v_item#>'{nhsp_negative_population,negative_population_complete}' is distinct from 'true'::jsonb
      or v_item#>'{nhsp_negative_population,current_position_available}' is distinct from 'true'::jsonb
      or v_item#>'{nhsp_negative_population,no_reversal_proved}' is distinct from 'true'::jsonb
      or v_item#>'{nhsp_negative_population,paid_writer_permission}' is distinct from 'null'::jsonb
      else v_item#>>'{current_pay_snapshot,state}' is distinct from 'CURRENT'
    or v_item#>>'{current_pay_snapshot,snapshot_line_id}' is distinct from v_item->>'snapshot_line_id'
    or v_item#>>'{current_pay_snapshot,movement_id}' is distinct from v_item->>'current_pay_head_movement_id' end)
      or v_item#>'{native_payment_facts,paid}' is distinct from 'true'::jsonb
      or (v_item#>>'{native_payment_facts,paid_evidence_state}') is null or (v_item#>>'{native_payment_facts,paid_evidence_state}') not in ('SETTLED_ORIGINAL','SETTLED_LEGACY_SOURCE_COMPONENT')
      or (v_item ? 'nhsp_negative_population' and (
        v_item#>>'{current_native_position,state}' is distinct from 'CURRENT_NATIVE_POSITION'
        or v_item#>'{nhsp_negative_population,negative_population_complete}' is distinct from 'true'::jsonb
        or v_item#>'{nhsp_negative_population,current_position_available}' is distinct from 'true'::jsonb
        or v_item#>'{nhsp_negative_population,no_reversal_proved}' is distinct from 'true'::jsonb))
      or exists(select 1 from jsonb_array_elements(v_protected) protected
        where protected->>'work_event_id'=v_item->>'work_event_id') then continue;end if;
    v_choices:=v_choices||jsonb_build_array(jsonb_build_object('work_event_id',v_item->>'work_event_id',
      'work_date',v_item->>'work_date','start',to_char((v_item->>'start_at_local')::timestamp,'HH24:MI'),
      'end',to_char((v_item->>'end_at_local')::timestamp,'HH24:MI'),'break_minutes',v_item->'break_minutes',
      'contract_id',v_item->>'contract_id','same_allowed',v_item->>'contract_id'=v_resolution.contract_id::text));
  end loop;
  if jsonb_array_length(v_choices)=0 then
    return v_result||jsonb_build_object('reason_code','WEEKLY_SOURCE_PAID_OVERLAP_PAID_AUTHORITY_UNAVAILABLE');end if;
  return v_result||jsonb_build_object('state','READY','reason_code',null,
    'expected_paid_overlap_inputs_sha256',v_inputs->>'inputs_sha256','choices',v_choices);
end;
$function$;

create or replace function private.weekly_source_fixed_expense_invoice_values_v1(p_policy_snapshot_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_expense_policy public.weekly_source_row_expense_policy_snapshots%rowtype;
  v_new_pence bigint;v_vat_rate numeric(5,2);v_vat numeric(12,2);v_total numeric(12,2);
  v_replacement_pay_vector jsonb;v_replacement_charge_vector jsonb;
begin
  select * into strict v_expense_policy from public.weekly_source_row_expense_policy_snapshots
    where id=p_policy_snapshot_id;
  v_new_pence:=v_expense_policy.source_expense_pence;
  if v_new_pence is null or v_new_pence<0 or v_expense_policy.source_expense_vat_enabled is null
    or (v_expense_policy.source_expense_vat_enabled and v_expense_policy.invoice_vat_rate_pct is null) then
    raise exception 'WEEKLY_SOURCE_FIXED_EXPENSE_INVOICE_VALUES_UNBOUND' using errcode='55000';end if;
    v_vat_rate:=case when v_expense_policy.source_expense_vat_enabled
      then v_expense_policy.invoice_vat_rate_pct else 0 end;
    v_vat:=pg_catalog.round((v_new_pence::numeric/100)*(v_vat_rate/100),2);
    v_total:=v_new_pence::numeric/100+v_vat;
    v_replacement_pay_vector:=pg_catalog.jsonb_build_object(
      'schema_version','WEEKLY_SOURCE_FIXED_EXPENSE_VECTOR_V1','kind','PAY',
      'source_expense_pence',v_new_pence,
      'source_expense_vat_enabled',v_expense_policy.source_expense_vat_enabled
    );
    v_replacement_charge_vector:=v_replacement_pay_vector||pg_catalog.jsonb_build_object('kind','CHARGE');
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_FIXED_EXPENSE_INVOICE_VALUES_V1',
    'row_expense_policy_snapshot_id',v_expense_policy.id,'row_resolution_id',v_expense_policy.row_resolution_id,
    'work_event_id',v_expense_policy.work_event_id,'candidate_id',v_expense_policy.candidate_id,
    'client_id',v_expense_policy.client_id,'contract_id',v_expense_policy.contract_id,
    'net_pence',v_new_pence,'source_expense_vat_enabled',v_expense_policy.source_expense_vat_enabled,
    'vat_rate_pct',v_vat_rate,'vat_amount',v_vat,'total_inc_vat',v_total,
    'pay_vector',v_replacement_pay_vector,'charge_vector',v_replacement_charge_vector,
    'invoice_vat_policy_fingerprint',encode(v_expense_policy.invoice_vat_policy_fingerprint,'hex'));
end;
$function$;

create or replace function private.weekly_source_finalisation_materialise_expense_invoice_v1(
  p_final_revision_id uuid,
  p_finalisation_cycle_id uuid,
  p_source_profile_kind text,
  p_expense_authority_generation_id uuid,
  p_prior_expense_authority_generation_id uuid,
  p_expense_policy_snapshot_id uuid,
  p_invoice_timesheet_id uuid,
  p_correction_presentation text
) returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_current public.weekly_expense_authority_generations%rowtype;
  v_prior public.weekly_expense_authority_generations%rowtype;
  v_expense_policy public.weekly_source_row_expense_policy_snapshots%rowtype;
  v_contract public.contracts%rowtype;
  v_event public.weekly_work_events%rowtype;
  v_prior_movement public.weekly_source_billing_movements%rowtype;
  v_revision public.weekly_source_final_revisions%rowtype;
  v_old_pence bigint:=0;
  v_new_pence bigint;
  v_correction_unit_id uuid;
  v_mapping_fingerprint bytea;
  v_reversal_hash bytea;
  v_replacement_hash bytea;
  v_reversal_id uuid;
  v_replacement_id uuid;
  v_reversal_vector jsonb;
  v_replacement_pay_vector jsonb;
  v_replacement_charge_vector jsonb;
  v_vat_rate numeric(5,2);
  v_vat numeric(12,2);
  v_total numeric(12,2);
  v_values jsonb;
  v_count integer:=0;
  v_prepared boolean:=false;
begin
  if p_final_revision_id is null or p_finalisation_cycle_id is null
     or p_expense_authority_generation_id is null
     or p_source_profile_kind not in ('GENERIC_COMPLETE_SNAPSHOT','HEALTHROSTER_ACTUAL_ROWS')
     or p_correction_presentation not in ('FULL_REVERSAL_REPLACEMENT','NET_DIFFERENCE_PRESENTATION') then
    raise exception 'WEEKLY_SOURCE_EXPENSE_MOVEMENT_INPUT_INVALID' using errcode='22023';
  end if;

  select * into strict v_revision
  from public.weekly_source_final_revisions
  where id=p_final_revision_id and source_cycle_id=p_finalisation_cycle_id
    and state in ('PREPARED','CURRENT') and authority_scope_kind='CYCLE';
  v_prepared:=v_revision.state='PREPARED';
  select * into strict v_current
  from public.weekly_expense_authority_generations
  where id=p_expense_authority_generation_id and final_revision_id=p_final_revision_id
    and state=case when v_prepared then 'PREPARED' else 'CURRENT' end;
  v_new_pence:=(v_current.client_charge_ex_vat*100)::bigint;
  if v_current.source_expense_pence is distinct from v_new_pence
     or v_current.candidate_reimbursement_ex_vat is distinct from v_current.client_charge_ex_vat
     or v_current.prior_expense_authority_generation_id
          is distinct from p_prior_expense_authority_generation_id
     or v_current.correction_presentation is distinct from p_correction_presentation then
    raise exception 'WEEKLY_SOURCE_EXPENSE_AUTHORITY_INVALID' using errcode='55000';
  end if;

  if p_prior_expense_authority_generation_id is not null then
    select * into strict v_prior
    from public.weekly_expense_authority_generations
    where id=p_prior_expense_authority_generation_id
      and work_event_id=v_current.work_event_id
      and (
        (not v_prepared and generation=v_current.generation-1)
        or (v_prepared and generation<v_current.generation)
      )
      and (
        (not v_prepared and state='SUPERSEDED')
        or (v_prepared and state in ('CURRENT','SUPERSEDED'))
      );
    if v_prepared and exists(
      select 1
      from public.weekly_expense_authority_generations skipped
      where skipped.work_event_id=v_current.work_event_id
        and skipped.generation>v_prior.generation
        and skipped.generation<v_current.generation
        and skipped.final_revision_id is distinct from v_revision.predecessor_revision_id
    ) then
      raise exception 'WEEKLY_SOURCE_PREPARED_EXPENSE_HISTORY_INVALID'
        using errcode='55000';
    end if;
    v_old_pence:=(v_prior.client_charge_ex_vat*100)::bigint;
    if v_prior.source_expense_pence is distinct from v_old_pence
       or v_prior.candidate_reimbursement_ex_vat is distinct from v_prior.client_charge_ex_vat then
      raise exception 'WEEKLY_SOURCE_PRIOR_EXPENSE_AUTHORITY_INVALID' using errcode='55000';
    end if;
  elsif v_current.generation<>1 then
    if not v_prepared or exists(
      select 1
      from public.weekly_expense_authority_generations skipped
      where skipped.work_event_id=v_current.work_event_id
        and skipped.generation<v_current.generation
        and skipped.final_revision_id is distinct from v_revision.predecessor_revision_id
    ) then
      raise exception 'WEEKLY_SOURCE_PRIOR_EXPENSE_AUTHORITY_MISSING' using errcode='55000';
    end if;
  end if;

  if v_new_pence=v_old_pence and (
       p_prior_expense_authority_generation_id is null
       or (v_current.source_expense_vat_enabled is not distinct from v_prior.source_expense_vat_enabled
           and v_current.contract_id is not distinct from v_prior.contract_id)
     ) then
    return pg_catalog.jsonb_build_object(
      'movement_count',0,'primary_movement_id',null,'zero_noop',true
    );
  end if;
  v_correction_unit_id:=case when v_old_pence>0 then pg_catalog.gen_random_uuid() end;

  if v_old_pence>0 then
    select * into v_prior_movement
    from public.weekly_source_billing_movements movement
    where movement.expense_authority_generation_id=p_prior_expense_authority_generation_id
      and movement.source_line_kind='SOURCE_FIXED_EXPENSE'
      and movement.movement_role in ('EXPENSE_POSITIVE','EXPENSE_REPLACEMENT')
      and movement.invoice_presentation_charge_pence=v_old_pence
    order by movement.created_at_utc desc,movement.id desc
    limit 1;
    if not found then
      raise exception 'WEEKLY_SOURCE_PRIOR_EXPENSE_MOVEMENT_MISSING' using errcode='55000';
    end if;
    v_reversal_vector:=pg_catalog.jsonb_build_object(
      'schema_version','WEEKLY_SOURCE_FIXED_EXPENSE_VECTOR_V1',
      'kind','PAY_AND_CHARGE','source_expense_pence',-v_old_pence,
      'source_expense_vat_enabled',v_prior.source_expense_vat_enabled
    );
    v_mapping_fingerprint:=private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_FIXED_EXPENSE_MAPPING_V1',
      pg_catalog.jsonb_build_object(
        'current_expense_authority_generation_id',v_current.id,
        'prior_expense_authority_generation_id',v_prior.id,
        'prior_movement_id',v_prior_movement.id,
        'role','EXPENSE_REVERSAL'
      )
    );
    v_reversal_hash:=private.weekly_source_billing_movement_hash_v1(
      pg_catalog.jsonb_build_object(
        'expense_authority_generation_id',v_current.id,
        'final_revision_id',p_final_revision_id,
        'finalisation_cycle_id',p_finalisation_cycle_id,
        'actual_client_id',v_prior_movement.actual_client_id,
        'candidate_id',v_prior_movement.candidate_id,
        'contract_id',v_prior_movement.contract_id,
        'work_event_id',v_prior_movement.work_event_id,
        'movement_role','EXPENSE_REVERSAL','correction_unit_id',v_correction_unit_id,
        'prior_movement_id',v_prior_movement.id,
        'source_profile_kind',p_source_profile_kind,
        'source_line_kind','SOURCE_FIXED_EXPENSE',
        'source_facts',pg_catalog.jsonb_build_object(
          'schema_version','WEEKLY_SOURCE_FIXED_EXPENSE_FACTS_V1',
          'correction_presentation',p_correction_presentation,
          'old_expense_pence',v_old_pence,'new_expense_pence',v_new_pence,
          'authority_generation_id',v_current.id,
          'prior_authority_generation_id',v_prior.id,
          'row_expense_policy_snapshot_id',v_current.row_expense_policy_snapshot_id,
          'source_observation_kind',v_current.source_observation_kind
        ),
        'vector',v_reversal_vector,'invoice_presentation_charge_pence',-v_old_pence,
        'vat_rate_pct',v_prior_movement.vat_rate_pct,
        'vat_amount',-v_prior_movement.vat_amount,
        'total_inc_vat',-v_prior_movement.total_inc_vat,
        'mapping_rate_policy_fingerprint',pg_catalog.encode(v_mapping_fingerprint,'hex'),
        'invoice_timesheet_id',v_prior_movement.invoice_timesheet_id
      )
    );
    insert into public.weekly_source_billing_movements(
      transition_id,nhsp_upload_row_id,expense_authority_generation_id,
      final_revision_id,finalisation_cycle_id,actual_client_id,candidate_id,
      contract_id,work_event_id,movement_role,correction_unit_id,prior_movement_id,
      source_profile_kind,source_line_kind,source_facts_json,
      canonical_pay_vector_json,canonical_charge_vector_json,total_pay_ex_vat,
      calculated_comparison_charge_pence,source_validation_charge_pence,
      invoice_presentation_charge_pence,vat_rate_pct,vat_amount,total_inc_vat,
      price_check_result,price_check_fingerprint,mapping_rate_policy_fingerprint,
      invoice_timesheet_id,original_cycle_key,movement_economic_hash,placement_state
    ) values (
      null,null,v_current.id,p_final_revision_id,p_finalisation_cycle_id,
      v_prior_movement.actual_client_id,v_prior_movement.candidate_id,
      v_prior_movement.contract_id,v_prior_movement.work_event_id,
      'EXPENSE_REVERSAL',v_correction_unit_id,v_prior_movement.id,
      p_source_profile_kind,'SOURCE_FIXED_EXPENSE',
      pg_catalog.jsonb_build_object(
        'schema_version','WEEKLY_SOURCE_FIXED_EXPENSE_FACTS_V1',
        'correction_presentation',p_correction_presentation,
        'old_expense_pence',v_old_pence,'new_expense_pence',v_new_pence,
        'authority_generation_id',v_current.id,
        'prior_authority_generation_id',v_prior.id,
        'row_expense_policy_snapshot_id',v_current.row_expense_policy_snapshot_id,
        'source_observation_kind',v_current.source_observation_kind
      ),v_reversal_vector,v_reversal_vector,-v_old_pence::numeric/100,
      -v_old_pence,-v_old_pence,-v_old_pence,v_prior_movement.vat_rate_pct,
      -v_prior_movement.vat_amount,-v_prior_movement.total_inc_vat,
      'NOT_APPLICABLE',null,v_mapping_fingerprint,
      v_prior_movement.invoice_timesheet_id,p_finalisation_cycle_id::text,
      v_reversal_hash,'UNPLACED'
    ) returning id into v_reversal_id;
    v_count:=v_count+1;
  end if;

  if v_new_pence>0 then
    if p_expense_policy_snapshot_id is null or p_invoice_timesheet_id is null
       or v_current.source_observation_kind<>'ROW_PRESENT'
       or v_current.row_expense_policy_snapshot_id is distinct from p_expense_policy_snapshot_id then
      raise exception 'WEEKLY_SOURCE_EXPENSE_POLICY_SNAPSHOT_MISSING' using errcode='55000';
    end if;
    select * into strict v_expense_policy
    from public.weekly_source_row_expense_policy_snapshots
    where id=p_expense_policy_snapshot_id;
    select * into strict v_contract
    from public.contracts where id=v_current.contract_id;
    select * into strict v_event
    from public.weekly_work_events where id=v_current.work_event_id;
    if v_expense_policy.work_event_id is distinct from v_current.work_event_id
       or v_expense_policy.contract_id is distinct from v_current.contract_id
       or v_expense_policy.source_expense_pence is distinct from v_current.source_expense_pence
       or v_contract.id is distinct from v_expense_policy.contract_id
       or v_contract.client_id is distinct from v_expense_policy.client_id
       or v_contract.candidate_id is distinct from v_expense_policy.candidate_id
       or v_event.client_id is distinct from v_expense_policy.client_id
       or v_event.candidate_id is distinct from v_expense_policy.candidate_id
       or v_expense_policy.source_expense_vat_enabled is distinct from v_current.source_expense_vat_enabled then
      raise exception 'WEEKLY_SOURCE_EXPENSE_POLICY_SNAPSHOT_INVALID' using errcode='55000';
    end if;
    -- The existing scope/current/prior/policy equality guards above remain
    -- the write authority. This reads that exact immutable policy snapshot.
    v_values:=private.weekly_source_fixed_expense_invoice_values_v1(v_expense_policy.id);
    v_vat_rate:=(v_values->>'vat_rate_pct')::numeric(5,2);
    v_vat:=(v_values->>'vat_amount')::numeric(12,2);
    v_total:=(v_values->>'total_inc_vat')::numeric(12,2);
    v_replacement_pay_vector:=v_values->'pay_vector';
    v_replacement_charge_vector:=v_values->'charge_vector';
    v_mapping_fingerprint:=private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_FIXED_EXPENSE_MAPPING_V1',
      pg_catalog.jsonb_build_object(
        'current_expense_authority_generation_id',v_current.id,
        'prior_expense_authority_generation_id',p_prior_expense_authority_generation_id,
        'expense_policy_snapshot_id',v_expense_policy.id,
        'invoice_vat_policy_fingerprint',pg_catalog.encode(v_expense_policy.invoice_vat_policy_fingerprint,'hex'),
        'role',case when v_old_pence=0 then 'EXPENSE_POSITIVE' else 'EXPENSE_REPLACEMENT' end
      )
    );
    v_replacement_hash:=private.weekly_source_billing_movement_hash_v1(
      pg_catalog.jsonb_build_object(
        'expense_authority_generation_id',v_current.id,
        'final_revision_id',p_final_revision_id,
        'finalisation_cycle_id',p_finalisation_cycle_id,
        'actual_client_id',v_expense_policy.client_id,'candidate_id',v_expense_policy.candidate_id,
        'contract_id',v_expense_policy.contract_id,'work_event_id',v_expense_policy.work_event_id,
        'movement_role',case when v_old_pence=0 then 'EXPENSE_POSITIVE' else 'EXPENSE_REPLACEMENT' end,
        'correction_unit_id',v_correction_unit_id,'prior_movement_id',v_prior_movement.id,
        'source_profile_kind',p_source_profile_kind,'source_line_kind','SOURCE_FIXED_EXPENSE',
        'source_facts',pg_catalog.jsonb_build_object(
          'schema_version','WEEKLY_SOURCE_FIXED_EXPENSE_FACTS_V1',
          'correction_presentation',p_correction_presentation,
          'old_expense_pence',v_old_pence,'new_expense_pence',v_new_pence,
          'authority_generation_id',v_current.id,
          'prior_authority_generation_id',p_prior_expense_authority_generation_id,
          'row_expense_policy_snapshot_id',v_current.row_expense_policy_snapshot_id,
          'source_observation_kind',v_current.source_observation_kind
        ),
        'pay_vector',v_replacement_pay_vector,'charge_vector',v_replacement_charge_vector,
        'invoice_presentation_charge_pence',v_new_pence,'vat_rate_pct',v_vat_rate,
        'vat_amount',v_vat,'total_inc_vat',v_total,
        'mapping_rate_policy_fingerprint',pg_catalog.encode(v_mapping_fingerprint,'hex'),
        'invoice_timesheet_id',p_invoice_timesheet_id
      )
    );
    insert into public.weekly_source_billing_movements(
      transition_id,nhsp_upload_row_id,expense_authority_generation_id,
      final_revision_id,finalisation_cycle_id,actual_client_id,candidate_id,
      contract_id,work_event_id,movement_role,correction_unit_id,prior_movement_id,
      source_profile_kind,source_line_kind,source_facts_json,
      canonical_pay_vector_json,canonical_charge_vector_json,total_pay_ex_vat,
      calculated_comparison_charge_pence,source_validation_charge_pence,
      invoice_presentation_charge_pence,vat_rate_pct,vat_amount,total_inc_vat,
      price_check_result,price_check_fingerprint,mapping_rate_policy_fingerprint,
      invoice_timesheet_id,original_cycle_key,movement_economic_hash,placement_state
    ) values (
      null,null,v_current.id,p_final_revision_id,p_finalisation_cycle_id,
      v_expense_policy.client_id,v_expense_policy.candidate_id,v_expense_policy.contract_id,
      v_expense_policy.work_event_id,
      case when v_old_pence=0 then 'EXPENSE_POSITIVE' else 'EXPENSE_REPLACEMENT' end,
      v_correction_unit_id,case when v_old_pence>0 then v_prior_movement.id end,
      p_source_profile_kind,'SOURCE_FIXED_EXPENSE',
      pg_catalog.jsonb_build_object(
        'schema_version','WEEKLY_SOURCE_FIXED_EXPENSE_FACTS_V1',
        'correction_presentation',p_correction_presentation,
        'old_expense_pence',v_old_pence,'new_expense_pence',v_new_pence,
        'authority_generation_id',v_current.id,
        'prior_authority_generation_id',p_prior_expense_authority_generation_id,
        'row_expense_policy_snapshot_id',v_current.row_expense_policy_snapshot_id,
        'source_observation_kind',v_current.source_observation_kind
      ),v_replacement_pay_vector,v_replacement_charge_vector,v_new_pence::numeric/100,
      v_new_pence,v_new_pence,v_new_pence,v_vat_rate,v_vat,v_total,
      'NOT_APPLICABLE',null,v_mapping_fingerprint,p_invoice_timesheet_id,
      p_finalisation_cycle_id::text,v_replacement_hash,'UNPLACED'
    ) returning id into v_replacement_id;
    v_count:=v_count+1;
  end if;

  return pg_catalog.jsonb_build_object(
    'movement_count',v_count,
    'reversal_movement_id',v_reversal_id,
    'replacement_movement_id',v_replacement_id,
    'primary_movement_id',coalesce(v_replacement_id,v_reversal_id),
    'zero_noop',false
  );
end;
$function$;

create or replace function private.weekly_source_paid_match_expense_invoice_origin_assert_v1(p_movement_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare m public.weekly_source_billing_movements%rowtype;h public.weekly_source_billing_movements%rowtype;
  s public.weekly_source_final_snapshot_lines%rowtype;p public.weekly_source_row_expense_policy_snapshots%rowtype;
  r public.weekly_source_final_revisions%rowtype;v_values jsonb;v_pay jsonb;v_mapping bytea;v_state jsonb;
begin
  select * into strict m from public.weekly_source_billing_movements where id=p_movement_id;
  if m.pay_effect<>'NONE' or m.invoice_only_snapshot_line_id is null or m.source_line_kind<>'SOURCE_FIXED_EXPENSE'
    or m.movement_role<>'EXPENSE_POSITIVE' or m.transition_id is not null or m.nhsp_upload_row_id is not null
    or m.expense_authority_generation_id is not null or m.self_bill_report_row_id is not null
    or m.vat_rounding_revision_id is not null or m.prior_movement_id is not null or m.correction_unit_id is not null
    or m.total_pay_ex_vat<>0 or m.price_check_result<>'NOT_APPLICABLE' or m.price_check_fingerprint is not null
    or m.charge_acceptance_id is not null then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_EXPENSE_ORIGIN_UNBOUND' using errcode='55000';end if;
  select * into strict s from public.weekly_source_final_snapshot_lines where id=m.invoice_only_snapshot_line_id;
  select * into strict r from public.weekly_source_final_revisions where id=m.final_revision_id;
  select * into strict h from public.weekly_source_billing_movements
    where id=(m.source_facts_json->>'hours_companion_movement_id')::uuid;
  if h.source_line_kind<>'SOURCE_REBILL_LINE' or h.invoice_only_snapshot_line_id is distinct from s.id
    or h.pay_effect<>'NONE' or h.final_revision_id is distinct from r.id then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_EXPENSE_HOURS_ORIGIN_UNBOUND' using errcode='55000';end if;
  perform private.weekly_source_paid_match_invoice_origin_assert_v1(h.id);
  select * into strict p from public.weekly_source_row_expense_policy_snapshots
    where id=(m.source_facts_json->>'row_expense_policy_snapshot_id')::uuid;
  if p.source_expense_pence is null or p.source_expense_pence<=0
    or p.row_resolution_id is distinct from s.row_resolution_id or p.upload_row_id is distinct from s.upload_row_id
    or p.work_event_id is distinct from s.work_event_id or p.contract_id is distinct from s.contract_id
    or p.candidate_id is distinct from s.candidate_id or p.client_id is distinct from s.client_id
    or p.source_expense_pence is distinct from s.source_expense_pence
    or m.finalisation_cycle_id is distinct from r.source_cycle_id or m.work_event_id is distinct from s.work_event_id
    or m.contract_id is distinct from s.contract_id or m.actual_client_id is distinct from s.client_id
    or m.candidate_id is distinct from s.candidate_id or m.source_profile_kind is distinct from s.source_profile_kind
    or m.invoice_timesheet_id is distinct from h.invoice_timesheet_id
    or m.source_facts_json->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_MATCH_FIXED_EXPENSE_FACTS_V1'
    or m.source_facts_json->>'snapshot_line_id' is distinct from s.id::text
    or m.source_facts_json->>'snapshot_line_hash' is distinct from encode(s.snapshot_line_hash,'hex')
    or m.source_facts_json->>'upload_row_id' is distinct from s.upload_row_id::text
    or m.source_facts_json->>'bound_row_resolution_id' is distinct from s.row_resolution_id::text
    or m.source_facts_json->>'paid_overlap_choice_id' is distinct from s.paid_overlap_choice_id::text
    or m.source_facts_json->>'pay_effect' is distinct from 'NONE' or m.source_facts_json ? 'row_resolution_id'
    or m.source_facts_json->>'rule_set_version_id' is distinct from r.rule_set_version_id::text
    or m.source_facts_json->'invoice_window_cycle_id' is distinct from h.source_facts_json->'invoice_window_cycle_id'
    or m.source_facts_json->'invoice_window_scope' is distinct from h.source_facts_json->'invoice_window_scope' then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_EXPENSE_POLICY_UNBOUND' using errcode='55000';end if;
  v_values:=private.weekly_source_fixed_expense_invoice_values_v1(p.id);
  v_pay:=v_values->'pay_vector'||jsonb_build_object('source_expense_pence',0);
  if m.source_facts_json->'invoice_values' is distinct from v_values
    or m.canonical_pay_vector_json is distinct from v_pay or m.canonical_charge_vector_json is distinct from v_values->'charge_vector'
    or m.calculated_comparison_charge_pence is distinct from p.source_expense_pence
    or m.source_validation_charge_pence is distinct from p.source_expense_pence
    or m.invoice_presentation_charge_pence is distinct from p.source_expense_pence
    or m.vat_rate_pct is distinct from (v_values->>'vat_rate_pct')::numeric(5,2)
    or m.vat_amount is distinct from (v_values->>'vat_amount')::numeric(12,2)
    or m.total_inc_vat is distinct from (v_values->>'total_inc_vat')::numeric(12,2) then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_EXPENSE_NATIVE_VALUES_CHANGED' using errcode='55000';end if;
  v_mapping:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_PAID_MATCH_EXPENSE_MAPPING_V1',
    jsonb_build_object('snapshot_line_id',s.id,'snapshot_line_hash',encode(s.snapshot_line_hash,'hex'),
      'row_expense_policy_snapshot_id',p.id,'invoice_vat_policy_fingerprint',encode(p.invoice_vat_policy_fingerprint,'hex'),
      'hours_companion_movement_id',h.id,'paid_overlap_choice_id',s.paid_overlap_choice_id));
  if v_mapping is distinct from m.mapping_rate_policy_fingerprint then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_EXPENSE_MAPPING_CHANGED' using errcode='55000';end if;
  v_state:=jsonb_build_object('invoice_only_snapshot_line_id',s.id,'pay_effect','NONE','final_revision_id',r.id,
    'finalisation_cycle_id',r.source_cycle_id,'actual_client_id',s.client_id,'candidate_id',s.candidate_id,
    'contract_id',s.contract_id,'work_event_id',s.work_event_id,'movement_role','EXPENSE_POSITIVE',
    'source_profile_kind',s.source_profile_kind,'source_line_kind','SOURCE_FIXED_EXPENSE','source_facts',m.source_facts_json,
    'pay_vector',v_pay,'charge_vector',v_values->'charge_vector','total_pay_pence',0,
    'calculated_comparison_charge_pence',p.source_expense_pence,'source_validation_charge_pence',p.source_expense_pence,
    'invoice_presentation_charge_pence',p.source_expense_pence,'vat_rate_pct',m.vat_rate_pct,'vat_amount',m.vat_amount,
    'total_inc_vat',m.total_inc_vat,'price_check_result','NOT_APPLICABLE','price_check_fingerprint',null,'charge_acceptance_id',null,
    'mapping_rate_policy_fingerprint',encode(v_mapping,'hex'),'invoice_timesheet_id',h.invoice_timesheet_id);
  if private.weekly_source_billing_movement_hash_v1(v_state) is distinct from m.movement_economic_hash then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_EXPENSE_HASH_UNBOUND' using errcode='55000';end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_MATCH_FIXED_EXPENSE_ORIGIN_V1',
    'movement_id',m.id,'snapshot_line_id',s.id,'upload_row_id',s.upload_row_id,'work_event_id',s.work_event_id,
    'row_resolution_id',s.row_resolution_id,'row_expense_policy_snapshot_id',p.id,'paid_overlap_choice_id',s.paid_overlap_choice_id,
    'hours_companion_movement_id',h.id,'pay_effect','NONE','paid_writer_permission',null);
end;
$function$;

create or replace function private.weekly_source_paid_match_expense_invoice_insert_v1(p_snapshot_line_id uuid,p_final_revision_id uuid)
returns uuid language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare s public.weekly_source_final_snapshot_lines%rowtype;
  p public.weekly_source_row_expense_policy_snapshots%rowtype;
  h public.weekly_source_billing_movements%rowtype;r public.weekly_source_final_revisions%rowtype;
  v_hours uuid;v_id uuid;v_values jsonb;v_pay jsonb;v_facts jsonb;v_state jsonb;v_mapping bytea;v_hash bytea;
begin
  -- The real HOURS companion proves the common immutable raw Source row,
  -- actual choice/census/audit, original calculation and native lineage.
  v_hours:=private.weekly_source_paid_match_invoice_movement_insert_v1(p_snapshot_line_id,p_final_revision_id);
  if v_hours is null then return null;end if;
  perform private.weekly_source_paid_match_invoice_origin_assert_v1(v_hours);
  select * into strict h from public.weekly_source_billing_movements where id=v_hours;
  select * into strict s from public.weekly_source_final_snapshot_lines where id=p_snapshot_line_id;
  select * into strict r from public.weekly_source_final_revisions where id=p_final_revision_id;
  select * into p from public.weekly_source_row_expense_policy_snapshots where row_resolution_id=s.row_resolution_id;
  if not found then return null;end if;
  if p.source_expense_pence is null or p.source_expense_pence<0
    or p.row_resolution_id is distinct from s.row_resolution_id or p.upload_row_id is distinct from s.upload_row_id
    or p.work_event_id is distinct from s.work_event_id or p.contract_id is distinct from s.contract_id
    or p.candidate_id is distinct from s.candidate_id or p.client_id is distinct from s.client_id
    or p.source_expense_pence is distinct from s.source_expense_pence
    or private.weekly_source_finalisation_expense_policy_assert_v1(s.row_resolution_id,r.source_cycle_id) is distinct from p.id then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_EXPENSE_POLICY_UNBOUND' using errcode='55000';end if;
  if p.source_expense_pence=0 then return null;end if;
  select id into v_id from public.weekly_source_billing_movements
    where invoice_only_snapshot_line_id=s.id and source_line_kind='SOURCE_FIXED_EXPENSE';
  if found then perform private.weekly_source_paid_match_expense_invoice_origin_assert_v1(v_id);return v_id;end if;
  v_values:=private.weekly_source_fixed_expense_invoice_values_v1(p.id);
  v_pay:=v_values->'pay_vector'||jsonb_build_object('source_expense_pence',0);
  v_mapping:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_PAID_MATCH_EXPENSE_MAPPING_V1',
    jsonb_build_object('snapshot_line_id',s.id,'snapshot_line_hash',encode(s.snapshot_line_hash,'hex'),
      'row_expense_policy_snapshot_id',p.id,'invoice_vat_policy_fingerprint',encode(p.invoice_vat_policy_fingerprint,'hex'),
      'hours_companion_movement_id',h.id,'paid_overlap_choice_id',s.paid_overlap_choice_id));
  v_facts:=jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_MATCH_FIXED_EXPENSE_FACTS_V1',
    'snapshot_line_id',s.id,'snapshot_line_hash',encode(s.snapshot_line_hash,'hex'),'upload_row_id',s.upload_row_id,
    'bound_row_resolution_id',s.row_resolution_id,'paid_overlap_choice_id',s.paid_overlap_choice_id,'pay_effect','NONE',
    'hours_companion_movement_id',h.id,'row_expense_policy_snapshot_id',p.id,'invoice_values',v_values,
    'rule_set_version_id',r.rule_set_version_id,'invoice_window_cycle_id',h.source_facts_json->'invoice_window_cycle_id',
    'invoice_window_scope',h.source_facts_json->'invoice_window_scope');
  v_state:=jsonb_build_object('invoice_only_snapshot_line_id',s.id,'pay_effect','NONE','final_revision_id',r.id,
    'finalisation_cycle_id',r.source_cycle_id,'actual_client_id',s.client_id,'candidate_id',s.candidate_id,
    'contract_id',s.contract_id,'work_event_id',s.work_event_id,'movement_role','EXPENSE_POSITIVE',
    'source_profile_kind',s.source_profile_kind,'source_line_kind','SOURCE_FIXED_EXPENSE','source_facts',v_facts,
    'pay_vector',v_pay,'charge_vector',v_values->'charge_vector','total_pay_pence',0,
    'calculated_comparison_charge_pence',p.source_expense_pence,'source_validation_charge_pence',p.source_expense_pence,
    'invoice_presentation_charge_pence',p.source_expense_pence,'vat_rate_pct',(v_values->>'vat_rate_pct')::numeric(5,2),
    'vat_amount',(v_values->>'vat_amount')::numeric(12,2),'total_inc_vat',(v_values->>'total_inc_vat')::numeric(12,2),
    'price_check_result','NOT_APPLICABLE','price_check_fingerprint',null,'charge_acceptance_id',null,
    'mapping_rate_policy_fingerprint',encode(v_mapping,'hex'),'invoice_timesheet_id',h.invoice_timesheet_id);
  v_hash:=private.weekly_source_billing_movement_hash_v1(v_state);
  insert into public.weekly_source_billing_movements(invoice_only_snapshot_line_id,pay_effect,final_revision_id,finalisation_cycle_id,
    actual_client_id,candidate_id,contract_id,work_event_id,movement_role,source_profile_kind,source_line_kind,
    source_facts_json,canonical_pay_vector_json,canonical_charge_vector_json,total_pay_ex_vat,
    calculated_comparison_charge_pence,source_validation_charge_pence,invoice_presentation_charge_pence,
    vat_rate_pct,vat_amount,total_inc_vat,price_check_result,mapping_rate_policy_fingerprint,
    invoice_timesheet_id,original_cycle_key,movement_economic_hash)
  values(s.id,'NONE',r.id,r.source_cycle_id,s.client_id,s.candidate_id,s.contract_id,s.work_event_id,'EXPENSE_POSITIVE',
    s.source_profile_kind,'SOURCE_FIXED_EXPENSE',v_facts,v_pay,v_values->'charge_vector',0,
    p.source_expense_pence,p.source_expense_pence,p.source_expense_pence,
    (v_values->>'vat_rate_pct')::numeric(5,2),(v_values->>'vat_amount')::numeric(12,2),(v_values->>'total_inc_vat')::numeric(12,2),
    'NOT_APPLICABLE',v_mapping,h.invoice_timesheet_id,r.source_cycle_id::text,v_hash) returning id into v_id;
  perform private.weekly_source_paid_match_expense_invoice_origin_assert_v1(v_id);
  return v_id;
end;
$function$;

create or replace function private.weekly_source_paid_match_prepared_census_recheck_v1(p_final_revision_id uuid,p_actor_user_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare revision public.weekly_source_final_revisions%rowtype;session public.weekly_final_source_correction_sessions%rowtype;
  publication public.weekly_source_projection_publications%rowtype;v_row record;v_choice jsonb;v_census jsonb:='{}'::jsonb;
begin
  select * into strict revision from public.weekly_source_final_revisions where id=p_final_revision_id;
  if p_actor_user_id is null or revision.state is distinct from 'PREPARED' or revision.reason is distinct from 'CORRECT_FINAL_SOURCE'
    or revision.finalised_by_user_id is distinct from p_actor_user_id or revision.authority_scope_kind not in ('CYCLE','NHSP_REPORT_SCOPE')
    or (revision.authority_scope_kind='NHSP_REPORT_SCOPE') is distinct from (revision.report_scope_id is not null) then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_PREPARED_ACTOR_REQUIRED' using errcode='42501';end if;
  select * into strict session from public.weekly_final_source_correction_sessions
    where prepared_final_revision_id=revision.id and source_cycle_id=revision.source_cycle_id
      and replacement_correction_upload_id=revision.upload_id and actor_user_id=p_actor_user_id
      and authority_scope_kind=revision.authority_scope_kind and report_scope_id is not distinct from revision.report_scope_id
      and state in ('PREPARING','PREPARED','COMMITTING');
  select * into strict publication from public.weekly_source_projection_publications
    where id=session.replacement_projection_publication_id and upload_id=revision.upload_id
      and source_cycle_id=revision.source_cycle_id and correction_session_id=session.id
      and authority_scope_kind=revision.authority_scope_kind and report_scope_id is not distinct from revision.report_scope_id
      and state='CORRECTION_READY';
  if revision.authority_scope_kind='NHSP_REPORT_SCOPE' then
    perform private.weekly_source_paid_match_correction_scope_v1(revision.upload_id,p_actor_user_id,false);
  end if;
  for v_row in select raw.id,resolution.work_event_id,resolution.candidate_id,resolution.client_id,resolution.contract_id,
      resolution.paid_overlap_choice_id,resolution.pay_effect
    from public.weekly_source_upload_rows raw join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=raw.id
      and resolution.generation=coalesce(publication.projection_generation,publication.authority_scope_version)
    where raw.upload_id=revision.upload_id order by raw.source_row_ordinal,raw.id
  loop
    v_choice:=private.weekly_source_paid_overlap_choice_current_v1(v_row.id,p_actor_user_id);
    if v_choice is null then
      if v_row.pay_effect<>'NORMAL' or v_row.paid_overlap_choice_id is not null then
        raise exception 'WEEKLY_SOURCE_PAID_MATCH_PREPARED_RESOLUTION_UNBOUND' using errcode='40001';end if;
      continue;
    end if;
    if v_choice->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1'
      or v_choice->>'viewer_actor_user_id' is distinct from p_actor_user_id::text
      or v_choice->>'upload_row_id' is distinct from v_row.id::text
      or v_choice->>'candidate_id' is distinct from v_row.candidate_id::text
      or v_choice->>'client_id' is distinct from v_row.client_id::text
      or v_choice->>'contract_id' is distinct from v_row.contract_id::text
      or v_choice->>'choice_id' is distinct from v_row.paid_overlap_choice_id::text
      or v_choice->>'pay_effect' is distinct from v_row.pay_effect
      or (v_row.pay_effect='NONE' and v_choice->>'paid_overlap_target_work_event_id' is distinct from v_row.work_event_id::text)
      or v_choice->>'choice_proof_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1',v_choice-'choice_proof_sha256'),'hex') then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_PREPARED_RESOLUTION_UNBOUND' using errcode='40001';end if;
    v_census:=v_census||jsonb_build_object(v_row.id::text,v_choice);
  end loop;
  if v_census is distinct from revision.paid_overlap_choice_census then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_PREPARED_CENSUS_CHANGED' using errcode='40001';end if;
  return v_census;
end;
$function$;

create or replace function private.weekly_source_ordinary_projection_current_expenses_v1(
  p_root_timesheet_id uuid,
  p_through_final_revision_id uuid
) returns jsonb
language sql stable security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
  with target as (
    select revision.finalised_at_utc,revision.revision_number,
           source_cycle.finalisation_week_ending,revision.id,revision.state,
           revision.predecessor_revision_id
    from public.weekly_source_final_revisions revision
    join public.weekly_source_cycles source_cycle
      on source_cycle.id=revision.source_cycle_id
    where revision.id=p_through_final_revision_id
  ), root_events as (
    select distinct movement.work_event_id,movement.contract_id
    from public.weekly_source_billing_movements movement
    where movement.invoice_timesheet_id=p_root_timesheet_id
      and movement.source_profile_kind<>'SELF_BILL_REPORT'
      and movement.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION')
      and movement.pay_effect='NORMAL'
  ), ranked as (
    select expense.*,source_cycle.finalisation_week_ending,
      revision.finalised_at_utc,revision.revision_number,
      pg_catalog.row_number() over (
        partition by expense.work_event_id
        order by source_cycle.finalisation_week_ending desc,
                 revision.finalised_at_utc desc,revision.revision_number desc,
                 expense.generation desc,expense.id desc
      ) as event_rank
    from public.weekly_expense_authority_generations expense
    join root_events root_event
      on root_event.work_event_id=expense.work_event_id
     and root_event.contract_id=expense.contract_id
    join public.weekly_source_final_revisions revision
      on revision.id=expense.final_revision_id
    join public.weekly_source_cycles source_cycle
      on source_cycle.id=revision.source_cycle_id
    cross join target
    where (revision.state='CURRENT' or revision.id=target.id)
      and (
        target.state<>'PREPARED'
        or revision.id is distinct from target.predecessor_revision_id
      )
      and (source_cycle.finalisation_week_ending<target.finalisation_week_ending
       or (
         source_cycle.finalisation_week_ending=target.finalisation_week_ending
         and revision.finalised_at_utc<target.finalised_at_utc
       )
       or (
         source_cycle.finalisation_week_ending=target.finalisation_week_ending
         and revision.finalised_at_utc=target.finalised_at_utc
         and revision.revision_number<target.revision_number
       )
       or (
         source_cycle.finalisation_week_ending=target.finalisation_week_ending
         and revision.finalised_at_utc=target.finalised_at_utc
         and revision.revision_number=target.revision_number
         and revision.id::text<=target.id::text
       )
      )
  )
  select coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
    'expense_authority_generation_id',ranked.id,
    'final_revision_id',ranked.final_revision_id,
    'work_event_id',ranked.work_event_id,
    'contract_id',ranked.contract_id,
    'row_expense_policy_snapshot_id',ranked.row_expense_policy_snapshot_id,
    'prior_expense_authority_generation_id',ranked.prior_expense_authority_generation_id,
    'generation',ranked.generation,
    'source_observation_kind',ranked.source_observation_kind,
    'correction_presentation',ranked.correction_presentation,
    'source_expense_pence',ranked.source_expense_pence::text,
    'source_expense_vat_enabled',ranked.source_expense_vat_enabled,
    'candidate_reimbursement_ex_vat',ranked.candidate_reimbursement_ex_vat::text,
    'client_charge_ex_vat',ranked.client_charge_ex_vat::text,
    'authority_hash',pg_catalog.encode(ranked.authority_hash,'hex')
  ) order by ranked.work_event_id),'[]'::jsonb)
  from ranked
  -- Keep a zero authority in the ranking so it remains the newest immutable
  -- observation and the superseded positive authority cannot reappear.  A
  -- zero tombstone is not, however, a payable source expense and must not
  -- produce Timesheet expense description or evidence.
  where ranked.event_rank=1
    and ranked.source_expense_pence>0;
$function$;

create or replace function public.weekly_source_office_workspace_v1(
  p_request jsonb
) returns jsonb
language plpgsql
stable
security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_allowed_keys constant text[]:=array[
    'actor_user_id','tab','source_group_id','source_cycle_id','client_id',
    'report_scope_id','projection_publication_id','cursor','limit','sort_key',
    'sort_direction','status','candidate','issue','cycle_filter','row_key'
  ]::text[];
  v_unknown text;
  v_query_row_key text;
  v_d10_target boolean:=false;
  v_d10_groups jsonb;
  v_d10_rows jsonb:='[]'::jsonb;
  v_d10_keys jsonb:='[]'::jsonb;
  v_d10_revisions jsonb:='[]'::jsonb;
  v_d10_scope record;
  v_d10_row jsonb;
  v_query_population jsonb;
  v_actor uuid;
  v_pay_view boolean;
  v_pay_row jsonb;
  v_pay_rows jsonb;
  v_pay_child jsonb;
  v_pay_children jsonb;
  v_cursor_view_version text;
  v_result jsonb;
  v_tab text;
  v_group_id uuid;
  v_cycle_id uuid;
  v_client_id uuid;
  v_report_scope_id uuid;
  v_publication_id uuid;
  v_cursor text;
  v_limit integer;
  v_offset integer:=0;
  v_sort_key text;
  v_sort_direction text;
  v_cycle_filter text;
  v_filters jsonb;
  v_group public.weekly_source_groups%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_profile public.weekly_source_format_profiles%rowtype;
  v_guard jsonb;
  v_workspace_version text;
  v_recheck_action jsonb:='{}'::jsonb;
  v_imports jsonb;
  v_queries jsonb;
  v_ready jsonb;
  v_blocked jsonb;
  v_complete jsonb;
  v_history jsonb;
  v_tracker jsonb;
  v_controls jsonb;
  v_query_count integer:=0;
  v_ask_eligible_count integer:=0;
  v_manager_eligible_count integer:=0;
  v_blocker_count integer:=0;
  v_paid_unresolved_count integer:=0;
  v_total integer:=0;
  v_rows jsonb:='[]'::jsonb;
  v_next_cursor text:='';
  v_cycle_label text;
  v_cycle_state_label text;
  v_cycle_state_tone text;
  v_finalise_payload jsonb:='{}'::jsonb;
  v_finalise_pay_follow_up jsonb;
  v_finalise_enabled boolean:=false;
  v_bulk_actions jsonb:='{}'::jsonb;
  v_all_group_keys jsonb:='[]'::jsonb;
  v_ask_selection_proof text;
  v_manager_selection_proof text;
  v_rate_warnings jsonb:='{}'::jsonb;
  v_rate_warning_rows jsonb:='[]'::jsonb;
  v_rate_warning_keys jsonb:='[]'::jsonb;
  v_rate_warning_selection_proof text;
  v_rate_warning_count integer:=0;
  v_rate_warning_accepted_count integer:=0;
  v_rate_warning_unaccepted_count integer:=0;
  v_rate_warning_zero_count integer:=0;
  v_rate_warning_disparity_count integer:=0;
  v_authority_mode text:='SOURCE_AUTHORITY';
  v_document_mode text:='CHECK_ONLY';
  v_import_journey jsonb:='{}'::jsonb;
  v_import_attention_rows jsonb:='[]'::jsonb;
  v_import_waiting_rows jsonb:='[]'::jsonb;
  v_import_ready_rows jsonb:='[]'::jsonb;
  v_mode_a_import_id uuid;
  v_context_client_name text;
  v_context_cutoff timestamptz;
  v_nhsp_report_number text;
  v_import_prepared boolean:=false;
  v_office_checks jsonb:='{}'::jsonb;
  v_prepare_action jsonb;
  v_unfinalised_count integer:=0;
  v_excluded_rows jsonb:='[]'::jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_request is null or pg_catalog.jsonb_typeof(p_request)<>'object' then
    raise exception 'WEEKLY_SOURCE_WORKSPACE_REQUEST_INVALID' using errcode='22023';
  end if;
  select key into v_unknown from pg_catalog.jsonb_object_keys(p_request) key
  where not (key=any(v_allowed_keys)) order by key limit 1;
  if v_unknown is not null then
    raise exception 'WEEKLY_SOURCE_WORKSPACE_REQUEST_UNKNOWN_FIELD'
      using errcode='22023',detail=v_unknown;
  end if;
  if pg_catalog.jsonb_typeof(p_request->'actor_user_id')<>'string'
     or exists(
       select 1 from pg_catalog.jsonb_each(p_request) item
       where item.key in ('tab','source_group_id','source_cycle_id','client_id',
         'report_scope_id','projection_publication_id','cursor','sort_key',
         'sort_direction','status','candidate','issue','cycle_filter')
         and pg_catalog.jsonb_typeof(item.value) not in ('string','null')
     )
     or (p_request ? 'limit' and pg_catalog.jsonb_typeof(p_request->'limit') not in ('number','null')) then
    raise exception 'WEEKLY_SOURCE_WORKSPACE_REQUEST_INVALID' using errcode='22023';
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_pay_view:=not exists(select 1 from public.tms_users actor where actor.id=v_actor
      and lower(btrim(coalesce(actor.role,'')))='admin');
    v_tab:=pg_catalog.lower(coalesce(nullif(pg_catalog.btrim(p_request->>'tab'),''),case when v_pay_view then 'queries' else 'imports' end));
    v_group_id:=nullif(p_request->>'source_group_id','')::uuid;
    v_cycle_id:=nullif(p_request->>'source_cycle_id','')::uuid;
    v_client_id:=nullif(p_request->>'client_id','')::uuid;
    v_report_scope_id:=nullif(p_request->>'report_scope_id','')::uuid;
    v_publication_id:=nullif(p_request->>'projection_publication_id','')::uuid;
    v_limit:=coalesce(nullif(p_request->>'limit','')::integer,50);
  exception when others then
    raise exception 'WEEKLY_SOURCE_WORKSPACE_REQUEST_INVALID' using errcode='22023';
  end;
  v_query_row_key:=p_request->>'row_key';
  v_d10_target:=coalesce(v_query_row_key~'^d10g_[0-9a-f]{64}$',false);
  if p_request ? 'row_key' and (jsonb_typeof(p_request->'row_key') is distinct from 'string'
    or v_query_row_key!~'^(qg|d10g)_[0-9a-f]{64}$'
    or v_tab<>'queries' or v_group_id is null or v_cycle_id is null or v_client_id is null
    or nullif(p_request->>'cursor','') is not null or v_report_scope_id is not null
    or v_publication_id is not null) then
    raise exception 'WEEKLY_SOURCE_WORKSPACE_REQUEST_INVALID' using errcode='22023';
  end if;
  if v_actor is null or v_tab not in ('imports','queries','finalise','history')
     or v_limit not between 1 and 100 then
    raise exception 'WEEKLY_SOURCE_WORKSPACE_REQUEST_INVALID' using errcode='22023';
  end if;
  v_sort_direction:=pg_catalog.lower(coalesce(nullif(pg_catalog.btrim(p_request->>'sort_direction'),''),
    case when v_tab='history' then 'desc' else 'asc' end));
  if v_sort_direction not in ('asc','desc') then
    raise exception 'WEEKLY_SOURCE_WORKSPACE_SORT_INVALID' using errcode='22023';
  end if;
  v_sort_key:=coalesce(nullif(pg_catalog.lower(pg_catalog.btrim(p_request->>'sort_key')),''),
    case v_tab when 'imports' then 'uploaded' when 'history' then 'when' else 'candidate' end);
  if (v_tab='imports' and v_sort_key not in ('file','uploaded','rows','coverage','report','cutoff','status','final_source'))
     or (v_tab='queries' and v_sort_key not in ('candidate','client','issues','candidate_asked','manager_informed','status','age'))
     or (v_tab='finalise' and v_sort_key not in (
       'candidate','day_date','client','system_hours','actual_hours','movement',
       'commission','total_cost','invoice_charge','status','problem','job_role',
       'contract','outcome'
     ))
     or (v_tab='history' and v_sort_key not in ('when','source','event','by','detail')) then
    raise exception 'WEEKLY_SOURCE_WORKSPACE_SORT_INVALID' using errcode='22023';
  end if;
  v_cycle_filter:=pg_catalog.upper(coalesce(nullif(pg_catalog.btrim(p_request->>'cycle_filter'),''),'CURRENT_PAY_CYCLE'));
  if v_cycle_filter not in ('CURRENT_PAY_CYCLE','LAST_4_PAY_CYCLES','LAST_13_PAY_CYCLES') then
    raise exception 'WEEKLY_SOURCE_WORKSPACE_HISTORY_FILTER_INVALID' using errcode='22023';
  end if;
  v_filters:=pg_catalog.jsonb_strip_nulls(pg_catalog.jsonb_build_object(
    'status',nullif(p_request->>'status',''),
    'candidate',nullif(p_request->>'candidate',''),
    'issue',nullif(p_request->>'issue','')
  ));

  if v_group_id is null and v_cycle_id is not null then
    select source_group_id into v_group_id from public.weekly_source_cycles where id=v_cycle_id;
  end if;
  if v_group_id is null then
    select source_group.id into v_group_id
    from public.weekly_source_groups source_group
    where source_group.active
    order by source_group.updated_at_utc desc,source_group.id limit 1;
  end if;
  select * into v_group from public.weekly_source_groups where id=v_group_id and active;
  if not found then raise exception 'WEEKLY_SOURCE_GROUP_NOT_ACTIVE' using errcode='22023'; end if;
  if v_cycle_id is null then
    select cycle.id into v_cycle_id from public.weekly_source_cycles cycle
    where cycle.source_group_id=v_group.id
      and (cycle.scope_client_id is null or cycle.scope_client_id=v_client_id)
    order by cycle.finalisation_week_ending desc,cycle.id desc limit 1;
  end if;
  select * into v_cycle from public.weekly_source_cycles
  where id=v_cycle_id and source_group_id=v_group.id;
  if not found then raise exception 'WEEKLY_SOURCE_CYCLE_NOT_FOUND' using errcode='22023'; end if;

  if v_cycle.scope_client_id is not null then
    if v_client_id is not null and v_client_id<>v_cycle.scope_client_id then
      raise exception 'WEEKLY_SOURCE_CLIENT_CYCLE_SCOPE_MISMATCH' using errcode='22023';
    end if;
    v_client_id:=v_cycle.scope_client_id;
  end if;

  perform private.weekly_source_office_authority_v1(
    v_actor,case when v_pay_view then 'VIEW_PAY_WORK' else 'VIEW_SOURCE_PROGRESS' end,
    v_group.id,v_client_id,v_cycle.finalisation_week_ending
  );
  if v_pay_view and v_tab<>'queries' then
    raise exception 'WEEKLY_SOURCE_OFFICE_ADMIN_REQUIRED' using errcode='42501';
  end if;
  if v_report_scope_id is not null then
    select scope.client_id into strict v_client_id
    from public.weekly_source_report_scopes scope
    where scope.id=v_report_scope_id and scope.source_cycle_id=v_cycle.id
      and (v_client_id is null or scope.client_id=v_client_id);
  end if;
  if v_client_id is not null and not exists(
    select 1 from public.weekly_source_group_clients membership
    where membership.source_group_id=v_group.id and membership.client_id=v_client_id
      and v_cycle.finalisation_week_ending between membership.valid_from
        and coalesce(membership.valid_to,'infinity'::date)
  ) then
    raise exception 'WEEKLY_SOURCE_CLIENT_NOT_IN_GROUP' using errcode='22023';
  end if;

  -- Report finalise remains a separate exact invoice scope, after native
  -- actor, group, cycle, client and reduced-pay-view admission.
  if v_tab='finalise' and exists(select 1 from public.weekly_source_report_scopes rs
    where rs.id=v_report_scope_id and rs.self_bill_report_id is not null) then
    return private.weekly_source_self_bill_report_workspace_v1(p_request);
  end if;

  if v_client_id is not null then
    select policy.authority_mode,policy.document_mode
    into v_authority_mode,v_document_mode
    from public.weekly_source_client_policies policy
    where policy.source_group_id=v_group.id and policy.client_id=v_client_id
      and v_cycle.finalisation_week_ending between policy.effective_from
        and coalesce(policy.effective_to,'infinity'::date)
    order by policy.effective_from desc,policy.id desc limit 1;
    if not found then
      v_authority_mode:='SOURCE_AUTHORITY';
      v_document_mode:='CHECK_ONLY';
    end if;
  end if;

  -- Queries are a cycle-wide pre-finalisation journey. An NHSP report scope
  -- can retain an older final backing publication while a newer complete
  -- previously-released upload is current for the cycle. Never let the
  -- selected Trust's report scope hide that current candidate work.
  if v_tab='queries' and v_cycle.current_projection_publication_id is not null then
    if v_publication_id is not null
       and v_publication_id is distinct from v_cycle.current_projection_publication_id then
      raise exception 'WEEKLY_SOURCE_WORKSPACE_PUBLICATION_STALE' using errcode='40001';
    end if;
    v_publication_id:=v_cycle.current_projection_publication_id;
  else
    if v_publication_id is null and v_report_scope_id is not null then
      select current_projection_publication_id into v_publication_id
      from public.weekly_source_report_scopes where id=v_report_scope_id;
    end if;
    if v_publication_id is null and v_client_id is not null and v_group.source_family='NHSP' then
      select scope.current_projection_publication_id,scope.id
      into v_publication_id,v_report_scope_id
      from public.weekly_source_report_scopes scope
      where scope.source_cycle_id=v_cycle.id and scope.client_id=v_client_id
      order by scope.cutoff_at_utc desc,scope.id desc limit 1;
    end if;
  end if;
  if v_publication_id is null then
    v_publication_id:=v_cycle.current_projection_publication_id;
  end if;
  if v_publication_id is not null then
    v_guard:=private.weekly_source_query_current_publication_v1(v_cycle.id,v_publication_id);
    select * into strict v_publication from public.weekly_source_projection_publications
    where id=v_publication_id;
    select * into strict v_upload from public.weekly_source_uploads where id=v_publication.upload_id;
    select profile.* into strict v_profile
    from public.weekly_source_format_profiles profile where profile.id=v_upload.source_format_profile_id;
    v_workspace_version:=private.weekly_source_office_workspace_version_v1(v_cycle.id,v_publication.id);
  else
    v_workspace_version:=pg_catalog.encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_OFFICE_WORKSPACE_VERSION_V1',pg_catalog.jsonb_build_object(
        'source_cycle_id',v_cycle.id,'cycle_version',v_cycle.version,
        'cycle_state',v_cycle.state,'projection_state',v_cycle.projection_state,
        'completions',coalesce((select pg_catalog.jsonb_agg(pg_catalog.encode(completion.completion_hash,'hex')
          order by completion.client_id) from public.weekly_source_client_cycle_completions completion
          where completion.source_cycle_id=v_cycle.id and completion.state='CURRENT'),'[]'::jsonb)
      )),'hex');
  end if;

  v_cursor_view_version:=case when v_pay_view then encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_PAYMENT_CURSOR_V1',jsonb_build_object('actor',v_actor,'view','PAY','source',v_workspace_version)),
    'hex') else v_workspace_version end;
  -- One shared native parent census. It is read before filters/count/page and
  -- is independent of Source publication. Source bulk proofs keep their own
  -- original population and workspace version; no d10g_ key enters them.
  if v_tab='queries' and v_group.source_family='ROSTER' then
    for v_d10_scope in
      select distinct membership.client_id,t.week_ending_date
      from public.weekly_source_group_clients membership
      cross join public.timesheets t
      where membership.source_group_id=v_group.id
        and t.week_ending_date between v_cycle.finalisation_week_ending-6 and v_cycle.finalisation_week_ending
        and t.week_ending_date between membership.valid_from
          and coalesce(membership.valid_to,'infinity'::date)
        and (v_client_id is null or membership.client_id=v_client_id)
        and (v_cycle.scope_client_id is null or membership.client_id=v_cycle.scope_client_id)
        and (v_cycle.scope_client_id is not null or not exists(
          select 1 from public.weekly_source_cycles preferred
          where preferred.source_group_id=v_group.id and preferred.scope_client_id=membership.client_id
            and preferred.finalisation_week_ending=v_cycle.finalisation_week_ending))
      order by membership.client_id,t.week_ending_date
    loop
      -- The date is an actual native Timesheet week, not the group's calendar
      -- label. The shared owner alone decides signed/agency eligibility.
      v_d10_groups:=private.weekly_source_check_only_query_groups_v1(v_cycle.id,v_d10_scope.client_id,
        jsonb_build_object('actor_user_id',v_actor,'source_group_id',v_group.id,
          'week_ending',v_d10_scope.week_ending_date));
      if v_d10_groups->>'contract' is distinct from 'WEEKLY_SOURCE_CHECK_ONLY_QUERY_GROUPS_V1'
        or v_d10_groups->>'actor_user_id' is distinct from v_actor::text
        or v_d10_groups->>'permission_view' is distinct from case when v_pay_view then 'PAY_READONLY' else 'ADMIN' end
        or v_d10_groups#>>'{scope,source_group_id}' is distinct from v_group.id::text
        or v_d10_groups#>>'{scope,source_cycle_id}' is distinct from v_cycle.id::text
        or v_d10_groups#>>'{scope,client_id}' is distinct from v_d10_scope.client_id::text
        or v_d10_groups#>>'{scope,week_ending}' is distinct from v_d10_scope.week_ending_date::text
        or jsonb_typeof(v_d10_groups->'groups') is distinct from 'array'
        or v_d10_groups->'source_outreach_eligible' is distinct from 'false'::jsonb
        or v_d10_groups->'bulk_actions' is distinct from '{}'::jsonb
        or coalesce(v_d10_groups->>'read_revision','')!~'^[0-9a-f]{64}$'
        or coalesce(v_d10_groups->>'source_read_revision','')!~'^[0-9a-f]{64}$'
        or (v_pay_view and v_d10_groups->'groups'<>'[]'::jsonb) then
        raise exception 'WEEKLY_SOURCE_CHECK_ONLY_NATIVE_GROUP_READ_UNAVAILABLE' using errcode='55000';
      end if;
      v_d10_revisions:=v_d10_revisions||jsonb_build_array(jsonb_build_object(
        'client_id',v_d10_scope.client_id,'week_ending',v_d10_scope.week_ending_date,
        'read_revision',v_d10_groups->>'read_revision',
        'source_read_revision',v_d10_groups->>'source_read_revision'));
      for v_d10_row in select value from jsonb_array_elements(v_d10_groups->'groups') loop
        if v_d10_row->>'origin' is distinct from 'CHECK_ONLY_D10'
          or v_d10_row->>'client_id' is distinct from v_d10_scope.client_id::text
          or coalesce(v_d10_row->>'group_key','')!~'^d10g_[0-9a-f]{64}$'
          or v_d10_row->>'row_key' is distinct from v_d10_row->>'group_key'
          or v_d10_row->'source_outreach_eligible' is distinct from 'false'::jsonb
          or v_d10_row->'outreach_eligible' is distinct from 'false'::jsonb
          or v_d10_row->'manager_eligible' is distinct from 'false'::jsonb
          or v_d10_row->'bulk_actions' is distinct from '{}'::jsonb then
          raise exception 'WEEKLY_SOURCE_CHECK_ONLY_NATIVE_GROUP_READ_UNAVAILABLE' using errcode='55000';
        end if;
        -- Native5804 owns the real subject keys, including an empty array for
        -- unknown/reference-only facts. Never classify its display wording.
        if jsonb_typeof(v_d10_row->'issue_filter_keys') is distinct from 'array'
          or jsonb_array_length(v_d10_row->'issue_filter_keys')>3
          or exists(select 1 from jsonb_array_elements(v_d10_row->'issue_filter_keys') k
            where jsonb_typeof(k)<>'string' or k#>>'{}' not in ('TIMESHEET_MISSING','HOURS_DIFFER','MISSING_SHIFT'))
          or (select count(*)<>count(distinct k) from jsonb_array_elements(v_d10_row->'issue_filter_keys') k) then
          raise exception 'WEEKLY_SOURCE_CHECK_ONLY_NATIVE_FILTER_AUTHORITY_UNAVAILABLE' using errcode='55000';
        end if;
        v_d10_keys:=v_d10_keys||jsonb_build_array(v_d10_row->>'group_key');
        if (v_query_row_key is null or v_d10_row->>'group_key'=v_query_row_key)
          and coalesce(v_filters->>'status','UNRESOLVED') in ('UNRESOLVED','ALL')
          and (nullif(btrim(coalesce(v_filters->>'candidate','')),'') is null
            or private.weekly_source_query_ascii_fold_v1(v_d10_row->>'candidate')
              like '%'||private.weekly_source_query_ascii_fold_v1(v_filters->>'candidate')||'%')
          and (coalesce(v_filters->>'issue','ALL')='ALL'
            or v_d10_row->'issue_filter_keys' ? (v_filters->>'issue')) then
          v_d10_rows:=v_d10_rows||jsonb_build_array(v_d10_row);
        end if;
      end loop;
    end loop;
    if exists(select 1 from jsonb_array_elements(v_d10_keys) g group by g having count(*)<>1) then
      raise exception 'WEEKLY_SOURCE_CHECK_ONLY_NATIVE_GROUP_PARENT_AMBIGUOUS' using errcode='55000';
    end if;
  end if;
  if v_tab='queries' then
    v_cursor_view_version:=encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_QUERIES_POPULATION_CURSOR_V1',jsonb_build_object(
        'actor_user_id',v_actor,'permission_view',case when v_pay_view then 'PAY_READONLY' else 'ADMIN' end,
        'source_group_id',v_group.id,'source_cycle_id',v_cycle.id,'client_id',v_client_id,
        'source_workspace_version',v_workspace_version,'d10_read_revisions',v_d10_revisions,
        'filters',v_filters,'sort_key',v_sort_key,'sort_direction',v_sort_direction)),'hex');
  end if;
  v_cursor:=coalesce(nullif(p_request->>'cursor',''),'');
  if v_cursor<>'' then
    if split_part(v_cursor,':',1)<>v_cursor_view_version
       or v_cursor!~'^[0-9a-f]{64}:[0-9]{1,10}$'
       or split_part(v_cursor,':',2)::numeric>2147483547 then
      raise exception 'WEEKLY_SOURCE_WORKSPACE_CURSOR_STALE' using errcode='40001';
    end if;
    v_offset:=split_part(v_cursor,':',2)::integer;
  end if;

  if v_publication_id is not null and not v_d10_target then
    select pg_catalog.count(*)::integer,
      pg_catalog.count(*) filter (where query.outreach_eligible)::integer,
      pg_catalog.count(*) filter (where query.manager_eligible)::integer,
      coalesce(pg_catalog.jsonb_agg(query.group_key order by query.group_key),'[]'::jsonb)
    into v_query_count,v_ask_eligible_count,v_manager_eligible_count,v_all_group_keys
    from private.weekly_source_office_query_groups_v1(v_cycle.id,v_publication.id,v_filters) query
    where (v_query_row_key is null or (query.group_key=v_query_row_key and query.client_id=v_client_id))
      and (not v_pay_view or exists(select 1 from jsonb_array_elements(query.children) child
      where child ? 'manual_review_id' or jsonb_typeof(child->'protected_pay_seed')='object'
        or coalesce((child->>'accept_eligible')::boolean,false)));
    if v_query_row_key is not null and v_query_count<>1 then
      raise exception 'WEEKLY_SOURCE_CHECKLIST_QUERY_TARGET_STALE' using errcode='40001';
    end if;
    v_ask_selection_proof:=pg_catalog.encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_BULK_FILTER_SELECTION_V1',pg_catalog.jsonb_build_object(
        'action','ASK_CANDIDATES','source_cycle_id',v_cycle.id,
        'projection_publication_id',v_publication.id,
        'workspace_version',v_workspace_version,'filters',v_filters,
        'group_keys',v_all_group_keys
      )),'hex');
    v_manager_selection_proof:=pg_catalog.encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_BULK_FILTER_SELECTION_V1',pg_catalog.jsonb_build_object(
        'action','SEND_MANAGER_NOW','source_cycle_id',v_cycle.id,
        'projection_publication_id',v_publication.id,
        'workspace_version',v_workspace_version,'filters',v_filters,
        'group_keys',v_all_group_keys
      )),'hex');
    v_bulk_actions:=pg_catalog.jsonb_build_object(
      'contract','WEEKLY_SOURCE_BULK_FILTER_SELECTION_V1',
      'filtered_group_count',v_query_count,'selection_complete',true,
      'ask_candidates',pg_catalog.jsonb_build_object(
        'action','ASK_CANDIDATES','enabled',v_ask_eligible_count>0,
        'eligible_group_count',v_ask_eligible_count,
        'selection_proof',v_ask_selection_proof,
        'request',pg_catalog.jsonb_build_object(
          'actor_user_id',v_actor,'source_cycle_id',v_cycle.id,
          'projection_publication_id',v_publication.id,
          'expected_workspace_version',v_workspace_version,'action','ASK_CANDIDATES',
          'selection',pg_catalog.jsonb_build_object(
            'mode','ALL_FILTERED','group_keys','[]'::jsonb,
            'excluded_group_keys','[]'::jsonb,'incident_ids','[]'::jsonb,
            'filters',v_filters,'sort_key',v_sort_key,
            'sort_direction',v_sort_direction,'selection_proof',v_ask_selection_proof
          )
        )
      ),
      'send_manager_now',pg_catalog.jsonb_build_object(
        'action','SEND_MANAGER_NOW','enabled',v_manager_eligible_count>0,
        'eligible_group_count',v_manager_eligible_count,
        'selection_proof',v_manager_selection_proof,
        'request',pg_catalog.jsonb_build_object(
          'actor_user_id',v_actor,'source_cycle_id',v_cycle.id,
          'projection_publication_id',v_publication.id,
          'expected_workspace_version',v_workspace_version,'action','SEND_MANAGER_NOW',
          'selection',pg_catalog.jsonb_build_object(
            'mode','ALL_FILTERED','group_keys','[]'::jsonb,
            'excluded_group_keys','[]'::jsonb,'incident_ids','[]'::jsonb,
            'filters',v_filters,'sort_key',v_sort_key,
            'sort_direction',v_sort_direction,'selection_proof',v_manager_selection_proof
          )
        )
      )
    );
  end if;
  select pg_catalog.count(distinct family.id)::integer into v_paid_unresolved_count
  from public.weekly_exceptional_pay_target_families family
  join public.weekly_exceptional_payment_approvals approval on approval.pay_target_family_id=family.id
  where approval.source_cycle_id=v_cycle.id
    and family.current_lifecycle_state in ('PROTECTED','WAITING_SOURCE','READY_TO_RECONCILE','ACTION_REQUIRED');

  select pg_catalog.count(*)::integer into v_blocker_count
  from public.weekly_source_upload_rows source_row
  left join lateral (
    select resolution.* from public.weekly_source_row_resolutions resolution
    where resolution.upload_row_id=source_row.id
    order by resolution.generation desc,resolution.id desc limit 1
  ) resolution on true
  left join lateral (
    select charge.* from public.weekly_source_charge_checks charge
    where charge.upload_row_id=source_row.id
    order by charge.generation desc,charge.id desc limit 1
  ) charge on true
  left join public.weekly_source_charge_acceptances charge_acceptance
    on charge_acceptance.charge_check_id=charge.id
  where v_publication_id is not null and source_row.upload_id=v_upload.id
    and (resolution.mapping_state is distinct from 'RESOLVED'
      or source_row.row_finalisation_state in ('BLOCK_FINALISATION_DISAGREEMENT','BLOCK_ACTUAL_TUPLE')
      or charge.phase_severity='FINALISATION_BLOCKER'
      or (charge.phase_severity='PROVISIONAL_WARNING' and charge_acceptance.id is null));

  -- PHD-014..019 / PRC-043..050.  The final NHSP source value remains
  -- authoritative, but a known disparity or structurally valid zero charge is
  -- shown as one concise, server-owned warning decision.  The Trust-wide zero
  -- pattern has one notice, with a decision for each shift. No source money
  -- from this projection is ever an input to Candidate pay.
  if v_publication_id is not null
     and v_profile.profile_code in ('NHSP_PREFINAL_RELEASED_V1','NHSP_FINAL_BACKING_V1') then
    select pg_catalog.count(*)::integer,
      pg_catalog.count(acceptance.id)::integer,
      pg_catalog.count(*) filter (where acceptance.id is null)::integer,
      pg_catalog.count(*) filter (where charge.comparison_result='ZERO_SOURCE_CHARGE')::integer,
      pg_catalog.count(*) filter (where charge.comparison_result='MISMATCH')::integer
    into v_rate_warning_count,v_rate_warning_accepted_count,
      v_rate_warning_unaccepted_count,v_rate_warning_zero_count,
      v_rate_warning_disparity_count
    from public.weekly_source_charge_checks charge
    join public.weekly_source_upload_rows source_row on source_row.id=charge.upload_row_id
    left join public.weekly_source_charge_acceptances acceptance
      on acceptance.charge_check_id=charge.id
    where source_row.upload_id=v_upload.id
      and charge.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version)
      and charge.comparison_result in ('MISMATCH','ZERO_SOURCE_CHARGE')
      and charge.phase_severity='PROVISIONAL_WARNING'
      and charge.blocker_code is null;

    if v_rate_warning_count>0 then
      select coalesce(pg_catalog.jsonb_agg(warning.row_json order by warning.work_date,warning.candidate_name,warning.warning_key),'[]'::jsonb)
      into v_rate_warning_rows
      from (
        select source_row.work_date,
          coalesce(candidate.display_name,candidate.tms_ref,source_row.source_candidate_identity,'Candidate') candidate_name,
          'charge-check:'||charge.id::text warning_key,
          pg_catalog.jsonb_build_object(
            'warning_key','charge-check:'||charge.id::text,
            'source_row_id',source_row.id,
            'candidate',coalesce(candidate.display_name,candidate.tms_ref,source_row.source_candidate_identity,'Candidate'),
            'day_date',to_char(source_row.work_date,'Dy FMDD Mon YYYY'),
            'source_charge',case when charge.source_shift_charge_pence<0 then '-£' else '£' end
              ||to_char(pg_catalog.abs(charge.source_shift_charge_pence)::numeric/100,'FM9999999990.00'),
            'commission',case when charge.source_commission_pence<0 then '-£' else '£' end
              ||to_char(pg_catalog.abs(charge.source_commission_pence)::numeric/100,'FM9999999990.00'),
            'total_cost',case when charge.source_total_cost_pence<0 then '-£' else '£' end
              ||to_char(pg_catalog.abs(charge.source_total_cost_pence)::numeric/100,'FM9999999990.00'),
            'calculated_charge',case when charge.calculated_segment_charge_pence<0 then '-£' else '£' end
              ||to_char(pg_catalog.abs(charge.calculated_segment_charge_pence)::numeric/100,'FM9999999990.00'),
            'difference',case when charge.source_charge_difference_pence<0 then '-£' else '£' end
              ||to_char(pg_catalog.abs(charge.source_charge_difference_pence)::numeric/100,'FM9999999990.00'),
            'contract',pg_catalog.concat_ws(' · ',contract.role,contract.band,contract.display_site),
            'warning',case when charge.comparison_result='ZERO_SOURCE_CHARGE'
              then 'Possible NHSP rate card issue' else 'Rate card expired or wrong Contract rate' end,
            'warning_tone','warning',
            'action_label',case when acceptance.id is null then 'Review charge' else 'Accepted' end,
            'accept_eligible',v_profile.profile_code='NHSP_FINAL_BACKING_V1'
              and resolution.mapping_state='RESOLVED' and resolution.contract_id is not null
              and acceptance.id is null,
            'detail_rows','[]'::jsonb
          ) row_json
        from public.weekly_source_charge_checks charge
        join public.weekly_source_upload_rows source_row on source_row.id=charge.upload_row_id
        left join public.weekly_source_row_resolutions resolution on resolution.id=charge.row_resolution_id
        left join public.candidates candidate on candidate.id=resolution.candidate_id
        left join public.contracts contract on contract.id=resolution.contract_id
        left join public.weekly_source_charge_acceptances acceptance on acceptance.charge_check_id=charge.id
        where source_row.upload_id=v_upload.id
          and charge.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version)
          and charge.comparison_result in ('MISMATCH','ZERO_SOURCE_CHARGE')
          and charge.phase_severity='PROVISIONAL_WARNING'
          and charge.blocker_code is null
      ) warning;

      if v_profile.profile_code='NHSP_FINAL_BACKING_V1' and v_rate_warning_unaccepted_count>0 then
        select coalesce(pg_catalog.jsonb_agg(key_value order by key_value),'[]'::jsonb)
        into v_rate_warning_keys
        from (
          select 'charge-check:'||charge.id::text key_value
          from public.weekly_source_charge_checks charge
          join public.weekly_source_upload_rows source_row on source_row.id=charge.upload_row_id
          left join public.weekly_source_charge_acceptances acceptance on acceptance.charge_check_id=charge.id
          where source_row.upload_id=v_upload.id
            and charge.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version)
            and charge.comparison_result in ('MISMATCH','ZERO_SOURCE_CHARGE')
            and charge.phase_severity='PROVISIONAL_WARNING'
            and charge.blocker_code is null and acceptance.id is null
        ) eligible;
        v_rate_warning_selection_proof:=pg_catalog.encode(private.weekly_source_sha256_jsonb_v1(
          'NHSP_RATE_WARNING_SELECTION_V1',pg_catalog.jsonb_build_object(
            'source_cycle_id',v_cycle.id,'projection_publication_id',v_publication.id,
            'projection_generation',coalesce(v_publication.projection_generation,v_publication.authority_scope_version),
            'workspace_version',v_workspace_version,
            'eligible_warning_keys',v_rate_warning_keys
          )),'hex');
      end if;

      v_rate_warnings:=pg_catalog.jsonb_build_object(
        'contract','NHSP_RATE_WARNING_WORKSPACE_V1',
        'phase',case when v_profile.profile_code='NHSP_PREFINAL_RELEASED_V1' then 'PREFINAL'
          when v_rate_warning_unaccepted_count>0 then 'FINAL_AWAITING_ACCEPTANCE' else 'READY' end,
        'rows',v_rate_warning_rows,'total_count',v_rate_warning_count,
        'accepted_count',v_rate_warning_accepted_count,
        'ready_count',v_rate_warning_accepted_count,'hard_blocker_count',0,
        'notice',case when v_rate_warning_zero_count>1 then pg_catalog.jsonb_build_object(
          'title','Possible Trust rate card issue',
          'body',v_rate_warning_zero_count::text||' shifts have a £0 source charge. Check the Trust rate card in NHSP'
            ||case when v_profile.profile_code='NHSP_FINAL_BACKING_V1' then ' before accepting.' else '.' end
            ||case when v_rate_warning_disparity_count=1 then ' One other shift has a different source charge.'
              when v_rate_warning_disparity_count>1 then ' '||v_rate_warning_disparity_count::text||' other shifts have different source charges.' else '' end,
          'tone','warning') else null end,
        'acceptance',case when v_profile.profile_code='NHSP_FINAL_BACKING_V1'
            and v_rate_warning_unaccepted_count>0 then pg_catalog.jsonb_build_object(
          'enabled',true,'action','ACCEPT_NHSP_SOURCE_CHARGES',
          'payload',pg_catalog.jsonb_build_object(
            'source_cycle_id',v_cycle.id,'projection_publication_id',v_publication.id),
          'selection',pg_catalog.jsonb_build_object(
            'key','warning_keys','proof_key','selection_proof','proof',v_rate_warning_selection_proof)
        ) else null end
      );
    end if;
  end if;

  if v_tab='imports' then
    select pg_catalog.count(*)::integer into v_total
    from public.weekly_source_uploads upload where upload.source_cycle_id=v_cycle.id;
    select coalesce(pg_catalog.jsonb_agg(page.row_json order by page.position),'[]'::jsonb)
    into v_rows
    from (
      select pg_catalog.jsonb_build_object(
        'row_key',upload.id,'file',upload.original_filename,
        'client_id',coalesce(scope.client_id,v_cycle.scope_client_id),
        'uploaded_at',upload.uploaded_at_utc,'state',upload.state,
        'prepared',private.weekly_source_import_is_prepared_v1(upload.id),
        'purpose_label',case when exists(select 1 from public.weekly_source_format_profiles file_profile
          where file_profile.id=upload.source_format_profile_id and file_profile.profile_code='NHSP_FINAL_BACKING_V1')
          or upload.file_metadata_json->>'import_use'='PREPARE_FINALISATION'
          then 'Finalisation report' else 'Checking hours' end,
        'uploaded',to_char(upload.uploaded_at_utc at time zone 'Europe/London','DD Mon YYYY HH24:MI'),
        'rows',upload.accepted_count,
        'coverage',case when upload.confirmed_coverage_start_local_date is null then 'Not confirmed'
          else to_char(upload.confirmed_coverage_start_local_date,'DD Mon YYYY')||' to '
            ||to_char(upload.confirmed_coverage_end_local_date,'DD Mon YYYY') end,
        'report',case when v_group.source_family='NHSP' then coalesce(
          nullif(pg_catalog.btrim(upload.file_metadata_json->>'nhsp_report_number'),''),'Not confirmed') else null end,
        'cutoff',case when v_group.source_family='NHSP' then coalesce(
          to_char(scope.cutoff_at_utc at time zone 'Europe/London','FMDD Mon YYYY · HH24:MI'),'Not confirmed') else null end,
        'status',pg_catalog.jsonb_build_object('text',case upload.state
          when 'CURRENT' then 'Current' when 'SUPERSEDED' then 'Superseded'
          when 'SEALED' then 'Ready' else initcap(pg_catalog.replace(upload.state,'_',' ')) end,
          'tone',case when upload.state='CURRENT' then 'positive'
            when upload.state in ('REJECTED') then 'danger' else 'neutral' end),
        'final_source',case when exists(select 1 from public.weekly_source_final_revisions revision
          where revision.upload_id=upload.id and revision.state='CURRENT') then 'Finalised' else pg_catalog.chr(8212) end,
        'actions',pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
          'label','View','enabled',true,'payload',pg_catalog.jsonb_build_object('upload_id',upload.id)
        ))
      ) row_json,
      pg_catalog.row_number() over(order by
        case when v_sort_key='file' and v_sort_direction='asc' then upload.original_filename end asc,
        case when v_sort_key='file' and v_sort_direction='desc' then upload.original_filename end desc,
        case when v_sort_key='rows' and v_sort_direction='asc' then upload.accepted_count end asc,
        case when v_sort_key='rows' and v_sort_direction='desc' then upload.accepted_count end desc,
        case when v_sort_key='report' and v_sort_direction='asc' then upload.file_metadata_json->>'nhsp_report_number' end asc nulls last,
        case when v_sort_key='report' and v_sort_direction='desc' then upload.file_metadata_json->>'nhsp_report_number' end desc nulls last,
        case when v_sort_key='cutoff' and v_sort_direction='asc' then scope.cutoff_at_utc end asc nulls last,
        case when v_sort_key='cutoff' and v_sort_direction='desc' then scope.cutoff_at_utc end desc nulls last,
        case when v_sort_direction='asc' then upload.uploaded_at_utc end asc,
        case when v_sort_direction='desc' then upload.uploaded_at_utc end desc,
        upload.id
      ) position
      from public.weekly_source_uploads upload
      left join public.weekly_source_report_scopes scope on scope.id=upload.report_scope_id
      where upload.source_cycle_id=v_cycle.id
      order by
        case when v_sort_key='file' and v_sort_direction='asc' then upload.original_filename end asc,
        case when v_sort_key='file' and v_sort_direction='desc' then upload.original_filename end desc,
        case when v_sort_key='rows' and v_sort_direction='asc' then upload.accepted_count end asc,
        case when v_sort_key='rows' and v_sort_direction='desc' then upload.accepted_count end desc,
        case when v_sort_key='report' and v_sort_direction='asc' then upload.file_metadata_json->>'nhsp_report_number' end asc nulls last,
        case when v_sort_key='report' and v_sort_direction='desc' then upload.file_metadata_json->>'nhsp_report_number' end desc nulls last,
        case when v_sort_key='cutoff' and v_sort_direction='asc' then scope.cutoff_at_utc end asc nulls last,
        case when v_sort_key='cutoff' and v_sort_direction='desc' then scope.cutoff_at_utc end desc nulls last,
        case when v_sort_direction='asc' then upload.uploaded_at_utc end asc,
        case when v_sort_direction='desc' then upload.uploaded_at_utc end desc,
        upload.id
      offset v_offset limit v_limit
    ) page;
    v_next_cursor:=case when v_offset+v_limit<v_total
      then v_cursor_view_version||':'||(v_offset+v_limit)::text else '' end;
    v_imports:=pg_catalog.jsonb_build_object('rows',v_rows,'total_count',v_total,
      'next_cursor',v_next_cursor,'has_more',v_next_cursor<>'','record_version',v_workspace_version,'stale',false);
  else
    v_imports:=pg_catalog.jsonb_build_object('rows','[]'::jsonb,'total_count',
      (select pg_catalog.count(*) from public.weekly_source_uploads upload where upload.source_cycle_id=v_cycle.id),
      'next_cursor','','has_more',false,'record_version',v_workspace_version,'stale',false);
  end if;

  if v_authority_mode='TIMESHEET_AUTHORITY' and v_publication_id is not null then
    -- The established import-review owns the manager correction email.  Give
    -- Office its exact per-client review rather than reopening the upload hub.
    select mode_a_import.id into v_mode_a_import_id
    from public.hr_imports mode_a_import
    where mode_a_import.coverage_operation_key=
      private.weekly_source_mode_a_operation_key_v1(v_publication_id,v_client_id);

    -- Resolved source work may arrive before the candidate and manager have
    -- completed their Timesheet. Keep that work visible without treating it
    -- as a comparison, an Office authorisation, or source finalisation.
    select coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
      'row_key','authority-waiting-'||waiting.contract_id::text,
      'candidate',waiting.candidate_name,
      'day_date','Week ending '||to_char(v_cycle.finalisation_week_ending,'FMDD Mon YYYY'),
      'attention','Timesheet not yet completed',
      'reference','Not added',
      'timesheet_id',waiting.timesheet_id,
      'status',pg_catalog.jsonb_build_object('text','Waiting for completed Timesheet','tone','neutral'),
      'actions',case when waiting.timesheet_id is null then '[]'::jsonb
        else pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
          'label','View Timesheet','enabled',true,
          'payload',pg_catalog.jsonb_build_object('timesheet_id',waiting.timesheet_id))) end
    ) order by private.weekly_source_query_ascii_fold_v1(waiting.candidate_name) collate "C",
      waiting.contract_id),'[]'::jsonb) into v_import_waiting_rows
    from (
      select distinct on (resolution.contract_id) resolution.contract_id,
        coalesce(candidate.display_name,candidate.tms_ref,'Candidate') candidate_name,
        current_timesheet.timesheet_id
      from public.weekly_source_row_resolutions resolution
      join public.weekly_source_upload_rows source_row on source_row.id=resolution.upload_row_id
        and source_row.upload_id=v_upload.id
      join public.candidates candidate on candidate.id=resolution.candidate_id
      left join lateral (
        select timesheet_row.timesheet_id
        from public.timesheets timesheet_row
        where timesheet_row.contract_id=resolution.contract_id
          and timesheet_row.week_ending_date=v_cycle.finalisation_week_ending
          and timesheet_row.is_current
          and timesheet_row.revoked_at is null
        order by timesheet_row.version desc,timesheet_row.timesheet_id limit 1
      ) current_timesheet on true
      left join lateral (
        select workflow.id,workflow.state,workflow.candidate_signed_at_utc,
          workflow.manager_approved_at_utc,workflow.candidate_signature_component_id,
          workflow.manager_signature_component_id
        from public.candidate_submission_workflows workflow
        where workflow.contract_id=resolution.contract_id
          and workflow.week_ending_date=v_cycle.finalisation_week_ending
          and workflow.scope='WEEKLY'
          and workflow.workflow_kind in ('CONTRACT_HOURS','CONTRACT_COMBINED')
        order by workflow.updated_at_utc desc,workflow.id desc limit 1
      ) current_workflow on true
      where resolution.generation=coalesce(
          v_publication.projection_generation,v_publication.authority_scope_version::integer)
        and resolution.client_id=v_client_id
        and resolution.mapping_state='RESOLVED'
        and resolution.work_event_id is not null
        and exists(select 1 from public.weekly_timesheet_authority_resolutions authority
          where authority.source_cycle_id=v_cycle.id
            and authority.contract_id=resolution.contract_id
            and authority.work_date=source_row.work_date)
        and (current_timesheet.timesheet_id is null
          or (current_workflow.id is not null and not (
            current_workflow.state='FINALISED'
            and current_workflow.candidate_signed_at_utc is not null
            and current_workflow.manager_approved_at_utc is not null
            and current_workflow.candidate_signature_component_id is not null
            and current_workflow.manager_signature_component_id is not null)))
      order by resolution.contract_id,source_row.work_date,resolution.id
    ) waiting;
    select coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
      'row_key','authority-'||comparison.id::text,
      'candidate',coalesce(candidate.display_name,candidate.tms_ref,'Candidate'),
      'day_date',to_char(comparison.work_date,'Dy FMDD Mon YYYY'),
      'attention',case comparison.comparison_state
        when 'HOURS_MISMATCH' then 'Hours are different'
        when 'SOURCE_SHIFT_MISSING' then 'Shift is missing or not yet authorised'
        when 'REFERENCE_MISSING' then 'Reference is missing'
        when 'AMBIGUOUS_SOURCE_ROW' then 'More than one source shift matches'
        else 'Check this Timesheet' end,
      'reference',case when nullif(pg_catalog.btrim(comparison.source_reference_number),'') is null
        then 'Not added' else comparison.source_reference_number end,
      'status',pg_catalog.jsonb_build_object(
        'text',case when comparison.comparison_state='REFERENCE_MISSING'
          then 'Reference needed' else 'Manager correction needed' end,
        'tone','warning'),
      'actions',pg_catalog.jsonb_build_array(
        pg_catalog.jsonb_build_object('label','View Timesheet','enabled',true,
          'payload',pg_catalog.jsonb_build_object('timesheet_id',comparison.timesheet_id)),
        pg_catalog.jsonb_build_object('label','Email manager','enabled',v_mode_a_import_id is not null,
          'payload',pg_catalog.jsonb_build_object('timesheet_id',comparison.timesheet_id,
            'comparison_id',comparison.id,'import_id',v_mode_a_import_id)))
    ) order by private.weekly_source_query_ascii_fold_v1(coalesce(candidate.display_name,candidate.tms_ref,'')) collate "C",
      comparison.work_date,comparison.id),'[]'::jsonb)
    into v_import_attention_rows
    from public.weekly_timesheet_source_comparisons comparison
    join public.timesheets timesheet_row on timesheet_row.timesheet_id=comparison.timesheet_id
      and timesheet_row.is_current
    join public.contracts contract on contract.id=timesheet_row.contract_id
    left join public.candidates candidate on candidate.id=contract.candidate_id
    where comparison.projection_publication_id=v_publication_id
      and comparison.comparison_state<>'EXACT_MATCH'
      and not exists(select 1 from pg_catalog.jsonb_array_elements(v_import_waiting_rows) waiting
        where waiting->>'timesheet_id'=comparison.timesheet_id::text);

    -- Ready is a Timesheet-authority handoff, never a source-finalisation
    -- queue.  The established reference owner must already have applied the
    -- complete matching Timesheet, and an Office-authorised head no longer
    -- needs this action list.
    select coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
      'row_key','authority-ready-'||ready.timesheet_id::text,
      'candidate',ready.candidate_name,
      'day_date',to_char(ready.work_date,'Dy FMDD Mon YYYY'),
      'attention','Source reference added',
      'reference',ready.source_reference_number,
      'status',pg_catalog.jsonb_build_object('text','Ready for Office authorisation','tone','positive'),
      'actions',pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
        'label','View Timesheet','enabled',true,
        'payload',pg_catalog.jsonb_build_object('timesheet_id',ready.timesheet_id)))
    ) order by private.weekly_source_query_ascii_fold_v1(
        ready.candidate_name) collate "C",ready.work_date,ready.timesheet_id),'[]'::jsonb)
      into v_import_ready_rows
    from (
      select timesheet_row.timesheet_id,
        coalesce(candidate.display_name,candidate.tms_ref,'Candidate') as candidate_name,
        pg_catalog.min(comparison.work_date) as work_date,
        pg_catalog.min(comparison.source_reference_number) as source_reference_number
      from public.weekly_timesheet_source_comparisons comparison
      join public.timesheets timesheet_row on timesheet_row.timesheet_id=comparison.timesheet_id
        and timesheet_row.is_current and timesheet_row.authorised_at_server is null
      join public.contracts contract on contract.id=timesheet_row.contract_id
      left join public.candidates candidate on candidate.id=contract.candidate_id
      where comparison.projection_publication_id=v_publication_id
        and comparison.comparison_state='EXACT_MATCH'
        and not exists(select 1 from pg_catalog.jsonb_array_elements(v_import_waiting_rows) waiting
          where waiting->>'timesheet_id'=comparison.timesheet_id::text)
        and not exists (
          select 1 from public.weekly_timesheet_source_comparisons other
          where other.projection_publication_id=v_publication_id
            and other.timesheet_id=comparison.timesheet_id
            and other.comparison_state<>'EXACT_MATCH'
        )
        and exists (
          select 1 from public.weekly_timesheet_reference_apply_operations operation
          where operation.projection_publication_id=v_publication_id
            and operation.timesheet_id=comparison.timesheet_id
            and operation.state='APPLIED'
        )
      group by timesheet_row.timesheet_id,candidate.display_name,candidate.tms_ref
    ) ready;
  end if;

  v_import_journey:=pg_catalog.jsonb_build_object(
    'authority_mode',v_authority_mode,
    'document_mode',v_document_mode,
    'title',case when v_authority_mode='TIMESHEET_AUTHORITY'
      then 'Signed Timesheet decides hours' else 'Client system decides hours' end,
    'body',case when v_authority_mode='TIMESHEET_AUTHORITY'
      then 'Timesheet hours are used. The client system is checked so matching references can be added.'
      else 'Client system hours are used after the source is finalised.' end,
    'import_id',v_mode_a_import_id,
    'waiting_rows',v_import_waiting_rows,
    'waiting_count',pg_catalog.jsonb_array_length(v_import_waiting_rows),
    'attention_rows',v_import_attention_rows,
    'attention_count',pg_catalog.jsonb_array_length(v_import_attention_rows),
    'ready_rows',v_import_ready_rows,
    'ready_count',pg_catalog.jsonb_array_length(v_import_ready_rows)
  );
  v_imports:=v_imports||pg_catalog.jsonb_build_object('journey',v_import_journey);

  if v_tab='queries' and v_publication_id is not null and not v_d10_target then
    v_total:=v_query_count;
    select coalesce(pg_catalog.jsonb_agg(page.row_json order by page.position),'[]'::jsonb)
    into v_rows
    from (
      select pg_catalog.jsonb_build_object(
        'row_key',query.group_key,'group_key',query.group_key,
        'client_id',query.client_id,'candidate_id',query.candidate_id,
        'candidate_sort',coalesce((select nullif(person.last_name,'') from public.candidates person
          where person.id=query.candidate_id),query.candidate_name),
        '_query_first_seen_at_utc',query.first_seen_at_utc,
        'candidate',query.candidate_name,'client',query.client_name,'issues',query.issue_count,
        'candidate_asked',query.candidate_asked,'manager_informed',query.manager_informed,
        'status',pg_catalog.jsonb_build_object('text',query.status_text,'tone',query.status_tone),
        'age',case when query.first_seen_at_utc is null then pg_catalog.chr(8212)
          when pg_catalog.transaction_timestamp()-query.first_seen_at_utc<interval '1 hour' then 'Less than 1 hour'
          when pg_catalog.transaction_timestamp()-query.first_seen_at_utc<interval '24 hours'
            then floor(extract(epoch from (pg_catalog.transaction_timestamp()-query.first_seen_at_utc))/3600)::integer||' hours'
          else floor(extract(epoch from (pg_catalog.transaction_timestamp()-query.first_seen_at_utc))/86400)::integer||' days' end,
        'outreach_eligible',query.outreach_eligible,
        'manager_eligible',query.manager_eligible,
        'candidate_app_available',query.candidate_app_available,
        'contact_policy',private.weekly_source_office_contact_policy_v1(v_cycle.id,
          to_jsonb(query)||jsonb_build_object('projection_publication_id',v_publication.id)),
        'children',coalesce((
          select pg_catalog.jsonb_agg(
            (child.value-'actions')||pg_catalog.jsonb_build_object(
              'actions',pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
                'label','View details','enabled',true,
                'payload',pg_catalog.jsonb_build_object('detail',pg_catalog.jsonb_build_object(
                  'candidate',query.candidate_name,'client',query.client_name,
                  'status',child.value#>>'{status,text}',
                  'age',case when query.first_seen_at_utc is null then pg_catalog.chr(8212)
                    when pg_catalog.transaction_timestamp()-query.first_seen_at_utc<interval '1 hour' then 'Less than 1 hour'
                    when pg_catalog.transaction_timestamp()-query.first_seen_at_utc<interval '24 hours'
                      then floor(extract(epoch from (pg_catalog.transaction_timestamp()-query.first_seen_at_utc))/3600)::integer||' hours'
                    else floor(extract(epoch from (pg_catalog.transaction_timestamp()-query.first_seen_at_utc))/86400)::integer||' days' end,
                  'shifts',pg_catalog.jsonb_build_array(child.value-'actions')
                ))
              ))||case when pg_catalog.jsonb_typeof(child.value->'protected_pay_seed')='object'
                and private.weekly_source_pay_actor_allowed_v1(v_actor)
                then pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
                  'label','Protect pay','enabled',true,'payload',child.value->'protected_pay_seed'))
                else '[]'::jsonb end
              ||case when child.value ? 'manual_review_id' then
                pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
                  'label','Accept current source hours','kind','COMMAND',
                  'command','RESOLVE_MANUAL_REVIEW',
                  'payload',pg_catalog.jsonb_build_object(
                    'review_id',child.value->>'manual_review_id',
                    'resolution_kind','OFFICE_ACCEPTED_SOURCE',
                    'expected_current_row_hash',child.value->>'current_source_row_hash'),
                  'enabled',child.value->>'current_source_row_hash' is not null,
                  'context',pg_catalog.jsonb_build_object(
                    'candidate',query.candidate_name,'client',query.client_name,
                    'status',child.value->>'day_date',
                    'system_hours',child.value->>'system_hours')))
                else '[]'::jsonb end
            ) order by child.ordinality
          )
          from pg_catalog.jsonb_array_elements(query.children) with ordinality child(value,ordinality)
        ),'[]'::jsonb),
        'actions',pg_catalog.jsonb_build_array(
          pg_catalog.jsonb_build_object(
            'label','Open','enabled',true,
            'payload',pg_catalog.jsonb_build_object(
              'group_key',query.group_key,
              'detail',pg_catalog.jsonb_build_object(
                'candidate',query.candidate_name,'client',query.client_name,
                'status',query.status_text,
                'age',case when query.first_seen_at_utc is null then pg_catalog.chr(8212)
                  when pg_catalog.transaction_timestamp()-query.first_seen_at_utc<interval '1 hour' then 'Less than 1 hour'
                  when pg_catalog.transaction_timestamp()-query.first_seen_at_utc<interval '24 hours'
                    then floor(extract(epoch from (pg_catalog.transaction_timestamp()-query.first_seen_at_utc))/3600)::integer||' hours'
                  else floor(extract(epoch from (pg_catalog.transaction_timestamp()-query.first_seen_at_utc))/86400)::integer||' days' end,
                'shifts',query.children
              )
            )
          ),
          pg_catalog.jsonb_strip_nulls(pg_catalog.jsonb_build_object(
            'label','Remind candidate','kind','COMMAND','command','REMIND_CANDIDATE',
            'enabled',candidate_reminder.candidate_generation_id is not null
              and (candidate_reminder.manual_reminder_available_at_utc is null
                or pg_catalog.transaction_timestamp()>=candidate_reminder.manual_reminder_available_at_utc),
            'reason',case
              when candidate_reminder.candidate_generation_id is null then 'Ask the candidate before sending a reminder.'
              when candidate_reminder.manual_reminder_available_at_utc is not null
               and pg_catalog.transaction_timestamp()<candidate_reminder.manual_reminder_available_at_utc
                then 'A reminder can be sent after '
                  ||to_char(candidate_reminder.manual_reminder_available_at_utc at time zone 'Europe/London','Dy FMDD Mon YYYY HH24:MI')||'.'
              else null end,
            'available_at_utc',candidate_reminder.manual_reminder_available_at_utc,
            'context',pg_catalog.jsonb_build_object(
              'candidate',query.candidate_name,'client',query.client_name,'status',query.status_text
            ),
            'payload',case when candidate_reminder.candidate_generation_id is not null
              and (candidate_reminder.manual_reminder_available_at_utc is null
                or pg_catalog.transaction_timestamp()>=candidate_reminder.manual_reminder_available_at_utc)
              then pg_catalog.jsonb_build_object(
                'candidate_generation_id',candidate_reminder.candidate_generation_id,
                'projection_publication_id',v_publication.id
              ) else '{}'::jsonb end
          ))
        )||case when submission_reminder.generation_id is not null then pg_catalog.jsonb_build_array(
          pg_catalog.jsonb_build_object('label','Remind missing timesheet','kind','COMMAND','command','REMIND_CANDIDATE',
            'enabled',pg_catalog.transaction_timestamp()>=submission_reminder.available_at,
            'reason','Reminder for missing week(s): '||submission_reminder.weeks,
            'context',pg_catalog.jsonb_build_object('candidate',query.candidate_name,
              'client',query.client_name,'weeks',submission_reminder.weeks),
            'payload',pg_catalog.jsonb_build_object('candidate_generation_id',submission_reminder.generation_id,
              'projection_publication_id',v_publication.id))) else '[]'::jsonb end,
        'accept_system_hours_action',pg_catalog.jsonb_build_object(
          'label','Accept system hours','kind','COMMAND','command','ACCEPT_SYSTEM_HOURS',
          'enabled',coalesce(pg_catalog.array_length(query.accept_incident_ids,1),0)>0,
          'context',pg_catalog.jsonb_build_object(
            'candidate',query.candidate_name,'client',query.client_name,
            'issue',query.issue_summary
          ),
          'payload',pg_catalog.jsonb_build_object(
            'actor_user_id',v_actor,'source_cycle_id',v_cycle.id,
            'projection_publication_id',v_publication.id,
            'expected_workspace_version',v_workspace_version,'action','ACCEPT_SYSTEM_HOURS',
            'selection',pg_catalog.jsonb_build_object(
              'mode','EXPLICIT','group_keys',pg_catalog.jsonb_build_array(query.group_key),
              'excluded_group_keys','[]'::jsonb,
              'incident_ids',to_jsonb(query.accept_incident_ids),
              'filters',v_filters,'sort_key',v_sort_key,'sort_direction',v_sort_direction,
              'selection_proof',null,
              'group_selection_proofs',pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
                'group_key',query.group_key,
                'selection_proof',pg_catalog.encode(private.weekly_source_sha256_jsonb_v1(
                  'WEEKLY_SOURCE_ACCEPT_GROUP_SELECTION_V1',pg_catalog.jsonb_build_object(
                    'workspace_version',v_workspace_version,'group_key',query.group_key,
                    'incident_ids',to_jsonb(query.accept_incident_ids)
                  )),'hex')
              ))
            )
          )
        )
      ) row_json,
      pg_catalog.row_number() over(order by
        case when v_sort_key='candidate' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(query.candidate_name) end asc,
        case when v_sort_key='candidate' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(query.candidate_name) end desc,
        case when v_sort_key='client' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(query.client_name) end asc,
        case when v_sort_key='client' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(query.client_name) end desc,
        case when v_sort_key='issues' and v_sort_direction='asc' then query.issue_count end asc,
        case when v_sort_key='issues' and v_sort_direction='desc' then query.issue_count end desc,
        case when v_sort_key='age' and v_sort_direction='asc' then query.first_seen_at_utc end asc,
        case when v_sort_key='age' and v_sort_direction='desc' then query.first_seen_at_utc end desc,
        query.group_key
      ) position
      from private.weekly_source_office_query_groups_v1(v_cycle.id,v_publication.id,v_filters) query
      left join lateral (
        select generation.id candidate_generation_id,
          generation.manual_reminder_available_at_utc
        from public.weekly_candidate_cohorts cohort
        join public.weekly_candidate_outreach_generations generation
          on generation.id=cohort.current_generation_id and generation.state='ACTIVE'
        where cohort.source_cycle_id=v_cycle.id
          and cohort.candidate_id=query.candidate_id
          and cohort.client_id=query.client_id
          and cohort.manager_recipient_route_key=query.manager_recipient_route_key
          and generation.request_kind='CHECK_HOURS'
          and exists(select 1 from public.weekly_candidate_outreach_memberships membership
            join public.weekly_discrepancy_incidents incident on incident.id=membership.incident_id
            where membership.candidate_generation_id=generation.id and membership.state='ACTIONABLE'
              and incident.state='OPEN' and incident.candidate_action_state='ASKED'
              and membership.comparison_revision_id=incident.current_comparison_revision_id
              and exists(select 1 from pg_catalog.jsonb_array_elements(query.children) child
                where child->>'incident_id'=incident.id::text))
        limit 1
      ) candidate_reminder on true
      left join lateral (
        select generation.id generation_id,generation.manual_reminder_available_at_utc available_at,
          pg_catalog.string_agg(distinct to_char(membership.week_ending,'FMDD Mon YYYY'),', ') weeks
        from public.weekly_candidate_cohorts cohort
        join public.weekly_candidate_outreach_generations generation
          on generation.id=cohort.current_submission_generation_id and generation.state='ACTIVE'
          and generation.request_kind='SUBMIT_TIMESHEET'
        join public.weekly_timesheet_submission_requests request
          on request.candidate_cohort_id=cohort.id and request.request_generation=generation.generation_number
          and request.state in ('ACTIVE','OVERDUE','PARTLY_SUBMITTED')
        join public.weekly_timesheet_submission_request_memberships membership
          on membership.submission_request_id=request.id and membership.state='WAITING'
        where cohort.source_cycle_id=v_cycle.id and cohort.candidate_id=query.candidate_id
          and exists(select 1 from pg_catalog.jsonb_array_elements(query.missing_scopes) scope
            where scope->>'client_id'=membership.client_id::text
              and scope->>'contract_id'=membership.contract_id::text
              and (scope->>'week_ending')::date=membership.week_ending)
        group by generation.id,generation.manual_reminder_available_at_utc
        limit 1
      ) submission_reminder on true
      where (v_query_row_key is null or (query.group_key=v_query_row_key and query.client_id=v_client_id))
        and (not v_pay_view or exists(select 1 from jsonb_array_elements(query.children) child
      where child ? 'manual_review_id' or jsonb_typeof(child->'protected_pay_seed')='object'
        or coalesce((child->>'accept_eligible')::boolean,false)))
      order by
        case when v_sort_key='candidate' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(query.candidate_name) end asc,
        case when v_sort_key='candidate' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(query.candidate_name) end desc,
        case when v_sort_key='client' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(query.client_name) end asc,
        case when v_sort_key='client' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(query.client_name) end desc,
        case when v_sort_key='issues' and v_sort_direction='asc' then query.issue_count end asc,
        case when v_sort_key='issues' and v_sort_direction='desc' then query.issue_count end desc,
        case when v_sort_key='age' and v_sort_direction='asc' then query.first_seen_at_utc end asc,
        case when v_sort_key='age' and v_sort_direction='desc' then query.first_seen_at_utc end desc,
        query.group_key
    ) page;
    v_next_cursor:=case when v_offset+v_limit<v_total
      then v_cursor_view_version||':'||(v_offset+v_limit)::text else '' end;
    v_queries:=pg_catalog.jsonb_build_object('rows',v_rows,'total_count',v_total,
      'next_cursor',v_next_cursor,'has_more',v_next_cursor<>'','record_version',v_workspace_version,'stale',false);
  else
    v_queries:=pg_catalog.jsonb_build_object('rows','[]'::jsonb,'total_count',v_query_count,
      'next_cursor','','has_more',false,'record_version',v_workspace_version,'stale',false);
  end if;
  if v_tab='queries' then
    -- The complete rendered Source population and native D10 census meet only
    -- here. Native Source row actions/proofs and D10 action bindings are retained.
    v_query_population:=coalesce(v_queries->'rows','[]'::jsonb)||v_d10_rows;
    if exists(select 1 from jsonb_array_elements(v_query_population) g
      group by g->>'group_key' having count(*)<>1) then
      raise exception 'WEEKLY_SOURCE_QUERY_PARENT_AMBIGUOUS' using errcode='55000';end if;
    v_total:=jsonb_array_length(v_query_population);
    if v_query_row_key is not null and v_total<>1 then
      raise exception 'WEEKLY_SOURCE_CHECKLIST_QUERY_TARGET_STALE' using errcode='40001';end if;
    select coalesce(jsonb_agg(page.row_json order by page.position),'[]'::jsonb) into v_rows
    from (
      select (g.value-array['_query_first_seen_at_utc','first_seen_at_utc','issue_filter_keys']) row_json,
        row_number() over(order by
          case when v_sort_key='candidate' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(g.value->>'candidate') end collate "C" asc,
          case when v_sort_key='candidate' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(g.value->>'candidate') end collate "C" desc,
          case when v_sort_key='client' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(g.value->>'client') end collate "C" asc,
          case when v_sort_key='client' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(g.value->>'client') end collate "C" desc,
          case when v_sort_key='issues' and v_sort_direction='asc' then (g.value->>'issues')::integer end asc,
          case when v_sort_key='issues' and v_sort_direction='desc' then (g.value->>'issues')::integer end desc,
          case when v_sort_key='candidate_asked' and v_sort_direction='asc' then (g.value->>'candidate_asked')::boolean end asc,
          case when v_sort_key='candidate_asked' and v_sort_direction='desc' then (g.value->>'candidate_asked')::boolean end desc,
          case when v_sort_key='manager_informed' and v_sort_direction='asc' then (g.value->>'manager_informed')::boolean end asc,
          case when v_sort_key='manager_informed' and v_sort_direction='desc' then (g.value->>'manager_informed')::boolean end desc,
          case when v_sort_key='status' and v_sort_direction='asc' then g.value#>>'{status,text}' end collate "C" asc,
          case when v_sort_key='status' and v_sort_direction='desc' then g.value#>>'{status,text}' end collate "C" desc,
          case when v_sort_key='age' and v_sort_direction='asc' then coalesce(g.value->>'_query_first_seen_at_utc',g.value->>'first_seen_at_utc')::timestamptz end asc,
          case when v_sort_key='age' and v_sort_direction='desc' then coalesce(g.value->>'_query_first_seen_at_utc',g.value->>'first_seen_at_utc')::timestamptz end desc,
          (g.value->>'group_key') collate "C") position
      from jsonb_array_elements(v_query_population) g(value)
    ) page where page.position>v_offset and page.position<=v_offset+v_limit;
    v_next_cursor:=case when v_offset+v_limit<v_total
      then v_cursor_view_version||':'||(v_offset+v_limit)::text else '' end;
    v_query_count:=v_total;
    v_queries:=jsonb_build_object('rows',v_rows,'total_count',v_total,'next_cursor',v_next_cursor,
      'has_more',v_next_cursor<>'','record_version',v_cursor_view_version,'stale',false);
    if v_query_row_key is not null then v_bulk_actions:='{}'::jsonb;end if;
  end if;
  v_queries:=v_queries||pg_catalog.jsonb_build_object('bulk_actions',v_bulk_actions);

  if v_publication_id is not null then
    select coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
      'row_key',source_row.id,'source_row_id',source_row.id,
      'candidate',coalesce(candidate.display_name,candidate.tms_ref,'Candidate'),
      'candidate_sort',coalesce(nullif(candidate.last_name,''),candidate.display_name,candidate.tms_ref,''),
      'work_date',source_row.work_date,
      'day_date',to_char(source_row.work_date,'Dy FMDD Mon YYYY'),
      'client',coalesce(client.name,source_row.source_client_identity),
      'system_hours',case when source_row.start_at_local is null then pg_catalog.chr(8212)
        else to_char(source_row.start_at_local,'HH24:MI')||'-'||to_char(source_row.end_at_local,'HH24:MI')
          ||' ('||coalesce(source_row.break_minutes,0)||' min break)' end,
      'actual_hours',case when source_row.start_at_local is null then pg_catalog.chr(8212)
        else to_char(source_row.start_at_local,'HH24:MI')||'-'||to_char(source_row.end_at_local,'HH24:MI')
          ||' ('||coalesce(source_row.break_minutes,0)||' min break)' end,
      'movement',case charge.row_sign_kind
        when 'FULL_NEGATIVE' then 'Reversal'
        when 'POSITIVE' then 'Positive'
        else case when coalesce(source_row.actual_net_minutes,0)<0 then 'Reversal' else 'Positive' end end,
      'commission',case when source_row.source_commission_pence is null then pg_catalog.chr(8212)
        else case when source_row.source_commission_pence<0 then '-£' else '£' end
          ||to_char(pg_catalog.abs(source_row.source_commission_pence)::numeric/100,'FM9999999990.00') end,
      'total_cost',case when source_row.source_total_cost_pence is null then pg_catalog.chr(8212)
        else case when source_row.source_total_cost_pence<0 then '-£' else '£' end
          ||to_char(pg_catalog.abs(source_row.source_total_cost_pence)::numeric/100,'FM9999999990.00') end,
      'invoice_charge',case when source_row.source_shift_charge_pence is null then pg_catalog.chr(8212)
        else case when source_row.source_shift_charge_pence<0 then '-£' else '£' end
          ||to_char(pg_catalog.abs(source_row.source_shift_charge_pence)::numeric/100,'FM9999999990.00') end,
      'status',pg_catalog.jsonb_build_object('text','Ready','tone','positive'),
      'actions',case when source_row.row_finalisation_state in ('NOT_APPLICABLE','SOURCE_WORKED')
        and not exists(select 1 from private.weekly_source_manual_reviews review
          where review.source_group_id=v_cycle.source_group_id
            and review.work_event_id=resolution.work_event_id and review.state='OPEN')
        and not exists(select 1 from public.weekly_discrepancy_incidents incident
          join public.weekly_source_cycles incident_cycle on incident_cycle.id=incident.source_cycle_id
          where incident_cycle.source_group_id=v_cycle.source_group_id
            and incident.work_event_id=resolution.work_event_id and incident.state='OPEN')
        then pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
          'label','Send to Pay Queries','kind','COMMAND','command','OPEN_MANUAL_REVIEW',
          'enabled',true,'payload',pg_catalog.jsonb_build_object('source_row_id',source_row.id),
          'context',pg_catalog.jsonb_build_object('candidate',coalesce(candidate.display_name,candidate.tms_ref),
            'client',coalesce(client.name,source_row.source_client_identity),
            'status',to_char(source_row.work_date,'Dy FMDD Mon YYYY')))) else '[]'::jsonb end
    ) order by
      case when v_sort_key='candidate' and v_sort_direction='asc'
        then private.weekly_source_query_ascii_fold_v1(coalesce(candidate.display_name,candidate.tms_ref,'')) end collate "C" asc,
      case when v_sort_key='candidate' and v_sort_direction='desc'
        then private.weekly_source_query_ascii_fold_v1(coalesce(candidate.display_name,candidate.tms_ref,'')) end collate "C" desc,
      case when v_sort_key='day_date' and v_sort_direction='asc' then source_row.work_date end asc,
      case when v_sort_key='day_date' and v_sort_direction='desc' then source_row.work_date end desc,
      case when v_sort_key='client' and v_sort_direction='asc'
        then private.weekly_source_query_ascii_fold_v1(coalesce(client.name,source_row.source_client_identity,'')) end collate "C" asc,
      case when v_sort_key='client' and v_sort_direction='desc'
        then private.weekly_source_query_ascii_fold_v1(coalesce(client.name,source_row.source_client_identity,'')) end collate "C" desc,
      case when v_sort_key in ('system_hours','actual_hours') and v_sort_direction='asc' then source_row.start_at_local end asc nulls last,
      case when v_sort_key in ('system_hours','actual_hours') and v_sort_direction='desc' then source_row.start_at_local end desc nulls last,
      case when v_sort_key in ('system_hours','actual_hours') and v_sort_direction='asc' then source_row.end_at_local end asc nulls last,
      case when v_sort_key in ('system_hours','actual_hours') and v_sort_direction='desc' then source_row.end_at_local end desc nulls last,
      case when v_sort_key in ('system_hours','actual_hours') and v_sort_direction='asc' then source_row.break_minutes end asc nulls last,
      case when v_sort_key in ('system_hours','actual_hours') and v_sort_direction='desc' then source_row.break_minutes end desc nulls last,
      case when v_sort_key='movement' and v_sort_direction='asc' then
        case charge.row_sign_kind when 'FULL_NEGATIVE' then 'Reversal' when 'POSITIVE' then 'Positive'
          else case when coalesce(source_row.actual_net_minutes,0)<0 then 'Reversal' else 'Positive' end end end asc,
      case when v_sort_key='movement' and v_sort_direction='desc' then
        case charge.row_sign_kind when 'FULL_NEGATIVE' then 'Reversal' when 'POSITIVE' then 'Positive'
          else case when coalesce(source_row.actual_net_minutes,0)<0 then 'Reversal' else 'Positive' end end end desc,
      case when v_sort_key='commission' and v_sort_direction='asc' then source_row.source_commission_pence end asc nulls last,
      case when v_sort_key='commission' and v_sort_direction='desc' then source_row.source_commission_pence end desc nulls last,
      case when v_sort_key='total_cost' and v_sort_direction='asc' then source_row.source_total_cost_pence end asc nulls last,
      case when v_sort_key='total_cost' and v_sort_direction='desc' then source_row.source_total_cost_pence end desc nulls last,
      case when v_sort_key='invoice_charge' and v_sort_direction='asc' then source_row.source_shift_charge_pence end asc nulls last,
      case when v_sort_key='invoice_charge' and v_sort_direction='desc' then source_row.source_shift_charge_pence end desc nulls last,
      case when v_sort_key='status' and v_sort_direction='asc' then 'Ready' end asc,
      case when v_sort_key='status' and v_sort_direction='desc' then 'Ready' end desc,
      case when v_sort_key='job_role' and v_sort_direction='asc'
        then private.weekly_source_query_ascii_fold_v1(coalesce(source_row.role_band_source,'')) end collate "C" asc,
      case when v_sort_key='job_role' and v_sort_direction='desc'
        then private.weekly_source_query_ascii_fold_v1(coalesce(source_row.role_band_source,'')) end collate "C" desc,
      case when v_sort_key='contract' and v_sort_direction='asc' then resolution.contract_id end asc nulls last,
      case when v_sort_key='contract' and v_sort_direction='desc' then resolution.contract_id end desc nulls last,
      case when v_sort_key='outcome' and v_sort_direction='asc' then source_row.row_finalisation_state end asc,
      case when v_sort_key='outcome' and v_sort_direction='desc' then source_row.row_finalisation_state end desc,
      private.weekly_source_query_ascii_fold_v1(coalesce(candidate.display_name,candidate.tms_ref,'')) collate "C",
      source_row.work_date,source_row.start_at_local,source_row.id),'[]'::jsonb)
    into v_rows
    from public.weekly_source_upload_rows source_row
    join lateral (select resolution.* from public.weekly_source_row_resolutions resolution
      where resolution.upload_row_id=source_row.id order by resolution.generation desc,resolution.id desc limit 1) resolution
      on resolution.mapping_state='RESOLVED'
    left join public.candidates candidate on candidate.id=resolution.candidate_id
    left join public.clients client on client.id=resolution.client_id
    left join lateral (select charge.* from public.weekly_source_charge_checks charge
      where charge.upload_row_id=source_row.id order by charge.generation desc,charge.id desc limit 1) charge on true
    left join public.weekly_source_charge_acceptances charge_acceptance
      on charge_acceptance.charge_check_id=charge.id
    where source_row.upload_id=v_upload.id
      and source_row.row_finalisation_state in ('NOT_APPLICABLE','SOURCE_WORKED','SOURCE_ABSENT_ZERO')
      and coalesce(charge.phase_severity,'NONE')<>'FINALISATION_BLOCKER'
      and (charge.phase_severity is distinct from 'PROVISIONAL_WARNING' or charge_acceptance.id is not null);
    v_ready:=pg_catalog.jsonb_build_object('rows',v_rows,'total_count',pg_catalog.jsonb_array_length(v_rows),
      'next_cursor','','has_more',false,'record_version',v_workspace_version,'stale',false);

    select coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
      'row_key',source_row.id,'candidate',coalesce(candidate.display_name,
        nullif(source_row.bounded_raw_columns_json->>'worker_name',''),
        nullif(source_row.bounded_raw_columns_json->>'staff_name',''),
        nullif(source_row.bounded_raw_columns_json->>'candidate',''),source_row.source_candidate_identity),
      'source_reference',source_row.source_candidate_identity,
      'candidate_sort',coalesce(nullif(candidate.last_name,''),candidate.display_name,
        nullif(source_row.bounded_raw_columns_json->>'worker_name',''),source_row.source_candidate_identity),
      'work_date',source_row.work_date,
      'booking_reference',source_row.external_source_key,
      'client_id',resolution.client_id,
      'client',source_row.source_client_identity,
      'mapping_state',resolution.mapping_state,
      'pay_blocking',resolution.mapping_state is distinct from 'RESOLVED'
        or source_row.row_finalisation_state in
          ('SOURCE_UNFINALISED','BLOCK_FINALISATION_DISAGREEMENT','BLOCK_ACTUAL_TUPLE'),
      'day_date',to_char(source_row.work_date,'Dy FMDD Mon YYYY'),
      'system_hours',case
        when source_row.start_at_local is not null and source_row.end_at_local is not null
          then to_char(source_row.start_at_local,'HH24:MI')||pg_catalog.chr(8211)
            ||to_char(source_row.end_at_local,'HH24:MI')
            ||case when source_row.break_minutes is not null
              then ' ('||source_row.break_minutes::text||' min break)' else '' end
        when source_row.row_finalisation_state='SOURCE_UNFINALISED' then 'No confirmed hours'
        else 'Start or finish missing' end,
      'status',pg_catalog.jsonb_build_object(
        'text',case
          when resolution.blocker_code='PAID_SHIFT_OVERLAP_CONFIRMATION_REQUIRED' then 'Paid shift needs matching'
          when resolution.mapping_state is distinct from 'RESOLVED' then 'Needs correction'
          when source_row.row_finalisation_state='SOURCE_UNFINALISED' then 'Not finalised'
          when source_row.row_finalisation_state in ('BLOCK_FINALISATION_DISAGREEMENT','BLOCK_ACTUAL_TUPLE')
            then 'Source shift needs correction'
          when charge.phase_severity='FINALISATION_BLOCKER' then 'Charge needs checking'
          when charge.phase_severity='PROVISIONAL_WARNING' and charge_acceptance.id is null then 'Charge decision needed'
          else 'Needs correction' end,
        'tone',case
          when source_row.row_finalisation_state='SOURCE_UNFINALISED' then 'warning'
          when resolution.mapping_state='RESOLVED' and charge.phase_severity='PROVISIONAL_WARNING'
            and charge_acceptance.id is null then 'warning'
          else 'danger' end),
      'problem',case
        when resolution.blocker_code='PAID_SHIFT_OVERLAP_CONFIRMATION_REQUIRED' then case
          when paid_question.value->>'state'='READY' then 'Confirm whether this is the paid shift or separate work.'
          else 'The paid-shift comparison is unavailable. Recheck the current payment and source authority.' end
        when resolution.blocker_code='PROTECTED_SHIFT_MATCH_REQUIRED' then 'Confirm whether this is the protected shift or a separate shift.'
        when resolution.blocker_code='CANDIDATE_MAPPING_AMBIGUOUS' then 'More than one candidate matches. Choose the correct candidate.'
        when resolution.mapping_state='CANDIDATE_NOT_FOUND' then 'No active candidate matches this source row'
        when resolution.mapping_state='CLIENT_NOT_FOUND' then 'No eligible client matches this source row'
        when resolution.mapping_state in ('NO_ELIGIBLE_CONTRACT','AMBIGUOUS_CONTRACT','CONTRACT_SELECTION_REQUIRED') then 'Review the contract for this shift'
        when resolution.mapping_state is distinct from 'RESOLVED' then 'Review the source row matching'
        when source_row.row_finalisation_state='SOURCE_UNFINALISED' then 'This shift is not finalised'
        when source_row.row_finalisation_state in ('BLOCK_FINALISATION_DISAGREEMENT','BLOCK_ACTUAL_TUPLE')
          then 'Check the source shift status and hours'
        when charge.phase_severity='FINALISATION_BLOCKER' then 'Check the charge for this shift'
        when charge.phase_severity='PROVISIONAL_WARNING' and charge_acceptance.id is null then 'Accept the final NHSP source charge'
        else 'Check the hours for this shift' end,
      'issue_count',(
        (case when resolution.mapping_state is distinct from 'RESOLVED' then 1 else 0 end)
        +(case when source_row.row_finalisation_state in ('SOURCE_UNFINALISED','BLOCK_FINALISATION_DISAGREEMENT','BLOCK_ACTUAL_TUPLE') then 1 else 0 end)
        +(case when charge.phase_severity='FINALISATION_BLOCKER'
          or (charge.phase_severity='PROVISIONAL_WARNING' and charge_acceptance.id is null) then 1 else 0 end)),
      'charge_warning_key',case when charge.phase_severity='PROVISIONAL_WARNING'
        and charge_acceptance.id is null then 'charge-check:'||charge.id::text end,
      'actions',pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
        'label',case when resolution.blocker_code='PAID_SHIFT_OVERLAP_CONFIRMATION_REQUIRED' then case
            when paid_question.value->>'state'='READY' then 'Confirm paid shift match' else 'View details' end
          when resolution.blocker_code='PROTECTED_SHIFT_MATCH_REQUIRED' then 'Confirm shift match'
          when resolution.mapping_state='CANDIDATE_NOT_FOUND'
          or resolution.blocker_code='CANDIDATE_MAPPING_AMBIGUOUS' then 'Link candidate'
          when resolution.mapping_state='CLIENT_NOT_FOUND' then 'Link client'
          when resolution.mapping_state in ('NO_ELIGIBLE_CONTRACT','AMBIGUOUS_CONTRACT','CONTRACT_SELECTION_REQUIRED') then 'Choose contract'
          when resolution.mapping_state='SOURCE_ROW_BLOCKED' and resolution.candidate_id is not null and resolution.client_id is not null then 'Choose contract'
          when source_row.row_finalisation_state in ('BLOCK_FINALISATION_DISAGREEMENT','BLOCK_ACTUAL_TUPLE') then 'View details'
          when charge.phase_severity in ('FINALISATION_BLOCKER','PROVISIONAL_WARNING') then 'Open charge details'
          else 'View details' end,
        'enabled',true,'payload',pg_catalog.jsonb_build_object(
          'upload_row_id',source_row.id,
          'paid_match_question',paid_question.value,
          'match_choices',private.weekly_source_protected_match_candidates_v1(source_row.id,resolution.candidate_id,resolution.client_id),
          'contract_id',resolution.contract_id,
          'system_hours',to_char(source_row.start_at_local,'HH24:MI')||'–'||to_char(source_row.end_at_local,'HH24:MI')||' · '||source_row.break_minutes::text||' min break',
          'candidate',coalesce(candidate.display_name,source_row.bounded_raw_columns_json->>'worker_name',
            source_row.bounded_raw_columns_json->>'candidate',source_row.source_candidate_identity),
          'client',source_row.source_client_identity,
          'shift',to_char(source_row.work_date,'FMDD Mon YYYY'),
          'source_row_ordinal',source_row.source_row_ordinal,
          'source_role_band',source_row.role_band_source,
          'contract_seed',case when resolution.candidate_id is not null and resolution.client_id is not null
            then pg_catalog.jsonb_build_object('candidate_id',resolution.candidate_id,
              'client_id',resolution.client_id,'start_date',source_row.work_date) else '{}'::jsonb end,
          'recheck_payload',pg_catalog.jsonb_build_object('request_id',pg_catalog.gen_random_uuid(),
            'upload_id',v_upload.id,'upload_row_id',source_row.id,
            'projection_publication_id',v_publication.id,
            'expected_authority_scope_version',v_publication.authority_scope_version,
            'expected_row_manifest_hash',pg_catalog.encode(v_upload.row_manifest_hash,'hex')),
          'choices',coalesce((select pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
            'contract_id',contract.id,'role_band',pg_catalog.concat_ws(' / ',contract.role,contract.band),
            'site',contract.display_site,'dates',to_char(contract.start_date,'FMDD Mon YYYY')||' onwards',
            'pay_type',contract.pay_method_snapshot) order by contract.start_date,contract.id)
            from public.contracts contract where contract.candidate_id=resolution.candidate_id
              and contract.client_id=resolution.client_id
              and source_row.work_date between contract.start_date and coalesce(contract.end_date,'infinity'::date)),'[]'::jsonb),
          'detail',pg_catalog.jsonb_build_object('candidate',coalesce(candidate.display_name,
              source_row.bounded_raw_columns_json->>'worker_name',source_row.bounded_raw_columns_json->>'candidate',source_row.source_candidate_identity),
            'source_reference',source_row.source_candidate_identity,'booking_reference',source_row.external_source_key,
            'client',source_row.source_client_identity,'day_date',to_char(source_row.work_date,'FMDD Mon YYYY'),
            'contract_id',resolution.contract_id,
            'commission',case when charge.source_commission_pence is not null then '£'||to_char(charge.source_commission_pence::numeric/100,'FM9999999990.00') end,
            'total_cost',case when charge.source_total_cost_pence is not null then '£'||to_char(charge.source_total_cost_pence::numeric/100,'FM9999999990.00') end,
            'source_charge',case when charge.source_shift_charge_pence is not null then '£'||to_char(charge.source_shift_charge_pence::numeric/100,'FM9999999990.00') end,
            'calculated_charge',case when charge.calculated_segment_charge_pence is not null then '£'||to_char(charge.calculated_segment_charge_pence::numeric/100,'FM9999999990.00') end,
            'difference',case when charge.source_charge_difference_pence is not null then '£'||to_char(charge.source_charge_difference_pence::numeric/100,'FM9999999990.00') end,
            'problem',case
              when resolution.blocker_code='PAID_SHIFT_OVERLAP_CONFIRMATION_REQUIRED' then case
                when paid_question.value->>'state'='READY' then 'Choose Same only for the work already paid. Earlier pay is retained; the imported row is invoiced. Choose Separate only for different work, then enter a reason. The saved comparison is rechecked before it can be used.'
                else 'The native paid proof, current source or payment authority is unavailable. No Same or Separate choice can be saved from this screen. Recheck the workspace.' end
              when resolution.blocker_code='PROTECTED_SHIFT_MATCH_REQUIRED' then 'Confirm whether the imported shift is one of the protected shifts shown. Different hours are allowed. Choose a separate shift only if it is different work.'
              when resolution.blocker_code='CANDIDATE_MAPPING_AMBIGUOUS' then 'More than one candidate matches. Choose the correct candidate.'
              when resolution.mapping_state='CANDIDATE_NOT_FOUND' then 'No active candidate matches. Link an active candidate, or review the candidate record before rechecking.'
              when resolution.mapping_state='CLIENT_NOT_FOUND' then 'Choose the client this shift belongs to.'
              when resolution.mapping_state in ('NO_ELIGIBLE_CONTRACT','AMBIGUOUS_CONTRACT','CONTRACT_SELECTION_REQUIRED') then 'Review the candidate contract, dates, role and band, then recheck.'
              when resolution.mapping_state='SOURCE_ROW_BLOCKED' then 'Review the source details and contract rates, then recheck. The remaining hours and pricing checks have not passed yet.'
              when charge.phase_severity in ('FINALISATION_BLOCKER','PROVISIONAL_WARNING') then 'The source charge needs review. Compare it with the contract rates before proceeding.'
              when source_row.row_finalisation_state='SOURCE_UNFINALISED' then 'The source has not finalised this shift.'
              else 'Review the source hours and finalisation details.' end)
        )
      ))
    ) order by
      case when v_sort_key='candidate' and v_sort_direction='asc'
        then private.weekly_source_query_ascii_fold_v1(coalesce(candidate.display_name,source_row.source_candidate_identity,'')) end collate "C" asc,
      case when v_sort_key='candidate' and v_sort_direction='desc'
        then private.weekly_source_query_ascii_fold_v1(coalesce(candidate.display_name,source_row.source_candidate_identity,'')) end collate "C" desc,
      case when v_sort_key='day_date' and v_sort_direction='asc' then source_row.work_date end asc,
      case when v_sort_key='day_date' and v_sort_direction='desc' then source_row.work_date end desc,
      case when v_sort_key='client' and v_sort_direction='asc'
        then private.weekly_source_query_ascii_fold_v1(coalesce(source_row.source_client_identity,'')) end collate "C" asc,
      case when v_sort_key='client' and v_sort_direction='desc'
        then private.weekly_source_query_ascii_fold_v1(coalesce(source_row.source_client_identity,'')) end collate "C" desc,
      case when v_sort_key in ('system_hours','actual_hours') and v_sort_direction='asc' then source_row.start_at_local end asc nulls last,
      case when v_sort_key in ('system_hours','actual_hours') and v_sort_direction='desc' then source_row.start_at_local end desc nulls last,
      case when v_sort_key in ('system_hours','actual_hours') and v_sort_direction='asc' then source_row.end_at_local end asc nulls last,
      case when v_sort_key in ('system_hours','actual_hours') and v_sort_direction='desc' then source_row.end_at_local end desc nulls last,
      case when v_sort_key in ('system_hours','actual_hours') and v_sort_direction='asc' then source_row.break_minutes end asc nulls last,
      case when v_sort_key in ('system_hours','actual_hours') and v_sort_direction='desc' then source_row.break_minutes end desc nulls last,
      case when v_sort_key='movement' and v_sort_direction='asc'
        then case when coalesce(source_row.actual_net_minutes,0)<0 then 'Reversal' else 'Positive' end end asc,
      case when v_sort_key='movement' and v_sort_direction='desc'
        then case when coalesce(source_row.actual_net_minutes,0)<0 then 'Reversal' else 'Positive' end end desc,
      case when v_sort_key='commission' and v_sort_direction='asc' then source_row.source_commission_pence end asc nulls last,
      case when v_sort_key='commission' and v_sort_direction='desc' then source_row.source_commission_pence end desc nulls last,
      case when v_sort_key='total_cost' and v_sort_direction='asc' then source_row.source_total_cost_pence end asc nulls last,
      case when v_sort_key='total_cost' and v_sort_direction='desc' then source_row.source_total_cost_pence end desc nulls last,
      case when v_sort_key='invoice_charge' and v_sort_direction='asc' then source_row.source_shift_charge_pence end asc nulls last,
      case when v_sort_key='invoice_charge' and v_sort_direction='desc' then source_row.source_shift_charge_pence end desc nulls last,
      case when v_sort_key='status' and v_sort_direction='asc' then case
        when resolution.mapping_state is distinct from 'RESOLVED' then 'Needs correction'
        when source_row.row_finalisation_state='SOURCE_UNFINALISED' then 'Not finalised'
        when charge.phase_severity='FINALISATION_BLOCKER' then 'Charge needs checking'
        else 'Needs correction' end end asc,
      case when v_sort_key='status' and v_sort_direction='desc' then case
        when resolution.mapping_state is distinct from 'RESOLVED' then 'Needs correction'
        when source_row.row_finalisation_state='SOURCE_UNFINALISED' then 'Not finalised'
        when charge.phase_severity='FINALISATION_BLOCKER' then 'Charge needs checking'
        else 'Needs correction' end end desc,
      case when v_sort_key='problem' and v_sort_direction='asc' then case
        when resolution.mapping_state is distinct from 'RESOLVED' then 'Link this row before finalising'
        when source_row.row_finalisation_state='SOURCE_UNFINALISED' then 'This shift is not finalised'
        when charge.phase_severity='FINALISATION_BLOCKER' then 'Check the charge for this shift'
        else 'Check the hours for this shift' end end asc,
      case when v_sort_key='problem' and v_sort_direction='desc' then case
        when resolution.mapping_state is distinct from 'RESOLVED' then 'Link this row before finalising'
        when source_row.row_finalisation_state='SOURCE_UNFINALISED' then 'This shift is not finalised'
        when charge.phase_severity='FINALISATION_BLOCKER' then 'Check the charge for this shift'
        else 'Check the hours for this shift' end end desc,
      case when v_sort_key='job_role' and v_sort_direction='asc'
        then private.weekly_source_query_ascii_fold_v1(coalesce(source_row.role_band_source,'')) end collate "C" asc,
      case when v_sort_key='job_role' and v_sort_direction='desc'
        then private.weekly_source_query_ascii_fold_v1(coalesce(source_row.role_band_source,'')) end collate "C" desc,
      case when v_sort_key='contract' and v_sort_direction='asc' then resolution.contract_id end asc nulls last,
      case when v_sort_key='contract' and v_sort_direction='desc' then resolution.contract_id end desc nulls last,
      case when v_sort_key='outcome' and v_sort_direction='asc' then source_row.row_finalisation_state end asc,
      case when v_sort_key='outcome' and v_sort_direction='desc' then source_row.row_finalisation_state end desc,
      source_row.work_date,private.weekly_source_query_ascii_fold_v1(source_row.source_candidate_identity) collate "C",source_row.id),'[]'::jsonb)
    into v_rows
    from public.weekly_source_upload_rows source_row
    left join lateral (select latest.* from public.weekly_source_row_resolutions latest
      where latest.upload_row_id=source_row.id order by latest.generation desc,latest.id desc limit 1) resolution on true
    left join lateral (select case when resolution.blocker_code='PAID_SHIFT_OVERLAP_CONFIRMATION_REQUIRED'
      then private.weekly_source_paid_match_question_v1(v_publication.id,source_row.id,v_actor) else null end value) paid_question on true
    left join public.candidates candidate on candidate.id=resolution.candidate_id
    left join lateral (select latest.* from public.weekly_source_charge_checks latest
      where latest.upload_row_id=source_row.id order by latest.generation desc,latest.id desc limit 1) charge on true
    left join public.weekly_source_charge_acceptances charge_acceptance
      on charge_acceptance.charge_check_id=charge.id
    where source_row.upload_id=v_upload.id
      and (resolution.mapping_state is distinct from 'RESOLVED'
        or source_row.row_finalisation_state in ('SOURCE_UNFINALISED','BLOCK_FINALISATION_DISAGREEMENT','BLOCK_ACTUAL_TUPLE')
        or charge.phase_severity='FINALISATION_BLOCKER'
        or (charge.phase_severity='PROVISIONAL_WARNING' and charge_acceptance.id is null));
    v_blocked:=pg_catalog.jsonb_build_object('rows',v_rows,'total_count',pg_catalog.jsonb_array_length(v_rows),
      'next_cursor','','has_more',false,'record_version',v_workspace_version,'stale',false);
    v_import_prepared:=private.weekly_source_import_is_prepared_v1(v_upload.id);
    v_office_checks:=v_blocked;
    select coalesce(pg_catalog.jsonb_agg(row_data),'[]'::jsonb) into v_excluded_rows
    from pg_catalog.jsonb_array_elements(v_rows) row_data where row_data->'status'->>'text'='Not finalised';
    select coalesce(pg_catalog.jsonb_agg(row_data),'[]'::jsonb) into v_rows
    from pg_catalog.jsonb_array_elements(v_rows) row_data
    where row_data->'status'->>'text'<>'Not finalised';
    v_blocked:=v_blocked||pg_catalog.jsonb_build_object('rows',v_rows,'total_count',pg_catalog.jsonb_array_length(v_rows));
    select pg_catalog.count(*)::integer into v_unfinalised_count
    from public.weekly_source_upload_rows where upload_id=v_upload.id and row_finalisation_state='SOURCE_UNFINALISED';
    v_finalise_enabled:=v_import_prepared and v_blocker_count=0
      and (v_profile.profile_code<>'NHSP_FINAL_BACKING_V1' or v_rate_warning_unaccepted_count=0)
      and (v_profile.profile_code in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1')
        or pg_catalog.statement_timestamp()>=coalesce(
        (select scope.cutoff_at_utc from public.weekly_source_report_scopes scope
          where scope.id=v_report_scope_id),
        v_cycle.cutoff_at_utc
      ))
      and v_cycle.state not in ('FINALISING','FINALISED');
    v_finalise_payload:=pg_catalog.jsonb_build_object(
      'source_cycle_id',v_cycle.id,'authority_scope_kind',v_publication.authority_scope_kind,
      'report_scope_id',v_publication.report_scope_id,'upload_id',v_upload.id,
      'projection_publication_id',v_publication.id,
      'expected_authority_scope_version',v_publication.authority_scope_version,
      'expected_row_manifest_hash',pg_catalog.encode(v_upload.row_manifest_hash,'hex'),
      'expected_comparison_manifest_hash',pg_catalog.encode(v_publication.comparison_manifest_hash,'hex'),
      'expected_issue_set_hash',pg_catalog.encode(v_publication.issue_set_hash,'hex')
    );

    select pg_catalog.jsonb_build_object(
      'state',run_row.state,
      'title',case run_row.state
        when 'ACTION_REQUIRED' then 'Approved hours need attention'
        when 'RECOVERY_REQUIRED' then 'Approved hours update needs checking'
        else 'Approved hours update is not complete' end,
      'body',case run_row.state
        when 'ACTION_REQUIRED' then run_row.action_required_task_count::text
          ||case when run_row.action_required_task_count=1 then ' timesheet needs' else ' timesheets need' end
          ||' review. The source is finalised and invoicing is not delayed.'
        when 'RECOVERY_REQUIRED' then 'The source is finalised. Check the approved-hours update before trying it again.'
        else 'The source is finalised. Continue the approved-hours update.' end,
      'action',case
        when task.state='READY' then pg_catalog.jsonb_build_object(
          'label','Continue approved hours update','command','FINALISE_WEEK',
          'payload',v_finalise_payload
        )
        when task.state in ('SUBMISSION_STARTED','RECOVERY_REQUIRED') then pg_catalog.jsonb_build_object(
          'label','Check approved hours update','command','RECOVER_FINALISED_PAY',
          'payload',pg_catalog.jsonb_build_object(
            'final_revision_id',run_row.final_revision_id,'run_id',run_row.id,
            'task_id',task.id,'expected_task_version',task.version,'confirm_retry',false
          )
        )
        else null end
    ) into v_finalise_pay_follow_up
    from public.weekly_source_final_revisions revision
    join public.weekly_source_finalisation_pay_runs run_row
      on run_row.final_revision_id=revision.id and run_row.state<>'COMPLETE'
    left join lateral (
      select pending.*
      from public.weekly_source_finalisation_pay_tasks pending
      where pending.run_id=run_row.id
        and pending.state in ('READY','SUBMISSION_STARTED','RECOVERY_REQUIRED')
      order by case pending.state
        when 'SUBMISSION_STARTED' then 1 when 'RECOVERY_REQUIRED' then 2 else 3 end,
        pending.task_ordinal,pending.id
      limit 1
    ) task on true
    where revision.source_cycle_id=v_cycle.id and revision.state='CURRENT'
      and revision.authority_scope_kind=v_publication.authority_scope_kind
      and revision.report_scope_id is not distinct from v_publication.report_scope_id
    order by revision.revision_number desc,revision.id desc
    limit 1;
  else
    v_ready:=pg_catalog.jsonb_build_object('rows','[]'::jsonb,'total_count',0,'next_cursor','','has_more',false,'record_version',v_workspace_version,'stale',false);
    v_blocked:=v_ready;
  end if;

  v_complete:=case when v_authority_mode='SOURCE_AUTHORITY'
    then private.weekly_source_completed_rows_v1(v_cycle.id,v_client_id,v_report_scope_id)
    else jsonb_build_object('rows','[]'::jsonb,'total_count',0,'next_cursor','','has_more',false,'stale',false) end;
  if v_authority_mode='SOURCE_AUTHORITY' and exists(select 1 from public.weekly_source_final_revisions completed
    where completed.source_cycle_id=v_cycle.id and completed.state='CURRENT'
      and completed.upload_id=v_upload.id
      and completed.report_scope_id is not distinct from v_report_scope_id) then
    v_ready:=pg_catalog.jsonb_build_object('rows','[]'::jsonb,'total_count',0,
      'next_cursor','','has_more',false,'record_version',v_workspace_version,'stale',false);
    v_blocked:=v_ready;
    v_blocker_count:=0;
    v_finalise_enabled:=false;
    v_finalise_payload:='{}'::jsonb;
  end if;
  v_queries:=v_queries||pg_catalog.jsonb_build_object('office_checks',v_office_checks);
  if not v_import_prepared then
    if v_publication_id is not null and v_upload.state='CURRENT' and v_upload.purpose='ORDINARY'
      and v_cycle.state not in ('FINALISING','FINALISED') and v_upload.coverage_state='COMPLETE'
      and v_profile.profile_code in ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1',
        'HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1','ROSTER_WEEKLY_SUMMARY_ACTUAL_V1') then
      v_prepare_action:=pg_catalog.jsonb_build_object('label','Prepare for finalisation',
        'command','PREPARE_FINALISATION','payload',pg_catalog.jsonb_build_object(
          'upload_id',v_upload.id,'projection_publication_id',v_publication.id,
          'expected_authority_scope_version',v_publication.authority_scope_version,
          'expected_row_manifest_hash',pg_catalog.encode(v_upload.row_manifest_hash,'hex')));
    end if;
    v_ready:=pg_catalog.jsonb_build_object('rows','[]'::jsonb,'total_count',0,
      'next_cursor','','has_more',false,'record_version',v_workspace_version,'stale',false);
    v_blocked:=v_ready;
    v_finalise_enabled:=false;
    v_finalise_payload:='{}'::jsonb;
  end if;

  select pg_catalog.jsonb_build_object(
    'title','Finalisation progress','cycle_label','Week ending '||to_char(v_cycle.finalisation_week_ending,'FMDD Mon YYYY'),
    'cycle_id',v_cycle.id,
    'cycle_options',coalesce((select pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
      'value',item.id,'label','Week ending '||to_char(item.finalisation_week_ending,'FMDD Mon YYYY'))
      order by item.finalisation_week_ending desc,item.id)
      from public.weekly_source_cycles item where item.source_group_id=v_group.id),'[]'::jsonb),
    'complete',not exists(
      select 1 from public.weekly_source_group_clients membership
      where membership.source_group_id=v_group.id
        and (v_cycle.scope_client_id is null or membership.client_id=v_cycle.scope_client_id)
        and v_cycle.finalisation_week_ending between membership.valid_from and coalesce(membership.valid_to,'infinity'::date)
        and not exists(select 1 from public.weekly_source_client_cycle_completions completion
          where completion.source_cycle_id=v_cycle.id and completion.client_id=membership.client_id and completion.state='CURRENT')
    ),
    'rows',coalesce((select pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
      'row_key','tracker-'||membership.client_id::text,'source',v_group.display_name,'client',client.name,
      'status',pg_catalog.jsonb_build_object(
        'text',case when completion.id is not null then case completion.completion_kind
          when 'FINAL_SOURCE' then 'Finalised' else 'No shifts this week' end else 'Not finalised' end,
        'tone',case when completion.id is not null then 'positive' else 'warning' end),
      'detail',case when completion.id is not null then to_char(completion.attested_at_utc at time zone 'Europe/London','DD Mon YYYY HH24:MI') else '' end,
      'actions',case
        when completion.id is null
         and v_cycle.state not in ('FINALISING','FINALISED')
         and not exists(select 1 from public.weekly_source_final_revisions revision
           join public.weekly_source_final_snapshot_lines snapshot on snapshot.final_revision_id=revision.id
           where revision.source_cycle_id=v_cycle.id and revision.state in ('PREPARED','CURRENT')
             and snapshot.client_id=membership.client_id)
         and not exists(select 1 from public.weekly_source_uploads upload
           join public.weekly_source_upload_rows source_row on source_row.upload_id=upload.id
           left join lateral (select resolution.* from public.weekly_source_row_resolutions resolution
             where resolution.upload_row_id=source_row.id order by resolution.generation desc,resolution.id desc limit 1) resolution on true
           where upload.source_cycle_id=v_cycle.id
             and (upload.id=v_cycle.current_complete_upload_id or upload.state='CURRENT')
             and resolution.mapping_state is distinct from 'RESOLVED')
         and not exists(select 1 from public.weekly_source_report_scopes scope
           where scope.source_cycle_id=v_cycle.id and scope.client_id=membership.client_id
             and (scope.current_complete_upload_id is not null or scope.current_projection_publication_id is not null or scope.current_final_revision_id is not null))
         and not exists(select 1 from public.weekly_source_upload_rows source_row
           join public.weekly_source_uploads upload on upload.id=source_row.upload_id and upload.source_cycle_id=v_cycle.id and upload.state='CURRENT'
           join lateral (select resolution.* from public.weekly_source_row_resolutions resolution
             where resolution.upload_row_id=source_row.id order by resolution.generation desc,resolution.id desc limit 1) resolution
             on resolution.mapping_state='RESOLVED' and resolution.client_id=membership.client_id)
         and not exists(select 1 from public.weekly_discrepancy_incidents incident
           where incident.source_cycle_id=v_cycle.id and incident.client_id=membership.client_id and incident.state='OPEN')
        then pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
          'label','No shifts to import','enabled',true,'kind','COMMAND','command','NO_SHIFTS_TO_IMPORT',
          'context',pg_catalog.jsonb_build_object(
            'trust',client.name,
            'cutoff',to_char(v_cycle.cutoff_at_utc at time zone 'Europe/London','Dy FMDD Mon YYYY HH24:MI')
          ),
          'payload',pg_catalog.jsonb_build_object(
            'actor_user_id',v_actor,
            'source_cycle_id',v_cycle.id,'source_group_id',v_group.id,
            'client_id',membership.client_id,'expected_cycle_version',v_cycle.version,
            'attestation_text','No shifts to import'
          )))
        else pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
          'label','View','enabled',true,'payload',pg_catalog.jsonb_build_object('client_id',membership.client_id)
        )) end
    ) order by private.weekly_source_query_ascii_fold_v1(client.name) collate "C",client.id)
    from public.weekly_source_group_clients membership
    join public.clients client on client.id=membership.client_id
    left join public.weekly_source_client_cycle_completions completion
      on completion.source_cycle_id=v_cycle.id and completion.client_id=membership.client_id and completion.state='CURRENT'
    where membership.source_group_id=v_group.id
      and (v_cycle.scope_client_id is null or membership.client_id=v_cycle.scope_client_id)
      and v_cycle.finalisation_week_ending between membership.valid_from and coalesce(membership.valid_to,'infinity'::date)),'[]'::jsonb)
  ) into v_tracker;

  if v_tab='history' then
    with ranked_cycles as (
      select item.id,pg_catalog.row_number() over(
        order by item.finalisation_week_ending desc,item.id desc
      ) cycle_ordinal
      from public.weekly_source_cycles item
      where item.source_group_id=v_group.id
        and item.finalisation_week_ending<=v_cycle.finalisation_week_ending
    ), selected_cycles as (
      select id from ranked_cycles
      where (v_cycle_filter='CURRENT_PAY_CYCLE' and id=v_cycle.id)
         or (v_cycle_filter='LAST_4_PAY_CYCLES' and cycle_ordinal<=4)
         or (v_cycle_filter='LAST_13_PAY_CYCLES' and cycle_ordinal<=13)
    ), events as (
      select completion.attested_at_utc when_utc,completion.id::text row_key,
        v_group.display_name source_label,
        case completion.completion_kind when 'FINAL_SOURCE' then 'Finalised' else 'No shifts to import' end event_label,
        coalesce(office_user.display_name,office_user.email,'Office') by_label,
        client.name detail_label
      from public.weekly_source_client_cycle_completions completion
      join selected_cycles selected on selected.id=completion.source_cycle_id
      join public.clients client on client.id=completion.client_id
      left join public.tms_users office_user on office_user.id=completion.attested_by_user_id
      union all
      select upload.uploaded_at_utc,upload.id::text,v_group.display_name,'Source uploaded',
        coalesce(office_user.display_name,office_user.email,'Office'),upload.original_filename
      from public.weekly_source_uploads upload
      join selected_cycles selected on selected.id=upload.source_cycle_id
      left join public.tms_users office_user on office_user.id=upload.uploaded_by_user_id
    )
    select pg_catalog.count(*)::integer into v_total from events;

    with ranked_cycles as (
      select item.id,pg_catalog.row_number() over(
        order by item.finalisation_week_ending desc,item.id desc
      ) cycle_ordinal
      from public.weekly_source_cycles item
      where item.source_group_id=v_group.id
        and item.finalisation_week_ending<=v_cycle.finalisation_week_ending
    ), selected_cycles as (
      select id from ranked_cycles
      where (v_cycle_filter='CURRENT_PAY_CYCLE' and id=v_cycle.id)
         or (v_cycle_filter='LAST_4_PAY_CYCLES' and cycle_ordinal<=4)
         or (v_cycle_filter='LAST_13_PAY_CYCLES' and cycle_ordinal<=13)
    ), events as (
      select completion.attested_at_utc when_utc,completion.id::text row_key,
        v_group.display_name source_label,
        case completion.completion_kind when 'FINAL_SOURCE' then 'Finalised' else 'No shifts to import' end event_label,
        coalesce(office_user.display_name,office_user.email,'Office') by_label,
        client.name detail_label
      from public.weekly_source_client_cycle_completions completion
      join selected_cycles selected on selected.id=completion.source_cycle_id
      join public.clients client on client.id=completion.client_id
      left join public.tms_users office_user on office_user.id=completion.attested_by_user_id
      union all
      select upload.uploaded_at_utc,upload.id::text,v_group.display_name,'Source uploaded',
        coalesce(office_user.display_name,office_user.email,'Office'),upload.original_filename
      from public.weekly_source_uploads upload
      join selected_cycles selected on selected.id=upload.source_cycle_id
      left join public.tms_users office_user on office_user.id=upload.uploaded_by_user_id
    ), page as (
      select pg_catalog.jsonb_build_object(
          'row_key',event.row_key,'when',to_char(event.when_utc at time zone 'Europe/London','DD Mon YYYY HH24:MI'),
          'source',event.source_label,'event',event.event_label,'by',event.by_label,'detail',event.detail_label
        ) row_json,
        pg_catalog.row_number() over(order by
          case when v_sort_key='when' and v_sort_direction='asc' then event.when_utc end asc,
          case when v_sort_key='when' and v_sort_direction='desc' then event.when_utc end desc,
          case when v_sort_key='source' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(event.source_label) end asc,
          case when v_sort_key='source' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(event.source_label) end desc,
          case when v_sort_key='event' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(event.event_label) end asc,
          case when v_sort_key='event' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(event.event_label) end desc,
          case when v_sort_key='by' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(event.by_label) end asc,
          case when v_sort_key='by' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(event.by_label) end desc,
          case when v_sort_key='detail' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(event.detail_label) end asc,
          case when v_sort_key='detail' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(event.detail_label) end desc,
          case when v_sort_direction='asc' then event.when_utc end asc,
          case when v_sort_direction='desc' then event.when_utc end desc,
          event.row_key
        ) position
      from events event
      order by
        case when v_sort_key='when' and v_sort_direction='asc' then event.when_utc end asc,
        case when v_sort_key='when' and v_sort_direction='desc' then event.when_utc end desc,
        case when v_sort_key='source' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(event.source_label) end asc,
        case when v_sort_key='source' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(event.source_label) end desc,
        case when v_sort_key='event' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(event.event_label) end asc,
        case when v_sort_key='event' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(event.event_label) end desc,
        case when v_sort_key='by' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(event.by_label) end asc,
        case when v_sort_key='by' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(event.by_label) end desc,
        case when v_sort_key='detail' and v_sort_direction='asc' then private.weekly_source_query_ascii_fold_v1(event.detail_label) end asc,
        case when v_sort_key='detail' and v_sort_direction='desc' then private.weekly_source_query_ascii_fold_v1(event.detail_label) end desc,
        case when v_sort_direction='asc' then event.when_utc end asc,
        case when v_sort_direction='desc' then event.when_utc end desc,
        event.row_key
      offset v_offset limit v_limit
    )
    select coalesce(pg_catalog.jsonb_agg(page.row_json order by page.position),'[]'::jsonb)
    into v_rows from page;
    v_next_cursor:=case when v_offset+v_limit<v_total
      then v_cursor_view_version||':'||(v_offset+v_limit)::text else '' end;
  else
    v_rows:='[]'::jsonb;
    v_total:=0;
    v_next_cursor:='';
  end if;
  v_history:=pg_catalog.jsonb_build_object('rows',v_rows,
    'total_count',v_total,'next_cursor',v_next_cursor,'has_more',v_next_cursor<>'',
    'record_version',v_workspace_version,'stale',false,'cycle_filter',v_cycle_filter,
    'cycle_options',pg_catalog.jsonb_build_array(
      pg_catalog.jsonb_build_object('value','CURRENT_PAY_CYCLE','label','Current pay cycle'),
      pg_catalog.jsonb_build_object('value','LAST_4_PAY_CYCLES','label','Last 4 pay cycles'),
      pg_catalog.jsonb_build_object('value','LAST_13_PAY_CYCLES','label','Last 13 pay cycles')
    ));

  if v_client_id is not null then
    select client.name into v_context_client_name from public.clients client where client.id=v_client_id;
  end if;
  v_context_cutoff:=v_cycle.cutoff_at_utc;
  if v_report_scope_id is not null then
    select scope.cutoff_at_utc into v_context_cutoff
    from public.weekly_source_report_scopes scope where scope.id=v_report_scope_id;
  end if;
  if v_group.source_family='NHSP' then
    v_nhsp_report_number:=nullif(pg_catalog.btrim(v_upload.file_metadata_json->>'nhsp_report_number'),'');
    select pg_catalog.jsonb_build_array(
      pg_catalog.jsonb_build_object('key','source_group','label','Source','value',v_group.id,
        'options',coalesce((select pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
          'value',item.id,'label',case when item.source_family='NHSP' then 'NHSP' else item.display_name end)
          order by private.weekly_source_query_ascii_fold_v1(item.display_name) collate "C",item.id)
          from public.weekly_source_groups item where item.active),'[]'::jsonb)),
      pg_catalog.jsonb_build_object('key','client','label','Trust','value',coalesce(v_client_id::text,''),
        'options',coalesce((select pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('value',client.id,'label',client.name)
          order by private.weekly_source_query_ascii_fold_v1(client.name) collate "C",client.id)
          from public.weekly_source_group_clients membership join public.clients client on client.id=membership.client_id
          where membership.source_group_id=v_group.id and v_cycle.finalisation_week_ending between membership.valid_from and coalesce(membership.valid_to,'infinity'::date)),'[]'::jsonb)),
      pg_catalog.jsonb_build_object('key','report','label','Report number','value',coalesce(v_nhsp_report_number,'Not confirmed'),'options','[]'::jsonb),
      pg_catalog.jsonb_build_object('key','cutoff','label','Cutoff','value',to_char(v_context_cutoff at time zone 'Europe/London','DD/MM/YYYY HH24:MI'),'options','[]'::jsonb)
    ) into v_controls;
  else
    select pg_catalog.jsonb_build_array(
      pg_catalog.jsonb_build_object('key','journey','label','Journey',
        'value',case when v_authority_mode='TIMESHEET_AUTHORITY'
          then 'Signed Timesheet decides hours' else 'Client system decides hours' end,
        'options','[]'::jsonb),
      pg_catalog.jsonb_build_object('key','source_group','label','Source','value',v_group.id,
        'options',coalesce((select pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('value',item.id,'label',item.display_name)
          order by private.weekly_source_query_ascii_fold_v1(item.display_name) collate "C",item.id)
          from public.weekly_source_groups item where item.active),'[]'::jsonb)),
      pg_catalog.jsonb_build_object('key','cycle','label','Week','value',v_cycle.id,
        'options',coalesce((select pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('value',item.id,'label','Week ending '||to_char(item.finalisation_week_ending,'FMDD Mon YYYY'),
          'scope_client_id',item.scope_client_id,'finalisation_week_ending',item.finalisation_week_ending)
          order by item.finalisation_week_ending desc,item.id)
          from public.weekly_source_cycles item where item.source_group_id=v_group.id),'[]'::jsonb)),
      pg_catalog.jsonb_build_object('key','client','label','Client','value',coalesce(v_client_id::text,''),
        'options',coalesce((select pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('value',client.id,'label',client.name)
          order by private.weekly_source_query_ascii_fold_v1(client.name) collate "C",client.id)
          from public.weekly_source_group_clients membership join public.clients client on client.id=membership.client_id
          where membership.source_group_id=v_group.id and v_cycle.finalisation_week_ending between membership.valid_from and coalesce(membership.valid_to,'infinity'::date)),'[]'::jsonb))
    ) into v_controls;
  end if;

  v_cycle_label:='Week ending '||to_char(v_cycle.finalisation_week_ending,'FMDD Mon YYYY');
  v_cycle_state_label:=case v_cycle.state when 'OPEN' then 'Before cutoff'
    when 'FINALISABLE' then 'Ready for finalisation' when 'FINALISED' then 'Finalised'
    when 'CORRECTION_IN_PROGRESS' then 'Correction in progress' else 'Ready for finalisation' end;
  v_cycle_state_tone:=case when v_cycle.state='FINALISED' then 'positive'
    when v_cycle.state='CORRECTION_IN_PROGRESS' then 'danger' else 'warning' end;

  if v_publication.state='CURRENT' and v_upload.purpose='ORDINARY'
    and v_cycle.state not in ('FINALISING','FINALISED') then
    v_recheck_action:=pg_catalog.jsonb_build_object('request_id',pg_catalog.gen_random_uuid(),
      'upload_id',v_upload.id,'projection_publication_id',v_publication.id,
      'expected_authority_scope_version',v_publication.authority_scope_version,
      'expected_row_manifest_hash',pg_catalog.encode(v_upload.row_manifest_hash,'hex'));
  else
    select saved.request_json-'actor_user_id' into v_recheck_action
      from private.weekly_source_office_rechecks saved
      join public.weekly_source_projection_publications pending on pending.id=saved.publication_id
      join public.weekly_source_uploads upload on upload.id=saved.upload_id
      where saved.actor_user_id=v_actor and pending.source_cycle_id=v_cycle.id
        and pending.state='BUILDING' and upload.state='CURRENT'
        and pending.report_scope_id is not distinct from v_report_scope_id
      order by saved.created_at_utc desc,saved.request_id desc limit 1;
  end if;
  -- Reduce the existing Hours-question projection, preserving each owner's
  -- exact pay proofs. No contact, upload, settings or invoice command survives.
  if v_pay_view then
    v_pay_rows:='[]'::jsonb;
    for v_pay_row in select value from jsonb_array_elements(coalesce(v_queries->'rows','[]'::jsonb))
    loop
      v_pay_children:='[]'::jsonb;
      for v_pay_child in select value from jsonb_array_elements(coalesce(v_pay_row->'children','[]'::jsonb))
      loop
        if v_pay_child ? 'manual_review_id' or jsonb_typeof(v_pay_child->'protected_pay_seed')='object'
          or coalesce((v_pay_child->>'accept_eligible')::boolean,false) then
          v_pay_children:=v_pay_children||jsonb_build_array(v_pay_child||jsonb_build_object('actions',
            coalesce((select jsonb_agg(action.value order by action.ordinality)
              from jsonb_array_elements(coalesce(v_pay_child->'actions','[]'::jsonb))
                with ordinality action(value,ordinality)
              where action.value->>'command'='RESOLVE_MANUAL_REVIEW'
                or (not action.value ? 'command' and (
                  action.value->'payload' ? 'detail'
                  or action.value->'payload' ?& array['source_group_id','candidate_id','work_date']))),'[]'::jsonb)));
        end if;
      end loop;
      if jsonb_array_length(v_pay_children)>0 then
        v_pay_rows:=v_pay_rows||jsonb_build_array(
          (v_pay_row-array['actions','contact_policy','outreach_eligible','manager_eligible'])
          ||jsonb_build_object('children',v_pay_children));
      end if;
    end loop;
    v_queries:=(v_queries-array['office_checks','bulk_actions','rows'])||jsonb_build_object(
      'rows',v_pay_rows,'bulk_actions','{}'::jsonb);
  end if;
  v_result:=pg_catalog.jsonb_build_object(
    'contract','WEEKLY_SOURCE_IMPORT_WORKSPACE_V1','workspace_version',v_workspace_version,
    'combined_source_workspace',v_authority_mode='SOURCE_AUTHORITY' and exists(
      select 1 from public.weekly_source_client_policies policy where policy.source_group_id=v_group.id
        and policy.authority_mode='SOURCE_AUTHORITY'
        and (v_client_id is null or policy.client_id=v_client_id)
        and v_cycle.finalisation_week_ending between policy.effective_from and coalesce(policy.effective_to,'infinity'::date)),
    'recheck_payload',coalesce(v_recheck_action,'{}'::jsonb),
    'profile',pg_catalog.jsonb_build_object(
      'id',private.weekly_source_configured_upload_profile_v1(v_client_id,v_cycle.id,v_group.source_family,v_profile.profile_code),
      'label',case when v_group.source_family='NHSP' then 'NHSP' else v_group.display_name end,
      'finalise_label',case when v_group.source_family='NHSP' then 'Finalise report' else 'Finalise source' end),
    'context',pg_catalog.jsonb_build_object('subtitle',case when v_group.source_family='NHSP' then
        'NHSP'||case when v_context_client_name is null then '' else ' · '||v_context_client_name end
      else v_cycle_label end,'cycle_state',v_cycle_state_label,
      'cycle_tone',v_cycle_state_tone,'controls',v_controls),
    'selected',pg_catalog.jsonb_build_object('source_group_id',v_group.id,'source_cycle_id',v_cycle.id,
      'client_id',v_client_id,'report_scope_id',v_report_scope_id,'projection_publication_id',v_publication_id),
    'counts',pg_catalog.jsonb_build_object('queries',v_query_count,'blockers',v_blocker_count,
      'paid_unresolved',v_paid_unresolved_count),
    'imports',v_imports,'queries',v_queries||pg_catalog.jsonb_build_object(
      'protected_shifts',private.weekly_source_protected_query_rows_v1(v_group.id,v_client_id,
        private.weekly_source_pay_actor_allowed_v1(v_actor)),
      'protected_pay_enabled',private.weekly_source_pay_actor_allowed_v1(v_actor)
        and exists(select 1 from public.weekly_source_client_policies policy
          where policy.source_group_id=v_group.id and policy.authority_mode='SOURCE_AUTHORITY'
            and (v_client_id is null or policy.client_id=v_client_id)
            and v_cycle.finalisation_week_ending between policy.effective_from and coalesce(policy.effective_to,'infinity'::date))),
    'finalise',pg_catalog.jsonb_build_object(
      'prepared',v_import_prepared,'prepare_action',v_prepare_action,
      'unfinalised_count',v_unfinalised_count,
      'excluded_rows',v_excluded_rows,
      'exclusion_confirmation',case when v_unfinalised_count>0 and v_profile.profile_code in
        ('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1')
        then 'I confirm that non-finalised shifts are excluded. Previously finalised shifts now missing or non-finalised within this file period may be reversed.' else null end,
      'ready',v_ready,'blocked',v_blocked,'complete',v_complete,
      'active_list',case when v_blocker_count>0 then 'blocked'
        when (v_ready->>'total_count')::integer=0 and (v_complete->>'total_count')::integer>0 then 'complete' else 'ready' end,
      'confirmation_text','I confirm this is the final source for this week.',
      'confirmation_required',true,'finalise_enabled',v_finalise_enabled,
      'finalise_payload',v_finalise_payload,
      'rate_warnings',v_rate_warnings,
      'approved_hours_follow_up',v_finalise_pay_follow_up,
      'source_summary',case when v_publication_id is null then 'Upload a source file to continue.'
        else v_upload.original_filename end,'tracker',v_tracker),
    'history',v_history,'notices','[]'::jsonb,
    -- Gate 9 G9-1, workspace half.  The workspace serves the complete
    -- server-owned lifecycle vocabulary -- all 22 rows, with their exact
    -- headings, statuses, permitted new actions and forbidden inferences -- so
    -- that no Office surface ever hard-codes a lifecycle heading and no browser
    -- has to map a state to one.  The PER-TIMESHEET phase is not computed here:
    -- it is one read per Timesheet from the named owner below, which is what
    -- the Simple Timesheet and the Bulk right pane already call.
    'lifecycle_policy',private.weekly_source_office_lifecycle_policy_v1()
      ||pg_catalog.jsonb_build_object(
        'per_timesheet_owner','public.weekly_source_office_timesheet_presentation_v1',
        'per_timesheet_member','lifecycle',
        'browser_may_infer_phase',false)
  );
  if v_pay_view then
    v_result:=v_result-array['imports','finalise','history','recheck_payload','lifecycle_policy'];
    v_result:=jsonb_set(v_result,'{context,controls}','{}'::jsonb,false)
      ||jsonb_build_object('permissions',jsonb_build_object(
        'contract','WEEKLY_SOURCE_PAYMENT_VIEW_V1','view','PAY',
        'allowed_tabs',jsonb_build_array('queries'),
        'allowed_sections',jsonb_build_array('questions','checks','protected'),
        'landing_tab','queries','can_upload',false,'can_finalise',false,'can_manage_settings',false,
        'checklist',jsonb_build_object('available',false,'read_only',true,'pay_only',true,'action_links',false)));
  end if;
  return v_result;
exception
  when invalid_text_representation or numeric_value_out_of_range or datetime_field_overflow then
    raise exception 'WEEKLY_SOURCE_WORKSPACE_REQUEST_INVALID' using errcode='22023';
end;
$function$;

create or replace function private.weekly_source_paid_match_correction_scope_v1(
  p_upload_id uuid,p_actor_user_id uuid,p_confirm boolean default false
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_upload public.weekly_source_uploads%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_session public.weekly_final_source_correction_sessions%rowtype;
  v_revision public.weekly_source_final_revisions%rowtype;
  v_prior_upload public.weekly_source_uploads%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_client uuid;v_result jsonb;v_scope public.weekly_source_report_scopes%rowtype;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_upload_id is null or p_actor_user_id is null or p_confirm is null then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_INVALID' using errcode='22023';end if;
  select * into strict v_upload from public.weekly_source_uploads where id=p_upload_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_upload.source_cycle_id;
  select * into v_session from public.weekly_final_source_correction_sessions where id=v_upload.correction_session_id;
  if v_upload.report_scope_id is not null then
    select * into strict v_scope from public.weekly_source_report_scopes where id=v_upload.report_scope_id;
    if not found or v_upload.purpose is distinct from 'FINAL_SOURCE_CORRECTION'
      or v_upload.state is distinct from 'CORRECTION_READY'
      or v_session.id is null or v_session.source_cycle_id is distinct from v_cycle.id
      or v_session.authority_scope_kind is distinct from 'NHSP_REPORT_SCOPE'
      or v_session.report_scope_id is distinct from v_scope.id
      or v_session.replacement_correction_upload_id is distinct from v_upload.id
      or v_session.actor_user_id is distinct from p_actor_user_id
      or v_session.state not in ('READY','REVIEWED','PREPARING','PREPARED','COMMITTING')
      or (p_confirm and v_session.state is distinct from 'REVIEWED')
      or v_scope.state not in ('FINALISED','CORRECTION_IN_PROGRESS')
      or v_scope.source_cycle_id is distinct from v_cycle.id
      or v_scope.source_group_id is distinct from v_cycle.source_group_id or v_scope.self_bill_report_id is not null
      or v_scope.current_final_revision_id is distinct from v_session.expected_current_final_revision_id
      or not exists(select 1 from public.weekly_source_groups g
        where g.id=v_cycle.source_group_id and g.active and g.source_family='NHSP')
      or not exists(select 1 from public.weekly_source_format_profiles profile
        where profile.id=v_upload.source_format_profile_id and profile.active and profile.profile_code='NHSP_FINAL_BACKING_V1') then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
    select * into strict v_revision from public.weekly_source_final_revisions where id=v_session.expected_current_final_revision_id;
    select * into strict v_prior_upload from public.weekly_source_uploads where id=v_revision.upload_id;
    if v_revision.state is distinct from 'CURRENT' or v_revision.authority_scope_kind is distinct from 'NHSP_REPORT_SCOPE'
      or v_revision.report_scope_id is distinct from v_scope.id or v_revision.source_cycle_id is distinct from v_cycle.id
      or v_revision.manifest_hash is distinct from v_session.expected_final_manifest_hash
      or v_prior_upload.state is distinct from 'CURRENT' or v_prior_upload.purpose not in ('ORDINARY','FINAL_SOURCE_CORRECTION')
      or v_prior_upload.report_scope_id is distinct from v_scope.id
      or v_prior_upload.source_format_profile_id is distinct from v_upload.source_format_profile_id
      or v_scope.current_complete_upload_id is distinct from v_prior_upload.id
      or v_prior_upload.declared_scope_fingerprint is distinct from v_upload.declared_scope_fingerprint then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
    select * into strict v_publication from public.weekly_source_projection_publications where id=v_scope.current_projection_publication_id;
    if v_publication.state is distinct from 'CURRENT' or v_publication.upload_id is distinct from v_prior_upload.id
      or v_publication.source_cycle_id is distinct from v_cycle.id or v_publication.authority_scope_kind is distinct from 'NHSP_REPORT_SCOPE'
      or v_publication.report_scope_id is distinct from v_scope.id
      or (v_prior_upload.purpose='ORDINARY' and v_publication.correction_session_id is not null)
      or (v_prior_upload.purpose='FINAL_SOURCE_CORRECTION' and not exists(
        select 1 from public.weekly_final_source_correction_sessions prior_session
        where prior_session.id=v_prior_upload.correction_session_id and prior_session.id=v_publication.correction_session_id
          and prior_session.applied_final_revision_id=v_revision.id and prior_session.state='APPLIED')) then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
    v_client:=v_scope.client_id;
    if nullif(v_upload.file_metadata_json->>'client_id','')::uuid is distinct from v_client then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
    perform private.weekly_source_office_authority_v1(p_actor_user_id,'CORRECT_FINAL_SOURCE',
      v_cycle.source_group_id,v_client,v_cycle.finalisation_week_ending);
    if v_session.replacement_projection_publication_id is not null then
      select * into strict v_publication from public.weekly_source_projection_publications where id=v_session.replacement_projection_publication_id;
      if v_publication.state not in ('BUILDING','CORRECTION_READY')
        or (p_confirm and v_publication.state<>'CORRECTION_READY')
        or (v_publication.state='BUILDING' and v_session.state<>'READY')
        or v_publication.upload_id is distinct from v_upload.id or v_publication.source_cycle_id is distinct from v_cycle.id
        or v_publication.authority_scope_kind is distinct from 'NHSP_REPORT_SCOPE'
        or v_publication.report_scope_id is distinct from v_scope.id
        or v_publication.correction_session_id is distinct from v_session.id
        or v_publication.authority_scope_version is distinct from v_scope.version then
        raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
    elsif v_session.state is distinct from 'READY' then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
    if v_session.state='REVIEWED' and (v_session.review_result_json is null
      or v_session.review_result_hash is distinct from private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_CORRECT_FINAL_REVIEW_RESULT_V1',v_session.review_result_json)) then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
    -- Stable subject identity only. Every mutable session/publication/scope
    -- gate above is re-read; none is relabelled as immutable financial facts.
    v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_V1',
      'correction_session_id',v_session.id,'source_cycle_id',v_cycle.id,'source_group_id',v_cycle.source_group_id,
      'client_id',v_client,'upload_id',v_upload.id,'actor_user_id',p_actor_user_id,
      'prior_final_revision_id',v_revision.id,'prior_final_manifest_hash',encode(v_revision.manifest_hash,'hex'),
      'prior_upload_id',v_prior_upload.id,'source_format_profile_id',v_upload.source_format_profile_id,
      'row_manifest_hash',encode(v_upload.row_manifest_hash,'hex'),'report_scope_id',v_scope.id,
      'authority_scope_kind','NHSP_REPORT_SCOPE');
    return v_result||jsonb_build_object('scope_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_V1',v_result),'hex'));
  end if;
  if not found or v_upload.purpose is distinct from 'FINAL_SOURCE_CORRECTION'
    or v_upload.state is distinct from 'CORRECTION_READY' or v_upload.report_scope_id is not null
    or v_session.source_cycle_id is distinct from v_cycle.id
    or v_session.authority_scope_kind is distinct from 'CYCLE' or v_session.report_scope_id is not null
    or v_session.replacement_correction_upload_id is distinct from v_upload.id
    or v_session.actor_user_id is distinct from p_actor_user_id
    or v_session.state not in ('READY','REVIEWED','PREPARING','PREPARED','COMMITTING')
    or (p_confirm and v_session.state is distinct from 'REVIEWED')
    or v_cycle.state is distinct from 'FINALISED'
    or v_cycle.current_final_revision_id is distinct from v_session.expected_current_final_revision_id then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
  select * into strict v_revision from public.weekly_source_final_revisions where id=v_session.expected_current_final_revision_id;
  select * into strict v_prior_upload from public.weekly_source_uploads where id=v_revision.upload_id;
  if v_revision.state is distinct from 'CURRENT' or v_revision.authority_scope_kind is distinct from 'CYCLE'
    or v_revision.report_scope_id is not null or v_revision.source_cycle_id is distinct from v_cycle.id
    or v_revision.manifest_hash is distinct from v_session.expected_final_manifest_hash
    or v_prior_upload.state is distinct from 'CURRENT'
    or v_cycle.current_complete_upload_id is distinct from v_prior_upload.id
    or v_prior_upload.declared_scope_fingerprint is distinct from v_upload.declared_scope_fingerprint then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
  select * into strict v_publication from public.weekly_source_projection_publications where id=v_cycle.current_projection_publication_id;
  if v_publication.state is distinct from 'CURRENT' or v_publication.upload_id is distinct from v_prior_upload.id
    or v_publication.source_cycle_id is distinct from v_cycle.id or v_publication.authority_scope_kind is distinct from 'CYCLE'
    or v_publication.report_scope_id is not null or v_publication.correction_session_id is not null then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
  select manifest.client_id into strict v_client from public.weekly_source_client_manifests manifest
    where manifest.final_revision_id=v_revision.id and coalesce(manifest.invoice_window_cycle_id,manifest.source_cycle_id)=manifest.source_cycle_id;
  if nullif(v_upload.file_metadata_json->>'client_id','')::uuid is distinct from v_client then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'CORRECT_FINAL_SOURCE',
    v_cycle.source_group_id,v_client,v_cycle.finalisation_week_ending);
  if v_session.replacement_projection_publication_id is not null then
    select * into strict v_publication from public.weekly_source_projection_publications where id=v_session.replacement_projection_publication_id;
    if v_publication.state is distinct from 'CORRECTION_READY'
      or v_publication.upload_id is distinct from v_upload.id or v_publication.source_cycle_id is distinct from v_cycle.id
      or v_publication.authority_scope_kind is distinct from 'CYCLE' or v_publication.report_scope_id is not null
      or v_publication.correction_session_id is distinct from v_session.id
      or v_publication.authority_scope_version is distinct from v_cycle.version then
      raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
  elsif v_session.state is distinct from 'READY' then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
  if v_session.state='REVIEWED' and (v_session.review_result_json is null
    or v_session.review_result_hash is distinct from private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_CORRECT_FINAL_REVIEW_RESULT_V1',v_session.review_result_json)) then
    raise exception 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_STALE' using errcode='40001';end if;
  -- Session state/version and the replacement comparison pointer legitimately
  -- advance at native rebuild/prepare. They are validated above, but are not
  -- invented economic changes in the immutable choice's facts fingerprint.
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_V1',
    'correction_session_id',v_session.id,'source_cycle_id',v_cycle.id,'source_group_id',v_cycle.source_group_id,
    'client_id',v_client,'upload_id',v_upload.id,'actor_user_id',p_actor_user_id,
    'prior_final_revision_id',v_revision.id,'prior_final_manifest_hash',encode(v_revision.manifest_hash,'hex'),
    'prior_upload_id',v_prior_upload.id,'source_format_profile_id',v_upload.source_format_profile_id,
    'row_manifest_hash',encode(v_upload.row_manifest_hash,'hex'));
  return v_result||jsonb_build_object('scope_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_V1',v_result),'hex'));
end;
$function$;

create or replace function private.weekly_source_correct_final_office_preview_v1(
  p_correction_session_id uuid
) returns jsonb
language plpgsql stable security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_session public.weekly_final_source_correction_sessions%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_prior_revision public.weekly_source_final_revisions%rowtype;
  v_prior_profile public.weekly_source_format_profiles%rowtype;
  v_changes jsonb:='[]'::jsonb;
  v_blockers jsonb:='[]'::jsonb;
  v_confirmation text;
  v_old_report text;
  v_preview jsonb;v_paid_questions jsonb:='[]'::jsonb;
begin
  if exists(select 1 from public.weekly_final_source_correction_sessions c where c.id=p_correction_session_id and c.authority_scope_kind='SELF_BILL_REPORT_SCOPE') then
    raise exception 'WEEKLY_SOURCE_SELF_BILL_REPORT_CORRECT_FINAL_UNSUPPORTED' using errcode='55000';
  end if;
  select * into v_session
  from public.weekly_final_source_correction_sessions
  where id=p_correction_session_id;
  if not found or v_session.state not in ('READY','REVIEWED','PREPARING','PREPARED','COMMITTING','APPLIED')
     or v_session.replacement_correction_upload_id is null
     or v_session.replacement_projection_publication_id is null then
    raise exception 'WEEKLY_SOURCE_CORRECTION_PREVIEW_NOT_READY' using errcode='55000';
  end if;
  select * into strict v_publication
  from public.weekly_source_projection_publications
  where id=v_session.replacement_projection_publication_id;
  select * into strict v_prior_revision
  from public.weekly_source_final_revisions
  where id=v_session.expected_current_final_revision_id;
  select profile.* into strict v_prior_profile
  from public.weekly_source_uploads upload_row
  join public.weekly_source_format_profiles profile
    on profile.id=upload_row.source_format_profile_id
  where upload_row.id=v_prior_revision.upload_id;

  select coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
    'candidate',coalesce(candidate.display_name,source_row.source_candidate_identity,'Candidate'),
    'day_date',to_char(source_row.work_date,'Dy FMDD Mon YYYY'),
    'problem',case
      when resolution.id is null then 'This row has not been linked yet'
      when resolution.mapping_state='CANDIDATE_NOT_FOUND' then 'Candidate could not be found'
      when resolution.mapping_state='CLIENT_NOT_FOUND' then 'Client could not be found'
      when resolution.mapping_state='NO_ELIGIBLE_CONTRACT' then 'No matching contract'
      when resolution.mapping_state in ('AMBIGUOUS_CONTRACT','CONTRACT_SELECTION_REQUIRED')
        then 'More than one contract matches'
      when source_row.row_finalisation_state='SOURCE_UNFINALISED' then 'This shift is not finalised'
      when charge.phase_severity='FINALISATION_BLOCKER' then 'Check the charge for this shift'
      else 'Check the hours for this shift' end,
    'action',case
      when resolution.mapping_state='CANDIDATE_NOT_FOUND' then 'Link candidate'
      when resolution.mapping_state='CLIENT_NOT_FOUND' then 'Link client'
      when resolution.mapping_state in ('NO_ELIGIBLE_CONTRACT','AMBIGUOUS_CONTRACT','CONTRACT_SELECTION_REQUIRED')
        then 'Choose contract'
      when charge.phase_severity='FINALISATION_BLOCKER' then 'Open charge details'
      else 'View details' end
  ) order by source_row.work_date,source_row.source_candidate_identity,source_row.source_row_ordinal),'[]'::jsonb)
  into v_blockers
  from public.weekly_source_upload_rows source_row
  left join public.weekly_source_row_resolutions resolution
    on resolution.upload_row_id=source_row.id
   and resolution.generation=coalesce(
     v_publication.projection_generation,
     v_publication.authority_scope_version::integer
   )
  left join public.candidates candidate on candidate.id=resolution.candidate_id
  left join public.weekly_source_charge_checks charge
    on charge.upload_row_id=source_row.id
   and charge.row_resolution_id=resolution.id
   and charge.generation=coalesce(
     v_publication.projection_generation,
     v_publication.authority_scope_version::integer
   )
  where source_row.upload_id=v_session.replacement_correction_upload_id
    and (
      resolution.id is null or resolution.mapping_state<>'RESOLVED'
      or source_row.row_finalisation_state in (
        'SOURCE_UNFINALISED','BLOCK_FINALISATION_DISAGREEMENT','BLOCK_ACTUAL_TUPLE'
      )
      or charge.phase_severity='FINALISATION_BLOCKER'
    );

  if v_session.authority_scope_kind='CYCLE' and v_session.state in ('READY','REVIEWED')
    and exists(select 1 from public.weekly_source_cycles cycle join public.weekly_source_groups source_group
      on source_group.id=cycle.source_group_id and source_group.source_family='ROSTER'
      where cycle.id=v_session.source_cycle_id) then
    select coalesce(jsonb_agg(jsonb_build_object(
      'candidate',coalesce(candidate.display_name,source_row.source_candidate_identity,'Candidate'),
      'client',coalesce(client.name,'Client'),'shift',to_char(source_row.work_date,'Dy FMDD Mon YYYY'),
      'system_hours',to_char(source_row.start_at_local,'HH24:MI')||'-'||to_char(source_row.end_at_local,'HH24:MI')
        ||case when source_row.break_minutes is null then ' (break not recorded)'
          else ' ('||source_row.break_minutes::text||' min break)' end,
      'paid_match_question',question.value) order by source_row.source_row_ordinal,source_row.id),'[]'::jsonb)
    into v_paid_questions
    from public.weekly_source_upload_rows source_row
    join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=source_row.id
      and resolution.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version::integer)
    left join public.candidates candidate on candidate.id=resolution.candidate_id
    left join public.clients client on client.id=resolution.client_id
    cross join lateral(select private.weekly_source_paid_match_question_v1(
      v_publication.id,source_row.id,v_session.actor_user_id) value) question
    where source_row.upload_id=v_session.replacement_correction_upload_id
      and resolution.blocker_code='PAID_SHIFT_OVERLAP_CONFIRMATION_REQUIRED'
      and question.value->>'state'='READY';
  end if;
  if pg_catalog.jsonb_array_length(v_blockers)=0 then
    if v_prior_profile.final_authority_kind='NHSP_TRUST_BACKING_REPORT' then
      with prior_rows as (
        select movement.work_event_id,movement.source_line_kind,movement.candidate_id,
               movement.source_facts_json prior_facts,
               -- WP-54.  The money this line currently puts on the self-bill.
               -- Pack 14 section 4.3.1: for NHSP "The validated source total is
               -- the invoice value", and that is what this column holds.
               movement.invoice_presentation_charge_pence prior_charge_pence,
               pg_catalog.row_number() over(
                 partition by movement.work_event_id,movement.source_line_kind
                 order by source_row.source_row_ordinal,movement.id
               ) as row_number
        from public.weekly_source_billing_movements movement
        join public.weekly_source_upload_rows source_row
          on source_row.id=movement.nhsp_upload_row_id
        where movement.final_revision_id=v_session.expected_current_final_revision_id
      ), replacement_rows as (
        select resolution.work_event_id,
               case when economic.row_sign=1 then 'NHSP_PHYSICAL_POSITIVE'
                    else 'NHSP_PHYSICAL_FULL_NEGATIVE' end source_line_kind,
               resolution.candidate_id,
               pg_catalog.jsonb_build_object(
                 'work_date',source_row.work_date,
                 'start_at_local',source_row.start_at_local,
                 'end_at_local',source_row.end_at_local,
                 'break_minutes',source_row.break_minutes
               ) replacement_facts,
               -- WP-54.  The money the replacement line would put on the
               -- self-bill: the signed Commission + Total Cost the replacement
               -- report supplies, which pack 14 section 4.3.1 makes the invoice
               -- value once the server's own comparison has passed.
               source_row.source_shift_charge_pence replacement_charge_pence,
               pg_catalog.row_number() over(
                 partition by resolution.work_event_id,
                   case when economic.row_sign=1 then 'NHSP_PHYSICAL_POSITIVE'
                        else 'NHSP_PHYSICAL_FULL_NEGATIVE' end
                 order by source_row.source_row_ordinal,resolution.id
               ) as row_number
        from public.weekly_source_upload_rows source_row
        join public.weekly_source_row_resolutions resolution
          on resolution.upload_row_id=source_row.id
         and resolution.generation=coalesce(
           v_publication.projection_generation,
           v_publication.authority_scope_version::integer
         )
         and resolution.mapping_state='RESOLVED'
        join public.weekly_source_row_economic_snapshots economic
          on economic.row_resolution_id=resolution.id
        where source_row.upload_id=v_session.replacement_correction_upload_id
      ), paired as (
        select coalesce(replacement.work_event_id,prior.work_event_id) work_event_id,
               coalesce(replacement.source_line_kind,prior.source_line_kind) source_line_kind,
               coalesce(replacement.candidate_id,prior.candidate_id) candidate_id,
               prior.prior_facts,replacement.replacement_facts,
               prior.prior_charge_pence,replacement.replacement_charge_pence
        from prior_rows prior
        full join replacement_rows replacement
          on replacement.work_event_id=prior.work_event_id
         and replacement.source_line_kind=prior.source_line_kind
         and replacement.row_number=prior.row_number
      ), presented as (
        select paired.*,candidate.display_name,
          coalesce(replacement_facts->>'work_date',prior_facts->>'work_date') work_date,
          case when prior_facts is null then 'Not present' else
            to_char((prior_facts->>'start_at_local')::timestamp,'HH24:MI')||'-'||
            to_char((prior_facts->>'end_at_local')::timestamp,'HH24:MI')||' ('||
            coalesce(prior_facts->>'break_minutes','0')||' min break)' end current_final,
          case when replacement_facts is null then 'Not present' else
            to_char((replacement_facts->>'start_at_local')::timestamp,'HH24:MI')||'-'||
            to_char((replacement_facts->>'end_at_local')::timestamp,'HH24:MI')||' ('||
            coalesce(replacement_facts->>'break_minutes','0')||' min break)' end replacement,
          -- WP-54.  The same two lines expressed as money.  The preview
          -- compared the formatted TIME only, so a report that repriced every
          -- line produced changes=[] and the confirmation the Office signed --
          -- and the preview_hash that binds it -- covered an empty list.
          -- Pack 24 section 7 requires Office to see the exact consequence it
          -- is confirming; pack 14 section 4.3.1 makes this figure the invoice
          -- value.  The DECISION below compares exact signed pence; only the
          -- display is formatted.
          case when paired.prior_charge_pence is null then 'Not present'
               else private.weekly_source_office_money_text_v1(paired.prior_charge_pence::numeric/100)
          end current_final_amount,
          case when paired.replacement_charge_pence is null then 'Not present'
               else private.weekly_source_office_money_text_v1(paired.replacement_charge_pence::numeric/100)
          end replacement_amount,
          case when prior_facts is null then 'Added'
               when replacement_facts is null then 'Removed'
               else 'Changed' end result
        from paired
        left join public.candidates candidate on candidate.id=paired.candidate_id
      )
      select coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
        'candidate',coalesce(display_name,'Candidate'),
        'day_date',to_char(work_date::date,'Dy FMDD Mon YYYY'),
        'current_final',current_final,'replacement',replacement,
        'current_final_amount',current_final_amount,
        'replacement_amount',replacement_amount,
        'amount_changed',prior_charge_pence is distinct from replacement_charge_pence,
        'result',result
      ) order by work_date,coalesce(display_name,''),work_event_id),'[]'::jsonb)
      into v_changes
      from presented
      where current_final is distinct from replacement
         or prior_charge_pence is distinct from replacement_charge_pence;
    else
      with prior_rows as (
        select snapshot.work_event_id,snapshot.candidate_id,snapshot.work_date,
               snapshot.start_at_local,snapshot.end_at_local,snapshot.break_minutes,
               -- WP-54.  The same blindness the NHSP branch had: this preview
               -- compared work date, times and break only.  On this route the
               -- money is the server's own calculation, so it moves when the
               -- Contract or the rate policy behind the row moves even though
               -- every displayed time is identical.  LEFT join: a row with no
               -- economic snapshot keeps its place in the pairing and simply
               -- carries no amount.
               prior_economic.calculated_charge_pence prior_charge_pence
        from public.weekly_source_final_snapshot_lines snapshot
        left join public.weekly_source_row_economic_snapshots prior_economic
          on prior_economic.row_resolution_id=snapshot.row_resolution_id
        where snapshot.final_revision_id=v_session.expected_current_final_revision_id
      ), replacement_rows as (
        select resolution.work_event_id,resolution.candidate_id,source_row.work_date,
               source_row.start_at_local,source_row.end_at_local,source_row.break_minutes,
               replacement_economic.calculated_charge_pence replacement_charge_pence
        from public.weekly_source_upload_rows source_row
        join public.weekly_source_row_resolutions resolution
          on resolution.upload_row_id=source_row.id
         and resolution.generation=coalesce(
           v_publication.projection_generation,
           v_publication.authority_scope_version::integer
         )
         and resolution.mapping_state='RESOLVED'
        left join public.weekly_source_row_economic_snapshots replacement_economic
          on replacement_economic.row_resolution_id=resolution.id
        where source_row.upload_id=v_session.replacement_correction_upload_id
          and (
            source_row.row_finalisation_state='SOURCE_WORKED'
            or (v_prior_profile.final_authority_kind='GENERIC_COMPLETE_SNAPSHOT'
                and source_row.row_finalisation_state='NOT_APPLICABLE')
          )
      ), paired as (
        select coalesce(replacement.work_event_id,prior.work_event_id) work_event_id,
               coalesce(replacement.candidate_id,prior.candidate_id) candidate_id,
               prior.work_date prior_date,prior.start_at_local prior_start,
               prior.end_at_local prior_end,prior.break_minutes prior_break,
               prior.prior_charge_pence,
               replacement.work_date replacement_date,
               replacement.start_at_local replacement_start,
               replacement.end_at_local replacement_end,
               replacement.break_minutes replacement_break,
               replacement.replacement_charge_pence
        from prior_rows prior
        full join replacement_rows replacement using(work_event_id)
      )
      select coalesce(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
        'candidate',coalesce(candidate.display_name,'Candidate'),
        'day_date',to_char(coalesce(paired.replacement_date,paired.prior_date),'Dy FMDD Mon YYYY'),
        'current_final',case when paired.prior_date is null then 'Not present' else
          to_char(paired.prior_start,'HH24:MI')||'-'||to_char(paired.prior_end,'HH24:MI')||
          ' ('||paired.prior_break||' min break)' end,
        'replacement',case when paired.replacement_date is null then 'Not present' else
          to_char(paired.replacement_start,'HH24:MI')||'-'||to_char(paired.replacement_end,'HH24:MI')||
          ' ('||paired.replacement_break||' min break)' end,
        'current_final_amount',case when paired.prior_charge_pence is null then 'Not present'
          else private.weekly_source_office_money_text_v1(
            paired.prior_charge_pence::numeric/100) end,
        'replacement_amount',case when paired.replacement_charge_pence is null then 'Not present'
          else private.weekly_source_office_money_text_v1(
            paired.replacement_charge_pence::numeric/100) end,
        'amount_changed',paired.prior_charge_pence is distinct from paired.replacement_charge_pence,
        'result',case when paired.prior_date is null then 'Added'
          when paired.replacement_date is null then 'Removed' else 'Changed' end
      ) order by coalesce(paired.replacement_date,paired.prior_date),
        coalesce(candidate.display_name,''),paired.work_event_id),'[]'::jsonb)
      into v_changes
      from paired
      left join public.candidates candidate on candidate.id=paired.candidate_id
      -- WP-54: money joins date, times and break in the comparison, so a
      -- correction that moves only the figure can no longer present the Office
      -- with an empty change list.
      where pg_catalog.jsonb_build_array(
              paired.prior_date,paired.prior_start,paired.prior_end,paired.prior_break
            ) is distinct from pg_catalog.jsonb_build_array(
              paired.replacement_date,paired.replacement_start,
              paired.replacement_end,paired.replacement_break
            )
         or paired.prior_charge_pence is distinct from paired.replacement_charge_pence;
    end if;
  end if;

  if v_session.authority_scope_kind='NHSP_REPORT_SCOPE' then
    select backing.backing_report_number into strict v_old_report
    from public.weekly_source_nhsp_backing_reports backing
    where backing.final_revision_id=v_session.expected_current_final_revision_id;
    v_confirmation:='I understand this will replace report '||v_old_report||
      ' as the final report for this Trust and cutoff.';
  else
    v_confirmation:='I understand this will replace the final version for this group and week.';
  end if;
  v_preview:=pg_catalog.jsonb_build_object(
    'changes',v_changes,'blockers',v_blockers,'confirmation_text',v_confirmation
  );
  if jsonb_array_length(v_paid_questions)>0 then
    v_preview:=v_preview||jsonb_build_object('paid_match_questions',v_paid_questions);
  end if;
  return v_preview||pg_catalog.jsonb_build_object(
    'preview_hash',pg_catalog.encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_CORRECT_FINAL_OFFICE_PREVIEW_V1',v_preview
    ),'hex')
  );
end;
$function$;

create or replace function private.weekly_source_roster_prior_states_v1(
  p_source_group_id uuid,p_client_id uuid,p_source_profile_kind text,p_before_week_ending date
) returns table(work_event_id uuid,snapshot_line_id uuid,transition_id uuid,final_revision_id uuid)
language sql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
        select distinct on (prior_transition.work_event_id)
               prior_transition.work_event_id,
               coalesce(prior_transition.new_snapshot_line_id,
                 case when prior_transition.exclude_cancel then prior_transition.previous_snapshot_line_id end)
                 as snapshot_line_id,
               prior_transition.id as transition_id,prior_transition.final_revision_id
        from public.weekly_source_state_transitions prior_transition
        join public.weekly_source_final_revisions prior_revision
          on prior_revision.id=prior_transition.final_revision_id
         and prior_revision.state='CURRENT'
        join public.weekly_source_cycles prior_cycle
          on prior_cycle.id=prior_transition.finalisation_cycle_id
        join public.weekly_source_client_manifests prior_manifest
          on coalesce(prior_manifest.invoice_window_cycle_id,prior_manifest.source_cycle_id)=prior_manifest.source_cycle_id and prior_manifest.final_revision_id=prior_revision.id
         and prior_manifest.client_id=p_client_id
        where prior_transition.source_profile_kind=p_source_profile_kind
          and prior_cycle.source_group_id=p_source_group_id
          and prior_cycle.finalisation_week_ending<p_before_week_ending
        order by prior_transition.work_event_id,
                 prior_cycle.finalisation_week_ending desc,
                 prior_revision.finalised_at_utc desc,
                 prior_revision.revision_number desc,
                 prior_transition.created_at_utc desc,
                 prior_transition.id desc

;
$function$;

create or replace function private.weekly_source_legacy_signed_source_membership_v1(
  p_root_timesheet_id uuid,p_work_event_id uuid,p_actor_user_id uuid,p_source_cycle_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  event public.weekly_work_events%rowtype;cycle public.weekly_source_cycles%rowtype;
  snapshot public.pay_batch_timesheet_snapshots%rowtype;history public.timesheet_pay_state_history%rowtype;
  native_allocation jsonb;native_census jsonb;settlement jsonb;component jsonb;segment jsonb;
  roots uuid[];native_items uuid[];signed_items uuid[];proofs jsonb:='[]'::jsonb;
  component_row record;item public.pay_batch_items%rowtype;v_count integer;v_members jsonb;
  v_result jsonb;v_reason text;v_current_financial jsonb;v_member jsonb;v_member_event uuid;v_member_movement uuid;v_module jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict event from public.weekly_work_events where id=p_work_event_id;
  select * into strict cycle from public.weekly_source_cycles where id=p_source_cycle_id;
  if p_actor_user_id is null or cycle.source_group_id is distinct from event.first_source_group_id
    or (cycle.scope_client_id is not null and cycle.scope_client_id is distinct from event.client_id)
    or not exists(select 1 from public.weekly_source_groups g where g.id=cycle.source_group_id and g.source_family='ROSTER') then
    raise exception 'WEEKLY_SOURCE_LEGACY_MEMBERSHIP_SCOPE_INVALID' using errcode='42501';end if;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
    event.first_source_group_id,event.client_id,cycle.finalisation_week_ending);
  select coalesce(array_agg(distinct s.family_timesheet_id order by s.family_timesheet_id),'{}'::uuid[]) into roots
    from public._pay_timesheet_rotation_scope(array[p_root_timesheet_id]) s;
  if cardinality(roots)=0 or cardinality(roots)>200 or not exists(
    select 1 from public.weekly_source_row_timesheet_lineages l join public.contracts c on c.id=l.contract_id
      join public.timesheets ts on ts.timesheet_id=l.timesheet_id
    where l.timesheet_id=any(roots) and l.work_event_id=event.id
      and (l.candidate_id,l.client_id)=(event.candidate_id,event.client_id)
      and (c.candidate_id,c.client_id)=(event.candidate_id,event.client_id)
      and ts.contract_id=c.id and ts.booking_id=l.family_booking_id) then
    raise exception 'WEEKLY_SOURCE_LEGACY_MEMBERSHIP_LINEAGE_UNBOUND' using errcode='55000';end if;
  native_allocation:=private.weekly_source_settlement_allocation_v1(p_root_timesheet_id);
  native_census:=private.weekly_source_freeze_census_v1(event.candidate_id,roots);
  select to_jsonb(m) into v_module from private.bpay_next_module_control m where m.id=1;
  if v_module->>'active_owner' is distinct from 'LEGACY'
    or native_allocation->>'state' is distinct from 'AVAILABLE'
    or native_allocation->'settlement_count' is distinct from '1'::jsonb
    or native_census->>'result' is distinct from 'RELEASABLE'
    or native_census->'errors' is distinct from '[]'::jsonb
    or native_census->'member_candidate_unknown_timesheet_ids' is distinct from '[]'::jsonb
    or array(select value::uuid from jsonb_array_elements_text(native_allocation->'member_timesheet_ids') value order by value::uuid)
      is distinct from roots
    or array(select value::uuid from jsonb_array_elements_text(native_census->'member_timesheet_ids') value order by value::uuid)
      is distinct from roots then
    v_reason:='NATIVE_SETTLEMENT_SCOPE_UNAVAILABLE';
  else
    select value into strict settlement from jsonb_array_elements(native_allocation->'settlements');
    select * into strict snapshot from public.pay_batch_timesheet_snapshots where id=(settlement->>'snapshot_id')::uuid;
    select * into strict history from public.timesheet_pay_state_history where id=(settlement->>'history_id')::uuid;
    if snapshot.pay_batch_id::text is distinct from settlement->>'pay_batch_id'
      or snapshot.timesheet_id::text is distinct from settlement->>'timesheet_id'
      or snapshot.candidate_id is distinct from event.candidate_id
      or history.pay_batch_id is distinct from snapshot.pay_batch_id or history.timesheet_id is distinct from snapshot.timesheet_id
      or snapshot.signature is distinct from history.signature or snapshot.target_snapshot_json is distinct from history.snapshot_json
      or snapshot.signature is distinct from md5(snapshot.target_snapshot_json::text)
      or jsonb_typeof(snapshot.target_snapshot_json->'resolved_components') is distinct from 'array' then
      v_reason:='SIGNED_COMPONENT_CENSUS_UNAVAILABLE';
    else
      select coalesce(array_agg(i.id order by i.id),'{}'::uuid[]) into native_items
        from public.pay_batch_items i join public.pay_batch_candidates c on c.id=i.pay_batch_candidate_id
        where c.pay_batch_id=snapshot.pay_batch_id and c.candidate_id=event.candidate_id
          and i.timesheet_id=snapshot.timesheet_id and i.pay_channel=snapshot.pay_channel and not coalesce(i.is_voided,false);
      select coalesce(array_agg((x->>'pay_batch_item_id')::uuid order by (x->>'pay_batch_item_id')::uuid),'{}'::uuid[]) into signed_items
        from jsonb_array_elements(snapshot.target_snapshot_json->'resolved_components') x;
      if cardinality(native_items)=0 or cardinality(native_items)>500 or native_items is distinct from signed_items
        or exists(select 1 from unnest(native_items) id where not exists(
          select 1 from jsonb_array_elements(native_census->'items') x where x->>'pay_batch_item_id'=id::text
            and x->>'class'='SETTLED_TERMINAL' and x->>'timesheet_id'=snapshot.timesheet_id::text
            and x->>'pay_batch_id'=snapshot.pay_batch_id::text)) then
        v_reason:='SIGNED_NATIVE_ITEM_CENSUS_CHANGED';
      else
        for component in select value from jsonb_array_elements(snapshot.target_snapshot_json->'resolved_components') loop
          select * into strict item from public.pay_batch_items where id=(component->>'pay_batch_item_id')::uuid;
          if component->'frozen_component_snapshot_json' is distinct from item.frozen_component_snapshot_json
            or component->'frozen_source_basis_json' is distinct from item.frozen_source_basis_json
            or component->>'component_key_type' is distinct from item.frozen_component_key_type
            or component->>'component_key_value' is distinct from item.frozen_component_key_value
            or component->'frozen_target_amount_ex_vat' is distinct from to_jsonb(item.frozen_target_amount_ex_vat) then
            v_reason:='SIGNED_NATIVE_COMPONENT_CHANGED';exit;end if;
          -- Native monetary/key semantics are read from the existing kernel.
          for component_row in select * from public._pay_batch_item_economic_components(null,array[item.id]) loop
            if component_row.key_resolution_failure_reason is not null then
              v_reason:='NATIVE_COMPONENT_KEY_UNAVAILABLE';exit;end if;
            if component_row.key_type='TS_DAY' and component_row.key_value=event.work_date::text then
              v_members:=component#>'{frozen_component_snapshot_json,segments}';
              if jsonb_typeof(v_members) is distinct from 'array' or jsonb_array_length(v_members)=0 then
                v_reason:='NATIVE_DAY_SOURCE_MEMBERSHIP_UNAVAILABLE';exit;end if;
              -- The actual frozen component's entire Source member set is
              -- checked, including other Source shifts on this same native day.
              -- Missing/mixed/duplicate identity never becomes coverage proof.
              if jsonb_array_length(v_members)>1000 or exists(
                select 1 from jsonb_array_elements(v_members) s group by s->>'segment_id' having count(*)<>1) then
                v_reason:='NATIVE_DAY_SOURCE_MEMBER_CENSUS_INVALID';exit;end if;
              for v_member in select value from jsonb_array_elements(v_members) loop
                if jsonb_typeof(v_member) is distinct from 'object'
                  or v_member->>'date' is distinct from component_row.key_value
                  or coalesce(v_member#>>'{weekly_source,work_event_id}','') !~* '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'
                  or coalesce(v_member#>>'{weekly_source,movement_id}','') !~* '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'
                  or v_member->>'segment_id' is distinct from 'weekly-source-event:'||(v_member#>>'{weekly_source,work_event_id}') then
                  v_reason:='NATIVE_DAY_SOURCE_MEMBER_CENSUS_UNBOUND';exit;end if;
                v_member_event:=(v_member#>>'{weekly_source,work_event_id}')::uuid;
                v_member_movement:=(v_member#>>'{weekly_source,movement_id}')::uuid;
                if not exists(select 1 from public.weekly_work_events e
                  join public.weekly_source_billing_movements m on m.work_event_id=e.id and m.id=v_member_movement
                  join public.weekly_source_row_timesheet_lineages l on l.work_event_id=e.id
                    and l.row_resolution_id=(m.source_facts_json->>'row_resolution_id')::uuid
                  where e.id=v_member_event and e.first_source_group_id=event.first_source_group_id
                    and e.work_date=event.work_date and (e.candidate_id,e.client_id)=(event.candidate_id,event.client_id)
                    and (m.candidate_id,m.actual_client_id)=(event.candidate_id,event.client_id)
                    and (l.candidate_id,l.client_id,l.contract_id)=(m.candidate_id,m.actual_client_id,m.contract_id)
                    and l.timesheet_id=any(roots) and m.pay_effect='NORMAL'
                    and m.source_profile_kind<>'SELF_BILL_REPORT'
                    and m.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION')
                    and m.movement_role in ('POSITIVE','REPLACEMENT')) then
                  v_reason:='NATIVE_DAY_SOURCE_MEMBER_LINEAGE_UNBOUND';exit;end if;
              end loop;
              if v_reason is not null then exit;end if;
              select count(*) into v_count from jsonb_array_elements(v_members) s
                where s->>'segment_id'='weekly-source-event:'||event.id::text
                  and s->>'date'=event.work_date::text
                  and s#>>'{weekly_source,work_event_id}'=event.id::text;
              if v_count=1 then
                select value into strict segment from jsonb_array_elements(v_members) where value->>'segment_id'='weekly-source-event:'||event.id::text;
                if segment->'exclude_from_pay'='true'::jsonb or segment#>>'{weekly_source,movement_id}' is null
                  or not exists(select 1 from public.weekly_source_billing_movements m
                    where m.id=(segment#>>'{weekly_source,movement_id}')::uuid and m.work_event_id=event.id
                      and (m.candidate_id,m.actual_client_id)=(event.candidate_id,event.client_id)
                      and m.source_profile_kind<>'SELF_BILL_REPORT'
                      and m.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION')
                      and m.pay_effect='NORMAL' and m.movement_role in ('POSITIVE','REPLACEMENT')) then
                  v_reason:='NATIVE_SOURCE_MEMBER_UNBOUND';exit;end if;
                select coalesce(jsonb_agg(to_jsonb(c) order by c.timesheet_id,c.key_type,c.key_value),'[]'::jsonb)
                  into v_current_financial from public._pay_active_settled_components(array[p_root_timesheet_id]) c
                  where c.timesheet_id=p_root_timesheet_id and c.key_type=component_row.key_type and c.key_value=component_row.key_value;
                proofs:=proofs||jsonb_build_array(jsonb_build_object('pay_batch_item_id',item.id,
                  'native_component',to_jsonb(component_row),'signed_component',component,'signed_member',segment,
                  'complete_signed_source_members',v_members,'native_current_financial_components',v_current_financial));
              elsif v_count>1 then v_reason:='NATIVE_SOURCE_MEMBER_AMBIGUOUS';exit;end if;
            end if;
          end loop;
          if v_reason is not null then exit;end if;
        end loop;
      end if;
    end if;
  end if;
  if v_reason is null and jsonb_array_length(proofs)=0 then v_reason:='NATIVE_SOURCE_MEMBERSHIP_ABSENT';end if;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_LEGACY_SIGNED_SOURCE_MEMBERSHIP_INPUT_V1',
    'work_event_id',event.id,'source_cycle_id',cycle.id,'source_group_id',cycle.source_group_id,
    'candidate_id',event.candidate_id,'client_id',event.client_id,'actor_user_id',p_actor_user_id,
    'root_timesheet_id',p_root_timesheet_id,'member_timesheet_ids',to_jsonb(roots),
    'state',case when v_reason is null then 'MEMBERSHIP_PRESENT' else 'UNAVAILABLE' end,'reason',v_reason,
    'native_module',v_module,'native_allocation',native_allocation,'native_terminal_census',native_census-'evaluated_at_utc',
    'signed_native_memberships',proofs,'paid_writer_permission',null,'paid',null,'paid_quantity_known',false,
    'withheld_amount_known',false);
  return v_result||jsonb_build_object('inputs_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_LEGACY_SIGNED_SOURCE_MEMBERSHIP_INPUT_V1',v_result),'hex'));
end;
$function$;

create or replace function private.weekly_source_paid_overlap_current_snapshot_for_cycle_v1(
  p_work_event_id uuid,p_movement_id uuid,p_candidate_id uuid,p_client_id uuid,p_contract_id uuid,
  p_source_group_id uuid,p_native_root_ids uuid[],p_source_cycle_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  event public.weekly_work_events%rowtype;cycle public.weekly_source_cycles%rowtype;
  profile public.weekly_source_format_profiles%rowtype;line public.weekly_source_final_snapshot_lines%rowtype;
  transition public.weekly_source_state_transitions%rowtype;revision public.weekly_source_final_revisions%rowtype;
  selected record;root uuid;member_roots uuid[];rows jsonb:='[]'::jsonb;v_count integer:=0;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict event from public.weekly_work_events where id=p_work_event_id;
  select * into strict cycle from public.weekly_source_cycles where id=p_source_cycle_id;
  select * into strict profile from public.weekly_source_format_profiles where id=event.source_format_profile_id;
  if (event.candidate_id,event.client_id,event.first_source_group_id) is distinct from
      (p_candidate_id,p_client_id,p_source_group_id) or cycle.source_group_id is distinct from p_source_group_id
    or (cycle.scope_client_id is not null and cycle.scope_client_id is distinct from p_client_id)
    or not exists(select 1 from public.contracts c where c.id=p_contract_id
      and (c.candidate_id,c.client_id)=(p_candidate_id,p_client_id))
    or cardinality(p_native_root_ids) is null or cardinality(p_native_root_ids)=0 or cardinality(p_native_root_ids)>200 then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_SNAPSHOT_SCOPE_INVALID' using errcode='22023';end if;
  if private.weekly_source_office_next_owner_v1() then
    return private.weekly_source_paid_overlap_current_snapshot_v1(p_work_event_id,p_movement_id,
      p_candidate_id,p_client_id,p_contract_id,p_source_group_id,p_native_root_ids);
  end if;
  if (select m.active_owner from private.bpay_next_module_control m where m.id=1) is distinct from 'LEGACY'
    or profile.final_authority_kind not in ('GENERIC_COMPLETE_SNAPSHOT','HEALTHROSTER_ACTUAL_ROWS') then
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_PAY_SNAPSHOT_V1',
      'state','UNAVAILABLE','snapshot_line_id',null,'work_event_id',p_work_event_id,
      'movement_id',p_movement_id,'native_current_selections','[]'::jsonb);end if;
  select * into selected from private.weekly_source_roster_prior_states_v1(
    p_source_group_id,p_client_id,profile.final_authority_kind,cycle.finalisation_week_ending) prior
    where prior.work_event_id=p_work_event_id;
  if found and selected.snapshot_line_id is not null then
    select * into strict line from public.weekly_source_final_snapshot_lines where id=selected.snapshot_line_id;
    select * into strict transition from public.weekly_source_state_transitions where id=selected.transition_id;
    select * into strict revision from public.weekly_source_final_revisions where id=selected.final_revision_id;
    if line.pay_effect='NORMAL' and (line.work_event_id,line.candidate_id,line.client_id,line.contract_id,line.work_date)
      =(event.id,p_candidate_id,p_client_id,p_contract_id,event.work_date)
      and revision.state='CURRENT' and revision.authority_scope_kind='CYCLE' and revision.report_scope_id is null
      and exists(select 1 from public.weekly_source_cycles c where c.id=revision.source_cycle_id
        and c.source_group_id=p_source_group_id and c.current_final_revision_id=revision.id)
      and (transition.new_snapshot_line_id=line.id or (transition.outcome='CANCEL' and transition.exclude_cancel
        and transition.previous_snapshot_line_id=line.id and not transition.new_present
        and transition.new_snapshot_line_id is null
        and (case when transition.outcome='CANCEL' and transition.exclude_cancel
          then private.weekly_source_missing_cancel_transition_assert_v1(transition.id) end)#>>'{original_basis,movement_id}'=p_movement_id::text)) then
      foreach root in array p_native_root_ids loop
        member_roots:=private.weekly_source_invoice_family_timesheet_ids_v1(root);
        if exists(select 1 from public.weekly_source_row_timesheet_lineages l
          where l.row_resolution_id=line.row_resolution_id and l.work_event_id=event.id
            and (l.candidate_id,l.client_id,l.contract_id)=(p_candidate_id,p_client_id,p_contract_id)
            and l.timesheet_id=any(member_roots))
          and exists(select 1 from private.weekly_source_ordinary_projection_active_movements_v1(root,revision.id) m
            where m.id=p_movement_id and m.work_event_id=event.id and m.pay_effect='NORMAL'
              and (m.candidate_id,m.actual_client_id,m.contract_id)=(p_candidate_id,p_client_id,p_contract_id)) then
          v_count:=v_count+1;
          rows:=rows||jsonb_build_array(jsonb_build_object('selection_owner','SOURCE_FIN4_PRIOR_STATE',
            'root_timesheet_id',root,'member_timesheet_ids',to_jsonb(member_roots),
            'snapshot_line_id',line.id,'snapshot_line_hash',encode(line.snapshot_line_hash,'hex'),
            'selected_transition_id',transition.id,'selected_final_revision_id',revision.id,
            'source_hash',encode(transition.transition_fingerprint,'hex'),
            'selected_manifest_hash',encode(revision.manifest_hash,'hex'),
            'before_week_ending',cycle.finalisation_week_ending,'source_export_present',transition.new_present,
            'exclude_cancel',transition.exclude_cancel));
        end if;
      end loop;
    end if;
  end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_PAY_SNAPSHOT_V1',
    'state',case when v_count>0 then 'CURRENT' else 'UNAVAILABLE' end,
    'snapshot_line_id',case when v_count>0 then line.id end,'work_event_id',p_work_event_id,
    'movement_id',p_movement_id,'native_current_selections',rows);
end;
$function$;

create or replace function private.weekly_source_off_rule_setup_shape_assert_v1(p_auth jsonb)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare manifest jsonb:=p_auth->'fixture_manifest'; key text; ids jsonb; sorted jsonb; permitted text[];
begin
  if not private.weekly_source_qualification_closed_object_v1(manifest,array['group_code','client_ids','contract_ids','candidate_ids','client_refs','candidate_refs'])
    or coalesce(manifest->>'group_code','') !~ '^WSQ_TEST_[A-Z0-9_]+$'
    or coalesce(p_auth->>'week_ending','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
    or (p_auth->>'week_ending')::date::text is distinct from p_auth->>'week_ending'
    or extract(dow from (p_auth->>'week_ending')::date)<>0
    or coalesce(p_auth->>'expires_at_utc','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$' then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
  for key in select unnest(array['client_ids','contract_ids','candidate_ids']) loop
    ids:=manifest->key;
    if jsonb_typeof(ids) is distinct from 'array' or jsonb_array_length(ids) not between 1 and 100
      or exists(select 1 from jsonb_array_elements(ids) id where jsonb_typeof(id) is distinct from 'string'
        or coalesce(id#>>'{}','') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$') then
      raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
    select jsonb_agg(id order by id) into sorted from (select distinct id from jsonb_array_elements(ids) id) dedupe;
    if ids is distinct from sorted then raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
  end loop;
  if jsonb_typeof(manifest->'client_refs') is distinct from 'array' or jsonb_typeof(manifest->'candidate_refs') is distinct from 'array'
    or (select coalesce(jsonb_agg(value->'client_id' order by ord),'[]'::jsonb) from jsonb_array_elements(manifest->'client_refs') with ordinality refs(value,ord)) is distinct from manifest->'client_ids'
    or (select coalesce(jsonb_agg(value->'candidate_id' order by ord),'[]'::jsonb) from jsonb_array_elements(manifest->'candidate_refs') with ordinality refs(value,ord)) is distinct from manifest->'candidate_ids'
    or exists(select 1 from jsonb_array_elements(manifest->'client_refs') ref where not private.weekly_source_qualification_closed_object_v1(ref,array['client_id','cli_ref'])
      or coalesce(ref->>'cli_ref','') !~ '^CLI-913013[0-9]{2}$')
    or exists(select 1 from jsonb_array_elements(manifest->'candidate_refs') ref where not private.weekly_source_qualification_closed_object_v1(ref,array['candidate_id','tms_ref'])
      or coalesce(ref->>'tms_ref','') !~ '^CCR-913013[0-9]{2}$')
    or (select count(distinct value->>'cli_ref') from jsonb_array_elements(manifest->'client_refs'))<>jsonb_array_length(manifest->'client_ids')
    or (select count(distinct value->>'tms_ref') from jsonb_array_elements(manifest->'candidate_refs'))<>jsonb_array_length(manifest->'candidate_ids') then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
  permitted:=case p_auth->>'purpose' when 'SOURCE_FIXTURE_SETUP' then array[
    'weekly_source_office_recheck_begin_v1','weekly_source_upload_context_v1','weekly_source_upload_stage_begin_atomic_v1','weekly_source_upload_stage_rows_atomic_v1','weekly_source_upload_seal_atomic_v1',
    'weekly_source_projection_begin_atomic_v1','weekly_source_projection_rows_apply_atomic_v1','weekly_source_projection_publish_atomic_v1',
    'weekly_source_import_prepare_atomic_v1','weekly_source_finalise_atomic_v1','weekly_source_finalisation_pay_open_atomic_v1',
    'weekly_source_finalisation_pay_task_start_atomic_v1','weekly_source_ordinary_pay_projection_apply_atomic_v1','weekly_source_finalisation_pay_task_finish_atomic_v1',
    'REPORT_FIN_AB_FINALISE','weekly_source_agency_timesheet_change_v1','weekly_source_agency_change_worker_context_v1','weekly_source_agency_change_worker_apply_v1','weekly_source_agency_validation_context_v1','weekly_source_agency_validation_apply_v1','weekly_source_agency_change_authorise_step_v1','weekly_source_agency_change_return_step_v1'] when 'AUTOMATIC_JOURNEY' then array['weekly_source_automatic_reconcile_atomic_v1','weekly_exceptional_pay_prepare_action_v1',
    'weekly_exceptional_pay_action_context_v1','weekly_exceptional_pay_action_publication_status_v1','weekly_exceptional_pay_stage_c1_request_v1','weekly_source_missing_accept_context_v1','weekly_source_missing_accept_prepare_atomic_v1','weekly_source_later_change_decide_atomic_v1'] else null end;
  ids:=p_auth->'allowed_operations';
  if permitted is null or jsonb_typeof(ids) is distinct from 'array' or jsonb_array_length(ids) not between 1 and cardinality(permitted)
    or exists(select 1 from jsonb_array_elements(ids) op where jsonb_typeof(op)<>'string' or not(op#>>'{}'=any(permitted))) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
  select jsonb_agg(op order by op) into sorted from (select distinct op from jsonb_array_elements(ids) op) dedupe;
  if ids is distinct from sorted then raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
  if p_auth->>'purpose'='AUTOMATIC_JOURNEY' and (not private.weekly_source_qualification_closed_object_v1(p_auth->'original_source_cas',
      array['schema_version','source_cycle_id','client_ids','source_cas_sha256'])
    or p_auth#>>'{original_source_cas,schema_version}' is distinct from 'WEEKLY_SOURCE_BULK_SOURCE_CAS_V1'
    or p_auth#>>'{original_source_cas,source_cycle_id}' is distinct from p_auth->>'source_cycle_id'
    or p_auth#>'{original_source_cas,client_ids}' is distinct from manifest->'client_ids'
    or jsonb_array_length(manifest->'client_ids')<>1
    or coalesce(p_auth#>>'{original_source_cas,source_cas_sha256}','') !~ '^[0-9a-f]{64}$') then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
exception when invalid_text_representation or datetime_field_overflow or invalid_datetime_format then
  raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023';
end;
$function$;

create or replace function private.weekly_source_off_rule_native_parent_scope_v1(p_request jsonb,p_actor uuid,p_auth jsonb default null)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare subjects jsonb:=jsonb_build_array(p_request); subject jsonb; field text; selector uuid; parent jsonb;
  cycles uuid[]:='{}'::uuid[]; bindings jsonb:='[]'::jsonb; observed uuid; expected uuid; qualified boolean:=p_auth is not null; ambiguous boolean:=false;
  run_row public.weekly_exceptional_orchestration_runs%rowtype; family public.weekly_exceptional_pay_target_families%rowtype;
  proof jsonb; proof_result jsonb; prepare_request jsonb; command_frame jsonb; n integer; key text;
  decision_bundle public.weekly_source_entitlement_decision_bundles%rowtype;missing_audit public.audit_events%rowtype;
  root public.timesheets%rowtype; contract public.contracts%rowtype; fixture_week date; client_id uuid; candidate_id uuid; contract_id uuid;
begin
  if jsonb_typeof(p_request) is distinct from 'object' or p_actor is null then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_INVALID' using errcode='22023'; end if;
  if qualified then expected:=(p_auth->>'source_cycle_id')::uuid; fixture_week:=(p_auth->>'week_ending')::date; end if;
  -- Only declared native subject payloads, not arbitrary uploaded raw columns.
  foreach key in array array['c1_request','service_snapshot','target_snapshot'] loop
    if jsonb_typeof(p_request->key)='object' then subjects:=subjects||jsonb_build_array(p_request->key); end if;
  end loop;
  foreach key in array array['p_rows','c1_sources','c1_components'] loop
    if jsonb_typeof(p_request->key)='array' then subjects:=subjects||(p_request->key); end if;
  end loop;
  for subject in select value from jsonb_array_elements(subjects) value loop
    if jsonb_typeof(subject) is distinct from 'object' then
      if qualified then raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_INVALID' using errcode='22023'; end if;
      ambiguous:=true;continue;end if;
    if qualified and ((subject ? 'source_cycle_id' and nullif(subject->>'source_cycle_id','') is not null and (subject->>'source_cycle_id')::uuid<>expected)
      or (subject ? 'source_group_id' and nullif(subject->>'source_group_id','') is not null and subject->>'source_group_id' is distinct from p_auth->>'source_group_id')
      or (subject ? 'agency_id' and nullif(subject->>'agency_id','') is not null and subject->>'agency_id' is distinct from p_auth->>'agency_id')
      or (subject ? 'actor_user_id' and nullif(subject->>'actor_user_id','') is not null and (subject->>'actor_user_id')::uuid<>p_actor)
      or (subject ? 'p_actor_user_id' and nullif(subject->>'p_actor_user_id','') is not null and (subject->>'p_actor_user_id')::uuid<>p_actor)) then
      raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
    if nullif(subject->>'source_cycle_id','') is not null then
      begin cycles:=array_append(cycles,(subject->>'source_cycle_id')::uuid);
      exception when others then if qualified then raise; end if;ambiguous:=true;end;
    end if;
    foreach field in array array['upload_id','expected_current_upload_id','projection_publication_id','p_publication_id','publication_id','expected_projection_publication_id',
      'final_revision_id','current_final_revision_id','expected_source_revision','current_comparison_revision_id','report_scope_id','correction_session_id',
      'run_id','task_id','projection_receipt_id','orchestration_run_id','publication_request_id','family_id','work_event_id','prior_work_event_id','paid_overlap_target_work_event_id',
      'root_timesheet_id','evidence_timesheet_id','upload_row_id','client_id','candidate_id','contract_id','decision_bundle_id','p_contract_week_id','p_request_id'] loop
      if nullif(subject->>field,'') is null then continue; end if;
      parent:=null;observed:=null;client_id:=null;candidate_id:=null;contract_id:=null;
      begin
      selector:=(subject->>field)::uuid;
      case field
        when 'p_contract_week_id','p_request_id' then
          parent:=private.weekly_source_off_rule_agency_parent_v1(case when field='p_contract_week_id'
            then 'weekly_source_agency_timesheet_change_v1'
            when subject ? 'p_actor_user_id' then case when exists(select 1
              from private.weekly_source_agency_timesheet_change_requests r where r.id=selector and r.phase='FINANCIAL_CURRENT')
                then 'weekly_source_agency_change_authorise_step_v1' else 'weekly_source_agency_change_return_step_v1' end
            when exists(select 1 from private.weekly_source_agency_timesheet_change_requests r
              where r.id=selector and r.phase='AUTHORISED') then case when subject ? 'p_snapshot'
                then 'weekly_source_agency_validation_apply_v1' else 'weekly_source_agency_validation_context_v1' end
            when subject ? 'p_snapshot' then 'weekly_source_agency_change_worker_apply_v1'
            else 'weekly_source_agency_change_worker_context_v1' end,
            subject,p_actor,qualified);
        when 'upload_id','expected_current_upload_id' then
          select jsonb_build_object('source_cycle_id',u.source_cycle_id,'upload_id',u.id,'report_scope_id',u.report_scope_id,
            'client_id',nullif(u.file_metadata_json->>'client_id','')::uuid) into strict parent from public.weekly_source_uploads u where u.id=selector;
        when 'projection_publication_id','p_publication_id','publication_id','expected_projection_publication_id' then
          select jsonb_build_object('source_cycle_id',p.source_cycle_id,'upload_id',p.upload_id,'publication_id',p.id,'report_scope_id',p.report_scope_id)
            into strict parent from public.weekly_source_projection_publications p where p.id=selector;
          if nullif(subject->>'upload_id','') is not null and parent->>'upload_id' is distinct from (subject->>'upload_id')::uuid::text then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
        when 'final_revision_id','current_final_revision_id','expected_source_revision' then
          select jsonb_build_object('source_cycle_id',r.source_cycle_id,'final_revision_id',r.id,'upload_id',r.upload_id,'report_scope_id',r.report_scope_id)
            into strict parent from public.weekly_source_final_revisions r where r.id=selector;
        when 'current_comparison_revision_id' then
          select jsonb_build_object('source_cycle_id',i.source_cycle_id,'work_event_id',i.work_event_id,'client_id',i.client_id,
            'candidate_id',i.candidate_id,'contract_id',r.contract_id,'comparison_revision_id',r.id)
            into strict parent from public.weekly_issue_comparison_revisions r join public.weekly_discrepancy_incidents i on i.id=r.incident_id where r.id=selector;
        when 'report_scope_id' then
          select jsonb_build_object('source_cycle_id',s.source_cycle_id,'client_id',s.client_id,'report_scope_id',s.id)
            into strict parent from public.weekly_source_report_scopes s where s.id=selector;
        when 'correction_session_id' then
          select jsonb_build_object('source_cycle_id',s.source_cycle_id,'report_scope_id',s.report_scope_id)
            into strict parent from public.weekly_final_source_correction_sessions s where s.id=selector;
        when 'run_id' then
          select jsonb_build_object('source_cycle_id',r.source_cycle_id,'final_revision_id',r.final_revision_id,'run_id',r.id,'actor_user_id',r.requested_by_user_id)
            into strict parent from public.weekly_source_finalisation_pay_runs r where r.id=selector;
          if (parent->>'actor_user_id')::uuid<>p_actor or (nullif(subject->>'final_revision_id','') is not null
            and parent->>'final_revision_id' is distinct from (subject->>'final_revision_id')::uuid::text) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
        when 'task_id' then
          select jsonb_build_object('source_cycle_id',r.source_cycle_id,'final_revision_id',r.final_revision_id,'run_id',r.id,'root_timesheet_id',t.root_timesheet_id,
            'client_id',m.client_id,'contract_id',sheet.contract_id,'candidate_id',k.candidate_id,'task_id',t.id)
            into strict parent from public.weekly_source_finalisation_pay_tasks t join public.weekly_source_finalisation_pay_runs r on r.id=t.run_id
            join public.weekly_source_client_manifests m on m.id=t.client_manifest_id join public.timesheets sheet on sheet.timesheet_id=t.root_timesheet_id
            join public.contracts k on k.id=sheet.contract_id where t.id=selector and m.final_revision_id=r.final_revision_id;
          if nullif(subject->>'run_id','') is null or parent->>'run_id' is distinct from (subject->>'run_id')::uuid::text then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
        when 'projection_receipt_id' then
          select jsonb_build_object('source_cycle_id',r.source_cycle_id,'final_revision_id',r.final_revision_id,'root_timesheet_id',r.root_timesheet_id,'client_id',r.client_id,'actor_user_id',r.actor_user_id)
            into strict parent from public.weekly_source_ordinary_pay_projection_receipts r where r.id=selector;
          if nullif(subject->>'task_id','') is not null and not exists(select 1 from public.weekly_source_finalisation_pay_tasks t
            join public.weekly_source_finalisation_pay_runs r on r.id=t.run_id where t.id=(subject->>'task_id')::uuid
              and r.id=(subject->>'run_id')::uuid and r.final_revision_id=(parent->>'final_revision_id')::uuid
              and t.root_timesheet_id=(parent->>'root_timesheet_id')::uuid) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
        when 'family_id' then
          select f.* into strict family from public.weekly_exceptional_pay_target_families f where f.id=selector;
          select k.* into strict contract from public.contracts k where k.id=family.contract_id;
          parent:=jsonb_build_object('family_id',family.id,'root_timesheet_id',family.root_timesheet_id,'contract_id',contract.id,'candidate_id',family.candidate_id,'client_id',contract.client_id);
          if qualified and family.agency_id::text is distinct from p_auth->>'agency_id' then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
        when 'orchestration_run_id' then
          select r.* into strict run_row from public.weekly_exceptional_orchestration_runs r where r.id=selector;
          select f.* into strict family from public.weekly_exceptional_pay_target_families f where f.id=run_row.family_id;
          select k.* into strict contract from public.contracts k where k.id=family.contract_id;
          if run_row.requested_by_user_id<>p_actor or nullif(subject->>'family_id','') is not null and (subject->>'family_id')::uuid<>family.id then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
          parent:=jsonb_build_object('family_id',family.id,'root_timesheet_id',family.root_timesheet_id,'contract_id',contract.id,'candidate_id',family.candidate_id,'client_id',contract.client_id);
          -- No source_cycle_id exists on this native run. Resolve a real
          -- completed OFF prepare command's exact request/result, or the
          -- original native approval. Never infer a cycle from group/week.
          n:=0;
          for proof in select jsonb_build_object('frame',admitted.after_json,'completion',done.after_json)
            from public.audit_events admitted join public.audit_events done on done.object_type=admitted.object_type and done.object_id_text=admitted.object_id_text
              and done.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_COMPLETED' and done.event_sequence_is_authoritative and done.before_json=admitted.after_json
            where admitted.object_type='weekly_source_off_rule_command' and admitted.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_ADMITTED'
              and admitted.event_sequence_is_authoritative and admitted.after_json->>'native_operation'='weekly_exceptional_pay_prepare_action_v1'
              and admitted.after_json->>'actor_user_id'=p_actor::text and done.after_json#>>'{native_prepare_result,orchestration_run_id}'=run_row.id::text
              and (not qualified or admitted.after_json#>>'{authorization,scope_id}'=p_auth->>'scope_id')
          loop
            n:=n+1;command_frame:=proof->'frame';proof_result:=proof#>'{completion,native_prepare_result}';
            prepare_request:=command_frame->'native_prepare_request';
            if command_frame->>'command_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_COMMAND_V1',command_frame-'command_sha256'),'hex')
              or proof#>>'{completion,command_sha256}' is distinct from command_frame->>'command_sha256'
              or proof#>>'{completion,native_result_sha256}' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_NATIVE_RESULT_V1',proof_result),'hex')
              or command_frame->>'native_request_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_NATIVE_REQUEST_V1',prepare_request),'hex')
              or run_row.request_fingerprint is distinct from private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_PREPARE_ACTION_REQUEST_V1',prepare_request)
              or prepare_request->>'family_id' is distinct from family.id::text or prepare_request->>'actor_user_id' is distinct from p_actor::text
              or proof_result->>'family_id' is distinct from family.id::text or proof_result->>'source_cycle_id' is distinct from prepare_request->>'source_cycle_id'
              or proof_result->>'work_event_id' is distinct from prepare_request->>'work_event_id'
              or command_frame->>'source_cycle_id' is distinct from prepare_request->>'source_cycle_id' then
              raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
          end loop;
          if n>0 then
            observed:=(prepare_request->>'source_cycle_id')::uuid;
            parent:=parent||jsonb_build_object('source_cycle_id',observed,'work_event_id',prepare_request->>'work_event_id');
          else
            select count(distinct a.source_cycle_id),(array_agg(a.source_cycle_id))[1] into n,observed from public.weekly_exceptional_payment_approvals a
              where a.creation_orchestration_run_id=run_row.id and a.pay_target_family_id=family.id;
            if n>1 or (qualified and n<>1) then raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
            if n=1 then parent:=parent||jsonb_build_object('source_cycle_id',observed); end if;
            -- An ordinary unstaged run may have neither proof. Discovery
            -- returns no OFF cycle and leaves native staged=false unchanged.
          end if;
          if qualified and family.agency_id::text is distinct from p_auth->>'agency_id' then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
        when 'publication_request_id' then
          select jsonb_build_object('family_id',r.family_id,'orchestration_run_id',r.orchestration_run_id,'root_timesheet_id',r.root_timesheet_id,
            'candidate_id',r.candidate_id,'contract_id',r.contract_id,'client_id',k.client_id) into strict parent
            from public.weekly_exceptional_c1_publication_requests r join public.contracts k on k.id=r.contract_id where r.id=selector;
          if qualified and not exists(select 1 from public.weekly_exceptional_payment_approvals a where a.creation_orchestration_run_id=(parent->>'orchestration_run_id')::uuid
            and a.pay_target_family_id=(parent->>'family_id')::uuid and a.source_cycle_id=expected) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
        when 'work_event_id','prior_work_event_id','paid_overlap_target_work_event_id' then
          select jsonb_build_object('source_group_id',w.first_source_group_id,'client_id',w.client_id,'candidate_id',w.candidate_id,'work_date',w.work_date)
            into strict parent from public.weekly_work_events w where w.id=selector;
          if qualified and parent->>'source_group_id' is distinct from p_auth->>'source_group_id' then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
        when 'root_timesheet_id','evidence_timesheet_id' then
          select sheet.* into strict root from public.timesheets sheet where sheet.timesheet_id=selector;
          select k.* into strict contract from public.contracts k where k.id=root.contract_id;
          parent:=jsonb_build_object('root_timesheet_id',root.timesheet_id,'contract_id',contract.id,'candidate_id',contract.candidate_id,'client_id',contract.client_id);
          if qualified and (contract.client_id is null or contract.candidate_id is null) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
          if qualified and nullif(subject->>'final_revision_id','') is not null and not exists(select 1 from public.weekly_source_billing_movements m
            where m.final_revision_id=(subject->>'final_revision_id')::uuid and m.invoice_timesheet_id=root.timesheet_id and m.actual_client_id=contract.client_id)
            and not exists(select 1 from public.audit_events missing
            where missing.action='WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED' and missing.object_type='weekly_source_entitlement_decision_bundles'
              and missing.object_id_text=subject->>'decision_bundle_id'
              and missing.after_json->>'bundle_revision'=subject->>'bundle_revision'
              and missing.after_json#>>'{inputs,target_final_revision_id}'=subject->>'final_revision_id'
              and missing.after_json#>>'{inputs,root_timesheet_id}'=root.timesheet_id::text
              and missing.after_json#>>'{inputs,client_id}'=contract.client_id::text
              and missing.after_json#>>'{inputs,candidate_id}'=contract.candidate_id::text
              and missing.after_json#>>'{inputs,contract_id}'=contract.id::text
              and missing.after_json->>'proof_sha256'=encode(private.weekly_source_sha256_jsonb_v1(
                'WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSAL_PROOF_V1',missing.after_json-'proof_sha256'),'hex')) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
        when 'upload_row_id' then
          select jsonb_build_object('source_cycle_id',u.source_cycle_id,'upload_id',u.id) into strict parent
            from public.weekly_source_upload_rows r join public.weekly_source_uploads u on u.id=r.upload_id where r.id=selector;
        when 'decision_bundle_id' then
          select * into strict decision_bundle from public.weekly_source_entitlement_decision_bundles
            where decision_bundle_id=selector and bundle_revision=(subject->>'bundle_revision')::bigint;
          parent:=jsonb_build_object('decision_bundle_id',selector,'bundle_revision',decision_bundle.bundle_revision,
            'root_timesheet_id',decision_bundle.source_root_timesheet_id,'contract_id',decision_bundle.source_contract_id,
            'candidate_id',decision_bundle.candidate_id);
          select count(*) into n from public.audit_events audit
            where audit.action='WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED' and audit.object_type='weekly_source_entitlement_decision_bundles'
              and audit.object_id_text=selector::text and audit.after_json->>'bundle_revision'=decision_bundle.bundle_revision::text;
          if n>1 or (qualified and n<>1) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501';end if;
          if n=1 then
            select * into strict missing_audit from public.audit_events audit
              where audit.action='WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSED' and audit.object_type='weekly_source_entitlement_decision_bundles'
                and audit.object_id_text=selector::text and audit.after_json->>'bundle_revision'=decision_bundle.bundle_revision::text;
            proof:=missing_audit.after_json;
            if proof->>'proof_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
                'WEEKLY_SOURCE_MISSING_ACCEPT_PROPOSAL_PROOF_V1',proof-'proof_sha256'),'hex')
              or proof->>'actor_user_id' is distinct from missing_audit.actor_user_id::text
              or decision_bundle.decided_by_user_id is distinct from missing_audit.actor_user_id
              or proof#>>'{inputs,root_timesheet_id}' is distinct from decision_bundle.source_root_timesheet_id::text
              or proof#>>'{inputs,contract_id}' is distinct from decision_bundle.source_contract_id::text
              or proof#>>'{inputs,candidate_id}' is distinct from decision_bundle.candidate_id::text
              or proof#>>'{inputs,target_final_revision_id}' is distinct from subject->>'final_revision_id' then
              raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501';end if;
            parent:=parent||jsonb_build_object('source_cycle_id',proof#>'{inputs,source_cycle_id}',
              'final_revision_id',proof#>'{inputs,target_final_revision_id}',
              'work_event_id',proof#>'{inputs,work_event_id}','client_id',proof#>'{inputs,client_id}');
          end if;
        when 'client_id' then parent:=jsonb_build_object('client_id',selector);
        when 'candidate_id' then parent:=jsonb_build_object('candidate_id',selector);
        when 'contract_id' then
          select jsonb_build_object('contract_id',k.id,'client_id',k.client_id,'candidate_id',k.candidate_id) into strict parent from public.contracts k where k.id=selector;
      end case;
      observed:=nullif(parent->>'source_cycle_id','')::uuid;
      if observed is not null then cycles:=array_append(cycles,observed); end if;
      foreach key in array array['family_id','work_event_id','root_timesheet_id','contract_id','candidate_id','client_id','final_revision_id','report_scope_id','upload_id'] loop
        if nullif(parent->>key,'') is not null and nullif(subject->>key,'') is not null
          and (parent->>key)::uuid is distinct from (subject->>key)::uuid then
          raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
      end loop;
      if nullif(parent->>'actor_user_id','') is not null and (parent->>'actor_user_id')::uuid is distinct from p_actor then
        raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
      if qualified then
        client_id:=nullif(parent->>'client_id','')::uuid;candidate_id:=nullif(parent->>'candidate_id','')::uuid;contract_id:=nullif(parent->>'contract_id','')::uuid;
        if nullif(parent->>'root_timesheet_id','') is not null then
          select sheet.* into strict root from public.timesheets sheet where sheet.timesheet_id=(parent->>'root_timesheet_id')::uuid;
          select k.* into strict contract from public.contracts k where k.id=root.contract_id;
          if contract.client_id is null or contract.candidate_id is null
            or (contract_id is not null and contract_id is distinct from contract.id)
            or (candidate_id is not null and candidate_id is distinct from contract.candidate_id)
            or (client_id is not null and client_id is distinct from contract.client_id) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
          client_id:=contract.client_id;candidate_id:=contract.candidate_id;contract_id:=contract.id;
          -- Bind the physical root to actual Source membership or the
          -- immutable OPEN signed-evidence union. Source coverage may include
          -- older work; never infer root membership from calendar equality.
          if not exists(select 1 from public.weekly_source_billing_movements m
            join public.weekly_source_final_revisions r on r.id=m.final_revision_id
            where r.source_cycle_id=expected and m.invoice_timesheet_id=root.timesheet_id and m.actual_client_id=contract.client_id)
            and not exists(select 1 from public.weekly_source_finalisation_pay_tasks t
              join public.weekly_source_finalisation_pay_runs r on r.id=t.run_id
              where r.source_cycle_id=expected and t.root_timesheet_id=root.timesheet_id)
            and not exists(select 1 from public.audit_events opened,
              lateral jsonb_array_elements(opened.after_json#>'{original_census,original_root_identities}') original_root
              where opened.object_type='weekly_source_off_rule_test_journey' and opened.object_id_text=p_auth->>'scope_id'
                and opened.action='WEEKLY_SOURCE_OFF_RULE_TEST_OPENED' and opened.event_sequence_is_authoritative
                and original_root->>'timesheet_id'=root.timesheet_id::text) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
        end if;
        if (observed is not null and observed<>expected)
          or (client_id is not null and not(p_auth#>'{fixture_manifest,client_ids}' @> jsonb_build_array(client_id)))
          or (candidate_id is not null and not(p_auth#>'{fixture_manifest,candidate_ids}' @> jsonb_build_array(candidate_id)))
          or (contract_id is not null and not(p_auth#>'{fixture_manifest,contract_ids}' @> jsonb_build_array(contract_id))) then
          raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
      end if;
      bindings:=bindings||jsonb_build_array(jsonb_build_object('selector',field,'id',selector,'parent',parent));
      exception when others then
        if qualified then raise; end if;
        -- Retain actual parent provenance even when a sibling link is bad,
        -- then discover remaining parents. A matching OFF claim must refuse.
        observed:=nullif(parent->>'source_cycle_id','')::uuid;
        if observed is not null then cycles:=array_append(cycles,observed); end if;
        ambiguous:=true;
      end;
    end loop;
  end loop;
  if qualified and exists(select 1 from unnest(cycles) value where value is distinct from expected) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_SCOPE_V1',
    'source_cycle_id',case when (select count(distinct value) from unnest(cycles) value)=1 then cycles[1] else null end,
    'observed_cycle_ids',to_jsonb(cycles),'bindings',bindings,'ambiguous',ambiguous or (select count(distinct value) from unnest(cycles) value)>1);
exception when others then
  if qualified then raise; end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_SCOPE_V1','source_cycle_id',null,'observed_cycle_ids',to_jsonb(cycles),'bindings',bindings,'ambiguous',true);
end;
$function$;

create or replace function private.weekly_source_rule_qualification_setup_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare auth jsonb; actor uuid; journey uuid; action text; lease jsonb; result jsonb; n integer;
  assignment public.weekly_source_group_rule_assignments%rowtype; census jsonb; clients uuid[]; audit_id uuid;
begin
  perform private.weekly_source_query_require_service_v1();
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['actor_user_id','agency_id','environment','qualification_action',
    'source_cycle_id','journey_actor_user_id','purpose','reason']) or p_request->>'environment' is distinct from 'TEST'
    or char_length(coalesce(p_request->>'reason','')) not between 1 and 500 then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid; journey:=(p_request->>'journey_actor_user_id')::uuid; action:=p_request->>'qualification_action';
  perform private._weekly_source_settings_require_admin_v1(actor);
  auth:=private.weekly_source_rule_qualification_authorization_v1((p_request->>'source_cycle_id')::uuid,journey,p_request->>'purpose');
  if auth->>'setup_actor_user_id' is distinct from actor::text or auth->>'agency_id' is distinct from p_request->>'agency_id'
    or private._weekly_source_settings_deployment_v1((auth->>'agency_id')::uuid,'TEST')<>'TEST'
    or action not in ('OFF_RULE_OPEN','OFF_RULE_CLOSE','OFF_RULE_REVOKE') then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_REFUSED' using errcode='42501'; end if;
  perform pg_advisory_xact_lock(hashtextextended('weekly-source-off-rule-test:'||(auth->>'scope_id'),0));
  -- The same assignment store serializes configuration and qualification. No
  -- toggle or metadata write is made to it. Readers revalidate its full hash.
  select * into strict assignment from public.weekly_source_group_rule_assignments where id=(auth->>'assignment_id')::uuid for share;
  if exists(select 1 from public.audit_events audit where audit.object_type='weekly_source_off_rule_test_journey'
    and audit.object_id_text=auth->>'scope_id' and audit.event_sequence_is_authoritative
    and audit.action in ('WEEKLY_SOURCE_OFF_RULE_TEST_CLOSED','WEEKLY_SOURCE_OFF_RULE_TEST_REVOKED')) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_TERMINAL' using errcode='55000'; end if;
  select count(*),jsonb_agg(audit.after_json)->0 into n,lease from public.audit_events audit
    where audit.object_type='weekly_source_off_rule_test_journey' and audit.object_id_text=auth->>'scope_id'
      and audit.action='WEEKLY_SOURCE_OFF_RULE_TEST_OPENED' and audit.event_sequence_is_authoritative;
  if action='OFF_RULE_OPEN' then
    if n<>0 then raise exception 'WEEKLY_SOURCE_OFF_RULE_SCOPE_ALREADY_OPEN' using errcode='23505'; end if;
    perform private.weekly_source_rule_qualification_scope_assert_v1(auth,journey,true);
    lease:=jsonb_build_object('schema_version','WEEKLY_SOURCE_OFF_RULE_TEST_SCOPE_V1','scope_id',auth->>'scope_id',
      'authorization_id',auth->>'authorization_id','authorization_sha256',auth->>'authorization_sha256',
      'purpose',auth->>'purpose','source_cycle_id',auth->>'source_cycle_id','source_group_id',auth->>'source_group_id',
      'week_ending',auth->>'week_ending','assignment_id',assignment.id,'assignment_version',assignment.version,
      'rule_set_version_id',assignment.rule_set_version_id,'opened_at_utc',clock_timestamp(),
      'opened_local_date',(clock_timestamp() at time zone 'Europe/London')::date,
      'coverage_floor_local_date',((auth->>'week_ending')::date-6),
      'actor_user_id',journey,'setup_actor_user_id',actor,'operational_ready',false,'expires_at_utc',auth->>'expires_at_utc');
    if auth->>'purpose'='AUTOMATIC_JOURNEY' then
      -- Capture ONCE, before any protected round. Every remaining Client and
      -- original physical root stays in this immutable audited census.
      census:=private.weekly_source_protected_qualification_census_v1((auth->>'source_cycle_id')::uuid);
      if census->'original_client_ids' is distinct from auth#>'{fixture_manifest,client_ids}'
        or census->'source_cas' is distinct from auth->'original_source_cas'
        or (select coalesce(jsonb_agg(distinct row_value->'contract_id' order by row_value->'contract_id'),'[]'::jsonb)
          from jsonb_array_elements(census->'original_items') row_value) is distinct from auth#>'{fixture_manifest,contract_ids}'
        or (select coalesce(jsonb_agg(distinct row_value->'candidate_id' order by row_value->'candidate_id'),'[]'::jsonb)
          from jsonb_array_elements(census->'original_items') row_value) is distinct from auth#>'{fixture_manifest,candidate_ids}' then
        raise exception 'WEEKLY_SOURCE_OFF_RULE_ORIGINAL_CENSUS_CHANGED' using errcode='40001'; end if;
      lease:=lease||jsonb_build_object('original_census',census);
    end if;
    lease:=lease||jsonb_build_object('scope_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_TEST_SCOPE_V1',lease),'hex'));
    perform public._audit_insert('weekly_source_off_rule_test_journey',auth->>'scope_id','WEEKLY_SOURCE_OFF_RULE_TEST_OPENED',null,lease,p_request->>'reason',actor);
    return lease;
  end if;
  if n<>1 then raise exception 'WEEKLY_SOURCE_OFF_RULE_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  if action='OFF_RULE_CLOSE' then
    perform private.weekly_source_rule_qualification_scope_assert_v1(auth,journey,false);
    if auth->>'purpose'='AUTOMATIC_JOURNEY' then
      census:=lease->'original_census';
      if census is null or census->>'census_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_SOURCE_QUALIFICATION_CENSUS_V1',census-'census_sha256'),'hex') then
        raise exception 'WEEKLY_SOURCE_OFF_RULE_ORIGINAL_CENSUS_UNAVAILABLE' using errcode='55000'; end if;
      select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(census->'original_client_ids') value;
      if private.weekly_source_bulk_source_cas_v1((auth->>'source_cycle_id')::uuid,clients) is distinct from census->'source_cas' then
        raise exception 'WEEKLY_SOURCE_OFF_RULE_ORIGINAL_CENSUS_CHANGED' using errcode='40001'; end if;
      -- Same closed DTO as the original controlled journey. The closure audit
      -- preserves the OPEN census; it never recollects remaining incidents.
      result:=jsonb_build_object('scope_id',auth->>'scope_id','scope_sha256',lease->>'scope_sha256',
        'setup_authorization_sha256',auth->>'authorization_sha256','original_census_sha256',census->>'census_sha256',
        'actor_user_id',journey,'source_cycle_id',auth->>'source_cycle_id','week_ending',auth->>'week_ending',
        'execution_release_id',auth->>'release_id','execution_source_commit',auth->>'source_commit',
        'execution_contract_sha256',auth->>'contract_sha256','state','CLOSED','closed_at_utc',clock_timestamp(),
        'all_assignments_disabled',true,'all_operational_producers_false',true);
    else
      -- The first genuine Source producer may have no protected incidents.
      -- Its resulting frozen Source CAS is a setup result, not a protected
      -- capability census/certificate or manufactured protection evidence.
      select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(auth#>'{fixture_manifest,client_ids}') value;
      result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_OFF_RULE_TEST_SOURCE_CLOSURE_V1','scope_id',auth->>'scope_id',
        'scope_sha256',lease->>'scope_sha256','authorization_sha256',auth->>'authorization_sha256',
        'source_cycle_id',auth->>'source_cycle_id','week_ending',auth->>'week_ending','rule_set_version_id',auth->>'rule_set_version_id',
        'rule_values_sha256',auth->>'rule_values_sha256','result_source_cas',private.weekly_source_bulk_source_cas_v1((auth->>'source_cycle_id')::uuid,clients),
        'actor_user_id',journey,'release_id',auth->>'release_id','source_commit',auth->>'source_commit','contract_sha256',auth->>'contract_sha256',
        'state','CLOSED','closed_at_utc',clock_timestamp(),'all_assignments_disabled',true,'all_operational_producers_false',true);
    end if;
  else result:=jsonb_build_object('scope_id',auth->>'scope_id','state','REVOKED','closed_at_utc',clock_timestamp(),'operational_ready',false); end if;
  perform public._audit_insert('weekly_source_off_rule_test_journey',auth->>'scope_id',
    case when action='OFF_RULE_CLOSE' then 'WEEKLY_SOURCE_OFF_RULE_TEST_CLOSED' else 'WEEKLY_SOURCE_OFF_RULE_TEST_REVOKED' end,
    lease,result,p_request->>'reason',actor);
  if action='OFF_RULE_CLOSE' and auth->>'purpose'='AUTOMATIC_JOURNEY' then
    select audit.id into strict audit_id from public.audit_events audit
      where audit.object_type='weekly_source_off_rule_test_journey' and audit.object_id_text=auth->>'scope_id'
        and audit.action='WEEKLY_SOURCE_OFF_RULE_TEST_CLOSED' and audit.event_sequence_is_authoritative and audit.after_json=result;
    -- OFF_RULE_ORIGINAL_CENSUS_CLOSED: returned identifiers are measured from
    -- the genuine audit row, never supplied by caller or inserted as evidence.
    return result||jsonb_build_object('closure_audit_id',audit_id,'closure_audit_sha256',
      encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_TEST_JOURNEY_CLOSED_V1',result),'hex'));
  end if;
  return result;
end;
$function$;

create or replace function private.weekly_source_rule_qualification_execute_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare actor uuid; cycle_id uuid; auth jsonb; req jsonb; op text; purpose text; frame jsonb; result jsonb;
  command_id uuid:=gen_random_uuid(); stack text; parent_scope jsonb; completion jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  get diagnostics stack=pg_context;
  if stack !~ 'PL/pgSQL function (public\.)?weekly_source_group_rule_feature_set_atomic_v1\(jsonb\)' then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_CONTROLLED_OWNER_REQUIRED' using errcode='42501'; end if;
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['actor_user_id','agency_id','environment','qualification_action',
    'source_cycle_id','native_operation','native_request']) or p_request->>'qualification_action' is distinct from 'OFF_RULE_COMMAND'
    or p_request->>'environment' is distinct from 'TEST' or jsonb_typeof(p_request->'native_request') is distinct from 'object' then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_COMMAND_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid;cycle_id:=(p_request->>'source_cycle_id')::uuid;op:=p_request->>'native_operation';req:=p_request->'native_request';
  if op in ('weekly_source_office_recheck_begin_v1','weekly_source_upload_context_v1','weekly_source_upload_stage_begin_atomic_v1','weekly_source_upload_stage_rows_atomic_v1',
    'weekly_source_upload_seal_atomic_v1','weekly_source_projection_begin_atomic_v1','weekly_source_projection_rows_apply_atomic_v1',
    'weekly_source_projection_publish_atomic_v1','weekly_source_import_prepare_atomic_v1','weekly_source_finalise_atomic_v1',
    'weekly_source_finalisation_pay_open_atomic_v1','weekly_source_finalisation_pay_task_start_atomic_v1',
    'weekly_source_ordinary_pay_projection_apply_atomic_v1','weekly_source_finalisation_pay_task_finish_atomic_v1','REPORT_FIN_AB_FINALISE','weekly_source_agency_timesheet_change_v1','weekly_source_agency_change_worker_context_v1','weekly_source_agency_change_worker_apply_v1','weekly_source_agency_validation_context_v1','weekly_source_agency_validation_apply_v1','weekly_source_agency_change_authorise_step_v1','weekly_source_agency_change_return_step_v1') then
    purpose:='SOURCE_FIXTURE_SETUP';
  elsif op in ('weekly_source_automatic_reconcile_atomic_v1','weekly_exceptional_pay_prepare_action_v1',
    'weekly_exceptional_pay_action_context_v1','weekly_exceptional_pay_action_publication_status_v1',
    'weekly_exceptional_pay_stage_c1_request_v1','weekly_source_missing_accept_context_v1','weekly_source_missing_accept_prepare_atomic_v1','weekly_source_later_change_decide_atomic_v1') then purpose:='AUTOMATIC_JOURNEY';
  else raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_OPERATION_REFUSED' using errcode='42501'; end if;
  if op='weekly_source_later_change_decide_atomic_v1' and req->>'decision' is distinct from 'APPROVE_UPDATED_HOURS' then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_OPERATION_REFUSED' using errcode='42501';end if;
  auth:=private.weekly_source_rule_qualification_authorization_v1(cycle_id,actor,purpose);
  if auth->>'agency_id' is distinct from p_request->>'agency_id' or not(auth->'allowed_operations' @> jsonb_build_array(op))
    or (req ? 'actor_user_id' and req->>'actor_user_id' is distinct from actor::text)
    or (req ? 'p_actor_user_id' and req->>'p_actor_user_id' is distinct from actor::text)
    or (req ? 'source_cycle_id' and req->>'source_cycle_id' is distinct from cycle_id::text)
    or (req ? 'source_group_id' and req->>'source_group_id' is distinct from auth->>'source_group_id')
    or (req ? 'client_id' and not(auth#>'{fixture_manifest,client_ids}' @> jsonb_build_array((req->>'client_id')::uuid))) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_COMMAND_SCOPE_REFUSED' using errcode='42501'; end if;
  -- Nonwaiting same-scope gate precedes OPEN revalidation. It remains held
  -- through native dispatch/completion until transaction end. No group/row
  -- lock is acquired ahead of native I1; a CLOSE holder returns busy here.
  if not pg_try_advisory_xact_lock(hashtextextended('weekly-source-off-rule-test:'||(auth->>'scope_id'),0)) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SCOPE_BUSY' using errcode='55P03'; end if;
  perform private.weekly_source_rule_qualification_scope_assert_v1(auth,actor,false);
  if op in ('weekly_source_agency_timesheet_change_v1','weekly_source_agency_change_worker_context_v1','weekly_source_agency_change_worker_apply_v1','weekly_source_agency_validation_context_v1','weekly_source_agency_validation_apply_v1','weekly_source_agency_change_authorise_step_v1','weekly_source_agency_change_return_step_v1') then
    perform private.weekly_source_off_rule_agency_parent_v1(op,req,actor,true);
  end if;
  parent_scope:=private.weekly_source_off_rule_native_parent_scope_v1(req,actor,auth);
  if exists(select 1 from public.audit_events audit where audit.object_type='weekly_source_off_rule_command'
    and audit.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_ADMITTED' and audit.event_sequence_is_authoritative
    and audit.after_json->>'transaction_id'=pg_current_xact_id()::text and audit.after_json->>'backend_pid'=pg_backend_pid()::text
    and not exists(select 1 from public.audit_events closed where closed.object_type=audit.object_type and closed.object_id_text=audit.object_id_text
      and closed.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_COMPLETED' and closed.event_sequence_is_authoritative)) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_COMMAND_NESTED' using errcode='55000'; end if;
  frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_OFF_RULE_COMMAND_V1','command_id',command_id,
    'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid()::text,'source_cycle_id',cycle_id,'actor_user_id',actor,
    'authorization',auth,'native_operation',op,'native_request_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_OFF_RULE_NATIVE_REQUEST_V1',req),'hex'),'native_parent_scope',parent_scope,'operational_ready',false);
  if op='weekly_exceptional_pay_prepare_action_v1' then frame:=frame||jsonb_build_object('native_prepare_request',req); end if;
  frame:=frame||jsonb_build_object('command_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_COMMAND_V1',frame),'hex'));
  perform public._audit_insert('weekly_source_off_rule_command',command_id::text,'WEEKLY_SOURCE_OFF_RULE_COMMAND_ADMITTED',null,frame,'Controlled OFF fixture native command',actor);
  case op
    when 'weekly_source_office_recheck_begin_v1' then result:=public.weekly_source_office_recheck_begin_v1(req);
    when 'weekly_source_upload_context_v1' then result:=public.weekly_source_upload_context_v1(req);
    when 'weekly_source_upload_stage_begin_atomic_v1' then result:=public.weekly_source_upload_stage_begin_atomic_v1(req);
    when 'weekly_source_upload_stage_rows_atomic_v1' then result:=public.weekly_source_upload_stage_rows_atomic_v1(req);
    when 'weekly_source_upload_seal_atomic_v1' then result:=public.weekly_source_upload_seal_atomic_v1(req);
    when 'weekly_source_projection_begin_atomic_v1' then result:=public.weekly_source_projection_begin_atomic_v1(req);
    when 'weekly_source_projection_rows_apply_atomic_v1' then result:=public.weekly_source_projection_rows_apply_atomic_v1(
      (req->>'p_actor_user_id')::uuid,(req->>'p_publication_id')::uuid,req->'p_rows');
    when 'weekly_source_projection_publish_atomic_v1' then result:=public.weekly_source_projection_publish_atomic_v1(req);
    when 'weekly_source_import_prepare_atomic_v1' then result:=public.weekly_source_import_prepare_atomic_v1(req);
    when 'weekly_source_finalise_atomic_v1' then result:=public.weekly_source_finalise_atomic_v1(req);
    when 'weekly_source_finalisation_pay_open_atomic_v1' then result:=public.weekly_source_finalisation_pay_open_atomic_v1(req);
    when 'weekly_source_finalisation_pay_task_start_atomic_v1' then result:=public.weekly_source_finalisation_pay_task_start_atomic_v1(req);
    when 'weekly_source_ordinary_pay_projection_apply_atomic_v1' then result:=public.weekly_source_ordinary_pay_projection_apply_atomic_v1(req);
    when 'weekly_source_finalisation_pay_task_finish_atomic_v1' then result:=public.weekly_source_finalisation_pay_task_finish_atomic_v1(req);
    when 'REPORT_FIN_AB_FINALISE' then result:=private.weekly_source_rule_report_fixture_finalise_v1(auth,req);
    when 'weekly_source_agency_timesheet_change_v1' then result:=public.weekly_source_agency_timesheet_change_v1(
      (req->>'p_contract_week_id')::uuid,req->>'p_reason',req->>'p_expected_signature',req->>'p_request_key',(req->>'p_actor_user_id')::uuid);
    when 'weekly_source_agency_change_worker_context_v1' then result:=public.weekly_source_agency_change_worker_context_v1((req->>'p_request_id')::uuid);
    when 'weekly_source_agency_change_worker_apply_v1' then result:=public.weekly_source_agency_change_worker_apply_v1(
      (req->>'p_request_id')::uuid,(req->>'p_expected_request_version')::bigint,req->>'p_expected_context_sha256',req->'p_snapshot');
    when 'weekly_source_agency_validation_context_v1' then result:=public.weekly_source_agency_validation_context_v1((req->>'p_request_id')::uuid);
    when 'weekly_source_agency_validation_apply_v1' then result:=public.weekly_source_agency_validation_apply_v1(
      (req->>'p_request_id')::uuid,(req->>'p_expected_request_version')::bigint,req->>'p_expected_context_sha256',req->'p_snapshot');
    when 'weekly_source_agency_change_authorise_step_v1' then result:=public.weekly_source_agency_change_authorise_step_v1(
      (req->>'p_request_id')::uuid,(req->>'p_actor_user_id')::uuid);
    when 'weekly_source_agency_change_return_step_v1' then result:=public.weekly_source_agency_change_return_step_v1(
      (req->>'p_request_id')::uuid,(req->>'p_actor_user_id')::uuid);
    when 'weekly_source_automatic_reconcile_atomic_v1' then result:=public.weekly_source_automatic_reconcile_atomic_v1(req);
    when 'weekly_exceptional_pay_prepare_action_v1' then result:=public.weekly_exceptional_pay_prepare_action_v1(req);
    when 'weekly_exceptional_pay_action_context_v1' then result:=public.weekly_exceptional_pay_action_context_v1(req);
    when 'weekly_exceptional_pay_action_publication_status_v1' then result:=public.weekly_exceptional_pay_action_publication_status_v1(req);
    when 'weekly_exceptional_pay_stage_c1_request_v1' then result:=public.weekly_exceptional_pay_stage_c1_request_v1(req);
    when 'weekly_source_missing_accept_context_v1' then result:=public.weekly_source_missing_accept_context_v1(req);
    when 'weekly_source_missing_accept_prepare_atomic_v1' then result:=public.weekly_source_missing_accept_prepare_atomic_v1(req);
    when 'weekly_source_later_change_decide_atomic_v1' then result:=public.weekly_source_later_change_decide_atomic_v1(req);
  end case;
  -- The command frame is closed even for a legal native refusal result. Errors
  -- abort the whole command/audit transaction; a later session starts afresh.
  completion:=jsonb_build_object('command_id',command_id,'command_sha256',frame->>'command_sha256','native_result_sha256',
    encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_NATIVE_RESULT_V1',result),'hex'),'operational_ready',false);
  if op='weekly_exceptional_pay_prepare_action_v1' then
    if result->>'source_cycle_id' is distinct from cycle_id::text or result->>'family_id' is distinct from req->>'family_id'
      or result->>'work_event_id' is distinct from req->>'work_event_id'
      or not exists(select 1 from public.weekly_exceptional_orchestration_runs r where r.id=(result->>'orchestration_run_id')::uuid
        and r.family_id=(req->>'family_id')::uuid and r.requested_by_user_id=actor
        and r.request_fingerprint=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_PREPARE_ACTION_REQUEST_V1',req)) then
      raise exception 'WEEKLY_SOURCE_OFF_RULE_PREPARE_RESULT_CHANGED' using errcode='42501'; end if;
    completion:=completion||jsonb_build_object('native_prepare_result',result);
  end if;
  perform public._audit_insert('weekly_source_off_rule_command',command_id::text,'WEEKLY_SOURCE_OFF_RULE_COMMAND_COMPLETED',frame,
    completion,'Controlled OFF fixture native command complete',actor);
  return result;
end;
$function$;

create or replace function private.weekly_source_rule_qualification_transport_status_v1(p_request jsonb)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare req jsonb; parent_scope jsonb; cycle_id uuid; actor uuid; op text; purpose text; result jsonb; claim jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['actor_user_id','agency_id','environment','qualification_action','native_operation','native_request'])
    or p_request->>'qualification_action' is distinct from 'OFF_RULE_TRANSPORT_STATUS' or p_request->>'environment' is distinct from 'TEST'
    or jsonb_typeof(p_request->'native_request') is distinct from 'object' then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_TRANSPORT_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid;op:=p_request->>'native_operation';req:=p_request->'native_request';
  if op in ('weekly_source_office_recheck_begin_v1','weekly_source_upload_context_v1','weekly_source_upload_stage_begin_atomic_v1','weekly_source_upload_stage_rows_atomic_v1',
    'weekly_source_upload_seal_atomic_v1','weekly_source_projection_begin_atomic_v1','weekly_source_projection_rows_apply_atomic_v1',
    'weekly_source_projection_publish_atomic_v1','weekly_source_import_prepare_atomic_v1','weekly_source_finalise_atomic_v1',
    'weekly_source_finalisation_pay_open_atomic_v1','weekly_source_finalisation_pay_task_start_atomic_v1',
    'weekly_source_ordinary_pay_projection_apply_atomic_v1','weekly_source_finalisation_pay_task_finish_atomic_v1','weekly_source_agency_timesheet_change_v1','weekly_source_agency_change_worker_context_v1','weekly_source_agency_change_worker_apply_v1','weekly_source_agency_validation_context_v1','weekly_source_agency_validation_apply_v1','weekly_source_agency_change_authorise_step_v1','weekly_source_agency_change_return_step_v1') then purpose:='SOURCE_FIXTURE_SETUP';
  elsif op in ('weekly_source_automatic_reconcile_atomic_v1','weekly_exceptional_pay_prepare_action_v1',
    'weekly_exceptional_pay_action_context_v1','weekly_exceptional_pay_action_publication_status_v1','weekly_exceptional_pay_stage_c1_request_v1','weekly_source_missing_accept_context_v1','weekly_source_missing_accept_prepare_atomic_v1','weekly_source_later_change_decide_atomic_v1') then purpose:='AUTOMATIC_JOURNEY';
  else raise exception 'WEEKLY_SOURCE_OFF_RULE_TRANSPORT_OPERATION_REFUSED' using errcode='42501'; end if;
  if op in ('weekly_source_agency_change_worker_context_v1','weekly_source_agency_change_worker_apply_v1','weekly_source_agency_validation_context_v1','weekly_source_agency_validation_apply_v1','weekly_source_agency_change_authorise_step_v1','weekly_source_agency_change_return_step_v1') then
    -- Worker has no Office token actor. Resolve ONLY its actual stored phase
    -- actor through the finite current-request native parent. Execute rechecks.
    parent_scope:=private.weekly_source_off_rule_agency_parent_v1(op,req,actor,false);
    if parent_scope is null then return jsonb_build_object('contract','WEEKLY_SOURCE_OFF_RULE_TEST_ADMISSION_V1',
      'qualified_fixture',false,'operational_ready',false);end if;
    actor:=(parent_scope->>'actor_user_id')::uuid;
  end if;
  if (req ? 'actor_user_id' and req->>'actor_user_id' is distinct from actor::text)
    or (req ? 'p_actor_user_id' and req->>'p_actor_user_id' is distinct from actor::text) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_TRANSPORT_ACTOR_REFUSED' using errcode='42501'; end if;
  parent_scope:=private.weekly_source_off_rule_native_parent_scope_v1(req,actor,null);
  if parent_scope->>'source_cycle_id' is null or (parent_scope->>'ambiguous')::boolean then
    if (select count(distinct value) from jsonb_array_elements_text(parent_scope->'observed_cycle_ids') value)>1 then
      raise exception 'WEEKLY_SOURCE_OFF_RULE_TRANSPORT_SCOPE_CHANGED' using errcode='40001'; end if;
    for cycle_id in select distinct value::uuid from jsonb_array_elements_text(parent_scope->'observed_cycle_ids') value loop
      claim:=private.weekly_source_rule_qualification_status_v1(jsonb_build_object('actor_user_id',actor,'agency_id',p_request->>'agency_id',
        'environment','TEST','qualification_action','OFF_RULE_STATUS','source_cycle_id',cycle_id,'purpose',purpose));
      if (claim->>'qualified_fixture')::boolean then
        raise exception 'WEEKLY_SOURCE_OFF_RULE_TRANSPORT_SCOPE_CHANGED' using errcode='40001'; end if;
    end loop;
    -- Advisory discovery never admits OFF. In particular an ordinary
    -- unstaged run has no OFF cycle and retains its actual native response.
    return jsonb_build_object('contract','WEEKLY_SOURCE_OFF_RULE_TEST_ADMISSION_V1','qualified_fixture',false,'operational_ready',false);
  end if;
  cycle_id:=(parent_scope->>'source_cycle_id')::uuid;
  result:=private.weekly_source_rule_qualification_status_v1(jsonb_build_object('actor_user_id',actor,'agency_id',p_request->>'agency_id',
    'environment','TEST','qualification_action','OFF_RULE_STATUS','source_cycle_id',cycle_id,'purpose',purpose));
  return result;
end;
$function$;

create or replace function private.weekly_source_nhsp_paid_overlap_basis_v1(
  p_work_event_id uuid,p_actor_user_id uuid,p_source_cycle_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_event public.weekly_work_events%rowtype;v_cycle public.weekly_source_cycles%rowtype;
  v_root public.timesheets%rowtype;v_contract public.contracts%rowtype;
  v_movement public.weekly_source_billing_movements%rowtype;v_resolution public.weekly_source_row_resolutions%rowtype;
  v_row public.weekly_source_upload_rows%rowtype;v_upload public.weekly_source_uploads%rowtype;
  v_roots uuid[];v_root_id uuid;v_scope uuid;v_scope_count integer;v_native jsonb;
  v_payment jsonb;v_rows jsonb:='[]'::jsonb;v_result jsonb;v_complete boolean:=true;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_work_event_id is null or p_actor_user_id is null or p_source_cycle_id is null then
    raise exception 'WEEKLY_SOURCE_NHSP_PAID_BASIS_REQUEST_INVALID' using errcode='22023';end if;
  if private.weekly_source_pay_actor_allowed_v1(p_actor_user_id) is distinct from true then
    raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501';end if;
  select * into strict v_event from public.weekly_work_events where id=p_work_event_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=p_source_cycle_id;
  if v_event.first_source_group_id is distinct from v_cycle.source_group_id
    or (v_cycle.scope_client_id is not null and v_cycle.scope_client_id is distinct from v_event.client_id)
    or not exists(select 1 from public.weekly_source_groups g
      where g.id=v_cycle.source_group_id and g.active and g.source_family='NHSP') then
    raise exception 'WEEKLY_SOURCE_NHSP_PAID_BASIS_SCOPE_FORBIDDEN' using errcode='42501';end if;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
    v_cycle.source_group_id,v_event.client_id,v_cycle.finalisation_week_ending);
  if not private.weekly_source_office_next_owner_v1() then
    v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_NHSP_PAID_OVERLAP_BASIS_INPUT_V1',
      'state','UNAVAILABLE','reason','NEXT_NOT_ACTIVE','work_event_id',v_event.id,
      'candidate_id',v_event.candidate_id,'client_id',v_event.client_id,'root_timesheet_ids',null,
      'source_cycle_id',v_cycle.id,'source_group_id',v_cycle.source_group_id,
      'native_current_rows',null,'native_payment_facts',null,
      'no_reversal_proved',null,'paid_writer_permission',null);
    return v_result||jsonb_build_object('inputs_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_NHSP_PAID_OVERLAP_BASIS_INPUT_V1',v_result),'hex'));end if;
  -- This is the single existing Source payment classifier/Original reader.
  -- Its present CYCLE history field is not relabelled a NHSP current head.
  -- The actual NHSP MOVEMENT selection below remains separately identified.
  v_payment:=private.weekly_source_work_event_payment_facts_v1(v_event.id,p_actor_user_id,v_cycle.id);
  select coalesce(array_agg(distinct family.canonical_timesheet_id order by family.canonical_timesheet_id),'{}'::uuid[])
    into v_roots from public.weekly_source_row_timesheet_lineages lineage
    cross join lateral public._pay_timesheet_rotation_scope(array[lineage.timesheet_id]) family
    where lineage.work_event_id=v_event.id and lineage.candidate_id=v_event.candidate_id
      and lineage.client_id=v_event.client_id;
  if cardinality(v_roots)=0 or cardinality(v_roots)>200
    or to_jsonb(v_roots) is distinct from v_payment->'root_timesheet_ids' then
    raise exception 'WEEKLY_SOURCE_NHSP_PAID_BASIS_ROOT_UNBOUND' using errcode='55000';end if;
  foreach v_root_id in array v_roots loop
    select * into strict v_root from public.timesheets t where t.timesheet_id=v_root_id;
    select * into strict v_contract from public.contracts c where c.id=v_root.contract_id;
    if not v_root.is_current or v_root.revoked_at is not null or v_root.archived_at_utc is not null
      or v_root.sheet_scope<>'WEEKLY' or v_root.line_type<>'HOURS'
      or (v_contract.candidate_id,v_contract.client_id) is distinct from (v_event.candidate_id,v_event.client_id)
      or v_event.work_date not between v_root.week_ending_date-6 and v_root.week_ending_date
      or v_event.work_date not between v_contract.start_date and coalesce(v_contract.end_date,'infinity'::date)
      or not exists(select 1 from public.weekly_source_group_clients membership
        where membership.source_group_id=v_event.first_source_group_id and membership.client_id=v_contract.client_id
          and v_root.week_ending_date between membership.valid_from and coalesce(membership.valid_to,'infinity'::date)) then
      raise exception 'WEEKLY_SOURCE_NHSP_PAID_BASIS_ROOT_FORBIDDEN' using errcode='42501';end if;
    perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
      v_event.first_source_group_id,v_contract.client_id,v_root.week_ending_date);
    select count(*),min(scope.id::text)::uuid into v_scope_count,v_scope
      from private.bpay_next_source_current_scopes scope where scope.root_timesheet_id=v_root_id;
    if v_scope_count>1 then
      raise exception 'WEEKLY_SOURCE_NHSP_PAID_BASIS_SCOPE_AMBIGUOUS' using errcode='55000';end if;
    if v_scope_count=0 or not exists(select 1 from private.bpay_next_source_current_events ce
      where ce.scope_id=v_scope and ce.work_event_id=v_event.id) then
      -- Uncaptured does not mean absent/unpaid/no reversal. Preserve it as
      -- an explicit unavailable native position; no history fallback occurs.
      v_complete:=false;
      v_rows:=v_rows||jsonb_build_array(jsonb_build_object('root_timesheet_id',v_root_id,
        'state','UNAVAILABLE','reason','NATIVE_CURRENT_UNCAPTURED','native_current_event',null));
      continue;
    end if;
    if not exists(select 1 from private.bpay_next_source_current_scopes scope where scope.id=v_scope
      and scope.root_timesheet_id=v_root_id and scope.family_booking_id=v_root.booking_id
      and scope.source_group_id=v_event.first_source_group_id
      and scope.candidate_id=v_contract.candidate_id and scope.client_id=v_contract.client_id
      and scope.contract_id=v_contract.id and scope.week_ending_date=v_root.week_ending_date) then
      raise exception 'WEEKLY_SOURCE_NHSP_PAID_BASIS_SCOPE_UNBOUND' using errcode='55000';end if;
    -- The native pure reader itself revalidates genuine CURRENT observation,
    -- magnitude ambiguity, selected movement and immutable lineage/economics.
    v_native:=private.bpay_next_source_current_event_v1(v_root_id,v_event.id);
    if v_native->>'schema_version' is distinct from 'BPAY_NEXT_SOURCE_CURRENT_EVENT_V1'
      or v_native->>'root_timesheet_id' is distinct from v_root_id::text
      or v_native->>'work_event_id' is distinct from v_event.id::text
      or v_native->>'source_kind' is distinct from 'NHSP'
      or v_native->'source_observed' is distinct from 'true'::jsonb
      or jsonb_typeof(v_native->'source_present') is distinct from 'boolean' then
      raise exception 'WEEKLY_SOURCE_NHSP_PAID_BASIS_NATIVE_UNBOUND' using errcode='55000';end if;
    if v_native->'source_present'='true'::jsonb then
      select * into strict v_movement from public.weekly_source_billing_movements m
        where m.id=(v_native->>'movement_id')::uuid;
      select * into strict v_resolution from public.weekly_source_row_resolutions r
        where r.id=(v_native->>'row_resolution_id')::uuid;
      select * into strict v_row from public.weekly_source_upload_rows r where r.id=v_resolution.upload_row_id;
      select * into strict v_upload from public.weekly_source_uploads u where u.id=v_row.upload_id;
      if v_movement.source_profile_kind<>'NHSP_TRUST_BACKING_REPORT' or v_movement.pay_effect<>'NORMAL'
        or v_movement.source_line_kind<>'NHSP_PHYSICAL_POSITIVE' or v_movement.movement_role not in ('POSITIVE','REPLACEMENT')
        or v_movement.work_event_id is distinct from v_event.id
        or (v_movement.candidate_id,v_movement.actual_client_id,v_movement.contract_id) is distinct from
          (v_contract.candidate_id,v_contract.client_id,v_contract.id)
        or v_movement.final_revision_id::text is distinct from v_native->>'final_revision_id'
        or v_movement.source_facts_json->>'row_resolution_id' is distinct from v_resolution.id::text
        or v_resolution.mapping_state<>'RESOLVED' or v_resolution.work_event_id is distinct from v_event.id
        or (v_resolution.candidate_id,v_resolution.client_id,v_resolution.contract_id) is distinct from
          (v_contract.candidate_id,v_contract.client_id,v_contract.id)
        or v_row.work_date is distinct from v_event.work_date or v_row.row_finalisation_state<>'SOURCE_WORKED'
        or not exists(select 1 from public.weekly_source_format_profiles profile
          where profile.id=v_upload.source_format_profile_id and profile.profile_code='NHSP_FINAL_BACKING_V1')
        or not exists(select 1 from public.weekly_source_row_timesheet_lineages lineage
          join public.weekly_source_row_economic_snapshots economic on economic.row_resolution_id=lineage.row_resolution_id
          where lineage.id=(v_native->>'lineage_id')::uuid and lineage.row_resolution_id=v_resolution.id
            and lineage.work_event_id=v_event.id and lineage.family_booking_id=v_root.booking_id
            and (lineage.candidate_id,lineage.client_id,lineage.contract_id,lineage.week_ending_date) is not distinct from
              (v_contract.candidate_id,v_contract.client_id,v_contract.id,v_root.week_ending_date)
            and economic.id=(v_native->>'economic_snapshot_id')::uuid and economic.work_event_id=v_event.id)
        or private.weekly_source_nhsp_selected_pay_origin_v1(v_scope,v_event.id,v_movement.id) is null then
        raise exception 'WEEKLY_SOURCE_NHSP_PAID_BASIS_MOVEMENT_UNBOUND' using errcode='55000';end if;
    elsif v_native->'movement_id' is distinct from 'null'::jsonb then
      raise exception 'WEEKLY_SOURCE_NHSP_PAID_BASIS_NATIVE_UNBOUND' using errcode='55000';end if;
    v_rows:=v_rows||jsonb_build_array(jsonb_build_object('root_timesheet_id',v_root_id,
      'state','CURRENT_NATIVE_POSITION','native_current_event',v_native));
  end loop;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_NHSP_PAID_OVERLAP_BASIS_INPUT_V1',
    'state',case when v_complete then 'NATIVE_POSITION_INPUTS' else 'UNAVAILABLE' end,
    'reason',case when v_complete then null else 'NATIVE_CURRENT_UNCAPTURED' end,
    'work_event_id',v_event.id,'candidate_id',v_event.candidate_id,'client_id',v_event.client_id,
    'source_cycle_id',v_cycle.id,'source_group_id',v_cycle.source_group_id,'root_timesheet_ids',to_jsonb(v_roots),
    'native_current_rows',v_rows,'native_payment_facts',v_payment,
    'no_reversal_proved',null,'paid_writer_permission',null);
  if octet_length(v_result::text)>524288 then
    raise exception 'WEEKLY_SOURCE_NHSP_PAID_BASIS_BYTE_BOUND' using errcode='54000';end if;
  return v_result||jsonb_build_object('inputs_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_NHSP_PAID_OVERLAP_BASIS_INPUT_V1',v_result),'hex'));
end;
$function$;

create or replace function private.bpay_next_source_nhsp_magnitude_v1(
  p_source_facts jsonb,p_pay_vector jsonb,p_charge_vector jsonb
) returns jsonb language plpgsql immutable security definer
set search_path='pg_catalog','private','public','pg_temp' as $f$
declare v_magnitude jsonb;v_bucket text;v_hours jsonb:='{}';
begin
  foreach v_bucket in array array['day','night','sat','sun','bh'] loop
    v_hours:=v_hours||jsonb_build_object('hours_'||v_bucket,round(abs((p_pay_vector#>>array['hours',v_bucket])::numeric),2)::text);
  end loop;
  v_magnitude:=jsonb_build_object('work_date',p_source_facts->>'work_date',
    'start_at_local',p_source_facts->>'start_at_local','end_at_local',p_source_facts->>'end_at_local',
    'break_minutes',p_source_facts->>'break_minutes',
    'pay_pence',abs((p_pay_vector->>'total_pence')::bigint)::text,
    'charge_pence',abs((p_charge_vector->>'total_pence')::bigint)::text)||v_hours;
  return v_magnitude;
end $f$;

create or replace function private.bpay_next_source_current_capture_movement_v1(p_movement uuid)
returns jsonb language plpgsql security definer
set search_path='pg_catalog','private','public','pg_temp' as $f$
declare v_m public.weekly_source_billing_movements%rowtype;v_origin private.bpay_next_source_current_origins%rowtype;
  v_revision record;v_scope uuid;v_resolution uuid;v_lineage public.weekly_source_row_timesheet_lineages%rowtype;
  v_economic uuid;v_magnitude jsonb;v_hash bytea;v_inserted boolean;
begin
  select m.* into v_m from public.weekly_source_billing_movements m where m.id=p_movement;
  if found and v_m.pay_effect='NONE' and v_m.source_profile_kind='NHSP_TRUST_BACKING_REPORT' then
    return private.bpay_next_source_current_capture_nhsp_none_v1(p_movement);end if;
  if not found or v_m.pay_effect<>'NORMAL' or v_m.source_profile_kind<>'NHSP_TRUST_BACKING_REPORT' or v_m.prior_movement_id is not null
    or v_m.source_line_kind not in ('NHSP_PHYSICAL_POSITIVE','NHSP_PHYSICAL_FULL_NEGATIVE')
    or v_m.movement_role not in ('POSITIVE','REVERSAL','REPLACEMENT') or v_m.expense_authority_generation_id is not null then
    raise exception 'BPAY_NEXT_SOURCE_MOVEMENT_NOT_ADMITTED' using errcode='55000';end if;
  select o.* into v_origin from private.bpay_next_source_current_origins o where o.origin_kind='MOVEMENT' and o.origin_id=p_movement;
  if found and v_origin.source_hash is distinct from v_m.movement_economic_hash then
    raise exception 'BPAY_NEXT_SOURCE_ORIGIN_CHANGED' using errcode='55000';end if;
  if found and (v_origin.active or v_origin.retracted_by_session_id is not null) then
    return jsonb_build_object('origin_id',p_movement,'active',v_origin.active,'idempotent',true);end if;
  select * into strict v_revision from private.bpay_next_source_current_revision_v1(v_m.final_revision_id);
  v_resolution:=(v_m.source_facts_json->>'row_resolution_id')::uuid;
  v_scope:=private.bpay_next_source_current_scope_v1(v_resolution,v_revision.source_group_id,v_m.work_event_id,v_m.contract_id);
  select l.* into strict v_lineage from public.weekly_source_row_timesheet_lineages l where l.row_resolution_id=v_resolution;
  if v_m.candidate_id is distinct from v_lineage.candidate_id or v_m.actual_client_id is distinct from v_lineage.client_id then
    raise exception 'BPAY_NEXT_SOURCE_MOVEMENT_LINEAGE_UNBOUND' using errcode='55000';end if;
  select e.id into strict v_economic from public.weekly_source_row_economic_snapshots e where e.row_resolution_id=v_resolution;
  v_magnitude:=private.bpay_next_source_nhsp_magnitude_v1(v_m.source_facts_json,v_m.canonical_pay_vector_json,v_m.canonical_charge_vector_json);
  v_hash:=private.weekly_source_sha256_jsonb_v1('BPAY_NEXT_SOURCE_NHSP_MAGNITUDE_V1',v_magnitude);
  insert into private.bpay_next_source_current_magnitudes(scope_id,work_event_id,magnitude_hash,economic_magnitude)
    values(v_scope,v_m.work_event_id,v_hash,v_magnitude) on conflict do nothing;
  if not exists(select 1 from private.bpay_next_source_current_magnitudes m where m.scope_id=v_scope
    and m.work_event_id=v_m.work_event_id and m.magnitude_hash=v_hash and m.economic_magnitude=v_magnitude) then
    raise exception 'BPAY_NEXT_SOURCE_MAGNITUDE_HASH_COLLISION' using errcode='55000';end if;
  insert into private.bpay_next_source_current_events(scope_id,work_event_id,source_kind,source_present,source_group_id,client_id,work_date)
    select v_scope,v_m.work_event_id,'NHSP',false,v_revision.source_group_id,w.client_id,w.work_date
    from public.weekly_work_events w where w.id=v_m.work_event_id on conflict do nothing;
  if not exists(select 1 from private.bpay_next_source_current_events e where e.scope_id=v_scope
    and e.work_event_id=v_m.work_event_id and e.source_kind='NHSP') then
    raise exception 'BPAY_NEXT_SOURCE_EVENT_KIND_CHANGED' using errcode='55000';end if;
  insert into private.bpay_next_source_current_origins(origin_kind,origin_id,movement_id,scope_id,work_event_id,
    final_revision_id,order_key,source_hash,row_resolution_id,lineage_id,economic_snapshot_id,
    magnitude_hash,contribution,representative_created_at)
    values('MOVEMENT',v_m.id,v_m.id,v_scope,v_m.work_event_id,v_m.final_revision_id,v_revision.order_key,
      v_m.movement_economic_hash,v_resolution,v_lineage.id,v_economic,v_hash,
      case when v_m.movement_role='REVERSAL' then -1 else 1 end,v_m.created_at_utc) on conflict do nothing;
  v_inserted:=found;
  perform private.bpay_next_source_current_toggle_v1('MOVEMENT',p_movement,v_revision.is_current);
  return jsonb_build_object('origin_id',p_movement,'active',v_revision.is_current,'idempotent',not v_inserted and not v_revision.is_current);
end $f$;

create or replace function private.weekly_source_nhsp_negative_population_v1(
  p_upload_id uuid,p_work_event_id uuid,p_actor_user_id uuid,p_source_cycle_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  u public.weekly_source_uploads%rowtype;c public.weekly_source_cycles%rowtype;
  scope public.weekly_source_report_scopes%rowtype;p public.weekly_source_projection_publications%rowtype;
  w public.weekly_work_events%rowtype;row public.weekly_source_upload_rows%rowtype;
  resolution public.weekly_source_row_resolutions%rowtype;e public.weekly_source_row_economic_snapshots%rowtype;
  m public.weekly_source_billing_movements%rowtype;origin private.bpay_next_source_current_origins%rowtype;
  basis jsonb;position jsonb;target jsonb;targets jsonb:='[]'::jsonb;negatives jsonb:='[]'::jsonb;
  magnitude jsonb;v_pay jsonb;v_charge jsonb;result jsonb;native jsonb;
  correction public.weekly_final_source_correction_sessions%rowtype;
  generation integer;counted integer;total integer;negative_count integer:=0;
  complete boolean:=true;matching boolean:=false;current_available boolean:=true;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_upload_id is null or p_work_event_id is null or p_actor_user_id is null or p_source_cycle_id is null then
    raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_REQUEST_INVALID' using errcode='22023';end if;
  select * into strict u from public.weekly_source_uploads where id=p_upload_id;
  select * into strict c from public.weekly_source_cycles where id=p_source_cycle_id;
  select * into strict w from public.weekly_work_events where id=p_work_event_id;
  select * into strict scope from public.weekly_source_report_scopes where id=u.report_scope_id;
  if u.purpose='FINAL_SOURCE_CORRECTION' then
    perform private.weekly_source_paid_match_correction_scope_v1(u.id,p_actor_user_id,false);
    select * into strict correction from public.weekly_final_source_correction_sessions where id=u.correction_session_id;
  end if;
  if u.source_cycle_id is distinct from c.id or u.purpose not in ('ORDINARY','FINAL_SOURCE_CORRECTION')
    or (u.purpose='ORDINARY' and (u.state<>'CURRENT' or u.correction_session_id is not null))
    or (u.purpose='FINAL_SOURCE_CORRECTION' and u.state<>'CORRECTION_READY') or u.row_manifest_hash is null or u.malformed_count<>0 or u.blocking_economic_duplicate_count<>0
    or scope.source_cycle_id is distinct from c.id or scope.source_group_id is distinct from c.source_group_id
    or scope.client_id is distinct from w.client_id or scope.self_bill_report_id is not null
    or (u.purpose='ORDINARY' and scope.current_complete_upload_id is distinct from u.id)
    or w.first_source_group_id is distinct from c.source_group_id
    or not exists(select 1 from public.weekly_source_groups g where g.id=c.source_group_id and g.active and g.source_family='NHSP')
    or not exists(select 1 from public.weekly_source_format_profiles profile where profile.id=u.source_format_profile_id
      and profile.active and profile.profile_code='NHSP_FINAL_BACKING_V1')
    or private.weekly_source_upload_manifest_hash_v1(u.id) is distinct from u.row_manifest_hash then
    raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_SCOPE_UNBOUND' using errcode='55000';end if;
  -- Actual viewer and both cycle/root dated permissions are proved inside the
  -- one native basis owner before any cash/current selection is returned.
  basis:=private.weekly_source_nhsp_paid_overlap_basis_v1(w.id,p_actor_user_id,c.id);
  if basis->>'schema_version' is distinct from 'WEEKLY_SOURCE_NHSP_PAID_OVERLAP_BASIS_INPUT_V1'
    or basis->>'work_event_id' is distinct from w.id::text or basis->>'source_cycle_id' is distinct from c.id::text
    or basis->>'inputs_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_NHSP_PAID_OVERLAP_BASIS_INPUT_V1',basis-'inputs_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_BASIS_UNBOUND' using errcode='55000';end if;
  if basis->>'state' is distinct from 'NATIVE_POSITION_INPUTS' then current_available:=false;
  else
    for position in select value from jsonb_array_elements(basis->'native_current_rows') loop
      native:=position->'native_current_event';
      if position->>'state' is distinct from 'CURRENT_NATIVE_POSITION' or native->'source_present' is distinct from 'true'::jsonb then
        current_available:=false;continue;end if;
      select * into strict m from public.weekly_source_billing_movements where id=(native->>'movement_id')::uuid;
      select * into strict origin from private.bpay_next_source_current_origins o
        where o.origin_kind='MOVEMENT' and o.origin_id=private.weekly_source_nhsp_selected_pay_origin_v1(
          (select current_scope.id from private.bpay_next_source_current_scopes current_scope
            where current_scope.root_timesheet_id=(position->>'root_timesheet_id')::uuid
              and current_scope.source_group_id=c.source_group_id),w.id,m.id) and o.active and o.contribution=1;
      magnitude:=private.bpay_next_source_nhsp_magnitude_v1(m.source_facts_json,m.canonical_pay_vector_json,m.canonical_charge_vector_json);
      if not exists(select 1 from private.bpay_next_source_current_magnitudes mag
        where mag.scope_id=origin.scope_id and mag.work_event_id=w.id and mag.magnitude_hash=origin.magnitude_hash
          and mag.selected_movement_id=m.id and mag.economic_magnitude=magnitude)
        or origin.magnitude_hash is distinct from private.weekly_source_sha256_jsonb_v1('BPAY_NEXT_SOURCE_NHSP_MAGNITUDE_V1',magnitude) then
        raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_CURRENT_MAGNITUDE_UNBOUND' using errcode='55000';end if;
      targets:=targets||jsonb_build_array(jsonb_build_object('root_timesheet_id',position->'root_timesheet_id',
        'scope_id',origin.scope_id,'movement_id',m.id,'movement_economic_hash',encode(m.movement_economic_hash,'hex'),
        'work_event_id',m.work_event_id,'candidate_id',m.candidate_id,'client_id',m.actual_client_id,'contract_id',m.contract_id,
        'economic_magnitude',magnitude,'magnitude_sha256',encode(origin.magnitude_hash,'hex')));
    end loop;
    if jsonb_array_length(targets)=0 then current_available:=false;end if;
  end if;
  select count(*),min(x.id::text)::uuid into counted,p.id from public.weekly_source_projection_publications x
    where x.upload_id=u.id and x.source_cycle_id=c.id and x.report_scope_id=scope.id
      and x.authority_scope_kind='NHSP_REPORT_SCOPE' and x.authority_scope_version=scope.version
      and ((u.purpose='ORDINARY' and x.correction_session_id is null and x.state in ('BUILDING','CURRENT'))
        or (u.purpose='FINAL_SOURCE_CORRECTION' and x.correction_session_id=correction.id
          and x.id=correction.replacement_projection_publication_id and x.state in ('BUILDING','CORRECTION_READY')));
  if counted<>1 then complete:=false;
  else
    select * into strict p from public.weekly_source_projection_publications where id=p.id;
    if p.state='CURRENT' and scope.current_projection_publication_id is distinct from p.id then
      raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_PUBLICATION_UNBOUND' using errcode='55000';end if;
    if p.authority_scope_version>2147483647 then
      raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_GENERATION_UNBOUND' using errcode='55000';end if;
    generation:=coalesce(p.projection_generation,p.authority_scope_version::integer);
  end if;
  select count(*) into total from public.weekly_source_upload_rows where upload_id=u.id;
  if total<>u.accepted_count then
    raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_POPULATION_UNBOUND' using errcode='55000';end if;
  -- Scan every genuine physical row. A missing sign is not evidence that no
  -- full negative exists. Ref Num/name/ward never substitutes event identity.
  for row in select r.* from public.weekly_source_upload_rows r where r.upload_id=u.id order by r.source_row_ordinal loop
    if row.row_finalisation_state is distinct from 'SOURCE_WORKED' or row.source_money_parse_state is distinct from 'VALID'
      or row.source_qualification_profile_version is distinct from 'NHSP_TWO_COMPONENT_PENCE_V1'
      or row.source_shift_charge_pence is null then
      raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_PHYSICAL_UNBOUND' using errcode='55000';end if;
    if row.source_shift_charge_pence>=0 then continue;end if;
    negative_count:=negative_count+1;
    select count(*) into counted from public.weekly_source_row_resolutions r
      where r.upload_row_id=row.id and r.generation=generation;
    if counted<>1 then complete:=false;
      negatives:=negatives||jsonb_build_array(jsonb_build_object('upload_row_id',row.id,
        'normalised_row_hash',encode(row.normalised_row_hash,'hex'),'state','UNAVAILABLE','reason','NATIVE_NEGATIVE_RESOLUTION_UNAVAILABLE'));
      continue;end if;
    select * into strict resolution from public.weekly_source_row_resolutions r where r.upload_row_id=row.id and r.generation=generation;
    if resolution.mapping_state<>'RESOLVED' or resolution.work_event_id is null or resolution.candidate_id is null
      or resolution.client_id is null or resolution.contract_id is null or resolution.pay_effect<>'NORMAL'
      or resolution.paid_overlap_choice_id is not null or resolution.source_row_fingerprint is distinct from row.normalised_row_hash then
      complete:=false;
      negatives:=negatives||jsonb_build_array(jsonb_build_object('upload_row_id',row.id,
        'normalised_row_hash',encode(row.normalised_row_hash,'hex'),'state','UNAVAILABLE','reason','NATIVE_NEGATIVE_RESOLUTION_UNAVAILABLE'));
      continue;end if;
    select * into strict e from public.weekly_source_row_economic_snapshots where id=
      private.weekly_source_finalisation_economic_assert_v1(resolution.id,c.id,'NHSP_WEEKLY');
    v_pay:=private.weekly_source_finalisation_vector_v1(e.id,'PAY',1::smallint);
    v_charge:=private.weekly_source_finalisation_vector_v1(e.id,'CHARGE',1::smallint);
    magnitude:=private.bpay_next_source_nhsp_magnitude_v1(jsonb_build_object('work_date',row.work_date,
      'start_at_local',row.start_at_local,'end_at_local',row.end_at_local,'break_minutes',row.break_minutes),v_pay,v_charge);
    for target in select value from jsonb_array_elements(targets) loop
      if resolution.work_event_id::text=target->>'work_event_id' and resolution.candidate_id::text=target->>'candidate_id'
        and resolution.client_id::text=target->>'client_id' and resolution.contract_id::text=target->>'contract_id'
        and magnitude=target->'economic_magnitude' then matching:=true;end if;
    end loop;
    negatives:=negatives||jsonb_build_array(jsonb_build_object('upload_row_id',row.id,'source_row_ordinal',row.source_row_ordinal,
      'normalised_row_hash',encode(row.normalised_row_hash,'hex'),'state','NATIVE_RESOLVED_NEGATIVE',
      'row_resolution_id',resolution.id,'generation',resolution.generation,'work_event_id',resolution.work_event_id,
      'candidate_id',resolution.candidate_id,'client_id',resolution.client_id,'contract_id',resolution.contract_id,
      'economic_snapshot_id',e.id,'calculation_fingerprint',encode(e.calculation_fingerprint,'hex'),
      'economic_magnitude',magnitude,'magnitude_sha256',encode(private.weekly_source_sha256_jsonb_v1(
        'BPAY_NEXT_SOURCE_NHSP_MAGNITUDE_V1',magnitude),'hex')));
  end loop;
  result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_NHSP_NEGATIVE_POPULATION_INPUT_V1',
    'upload_id',u.id,'content_sha256',encode(u.content_sha256,'hex'),'row_manifest_hash',encode(u.row_manifest_hash,'hex'),
    'source_cycle_id',c.id,'source_group_id',c.source_group_id,'report_scope_id',scope.id,'authority_scope_version',scope.version,
    'projection_publication_id',p.id,'projection_generation',generation,'work_event_id',w.id,'native_current_basis',basis,
    'current_targets',targets,'physical_row_count',total,'negative_row_count',negative_count,'negative_rows',negatives,
    'negative_population_complete',complete,'current_position_available',current_available,
    'no_reversal_proved',case when complete and current_available then to_jsonb(not matching) else 'null'::jsonb end,
    'paid_writer_permission',null);
  if octet_length(result::text)>1048576 then raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_BYTE_BOUND' using errcode='54000';end if;
  return result||jsonb_build_object('inputs_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_NHSP_NEGATIVE_POPULATION_INPUT_V1',result),'hex'));
end;
$function$;

create or replace function private.weekly_source_native_line_vat_v1(
  p_invoice_presentation_charge_pence bigint,p_vat_chargeable boolean,p_vat_rate_pct numeric
) returns jsonb language plpgsql immutable security definer
set search_path to 'public','private','pg_catalog','pg_temp' as $function$
declare v_vat_rate numeric(5,2);v_vat numeric(12,2);v_total numeric(12,2);
begin
  v_vat_rate:=case when p_vat_chargeable
    then p_vat_rate_pct else 0 end;
  v_vat:=pg_catalog.round((p_invoice_presentation_charge_pence::numeric/100)*(v_vat_rate/100),2);
  v_total:=(p_invoice_presentation_charge_pence::numeric/100)+v_vat;
  return pg_catalog.jsonb_build_object('vat_rate_pct',v_vat_rate,'vat_amount',v_vat,'total_inc_vat',v_total);
end;
$function$;

create or replace function private.weekly_source_finalisation_insert_current_movement_v1(
  p_transition_id uuid,
  p_nhsp_upload_row_id uuid,
  p_final_revision_id uuid,
  p_finalisation_cycle_id uuid,
  p_source_profile_kind text,
  p_movement_role text,
  p_source_line_kind text,
  p_row_resolution_id uuid,
  p_economic_snapshot_id uuid,
  p_invoice_timesheet_id uuid,
  p_source_validation_charge_pence bigint,
  p_invoice_presentation_charge_pence bigint,
  p_price_check_result text,
  p_price_check_fingerprint bytea,
  p_charge_acceptance_id uuid,
  p_source_facts_json jsonb,
  p_correction_unit_id uuid default null,
  p_prior_movement_id uuid default null
) returns uuid
language plpgsql volatile security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_resolution public.weekly_source_row_resolutions%rowtype;
  v_source_row public.weekly_source_upload_rows%rowtype;
  v_economic public.weekly_source_row_economic_snapshots%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_invoice_rules jsonb;
  v_invoice_amounts jsonb;
  v_source_amount boolean:=false;
  v_source_facts jsonb:=p_source_facts_json;
  v_pay_vector jsonb;
  v_charge_vector jsonb;
  v_mapping_fingerprint bytea;
  v_vat_values jsonb;
  v_vat_rate numeric(5,2);
  v_vat numeric(12,2);
  v_total numeric(12,2);
  v_hash bytea;
  v_id uuid;v_pay_effect text:='NORMAL';v_total_pay_pence bigint;v_nhsp_none_basis jsonb;
begin
  if (p_transition_id is null)::integer+(p_nhsp_upload_row_id is null)::integer<>1
     or p_final_revision_id is null or p_finalisation_cycle_id is null
     or p_source_profile_kind not in (
       'GENERIC_COMPLETE_SNAPSHOT','NHSP_TRUST_BACKING_REPORT','HEALTHROSTER_ACTUAL_ROWS'
     )
     or p_movement_role not in ('POSITIVE','REPLACEMENT','REVERSAL')
     or p_source_line_kind not in (
       'SOURCE_ORDINARY','SOURCE_REPLACEMENT','NHSP_PHYSICAL_POSITIVE','NHSP_PHYSICAL_FULL_NEGATIVE'
     )
     or pg_catalog.jsonb_typeof(p_source_facts_json)<>'object' then
    raise exception 'WEEKLY_SOURCE_MOVEMENT_INPUT_INVALID' using errcode='22023';
  end if;
  select * into strict v_resolution
  from public.weekly_source_row_resolutions where id=p_row_resolution_id;
  select * into strict v_source_row
  from public.weekly_source_upload_rows where id=v_resolution.upload_row_id;
  select * into strict v_upload
  from public.weekly_source_uploads where id=v_source_row.upload_id;
  select * into strict v_economic
  from public.weekly_source_row_economic_snapshots where id=p_economic_snapshot_id;
  v_invoice_rules:=private.weekly_source_frozen_rule_values_v1(p_final_revision_id);
  v_source_amount:=v_invoice_rules is not null and v_invoice_rules->>'invoice_sender'='CLIENT_SELF_BILL' and v_invoice_rules->>'invoice_amount_basis'='SOURCE_AMOUNT' and v_invoice_rules->>'source_amount_basis'='EXPORT_ACTUAL_COST_INC_VAT_NET_AGENCY_WORKER_PAY';
  if v_economic.row_resolution_id is distinct from v_resolution.id
     or v_resolution.mapping_state<>'RESOLVED'
     or p_invoice_timesheet_id is null
     or not exists(
       select 1
       from public.weekly_source_final_revisions revision
       where revision.id=p_final_revision_id
         and revision.source_cycle_id=p_finalisation_cycle_id
         and (
           revision.state='CURRENT'
           or (
             revision.state='PREPARED'
             and revision.reason='CORRECT_FINAL_SOURCE'
             and exists(
               select 1
               from public.weekly_final_source_correction_sessions correction
               join public.weekly_source_uploads replacement_upload
                 on replacement_upload.id=correction.replacement_correction_upload_id
                and replacement_upload.id=revision.upload_id
                and replacement_upload.source_cycle_id=revision.source_cycle_id
                and replacement_upload.state='CORRECTION_READY'
               join public.weekly_source_projection_publications replacement_publication
                 on replacement_publication.id=correction.replacement_projection_publication_id
                and replacement_publication.upload_id=replacement_upload.id
                and replacement_publication.source_cycle_id=revision.source_cycle_id
                and replacement_publication.state='CORRECTION_READY'
               where correction.source_cycle_id=revision.source_cycle_id
                 and correction.authority_scope_kind=revision.authority_scope_kind
                 and correction.report_scope_id is not distinct from revision.report_scope_id
                 and correction.state='PREPARING'
                 and correction.expected_current_final_revision_id=revision.predecessor_revision_id
             )
           )
         )
     )
     or private.weekly_source_finalisation_economic_assert_v1(
          p_row_resolution_id,p_finalisation_cycle_id,
          case when p_source_profile_kind='NHSP_TRUST_BACKING_REPORT'
            then 'NHSP_WEEKLY' else 'HEALTHROSTER_WEEKLY' end
        ) is distinct from p_economic_snapshot_id
     or private.weekly_source_finalisation_lineage_assert_v1(
          p_row_resolution_id,p_finalisation_cycle_id
        ) is distinct from p_invoice_timesheet_id
     or (p_source_profile_kind='NHSP_TRUST_BACKING_REPORT') is distinct from
        (p_nhsp_upload_row_id is not null)
     or (p_source_profile_kind='NHSP_TRUST_BACKING_REPORT' and (
       p_nhsp_upload_row_id is distinct from v_source_row.id
       or p_source_validation_charge_pence is null
       or p_source_validation_charge_pence is distinct from v_source_row.source_shift_charge_pence
       or p_source_validation_charge_pence is distinct from p_invoice_presentation_charge_pence
       or p_price_check_result not in ('EXACT','SOURCE_ROUNDING_EQUIVALENT','ACCEPTED_DISPARITY','ACCEPTED_ZERO')
       or p_price_check_fingerprint is distinct from v_economic.calculation_fingerprint
       or (p_price_check_result in ('EXACT','SOURCE_ROUNDING_EQUIVALENT')) is distinct from
          (p_charge_acceptance_id is null)
       or (p_price_check_result in ('ACCEPTED_DISPARITY','ACCEPTED_ZERO') and not exists(
         select 1
         from public.weekly_source_charge_acceptances acceptance
         join public.weekly_source_charge_checks charge_check
           on charge_check.id=acceptance.charge_check_id
         where acceptance.id=p_charge_acceptance_id
           and acceptance.upload_row_id=v_source_row.id
           and acceptance.row_resolution_id=v_resolution.id
           and acceptance.source_upload_id=v_upload.id
           and acceptance.contract_id=v_resolution.contract_id
           and acceptance.acceptance_kind=p_price_check_result
           and acceptance.source_upload_hash=v_upload.content_sha256
           and acceptance.source_row_fingerprint=v_resolution.source_row_fingerprint
           and acceptance.contract_and_rate_fingerprint=v_economic.contract_and_rate_fingerprint
           and acceptance.effective_policy_fingerprint=v_economic.effective_policy_fingerprint
           and acceptance.charge_calculation_fingerprint=v_economic.calculation_fingerprint
           and acceptance.acceptance_policy_fingerprint=
             private.weekly_source_charge_acceptance_policy_fingerprint_v1()
           and charge_check.upload_row_id=v_source_row.id
           and charge_check.row_resolution_id=v_resolution.id
           and charge_check.charge_calculation_fingerprint=v_economic.calculation_fingerprint
           and charge_check.comparison_result=case p_price_check_result
             when 'ACCEPTED_ZERO' then 'ZERO_SOURCE_CHARGE' else 'MISMATCH' end
       ))
       or p_correction_unit_id is not null
       or p_prior_movement_id is not null
       or not (
         (v_economic.row_sign=1 and p_movement_role='POSITIVE'
           and p_source_line_kind='NHSP_PHYSICAL_POSITIVE'
           and v_source_row.source_shift_charge_pence>=0)
         or (v_economic.row_sign=-1 and p_movement_role='REVERSAL'
           and p_source_line_kind='NHSP_PHYSICAL_FULL_NEGATIVE'
           and v_source_row.source_shift_charge_pence<0)
       )
     ))
     or (p_source_profile_kind<>'NHSP_TRUST_BACKING_REPORT' and (
       (not v_source_amount and (p_source_validation_charge_pence is not null
         or p_invoice_presentation_charge_pence is distinct from v_economic.calculated_charge_pence
         or p_price_check_result<>'NOT_APPLICABLE' or p_price_check_fingerprint is not null or p_charge_acceptance_id is not null))
       or (v_source_amount and (p_source_validation_charge_pence is distinct from v_source_row.source_shift_charge_pence
         or p_invoice_presentation_charge_pence is distinct from v_source_row.source_shift_charge_pence
         or p_price_check_result not in ('EXACT','SOURCE_ROUNDING_EQUIVALENT','SOURCE_AMOUNT_DIFFERS','ACCEPTED_DISPARITY')
         or p_price_check_fingerprint is distinct from v_economic.calculation_fingerprint
         or ((p_price_check_result='ACCEPTED_DISPARITY') is distinct from (p_charge_acceptance_id is not null))))
       or v_economic.row_sign<>1
       or not (
         (p_movement_role='POSITIVE' and p_source_line_kind='SOURCE_ORDINARY'
           and p_correction_unit_id is null and p_prior_movement_id is null)
         or (p_movement_role='REPLACEMENT' and p_source_line_kind='SOURCE_REPLACEMENT'
           and p_correction_unit_id is not null and p_prior_movement_id is not null)
       )
     )) then
    raise exception 'WEEKLY_SOURCE_MOVEMENT_AUTHORITY_INVALID' using errcode='55000';
  end if;
  if p_source_profile_kind='NHSP_TRUST_BACKING_REPORT' then
    if not exists(
      select 1
      from public.weekly_source_final_revisions revision
      where revision.id=p_final_revision_id
        and revision.authority_scope_kind='NHSP_REPORT_SCOPE'
    ) then
      raise exception 'WEEKLY_SOURCE_MOVEMENT_SCOPE_INVALID' using errcode='55000';
    end if;
  elsif not exists(
    select 1
    from public.weekly_source_state_transitions transition_row
    where transition_row.id=p_transition_id
      and transition_row.final_revision_id=p_final_revision_id
      and transition_row.finalisation_cycle_id=p_finalisation_cycle_id
      and transition_row.work_event_id=v_resolution.work_event_id
      and transition_row.outcome=case when p_movement_role='POSITIVE' then 'ADD' else 'AMEND' end
  ) then
    raise exception 'WEEKLY_SOURCE_MOVEMENT_TRANSITION_INVALID' using errcode='55000';
  end if;

  if p_source_profile_kind<>'NHSP_TRUST_BACKING_REPORT' and v_invoice_rules is not null and v_invoice_rules->>'invoice_sender'='CLIENT_SELF_BILL' then
    v_invoice_amounts:=private.weekly_source_invoice_line_amounts_v1(v_resolution.id,p_final_revision_id);
    if (v_invoice_amounts->>'net_pence')::bigint is distinct from p_invoice_presentation_charge_pence
      or v_invoice_amounts->>'price_check_result' is distinct from p_price_check_result
      or nullif(v_invoice_amounts->>'charge_acceptance_id','')::uuid is distinct from p_charge_acceptance_id then raise exception 'WEEKLY_SOURCE_INVOICE_MONEY_NOT_REDERIVED' using errcode='55000'; end if;
    v_source_facts:=v_source_facts||jsonb_build_object('rule_set_version_id',v_invoice_amounts->'rule_set_version_id',
      'rule_set_values_sha256',(select version.values_sha256 from public.weekly_source_rule_set_versions version where version.id=(v_invoice_amounts->>'rule_set_version_id')::uuid),
      'invoice_hold',v_invoice_amounts->'invoice_hold','hold_release_id',v_invoice_amounts->'hold_release_id');
  end if;
  v_total_pay_pence:=v_economic.total_pay_pence;
  if v_resolution.pay_effect='NONE' then
    if p_source_profile_kind<>'NHSP_TRUST_BACKING_REPORT' or p_source_line_kind<>'NHSP_PHYSICAL_POSITIVE'
      or p_movement_role<>'POSITIVE' or p_nhsp_upload_row_id is distinct from v_source_row.id
      or p_transition_id is not null or p_correction_unit_id is not null or p_prior_movement_id is not null
      or v_economic.row_sign<>1 then
      raise exception 'WEEKLY_SOURCE_NHSP_NONE_MOVEMENT_SCOPE_UNBOUND' using errcode='55000';end if;
    v_nhsp_none_basis:=private.weekly_source_nhsp_none_invoice_basis_v1(v_resolution.id,p_final_revision_id);
    perform private.weekly_source_nhsp_none_write_admit_v1(v_nhsp_none_basis,p_final_revision_id);
    if v_nhsp_none_basis->>'invoice_timesheet_id' is distinct from p_invoice_timesheet_id::text
      or v_nhsp_none_basis#>>'{native_invoice_values,source_shift_charge_pence}' is distinct from p_invoice_presentation_charge_pence::text then
      raise exception 'WEEKLY_SOURCE_NHSP_NONE_NORMAL_WITNESS_NOT_CURRENT' using errcode='55000';end if;
    -- The raw physical B source remains this origin. Removing only its generic
    -- pay-lineage key cannot mint a replacement of A's genuine NORMAL origin.
    v_source_facts:=(v_source_facts-'row_resolution_id')||jsonb_build_object(
      'bound_row_resolution_id',v_resolution.id,'pay_effect','NONE','nhsp_none_invoice_basis',v_nhsp_none_basis);
    v_pay_effect:='NONE';v_total_pay_pence:=0;
  end if;
  v_pay_vector:=case when v_pay_effect='NONE' then private.weekly_source_nhsp_invoice_only_vector_v1('PAY',0)
    else private.weekly_source_finalisation_vector_v1(v_economic.id,'PAY',1::smallint) end;
  v_charge_vector:=case when v_pay_effect='NONE' then private.weekly_source_nhsp_invoice_only_vector_v1('CHARGE',p_invoice_presentation_charge_pence)
    else private.weekly_source_finalisation_vector_v1(v_economic.id,'CHARGE',1::smallint) end;
  v_mapping_fingerprint:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_MAPPING_RATE_POLICY_V1',
    pg_catalog.jsonb_build_object(
      'row_resolution_id',v_resolution.id,
      'work_event_id',v_resolution.work_event_id,
      'candidate_id',v_resolution.candidate_id,
      'client_id',v_resolution.client_id,
      'contract_id',v_resolution.contract_id,
      'contract_and_rate_fingerprint',pg_catalog.encode(v_economic.contract_and_rate_fingerprint,'hex'),
      'effective_policy_fingerprint',pg_catalog.encode(v_economic.effective_policy_fingerprint,'hex'),
      'invoice_vat_policy_fingerprint',pg_catalog.encode(v_economic.invoice_vat_policy_fingerprint,'hex'),
      'calculation_fingerprint',pg_catalog.encode(v_economic.calculation_fingerprint,'hex')
    )
  );
  v_vat_values:=private.weekly_source_native_line_vat_v1(p_invoice_presentation_charge_pence,v_economic.invoice_vat_chargeable,v_economic.invoice_vat_rate_pct);
  v_vat_rate:=(v_vat_values->>'vat_rate_pct')::numeric;
  v_vat:=(v_vat_values->>'vat_amount')::numeric;
  v_total:=(v_vat_values->>'total_inc_vat')::numeric;
  if v_invoice_amounts is not null then v_vat:=(v_invoice_amounts->>'vat_pence')::numeric/100; v_total:=(v_invoice_amounts->>'gross_pence')::numeric/100; end if;
  v_hash:=private.weekly_source_billing_movement_hash_v1(
    pg_catalog.jsonb_build_object(
      'transition_id',p_transition_id,'nhsp_upload_row_id',p_nhsp_upload_row_id,
      'final_revision_id',p_final_revision_id,'finalisation_cycle_id',p_finalisation_cycle_id,
      'actual_client_id',v_resolution.client_id,'candidate_id',v_resolution.candidate_id,
      'contract_id',v_resolution.contract_id,'work_event_id',v_resolution.work_event_id,
      'movement_role',p_movement_role,'correction_unit_id',p_correction_unit_id,
      'prior_movement_id',p_prior_movement_id,'source_profile_kind',p_source_profile_kind,
      'source_line_kind',p_source_line_kind,'source_facts',v_source_facts,
      'pay_vector',v_pay_vector,'charge_vector',v_charge_vector,
      'total_pay_pence',v_total_pay_pence,
      'calculated_comparison_charge_pence',v_economic.calculated_charge_pence,
      'source_validation_charge_pence',p_source_validation_charge_pence,
      'invoice_presentation_charge_pence',p_invoice_presentation_charge_pence,
      'vat_rate_pct',v_vat_rate,'vat_amount',v_vat,'total_inc_vat',v_total,
      'price_check_result',p_price_check_result,
      'price_check_fingerprint',case when p_price_check_fingerprint is null then null
        else pg_catalog.encode(p_price_check_fingerprint,'hex') end,
      'charge_acceptance_id',p_charge_acceptance_id,
      'mapping_rate_policy_fingerprint',pg_catalog.encode(v_mapping_fingerprint,'hex'),
      'invoice_timesheet_id',p_invoice_timesheet_id
    )||case when v_pay_effect='NONE' then jsonb_build_object('pay_effect','NONE') else '{}'::jsonb end
  );
  insert into public.weekly_source_billing_movements(
    transition_id,nhsp_upload_row_id,pay_effect,final_revision_id,finalisation_cycle_id,
    actual_client_id,candidate_id,contract_id,work_event_id,movement_role,
    correction_unit_id,prior_movement_id,source_profile_kind,source_line_kind,
    source_facts_json,canonical_pay_vector_json,canonical_charge_vector_json,
    total_pay_ex_vat,calculated_comparison_charge_pence,
    source_validation_charge_pence,invoice_presentation_charge_pence,
    vat_rate_pct,vat_amount,total_inc_vat,price_check_result,price_check_fingerprint,
    charge_acceptance_id,mapping_rate_policy_fingerprint,invoice_timesheet_id,original_cycle_key,
    movement_economic_hash,placement_state
  ) values (
    p_transition_id,p_nhsp_upload_row_id,v_pay_effect,p_final_revision_id,p_finalisation_cycle_id,
    v_resolution.client_id,v_resolution.candidate_id,v_resolution.contract_id,
    v_resolution.work_event_id,p_movement_role,p_correction_unit_id,p_prior_movement_id,
    p_source_profile_kind,p_source_line_kind,v_source_facts,v_pay_vector,v_charge_vector,
    v_total_pay_pence::numeric/100,v_economic.calculated_charge_pence,
    p_source_validation_charge_pence,p_invoice_presentation_charge_pence,
    v_vat_rate,v_vat,v_total,p_price_check_result,p_price_check_fingerprint,
    p_charge_acceptance_id,v_mapping_fingerprint,p_invoice_timesheet_id,p_finalisation_cycle_id::text,
    v_hash,'UNPLACED'
  ) returning id into v_id;
  if v_pay_effect='NONE' then perform private.weekly_source_nhsp_none_invoice_origin_assert_v1(v_id);end if;
  return v_id;
end;
$function$;

create or replace function private.weekly_source_nhsp_price_admission_v1(
  p_row_resolution_id uuid,p_source_cycle_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'public','private','pg_catalog','pg_temp' as $function$
declare v_row record;v_upload public.weekly_source_uploads%rowtype;
  v_economic public.weekly_source_row_economic_snapshots%rowtype;v_generation integer;
  v_charge_check public.weekly_source_charge_checks%rowtype;
  v_charge_acceptance public.weekly_source_charge_acceptances%rowtype;v_price_admission_result text;
begin
  select source_row.*,resolution.id as resolution_id,resolution.work_event_id,
    resolution.candidate_id,resolution.client_id,resolution.contract_id,resolution.generation
    into strict v_row from public.weekly_source_upload_rows source_row
    join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=source_row.id
    where resolution.id=p_row_resolution_id;
  select * into strict v_upload from public.weekly_source_uploads where id=v_row.upload_id;
  if v_upload.source_cycle_id is distinct from p_source_cycle_id then
    raise exception 'WEEKLY_SOURCE_NHSP_PRICE_SCOPE_UNBOUND' using errcode='55000';end if;
  select * into strict v_economic from public.weekly_source_row_economic_snapshots where id=
    private.weekly_source_finalisation_economic_assert_v1(v_row.resolution_id,p_source_cycle_id,'NHSP_WEEKLY');
  v_generation:=v_row.generation;
      select * into v_charge_check
      from public.weekly_source_charge_checks charge_check
      where charge_check.upload_row_id=v_row.id
        and charge_check.row_resolution_id=v_row.resolution_id
        and charge_check.generation=v_generation;
      v_charge_acceptance.id:=null;
      if found and v_charge_check.comparison_result in ('MISMATCH','ZERO_SOURCE_CHARGE') then
        select * into v_charge_acceptance
        from public.weekly_source_charge_acceptances acceptance
        where acceptance.charge_check_id=v_charge_check.id
          and acceptance.upload_row_id=v_row.id
          and acceptance.row_resolution_id=v_row.resolution_id
          and acceptance.source_upload_id=v_upload.id
          and acceptance.contract_id=v_row.contract_id
          and acceptance.acceptance_kind=case v_charge_check.comparison_result
            when 'ZERO_SOURCE_CHARGE' then 'ACCEPTED_ZERO' else 'ACCEPTED_DISPARITY' end
          and acceptance.source_upload_hash=v_upload.content_sha256
          and acceptance.source_row_fingerprint=(select resolution.source_row_fingerprint
            from public.weekly_source_row_resolutions resolution where resolution.id=v_row.resolution_id)
          and acceptance.contract_and_rate_fingerprint=v_economic.contract_and_rate_fingerprint
          and acceptance.effective_policy_fingerprint=v_economic.effective_policy_fingerprint
          and acceptance.charge_calculation_fingerprint=v_economic.calculation_fingerprint
          and acceptance.acceptance_policy_fingerprint=
            private.weekly_source_charge_acceptance_policy_fingerprint_v1();
      end if;
      v_price_admission_result:=case v_charge_check.comparison_result
        when 'ZERO_SOURCE_CHARGE' then 'ACCEPTED_ZERO'
        when 'MISMATCH' then 'ACCEPTED_DISPARITY'
        else v_charge_check.comparison_result end;
      if not found or (select pg_catalog.count(*)
          from public.weekly_source_charge_checks charge_check
          where charge_check.upload_row_id=v_row.id
            and charge_check.row_resolution_id=v_row.resolution_id
            and charge_check.generation=v_generation)<>1
         or v_charge_check.source_commission_pence is distinct from v_row.source_commission_pence
         or v_charge_check.source_total_cost_pence is distinct from v_row.source_total_cost_pence
         or v_charge_check.source_shift_charge_pence is distinct from v_row.source_shift_charge_pence
         or v_charge_check.calculated_segment_charge_pence is distinct from v_economic.calculated_charge_pence
         or v_charge_check.source_charge_difference_pence is distinct from
              (v_row.source_shift_charge_pence-v_economic.calculated_charge_pence)
         or v_charge_check.charge_calculation_fingerprint is distinct from
              v_economic.calculation_fingerprint
         or v_charge_check.comparison_profile_version<>'NHSP_TWO_COMPONENT_PENCE_V1'
         or v_charge_check.comparison_result not in (
              'EXACT','SOURCE_ROUNDING_EQUIVALENT','MISMATCH','ZERO_SOURCE_CHARGE'
            )
         or not (
           (v_charge_check.comparison_result='EXACT'
             and v_charge_check.source_charge_difference_pence=0)
           or (v_charge_check.comparison_result='SOURCE_ROUNDING_EQUIVALENT'
             and v_charge_check.row_sign_kind in ('POSITIVE','FULL_NEGATIVE')
             and (v_charge_check.source_charge_difference_pence=1
               or v_charge_check.source_charge_difference_pence=-1)
             and ((v_charge_check.source_shift_charge_pence>0
                   and v_charge_check.calculated_segment_charge_pence>0)
               or (v_charge_check.source_shift_charge_pence<0
                   and v_charge_check.calculated_segment_charge_pence<0)))
           or (v_charge_check.comparison_result='MISMATCH'
             and v_charge_acceptance.id is not null
             and v_charge_acceptance.acceptance_kind='ACCEPTED_DISPARITY')
           or (v_charge_check.comparison_result='ZERO_SOURCE_CHARGE'
             and v_charge_check.source_commission_pence=0
             and v_charge_check.source_total_cost_pence=0
             and v_charge_check.source_shift_charge_pence=0
             and v_charge_check.calculated_segment_charge_pence>0
             and v_charge_acceptance.id is not null
             and v_charge_acceptance.acceptance_kind='ACCEPTED_ZERO')
         )
         or v_charge_check.row_sign_kind is distinct from (case
              when v_economic.row_sign=1 then 'POSITIVE' else 'FULL_NEGATIVE' end)
         or v_charge_check.phase_severity='FINALISATION_BLOCKER'
         or v_charge_check.blocker_code is not null then
        raise exception 'WEEKLY_SOURCE_NHSP_PRICE_GATE_FAILED'
          using errcode='55000',detail=v_row.source_row_ordinal::text;
      end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_NHSP_PRICE_ADMISSION_V1',
    'upload_row_id',v_row.id,'row_resolution_id',v_row.resolution_id,'economic_snapshot_id',v_economic.id,
    'charge_check',to_jsonb(v_charge_check),'charge_acceptance',to_jsonb(v_charge_acceptance),
    'price_admission_result',v_price_admission_result);
end;
$function$;

create or replace function private.weekly_source_nhsp_invoice_values_v1(
  p_row_resolution_id uuid,p_source_cycle_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare r public.weekly_source_row_resolutions%rowtype;s public.weekly_source_upload_rows%rowtype;
  u public.weekly_source_uploads%rowtype;e public.weekly_source_row_economic_snapshots%rowtype;
  admission jsonb;vat jsonb;result jsonb;
begin
  select * into strict r from public.weekly_source_row_resolutions where id=p_row_resolution_id;
  select * into strict s from public.weekly_source_upload_rows where id=r.upload_row_id;
  select * into strict u from public.weekly_source_uploads where id=s.upload_id;
  if u.source_cycle_id is distinct from p_source_cycle_id or u.report_scope_id is null
    or not exists(select 1 from public.weekly_source_report_scopes scope
      where scope.id=u.report_scope_id and scope.source_cycle_id=u.source_cycle_id
        and scope.client_id=r.client_id and scope.self_bill_report_id is null)
    or not exists(select 1 from public.weekly_source_format_profiles profile
      where profile.id=u.source_format_profile_id and profile.profile_code='NHSP_FINAL_BACKING_V1')
    or s.row_finalisation_state is distinct from 'SOURCE_WORKED' or s.source_money_parse_state is distinct from 'VALID'
    or s.source_qualification_profile_version is distinct from 'NHSP_TWO_COMPONENT_PENCE_V1'
    or s.source_shift_charge_pence is null or s.source_shift_charge_pence<0 then
    raise exception 'WEEKLY_SOURCE_NHSP_INVOICE_VALUES_SCOPE_UNBOUND' using errcode='55000';end if;
  admission:=private.weekly_source_nhsp_price_admission_v1(r.id,p_source_cycle_id);
  select * into strict e from public.weekly_source_row_economic_snapshots where id=(admission->>'economic_snapshot_id')::uuid;
  if e.row_sign<>1 then raise exception 'WEEKLY_SOURCE_NHSP_INVOICE_VALUES_SIGN_UNBOUND' using errcode='55000';end if;
  vat:=private.weekly_source_native_line_vat_v1(s.source_shift_charge_pence,e.invoice_vat_chargeable,e.invoice_vat_rate_pct);
  result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_NHSP_NATIVE_INVOICE_VALUES_V1',
    'row_resolution_id',r.id,'upload_row_id',s.id,'economic_snapshot_id',e.id,'source_cycle_id',p_source_cycle_id,
    'source_commission_pence',s.source_commission_pence,'source_total_cost_pence',s.source_total_cost_pence,
    'source_shift_charge_pence',s.source_shift_charge_pence,'calculated_comparison_charge_pence',e.calculated_charge_pence,
    'native_price_admission',admission,'native_line_vat',vat,'paid_writer_permission',null);
  return result||jsonb_build_object('inputs_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_NHSP_NATIVE_INVOICE_VALUES_V1',result),'hex'));
end;
$function$;

create or replace function private.weekly_source_nhsp_negative_comparison_v1(p_inputs jsonb)
returns jsonb language plpgsql immutable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare n jsonb;t jsonb;basis jsonb;magnitude jsonb;key text;rows jsonb:='[]'::jsonb;result jsonb;ordinal integer:=0;
begin
  if jsonb_typeof(p_inputs) is distinct from 'object'
    or not p_inputs ?& array['schema_version','upload_id','content_sha256','row_manifest_hash',
      'source_cycle_id','source_group_id','report_scope_id','authority_scope_version',
      'projection_publication_id','projection_generation','work_event_id','native_current_basis',
      'current_targets','physical_row_count','negative_row_count','negative_rows',
      'negative_population_complete','current_position_available','no_reversal_proved','paid_writer_permission','inputs_sha256']
    or exists(select 1 from jsonb_object_keys(p_inputs) k where k not in
      ('schema_version','upload_id','content_sha256','row_manifest_hash','source_cycle_id','source_group_id',
       'report_scope_id','authority_scope_version','projection_publication_id','projection_generation','work_event_id',
       'native_current_basis','current_targets','physical_row_count','negative_row_count','negative_rows',
       'negative_population_complete','current_position_available','no_reversal_proved','paid_writer_permission','inputs_sha256'))
    or p_inputs->>'schema_version' is distinct from 'WEEKLY_SOURCE_NHSP_NEGATIVE_POPULATION_INPUT_V1'
    or p_inputs->>'inputs_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_NHSP_NEGATIVE_POPULATION_INPUT_V1',p_inputs-'inputs_sha256'),'hex')
    or p_inputs->'negative_population_complete' is distinct from 'true'::jsonb
    or p_inputs->'current_position_available' is distinct from 'true'::jsonb
    or p_inputs->'no_reversal_proved' is distinct from 'true'::jsonb
    or p_inputs->'paid_writer_permission' is distinct from 'null'::jsonb
    or jsonb_typeof(p_inputs->'current_targets') is distinct from 'array'
    or jsonb_typeof(p_inputs->'negative_rows') is distinct from 'array'
    or jsonb_typeof(p_inputs->'physical_row_count') is distinct from 'number'
    or jsonb_typeof(p_inputs->'negative_row_count') is distinct from 'number'
    or jsonb_typeof(p_inputs->'projection_generation') is distinct from 'number'
    or jsonb_typeof(p_inputs->'authority_scope_version') is distinct from 'number'
    or coalesce(p_inputs->>'authority_scope_version','')!~'^[1-9][0-9]*$'
    or coalesce(p_inputs->>'content_sha256','')!~'^[0-9a-f]{64}$'
    or coalesce(p_inputs->>'row_manifest_hash','')!~'^[0-9a-f]{64}$'
    or coalesce(p_inputs->>'physical_row_count','')!~'^[0-9]+$'
    or coalesce(p_inputs->>'negative_row_count','')!~'^[0-9]+$'
    or coalesce(p_inputs->>'projection_generation','')!~'^[1-9][0-9]*$' then
    raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_COMPARISON_UNBOUND' using errcode='55000';end if;
  if (p_inputs->>'negative_row_count')::numeric>2147483647
    or (p_inputs->>'physical_row_count')::numeric>2147483647
    or (p_inputs->>'projection_generation')::numeric>2147483647
    or jsonb_array_length(p_inputs->'negative_rows')<>(p_inputs->>'negative_row_count')::integer
    or (p_inputs->>'negative_row_count')::integer>(p_inputs->>'physical_row_count')::integer
    or jsonb_array_length(p_inputs->'current_targets')=0 then
    raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_COMPARISON_UNBOUND' using errcode='55000';end if;
  foreach t in array array[p_inputs->'upload_id',p_inputs->'source_cycle_id',p_inputs->'source_group_id',
    p_inputs->'report_scope_id',p_inputs->'projection_publication_id',p_inputs->'work_event_id'] loop
    if jsonb_typeof(t) is distinct from 'string' or trim(both '"' from t::text)!~'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' then
      raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_COMPARISON_UNBOUND' using errcode='55000';end if;
  end loop;
  basis:=p_inputs->'native_current_basis';
  if basis->>'schema_version' is distinct from 'WEEKLY_SOURCE_NHSP_PAID_OVERLAP_BASIS_INPUT_V1'
    or basis->>'state' is distinct from 'NATIVE_POSITION_INPUTS'
    or basis->>'inputs_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_NHSP_PAID_OVERLAP_BASIS_INPUT_V1',basis-'inputs_sha256'),'hex')
    or basis->'work_event_id' is distinct from p_inputs->'work_event_id'
    or basis->'source_cycle_id' is distinct from p_inputs->'source_cycle_id'
    or basis->'source_group_id' is distinct from p_inputs->'source_group_id' then
    raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_COMPARISON_UNBOUND' using errcode='55000';end if;
  -- Validate each full native magnitude before making any comparison copy.
  -- This validates the codec grain only; it does not re-price the values or
  -- replace the real current Source constructor's provenance admission.
  for magnitude in
    select x->'economic_magnitude' from jsonb_array_elements(p_inputs->'negative_rows') x
    union all select x->'economic_magnitude' from jsonb_array_elements(p_inputs->'current_targets') x
  loop
    if jsonb_typeof(magnitude) is distinct from 'object' or not magnitude ?& array['work_date','start_at_local',
      'end_at_local','break_minutes','hours_day','hours_night','hours_sat','hours_sun','hours_bh','pay_pence','charge_pence']
      or exists(select 1 from jsonb_object_keys(magnitude) k where k not in ('work_date','start_at_local',
        'end_at_local','break_minutes','hours_day','hours_night','hours_sat','hours_sun','hours_bh','pay_pence','charge_pence')) then
      raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_COMPARISON_UNBOUND' using errcode='55000';end if;
    foreach key in array array['work_date','start_at_local','end_at_local','break_minutes','hours_day','hours_night',
      'hours_sat','hours_sun','hours_bh','pay_pence','charge_pence'] loop
      if jsonb_typeof(magnitude->key) is distinct from 'string' then
        raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_COMPARISON_UNBOUND' using errcode='55000';end if;
    end loop;
  end loop;
  for n in select value from jsonb_array_elements(p_inputs->'negative_rows') loop
    if jsonb_typeof(n) is distinct from 'object' or not n ?& array['upload_row_id','source_row_ordinal','normalised_row_hash',
      'state','row_resolution_id','generation','work_event_id','candidate_id','client_id','contract_id',
      'economic_snapshot_id','calculation_fingerprint','economic_magnitude','magnitude_sha256']
      or exists(select 1 from jsonb_object_keys(n) k where k not in ('upload_row_id','source_row_ordinal','normalised_row_hash',
        'state','row_resolution_id','generation','work_event_id','candidate_id','client_id','contract_id',
        'economic_snapshot_id','calculation_fingerprint','economic_magnitude','magnitude_sha256'))
      or n->>'state' is distinct from 'NATIVE_RESOLVED_NEGATIVE'
      or n->'generation' is distinct from p_inputs->'projection_generation'
      or jsonb_typeof(n->'source_row_ordinal') is distinct from 'number'
      or coalesce(n->>'source_row_ordinal','')!~'^[1-9][0-9]*$'
      or coalesce(n->>'normalised_row_hash','')!~'^[0-9a-f]{64}$'
      or coalesce(n->>'calculation_fingerprint','')!~'^[0-9a-f]{64}$'
      or n->>'magnitude_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'BPAY_NEXT_SOURCE_NHSP_MAGNITUDE_V1',n->'economic_magnitude'),'hex') then
      raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_COMPARISON_UNBOUND' using errcode='55000';end if;
    if (n->>'source_row_ordinal')::numeric>2147483647 or (n->>'source_row_ordinal')::integer<=ordinal then
      raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_COMPARISON_UNBOUND' using errcode='55000';end if;
    ordinal:=(n->>'source_row_ordinal')::integer;
    foreach t in array array[n->'upload_row_id',n->'row_resolution_id',n->'economic_snapshot_id',n->'work_event_id',
      n->'candidate_id',n->'client_id',n->'contract_id'] loop
      if jsonb_typeof(t) is distinct from 'string' or trim(both '"' from t::text)!~'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' then
        raise exception 'WEEKLY_SOURCE_NHSP_NEGATIVE_COMPARISON_UNBOUND' using errcode='55000';end if;
    end loop;
    -- Only these actual rebuild record IDs/generation differ when one exact
    -- native C1/source fact is resolved again. Row/hash/event/full economic
    -- magnitude and calculation fingerprint remain comparison authorities.
    rows:=rows||jsonb_build_array(n-'row_resolution_id'-'economic_snapshot_id'-'generation');
  end loop;
  result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_NHSP_NEGATIVE_COMPARISON_FACTS_V1',
    'upload_id',p_inputs->'upload_id','content_sha256',p_inputs->'content_sha256','row_manifest_hash',p_inputs->'row_manifest_hash',
    'source_cycle_id',p_inputs->'source_cycle_id','source_group_id',p_inputs->'source_group_id',
    'report_scope_id',p_inputs->'report_scope_id','work_event_id',p_inputs->'work_event_id',
    'native_current_basis',basis,'current_targets',p_inputs->'current_targets',
    'physical_row_count',p_inputs->'physical_row_count','negative_row_count',p_inputs->'negative_row_count','negative_rows',rows,
    'negative_population_complete',true,'current_position_available',true,'no_reversal_proved',true,'paid_writer_permission',null);
  return result||jsonb_build_object('facts_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_NHSP_NEGATIVE_COMPARISON_FACTS_V1',result),'hex'));
end;
$function$;

create or replace function private.weekly_source_paid_choice_immutable_v1(p_upload_row_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp' as $function$
declare v_choice private.weekly_source_office_row_choices%rowtype;
  v_journal private.weekly_source_office_rechecks%rowtype;v_audit public.audit_events%rowtype;v_count integer;v_saved jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into v_choice from private.weekly_source_office_row_choices
    where upload_row_id=p_upload_row_id order by id desc limit 1;
  if v_choice.paid_overlap_target_work_event_id is null then return null;end if;
  v_saved:=v_choice.paid_overlap_inputs_json;
  if v_saved->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_ADMISSION_V1'
    or v_saved->>'upload_row_id' is distinct from v_choice.upload_row_id::text
    or v_saved->>'candidate_id' is distinct from v_choice.candidate_id::text
    or v_saved->>'client_id' is distinct from v_choice.client_id::text
    or v_saved->>'contract_id' is distinct from v_choice.contract_id::text
    or v_saved->>'actor_user_id' is distinct from v_choice.actor_user_id::text
    or v_saved->>'paid_overlap_target_work_event_id' is distinct from v_choice.paid_overlap_target_work_event_id::text
    or v_saved->>'pay_effect' is distinct from v_choice.pay_effect
    or v_saved->>'reason' is distinct from v_choice.match_reason
    or v_saved->>'inputs_sha256' is distinct from encode(v_choice.paid_overlap_inputs_sha256,'hex') then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_UNBOUND' using errcode='55000';end if;
  select * into strict v_journal from private.weekly_source_office_rechecks
    where request_id=(v_saved->>'request_id')::uuid;
  if v_journal.actor_user_id is distinct from v_choice.actor_user_id
    or v_journal.upload_id::text is distinct from v_saved->>'upload_id'
    or encode(v_journal.request_hash,'hex') is distinct from v_saved->>'request_sha256'
    or v_journal.request_hash is distinct from private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_OFFICE_RECHECK_V1',v_journal.request_json) then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_UNBOUND' using errcode='55000';end if;
  select count(*) into v_count from public.audit_events a
    where a.object_type='weekly_source_office_row_choices' and a.object_id_text=v_choice.id::text
      and a.action='WEEKLY_SOURCE_PAID_SHIFT_MATCH_CONFIRMED';
  if v_count<>1 then raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_AUDIT_UNBOUND' using errcode='55000';end if;
  select * into strict v_audit from public.audit_events a
    where a.object_type='weekly_source_office_row_choices' and a.object_id_text=v_choice.id::text
      and a.action='WEEKLY_SOURCE_PAID_SHIFT_MATCH_CONFIRMED';
  if v_audit.actor_user_id is distinct from v_choice.actor_user_id
    or v_audit.after_json->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_SHIFT_MATCH_CONFIRMATION_V1'
    or v_audit.after_json->'choice' is distinct from to_jsonb(v_choice)
    or v_audit.after_json->'admission' is distinct from v_saved
    or v_audit.after_json->'request' is distinct from v_journal.request_json
    or v_audit.after_json->>'request_sha256' is distinct from encode(v_journal.request_hash,'hex') then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_AUDIT_UNBOUND' using errcode='55000';end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_CHOICE_IMMUTABLE_INPUT_V1',
    'choice',to_jsonb(v_choice),'journal',to_jsonb(v_journal),'audit',to_jsonb(v_audit),'admission',v_saved);
end;
$function$;

create or replace function private.weekly_source_nhsp_projection_lock_input_v1(
  p_upload_row_id uuid,p_actor_user_id uuid,p_projection_publication_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp' as $function$
declare data jsonb;choice private.weekly_source_office_row_choices%rowtype;
  row public.weekly_source_upload_rows%rowtype;upload public.weekly_source_uploads%rowtype;
  cycle public.weekly_source_cycles%rowtype;scope public.weekly_source_report_scopes%rowtype;
  publication public.weekly_source_projection_publications%rowtype;saved jsonb;item jsonb;basis jsonb;raw_negative jsonb;
  correction public.weekly_final_source_correction_sessions%rowtype;
  result jsonb;counted integer:=0;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_actor_user_id is null then raise exception 'WEEKLY_SOURCE_ACTOR_REQUIRED' using errcode='42501';end if;
  data:=private.weekly_source_paid_choice_immutable_v1(p_upload_row_id);
  if data is null then return null;end if;
  if private.weekly_source_pay_actor_allowed_v1(p_actor_user_id) is distinct from true then
    raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501';end if;
  select * into strict row from public.weekly_source_upload_rows where id=p_upload_row_id;
  select * into strict upload from public.weekly_source_uploads where id=row.upload_id;
  select * into strict cycle from public.weekly_source_cycles where id=upload.source_cycle_id;
  select * into strict scope from public.weekly_source_report_scopes where id=upload.report_scope_id;
  select * into strict publication from public.weekly_source_projection_publications where id=p_projection_publication_id;
  if upload.purpose='FINAL_SOURCE_CORRECTION' then
    perform private.weekly_source_paid_match_correction_scope_v1(upload.id,p_actor_user_id,false);
    select * into strict correction from public.weekly_final_source_correction_sessions where id=upload.correction_session_id;
  end if;
  if upload.purpose not in ('ORDINARY','FINAL_SOURCE_CORRECTION')
    or (upload.purpose='ORDINARY' and (upload.state<>'CURRENT' or upload.correction_session_id is not null
      or scope.current_complete_upload_id is distinct from upload.id))
    or (upload.purpose='FINAL_SOURCE_CORRECTION' and (upload.state<>'CORRECTION_READY'
      or publication.id is distinct from correction.replacement_projection_publication_id)) or scope.source_cycle_id is distinct from cycle.id
    or scope.source_group_id is distinct from cycle.source_group_id or scope.self_bill_report_id is not null
    or publication.upload_id is distinct from upload.id or publication.source_cycle_id is distinct from cycle.id
    or publication.report_scope_id is distinct from scope.id or publication.authority_scope_kind<>'NHSP_REPORT_SCOPE'
    or publication.authority_scope_version is distinct from scope.version or publication.state<>'BUILDING'
    or publication.correction_session_id is distinct from upload.correction_session_id
    or not exists(select 1 from public.weekly_source_groups g where g.id=cycle.source_group_id and g.active and g.source_family='NHSP')
    or not exists(select 1 from public.weekly_source_format_profiles profile
      where profile.id=upload.source_format_profile_id and profile.profile_code='NHSP_FINAL_BACKING_V1') then
    raise exception 'WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_SCOPE_UNBOUND' using errcode='55000';end if;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',cycle.source_group_id,scope.client_id,cycle.finalisation_week_ending);
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'APPROVE_PROTECTED_PAY',cycle.source_group_id,scope.client_id,cycle.finalisation_week_ending);
  choice:=pg_catalog.jsonb_populate_record(null::private.weekly_source_office_row_choices,data->'choice');
  saved:=data#>'{admission,inputs}';
  if choice.client_id is distinct from scope.client_id or saved->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_INPUTS_V1'
    or saved->>'candidate_id' is distinct from choice.candidate_id::text
    or saved->>'client_id' is distinct from choice.client_id::text
    or saved->>'source_cycle_id' is distinct from cycle.id::text
    or saved->>'source_group_id' is distinct from cycle.source_group_id::text
    or saved->>'upload_id' is distinct from upload.id::text or saved->>'upload_row_id' is distinct from row.id::text
    or saved->>'actor_user_id' is distinct from choice.actor_user_id::text
    or saved->>'normalised_row_hash' is distinct from encode(row.normalised_row_hash,'hex')
    or saved->>'row_manifest_hash' is distinct from encode(upload.row_manifest_hash,'hex')
    or saved->>'inputs_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PAID_OVERLAP_INPUTS_V1',saved-'inputs_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_CHOICE_UNBOUND' using errcode='55000';end if;
  if upload.purpose='FINAL_SOURCE_CORRECTION' and saved->'correction_scope' is distinct from
    private.weekly_source_paid_match_correction_scope_v1(upload.id,p_actor_user_id,false) then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_FACTS_CHANGED' using errcode='40001';end if;
  -- The saved incoming negative records are HISTORICAL input provenance only.
  -- Current Source position/cash/roots are independently re-read for every
  -- member before I1. Fresh current-generation negative proof follows native
  -- negative row application and must be rechecked before any positive write.
  for item in select value from jsonb_array_elements(saved->'overlaps') loop
    if item->>'candidate_id' is distinct from choice.candidate_id::text or item->>'client_id' is distinct from choice.client_id::text then
      raise exception 'WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_CHOICE_UNBOUND' using errcode='55000';end if;
    raw_negative:=item->'nhsp_negative_population';
    perform private.weekly_source_nhsp_negative_comparison_v1(raw_negative);
    basis:=private.weekly_source_nhsp_paid_overlap_basis_v1((item->>'work_event_id')::uuid,p_actor_user_id,cycle.id);
    if basis is distinct from raw_negative->'native_current_basis'
      or item->'native_payment_facts' is distinct from basis->'native_payment_facts'
      or basis->>'state' is distinct from 'NATIVE_POSITION_INPUTS' then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_FACTS_CHANGED' using errcode='40001';end if;
    counted:=counted+1;
  end loop;
  if counted=0 then raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_ROOT_UNAVAILABLE' using errcode='55000';end if;
  result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_INPUT_V1',
    'choice_id',choice.id,'upload_row_id',row.id,'upload_id',upload.id,'candidate_id',choice.candidate_id,
    'client_id',choice.client_id,'contract_id',choice.contract_id,'pay_effect',choice.pay_effect,
    'paid_overlap_target_work_event_id',choice.paid_overlap_target_work_event_id,
    'viewer_actor_user_id',p_actor_user_id,'projection_publication_id',publication.id,
    'native_backend_pid',pg_backend_pid(),'native_transaction_id',pg_current_xact_id()::text,
    'inputs',saved,'fresh_choice_admission',false);
  return result||jsonb_build_object('lock_input_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_INPUT_V1',result),'hex'));
end;
$function$;

create or replace function private.weekly_source_nhsp_projection_choice_recheck_v1(
  p_lock_input jsonb,p_current_choice jsonb,p_actor_user_id uuid,p_publication_id uuid
) returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp' as $function$
declare key text;old_roots uuid[];new_roots uuid[];
begin
  perform private.weekly_source_query_require_service_v1();
  if p_actor_user_id is null or p_publication_id is null then
    raise exception 'WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_FRAME_UNBOUND' using errcode='55000';end if;
  if p_lock_input->>'schema_version' is distinct from 'WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_INPUT_V1'
    or p_lock_input->'fresh_choice_admission' is distinct from 'false'::jsonb
    or p_lock_input->>'viewer_actor_user_id' is distinct from p_actor_user_id::text
    or p_lock_input->>'projection_publication_id' is distinct from p_publication_id::text
    or p_lock_input->>'native_backend_pid' is distinct from pg_backend_pid()::text
    or p_lock_input->>'native_transaction_id' is distinct from pg_current_xact_id()::text
    or p_lock_input->>'lock_input_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_INPUT_V1',p_lock_input-'lock_input_sha256'),'hex')
    or p_current_choice->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1'
    or p_current_choice->>'viewer_actor_user_id' is distinct from p_actor_user_id::text
    or p_current_choice->>'choice_proof_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1',p_current_choice-'choice_proof_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_FRAME_UNBOUND' using errcode='55000';end if;
  foreach key in array array['choice_id','upload_row_id','candidate_id','client_id','contract_id','pay_effect','paid_overlap_target_work_event_id'] loop
    if p_current_choice->key is distinct from p_lock_input->key then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_CHANGED' using errcode='40001';end if;
  end loop;
  select array_agg(distinct root::uuid order by root::uuid) into old_roots
    from jsonb_array_elements(p_lock_input#>'{inputs,overlaps}') item
    cross join lateral jsonb_array_elements_text(item#>'{native_payment_facts,root_timesheet_ids}') root;
  select array_agg(distinct root::uuid order by root::uuid) into new_roots
    from jsonb_array_elements(p_current_choice#>'{inputs,overlaps}') item
    cross join lateral jsonb_array_elements_text(item#>'{native_payment_facts,root_timesheet_ids}') root;
  if coalesce(cardinality(old_roots),0)=0 or new_roots is distinct from old_roots then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_SCOPE_CHANGED' using errcode='40001';end if;
end;
$function$;

create or replace function private.weekly_source_nhsp_invoice_only_vector_v1(p_kind text,p_total_pence bigint)
returns jsonb language sql immutable
set search_path to 'pg_catalog','pg_temp' as $function$
  select jsonb_set(private.weekly_source_invoice_only_vector_v1(p_kind,p_total_pence),
    '{source_mode}',to_jsonb('NHSP_WEEKLY'::text),false);
$function$;

create or replace function private.weekly_source_nhsp_none_invoice_basis_v1(
  p_row_resolution_id uuid,p_final_revision_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp' as $function$
declare r public.weekly_source_row_resolutions%rowtype;row public.weekly_source_upload_rows%rowtype;
  u public.weekly_source_uploads%rowtype;revision public.weekly_source_final_revisions%rowtype;
  scope public.weekly_source_report_scopes%rowtype;cycle public.weekly_source_cycles%rowtype;
  choice private.weekly_source_office_row_choices%rowtype;journal private.weekly_source_office_rechecks%rowtype;
  target public.weekly_source_billing_movements%rowtype;target_revision public.weekly_source_final_revisions%rowtype;
  proof jsonb;match jsonb;negative jsonb;invoice jsonb;result jsonb;counted integer;ts uuid;
  session public.weekly_final_source_correction_sessions%rowtype;
  side integer;comparison jsonb;overlaps jsonb;item jsonb;saved_comparison jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_row_resolution_id is null or p_final_revision_id is null then
    raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_BASIS_UNBOUND' using errcode='55000';end if;
  select * into strict r from public.weekly_source_row_resolutions where id=p_row_resolution_id;
  select * into strict row from public.weekly_source_upload_rows where id=r.upload_row_id;
  select * into strict u from public.weekly_source_uploads where id=row.upload_id;
  select * into strict revision from public.weekly_source_final_revisions where id=p_final_revision_id;
  select * into strict scope from public.weekly_source_report_scopes where id=revision.report_scope_id;
  select * into strict cycle from public.weekly_source_cycles where id=revision.source_cycle_id;
  select * into strict choice from private.weekly_source_office_row_choices where id=r.paid_overlap_choice_id;
  proof:=revision.paid_overlap_choice_census->row.id::text;
  if revision.authority_scope_kind<>'NHSP_REPORT_SCOPE' or revision.upload_id is distinct from u.id
    or revision.source_cycle_id is distinct from u.source_cycle_id or u.report_scope_id is distinct from scope.id
    or u.purpose not in ('ORDINARY','FINAL_SOURCE_CORRECTION')
    or (u.purpose='ORDINARY' and u.correction_session_id is not null)
    or (u.purpose='FINAL_SOURCE_CORRECTION' and u.correction_session_id is null) or scope.self_bill_report_id is not null
    or scope.source_cycle_id is distinct from cycle.id or scope.source_group_id is distinct from cycle.source_group_id
    or scope.client_id is distinct from r.client_id
    or not exists(select 1 from public.weekly_source_groups g where g.id=cycle.source_group_id and g.source_family='NHSP')
    or not exists(select 1 from public.weekly_source_format_profiles profile
      where profile.id=u.source_format_profile_id and profile.profile_code='NHSP_FINAL_BACKING_V1')
    or r.mapping_state<>'RESOLVED' or r.pay_effect<>'NONE' or choice.pay_effect<>'NONE'
    or row.row_finalisation_state<>'SOURCE_WORKED' or row.source_money_parse_state is distinct from 'VALID'
    or row.source_shift_charge_pence is null or row.source_shift_charge_pence<0
    or r.source_row_fingerprint is distinct from row.normalised_row_hash
    or (choice.upload_row_id,choice.work_event_id,choice.paid_overlap_target_work_event_id,choice.candidate_id,choice.client_id,choice.contract_id)
      is distinct from (row.id,r.work_event_id,r.work_event_id,r.candidate_id,r.client_id,r.contract_id)
    or choice.separate_shift
    or proof->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1'
    or proof->>'choice_id' is distinct from choice.id::text or proof->>'pay_effect' is distinct from 'NONE'
    or proof->>'upload_row_id' is distinct from row.id::text
    or proof->>'paid_overlap_target_work_event_id' is distinct from r.work_event_id::text
    or proof->>'candidate_id' is distinct from r.candidate_id::text or proof->>'client_id' is distinct from r.client_id::text
    or proof->>'contract_id' is distinct from r.contract_id::text
    or proof->>'confirmed_by_actor_user_id' is distinct from choice.actor_user_id::text
    or proof->>'choice_proof_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1',proof-'choice_proof_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_BASIS_UNBOUND' using errcode='55000';end if;
  if u.purpose='FINAL_SOURCE_CORRECTION' then
    select * into strict session from public.weekly_final_source_correction_sessions where id=u.correction_session_id;
    if revision.reason<>'CORRECT_FINAL_SOURCE' or revision.predecessor_revision_id is null
      or session.authority_scope_kind<>'NHSP_REPORT_SCOPE' or session.report_scope_id is distinct from scope.id
      or session.source_cycle_id is distinct from cycle.id or session.replacement_correction_upload_id is distinct from u.id
      or session.actor_user_id is distinct from revision.finalised_by_user_id
      or session.expected_current_final_revision_id is distinct from revision.predecessor_revision_id
      or session.state not in ('PREPARING','PREPARED','COMMITTING','APPLIED')
      or (session.state<>'PREPARING' and session.prepared_final_revision_id is distinct from revision.id)
      or (session.state='APPLIED' and session.applied_final_revision_id is distinct from revision.id)
      or proof#>>'{inputs,correction_scope,schema_version}' is distinct from 'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_V1'
      or proof#>>'{inputs,correction_scope,correction_session_id}' is distinct from session.id::text
      or proof#>>'{inputs,correction_scope,prior_final_revision_id}' is distinct from revision.predecessor_revision_id::text
      or proof#>>'{inputs,correction_scope,prior_final_manifest_hash}' is distinct from encode(session.expected_final_manifest_hash,'hex')
      or proof#>>'{inputs,correction_scope,upload_id}' is distinct from u.id::text
      or proof#>>'{inputs,correction_scope,report_scope_id}' is distinct from scope.id::text
      or proof#>>'{inputs,correction_scope,authority_scope_kind}' is distinct from 'NHSP_REPORT_SCOPE'
      or proof#>>'{inputs,correction_scope,scope_sha256}' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_PAID_MATCH_CORRECTION_SCOPE_V1',(proof#>'{inputs,correction_scope}')-'scope_sha256'),'hex') then
      raise exception 'WEEKLY_SOURCE_NHSP_NONE_CORRECTION_PROVENANCE_UNBOUND' using errcode='55000';end if;
  end if;
  select * into strict journal from private.weekly_source_office_rechecks where request_id=(choice.paid_overlap_inputs_json->>'request_id')::uuid;
  select count(*) into counted from public.audit_events a
    where a.object_type='weekly_source_office_row_choices' and a.object_id_text=choice.id::text
      and a.action='WEEKLY_SOURCE_PAID_SHIFT_MATCH_CONFIRMED' and a.actor_user_id=choice.actor_user_id
      and a.after_json->'choice'=to_jsonb(choice) and a.after_json->'admission'=choice.paid_overlap_inputs_json
      and a.after_json->'request'=journal.request_json and journal.actor_user_id=choice.actor_user_id
      and journal.upload_id=u.id and journal.request_hash=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFFICE_RECHECK_V1',journal.request_json)
      and a.after_json->>'request_sha256'=encode(journal.request_hash,'hex')
      and proof->>'confirmation_request_id'=journal.request_id::text
      and proof->>'confirmation_request_sha256'=encode(journal.request_hash,'hex');
  if counted<>1 then raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_AUDIT_UNBOUND' using errcode='55000';end if;
  if choice.paid_overlap_inputs_json->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_ADMISSION_V1'
    or choice.paid_overlap_inputs_json->>'inputs_sha256' is distinct from encode(choice.paid_overlap_inputs_sha256,'hex')
    or proof#>>'{inputs,schema_version}' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_INPUTS_V1'
    or proof#>>'{inputs,inputs_sha256}' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PAID_OVERLAP_INPUTS_V1',(proof->'inputs')-'inputs_sha256'),'hex')
    or proof#>>'{inputs,upload_id}' is distinct from u.id::text
    or proof#>>'{inputs,upload_row_id}' is distinct from row.id::text
    or proof#>>'{inputs,source_cycle_id}' is distinct from cycle.id::text
    or proof#>>'{inputs,normalised_row_hash}' is distinct from encode(row.normalised_row_hash,'hex')
    or proof#>>'{inputs,row_manifest_hash}' is distinct from encode(u.row_manifest_hash,'hex') then
    raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_PROOF_UNBOUND' using errcode='55000';end if;
  -- The immutable final confirmation and original audit must agree on the
  -- complete semantic input population, preserving both raw generations.
  for side in 0..1 loop
    comparison:=case when side=0 then choice.paid_overlap_inputs_json->'inputs' else proof->'inputs' end;
    if comparison->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_INPUTS_V1'
      or comparison->>'inputs_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_PAID_OVERLAP_INPUTS_V1',comparison-'inputs_sha256'),'hex') then
      raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_PROOF_UNBOUND' using errcode='55000';end if;
    overlaps:='[]'::jsonb;
    for item in select value from jsonb_array_elements(comparison->'overlaps') loop
      item:=jsonb_set(item,'{nhsp_negative_population}',private.weekly_source_nhsp_negative_comparison_v1(
        item->'nhsp_negative_population'),false);
      overlaps:=overlaps||jsonb_build_array(item);
    end loop;
    comparison:=jsonb_set(comparison,'{overlaps}',overlaps,false)-'actor_user_id'-'inputs_sha256';
    if side=0 then saved_comparison:=comparison;elsif comparison is distinct from saved_comparison then
      raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_PROOF_UNBOUND' using errcode='55000';end if;
  end loop;
  select count(*) into counted from jsonb_array_elements(proof#>'{inputs,overlaps}') item where item->>'work_event_id'=r.work_event_id::text;
  if counted<>1 then raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_TARGET_UNBOUND' using errcode='55000';end if;
  select item into strict match from jsonb_array_elements(proof#>'{inputs,overlaps}') item where item->>'work_event_id'=r.work_event_id::text;
  negative:=match->'nhsp_negative_population';
  perform private.weekly_source_nhsp_negative_comparison_v1(negative);
  if match#>>'{current_native_position,state}' is distinct from 'CURRENT_NATIVE_POSITION'
    or match#>'{native_payment_facts,paid}' is distinct from 'true'::jsonb
    or match#>>'{native_payment_facts,paid_evidence_state}' is distinct from 'SETTLED_ORIGINAL'
    or negative->>'upload_id' is distinct from u.id::text or negative->>'work_event_id' is distinct from r.work_event_id::text
    or negative->>'source_cycle_id' is distinct from cycle.id::text or negative->>'report_scope_id' is distinct from scope.id::text
    or negative->>'projection_generation' is distinct from r.generation::text
    or jsonb_array_length(negative->'current_targets')<>1
    or match#>'{current_native_position,native_current_target}' is distinct from negative#>'{current_targets,0}' then
    raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_TARGET_UNBOUND' using errcode='55000';end if;
  select * into strict target from public.weekly_source_billing_movements where id=(negative#>>'{current_targets,0,movement_id}')::uuid;
  select * into strict target_revision from public.weekly_source_final_revisions where id=target.final_revision_id;
  if target.pay_effect<>'NORMAL' or target.source_profile_kind<>'NHSP_TRUST_BACKING_REPORT'
    or target.source_line_kind<>'NHSP_PHYSICAL_POSITIVE' or target.movement_role not in ('POSITIVE','REPLACEMENT')
    or (target.work_event_id,target.candidate_id,target.actual_client_id,target.contract_id)
      is distinct from (r.work_event_id,r.candidate_id,r.client_id,r.contract_id)
    or encode(target.movement_economic_hash,'hex') is distinct from negative#>>'{current_targets,0,movement_economic_hash}'
    or target_revision.authority_scope_kind<>'NHSP_REPORT_SCOPE'
    or (target_revision.report_scope_id=scope.id and (u.purpose<>'FINAL_SOURCE_CORRECTION'
      or revision.reason<>'CORRECT_FINAL_SOURCE' or revision.predecessor_revision_id is null))
    or not exists(select 1 from public.weekly_source_report_scopes target_scope
      where target_scope.id=target_revision.report_scope_id and target_scope.source_group_id=cycle.source_group_id
        and target_scope.client_id=r.client_id and target_scope.self_bill_report_id is null) then
    raise exception 'WEEKLY_SOURCE_NHSP_NONE_NORMAL_WITNESS_UNBOUND' using errcode='55000';end if;
  invoice:=private.weekly_source_nhsp_invoice_values_v1(r.id,cycle.id);
  ts:=private.weekly_source_finalisation_lineage_assert_v1(r.id,cycle.id);
  result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_NHSP_NONE_INVOICE_BASIS_V1',
    'row_resolution_id',r.id,'upload_row_id',row.id,'final_revision_id',revision.id,'report_scope_id',scope.id,
    'source_cycle_id',cycle.id,'work_event_id',r.work_event_id,'candidate_id',r.candidate_id,'client_id',r.client_id,
    'contract_id',r.contract_id,'invoice_timesheet_id',ts,'paid_overlap_choice_id',choice.id,
    'paid_overlap_choice_proof',proof,'native_invoice_values',invoice,
    'normal_pay_movement_id',target.id,'normal_pay_movement_sha256',encode(target.movement_economic_hash,'hex'),
    'normal_pay_final_revision_id',target_revision.id,'normal_pay_report_scope_id',target_revision.report_scope_id,
    'pay_effect','NONE','invoice_only',true,'paid_writer_permission',null);
  if octet_length(result::text)>1048576 then raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_BYTE_BOUND' using errcode='54000';end if;
  return result||jsonb_build_object('inputs_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_NHSP_NONE_INVOICE_BASIS_V1',result),'hex'));
end;
$function$;

create or replace function private.weekly_source_nhsp_none_invoice_origin_assert_v1(p_movement_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp' as $function$
declare m public.weekly_source_billing_movements%rowtype;r public.weekly_source_row_resolutions%rowtype;
  row public.weekly_source_upload_rows%rowtype;e public.weekly_source_row_economic_snapshots%rowtype;
  basis jsonb;invoice jsonb;vat jsonb;admission jsonb;pay jsonb;charge jsonb;state jsonb;mapping bytea;expected bytea;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict m from public.weekly_source_billing_movements where id=p_movement_id;
  if m.pay_effect<>'NONE' or m.source_profile_kind<>'NHSP_TRUST_BACKING_REPORT'
    or m.source_line_kind<>'NHSP_PHYSICAL_POSITIVE' or m.movement_role<>'POSITIVE'
    or m.nhsp_upload_row_id is null or m.invoice_only_snapshot_line_id is not null or m.transition_id is not null
    or m.expense_authority_generation_id is not null or m.self_bill_report_row_id is not null or m.vat_rounding_revision_id is not null
    or m.correction_unit_id is not null or m.prior_movement_id is not null or m.total_pay_ex_vat<>0
    or m.source_facts_json ? 'row_resolution_id'
    or m.source_facts_json->>'schema_version' is distinct from 'WEEKLY_SOURCE_NHSP_PHYSICAL_FACTS_V1'
    or m.source_facts_json->>'pay_effect' is distinct from 'NONE' then
    raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_ORIGIN_UNBOUND' using errcode='55000';end if;
  select * into strict r from public.weekly_source_row_resolutions where id=(m.source_facts_json->>'bound_row_resolution_id')::uuid;
  select * into strict row from public.weekly_source_upload_rows where id=r.upload_row_id;
  basis:=private.weekly_source_nhsp_none_invoice_basis_v1(r.id,m.final_revision_id);
  invoice:=basis->'native_invoice_values';vat:=invoice->'native_line_vat';admission:=invoice->'native_price_admission';
  select * into strict e from public.weekly_source_row_economic_snapshots where id=(invoice->>'economic_snapshot_id')::uuid;
  pay:=private.weekly_source_nhsp_invoice_only_vector_v1('PAY',0);
  charge:=private.weekly_source_nhsp_invoice_only_vector_v1('CHARGE',row.source_shift_charge_pence);
  mapping:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_MAPPING_RATE_POLICY_V1',jsonb_build_object(
    'row_resolution_id',r.id,'work_event_id',r.work_event_id,'candidate_id',r.candidate_id,'client_id',r.client_id,'contract_id',r.contract_id,
    'contract_and_rate_fingerprint',encode(e.contract_and_rate_fingerprint,'hex'),'effective_policy_fingerprint',encode(e.effective_policy_fingerprint,'hex'),
    'invoice_vat_policy_fingerprint',encode(e.invoice_vat_policy_fingerprint,'hex'),'calculation_fingerprint',encode(e.calculation_fingerprint,'hex')));
  if (m.work_event_id,m.candidate_id,m.actual_client_id,m.contract_id) is distinct from (r.work_event_id,r.candidate_id,r.client_id,r.contract_id)
    or m.nhsp_upload_row_id is distinct from row.id or m.finalisation_cycle_id::text is distinct from basis->>'source_cycle_id'
    or m.invoice_timesheet_id::text is distinct from basis->>'invoice_timesheet_id'
    or m.source_facts_json->'nhsp_none_invoice_basis' is distinct from basis
    or m.source_facts_json->>'upload_row_id' is distinct from row.id::text
    or m.source_facts_json->>'report_scope_id' is distinct from basis->>'report_scope_id'
    or m.source_facts_json->>'source_row_ordinal' is distinct from row.source_row_ordinal::text
    or m.source_facts_json->'work_date' is distinct from to_jsonb(row.work_date)
    or m.source_facts_json->'start_at_local' is distinct from to_jsonb(row.start_at_local)
    or m.source_facts_json->'end_at_local' is distinct from to_jsonb(row.end_at_local)
    or m.source_facts_json->'break_minutes' is distinct from coalesce(to_jsonb(row.break_minutes),'null'::jsonb)
    or m.source_facts_json->'actual_net_minutes' is distinct from to_jsonb(row.actual_net_minutes)
    or m.source_facts_json->'source_commission_pence' is distinct from to_jsonb(row.source_commission_pence)
    or m.source_facts_json->'source_total_cost_pence' is distinct from to_jsonb(row.source_total_cost_pence)
    or m.source_facts_json->'source_shift_charge_pence' is distinct from to_jsonb(row.source_shift_charge_pence)
    or m.source_facts_json->>'physical_sign' is distinct from 'POSITIVE'
    or m.canonical_pay_vector_json is distinct from pay or m.canonical_charge_vector_json is distinct from charge
    or m.calculated_comparison_charge_pence is distinct from e.calculated_charge_pence
    or m.source_validation_charge_pence is distinct from row.source_shift_charge_pence
    or m.invoice_presentation_charge_pence is distinct from row.source_shift_charge_pence
    or m.vat_rate_pct is distinct from (vat->>'vat_rate_pct')::numeric
    or m.vat_amount is distinct from (vat->>'vat_amount')::numeric
    or m.total_inc_vat is distinct from (vat->>'total_inc_vat')::numeric
    or m.price_check_result is distinct from admission->>'price_admission_result'
    or m.price_check_fingerprint is distinct from e.calculation_fingerprint
    or m.charge_acceptance_id::text is distinct from admission#>>'{charge_acceptance,id}'
    or m.mapping_rate_policy_fingerprint is distinct from mapping then
    raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_VALUES_UNBOUND' using errcode='55000';end if;
  state:=jsonb_build_object('transition_id',m.transition_id,'nhsp_upload_row_id',m.nhsp_upload_row_id,
    'final_revision_id',m.final_revision_id,'finalisation_cycle_id',m.finalisation_cycle_id,
    'actual_client_id',r.client_id,'candidate_id',r.candidate_id,'contract_id',r.contract_id,'work_event_id',r.work_event_id,
    'movement_role',m.movement_role,'correction_unit_id',m.correction_unit_id,'prior_movement_id',m.prior_movement_id,
    'source_profile_kind',m.source_profile_kind,'source_line_kind',m.source_line_kind,'source_facts',m.source_facts_json,
    'pay_vector',pay,'charge_vector',charge,'total_pay_pence',0,'calculated_comparison_charge_pence',e.calculated_charge_pence,
    'source_validation_charge_pence',m.source_validation_charge_pence,'invoice_presentation_charge_pence',m.invoice_presentation_charge_pence,
    'vat_rate_pct',m.vat_rate_pct,'vat_amount',m.vat_amount,'total_inc_vat',m.total_inc_vat,'price_check_result',m.price_check_result,
    'price_check_fingerprint',encode(m.price_check_fingerprint,'hex'),'charge_acceptance_id',m.charge_acceptance_id,
    'mapping_rate_policy_fingerprint',encode(mapping,'hex'),'invoice_timesheet_id',m.invoice_timesheet_id,'pay_effect','NONE');
  expected:=private.weekly_source_billing_movement_hash_v1(state);
  if expected is distinct from m.movement_economic_hash then
    raise exception 'WEEKLY_SOURCE_NHSP_NONE_INVOICE_HASH_UNBOUND' using errcode='55000';end if;
  return basis;
end;
$function$;

create or replace function private.bpay_next_source_current_publish_revision_v1(p_revision uuid)
returns void language plpgsql security definer set search_path=pg_catalog,private,public as $f$
declare v_authority record;v_row record;v_after uuid;v_count integer;v_scope uuid;v_capture jsonb;
  v_upload uuid;v_generation integer;v_after_row integer;
begin
  perform 1 from private.bpay_next_module_control where id=1 and active_owner='NEXT' for share;
  if not found then return;end if;
  select * into strict v_authority from private.bpay_next_source_current_revision_v1(p_revision);
  if not v_authority.is_current then raise exception 'BPAY_NEXT_SOURCE_PUBLISH_NOT_CURRENT' using errcode='55000';end if;
  -- Each loop reads <=100 NEW payload IDs through its exact emission index.
  -- It does not drain an asynchronous job or rebuild a Candidate/history.
  loop
    v_count:=0;
    for v_row in select m.id from public.weekly_source_billing_movements m where m.final_revision_id=p_revision
      and m.pay_effect in ('NORMAL','NONE') and m.source_profile_kind='NHSP_TRUST_BACKING_REPORT'
      and m.source_line_kind in ('NHSP_PHYSICAL_POSITIVE','NHSP_PHYSICAL_FULL_NEGATIVE')
      and m.id>=coalesce(v_after,'00000000-0000-0000-0000-000000000000'::uuid) and (v_after is null or m.id<>v_after)
      order by m.id limit 100 loop
      v_capture:=private.bpay_next_source_current_capture_movement_v1(v_row.id);
      if v_capture->'pay_origin_present' is distinct from 'false'::jsonb then
        select o.scope_id into strict v_scope from private.bpay_next_source_current_origins o where o.origin_kind='MOVEMENT' and o.origin_id=v_row.id;
        perform private.bpay_next_source_current_observe_v1(v_scope,p_revision,null);
      end if;
      v_after:=v_row.id;v_count:=v_count+1;
    end loop;
    exit when v_count<100;
  end loop;
  v_after:=null;
  loop
    v_count:=0;
    for v_row in select t.id from public.weekly_source_state_transitions t where t.final_revision_id=p_revision
      and t.id>=coalesce(v_after,'00000000-0000-0000-0000-000000000000'::uuid) and (v_after is null or t.id<>v_after)
      order by t.id limit 100 loop
      perform private.bpay_next_source_current_capture_transition_v1(v_row.id);
      select o.scope_id into strict v_scope from private.bpay_next_source_current_origins o where o.origin_kind='TRANSITION' and o.origin_id=v_row.id;
      perform private.bpay_next_source_current_observe_v1(v_scope,p_revision,null);
      v_after:=v_row.id;v_count:=v_count+1;
    end loop;
    exit when v_count<100;
  end loop;
  v_after:=null;
  loop
    v_count:=0;
    for v_row in select a.id from public.weekly_expense_authority_generations a where a.final_revision_id=p_revision and a.state='CURRENT'
      and a.id>=coalesce(v_after,'00000000-0000-0000-0000-000000000000'::uuid) and (v_after is null or a.id<>v_after)
      order by a.id limit 100 loop
      v_capture:=private.bpay_next_source_current_capture_expense_v1(v_row.id);
      if (v_capture->>'root_bound')::boolean then
        select o.scope_id into strict v_scope from private.bpay_next_source_current_origins o where o.origin_kind='EXPENSE' and o.origin_id=v_row.id;
        perform private.bpay_next_source_current_observe_v1(v_scope,p_revision,null);
      end if;
      v_after:=v_row.id;v_count:=v_count+1;
    end loop;
    exit when v_count<100;
  end loop;
  -- Current upload payload only. The old authority may legitimately remain
  -- CURRENT with its ORIGINAL revision when expense money is unchanged.
  select r.upload_id,coalesce(p.projection_generation,p.authority_scope_version::integer)
    into strict v_upload,v_generation from public.weekly_source_final_revisions r
    join public.weekly_source_cycles c on c.id=r.source_cycle_id
    left join public.weekly_source_report_scopes s on s.id=r.report_scope_id
    join public.weekly_source_projection_publications p on p.id=case when r.authority_scope_kind='CYCLE'
      then c.current_projection_publication_id else s.current_projection_publication_id end
    where r.id=p_revision and p.upload_id=r.upload_id and p.state='CURRENT';
  loop
    v_count:=0;
    for v_row in select u.source_row_ordinal,p.id as policy_id
      from public.weekly_source_upload_rows u
      join public.weekly_source_row_resolutions r on r.upload_row_id=u.id and r.generation=v_generation
      join public.weekly_source_row_expense_policy_snapshots p on p.row_resolution_id=r.id
      where u.upload_id=v_upload and (v_after_row is null or u.source_row_ordinal>v_after_row)
      order by u.source_row_ordinal limit 100 loop
      perform private.bpay_next_source_current_observe_expense_row_v1(p_revision,v_row.policy_id);
      v_after_row:=v_row.source_row_ordinal;v_count:=v_count+1;
    end loop;
    exit when v_count<100;
  end loop;
end $f$;

create or replace function public.weekly_source_workspace_scopes_v1(p_request jsonb)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_actor uuid;
  v_group uuid;
  v_client uuid;
  v_week date;
  v_limit integer:=100;
  v_offset integer:=0;
  v_cursor jsonb;
  v_rows jsonb;
  v_version text;
  v_total integer;
  v_missing integer;
  v_pending integer;
  v_cutoffs jsonb;
  v_admin boolean;
  v_d10_scope record;
  v_d10_frame jsonb;
  v_d10_scopes jsonb:='[]'::jsonb;
  v_monday date:=(date_trunc('week',statement_timestamp() at time zone 'Europe/London'))::date;
begin
  perform private.weekly_source_query_require_service_v1();
  perform private._weekly_source_settings_assert_request_v1(p_request,
    array['actor_user_id','source_group_id','client_id','week_ending','cursor','limit'],
    'WEEKLY_SOURCE_SCOPE_REQUEST_INVALID');
  v_actor:=(p_request->>'actor_user_id')::uuid;
  v_group:=nullif(p_request->>'source_group_id','')::uuid;
  v_client:=nullif(p_request->>'client_id','')::uuid;
  v_week:=nullif(p_request->>'week_ending','')::date;
  v_limit:=coalesce((p_request->>'limit')::integer,100);
  if v_limit not between 1 and 100 then
    raise exception 'WEEKLY_SOURCE_SCOPE_REQUEST_INVALID' using errcode='22023';
  end if;
  perform private.weekly_source_office_authority_v1(v_actor,case when exists(select 1 from public.tms_users actor where actor.id=v_actor
    and lower(btrim(coalesce(actor.role,'')))='admin') then 'VIEW_SOURCE_PROGRESS' else 'VIEW_PAY_WORK' end,v_group);
  if nullif(p_request->>'cursor','') is not null then
    begin
      v_cursor:=convert_from(decode(p_request->>'cursor','base64'),'UTF8')::jsonb;
      v_offset:=(v_cursor->>'offset')::integer;
      if v_offset is null or v_offset<0 or v_offset>2147483547 then raise exception 'invalid offset'; end if;
    exception when others then
      raise exception 'WEEKLY_SOURCE_WORKSPACE_CURSOR_STALE' using errcode='40001';
    end;
  end if;
  -- D10 adds only actual Admin-visible native query scopes. It does not make a
  -- missing Source report, a completed final revision or an import-ready claim.
  select lower(btrim(coalesce(actor.role,'')))='admin' into v_admin
  from public.tms_users actor where actor.id=v_actor and actor.is_active;
  if v_admin then
    for v_d10_scope in
      select distinct g.id group_id,g.display_name source_name,gc.client_id,cl.name client_name,
        c.id cycle_id,c.scope_client_id,c.finalisation_week_ending,c.cutoff_at_utc,c.version cycle_version
      from public.weekly_source_groups g
      join public.weekly_source_cycles c on c.source_group_id=g.id
      join public.weekly_source_group_clients gc on gc.source_group_id=g.id
      join public.clients cl on cl.id=gc.client_id
      where g.active and g.source_family='ROSTER'
        and (v_group is null or g.id=v_group) and (v_client is null or gc.client_id=v_client)
        and (v_week is null or c.finalisation_week_ending=v_week)
        and (c.scope_client_id is null or c.scope_client_id=gc.client_id)
        and (c.scope_client_id is not null or not exists(select 1 from public.weekly_source_cycles preferred
          where preferred.source_group_id=g.id and preferred.scope_client_id=gc.client_id
            and preferred.finalisation_week_ending=c.finalisation_week_ending))
        and exists(select 1 from public.timesheets t
          join public.weekly_source_client_policies p on p.source_group_id=g.id and p.client_id=gc.client_id
          where t.week_ending_date between c.finalisation_week_ending-6 and c.finalisation_week_ending
            and t.week_ending_date between gc.valid_from and coalesce(gc.valid_to,'infinity'::date)
            and t.week_ending_date between p.effective_from and coalesce(p.effective_to,'infinity'::date)
            and p.authority_mode='TIMESHEET_AUTHORITY' and p.document_mode='INVOICE_EVIDENCE_REQUIRED' and not p.self_bill_enabled)
        -- Source candidates above keep their existing row and report totals.
        and not exists(select 1 from public.weekly_source_client_policies p where p.source_group_id=g.id and p.client_id=gc.client_id
          and p.authority_mode='SOURCE_AUTHORITY' and c.finalisation_week_ending between p.effective_from and coalesce(p.effective_to,'infinity'::date))
      order by g.id,gc.client_id,c.finalisation_week_ending,c.id
    loop
      -- Enumerate real native weeks inside this exact cycle. Eligibility and
      -- parent identity still come exclusively from the same shared D10 owner.
      with native_scope_frames as materialized (
        select native_week.week_ending_date,private.weekly_source_check_only_query_groups_v1(v_d10_scope.cycle_id,v_d10_scope.client_id,
          jsonb_build_object('actor_user_id',v_actor,'source_group_id',v_d10_scope.group_id,'week_ending',native_week.week_ending_date)) value
        from (select distinct t.week_ending_date from public.timesheets t
          where t.week_ending_date between v_d10_scope.finalisation_week_ending-6 and v_d10_scope.finalisation_week_ending
            and exists(select 1 from public.weekly_source_group_clients gc where gc.source_group_id=v_d10_scope.group_id
              and gc.client_id=v_d10_scope.client_id and t.week_ending_date between gc.valid_from and coalesce(gc.valid_to,'infinity'::date))) native_week
      )
      select jsonb_build_object('revisions',coalesce(jsonb_agg(jsonb_build_object(
        'week_ending',native_frame.week_ending_date,'read_revision',native_frame.value->>'read_revision',
        'source_read_revision',native_frame.value->>'source_read_revision') order by native_frame.week_ending_date),'[]'::jsonb),
        'group_count',coalesce(sum(jsonb_array_length(native_frame.value->'groups')),0),
        'valid',coalesce(bool_and(coalesce(native_frame.value->>'contract'='WEEKLY_SOURCE_CHECK_ONLY_QUERY_GROUPS_V1'
          and native_frame.value->>'actor_user_id'=v_actor::text and native_frame.value->>'permission_view'='ADMIN'
          and native_frame.value#>>'{scope,source_group_id}'=v_d10_scope.group_id::text
          and native_frame.value#>>'{scope,source_cycle_id}'=v_d10_scope.cycle_id::text
          and native_frame.value#>>'{scope,client_id}'=v_d10_scope.client_id::text
          and native_frame.value#>>'{scope,week_ending}'=native_frame.week_ending_date::text
          and jsonb_typeof(native_frame.value->'groups')='array'
          and native_frame.value->'source_outreach_eligible'='false'::jsonb and native_frame.value->'bulk_actions'='{}'::jsonb
          and coalesce(native_frame.value->>'read_revision','')~'^[0-9a-f]{64}$'
          and coalesce(native_frame.value->>'source_read_revision','')~'^[0-9a-f]{64}$',false)),false))
      into v_d10_frame
      from native_scope_frames native_frame;
      if v_d10_frame->'valid' is distinct from 'true'::jsonb then
        raise exception 'WEEKLY_SOURCE_CHECK_ONLY_NATIVE_GROUP_READ_UNAVAILABLE' using errcode='55000';end if;
      if (v_d10_frame->>'group_count')::integer>0 then
        v_d10_scopes:=v_d10_scopes||jsonb_build_array(jsonb_build_object(
          'group_id',v_d10_scope.group_id,'source_name',v_d10_scope.source_name,'client_id',v_d10_scope.client_id,'client_name',v_d10_scope.client_name,
          'cycle_id',v_d10_scope.cycle_id,'scope_client_id',v_d10_scope.scope_client_id,'finalisation_week_ending',v_d10_scope.finalisation_week_ending,
          'cutoff_at_utc',v_d10_scope.cutoff_at_utc,'cycle_version',v_d10_scope.cycle_version,
          'query_read_revision',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_D10_SCOPE_CENSUS_V1',
            jsonb_build_object('actor_user_id',v_actor,'source_cycle_id',v_d10_scope.cycle_id,'client_id',v_d10_scope.client_id,
              'native_read_revisions',v_d10_frame->'revisions')),'hex')));
      end if;
    end loop;
  end if;
  with candidates as (
    select distinct on (source_group.id,membership.client_id,cycle.finalisation_week_ending)
      source_group.id group_id,source_group.display_name source_name,source_group.source_family,
      membership.client_id,client.name client_name,cycle.id cycle_id,
      cycle.scope_client_id,
      cycle.finalisation_week_ending,cycle.cutoff_at_utc,cycle.version cycle_version,
      cycle.current_complete_upload_id,cycle.current_projection_publication_id
    from public.weekly_source_groups source_group
    join public.weekly_source_cycles cycle on cycle.source_group_id=source_group.id
    join public.weekly_source_group_clients membership on membership.source_group_id=source_group.id
      and cycle.finalisation_week_ending between membership.valid_from and coalesce(membership.valid_to,'infinity'::date)
      and (cycle.scope_client_id is null or cycle.scope_client_id=membership.client_id)
    join public.clients client on client.id=membership.client_id
    where source_group.active and (v_group is null or source_group.id=v_group)
      and (v_client is null or membership.client_id=v_client)
      and (v_week is null or cycle.finalisation_week_ending=v_week)
      and exists(select 1 from public.weekly_source_client_policies policy
        where policy.source_group_id=source_group.id and policy.client_id=membership.client_id
          and policy.authority_mode='SOURCE_AUTHORITY'
          and cycle.finalisation_week_ending between policy.effective_from and coalesce(policy.effective_to,'infinity'::date))
    order by source_group.id,membership.client_id,cycle.finalisation_week_ending,
      (cycle.scope_client_id is not null) desc,cycle.id
  ), scopes as (
    select candidate.*,report.id report_scope_id,report.version report_version,
      case when candidate.source_family='NHSP' then report.current_complete_upload_id
        when candidate.scope_client_id=candidate.client_id then candidate.current_complete_upload_id end upload_id,
      case when candidate.source_family='NHSP' then report.current_projection_publication_id
        when candidate.scope_client_id=candidate.client_id then candidate.current_projection_publication_id end publication_id,
      coalesce(final_report.id,completion.id) completion_id,
      case when final_report.id is not null then 'FINAL_SOURCE' else completion.completion_kind end completion_kind,
      coalesce(final_report.finalised_at_utc,completion.attested_at_utc) completed_at,
      encode(coalesce(final_report.manifest_hash,completion.completion_hash),'hex') completion_hash,
      coalesce(report.cutoff_at_utc,candidate.cutoff_at_utc) actual_cutoff,
      'SOURCE'::text scope_kind,null::text query_read_revision
    from candidates candidate
    left join public.weekly_source_report_scopes report on report.source_cycle_id=candidate.cycle_id
      and report.client_id=candidate.client_id and candidate.source_family='NHSP'
    left join public.weekly_source_client_cycle_completions completion
      on completion.source_cycle_id=candidate.cycle_id and completion.client_id=candidate.client_id
      and completion.state='CURRENT' and completion.completion_kind='NO_SHIFTS_TO_IMPORT'
    -- Completion belongs to this exact client/report. A completed sibling
    -- report for the same client/week must not hide another pending report.
    left join lateral (
      select revision.id,revision.finalised_at_utc,revision.manifest_hash
      from public.weekly_source_final_revisions revision
      join public.weekly_source_client_manifests manifest on manifest.final_revision_id=revision.id
        and manifest.client_id=candidate.client_id
      where revision.source_cycle_id=candidate.cycle_id and revision.state='CURRENT'
        and revision.report_scope_id is not distinct from report.id
      order by revision.revision_number desc,revision.id limit 1
    ) final_report on true
    union all
    select g.id,g.display_name,g.source_family,rs.client_id,cl.name,rc.id,rc.scope_client_id,
      rc.finalisation_week_ending,rc.cutoff_at_utc,rc.version,rc.current_complete_upload_id,rc.current_projection_publication_id,
      rs.id,rs.version,rs.current_complete_upload_id,rs.current_projection_publication_id,
      fr.id,case when fr.id is not null then 'FINAL_SOURCE' end,fr.finalised_at_utc,encode(fr.manifest_hash,'hex'),rs.cutoff_at_utc,
      'SELF_BILL_REPORT'::text,null::text
    from public.weekly_source_report_scopes rs join public.weekly_source_self_bill_reports sr on sr.id=rs.self_bill_report_id
    join public.weekly_source_cycles rc on rc.id=rs.source_cycle_id
    join public.weekly_source_groups g on g.id=rs.source_group_id and g.active and g.source_family='ROSTER'
    join public.clients cl on cl.id=rs.client_id
    left join public.weekly_source_final_revisions fr on fr.id=rs.current_final_revision_id
      and fr.report_scope_id=rs.id and fr.authority_scope_kind='SELF_BILL_REPORT_SCOPE' and fr.state='CURRENT'
    -- Invoice-only report scopes are hidden from the reduced pay workspace.
    where exists(select 1 from public.tms_users actor where actor.id=v_actor and actor.is_active
      and lower(btrim(coalesce(actor.role,'')))='admin')
      and (v_group is null or rs.source_group_id=v_group) and (v_client is null or rs.client_id=v_client)
      and (v_week is null or rc.finalisation_week_ending=v_week)
      and exists(select 1 from public.weekly_source_group_clients gc where gc.source_group_id=rs.source_group_id
        and gc.client_id=rs.client_id and rc.finalisation_week_ending between gc.valid_from and coalesce(gc.valid_to,'infinity'::date))
    union all
    select q.group_id,q.source_name,'ROSTER'::text,q.client_id,q.client_name,q.cycle_id,q.scope_client_id,
      q.finalisation_week_ending,q.cutoff_at_utc,q.cycle_version,null::uuid,null::uuid,
      null::uuid,null::bigint,null::uuid,null::uuid,null::uuid,null::text,null::timestamptz,null::text,
      q.cutoff_at_utc,'CHECK_ONLY_D10'::text,q.query_read_revision
    from jsonb_to_recordset(v_d10_scopes) q(group_id uuid,source_name text,client_id uuid,client_name text,
      cycle_id uuid,scope_client_id uuid,finalisation_week_ending date,cutoff_at_utc timestamptz,
      cycle_version bigint,query_read_revision text)
  ), facts as (
    select scopes.*,case when scopes.scope_kind='CHECK_ONLY_D10' then null::boolean
      else private.weekly_source_import_is_prepared_v1(scopes.upload_id) end prepared
    from scopes
  ), ordered as (
    select facts.*,bool_or(prepared) over(partition by cycle_id,client_id,
      case when exists(select 1 from public.weekly_source_report_scopes rs where rs.id=facts.report_scope_id and rs.self_bill_report_id is not null)
        then report_scope_id end) client_has_prepared,
      row_number() over(order by private.weekly_source_query_ascii_fold_v1(client_name) collate "C",
      client_id,finalisation_week_ending desc,group_id,report_scope_id nulls first) ordinal
    from facts
  )
  select count(*)::integer,
    count(distinct (cycle_id,client_id)) filter(where scope_kind<>'CHECK_ONLY_D10' and completion_id is null and not client_has_prepared
      and actual_cutoff<(v_monday::timestamp at time zone 'Europe/London'))::integer,
    count(distinct (cycle_id,client_id)) filter(where scope_kind<>'CHECK_ONLY_D10' and completion_id is null and prepared)::integer,
    encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_WORKSPACE_SCOPES_V1',
      jsonb_build_object('filter',p_request-'cursor'-'limit','rows',coalesce(jsonb_agg(jsonb_build_array(
        cycle_id,client_id,cycle_version,report_scope_id,report_version,upload_id,publication_id,completion_hash,prepared,scope_kind,query_read_revision)
        order by ordinal),'[]'::jsonb))),'hex'),
    coalesce(jsonb_agg(jsonb_build_object(
      'key',cycle_id::text||':'||client_id::text||':'||coalesce(report_scope_id::text,'CYCLE'),
      'source_group_id',group_id,'source_cycle_id',cycle_id,'report_scope_id',report_scope_id,
      'client_id',client_id,'client',client_name,'source',source_name,'source_family',source_family,
      'week_ending',finalisation_week_ending,'period',to_char(finalisation_week_ending,'FMDD Mon YYYY'),
      'cutoff',actual_cutoff,'upload_id',upload_id,'projection_publication_id',publication_id,
      'scope_kind',scope_kind,'query_read_revision',query_read_revision,
      'prepared',prepared,'completed',case when scope_kind='CHECK_ONLY_D10' then null::boolean else completion_id is not null end,'completion_kind',completion_kind,
      'completed_at',completed_at,
      'missing_previous_report',scope_kind<>'CHECK_ONLY_D10' and completion_id is null and not client_has_prepared
        and actual_cutoff<(v_monday::timestamp at time zone 'Europe/London')
      ) order by ordinal) filter(where ordinal>v_offset and ordinal<=v_offset+v_limit),'[]'::jsonb)
    into v_total,v_missing,v_pending,v_version,v_rows from ordered;
  if v_cursor is not null and v_cursor->>'version' is distinct from v_version then
    raise exception 'WEEKLY_SOURCE_WORKSPACE_CURSOR_STALE' using errcode='40001';
  end if;
  select coalesce(jsonb_agg(jsonb_build_object('source_group_id',source_group.id,
    'source',source_group.display_name,'cutoff',deadline.value,
    'passed',statement_timestamp()>=deadline.value) order by source_group.display_name,source_group.id),'[]'::jsonb)
  into v_cutoffs from public.weekly_source_groups source_group
  cross join lateral(select ((v_monday+((source_group.cutoff_weekday+6)%7))
    +source_group.cutoff_local_time) at time zone source_group.timezone value) deadline
  where source_group.active and (v_group is null or source_group.id=v_group)
    and exists(select 1 from public.weekly_source_group_clients membership
      join public.weekly_source_client_policies policy on policy.source_group_id=source_group.id
        and policy.client_id=membership.client_id and policy.authority_mode='SOURCE_AUTHORITY'
      where membership.source_group_id=source_group.id and (v_client is null or membership.client_id=v_client)
        and (statement_timestamp() at time zone source_group.timezone)::date between membership.valid_from and coalesce(membership.valid_to,'infinity'::date)
        and (statement_timestamp() at time zone source_group.timezone)::date between policy.effective_from and coalesce(policy.effective_to,'infinity'::date));
  return jsonb_build_object('ok',true,'contract','WEEKLY_SOURCE_WORKSPACE_SCOPES_V1',
    'rows',v_rows,'total_count',v_total,'version',v_version,
    'missing_previous_reports',v_missing,'reports_awaiting_finalisation',v_pending,
    'this_week_cutoffs',v_cutoffs,'has_more',v_offset+v_limit<v_total,
    'next_cursor',case when v_offset+v_limit<v_total then
      encode(convert_to(jsonb_build_object('offset',v_offset+v_limit,'version',v_version)::text,'UTF8'),'base64') else '' end);
end;
$function$;

create or replace function private.bpay_next_source_current_toggle_v1(p_kind text,p_id uuid,p_active boolean)
returns void language plpgsql security definer
set search_path='pg_catalog','private','public','pg_temp' as $f$
declare v_origin private.bpay_next_source_current_origins%rowtype;v_delta integer;v_key bit(128);v_movement uuid;
begin
  if p_active is null then raise exception 'BPAY_NEXT_SOURCE_ACTIVE_NULL' using errcode='22023';end if;
  select o.* into strict v_origin from private.bpay_next_source_current_origins o where o.origin_kind=p_kind and o.origin_id=p_id for update;
  if v_origin.active=p_active then return;end if;
  v_delta:=case when p_active then 1 else -1 end;
  insert into private.bpay_next_source_current_revisions(scope_id,final_revision_id,order_key,active_origin_count)
    values(v_origin.scope_id,v_origin.final_revision_id,v_origin.order_key,greatest(v_delta,0))
    on conflict(scope_id,final_revision_id) do update
      set active_origin_count=bpay_next_source_current_revisions.active_origin_count+v_delta;
  update private.bpay_next_source_current_origins o set active=p_active where o.origin_kind=p_kind and o.origin_id=p_id;
  if p_kind='MOVEMENT' then
    perform 1 from private.bpay_next_source_current_magnitudes m where m.scope_id=v_origin.scope_id
      and m.work_event_id=v_origin.work_event_id and m.magnitude_hash=v_origin.magnitude_hash for update;
    perform private.bpay_next_source_nhsp_delta_v1(v_origin.scope_id,v_origin.work_event_id,v_origin.magnitude_hash,
      v_origin.order_key,case when v_origin.contribution=1 then v_delta else 0 end,case when v_origin.contribution=-1 then v_delta else 0 end);
    v_key:=private.bpay_next_source_nhsp_head_v1(v_origin.scope_id,v_origin.work_event_id,v_origin.magnitude_hash);
    if v_key is not null then
      select coalesce(o.selected_movement_id,o.movement_id) into v_movement from private.bpay_next_source_current_origins o
        where o.scope_id=v_origin.scope_id and o.work_event_id=v_origin.work_event_id
          and o.magnitude_hash=v_origin.magnitude_hash and o.order_key=v_key and o.active
          and o.origin_kind='MOVEMENT' and o.contribution=1
        order by o.representative_created_at desc,o.origin_id::text desc limit 1;
      if v_movement is null then raise exception 'BPAY_NEXT_SOURCE_REPRESENTATIVE_MISSING' using errcode='55000';end if;
    end if;
    update private.bpay_next_source_current_magnitudes m set surviving_order_key=v_key,selected_movement_id=v_movement
      where m.scope_id=v_origin.scope_id and m.work_event_id=v_origin.work_event_id and m.magnitude_hash=v_origin.magnitude_hash;
    perform private.bpay_next_source_current_refresh_v1(v_origin.scope_id,v_origin.work_event_id);
  elsif p_kind='TRANSITION' then
    perform private.bpay_next_source_current_refresh_v1(v_origin.scope_id,v_origin.work_event_id);
  elsif p_kind='EXPENSE' and not p_active then
    delete from private.bpay_next_source_current_expenses e where e.scope_id=v_origin.scope_id
      and e.work_event_id=v_origin.work_event_id and e.authority_id=p_id;
  end if;
end $f$;

create or replace function private.weekly_source_nhsp_none_write_admit_v1(p_basis jsonb,p_revision uuid)
returns void language plpgsql stable security definer set search_path='pg_catalog','pg_temp' as $function$
declare revision public.weekly_source_final_revisions%rowtype;u public.weekly_source_uploads%rowtype;
  session public.weekly_final_source_correction_sessions%rowtype;scope public.weekly_source_report_scopes%rowtype;
  saved jsonb;current_basis jsonb;target uuid;counted integer;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict revision from public.weekly_source_final_revisions where id=p_revision;
  select * into strict u from public.weekly_source_uploads where id=revision.upload_id;
  select * into strict scope from public.weekly_source_report_scopes where id=revision.report_scope_id;
  if p_basis is distinct from private.weekly_source_nhsp_none_invoice_basis_v1(
    (p_basis->>'row_resolution_id')::uuid,p_revision) then
    raise exception 'WEEKLY_SOURCE_NHSP_NONE_WRITE_BASIS_UNBOUND' using errcode='55000';end if;
  select value->'nhsp_negative_population'->'native_current_basis' into strict saved
    from jsonb_array_elements(p_basis#>'{paid_overlap_choice_proof,inputs,overlaps}')
    where value->>'work_event_id'=p_basis->>'work_event_id';
  current_basis:=private.weekly_source_nhsp_paid_overlap_basis_v1((p_basis->>'work_event_id')::uuid,
    revision.finalised_by_user_id,revision.source_cycle_id);
  if current_basis is distinct from saved or current_basis->>'state' is distinct from 'NATIVE_POSITION_INPUTS' then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_FACTS_CHANGED' using errcode='40001';end if;
  target:=(p_basis->>'normal_pay_movement_id')::uuid;
  if u.purpose='ORDINARY' then
    if revision.state<>'CURRENT' or revision.reason<>'INITIAL_FINALISATION' or revision.predecessor_revision_id is not null
      or p_basis->>'normal_pay_report_scope_id'=scope.id::text
      or not exists(select 1 from public.weekly_source_final_revisions normal_revision
        join public.weekly_source_report_scopes normal_scope on normal_scope.id=normal_revision.report_scope_id
        where normal_revision.id=(p_basis->>'normal_pay_final_revision_id')::uuid and normal_revision.state='CURRENT'
          and normal_scope.current_final_revision_id=normal_revision.id) then
      raise exception 'WEEKLY_SOURCE_NHSP_NONE_NORMAL_WITNESS_NOT_CURRENT' using errcode='55000';end if;
  elsif u.purpose='FINAL_SOURCE_CORRECTION' then
    perform private.weekly_source_paid_match_correction_scope_v1(u.id,revision.finalised_by_user_id,false);
    select * into strict session from public.weekly_final_source_correction_sessions where id=u.correction_session_id;
    if revision.state<>'PREPARED' or revision.reason<>'CORRECT_FINAL_SOURCE' or session.state<>'PREPARING'
      or revision.predecessor_revision_id is distinct from session.expected_current_final_revision_id then
      raise exception 'WEEKLY_SOURCE_NHSP_NONE_CORRECTION_WRITE_UNBOUND' using errcode='55000';end if;
    if p_basis->>'normal_pay_report_scope_id'=scope.id::text then
      -- An actual prior pay origin is required; a cash receipt or historical
      -- NORMAL row alone cannot become current correction authority.
      select count(*) into counted from private.bpay_next_source_current_origins origin
        join private.bpay_next_source_current_magnitudes magnitude on magnitude.scope_id=origin.scope_id
          and magnitude.work_event_id=origin.work_event_id and magnitude.magnitude_hash=origin.magnitude_hash
        where origin.origin_kind='MOVEMENT' and origin.final_revision_id=revision.predecessor_revision_id
          and origin.work_event_id=(p_basis->>'work_event_id')::uuid and origin.active and origin.contribution=1
          and coalesce(origin.selected_movement_id,origin.movement_id)=target and magnitude.selected_movement_id=target
          and magnitude.surviving_order_key=origin.order_key;
      if counted<>1 then raise exception 'WEEKLY_SOURCE_NHSP_NONE_RETAINED_ORIGIN_UNBOUND' using errcode='55000';end if;
    end if;
  else raise exception 'WEEKLY_SOURCE_NHSP_NONE_WRITE_SCOPE_UNBOUND' using errcode='55000';end if;
end;
$function$;

create or replace function private.bpay_next_source_current_capture_nhsp_none_v1(p_movement uuid)
returns jsonb language plpgsql security definer set search_path='pg_catalog','private','public','pg_temp' as $function$
declare invoice public.weekly_source_billing_movements%rowtype;normal public.weekly_source_billing_movements%rowtype;
  revision public.weekly_source_final_revisions%rowtype;session public.weekly_final_source_correction_sessions%rowtype;
  old_origin private.bpay_next_source_current_origins%rowtype;existing private.bpay_next_source_current_origins%rowtype;
  lineage public.weekly_source_row_timesheet_lineages%rowtype;authority record;basis jsonb;economic uuid;
  magnitude jsonb;hash bytea;resolution uuid;scope uuid;counted integer;inserted boolean;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict invoice from public.weekly_source_billing_movements where id=p_movement;
  basis:=private.weekly_source_nhsp_none_invoice_origin_assert_v1(invoice.id);
  if basis->>'normal_pay_report_scope_id' is distinct from basis->>'report_scope_id' then
    return jsonb_build_object('origin_id',invoice.id,'active',false,'pay_origin_present',false,
      'reason','NORMAL_POSITION_HAS_DISTINCT_REPORT_AUTHORITY');end if;
  select * into strict revision from public.weekly_source_final_revisions where id=invoice.final_revision_id;
  select * into strict authority from private.bpay_next_source_current_revision_v1(revision.id);
  select * into strict session from public.weekly_final_source_correction_sessions
    where prepared_final_revision_id=revision.id and replacement_correction_upload_id=revision.upload_id;
  if revision.state<>'CURRENT' or revision.reason<>'CORRECT_FINAL_SOURCE' or not authority.is_current
    or session.state not in ('COMMITTING','APPLIED') or session.authority_scope_kind<>'NHSP_REPORT_SCOPE'
    or session.report_scope_id is distinct from revision.report_scope_id
    or session.source_cycle_id is distinct from revision.source_cycle_id
    or session.expected_current_final_revision_id is distinct from revision.predecessor_revision_id
    or (session.state='APPLIED' and session.applied_final_revision_id is distinct from revision.id)
    or not exists(select 1 from public.weekly_source_final_revisions old_revision
      where old_revision.id=revision.predecessor_revision_id and old_revision.state='SUPERSEDED'
        and old_revision.manifest_hash=session.expected_final_manifest_hash) then
    raise exception 'BPAY_NEXT_SOURCE_NHSP_NONE_RETAINED_SCOPE_UNBOUND' using errcode='55000';end if;
  select * into strict normal from public.weekly_source_billing_movements where id=(basis->>'normal_pay_movement_id')::uuid;
  resolution:=(normal.source_facts_json->>'row_resolution_id')::uuid;
  select * into strict lineage from public.weekly_source_row_timesheet_lineages where row_resolution_id=resolution;
  select id into strict economic from public.weekly_source_row_economic_snapshots where row_resolution_id=resolution;
  scope:=private.bpay_next_source_current_scope_v1(resolution,authority.source_group_id,normal.work_event_id,normal.contract_id);
  magnitude:=private.bpay_next_source_nhsp_magnitude_v1(normal.source_facts_json,
    normal.canonical_pay_vector_json,normal.canonical_charge_vector_json);
  hash:=private.weekly_source_sha256_jsonb_v1('BPAY_NEXT_SOURCE_NHSP_MAGNITUDE_V1',magnitude);
  select count(*) into counted from private.bpay_next_source_current_origins origin
    where origin.origin_kind='MOVEMENT' and origin.final_revision_id=revision.predecessor_revision_id
      and origin.scope_id=scope and origin.work_event_id=normal.work_event_id and origin.contribution=1
      and coalesce(origin.selected_movement_id,origin.movement_id)=normal.id
      and origin.retracted_by_session_id=session.id and not origin.active;
  if counted<>1 then raise exception 'BPAY_NEXT_SOURCE_NHSP_NONE_PRIOR_ORIGIN_UNBOUND' using errcode='55000';end if;
  select * into strict old_origin from private.bpay_next_source_current_origins origin
    where origin.origin_kind='MOVEMENT' and origin.final_revision_id=revision.predecessor_revision_id
      and origin.scope_id=scope and origin.work_event_id=normal.work_event_id and origin.contribution=1
      and coalesce(origin.selected_movement_id,origin.movement_id)=normal.id
      and origin.retracted_by_session_id=session.id and not origin.active;
  if old_origin.magnitude_hash is distinct from hash or old_origin.row_resolution_id is distinct from resolution
    or old_origin.lineage_id is distinct from lineage.id or old_origin.economic_snapshot_id is distinct from economic
    or not exists(select 1 from public.weekly_source_billing_movements prior_invoice
      where prior_invoice.id=old_origin.movement_id and prior_invoice.id=old_origin.origin_id
        and prior_invoice.final_revision_id=old_origin.final_revision_id
        and prior_invoice.movement_economic_hash=old_origin.source_hash
        and ((prior_invoice.id=normal.id and prior_invoice.pay_effect='NORMAL' and old_origin.selected_movement_id is null)
          or (prior_invoice.pay_effect='NONE' and old_origin.selected_movement_id=normal.id
            and private.weekly_source_nhsp_none_invoice_origin_assert_v1(prior_invoice.id)->>'normal_pay_movement_id'=normal.id::text)))
    or not exists(select 1 from private.bpay_next_source_current_magnitudes m where m.scope_id=scope
      and m.work_event_id=normal.work_event_id and m.magnitude_hash=hash and m.economic_magnitude=magnitude) then
    raise exception 'BPAY_NEXT_SOURCE_NHSP_NONE_NORMAL_PROVENANCE_UNBOUND' using errcode='55000';end if;
  select * into existing from private.bpay_next_source_current_origins where origin_kind='MOVEMENT' and origin_id=invoice.id;
  if found and (existing.movement_id,existing.scope_id,existing.work_event_id,existing.final_revision_id,
      existing.order_key,existing.source_hash,existing.row_resolution_id,existing.lineage_id,existing.economic_snapshot_id,
      existing.selected_movement_id,existing.magnitude_hash,existing.contribution,existing.representative_created_at)
    is distinct from (invoice.id,scope,normal.work_event_id,revision.id,authority.order_key,invoice.movement_economic_hash,
      resolution,lineage.id,economic,normal.id,hash,1::smallint,invoice.created_at_utc) then
    raise exception 'BPAY_NEXT_SOURCE_ORIGIN_CHANGED' using errcode='55000';end if;
  if found and (existing.active or existing.retracted_by_session_id is not null) then
    return jsonb_build_object('origin_id',invoice.id,'active',existing.active,'pay_origin_present',true,'idempotent',true);end if;
  insert into private.bpay_next_source_current_origins(origin_kind,origin_id,movement_id,scope_id,work_event_id,
    final_revision_id,order_key,source_hash,row_resolution_id,lineage_id,economic_snapshot_id,
    selected_movement_id,magnitude_hash,contribution,representative_created_at)
    values('MOVEMENT',invoice.id,invoice.id,scope,normal.work_event_id,revision.id,authority.order_key,
      invoice.movement_economic_hash,resolution,lineage.id,economic,normal.id,hash,1,invoice.created_at_utc) on conflict do nothing;
  inserted:=found;
  perform private.bpay_next_source_current_toggle_v1('MOVEMENT',invoice.id,true);
  return jsonb_build_object('origin_id',invoice.id,'active',true,'pay_origin_present',true,
    'normal_pay_movement_id',normal.id,'idempotent',not inserted);
end;
$function$;

create or replace function private.weekly_source_nhsp_selected_pay_origin_v1(p_scope uuid,p_event uuid,p_normal uuid)
returns uuid language plpgsql stable security definer set search_path='pg_catalog','pg_temp' as $function$
declare origin private.bpay_next_source_current_origins%rowtype;normal public.weekly_source_billing_movements%rowtype;
  invoice public.weekly_source_billing_movements%rowtype;authority record;basis jsonb;magnitude jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict normal from public.weekly_source_billing_movements where id=p_normal;
  if normal.pay_effect<>'NORMAL' or normal.work_event_id is distinct from p_event
    or normal.source_profile_kind<>'NHSP_TRUST_BACKING_REPORT' or normal.source_line_kind<>'NHSP_PHYSICAL_POSITIVE'
    or normal.movement_role not in ('POSITIVE','REPLACEMENT') then
    raise exception 'WEEKLY_SOURCE_NHSP_SELECTED_NORMAL_UNBOUND' using errcode='55000';end if;
  magnitude:=private.bpay_next_source_nhsp_magnitude_v1(normal.source_facts_json,
    normal.canonical_pay_vector_json,normal.canonical_charge_vector_json);
  select o.* into strict origin from private.bpay_next_source_current_origins o
    join private.bpay_next_source_current_magnitudes m on m.scope_id=o.scope_id and m.work_event_id=o.work_event_id
      and m.magnitude_hash=o.magnitude_hash and m.surviving_order_key=o.order_key
    where o.origin_kind='MOVEMENT' and o.scope_id=p_scope and o.work_event_id=p_event and o.active and o.contribution=1
      and m.selected_movement_id=normal.id and coalesce(o.selected_movement_id,o.movement_id)=normal.id
      and m.economic_magnitude=magnitude
    order by o.representative_created_at desc,o.origin_id::text desc limit 1;
  select * into strict authority from private.bpay_next_source_current_revision_v1(origin.final_revision_id);
  select * into strict invoice from public.weekly_source_billing_movements where id=origin.movement_id;
  if not authority.is_current or origin.origin_id is distinct from invoice.id
    or origin.final_revision_id is distinct from invoice.final_revision_id
    or origin.source_hash is distinct from invoice.movement_economic_hash
    or origin.row_resolution_id::text is distinct from normal.source_facts_json->>'row_resolution_id'
    or origin.magnitude_hash is distinct from private.weekly_source_sha256_jsonb_v1('BPAY_NEXT_SOURCE_NHSP_MAGNITUDE_V1',magnitude)
    or not exists(select 1 from public.weekly_source_row_timesheet_lineages l
      join public.weekly_source_row_economic_snapshots e on e.row_resolution_id=l.row_resolution_id
      where l.id=origin.lineage_id and l.row_resolution_id=origin.row_resolution_id
        and e.id=origin.economic_snapshot_id and l.work_event_id=p_event and e.work_event_id=p_event
        and (l.candidate_id,l.client_id,l.contract_id) is not distinct from
          (normal.candidate_id,normal.actual_client_id,normal.contract_id)) then
    raise exception 'WEEKLY_SOURCE_NHSP_SELECTED_ORIGIN_UNBOUND' using errcode='55000';end if;
  if invoice.id=normal.id then
    if origin.selected_movement_id is not null then
      raise exception 'WEEKLY_SOURCE_NHSP_SELECTED_ORIGIN_UNBOUND' using errcode='55000';end if;
  else
    basis:=private.weekly_source_nhsp_none_invoice_origin_assert_v1(invoice.id);
    if invoice.pay_effect<>'NONE' or origin.selected_movement_id is distinct from normal.id
      or basis->>'normal_pay_movement_id' is distinct from normal.id::text
      or basis->>'normal_pay_movement_sha256' is distinct from encode(normal.movement_economic_hash,'hex')
      or basis->>'normal_pay_report_scope_id' is distinct from basis->>'report_scope_id'
      or not exists(select 1 from public.weekly_final_source_correction_sessions session
        join public.weekly_source_final_revisions revision on revision.id=session.prepared_final_revision_id
        where revision.id=origin.final_revision_id and revision.state='CURRENT' and revision.reason='CORRECT_FINAL_SOURCE'
          and revision.predecessor_revision_id=session.expected_current_final_revision_id
          and session.authority_scope_kind='NHSP_REPORT_SCOPE' and session.report_scope_id=revision.report_scope_id
          and session.state in ('COMMITTING','APPLIED')
          and (session.state='COMMITTING' or session.applied_final_revision_id=revision.id)) then
      raise exception 'WEEKLY_SOURCE_NHSP_SELECTED_RETAINED_ORIGIN_UNBOUND' using errcode='55000';end if;
  end if;
  return origin.origin_id;
end;
$function$;

create or replace function private.bpay_next_source_current_event_v1(p_root uuid,p_event uuid)
returns jsonb language plpgsql stable security definer
set search_path='pg_catalog','private','public','pg_temp' as $f$
declare v_scope private.bpay_next_source_current_scopes%rowtype;v_ids uuid[];
  v_event private.bpay_next_source_current_events%rowtype;v_m public.weekly_source_billing_movements%rowtype;
  v_resolution uuid;v_lineage public.weekly_source_row_timesheet_lineages%rowtype;
  v_e public.weekly_source_row_economic_snapshots%rowtype;v_exp public.weekly_expense_authority_generations%rowtype;
  v_result jsonb;v_observation jsonb;v_family uuid;v_decision private.bpay_next_protected_current_decisions%rowtype;
begin
  if p_root is null or p_event is null then raise exception 'BPAY_NEXT_SOURCE_READ_INPUT_INVALID' using errcode='22023';end if;
  select array_agg(x.id) into v_ids from (select s.id from private.bpay_next_source_current_scopes s where s.root_timesheet_id=p_root limit 2) x;
  if coalesce(array_length(v_ids,1),0)<>1 then raise exception 'BPAY_NEXT_SOURCE_SCOPE_UNCAPTURED_OR_AMBIGUOUS' using errcode='55000';end if;
  select s.* into strict v_scope from private.bpay_next_source_current_scopes s where s.id=v_ids[1];
  if not exists(select 1 from public.weekly_work_events w where w.id=p_event and w.candidate_id=v_scope.candidate_id
    and w.client_id=v_scope.client_id and w.first_source_group_id=v_scope.source_group_id
    and w.work_date between v_scope.week_ending_date-6 and v_scope.week_ending_date) then
    raise exception 'BPAY_NEXT_SOURCE_EVENT_OUTSIDE_SCOPE' using errcode='55000';end if;
  -- Latest genuine root observation is NOT selected money provenance. In
  -- particular an empty CorrectFinal has a CURRENT observation but no new
  -- origin and may restore an older immutable surviving positive movement.
  v_observation:=private.bpay_next_source_current_observation_v1(p_root);
  select e.* into v_event from private.bpay_next_source_current_events e where e.scope_id=v_scope.id and e.work_event_id=p_event;
  if coalesce(v_event.ambiguous,false) then raise exception 'BPAY_NEXT_SOURCE_CURRENT_MAGNITUDE_AMBIGUOUS' using errcode='55000';end if;
  select a.* into v_exp from private.bpay_next_source_current_expenses c join public.weekly_expense_authority_generations a on a.id=c.authority_id
    where c.scope_id=v_scope.id and c.work_event_id=p_event;
  if v_exp.id is not null and v_exp.state<>'CURRENT' then raise exception 'BPAY_NEXT_SOURCE_EXPENSE_CACHE_STALE' using errcode='55000';end if;
  select f.id into v_family from public.weekly_exceptional_pay_target_families f
    where btrim(f.root_family_booking_id)=btrim(v_scope.family_booking_id) and f.root_family_booking_id=v_scope.family_booking_id;
  if v_family is not null then select d.* into v_decision from private.bpay_next_protected_current_decisions d where d.family_id=v_family and d.work_event_id=p_event;end if;
  v_result:=jsonb_build_object('schema_version','BPAY_NEXT_SOURCE_CURRENT_EVENT_V1','root_timesheet_id',p_root,'work_event_id',p_event,
    'source_present',coalesce(v_event.source_present,false),'movement_id',v_event.selected_movement_id,
    'transition_id',v_event.selected_transition_id,'source_kind',v_event.source_kind,'protected_decision_id',v_decision.event_id,
    'protected_state',v_decision.state,'expense_authority_id',v_exp.id,
    'source_expense_pence',v_exp.source_expense_pence::text,
    'candidate_reimbursement_ex_vat',v_exp.candidate_reimbursement_ex_vat::text,'client_charge_ex_vat',v_exp.client_charge_ex_vat::text)||v_observation;
  if coalesce(v_event.source_present,false) then
    select m.* into strict v_m from public.weekly_source_billing_movements m where m.id=v_event.selected_movement_id;
    if v_m.placement_state='VOIDED_BY_CORRECT_FINAL' and not exists(
      select 1 from private.bpay_next_source_current_origins origin
      where origin.origin_kind='MOVEMENT' and origin.origin_id=private.weekly_source_nhsp_selected_pay_origin_v1(v_scope.id,p_event,v_m.id)
        and origin.selected_movement_id=v_m.id and origin.movement_id<>v_m.id and origin.active) then
      raise exception 'BPAY_NEXT_SOURCE_MOVEMENT_CACHE_STALE' using errcode='55000';end if;
    v_resolution:=(v_m.source_facts_json->>'row_resolution_id')::uuid;
    select l.* into strict v_lineage from public.weekly_source_row_timesheet_lineages l where l.row_resolution_id=v_resolution;
    select e.* into strict v_e from public.weekly_source_row_economic_snapshots e where e.row_resolution_id=v_resolution;
    v_result:=v_result||jsonb_build_object('final_revision_id',v_m.final_revision_id,'row_resolution_id',v_resolution,
      'lineage_id',v_lineage.id,'economic_snapshot_id',v_e.id,'original_invoice_timesheet_id',v_m.invoice_timesheet_id,
      'source_facts',jsonb_build_object('work_date',v_m.source_facts_json->>'work_date','start_at_local',v_m.source_facts_json->>'start_at_local',
        'end_at_local',v_m.source_facts_json->>'end_at_local','break_minutes',v_m.source_facts_json->>'break_minutes'),
      'hours',jsonb_build_object('day',v_e.hours_day::text,'night',v_e.hours_night::text,'sat',v_e.hours_sat::text,'sun',v_e.hours_sun::text,'bh',v_e.hours_bh::text),
      'pay_rates',jsonb_build_object('day',v_e.pay_day::text,'night',v_e.pay_night::text,'sat',v_e.pay_sat::text,'sun',v_e.pay_sun::text,'bh',v_e.pay_bh::text),
      'charge_rates',jsonb_build_object('day',v_e.charge_day::text,'night',v_e.charge_night::text,'sat',v_e.charge_sat::text,'sun',v_e.charge_sun::text,'bh',v_e.charge_bh::text),
      'pay_pence',v_m.canonical_pay_vector_json->>'total_pence','charge_pence',v_m.canonical_charge_vector_json->>'total_pence');
  end if;
  if octet_length(v_result::text)>122880 then raise exception 'BPAY_NEXT_SOURCE_CURRENT_BYTE_BOUND' using errcode='54000';end if;
  return v_result;
end $f$;

create or replace function private.weekly_source_rule_qualification_scope_assert_v1(p_auth jsonb,p_actor_id uuid,p_initial_open boolean default false)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare auth jsonb; c public.weekly_source_cycles%rowtype; g public.weekly_source_groups%rowtype;
  a public.weekly_source_group_rule_assignments%rowtype; v public.weekly_source_rule_set_versions%rowtype;
  manifest jsonb; item jsonb; clients uuid[]; actual jsonb; lease jsonb; n integer; today date;
begin
  auth:=private.weekly_source_rule_qualification_authorization_v1((p_auth->>'source_cycle_id')::uuid,p_actor_id,p_auth->>'purpose');
  if auth is distinct from p_auth then raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_AUTHORIZATION_CHANGED' using errcode='40001'; end if;
  perform private._weekly_source_settings_require_admin_v1((auth->>'setup_actor_user_id')::uuid);
  select * into strict c from public.weekly_source_cycles where id=(auth->>'source_cycle_id')::uuid;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and active and source_family='ROSTER' and environment='TEST';
  perform private._weekly_source_settings_deployment_v1(g.agency_id,g.environment);
  perform private.weekly_source_office_authority_v1(p_actor_id,'APPROVE_PROTECTED_PAY',g.id,null,c.finalisation_week_ending);
  if not private.weekly_source_pay_actor_allowed_v1(p_actor_id) then raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_ACTOR_REFUSED' using errcode='42501'; end if;
  select * into strict a from public.weekly_source_group_rule_assignments where id=(auth->>'assignment_id')::uuid
    and source_group_id=g.id and not feature_enabled and rule_set_version_id=(auth->>'rule_set_version_id')::uuid
    and c.finalisation_week_ending between effective_from_week_ending and coalesce(effective_to_week_ending,'infinity'::date);
  select version.* into strict v from public.weekly_source_rule_set_versions version
    join public.weekly_source_rule_sets rules on rules.id=version.rule_set_id and rules.agency_id=g.agency_id and rules.environment=g.environment
    where version.id=a.rule_set_version_id;
  today:=(clock_timestamp() at time zone 'Europe/London')::date;
  if (g.id::text,g.agency_id::text,c.finalisation_week_ending::text,a.version::text) is distinct from
    (auth->>'source_group_id',auth->>'agency_id',auth->>'week_ending',auth->>'assignment_version')
    or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_ASSIGNMENT_V1',to_jsonb(a)),'hex') is distinct from auth->>'assignment_sha256'
    or v.values_sha256 is distinct from auth->>'rule_values_sha256'
    or (v.values_json->>'invoice_sender' is distinct from 'CLIENT_SELF_BILL'
      and not(auth->>'purpose'='SOURCE_FIXTURE_SETUP' and v.values_json->>'invoice_sender'='AGENCY_INVOICE'
        and auth->'allowed_operations' @> jsonb_build_array('weekly_source_agency_timesheet_change_v1','weekly_source_agency_change_worker_context_v1','weekly_source_agency_change_worker_apply_v1','weekly_source_agency_validation_context_v1','weekly_source_agency_validation_apply_v1','weekly_source_agency_change_authorise_step_v1','weekly_source_agency_change_return_step_v1')
        and not(auth->'allowed_operations' @> jsonb_build_array('REPORT_FIN_AB_FINALISE'))))
    or (auth->>'purpose'='AUTOMATIC_JOURNEY' and (v.values_json->>'equal_protected_hours' is distinct from 'CLEAR_AUTOMATICALLY'
      or (select automatic_reconcile_actor_user_id from public.weekly_source_global_settings where singleton) is distinct from p_actor_id))
    or exists(select 1 from public.weekly_source_group_rule_assignments enabled where enabled.source_group_id=g.id and enabled.feature_enabled)
    or private.weekly_source_bulk_producer_ready_v1(c.id) or private.weekly_source_automatic_reconcile_producer_ready_v1(c.id) then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_SCOPE_CHANGED' using errcode='40001'; end if;
  manifest:=auth->'fixture_manifest';
  if not private.weekly_source_qualification_closed_object_v1(manifest,array['group_code','client_ids','contract_ids','candidate_ids','client_refs','candidate_refs'])
    or g.code is distinct from manifest->>'group_code' or g.code !~ '^WSQ_TEST_[A-Z0-9_]+$'
    or jsonb_typeof(manifest->'client_ids') is distinct from 'array' or jsonb_array_length(manifest->'client_ids') not between 1 and 100 then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FIXTURE_REFUSED' using errcode='42501'; end if;
  select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(manifest->'client_ids') value;
  if to_jsonb(clients) is distinct from manifest->'client_ids'
    or cardinality(clients)<>(select count(distinct value) from unnest(clients) value)
    or exists(select 1 from unnest(clients) client where not exists(select 1 from public.weekly_source_group_clients member
      where member.source_group_id=g.id and member.client_id=client and c.finalisation_week_ending between member.valid_from and coalesce(member.valid_to,'infinity'::date))) then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FIXTURE_REFUSED' using errcode='42501'; end if;
  for item in select value from jsonb_array_elements(manifest->'client_refs') value loop
    if not private.weekly_source_qualification_closed_object_v1(item,array['client_id','cli_ref']) or item->>'cli_ref' !~ '^CLI-913013[0-9]{2}$'
      or not exists(select 1 from public.clients client where client.id=(item->>'client_id')::uuid and client.id=any(clients) and client.cli_ref=item->>'cli_ref') then
      raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FIXTURE_REFUSED' using errcode='42501'; end if;
  end loop;
  for item in select value from jsonb_array_elements(manifest->'candidate_refs') value loop
    if not private.weekly_source_qualification_closed_object_v1(item,array['candidate_id','tms_ref']) or item->>'tms_ref' !~ '^CCR-913013[0-9]{2}$'
      or not exists(select 1 from public.candidates candidate where candidate.id=(item->>'candidate_id')::uuid and candidate.tms_ref=item->>'tms_ref') then
      raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FIXTURE_REFUSED' using errcode='42501'; end if;
  end loop;
  select coalesce(jsonb_agg(contract.id order by contract.id),'[]'::jsonb) into actual from public.contracts contract
    where contract.client_id=any(clients) and daterange(contract.start_date,contract.end_date,'[]')
      && daterange(c.finalisation_week_ending-6,c.finalisation_week_ending,'[]');
  if actual is distinct from manifest->'contract_ids' or (select coalesce(jsonb_agg(distinct contract.candidate_id order by contract.candidate_id),'[]'::jsonb)
    from public.contracts contract where contract.id in(select value::uuid from jsonb_array_elements_text(manifest->'contract_ids') value)) is distinct from manifest->'candidate_ids'
    or jsonb_array_length(manifest->'client_refs')<>cardinality(clients)
    or (select coalesce(jsonb_agg(value->'client_id' order by value->'client_id'),'[]'::jsonb) from jsonb_array_elements(manifest->'client_refs') value) is distinct from manifest->'client_ids'
    or (select coalesce(jsonb_agg(value->'candidate_id' order by value->'candidate_id'),'[]'::jsonb) from jsonb_array_elements(manifest->'candidate_refs') value) is distinct from manifest->'candidate_ids' then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FIXTURE_REFUSED' using errcode='42501'; end if;
  perform private._weekly_source_rule_group_context_v1(g.id,a.effective_from_week_ending,a.effective_to_week_ending,v.values_json,true);
  -- HISTORICAL_FIXTURE_OPEN_BOUNDARY: every use rechecks the real native
  -- assignment audit; only the first source OPEN additionally requires zero
  -- prior uploads. No historical operational enablement is inferred.
  if a.effective_from_week_ending<today then
    perform private.weekly_source_historical_fixture_setup_assert_v1(auth,p_initial_open and auth->>'purpose'='SOURCE_FIXTURE_SETUP');
  end if;
  if p_initial_open then
    if auth->>'purpose'='SOURCE_FIXTURE_SETUP' and (c.finalisation_week_ending<>a.effective_from_week_ending
      or c.current_final_revision_id is not null or c.state in ('FINALISING','FINALISED','CORRECTION_IN_PROGRESS')
      or exists(select 1 from public.weekly_source_final_revisions final where final.source_cycle_id=c.id)
      or auth->'original_source_cas' is distinct from 'null'::jsonb) then
      raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FUTURE_UNFINALISED_REQUIRED' using errcode='55000'; end if;
  else
    select count(*),jsonb_agg(audit.after_json)->0 into n,lease from public.audit_events audit
      where audit.object_type='weekly_source_off_rule_test_journey' and audit.object_id_text=auth->>'scope_id'
        and audit.action='WEEKLY_SOURCE_OFF_RULE_TEST_OPENED' and audit.event_sequence_is_authoritative
        and not exists(select 1 from public.audit_events terminal where terminal.object_type=audit.object_type and terminal.object_id_text=audit.object_id_text
          and terminal.event_sequence_is_authoritative and terminal.action in ('WEEKLY_SOURCE_OFF_RULE_TEST_CLOSED','WEEKLY_SOURCE_OFF_RULE_TEST_REVOKED'));
    if n<>1 or lease->>'authorization_sha256' is distinct from auth->>'authorization_sha256'
      or lease->>'scope_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_TEST_SCOPE_V1',lease-'scope_sha256'),'hex') then
      raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  end if;
  if auth->>'purpose'='AUTOMATIC_JOURNEY' then
    if not p_initial_open then
      -- ORIGINAL_CAPTURED_PHYSICAL_ROOTS: recheck the OPEN union of Source
      -- pay roots and signed evidence roots with the physical root's actual
      -- Contract-derived Client. Unbound Contract is not a nullable Client
      -- proof. Never recollect only surviving OPEN incidents after a round.
      if lease#>>'{original_census,schema_version}' is distinct from 'WEEKLY_SOURCE_QUALIFICATION_CENSUS_V1'
        or lease#>>'{original_census,source_cycle_id}' is distinct from c.id::text
        or lease#>>'{original_census,source_group_id}' is distinct from g.id::text
        or lease#>>'{original_census,week_ending}' is distinct from c.finalisation_week_ending::text
        or lease#>'{original_census,original_client_ids}' is distinct from auth#>'{fixture_manifest,client_ids}'
        or lease#>>'{original_census,census_sha256}' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_SOURCE_QUALIFICATION_CENSUS_V1',lease->'original_census'-'census_sha256'),'hex') then
        raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_ORIGINAL_ROOT_CHANGED' using errcode='40001'; end if;
      for item in select value from jsonb_array_elements(lease#>'{original_census,original_root_identities}') value loop
        if not private.weekly_source_qualification_closed_object_v1(item,array['timesheet_id','booking_id','contract_id','candidate_id','client_id']) then
          raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_ORIGINAL_ROOT_CHANGED' using errcode='40001'; end if;
        select jsonb_build_object('timesheet_id',sheet.timesheet_id,'booking_id',sheet.booking_id,'contract_id',contract.id,
          'candidate_id',contract.candidate_id,'client_id',contract.client_id) into actual
          from public.timesheets sheet join public.contracts contract on contract.id=sheet.contract_id
          where sheet.timesheet_id=(item->>'timesheet_id')::uuid
            and contract.candidate_id is not null and contract.client_id is not null;
        if actual is distinct from item then
          raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_ORIGINAL_ROOT_CHANGED' using errcode='40001'; end if;
      end loop;
    end if;
    if cardinality(clients)<>1 or auth->'original_source_cas' is null or auth->'original_source_cas'='null'::jsonb
      or private.weekly_source_bulk_source_cas_v1(c.id,clients) is distinct from auth->'original_source_cas'
      or not exists(select 1 from public.weekly_source_final_revisions final where final.id=c.current_final_revision_id
        and final.source_cycle_id=c.id and final.state='CURRENT' and final.rule_set_version_id=v.id) then
      raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_ORIGINAL_SOURCE_CHANGED' using errcode='40001'; end if;
  end if;
  return auth;
exception when no_data_found or too_many_rows or invalid_text_representation or datetime_field_overflow then
  raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_contract_fixed_approval_locks_v1(p_client_ids uuid[])
returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $contract_fixed_locks$
declare clients uuid[];groups_before uuid[];groups_after uuid[];identity uuid;
begin
 if p_client_ids is null or cardinality(p_client_ids) not between 1 and 2 or array_position(p_client_ids,null) is not null then
  raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_SCOPE_INVALID' using errcode='22023';end if;
 select array_agg(distinct value order by value) into clients from unnest(p_client_ids) value;
 if (select count(*) from public.clients c where c.id=any(clients))<>cardinality(clients) then
  raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_SCOPE_INVALID' using errcode='22023';end if;
 select coalesce(array_agg(distinct m.source_group_id order by m.source_group_id),'{}'::uuid[]) into groups_before
 from public.weekly_source_group_clients m where m.client_id=any(clients);
 -- Same lifecycle/client keys and order as the actual feature/Client owners.
 -- Existing native deletion/clone callers may already hold their Contract;
 -- non-waiting acquisition refuses a race instead of reversing that lock order.
 foreach identity in array groups_before loop
  if not pg_try_advisory_xact_lock(hashtextextended('weekly-source-cycle-lifecycle:'||identity::text,0)) then
   raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';end if;
 end loop;
 foreach identity in array clients loop
  if not pg_try_advisory_xact_lock(hashtextextended('weekly-source-settings-client:'||identity::text,0)) then
   raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';end if;
 end loop;
 perform 1 from public.clients c where c.id=any(clients) order by c.id for update nowait;
 perform 1 from public.weekly_source_groups g where g.id=any(groups_before) order by g.id for update nowait;
 perform 1 from public.weekly_source_group_rule_assignments a where a.source_group_id=any(groups_before) order by a.id for update nowait;
 perform 1 from public.weekly_source_group_clients m where m.client_id=any(clients) order by m.id for update nowait;
 perform 1 from public.weekly_source_client_policies cp where cp.client_id=any(clients) order by cp.id for update nowait;
 perform 1 from public.client_settings cs where cs.client_id=any(clients) order by cs.id for update nowait;
 select coalesce(array_agg(distinct m.source_group_id order by m.source_group_id),'{}'::uuid[]) into groups_after
 from public.weekly_source_group_clients m where m.client_id=any(clients);
 if groups_after is distinct from groups_before then
  raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';end if;
exception when lock_not_available then
 raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';
end;
$contract_fixed_locks$;

create or replace function private.weekly_source_contract_fixed_approval_sync_v1(p_contract_id uuid,p_actor_user_id uuid)
returns public.contracts language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','extensions','pg_temp'
as $contract_fixed_sync$
declare contract public.contracts%rowtype;target_client uuid;before_policy jsonb;after_policy jsonb;scope record;authority jsonb;
 today date:=(transaction_timestamp() at time zone 'Europe/London')::date;
 v_environment text;fixed boolean:=false;group_id uuid;scope_date date;capture jsonb;response jsonb;receipt_key text;
begin
 perform private.weekly_source_query_require_service_v1();
 -- Permission remains with the actual native Contract/deletion/clone caller.
 -- This private helper derives a system key and records that caller's REAL actor.
 if not exists(select 1 from public.tms_users u where u.id=p_actor_user_id and u.is_active) then
  raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_ACTOR_REQUIRED' using errcode='42501';end if;
 select c.* into strict contract from public.contracts c where c.id=p_contract_id;
 target_client:=contract.client_id;
 perform private.weekly_source_contract_fixed_approval_locks_v1(array[target_client]);
 select s.candidate_app_environment into strict v_environment from public.settings_defaults s where s.id=1;
 -- The native configured predicate considers EVERY Contract for the Client.
 -- Inserting/changing one route can therefore apply/clear other raw keys.
 -- Refresh that same complete Client set, with one receipt per real change.
 for contract in select c.* from public.contracts c where c.client_id=target_client order by c.id for update nowait
 loop
 fixed:=false;group_id:=null;scope_date:=null;
 before_policy:=contract.candidate_manager_approval_policy_json;
 if before_policy is not null and jsonb_typeof(before_policy) is distinct from 'object' then
  raise exception 'CANDIDATE_MANAGER_CONTRACT_POLICY_FIELD_INVALID' using errcode='22023';end if;
 if contract.weekly_timesheet_source::text='HEALTHROSTER' and contract.end_date>=greatest(contract.start_date,today) then
  -- The raw Contract key represents an existing current/future preset.107 is
  -- still the sole dated Candidate consumer; this unversioned key NEVER grants
  -- approval for an earlier, later, DAILY, expense or combined workflow.
  for scope in
   with dates as (
    select greatest(contract.start_date,today) evaluation_date
    union select m.valid_from from public.weekly_source_group_clients m where m.client_id=contract.client_id
    union select m.valid_to+1 from public.weekly_source_group_clients m where m.client_id=contract.client_id and isfinite(m.valid_to)
    union select a.effective_from_week_ending-6 from public.weekly_source_group_rule_assignments a
     join public.weekly_source_group_clients m on m.source_group_id=a.source_group_id where m.client_id=contract.client_id
    union select a.effective_to_week_ending+1 from public.weekly_source_group_rule_assignments a
     join public.weekly_source_group_clients m on m.source_group_id=a.source_group_id where m.client_id=contract.client_id and isfinite(a.effective_to_week_ending)
    union select cp.effective_from from public.weekly_source_client_policies cp where cp.client_id=contract.client_id
    union select cp.effective_to+1 from public.weekly_source_client_policies cp where cp.client_id=contract.client_id and isfinite(cp.effective_to)
    union select cs.effective_from from public.client_settings cs where cs.client_id=contract.client_id and cs.effective_from is not null
    union select c.end_date+1 from public.contracts c where c.client_id=contract.client_id and isfinite(c.end_date)
   )
   select distinct g.id,g.agency_id,g.environment,greatest(d.evaluation_date,contract.start_date,today) evaluation_date
   from dates d join public.weekly_source_group_clients m on m.client_id=contract.client_id
    and greatest(d.evaluation_date,contract.start_date,today) between m.valid_from and coalesce(m.valid_to,'infinity'::date)
   join public.weekly_source_groups g on g.id=m.source_group_id and g.active and g.source_family='ROSTER' and g.environment=v_environment
   where greatest(d.evaluation_date,contract.start_date,today)<=contract.end_date order by evaluation_date,g.id
  loop
   if (select count(*) from public.weekly_source_group_clients m join public.weekly_source_groups g on g.id=m.source_group_id
     and g.active and g.source_family='ROSTER' and g.environment=v_environment where m.client_id=contract.client_id
      and scope.evaluation_date between m.valid_from and coalesce(m.valid_to,'infinity'::date))<>1 then
    raise exception 'WEEKLY_SOURCE_GROUP_CARDINALITY_INVALID' using errcode='55000';end if;
   authority:=private._contract_settings_effective_core_v1(contract.client_id,contract.id,scope.evaluation_date,'WEEKLY',null);
   if authority->>'configured_route'='HEALTHROSTER_WEEKLY_VALIDATION'
    and coalesce((authority#>>'{applicability,configuration_valid}')::boolean,false)
    and not coalesce((authority#>>'{applicability,import_authoritative}')::boolean,false)
    and private.weekly_source_configured_agency_invoice_v1(contract.client_id,scope.id,scope.agency_id,scope.environment,scope.evaluation_date) is true then
    fixed:=true;group_id:=scope.id;scope_date:=scope.evaluation_date;exit;
   end if;
  end loop;
 end if;
 after_policy:=case when fixed then coalesce(before_policy,'{}'::jsonb)||jsonb_build_object('approval','NOT_REQUIRED') else before_policy-'approval' end;
 if after_policy is not distinct from before_policy then continue;end if;
 capture:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_FIXED_APPROVAL_CHANGE_V1','contract_id',contract.id,
  'client_id',contract.client_id,'source_group_id',group_id,'effective_from',scope_date,'expected_contract_updated_at',contract.updated_at,
  'before_policy',before_policy,'after_policy',after_policy,'operation',case when fixed then 'APPLY' else 'CLEAR' end);
 capture:=capture||jsonb_build_object('input_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_FIXED_APPROVAL_CHANGE_V1',capture),'hex'));
 receipt_key:='SOURCE_AGENCY_FIXED:'||gen_random_uuid()::text;
 update public.contracts c set candidate_manager_approval_policy_json=after_policy,updated_at=transaction_timestamp()
  where c.id=contract.id returning c.* into contract;
 response:=public.contract_manager_authoriser_policy_get_v1(contract.id)||jsonb_build_object('system_fixed_approval',capture,'idempotent_replay',false);
 insert into public.candidate_manager_authoriser_policy_receipts(entity_kind,entity_id,idempotency_key,semantic_sha256,response_json,actor_user_id,recorded_at_utc)
 values('CONTRACT',contract.id,receipt_key,extensions.digest(convert_to(after_policy::text,'UTF8'),'sha256'),response,p_actor_user_id,transaction_timestamp());
 end loop;
 select c.* into strict contract from public.contracts c where c.id=p_contract_id and c.client_id=target_client;
 return contract;
exception when no_data_found or too_many_rows then
 raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_SCOPE_INVALID' using errcode='55000';
 when lock_not_available then
 raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';
end;
$contract_fixed_sync$;

create or replace function public.weekly_source_contract_write_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $contract_write$
declare actor uuid;mode text;values_json jsonb;contract_id uuid;expected timestamptz;
 before_row public.contracts%rowtype;after_row public.contracts%rowtype;source_row public.contracts%rowtype;
 old_client uuid;new_client uuid;old_client_contract uuid;source_id uuid;source_expected timestamptz;columns_sql text;expressions_sql text;changes_sql text;
 permitted constant text[]:=array[
 'candidate_id','client_id','role','band','display_site','ward_hint','start_date','end_date','pay_method_snapshot',
 'rates_json','std_hours_json','std_schedule_json','bucket_labels_json','additional_rates_json','default_submission_mode',
 'week_ending_weekday_snapshot','auto_invoice','require_reference_to_pay','require_reference_to_invoice','mileage_pay_rate','mileage_charge_rate',
 'overrideclientsettings','candidate_paper_submission_enabled_override','candidate_expenses_require_separate_timesheet_override',
 'candidate_expense_invoice_email_override','is_ad_hoc','is_nhsp','autoprocess_hr','requires_hr','no_timesheet_required',
 'weekly_timesheet_source','daily_calc_of_invoices','group_nightsat_sunbh','self_bill','hr_attach_to_invoice','ts_attach_to_invoice',
 'reference_number_required_to_issue_invoice','send_manual_invoices_to_different_email','manual_invoices_alt_email_address',
 'send_ts_queries_to_different_email','ts_queries_alt_email_address','timesheet_break_entry_mode','created_at','updated_at'];
begin
 perform private.weekly_source_query_require_service_v1();
 if jsonb_typeof(p_request) is distinct from 'object' or p_request-array['actor_user_id','mode','values','contract_id','expected_updated_at',
   'policy_source_contract_id','policy_source_expected_updated_at']<>'{}'::jsonb then
  raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_WRITE_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;mode:=p_request->>'mode';values_json:=p_request->'values';
 perform private._weekly_source_settings_require_admin_v1(actor);
 if mode is null or mode not in('POST','PATCH') or jsonb_typeof(values_json) is distinct from 'object' or values_json='{}'::jsonb
  or octet_length(values_json::text)>262144 or exists(select 1 from jsonb_object_keys(values_json) key where not(key=any(permitted))) then
  raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_WRITE_INVALID' using errcode='22023';end if;
 if mode='PATCH' then
  contract_id:=(p_request->>'contract_id')::uuid;expected:=(p_request->>'expected_updated_at')::timestamptz;
  if contract_id is null or expected is null or values_json ? 'created_at' or p_request ? 'policy_source_contract_id'
    or p_request ? 'policy_source_expected_updated_at' then
   raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_WRITE_INVALID' using errcode='22023';end if;
  select c.* into strict before_row from public.contracts c where c.id=contract_id;
  old_client:=before_row.client_id;new_client:=case when values_json ? 'client_id' then (values_json->>'client_id')::uuid else old_client end;
 else
  if p_request ? 'contract_id' or p_request ? 'expected_updated_at' then
   raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_WRITE_INVALID' using errcode='22023';end if;
  new_client:=(values_json->>'client_id')::uuid;old_client:=new_client;
 end if;
 perform private.weekly_source_contract_fixed_approval_locks_v1(array[old_client,new_client]);
 if mode='PATCH' then
  select c.* into strict before_row from public.contracts c where c.id=contract_id for update nowait;
  if before_row.client_id is distinct from old_client or before_row.updated_at is distinct from expected then
   raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';end if;
 else
  source_id:=(p_request->>'policy_source_contract_id')::uuid;
  source_expected:=(p_request->>'policy_source_expected_updated_at')::timestamptz;
  if (source_id is null)<>(source_expected is null) then
   raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_WRITE_INVALID' using errcode='22023';end if;
  if source_id is not null then
   select c.* into strict source_row from public.contracts c where c.id=source_id for share nowait;
   if source_row.client_id is distinct from new_client or source_row.updated_at is distinct from source_expected then
    raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';end if;
   -- Copy ordinary manager-policy bytes from the ACTUAL source Contract;
   -- the next native sync rederives only the fixed key for the new scope.
   values_json:=values_json||jsonb_build_object('candidate_manager_approval_policy_json',source_row.candidate_manager_approval_policy_json);
  end if;
 end if;
 -- Identifiers come exclusively from the finite list above or the one native
 -- copy field. JSON values remain bound parameters; no caller SQL is accepted.
 select string_agg(format('%I',key),',' order by key),
  string_agg(format('incoming.%I',key),',' order by key),
  string_agg(format('%I=incoming.%I',key,key),',' order by key)
 into columns_sql,expressions_sql,changes_sql from jsonb_object_keys(values_json) key;
 if mode='POST' then
  execute format('insert into public.contracts as target(%s) select %s from jsonb_populate_record(null::public.contracts,$1) incoming returning target.*',columns_sql,expressions_sql)
   into strict after_row using values_json;
 else
  execute format('update public.contracts as target set %s from jsonb_populate_record(null::public.contracts,$1) incoming where target.id=$2 and target.updated_at is not distinct from $3 returning target.*',changes_sql)
   into strict after_row using values_json,contract_id,expected;
 end if;
 after_row:=private.weekly_source_contract_fixed_approval_sync_v1(after_row.id,actor);
 if old_client is distinct from new_client then
  select c.id into old_client_contract from public.contracts c where c.client_id=old_client order by c.id limit 1;
  if old_client_contract is not null then perform private.weekly_source_contract_fixed_approval_sync_v1(old_client_contract,actor);end if;
 end if;
 return to_jsonb(after_row);
exception when no_data_found or too_many_rows then
 raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';
 when lock_not_available then
 raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';
 when invalid_text_representation or invalid_datetime_format or datetime_field_overflow then
 raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_WRITE_INVALID' using errcode='22023';
end;
$contract_write$;

create or replace function private.weekly_source_agency_submitted_claim_v1(
  p_timesheet_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  v_submission jsonb; v_workflow public.candidate_submission_workflows%rowtype;
  v_input jsonb; v_patch jsonb; v_schedule jsonb; v_receipt jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  v_submission:=private.weekly_source_actual_timesheet_submission_v1(p_timesheet_id);
  if v_submission->>'actual_submitted' is distinct from 'true'
    or v_submission->>'support_state' is distinct from 'PROVED'
    or v_submission->>'sheet_scope' is distinct from 'WEEKLY' then
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
      'available',false,'reason','ACTUAL_WEEKLY_SUBMISSION_UNPROVED','claim',null);
  end if;
  if v_submission->>'authority' is distinct from 'CANDIDATE_IMMUTABLE_HOURS' then
    -- The existing legacy reader proves a current source and official document;
    -- it does not expose a frozen original hours vector after a native T0 edit.
    -- Keep that missing producer explicit instead of reading mutable T0 hours.
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
      'available',false,'reason','LEGACY_FROZEN_HOURS_CLAIM_UNAVAILABLE','claim',null);
  end if;
  if not pg_input_is_valid(coalesce(v_submission->>'workflow_id',''),'uuid')
    or not pg_input_is_valid(coalesce(v_submission->>'workflow_generation',''),'integer') then
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
      'available',false,'reason','IMMUTABLE_WORKFLOW_IDENTITY_UNPROVED','claim',null);
  end if;
  select * into v_workflow from public.candidate_submission_workflows
    where id=(v_submission->>'workflow_id')::uuid
      and generation=(v_submission->>'workflow_generation')::integer
      and target_timesheet_id=p_timesheet_id
      and candidate_id=(v_submission->>'candidate_id')::uuid
      and contract_id=(v_submission->>'contract_id')::uuid
      and week_ending_date=(v_submission->>'week_ending_date')::date
      and scope='WEEKLY' and workflow_kind in('CONTRACT_HOURS','CONTRACT_COMBINED')
      and worker_submitted_at_utc is not null and cancelled_at_utc is null;
  if v_workflow.id is null or jsonb_typeof(v_workflow.immutable_submission_json) is distinct from 'object'
    or octet_length(v_workflow.immutable_submission_sha256) is distinct from 32
    or private._candidate_sha256_jsonb_v1(v_workflow.immutable_submission_json)
      is distinct from v_workflow.immutable_submission_sha256
    or encode(v_workflow.immutable_submission_sha256,'hex') is distinct from v_submission->>'submission_sha256'
    or v_workflow.candidate_signed_at_utc is null then
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
      'available',false,'reason','IMMUTABLE_SUBMISSION_CHANGED_OR_UNPROVED','claim',null);
  end if;
  v_input:=coalesce(v_workflow.immutable_submission_json->'hours_submission',v_workflow.immutable_submission_json);
  v_patch:=coalesce(v_input->'timesheet_patch_json',v_input);
  v_schedule:=coalesce(v_patch->'actual_schedule_json',v_input#>'{canonical_tsfin_snapshot,actual_schedule_json}');
  if jsonb_typeof(v_input) is distinct from 'object' or jsonb_typeof(v_patch) is distinct from 'object'
    or jsonb_typeof(v_schedule) is distinct from 'array'
    or jsonb_array_length(v_schedule)>100 or octet_length(v_schedule::text)>65536
    or exists(select 1 from jsonb_array_elements(v_schedule) entry where jsonb_typeof(entry) is distinct from 'object') then
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
      'available',false,'reason','FROZEN_WORKER_HOURS_CLAIM_BOUND_OR_SHAPE_INVALID','claim',null);
  end if;
  -- The original vector is preserved verbatim. Canonical date/break conversion
  -- and work_event membership remain the actual native producer's duties.
  v_receipt:=jsonb_build_object('authority','CANDIDATE_IMMUTABLE_HOURS',
    'timesheet_id',p_timesheet_id,'timesheet_version',v_submission->'timesheet_version',
    'candidate_id',v_submission->'candidate_id','client_id',v_submission->'client_id',
    'contract_id',v_submission->'contract_id','week_ending_date',v_submission->'week_ending_date',
    'workflow_id',v_workflow.id,'workflow_generation',v_workflow.generation,
    'submission_sha256',encode(v_workflow.immutable_submission_sha256,'hex'),
    'hours_component_id',v_submission->'hours_component_id',
    'candidate_signature_component_id',v_submission->'candidate_signature_component_id',
    'submitted_at_utc',v_workflow.worker_submitted_at_utc,'signed_at_utc',v_workflow.candidate_signed_at_utc,
    'actual_schedule_json',v_schedule);
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
    'available',true,'reason',null,'claim',v_receipt,
    'claim_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',v_receipt),'hex'));
end;
$function$;

create or replace function private.weekly_source_agency_native_pay_scope_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 req private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
 work private.bpay_next_work%rowtype; revision private.bpay_next_work_revision%rowtype;
 members uuid[]; module_owner text; module_epoch bigint; work_value jsonb; revision_value jsonb;
 legacy jsonb; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict req from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 req:=private.weekly_source_agency_change_request_assert_v1(req.contract_week_id,req.reason,
   req.initial_row_signature,req.request_key,req.updated_by_user_id);
 if req.state<>'ACTIVE' then raise exception 'AGENCY_CHANGE_CURRENT_REQUEST_UNAVAILABLE' using errcode='55000'; end if;
 select * into strict t from public.timesheets where timesheet_id=req.current_timesheet_id;
 select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
 select array_agg(distinct family.family_timesheet_id order by family.family_timesheet_id) into members
 from public._pay_timesheet_rotation_scope(array[t.timesheet_id]) family;
 if members is null or cardinality(members) not between 1 and 256 or not t.timesheet_id=any(members)
  or f.id is distinct from req.current_financial_id or f.timesheet_version is distinct from t.version then
  raise exception 'AGENCY_CHANGE_NATIVE_PAY_FAMILY_SCOPE_CHANGED' using errcode='40001'; end if;
 select m.active_owner,m.owner_epoch into strict module_owner,module_epoch
 from private.bpay_next_module_control m where m.id=1;
 if module_owner is null or module_owner not in('LEGACY','NEXT') or module_epoch is null
  or module_epoch<0 or(module_owner='NEXT' and module_epoch=0) then
  raise exception 'AGENCY_CHANGE_NATIVE_PAY_MODULE_UNAVAILABLE' using errcode='55000'; end if;
 if module_owner='LEGACY' then
  -- Its exact certified grain is family/shift HOURS. It supplies no general
  -- cash/reservation/final-transfer authority and cannot permit a paid writer.
  legacy:=private.weekly_source_settlement_allocation_v1(t.timesheet_id);
 else
  select w.* into work from private.bpay_next_work w where w.booking_id=t.booking_id;
  if found then
   if work.work_kind is distinct from 'ORDINARY' or work.origin_kind is distinct from 'CONTRACT'
    or work.candidate_id is distinct from req.candidate_id or work.contract_id is distinct from req.contract_id
    or work.week_ending_date is distinct from req.week_ending_date
    or work.original_timesheet_id is null or not work.original_timesheet_id=any(members) then
    raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_WORK_SCOPE_CONFLICT' using errcode='55000'; end if;
   work_value:=jsonb_build_object('work_id',work.id,'work_kind',work.work_kind,'origin_kind',work.origin_kind,
    'original_timesheet_id',work.original_timesheet_id,'booking_id',work.booking_id,
    'candidate_id',work.candidate_id,'contract_id',work.contract_id,'week_ending_date',work.week_ending_date,
    'current_revision_id',work.current_revision_id,'applied_revision_id',work.applied_revision_id,
    'current_revision_no',work.current_revision_no);
   if coalesce(work.current_revision_id,work.applied_revision_id) is not null then
    select v.* into strict revision from private.bpay_next_work_revision v
     where v.id=coalesce(work.current_revision_id,work.applied_revision_id) and v.work_id=work.id;
    if revision.source_kind is distinct from 'ORDINARY'
     or revision.physical_timesheet_id is null or not revision.physical_timesheet_id=any(members)
     or revision.week_ending_date is distinct from req.week_ending_date then
     raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_REVISION_SCOPE_CONFLICT' using errcode='55000'; end if;
    revision_value:=jsonb_build_object('revision_id',revision.id,'work_id',revision.work_id,
     'source_kind',revision.source_kind,'revision_no',revision.revision_no,
     'physical_timesheet_id',revision.physical_timesheet_id,'physical_timesheet_version',revision.physical_timesheet_version,
     'financial_snapshot_id',revision.financial_snapshot_id,'detail_kind',revision.detail_kind,
     'source_pay_channel',revision.source_pay_channel,'expected_line_count',revision.expected_line_count,
     'certified_zero',revision.certified_zero,'approved_source_ex_vat',revision.approved_source_ex_vat,
     'sealed_at_utc',revision.sealed_at_utc);
   end if;
  end if;
 end if;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_PAY_SCOPE_V1',
  'request_id',req.id,'request_sha256',encode(req.request_sha256,'hex'),'phase_actor_user_id',req.updated_by_user_id,
  'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'contract_week_id',req.contract_week_id,
  'contract_id',req.contract_id,'candidate_id',req.candidate_id,'client_id',req.client_id,'week_ending_date',req.week_ending_date,
  'family_member_ids',to_jsonb(members),'active_owner',module_owner,'owner_epoch',module_epoch,
  'current_financial_id',f.id,'current_financial_paid_marker',f.paid_at_utc,
  'original_captured_financial_id',req.native_receipts#>'{original_capture,current_financial_id}',
  'ordinary_work',work_value,'ordinary_revision',revision_value,'legacy_family_hours',legacy);
 if octet_length(result::text)>262144 then raise exception 'AGENCY_CHANGE_NATIVE_PAY_SCOPE_BOUND_EXCEEDED' using errcode='54000'; end if;
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_PAY_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_legacy_original_document_v1(
 p_timesheet_id uuid,p_request_id uuid,p_actual_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','extensions','pg_temp'
as $function$
declare
 t public.timesheets%rowtype; c public.contracts%rowtype;
 d public.invoice_document_versions%rowtype;
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 capture jsonb; stored jsonb; witness jsonb; submission jsonb; model jsonb;
 actual_snapshot record; doc_id uuid; days jsonb; shifts jsonb; signing jsonb;
 source_fingerprint text; receipt jsonb; count_rows bigint;
 snapshot_keys constant text[]:=array['snapshot_schema_version','request_key','presentation_model',
  'presentation_model_hash','timesheet_sources','supporting_sources','supporting_manifest','higher_rate_support'];
 signing_keys constant text[]:=array['submission_mode','r2_nurse_key','r2_auth_key','img_sha256_nurse',
  'img_sha256_auth','auth_name','auth_job_title','authorised_at_server','qr_status','qr_scanned_at',
  'qr_signed_hash','qr_signed_at_utc','manual_pdf_r2_key','manual_document_asset_id'];
begin
 perform private.weekly_source_query_require_service_v1();
 if private.weekly_source_pay_actor_allowed_v1(p_actual_actor_user_id) is distinct from true then
  raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict c from public.contracts where id=t.contract_id;
 if t.is_current is distinct from true or t.archived_at_utc is not null
  or t.sheet_scope::text is distinct from 'WEEKLY' or t.line_type::text is distinct from 'HOURS'
  or t.week_ending_date is null or c.candidate_id is null or c.client_id is null then
  raise exception 'AGENCY_LEGACY_ORIGINAL_SCOPE_CHANGED' using errcode='40001'; end if;
 if p_request_id is null then
  if t.revoked_at is not null then
   raise exception 'AGENCY_LEGACY_ORIGINAL_CURRENT_SUBMISSION_REQUIRED' using errcode='40001'; end if;
  submission:=private.weekly_source_actual_timesheet_submission_v1(t.timesheet_id);
  if submission->>'actual_submitted' is distinct from 'true'
   or submission->>'support_state' is distinct from 'PROVED'
   or submission->>'authority' is distinct from 'VERIFIED_LEGACY_SOURCE_DOCUMENT'
   or submission->>'timesheet_id' is distinct from t.timesheet_id::text
   or submission->>'timesheet_version' is distinct from t.version::text
   or submission->>'candidate_id' is distinct from c.candidate_id::text
   or submission->>'client_id' is distinct from c.client_id::text
   or submission->>'contract_id' is distinct from c.id::text
   or submission->>'week_ending_date' is distinct from t.week_ending_date::text
   or not pg_input_is_valid(coalesce(submission->>'document_version_id',''),'uuid') then
   return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_LEGACY_ORIGINAL_DOCUMENT_VIEW_V1',
    'available',false,'reason','GENUINE_LEGACY_SUBMISSION_UNPROVED','document_view',null,'worker_claim_proved',null);
  end if;
  doc_id:=(submission->>'document_version_id')::uuid;
  source_fingerprint:=submission->>'source_evidence_fingerprint';
  if source_fingerprint is null or source_fingerprint!~'^[0-9a-f]{64}$'
   or doc_id is distinct from t.current_document_version_id then
   raise exception 'AGENCY_LEGACY_ORIGINAL_DOCUMENT_CHANGED' using errcode='40001'; end if;
 else
  select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
  capture:=r.native_receipts->'original_capture';stored:=capture->'original_legacy_document';
  if private.weekly_source_agency_change_request_sha256_v1(r.contract_week_id,r.reason,r.initial_row_signature,
   r.request_key,r.actor_user_id,capture) is distinct from r.request_sha256
   or r.initial_timesheet_id is distinct from t.timesheet_id or r.current_timesheet_id is distinct from t.timesheet_id
   or r.initial_timesheet_version is distinct from t.version or r.current_timesheet_version is distinct from t.version
   or r.candidate_id is distinct from c.candidate_id or r.client_id is distinct from c.client_id
   or r.contract_id is distinct from c.id or r.week_ending_date is distinct from t.week_ending_date
   or stored->>'document_state' is distinct from 'FROZEN_DOCUMENT_VIEW'
   or stored->>'available' is distinct from 'true' or jsonb_typeof(stored->'document_witness') is distinct from 'object' then
   raise exception 'AGENCY_LEGACY_ORIGINAL_CAPTURE_INVALID' using errcode='55000'; end if;
  -- Read permission belongs to the real current reader, not the original
  -- creator or a former phase actor. A read never impersonates either actor.
  perform private.weekly_source_office_authority_v1(p_actual_actor_user_id,'VIEW_PAY_WORK',
   r.source_group_id,r.client_id,r.week_ending_date);
  witness:=stored->'document_witness';
  if witness->>'authority' is distinct from 'VERIFIED_LEGACY_FROZEN_TIMESHEET_DOCUMENT'
   or not pg_input_is_valid(coalesce(witness->>'document_version_id',''),'uuid') then
   raise exception 'AGENCY_LEGACY_ORIGINAL_CAPTURE_INVALID' using errcode='55000'; end if;
  doc_id:=(witness->>'document_version_id')::uuid;
  source_fingerprint:=witness->>'source_evidence_fingerprint';
  -- Generic unauthorise may clear its authorisation clock. It is allowed only
  -- through this request's actual recorded native unauthorise result; every
  -- signature/QR/asset identity remains the originally captured value.
  if t.revoked_at is not null and coalesce((t.revoked_reason='TIMESHEET_UNAUTHORISE'
   and t.revoked_by=r.native_receipts#>>'{unauthorise,phase_actor_user_id}'
   and r.native_receipts#>>'{unauthorise,result,timesheet_id}'=t.timesheet_id::text
   and r.native_receipts#>>'{unauthorise,result,ok}'='true'
   and r.phase in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT')),false) is distinct from true then
   raise exception 'AGENCY_LEGACY_ORIGINAL_SCOPE_CHANGED' using errcode='40001'; end if;
 end if;
 select * into strict d from public.invoice_document_versions where id=doc_id;
 if d.entity_type is distinct from 'TIMESHEET' or d.entity_id is distinct from t.timesheet_id
  or d.purpose is distinct from 'TIMESHEET' or d.template_version is distinct from 'timesheet-professional-v2'
  or d.status not in('READY','SUPERSEDED') or d.ready_at_utc is null or d.verified_at_utc is null
  or nullif(btrim(d.r2_key),'') is null or coalesce(d.sha256,'')!~'^[0-9a-f]{64}$'
  or d.size_bytes is null or d.size_bytes<=0 or d.page_count is null or d.page_count<=0
  or jsonb_typeof(d.snapshot_json) is distinct from 'object' or octet_length(d.snapshot_json::text)>1048576
  or not(d.snapshot_json ?& snapshot_keys) or d.snapshot_json-snapshot_keys<>'{}'::jsonb
  or d.snapshot_json->>'snapshot_schema_version' is distinct from 'TIMESHEET_PRESENTATION_SNAPSHOT_V5'
  or encode(extensions.digest(convert_to(d.snapshot_json::text,'UTF8'),'sha256'),'hex') is distinct from d.snapshot_hash then
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_LEGACY_ORIGINAL_DOCUMENT_VIEW_V1',
   'available',false,'reason','FROZEN_LEGACY_DOCUMENT_ORIGINAL_UNAVAILABLE','document_view',null,'worker_claim_proved',null);
 end if;
 model:=d.snapshot_json->'presentation_model';
 if jsonb_typeof(model) is distinct from 'object'
  or model->>'schema_version' is distinct from 'TIMESHEET_RENDER_MODEL_V2'
  or model->>'timesheet_id' is distinct from t.timesheet_id::text
  or model->>'sheet_scope' is distinct from 'WEEKLY'
  or model->>'document_revision' is distinct from d.source_revision
  or model#>>'{week_period,start_date}' is distinct from (t.week_ending_date-6)::text
  or model#>>'{week_period,end_date}' is distinct from t.week_ending_date::text
  or encode(extensions.digest(convert_to(model::text,'UTF8'),'sha256'),'hex')
   is distinct from d.snapshot_json->>'presentation_model_hash' then
  raise exception 'AGENCY_LEGACY_ORIGINAL_MODEL_CHANGED' using errcode='55000'; end if;
 days:=model#>'{week_period,days}';
 if jsonb_typeof(days) is distinct from 'array' or jsonb_array_length(days)<>7
  or exists(select 1 from jsonb_array_elements(days) with ordinality day(value,ordinality)
   where jsonb_typeof(value) is distinct from 'object' or value->>'date' is distinct from
    (t.week_ending_date-7+ordinality::integer)::text or jsonb_typeof(value->'shift_lines') is distinct from 'array') then
  raise exception 'AGENCY_LEGACY_ORIGINAL_WEEK_VECTOR_INVALID' using errcode='55000'; end if;
 select count(*),coalesce(jsonb_agg(shift.value order by day.ordinality,shift.ordinality),'[]'::jsonb)
  into count_rows,shifts from jsonb_array_elements(days) with ordinality day(value,ordinality)
  cross join lateral jsonb_array_elements(day.value->'shift_lines') with ordinality shift(value,ordinality);
 if count_rows not between 1 and 100 or octet_length(shifts::text)>65536
  or exists(select 1 from jsonb_array_elements(days) day cross join lateral jsonb_array_elements(day->'shift_lines') shift
   where jsonb_typeof(shift) is distinct from 'object' or shift->>'date' is distinct from day->>'date'
    or nullif(shift->>'row_key','') is null or nullif(shift->>'segment_id','') is null
    or coalesce(shift->>'display_start_local','')!~'^(?:[01][0-9]|2[0-3]):[0-5][0-9]$'
    or coalesce(shift->>'display_end_local','')!~'^(?:[01][0-9]|2[0-3]):[0-5][0-9]$')
  or (select count(distinct value->>'row_key') from jsonb_array_elements(shifts))<>count_rows then
  raise exception 'AGENCY_LEGACY_ORIGINAL_SHIFT_VECTOR_INVALID' using errcode='55000'; end if;
 signing:=(select jsonb_object_agg(key,value) from jsonb_each(to_jsonb(t)) where key=any(signing_keys));
 if p_request_id is null then
  if d.status is distinct from 'READY' or d.superseded_at_utc is not null
   or d.source_revision is distinct from t.document_revision::text then
   raise exception 'AGENCY_LEGACY_ORIGINAL_CURRENT_DOCUMENT_REQUIRED' using errcode='40001'; end if;
  -- Literal actual owner and native arguments. This is not a mapper callback,
  -- schema equality assertion, current T0 fallback or caller-normalised vector.
  select * into strict actual_snapshot from private._invoice_presentation_snapshot_batch(jsonb_build_array(
   jsonb_build_object('request_key',d.snapshot_json->>'request_key','entity_type','TIMESHEET',
    'entity_id',t.timesheet_id,'purpose','TIMESHEET','template_version',d.template_version)),transaction_timestamp());
  if actual_snapshot.valid is distinct from true or actual_snapshot.snapshot_json is distinct from d.snapshot_json
   or actual_snapshot.snapshot_hash is distinct from d.snapshot_hash
   or actual_snapshot.presentation_model is distinct from model then
   raise exception 'AGENCY_LEGACY_ORIGINAL_NATIVE_DOCUMENT_SOURCE_CHANGED' using errcode='40001'; end if;
  receipt:=jsonb_build_object('authority','VERIFIED_LEGACY_FROZEN_TIMESHEET_DOCUMENT','timesheet_id',t.timesheet_id,
   'timesheet_version',t.version,'candidate_id',c.candidate_id,'client_id',c.client_id,'contract_id',c.id,
   'week_ending_date',t.week_ending_date,'document_version_id',d.id,'document_source_revision',d.source_revision,
   'document_template_version',d.template_version,'document_snapshot_sha256',d.snapshot_hash,
   'presentation_model_sha256',d.snapshot_json->'presentation_model_hash','document_sha256',d.sha256,
   'document_size_bytes',d.size_bytes,'document_page_count',d.page_count,'document_r2_key',d.r2_key,
   'ready_at_utc',d.ready_at_utc,'verified_at_utc',d.verified_at_utc,
   'source_evidence_fingerprint',source_fingerprint,'signing_basis',signing,'original_shift_lines',shifts);
 else
  if witness->>'document_source_revision' is distinct from d.source_revision
   or witness->>'document_template_version' is distinct from d.template_version
   or witness->>'document_snapshot_sha256' is distinct from d.snapshot_hash
   or witness->'presentation_model_sha256' is distinct from d.snapshot_json->'presentation_model_hash'
   or witness->>'document_sha256' is distinct from d.sha256
   or witness->>'document_size_bytes' is distinct from d.size_bytes::text
   or witness->>'document_page_count' is distinct from d.page_count::text
   or witness->>'document_r2_key' is distinct from d.r2_key
   or (witness->>'ready_at_utc')::timestamptz is distinct from d.ready_at_utc
   or (witness->>'verified_at_utc')::timestamptz is distinct from d.verified_at_utc
   or (signing-array['authorised_at_server','qr_scanned_at','qr_signed_at_utc']) is distinct from
    ((witness->'signing_basis')-array['authorised_at_server','qr_scanned_at','qr_signed_at_utc'])
   or (witness#>>'{signing_basis,qr_scanned_at}')::timestamptz is distinct from t.qr_scanned_at
   or (witness#>>'{signing_basis,qr_signed_at_utc}')::timestamptz is distinct from t.qr_signed_at_utc
   or (t.authorised_at_server is null and witness#>>'{signing_basis,authorised_at_server}' is not null
    and coalesce(r.native_receipts#>>'{unauthorise,result,ok}'='true',false) is distinct from true)
   or (t.authorised_at_server is not null and t.authorised_at_server is distinct from
    (witness#>>'{signing_basis,authorised_at_server}')::timestamptz) then
   raise exception 'AGENCY_LEGACY_ORIGINAL_CAPTURED_DOCUMENT_CHANGED' using errcode='40001'; end if;
  -- Retain captured timestamp bytes. Actual instants were checked above, so
  -- another session TimeZone cannot manufacture a different original hash.
  receipt:=witness||jsonb_build_object('original_shift_lines',shifts);
  if encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_LEGACY_ORIGINAL_DOCUMENT_VIEW_V1',receipt),'hex')
   is distinct from stored->>'document_view_sha256' then
   raise exception 'AGENCY_LEGACY_ORIGINAL_CAPTURED_VECTOR_CHANGED' using errcode='40001'; end if;
 end if;
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_LEGACY_ORIGINAL_DOCUMENT_VIEW_V1','available',true,
  'reason',null,'document_view',receipt,'document_view_sha256',encode(private.weekly_source_sha256_jsonb_v1(
   'WEEKLY_SOURCE_AGENCY_LEGACY_ORIGINAL_DOCUMENT_VIEW_V1',receipt),'hex'),'worker_claim_proved',null);
exception when no_data_found or too_many_rows or invalid_text_representation
 or invalid_datetime_format or datetime_field_overflow then
 raise exception 'AGENCY_LEGACY_ORIGINAL_DOCUMENT_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_original_pay_identity_v1(
 p_timesheet_id uuid,p_actor_user_id uuid,p_original_financial_id uuid,p_request_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 scope jsonb; t public.timesheets%rowtype; original public.timesheets_financials%rowtype;
 v_work_id uuid; line_ids uuid[]; effect_ids uuid[]; transfer_ids uuid[];
 lines jsonb; effects jsonb; transfers jsonb; reservations jsonb:='[]'::jsonb;
 transfer private.bpay_next_transfer%rowtype; reservation jsonb; result jsonb;
 financial_identity jsonb; signed_identity jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if p_request_id is null then
  scope:=private.weekly_source_agency_physical_pay_inputs_v1(p_timesheet_id,p_actor_user_id);
 else
  scope:=private.weekly_source_agency_native_pay_scope_v1(p_request_id);
  if scope->>'phase_actor_user_id' is distinct from p_actor_user_id::text then
   raise exception 'AGENCY_CHANGE_PAY_PHASE_ACTOR_CHANGED' using errcode='42501'; end if;
 end if;
 if scope->>'timesheet_id' is distinct from p_timesheet_id::text then
  raise exception 'AGENCY_CHANGE_PAY_PHYSICAL_TARGET_CHANGED' using errcode='40001'; end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict original from public.timesheets_financials where id=p_original_financial_id
  and timesheet_id=p_timesheet_id and timesheet_version=t.version
  and candidate_id=(scope->>'candidate_id')::uuid and client_id=(scope->>'client_id')::uuid for update;
 -- These are the exact lifecycle/placement fields changed by unchanged UNA,
 -- REMOVE and current-row retirement. All economic fields and the paid marker
 -- remain in the hash; no authorised/processing label certifies a money amount.
 financial_identity:=to_jsonb(original)-array[
  'is_current','updated_at','processing_status','authorised_by_user_id','authorised_at_utc','locked_by_invoice_id','locked_at_utc'];
 if jsonb_typeof(original.invoice_breakdown_json->'segments')='array' then
  financial_identity:=jsonb_set(financial_identity,'{invoice_breakdown_json,segments}',
   coalesce((select jsonb_agg(segment.value-'invoice_locked_invoice_id' order by segment.ordinality)
    from jsonb_array_elements(original.invoice_breakdown_json->'segments') with ordinality segment(value,ordinality)),'[]'::jsonb),false);
 end if;
 signed_identity:=to_jsonb(t)-array[
  'actual_schedule_json','updated_at','authorised_at_server','revoked_at','revoked_reason','revoked_by'];
 -- Type-directed timestamp instants, from these two literal native relations,
 -- preserve hashes across sessions without changing a GUC or timestamp value.
 select jsonb_object_agg(value.key,case when column_type.atttypid='pg_catalog.timestamptz'::regtype
   and value.value<>'null'::jsonb then to_jsonb(extract(epoch from(value.value#>>'{}')::timestamptz))
   else value.value end) into financial_identity from jsonb_each(financial_identity) value
  join pg_attribute column_type on column_type.attrelid='public.timesheets_financials'::regclass
   and column_type.attname=value.key and column_type.attnum>0 and not column_type.attisdropped;
 select jsonb_object_agg(value.key,case when column_type.atttypid='pg_catalog.timestamptz'::regtype
   and value.value<>'null'::jsonb then to_jsonb(extract(epoch from(value.value#>>'{}')::timestamptz))
   else value.value end) into signed_identity from jsonb_each(signed_identity) value
  join pg_attribute column_type on column_type.attrelid='public.timesheets'::regclass
   and column_type.attname=value.key and column_type.attnum>0 and not column_type.attisdropped;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORIGINAL_PAY_IDENTITY_V1',
  'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'original_financial_id',original.id,
  'original_financial_identity_sha256',encode(private.weekly_source_sha256_jsonb_v1(
   'WEEKLY_SOURCE_AGENCY_ORIGINAL_FINANCIAL_IDENTITY_V1',financial_identity),'hex'),
  'original_paid_marker',original.paid_at_utc,
  'signed_timesheet_identity_sha256',encode(private.weekly_source_sha256_jsonb_v1(
   'WEEKLY_SOURCE_AGENCY_SIGNED_TIMESHEET_IDENTITY_V1',signed_identity),'hex'),
  'active_owner',scope->'active_owner','owner_epoch',scope->'owner_epoch',
  'ordinary_work_id',scope#>'{ordinary_work,work_id}',
  'original_run_line_ids',null,'original_run_lines_sha256',null,
  'original_effect_ids',null,'original_effects_sha256',null,
  'original_transfer_ids',null,'original_transfers_sha256',null,'native_original_reservations',null);
 if scope->>'active_owner'='NEXT' then
  -- Existing native Candidate financial fence owns its real module SHARE /
  -- worker-control UPDATE and active NET refusal. No invented job or lease.
  perform private.bpay_next_assert_candidate_financial_fence_v1(
   (scope->>'candidate_id')::uuid,null::uuid,null::uuid,null::bigint);
  v_work_id:=(scope#>>'{ordinary_work,work_id}')::uuid;
  if v_work_id is null then
   if original.paid_at_utc is not null then
    raise exception 'AGENCY_CHANGE_PAID_ORDINARY_WORK_UNBOUND' using errcode='55000'; end if;
  else
   select coalesce(array_agg(l.id order by l.id),'{}'::uuid[]),
    coalesce(jsonb_agg(to_jsonb(l) order by l.id),'[]'::jsonb) into line_ids,lines
    from private.bpay_next_run_line l where l.work_id=v_work_id;
   select coalesce(array_agg(e.id order by e.id),'{}'::uuid[]),
    coalesce(jsonb_agg((to_jsonb(e)-'occurred_at_utc')||jsonb_build_object(
     'occurred_at_epoch',extract(epoch from e.occurred_at_utc)) order by e.id),'[]'::jsonb) into effect_ids,effects
    from private.bpay_next_financial_effect e where e.work_id=v_work_id;
   select coalesce(array_agg(distinct native.id order by native.id),'{}'::uuid[]) into transfer_ids from(
    select tr.id from private.bpay_next_transfer tr join private.bpay_next_transfer_member member
     on member.transfer_id=tr.id and member.run_line_id=any(line_ids)
     where tr.candidate_id=(scope->>'candidate_id')::uuid and tr.original_transfer_id is null
    union select tr.id from private.bpay_next_transfer tr join private.bpay_next_financial_effect effect
     on effect.original_transfer_id=tr.id and effect.id=any(effect_ids)
     where tr.candidate_id=(scope->>'candidate_id')::uuid and tr.original_transfer_id is null
   ) native;
   if cardinality(line_ids)>100 or cardinality(effect_ids)>100 or cardinality(transfer_ids)>100
    or octet_length(lines::text)>262144 or octet_length(effects::text)>262144 then
    raise exception 'AGENCY_CHANGE_ORIGINAL_PAY_IDENTITY_BOUND_EXCEEDED' using errcode='54000'; end if;
   -- Only immutable Original cash identity. Runtime bank account selection,
   -- posting status and member assembly remain exclusively native authorities.
   select coalesce(jsonb_agg(jsonb_build_object('id',tr.id,'run_worker_id',tr.run_worker_id,
    'candidate_id',tr.candidate_id,'projection_id',tr.projection_id,'transfer_no',tr.transfer_no,
    'currency',tr.currency,'cash_amount',tr.cash_amount,'original_transfer_id',tr.original_transfer_id,
    'return_cash_id',tr.return_cash_id,'created_at_epoch',extract(epoch from tr.created_at_utc)) order by tr.id),'[]'::jsonb)
    into transfers from private.bpay_next_transfer tr where tr.id=any(transfer_ids);
   for transfer in select tr.* from private.bpay_next_transfer tr where tr.id=any(transfer_ids) order by tr.id loop
    select to_jsonb(native) into strict reservation
     from private.bpay_next_original_reservation_v1(transfer.run_worker_id,transfer.id) native;
    reservations:=reservations||jsonb_build_array(jsonb_build_object('transfer_id',transfer.id,
     'run_worker_id',transfer.run_worker_id,'native_reservation',reservation));
   end loop;
   result:=result||jsonb_build_object('original_run_line_ids',to_jsonb(line_ids),
    'original_run_lines_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_ORIGINAL_RUN_LINES_V1',lines),'hex'),
    'original_effect_ids',to_jsonb(effect_ids),
    'original_effects_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_ORIGINAL_EFFECTS_V1',effects),'hex'),
    'original_transfer_ids',to_jsonb(transfer_ids),
    'original_transfers_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_ORIGINAL_TRANSFERS_V1',transfers),'hex'),
    'native_original_reservations',reservations);
  end if;
 end if;
 if octet_length(result::text)>32768 then
  raise exception 'AGENCY_CHANGE_ORIGINAL_PAY_IDENTITY_BOUND_EXCEEDED' using errcode='54000'; end if;
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_ORIGINAL_PAY_IDENTITY_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_paid_write_purpose_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 before_identity jsonb; current_identity jsonb; native_input jsonb; item jsonb;
 t public.timesheets%rowtype; original public.timesheets_financials%rowtype; claim jsonb; document_view jsonb;
 original_id uuid; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,
  r.initial_row_signature,r.request_key,r.updated_by_user_id);
 if r.state<>'ACTIVE' or r.phase not in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT')
  or r.current_timesheet_id is distinct from r.initial_timesheet_id
  or r.current_timesheet_version is distinct from r.initial_timesheet_version then
  raise exception 'AGENCY_CHANGE_PAID_PURPOSE_PHASE_INVALID' using errcode='55000'; end if;
 select * into strict t from public.timesheets where timesheet_id=r.initial_timesheet_id;
 if t.authorised_at_server is not null
  or (r.native_receipts#>>'{unauthorise,schema_version}'='WEEKLY_SOURCE_AGENCY_NATIVE_UNAUTHORISE_V1'
   and (r.native_receipts#>>'{unauthorise,result,ok}' is distinct from 'true'
    or r.native_receipts#>>'{unauthorise,result,timesheet_id}' is distinct from t.timesheet_id::text
    or t.revoked_reason is distinct from 'TIMESHEET_UNAUTHORISE'
    or t.revoked_by is distinct from r.native_receipts#>>'{unauthorise,phase_actor_user_id}'))
  or r.native_receipts#>>'{unauthorise,schema_version}' is null
  or r.native_receipts#>>'{unauthorise,schema_version}' not in(
   'WEEKLY_SOURCE_AGENCY_NATIVE_UNAUTHORISE_V1','WEEKLY_SOURCE_AGENCY_NATIVE_ALREADY_UNAUTHORISED_V1') then
  raise exception 'AGENCY_CHANGE_GENUINE_UNAUTHORISE_RECEIPT_REQUIRED' using errcode='55000'; end if;
 original_id:=(r.native_receipts#>>'{original_capture,current_financial_id}')::uuid;
 before_identity:=r.native_receipts#>'{original_capture,original_before_pay_inputs,original_identity}';
 if before_identity->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_ORIGINAL_PAY_IDENTITY_V1'
  or before_identity->>'original_financial_id' is distinct from original_id::text then
  raise exception 'AGENCY_CHANGE_ORIGINAL_PAY_CAPTURE_REQUIRED' using errcode='55000'; end if;
 current_identity:=private.weekly_source_agency_original_pay_identity_v1(t.timesheet_id,r.updated_by_user_id,original_id,r.id);
 -- Compare the immutable Original cut, not approval state that UNA changes.
 -- A foreign payroll/cash effect or run capture is not silently adopted.
 if current_identity-array['native_original_reservations','original_paid_marker']
    is distinct from before_identity-array['native_reservations_sha256','original_paid_marker']
  or (current_identity->>'original_paid_marker')::timestamptz
    is distinct from (before_identity->>'original_paid_marker')::timestamptz then
  raise exception 'AGENCY_CHANGE_ORIGINAL_PAY_IDENTITY_CHANGED' using errcode='40001'; end if;
 select * into strict original from public.timesheets_financials where id=original_id;
 claim:=private.weekly_source_agency_original_claim_recheck_v1(r.id);
 if r.native_receipts#>>'{original_capture,original_submitted_claim,available}'='true'
  and claim->>'available' is distinct from 'true' then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_CHANGED' using errcode='40001'; end if;
 if r.native_receipts#>>'{original_capture,original_legacy_document,available}'='true' then
  document_view:=private.weekly_source_agency_legacy_original_document_v1(t.timesheet_id,r.id,r.updated_by_user_id);
  if document_view->>'available' is distinct from 'true'
   or document_view->'document_view_sha256'
    is distinct from r.native_receipts#>'{original_capture,original_legacy_document,document_view_sha256}' then
   raise exception 'AGENCY_CHANGE_ORIGINAL_DOCUMENT_CHANGED' using errcode='40001'; end if;
 end if;
 if current_identity->>'active_owner'='NEXT' then
  native_input:=private.weekly_source_agency_ordinary_collection_inputs_v1(r.id);
  if original.paid_at_utc is not null and native_input->'native_component_inputs' is null then
   raise exception 'AGENCY_CHANGE_PAID_ORDINARY_INPUTS_UNBOUND' using errcode='55000'; end if;
  for item in select value from jsonb_array_elements(coalesce(current_identity->'native_original_reservations','[]'::jsonb)) loop
   -- Literal existing native reservation outcomes. No amount/ratio calculation,
   -- and no UNKNOWN, pending posting, inconsistent projection or assumed zero.
   if item#>>'{native_reservation,reservation_state}' is null
    or item#>>'{native_reservation,reservation_state}' not in(
     'POSTED','RETURNED','CLOSED_INTERNAL','RESERVED','INTERNAL_RESERVED','ISSUED_AWAITING_RECEIPT') then
    raise exception 'AGENCY_CHANGE_NATIVE_ORIGINAL_RESERVATION_NOT_ADMISSIBLE' using errcode='55000'; end if;
  end loop;
 end if;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_PAID_WRITE_PURPOSE_V1',
  'request_id',r.id,'request_sha256',encode(r.request_sha256,'hex'),'phase',r.phase,
  'phase_actor_user_id',r.updated_by_user_id,'timesheet_id',t.timesheet_id,'timesheet_version',t.version,
  'original_financial_id',original.id,'original_paid_marker',before_identity->'original_paid_marker',
  'original_identity_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_ORIGINAL_PAY_IDENTITY_CUT_V1',before_identity),'hex'),
  'current_native_inputs_sha256',case when native_input is null then null else encode(private.weekly_source_sha256_jsonb_v1(
   'AGENCY_CURRENT_NATIVE_ORDINARY_INPUTS_V1',native_input),'hex') end,
  'current_native_reservations_sha256',encode(private.weekly_source_sha256_jsonb_v1(
   'AGENCY_CURRENT_NATIVE_ORIGINAL_RESERVATIONS_V1',current_identity->'native_original_reservations'),'hex'),
  'source_cas',r.source_cas,'original_submission_proved',claim->'available',
  'original_submission_sha256',claim->'claim_sha256','original_submission_state',claim->'submission_state',
  'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid());
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_PAID_WRITE_PURPOSE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_ordinary_collection_inputs_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 scope jsonb; v_work private.bpay_next_work%rowtype;
 before_work jsonb; before_worker jsonb; after_worker jsonb;
 v_keys text[]; v_key text; v_position private.bpay_next_position%rowtype;
 v_basis private.bpay_next_work_collection%rowtype; rows jsonb:='[]'::jsonb;
 observation jsonb; reservation jsonb; native_error text; item jsonb; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 scope:=private.weekly_source_agency_native_pay_scope_v1(p_request_id);
 if scope->>'active_owner' is distinct from 'NEXT' then
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORDINARY_COLLECTION_INPUTS_V1',
   'scope',scope,'native_component_inputs',null,'reason','LEGACY_COLLECTION_PROTOCOL_NOT_NEXT',
   'paid_writer_permission',null,'paid_quantity_known',null,'withheld_quantity_known',null);
 end if;
 if jsonb_typeof(scope->'ordinary_work') is distinct from 'object'
  or not pg_input_is_valid(coalesce(scope#>>'{ordinary_work,work_id}',''),'uuid') then
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORDINARY_COLLECTION_INPUTS_V1',
   'scope',scope,'native_component_inputs',null,'reason','NATIVE_ORDINARY_WORK_UNAVAILABLE',
   'paid_writer_permission',null,'paid_quantity_known',null,'withheld_quantity_known',null);
 end if;
 select * into strict v_work from private.bpay_next_work where id=(scope#>>'{ordinary_work,work_id}')::uuid;
 if v_work.work_kind is distinct from 'ORDINARY' or v_work.origin_kind is distinct from 'CONTRACT'
  or v_work.booking_id is distinct from scope#>>'{ordinary_work,booking_id}'
  or v_work.candidate_id::text is distinct from scope->>'candidate_id'
  or v_work.contract_id::text is distinct from scope->>'contract_id'
  or v_work.week_ending_date::text is distinct from scope->>'week_ending_date'
  or v_work.current_revision_id::text is distinct from scope#>>'{ordinary_work,current_revision_id}'
  or v_work.applied_revision_id::text is distinct from scope#>>'{ordinary_work,applied_revision_id}' then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_WORK_SCOPE_CONFLICT' using errcode='40001'; end if;
 before_work:=to_jsonb(v_work);
 select to_jsonb(worker) into before_worker from private.bpay_next_worker_control worker where candidate_id=v_work.candidate_id;
 -- All actual native v_keys, including historical paid/held/collection v_keys.
 -- Caller supplies no v_key, date, subset, source_component_id or after cursor.
 select coalesce(array_agg(component_key order by component_key),'{}'::text[]) into v_keys from (
  select line.component_key from private.bpay_next_approved_line line
   join private.bpay_next_work_revision revision on revision.id=line.revision_id and revision.work_id=v_work.id
   where revision.id=v_work.current_revision_id or revision.id=v_work.applied_revision_id
  union select pos.component_key from private.bpay_next_position pos where pos.work_id=v_work.id
  union select collection.component_key from private.bpay_next_work_collection collection where collection.work_id=v_work.id
 ) native_keys;
 if cardinality(v_keys)>1000 or array_position(v_keys,null::text) is not null
  or exists(select 1 from unnest(v_keys) actual_key where length(actual_key) not between 1 and 256
   or octet_length(actual_key)>1024) then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_COMPONENT_BOUND_EXCEEDED' using errcode='54000'; end if;
 foreach v_key in array v_keys loop
  v_position:=null;v_basis:=null;observation:=null;reservation:=null;native_error:=null;
  select * into v_position from private.bpay_next_position pos where pos.work_id=v_work.id and pos.component_key=v_key;
  select * into v_basis from private.bpay_next_work_collection collection where collection.work_id=v_work.id and collection.component_key=v_key;
  if v_position.work_id is not null and v_position.applied_revision_id is not null then
   begin
    observation:=private.bpay_next_work_collection_observation_v1(v_work.id,v_key,v_position.applied_revision_id);
   exception when no_data_found or too_many_rows then
    get stacked diagnostics native_error=returned_sqlstate;
   end;
  end if;
  if v_basis.id is not null and v_basis.original_transfer_id is not null then
   -- The run worker is derived from the real Original transfer. It is not an
   -- Office selected payer or a stored held_source_ex_vat -> withheld shortcut.
   select to_jsonb(native) into reservation
    from private.bpay_next_transfer transfer
    cross join lateral private.bpay_next_original_reservation_v1(transfer.run_worker_id,transfer.id) native
    where transfer.id=v_basis.original_transfer_id and transfer.candidate_id=v_work.candidate_id;
  end if;
  item:=jsonb_build_object('component_key',v_key,'actual_position',to_jsonb(v_position),
   'actual_collection',to_jsonb(v_basis),'native_collection_observation',observation,
   'native_observation_sqlstate',native_error,'native_original_reservation',reservation);
  rows:=rows||jsonb_build_array(item);
  if octet_length(rows::text)>1048576 then
   raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_COMPONENT_BOUND_EXCEEDED' using errcode='54000'; end if;
 end loop;
 select to_jsonb(worker) into after_worker from private.bpay_next_worker_control worker where candidate_id=v_work.candidate_id;
 if before_work is distinct from (select to_jsonb(current_work) from private.bpay_next_work current_work where id=v_work.id)
  or before_worker is distinct from after_worker
  or not exists(select 1 from private.bpay_next_module_control module where module.id=1
   and module.active_owner='NEXT' and module.owner_epoch::text=scope->>'owner_epoch') then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_INPUTS_CHANGED' using errcode='40001'; end if;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORDINARY_COLLECTION_INPUTS_V1',
  'scope',scope,'native_component_inputs',rows,'native_worker_control',before_worker,
  'reason',null,'paid_writer_permission',null,'paid_quantity_known',null,'withheld_quantity_known',null);
 if octet_length(result::text)>1310720 then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_COMPONENT_BOUND_EXCEEDED' using errcode='54000'; end if;
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_INPUTS_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_before_collection_inputs_v1(p_timesheet_id uuid,p_actual_actor_user_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 scope jsonb; v_work private.bpay_next_work%rowtype;
 before_work jsonb; before_worker jsonb; after_worker jsonb;
 v_keys text[]; v_key text; v_position private.bpay_next_position%rowtype;
 v_basis private.bpay_next_work_collection%rowtype; rows jsonb:='[]'::jsonb;
 observation jsonb; reservation jsonb; native_error text; item jsonb; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 scope:=private.weekly_source_agency_physical_pay_inputs_v1(p_timesheet_id,p_actual_actor_user_id);
 if scope->>'active_owner' is distinct from 'NEXT' then
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORDINARY_COLLECTION_INPUTS_V1',
   'scope',scope,'native_component_inputs',null,'reason','LEGACY_COLLECTION_PROTOCOL_NOT_NEXT',
   'paid_writer_permission',null,'paid_quantity_known',null,'withheld_quantity_known',null);
 end if;
 if jsonb_typeof(scope->'ordinary_work') is distinct from 'object'
  or not pg_input_is_valid(coalesce(scope#>>'{ordinary_work,work_id}',''),'uuid') then
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORDINARY_COLLECTION_INPUTS_V1',
   'scope',scope,'native_component_inputs',null,'reason','NATIVE_ORDINARY_WORK_UNAVAILABLE',
   'paid_writer_permission',null,'paid_quantity_known',null,'withheld_quantity_known',null);
 end if;
 select * into strict v_work from private.bpay_next_work where id=(scope#>>'{ordinary_work,work_id}')::uuid;
 if v_work.work_kind is distinct from 'ORDINARY' or v_work.origin_kind is distinct from 'CONTRACT'
  or v_work.booking_id is distinct from scope#>>'{ordinary_work,booking_id}'
  or v_work.candidate_id::text is distinct from scope->>'candidate_id'
  or v_work.contract_id::text is distinct from scope->>'contract_id'
  or v_work.week_ending_date::text is distinct from scope->>'week_ending_date'
  or v_work.current_revision_id::text is distinct from scope#>>'{ordinary_work,current_revision_id}'
  or v_work.applied_revision_id::text is distinct from scope#>>'{ordinary_work,applied_revision_id}' then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_WORK_SCOPE_CONFLICT' using errcode='40001'; end if;
 before_work:=to_jsonb(v_work);
 select to_jsonb(worker) into before_worker from private.bpay_next_worker_control worker where candidate_id=v_work.candidate_id;
 -- All actual native v_keys, including historical paid/held/collection v_keys.
 -- Caller supplies no v_key, date, subset, source_component_id or after cursor.
 select coalesce(array_agg(component_key order by component_key),'{}'::text[]) into v_keys from (
  select line.component_key from private.bpay_next_approved_line line
   join private.bpay_next_work_revision revision on revision.id=line.revision_id and revision.work_id=v_work.id
   where revision.id=v_work.current_revision_id or revision.id=v_work.applied_revision_id
  union select pos.component_key from private.bpay_next_position pos where pos.work_id=v_work.id
  union select collection.component_key from private.bpay_next_work_collection collection where collection.work_id=v_work.id
 ) native_keys;
 if cardinality(v_keys)>1000 or array_position(v_keys,null::text) is not null
  or exists(select 1 from unnest(v_keys) actual_key where length(actual_key) not between 1 and 256
   or octet_length(actual_key)>1024) then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_COMPONENT_BOUND_EXCEEDED' using errcode='54000'; end if;
 foreach v_key in array v_keys loop
  v_position:=null;v_basis:=null;observation:=null;reservation:=null;native_error:=null;
  select * into v_position from private.bpay_next_position pos where pos.work_id=v_work.id and pos.component_key=v_key;
  select * into v_basis from private.bpay_next_work_collection collection where collection.work_id=v_work.id and collection.component_key=v_key;
  if v_position.work_id is not null and v_position.applied_revision_id is not null then
   begin
    observation:=private.bpay_next_work_collection_observation_v1(v_work.id,v_key,v_position.applied_revision_id);
   exception when no_data_found or too_many_rows then
    get stacked diagnostics native_error=returned_sqlstate;
   end;
  end if;
  if v_basis.id is not null and v_basis.original_transfer_id is not null then
   -- The run worker is derived from the real Original transfer. It is not an
   -- Office selected payer or a stored held_source_ex_vat -> withheld shortcut.
   select to_jsonb(native) into reservation
    from private.bpay_next_transfer transfer
    cross join lateral private.bpay_next_original_reservation_v1(transfer.run_worker_id,transfer.id) native
    where transfer.id=v_basis.original_transfer_id and transfer.candidate_id=v_work.candidate_id;
  end if;
  item:=jsonb_build_object('component_key',v_key,'actual_position',to_jsonb(v_position),
   'actual_collection',to_jsonb(v_basis),'native_collection_observation',observation,
   'native_observation_sqlstate',native_error,'native_original_reservation',reservation);
  rows:=rows||jsonb_build_array(item);
  if octet_length(rows::text)>1048576 then
   raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_COMPONENT_BOUND_EXCEEDED' using errcode='54000'; end if;
 end loop;
 select to_jsonb(worker) into after_worker from private.bpay_next_worker_control worker where candidate_id=v_work.candidate_id;
 if before_work is distinct from (select to_jsonb(current_work) from private.bpay_next_work current_work where id=v_work.id)
  or before_worker is distinct from after_worker
  or not exists(select 1 from private.bpay_next_module_control module where module.id=1
   and module.active_owner='NEXT' and module.owner_epoch::text=scope->>'owner_epoch') then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_INPUTS_CHANGED' using errcode='40001'; end if;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORDINARY_COLLECTION_INPUTS_V1',
  'scope',scope,'native_component_inputs',rows,'native_worker_control',before_worker,
  'reason',null,'paid_writer_permission',null,'paid_quantity_known',null,'withheld_quantity_known',null);
 if octet_length(result::text)>1310720 then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_COMPONENT_BOUND_EXCEEDED' using errcode='54000'; end if;
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_INPUTS_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_candidate_admit_v1(
 p_timesheet_id uuid,p_actual_actor_user_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare t public.timesheets%rowtype;c public.contracts%rowtype;gate jsonb;module_owner text;
 owned private.weekly_source_agency_timesheet_change_requests%rowtype;
begin
 perform private.weekly_source_query_require_service_v1();
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001'; end if;
 if private.weekly_source_pay_actor_allowed_v1(p_actual_actor_user_id) is distinct from true then
  raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict c from public.contracts where id=t.contract_id;
 if t.is_current is distinct from true or t.archived_at_utc is not null
  or t.sheet_scope::text is distinct from 'WEEKLY' or t.line_type::text is distinct from 'HOURS'
  or c.candidate_id is null or c.client_id is null then
  raise exception 'AGENCY_CHANGE_CANDIDATE_NATIVE_SCOPE_INVALID' using errcode='55000'; end if;
 if private.weekly_source_agency_invoice_check_only_v1(t.timesheet_id) is distinct from true then
  -- The ordinary check-only reader deliberately rejects every revoked root.
  -- The single change owner may be between its genuine UNA and AUTH only;
  -- original source/rule/input/scope and phase CAS are asserted by its caller.
  select * into strict owned from private.weekly_source_agency_timesheet_change_requests
   where current_timesheet_id=t.timesheet_id and state='ACTIVE';
  if owned.current_timesheet_id is distinct from owned.initial_timesheet_id
   or owned.current_timesheet_version is distinct from t.version
   or owned.contract_id is distinct from c.id or owned.candidate_id is distinct from c.candidate_id
   or owned.client_id is distinct from c.client_id
   or owned.phase not in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT')
   or t.revoked_at is null or t.revoked_reason is distinct from 'TIMESHEET_UNAUTHORISE'
   or t.revoked_by is distinct from owned.native_receipts#>>'{unauthorise,phase_actor_user_id}'
   or owned.native_receipts#>>'{unauthorise,result,ok}' is distinct from 'true'
   or owned.native_receipts#>>'{unauthorise,result,timesheet_id}' is distinct from t.timesheet_id::text then
   raise exception 'AGENCY_CHANGE_CANDIDATE_NATIVE_SCOPE_INVALID' using errcode='55000'; end if;
 end if;
 gate:=private.weekly_source_candidate_serial_gate_v1(c.candidate_id,
  'WORKBENCH_CANDIDATE_FIRST_AUTHORISATION',t.timesheet_id,'AGENCY_CHANGE_OFFICE_AUTHORISE_ADMISSION');
 if gate->>'ok' is distinct from 'true' or gate->>'gate' is distinct from 'GRANTED'
  or gate->>'candidate_id' is distinct from c.candidate_id::text then
  raise exception 'AGENCY_CHANGE_CANDIDATE_NATIVE_ADMISSION_BUSY' using errcode='55P03'; end if;
 select active_owner into strict module_owner from private.bpay_next_module_control where id=1;
 if module_owner='NEXT' then
  perform private.bpay_next_assert_candidate_financial_fence_v1(c.candidate_id,null::uuid,null::uuid,null::bigint);
 elsif module_owner is distinct from 'LEGACY' then
  raise exception 'AGENCY_CHANGE_NATIVE_PAY_MODULE_UNAVAILABLE' using errcode='55000'; end if;
 return gate;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_CANDIDATE_NATIVE_SCOPE_INVALID' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_physical_pay_inputs_v1(
 p_timesheet_id uuid,p_actual_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
 c public.contracts%rowtype; cw public.contract_weeks%rowtype;
 group_id uuid; cycle_id uuid; cycle_ids uuid[]; member_ids uuid[]; n bigint;
 native_work private.bpay_next_work%rowtype; native_revision private.bpay_next_work_revision%rowtype;
 work_value jsonb; revision_value jsonb; legacy jsonb; module_owner text; module_epoch bigint;
 result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if p_timesheet_id is null or private.weekly_source_pay_actor_allowed_v1(p_actual_actor_user_id) is distinct from true then
  raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict c from public.contracts where id=t.contract_id;
 select count(*) into n from public.contract_weeks week where week.contract_id=c.id
  and week.week_ending_date=t.week_ending_date and coalesce(week.additional_seq,0)=0
  and coalesce(week.is_adjustment,false)=false and week.timesheet_id=t.timesheet_id;
 if n<>1 or t.is_current is distinct from true or t.revoked_at is not null or t.archived_at_utc is not null
  or t.sheet_scope::text is distinct from 'WEEKLY' or t.line_type::text is distinct from 'HOURS'
  or private.weekly_source_agency_invoice_check_only_v1(t.timesheet_id) is distinct from true then
  raise exception 'AGENCY_CHANGE_NATIVE_MAIN_PAY_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
 select * into strict cw from public.contract_weeks week where week.contract_id=c.id
  and week.week_ending_date=t.week_ending_date and coalesce(week.additional_seq,0)=0
  and coalesce(week.is_adjustment,false)=false and week.timesheet_id=t.timesheet_id;
 select array_agg(cycle.id order by cycle.id) into cycle_ids from public.weekly_source_groups g
  join public.weekly_source_group_clients member on member.source_group_id=g.id and member.client_id=c.client_id
   and t.week_ending_date between member.valid_from and coalesce(member.valid_to,'infinity'::date)
  join public.weekly_source_cycles cycle on cycle.source_group_id=g.id and cycle.finalisation_week_ending=t.week_ending_date
  where g.active and g.environment='TEST' and g.source_family='ROSTER'
   and (cycle.scope_client_id is null or cycle.scope_client_id=c.client_id);
 if cardinality(cycle_ids)>1 then
  select array_agg(cycle.id order by cycle.id) into cycle_ids from public.weekly_source_cycles cycle
   where cycle.id=any(cycle_ids) and cycle.scope_client_id=c.client_id; end if;
 if coalesce(cardinality(cycle_ids),0)<>1 then
  raise exception 'AGENCY_CHANGE_SOURCE_CYCLE_AMBIGUOUS' using errcode='55000'; end if;
 select cycle.source_group_id,cycle.id into strict group_id,cycle_id
  from public.weekly_source_cycles cycle where cycle.id=cycle_ids[1];
 perform private.weekly_source_office_authority_v1(p_actual_actor_user_id,'VIEW_PAY_WORK',group_id,c.client_id,t.week_ending_date);
 select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
 select array_agg(distinct family.family_timesheet_id order by family.family_timesheet_id) into member_ids
  from public._pay_timesheet_rotation_scope(array[t.timesheet_id]) family;
 if member_ids is null or cardinality(member_ids) not between 1 and 256 or not t.timesheet_id=any(member_ids)
  or f.timesheet_version is distinct from t.version or f.candidate_id is distinct from c.candidate_id
  or f.client_id is distinct from c.client_id then
  raise exception 'AGENCY_CHANGE_NATIVE_PAY_FAMILY_SCOPE_CHANGED' using errcode='40001'; end if;
 select module.active_owner,module.owner_epoch into strict module_owner,module_epoch from private.bpay_next_module_control module where module.id=1;
 if module_owner is null or module_owner not in('LEGACY','NEXT') or module_epoch is null or module_epoch<0
  or(module_owner='NEXT' and module_epoch=0) then
  raise exception 'AGENCY_CHANGE_NATIVE_PAY_MODULE_UNAVAILABLE' using errcode='55000'; end if;
 if module_owner='LEGACY' then
  legacy:=private.weekly_source_settlement_allocation_v1(t.timesheet_id);
 else
  select * into native_work from private.bpay_next_work work where work.booking_id=t.booking_id;
  if found then
   if native_work.work_kind is distinct from 'ORDINARY' or native_work.origin_kind is distinct from 'CONTRACT'
    or native_work.candidate_id is distinct from c.candidate_id or native_work.contract_id is distinct from c.id
    or native_work.week_ending_date is distinct from t.week_ending_date
    or native_work.original_timesheet_id is null or not native_work.original_timesheet_id=any(member_ids) then
    raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_WORK_SCOPE_CONFLICT' using errcode='55000'; end if;
   work_value:=jsonb_build_object('work_id',native_work.id,'work_kind',native_work.work_kind,'origin_kind',native_work.origin_kind,
    'original_timesheet_id',native_work.original_timesheet_id,'booking_id',native_work.booking_id,
    'candidate_id',native_work.candidate_id,'contract_id',native_work.contract_id,'week_ending_date',native_work.week_ending_date,
    'current_revision_id',native_work.current_revision_id,'applied_revision_id',native_work.applied_revision_id,
    'current_revision_no',native_work.current_revision_no);
   if coalesce(native_work.current_revision_id,native_work.applied_revision_id) is not null then
    select * into strict native_revision from private.bpay_next_work_revision revision
     where revision.id=coalesce(native_work.current_revision_id,native_work.applied_revision_id) and revision.work_id=native_work.id;
    if native_revision.source_kind is distinct from 'ORDINARY' or native_revision.physical_timesheet_id is null
     or not native_revision.physical_timesheet_id=any(member_ids) or native_revision.week_ending_date is distinct from t.week_ending_date then
     raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_REVISION_SCOPE_CONFLICT' using errcode='55000'; end if;
    revision_value:=jsonb_build_object('revision_id',native_revision.id,'work_id',native_revision.work_id,
     'source_kind',native_revision.source_kind,'revision_no',native_revision.revision_no,
     'physical_timesheet_id',native_revision.physical_timesheet_id,'physical_timesheet_version',native_revision.physical_timesheet_version,
     'financial_snapshot_id',native_revision.financial_snapshot_id,'detail_kind',native_revision.detail_kind,
     'source_pay_channel',native_revision.source_pay_channel,'expected_line_count',native_revision.expected_line_count,
     'certified_zero',native_revision.certified_zero,'approved_source_ex_vat',native_revision.approved_source_ex_vat,
     'sealed_at_utc',native_revision.sealed_at_utc);
   end if;
  end if;
 end if;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_PHYSICAL_PAY_INPUTS_V1',
  'actual_actor_user_id',p_actual_actor_user_id,'timesheet_id',t.timesheet_id,'timesheet_version',t.version,
  'contract_week_id',cw.id,'contract_id',c.id,'candidate_id',c.candidate_id,'client_id',c.client_id,
  'week_ending_date',t.week_ending_date,'source_group_id',group_id,'source_cycle_id',cycle_id,
  'family_member_ids',to_jsonb(member_ids),'active_owner',module_owner,'owner_epoch',module_epoch,
  'current_financial_id',f.id,'current_financial_paid_marker',f.paid_at_utc,
  'ordinary_work',work_value,'ordinary_revision',revision_value,'legacy_family_hours',legacy);
 if octet_length(result::text)>262144 then raise exception 'AGENCY_CHANGE_NATIVE_PAY_SCOPE_BOUND_EXCEEDED' using errcode='54000'; end if;
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_PAY_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_segment_flags_apply_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 before_fin public.timesheets_financials%rowtype; after_fin public.timesheets_financials%rowtype;
 plan jsonb; native_result jsonb; old_segment jsonb; new_segment jsonb; flag jsonb; count_value integer;
begin
 plan:=private.weekly_source_agency_segment_flags_v1(p_request_id);
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 select * into strict before_fin from public.timesheets_financials where id=r.current_financial_id and is_current;
 native_result:=public.tsfin_update_segments_locked(r.current_timesheet_id,plan->'flags',r.updated_by_user_id);
 select * into strict after_fin from public.timesheets_financials where id=before_fin.id and is_current;
 if native_result#>>'{updated,id}' is distinct from after_fin.id::text
  or to_jsonb(after_fin)-array['invoice_breakdown_json','total_pay_ex_vat','total_charge_ex_vat','margin_ex_vat','updated_at']
    is distinct from to_jsonb(before_fin)-array['invoice_breakdown_json','total_pay_ex_vat','total_charge_ex_vat','margin_ex_vat','updated_at']
  or jsonb_typeof(after_fin.invoice_breakdown_json->'segments') is distinct from 'array'
  or jsonb_array_length(after_fin.invoice_breakdown_json->'segments')<>jsonb_array_length(plan->'flags') then
  raise exception 'AGENCY_CHANGE_NATIVE_SEGMENT_FLAG_WRITE_UNPROVED' using errcode='55000';end if;
 for old_segment in select value from jsonb_array_elements(before_fin.invoice_breakdown_json->'segments') loop
  select count(*) into count_value from jsonb_array_elements(after_fin.invoice_breakdown_json->'segments') s
    where s->>'segment_id'=old_segment->>'segment_id';
  if count_value<>1 then raise exception 'AGENCY_CHANGE_NATIVE_SEGMENT_FLAG_WRITE_UNPROVED' using errcode='55000';end if;
  select value into strict new_segment from jsonb_array_elements(after_fin.invoice_breakdown_json->'segments') s(value)
    where value->>'segment_id'=old_segment->>'segment_id';
  select value into strict flag from jsonb_array_elements(plan->'flags') s(value) where value->>'segment_id'=old_segment->>'segment_id';
  if new_segment-'exclude_from_pay' is distinct from old_segment-'exclude_from_pay'
   or new_segment->'exclude_from_pay' is distinct from flag->'exclude_from_pay' then
   raise exception 'AGENCY_CHANGE_NATIVE_SEGMENT_FLAG_WRITE_UNPROVED' using errcode='55000';end if;
 end loop;
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_SEGMENT_FLAG_WRITE_V1',
  'request_id',r.id,'request_sha256',encode(r.request_sha256,'hex'),'phase_actor_user_id',r.updated_by_user_id,
  'timesheet_id',r.current_timesheet_id,'timesheet_version',r.current_timesheet_version,'financial_id',after_fin.id,
  'flags',plan->'flags','basis_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_SEGMENT_FLAG_BASIS_V1',plan->'basis'),'hex'),
  'native_result_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_SEGMENT_FLAG_WRITE_RESULT_V1',native_result),'hex'),
  'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid());
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_SEGMENT_FLAG_WRITE_UNPROVED' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_native_query_facts_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; c public.contracts%rowtype; family public.weekly_exceptional_pay_target_families%rowtype;
 identity jsonb; frame jsonb; native_scope jsonb; actual_scope jsonb; count_value integer;
begin
 perform private.weekly_source_query_require_service_v1();
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001';end if;
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 if r.state<>'ACTIVE' or r.phase not in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT','AUTHORISED')
  or private.weekly_source_agency_change_request_sha256_v1(r.contract_week_id,r.reason,r.initial_row_signature,
   r.request_key,r.actor_user_id,r.native_receipts->'original_capture') is distinct from r.request_sha256 then
  raise exception 'AGENCY_CHANGE_ORIGINAL_REQUEST_DIGEST_INVALID' using errcode='55000';end if;
 if private.weekly_source_pay_actor_allowed_v1(r.updated_by_user_id) is distinct from true then
  raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501';end if;
 perform private.weekly_source_office_authority_v1(r.updated_by_user_id,'VIEW_PAY_WORK',r.source_group_id,r.client_id,r.week_ending_date);
 if private.weekly_source_bulk_source_cas_v1(r.source_cycle_id,array[r.client_id]) is distinct from r.source_cas
  or private.weekly_source_effective_rule_set_v1(r.client_id,r.source_cycle_id)->>'rule_set_version_id'
    is distinct from r.rule_set_version_id::text then
  raise exception 'AGENCY_CHANGE_ORIGINAL_SOURCE_CAS_CHANGED' using errcode='40001';end if;
 select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
 select * into strict c from public.contracts where id=t.contract_id;
 identity:=private.weekly_source_resolve_root_identity_v1(t.timesheet_id);
 if identity->>'ok' is distinct from 'true' or identity->>'requested_is_canonical' is distinct from 'true'
  or identity->>'family_is_current' is distinct from 'true' or identity->>'canonical_timesheet_id' is distinct from t.timesheet_id::text
  or identity->>'family_booking_id' is distinct from t.booking_id
  or t.timesheet_id is distinct from r.initial_timesheet_id or t.version is distinct from r.current_timesheet_version
  or t.is_current is distinct from true or t.archived_at_utc is not null or t.sheet_scope::text is distinct from 'WEEKLY'
  or t.line_type::text is distinct from 'HOURS' or t.is_adjustment is distinct from false
  or c.id is distinct from r.contract_id or c.candidate_id is distinct from r.candidate_id or c.client_id is distinct from r.client_id
  or t.week_ending_date is distinct from r.week_ending_date then
  raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
 select count(*) into count_value from public.contract_weeks where contract_id=c.id and week_ending_date=t.week_ending_date
  and additional_seq=0 and is_adjustment is false and timesheet_id=t.timesheet_id;
 if count_value<>1 then raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
 if r.phase in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING') then
  frame:=r.native_receipts->'financial_write_frame';
  if frame->>'transaction_id' is distinct from pg_current_xact_id()::text or frame->>'backend_pid' is distinct from pg_backend_pid()::text
   or frame->>'request_id' is distinct from r.id::text or frame->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
   or frame->>'phase_actor_user_id' is distinct from r.updated_by_user_id::text
   or frame->>'timesheet_id' is distinct from t.timesheet_id::text or frame->>'timesheet_version' is distinct from t.version::text
   or frame->'source_cas' is distinct from r.source_cas then
   raise exception 'AGENCY_CHANGE_GENUINE_FINANCIAL_FRAME_REQUIRED' using errcode='55000';end if;
 else
  r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,r.initial_row_signature,r.request_key,r.updated_by_user_id);
 end if;
 if t.revoked_at is not null and (r.phase='AUTHORISED' or t.revoked_reason is distinct from 'TIMESHEET_UNAUTHORISE'
   or t.revoked_by is distinct from r.native_receipts#>>'{unauthorise,phase_actor_user_id}'
   or r.native_receipts#>>'{unauthorise,result,ok}' is distinct from 'true'
   or r.native_receipts#>>'{unauthorise,result,timesheet_id}' is distinct from t.timesheet_id::text) then
  raise exception 'AGENCY_CHANGE_GENUINE_UNAUTHORISE_RECEIPT_REQUIRED' using errcode='55000';end if;
 select count(*) into count_value from public.weekly_exceptional_pay_target_families where btrim(root_family_booking_id)=btrim(t.booking_id);
 if count_value>1 then raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
 if count_value=1 then
  select * into strict family from public.weekly_exceptional_pay_target_families where btrim(root_family_booking_id)=btrim(t.booking_id);
  if family.root_timesheet_id is distinct from t.timesheet_id or family.root_family_booking_id is distinct from t.booking_id
   or family.candidate_id is distinct from c.candidate_id or family.contract_id is distinct from c.id
   or family.week_start_date is distinct from t.week_ending_date-6 or family.week_ending_date is distinct from t.week_ending_date
   or family.bound_version is null or family.bound_version<1 then
   raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
 end if;
 native_scope:=jsonb_build_object('root_timesheet_id',t.timesheet_id,'family_booking_id',t.booking_id,'target_family_id',family.id,
  'candidate_id',c.candidate_id,'client_id',c.client_id,'contract_id',c.id,'week_ending_date',t.week_ending_date,
  'root_version',t.version::text,'family_bound_version',family.bound_version::text);
 if t.revoked_at is null then
  -- Where the original native scope is applicable it must be byte-identical.
  -- Its real integrity/refusal errors propagate and are never swallowed.
  actual_scope:=private.weekly_source_pay_query_scope_v1(t.timesheet_id);
  if actual_scope is not null and actual_scope is distinct from native_scope then
   raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
 end if;
 return private.weekly_source_native_query_facts_for_scope_v1(native_scope);
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_invoice_segment_selection_v1(
 p_timesheet_id uuid,p_financial_id uuid,p_invoice_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare fin public.timesheets_financials%rowtype; invoice public.invoices%rowtype;
 ts public.timesheets%rowtype; pc record; segment jsonb; selected jsonb:='[]'::jsonb;
 natural_start date; invoice_week date; target_week date; reference text;
begin
 select * into strict invoice from public.invoices where id=p_invoice_id;
 select * into strict ts from public.timesheets where timesheet_id=p_timesheet_id and is_current;
 select * into strict fin from public.timesheets_financials where id=p_financial_id and timesheet_id=ts.timesheet_id
  and is_current and timesheet_version=ts.version and client_id=invoice.client_id;
 if invoice.type is distinct from 'INVOICE' or invoice.status not in('DRAFT','ON_HOLD')
  or invoice.issued_at_utc is not null or invoice.paid_at_utc is not null
  or private.weekly_source_agency_invoice_check_only_v1(ts.timesheet_id) is distinct from true
  or fin.processing_status::text is distinct from 'READY_FOR_INVOICE' or fin.is_stale is distinct from false
  or fin.invoice_breakdown_json->>'mode' is distinct from 'SEGMENTS'
  or jsonb_typeof(fin.invoice_breakdown_json->'segments') is distinct from 'array'
  or jsonb_array_length(fin.invoice_breakdown_json->'segments')>100 then
  raise exception 'AGENCY_DRAFT_NATIVE_SELECTION_UNAVAILABLE' using errcode='55000';end if;
 invoice_week:=(invoice.header_snapshot_json#>>'{meta,invoice_week_start}')::date;
 natural_start:=ts.week_ending_date-6;
 if invoice_week is null then raise exception 'AGENCY_DRAFT_NATIVE_SELECTION_UNAVAILABLE' using errcode='55000';end if;
 select * into strict pc from public.v_ts_invoice_precheck where timesheet_id=ts.timesheet_id;
 for segment in select value from jsonb_array_elements(fin.invoice_breakdown_json->'segments') loop
  if jsonb_typeof(segment) is distinct from 'object' or nullif(btrim(segment->>'segment_id'),'') is null then
   raise exception 'AGENCY_DRAFT_NATIVE_COMPONENT_UNBOUND' using errcode='55000';end if;
  if nullif(btrim(coalesce(segment->>'invoice_locked_invoice_id','')),'') is not null then continue;end if;
  target_week:=nullif(btrim(coalesce(segment->>'invoice_target_week_start','')),'')::date;
  reference:=btrim(coalesce(segment->>'ref_num',''));
  if pc.require_reference_to_invoice is true and reference='' then continue;end if;
  if target_week is null or target_week=natural_start then
   if invoice_week<>natural_start then continue;end if;
   selected:=selected||jsonb_build_array(segment);
  elsif invoice_week=target_week and target_week<=(now() at time zone 'Europe/London')::date then
   selected:=selected||jsonb_build_array(segment);
  end if;
 end loop;
 if selected is distinct from fin.invoice_breakdown_json->'segments'
  or (select count(distinct s->>'segment_id') from jsonb_array_elements(selected) s)<>jsonb_array_length(selected) then
  raise exception 'AGENCY_DRAFT_ROUND_TRIP_NATIVE_COMPONENT_SUBSET_REFUSED' using errcode='55000';end if;
 return jsonb_build_object('schema_version','INVOICE_EDIT_NATIVE_SEGMENT_SELECTION_WITNESS_V1',
  'timesheet_id',ts.timesheet_id,'financial_id',fin.id,'invoice_id',invoice.id,
  'invoice_week_start',invoice_week,'segments',selected);
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'AGENCY_DRAFT_NATIVE_SELECTION_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_draft_round_trip_v1(
  p_request_key text,p_step text,p_actor_user_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  v_request private.weekly_source_agency_timesheet_change_requests%rowtype;
  v_invoice public.invoices%rowtype; v_fin public.timesheets_financials%rowtype;
  v_step text:=upper(btrim(p_step)); v_ids jsonb; v_result jsonb; v_plan jsonb;
  v_unrelated bytea; v_actual jsonb; v_signature jsonb;
  v_after_fin public.timesheets_financials%rowtype; v_line_ids jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if v_step is null or v_step not in('REMOVE','RETURN') then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_STEP_INVALID' using errcode='22023'; end if;
  select * into strict v_request from private.weekly_source_agency_timesheet_change_requests where request_key=p_request_key;
  v_request:=private.weekly_source_agency_change_request_assert_v1(v_request.contract_week_id,v_request.reason,
    v_request.initial_row_signature,v_request.request_key,p_actor_user_id);
  if v_request.state is distinct from 'ACTIVE'
    or(v_step='REMOVE' and v_request.phase is distinct from 'CAPTURED')
    or(v_step='RETURN' and v_request.phase is distinct from 'AUTHORISED') then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_PHASE_INVALID' using errcode='55000'; end if;
  if v_request.original_draft_invoice_id is null then
    if exists(select 1 from public.invoice_lines l where l.timesheet_id in(v_request.initial_timesheet_id,v_request.current_timesheet_id)) then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_FOREIGN_PLACEMENT' using errcode='55000'; end if;
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_DRAFT_ROUND_TRIP_RECEIPT_V1',
      'ok',true,'request_id',v_request.id,'step',v_step,'phase_actor_user_id',p_actor_user_id,'not_required',true,
      'original_draft_invoice_id',null,'original_draft_invoice_no',null); end if;
  select * into strict v_invoice from public.invoices where id=v_request.original_draft_invoice_id for update;
  if v_invoice.type is distinct from 'INVOICE' or v_invoice.status not in('DRAFT','ON_HOLD')
    or v_invoice.issued_at_utc is not null or v_invoice.paid_at_utc is not null
    or v_invoice.client_id is distinct from v_request.client_id
    or v_invoice.invoice_no is distinct from v_request.original_draft_invoice_no then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_ORIGINAL_D1_CHANGED' using errcode='40001'; end if;
  if jsonb_array_length(private.timesheet_correction_draft_holds_v1(v_invoice.id))>0
    or exists(select 1 from private.weekly_source_agency_timesheet_change_requests other_request
      where other_request.id<>v_request.id and other_request.return_hold and other_request.original_draft_invoice_id=v_invoice.id) then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_OTHER_RETURN_HOLD' using errcode='55000'; end if;
  if exists(select 1 from public.invoice_lines l where l.timesheet_id in(v_request.initial_timesheet_id,v_request.current_timesheet_id)
    and l.invoice_id<>v_invoice.id) then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_FOREIGN_PLACEMENT' using errcode='55000'; end if;
  select * into strict v_fin from public.timesheets_financials
    where timesheet_id=v_request.current_timesheet_id and is_current for update;
  v_unrelated:=private.weekly_source_sha256_jsonb_v1('AGENCY_DRAFT_UNRELATED_NATIVE_LINES_V1',
    coalesce((select jsonb_agg(to_jsonb(l) order by l.id) from public.invoice_lines l where l.invoice_id=v_invoice.id
      and l.timesheet_id is distinct from v_request.initial_timesheet_id
      and l.timesheet_id is distinct from v_request.current_timesheet_id),'[]'::jsonb));
  if v_step='REMOVE' then
    if v_request.return_hold or v_request.current_timesheet_id is distinct from v_request.initial_timesheet_id
      or v_fin.id::text is distinct from v_request.native_receipts#>>'{original_capture,current_financial_id}' then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_ORIGINAL_FINANCIAL_CUT_CHANGED' using errcode='40001'; end if;
    select coalesce(jsonb_agg(l.id order by l.id),'[]'::jsonb) into v_ids
      from public.invoice_lines l where l.invoice_id=v_invoice.id and l.timesheet_id=v_request.current_timesheet_id;
    if jsonb_array_length(v_ids)=0 or jsonb_array_length(v_ids)>100 then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_ORIGINAL_PLACEMENT_UNPROVED' using errcode='55000'; end if;
    v_result:=public.invoice_apply_edits(v_invoice.id,jsonb_build_object('remove_invoice_line_ids',v_ids),p_actor_user_id);
    if exists(select 1 from public.invoice_lines l where l.timesheet_id=v_request.current_timesheet_id)
      or exists(select 1 from public.timesheets_financials tf where tf.timesheet_id=v_request.current_timesheet_id
        and tf.is_current and tf.locked_by_invoice_id is not null) then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_REMOVE_NOT_PROVED' using errcode='55000'; end if;
  else
    if v_request.return_hold is distinct from true or v_fin.id is distinct from v_request.current_financial_id
      or v_fin.timesheet_version is distinct from v_request.current_timesheet_version
      or v_fin.is_stale is distinct from false or v_fin.authorised_at_utc is null
      or v_fin.processing_status::text is distinct from 'READY_FOR_INVOICE'
      or v_fin.locked_by_invoice_id is not null then
      raise exception 'AGENCY_INVOICE_TSFIN_NOT_READY' using errcode='55000'; end if;
    if exists(select 1 from public.invoice_lines l where l.timesheet_id=v_request.current_timesheet_id) then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_RETURN_PLACEMENT_CHANGED' using errcode='40001'; end if;
    v_plan:=private.weekly_source_agency_invoice_segment_selection_v1(v_request.current_timesheet_id,v_fin.id,v_invoice.id);
    if v_plan->>'schema_version' is distinct from 'INVOICE_EDIT_NATIVE_SEGMENT_SELECTION_WITNESS_V1'
      or v_plan->>'timesheet_id' is distinct from v_request.current_timesheet_id::text
      or v_plan->>'financial_id' is distinct from v_fin.id::text or v_plan->>'invoice_id' is distinct from v_invoice.id::text
      or v_plan->'segments' is distinct from v_fin.invoice_breakdown_json->'segments' then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_NATIVE_COMPONENT_SUBSET_REFUSED' using errcode='55000';end if;
    -- Literal unchanged native editor/service branch, with one internally derived
    -- payload. No expected money/VAT/line calculator or general permission change.
    v_result:=public.invoice_apply_edits(v_invoice.id,jsonb_build_object('add_timesheet_ids',jsonb_build_array(v_request.current_timesheet_id)),p_actor_user_id);
    select * into strict v_after_fin from public.timesheets_financials where id=v_fin.id and is_current;
    if to_jsonb(v_after_fin)-array['invoice_breakdown_json','locked_by_invoice_id','locked_at_utc','updated_at']
       is distinct from to_jsonb(v_fin)-array['invoice_breakdown_json','locked_by_invoice_id','locked_at_utc','updated_at']
      or v_after_fin.invoice_breakdown_json-'segments' is distinct from v_fin.invoice_breakdown_json-'segments'
      or (select jsonb_agg(s.value-'invoice_locked_invoice_id' order by s.ordinality)
          from jsonb_array_elements(v_after_fin.invoice_breakdown_json->'segments') with ordinality s(value,ordinality))
       is distinct from (select jsonb_agg(s.value-'invoice_locked_invoice_id' order by s.ordinality)
          from jsonb_array_elements(v_fin.invoice_breakdown_json->'segments') with ordinality s(value,ordinality))
      or (jsonb_array_length(v_plan->'segments')>0 and
          (v_after_fin.locked_by_invoice_id is distinct from v_invoice.id or v_after_fin.locked_at_utc is null))
      or exists(select 1 from jsonb_array_elements(v_after_fin.invoice_breakdown_json->'segments') s
        where s->>'invoice_locked_invoice_id' is distinct from v_invoice.id::text) then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_COMPLETE_NATIVE_COMPONENTS_UNPROVED' using errcode='55000';end if;
    select coalesce(jsonb_agg(to_jsonb(l) order by l.id),'[]'::jsonb),coalesce(jsonb_agg(l.id order by l.id),'[]'::jsonb)
      into v_actual,v_line_ids from public.invoice_lines l where l.invoice_id=v_invoice.id and l.timesheet_id=v_request.current_timesheet_id;
    if (jsonb_array_length(v_plan->'segments')>0 and jsonb_array_length(v_actual)=0)
      or (jsonb_array_length(v_plan->'segments')=0 and jsonb_array_length(v_actual)<>0)
      or (select count(distinct l->>'source_key') from jsonb_array_elements(v_actual) l)<>jsonb_array_length(v_actual)
      or exists(select 1 from jsonb_array_elements(v_actual) l
        where l#>>'{meta_json,tsfin_id}' is distinct from v_fin.id::text
          or l->>'booking_id' is distinct from (select booking_id from public.timesheets where timesheet_id=v_request.current_timesheet_id)
          or l->>'invoice_id' is distinct from v_invoice.id::text or l->>'timesheet_id' is distinct from v_request.current_timesheet_id::text) then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_NATIVE_LINE_IDENTITY_UNPROVED' using errcode='55000';end if;
    -- Complete actual identity census from this native call; hashes do not assert
    -- independent rendered document order or another monetary qualification.
    v_plan:=v_plan||jsonb_build_object('native_invoice_line_ids',v_line_ids,
      'native_invoice_lines_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_DRAFT_NATIVE_RETURNED_LINES_V1',v_actual),'hex'),
      'native_locked_segments_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_DRAFT_NATIVE_RETURNED_SEGMENTS_V1',v_after_fin.invoice_breakdown_json->'segments'),'hex'));
  end if;
  if (v_result is not null and (jsonb_typeof(v_result) is distinct from 'object'
      or v_result->>'invoice_id' is distinct from v_invoice.id::text
      or v_result->>'status' not in('DRAFT','ON_HOLD')))
    or v_result->>'ok'='false' or v_result->>'success'='false'
    or (select invoice_no from public.invoices where id=v_invoice.id) is distinct from v_request.original_draft_invoice_no
    or private.weekly_source_sha256_jsonb_v1('AGENCY_DRAFT_UNRELATED_NATIVE_LINES_V1',
      coalesce((select jsonb_agg(to_jsonb(l) order by l.id) from public.invoice_lines l where l.invoice_id=v_invoice.id
        and l.timesheet_id is distinct from v_request.initial_timesheet_id
        and l.timesheet_id is distinct from v_request.current_timesheet_id),'[]'::jsonb)) is distinct from v_unrelated then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_UNRELATED_D1_CHANGED' using errcode='55000'; end if;
  v_signature:=public.timesheet_lifecycle_guard_signature_v1(v_request.current_timesheet_id,v_request.contract_week_id,false);
  if nullif(btrim(coalesce(v_signature->>'backend_row_signature',v_signature->>'row_signature',v_signature->>'signature')),'') is null then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000'; end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_DRAFT_ROUND_TRIP_RECEIPT_V1',
    'ok',true,'request_id',v_request.id,'step',v_step,'phase_actor_user_id',p_actor_user_id,
    'original_draft_invoice_id',v_invoice.id,'original_draft_invoice_no',v_invoice.invoice_no,
    'timesheet_id',v_request.current_timesheet_id,'financial_id',v_fin.id,'native_result',v_result,
    'unrelated_lines_sha256',encode(v_unrelated,'hex'),'native_line_plan',v_plan,
    'current_row_signature',btrim(coalesce(v_signature->>'backend_row_signature',v_signature->>'row_signature',v_signature->>'signature')));
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_DRAFT_ROUND_TRIP_NATIVE_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_week_facts_v1(p_timesheet_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 t public.timesheets%rowtype; w public.contract_weeks%rowtype; con public.contracts%rowtype;
 cycle public.weekly_source_cycles%rowtype; pub public.weekly_source_projection_publications%rowtype;
 upload public.weekly_source_uploads%rowtype; profile public.weekly_source_format_profiles%rowtype;
 rules jsonb; cycles uuid[]; records jsonb:='[]'; sources jsonb:='[]'; carried jsonb:='[]';
 coverage jsonb:='[]'; queries jsonb:='[]'; protections jsonb:='[]'; pairs jsonb:='[]'; pending jsonb:='[]';
 facts jsonb; checks jsonb; reasons text[]:='{}'; rec record; row_data record; item jsonb; source_item jsonb;
 incident record; response public.weekly_discrepancy_events%rowtype; protection record; pair record;
 chain jsonb; leg uuid; n integer; hit integer; event_id uuid; valid boolean; disputed boolean; wait_fact jsonb;
 coverage_ok boolean:=false; finalised_ok boolean:=true; queries_ok boolean:=true; matching_ok boolean:=true;
 records_ok boolean:=true; authorised_ok boolean:=true; decisions_ok boolean:=true; protection_ok boolean:=true;
begin
 if p_timesheet_id is null then raise exception 'AGENCY_INVOICE_TIMESHEET_REQUIRED' using errcode='22023';end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict con from public.contracts where id=t.contract_id;
 select * into strict w from public.contract_weeks where timesheet_id=t.timesheet_id
  and contract_id=con.id and week_ending_date=t.week_ending_date and coalesce(additional_seq,0)=0 and not is_adjustment;
 if t.is_current is distinct from true or t.revoked_at is not null or t.archived_at_utc is not null
  or t.sheet_scope::text<>'WEEKLY' or t.line_type::text<>'HOURS'
  or private.weekly_source_agency_invoice_check_only_v1(t.timesheet_id) is distinct from true then
  raise exception 'AGENCY_INVOICE_TIMESHEET_ROTATED' using errcode='40001';end if;
 select array_agg(c.id order by c.id) into cycles from public.weekly_source_cycles c
  join public.weekly_source_groups g on g.id=c.source_group_id and g.active and g.source_family='ROSTER'
  join public.weekly_source_group_clients m on m.source_group_id=g.id and m.client_id=con.client_id
   and w.week_ending_date between m.valid_from and coalesce(m.valid_to,'infinity'::date)
  where c.finalisation_week_ending=w.week_ending_date and(c.scope_client_id is null or c.scope_client_id=con.client_id);
 if cardinality(cycles)>1 then select array_agg(c.id order by c.id) into cycles from public.weekly_source_cycles c
  where c.id=any(cycles) and c.scope_client_id=con.client_id;end if;
 if coalesce(cardinality(cycles),0)<>1 then raise exception 'AGENCY_INVOICE_SOURCE_CYCLE_AMBIGUOUS' using errcode='55000';end if;
 select * into strict cycle from public.weekly_source_cycles where id=cycles[1];
 rules:=private.weekly_source_effective_rule_set_v1(con.client_id,cycle.id);
 if rules#>>'{values,invoice_sender}' is distinct from 'AGENCY_INVOICE' then
  raise exception 'AGENCY_INVOICE_RULE_UNAVAILABLE' using errcode='55000';end if;
 select * into pub from public.weekly_source_projection_publications where id=cycle.current_projection_publication_id
  and source_cycle_id=cycle.id and state='CURRENT' and authority_scope_kind='CYCLE' and report_scope_id is null and correction_session_id is null;
 if pub.id is null then raise exception 'AGENCY_INVOICE_CURRENT_PUBLICATION_UNAVAILABLE' using errcode='55000';end if;
 perform private.weekly_source_query_current_publication_v1(cycle.id,pub.id);
 select * into strict upload from public.weekly_source_uploads where id=pub.upload_id and id=cycle.current_complete_upload_id
  and source_cycle_id=cycle.id and report_scope_id is null and state='CURRENT';
 if upload.blocked_count<>0 or upload.blocking_economic_duplicate_count<>0 or upload.malformed_count<>0 then
  raise exception 'AGENCY_INVOICE_SOURCE_MAPPING_UNAVAILABLE' using errcode='55000';end if;
 if exists(select 1 from public.weekly_source_upload_rows ur left join public.weekly_source_row_resolutions rr
  on rr.upload_row_id=ur.id and rr.generation=coalesce(pub.projection_generation,pub.authority_scope_version)
  where ur.upload_id=upload.id and ur.row_finalisation_state='SOURCE_WORKED'
   and ur.work_date between w.week_ending_date-6 and w.week_ending_date and rr.mapping_state is distinct from 'RESOLVED') then
  raise exception 'AGENCY_INVOICE_SOURCE_MAPPING_UNAVAILABLE' using errcode='55000';end if;
 select * into strict profile from public.weekly_source_format_profiles where id=upload.source_format_profile_id and active;
 if profile.profile_code is distinct from rules#>>'{values,checking_profile_kind}'
  or not((profile.final_authority_kind='HEALTHROSTER_ACTUAL_ROWS' and profile.row_finalisation_capability='FINALISED_ROW_ONLY')
    or(profile.profile_code='ROSTER_WEEKLY_SUMMARY_ACTUAL_V1' and profile.final_authority_kind='GENERIC_COMPLETE_SNAPSHOT'
      and profile.row_finalisation_capability='COMPLETE_FILE_ROWS')) then
  raise exception 'AGENCY_INVOICE_FINALISED_PROFILE_UNAVAILABLE' using errcode='55000';end if;
 -- COMPLETE is an actual accepted/ticked coverage witness. All seven days are
 -- tested before evaluating shifts; an export's absence of rows is not coverage.
 select coalesce(jsonb_agg(jsonb_build_object('publication_id',p.id,'upload_id',u.id,
  'upload_sha256',encode(u.content_sha256,'hex'),'start',u.confirmed_coverage_start_local_date,
  'end',u.confirmed_coverage_end_local_date,'confirmed_actor',u.coverage_confirmed_by_user_id,
  'confirmed_at',u.coverage_confirmed_at_utc) order by p.id),'[]') into coverage
 from public.weekly_source_projection_publications p join public.weekly_source_uploads u on u.id=p.upload_id
 where p.source_cycle_id=cycle.id and p.authority_scope_kind='CYCLE' and p.report_scope_id is null
  and p.state in('CURRENT','STALE') and p.published_at_utc is not null and p.correction_session_id is null
  and u.state in('CURRENT','SUPERSEDED') and u.coverage_state='COMPLETE' and u.coverage_timezone='Europe/London'
  and u.coverage_confirmed_by_user_id is not null and u.coverage_confirmed_at_utc is not null
  and coalesce(u.file_metadata_json->>'import_use','CHECKING')='CHECKING'
  and exists(select 1 from public.weekly_source_upload_attempts a where a.logical_upload_id=u.id and a.result='ACCEPTED')
  and (cycle.scope_client_id=con.client_id or exists(select 1 from public.weekly_source_row_resolutions rr
   join public.weekly_source_upload_rows ur on ur.id=rr.upload_row_id and ur.upload_id=u.id
   where rr.mapping_state='RESOLVED' and rr.client_id=con.client_id));
 coverage_ok:=not exists(select 1 from generate_series(0,6) day where not exists(
  select 1 from jsonb_array_elements(coverage) c where w.week_ending_date-day between (c->>'start')::date and(c->>'end')::date));
 -- This is the current native finalised tuple, not the worker's signed claim.
 for row_data in select rr.*,ur.work_date,ur.start_at_local,ur.end_at_local,ur.break_minutes,ur.actual_net_minutes,
  ur.row_finalisation_state,ur.finalised_by,ur.bounded_raw_columns_json,ur.normalised_row_hash,
  e.candidate_id event_candidate,e.client_id event_client,e.work_date event_date,e.first_source_group_id
  from public.weekly_source_row_resolutions rr join public.weekly_source_upload_rows ur on ur.id=rr.upload_row_id
  left join public.weekly_work_events e on e.id=rr.work_event_id
  where ur.upload_id=upload.id and rr.generation=coalesce(pub.projection_generation,pub.authority_scope_version)
   and rr.contract_id=con.id and rr.candidate_id=con.candidate_id and rr.client_id=con.client_id
   and ur.work_date between w.week_ending_date-6 and w.week_ending_date
  order by ur.work_date,ur.start_at_local,rr.id loop
  if row_data.row_finalisation_state='SOURCE_WORKED' then
   valid:=row_data.mapping_state='RESOLVED' and row_data.work_event_id is not null
    and row_data.event_candidate=con.candidate_id and row_data.event_client=con.client_id
    and row_data.event_date=row_data.work_date and row_data.first_source_group_id=cycle.source_group_id
    and row_data.start_at_local is not null and row_data.end_at_local>row_data.start_at_local
    and row_data.break_minutes is not null and row_data.actual_net_minutes>0
    and row_data.paid_minutes=row_data.actual_net_minutes
    and extract(epoch from(row_data.end_at_local-row_data.start_at_local))/60-row_data.break_minutes=row_data.actual_net_minutes
    and date_trunc('minute',row_data.start_at_local)=row_data.start_at_local
    and date_trunc('minute',row_data.end_at_local)=row_data.end_at_local
    and (profile.row_finalisation_capability<>'FINALISED_ROW_ONLY' or(nullif(btrim(row_data.finalised_by),'') is not null
     and row_data.finalised_by=row_data.bounded_raw_columns_json->>'finalised_by'));
   if valid is distinct from true then raise exception 'AGENCY_INVOICE_SOURCE_TUPLE_UNAVAILABLE' using errcode='55000';end if;
   if exists(select 1 from jsonb_array_elements(sources) s where s->>'work_event_id'=row_data.work_event_id::text) then
    raise exception 'AGENCY_INVOICE_SOURCE_EVENT_AMBIGUOUS' using errcode='55000';end if;
   sources:=sources||jsonb_build_array(jsonb_build_object('work_event_id',row_data.work_event_id,'upload_row_id',row_data.upload_row_id,
    'row_sha256',encode(row_data.normalised_row_hash,'hex'),'date',row_data.work_date,'start',to_char(row_data.start_at_local,'HH24:MI'),
    'end',to_char(row_data.end_at_local,'HH24:MI'),'end_date',row_data.end_at_local::date,'break_minutes',row_data.break_minutes));
  end if;
 end loop;
 -- Current native reversal/replacement units remain native units. A reversal
 -- is excluded from the positive records only with the real APPLIED request
 -- and a valid complete chain. Both native legs must actually be authorised.
 for pair in select r.* from private.timesheet_correction_requests r where r.contract_id=con.id
  and r.candidate_id=con.candidate_id and r.client_id=con.client_id and r.week_ending_date=w.week_ending_date
  and r.state='APPLIED' order by r.id loop
  chain:=public.timesheet_correction_chain_scope_v1(pair.replacement_timesheet_id,false,32,100);
  if chain->'valid' is distinct from 'true'::jsonb or chain#>'{requested_correction_unit,valid}' is distinct from 'true'::jsonb
   or jsonb_typeof(chain#>'{requested_correction_unit,member_ids}') is distinct from 'array'
   or not(chain#>'{requested_correction_unit,member_ids}' ? pair.replacement_timesheet_id::text)
   or not(chain#>'{requested_correction_unit,member_ids}' ? pair.reversal_timesheet_id::text) then
   raise exception 'AGENCY_INVOICE_NATIVE_PAIR_UNAVAILABLE' using errcode='55000';end if;
  for leg in select value::uuid from jsonb_array_elements_text(chain#>'{requested_correction_unit,member_ids}') loop
   if not exists(select 1 from public.timesheets x join public.timesheets_financials f on f.timesheet_id=x.timesheet_id
    and f.is_current and not f.is_stale and f.timesheet_version=x.version
    and f.candidate_id=con.candidate_id and f.client_id=con.client_id
    where x.timesheet_id=leg and x.is_current and x.revoked_at is null
    and x.authorised_at_server is not null and f.authorised_at_utc=x.authorised_at_server) then authorised_ok:=false;end if;
  end loop;
  pairs:=pairs||jsonb_build_array(jsonb_build_object('request_id',pair.id,'state_revision',pair.state_revision,
   'reversed_timesheet_id',pair.reversed_timesheet_id,'reversal_timesheet_id',pair.reversal_timesheet_id,
   'replacement_timesheet_id',pair.replacement_timesheet_id,'member_ids',chain#>'{requested_correction_unit,member_ids}'));
 end loop;
 for rec in select x.*,cw.id week_id from public.contract_weeks cw join public.timesheets x on x.timesheet_id=cw.timesheet_id
  where cw.contract_id=con.id and cw.week_ending_date=w.week_ending_date and x.is_current and x.archived_at_utc is null
   and x.sheet_scope::text='WEEKLY' and x.line_type::text='HOURS'
   and not exists(select 1 from jsonb_array_elements(pairs) p where x.timesheet_id::text in(p->>'reversed_timesheet_id',p->>'reversal_timesheet_id'))
  order by x.timesheet_id loop
  if jsonb_typeof(rec.actual_schedule_json) is distinct from 'array' then
   raise exception 'AGENCY_INVOICE_RECORD_SCHEDULE_UNAVAILABLE' using errcode='55000';end if;
  if jsonb_array_length(rec.actual_schedule_json)=0 then continue;end if; -- empty P0 is not invoiceable
  if rec.revoked_at is not null or rec.authorised_at_server is null then authorised_ok:=false;end if;
  if (select count(*) from public.timesheets_financials f where f.timesheet_id=rec.timesheet_id and f.is_current and not f.is_stale
    and f.timesheet_version=rec.version and f.authorised_at_utc is not distinct from rec.authorised_at_server
    and f.candidate_id=con.candidate_id and f.client_id=con.client_id and f.actual_schedule_json is not distinct from rec.actual_schedule_json)<>1 then authorised_ok:=false;end if;
  records:=records||jsonb_build_array(jsonb_build_object('timesheet_id',rec.timesheet_id,'timesheet_version',rec.version,
   'contract_week_id',rec.week_id,'authorised_at_server',rec.authorised_at_server,'revoked_at',rec.revoked_at,'schedule',rec.actual_schedule_json));
  for item in select value from jsonb_array_elements(rec.actual_schedule_json) loop
   if jsonb_typeof(item) is distinct from 'object' or jsonb_typeof(item->'work_event_id') is distinct from 'string'
    or coalesce(item->>'work_event_id','')!~'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' then
    raise exception 'AGENCY_INVOICE_RECORD_EVENT_UNBOUND' using errcode='55000';end if;
   event_id:=(item->>'work_event_id')::uuid;
   select count(*) into hit from jsonb_array_elements(sources) s where s->>'work_event_id'=event_id::text;
   if hit<>1 then finalised_ok:=false;matching_ok:=false;else
    select value into strict source_item from jsonb_array_elements(sources) s(value) where value->>'work_event_id'=event_id::text;
    if item->>'date' is distinct from source_item->>'date' or item->>'start' is distinct from source_item->>'start'
     or item->>'end' is distinct from source_item->>'end' or item->>'end_date' is distinct from source_item->>'end_date'
     or (item->>'break_minutes')::integer is distinct from(source_item->>'break_minutes')::integer then matching_ok:=false;end if;
   end if;
   carried:=carried||jsonb_build_array(jsonb_build_object('work_event_id',event_id,'timesheet_id',rec.timesheet_id));
  end loop;
 end loop;
 if exists(select 1 from jsonb_array_elements(carried) r group by r->>'work_event_id' having count(*)<>1)
  or exists(select 1 from jsonb_array_elements(sources) s where not exists(select 1 from jsonb_array_elements(carried) r
   where r->>'work_event_id'=s->>'work_event_id')) or jsonb_array_length(carried)<>jsonb_array_length(sources) then records_ok:=false;end if;
 -- Only a genuine pre-authorisation worker dispute on a finalised carried
 -- shift can hold invoicing. Reminders and unprotected absent/unfinalised
 -- subjects are deliberately outside this predicate.
 for incident in select i.id incident_id,i.work_event_id,i.episode_number,i.candidate_action_state,
  x.id comparison_id,x.incident_id comparison_incident_id,x.contract_id comparison_contract_id,x.issue_family,
  x.revision_number,x.projection_publication_id,x.material_comparison_fingerprint,
  x.candidate_start_at_local,x.candidate_end_at_local,x.candidate_break_minutes,
  x.system_start_at_local,x.system_end_at_local,x.system_break_minutes from public.weekly_discrepancy_incidents i
  left join public.weekly_issue_comparison_revisions x on x.id=i.current_comparison_revision_id
  where i.source_group_id=cycle.source_group_id and i.source_cycle_id=cycle.id and i.candidate_id=con.candidate_id
   and i.client_id=con.client_id and i.state='OPEN'
   and exists(select 1 from jsonb_array_elements(carried) r where r->>'work_event_id'=i.work_event_id::text)
  order by i.id loop
  if incident.comparison_id is null or incident.comparison_incident_id is distinct from incident.incident_id
   or incident.comparison_contract_id is distinct from con.id
   or incident.revision_number is distinct from(select max(revision_number) from public.weekly_issue_comparison_revisions where incident_id=incident.incident_id)
   or incident.projection_publication_id is distinct from pub.id then raise exception 'AGENCY_INVOICE_QUERY_EVIDENCE_UNAVAILABLE' using errcode='55000';end if;
  if incident.issue_family<>'SOURCE_HOURS_DIFFER' then continue;end if;
  response:=null;select * into response from public.weekly_discrepancy_events e where e.incident_id=incident.incident_id
   and e.issue_episode=incident.episode_number and e.event_kind='CANDIDATE_RESPONDED' and e.actor_kind='CANDIDATE'
   order by e.occurred_at_utc desc,e.id desc limit 1;
  disputed:=false;
  if response.id is not null then
   if response.expected_comparison_fingerprint is distinct from incident.material_comparison_fingerprint
    or response.projection_publication_id is distinct from pub.id
    or response.bounded_payload_json->>'choice' is null
    or response.bounded_payload_json->>'choice' not in('CANDIDATE_WRONG','CANDIDATE_CORRECT','NEITHER_CORRECT') then
    raise exception 'AGENCY_INVOICE_QUERY_RESPONSE_UNAVAILABLE' using errcode='55000';end if;
   if incident.candidate_start_at_local is null or incident.candidate_end_at_local is null
    or incident.candidate_break_minutes is null or incident.system_start_at_local is null
    or incident.system_end_at_local is null or incident.system_break_minutes is null then
    raise exception 'AGENCY_INVOICE_QUERY_TUPLE_UNAVAILABLE' using errcode='55000';end if;
   disputed:=response.bounded_payload_json->>'choice' in('CANDIDATE_CORRECT','NEITHER_CORRECT')
    and extract(epoch from(incident.system_end_at_local-incident.system_start_at_local))/60-incident.system_break_minutes
      <=extract(epoch from(incident.candidate_end_at_local-incident.candidate_start_at_local))/60-incident.candidate_break_minutes
    and exists(
    select 1 from jsonb_array_elements(records) r join jsonb_array_elements(carried) a
     on a->>'timesheet_id'=r->>'timesheet_id' and a->>'work_event_id'=incident.work_event_id::text
     where (r->>'authorised_at_server')::timestamptz is null
      or response.occurred_at_utc<=(r->>'authorised_at_server')::timestamptz);
  elsif incident.candidate_action_state='RESPONDED' then raise exception 'AGENCY_INVOICE_QUERY_RESPONSE_UNAVAILABLE' using errcode='55000';end if;
  if disputed then queries_ok:=false;end if;
  queries:=queries||jsonb_build_array(jsonb_build_object('incident_id',incident.incident_id,'comparison_id',incident.comparison_id,
   'comparison_fingerprint',encode(incident.material_comparison_fingerprint,'hex'),'response_id',response.id,'disputed',disputed));
 end loop;
 -- Existing Source WAIT remains a genuine native receipt, distinct from the
 -- planned check-only intent. No event status alone establishes qualified WAIT.
 for protection in select family.root_timesheet_id,e.id event_id,e.durable_work_event_id
  from public.weekly_exceptional_pay_target_families family
  join public.weekly_exceptional_pay_family_events e on e.family_id=family.id
  where family.contract_id=con.id and family.candidate_id=con.candidate_id
   and family.week_ending_date=w.week_ending_date and e.state='WAIT'
   and e.event_sequence=(select max(tail.event_sequence) from public.weekly_exceptional_pay_family_events tail
    where tail.family_id=family.id and tail.durable_work_event_id=e.durable_work_event_id) order by e.id loop
  wait_fact:=private.weekly_source_protected_wait_receipt_v1(protection.root_timesheet_id,protection.event_id);
  if jsonb_typeof(wait_fact) is distinct from 'object' then
   raise exception 'AGENCY_INVOICE_QUALIFIED_WAIT_EVIDENCE_UNAVAILABLE' using errcode='55000';end if;
  protection_ok:=false;reasons:=array_append(reasons,'PROTECTED_SHIFT_WAITING');
  protections:=protections||jsonb_build_array(jsonb_build_object('native_wait_event_id',protection.event_id,
   'work_event_id',protection.durable_work_event_id,'qualified_receipt',wait_fact));
 end loop;
 select coalesce(jsonb_agg(jsonb_build_object('request_id',r.id,'state_revision',r.state_revision) order by r.id),'[]') into pending
  from private.timesheet_correction_requests r where r.contract_id=con.id and r.candidate_id=con.candidate_id
   and r.client_id=con.client_id and r.week_ending_date=w.week_ending_date and r.state='WAITING';
 decisions_ok:=jsonb_array_length(pending)=0 and not exists(select 1 from private.weekly_source_manual_reviews r
  where r.contract_id=con.id and r.candidate_id=con.candidate_id and r.client_id=con.client_id
   and r.work_date between w.week_ending_date-6 and w.week_ending_date and r.state='OPEN'
   and exists(select 1 from jsonb_array_elements(carried) event where event->>'work_event_id'=r.work_event_id::text));
 for protection in select p.* from private.weekly_source_check_only_shift_protections p where p.candidate_id=con.candidate_id
  and p.contract_id=con.id and p.client_id=con.client_id and p.week_ending_date=w.week_ending_date and p.state='ACTIVE' order by p.id loop
  select count(*) into hit from jsonb_array_elements(sources) s where s->>'work_event_id'=protection.work_event_id::text;
  if hit=0 then protection_ok:=false;reasons:=array_append(reasons,'PROTECTED_SHIFT_WAITING');else
   select value into strict source_item from jsonb_array_elements(sources) s(value) where s->>'work_event_id'=protection.work_event_id::text;
   if protection.protected_start_at_local is distinct from(source_item->>'date')::date+(source_item->>'start')::time
    or protection.protected_end_at_local is distinct from(source_item->>'end_date')::date+(source_item->>'end')::time
    or protection.protected_break_minutes is distinct from(source_item->>'break_minutes')::integer then
    protection_ok:=false;reasons:=array_append(reasons,'PROTECTED_HOURS_DIFFER');end if;
  end if;
  protections:=protections||jsonb_build_array(jsonb_build_object('id',protection.id,'version',protection.version,'work_event_id',protection.work_event_id,
   'start',protection.protected_start_at_local,'end',protection.protected_end_at_local,'break_minutes',protection.protected_break_minutes));
 end loop;
 if not coverage_ok then reasons:=array_prepend('COVERAGE_MISSING',reasons);end if;
 if not finalised_ok then reasons:=array_append(reasons,'NOT_FINALISED');end if;
 if not queries_ok then reasons:=array_append(reasons,'QUERY_UNRESOLVED');end if;
 if not matching_ok then reasons:=array_append(reasons,'HOURS_DIFFER');end if;
 if not records_ok then reasons:=array_append(reasons,'RECORDS_NOT_ALIGNED');end if;
 if not authorised_ok then reasons:=array_append(reasons,'NOT_AUTHORISED');end if;
 if not decisions_ok then reasons:=array_append(reasons,'CORRECTION_PENDING');end if;
 checks:=jsonb_build_object('coverage',coverage_ok,'finalised',finalised_ok,'pre_authorisation_queries',queries_ok,'matching',matching_ok,
  'records_equal_source',records_ok,'authorised_units',authorised_ok,'no_pending_decision',decisions_ok,'protected_resolved',protection_ok);
 facts:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_WEEK_FACTS_V1','main_timesheet_id',t.timesheet_id,
  'main_contract_week_id',w.id,'contract_id',con.id,'candidate_id',con.candidate_id,'client_id',con.client_id,'week_ending',w.week_ending_date,
  'source_cycle_id',cycle.id,'source_group_id',cycle.source_group_id,'publication_id',pub.id,'upload_id',upload.id,
  'rule_set_version_id',rules->'rule_set_version_id','coverage',coverage,'finalised_source',sources,'records',records,
  'pairs',pairs,'queries',queries,'pending_corrections',pending,'protections',protections,'conditions',checks,'reasons',to_jsonb(reasons));
 if jsonb_array_length(records)>100 or jsonb_array_length(sources)>100 or octet_length(facts::text)>2097152 then
  raise exception 'AGENCY_INVOICE_WEEK_FACTS_BOUND_EXCEEDED' using errcode='54000';end if;
 return facts||jsonb_build_object('complete',cardinality(reasons)=0,'facts_hash',encode(private.weekly_source_sha256_jsonb_v1(
  'WEEKLY_SOURCE_AGENCY_NATIVE_WEEK_FACTS_V1',facts),'hex'));
exception when no_data_found or too_many_rows then raise exception 'AGENCY_INVOICE_WEEK_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function public.weekly_source_agency_week_validation_refresh_v1(
 p_timesheet_id uuid,p_publication_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare facts jsonb; item jsonb; target uuid; native_actor uuid; validation public.timesheet_validations%rowtype;
 actor public.tms_users%rowtype; written jsonb:='[]'; status_value public.validation_status_enum; reason_value text;
 r private.weekly_source_agency_timesheet_change_requests%rowtype; queue public.ts_financials_outbox%rowtype;
 fin public.timesheets_financials%rowtype; sig jsonb; signature text; receipt jsonb; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001';end if;
 facts:=private.weekly_source_agency_week_facts_v1(p_timesheet_id);
 if p_publication_id is null or facts->>'publication_id' is distinct from p_publication_id::text then
  raise exception 'AGENCY_INVOICE_VALIDATION_PUBLICATION_STALE' using errcode='40001';end if;
 -- The validating actor is an actual native approval actor, or the immutable
 -- accepted upload actor for a not-yet-authorised week. It is not a caller field.
 select coalesce(f.authorised_by_user_id,u.uploaded_by_user_id) into strict native_actor
 from public.timesheets t join public.weekly_source_uploads u on u.id=(facts->>'upload_id')::uuid
 left join public.timesheets_financials f on f.timesheet_id=t.timesheet_id and f.is_current and f.timesheet_version=t.version
 where t.timesheet_id=p_timesheet_id;
 select * into strict actor from public.tms_users where id=native_actor;
 status_value:=case when facts->'complete'='true'::jsonb then 'VALIDATION_OK'::public.validation_status_enum
  else 'VALIDATION_ERROR'::public.validation_status_enum end;
 reason_value:=case when status_value='VALIDATION_OK' then null else facts#>>'{reasons,0}' end;
 if status_value='VALIDATION_ERROR' and nullif(reason_value,'') is null then
  raise exception 'AGENCY_INVOICE_VALIDATION_REASON_UNAVAILABLE' using errcode='55000';end if;
 for item in select value from jsonb_array_elements(facts->'records') loop
  target:=(item->>'timesheet_id')::uuid;
  perform 1 from public.timesheets t where t.timesheet_id=target and t.is_current
   and t.version=(item->>'timesheet_version')::integer for update;
  if not found then raise exception 'AGENCY_INVOICE_TIMESHEET_ROTATED' using errcode='40001';end if;
  insert into public.timesheet_validations(id,timesheet_id,booking_id,status,reason_code,validated_at_utc,last_source,
   created_at,updated_at,pre_validated,validation_source_kind,validation_source_publication_id,
   validation_source_facts_sha256,validation_source_actor_user_id)
  select gen_random_uuid(),t.timesheet_id,t.booking_id,status_value,reason_value,transaction_timestamp(),null,
   transaction_timestamp(),transaction_timestamp(),false,'AGENCY_INVOICE_WEEK',p_publication_id,
   decode(facts->>'facts_hash','hex'),native_actor from public.timesheets t where t.timesheet_id=target
  on conflict(timesheet_id) do update set status=excluded.status,reason_code=excluded.reason_code,
   validated_at_utc=excluded.validated_at_utc,last_source=null,updated_at=excluded.updated_at,pre_validated=false,
   override_requested_at_utc=null,override_requested_by=null,override_confirmed_at_utc=null,override_confirmed_by=null,
   override_reason=null,override_cleared_at_utc=case when timesheet_validations.override_reason is not null
    then transaction_timestamp() else timesheet_validations.override_cleared_at_utc end,
   validation_source_kind=excluded.validation_source_kind,validation_source_publication_id=excluded.validation_source_publication_id,
   validation_source_facts_sha256=excluded.validation_source_facts_sha256,validation_source_actor_user_id=excluded.validation_source_actor_user_id
  where (timesheet_validations.status,timesheet_validations.reason_code,timesheet_validations.pre_validated,
   timesheet_validations.validation_source_kind,timesheet_validations.validation_source_publication_id,
   timesheet_validations.validation_source_facts_sha256,timesheet_validations.validation_source_actor_user_id)
   is distinct from(excluded.status,excluded.reason_code,false,excluded.validation_source_kind,
    excluded.validation_source_publication_id,excluded.validation_source_facts_sha256,excluded.validation_source_actor_user_id)
  returning * into validation;
  if not found then select * into strict validation from public.timesheet_validations where timesheet_id=target;end if;
  written:=written||jsonb_build_array(jsonb_build_object('timesheet_id',target,'validation_id',validation.id,'status',validation.status,
   'reason_code',validation.reason_code,'updated_at',validation.updated_at));
 end loop;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_VALIDATION_REFRESH_V1','main_timesheet_id',p_timesheet_id,
  'publication_id',p_publication_id,'facts_hash',facts->>'facts_hash','complete',facts->'complete','reasons',facts->'reasons',
  'validation_actor_user_id',native_actor,'written',written);
 select * into r from private.weekly_source_agency_timesheet_change_requests where current_timesheet_id=p_timesheet_id and state='ACTIVE';
 if found and r.phase='AUTHORISED' then
  if r.source_publication_id is distinct from p_publication_id or r.source_cas is distinct from
    private.weekly_source_bulk_source_cas_v1(r.source_cycle_id,array[r.client_id]) then
   raise exception 'AGENCY_CHANGE_ORIGINAL_SOURCE_CAS_CHANGED' using errcode='40001';end if;
  select * into strict fin from public.timesheets_financials where id=r.current_financial_id and is_current;
  if fin.timesheet_id is distinct from r.current_timesheet_id or fin.timesheet_version is distinct from r.current_timesheet_version
   or fin.authorised_by_user_id::text is distinct from r.native_receipts#>>'{authorise,phase_actor_user_id}'
   or fin.authorised_at_utc is distinct from(r.native_receipts#>>'{authorise,authorised_at_server}')::timestamptz then
   raise exception 'AGENCY_CHANGE_GENUINE_AUTHORISE_RECEIPT_REQUIRED' using errcode='55000';end if;
  select * into strict validation from public.timesheet_validations where timesheet_id=p_timesheet_id;
  -- Do not enqueue anew from a successful validation replay. A real retained
  -- post-write receipt for this current row remains a genuine completed queue.
  if r.native_receipts#>>'{validation_recompute,financial_id}' is distinct from fin.id::text
   or r.native_receipts#>>'{validation_recompute,facts_sha256}' is distinct from facts->>'facts_hash' then
   select * into queue from public.ts_financials_outbox where timesheet_id=p_timesheet_id and reason='CONTEXT_CHANGED';
   if not found then
    perform public.enqueue_ts_financials_priority(array[p_timesheet_id],'CONTEXT_CHANGED'::public.ts_fin_reason_enum);
    select * into strict queue from public.ts_financials_outbox where timesheet_id=p_timesheet_id and reason='CONTEXT_CHANGED';
   end if;
   sig:=public.timesheet_lifecycle_guard_signature_v1(p_timesheet_id,r.contract_week_id,false);
   signature:=nullif(btrim(coalesce(sig->>'backend_row_signature',sig->>'row_signature',sig->>'signature')),'');
   if signature is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000';end if;
   receipt:=result||jsonb_build_object('request_id',r.id,'request_sha256',encode(r.request_sha256,'hex'),
    'timesheet_version',r.current_timesheet_version,'financial_id',fin.id,'outbox_id',queue.id,'outbox_reason',queue.reason,
    'validation_row_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_TYPED_VALIDATION_ROW_V1',to_jsonb(validation)),'hex'),
    'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid());
   update private.weekly_source_agency_timesheet_change_requests set native_receipts=native_receipts||jsonb_build_object('validation_refresh',receipt),
    outbox_id=queue.id,outbox_reason=queue.reason,current_row_signature=signature,version=version+1,updated_at_utc=transaction_timestamp()
    where id=r.id;
  end if;
 end if;
 -- Superseded positive originals and native reversal legs are not additional
 -- invoiceable records. They retain an explicit error in this SAME store.
 for target in select distinct id::uuid from jsonb_array_elements(facts->'pairs') p
  cross join lateral unnest(array[p->>'reversed_timesheet_id',p->>'reversal_timesheet_id']) id loop
  -- Preserve the actual retired override in the native audit before clearing
  -- current authority. An old LEGACY override never authorises this typed row.
  select * into validation from public.timesheet_validations where timesheet_id=target for update;
  if found and (validation.override_requested_at_utc is not null or validation.override_requested_by is not null
    or validation.override_confirmed_at_utc is not null or validation.override_confirmed_by is not null
    or validation.override_reason is not null) then
   insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,action,before_json,after_json,reason)
   values(gen_random_uuid(),transaction_timestamp(),native_actor,actor.role,'timesheet_validation',target::text,
    'AGENCY_SUPERSEDED_VALIDATION_OVERRIDE_RETIRED',
    jsonb_build_object('validation_id',validation.id,'validation_source_kind',validation.validation_source_kind,
     'status',validation.status,'override_requested_at_utc',validation.override_requested_at_utc,
     'override_requested_by',validation.override_requested_by,'override_confirmed_at_utc',validation.override_confirmed_at_utc,
     'override_confirmed_by',validation.override_confirmed_by,'override_reason',validation.override_reason,
     'override_cleared_at_utc',validation.override_cleared_at_utc),
    jsonb_build_object('validation_source_kind','AGENCY_INVOICE_WEEK','status','VALIDATION_ERROR',
     'reason_code','SUPERSEDED_BY_CORRECTION','publication_id',p_publication_id),
    'SUPERSEDED_BY_CORRECTION');
  end if;
  update public.timesheet_validations set status='VALIDATION_ERROR',reason_code='SUPERSEDED_BY_CORRECTION',
   validated_at_utc=transaction_timestamp(),pre_validated=false,last_source=null,updated_at=transaction_timestamp(),
   override_requested_at_utc=null,override_requested_by=null,override_confirmed_at_utc=null,override_confirmed_by=null,
   override_reason=null,override_cleared_at_utc=case when override_requested_at_utc is not null or override_requested_by is not null
    or override_confirmed_at_utc is not null or override_confirmed_by is not null or override_reason is not null
    then transaction_timestamp() else override_cleared_at_utc end,
   validation_source_kind='AGENCY_INVOICE_WEEK',validation_source_publication_id=p_publication_id,
   validation_source_facts_sha256=decode(facts->>'facts_hash','hex'),validation_source_actor_user_id=native_actor
   where timesheet_id=target;
 end loop;
 insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,action,after_json,reason,correlation_id)
 values(gen_random_uuid(),transaction_timestamp(),native_actor,actor.role,'WEEKLY_SOURCE_AGENCY_VALIDATION',p_timesheet_id::text,
  'NATIVE_WHOLE_WEEK_VALIDATION_REFRESHED',jsonb_build_object('publication_id',p_publication_id,'facts_hash',facts->>'facts_hash',
   'complete',facts->'complete','written',written,'native_actor_source','ACTUAL_AUTHORISE_OR_ACCEPTED_UPLOAD'),reason_value,null);
 return result;
exception when no_data_found or too_many_rows then raise exception 'AGENCY_INVOICE_VALIDATION_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_validation_source_guard_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare main_id uuid; facts jsonb; reason_value text; actor_id uuid; expected_status text;
begin
 if tg_op='DELETE' then return old;end if;
 if private.weekly_source_agency_invoice_check_only_v1(new.timesheet_id) is distinct from true
  and new.validation_source_kind='LEGACY' then return new;end if;
 if new.status::text in('OVERRIDDEN','OVERRIDE_AWAITING_CONFIRM') then
  raise exception 'AGENCY_INVOICE_VALIDATION_OVERRIDE_FORBIDDEN' using errcode='55000';end if;
 if new.override_requested_at_utc is not null or new.override_requested_by is not null
  or new.override_confirmed_at_utc is not null or new.override_confirmed_by is not null or new.override_reason is not null then
  raise exception 'AGENCY_INVOICE_VALIDATION_OVERRIDE_FORBIDDEN' using errcode='55000';end if;
 if new.validation_source_kind is distinct from 'AGENCY_INVOICE_WEEK' or new.last_source is not null then
  raise exception 'AGENCY_INVOICE_USES_COMPLETENESS_WRITER' using errcode='55000';end if;
 select cw.timesheet_id into strict main_id from public.timesheets t join public.contract_weeks cw
  on cw.contract_id=t.contract_id and cw.week_ending_date=t.week_ending_date and coalesce(cw.additional_seq,0)=0 and not cw.is_adjustment
  where t.timesheet_id=new.timesheet_id;
 facts:=private.weekly_source_agency_week_facts_v1(main_id);
 expected_status:=case when facts->'complete'='true'::jsonb then 'VALIDATION_OK' else 'VALIDATION_ERROR' end;
 reason_value:=case when expected_status='VALIDATION_OK' then null else facts#>>'{reasons,0}' end;
 if exists(select 1 from jsonb_array_elements(facts->'pairs') p where new.timesheet_id::text in
  (p->>'reversed_timesheet_id',p->>'reversal_timesheet_id')) then expected_status:='VALIDATION_ERROR';reason_value:='SUPERSEDED_BY_CORRECTION';end if;
 select coalesce(f.authorised_by_user_id,u.uploaded_by_user_id) into strict actor_id
  from public.timesheets t join public.weekly_source_uploads u on u.id=(facts->>'upload_id')::uuid
  left join public.timesheets_financials f on f.timesheet_id=t.timesheet_id and f.is_current and f.timesheet_version=t.version
  where t.timesheet_id=main_id;
 if new.validation_source_publication_id::text is distinct from facts->>'publication_id'
  or new.validation_source_facts_sha256 is distinct from decode(facts->>'facts_hash','hex')
  or new.validation_source_actor_user_id is distinct from actor_id or new.status::text is distinct from expected_status
  or new.reason_code is distinct from reason_value or new.pre_validated is distinct from false
  or new.validated_at_utc is distinct from transaction_timestamp() then
  raise exception 'AGENCY_INVOICE_GENUINE_COMPLETENESS_REQUIRED' using errcode='55000';end if;
 return new;
exception when no_data_found or too_many_rows then raise exception 'AGENCY_INVOICE_VALIDATION_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_validation_context_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype; q public.ts_financials_outbox%rowtype;
 v public.timesheet_validations%rowtype; facts jsonb; context jsonb; weekly jsonb; shifts jsonb; frame jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,r.initial_row_signature,r.request_key,r.updated_by_user_id);
 if r.state<>'ACTIVE' or r.phase<>'AUTHORISED' then raise exception 'AGENCY_CHANGE_VALIDATION_PHASE_NOT_READY' using errcode='55000';end if;
 select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
 select * into strict f from public.timesheets_financials where id=r.current_financial_id and is_current;
 select * into strict v from public.timesheet_validations where timesheet_id=t.timesheet_id;
 select * into strict q from public.ts_financials_outbox where id=r.outbox_id;
 facts:=private.weekly_source_agency_week_facts_v1(t.timesheet_id);
 if t.is_current is distinct from true or t.version is distinct from r.current_timesheet_version
  or t.authorised_at_server is null or t.revoked_at is not null or f.timesheet_version is distinct from t.version
  or f.authorised_at_utc is distinct from t.authorised_at_server
  or f.authorised_by_user_id::text is distinct from r.native_receipts#>>'{authorise,phase_actor_user_id}'
  or (r.native_receipts#>>'{authorise,authorised_at_server}')::timestamptz is distinct from t.authorised_at_server
  or f.paid_at_utc is not null or f.locked_by_invoice_id is not null
  or exists(select 1 from public.invoice_lines where timesheet_id=t.timesheet_id)
  or t.actual_schedule_json is distinct from r.native_receipts#>'{original_capture,schedule}'
  or f.actual_schedule_json is distinct from t.actual_schedule_json
  or q.timesheet_id is distinct from t.timesheet_id or q.reason is distinct from 'CONTEXT_CHANGED'::public.ts_fin_reason_enum
  or r.outbox_reason is distinct from q.reason or q.attempt_count<1 or q.next_attempt_at is null
  or q.next_attempt_at<=transaction_timestamp() or v.validation_source_kind is distinct from 'AGENCY_INVOICE_WEEK'
  or v.last_source is not null or v.pre_validated or v.validation_source_publication_id is distinct from r.source_publication_id
  or v.status::text not in('VALIDATION_OK','VALIDATION_ERROR') or encode(v.validation_source_facts_sha256,'hex') is distinct from facts->>'facts_hash'
  or facts->>'publication_id' is distinct from r.source_publication_id::text
  or r.native_receipts#>>'{validation_refresh,request_id}' is distinct from r.id::text
  or r.native_receipts#>>'{validation_refresh,outbox_id}' is distinct from q.id::text
  or r.native_receipts#>>'{validation_refresh,financial_id}' is distinct from f.id::text
  or r.native_receipts#>>'{validation_refresh,facts_hash}' is distinct from facts->>'facts_hash'
  or r.native_receipts#>>'{validation_refresh,validation_row_sha256}' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
   'AGENCY_NATIVE_TYPED_VALIDATION_ROW_V1',to_jsonb(v)),'hex') then
  raise exception 'AGENCY_CHANGE_GENUINE_VALIDATION_CONTEXT_REQUIRED' using errcode='55000';end if;
 select to_jsonb(x) into strict context from public.tsfin_load_context_batch(array[t.timesheet_id]) x where x.effective_timesheet_id=t.timesheet_id;
 select to_jsonb(x) into strict weekly from public.tsfin_load_weekly_context_batch(array[t.timesheet_id]) x where x.timesheet_id=t.timesheet_id;
 select x.shifts into strict shifts from public.tsfin_load_nhsp_shifts_batch(array[t.timesheet_id]) x where x.timesheet_id=t.timesheet_id;
 if context#>>'{out_timesheet,timesheet_id}' is distinct from t.timesheet_id::text or context#>>'{out_cur_fin,id}' is distinct from f.id::text
  or context#>>'{out_candidate,id}' is distinct from r.candidate_id::text or context->>'out_client_id' is distinct from r.client_id::text
  or weekly#>>'{out_cw,id}' is distinct from r.contract_week_id::text or weekly#>>'{out_contract,id}' is distinct from r.contract_id::text
  or jsonb_typeof(shifts) is distinct from 'array' or jsonb_array_length(shifts)>100 then
  raise exception 'AGENCY_CHANGE_NATIVE_CALCULATOR_CONTEXT_UNAVAILABLE' using errcode='55000';end if;
 frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_AUTHORISED_VALIDATION_CONTEXT_V1',
  'request_id',r.id,'request_sha256',encode(r.request_sha256,'hex'),'request_version',r.version,'phase',r.phase,
  'phase_actor_user_id',r.updated_by_user_id,'current_row_signature',r.current_row_signature,'source_cas',r.source_cas,
  'source_schedule',t.actual_schedule_json,'outbox_id',q.id,'outbox_reason',q.reason,'outbox_row',to_jsonb(q),
  'context',context,'weekly_context',weekly,'weekly_validation',to_jsonb(v),'nhsp_shifts',shifts,
  'week_facts_sha256',facts->>'facts_hash','week_complete',facts->'complete','validation_actor_user_id',v.validation_source_actor_user_id);
 if octet_length(frame::text)>2097152 then raise exception 'AGENCY_CHANGE_WORKER_CONTEXT_BOUND_EXCEEDED' using errcode='54000';end if;
 return frame||jsonb_build_object('context_sha256',encode(private.weekly_source_sha256_jsonb_v1(
  'WEEKLY_SOURCE_AGENCY_AUTHORISED_VALIDATION_CONTEXT_V1',frame),'hex'));
exception when no_data_found or too_many_rows then raise exception 'AGENCY_CHANGE_NATIVE_VALIDATION_CONTEXT_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_validation_frame_open_v1(p_request_id uuid,p_snapshot jsonb,p_outbox_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype; context jsonb; frame jsonb;
begin
 context:=private.weekly_source_agency_validation_context_v1(p_request_id);
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id for update;
 if context->>'outbox_id' is distinct from p_outbox_id::text then raise exception 'AGENCY_CHANGE_NATIVE_OUTBOX_CHANGED' using errcode='40001';end if;
 perform private.weekly_source_agency_snapshot_provenance_assert_v1(r.id,p_snapshot);
 -- The actual canonical builder does not emit an approval timestamp. The
 -- unchanged E26 lifecycle owner preserves it from native TS/TF authority;
 -- observe() verifies that real post-write timestamp, never invents one here.
 if p_snapshot->>'processing_status' is distinct from case when context->'week_complete'='true'::jsonb
   then 'READY_FOR_INVOICE' else 'READY_FOR_HR' end then
  raise exception 'AGENCY_CHANGE_VALIDATION_SNAPSHOT_LIFECYCLE_INVALID' using errcode='55000';end if;
 frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_AUTHORISED_WRITE_FRAME_V1','request_id',r.id,
  'request_sha256',encode(r.request_sha256,'hex'),'mode','AUTHORISED_VALIDATION','transaction_id',pg_current_xact_id()::text,
  'backend_pid',pg_backend_pid(),'phase_actor_user_id',r.updated_by_user_id,'timesheet_id',r.current_timesheet_id,
  'timesheet_version',r.current_timesheet_version,'prior_financial_id',r.current_financial_id,'outbox_id',p_outbox_id,
  'prior_financial_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_VALIDATION_PRIOR_ROW_V1',
   context#>'{context,out_cur_fin}'-array['is_current','updated_at']),'hex'),
  'timesheet_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_VALIDATION_TIMESHEET_V1',context#>'{context,out_timesheet}'),'hex'),
  'snapshot_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_CANONICAL_SNAPSHOT_V1',p_snapshot),'hex'),
  'publication_id',r.source_publication_id,'facts_sha256',context->'week_facts_sha256',
  'validation_actor_user_id',context->'validation_actor_user_id','source_cas',r.source_cas);
 update private.weekly_source_agency_timesheet_change_requests set native_receipts=native_receipts||jsonb_build_object('validation_write_frame',frame),
  version=version+1,updated_at_utc=transaction_timestamp() where id=r.id;
 return frame;
end;
$function$;

create or replace function private.weekly_source_agency_validation_write_assert_v1(p_timesheet_id uuid,p_snapshot jsonb,p_actor_user_id uuid,p_outbox_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype; t public.timesheets%rowtype;
 f public.timesheets_financials%rowtype; frame jsonb; facts jsonb; v public.timesheet_validations%rowtype;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where current_timesheet_id=p_timesheet_id and state='ACTIVE';
 frame:=r.native_receipts->'validation_write_frame';
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict f from public.timesheets_financials where id=r.current_financial_id and is_current;
 select * into strict v from public.timesheet_validations where timesheet_id=p_timesheet_id;
 facts:=private.weekly_source_agency_week_facts_v1(p_timesheet_id);
 if r.phase<>'AUTHORISED' or frame->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_AUTHORISED_WRITE_FRAME_V1'
  or frame->>'mode' is distinct from 'AUTHORISED_VALIDATION' or frame->>'transaction_id' is distinct from pg_current_xact_id()::text
  or frame->>'backend_pid' is distinct from pg_backend_pid()::text or frame->>'request_id' is distinct from r.id::text
  or frame->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
  or frame->>'phase_actor_user_id' is distinct from r.updated_by_user_id::text
  or frame->>'timesheet_id' is distinct from t.timesheet_id::text or frame->>'timesheet_version' is distinct from t.version::text
  or frame->'source_cas' is distinct from r.source_cas or r.source_cas is distinct from private.weekly_source_bulk_source_cas_v1(r.source_cycle_id,array[r.client_id])
  or p_outbox_id is null or frame->>'outbox_id' is distinct from p_outbox_id::text or p_outbox_id is distinct from r.outbox_id
  or r.outbox_reason is distinct from 'CONTEXT_CHANGED'::public.ts_fin_reason_enum
  or p_snapshot is null or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_CANONICAL_SNAPSHOT_V1',p_snapshot),'hex')
    is distinct from frame->>'snapshot_sha256'
  or (p_actor_user_id is not null and p_actor_user_id is distinct from r.updated_by_user_id)
  or f.paid_at_utc is not null or f.locked_by_invoice_id is not null or f.id::text is distinct from frame->>'prior_financial_id'
  or f.timesheet_version is distinct from t.version or t.authorised_at_server is null or t.revoked_at is not null
  or f.authorised_at_utc is distinct from t.authorised_at_server
  or f.authorised_by_user_id::text is distinct from r.native_receipts#>>'{authorise,phase_actor_user_id}'
  or frame->>'timesheet_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('AGENCY_VALIDATION_TIMESHEET_V1',to_jsonb(t)),'hex')
  or frame->>'prior_financial_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('AGENCY_VALIDATION_PRIOR_ROW_V1',to_jsonb(f)-array['is_current','updated_at']),'hex')
  or frame->>'facts_sha256' is distinct from facts->>'facts_hash'
  or v.validation_source_kind is distinct from 'AGENCY_INVOICE_WEEK' or v.last_source is not null
  or v.validation_source_publication_id is distinct from r.source_publication_id
  or encode(v.validation_source_facts_sha256,'hex') is distinct from facts->>'facts_hash'
  or not exists(select 1 from public.ts_financials_outbox q where q.id=p_outbox_id and q.timesheet_id=p_timesheet_id
    and q.reason=r.outbox_reason and q.attempt_count>=1 and q.next_attempt_at>transaction_timestamp()) then
  raise exception 'AGENCY_CHANGE_GENUINE_AUTHORISED_WRITE_FRAME_REQUIRED' using errcode='55000';end if;
 perform private.weekly_source_agency_snapshot_provenance_assert_v1(r.id,p_snapshot);
 return frame;
end;
$function$;

create or replace function private.weekly_source_agency_validation_write_observe_v1(p_timesheet_id uuid,p_snapshot jsonb,p_outbox_id uuid)
returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype; t public.timesheets%rowtype;
 f public.timesheets_financials%rowtype; prior public.timesheets_financials%rowtype;
 frame jsonb; observation jsonb; flags jsonb; signature jsonb; actual_signature text; facts jsonb;
begin
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where current_timesheet_id=p_timesheet_id and state='ACTIVE' for update;
 frame:=r.native_receipts->'validation_write_frame';
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict f from public.timesheets_financials where timesheet_id=p_timesheet_id and is_current;
 select * into strict prior from public.timesheets_financials where id=(frame->>'prior_financial_id')::uuid;
 facts:=private.weekly_source_agency_week_facts_v1(t.timesheet_id);
 if r.phase<>'AUTHORISED' or frame->>'transaction_id' is distinct from pg_current_xact_id()::text
  or frame->>'backend_pid' is distinct from pg_backend_pid()::text or frame->>'request_id' is distinct from r.id::text
  or frame->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
  or frame->>'snapshot_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_CANONICAL_SNAPSHOT_V1',p_snapshot),'hex')
  or frame->>'outbox_id' is distinct from p_outbox_id::text or f.id=prior.id or prior.is_current
  or frame->>'timesheet_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('AGENCY_VALIDATION_TIMESHEET_V1',to_jsonb(t)),'hex')
  or frame->>'prior_financial_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('AGENCY_VALIDATION_PRIOR_ROW_V1',to_jsonb(prior)-array['is_current','updated_at']),'hex')
  or frame->>'facts_sha256' is distinct from facts->>'facts_hash'
  or f.timesheet_version is distinct from t.version or f.paid_at_utc is not null or f.locked_by_invoice_id is not null
  or f.authorised_at_utc is distinct from t.authorised_at_server or f.authorised_by_user_id is distinct from prior.authorised_by_user_id
  or f.actual_schedule_json is distinct from t.actual_schedule_json
  or f.processing_status::text is distinct from case when facts->'complete'='true'::jsonb then 'READY_FOR_INVOICE' else 'READY_FOR_HR' end
  or not exists(select 1 from public.ts_financials_outbox q where q.id=p_outbox_id and q.timesheet_id=t.timesheet_id and q.reason='CONTEXT_CHANGED') then
  raise exception 'AGENCY_CHANGE_VALIDATION_NEW_ROW_UNPROVED' using errcode='55000';end if;
 -- Retain only this genuinely new native row/signature under the current
 -- XID/PID before the SAME sole segment writer rederives its native flags.
 signature:=public.timesheet_lifecycle_guard_signature_v1(t.timesheet_id,r.contract_week_id,false);
 actual_signature:=nullif(btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature')),'');
 if actual_signature is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000';end if;
 update private.weekly_source_agency_timesheet_change_requests set current_financial_id=f.id,current_row_signature=actual_signature,
  version=version+1,updated_at_utc=transaction_timestamp() where id=r.id;
 flags:=private.weekly_source_agency_segment_flags_apply_v1(r.id);
 select * into strict f from public.timesheets_financials where id=f.id and is_current;
 observation:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_VALIDATION_WRITE_OBSERVED_V1','request_id',r.id,
  'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'financial_id',f.id,'prior_financial_id',prior.id,
  'observed_outbox_id',p_outbox_id,'publication_id',r.source_publication_id,'facts_sha256',facts->>'facts_hash',
  'validation_actor_user_id',frame->'validation_actor_user_id','phase_actor_user_id',r.updated_by_user_id,
  'financial_row_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_VALIDATION_RECOMPUTE_ROW_V1',to_jsonb(f)),'hex'),
  'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid());
 signature:=public.timesheet_lifecycle_guard_signature_v1(t.timesheet_id,r.contract_week_id,false);
 actual_signature:=nullif(btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature')),'');
 if actual_signature is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000';end if;
 update private.weekly_source_agency_timesheet_change_requests set native_receipts=(native_receipts-'validation_write_frame')||
   jsonb_build_object('validation_write_observation',observation,'segment_flags',flags),current_row_signature=actual_signature,
  version=version+1,updated_at_utc=transaction_timestamp() where id=r.id;
end;
$function$;

create or replace function public.weekly_source_agency_validation_apply_v1(p_request_id uuid,p_expected_request_version bigint,
 p_expected_context_sha256 text,p_snapshot jsonb)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare context jsonb; r private.weekly_source_agency_timesheet_change_requests%rowtype;
 native_result record; observation jsonb; receipt jsonb; f public.timesheets_financials%rowtype;
begin
 context:=private.weekly_source_agency_validation_context_v1(p_request_id);
 if context->>'context_sha256' is distinct from p_expected_context_sha256
  or context->>'request_version' is distinct from p_expected_request_version::text then
  raise exception 'AGENCY_CHANGE_WORKER_CONTEXT_CHANGED' using errcode='40001';end if;
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 select * into strict native_result from public.tsfin_write_snapshots_and_complete(jsonb_build_array(
  jsonb_build_object('outbox_id',r.outbox_id,'timesheet_id',r.current_timesheet_id,'snapshot',p_snapshot)));
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 observation:=r.native_receipts->'validation_write_observation';
 select * into strict f from public.timesheets_financials where id=r.current_financial_id and is_current;
 if native_result.ok_count is distinct from 1 or native_result.fail_count is distinct from 0 or native_result.errors is distinct from '[]'::jsonb
  or observation->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_NATIVE_VALIDATION_WRITE_OBSERVED_V1'
  or observation->>'request_id' is distinct from r.id::text or observation->>'observed_outbox_id' is distinct from r.outbox_id::text
  or observation->>'transaction_id' is distinct from pg_current_xact_id()::text or observation->>'backend_pid' is distinct from pg_backend_pid()::text
  or observation->>'financial_id' is distinct from f.id::text or observation->>'financial_row_sha256' is distinct from
    encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_VALIDATION_RECOMPUTE_ROW_V1',to_jsonb(f)),'hex')
  or exists(select 1 from public.ts_financials_outbox where id=r.outbox_id) then
  raise exception 'AGENCY_CHANGE_NATIVE_VALIDATION_RECOMPUTE_UNPROVED' using errcode='55000';end if;
 receipt:=(observation-'schema_version')||jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_VALIDATION_RECOMPUTE_V1',
  'native_ok_count',native_result.ok_count,'native_fail_count',native_result.fail_count);
 update private.weekly_source_agency_timesheet_change_requests set native_receipts=(native_receipts-'validation_write_observation')||
  jsonb_build_object('validation_recompute',receipt),version=version+1,updated_at_utc=transaction_timestamp(),last_refusal_code=null
  where id=r.id returning * into r;
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_VALIDATION_APPLY_RESULT_V1','request_id',r.id,'request_version',r.version,
  'phase',r.phase,'phase_actor_user_id',r.updated_by_user_id,'timesheet_id',r.current_timesheet_id,
  'timesheet_version',r.current_timesheet_version,'outbox_id',r.outbox_id,'financial_id',r.current_financial_id,
  'native_write_observed',true,'native_queue_completed',true,'validation_receipt',receipt);
end;
$function$;

create or replace function private.weekly_source_agency_financial_frame_open_v1(
  p_request_id uuid,p_mode text,p_snapshot jsonb,p_outbox_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  r private.weekly_source_agency_timesheet_change_requests%rowtype;
  t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
  queue public.ts_financials_outbox%rowtype; claim jsonb; purpose jsonb; frame jsonb; receipts jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_mode not in('MANUAL','RECOMPUTE') or p_mode is null
    or jsonb_typeof(p_snapshot) is distinct from 'object' or octet_length(p_snapshot::text)>1048576 then
    raise exception 'AGENCY_CHANGE_FINANCIAL_FRAME_INVALID' using errcode='22023'; end if;
  select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
  r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,
    r.initial_row_signature,r.request_key,r.updated_by_user_id);
  if r.phase='AUTHORISED' and p_mode='RECOMPUTE' then
    return private.weekly_source_agency_validation_frame_open_v1(r.id,p_snapshot,p_outbox_id);
  end if;
  if r.state<>'ACTIVE' or (p_mode='MANUAL' and r.phase<>'UNAUTHORISED')
    or (p_mode='RECOMPUTE' and r.phase<>'RECOMPUTE_PENDING') then
    raise exception 'AGENCY_CHANGE_FINANCIAL_PHASE_INVALID' using errcode='55000'; end if;
  if p_mode='RECOMPUTE' then
    select * into strict queue from public.ts_financials_outbox where id=p_outbox_id for update;
    if p_outbox_id is distinct from r.outbox_id or queue.timesheet_id is distinct from r.current_timesheet_id
      or queue.reason is distinct from r.outbox_reason then
      raise exception 'AGENCY_CHANGE_NATIVE_OUTBOX_CHANGED' using errcode='40001'; end if;
  elsif p_outbox_id is not null then
    raise exception 'AGENCY_CHANGE_FINANCIAL_FRAME_INVALID' using errcode='22023';
  end if;
  select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id for update;
  select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current for update;
  if t.version is distinct from r.current_timesheet_version
    or f.timesheet_version is distinct from t.version or f.id is distinct from r.current_financial_id
    or f.locked_by_invoice_id is not null or t.authorised_at_server is not null
    or exists(select 1 from public.invoice_lines l where l.timesheet_id=t.timesheet_id) then
    raise exception 'AGENCY_CHANGE_FINANCIAL_BEFORE_CHANGED' using errcode='40001'; end if;
  if p_snapshot->>'timesheet_id' is distinct from t.timesheet_id::text
    or p_snapshot->>'timesheet_version' is distinct from t.version::text
    or p_snapshot->'actual_schedule_json' is distinct from r.native_receipts#>'{original_capture,schedule}'
    or (p_mode='RECOMPUTE' and t.actual_schedule_json is distinct from r.native_receipts#>'{original_capture,schedule}') then
    raise exception 'AGENCY_CHANGE_CANONICAL_TARGET_CHANGED' using errcode='40001'; end if;
  -- The same existing policy/unit guards remain the financial admission owners.
  perform public._ctms_assert_tsfin_snapshot_policy_v1(t.timesheet_id,p_snapshot);
  claim:=private.weekly_source_agency_original_claim_recheck_v1(r.id);
  purpose:=private.weekly_source_agency_paid_write_purpose_v1(r.id);
  -- Unavailable original hours stay unavailable to protection. The financial
  -- purpose preserves the actual signed/document/old-financial identities;
  -- it does not relabel a document view as an immutable worker claim.
  frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_FINANCIAL_WRITE_FRAME_V1',
    'request_id',r.id,'request_sha256',encode(r.request_sha256,'hex'),'mode',p_mode,
    'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid(),
    'phase_actor_user_id',r.updated_by_user_id,'timesheet_id',t.timesheet_id,'timesheet_version',t.version,
    'prior_financial_id',f.id,'prior_financial_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_PRIOR_FINANCIAL_V1',to_jsonb(f)-array['is_current','updated_at']),'hex'),
    'snapshot_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_CANONICAL_SNAPSHOT_V1',p_snapshot),'hex'),
    'source_cas',r.source_cas,'original_submission_proved',claim->'available',
    'paid_write_purpose_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_PAID_WRITE_PURPOSE_V1',purpose),'hex'),
    'original_submission_sha256',claim->'claim_sha256',
    'original_submission_state',claim->'submission_state','prior_financial_updated_at',f.updated_at,'outbox_id',p_outbox_id);
  receipts:=r.native_receipts||jsonb_build_object('financial_write_frame',frame);
  if octet_length(receipts::text)>65536 then
    raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED' using errcode='54000'; end if;
  update private.weekly_source_agency_timesheet_change_requests set native_receipts=receipts,
    version=version+1,updated_at_utc=transaction_timestamp() where id=r.id;
  return frame;
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_CHANGE_FINANCIAL_BEFORE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_financial_write_assert_v1(
  p_timesheet_id uuid,p_snapshot jsonb,p_actor_user_id uuid,p_outbox_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  r private.weekly_source_agency_timesheet_change_requests%rowtype;
  t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
  frame jsonb; claim jsonb; purpose jsonb; invoice public.invoices%rowtype;
  keys constant text[]:=array['schema_version','request_id','request_sha256','mode','transaction_id','backend_pid',
    'phase_actor_user_id','timesheet_id','timesheet_version','prior_financial_id','prior_financial_sha256',
    'snapshot_sha256','source_cas','original_submission_proved','paid_write_purpose_sha256',
    'original_submission_sha256','original_submission_state','prior_financial_updated_at','outbox_id'];
begin
  select * into r from private.weekly_source_agency_timesheet_change_requests
    where current_timesheet_id=p_timesheet_id and state='ACTIVE';
  if not found then return null; end if;
  perform private.weekly_source_query_require_service_v1();
  if r.phase='AUTHORISED' then
    return private.weekly_source_agency_validation_write_assert_v1(p_timesheet_id,p_snapshot,p_actor_user_id,p_outbox_id);
  end if;
  frame:=r.native_receipts->'financial_write_frame';
  if jsonb_typeof(frame) is distinct from 'object' or not(frame ?& keys) or frame-keys<>'{}'::jsonb
    or frame->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_FINANCIAL_WRITE_FRAME_V1'
    or frame->>'transaction_id' is distinct from pg_current_xact_id()::text
    or frame->>'backend_pid' is distinct from pg_backend_pid()::text
    or frame->>'request_id' is distinct from r.id::text
    or frame->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
    or frame->>'phase_actor_user_id' is distinct from r.updated_by_user_id::text
    or frame->>'timesheet_id' is distinct from r.current_timesheet_id::text
    or frame->>'timesheet_version' is distinct from r.current_timesheet_version::text
    or frame->'source_cas' is distinct from r.source_cas
    or (frame->>'mode'='MANUAL' and (r.phase<>'UNAUTHORISED' or p_outbox_id is not null))
    or (frame->>'mode'='RECOMPUTE' and (r.phase<>'RECOMPUTE_PENDING'
      or frame->>'outbox_id' is distinct from r.outbox_id::text))
    or frame->>'mode' is null or frame->>'mode' not in('MANUAL','RECOMPUTE')
    or coalesce(frame->>'snapshot_sha256','')!~'^[0-9a-f]{64}$'
    or coalesce(frame->>'prior_financial_sha256','')!~'^[0-9a-f]{64}$'
    or jsonb_typeof(frame->'original_submission_proved') is distinct from 'boolean'
    or coalesce(frame->>'paid_write_purpose_sha256','')!~'^[0-9a-f]{64}$'
    or (frame->'original_submission_proved'='true'::jsonb
      and coalesce(frame->>'original_submission_sha256','')!~'^[0-9a-f]{64}$')
    or (frame->'original_submission_proved'='false'::jsonb
      and (frame->'original_submission_sha256' is distinct from 'null'::jsonb
        or frame->'original_submission_state' is distinct from 'null'::jsonb))
    or (p_actor_user_id is not null and frame->>'phase_actor_user_id' is distinct from p_actor_user_id::text)
    or (p_outbox_id is not null and frame->>'outbox_id' is distinct from p_outbox_id::text)
    or (p_snapshot is not null and encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_CANONICAL_SNAPSHOT_V1',p_snapshot),'hex') is distinct from frame->>'snapshot_sha256') then
    raise exception 'AGENCY_CHANGE_GENUINE_FINANCIAL_FRAME_REQUIRED' using errcode='55000'; end if;
  -- Recheck immutable original input rather than trusting the stored digest.
  if private.weekly_source_agency_change_request_sha256_v1(r.contract_week_id,r.reason,
      r.initial_row_signature,r.request_key,r.actor_user_id,r.native_receipts->'original_capture')
    is distinct from r.request_sha256 then
    raise exception 'AGENCY_CHANGE_ORIGINAL_REQUEST_DIGEST_INVALID' using errcode='55000'; end if;
  if current_setting('transaction_isolation') is distinct from 'read committed' then
    raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001'; end if;
  if private.weekly_source_pay_actor_allowed_v1(r.updated_by_user_id) is distinct from true then
    raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
  perform private.weekly_source_office_authority_v1(r.updated_by_user_id,'VIEW_PAY_WORK',
    r.source_group_id,r.client_id,r.week_ending_date);
  if private.weekly_source_bulk_source_cas_v1(r.source_cycle_id,array[r.client_id]) is distinct from r.source_cas then
    raise exception 'AGENCY_CHANGE_ORIGINAL_SOURCE_CAS_CHANGED' using errcode='40001'; end if;
  if (private.weekly_source_effective_rule_set_v1(r.client_id,r.source_cycle_id)->>'rule_set_version_id')
    is distinct from r.rule_set_version_id::text then
    raise exception 'AGENCY_CHANGE_OPERATIONAL_RULE_UNAVAILABLE' using errcode='55000'; end if;
  -- The genuine phase owner acquired original D1 before family/financial rows.
  -- Re-reading here does not invent a second lock-order or an invoice chooser.
  if r.original_draft_invoice_id is not null then
    select * into strict invoice from public.invoices where id=r.original_draft_invoice_id;
    if not r.return_hold or invoice.invoice_no is distinct from r.original_draft_invoice_no
      or invoice.client_id is distinct from r.client_id or invoice.type is distinct from 'INVOICE'
      or invoice.status not in('DRAFT','ON_HOLD') or invoice.issued_at_utc is not null or invoice.paid_at_utc is not null then
      raise exception 'AGENCY_CHANGE_ORIGINAL_D1_CHANGED' using errcode='40001'; end if;
  end if;
  select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
  select * into strict f from public.timesheets_financials where timesheet_id=p_timesheet_id and is_current;
  if t.is_current is distinct from true or t.version is distinct from r.current_timesheet_version
    or t.contract_id is distinct from r.contract_id or t.week_ending_date is distinct from r.week_ending_date
    or btrim(t.booking_id) is distinct from r.canonical_family_booking_id
    or t.authorised_at_server is not null or t.actual_schedule_json is distinct from r.native_receipts#>'{original_capture,schedule}'
    or f.id::text is distinct from frame->>'prior_financial_id' or f.timesheet_version is distinct from t.version
    or f.locked_by_invoice_id is not null or exists(select 1 from public.invoice_lines l where l.timesheet_id=t.timesheet_id)
    or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_PRIOR_FINANCIAL_V1',to_jsonb(f)-array['is_current','updated_at']),'hex')
      is distinct from frame->>'prior_financial_sha256' then
    raise exception 'AGENCY_CHANGE_FINANCIAL_BEFORE_CHANGED' using errcode='40001'; end if;
  claim:=private.weekly_source_agency_original_claim_recheck_v1(r.id);
  purpose:=private.weekly_source_agency_paid_write_purpose_v1(r.id);
  if claim->'available' is distinct from frame->'original_submission_proved'
    or coalesce(claim->'claim_sha256','null'::jsonb) is distinct from frame->'original_submission_sha256'
    or coalesce(claim->'submission_state','null'::jsonb) is distinct from frame->'original_submission_state'
    or encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_PAID_WRITE_PURPOSE_V1',purpose),'hex')
      is distinct from frame->>'paid_write_purpose_sha256' then
    raise exception 'AGENCY_CHANGE_NATIVE_PAID_WRITE_PURPOSE_CHANGED' using errcode='40001'; end if;
  return frame;
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_CHANGE_GENUINE_FINANCIAL_FRAME_REQUIRED' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_financial_write_observe_v1(
  p_timesheet_id uuid,p_snapshot jsonb,p_outbox_id uuid
) returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
 prior public.timesheets_financials%rowtype; frame jsonb; observation jsonb; receipts jsonb; signature jsonb; segment_flags_receipt jsonb;
begin
 select * into r from private.weekly_source_agency_timesheet_change_requests
  where current_timesheet_id=p_timesheet_id and state='ACTIVE' for update;
 if not found then return; end if;
 perform private.weekly_source_query_require_service_v1();
 if r.phase='AUTHORISED' then
  perform private.weekly_source_agency_validation_write_observe_v1(p_timesheet_id,p_snapshot,p_outbox_id);
  return;
 end if;
 frame:=r.native_receipts->'financial_write_frame';
 if frame->>'transaction_id' is distinct from pg_current_xact_id()::text
  or frame->>'backend_pid' is distinct from pg_backend_pid()::text
  or frame->>'request_id' is distinct from r.id::text
  or frame->>'snapshot_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
   'WEEKLY_SOURCE_AGENCY_CANONICAL_SNAPSHOT_V1',p_snapshot),'hex')
  or frame->>'outbox_id' is distinct from p_outbox_id::text then
  raise exception 'AGENCY_CHANGE_FINANCIAL_OBSERVATION_FRAME_INVALID' using errcode='55000'; end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict f from public.timesheets_financials where timesheet_id=p_timesheet_id and is_current;
 select * into strict prior from public.timesheets_financials where id=(frame->>'prior_financial_id')::uuid;
 if f.id=prior.id or f.timesheet_version is distinct from t.version or prior.is_current
  or f.paid_at_utc is not null or f.locked_by_invoice_id is not null
  or t.version is distinct from r.current_timesheet_version or t.is_current is distinct from true
  or f.actual_schedule_json is distinct from r.native_receipts#>'{original_capture,schedule}'
  or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_PRIOR_FINANCIAL_V1',to_jsonb(prior)-array['is_current','updated_at']),'hex')
    is distinct from frame->>'prior_financial_sha256' then
  raise exception 'AGENCY_CHANGE_NEW_FINANCIAL_ROW_UNPROVED' using errcode='55000'; end if;
 if p_outbox_id is not null and not exists(select 1 from public.ts_financials_outbox q
  where q.id=p_outbox_id and q.id=r.outbox_id and q.timesheet_id=t.timesheet_id and q.reason=r.outbox_reason) then
  raise exception 'AGENCY_CHANGE_NATIVE_OUTBOX_CHANGED' using errcode='40001'; end if;
 -- Retain the genuine new row under the original native XID/PID frame before
 -- deriving its flags. The same existing segment writer runs after EVERY
 -- observed request recompute; its actual post-write row is what is hashed.
 update private.weekly_source_agency_timesheet_change_requests set current_financial_id=f.id,
  version=version+1,updated_at_utc=transaction_timestamp() where id=r.id returning * into r;
 segment_flags_receipt:=private.weekly_source_agency_segment_flags_apply_v1(r.id);
 select * into strict f from public.timesheets_financials where id=r.current_financial_id and is_current;
 observation:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_FINANCIAL_WRITE_V1',
  'observed_outbox_id',p_outbox_id,'timesheet_id',t.timesheet_id,'timesheet_version',t.version,
  'financial_id',f.id,'financial_row_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_AGENCY_RECOMPUTE_ROW_V1',to_jsonb(f)),'hex'),
  'prior_financial_id',prior.id,'prior_financial_sha256',frame->'prior_financial_sha256',
  'prior_paid_marker_retained',prior.paid_at_utc is not null,
  'prior_financial_updated_at_before',frame->'prior_financial_updated_at',
  'prior_financial_updated_at_after',prior.updated_at,
  'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid(),
  'native_phase_actor_user_id',frame->'phase_actor_user_id','snapshot_sha256',frame->'snapshot_sha256');
 receipts:=(r.native_receipts-'financial_write_frame')||jsonb_build_object(
   case when p_outbox_id is null then 'manual_financial_write' else 'recompute' end,observation,
   'segment_flags',segment_flags_receipt);
 if octet_length(receipts::text)>65536 then
  raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED' using errcode='54000'; end if;
 -- A newly written row is retained before queue success. No phase is completed
 -- from a count, queue absence or financial status; the same native core resumes.
 update private.weekly_source_agency_timesheet_change_requests set native_receipts=receipts,
  current_financial_id=f.id,version=version+1,updated_at_utc=transaction_timestamp() where id=r.id;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NEW_FINANCIAL_ROW_UNPROVED' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_segment_flags_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
 e public.weekly_work_events%rowtype; i public.weekly_discrepancy_incidents%rowtype;
 comparison public.weekly_issue_comparison_revisions%rowtype;
 response public.weekly_discrepancy_events%rowtype;
 segment jsonb; source_entry jsonb; flag jsonb; flags jsonb:='[]'::jsonb; basis jsonb:='[]'::jsonb;
 event_id uuid; count_value integer; active_protection boolean; disputed boolean;
 candidate_minutes numeric; source_minutes numeric; cutoff timestamptz; frame jsonb; result jsonb;
 native_query_facts jsonb; query_item jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001';end if;
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 if r.state<>'ACTIVE' or r.phase not in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT','AUTHORISED')
  or private.weekly_source_agency_change_request_sha256_v1(r.contract_week_id,r.reason,r.initial_row_signature,
   r.request_key,r.actor_user_id,r.native_receipts->'original_capture') is distinct from r.request_sha256 then
  raise exception 'AGENCY_CHANGE_ORIGINAL_REQUEST_DIGEST_INVALID' using errcode='55000';end if;
 if private.weekly_source_pay_actor_allowed_v1(r.updated_by_user_id) is distinct from true then
  raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501';end if;
 perform private.weekly_source_office_authority_v1(r.updated_by_user_id,'VIEW_PAY_WORK',r.source_group_id,r.client_id,r.week_ending_date);
 if private.weekly_source_bulk_source_cas_v1(r.source_cycle_id,array[r.client_id]) is distinct from r.source_cas
  or private.weekly_source_effective_rule_set_v1(r.client_id,r.source_cycle_id)->>'rule_set_version_id'
    is distinct from r.rule_set_version_id::text then
  raise exception 'AGENCY_CHANGE_ORIGINAL_SOURCE_CAS_CHANGED' using errcode='40001';end if;
 select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
 select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
 if t.timesheet_id is distinct from r.initial_timesheet_id or t.version is distinct from r.current_timesheet_version
  or t.contract_id is distinct from r.contract_id or t.week_ending_date is distinct from r.week_ending_date
  or t.is_current is distinct from true or t.archived_at_utc is not null
  or f.id is distinct from r.current_financial_id or f.timesheet_version is distinct from t.version
  or f.locked_by_invoice_id is not null or exists(select 1 from public.invoice_lines where timesheet_id=t.timesheet_id)
  or t.actual_schedule_json is distinct from r.native_receipts#>'{original_capture,schedule}'
  or f.actual_schedule_json is distinct from t.actual_schedule_json
  or f.invoice_breakdown_json->>'mode' is distinct from 'SEGMENTS'
  or jsonb_typeof(f.invoice_breakdown_json->'segments') is distinct from 'array'
  or jsonb_array_length(f.invoice_breakdown_json->'segments')>100
  or jsonb_array_length(f.invoice_breakdown_json->'segments')<>jsonb_array_length(t.actual_schedule_json) then
  raise exception 'AGENCY_CHANGE_SEGMENT_NATIVE_TARGET_CHANGED' using errcode='40001';end if;
 -- During the genuine E7/E25/E26 observation, row signature/currentness has
 -- already changed. Only its existing native frame, actual XID/PID and snapshot
 -- cut can admit that intermediate phase; no caller assertion is accepted.
 if r.phase in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING') then
  frame:=r.native_receipts->'financial_write_frame';
  if frame->>'request_id' is distinct from r.id::text
   or frame->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
   or frame->>'transaction_id' is distinct from pg_current_xact_id()::text
   or frame->>'backend_pid' is distinct from pg_backend_pid()::text
   or frame->>'phase_actor_user_id' is distinct from r.updated_by_user_id::text
   or frame->>'timesheet_id' is distinct from t.timesheet_id::text
   or frame->>'timesheet_version' is distinct from t.version::text
   or frame->'source_cas' is distinct from r.source_cas
   or frame->>'mode' not in('MANUAL','RECOMPUTE') or frame->>'mode' is null then
   raise exception 'AGENCY_CHANGE_GENUINE_FINANCIAL_FRAME_REQUIRED' using errcode='55000';end if;
 else
  r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,
    r.initial_row_signature,r.request_key,r.updated_by_user_id);
 end if;
 cutoff:=transaction_timestamp();
 if r.phase='AUTHORISED' then
  if r.native_receipts#>>'{authorise,result,ok}' is distinct from 'true'
   or r.native_receipts#>>'{authorise,result,timesheet_id}' is distinct from t.timesheet_id::text
   or (r.native_receipts#>>'{authorise,financial_id}' is distinct from f.id::text
    and coalesce((r.native_receipts#>>'{validation_write_frame,schema_version}'='WEEKLY_SOURCE_AGENCY_AUTHORISED_WRITE_FRAME_V1'
      and r.native_receipts#>>'{validation_write_frame,request_id}'=r.id::text
      and r.native_receipts#>>'{validation_write_frame,request_sha256}'=encode(r.request_sha256,'hex')
      and r.native_receipts#>>'{validation_write_frame,transaction_id}'=pg_current_xact_id()::text
      and r.native_receipts#>>'{validation_write_frame,backend_pid}'=pg_backend_pid()::text
      and r.native_receipts#>>'{validation_write_frame,prior_financial_id}'=r.native_receipts#>>'{validation_refresh,financial_id}'
      and exists(select 1 from public.timesheets_financials prior where prior.id::text=r.native_receipts#>>'{validation_write_frame,prior_financial_id}'
        and not prior.is_current and prior.timesheet_id=t.timesheet_id and prior.authorised_at_utc=t.authorised_at_server)),false) is distinct from true)
   or (r.native_receipts#>>'{authorise,authorised_at_server}')::timestamptz is distinct from t.authorised_at_server
   or f.authorised_by_user_id::text is distinct from r.native_receipts#>>'{authorise,phase_actor_user_id}'
   or t.authorised_at_server is null or t.revoked_at is not null then
   raise exception 'AGENCY_CHANGE_GENUINE_AUTHORISE_RECEIPT_REQUIRED' using errcode='55000';end if;
  cutoff:=t.authorised_at_server;
 elsif t.authorised_at_server is not null then
  raise exception 'AGENCY_CHANGE_SEGMENT_NATIVE_TARGET_CHANGED' using errcode='40001';end if;
 native_query_facts:=private.weekly_source_agency_native_query_facts_v1(r.id);
 if native_query_facts->'ok' is distinct from 'true'::jsonb or native_query_facts->>'code' is distinct from 'OK'
  or jsonb_typeof(native_query_facts->'hours_incidents') is distinct from 'array'
  or jsonb_typeof(native_query_facts->'manual_reviews') is distinct from 'array'
  or jsonb_typeof(native_query_facts->'blocked') is distinct from 'boolean'
  or coalesce(native_query_facts->>'query_state_sha256','')!~'^[0-9a-f]{64}$'
  or native_query_facts#>>'{scope,root_timesheet_id}' is distinct from t.timesheet_id::text
  or native_query_facts#>>'{scope,root_version}' is distinct from t.version::text
  or native_query_facts#>>'{scope,candidate_id}' is distinct from r.candidate_id::text
  or native_query_facts#>>'{scope,client_id}' is distinct from r.client_id::text
  or native_query_facts#>>'{scope,contract_id}' is distinct from r.contract_id::text
  or native_query_facts#>>'{scope,week_ending_date}' is distinct from r.week_ending_date::text then
  raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
 for segment in select value from jsonb_array_elements(f.invoice_breakdown_json->'segments') loop
  if jsonb_typeof(segment) is distinct from 'object' or nullif(segment->>'segment_id','') is null
   or segment->>'work_event_id'!~'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'
   or segment->>'work_event_id' is null or segment->>'source_shift_id' is distinct from segment->>'work_event_id' then
   raise exception 'AGENCY_CHANGE_SEGMENT_EVENT_UNBOUND' using errcode='55000';end if;
  event_id:=(segment->>'work_event_id')::uuid;
  select count(*) into count_value from jsonb_array_elements(t.actual_schedule_json) s where s->>'work_event_id'=event_id::text;
  if count_value<>1 then raise exception 'AGENCY_CHANGE_SEGMENT_EVENT_AMBIGUOUS' using errcode='55000';end if;
  select value into strict source_entry from jsonb_array_elements(t.actual_schedule_json) s(value) where value->>'work_event_id'=event_id::text;
  select * into strict e from public.weekly_work_events where id=event_id;
  if e.candidate_id is distinct from r.candidate_id or e.client_id is distinct from r.client_id
   or e.first_source_group_id is distinct from r.source_group_id or e.work_date::text is distinct from source_entry->>'date'
   or segment->>'date' is distinct from source_entry->>'date' or segment->>'start' is distinct from source_entry->>'start'
   or segment->>'end' is distinct from source_entry->>'end'
   or (segment->>'break_mins')::numeric is distinct from (source_entry->>'break_minutes')::numeric then
   raise exception 'AGENCY_CHANGE_SEGMENT_EVENT_UNBOUND' using errcode='55000';end if;
  active_protection:=exists(select 1 from private.weekly_source_check_only_shift_protections p
   where p.candidate_id=e.candidate_id and p.work_event_id=e.id and p.state='ACTIVE');
  if active_protection and exists(select 1 from private.weekly_source_check_only_shift_protections p
   where p.candidate_id=e.candidate_id and p.work_event_id=e.id and p.state='ACTIVE'
    and (p.client_id is distinct from r.client_id or p.contract_id is distinct from r.contract_id
      or p.week_ending_date is distinct from r.week_ending_date or p.work_date is distinct from e.work_date)) then
   raise exception 'AGENCY_CHANGE_PROTECTION_EVENT_SCOPE_CHANGED' using errcode='40001';end if;
  disputed:=false;i:=null;comparison:=null;response:=null;query_item:=null;
  select count(*) into count_value from jsonb_array_elements(native_query_facts->'hours_incidents') q
   where q->>'work_event_id'=e.id::text;
  if count_value>1 then raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
  if count_value=1 then
   select value into strict query_item from jsonb_array_elements(native_query_facts->'hours_incidents') q(value)
    where value->>'work_event_id'=e.id::text;
   if query_item->>'source_group_id' is distinct from r.source_group_id::text
    or query_item->>'candidate_id' is distinct from r.candidate_id::text or query_item->>'client_id' is distinct from r.client_id::text
    or query_item->>'comparison_contract_id' is distinct from r.contract_id::text then
    raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
  end if;
  select * into i from public.weekly_discrepancy_incidents where source_group_id=r.source_group_id and work_event_id=e.id and state='OPEN';
  if found then
   select * into strict comparison from public.weekly_issue_comparison_revisions where id=i.current_comparison_revision_id;
   if query_item->>'id' is distinct from i.id::text or query_item->>'current_comparison_revision_id' is distinct from comparison.id::text
    or query_item->>'material_comparison_fingerprint' is distinct from encode(comparison.material_comparison_fingerprint,'hex')
    or i.candidate_id is distinct from r.candidate_id or i.client_id is distinct from r.client_id
    or comparison.incident_id is distinct from i.id or comparison.contract_id is distinct from r.contract_id
    or comparison.id is distinct from(select id from public.weekly_issue_comparison_revisions
      where incident_id=i.id order by revision_number desc limit 1) then
    raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
   if comparison.issue_family='SOURCE_HOURS_DIFFER' then
    if comparison.source_presence is distinct from 'PRESENT'
     or comparison.candidate_timesheet_id is distinct from r.initial_timesheet_id
     or comparison.candidate_timesheet_revision is distinct from r.initial_timesheet_version
     or comparison.projection_publication_id is distinct from r.source_publication_id
     or comparison.system_start_at_local is distinct from (source_entry->>'date')::date+(source_entry->>'start')::time
     or comparison.system_end_at_local is distinct from (source_entry->>'end_date')::date+(source_entry->>'end')::time
     or comparison.system_break_minutes is distinct from (source_entry->>'break_minutes')::integer then
     raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SOURCE_UNAVAILABLE' using errcode='55000';end if;
    select * into response from public.weekly_discrepancy_events where incident_id=i.id and issue_episode=i.episode_number
     and event_kind='CANDIDATE_RESPONDED' and actor_kind='CANDIDATE' order by occurred_at_utc desc,id desc limit 1;
    if found then
     if response.expected_comparison_fingerprint is distinct from comparison.material_comparison_fingerprint
      or response.projection_publication_id is distinct from comparison.projection_publication_id
      or response.bounded_payload_json->>'choice' is null
      or response.bounded_payload_json->>'choice' not in('CANDIDATE_WRONG','CANDIDATE_CORRECT','NEITHER_CORRECT') then
      raise exception 'AGENCY_CHANGE_NATIVE_QUERY_RESPONSE_UNAVAILABLE' using errcode='55000';end if;
     if response.occurred_at_utc<=cutoff and response.bounded_payload_json->>'choice' in('CANDIDATE_CORRECT','NEITHER_CORRECT') then
      if comparison.candidate_start_at_local is null or comparison.candidate_end_at_local is null
       or comparison.candidate_break_minutes is null or comparison.candidate_end_at_local<=comparison.candidate_start_at_local then
       raise exception 'AGENCY_CHANGE_NATIVE_QUERY_CLAIM_UNAVAILABLE' using errcode='55000';end if;
      candidate_minutes:=extract(epoch from(comparison.candidate_end_at_local-comparison.candidate_start_at_local))/60-comparison.candidate_break_minutes;
      source_minutes:=extract(epoch from(comparison.system_end_at_local-comparison.system_start_at_local))/60-comparison.system_break_minutes;
      if candidate_minutes<=0 or source_minutes<=0 then
       raise exception 'AGENCY_CHANGE_NATIVE_QUERY_CLAIM_UNAVAILABLE' using errcode='55000';end if;
      disputed:=source_minutes<=candidate_minutes;
     end if;
    elsif i.candidate_action_state='RESPONDED' then
     raise exception 'AGENCY_CHANGE_NATIVE_QUERY_RESPONSE_UNAVAILABLE' using errcode='55000';end if;
   end if;
  elsif query_item is not null then
   raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';
  end if;
  flag:=jsonb_build_object('segment_id',segment->>'segment_id','exclude_from_pay',active_protection or disputed);
  flags:=flags||jsonb_build_array(flag);
  basis:=basis||jsonb_build_array(jsonb_build_object('work_event_id',e.id,'source_entry',source_entry,
   'active_protection',active_protection,'disputed_before_authorisation',disputed,
   'incident_id',i.id,'comparison_id',comparison.id,'response_event_id',response.id));
 end loop;
 if (select count(distinct s->>'segment_id') from jsonb_array_elements(flags) s)<>jsonb_array_length(flags) then
  raise exception 'AGENCY_CHANGE_SEGMENT_EVENT_AMBIGUOUS' using errcode='55000';end if;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_SEGMENT_FLAGS_V1','request_id',r.id,
  'request_sha256',encode(r.request_sha256,'hex'),'timesheet_id',t.timesheet_id,'timesheet_version',t.version,
  'financial_id',f.id,'phase_actor_user_id',r.updated_by_user_id,'source_cas',r.source_cas,'flags',flags,'basis',basis,
  'native_query_state_sha256',native_query_facts->'query_state_sha256');
 if octet_length(result::text)>65536 then raise exception 'AGENCY_CHANGE_SEGMENT_FLAGS_BOUND_EXCEEDED' using errcode='54000';end if;
 return result;
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'AGENCY_CHANGE_NATIVE_SEGMENT_FLAGS_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_change_authorise_step_v1(
 p_request_id uuid,p_actual_actor_user_id uuid
) returns private.weekly_source_agency_timesheet_change_requests
language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 before_ts public.timesheets%rowtype; after_ts public.timesheets%rowtype;
 before_fin public.timesheets_financials%rowtype; after_fin public.timesheets_financials%rowtype;
 actor public.tms_users%rowtype; result jsonb; signature jsonb; flags_receipt jsonb; pay_purpose jsonb; receipts jsonb;
 actual_signature text; error_code text; error_state text;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,
  r.initial_row_signature,r.request_key,p_actual_actor_user_id);
 select * into strict actor from public.tms_users where id=p_actual_actor_user_id and is_active;
 if r.state='COMPLETED' then return r;end if;
 if r.phase='AUTHORISED' then
  select * into strict after_ts from public.timesheets where timesheet_id=r.current_timesheet_id;
  select * into strict after_fin from public.timesheets_financials where id=r.current_financial_id and is_current;
  if r.native_receipts#>>'{authorise,result,ok}' is distinct from 'true'
   or r.native_receipts#>>'{authorise,result,operation}' is distinct from 'timesheet_authorise'
   or r.native_receipts#>>'{authorise,result,timesheet_id}' is distinct from after_ts.timesheet_id::text
   or (r.native_receipts#>>'{authorise,financial_id}' is distinct from after_fin.id::text
    and (r.native_receipts#>>'{validation_recompute,schema_version}' is distinct from 'WEEKLY_SOURCE_AGENCY_NATIVE_VALIDATION_RECOMPUTE_V1'
      or r.native_receipts#>>'{validation_recompute,request_id}' is distinct from r.id::text
      or r.native_receipts#>>'{validation_recompute,financial_id}' is distinct from after_fin.id::text
      or r.native_receipts#>>'{validation_recompute,financial_row_sha256}' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_AGENCY_VALIDATION_RECOMPUTE_ROW_V1',to_jsonb(after_fin)),'hex')))
   or (r.native_receipts#>>'{authorise,authorised_at_server}')::timestamptz is distinct from after_ts.authorised_at_server
   or after_fin.authorised_by_user_id::text is distinct from r.native_receipts#>>'{authorise,phase_actor_user_id}'
   or after_ts.authorised_at_server is null or after_ts.revoked_at is not null then
   raise exception 'AGENCY_CHANGE_GENUINE_AUTHORISE_RECEIPT_REQUIRED' using errcode='55000';end if;
  -- A permitted current reader/resumer sees the original genuine phase actor.
  -- Replay never rewrites who approved that native authorisation.
  perform public.weekly_source_agency_week_validation_refresh_v1(r.current_timesheet_id,r.source_publication_id);
  select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
  return r;
 end if;
 if r.phase<>'FINANCIAL_CURRENT' then raise exception 'AGENCY_CHANGE_AUTHORISE_PHASE_NOT_READY' using errcode='55000';end if;
 begin
  if r.updated_by_user_id is distinct from p_actual_actor_user_id then
   update private.weekly_source_agency_timesheet_change_requests set updated_by_user_id=p_actual_actor_user_id,
    version=version+1,updated_at_utc=transaction_timestamp() where id=r.id returning * into r;
   insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,action,after_json,reason,correlation_id)
   values(gen_random_uuid(),transaction_timestamp(),p_actual_actor_user_id,actor.role,'WEEKLY_SOURCE_AGENCY_CHANGE',r.id::text,
    'RESUME_CURRENT_SCOPED_ACTOR',jsonb_build_object('phase',r.phase,'original_creator_user_id',r.actor_user_id,
      'current_resumer_user_id',p_actual_actor_user_id),r.reason,r.request_key);
  end if;
  select * into strict before_ts from public.timesheets where timesheet_id=r.current_timesheet_id for update;
  select * into strict before_fin from public.timesheets_financials where id=r.current_financial_id and is_current for update;
  if before_ts.timesheet_id is distinct from r.initial_timesheet_id or before_ts.version is distinct from r.initial_timesheet_version
   or before_ts.authorised_at_server is not null or before_fin.is_stale is distinct from false
   or before_fin.timesheet_version is distinct from before_ts.version
   or before_fin.processing_status::text not in('PENDING_AUTH','READY_FOR_HR')
   or before_fin.locked_by_invoice_id is not null or exists(select 1 from public.invoice_lines where timesheet_id=before_ts.timesheet_id)
   or r.native_receipts#>>'{queue_completion,financial_id}' is distinct from before_fin.id::text
   or r.native_receipts#>>'{queue_completion,native_ok_count}' is distinct from '1'
   or r.native_receipts#>>'{queue_completion,native_fail_count}' is distinct from '0'
   or r.native_receipts#>>'{recompute,financial_id}' is distinct from before_fin.id::text
   or r.native_receipts#>>'{recompute,financial_row_sha256}' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_RECOMPUTE_ROW_V1',to_jsonb(before_fin)),'hex') then
   raise exception 'AGENCY_INVOICE_TSFIN_NOT_READY' using errcode='55000';end if;
  pay_purpose:=private.weekly_source_agency_paid_write_purpose_v1(r.id);
  flags_receipt:=private.weekly_source_agency_segment_flags_apply_v1(r.id);
  select * into strict before_fin from public.timesheets_financials where id=r.current_financial_id and is_current;
  signature:=public.timesheet_lifecycle_guard_signature_v1(r.current_timesheet_id,r.contract_week_id,false);
  actual_signature:=nullif(btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature')),'');
  if actual_signature is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000';end if;
  receipts:=r.native_receipts||jsonb_build_object('segment_flags',flags_receipt);
  update private.weekly_source_agency_timesheet_change_requests set native_receipts=receipts,current_row_signature=actual_signature,
   version=version+1,updated_at_utc=transaction_timestamp() where id=r.id returning * into r;
  result:=public.timesheet_authorise_generic_atomic(p_timesheet_id=>r.current_timesheet_id,
   p_expected_timesheet_id=>r.current_timesheet_id,p_actor_user_id=>p_actual_actor_user_id,
   p_now_utc=>transaction_timestamp(),p_expected_row_signature=>r.current_row_signature);
  select * into strict after_ts from public.timesheets where timesheet_id=r.current_timesheet_id;
  select * into strict after_fin from public.timesheets_financials where id=r.current_financial_id and is_current;
  if result->>'ok' is distinct from 'true' or result->>'success' is distinct from 'true'
   or result->>'operation' is distinct from 'timesheet_authorise'
   or result->>'timesheet_id' is distinct from r.current_timesheet_id::text
   or result->>'current_timesheet_id' is distinct from r.current_timesheet_id::text
   or result->>'requested_timesheet_id' is distinct from r.current_timesheet_id::text
   or result->>'contract_week_id' is distinct from r.contract_week_id::text
   or result->>'candidate_id' is distinct from r.candidate_id::text
   or result->>'was_stale' is distinct from 'false' or result->>'current_version' is distinct from r.current_timesheet_version::text
   or after_ts.authorised_at_server is null or after_ts.authorised_at_server is distinct from after_fin.authorised_at_utc
   or after_ts.revoked_at is not null or after_fin.authorised_by_user_id is distinct from p_actual_actor_user_id
   or after_fin.processing_status::text not in('READY_FOR_HR','READY_FOR_INVOICE')
   or to_jsonb(after_ts)-array['authorised_at_server','revoked_at','revoked_reason','revoked_by','updated_at']
    is distinct from to_jsonb(before_ts)-array['authorised_at_server','revoked_at','revoked_reason','revoked_by','updated_at']
   or to_jsonb(after_fin)-array['processing_status','authorised_by_user_id','authorised_at_utc','updated_at']
    is distinct from to_jsonb(before_fin)-array['processing_status','authorised_by_user_id','authorised_at_utc','updated_at'] then
   raise exception 'AGENCY_CHANGE_NATIVE_AUTHORISE_POSTCONDITION_UNPROVED' using errcode='55000';end if;
  actual_signature:=nullif(btrim(result->>'backend_row_signature'),'');
  signature:=public.timesheet_lifecycle_guard_signature_v1(r.current_timesheet_id,r.contract_week_id,false);
  if actual_signature is null or actual_signature is distinct from
    btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature')) then
   raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000';end if;
  receipts:=r.native_receipts||jsonb_build_object('authorise',jsonb_build_object(
   'schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_AUTHORISE_V1','request_id',r.id,'phase_actor_user_id',p_actual_actor_user_id,
   'timesheet_id',after_ts.timesheet_id,'timesheet_version',after_ts.version,'financial_id',after_fin.id,
   'authorised_at_server',after_ts.authorised_at_server,'result',result,
   'pay_purpose_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_PAID_WRITE_PURPOSE_V1',pay_purpose),'hex'),
   'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid()));
  if octet_length(receipts::text)>65536 then raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED' using errcode='54000';end if;
  update private.weekly_source_agency_timesheet_change_requests set phase='AUTHORISED',native_receipts=receipts,
   current_row_signature=actual_signature,last_refusal_code=null,version=version+1,updated_at_utc=transaction_timestamp()
   where id=r.id returning * into r;
  perform public.weekly_source_agency_week_validation_refresh_v1(r.current_timesheet_id,r.source_publication_id);
  select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
  insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,action,after_json,reason,correlation_id)
  values(gen_random_uuid(),transaction_timestamp(),p_actual_actor_user_id,actor.role,'WEEKLY_SOURCE_AGENCY_CHANGE',r.id::text,
   'NATIVE_AUTHORISE_PHASE_COMPLETED',jsonb_build_object('phase',r.phase,'current_timesheet_id',r.current_timesheet_id,
    'financial_id',r.current_financial_id,'original_creator_user_id',r.actor_user_id,'actual_phase_actor_user_id',p_actual_actor_user_id),r.reason,r.request_key);
 exception when others then
  get stacked diagnostics error_code=MESSAGE_TEXT,error_state=RETURNED_SQLSTATE;
  if error_state='55P03' then raise;end if;
  update private.weekly_source_agency_timesheet_change_requests set last_refusal_code=case
   when error_code~'^[A-Z][A-Z0-9_]{0,199}$' then error_code else 'AGENCY_CHANGE_NATIVE_AUTHORISE_FAILED' end,
   version=version+1,updated_at_utc=transaction_timestamp() where id=p_request_id returning * into r;
 end;
 return r;
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'AGENCY_CHANGE_NATIVE_AUTHORISE_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function public.weekly_source_agency_change_authorise_step_v1(p_request_id uuid,p_actor_user_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype;
begin
 perform private.weekly_source_query_require_service_v1();
 r:=private.weekly_source_agency_change_authorise_step_v1(p_request_id,p_actor_user_id);
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_AUTHORISE_STEP_RESULT_V1','request_id',r.id,
  'request_version',r.version,'phase',r.phase,'view_actor_user_id',p_actor_user_id,
  'timesheet_id',r.current_timesheet_id,'timesheet_version',r.current_timesheet_version,
  'financial_id',r.current_financial_id,'last_refusal_code',r.last_refusal_code,
  'authorise_receipt',r.native_receipts->'authorise','completed_receipt',r.completed_receipt);
end;
$function$;

create or replace function private.weekly_source_agency_publication_validation_v1(p_publication_id uuid)
returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare p public.weekly_source_projection_publications%rowtype; c public.weekly_source_cycles%rowtype; r record;
begin
 select * into strict p from public.weekly_source_projection_publications where id=p_publication_id;
 if p.authority_scope_kind<>'CYCLE' or p.correction_session_id is not null or p.state<>'CURRENT' then return;end if;
 select * into strict c from public.weekly_source_cycles where id=p.source_cycle_id;
 if c.current_projection_publication_id is distinct from p.id or c.current_complete_upload_id is distinct from p.upload_id then
  raise exception 'AGENCY_INVOICE_VALIDATION_PUBLICATION_STALE' using errcode='40001';end if;
 for r in select cw.timesheet_id from public.contract_weeks cw join public.contracts con on con.id=cw.contract_id
  join public.weekly_source_group_clients m on m.source_group_id=c.source_group_id and m.client_id=con.client_id
   and cw.week_ending_date between m.valid_from and coalesce(m.valid_to,'infinity'::date)
  where cw.week_ending_date=c.finalisation_week_ending and coalesce(cw.additional_seq,0)=0 and not cw.is_adjustment
   and cw.timesheet_id is not null and (c.scope_client_id is null or c.scope_client_id=con.client_id)
   and private.weekly_source_agency_invoice_check_only_v1(cw.timesheet_id) is true order by cw.timesheet_id loop
  perform public.weekly_source_agency_week_validation_refresh_v1(r.timesheet_id,p.id);
 end loop;
end;
$function$;

create or replace function private.weekly_source_agency_authorise_validation_after_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare main_id uuid; facts jsonb;
begin
 if new.is_current is not true or new.authorised_at_utc is null
  or new.authorised_at_utc is not distinct from old.authorised_at_utc
  or private.weekly_source_agency_invoice_check_only_v1(new.timesheet_id) is distinct from true then return new;end if;
 select cw.timesheet_id into strict main_id from public.timesheets t join public.contract_weeks cw
  on cw.contract_id=t.contract_id and cw.week_ending_date=t.week_ending_date and coalesce(cw.additional_seq,0)=0 and not cw.is_adjustment
  where t.timesheet_id=new.timesheet_id;
 facts:=private.weekly_source_agency_week_facts_v1(main_id);
 perform public.weekly_source_agency_week_validation_refresh_v1(main_id,(facts->>'publication_id')::uuid);
 return new;
end;
$function$;

create or replace function private.weekly_source_agency_legacy_import_validation_admit_v1(p_import_id uuid)
returns boolean language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare hi public.hr_imports%rowtype; preview jsonb; first_date date; last_date date; client uuid;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict hi from public.hr_imports where id=p_import_id and pruned_at is null;
 if hi.import_scope is not null and upper(hi.import_scope::text)<>'HR_WEEKLY' then return true;end if;
 preview:=public.hr_weekly_validation_preview(p_import_id);
 if preview->>'import_id' is distinct from p_import_id::text or jsonb_typeof(preview->'rows') is distinct from 'array'
  or jsonb_array_length(preview->'rows')>5000 then raise exception 'HR_VALIDATION_NATIVE_TARGETS_UNAVAILABLE' using errcode='55000';end if;
 client:=(preview->>'client_id')::uuid;
 first_date:=coalesce((preview->>'file_date_min')::date,hi.coverage_start_date);
 last_date:=coalesce((preview->>'file_date_max')::date,hi.coverage_end_date);
 if client is null or first_date is null or last_date is null then
  raise exception 'HR_VALIDATION_NATIVE_TARGETS_UNAVAILABLE' using errcode='55000';end if;
 if exists(select 1 from public.contract_weeks cw join public.contracts con on con.id=cw.contract_id
  where con.client_id=client and cw.timesheet_id is not null and cw.week_ending_date>=first_date and cw.week_ending_date-6<=last_date
   and private.weekly_source_agency_invoice_check_only_v1(cw.timesheet_id) is true) then
  raise exception 'AGENCY_INVOICE_USES_COMPLETENESS_WRITER' using errcode='55000';end if;
 return true;
end;
$function$;

create or replace function public.weekly_source_agency_legacy_import_validation_admit_v1(p_import_id uuid,p_actor_user_id uuid)
returns boolean language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
begin
 perform private.weekly_source_query_require_service_v1();
 if not exists(select 1 from public.tms_users where id=p_actor_user_id and is_active and lower(btrim(role))='admin') then
  raise exception 'ADMIN_REQUIRED' using errcode='42501';end if;
 return private.weekly_source_agency_legacy_import_validation_admit_v1(p_import_id);
end;
$function$;

create or replace function private.weekly_source_agency_change_return_step_v1(
 p_request_id uuid,p_actual_actor_user_id uuid
) returns private.weekly_source_agency_timesheet_change_requests
language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 actor public.tms_users%rowtype; ts public.timesheets%rowtype;
 fin public.timesheets_financials%rowtype; validation public.timesheet_validations%rowtype;
 week_facts record; receipt jsonb; stored_validation jsonb; completion jsonb;
 signature jsonb; actual_signature text; error_code text; error_state text;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,
  r.initial_row_signature,r.request_key,p_actual_actor_user_id);
 select * into strict actor from public.tms_users where id=p_actual_actor_user_id and is_active;
 if r.state='COMPLETED' then
  if r.completed_receipt->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_NATIVE_COMPLETED_V1'
   or r.completed_receipt->>'request_id' is distinct from r.id::text
   or r.completed_receipt->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
   or r.completed_receipt->>'timesheet_id' is distinct from r.current_timesheet_id::text
   or r.completed_receipt->>'timesheet_version' is distinct from r.current_timesheet_version::text
   or r.completed_receipt->>'original_draft_invoice_id' is distinct from r.original_draft_invoice_id::text
   or r.completed_receipt->>'original_creator_user_id' is distinct from r.actor_user_id::text
   or r.completed_receipt->>'completed_actor_user_id' is distinct from r.completed_by_user_id::text
   or r.return_hold or r.completed_at_utc is null or r.phase<>'COMPLETED'
   or (r.completed_receipt->>'completed_at_utc')::timestamptz is distinct from r.completed_at_utc then
   raise exception 'AGENCY_CHANGE_GENUINE_COMPLETED_RECEIPT_REQUIRED' using errcode='55000';end if;
  return r; -- Current reader authority was checked; original step actor stays immutable.
 end if;
 if r.phase<>'AUTHORISED' then raise exception 'AGENCY_CHANGE_RETURN_PHASE_NOT_READY' using errcode='55000';end if;
 begin
  select * into strict ts from public.timesheets where timesheet_id=r.current_timesheet_id for update;
  select * into strict fin from public.timesheets_financials where id=r.current_financial_id and is_current for update;
  select * into strict validation from public.timesheet_validations where timesheet_id=ts.timesheet_id for update;
  select * into strict week_facts from private.weekly_source_agency_week_complete_v1(ts.timesheet_id);
  if ts.timesheet_id is distinct from r.initial_timesheet_id or ts.version is distinct from r.current_timesheet_version
   or ts.is_current is distinct from true or ts.revoked_at is not null or ts.archived_at_utc is not null
   or ts.authorised_at_server is null or fin.authorised_at_utc is distinct from ts.authorised_at_server
   or fin.authorised_by_user_id::text is distinct from r.native_receipts#>>'{authorise,phase_actor_user_id}'
   or (r.native_receipts#>>'{authorise,authorised_at_server}')::timestamptz is distinct from ts.authorised_at_server
   or fin.timesheet_version is distinct from ts.version or fin.is_stale is distinct from false
   or fin.processing_status::text is distinct from 'READY_FOR_INVOICE' or fin.locked_by_invoice_id is not null
   or validation.validation_source_kind is distinct from 'AGENCY_INVOICE_WEEK'
   or validation.validation_source_publication_id is distinct from r.source_publication_id
   or validation.last_source is not null or validation.status::text is distinct from 'VALIDATION_OK'
   or validation.pre_validated or validation.validated_at_utc is null
   or week_facts.complete is distinct from true or week_facts.reasons is distinct from array[]::text[]
   or week_facts.facts_hash is null or week_facts.facts_hash!~'^[0-9a-f]{64}$'
   or encode(validation.validation_source_facts_sha256,'hex') is distinct from week_facts.facts_hash then
   raise exception 'AGENCY_CHANGE_CURRENT_NATIVE_WEEK_VALIDATION_REQUIRED' using errcode='55000';end if;
  stored_validation:=r.native_receipts->'validation_recompute';
  if jsonb_typeof(stored_validation) is distinct from 'object'
   or stored_validation->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_NATIVE_VALIDATION_RECOMPUTE_V1'
   or stored_validation->>'request_id' is distinct from r.id::text
   or stored_validation->>'timesheet_id' is distinct from ts.timesheet_id::text
   or stored_validation->>'timesheet_version' is distinct from ts.version::text
   or stored_validation->>'financial_id' is distinct from fin.id::text
   or stored_validation->>'publication_id' is distinct from r.source_publication_id::text
   or stored_validation->>'facts_sha256' is distinct from week_facts.facts_hash
   or stored_validation->>'validation_actor_user_id' is distinct from validation.validation_source_actor_user_id::text
   or stored_validation->>'native_ok_count' is distinct from '1'
   or stored_validation->>'native_fail_count' is distinct from '0'
   or stored_validation->>'observed_outbox_id' is null
   or stored_validation->>'financial_row_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_VALIDATION_RECOMPUTE_ROW_V1',to_jsonb(fin)),'hex') then
   raise exception 'AGENCY_CHANGE_GENUINE_VALIDATION_RECOMPUTE_RECEIPT_REQUIRED' using errcode='55000';end if;
  -- This native readiness read does not advance from queue absence or TSFIN status.
  -- Receipt production must be mounted from the actual canonical writer/complete owner.
  receipt:=private.weekly_source_agency_draft_round_trip_v1(r.request_key,'RETURN',p_actual_actor_user_id);
  if receipt->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_DRAFT_ROUND_TRIP_RECEIPT_V1'
   or receipt->>'ok' is distinct from 'true' or receipt->>'request_id' is distinct from r.id::text
   or receipt->>'step' is distinct from 'RETURN'
   or receipt->>'phase_actor_user_id' is distinct from p_actual_actor_user_id::text
   or receipt->>'original_draft_invoice_id' is distinct from r.original_draft_invoice_id::text
   or receipt->>'original_draft_invoice_no' is distinct from r.original_draft_invoice_no
   or (r.original_draft_invoice_id is null and receipt->>'not_required' is distinct from 'true')
   or (r.original_draft_invoice_id is not null and
      (receipt->>'timesheet_id' is distinct from r.current_timesheet_id::text
       or receipt->>'financial_id' is distinct from r.current_financial_id::text)) then
   raise exception 'AGENCY_CHANGE_GENUINE_SAME_D1_RETURN_RECEIPT_REQUIRED' using errcode='55000';end if;
  signature:=public.timesheet_lifecycle_guard_signature_v1(r.current_timesheet_id,r.contract_week_id,false);
  actual_signature:=nullif(btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature')),'');
  if actual_signature is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000';end if;
  completion:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_COMPLETED_V1','request_id',r.id,
   'request_sha256',encode(r.request_sha256,'hex'),'original_creator_user_id',r.actor_user_id,
   'completed_actor_user_id',p_actual_actor_user_id,'timesheet_id',ts.timesheet_id,'timesheet_version',ts.version,
   'financial_id',fin.id,'original_draft_invoice_id',r.original_draft_invoice_id,
   'original_draft_invoice_no',r.original_draft_invoice_no,'publication_id',r.source_publication_id,
   'week_facts_sha256',week_facts.facts_hash,'validation_recompute',stored_validation,'return_receipt',receipt,
   'completed_at_utc',transaction_timestamp(),'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid());
  if octet_length(completion::text)>16384 or octet_length((r.native_receipts||jsonb_build_object('return',receipt))::text)>65536 then
   raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED' using errcode='54000';end if;
  update private.weekly_source_agency_timesheet_change_requests set state='COMPLETED',phase='COMPLETED',return_hold=false,
   native_receipts=native_receipts||jsonb_build_object('return',receipt),completed_receipt=completion,
   current_row_signature=actual_signature,completed_at_utc=transaction_timestamp(),completed_by_user_id=p_actual_actor_user_id,
   updated_by_user_id=p_actual_actor_user_id,updated_at_utc=transaction_timestamp(),version=version+1,last_refusal_code=null
   where id=r.id returning * into r;
  insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,action,after_json,reason,correlation_id)
  values(gen_random_uuid(),transaction_timestamp(),p_actual_actor_user_id,actor.role,'WEEKLY_SOURCE_AGENCY_CHANGE',r.id::text,
   'NATIVE_SAME_D1_RETURN_COMPLETED',jsonb_build_object('phase',r.phase,'original_draft_invoice_id',r.original_draft_invoice_id,
    'original_creator_user_id',r.actor_user_id,'actual_phase_actor_user_id',p_actual_actor_user_id),r.reason,r.request_key);
 exception when others then
  get stacked diagnostics error_code=MESSAGE_TEXT,error_state=RETURNED_SQLSTATE;
  if error_state='55P03' then raise;end if;
  update private.weekly_source_agency_timesheet_change_requests set last_refusal_code=case
   when error_state='42883' then 'AGENCY_CHANGE_NATIVE_WEEK_PRODUCER_UNAVAILABLE'
   when error_code~'^[A-Z][A-Z0-9_]{0,199}$' then error_code else 'AGENCY_CHANGE_NATIVE_RETURN_FAILED' end,
   version=version+1,updated_at_utc=transaction_timestamp() where id=p_request_id returning * into r;
 end;
 return r;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_RETURN_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function public.weekly_source_agency_change_return_step_v1(p_request_id uuid,p_actor_user_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype;
begin
 perform private.weekly_source_query_require_service_v1();
 r:=private.weekly_source_agency_change_return_step_v1(p_request_id,p_actor_user_id);
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_RETURN_STEP_RESULT_V1',
  'request_id',r.id,'request_version',r.version,'phase',r.phase,'view_actor_user_id',p_actor_user_id,
  'timesheet_id',r.current_timesheet_id,'timesheet_version',r.current_timesheet_version,
  'completed',r.state='COMPLETED','last_refusal_code',r.last_refusal_code,
  'completed_actor_user_id',r.completed_by_user_id,'return_invoice_no',case when r.state='COMPLETED' then r.original_draft_invoice_no end,
  'completion_sha256',case when r.state='COMPLETED' then encode(private.weekly_source_sha256_jsonb_v1(
     'WEEKLY_SOURCE_AGENCY_NATIVE_COMPLETED_RECEIPT_V1',r.completed_receipt),'hex') end);
end;
$function$;

create or replace function private.weekly_source_agency_snapshot_provenance_assert_v1(
 p_request_id uuid,p_snapshot jsonb
) returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 schedule jsonb; segments jsonb; source_entry jsonb; segment jsonb; matches integer;
begin
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 schedule:=r.native_receipts#>'{original_capture,schedule}';
 segments:=p_snapshot#>'{invoice_breakdown_json,segments}';
 if jsonb_typeof(p_snapshot) is distinct from 'object' or octet_length(p_snapshot::text)>1048576
  or p_snapshot->>'timesheet_id' is distinct from r.current_timesheet_id::text
  or p_snapshot->>'timesheet_version' is distinct from r.current_timesheet_version::text
  or p_snapshot->>'candidate_id' is distinct from r.candidate_id::text
  or p_snapshot->>'client_id' is distinct from r.client_id::text
  or p_snapshot->'actual_schedule_json' is distinct from schedule
  or jsonb_typeof(schedule) is distinct from 'array' or jsonb_typeof(segments) is distinct from 'array'
  or jsonb_array_length(schedule)>100 or jsonb_array_length(segments)<>jsonb_array_length(schedule)
  or p_snapshot#>>'{invoice_breakdown_json,mode}' is distinct from 'SEGMENTS' then
  raise exception 'AGENCY_CHANGE_CANONICAL_SOURCE_PROVENANCE_INVALID' using errcode='22023'; end if;
 perform public._ctms_assert_tsfin_snapshot_policy_v1(r.current_timesheet_id,p_snapshot);
 for source_entry in select value from jsonb_array_elements(schedule) loop
  -- Re-derive membership from the locked actual native capture and native
  -- event identity. Native Source CAS/rule/finalisation is checked separately.
  if not exists(select 1 from public.weekly_work_events e
    where e.id=(source_entry->>'work_event_id')::uuid and e.candidate_id=r.candidate_id
      and e.client_id=r.client_id and e.first_source_group_id=r.source_group_id
      and e.work_date=(source_entry->>'date')::date)
   or source_entry->>'source_shift_id' is distinct from source_entry->>'work_event_id' then
   raise exception 'AGENCY_CHANGE_NATIVE_SOURCE_EVENT_CHANGED' using errcode='40001'; end if;
  select count(*) into matches from jsonb_array_elements(segments) s
   where s->>'work_event_id'=source_entry->>'work_event_id'
     and s->>'source_shift_id'=source_entry->>'work_event_id'
     and s->>'date'=source_entry->>'date' and s->>'start'=source_entry->>'start'
     and s->>'end'=source_entry->>'end'
     and (s->>'break_mins')::numeric=(source_entry->>'break_minutes')::numeric
     and (s->>'is_reversal')::boolean is not true;
  if matches<>1 then raise exception 'AGENCY_CHANGE_NATIVE_SOURCE_EVENT_CHANGED' using errcode='40001'; end if;
 end loop;
 for segment in select value from jsonb_array_elements(segments) loop
  if not exists(select 1 from jsonb_array_elements(schedule) e where e->>'work_event_id'=segment->>'work_event_id')
   or segment->>'segment_id' is null or segment->>'segment_id'=''
   or nullif(segment->>'invoice_locked_invoice_id','') is not null then
   raise exception 'AGENCY_CHANGE_CANONICAL_SOURCE_PROVENANCE_INVALID' using errcode='22023'; end if;
 end loop;
 if (select count(distinct s->>'segment_id') from jsonb_array_elements(segments) s)<>jsonb_array_length(segments) then
  raise exception 'AGENCY_CHANGE_CANONICAL_SOURCE_PROVENANCE_INVALID' using errcode='22023'; end if;
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'AGENCY_CHANGE_CANONICAL_SOURCE_PROVENANCE_INVALID' using errcode='22023';
end;
$function$;

create or replace function public.weekly_source_agency_change_worker_apply_v1(
 p_request_id uuid,p_expected_request_version bigint,p_expected_context_sha256 text,p_snapshot jsonb
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; before_ts public.timesheets%rowtype; f public.timesheets_financials%rowtype;
 q public.ts_financials_outbox%rowtype; before_queue jsonb; context jsonb; result jsonb; observation jsonb;
 receipts jsonb; signature jsonb; old_phase text; actor uuid; observed boolean:=false; queue_complete boolean:=false;
 error_code text; write_result record; next_signature text;
begin
 perform private.weekly_source_query_require_service_v1();
 if p_request_id is null or p_expected_request_version is null or p_expected_request_version<1
  or p_expected_context_sha256 is null or p_expected_context_sha256!~'^[0-9a-f]{64}$' then
  raise exception 'AGENCY_CHANGE_WORKER_APPLY_INVALID' using errcode='22023'; end if;
 context:=private.weekly_source_agency_change_worker_context_v1(p_request_id);
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id for update;
 if r.version is distinct from p_expected_request_version
  or context->>'context_sha256' is distinct from p_expected_context_sha256 then
  raise exception 'AGENCY_CHANGE_WORKER_CONTEXT_CHANGED' using errcode='40001'; end if;
 old_phase:=r.phase;actor:=r.updated_by_user_id;
 begin
  perform private.weekly_source_agency_snapshot_provenance_assert_v1(r.id,p_snapshot);
  if old_phase='UNAUTHORISED' then
   select * into strict before_ts from public.timesheets where timesheet_id=r.current_timesheet_id;
   perform private.weekly_source_agency_financial_frame_open_v1(r.id,'MANUAL',p_snapshot,null::uuid);
   -- One existing manual owner, same physical T0, no rotation/evidence selector.
   -- Patch is derived entirely from the genuine immutable Source capture.
   result:=public.contract_week_manual_upsert_atomic(
    p_week_id=>r.contract_week_id,p_expected_timesheet_id=>r.current_timesheet_id,
    p_timesheet_create_json=>null::jsonb,
    p_timesheet_patch_json=>jsonb_build_object('actual_schedule_json',r.native_receipts#>'{original_capture,schedule}'),
    p_contract_week_patch_json=>'{}'::jsonb,p_tsfin_snapshot_json=>p_snapshot,p_rotation_json=>null::jsonb,
    p_actor_user_id=>actor,p_materialise_staged_evidence=>false,p_now_utc=>transaction_timestamp(),
    p_expected_row_signature=>r.current_row_signature,
    p_queue_timesheet_materialisation_json=>jsonb_build_object('suppress_timesheet_evidence_materialisation',true));
   select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
   select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
   select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
   observation:=r.native_receipts->'manual_financial_write';
   if result->>'ok' is distinct from 'true' or result->>'operation' is distinct from 'weekly_manual_process_update'
    or result->>'created_now' is distinct from 'false' or result->>'timesheet_id' is distinct from t.timesheet_id::text
    or result->>'timesheet_financials_id' is distinct from f.id::text
    or t.version is distinct from r.current_timesheet_version
    or to_jsonb(t)-array['actual_schedule_json','updated_at']
      is distinct from to_jsonb(before_ts)-array['actual_schedule_json','updated_at']
    or t.actual_schedule_json is distinct from r.native_receipts#>'{original_capture,schedule}'
    or observation->>'financial_id' is distinct from f.id::text
    or observation->>'transaction_id' is distinct from pg_current_xact_id()::text
    or observation->>'backend_pid' is distinct from pg_backend_pid()::text then
    raise exception 'AGENCY_CHANGE_NATIVE_MANUAL_POSTCONDITION_UNPROVED'; end if;
   next_signature:=result->>'backend_row_signature';
   if nullif(btrim(next_signature),'') is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE'; end if;
   receipts:=r.native_receipts||jsonb_build_object('manual_process',jsonb_build_object(
     'schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_MANUAL_PROCESS_V1','phase_actor_user_id',actor,
     'native_result_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_NATIVE_MANUAL_RESULT_V1',result),'hex'),
     'timesheet_id',t.timesheet_id,'financial_id',f.id,'current_row_signature',next_signature));
   update private.weekly_source_agency_timesheet_change_requests set phase='SCHEDULE_APPLIED',native_receipts=receipts,
    current_financial_id=f.id,current_row_signature=next_signature,version=version+1,updated_at_utc=transaction_timestamp()
    where id=r.id returning * into r;
   select to_jsonb(existing) into before_queue from public.ts_financials_outbox existing
    where existing.timesheet_id=t.timesheet_id and existing.reason='MANUAL'::public.ts_fin_reason_enum;
   -- Preserve the existing upsert/queue owner and its genuine row identity.
   perform public.enqueue_ts_financials(t.timesheet_id,'MANUAL'::public.ts_fin_reason_enum);
   select * into strict q from public.ts_financials_outbox
    where timesheet_id=t.timesheet_id and reason='MANUAL'::public.ts_fin_reason_enum for update;
   if q.attempt_count<>0 or q.next_attempt_at is not null or q.last_error is not null then
    raise exception 'AGENCY_CHANGE_NATIVE_ENQUEUE_UNPROVED'; end if;
   receipts:=r.native_receipts||jsonb_build_object('enqueue',jsonb_build_object(
    'schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_ENQUEUE_V1','phase_actor_user_id',actor,
    'outbox_id',q.id,'timesheet_id',q.timesheet_id,'reason',q.reason,
    'before_sha256',case when before_queue is null then null else encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_NATIVE_QUEUE_BEFORE_V1',before_queue),'hex') end,
    'after_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_NATIVE_QUEUE_AFTER_V1',to_jsonb(q)),'hex')));
   update private.weekly_source_agency_timesheet_change_requests set phase='RECOMPUTE_PENDING',native_receipts=receipts,
    outbox_id=q.id,outbox_reason=q.reason,version=version+1,updated_at_utc=transaction_timestamp(),last_refusal_code=null
    where id=r.id returning * into r;
   observed:=true;
  elsif old_phase='RECOMPUTE_PENDING' then
   -- This is the exact queued native owner; no Worker no-op or paid-success
   -- shortcut. The new E26 observation must precede its real queue success.
   select * into strict write_result from public.tsfin_write_snapshots_and_complete(jsonb_build_array(
     jsonb_build_object('outbox_id',r.outbox_id,'timesheet_id',r.current_timesheet_id,'snapshot',p_snapshot)));
   select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
   observation:=r.native_receipts->'recompute';
   select * into strict f from public.timesheets_financials where id=r.current_financial_id and is_current;
   if write_result.ok_count is distinct from 1 or write_result.fail_count is distinct from 0
    or write_result.errors is distinct from '[]'::jsonb
    or observation->>'observed_outbox_id' is distinct from r.outbox_id::text
    or observation->>'financial_id' is distinct from f.id::text
    or observation->>'transaction_id' is distinct from pg_current_xact_id()::text
    or observation->>'backend_pid' is distinct from pg_backend_pid()::text
    or observation->>'financial_row_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_RECOMPUTE_ROW_V1',to_jsonb(f)),'hex')
    or exists(select 1 from public.ts_financials_outbox where id=r.outbox_id) then
    raise exception 'AGENCY_CHANGE_NATIVE_RECOMPUTE_POSTCONDITION_UNPROVED'; end if;
   signature:=public.timesheet_lifecycle_guard_signature_v1(r.current_timesheet_id,r.contract_week_id,false);
   next_signature:=btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature'));
   if nullif(next_signature,'') is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE'; end if;
   receipts:=r.native_receipts||jsonb_build_object('queue_completion',jsonb_build_object(
    'schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_QUEUE_COMPLETION_V1','outbox_id',r.outbox_id,
    'timesheet_id',r.current_timesheet_id,'financial_id',f.id,'phase_actor_user_id',actor,
    'native_ok_count',write_result.ok_count,'native_fail_count',write_result.fail_count,
    'actual_observation_transaction_id',observation->'transaction_id','actual_observation_backend_pid',observation->'backend_pid'));
   update private.weekly_source_agency_timesheet_change_requests set phase='FINANCIAL_CURRENT',native_receipts=receipts,
    current_row_signature=next_signature,version=version+1,updated_at_utc=transaction_timestamp(),last_refusal_code=null
    where id=r.id returning * into r;
   observed:=true;queue_complete:=true;
  else raise exception 'AGENCY_CHANGE_WORKER_PHASE_NOT_READY'; end if;
  if octet_length(r.native_receipts::text)>65536 then raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED'; end if;
 exception when others then
  get stacked diagnostics error_code=MESSAGE_TEXT;
  update private.weekly_source_agency_timesheet_change_requests set last_refusal_code=case
    when error_code~'^[A-Z][A-Z0-9_]{0,199}$' then error_code else 'AGENCY_CHANGE_NATIVE_PHASE_FAILED' end,
    version=version+1,updated_at_utc=transaction_timestamp() where id=p_request_id returning * into r;
  observed:=false;queue_complete:=false;
 end;
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_WORKER_RESULT_V1',
  'request_id',r.id,'request_version',r.version,'phase',r.phase,'phase_actor_user_id',r.updated_by_user_id,
  'timesheet_id',r.current_timesheet_id,'timesheet_version',r.current_timesheet_version,
  'current_financial_id',r.current_financial_id,'outbox_id',r.outbox_id,'last_refusal_code',r.last_refusal_code,
  'native_write_observed',observed,'native_queue_completed',queue_complete);
end;
$function$;

create or replace function public.weekly_source_agency_change_worker_targets_v1(p_timesheet_ids uuid[])
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if p_timesheet_ids is null or cardinality(p_timesheet_ids) not between 1 and 100
  or array_position(p_timesheet_ids,null::uuid) is not null
  or (select count(distinct id) from unnest(p_timesheet_ids) id)<>cardinality(p_timesheet_ids) then
  raise exception 'AGENCY_CHANGE_WORKER_TARGETS_INVALID' using errcode='22023'; end if;
 select coalesce(jsonb_agg(jsonb_build_object('request_id',r.id,'timesheet_id',r.current_timesheet_id,
   'phase',r.phase,'outbox_id',r.outbox_id) order by r.current_timesheet_id),'[]'::jsonb) into result
 from private.weekly_source_agency_timesheet_change_requests r
 where r.state='ACTIVE' and r.current_timesheet_id=any(p_timesheet_ids);
 if jsonb_array_length(result)>100 or octet_length(result::text)>65536 then
  raise exception 'AGENCY_CHANGE_WORKER_TARGETS_BOUND_EXCEEDED' using errcode='54000'; end if;
 return result;
end;
$function$;

create or replace function private.weekly_source_agency_change_worker_context_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
 q public.ts_financials_outbox%rowtype; context jsonb; weekly jsonb; frame jsonb; claim jsonb;
 validation jsonb; shifts jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,
   r.initial_row_signature,r.request_key,r.updated_by_user_id);
 if r.state<>'ACTIVE' or r.phase not in('UNAUTHORISED','RECOMPUTE_PENDING') then
  raise exception 'AGENCY_CHANGE_WORKER_PHASE_NOT_READY' using errcode='55000'; end if;
 select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
 select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
 if t.version is distinct from r.current_timesheet_version or f.id is distinct from r.current_financial_id
  or f.timesheet_version is distinct from t.version or f.locked_by_invoice_id is not null
  or t.authorised_at_server is not null or exists(select 1 from public.invoice_lines where timesheet_id=t.timesheet_id) then
  raise exception 'AGENCY_CHANGE_WORKER_CURRENT_TARGET_CHANGED' using errcode='40001'; end if;
 -- Current native planned-request purpose preserves original evidence,
 -- even when its hours parser is unavailable. It does not grant Protect pay.
 perform private.weekly_source_agency_paid_write_purpose_v1(r.id);
 if r.phase='RECOMPUTE_PENDING' then
  select * into strict q from public.ts_financials_outbox where id=r.outbox_id;
  if q.timesheet_id is distinct from t.timesheet_id or q.reason is distinct from r.outbox_reason
   or r.outbox_reason is distinct from 'MANUAL'::public.ts_fin_reason_enum
   or q.attempt_count<1 or q.next_attempt_at is null or q.next_attempt_at<=transaction_timestamp() then
   raise exception 'AGENCY_CHANGE_NATIVE_OUTBOX_CHANGED' using errcode='40001'; end if;
 end if;
 select to_jsonb(x) into strict context from public.tsfin_load_context_batch(array[t.timesheet_id]) x
  where x.effective_timesheet_id=t.timesheet_id;
 select to_jsonb(x) into strict weekly from public.tsfin_load_weekly_context_batch(array[t.timesheet_id]) x
  where x.timesheet_id=t.timesheet_id;
 if (select count(*) from public.timesheet_validations where timesheet_id=t.timesheet_id)>1 then
  raise exception 'AGENCY_CHANGE_NATIVE_VALIDATION_AMBIGUOUS' using errcode='55000'; end if;
 select jsonb_build_object('timesheet_id',v.timesheet_id,'status',v.status,'reason_code',v.reason_code,
   'validated_at_utc',v.validated_at_utc,'updated_at',v.updated_at,
   'validation_source_kind',v.validation_source_kind) into validation
 from public.timesheet_validations v where v.timesheet_id=t.timesheet_id;
 select x.shifts into strict shifts from public.tsfin_load_nhsp_shifts_batch(array[t.timesheet_id]) x
  where x.timesheet_id=t.timesheet_id;
 if jsonb_typeof(shifts) is distinct from 'array' or jsonb_array_length(shifts)>100 then
  raise exception 'AGENCY_CHANGE_NATIVE_CALCULATOR_CONTEXT_BOUND_EXCEEDED' using errcode='54000'; end if;
 if context#>>'{out_timesheet,timesheet_id}' is distinct from t.timesheet_id::text
  or context#>>'{out_cur_fin,id}' is distinct from f.id::text
  or context#>>'{out_candidate,id}' is distinct from r.candidate_id::text
  or context->>'out_client_id' is distinct from r.client_id::text
  or weekly#>>'{out_cw,id}' is distinct from r.contract_week_id::text
  or weekly#>>'{out_contract,id}' is distinct from r.contract_id::text
  or weekly#>>'{out_contract,candidate_id}' is distinct from r.candidate_id::text
  or weekly#>>'{out_contract,client_id}' is distinct from r.client_id::text then
  raise exception 'AGENCY_CHANGE_NATIVE_CALCULATOR_CONTEXT_UNAVAILABLE' using errcode='55000'; end if;
 frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_CANONICAL_WORKER_CONTEXT_V1',
   'request_id',r.id,'request_sha256',encode(r.request_sha256,'hex'),'request_version',r.version,
   'phase',r.phase,'phase_actor_user_id',r.updated_by_user_id,'current_row_signature',r.current_row_signature,
   'source_cas',r.source_cas,'source_schedule',r.native_receipts#>'{original_capture,schedule}',
   'outbox_id',r.outbox_id,'outbox_reason',r.outbox_reason,
   'outbox_row',case when r.phase='RECOMPUTE_PENDING' then to_jsonb(q) else null::jsonb end,
   'context',context,'weekly_context',weekly,'weekly_validation',validation,'nhsp_shifts',shifts);
 if r.version>9007199254740991 or octet_length(frame::text)>2097152 then
  raise exception 'AGENCY_CHANGE_WORKER_CONTEXT_BOUND_EXCEEDED' using errcode='54000'; end if;
 return frame||jsonb_build_object('context_sha256',encode(private.weekly_source_sha256_jsonb_v1(
   'WEEKLY_SOURCE_AGENCY_CANONICAL_WORKER_CONTEXT_V1',frame),'hex'));
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_CALCULATOR_CONTEXT_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function public.weekly_source_agency_timesheet_change_v1(
 p_contract_week_id uuid,p_reason text,p_expected_signature text,p_request_key text,p_actor_user_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype; continuation text; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 -- Begin rechecks the original immutable business digest, the real current
 -- scoped actor and the native physical/Source phase postconditions on replay.
 -- It never substitutes a new Source capture or an actor for the original click.
 r:=private.weekly_source_agency_change_begin_v1(p_contract_week_id,p_reason,
   p_expected_signature,p_request_key,p_actor_user_id);
 -- A prior causal refusal is not a permanent resume prohibition. Each owner
 -- rederives its actual postconditions before retrying the SAME request.
 if r.state='ACTIVE' and r.phase='FINANCIAL_CURRENT' then
  r:=private.weekly_source_agency_change_authorise_step_v1(r.id,p_actor_user_id);
 end if;
 if r.state='ACTIVE' and r.phase='AUTHORISED' then
  r:=private.weekly_source_agency_change_return_step_v1(r.id,p_actor_user_id);
 end if;
 if r.environment is distinct from 'TEST' or r.contract_week_id is distinct from p_contract_week_id
  or r.request_key is distinct from p_request_key or r.reason is distinct from p_reason
  or r.initial_row_signature is distinct from p_expected_signature
  or r.current_timesheet_id is distinct from r.initial_timesheet_id
  or r.current_timesheet_version is distinct from r.initial_timesheet_version
  or r.version not between 1 and 9007199254740991
  or r.state not in('ACTIVE','COMPLETED') then
  raise exception 'AGENCY_CHANGE_NATIVE_BUSINESS_RESULT_INVALID' using errcode='55000';end if;
 if r.state='COMPLETED' and (r.phase<>'COMPLETED' or r.return_hold
  or r.completed_receipt is null or r.completed_by_user_id is null or r.completed_at_utc is null or r.last_refusal_code is not null
  or r.completed_receipt->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_NATIVE_COMPLETED_V1'
  or r.completed_receipt->>'request_id' is distinct from r.id::text
  or r.completed_receipt->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
  or r.completed_receipt->>'timesheet_id' is distinct from r.current_timesheet_id::text
  or r.completed_receipt->>'completed_actor_user_id' is distinct from r.completed_by_user_id::text) then
  raise exception 'AGENCY_CHANGE_GENUINE_COMPLETION_RECEIPT_REQUIRED' using errcode='55000';end if;
 continuation:=case when r.state='COMPLETED' then 'NONE'
  when r.phase='UNAUTHORISED' then 'MANUAL'
  when r.phase in('RECOMPUTE_PENDING','AUTHORISED') then 'WORKER' else 'NONE' end;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_BUSINESS_RESULT_V1',
  'request_id',r.id,'request_key',r.request_key,'request_sha256',encode(r.request_sha256,'hex'),
  'request_version',r.version,'state',r.state,'phase',r.phase,'view_actor_user_id',p_actor_user_id,
  'contract_week_id',r.contract_week_id,'timesheet_id',r.current_timesheet_id,
  'timesheet_version',r.current_timesheet_version,'current_row_signature',r.current_row_signature,
  'completed',r.state='COMPLETED','completed_actor_user_id',r.completed_by_user_id,
  'return_invoice_no',case when r.state='COMPLETED' then r.original_draft_invoice_no end,
  'completion_sha256',case when r.state='COMPLETED' then encode(private.weekly_source_sha256_jsonb_v1(
   'WEEKLY_SOURCE_AGENCY_NATIVE_COMPLETED_RECEIPT_V1',r.completed_receipt),'hex') end,
  'last_refusal_code',r.last_refusal_code,'return_hold',r.return_hold,'continuation',continuation,
  'code',case when r.state='COMPLETED' then 'OK' when r.last_refusal_code is not null then r.last_refusal_code
    else 'AGENCY_INVOICE_TSFIN_NOT_READY' end);
 if octet_length(result::text)>16384 then
  raise exception 'AGENCY_CHANGE_NATIVE_BUSINESS_RESULT_BOUND_EXCEEDED' using errcode='54000';end if;
 return result;
end;
$function$;

create or replace function private.weekly_source_agency_crosscheck_context_v1(p_timesheet_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare t public.timesheets%rowtype; main_id uuid; facts jsonb; validation public.timesheet_validations%rowtype;
  hi public.hr_imports%rowtype; rows_json jsonb; source_count integer; comparison_count integer; record_json jsonb;
  has_native_mismatch boolean; has_native_ambiguity boolean;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
  if private.weekly_source_agency_invoice_check_only_v1(t.timesheet_id) is distinct from true then
    return jsonb_build_object('contract','WEEKLY_SOURCE_AGENCY_CROSSCHECK_CONTEXT_V1','timesheet_id',t.timesheet_id,
      'timesheet_version',t.version,'is_agency_invoice',false);
  end if;
  if t.is_current is distinct from true or t.revoked_at is not null or t.archived_at_utc is not null
    or t.sheet_scope::text<>'WEEKLY' or t.line_type::text<>'HOURS' then
    raise exception 'AGENCY_INVOICE_SUPPORT_TIMESHEET_STALE' using errcode='40001';end if;
  select cw.timesheet_id into strict main_id from public.contract_weeks cw
    where cw.contract_id=t.contract_id and cw.week_ending_date=t.week_ending_date
      and coalesce(cw.additional_seq,0)=0 and not cw.is_adjustment;
  facts:=private.weekly_source_agency_week_facts_v1(main_id);
  select value into strict record_json from jsonb_array_elements(facts->'records') r(value)
    where r->>'timesheet_id'=t.timesheet_id::text and r->>'timesheet_version'=t.version::text;
  -- A real bridge import is the deterministic established Mode A import,
  -- never a Source UUID relabelled as hr_imports provenance.
  select * into strict hi from public.hr_imports
    where coverage_operation_key=private.weekly_source_mode_a_operation_key_v1((facts->>'publication_id')::uuid,(facts->>'client_id')::uuid)
      and client_id=(facts->>'client_id')::uuid and import_scope::text='HR_WEEKLY'
      and source_system::text='HEALTHROSTER' and pruned_at is null
      and parser_version='WEEKLY_SOURCE_MODE_A_BRIDGE_V1'
      and parse_summary_json->>'weekly_source_upload_id'=facts->>'upload_id'
      and parse_summary_json->>'weekly_source_projection_publication_id'=facts->>'publication_id'
      and source_file_sha256=(select encode(u.content_sha256,'hex') from public.weekly_source_uploads u where u.id=(facts->>'upload_id')::uuid);
  select * into strict validation from public.timesheet_validations v where v.timesheet_id=t.timesheet_id;
  if validation.validation_source_kind is distinct from 'AGENCY_INVOICE_WEEK' or validation.last_source is not null
    or validation.pre_validated or validation.validation_source_publication_id::text is distinct from facts->>'publication_id'
    or encode(validation.validation_source_facts_sha256,'hex') is distinct from facts->>'facts_hash'
    or validation.status::text not in ('VALIDATION_OK','VALIDATION_ERROR')
    or validation.override_requested_at_utc is not null or validation.override_requested_by is not null
    or validation.override_confirmed_at_utc is not null or validation.override_confirmed_by is not null or validation.override_reason is not null then
    raise exception 'AGENCY_INVOICE_SUPPORT_TYPED_VALIDATION_REQUIRED' using errcode='55000';end if;
  select count(*) into source_count from jsonb_array_elements(facts->'finalised_source') source
    where exists(select 1 from jsonb_array_elements(record_json->'schedule') segment
      where segment->>'work_event_id'=source->>'work_event_id');
  with native_rows as materialized (
    select comparison.id comparison_id,comparison.comparison_state,ur.id upload_row_id,hr.id bridge_row_id,
      jsonb_build_object('date',ur.work_date,'source_system','HEALTHROSTER','hr_request_id',hr.hr_request_id,
        'nhsp_shift_id',null,'external_row_key',ur.external_source_key,'ward',ur.bounded_raw_columns_json->>'ward',
        'assignment_code',ur.bounded_raw_columns_json->>'assignment_code','ref_num',comparison.source_reference_number,
        'start',to_char(ur.start_at_local,'HH24:MI'),'end',to_char(ur.end_at_local,'HH24:MI'),
        'break_mins',ur.break_minutes,'paid_minutes',ur.actual_net_minutes) row_json
    from public.weekly_timesheet_source_comparisons comparison
    join public.weekly_source_upload_rows ur on ur.id=comparison.upload_row_id and ur.upload_id=(facts->>'upload_id')::uuid
      and ur.row_finalisation_state='SOURCE_WORKED'
    join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=ur.id
      and resolution.work_event_id=comparison.work_event_id and resolution.mapping_state='RESOLVED'
      and resolution.generation=(select coalesce(p.projection_generation,p.authority_scope_version) from public.weekly_source_projection_publications p where p.id=(facts->>'publication_id')::uuid)
    join public.hr_rows hr on hr.import_id=hi.id and hr.payload_json->>'weekly_source_upload_row_id'=ur.id::text
    where comparison.projection_publication_id=(facts->>'publication_id')::uuid
      and comparison.source_cycle_id=(facts->>'source_cycle_id')::uuid and comparison.upload_id=ur.upload_id
      and comparison.timesheet_id=t.timesheet_id and comparison.timesheet_revision=t.version
      and comparison.contract_id=t.contract_id and comparison.work_date=ur.work_date
      and comparison.source_start_at_local is not distinct from ur.start_at_local
      and comparison.source_end_at_local is not distinct from ur.end_at_local
      and comparison.source_break_minutes is not distinct from ur.break_minutes
      and exists(select 1 from jsonb_array_elements(facts->'finalised_source') source
        where source->>'work_event_id'=comparison.work_event_id::text and source->>'upload_row_id'=ur.id::text)
      and exists(select 1 from jsonb_array_elements(record_json->'schedule') segment
        where segment->>'work_event_id'=comparison.work_event_id::text)
  ) select count(*)::integer,coalesce(jsonb_agg(row_json order by row_json->>'date',upload_row_id),'[]'::jsonb),
      coalesce(bool_or(comparison_state='HOURS_MISMATCH'),false),
      coalesce(bool_or(comparison_state not in ('EXACT_MATCH','REFERENCE_MISSING','HOURS_MISMATCH')),false)
    into comparison_count,rows_json,has_native_mismatch,has_native_ambiguity from native_rows;
  if source_count=0 or source_count<>comparison_count or comparison_count>100 or has_native_ambiguity then
    raise exception 'AGENCY_INVOICE_SUPPORT_NATIVE_COMPARISON_UNAVAILABLE' using errcode='55000';end if;
  return jsonb_build_object('contract','WEEKLY_SOURCE_AGENCY_CROSSCHECK_CONTEXT_V1','is_agency_invoice',true,
    'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'source_cycle_id',facts->'source_cycle_id',
    'projection_publication_id',facts->'publication_id','upload_id',facts->'upload_id','hr_import_id',hi.id,
    'facts_sha256',facts->'facts_hash','week_complete',facts->'complete','validation_source_kind',validation.validation_source_kind,
    'validation_status',validation.status,'validation_reason',validation.reason_code,
    'crosscheck_status',case when has_native_mismatch then 'HOURS_MISMATCH_HR' else 'OK' end,
    'crosscheck_issues',case when has_native_mismatch then jsonb_build_array('HOURS_MISMATCH_HR') else null::jsonb end,
    'rows',rows_json);
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_INVOICE_SUPPORT_NATIVE_PROVENANCE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_issue_requirements_v1(p_invoice_id uuid)
returns text[] language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare i public.invoices%rowtype; target uuid; support jsonb; codes text[]:=array[]::text[];
  native_message text; validation_required boolean:=false; evidence_missing boolean:=false; credit_unissued boolean:=false;
  r private.timesheet_correction_requests%rowtype; chain jsonb;
begin
  select * into i from public.invoices where id=p_invoice_id;
  -- Actual ordinary unissued INVOICE only. Historical delivery/paid invoices
  -- and Credit Notes retain their existing native issue/delivery protocol.
  if i.id is null or i.type::text<>'INVOICE' or i.status::text not in ('DRAFT','ON_HOLD') or i.issued_at_utc is not null then return codes;end if;
  for target in select distinct l.timesheet_id from public.invoice_lines l where l.invoice_id=i.id
    and l.timesheet_id is not null and private.weekly_source_agency_invoice_check_only_v1(l.timesheet_id) is true order by l.timesheet_id loop
    support:=null;
    begin
      support:=private.weekly_source_agency_crosscheck_context_v1(target);
    exception when sqlstate '55000' or sqlstate '40001' then
      get stacked diagnostics native_message=message_text;
      if native_message not like 'AGENCY_INVOICE_%' then raise;end if;
      -- Genuine unavailable current Source/typed provenance is a validation
      -- requirement, never a legacy override or readiness inference.
      validation_required:=true;
    end;
    if support is not null then
      if support->'is_agency_invoice' is distinct from 'true'::jsonb or support->'week_complete' is distinct from 'true'::jsonb
        or support->>'validation_source_kind' is distinct from 'AGENCY_INVOICE_WEEK'
        or support->>'validation_status' is distinct from 'VALIDATION_OK' then validation_required:=true;end if;
      if not exists(select 1 from public.invoice_hr_source_rows hs where hs.invoice_id=i.id and hs.source_system='HEALTHROSTER'
        and hs.import_id=(support->>'hr_import_id')::uuid and jsonb_typeof(hs.rows_json)='array' and jsonb_array_length(hs.rows_json)>0) then
        evidence_missing:=true;
      end if;
    else
      evidence_missing:=true;
    end if;
    for r in select request.* from private.timesheet_correction_requests request
      where request.replacement_timesheet_id=target and request.state='APPLIED'
        and request.original_invoice_id is not null order by request.id loop
      chain:=public.timesheet_correction_chain_scope_v1(target,false,32,100);
      if chain->'valid' is distinct from 'true'::jsonb or chain#>'{requested_correction_unit,valid}' is distinct from 'true'::jsonb
        or not(chain#>'{requested_correction_unit,member_ids}' ? r.reversal_timesheet_id::text)
        or not(chain#>'{requested_correction_unit,member_ids}' ? target::text) then
        raise exception 'AGENCY_INVOICE_NATIVE_PAIR_UNAVAILABLE' using errcode='55000';end if;
      -- Scoped CN keeps the real T0 line identity and records R0 in metadata.
      -- Existing native resume authority verifies EVERY clone/original/member
      -- and exact original amounts; no second sum or native identity rewrite.
      if not exists(select 1 from public.invoices cn
        where cn.type::text='CREDIT_NOTE' and cn.status::text in ('ISSUED','PAID') and cn.issued_at_utc is not null
          and cn.client_id=i.client_id and cn.original_invoice_id=r.original_invoice_id
          and cn.header_snapshot_json#>>'{credit_scope,reversal_timesheet_id}'=r.reversal_timesheet_id::text
          and cn.header_snapshot_json#>>'{credit_scope,reversed_timesheet_id}'=r.reversed_timesheet_id::text
          and exists(select 1 from public.invoice_lines line where line.invoice_id=cn.id
            and line.timesheet_id=r.reversed_timesheet_id and line.meta_json->>'reversal_timesheet_id'=r.reversal_timesheet_id::text)
          and exists(select 1 from public.timesheets reversal join public.timesheets_financials financial
            on financial.timesheet_id=reversal.timesheet_id and financial.is_current and not financial.is_stale
              and financial.timesheet_version=reversal.version and financial.authorised_at_utc=reversal.authorised_at_server
            where reversal.timesheet_id=r.reversal_timesheet_id and reversal.is_current and reversal.revoked_at is null
              and financial.locked_by_invoice_id=cn.id)
          and exists(select 1 from public.invoice_document_versions doc where doc.id=cn.issued_document_version_id
            and doc.entity_type='INVOICE' and doc.entity_id=cn.id and doc.purpose='FINAL_ISSUE'
            and doc.status='READY' and doc.verified_at_utc is not null and doc.sha256 is not null and doc.r2_key is not null)
          and exists(select 1 from private._invoice_credit_resume_v1(r.original_invoice_id,
            case when pg_input_is_valid(coalesce(cn.header_snapshot_json#>>'{credit_scope,creating_operation_id}',
              cn.header_snapshot_json->>'credit_operation_id',''),'uuid')
              then coalesce(cn.header_snapshot_json#>>'{credit_scope,creating_operation_id}',cn.header_snapshot_json->>'credit_operation_id')::uuid end,
            cn.id,r.reversal_timesheet_id) native_credit where native_credit.credit_note_id=cn.id)
      ) then credit_unissued:=true;end if;
    end loop;
  end loop;
  if validation_required then codes:=array_append(codes,'HEALTHROSTER_VALIDATION_REQUIRED');end if;
  if credit_unissued then codes:=array_append(codes,'AGENCY_INVOICE_CREDIT_NOTE_NOT_ISSUED');end if;
  if evidence_missing then codes:=array_append(codes,'HEALTHROSTER_EVIDENCE_MISSING');end if;
  return codes;
end;
$function$;

create or replace function private.weekly_source_agency_issue_close_v1(p_invoice_id uuid)
returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare i public.invoices%rowtype; actual_audit public.audit_events%rowtype; target record; main_id uuid; facts jsonb;
  incident record; wait_event record; wait_fact jsonb; protected boolean; actor public.tms_users%rowtype;
  source_decision jsonb;
begin
  select * into strict i from public.invoices where id=p_invoice_id;
  if i.type::text<>'INVOICE' or i.status::text<>'ISSUED' or i.issued_at_utc is null then return;end if;
  if not exists(select 1 from public.invoice_lines l where l.invoice_id=i.id and l.timesheet_id is not null
    and private.weekly_source_agency_invoice_check_only_v1(l.timesheet_id) is true) then return;end if;
  if current_setting('transaction_isolation') is distinct from 'read committed' then
    raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001';end if;
  -- Exact issue-owner audit, including frozen asynchronous issue time distinct
  -- from its audit observation timestamp. No current-XID or clock fiction.
  select a.* into strict actual_audit from public.audit_events a
    where a.object_type='invoice' and a.object_id_text=i.id::text and a.action='INVOICE_ISSUED'
      and (a.ts_utc=i.issued_at_utc or case when jsonb_typeof(a.after_json->'issue_at_utc')='string'
        and pg_input_is_valid(coalesce(a.after_json->>'issue_at_utc',''),'timestamptz')
        then (a.after_json->>'issue_at_utc')::timestamptz=i.issued_at_utc else false end)
    order by a.ts_utc desc,a.id desc limit 1;
  select * into strict actor from public.tms_users where id=actual_audit.actor_user_id and is_active;
  for target in select distinct t.contract_id,t.week_ending_date from public.invoice_lines l
    join public.timesheets t on t.timesheet_id=l.timesheet_id
    where l.invoice_id=i.id and private.weekly_source_agency_invoice_check_only_v1(t.timesheet_id) is true
    order by t.contract_id,t.week_ending_date loop
    select cw.timesheet_id into strict main_id from public.contract_weeks cw where cw.contract_id=target.contract_id
      and cw.week_ending_date=target.week_ending_date and coalesce(cw.additional_seq,0)=0 and not cw.is_adjustment;
    facts:=private.weekly_source_agency_week_facts_v1(main_id);
    perform private.weekly_source_office_authority_v1(actor.id,'VIEW_SOURCE_PROGRESS',(facts->>'source_group_id')::uuid,
      (facts->>'client_id')::uuid,target.week_ending_date);
    if facts->'complete' is distinct from 'true'::jsonb then
      raise exception 'HEALTHROSTER_VALIDATION_REQUIRED' using errcode='55000';end if;
    for incident in select d.*,x.issue_family,x.id comparison_id,x.contract_id comparison_contract_id
      from public.weekly_discrepancy_incidents d
      join public.weekly_issue_comparison_revisions x on x.id=d.current_comparison_revision_id and x.incident_id=d.id
      join public.weekly_work_events e on e.id=d.work_event_id and e.candidate_id=d.candidate_id and e.client_id=d.client_id
      where d.state='OPEN' and d.source_group_id=(facts->>'source_group_id')::uuid and d.source_cycle_id=(facts->>'source_cycle_id')::uuid
        and d.candidate_id=(facts->>'candidate_id')::uuid and d.client_id=(facts->>'client_id')::uuid
        and x.contract_id=target.contract_id and x.projection_publication_id=(facts->>'publication_id')::uuid
        and x.issue_family in ('HEALTHROSTER_NOT_FINALISED','SOURCE_MISSING_OR_NOT_AUTHORISED')
        and e.work_date between target.week_ending_date-6 and target.week_ending_date
        and not exists(select 1 from jsonb_array_elements(facts->'records') r
          cross join lateral jsonb_array_elements(r->'schedule') s where s->>'work_event_id'=d.work_event_id::text)
        and not exists(select 1 from private.weekly_source_manual_reviews mr where mr.work_event_id=d.work_event_id
          and mr.candidate_id=d.candidate_id and mr.client_id=d.client_id and mr.state='OPEN')
        and not exists(select 1 from private.timesheet_correction_requests pending where pending.state='WAITING'
          and pending.contract_id=target.contract_id and pending.candidate_id=d.candidate_id
          and pending.client_id=d.client_id and pending.week_ending_date=target.week_ending_date)
        and not exists(select 1 from private.weekly_source_agency_timesheet_change_requests pending where pending.state='ACTIVE'
          and pending.contract_id=target.contract_id and pending.candidate_id=d.candidate_id
          and pending.client_id=d.client_id and pending.week_ending_date=target.week_ending_date)
        and not exists(select 1 from private.weekly_source_check_only_shift_protections p where p.state='ACTIVE'
          and p.work_event_id=d.work_event_id and p.candidate_id=d.candidate_id)
      order by d.id for update of d loop
      protected:=false;
      -- Status WAIT alone is not a certificate. The same genuine native wait
      -- receipt owner is consulted for the latest actual family/event position.
      for wait_event in select family.root_timesheet_id,event.id event_id
        from public.weekly_exceptional_pay_target_families family join public.weekly_exceptional_pay_family_events event on event.family_id=family.id
        where family.contract_id=target.contract_id and family.candidate_id=incident.candidate_id
          and family.week_ending_date=target.week_ending_date and event.durable_work_event_id=incident.work_event_id and event.state='WAIT'
          and event.event_sequence=(select max(tail.event_sequence) from public.weekly_exceptional_pay_family_events tail
            where tail.family_id=family.id and tail.durable_work_event_id=event.durable_work_event_id) order by event.id loop
        wait_fact:=private.weekly_source_protected_wait_receipt_v1(wait_event.root_timesheet_id,wait_event.event_id);
        if jsonb_typeof(wait_fact) is distinct from 'object' then
          raise exception 'AGENCY_INVOICE_QUALIFIED_WAIT_EVIDENCE_UNAVAILABLE' using errcode='55000';end if;
        protected:=true;
      end loop;
      if protected then continue;end if;
      -- This incident is an actual Source Missing/unfinalised subject. Consume
      -- the narrow genuine Source Missing/credit owner, never a universal
      -- Agency pending classifier, status alias, unknown-as-false or money sum.
      source_decision:=private.weekly_source_kept_as_paid_context_for_publication_v1(incident.work_event_id,actor.id,(facts->>'publication_id')::uuid);
      if source_decision->>'work_event_id' is distinct from incident.work_event_id::text
        or source_decision->>'candidate_id' is distinct from incident.candidate_id::text
        or source_decision->>'client_id' is distinct from incident.client_id::text
        or source_decision->>'contract_id' is distinct from target.contract_id::text
        or source_decision->>'projection_publication_id' is distinct from facts->>'publication_id'
        or source_decision->'decision_needed' is distinct from 'false'::jsonb then
        continue;
      end if;
      update public.weekly_discrepancy_incidents set state='CANCELLED',resolved_at_utc=null,resolution_kind=null
        where id=incident.id and state='OPEN' and episode_number=incident.episode_number
          and current_comparison_revision_id=incident.comparison_id;
      if not found then raise exception 'AGENCY_INVOICE_ISSUE_INCIDENT_STALE' using errcode='40001';end if;
      perform private.weekly_source_incident_contact_retire_v1(incident.id);
      insert into public.audit_events(ts_utc,actor_user_id,actor_display,actor_role_at_time,object_type,object_id_text,action,
        before_json,after_json,reason) values(transaction_timestamp(),actor.id,actor.display_name,actor.role,
        'weekly_discrepancy_incident',incident.id::text,'AGENCY_INVOICE_ISSUE_CANCELLED_UNCARRIED_QUERY',
        jsonb_build_object('state','OPEN','episode_number',incident.episode_number,'comparison_id',incident.comparison_id),
        jsonb_build_object('state','CANCELLED','invoice_id',i.id,'invoice_no',i.invoice_no,'issued_at_utc',i.issued_at_utc,
          'native_issue_audit_id',actual_audit.id,'source_publication_id',facts->'publication_id','week_ending',target.week_ending_date,
          'resolved_at_utc',null,'resolution_kind',null),'Actual issued preset Invoice; uncarried absent/unfinalised native query retired');
    end loop;
  end loop;
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_INVOICE_ISSUE_CLOSE_NATIVE_PROVENANCE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_mode_a_units_v1(p_import_id uuid)
returns table(candidate_id uuid,client_id uuid,has_preset boolean,timesheet_ids uuid[],week_endings date[])
language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare hi public.hr_imports%rowtype; preview jsonb;
begin
 select * into strict hi from public.hr_imports where id=p_import_id and pruned_at is null;
 if hi.source_system::text<>'HEALTHROSTER' or upper(coalesce(hi.import_scope::text,''))<>'HR_WEEKLY' then return;end if;
 preview:=public.hr_weekly_validation_preview(hi.id);
 if preview->>'import_id' is distinct from hi.id::text
  or preview->>'client_id' is distinct from hi.client_id::text
  or jsonb_typeof(preview->'rows') is distinct from 'array'
  or jsonb_array_length(preview->'rows')>5000 then
  raise exception 'HR_VALIDATION_NATIVE_TARGETS_UNAVAILABLE' using errcode='55000';end if;
 if exists(select 1 from jsonb_array_elements(preview->'rows') r
  where jsonb_typeof(r) is distinct from 'object'
   or jsonb_typeof(r->'candidate_id') is distinct from 'string'
   or (r->>'candidate_id')!~'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
   or jsonb_typeof(r->'client_id') is distinct from 'string'
   or r->>'client_id' is distinct from hi.client_id::text
   or jsonb_typeof(r->'week_ending_date') is distinct from 'string'
   or not pg_input_is_valid(r->>'week_ending_date','date')
   or (r->>'week_ending_date')!~'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
   or (jsonb_typeof(r->'timesheet_id') is distinct from 'null' and
    (jsonb_typeof(r->'timesheet_id') is distinct from 'string' or
     (r->>'timesheet_id')!~'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'))) then
  raise exception 'HR_VALIDATION_NATIVE_TARGETS_UNAVAILABLE' using errcode='55000';end if;
 return query
 with native_rows as materialized (
  select (r->>'candidate_id')::uuid candidate,(r->>'client_id')::uuid client,
   (r->>'timesheet_id')::uuid ts,(r->>'week_ending_date')::date own_week
  from jsonb_array_elements(preview->'rows') r
 ), classified as (
  select n.*,coalesce(private.weekly_source_agency_invoice_check_only_v1(n.ts),false)
   or exists(select 1 from public.weekly_source_group_clients m
    join public.weekly_source_groups g on g.id=m.source_group_id
    where m.client_id=n.client and n.own_week between m.valid_from and coalesce(m.valid_to,'infinity'::date)
     and private.weekly_source_configured_agency_invoice_v1(n.client,g.id,g.agency_id,g.environment,n.own_week) is true) preset
  from native_rows n
 )
 select n.candidate,n.client,bool_or(n.preset),
  coalesce(array_agg(distinct n.ts order by n.ts) filter(where n.ts is not null),array[]::uuid[]),
  array_agg(distinct n.own_week order by n.own_week)
 from classified n group by n.candidate,n.client order by n.candidate,n.client;
end;
$function$;

create or replace function private.weekly_source_agency_change_identity_guard_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','private','pg_temp'
as $function$
declare v_mutable constant text[]:=array['state','phase','version','current_timesheet_id','current_timesheet_version',
  'current_row_signature','return_hold','outbox_id','outbox_reason','current_financial_id','native_receipts',
  'last_refusal_code','completed_receipt','updated_at_utc','completed_at_utc','updated_by_user_id','completed_by_user_id','current_source_dependency_tokens'];
begin
  if tg_op='DELETE' then raise exception 'AGENCY_CHANGE_HISTORY_DELETE_FORBIDDEN' using errcode='55000';end if;
  if to_jsonb(new)-v_mutable is distinct from to_jsonb(old)-v_mutable then
    raise exception 'AGENCY_CHANGE_IMMUTABLE_CAPTURE_CHANGED' using errcode='55000';
  end if;
  if new.native_receipts->'original_capture' is distinct from old.native_receipts->'original_capture' then
    raise exception 'AGENCY_CHANGE_ORIGINAL_NATIVE_CAPTURE_CHANGED' using errcode='55000';
  end if;
  if new.current_source_dependency_tokens is distinct from old.current_source_dependency_tokens then
    if old.state is distinct from 'ACTIVE' or not new.current_source_dependency_tokens @> old.current_source_dependency_tokens
      or new.native_receipts#>>'{source_admission,schema_version}' is distinct from 'WEEKLY_SOURCE_AGENCY_SOURCE_PHASE_ADMISSION_V1'
      or new.native_receipts#>>'{source_admission,request_id}' is distinct from old.id::text
      or new.native_receipts#>>'{source_admission,request_sha256}' is distinct from encode(old.request_sha256,'hex')
      or new.native_receipts#>>'{source_admission,actor_user_id}' is distinct from new.updated_by_user_id::text
      or new.native_receipts#>>'{source_admission,transaction_id}' is distinct from pg_current_xact_id()::text
      or new.native_receipts#>>'{source_admission,backend_pid}' is distinct from pg_backend_pid()::text
      or new.native_receipts#>'{source_admission,source_cas}' is distinct from old.source_cas
      or new.native_receipts#>>'{source_admission,source_dependency_tokens_sha256}' is distinct from encode(
        private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_SOURCE_DEPENDENCY_TOKENS_V1',new.current_source_dependency_tokens),'hex') then
      raise exception 'AGENCY_CHANGE_NATIVE_SOURCE_FOOTPRINT_RECEIPT_REQUIRED' using errcode='55000';end if;
  end if;
  if old.state='COMPLETED' and to_jsonb(new) is distinct from to_jsonb(old) then
    raise exception 'AGENCY_CHANGE_COMPLETED_RECEIPT_IMMUTABLE' using errcode='55000';
  end if;
  if to_jsonb(new) is distinct from to_jsonb(old) and new.version<>old.version+1 then
    raise exception 'AGENCY_CHANGE_PHASE_VERSION_INVALID' using errcode='40001';
  end if;
  return new;
end;
$function$;

create or replace function private.weekly_source_agency_source_phase_admit_v1(
 p_timesheet_id uuid,p_actor_user_id uuid,p_candidate_id uuid,p_source_cycle_id uuid,
 p_client_id uuid,p_expected_source_cas jsonb,p_native_admission jsonb
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $agency_source_phase$
declare t public.timesheets%rowtype;c public.contracts%rowtype;cycle public.weekly_source_cycles%rowtype;
 gate jsonb:=p_native_admission;locks jsonb;family jsonb;family_before jsonb;family_after jsonb;before_footprint jsonb;after_footprint jsonb;
 members uuid[];scope_hash bytea;token_digest bytea;old_timeout text:=current_setting('lock_timeout');
begin
 perform private.weekly_source_query_require_service_v1();
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001';end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict c from public.contracts where id=t.contract_id;
 select * into strict cycle from public.weekly_source_cycles where id=p_source_cycle_id;
 if p_candidate_id is null or p_client_id is null or c.candidate_id is distinct from p_candidate_id
  or c.client_id is distinct from p_client_id or t.is_current is distinct from true
  or t.archived_at_utc is not null or t.sheet_scope::text is distinct from 'WEEKLY'
  or t.line_type::text is distinct from 'HOURS' or t.correction_id is not null or coalesce(t.is_adjustment,false)
  or t.week_ending_date is distinct from cycle.finalisation_week_ending
  or(cycle.scope_client_id is not null and cycle.scope_client_id is distinct from p_client_id) then
  raise exception 'AGENCY_CHANGE_SOURCE_PHASE_SUBJECT_CHANGED' using errcode='40001';end if;
 perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',cycle.source_group_id,p_client_id,t.week_ending_date);
 -- The exact actual Candidate/I1 result is passed only by the two reviewed
 -- private capture/resume callers, from their literal native invocation BEFORE
 -- D1 invoice/family locks. It is neither a public input nor a callback/flag.
 -- Do not reacquire a potentially changed Candidate after holding that order.
 if jsonb_typeof(gate) is distinct from 'object' or gate->>'ok' is distinct from 'true'
  or gate->>'gate' is distinct from 'GRANTED' or gate->>'candidate_id' is distinct from p_candidate_id::text then
  raise exception 'AGENCY_CHANGE_CANDIDATE_NATIVE_SCOPE_INVALID' using errcode='55000';end if;
 begin
  perform set_config('lock_timeout','1ms',true);
  locks:=private.weekly_source_lock_family_rows_v1(array[t.timesheet_id],p_candidate_id);
  if locks->>'ok' is distinct from 'true' or jsonb_typeof(locks->'families') is distinct from 'array'
   or jsonb_array_length(locks->'families')<>1 then
   raise exception 'AGENCY_CHANGE_NATIVE_FAMILY_LOCK_REFUSED' using errcode='55000';end if;
  family:=locks->'families'->0;
  if family->>'requested_timesheet_id' is distinct from t.timesheet_id::text
   or family->>'canonical_timesheet_id' is distinct from t.timesheet_id::text
   or family->'requested_is_canonical' is distinct from 'true'::jsonb
   or family->>'canonical_version' is distinct from t.version::text
   or jsonb_typeof(family->'member_timesheet_ids') is distinct from 'array' then
   raise exception 'AGENCY_CHANGE_NATIVE_FAMILY_CHANGED' using errcode='40001';end if;
  select array_agg(value::uuid order by value::uuid) into members from jsonb_array_elements_text(family->'member_timesheet_ids');
  select coalesce(jsonb_agg(to_jsonb(s) order by s.family_timesheet_id),'[]'::jsonb) into family_before
   from public._pay_timesheet_rotation_scope(array[t.timesheet_id]) s;
  -- SAME arbiter PHYSICAL then existing workflow/week/cycle dependencies.
  perform private.timesheet_correction_a0_family_tokens_retain_v1(t.timesheet_id,members);
  before_footprint:=private.timesheet_correction_a0_source_footprint_v1(p_source_cycle_id,array[p_client_id]);
  if before_footprint->>'schema_version' is distinct from 'CORRECTION_A0_NATIVE_SOURCE_FOOTPRINT_V1'
   or jsonb_typeof(before_footprint->'tokens') is distinct from 'array'
   or(p_expected_source_cas is not null and before_footprint->'source_cas' is distinct from p_expected_source_cas) then
   raise exception 'AGENCY_CHANGE_ORIGINAL_SOURCE_CAS_CHANGED' using errcode='40001';end if;
  perform private.timesheet_correction_a0_fence_acquire_v1(before_footprint->'tokens',true);
  -- Separate actual pre-mutation native reads, after retention; no same-write
  -- AFTER/STABLE snapshot assumption and no currentness inferred from a token.
  after_footprint:=private.timesheet_correction_a0_source_footprint_v1(p_source_cycle_id,array[p_client_id]);
  if after_footprint is distinct from before_footprint then
   raise exception 'AGENCY_CHANGE_SOURCE_FOOTPRINT_CHANGED_UNDER_LOCK' using errcode='40001';end if;
  select coalesce(jsonb_agg(to_jsonb(s) order by s.family_timesheet_id),'[]'::jsonb) into family_after
   from public._pay_timesheet_rotation_scope(array[t.timesheet_id]) s;
  if family_after is distinct from family_before or jsonb_array_length(family_after) is distinct from cardinality(members)
   or exists(select 1 from jsonb_array_elements(family_after) s where s->>'requested_timesheet_id' is distinct from t.timesheet_id::text
    or s->>'canonical_timesheet_id' is distinct from t.timesheet_id::text
    or s->>'booking_id' is distinct from family->>'family_booking_id'
    or not (s->>'family_timesheet_id')::uuid=any(members)) then
   raise exception 'AGENCY_CHANGE_NATIVE_FAMILY_CHANGED' using errcode='40001';end if;
  select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
  select * into strict c from public.contracts where id=t.contract_id;
  if c.candidate_id is distinct from p_candidate_id or c.client_id is distinct from p_client_id
   or t.version::text is distinct from family->>'canonical_version' or t.is_current is distinct from true then
   raise exception 'AGENCY_CHANGE_SOURCE_PHASE_SUBJECT_CHANGED' using errcode='40001';end if;
  perform set_config('lock_timeout',old_timeout,true);
 exception when others then perform set_config('lock_timeout',old_timeout,true);raise;end;
 token_digest:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_SOURCE_DEPENDENCY_TOKENS_V1',after_footprint->'tokens');
 scope_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_SOURCE_PHASE_ADMISSION_V1',jsonb_build_object(
  'actor_user_id',p_actor_user_id,'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'candidate_id',p_candidate_id,
  'client_id',p_client_id,'source_cycle_id',p_source_cycle_id,'source_cas',after_footprint->'source_cas',
  'native_gate',gate,'native_family',locks,'native_rotation_scope',family_after,'native_source_footprint',after_footprint,
  'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid()));
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SOURCE_PHASE_ADMISSION_V1','actor_user_id',p_actor_user_id,
  'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'candidate_id',p_candidate_id,'client_id',p_client_id,
  'source_cycle_id',p_source_cycle_id,'source_cas',after_footprint->'source_cas','source_dependency_tokens',after_footprint->'tokens',
  'source_dependency_tokens_sha256',encode(token_digest,'hex'),'admission_sha256',encode(scope_hash,'hex'),
  'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid());
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'AGENCY_CHANGE_SOURCE_PHASE_UNAVAILABLE' using errcode='55000';
end;
$agency_source_phase$;

create or replace function private.weekly_source_agency_source_mutation_basis_v1(p_relation text,p_row jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $agency_source_basis$
declare keys text[];result jsonb;comparison public.weekly_issue_comparison_revisions%rowtype;
begin
 if p_row is null then return null;end if;
 if jsonb_typeof(p_row) is distinct from 'object' then
  raise exception 'AGENCY_ACTIVE_SOURCE_MUTATION_CONTEXT_INVALID' using errcode='55000';end if;
 case p_relation
 when 'public.timesheets' then keys:=array['timesheet_id','contract_id','booking_id'];
 when 'public.timesheets_financials' then keys:=array['id','timesheet_id','client_id','candidate_id'];
 when 'public.weekly_source_billing_movements' then
  keys:=array['id','final_revision_id','invoice_timesheet_id','actual_client_id','candidate_id','contract_id',
   'movement_economic_hash','source_profile_kind','source_line_kind'];
 when 'public.weekly_issue_comparison_revisions' then keys:=array['id','incident_id','contract_id'];
 when 'public.weekly_discrepancy_incidents' then
  keys:=array['id','source_cycle_id','client_id','work_event_id'];
 else return p_row;
 end case;
 select coalesce(jsonb_object_agg(key,value),'{}'::jsonb) into result from jsonb_each(p_row) where key=any(keys);
 if p_relation='public.weekly_discrepancy_incidents' then
  -- A native comparison pointer is a dependency only through the actual
  -- referenced Contract in bulk facts. New comparison wording/hours or an
  -- OPEN/CLOSED/audit update does not silently become another Source CAS.
  -- This new volatile BEFORE reader deliberately obtains a fresh explicit
  -- native reference; it does not relabel the existing STABLE CAS owners.
  if p_row->>'current_comparison_revision_id' is not null then
   select * into strict comparison from public.weekly_issue_comparison_revisions
    where id=(p_row->>'current_comparison_revision_id')::uuid and incident_id=(p_row->>'id')::uuid;
   result:=result||jsonb_build_object('source_contract_dependency',comparison.contract_id);
  else result:=result||jsonb_build_object('source_contract_dependency',null);end if;
 end if;
 return result;
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'AGENCY_ACTIVE_SOURCE_MUTATION_CONTEXT_INVALID' using errcode='55000';
end;
$agency_source_basis$;

create or replace function private.weekly_source_agency_active_source_mutation_assert_v1(
 p_relation text,p_old jsonb,p_new jsonb,p_raw_tokens jsonb
) returns void language plpgsql volatile security definer set search_path to 'pg_catalog','public','private','pg_temp'
as $agency_source_guard$
declare raw_tokens jsonb:='[]'::jsonb;nested_tokens jsonb:='[]'::jsonb;token jsonb;captured jsonb;
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
begin
 if p_old is null and p_new is null then
  raise exception 'AGENCY_ACTIVE_SOURCE_MUTATION_CONTEXT_INVALID' using errcode='55000';end if;
 if p_old is not null then raw_tokens:=raw_tokens||private.timesheet_correction_a0_source_raw_tokens_v1(p_relation,p_old);end if;
 if p_new is not null then raw_tokens:=raw_tokens||private.timesheet_correction_a0_source_raw_tokens_v1(p_relation,p_new);end if;
 if p_old is not null then nested_tokens:=nested_tokens||private.timesheet_correction_a0_source_revision_tokens_v1(p_relation,p_old)
  ||private.timesheet_correction_a0_source_policy_tokens_v1(p_relation,p_old);end if;
 if p_new is not null then nested_tokens:=nested_tokens||private.timesheet_correction_a0_source_revision_tokens_v1(p_relation,p_new)
  ||private.timesheet_correction_a0_source_policy_tokens_v1(p_relation,p_new);end if;
 raw_tokens:=raw_tokens||nested_tokens;
 -- Native trigger's exact RAW plus NESTED union, with duplicates preserved, must
 -- match. This is not a caller-normalised or sampled dependency list.
 if raw_tokens is distinct from p_raw_tokens then
  raise exception 'AGENCY_CHANGE_SOURCE_FOOTPRINT_CHANGED_UNDER_LOCK' using errcode='40001';end if;
 if private.weekly_source_agency_source_mutation_basis_v1(p_relation,p_old)
  is not distinct from private.weekly_source_agency_source_mutation_basis_v1(p_relation,p_new) then return;end if;
 for r in select request.* from private.weekly_source_agency_timesheet_change_requests request
  where request.state='ACTIVE' and exists(
   select 1 from jsonb_array_elements(raw_tokens) raw
   where request.current_source_dependency_tokens @> jsonb_build_array(raw)
    or(raw->>'kind' in('SOURCE_CONTRACT_COVERAGE','SOURCE_POLICY_MEMBERSHIP_COVERAGE') and exists(
     select 1 from jsonb_array_elements(request.current_source_dependency_tokens) held
      where held->>'kind'=raw->>'kind' and held->>'uuid'=raw->>'uuid'
       and daterange((held->'coverage'->>0)::date,(held->'coverage'->>1)::date,'[]')
         && daterange((raw->'coverage'->>0)::date,(raw->'coverage'->>1)::date,'[]'))))
  order by request.id
 loop
  -- The existing immutable creator/click digest and captured Source scope
  -- remain the authority; a corrupted request cannot unlock foreign Source.
  captured:=r.native_receipts->'original_capture';
  if captured->>'source_dependency_tokens_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_AGENCY_SOURCE_DEPENDENCY_TOKENS_V1',r.source_dependency_tokens),'hex')
   or r.request_sha256 is distinct from private.weekly_source_agency_change_request_sha256_v1(
    r.contract_week_id,r.reason,r.initial_row_signature,r.request_key,r.actor_user_id,captured)
   or not r.current_source_dependency_tokens @> r.source_dependency_tokens then
   raise exception 'AGENCY_ACTIVE_SOURCE_CAPTURE_INVALID' using errcode='55000';end if;
  raise exception 'AGENCY_ACTIVE_SOURCE_MUTATION_REFUSED' using errcode='40001',detail=jsonb_build_object(
   'schema_version','WEEKLY_SOURCE_AGENCY_ACTIVE_SOURCE_REFUSAL_V1','request_id',r.id,'request_key',r.request_key,
   'phase',r.phase,'current_timesheet_id',r.current_timesheet_id,'original_draft_invoice_id',r.original_draft_invoice_id,
   'source_cycle_id',r.source_cycle_id,'recovery','RESUME_SAME_REQUEST_WITH_CURRENT_SCOPED_ACTOR')::text;
 end loop;
end;
$agency_source_guard$;

create or replace function private.weekly_source_agency_change_capture_v1(
  p_contract_week_id uuid,p_actor_user_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  v_week public.contract_weeks%rowtype; v_ts public.timesheets%rowtype;
  v_contract public.contracts%rowtype; v_group public.weekly_source_groups%rowtype;
  v_cycle public.weekly_source_cycles%rowtype; v_upload public.weekly_source_uploads%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_profile public.weekly_source_format_profiles%rowtype; v_invoice public.invoices%rowtype;
  v_fin public.timesheets_financials%rowtype;
  v_rules jsonb; v_scope jsonb; v_locks jsonb; v_signature jsonb; v_cas jsonb;
  native_admission jsonb; source_admission jsonb;
  v_count integer; v_ids uuid[]; v_invoice_ids uuid[]; v_locked_invoice_ids uuid[]; v_schedule jsonb;
  v_requested_timesheet_id uuid; v_claim jsonb; v_original_submission jsonb; v_legacy_document jsonb; v_before_pay jsonb; v_before_pay_witness jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if current_setting('transaction_isolation') is distinct from 'read committed' then
    raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001'; end if;
  if p_contract_week_id is null or p_actor_user_id is null then
    raise exception 'AGENCY_CHANGE_REQUEST_INVALID' using errcode='22023'; end if;
  if private.weekly_source_pay_actor_allowed_v1(p_actor_user_id) is distinct from true then
    raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
  select * into strict v_week from public.contract_weeks where id=p_contract_week_id;
  select * into strict v_contract from public.contracts where id=v_week.contract_id;
  if coalesce(v_week.additional_seq,0)<>0 or coalesce(v_week.is_adjustment,false)
    or v_week.timesheet_id is null or v_contract.candidate_id is null or v_contract.client_id is null then
    raise exception 'AGENCY_INVOICE_SECOND_FAMILY_REFUSED' using errcode='55000'; end if;
  -- The native invoice editor owns invoice -> Timesheet/financial lock order.
  -- Probe actual T0 placement, lock the same D1 first, then acquire the
  -- unchanged native family lock and rederive both identities.
  v_requested_timesheet_id:=v_week.timesheet_id;
  select * into strict v_ts from public.timesheets where timesheet_id=v_requested_timesheet_id;
  native_admission:=private.weekly_source_agency_candidate_admit_v1(v_requested_timesheet_id,p_actor_user_id);
  -- Source routing answers which authoriser to call; Agency deliberately
  -- routes to the ordinary owner. Actual Agency admission remains the native
  -- Candidate/fence owner, preset predicate and dated scoped authority below.
  if private.weekly_source_agency_invoice_check_only_v1(v_requested_timesheet_id) is distinct from true then
    raise exception 'AGENCY_CHANGE_SOURCE_SCOPE_REFUSED' using errcode='42501'; end if;
  select coalesce(array_agg(distinct l.invoice_id order by l.invoice_id),'{}'::uuid[]) into v_locked_invoice_ids
    from public.invoice_lines l where l.timesheet_id=v_requested_timesheet_id;
  if cardinality(v_locked_invoice_ids)>1 then
    raise exception 'AGENCY_CHANGE_INVOICE_PLACEMENT_SPLIT' using errcode='55000'; end if;
  if cardinality(v_locked_invoice_ids)=1 then
    select * into strict v_invoice from public.invoices where id=v_locked_invoice_ids[1] for update;
    if v_invoice.type is distinct from 'INVOICE' or v_invoice.status not in('DRAFT','ON_HOLD')
      or v_invoice.issued_at_utc is not null or v_invoice.paid_at_utc is not null
      or v_invoice.client_id is distinct from v_contract.client_id then
      raise exception 'AGENCY_CHANGE_ORIGIN_INVOICE_NOT_DRAFT' using errcode='55000'; end if;
  end if;
  -- Call-only shared native family owner: canonical/raw booking locks, complete
  -- family row locks, Candidate binding and canonical collision refusal.
  v_locks:=private.weekly_source_lock_family_rows_v1(array[v_week.timesheet_id],v_contract.candidate_id);
  if v_locks->>'ok' is distinct from 'true' then
    raise exception 'AGENCY_CHANGE_NATIVE_FAMILY_LOCK_REFUSED' using errcode='55000',detail=v_locks::text; end if;
  select * into strict v_week from public.contract_weeks where id=p_contract_week_id for update;
  select * into strict v_ts from public.timesheets where timesheet_id=v_week.timesheet_id for update;
  if v_week.timesheet_id is distinct from v_requested_timesheet_id
    or v_ts.is_current is distinct from true or v_ts.revoked_at is not null or v_ts.archived_at_utc is not null
    or v_ts.status::text='REVOKED' or v_ts.contract_id is distinct from v_contract.id
    or v_ts.week_ending_date is distinct from v_week.week_ending_date
    or v_ts.sheet_scope::text is distinct from 'WEEKLY' or v_ts.line_type::text is distinct from 'HOURS'
    or v_ts.correction_id is not null or coalesce(v_ts.is_adjustment,false)
    or (select count(*) from public.timesheets t where btrim(t.booking_id)=btrim(v_ts.booking_id) and t.is_current)<>1
    or exists(select 1 from public.contract_weeks sibling where sibling.contract_id=v_week.contract_id
      and sibling.week_ending_date=v_week.week_ending_date and coalesce(sibling.additional_seq,0)=0
      and sibling.id<>v_week.id and sibling.timesheet_id is not null) then
    raise exception 'AGENCY_INVOICE_TIMESHEET_ROTATED' using errcode='40001'; end if;
  if private.weekly_source_agency_invoice_check_only_v1(v_ts.timesheet_id) is distinct from true then
    raise exception 'AGENCY_CHANGE_PRESET_SCOPE_REFUSED' using errcode='55000'; end if;
  select array_agg(c.id order by c.id) into v_ids from public.weekly_source_cycles c
    join public.weekly_source_groups g on g.id=c.source_group_id and g.active and g.source_family='ROSTER'
    join public.weekly_source_group_clients member on member.source_group_id=g.id and member.client_id=v_contract.client_id
      and v_week.week_ending_date between member.valid_from and coalesce(member.valid_to,'infinity'::date)
    where c.finalisation_week_ending=v_week.week_ending_date
      and (c.scope_client_id is null or c.scope_client_id=v_contract.client_id);
  -- A real Client cycle takes precedence over its group parent only when there
  -- is exactly one such Client cycle. A different Client is never a fallback.
  if cardinality(v_ids)>1 then
    select array_agg(c.id order by c.id) into v_ids from public.weekly_source_cycles c
      where c.id=any(v_ids) and c.scope_client_id=v_contract.client_id; end if;
  if coalesce(cardinality(v_ids),0)<>1 then
    raise exception 'AGENCY_CHANGE_SOURCE_CYCLE_AMBIGUOUS' using errcode='55000'; end if;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_ids[1] for update;
  select * into strict v_group from public.weekly_source_groups where id=v_cycle.source_group_id for update;
  if v_group.environment is distinct from 'TEST' then
    raise exception 'AGENCY_CHANGE_TEST_SCOPE_REQUIRED' using errcode='42501'; end if;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
    v_group.id,v_contract.client_id,v_week.week_ending_date);
  -- Exact current owner admits either the genuinely enabled assignment or its
  -- already-native current-XID OFF qualification authority. No local override.
  v_rules:=private.weekly_source_effective_rule_set_v1(v_contract.client_id,v_cycle.id);
  if v_rules->>'contract' is distinct from 'WEEKLY_SOURCE_EFFECTIVE_RULE_SET_V1'
    or v_rules->>'source_group_id' is distinct from v_group.id::text
    or v_rules#>>'{values,invoice_sender}' is distinct from 'AGENCY_INVOICE' then
    raise exception 'AGENCY_CHANGE_OPERATIONAL_RULE_UNAVAILABLE' using errcode='55000'; end if;
  source_admission:=private.weekly_source_agency_source_phase_admit_v1(v_ts.timesheet_id,p_actor_user_id,
    v_contract.candidate_id,v_cycle.id,v_contract.client_id,null::jsonb,native_admission);
  select * into strict v_publication from public.weekly_source_projection_publications
    where id=v_cycle.current_projection_publication_id and source_cycle_id=v_cycle.id
      and state='CURRENT' and authority_scope_kind='CYCLE' and correction_session_id is null and report_scope_id is null for update;
  select * into strict v_upload from public.weekly_source_uploads
    where id=v_cycle.current_complete_upload_id and id=v_publication.upload_id and source_cycle_id=v_cycle.id
      and state='CURRENT' and report_scope_id is null for update;
  perform private.weekly_source_query_current_publication_v1(v_cycle.id,v_publication.id);
  if v_upload.confirmed_coverage_start_local_date is null or v_upload.confirmed_coverage_end_local_date is null
    or v_upload.confirmed_coverage_start_local_date>v_week.week_ending_date-6
    or v_upload.confirmed_coverage_end_local_date<v_week.week_ending_date then
    raise exception 'AGENCY_CHANGE_ACCEPTED_COVERAGE_UNAVAILABLE' using errcode='55000'; end if;
  select * into strict v_profile from public.weekly_source_format_profiles
    where id=v_upload.source_format_profile_id and active;
  if v_profile.profile_code is distinct from v_rules#>>'{values,checking_profile_kind}'
    or ((v_profile.profile_code in('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1')
        and v_profile.final_authority_kind='HEALTHROSTER_ACTUAL_ROWS' and v_profile.row_finalisation_capability='FINALISED_ROW_ONLY')
      or(v_profile.profile_code='ROSTER_WEEKLY_SUMMARY_ACTUAL_V1'
        and v_profile.final_authority_kind='GENERIC_COMPLETE_SNAPSHOT' and v_profile.row_finalisation_capability='COMPLETE_FILE_ROWS')) is distinct from true then
    raise exception 'AGENCY_CHANGE_FINALISED_PROFILE_UNAVAILABLE' using errcode='55000'; end if;
  if exists(select 1 from public.weekly_source_row_resolutions r
    join public.weekly_source_upload_rows row_data on row_data.id=r.upload_row_id
    where row_data.upload_id=v_upload.id and r.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version)
      and r.contract_id=v_contract.id and r.candidate_id=v_contract.candidate_id and r.client_id=v_contract.client_id
      and row_data.work_date between v_week.week_ending_date-6 and v_week.week_ending_date
      and r.mapping_state='RESOLVED' and row_data.row_finalisation_state='SOURCE_WORKED'
      and (row_data.start_at_local is null or row_data.end_at_local is null or row_data.break_minutes is null
        or row_data.actual_net_minutes is null or row_data.actual_net_minutes<=0 or r.paid_minutes is distinct from row_data.actual_net_minutes
        or row_data.start_at_local::date<>row_data.work_date
        or row_data.end_at_local<=row_data.start_at_local
        or date_trunc('minute',row_data.start_at_local) is distinct from row_data.start_at_local
        or date_trunc('minute',row_data.end_at_local) is distinct from row_data.end_at_local
        or row_data.end_at_local::date is distinct from case when row_data.end_at_local::time<=row_data.start_at_local::time
          then row_data.work_date+1 else row_data.work_date end
        or extract(epoch from(row_data.end_at_local-row_data.start_at_local))/60-row_data.break_minutes<>row_data.actual_net_minutes
        or(v_profile.row_finalisation_capability='FINALISED_ROW_ONLY'
          and (nullif(btrim(row_data.finalised_by),'') is null
            or row_data.finalised_by is distinct from row_data.bounded_raw_columns_json->>'finalised_by')))) then
    raise exception 'AGENCY_CHANGE_FINALISED_ROW_PROVENANCE_INVALID' using errcode='55000'; end if;
  if exists(select 1 from public.weekly_source_row_resolutions r
    join public.weekly_source_upload_rows row_data on row_data.id=r.upload_row_id
    left join public.weekly_work_events event on event.id=r.work_event_id
    where row_data.upload_id=v_upload.id and r.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version)
      and r.contract_id=v_contract.id and r.candidate_id=v_contract.candidate_id and r.client_id=v_contract.client_id
      and row_data.work_date between v_week.week_ending_date-6 and v_week.week_ending_date
      and r.mapping_state='RESOLVED' and row_data.row_finalisation_state='SOURCE_WORKED'
      and (event.id is null or event.candidate_id is distinct from v_contract.candidate_id
        or event.client_id is distinct from v_contract.client_id or event.work_date is distinct from row_data.work_date
        or event.first_source_group_id is distinct from v_group.id)) then
    raise exception 'AGENCY_CHANGE_FINALISED_EVENT_PROVENANCE_INVALID' using errcode='55000'; end if;
  if exists(select 1 from public.weekly_source_row_resolutions r
    join public.weekly_source_upload_rows row_data on row_data.id=r.upload_row_id
    where row_data.upload_id=v_upload.id and r.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version)
      and r.contract_id=v_contract.id and row_data.work_date between v_week.week_ending_date-6 and v_week.week_ending_date
      and r.mapping_state='RESOLVED' and row_data.row_finalisation_state='SOURCE_WORKED'
    group by r.work_event_id having count(*)<>1) then
    raise exception 'AGENCY_CHANGE_FINALISED_EVENT_AMBIGUOUS' using errcode='55000'; end if;
  -- The schedule carries the native work_event_id. It contains no imported
  -- money, rates, planned hours or protected worker hours.
  select coalesce(jsonb_agg(jsonb_build_object('date',row_data.work_date::text,
      'start',to_char(row_data.start_at_local,'HH24:MI'),'end',to_char(row_data.end_at_local,'HH24:MI'),
      'end_date',row_data.end_at_local::date::text,'break_minutes',row_data.break_minutes,
      'source_shift_id',event.id::text,'work_event_id',event.id::text)
    order by row_data.work_date,row_data.start_at_local,event.id),'[]'::jsonb) into v_schedule
    from public.weekly_source_row_resolutions r
    join public.weekly_source_upload_rows row_data on row_data.id=r.upload_row_id
    join public.weekly_work_events event on event.id=r.work_event_id and event.candidate_id=v_contract.candidate_id
      and event.client_id=v_contract.client_id and event.work_date=row_data.work_date and event.first_source_group_id=v_group.id
    where row_data.upload_id=v_upload.id and r.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version)
      and r.contract_id=v_contract.id and r.candidate_id=v_contract.candidate_id and r.client_id=v_contract.client_id
      and row_data.work_date between v_week.week_ending_date-6 and v_week.week_ending_date
      and r.mapping_state='RESOLVED' and row_data.row_finalisation_state='SOURCE_WORKED';
  if jsonb_array_length(v_schedule)>100 or octet_length(v_schedule::text)>65536 then
    raise exception 'AGENCY_CHANGE_SCHEDULE_BOUND_EXCEEDED' using errcode='54000'; end if;
  select coalesce(array_agg(distinct l.invoice_id order by l.invoice_id),'{}'::uuid[]) into v_invoice_ids
    from public.invoice_lines l where l.timesheet_id=v_ts.timesheet_id;
  if v_invoice_ids is distinct from v_locked_invoice_ids then
    raise exception 'AGENCY_CHANGE_INVOICE_PLACEMENT_CHANGED_UNDER_LOCK' using errcode='40001'; end if;
  if coalesce(cardinality(v_invoice_ids),0)>1 then
    raise exception 'AGENCY_CHANGE_INVOICE_PLACEMENT_SPLIT' using errcode='55000'; end if;
  if cardinality(v_invoice_ids)=1 then
    select * into strict v_invoice from public.invoices where id=v_invoice_ids[1] for update;
    if v_invoice.type is distinct from 'INVOICE' or v_invoice.status not in('DRAFT','ON_HOLD')
      or v_invoice.issued_at_utc is not null or v_invoice.paid_at_utc is not null
      or v_invoice.client_id is distinct from v_contract.client_id then
      raise exception 'AGENCY_CHANGE_ORIGIN_INVOICE_NOT_DRAFT' using errcode='55000'; end if;
  end if;
  select count(*) into v_count from public.timesheets_financials where timesheet_id=v_ts.timesheet_id and is_current;
  if v_count<>1 then raise exception 'AGENCY_INVOICE_TSFIN_NOT_READY' using errcode='55000'; end if;
  select * into strict v_fin from public.timesheets_financials where timesheet_id=v_ts.timesheet_id and is_current for update;
  v_signature:=public.timesheet_lifecycle_guard_signature_v1(v_ts.timesheet_id,v_week.id,false);
  if nullif(btrim(coalesce(v_signature->>'backend_row_signature',v_signature->>'row_signature',v_signature->>'signature')),'') is null then
    raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000'; end if;
  v_cas:=private.weekly_source_bulk_source_cas_v1(v_cycle.id,array[v_contract.client_id]);
  if v_cas is distinct from source_admission->'source_cas' then
    raise exception 'AGENCY_CHANGE_SOURCE_FOOTPRINT_CHANGED_UNDER_LOCK' using errcode='40001';end if;
  v_before_pay:=private.weekly_source_agency_before_collection_inputs_v1(v_ts.timesheet_id,p_actor_user_id);
  if v_before_pay#>>'{scope,timesheet_id}' is distinct from v_ts.timesheet_id::text
    or v_before_pay#>>'{scope,timesheet_version}' is distinct from v_ts.version::text
    or v_before_pay#>>'{scope,current_financial_id}' is distinct from v_fin.id::text
    or v_before_pay#>>'{scope,actual_actor_user_id}' is distinct from p_actor_user_id::text
    or v_before_pay#>>'{scope,source_group_id}' is distinct from v_group.id::text
    or v_before_pay#>>'{scope,source_cycle_id}' is distinct from v_cycle.id::text then
    raise exception 'AGENCY_CHANGE_NATIVE_BEFORE_PAY_INPUTS_CHANGED' using errcode='40001'; end if;
  -- Retain actual scope, hashes and timing only, never a second cash ledger.
  v_before_pay_witness:=private.weekly_source_agency_original_pay_identity_v1(
    v_ts.timesheet_id,p_actor_user_id,v_fin.id,null::uuid);
  v_before_pay_witness:=(v_before_pay_witness-'native_original_reservations')||jsonb_build_object(
    'native_reservations_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'AGENCY_CURRENT_NATIVE_ORIGINAL_RESERVATIONS_V1',v_before_pay_witness->'native_original_reservations'),'hex'));
  v_before_pay_witness:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_BEFORE_PAY_INPUT_WITNESS_V1',
    'original_identity',v_before_pay_witness,
    'scope',v_before_pay->'scope','native_input_reason',v_before_pay->'reason',
    'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid(),
    'native_inputs_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_BEFORE_PAY_INPUTS_V1',v_before_pay),'hex'));
  if octet_length(v_before_pay_witness::text)>32768 then
    raise exception 'AGENCY_CHANGE_NATIVE_BEFORE_PAY_INPUT_BOUND_EXCEEDED' using errcode='54000'; end if;
  v_original_submission:=private.weekly_source_actual_timesheet_submission_v1(v_ts.timesheet_id);
  v_claim:=private.weekly_source_agency_submitted_claim_v1(v_ts.timesheet_id);
  -- Retain original native metadata/hash, not another hours/document store.
  if v_claim->>'available'='true' then
    v_claim:=(v_claim-'claim')||jsonb_build_object('claim_witness',v_claim->'claim'-'actual_schedule_json',
      'submission_state','IMMUTABLE_CANDIDATE_CLAIM');
  elsif v_original_submission->>'support_state'='NOT_SUBMITTED'
    and v_original_submission->>'actual_submitted'='false' then
    v_claim:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
      'available',true,'submission_state','NO_ORIGINAL_SUBMISSION','claim_witness',null,
      'claim_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_NO_ORIGINAL_SUBMISSION_V1',
        jsonb_build_object('timesheet_id',v_ts.timesheet_id,'timesheet_version',v_ts.version,
          'native_submission',v_original_submission))),'hex'),
      'native_submission',v_original_submission);
  end if;
  v_legacy_document:=private.weekly_source_agency_legacy_original_document_v1(v_ts.timesheet_id,null,p_actor_user_id);
  if v_legacy_document->>'available'='true' then
    v_legacy_document:=(v_legacy_document-'document_view')||jsonb_build_object(
      'document_witness',v_legacy_document->'document_view'-'original_shift_lines','document_state','FROZEN_DOCUMENT_VIEW');
  end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_CHANGE_NATIVE_CAPTURE_V1',
    'agency_id',v_group.agency_id,'environment',v_group.environment,'contract_week_id',v_week.id,
    'contract_id',v_contract.id,'candidate_id',v_contract.candidate_id,'client_id',v_contract.client_id,
    'week_ending_date',v_week.week_ending_date,'source_group_id',v_group.id,'source_cycle_id',v_cycle.id,
    'source_upload_id',v_upload.id,'source_publication_id',v_publication.id,
    'rule_set_version_id',(v_rules->>'rule_set_version_id')::uuid,'source_cas',v_cas,
    'source_dependency_tokens',source_admission->'source_dependency_tokens',
    'source_dependency_tokens_sha256',source_admission->>'source_dependency_tokens_sha256',
    'initial_timesheet_id',v_ts.timesheet_id,'initial_timesheet_version',v_ts.version,
    'initial_row_signature',btrim(coalesce(v_signature->>'backend_row_signature',v_signature->>'row_signature',v_signature->>'signature')),
    'canonical_family_booking_id',btrim(v_ts.booking_id),'original_draft_invoice_id',v_invoice.id,
    'original_draft_invoice_no',v_invoice.invoice_no,'current_financial_id',v_fin.id,'schedule',v_schedule,
    'original_submitted_claim',v_claim,'original_legacy_document',v_legacy_document,'original_before_pay_inputs',v_before_pay_witness);
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_CHANGE_NATIVE_CAPTURE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_change_request_sha256_v1(
  p_contract_week_id uuid,p_reason text,p_expected_signature text,p_request_key text,
  p_original_creator_user_id uuid,p_original_capture jsonb
) returns bytea language sql immutable
set search_path to 'pg_catalog','private','pg_temp'
as $function$
  select private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_CHANGE_REQUEST_V1',jsonb_build_object(
    'contract_week_id',p_contract_week_id,'reason',p_reason,'expected_signature',p_expected_signature,
    'request_key',p_request_key,'original_creator_user_id',p_original_creator_user_id,
    'original_capture',p_original_capture));
$function$;

create or replace function private.weekly_source_agency_original_claim_recheck_v1(
 p_request_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 w public.candidate_submission_workflows%rowtype;
 h public.candidate_submission_components%rowtype; sig public.candidate_submission_components%rowtype;
 t public.timesheets%rowtype; capture jsonb; stored jsonb; witness jsonb;
 input jsonb; patch jsonb; schedule jsonb; actual jsonb; count_hours integer;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 capture:=r.native_receipts->'original_capture';stored:=capture->'original_submitted_claim';
 if private.weekly_source_agency_change_request_sha256_v1(r.contract_week_id,r.reason,r.initial_row_signature,
  r.request_key,r.actor_user_id,capture) is distinct from r.request_sha256 then
  raise exception 'AGENCY_CHANGE_ORIGINAL_REQUEST_DIGEST_INVALID' using errcode='55000'; end if;
 select * into strict t from public.timesheets where timesheet_id=r.initial_timesheet_id;
 if r.current_timesheet_id is distinct from r.initial_timesheet_id or t.is_current is distinct from true
  or t.version is distinct from r.initial_timesheet_version or t.contract_id is distinct from r.contract_id
  or t.week_ending_date is distinct from r.week_ending_date or t.sheet_scope::text is distinct from 'WEEKLY'
  or t.line_type::text is distinct from 'HOURS' or t.archived_at_utc is not null
  or (t.revoked_at is not null and coalesce((t.revoked_reason='TIMESHEET_UNAUTHORISE'
    and t.revoked_by=r.native_receipts#>>'{unauthorise,phase_actor_user_id}'
    and r.native_receipts#>>'{unauthorise,result,timesheet_id}'=t.timesheet_id::text
    and r.native_receipts#>>'{unauthorise,result,ok}'='true'
    and r.phase in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT')),false) is distinct from true) then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_SCOPE_CHANGED' using errcode='40001'; end if;
 if stored->>'available' is distinct from 'true' then
  return jsonb_build_object('available',false,'reason',coalesce(stored->>'reason','ORIGINAL_CLAIM_PRODUCER_UNAVAILABLE'));
 end if;
 if stored->>'submission_state'='NO_ORIGINAL_SUBMISSION' then
  if stored#>>'{native_submission,actual_submitted}' is distinct from 'false'
   or stored#>>'{native_submission,support_state}' is distinct from 'NOT_SUBMITTED'
   or stored->>'claim_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_AGENCY_NO_ORIGINAL_SUBMISSION_V1',jsonb_build_object('timesheet_id',r.initial_timesheet_id,
     'timesheet_version',r.initial_timesheet_version,'native_submission',stored->'native_submission')),'hex')
   or exists(select 1 from public.candidate_submission_workflows workflow
    where workflow.target_timesheet_id=t.timesheet_id and workflow.candidate_id=r.candidate_id
     and workflow.worker_submitted_at_utc is not null and workflow.cancelled_at_utc is null
     and workflow.workflow_kind in('CONTRACT_HOURS','CONTRACT_COMBINED')
     and workflow.state in('WORKER_SUBMITTED','WORKER_SUBMITTED_PENDING_REVIEW_DOCUMENT','READY_FOR_MANAGER_APPROVAL',
       'AWAITING_MANAGER_APPROVAL','MANAGER_APPROVED','MANAGER_APPROVED_PENDING_FINAL_DOCUMENT','READY_TO_FINALISE',
       'AWAITING_PAPER_RETURN','RECEIVED','FINALISED')) then
   raise exception 'AGENCY_CHANGE_ORIGINAL_SUBMISSION_CHANGED' using errcode='40001'; end if;
  -- This is a proved original absence, not a paid quantity or signed claim.
  return jsonb_build_object('available',true,'submission_state','NO_ORIGINAL_SUBMISSION',
   'claim_sha256',stored->'claim_sha256','claim',null);
 end if;
 if stored->>'submission_state' is distinct from 'IMMUTABLE_CANDIDATE_CLAIM'
  or jsonb_typeof(stored->'claim_witness') is distinct from 'object' then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_PRODUCER_UNAVAILABLE' using errcode='55000'; end if;
 witness:=stored->'claim_witness';
 select * into strict w from public.candidate_submission_workflows
  where id=(witness->>'workflow_id')::uuid and generation=(witness->>'workflow_generation')::integer
   and target_timesheet_id=r.initial_timesheet_id and candidate_id=r.candidate_id and contract_id=r.contract_id
   and environment=r.environment
   and week_ending_date=r.week_ending_date and scope='WEEKLY'
   and workflow_kind in('CONTRACT_HOURS','CONTRACT_COMBINED') and worker_submitted_at_utc is not null
   and cancelled_at_utc is null and state in('WORKER_SUBMITTED','WORKER_SUBMITTED_PENDING_REVIEW_DOCUMENT',
    'READY_FOR_MANAGER_APPROVAL','AWAITING_MANAGER_APPROVAL','MANAGER_APPROVED','MANAGER_APPROVED_PENDING_FINAL_DOCUMENT',
    'READY_TO_FINALISE','AWAITING_PAPER_RETURN','RECEIVED','FINALISED');
 if jsonb_typeof(w.immutable_submission_json) is distinct from 'object'
  or octet_length(w.immutable_submission_sha256) is distinct from 32
  or private._candidate_sha256_jsonb_v1(w.immutable_submission_json) is distinct from w.immutable_submission_sha256
  or encode(w.immutable_submission_sha256,'hex') is distinct from witness->>'submission_sha256'
  or (t.candidate_workflow_id is not null and (t.candidate_workflow_id is distinct from w.id
    or t.candidate_workflow_generation is distinct from w.generation)) then
  raise exception 'AGENCY_CHANGE_ORIGINAL_SUBMISSION_CHANGED' using errcode='40001'; end if;
 select count(*) into count_hours from public.candidate_submission_components component
  where component.workflow_id=w.id and component.workflow_generation=w.generation
   and component.component_kind='HOURS_TIMESHEET' and component.required
   and component.state='IMMUTABLE' and component.immutable_at_utc is not null
   and (component.timesheet_id is null or component.timesheet_id=t.timesheet_id);
 select * into strict h from public.candidate_submission_components where id=(witness->>'hours_component_id')::uuid
  and workflow_id=w.id and workflow_generation=w.generation and component_kind='HOURS_TIMESHEET'
  and required and state='IMMUTABLE' and immutable_at_utc is not null
  and (timesheet_id is null or timesheet_id=t.timesheet_id);
 select * into strict sig from public.candidate_submission_components where id=w.candidate_signature_component_id
  and id=(witness->>'candidate_signature_component_id')::uuid and workflow_id=w.id and workflow_generation=w.generation
  and document_role='CANDIDATE_SIGNATURE' and state='IMMUTABLE' and immutable_at_utc is not null;
 if count_hours<>1 or w.candidate_signed_at_utc is null or nullif(btrim(sig.storage_key),'') is null
  or octet_length(sig.source_content_sha256) is distinct from 32
  or sig.source_content_sha256 is distinct from w.candidate_signature_sha256 then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_COMPONENT_CHANGED' using errcode='40001'; end if;
 input:=coalesce(w.immutable_submission_json->'hours_submission',w.immutable_submission_json);
 patch:=coalesce(input->'timesheet_patch_json',input);
 schedule:=coalesce(patch->'actual_schedule_json',input#>'{canonical_tsfin_snapshot,actual_schedule_json}');
 if jsonb_typeof(schedule) is distinct from 'array' or jsonb_array_length(schedule)>100
  or octet_length(schedule::text)>65536 then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_BOUND_INVALID' using errcode='55000'; end if;
 actual:=jsonb_build_object('authority','CANDIDATE_IMMUTABLE_HOURS','timesheet_id',t.timesheet_id,
  'timesheet_version',r.initial_timesheet_version,'candidate_id',r.candidate_id,'client_id',r.client_id,
  'contract_id',r.contract_id,'week_ending_date',r.week_ending_date,'workflow_id',w.id,'workflow_generation',w.generation,
  'submission_sha256',encode(w.immutable_submission_sha256,'hex'),'hours_component_id',h.id,
  'candidate_signature_component_id',sig.id,'submitted_at_utc',w.worker_submitted_at_utc,
  'signed_at_utc',w.candidate_signed_at_utc,'actual_schedule_json',schedule);
 -- Validate the actual native instants, while retaining the original emitted
 -- timestamp strings so a different session TimeZone cannot rewrite claim bytes.
 if actual-array['actual_schedule_json','submitted_at_utc','signed_at_utc']
    is distinct from witness-array['submitted_at_utc','signed_at_utc']
  or (witness->>'submitted_at_utc')::timestamptz is distinct from w.worker_submitted_at_utc
  or (witness->>'signed_at_utc')::timestamptz is distinct from w.candidate_signed_at_utc then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_CHANGED' using errcode='40001'; end if;
 actual:=witness||jsonb_build_object('actual_schedule_json',schedule);
 if encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',actual),'hex')
    is distinct from stored->>'claim_sha256' then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_CHANGED' using errcode='40001'; end if;
 return jsonb_build_object('available',true,'submission_state','IMMUTABLE_CANDIDATE_CLAIM',
  'claim_sha256',stored->'claim_sha256','claim',actual);
exception when no_data_found or too_many_rows or invalid_text_representation
 or invalid_datetime_format or datetime_field_overflow then
 raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_change_request_assert_v1(
  p_contract_week_id uuid,p_reason text,p_expected_signature text,p_request_key text,p_actor_user_id uuid
) returns private.weekly_source_agency_timesheet_change_requests
language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  v_request private.weekly_source_agency_timesheet_change_requests%rowtype;
  v_week public.contract_weeks%rowtype; v_ts public.timesheets%rowtype;
  v_contract public.contracts%rowtype; v_group public.weekly_source_groups%rowtype;
  v_locks jsonb; v_signature jsonb; v_original jsonb; v_cas jsonb; v_scope jsonb;
  v_hash bytea; v_unauthorise_actor text; v_rule_version uuid; native_admission jsonb; source_admission jsonb; merged_tokens jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if current_setting('transaction_isolation') is distinct from 'read committed' then
    raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001'; end if;
  if p_contract_week_id is null or p_actor_user_id is null or p_request_key is null
    or length(p_request_key) not between 1 and 200 or p_request_key is distinct from btrim(p_request_key)
    or p_reason is null or length(p_reason) not between 1 and 2000 or p_reason is distinct from btrim(p_reason)
    or p_expected_signature is null or length(p_expected_signature) not between 1 and 512 then
    raise exception 'AGENCY_CHANGE_REQUEST_INVALID' using errcode='22023'; end if;
  if private.weekly_source_pay_actor_allowed_v1(p_actor_user_id) is distinct from true then
    raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
  select * into strict v_request from private.weekly_source_agency_timesheet_change_requests where request_key=p_request_key;
  if p_contract_week_id is distinct from v_request.contract_week_id or p_reason is distinct from v_request.reason
    or p_expected_signature is distinct from v_request.initial_row_signature then
    raise exception 'AGENCY_CHANGE_REQUEST_KEY_REUSED' using errcode='22023'; end if;
  v_original:=v_request.native_receipts->'original_capture';
  if jsonb_typeof(v_original) is distinct from 'object'
    or v_original->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_CHANGE_NATIVE_CAPTURE_V1'
    or v_original->>'contract_week_id' is distinct from v_request.contract_week_id::text
    or v_original->>'contract_id' is distinct from v_request.contract_id::text
    or v_original->>'candidate_id' is distinct from v_request.candidate_id::text
    or v_original->>'client_id' is distinct from v_request.client_id::text
    or v_original->>'agency_id' is distinct from v_request.agency_id::text
    or v_original->>'environment' is distinct from v_request.environment
    or v_original->>'week_ending_date' is distinct from v_request.week_ending_date::text
    or v_original->>'source_group_id' is distinct from v_request.source_group_id::text
    or v_original->>'source_cycle_id' is distinct from v_request.source_cycle_id::text
    or v_original->>'source_upload_id' is distinct from v_request.source_upload_id::text
    or v_original->>'source_publication_id' is distinct from v_request.source_publication_id::text
    or v_original->>'rule_set_version_id' is distinct from v_request.rule_set_version_id::text
    or v_original->'source_cas' is distinct from v_request.source_cas
    or v_original->>'initial_timesheet_id' is distinct from v_request.initial_timesheet_id::text
    or v_original->>'initial_timesheet_version' is distinct from v_request.initial_timesheet_version::text
    or v_original->>'initial_row_signature' is distinct from v_request.initial_row_signature
    or v_original->>'canonical_family_booking_id' is distinct from v_request.canonical_family_booking_id
    or v_original->>'original_draft_invoice_id' is distinct from v_request.original_draft_invoice_id::text
    or v_original->>'original_draft_invoice_no' is distinct from v_request.original_draft_invoice_no then
    raise exception 'AGENCY_CHANGE_ORIGINAL_CAPTURE_INVALID' using errcode='55000'; end if;
  -- The current actor is deliberately NOT the creator parameter here. This
  -- rechecks the original immutable capture even after a native phase changed T0.
  v_hash:=private.weekly_source_agency_change_request_sha256_v1(p_contract_week_id,p_reason,p_expected_signature,
    p_request_key,v_request.actor_user_id,v_original);
  if v_hash is distinct from v_request.request_sha256 then
    raise exception 'AGENCY_CHANGE_ORIGINAL_REQUEST_DIGEST_INVALID' using errcode='55000'; end if;
  select * into strict v_week from public.contract_weeks where id=v_request.contract_week_id;
  select * into strict v_contract from public.contracts where id=v_request.contract_id;
  if v_week.contract_id is distinct from v_request.contract_id or v_week.week_ending_date is distinct from v_request.week_ending_date
    or coalesce(v_week.additional_seq,0)<>0 or coalesce(v_week.is_adjustment,false)
    or v_week.timesheet_id is null or v_contract.candidate_id is distinct from v_request.candidate_id
    or v_contract.client_id is distinct from v_request.client_id then
    raise exception 'AGENCY_CHANGE_CURRENT_SUBJECT_SCOPE_CHANGED' using errcode='40001'; end if;
  native_admission:=private.weekly_source_agency_candidate_admit_v1(v_week.timesheet_id,p_actor_user_id);
  -- Preserve invoice -> Timesheet/financial order. The immutable D1 is the
  -- only return destination; an unrelated placement is never adopted.
  if v_request.state='ACTIVE' then
    if v_request.original_draft_invoice_id is not null then
      perform 1 from public.invoices where id=v_request.original_draft_invoice_id for update;
      if not found then
        raise exception 'AGENCY_DRAFT_ROUND_TRIP_ORIGINAL_D1_CHANGED' using errcode='40001'; end if;
    end if;
    if exists(select 1 from public.invoice_lines line
      where line.timesheet_id in(v_request.initial_timesheet_id,v_request.current_timesheet_id)
        and line.invoice_id is distinct from v_request.original_draft_invoice_id) then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_FOREIGN_PLACEMENT' using errcode='40001'; end if;
  end if;
  v_locks:=private.weekly_source_lock_family_rows_v1(array[v_week.timesheet_id],v_request.candidate_id);
  if v_locks->>'ok' is distinct from 'true' then
    raise exception 'AGENCY_CHANGE_NATIVE_FAMILY_LOCK_REFUSED' using errcode='55000',detail=v_locks::text; end if;
  select * into strict v_week from public.contract_weeks where id=v_request.contract_week_id for update;
  select * into strict v_ts from public.timesheets where timesheet_id=v_week.timesheet_id for update;
  select * into strict v_group from public.weekly_source_groups where id=v_request.source_group_id and active and source_family='ROSTER' for update;
  if v_group.agency_id is distinct from v_request.agency_id or v_group.environment is distinct from 'TEST'
    or v_ts.contract_id is distinct from v_request.contract_id or v_ts.week_ending_date is distinct from v_request.week_ending_date
    or v_ts.is_current is distinct from true or v_ts.archived_at_utc is not null
    or v_ts.sheet_scope::text is distinct from 'WEEKLY' or v_ts.line_type::text is distinct from 'HOURS'
    or v_ts.correction_id is not null or coalesce(v_ts.is_adjustment,false) then
    raise exception 'AGENCY_CHANGE_CURRENT_SUBJECT_SCOPE_CHANGED' using errcode='40001'; end if;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
    v_group.id,v_request.client_id,v_request.week_ending_date);
  if (select count(*) from public.weekly_source_group_clients membership
    join public.weekly_source_groups source_group on source_group.id=membership.source_group_id and source_group.active
    where membership.client_id=v_request.client_id and v_request.week_ending_date between membership.valid_from
      and coalesce(membership.valid_to,'infinity'::date))<>1 then
    raise exception 'WEEKLY_SOURCE_AUTHORISE_SCOPE_AMBIGUOUS' using errcode='55000'; end if;
  select * into strict v_request from private.weekly_source_agency_timesheet_change_requests where id=v_request.id for update;
  if v_request.state='COMPLETED' then
    -- No economic action or relabelled authorisation. Exact completed receipt
    -- is readable only after the genuine current user's present subject scope.
    -- Candidate/fence admission, actual current main-week/root, exact dated
    -- membership and scoped VIEW_PAY_WORK were rechecked above. The Source
    -- router correctly returns false for Agency and grants no action authority.
    return v_request;
  end if;
  if exists(select 1 from public.invoice_lines line
    where line.timesheet_id in(v_request.initial_timesheet_id,v_request.current_timesheet_id)
      and line.invoice_id is distinct from v_request.original_draft_invoice_id) then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_FOREIGN_PLACEMENT' using errcode='40001'; end if;
  if v_ts.timesheet_id is distinct from v_request.current_timesheet_id
    or v_ts.version is distinct from v_request.current_timesheet_version
    or btrim(v_ts.booking_id) is distinct from v_request.canonical_family_booking_id then
    raise exception 'AGENCY_INVOICE_TIMESHEET_ROTATED' using errcode='40001'; end if;
  if v_ts.revoked_at is not null then
    v_unauthorise_actor:=v_request.native_receipts#>>'{unauthorise,phase_actor_user_id}';
    if v_request.phase not in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT')
      or v_ts.revoked_reason is distinct from 'TIMESHEET_UNAUTHORISE'
      or v_ts.revoked_by is distinct from v_unauthorise_actor
      or v_request.native_receipts#>>'{unauthorise,result,timesheet_id}' is distinct from v_ts.timesheet_id::text
      or v_request.native_receipts#>>'{unauthorise,result,ok}' is distinct from 'true' then
      raise exception 'AGENCY_INVOICE_TIMESHEET_ROTATED' using errcode='40001'; end if;
  end if;
  -- Every advancing native phase rechecks the actual immutable original claim.
  -- The helper retains unavailable/absence semantics; no claim is manufactured.
  perform private.weekly_source_agency_original_claim_recheck_v1(v_request.id);
  v_cas:=private.weekly_source_bulk_source_cas_v1(v_request.source_cycle_id,array[v_request.client_id]);
  if v_cas is distinct from v_request.source_cas then
    raise exception 'AGENCY_CHANGE_ORIGINAL_SOURCE_CAS_CHANGED' using errcode='40001'; end if;
  select (private.weekly_source_effective_rule_set_v1(v_request.client_id,v_request.source_cycle_id)->>'rule_set_version_id')::uuid
    into v_rule_version;
  if v_rule_version is distinct from v_request.rule_set_version_id then
    raise exception 'AGENCY_CHANGE_OPERATIONAL_RULE_UNAVAILABLE' using errcode='55000'; end if;
  if v_original->>'source_dependency_tokens_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_AGENCY_SOURCE_DEPENDENCY_TOKENS_V1',v_request.source_dependency_tokens),'hex') then
    raise exception 'AGENCY_CHANGE_ORIGINAL_NATIVE_SOURCE_FOOTPRINT_CHANGED' using errcode='55000';end if;
  source_admission:=private.weekly_source_agency_source_phase_admit_v1(v_ts.timesheet_id,p_actor_user_id,
    v_request.candidate_id,v_request.source_cycle_id,v_request.client_id,v_request.source_cas,native_admission);
  select coalesce(jsonb_agg(value order by value),'[]'::jsonb) into merged_tokens from(
    select distinct value from jsonb_array_elements(v_request.current_source_dependency_tokens||(source_admission->'source_dependency_tokens'))
  ) native_current_union;
  if merged_tokens is distinct from v_request.current_source_dependency_tokens then
    source_admission:=(source_admission-'source_dependency_tokens')||jsonb_build_object('request_id',v_request.id,
      'request_sha256',encode(v_request.request_sha256,'hex'),'source_dependency_tokens_sha256',encode(
        private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_SOURCE_DEPENDENCY_TOKENS_V1',merged_tokens),'hex'));
    update private.weekly_source_agency_timesheet_change_requests set current_source_dependency_tokens=merged_tokens,
      native_receipts=native_receipts||jsonb_build_object('source_admission',source_admission),
      updated_by_user_id=p_actor_user_id,updated_at_utc=transaction_timestamp(),version=version+1
      where id=v_request.id returning * into v_request;
    insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,action,after_json,reason,correlation_id)
      select gen_random_uuid(),transaction_timestamp(),p_actor_user_id,a.role,'WEEKLY_SOURCE_AGENCY_CHANGE',v_request.id::text,
        'NATIVE_SOURCE_FOOTPRINT_RETAINED',jsonb_build_object('phase',v_request.phase,'request_version',v_request.version,
          'original_creator_user_id',v_request.actor_user_id,'current_resumer_user_id',p_actor_user_id,
          'source_dependency_tokens_sha256',source_admission->>'source_dependency_tokens_sha256'),v_request.reason,v_request.request_key
      from public.tms_users a where a.id=p_actor_user_id and a.is_active;
    if not found then raise exception 'AGENCY_CHANGE_CURRENT_ACTOR_UNAVAILABLE' using errcode='42501';end if;
  end if;
  v_signature:=public.timesheet_lifecycle_guard_signature_v1(v_ts.timesheet_id,v_week.id,false);
  -- A changed signature is admissible only when the existing canonical writer
  -- observation has retained its actual matching outbox/current financial cut.
  -- Generic TSFIN currentness or outbox disappearance alone never proves it.
  if btrim(coalesce(v_signature->>'backend_row_signature',v_signature->>'row_signature',v_signature->>'signature'))
    is distinct from v_request.current_row_signature
    and coalesce((v_request.phase='UNAUTHORISED'
      and v_request.native_receipts#>>'{financial_write_frame,mode}'='MANUAL'
      and v_request.native_receipts#>>'{financial_write_frame,request_id}'=v_request.id::text
      and v_request.native_receipts#>>'{financial_write_frame,request_sha256}'=encode(v_request.request_sha256,'hex')
      and v_request.native_receipts#>>'{financial_write_frame,transaction_id}'=pg_current_xact_id()::text
      and v_request.native_receipts#>>'{financial_write_frame,backend_pid}'=pg_backend_pid()::text
      and v_request.native_receipts#>>'{financial_write_frame,phase_actor_user_id}'=v_request.updated_by_user_id::text
      and v_request.native_receipts#>>'{financial_write_frame,timesheet_id}'=v_ts.timesheet_id::text
      and v_request.native_receipts#>>'{financial_write_frame,timesheet_version}'=v_ts.version::text
      and v_request.native_receipts#>'{financial_write_frame,source_cas}'=v_request.source_cas
      and v_ts.actual_schedule_json=v_request.native_receipts#>'{original_capture,schedule}')
     or(v_request.phase='RECOMPUTE_PENDING'
      and v_request.native_receipts#>>'{recompute,observed_outbox_id}'=v_request.outbox_id::text
      and v_request.native_receipts#>>'{recompute,timesheet_id}'=v_request.current_timesheet_id::text
      and v_request.native_receipts#>>'{recompute,timesheet_version}'=v_request.current_timesheet_version::text
      and exists(select 1 from public.timesheets_financials tf where tf.is_current
        and tf.id::text=v_request.native_receipts#>>'{recompute,financial_id}'
        and tf.timesheet_id=v_request.current_timesheet_id and tf.timesheet_version=v_request.current_timesheet_version
        and encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_RECOMPUTE_ROW_V1',to_jsonb(tf)),'hex')
          =v_request.native_receipts#>>'{recompute,financial_row_sha256}')),false) is distinct from true then
    raise exception 'AGENCY_CHANGE_CURRENT_PHASE_SIGNATURE_CHANGED' using errcode='40001'; end if;
  return v_request;
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_CHANGE_CURRENT_REQUEST_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_agency_change_begin_v1(
 p_contract_week_id uuid,p_reason text,p_expected_signature text,p_request_key text,p_actor_user_id uuid
) returns private.weekly_source_agency_timesheet_change_requests
language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 capture jsonb; signature jsonb; receipt jsonb; native_result jsonb;
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype; cw public.contract_weeks%rowtype;
 actor public.tms_users%rowtype; next_signature text; error_code text; error_state text;
 audit_id uuid; receipts jsonb; pay_purpose jsonb; dependency_tokens jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001'; end if;
 if p_contract_week_id is null or p_actor_user_id is null or p_reason is null
  or length(p_reason) not between 1 and 2000 or p_reason is distinct from btrim(p_reason)
  or p_request_key is null or length(p_request_key) not between 1 and 200
  or p_request_key is distinct from btrim(p_request_key)
  or p_expected_signature is null or length(p_expected_signature) not between 1 and 512 then
  raise exception 'AGENCY_CHANGE_REQUEST_INVALID' using errcode='22023'; end if;
 if private.weekly_source_pay_actor_allowed_v1(p_actor_user_id) is distinct from true then
  raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
 select * into strict actor from public.tms_users where id=p_actor_user_id and is_active;
 -- Only duplicate click-key admission serialisation; real invoice/family/source
 -- locks are still derived and taken by capture/request authority in native order.
 perform pg_advisory_xact_lock(hashtextextended('weekly_source_agency_change_key:'||p_request_key,0));
 select * into r from private.weekly_source_agency_timesheet_change_requests where request_key=p_request_key;
 if found then
  r:=private.weekly_source_agency_change_request_assert_v1(p_contract_week_id,p_reason,
    p_expected_signature,p_request_key,p_actor_user_id);
  if r.state='COMPLETED' then return r; end if;
  if r.updated_by_user_id is distinct from p_actor_user_id then
   update private.weekly_source_agency_timesheet_change_requests set updated_by_user_id=p_actor_user_id,
    updated_at_utc=transaction_timestamp(),version=version+1 where id=r.id returning * into r;
   insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,
     action,after_json,reason,correlation_id)
    values(gen_random_uuid(),transaction_timestamp(),p_actor_user_id,actor.role,'WEEKLY_SOURCE_AGENCY_CHANGE',r.id::text,
      'RESUME_CURRENT_SCOPED_ACTOR',jsonb_build_object('phase',r.phase,'request_version',r.version,
        'original_creator_user_id',r.actor_user_id,'current_resumer_user_id',p_actor_user_id),p_reason,r.request_key);
  end if;
 else
  capture:=private.weekly_source_agency_change_capture_v1(p_contract_week_id,p_actor_user_id);
  dependency_tokens:=capture->'source_dependency_tokens';
  if jsonb_typeof(dependency_tokens) is distinct from 'array'
   or capture->>'source_dependency_tokens_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_AGENCY_SOURCE_DEPENDENCY_TOKENS_V1',dependency_tokens),'hex') then
   raise exception 'AGENCY_CHANGE_NATIVE_SOURCE_FOOTPRINT_REQUIRED' using errcode='55000';end if;
  -- Keep the actual full immutable tokens on the same request, and only their
  -- native digest in the original small capture / request-input hash.
  capture:=capture-'source_dependency_tokens';
  if capture->>'initial_row_signature' is distinct from p_expected_signature then
   raise exception 'AGENCY_CHANGE_EXPECTED_SIGNATURE_CHANGED' using errcode='40001'; end if;
  if octet_length(jsonb_build_object('original_capture',capture)::text)>49152 then
   raise exception 'AGENCY_CHANGE_NATIVE_CAPTURE_BOUND_EXCEEDED' using errcode='54000'; end if;
  if exists(select 1 from private.weekly_source_agency_timesheet_change_requests active
   where active.state='ACTIVE' and (active.contract_week_id=p_contract_week_id
     or(active.agency_id=(capture->>'agency_id')::uuid
       and active.canonical_family_booking_id=capture->>'canonical_family_booking_id'))) then
   raise exception 'AGENCY_CHANGE_EXISTING_ACTIVE_REQUEST_REQUIRED' using errcode='40001'; end if;
  insert into private.weekly_source_agency_timesheet_change_requests(
   request_key,request_sha256,actor_user_id,reason,environment,agency_id,contract_week_id,contract_id,candidate_id,
   client_id,week_ending_date,source_group_id,source_cycle_id,source_upload_id,source_publication_id,rule_set_version_id,
   source_cas,source_dependency_tokens,current_source_dependency_tokens,initial_timesheet_id,initial_timesheet_version,initial_row_signature,canonical_family_booking_id,
   original_draft_invoice_id,original_draft_invoice_no,current_timesheet_id,current_timesheet_version,current_row_signature,
   return_hold,current_financial_id,native_receipts,updated_by_user_id)
  values(p_request_key,private.weekly_source_agency_change_request_sha256_v1(p_contract_week_id,p_reason,
    p_expected_signature,p_request_key,p_actor_user_id,capture),p_actor_user_id,p_reason,'TEST',
   (capture->>'agency_id')::uuid,p_contract_week_id,(capture->>'contract_id')::uuid,(capture->>'candidate_id')::uuid,
   (capture->>'client_id')::uuid,(capture->>'week_ending_date')::date,(capture->>'source_group_id')::uuid,
   (capture->>'source_cycle_id')::uuid,(capture->>'source_upload_id')::uuid,(capture->>'source_publication_id')::uuid,
   (capture->>'rule_set_version_id')::uuid,capture->'source_cas',dependency_tokens,dependency_tokens,(capture->>'initial_timesheet_id')::uuid,
   (capture->>'initial_timesheet_version')::integer,p_expected_signature,capture->>'canonical_family_booking_id',
   (capture->>'original_draft_invoice_id')::uuid,capture->>'original_draft_invoice_no',
   (capture->>'initial_timesheet_id')::uuid,(capture->>'initial_timesheet_version')::integer,p_expected_signature,
   false,(capture->>'current_financial_id')::uuid,
   jsonb_build_object('original_capture',capture),p_actor_user_id) returning * into r;
  insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,
    action,after_json,reason,correlation_id)
   values(gen_random_uuid(),transaction_timestamp(),p_actor_user_id,actor.role,'WEEKLY_SOURCE_AGENCY_CHANGE',r.id::text,
    'CAPTURE_NATIVE_REQUEST',jsonb_build_object('phase',r.phase,'request_version',r.version,
      'request_sha256',encode(r.request_sha256,'hex')),p_reason,p_request_key);
 end if;
 -- Each attempted phase has its own subtransaction. Failure does not relabel
 -- an earlier real phase, discard D1's hold or manufacture queue/completion.
 if r.phase='CAPTURED' then
  begin
   if r.original_draft_invoice_id is not null then
    receipt:=private.weekly_source_agency_draft_round_trip_v1(r.request_key,'REMOVE',p_actor_user_id);
    if receipt->>'ok' is distinct from 'true' or receipt->>'step' is distinct from 'REMOVE'
     or receipt->>'request_id' is distinct from r.id::text then
     raise exception 'AGENCY_CHANGE_NATIVE_DRAFT_REMOVAL_UNPROVED'; end if;
    next_signature:=receipt->>'current_row_signature';
   else
    if exists(select 1 from public.invoice_lines l where l.timesheet_id=r.current_timesheet_id) then
     raise exception 'AGENCY_CHANGE_FOREIGN_DRAFT_PLACEMENT'; end if;
    signature:=public.timesheet_lifecycle_guard_signature_v1(r.current_timesheet_id,r.contract_week_id,false);
    next_signature:=btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature'));
    receipt:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_DRAFT_ABSENCE_V1',
      'request_id',r.id,'timesheet_id',r.current_timesheet_id,'original_draft_invoice_id',null,
      'native_editor_called',false,'native_observed_no_placement',true,'phase_actor_user_id',p_actor_user_id);
   end if;
   if nullif(next_signature,'') is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE'; end if;
   receipts:=r.native_receipts||jsonb_build_object('remove_draft',receipt);
   if octet_length(receipts::text)>65536 then raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED'; end if;
   update private.weekly_source_agency_timesheet_change_requests set phase='DRAFT_REMOVED',native_receipts=receipts,
    return_hold=r.original_draft_invoice_id is not null,
    current_row_signature=next_signature,updated_by_user_id=p_actor_user_id,version=version+1,
    updated_at_utc=transaction_timestamp(),last_refusal_code=null where id=r.id returning * into r;
  exception when others then
   get stacked diagnostics error_code=MESSAGE_TEXT,error_state=RETURNED_SQLSTATE;
   update private.weekly_source_agency_timesheet_change_requests set last_refusal_code=case when error_code~'^[A-Z][A-Z0-9_]{0,199}$' then error_code
      else 'AGENCY_CHANGE_NATIVE_PHASE_FAILED' end,
    updated_by_user_id=p_actor_user_id,updated_at_utc=transaction_timestamp(),version=version+1
    where id=r.id returning * into r;
   return r;
  end;
 end if;
 if r.phase='DRAFT_REMOVED' then
  begin
   r:=private.weekly_source_agency_change_request_assert_v1(p_contract_week_id,p_reason,
     p_expected_signature,p_request_key,p_actor_user_id);
   select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
   select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
   select * into strict cw from public.contract_weeks where id=r.contract_week_id;
   if t.authorised_at_server is not null or f.authorised_at_utc is not null or cw.status::text='AUTHORISED' then
    native_result:=public.timesheet_unauthorise_atomic(t.timesheet_id,t.timesheet_id,p_actor_user_id,
      transaction_timestamp(),r.current_row_signature);
    if native_result->>'ok' is distinct from 'true' or native_result->>'timesheet_id' is distinct from t.timesheet_id::text
      or native_result->>'operation' is distinct from 'timesheet_unauthorise' then
     raise exception 'AGENCY_CHANGE_NATIVE_UNAUTHORISE_UNPROVED'; end if;
    select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
    select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
    if t.authorised_at_server is not null or f.authorised_at_utc is not null
      or t.revoked_reason is distinct from 'TIMESHEET_UNAUTHORISE' or t.revoked_by is distinct from p_actor_user_id::text then
     raise exception 'AGENCY_CHANGE_NATIVE_UNAUTHORISE_POSTCONDITION_UNPROVED'; end if;
    receipt:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_UNAUTHORISE_V1',
      'phase_actor_user_id',p_actor_user_id,'native_result_sha256',encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_AGENCY_NATIVE_UNAUTHORISE_RESULT_V1',native_result),'hex'),
      'result',jsonb_build_object('ok',true,'operation',native_result->'operation','timesheet_id',native_result->'timesheet_id',
        'current_version',native_result->'current_version','revoked_at',native_result->'revoked_at'));
   else
    receipt:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_ALREADY_UNAUTHORISED_V1',
      'phase_actor_user_id',p_actor_user_id,'native_unauthorise_called',false,
      'observed_timesheet_authorised_at',t.authorised_at_server,'observed_financial_authorised_at',f.authorised_at_utc,
      'observed_contract_week_status',cw.status::text);
   end if;
   signature:=public.timesheet_lifecycle_guard_signature_v1(t.timesheet_id,r.contract_week_id,false);
   next_signature:=btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature'));
   if nullif(next_signature,'') is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE'; end if;
   receipts:=r.native_receipts||jsonb_build_object('unauthorise',receipt);
   update private.weekly_source_agency_timesheet_change_requests set phase='UNAUTHORISED',native_receipts=receipts,
    current_row_signature=next_signature,current_financial_id=f.id,updated_by_user_id=p_actor_user_id,version=version+1,
    updated_at_utc=transaction_timestamp(),last_refusal_code=null where id=r.id returning * into r;
   pay_purpose:=private.weekly_source_agency_paid_write_purpose_v1(r.id);
   receipts:=r.native_receipts||jsonb_build_object('after_una_pay_purpose',pay_purpose);
   if octet_length(receipts::text)>65536 then raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED'; end if;
   update private.weekly_source_agency_timesheet_change_requests set native_receipts=receipts,
    version=version+1,updated_at_utc=transaction_timestamp() where id=r.id returning * into r;
  exception when others then
   get stacked diagnostics error_code=MESSAGE_TEXT,error_state=RETURNED_SQLSTATE;
   update private.weekly_source_agency_timesheet_change_requests set last_refusal_code=case when error_code~'^[A-Z][A-Z0-9_]{0,199}$' then error_code
      else 'AGENCY_CHANGE_NATIVE_PHASE_FAILED' end,
    updated_by_user_id=p_actor_user_id,updated_at_utc=transaction_timestamp(),version=version+1
    where id=r.id returning * into r;
   return r;
  end;
 end if;
 return r;
end;
$function$;

create or replace function private.timesheet_correction_a0_source_raw_tokens_v1(p_relation text,p_row jsonb)
returns jsonb language plpgsql immutable security definer set search_path to 'pg_catalog','pg_temp'
as $source_raw$
declare tokens jsonb:='[]'::jsonb; identity uuid; primary_key text; token jsonb; pair jsonb;
 parent_relation text; parent_column text; scope_kind text; left_column text; right_column text;
begin
 if jsonb_typeof(p_row) is distinct from 'object' or p_relation is null
  or p_relation not in('public.weekly_source_groups','public.weekly_source_cycles','public.weekly_source_uploads','public.weekly_source_upload_rows','public.weekly_source_projection_publications','public.weekly_source_row_resolutions','public.weekly_source_row_economic_snapshots','public.weekly_source_row_expense_policy_snapshots','public.weekly_expense_authority_generations','public.weekly_source_expense_cell_evidence','public.weekly_source_charge_checks','public.weekly_source_charge_acceptances','public.weekly_source_invoice_hold_releases','public.weekly_source_state_transitions','public.weekly_source_report_scopes','public.weekly_source_self_bill_reports','public.weekly_source_self_bill_report_line_bindings','public.weekly_work_events','public.weekly_source_final_revisions','public.weekly_source_final_snapshot_lines','public.weekly_source_row_timesheet_lineages','public.weekly_source_ordinary_pay_projection_receipts','public.weekly_discrepancy_incidents','public.weekly_issue_comparison_revisions','public.weekly_source_billing_movements','public.weekly_source_group_clients','public.weekly_source_client_policies','public.weekly_source_contract_policies','public.weekly_source_group_rule_assignments','public.weekly_source_rule_set_versions','public.weekly_source_rule_sets','public.weekly_source_format_profiles','public.clients','public.client_settings','public.contracts','public.timesheets','public.timesheets_financials','public.weekly_source_global_settings') then
  raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';end if;
 if p_relation='public.weekly_source_global_settings' then
  if p_row->'singleton'='true'::jsonb then
   return jsonb_build_array(jsonb_build_object('kind','SOURCE_GLOBAL_SETTINGS','json','true'));
  end if;
  return tokens;
 end if;
 primary_key:=case when p_relation='public.timesheets' then 'timesheet_id' else 'id' end;
 identity:=(p_row->>primary_key)::uuid;
 if identity is null then raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';end if;
 tokens:=jsonb_build_array(jsonb_build_object('kind','SOURCE_OBJECT',
  'json',jsonb_build_array(p_relation,identity)::text));
 -- These exact parent predicates select ALL child rows; another UUID column
 -- on a child is never automatically a dependency/phantom token.
 case p_relation
 when 'public.weekly_source_upload_rows','public.weekly_source_expense_cell_evidence' then
  parent_relation:='public.weekly_source_uploads';parent_column:='upload_id';
 when 'public.weekly_source_row_economic_snapshots','public.weekly_source_row_expense_policy_snapshots',
   'public.weekly_source_charge_checks','public.weekly_source_charge_acceptances' then
  parent_relation:='public.weekly_source_row_resolutions';parent_column:='row_resolution_id';
 when 'public.weekly_source_invoice_hold_releases' then
  parent_relation:='public.weekly_source_upload_rows';parent_column:='upload_row_id';
 when 'public.weekly_source_contract_policies' then
  parent_relation:='public.contracts';parent_column:='contract_id';
 when 'public.client_settings' then
  parent_relation:='public.clients';parent_column:='client_id';
 when 'public.weekly_source_group_rule_assignments' then
  parent_relation:='public.weekly_source_groups';parent_column:='source_group_id';
 when 'public.weekly_source_self_bill_report_line_bindings' then
  if p_row->>'state'='CURRENT' then
   parent_relation:='public.weekly_source_self_bill_reports';parent_column:='self_bill_report_id';
  end if;
 else null;
 end case;
 if parent_column is not null and p_row->>parent_column is not null then
  tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_OBJECT',
   'json',jsonb_build_array(parent_relation,(p_row->>parent_column)::uuid)::text));
 end if;
 if p_relation='public.weekly_source_group_clients' then
  if p_row->>'client_id' is null or p_row->>'valid_from' is null then
   raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';end if;
  tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_POLICY_MEMBERSHIP_COVERAGE',
   'uuid',(p_row->>'client_id')::uuid::text,'coverage',jsonb_build_array((p_row->>'valid_from')::date,(p_row->>'valid_to')::date)));
 end if;
 if p_relation='public.weekly_source_final_revisions' and p_row->>'state' in('CURRENT','PREPARED','SUPERSEDED')
  and p_row->>'source_cycle_id' is not null then
  tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_CYCLE_UUID','uuid',(p_row->>'source_cycle_id')::uuid::text));
 end if;
 if p_relation='public.weekly_source_row_resolutions' and p_row->>'upload_row_id' is not null
  and p_row->>'generation' is not null and p_row->>'client_id' is not null then
  -- Never broaden this AND slot to a raw-row/upload/Client object token.
  pair:=jsonb_build_array((p_row->>'upload_row_id')::uuid,(p_row->>'generation')::integer,(p_row->>'client_id')::uuid);
  tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_RESOLUTION_SLOT','json',pair::text));
 end if;
 case p_relation
 when 'public.weekly_source_final_snapshot_lines','public.weekly_source_ordinary_pay_projection_receipts' then
  scope_kind:='SOURCE_REVISION_CLIENT';left_column:='final_revision_id';right_column:='client_id';
 when 'public.weekly_expense_authority_generations','public.weekly_source_state_transitions' then
  scope_kind:='SOURCE_REVISION_EVENT';left_column:='final_revision_id';right_column:='work_event_id';
 when 'public.weekly_source_group_clients','public.weekly_source_client_policies','public.weekly_source_self_bill_reports' then
  scope_kind:='SOURCE_GROUP_CLIENT';left_column:='source_group_id';right_column:='client_id';
 when 'public.weekly_source_report_scopes' then
  if p_row->>'self_bill_report_id' is not null then
   scope_kind:='SOURCE_GROUP_CLIENT';left_column:='source_group_id';right_column:='client_id';
  end if;
 when 'public.weekly_discrepancy_incidents' then
  scope_kind:='SOURCE_CYCLE_CLIENT';left_column:='source_cycle_id';right_column:='client_id';
 else null;
 end case;
 if scope_kind is not null and p_row->>left_column is not null and p_row->>right_column is not null then
  tokens:=tokens||jsonb_build_array(jsonb_build_object('kind',scope_kind,
   'json',jsonb_build_array((p_row->>left_column)::uuid,(p_row->>right_column)::uuid)::text));
 end if;
 if p_relation='public.weekly_source_row_timesheet_lineages' and p_row->>'client_id' is not null then
  if p_row->>'row_resolution_id' is not null then
   tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_LINEAGE_RESOLUTION_CLIENT',
    'json',jsonb_build_array((p_row->>'row_resolution_id')::uuid,(p_row->>'client_id')::uuid)::text));
  end if;
  if p_row->>'work_event_id' is not null then
   tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_LINEAGE_EVENT_CLIENT',
    'json',jsonb_build_array((p_row->>'work_event_id')::uuid,(p_row->>'client_id')::uuid)::text));
  end if;
 end if;
 if p_relation='public.contracts' and p_row->>'client_id' is not null
  and p_row->>'start_date' is not null and p_row->>'end_date' is not null
  and (p_row->>'start_date')::date<=(p_row->>'end_date')::date then
  tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_CONTRACT_COVERAGE',
   'uuid',(p_row->>'client_id')::uuid::text,'coverage',jsonb_build_array(p_row->>'start_date',p_row->>'end_date')));
 end if;
 for token in select value from jsonb_array_elements(tokens) loop
  perform private.timesheet_correction_a0_source_token_assert_v1(token);
 end loop;
 select coalesce(jsonb_agg(value order by value),'[]'::jsonb) into tokens
  from(select distinct value from jsonb_array_elements(tokens)) complete;
 return tokens;
exception when invalid_text_representation or datetime_field_overflow then
 raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';
end;
$source_raw$;

create or replace function private.timesheet_correction_a0_source_revision_tokens_v1(p_relation text,p_row jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $source_revision$
declare tokens jsonb:='[]'::jsonb; v_group_id uuid; v_state text; item jsonb; token jsonb;
begin
 if p_relation is null then raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';end if;
 if p_relation not in('public.weekly_source_final_revisions','public.weekly_source_final_snapshot_lines') then return tokens;end if;
 if jsonb_typeof(p_row) is distinct from 'object' then
  raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';end if;
 if p_relation='public.weekly_source_final_revisions' then
  if coalesce(p_row->>'state','') not in('CURRENT','PREPARED','SUPERSEDED') then return tokens;end if;
  -- The direct actual cycle UUID was acquired in the preceding raw phase.
  select cycle.source_group_id into strict v_group_id from public.weekly_source_cycles cycle
   where cycle.id=(p_row->>'source_cycle_id')::uuid;
  if p_row->>'report_scope_id' is not null then
   tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_GROUP_REPORT_REVISION',
    'json',jsonb_build_array(v_group_id,(p_row->>'report_scope_id')::uuid)::text));
  end if;
  select coalesce(jsonb_agg(jsonb_build_object('kind','SOURCE_GROUP_REVISION_EVENT',
   'json',jsonb_build_array(v_group_id,snapshot.work_event_id)::text)),'[]'::jsonb) into item
   from public.weekly_source_final_snapshot_lines snapshot where snapshot.final_revision_id=(p_row->>'id')::uuid
    and snapshot.work_event_id is not null;
  tokens:=tokens||item;
 else
  select cycle.source_group_id,revision.state into strict v_group_id,v_state
   from public.weekly_source_final_revisions revision join public.weekly_source_cycles cycle on cycle.id=revision.source_cycle_id
   where revision.id=(p_row->>'final_revision_id')::uuid;
  if v_state in('CURRENT','PREPARED','SUPERSEDED') and p_row->>'work_event_id' is not null then
   tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_GROUP_REVISION_EVENT',
    'json',jsonb_build_array(v_group_id,(p_row->>'work_event_id')::uuid)::text));
  end if;
 end if;
 for token in select value from jsonb_array_elements(tokens) loop
  perform private.timesheet_correction_a0_source_token_assert_v1(token);
 end loop;
 select coalesce(jsonb_agg(value order by value),'[]'::jsonb) into tokens
  from(select distinct value from jsonb_array_elements(tokens)) complete;
 return tokens;
exception when no_data_found or too_many_rows then
 raise exception 'CORRECTION_A0_SOURCE_PARENT_SNAPSHOT_UNAVAILABLE' using errcode='40001';
end;
$source_revision$;

create or replace function private.timesheet_correction_a0_source_policy_tokens_v1(p_relation text,p_row jsonb)
returns jsonb language plpgsql volatile security definer set search_path='pg_catalog','pg_temp'
as $source_policy$
declare tokens jsonb:='[]'::jsonb;token jsonb;
begin
 if p_relation is null then raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';end if;
 if p_relation<>'public.weekly_source_groups' then return tokens;end if;
 if jsonb_typeof(p_row) is distinct from 'object' then raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';end if;
 if p_row->'active' is distinct from 'true'::jsonb then return tokens;end if;
 select coalesce(jsonb_agg(jsonb_build_object('kind','SOURCE_POLICY_MEMBERSHIP_COVERAGE','uuid',member.client_id::text,
  'coverage',jsonb_build_array(member.valid_from,member.valid_to))),'[]'::jsonb) into tokens
  from public.weekly_source_group_clients member where member.source_group_id=(p_row->>'id')::uuid;
 for token in select value from jsonb_array_elements(tokens) loop
  perform private.timesheet_correction_a0_source_token_assert_v1(token);end loop;
 select coalesce(jsonb_agg(value order by value),'[]'::jsonb) into tokens
  from(select distinct value from jsonb_array_elements(tokens)) complete;return tokens;
end;
$source_policy$;

create or replace function private.timesheet_correction_a0_source_reference_before_v1()
returns trigger language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $source_reference$
declare tokens jsonb:='[]'::jsonb; nested_tokens jsonb:='[]'::jsonb;
begin
 if tg_table_schema<>'public' or tg_op not in('INSERT','UPDATE','DELETE') then
  raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';end if;
 if tg_op in('UPDATE','DELETE') then
  tokens:=tokens||private.timesheet_correction_a0_source_raw_tokens_v1('public.'||tg_table_name,to_jsonb(old));
 end if;
 if tg_op in('INSERT','UPDATE') then
  tokens:=tokens||private.timesheet_correction_a0_source_raw_tokens_v1('public.'||tg_table_name,to_jsonb(new));
 end if;
 -- Only after the union of actual raw OLD/NEW may native fence inspection
 -- occur. Existing business/immutable/state/financial owners remain intact.
 perform private.timesheet_correction_a0_fence_acquire_v1(tokens,false);
 if tg_op in('UPDATE','DELETE') then
  nested_tokens:=nested_tokens||private.timesheet_correction_a0_source_revision_tokens_v1('public.'||tg_table_name,to_jsonb(old))
   ||private.timesheet_correction_a0_source_policy_tokens_v1('public.'||tg_table_name,to_jsonb(old));
 end if;
 if tg_op in('INSERT','UPDATE') then
  nested_tokens:=nested_tokens||private.timesheet_correction_a0_source_revision_tokens_v1('public.'||tg_table_name,to_jsonb(new))
   ||private.timesheet_correction_a0_source_policy_tokens_v1('public.'||tg_table_name,to_jsonb(new));
 end if;
 perform private.timesheet_correction_a0_fence_acquire_v1(nested_tokens,false);
 perform private.weekly_source_agency_active_source_mutation_assert_v1('public.'||tg_table_name,
  case when tg_op in('UPDATE','DELETE') then to_jsonb(old) end,
  case when tg_op in('INSERT','UPDATE') then to_jsonb(new) end,tokens||nested_tokens);
 if tg_op='DELETE' then return old;end if;return new;
end;
$source_reference$;

create or replace function private.timesheet_correction_a0_source_reference_final_before_v1()
returns trigger language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $source_reference$
declare tokens jsonb:='[]'::jsonb; nested_tokens jsonb:='[]'::jsonb;
begin
 if tg_table_schema<>'public' or tg_op not in('INSERT','UPDATE','DELETE') then
  raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';end if;
 if tg_op in('UPDATE','DELETE') then
  tokens:=tokens||private.timesheet_correction_a0_source_raw_tokens_v1('public.'||tg_table_name,to_jsonb(old));
 end if;
 if tg_op in('INSERT','UPDATE') then
  tokens:=tokens||private.timesheet_correction_a0_source_raw_tokens_v1('public.'||tg_table_name,to_jsonb(new));
 end if;
 -- Only after the union of actual raw OLD/NEW may native fence inspection
 -- occur. Existing business/immutable/state/financial owners remain intact.
 perform private.timesheet_correction_a0_fence_acquire_v1(tokens,false);
 if tg_op in('UPDATE','DELETE') then
  nested_tokens:=nested_tokens||private.timesheet_correction_a0_source_revision_tokens_v1('public.'||tg_table_name,to_jsonb(old))
   ||private.timesheet_correction_a0_source_policy_tokens_v1('public.'||tg_table_name,to_jsonb(old));
 end if;
 if tg_op in('INSERT','UPDATE') then
  nested_tokens:=nested_tokens||private.timesheet_correction_a0_source_revision_tokens_v1('public.'||tg_table_name,to_jsonb(new))
   ||private.timesheet_correction_a0_source_policy_tokens_v1('public.'||tg_table_name,to_jsonb(new));
 end if;
 perform private.timesheet_correction_a0_fence_acquire_v1(nested_tokens,false);
 -- Re-admit the FINAL native NEW frame after all earlier BEFORE transformations.
 -- Both actual RAW and NESTED phases still precede the ACTIVE lookup.
 perform private.weekly_source_agency_active_source_mutation_assert_v1('public.'||tg_table_name,
  case when tg_op in('UPDATE','DELETE') then to_jsonb(old) end,
  case when tg_op in('INSERT','UPDATE') then to_jsonb(new) end,tokens||nested_tokens);
 if tg_op='DELETE' then return old;end if;return new;
end;
$source_reference$;

create or replace function private._candidate_manager_authoriser_policy_normalize_v2(
  p_policy jsonb,
  p_scope text default 'EFFECTIVE'
)
returns jsonb
language plpgsql
immutable
parallel safe
set search_path=''
as $function$
declare
  v_source jsonb:=case when pg_catalog.jsonb_typeof(p_policy)='object' then p_policy else '{}'::jsonb end;
  v_scope text:=pg_catalog.upper(pg_catalog.btrim(coalesce(p_scope,'EFFECTIVE')));
  v_mode text:=pg_catalog.upper(pg_catalog.btrim(coalesce(v_source->>'mode','INHERIT')));
  v_emails jsonb;
  v_domains jsonb;
  v_allow_free boolean:=false;
begin
  if v_scope not in ('CLIENT','CONTRACT_WRITE','EFFECTIVE') then
    raise exception using errcode='22023',message='CANDIDATE_MANAGER_POLICY_SCOPE_INVALID';
  end if;
  if v_scope='CLIENT' and exists (
    select 1 from pg_catalog.jsonb_object_keys(v_source) k
    where k not in ('approved_emails','approved_domains','allow_free_business_email')
  ) then
    raise exception using errcode='22023',message='CANDIDATE_MANAGER_CLIENT_POLICY_FIELD_INVALID';
  end if;
  if v_scope='CONTRACT_WRITE' and exists (
    select 1 from pg_catalog.jsonb_object_keys(v_source) k
    where k not in ('mode','approved_emails','approved_domains','approval')
  ) then
    raise exception using errcode='22023',message='CANDIDATE_MANAGER_CONTRACT_POLICY_FIELD_INVALID';
  end if;
  if v_scope='CONTRACT_WRITE' and v_source ? 'approval'
    and (pg_catalog.jsonb_typeof(v_source->'approval') is distinct from 'string'
      or v_source->>'approval' is distinct from 'NOT_REQUIRED') then
    raise exception using errcode='22023',message='CANDIDATE_MANAGER_CONTRACT_POLICY_FIELD_INVALID';
  end if;
  v_emails:=private._candidate_manager_authoriser_email_array_v2(v_source->'approved_emails');
  v_domains:=private._candidate_manager_authoriser_domain_array_v2(v_source->'approved_domains');
  if v_source ? 'allow_free_business_email' then
    if pg_catalog.jsonb_typeof(v_source->'allow_free_business_email')<>'boolean' then
      raise exception using errcode='22023',message='CANDIDATE_MANAGER_FREE_EMAIL_SETTING_INVALID';
    end if;
    v_allow_free:=(v_source->>'allow_free_business_email')::boolean;
  end if;

  if v_scope='CLIENT' then
    return pg_catalog.jsonb_build_object(
      'approved_emails',v_emails,'approved_domains',v_domains,
      'allow_free_business_email',v_allow_free
    );
  elsif v_scope='CONTRACT_WRITE' then
    if v_mode not in ('INHERIT','EXTEND','CONTRACT_ONLY') then
      raise exception using errcode='22023',message='CANDIDATE_MANAGER_CONTRACT_MODE_INVALID';
    end if;
    if v_mode='INHERIT' and (pg_catalog.jsonb_array_length(v_emails)>0 or pg_catalog.jsonb_array_length(v_domains)>0) then
      raise exception using errcode='22023',message='CANDIDATE_MANAGER_INHERIT_HAS_ADDITIONS';
    end if;
    if v_mode='CONTRACT_ONLY' and pg_catalog.jsonb_array_length(v_emails)=0 and pg_catalog.jsonb_array_length(v_domains)=0 then
      raise exception using errcode='22023',message='CANDIDATE_MANAGER_CONTRACT_ONLY_EMPTY';
    end if;
    return pg_catalog.jsonb_build_object(
      'mode',v_mode,'approved_emails',v_emails,'approved_domains',v_domains
    )||case when v_source->'approval'='"NOT_REQUIRED"'::jsonb then pg_catalog.jsonb_build_object('approval','NOT_REQUIRED') else '{}'::jsonb end;
  end if;

  return pg_catalog.jsonb_build_object(
    'approved_emails',v_emails,'approved_domains',v_domains,
    'allow_free_business_email',v_allow_free
  )||case when v_source->'approval'='"NOT_REQUIRED"'::jsonb then pg_catalog.jsonb_build_object('approval','NOT_REQUIRED') else '{}'::jsonb end;
end;
$function$;

create or replace function private._candidate_manager_authoriser_effective_v2(
  p_client_policy jsonb,
  p_contract_policy jsonb default null
)
returns jsonb
language plpgsql
immutable
parallel safe
set search_path=''
as $function$
declare
  v_client jsonb:=private._candidate_manager_authoriser_policy_normalize_v2(p_client_policy,'CLIENT');
  v_contract_source jsonb:=case when pg_catalog.jsonb_typeof(p_contract_policy)='object' then p_contract_policy else '{"mode":"INHERIT"}'::jsonb end;
  v_mode text:=pg_catalog.upper(pg_catalog.btrim(coalesce(v_contract_source->>'mode','INHERIT')));
  v_contract jsonb;
  v_emails jsonb;
  v_domains jsonb;
  v_allow_free boolean;
  v_source_mode text;
begin
  if p_contract_policy is null or v_mode='INHERIT' then
    return v_client||pg_catalog.jsonb_build_object('source_mode','INHERIT')
      ||case when v_contract_source->'approval'='"NOT_REQUIRED"'::jsonb then pg_catalog.jsonb_build_object('approval','NOT_REQUIRED') else '{}'::jsonb end;
  end if;

  if v_mode in ('EXTEND','CONTRACT_ONLY') then
    v_contract:=private._candidate_manager_authoriser_policy_normalize_v2(v_contract_source,'CONTRACT_WRITE');
  else
    -- Compatibility: the former resolver treated every non-INHERIT value as a
    -- complete replacement. Preserve that meaning without rewriting stored rows.
    v_contract:=private._candidate_manager_authoriser_policy_normalize_v2(v_contract_source,'EFFECTIVE');
  end if;

  if v_mode='EXTEND' then
    select coalesce(pg_catalog.jsonb_agg(x.value order by x.value),'[]'::jsonb)
      into v_emails
    from (
      select distinct value
      from pg_catalog.jsonb_array_elements_text((v_client->'approved_emails')||(v_contract->'approved_emails'))
    ) x;
    select coalesce(pg_catalog.jsonb_agg(x.value order by x.value),'[]'::jsonb)
      into v_domains
    from (
      select distinct value
      from pg_catalog.jsonb_array_elements_text((v_client->'approved_domains')||(v_contract->'approved_domains'))
    ) x;
    v_allow_free:=coalesce((v_client->>'allow_free_business_email')::boolean,false);
    v_source_mode:='EXTEND';
  elsif v_mode='CONTRACT_ONLY' then
    v_emails:=v_contract->'approved_emails';
    v_domains:=v_contract->'approved_domains';
    v_allow_free:=false;
    v_source_mode:='CONTRACT_ONLY';
  else
    v_emails:=v_contract->'approved_emails';
    v_domains:=v_contract->'approved_domains';
    v_allow_free:=coalesce((v_contract->>'allow_free_business_email')::boolean,false);
    v_source_mode:='LEGACY_REPLACEMENT';
  end if;
  return pg_catalog.jsonb_build_object(
    'approved_emails',v_emails,'approved_domains',v_domains,
    'allow_free_business_email',v_allow_free,'source_mode',v_source_mode
  )||case when v_contract_source->'approval'='"NOT_REQUIRED"'::jsonb then pg_catalog.jsonb_build_object('approval','NOT_REQUIRED') else '{}'::jsonb end;
end;
$function$;

create or replace function public.contract_manager_authoriser_policy_update_v1(
  p_contract_id uuid,
  p_expected_contract_updated_at timestamptz,
  p_policy jsonb,
  p_actor_user_id uuid,
  p_idempotency_key text,
  p_now_utc timestamptz default pg_catalog.transaction_timestamp()
)
returns jsonb
language plpgsql
security definer
set search_path=''
as $function$
declare
  v_contract public.contracts%rowtype;
  v_policy jsonb:=private._candidate_manager_authoriser_policy_normalize_v2(p_policy,'CONTRACT_WRITE');
  v_hash bytea;
  v_existing public.candidate_manager_authoriser_policy_receipts%rowtype;
  v_response jsonb;
begin
  -- Primary26.12 / R242: this is not an Office setting. Only the actual
  -- preset application/clear owner may derive the Contract's fixed key.
  if pg_catalog.jsonb_typeof(p_policy)='object' and p_policy ? 'approval' then
    raise exception using errcode='22023',message='CANDIDATE_MANAGER_FIXED_APPROVAL_NOT_EDITABLE';
  end if;
  if p_contract_id is null or p_expected_contract_updated_at is null or p_actor_user_id is null
     or pg_catalog.char_length(pg_catalog.btrim(coalesce(p_idempotency_key,''))) not between 16 and 200 then
    raise exception using errcode='22023',message='CANDIDATE_MANAGER_AUTHORISER_REQUEST_INVALID';
  end if;
  v_hash:=extensions.digest(pg_catalog.convert_to(v_policy::text,'UTF8'),'sha256');
  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended('CONTRACT:'||p_contract_id::text||':'||p_idempotency_key,0));
  select * into v_existing from public.candidate_manager_authoriser_policy_receipts r
    where r.entity_kind='CONTRACT' and r.entity_id=p_contract_id and r.idempotency_key=p_idempotency_key;
  if found then
    if v_existing.semantic_sha256<>v_hash then raise exception using errcode='40001',message='CANDIDATE_MANAGER_AUTHORISER_IDEMPOTENCY_CONFLICT'; end if;
    return v_existing.response_json||pg_catalog.jsonb_build_object('idempotent_replay',true);
  end if;
  select * into v_contract from public.contracts c where c.id=p_contract_id for update;
  if not found then raise exception using errcode='P0002',message='CONTRACT_NOT_FOUND'; end if;
  if v_contract.updated_at is distinct from p_expected_contract_updated_at then
    raise exception using errcode='40001',message='CANDIDATE_MANAGER_AUTHORISER_VERSION_CONFLICT';
  end if;
  -- Refresh only the native system key after the existing CAS, preserving
  -- the ordinary request hash/replay identity and all manager policy fields.
  v_contract:=private.weekly_source_contract_fixed_approval_sync_v1(p_contract_id,p_actor_user_id);
  -- An ordinary approved-email/domain edit cannot clear a system-fixed key.
  -- It does not create the key for any other Contract or Client.
  if v_contract.candidate_manager_approval_policy_json->'approval'='"NOT_REQUIRED"'::jsonb then
    v_policy:=v_policy||pg_catalog.jsonb_build_object('approval','NOT_REQUIRED');
  end if;
  update public.contracts set candidate_manager_approval_policy_json=v_policy,updated_at=p_now_utc where id=p_contract_id;
  v_response:=public.contract_manager_authoriser_policy_get_v1(p_contract_id)||pg_catalog.jsonb_build_object('idempotent_replay',false);
  insert into public.candidate_manager_authoriser_policy_receipts(entity_kind,entity_id,idempotency_key,semantic_sha256,response_json,actor_user_id,recorded_at_utc)
  values ('CONTRACT',p_contract_id,p_idempotency_key,v_hash,v_response,p_actor_user_id,p_now_utc);
  return v_response;
end;
$function$;

create or replace function private.weekly_source_off_rule_agency_parent_v1(
 p_operation text,p_native_request jsonb,p_actor_user_id uuid,p_require_active boolean
) returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype;
 cw public.contract_weeks%rowtype; k public.contracts%rowtype; t public.timesheets%rowtype;
 c public.weekly_source_cycles%rowtype; g public.weekly_source_groups%rowtype; cycles uuid[]; actor uuid; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if p_operation='weekly_source_agency_timesheet_change_v1' then
  if not private.weekly_source_qualification_closed_object_v1(p_native_request,
     array['p_contract_week_id','p_reason','p_expected_signature','p_request_key','p_actor_user_id'])
    or jsonb_typeof(p_native_request->'p_actor_user_id') is distinct from 'string'
    or jsonb_typeof(p_native_request->'p_contract_week_id') is distinct from 'string'
    or jsonb_typeof(p_native_request->'p_reason') is distinct from 'string'
    or jsonb_typeof(p_native_request->'p_expected_signature') is distinct from 'string'
    or jsonb_typeof(p_native_request->'p_request_key') is distinct from 'string'
    or length(p_native_request->>'p_reason') not between 1 and 2000
    or length(p_native_request->>'p_expected_signature') not between 1 and 512
    or length(p_native_request->>'p_request_key') not between 1 and 200 then
   raise exception 'WEEKLY_SOURCE_OFF_AGENCY_REQUEST_INVALID' using errcode='22023';end if;
  actor:=(p_native_request->>'p_actor_user_id')::uuid;
  if actor is distinct from p_actor_user_id then
   raise exception 'WEEKLY_SOURCE_OFF_AGENCY_ACTOR_CHANGED' using errcode='42501';end if;
  select * into strict cw from public.contract_weeks where id=(p_native_request->>'p_contract_week_id')::uuid;
 else
  if p_operation in('weekly_source_agency_change_authorise_step_v1','weekly_source_agency_change_return_step_v1') then
   if not private.weekly_source_qualification_closed_object_v1(p_native_request,array['p_request_id','p_actor_user_id'])
     or jsonb_typeof(p_native_request->'p_actor_user_id') is distinct from 'string' then
    raise exception 'WEEKLY_SOURCE_OFF_AGENCY_REQUEST_INVALID' using errcode='22023';end if;
  elsif p_operation in('weekly_source_agency_change_worker_context_v1','weekly_source_agency_validation_context_v1') then
   if not private.weekly_source_qualification_closed_object_v1(p_native_request,array['p_request_id']) then
    raise exception 'WEEKLY_SOURCE_OFF_AGENCY_REQUEST_INVALID' using errcode='22023';end if;
  elsif p_operation in('weekly_source_agency_change_worker_apply_v1','weekly_source_agency_validation_apply_v1') then
   if not private.weekly_source_qualification_closed_object_v1(p_native_request,
      array['p_request_id','p_expected_request_version','p_expected_context_sha256','p_snapshot'])
     or jsonb_typeof(p_native_request->'p_expected_request_version') is distinct from 'number'
     or p_native_request->>'p_expected_request_version' !~ '^[1-9][0-9]*$'
     or (p_native_request->>'p_expected_request_version')::bigint>9007199254740991
     or jsonb_typeof(p_native_request->'p_expected_context_sha256') is distinct from 'string'
     or p_native_request->>'p_expected_context_sha256' !~ '^[0-9a-f]{64}$'
     or jsonb_typeof(p_native_request->'p_snapshot') is distinct from 'object'
     or octet_length((p_native_request->'p_snapshot')::text)>1048576 then
    raise exception 'WEEKLY_SOURCE_OFF_AGENCY_REQUEST_INVALID' using errcode='22023';end if;
  else raise exception 'WEEKLY_SOURCE_OFF_AGENCY_OPERATION_REFUSED' using errcode='42501';end if;
  if jsonb_typeof(p_native_request->'p_request_id') is distinct from 'string' then
   raise exception 'WEEKLY_SOURCE_OFF_AGENCY_REQUEST_INVALID' using errcode='22023';end if;
  select * into r from private.weekly_source_agency_timesheet_change_requests where id=(p_native_request->>'p_request_id')::uuid;
  if not found then
   if p_require_active then raise exception 'WEEKLY_SOURCE_OFF_AGENCY_REQUEST_UNAVAILABLE' using errcode='55000';end if;
   return null; -- No stored parent: discovery cannot assert a fixture.
  end if;
  actor:=r.updated_by_user_id;
  if p_native_request ? 'p_actor_user_id' and (p_native_request->>'p_actor_user_id')::uuid is distinct from actor then
   raise exception 'WEEKLY_SOURCE_OFF_AGENCY_ACTOR_CHANGED' using errcode='42501';end if;
  if p_actor_user_id is not null and p_actor_user_id is distinct from actor then
   raise exception 'WEEKLY_SOURCE_OFF_AGENCY_ACTOR_CHANGED' using errcode='42501';end if;
  if not p_require_active then
   -- Discovery retains the actual immutable request scope even when a current
   -- target changed. It is NOT a current-parent admission. Execute rederives
   -- every current native identity/CAS/phase below before its audit/dispatch.
   return jsonb_build_object('source_cycle_id',r.source_cycle_id,'source_group_id',r.source_group_id,
    'agency_id',r.agency_id,'contract_week_id',r.contract_week_id,'contract_id',r.contract_id,
    'client_id',r.client_id,'candidate_id',r.candidate_id,'agency_timesheet_id',r.current_timesheet_id,
    'timesheet_version',r.current_timesheet_version,'week_ending_date',r.week_ending_date,
    'actor_user_id',actor,'request_id',r.id,'request_version',r.version,
    'request_sha256',encode(r.request_sha256,'hex'),'phase',r.phase,'source_cas',r.source_cas);
  end if;
  if p_require_active and not(r.state='COMPLETED' and r.phase='COMPLETED'
     and p_operation in('weekly_source_agency_change_authorise_step_v1','weekly_source_agency_change_return_step_v1'))
   and (r.state is distinct from 'ACTIVE'
    or (p_operation in('weekly_source_agency_validation_context_v1','weekly_source_agency_validation_apply_v1')
      and r.phase is distinct from 'AUTHORISED')
    or (p_operation in('weekly_source_agency_change_worker_context_v1','weekly_source_agency_change_worker_apply_v1')
      and r.phase not in('UNAUTHORISED','RECOMPUTE_PENDING'))
    or (p_operation='weekly_source_agency_change_authorise_step_v1' and r.phase not in('FINANCIAL_CURRENT','AUTHORISED'))
    or (p_operation='weekly_source_agency_change_return_step_v1' and r.phase is distinct from 'AUTHORISED')) then
   raise exception 'WEEKLY_SOURCE_OFF_AGENCY_PHASE_CHANGED' using errcode='40001';end if;
  if p_operation in('weekly_source_agency_change_worker_apply_v1','weekly_source_agency_validation_apply_v1')
    and (p_native_request->>'p_expected_request_version')::bigint is distinct from r.version then
   raise exception 'WEEKLY_SOURCE_OFF_AGENCY_REQUEST_VERSION_CHANGED' using errcode='40001';end if;
  select * into strict cw from public.contract_weeks where id=r.contract_week_id;
 end if;
 select * into strict k from public.contracts where id=cw.contract_id;
 select array_agg(cycle.id order by cycle.id) into cycles from public.weekly_source_cycles cycle
  join public.weekly_source_groups g on g.id=cycle.source_group_id and g.active and g.source_family='ROSTER'
  join public.weekly_source_group_clients member on member.source_group_id=g.id and member.client_id=k.client_id
    and cw.week_ending_date between member.valid_from and coalesce(member.valid_to,'infinity'::date)
  where cycle.finalisation_week_ending=cw.week_ending_date and (cycle.scope_client_id is null or cycle.scope_client_id=k.client_id);
 if cardinality(cycles)>1 then
  select array_agg(cycle.id order by cycle.id) into cycles from public.weekly_source_cycles cycle
   where cycle.id=any(cycles) and cycle.scope_client_id=k.client_id;end if;
 if coalesce(cardinality(cycles),0)<>1 then raise exception 'WEEKLY_SOURCE_OFF_AGENCY_CYCLE_AMBIGUOUS' using errcode='55000';end if;
 select * into strict c from public.weekly_source_cycles where id=cycles[1];
 select * into strict g from public.weekly_source_groups where id=c.source_group_id;
 if g.environment is distinct from 'TEST' then
  raise exception 'WEEKLY_SOURCE_OFF_AGENCY_TEST_REQUIRED' using errcode='42501';end if;
 if not p_require_active then
  return jsonb_build_object('source_cycle_id',c.id,'source_group_id',g.id,'agency_id',g.agency_id,
   'contract_week_id',cw.id,'contract_id',k.id,'client_id',k.client_id,'candidate_id',k.candidate_id,
   'agency_timesheet_id',cw.timesheet_id,'week_ending_date',cw.week_ending_date,'actor_user_id',actor);
 end if;
 select * into strict t from public.timesheets where timesheet_id=cw.timesheet_id;
 if actor is null or k.client_id is null or k.candidate_id is null
   or coalesce(cw.additional_seq,0)<>0 or coalesce(cw.is_adjustment,false)
   or t.contract_id is distinct from k.id or t.week_ending_date is distinct from cw.week_ending_date
   or t.is_current is distinct from true or t.revoked_at is not null or t.archived_at_utc is not null
   or t.sheet_scope::text is distinct from 'WEEKLY' or t.line_type::text is distinct from 'HOURS'
   or t.correction_id is not null or coalesce(t.is_adjustment,false) then
  raise exception 'WEEKLY_SOURCE_OFF_AGENCY_PHYSICAL_SCOPE_CHANGED' using errcode='40001';end if;
 if r.id is not null and (r.environment is distinct from 'TEST' or r.source_cycle_id is distinct from c.id
   or r.agency_id is distinct from g.agency_id
   or r.source_group_id is distinct from c.source_group_id or r.contract_id is distinct from k.id
   or r.client_id is distinct from k.client_id or r.candidate_id is distinct from k.candidate_id
   or r.current_timesheet_id is distinct from t.timesheet_id or r.current_timesheet_version is distinct from t.version
   or r.week_ending_date is distinct from cw.week_ending_date
   or r.source_publication_id is distinct from c.current_projection_publication_id
   or r.source_upload_id is distinct from c.current_complete_upload_id
   or private.weekly_source_bulk_source_cas_v1(c.id,array[k.client_id]) is distinct from r.source_cas) then
  raise exception 'WEEKLY_SOURCE_OFF_AGENCY_CURRENT_CAPTURE_CHANGED' using errcode='40001';end if;
 result:=jsonb_build_object('source_cycle_id',c.id,'source_group_id',c.source_group_id,'agency_id',g.agency_id,
  'contract_week_id',cw.id,'contract_id',k.id,'client_id',k.client_id,'candidate_id',k.candidate_id,
  'agency_timesheet_id',t.timesheet_id,'timesheet_version',t.version,'week_ending_date',cw.week_ending_date,
  'actor_user_id',actor,'request_id',r.id,'request_version',r.version,'request_sha256',encode(r.request_sha256,'hex'),
  'phase',r.phase,'source_cas',r.source_cas);
 return result;
end;
$function$;

CREATE OR REPLACE FUNCTION public.weekly_source_client_settings_save_atomic_v1(p_request jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'pg_temp'
AS $function$
declare
  v_actor uuid;
  v_agency uuid;
  v_environment text;
  v_client uuid;
  v_expected text;
  v_input jsonb;
  v_effective_from date;
  v_current_shape jsonb;
  v_group_id uuid;
  v_group public.weekly_source_groups%rowtype;
  v_old_group_id uuid;
  v_locked_old_group_id uuid;
  v_membership public.weekly_source_group_clients%rowtype;
  v_policy public.weekly_source_client_policies%rowtype;
  v_policy_found boolean:=false;
  v_contract_count integer;
  v_client_nhsp_basis boolean:=false;
  v_client_agency_basis boolean:=false;
  v_family_count integer;
  v_mode_count integer;
  v_self_bill_count integer;
  v_family text;
  v_authority text;
  v_document text;
  v_self_bill boolean;
  v_correction text;
  v_source_expenses boolean;
  v_source_expense_vat boolean;
  v_rate_method text;
  v_tie_rule text;
  v_candidate_queries boolean;
  v_manager_queries boolean;
  v_manager_recipient text;
  v_completed_copy boolean;
  v_completed_recipient text;
  v_expense_supported boolean;
  v_prior_end date;
  v_nhsp_group_count integer;
  v_membership_history_count integer;
  v_policy_history_count integer;
  v_membership_effective_from date;
  v_policy_effective_from date;
  v_approval_contract public.contracts%rowtype; v_approval_before jsonb; v_approval_after jsonb;
  v_approval_capture jsonb; v_approval_key text; v_approval_response jsonb;
  v_approval_changes jsonb:='[]'::jsonb;
begin
  perform private._weekly_source_settings_assert_request_v1(
    p_request,array[
      'actor_user_id','agency_id','environment','client_id',
      'expected_settings_version','settings'
    ],'WEEKLY_SOURCE_CLIENT_SETTINGS_SAVE_REQUEST_INVALID'
  );
  v_input:=p_request->'settings';
  perform private._weekly_source_settings_assert_request_v1(
    v_input,array[
      'source_group_id','effective_from','authority_mode','document_mode','self_bill_enabled',
      'self_bill_correction_presentation','source_fixed_expenses_enabled','source_expense_vat_enabled',
      'weekly_rate_classification_method','duration_break_tie_rule',
      'candidate_queries_enabled','manager_queries_enabled','manager_query_recipient',
      'completed_pack_copy_enabled','completed_pack_recipient'
    ],'WEEKLY_SOURCE_CLIENT_SETTINGS_VALUES_INVALID'
  );
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_agency:=(p_request->>'agency_id')::uuid;
    v_client:=(p_request->>'client_id')::uuid;
    v_expected:=pg_catalog.btrim(p_request->>'expected_settings_version');
    v_effective_from:=coalesce(nullif(v_input->>'effective_from','')::date,current_date);
    v_group_id:=nullif(v_input->>'source_group_id','')::uuid;
    v_correction:=nullif(pg_catalog.upper(pg_catalog.btrim(v_input->>'self_bill_correction_presentation')),'');
    v_source_expenses:=(v_input->>'source_fixed_expenses_enabled')::boolean;
    v_source_expense_vat:=(v_input->>'source_expense_vat_enabled')::boolean;
    v_rate_method:=pg_catalog.upper(pg_catalog.btrim(v_input->>'weekly_rate_classification_method'));
    v_tie_rule:=nullif(pg_catalog.upper(pg_catalog.btrim(v_input->>'duration_break_tie_rule')),'');
    v_candidate_queries:=(v_input->>'candidate_queries_enabled')::boolean;
    v_manager_queries:=(v_input->>'manager_queries_enabled')::boolean;
    v_manager_recipient:=nullif(pg_catalog.btrim(v_input->>'manager_query_recipient'),'');
    v_completed_copy:=(v_input->>'completed_pack_copy_enabled')::boolean;
    v_completed_recipient:=nullif(pg_catalog.btrim(v_input->>'completed_pack_recipient'),'');
  exception when others then
    raise exception 'WEEKLY_SOURCE_CLIENT_SETTINGS_SAVE_REQUEST_INVALID' using errcode='22023';
  end;
  perform private._weekly_source_settings_require_admin_v1(v_actor);
  v_environment:=private._weekly_source_settings_deployment_v1(v_agency,p_request->>'environment');
  if v_effective_from<current_date or nullif(v_expected,'') is null then
    raise exception 'WEEKLY_SOURCE_CLIENT_SETTINGS_SAVE_REQUEST_INVALID' using errcode='22023';
  end if;
  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended(
    'weekly-source-settings-client:'||v_client::text,0
  ));
  v_current_shape:=private._weekly_source_settings_client_shape_v1(
    v_agency,v_environment,v_client,v_effective_from
  );
  if v_current_shape->>'settings_version'<>v_expected then
    raise exception 'WEEKLY_SOURCE_SETTINGS_STALE' using errcode='40001';
  end if;
  if not (v_current_shape->>'eligible')::boolean then
    raise exception 'WEEKLY_SOURCE_CLIENT_SETTINGS_NOT_APPLICABLE' using errcode='22023';
  end if;

  select pg_catalog.count(*),
         pg_catalog.count(distinct case
           when contract.weekly_timesheet_source::text='NHSP' then 'NHSP'
           when contract.weekly_timesheet_source::text='HEALTHROSTER' then 'ROSTER'
         end),
         pg_catalog.count(distinct case
           when contract.weekly_timesheet_source::text='NHSP'
             or coalesce(contract.no_timesheet_required,false) then 'SOURCE_AUTHORITY'
           else 'TIMESHEET_AUTHORITY'
         end),
         pg_catalog.count(distinct contract.self_bill),
         pg_catalog.min(case
           when contract.weekly_timesheet_source::text='NHSP' then 'NHSP'
           when contract.weekly_timesheet_source::text='HEALTHROSTER' then 'ROSTER'
         end),
         pg_catalog.min(case
           when contract.weekly_timesheet_source::text='NHSP'
             or coalesce(contract.no_timesheet_required,false) then 'SOURCE_AUTHORITY'
           else 'TIMESHEET_AUTHORITY'
         end),
         pg_catalog.bool_and(contract.self_bill)
  into v_contract_count,v_family_count,v_mode_count,v_self_bill_count,
       v_family,v_authority,v_self_bill
  from public.contracts contract
  where contract.client_id=v_client
    and contract.weekly_timesheet_source::text<>'NONE'
    and contract.end_date>=v_effective_from;

  -- Client setup precedes contracts. Only the currently effective dedicated
  -- NHSP client mode may supply this pre-contract configuration basis.
  -- Existing source contracts (including conflicting ones) remain authoritative.
  if v_contract_count=0 and coalesce((
    select settings.is_nhsp
      and not coalesce(settings.requires_hr,false)
      and not coalesce(settings.autoprocess_hr,false)
      and not coalesce(settings.no_timesheet_required,false)
    from public.client_settings settings
    where settings.client_id=v_client
      and (settings.effective_from is null or settings.effective_from<=v_effective_from)
    order by settings.effective_from desc nulls last,settings.updated_at desc,settings.id desc
    limit 1
  ),false) then
    v_family:='NHSP';
    v_authority:='SOURCE_AUTHORITY';
    v_self_bill:=true;
    v_family_count:=1;
    v_mode_count:=1;
    v_self_bill_count:=1;
    v_client_nhsp_basis:=true;
  end if;

  -- F1: derive the SOURCE/CHECK_ONLY exception only from an exact saved
  -- dated agency assignment and actual unsigned Client/Contract settings.
  v_client_agency_basis:=private.weekly_source_configured_agency_invoice_v1(
    v_client,v_group_id,v_agency,v_environment,v_effective_from);
  if v_client_agency_basis then
    v_authority:='SOURCE_AUTHORITY';
    v_self_bill:=false;
  end if;
  if (v_contract_count=0 and not v_client_nhsp_basis) or v_family_count<>1 or v_mode_count<>1 or v_self_bill_count<>1
     or (v_authority='SOURCE_AUTHORITY' and not v_self_bill and not v_client_agency_basis)
     or (v_authority='TIMESHEET_AUTHORITY' and v_self_bill) then
    raise exception 'WEEKLY_SOURCE_CLIENT_CONTRACT_POLICY_INCONSISTENT' using errcode='55000';
  end if;
  v_document:=case v_authority when 'SOURCE_AUTHORITY' then 'CHECK_ONLY'
    else 'INVOICE_EVIDENCE_REQUIRED' end;
  if (v_input ? 'authority_mode' and v_input->>'authority_mode'<>v_authority)
     or (v_input ? 'document_mode' and v_input->>'document_mode'<>v_document)
     or (v_input ? 'self_bill_enabled' and (v_input->>'self_bill_enabled')::boolean<>v_self_bill) then
    raise exception 'WEEKLY_SOURCE_CLIENT_READ_ONLY_POLICY_MISMATCH' using errcode='22023';
  end if;

  if v_family='NHSP' then
    select pg_catalog.count(*) into v_nhsp_group_count
    from public.weekly_source_groups source_group
    where source_group.agency_id=v_agency
      and source_group.environment=v_environment
      and source_group.source_family='NHSP'
      and source_group.active;
    if v_nhsp_group_count<>1 then
      raise exception 'WEEKLY_SOURCE_NHSP_GROUP_REQUIRED' using errcode='55000';
    end if;
    select source_group.id into strict v_group_id
    from public.weekly_source_groups source_group
    where source_group.agency_id=v_agency
      and source_group.environment=v_environment
      and source_group.source_family='NHSP'
      and source_group.active;
  end if;

  -- F8/G1: all finalisers lock their group row before cycle/revision writes.
  -- Preserve client-advisory-first; acquire both groups in the same UUID order
  -- before the established target-group lock and before any membership write.
  select membership.source_group_id into v_locked_old_group_id
  from public.weekly_source_group_clients membership
  join public.weekly_source_groups source_group on source_group.id=membership.source_group_id
  where membership.client_id=v_client and source_group.agency_id=v_agency
    and source_group.environment=v_environment
    and v_effective_from between membership.valid_from and coalesce(membership.valid_to,'infinity'::date);
  perform 1 from public.weekly_source_groups source_group
  where source_group.id=v_group_id or source_group.id=v_locked_old_group_id
  order by source_group.id for update;

  select * into v_group from public.weekly_source_groups source_group
  where source_group.id=v_group_id for update;
  if not found or v_group.agency_id<>v_agency or v_group.environment<>v_environment
     or not v_group.active or v_group.source_family<>v_family then
    raise exception 'WEEKLY_SOURCE_CLIENT_GROUP_NOT_APPLICABLE' using errcode='22023';
  end if;
  if v_rate_method not in ('SPLIT_RATE_WINDOWS','WHOLE_SHIFT_START_DAY')
     or (v_rate_method='SPLIT_RATE_WINDOWS' and v_tie_rule not in ('EARLIEST_LONGEST_PORTION','LATEST_LONGEST_PORTION')) then
    raise exception 'WEEKLY_SOURCE_CLIENT_RATE_SETTINGS_INVALID' using errcode='22023';
  end if;
  if v_rate_method<>'SPLIT_RATE_WINDOWS' then v_tie_rule:=null; end if;

  if v_self_bill and v_family='ROSTER' then
    if v_correction not in ('FULL_REVERSAL_REPLACEMENT','NET_DIFFERENCE_PRESENTATION') then
      raise exception 'WEEKLY_SOURCE_CLIENT_CORRECTION_SETTING_REQUIRED' using errcode='22023';
    end if;
  elsif v_correction is not null then
    raise exception 'WEEKLY_SOURCE_CLIENT_CORRECTION_SETTING_NOT_APPLICABLE' using errcode='22023';
  end if;

  select exists(
    select 1
    from public.weekly_source_uploads upload
    join public.weekly_source_cycles cycle on cycle.id=upload.source_cycle_id
    join public.weekly_source_format_profiles profile on profile.id=upload.source_format_profile_id
    where cycle.source_group_id=v_group_id
      and profile.profile_json ? 'expense_column'
      and upload.state in ('SEALED','CURRENT','SUPERSEDED','CORRECTION_READY')
  ) or coalesce((v_current_shape->'settings'->>'source_fixed_expenses_enabled')::boolean,false)
  into v_expense_supported;
  if v_client_agency_basis and (v_source_expenses or v_source_expense_vat) then
    raise exception 'WEEKLY_SOURCE_RULE_R13' using errcode='22023';
  end if;
  if v_source_expenses and not v_expense_supported then
    raise exception 'WEEKLY_SOURCE_CLIENT_SOURCE_EXPENSES_NOT_APPLICABLE' using errcode='22023';
  end if;
  if not v_source_expenses then v_source_expense_vat:=false; end if;

  if v_authority<>'SOURCE_AUTHORITY' then
    if v_candidate_queries or v_manager_queries or v_manager_recipient is not null
       or v_completed_copy or v_completed_recipient is not null then
      raise exception 'WEEKLY_SOURCE_CLIENT_QUERY_SETTINGS_NOT_APPLICABLE' using errcode='22023';
    end if;
  else
    if not v_manager_queries then v_manager_recipient:=null; end if;
    if v_manager_queries and v_manager_recipient is null then
      select nullif(pg_catalog.btrim(client.ts_queries_email),'') into v_manager_recipient
      from public.clients client where client.id=v_client;
    end if;
    if v_manager_queries and v_manager_recipient is null then
      raise exception 'WEEKLY_SOURCE_MANAGER_QUERY_RECIPIENT_REQUIRED' using errcode='22023';
    end if;
    if not v_completed_copy then v_completed_recipient:=null; end if;
    if v_completed_copy and v_completed_recipient is null then
      select coalesce(
        v_manager_recipient,
        nullif(pg_catalog.btrim(client.ts_queries_email),'')
      ) into v_completed_recipient
      from public.clients client where client.id=v_client;
    end if;
    if v_completed_copy and v_completed_recipient is null then
      raise exception 'WEEKLY_SOURCE_COMPLETED_PACK_RECIPIENT_REQUIRED' using errcode='22023';
    end if;
  end if;

  select membership.* into v_membership
  from public.weekly_source_group_clients membership
  join public.weekly_source_groups source_group on source_group.id=membership.source_group_id
  where membership.client_id=v_client
    and source_group.agency_id=v_agency and source_group.environment=v_environment
    and v_effective_from between membership.valid_from and coalesce(membership.valid_to,'infinity'::date)
  for update of membership;
  if found then v_old_group_id:=v_membership.source_group_id; end if;
  if v_old_group_id is distinct from v_locked_old_group_id then
    raise exception 'WEEKLY_SOURCE_SETTINGS_STALE' using errcode='40001';
  end if;
  if v_old_group_id is not null and v_old_group_id<>v_group_id and exists(
    select 1 from public.weekly_source_final_revisions final
    join public.weekly_source_cycles cycle on cycle.id=final.source_cycle_id
      and cycle.source_group_id=v_old_group_id
    where final.state='CURRENT' and (
      cycle.scope_client_id=v_client
      or exists(select 1 from public.weekly_source_client_manifests manifest
        where manifest.final_revision_id=final.id and manifest.client_id=v_client)
      or exists(select 1 from public.weekly_source_report_scopes report
        where report.id=final.report_scope_id and report.client_id=v_client
          and report.source_cycle_id=cycle.id and report.source_group_id=v_old_group_id)
    )
  ) then
    raise exception 'WEEKLY_SOURCE_CLIENT_GROUP_HAS_CURRENT_FINAL_REVISION' using errcode='55000',
      detail='This client has a finalised report in its current group and cannot be moved.';
  end if;


  select pg_catalog.count(*) into v_membership_history_count
  from public.weekly_source_group_clients membership
  join public.weekly_source_groups source_group on source_group.id=membership.source_group_id
  where membership.client_id=v_client
    and source_group.agency_id=v_agency and source_group.environment=v_environment;
  v_membership_effective_from:=case when v_membership_history_count=0
    then date '1900-01-01' else v_effective_from end;

  if v_old_group_id is null then
    insert into public.weekly_source_group_clients(
      source_group_id,client_id,valid_from,created_by_user_id
    ) values (v_group_id,v_client,v_membership_effective_from,v_actor)
    returning * into v_membership;
  elsif v_old_group_id<>v_group_id then
    if v_membership.valid_from=v_effective_from then
      update public.weekly_source_group_clients
      set source_group_id=v_group_id
      where id=v_membership.id returning * into v_membership;
    else
      v_prior_end:=v_membership.valid_to;
      update public.weekly_source_group_clients set valid_to=v_effective_from-1
      where id=v_membership.id;
      insert into public.weekly_source_group_clients(
        source_group_id,client_id,valid_from,valid_to,created_by_user_id
      ) values (v_group_id,v_client,v_effective_from,v_prior_end,v_actor)
      returning * into v_membership;
    end if;
  end if;

  if v_old_group_id is not null then
    select * into v_policy
    from public.weekly_source_client_policies policy
    where policy.source_group_id=v_old_group_id and policy.client_id=v_client
      and v_effective_from between policy.effective_from and coalesce(policy.effective_to,'infinity'::date)
    for update;
    v_policy_found:=found;
  end if;
  select pg_catalog.count(*) into v_policy_history_count
  from public.weekly_source_client_policies policy
  join public.weekly_source_groups source_group on source_group.id=policy.source_group_id
  where policy.client_id=v_client
    and source_group.agency_id=v_agency and source_group.environment=v_environment;
  v_policy_effective_from:=case when v_policy_history_count=0
    then date '1900-01-01' else v_effective_from end;
  if v_policy_found and v_policy.effective_from=v_effective_from then
    update public.weekly_source_client_policies
    set source_group_id=v_group_id,authority_mode=v_authority,document_mode=v_document,
        self_bill_enabled=v_self_bill,self_bill_correction_presentation=v_correction,
        source_fixed_expenses_enabled=v_source_expenses,
        source_expense_vat_enabled=v_source_expense_vat,
        weekly_rate_classification_method=v_rate_method,duration_break_tie_rule=v_tie_rule,
        candidate_queries_enabled=v_candidate_queries,manager_queries_enabled=v_manager_queries,
        manager_query_recipient=v_manager_recipient,
        completed_pack_copy_enabled=v_completed_copy,completed_pack_recipient=v_completed_recipient,
        created_by_user_id=v_actor,created_at_utc=pg_catalog.transaction_timestamp()
    where id=v_policy.id;
  else
    if v_policy_found then
      v_prior_end:=v_policy.effective_to;
      update public.weekly_source_client_policies set effective_to=v_effective_from-1
      where id=v_policy.id;
    else
      v_prior_end:=null;
    end if;
    insert into public.weekly_source_client_policies(
      source_group_id,client_id,effective_from,effective_to,
      authority_mode,document_mode,self_bill_enabled,self_bill_correction_presentation,
      source_fixed_expenses_enabled,source_expense_vat_enabled,
      weekly_rate_classification_method,duration_break_tie_rule,
      candidate_queries_enabled,manager_queries_enabled,manager_query_recipient,
      completed_pack_copy_enabled,completed_pack_recipient,created_by_user_id
    ) values (
      v_group_id,v_client,v_policy_effective_from,v_prior_end,
      v_authority,v_document,v_self_bill,v_correction,
      v_source_expenses,v_source_expense_vat,v_rate_method,v_tie_rule,
      v_candidate_queries,v_manager_queries,v_manager_recipient,
      v_completed_copy,v_completed_recipient,v_actor
    );
  end if;

  -- R242: derive the fixed key inside the same actual settings owner.
  -- No approval field is admitted from Office. The just-saved dated target
  -- membership and native configured AGENCY scope own apply/clear together.
  -- All ordinary manager email/domain policy bytes are preserved.
  if private.weekly_source_configured_agency_invoice_v1(v_client,v_group_id,v_agency,v_environment,v_effective_from)
    is distinct from v_client_agency_basis then
    raise exception 'WEEKLY_SOURCE_AGENCY_FIXED_APPROVAL_SCOPE_STALE' using errcode='40001';end if;
  for v_approval_contract in
    select contract.* from public.contracts contract where contract.client_id=v_client
      and ((v_client_agency_basis and contract.weekly_timesheet_source::text='HEALTHROSTER'
        and contract.end_date>=v_effective_from)
        or (not v_client_agency_basis and contract.candidate_manager_approval_policy_json->'approval'='"NOT_REQUIRED"'::jsonb))
    order by contract.id for update
  loop
    v_approval_before:=v_approval_contract.candidate_manager_approval_policy_json;
    v_approval_after:=case when v_client_agency_basis
      then coalesce(v_approval_before,'{}'::jsonb)||jsonb_build_object('approval','NOT_REQUIRED')
      else v_approval_before-'approval' end;
    if v_approval_after is not distinct from v_approval_before then continue;end if;
    v_approval_capture:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_FIXED_APPROVAL_CHANGE_V1',
      'contract_id',v_approval_contract.id,'client_id',v_client,'source_group_id',v_group_id,
      'previous_source_group_id',v_old_group_id,'effective_from',v_effective_from,
      'expected_contract_updated_at',v_approval_contract.updated_at,
      'before_policy',v_approval_before,'after_policy',v_approval_after,
      'operation',case when v_client_agency_basis then 'APPLY' else 'CLEAR' end);
    -- Every real change has a new native receipt, including A -> B -> A in
    -- one transaction. An equal historical input hash is not a replay owner.
    -- Feature request replay is already owned by its immutable feature receipt;
    -- a repeated Client save with unchanged policy takes the no-op above.
    v_approval_capture:=v_approval_capture||jsonb_build_object('input_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_FIXED_APPROVAL_CHANGE_V1',v_approval_capture),'hex'));
    v_approval_key:='SOURCE_AGENCY_FIXED:'||gen_random_uuid()::text;
    update public.contracts set candidate_manager_approval_policy_json=v_approval_after,
      updated_at=transaction_timestamp() where id=v_approval_contract.id returning * into v_approval_contract;
    v_approval_response:=public.contract_manager_authoriser_policy_get_v1(v_approval_contract.id)
      ||jsonb_build_object('system_fixed_approval',v_approval_capture,'idempotent_replay',false);
    insert into public.candidate_manager_authoriser_policy_receipts(
      entity_kind,entity_id,idempotency_key,semantic_sha256,response_json,actor_user_id,recorded_at_utc)
    values('CONTRACT',v_approval_contract.id,v_approval_key,
      extensions.digest(convert_to(v_approval_after::text,'UTF8'),'sha256'),v_approval_response,v_actor,transaction_timestamp());
    v_approval_changes:=v_approval_changes||jsonb_build_array(v_approval_capture||jsonb_build_object(
      'contract_updated_at',v_approval_contract.updated_at,'receipt_idempotency_key',v_approval_key));
  end loop;

  if v_old_group_id is not null and v_old_group_id<>v_group_id then
    perform private._weekly_source_settings_stale_open_v1(v_old_group_id,v_client);
  end if;
  perform private._weekly_source_settings_stale_open_v1(v_group_id,v_client);
  return private._weekly_source_settings_client_shape_v1(
    v_agency,v_environment,v_client,v_effective_from
  )||case when jsonb_array_length(v_approval_changes)=0 then '{}'::jsonb
    else jsonb_build_object('contract_approval_changes',v_approval_changes) end;
exception when exclusion_violation then
  raise exception 'WEEKLY_SOURCE_CLIENT_SETTINGS_EFFECTIVE_RANGE_CONFLICT' using errcode='23P01';
end;
$function$;

create or replace function public.weekly_source_group_rule_feature_set_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_actor uuid; v_agency uuid; v_environment text; v_group_id uuid; v_assignment_id uuid; v_version_id uuid;
  v_request_id uuid; v_expected bigint; v_enabled boolean; v_from date; v_release_id text; v_reason text; v_purpose text; v_hash text; v_receipt jsonb;
  v_group public.weekly_source_groups%rowtype; v_assignment public.weekly_source_group_rule_assignments%rowtype;
  v_latest private.cloudtms_database_releases%rowtype; v_values jsonb;
  v_member record; v_manifest jsonb; v_shape jsonb; v_result jsonb; v_changes jsonb:='[]'::jsonb;
  v_entry jsonb; v_apply_values jsonb; v_scope_date date; v_agency_invoice boolean:=false; v_qualification jsonb; v_report_qualification jsonb;
begin
  if p_request->>'qualification_action' in ('OFF_RULE_OPEN','OFF_RULE_CLOSE','OFF_RULE_REVOKE') then
    return private.weekly_source_rule_qualification_setup_atomic_v1(p_request);
  elsif p_request->>'qualification_action'='OFF_RULE_COMMAND' then
    return private.weekly_source_rule_qualification_execute_v1(p_request);
  elsif p_request->>'qualification_action'='OFF_RULE_TRANSPORT_STATUS' then
    return private.weekly_source_rule_qualification_transport_status_v1(p_request);
  elsif p_request->>'qualification_action'='OFF_RULE_STATUS' then
    return private.weekly_source_rule_qualification_status_v1(p_request);
  end if;
  if p_request ? 'qualification_action' then
    return private.weekly_source_protected_test_setup_atomic_v1(p_request);
  end if;
  perform private._weekly_source_settings_assert_request_v1(p_request,array['actor_user_id','agency_id','environment','source_group_id','assignment_id',
    'rule_set_version_id','effective_from_week_ending','expected_assignment_version','feature_enabled','feature_purpose','release_id','reason','request_id',
    'client_settings_versions','protected_capability_qualification_sha256','activation_probe_scope_id'],'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID');
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid; v_agency:=(p_request->>'agency_id')::uuid; v_group_id:=(p_request->>'source_group_id')::uuid;
    v_assignment_id:=(p_request->>'assignment_id')::uuid; v_version_id:=nullif(p_request->>'rule_set_version_id','')::uuid;
    v_request_id:=(p_request->>'request_id')::uuid; v_expected:=(p_request->>'expected_assignment_version')::bigint;
    v_enabled:=(p_request->>'feature_enabled')::boolean; v_from:=(p_request->>'effective_from_week_ending')::date;
    v_release_id:=p_request->>'release_id'; v_reason:=btrim(p_request->>'reason'); v_purpose:=p_request->>'feature_purpose';
  exception when others then raise exception 'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID' using errcode='22023'; end;
  perform private._weekly_source_settings_require_admin_v1(v_actor);
  v_environment:=private._weekly_source_settings_deployment_v1(v_agency,p_request->>'environment');
  if v_group_id is null or v_assignment_id is null or v_request_id is null or v_expected is null or v_from is null
    or jsonb_typeof(p_request->'feature_enabled') is distinct from 'boolean'
    or not p_request ? 'rule_set_version_id' or v_release_id is null or v_reason is null or char_length(v_reason) not between 1 and 500
    or v_purpose is null or v_purpose not in ('RULE_SET','SIGNED_CHECK_ONLY','PROTECTED_SOURCE') or (v_version_id is null)<>(v_purpose in ('SIGNED_CHECK_ONLY','PROTECTED_SOURCE'))
    or p_request->>'effective_from_week_ending'<>to_char(v_from,'YYYY-MM-DD') then
    raise exception 'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID' using errcode='22023'; end if;
  if p_request ? 'protected_capability_qualification_sha256' and
    (jsonb_typeof(p_request->'protected_capability_qualification_sha256') is distinct from 'string'
      or coalesce(p_request->>'protected_capability_qualification_sha256','') !~ '^[0-9a-f]{64}$') then
    raise exception 'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID' using errcode='22023'; end if;
  if v_purpose in ('RULE_SET','PROTECTED_SOURCE') and v_enabled and not(p_request ? 'protected_capability_qualification_sha256') and not(p_request ? 'activation_probe_scope_id') then
    raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_RELEASE_UNQUALIFIED' using errcode='55000'; end if;
  if p_request ? 'activation_probe_scope_id' then
    if v_purpose is distinct from 'PROTECTED_SOURCE' or v_enabled is distinct from true or v_version_id is not null
      or p_request ? 'protected_capability_qualification_sha256' then
      raise exception 'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID' using errcode='22023'; end if;
    perform private.weekly_source_protected_activation_probe_assert_v1((p_request->>'activation_probe_scope_id')::uuid,
      v_actor,v_group_id,v_from,(select effective_to_week_ending from public.weekly_source_group_rule_assignments where id=v_assignment_id),v_assignment_id);
  end if;
  if v_purpose='SIGNED_CHECK_ONLY' and p_request ? 'protected_capability_qualification_sha256' then
    raise exception 'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID' using errcode='22023'; end if;
  v_hash:=encode(extensions.digest(convert_to(p_request::text,'UTF8'),'sha256'),'hex');
  perform pg_advisory_xact_lock(hashtextextended('weekly-source-cycle-lifecycle:'||v_group_id::text,0));
  -- Match the Client owner's client-before-group lock order. Recheck the exact
  -- dated membership after taking the group/assignment locks below.
  if (select count(distinct gc.client_id) from public.weekly_source_group_clients gc
    where gc.source_group_id=v_group_id and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]')
      && daterange(v_from-6,'infinity'::date,'[]'))>100 then
    raise exception 'WEEKLY_SOURCE_RULE_ACTIVATION_SCOPE_TOO_LARGE' using errcode='22023'; end if;
  for v_member in select distinct gc.client_id from public.weekly_source_group_clients gc
    where gc.source_group_id=v_group_id and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]')
      && daterange(v_from-6,'infinity'::date,'[]') order by gc.client_id
  loop
    perform pg_advisory_xact_lock(hashtextextended('weekly-source-settings-client:'||v_member.client_id::text,0));
  end loop;
  select * into v_group from public.weekly_source_groups where id=v_group_id for update;
  if not found or v_group.agency_id<>v_agency or v_group.environment<>v_environment or not v_group.active or v_group.source_family<>'ROSTER' then
    raise exception 'WEEKLY_SOURCE_RULE_GROUP_NOT_APPLICABLE' using errcode='22023'; end if;
  select * into v_assignment from public.weekly_source_group_rule_assignments where id=v_assignment_id and source_group_id=v_group_id for update;
  if not found or v_assignment.rule_set_version_id is distinct from v_version_id or v_assignment.effective_from_week_ending<>v_from then
    raise exception 'WEEKLY_SOURCE_RULE_ASSIGNMENT_NOT_FOUND' using errcode='22023'; end if;
  -- Latest record, not latest successful record: an APPLYING/FAILED successor holds activation.
  select * into v_latest from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1;
  if not found or v_latest.release_id<>v_release_id or v_latest.status<>'VERIFIED'
    or v_latest.completed_at_utc is null or v_latest.installed_contract_sha256 is distinct from v_latest.repository_contract_sha256 then
    raise exception 'WEEKLY_SOURCE_RULE_VERIFIED_RELEASE_REQUIRED' using errcode='55000'; end if;
  if v_assignment.feature_request_id=v_request_id then
    if v_assignment.feature_request_sha256<>v_hash then raise exception 'WEEKLY_SOURCE_RULE_REQUEST_REUSED' using errcode='22023'; end if;
    if v_assignment.feature_enabled and v_assignment.feature_receipt_json ? 'protected_capability_qualification' then
      if p_request ? 'activation_probe_scope_id' then
        perform private.weekly_source_protected_activation_probe_assert_v1((p_request->>'activation_probe_scope_id')::uuid,
          v_actor,v_group_id,v_from,v_assignment.effective_to_week_ending,v_assignment_id);
      else
        perform private.weekly_source_protected_operational_certificate_assert_v1(
          v_assignment.feature_receipt_json->'protected_capability_qualification',v_group_id,v_from,v_assignment.effective_to_week_ending,
          v_assignment.feature_receipt_json#>>'{protected_capability_qualification,qualification_sha256}');
      end if;
    end if;
    if v_assignment.feature_enabled and v_assignment.feature_receipt_json ? 'report_fin_qualification' then
      if v_assignment.feature_receipt_json->'report_fin_qualification' is distinct from
        private.weekly_source_report_fin_feature_binding_v1(v_group_id,v_version_id,v_from,v_assignment.effective_to_week_ending,
          v_assignment.feature_receipt_json->'protected_capability_qualification') then
        raise exception 'WEEKLY_SOURCE_REPORT_FIN_FEATURE_RECEIPT_UNQUALIFIED' using errcode='55000';
      end if;
    end if;
    return v_assignment.feature_receipt_json||jsonb_build_object('replayed',true);
  end if;
  if v_assignment.version<>v_expected then raise exception 'WEEKLY_SOURCE_RULE_ASSIGNMENT_STALE' using errcode='40001'; end if;
  perform 1 from public.clients c where exists(select 1 from public.weekly_source_group_clients gc
    where gc.client_id=c.id and gc.source_group_id=v_group_id
      and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]') && daterange(v_from-6,coalesce(v_assignment.effective_to_week_ending,'infinity'::date),'[]'))
    order by c.id for update;
  perform 1 from public.client_settings cs where exists(select 1 from public.weekly_source_group_clients gc
    where gc.client_id=cs.client_id and gc.source_group_id=v_group_id
      and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]') && daterange(v_from-6,coalesce(v_assignment.effective_to_week_ending,'infinity'::date),'[]'))
    order by cs.id for update;
  perform 1 from public.contracts c where exists(select 1 from public.weekly_source_group_clients gc
    where gc.client_id=c.client_id and gc.source_group_id=v_group_id
      and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]') && daterange(v_from-6,coalesce(v_assignment.effective_to_week_ending,'infinity'::date),'[]'))
    order by c.id for share;
  -- Same owner requalification is metadata-only. Exact current assignment CAS,
  -- actor/deployment/latest VERIFIED and locked Client/Contract gates above stay.
  if p_request ? 'activation_probe_scope_id' then
    v_qualification:=private.weekly_source_protected_activation_probe_assert_v1((p_request->>'activation_probe_scope_id')::uuid,
      v_actor,v_group_id,v_from,v_assignment.effective_to_week_ending,v_assignment_id);
  elsif v_enabled and p_request ? 'protected_capability_qualification_sha256' then
    v_qualification:=private.weekly_source_protected_capability_release_evidence_v1(v_group_id,v_from,
      v_assignment.effective_to_week_ending,p_request->>'protected_capability_qualification_sha256');
    perform private.weekly_source_protected_operational_certificate_assert_v1(v_qualification,v_group_id,v_from,
      v_assignment.effective_to_week_ending,p_request->>'protected_capability_qualification_sha256');
  elsif p_request ? 'protected_capability_qualification_sha256' then
    raise exception 'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID' using errcode='22023'; end if;
  -- Server-derived Report binding, using only the actual saved immutable
  -- version/range. No browser strategy/hash field and no default A/B.
  if v_enabled and v_purpose='RULE_SET' then
    v_report_qualification:=private.weekly_source_report_fin_feature_binding_v1(v_group_id,v_version_id,v_from,v_assignment.effective_to_week_ending,v_qualification);
  end if;
  if v_assignment.feature_enabled=v_enabled then
    if not v_enabled or v_qualification is null or v_assignment.feature_purpose is distinct from v_purpose then
      raise exception 'WEEKLY_SOURCE_RULE_FEATURE_ALREADY_SET' using errcode='22023'; end if;
    if v_purpose='PROTECTED_SOURCE' then
      perform private.weekly_source_protected_source_activation_scope_v1(v_group_id,v_from,v_assignment.effective_to_week_ending);
    else
      select values_json into strict v_values from public.weekly_source_rule_set_versions where id=v_version_id;
      perform private._weekly_source_rule_group_context_v1(v_group_id,v_from,v_assignment.effective_to_week_ending,v_values,true);
    end if;
    if p_request ? 'client_settings_versions' and p_request->'client_settings_versions'<>'[]'::jsonb then
      raise exception 'WEEKLY_SOURCE_RULE_CLIENT_CAS_MANIFEST_INVALID' using errcode='22023'; end if;
    -- Preserve the exact AGENCY restore receipt, without calling Client save.
    v_receipt:=v_assignment.feature_receipt_json||jsonb_build_object('assignment_version',v_assignment.version+1,
      'release_id',v_release_id,'actor_user_id',v_actor,'changed_at_utc',transaction_timestamp(),'reason',v_reason,
      'request_id',v_request_id,'protected_capability_qualification',v_qualification,'requalification',true,'replayed',false)
      ||case when v_report_qualification is null then '{}'::jsonb else jsonb_build_object('report_fin_qualification',v_report_qualification) end;
    update public.weekly_source_group_rule_assignments set feature_changed_by_user_id=v_actor,
      feature_changed_at_utc=transaction_timestamp(),feature_change_reason=v_reason,feature_release_id=v_release_id,
      feature_request_id=v_request_id,feature_request_sha256=v_hash,feature_receipt_json=v_receipt,version=version+1 where id=v_assignment_id;
    return v_receipt;
  end if;
  select v.values_json into v_values from public.weekly_source_rule_set_versions v join public.weekly_source_rule_sets r on r.id=v.rule_set_id
    where v.id=v_version_id and r.agency_id=v_agency and r.environment=v_environment;
  if v_version_id is not null and not found then raise exception 'WEEKLY_SOURCE_RULE_VERSION_NOT_FOUND' using errcode='22023'; end if;
  v_agency_invoice:=coalesce(v_values->>'invoice_sender'='AGENCY_INVOICE',false);
  if v_agency_invoice then
    v_manifest:=p_request->'client_settings_versions';
    if jsonb_typeof(v_manifest) is distinct from 'array' or jsonb_array_length(v_manifest) not between 1 and 100 then
      raise exception 'WEEKLY_SOURCE_RULE_CLIENT_CAS_MANIFEST_REQUIRED' using errcode='22023'; end if;
    for v_entry in select value from jsonb_array_elements(v_manifest) loop
      perform private._weekly_source_settings_assert_request_v1(v_entry,array['client_id','expected_settings_version'],'WEEKLY_SOURCE_RULE_CLIENT_CAS_MANIFEST_INVALID');
      if jsonb_typeof(v_entry->'client_id') is distinct from 'string' or v_entry->>'client_id' !~ '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$'
        or jsonb_typeof(v_entry->'expected_settings_version') is distinct from 'string'
        or v_entry->>'expected_settings_version' !~ '^[0-9a-f]{64}$' then
        raise exception 'WEEKLY_SOURCE_RULE_CLIENT_CAS_MANIFEST_INVALID' using errcode='22023'; end if;
    end loop;
    if (select count(distinct value->>'client_id') from jsonb_array_elements(v_manifest))<>jsonb_array_length(v_manifest)
      or (select count(distinct gc.client_id) from public.weekly_source_group_clients gc where gc.source_group_id=v_group_id
        and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]') && daterange(v_from-6,coalesce(v_assignment.effective_to_week_ending,'infinity'::date),'[]'))<>jsonb_array_length(v_manifest)
      or exists(select 1 from jsonb_array_elements(v_manifest) x where not exists(select 1 from public.weekly_source_group_clients gc
        where gc.source_group_id=v_group_id and gc.client_id=(x.value->>'client_id')::uuid
          and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]') && daterange(v_from-6,coalesce(v_assignment.effective_to_week_ending,'infinity'::date),'[]'))) then
      raise exception 'WEEKLY_SOURCE_RULE_CLIENT_CAS_MANIFEST_INVALID' using errcode='22023'; end if;
    for v_member in select gc.client_id,greatest(v_from-6,min(gc.valid_from)) as scope_date
      from public.weekly_source_group_clients gc where gc.source_group_id=v_group_id
        and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]') && daterange(v_from-6,coalesce(v_assignment.effective_to_week_ending,'infinity'::date),'[]')
      group by gc.client_id order by gc.client_id
    loop
      v_scope_date:=v_member.scope_date;
      if v_scope_date<(transaction_timestamp() at time zone 'Europe/London')::date then
        raise exception 'WEEKLY_SOURCE_RULE_FUTURE_WEEK_REQUIRED' using errcode='22023'; end if;
      v_shape:=private._weekly_source_settings_client_shape_v1(v_agency,v_environment,v_member.client_id,v_scope_date);
      if v_shape->>'settings_version'<>(select value->>'expected_settings_version' from jsonb_array_elements(v_manifest) where (value->>'client_id')::uuid=v_member.client_id) then
        raise exception 'WEEKLY_SOURCE_RULE_CLIENT_SETTINGS_STALE' using errcode='40001'; end if;
      if v_enabled then
        if exists(select 1 from public.weekly_source_client_policies cp where cp.source_group_id=v_group_id and cp.client_id=v_member.client_id
          and cp.effective_from>v_scope_date and cp.effective_from<=coalesce(v_assignment.effective_to_week_ending,'infinity'::date)) then
          raise exception 'WEEKLY_SOURCE_RULE_ACTIVATION_FUTURE_SETTINGS_REFUSED' using errcode='22023'; end if;
        v_changes:=v_changes||jsonb_build_array(jsonb_build_object('client_id',v_member.client_id,'scope_date',v_scope_date,
          'before_values',v_shape->'settings','before_settings_version',v_shape->>'settings_version',
          'before_policy_id',(select cp.id from public.weekly_source_client_policies cp where cp.source_group_id=v_group_id and cp.client_id=v_member.client_id
            and v_scope_date between cp.effective_from and coalesce(cp.effective_to,'infinity'::date))));
      else
        select value into v_entry from jsonb_array_elements(v_assignment.feature_receipt_json->'client_changes')
          where (value->>'client_id')::uuid=v_member.client_id;
        if not found or v_entry->>'after_settings_version' is distinct from v_shape->>'settings_version'
          or (v_entry->>'scope_date')::date<>v_scope_date then
          raise exception 'WEEKLY_SOURCE_RULE_CLIENT_RESTORE_STALE' using errcode='40001'; end if;
        v_changes:=v_changes||jsonb_build_array(v_entry);
      end if;
    end loop;
  elsif p_request ? 'client_settings_versions' and p_request->'client_settings_versions'<>'[]'::jsonb then
    raise exception 'WEEKLY_SOURCE_RULE_CLIENT_CAS_MANIFEST_INVALID' using errcode='22023';
  end if;
  if v_enabled then
    if v_from<(transaction_timestamp() at time zone 'Europe/London')::date then
      raise exception 'WEEKLY_SOURCE_RULE_FUTURE_WEEK_REQUIRED' using errcode='22023'; end if;
    perform 1 from public.weekly_source_cycles c where c.source_group_id=v_group_id
      and c.finalisation_week_ending between v_from and coalesce(v_assignment.effective_to_week_ending,'infinity'::date) order by c.id for update;
    if exists(select 1 from public.weekly_source_cycles c where c.source_group_id=v_group_id
      and c.finalisation_week_ending between v_from and coalesce(v_assignment.effective_to_week_ending,'infinity'::date)
      and (c.current_final_revision_id is not null or c.state in ('FINALISING','FINALISED','CORRECTION_IN_PROGRESS')
        or exists(select 1 from public.weekly_source_final_revisions f where f.source_cycle_id=c.id))) then
      raise exception 'WEEKLY_SOURCE_RULE_FINALISED_WEEK_REFUSED' using errcode='55000'; end if;
    if v_purpose='PROTECTED_SOURCE' then
      perform private.weekly_source_protected_source_activation_scope_v1(v_group_id,v_from,v_assignment.effective_to_week_ending);
    else
      perform private._weekly_source_rule_group_context_v1(v_group_id,v_from,v_assignment.effective_to_week_ending,v_values,not v_agency_invoice);
    end if;
  end if;
  -- Publish the gate and the approved Client policy transition together. The
  -- feature receipt and Client writes cannot survive any refusal below.
  update public.weekly_source_group_rule_assignments set feature_enabled=v_enabled,feature_purpose=v_purpose,
    feature_changed_by_user_id=v_actor,feature_changed_at_utc=transaction_timestamp(),feature_change_reason=v_reason,feature_release_id=v_release_id,
    feature_request_id=v_request_id,feature_request_sha256=v_hash,feature_receipt_json='{}'::jsonb where id=v_assignment_id;
  if v_agency_invoice then
    v_manifest:='[]'::jsonb;
    for v_entry in select value from jsonb_array_elements(v_changes) order by value->>'client_id' loop
      v_scope_date:=(v_entry->>'scope_date')::date;
      v_shape:=private._weekly_source_settings_client_shape_v1(v_agency,v_environment,(v_entry->>'client_id')::uuid,v_scope_date);
      v_apply_values:=v_entry->'before_values'||jsonb_build_object('effective_from',v_scope_date);
      if v_enabled then v_apply_values:=v_apply_values||jsonb_build_object('authority_mode','SOURCE_AUTHORITY','document_mode','CHECK_ONLY','self_bill_enabled',false); end if;
      v_result:=public.weekly_source_client_settings_save_atomic_v1(jsonb_build_object('actor_user_id',v_actor,'agency_id',v_agency,'environment',v_environment,
        'client_id',v_entry->>'client_id','expected_settings_version',v_shape->>'settings_version','settings',v_apply_values));
      if coalesce((v_result->>'ok')::boolean,false) is not true then raise exception 'WEEKLY_SOURCE_RULE_CLIENT_TRANSITION_FAILED' using errcode='55000'; end if;
      v_shape:=private._weekly_source_settings_client_shape_v1(v_agency,v_environment,(v_entry->>'client_id')::uuid,v_scope_date);
      v_manifest:=v_manifest||jsonb_build_array(v_entry||case when v_result ? 'contract_approval_changes'
        then jsonb_build_object('contract_approval_changes',v_result->'contract_approval_changes') else '{}'::jsonb end||jsonb_build_object(
        case when v_enabled then 'after_values' else 'restored_values' end,v_shape->'settings',
        case when v_enabled then 'after_settings_version' else 'restored_settings_version' end,v_shape->>'settings_version',
        case when v_enabled then 'after_policy_id' else 'restored_policy_id' end,(select cp.id from public.weekly_source_client_policies cp
          where cp.source_group_id=v_group_id and cp.client_id=(v_entry->>'client_id')::uuid
            and v_scope_date between cp.effective_from and coalesce(cp.effective_to,'infinity'::date))));
    end loop;
    v_changes:=v_manifest;
    if v_enabled then perform private._weekly_source_rule_group_context_v1(v_group_id,v_from,v_assignment.effective_to_week_ending,v_values,true); end if;
  end if;
  v_receipt:=jsonb_build_object('contract','WEEKLY_SOURCE_RULE_FEATURE_RECEIPT_V1','assignment_id',v_assignment_id,
    'assignment_version',v_assignment.version+1,'source_group_id',v_group_id,'rule_set_version_id',v_version_id,
    'effective_from_week_ending',v_from,'feature_enabled',v_enabled,'feature_purpose',v_purpose,'release_id',v_release_id,
    'actor_user_id',v_actor,'changed_at_utc',transaction_timestamp(),'reason',v_reason,'request_id',v_request_id,'client_changes',v_changes,'replayed',false)||case when v_qualification is null then '{}'::jsonb else
      jsonb_build_object('protected_capability_qualification',v_qualification) end
      ||case when v_report_qualification is null then '{}'::jsonb else jsonb_build_object('report_fin_qualification',v_report_qualification) end;
  update public.weekly_source_group_rule_assignments set feature_enabled=v_enabled,feature_purpose=v_purpose,
    feature_changed_by_user_id=v_actor,feature_changed_at_utc=transaction_timestamp(),feature_change_reason=v_reason,feature_release_id=v_release_id,
    feature_request_id=v_request_id,feature_request_sha256=v_hash,feature_receipt_json=v_receipt,version=version+1 where id=v_assignment_id;
  return v_receipt;
end;
$function$;

create or replace function private._candidate_policy_resolve_v1(
  p_client_id uuid,
  p_contract_id uuid default null,
  p_evaluation_date date default null
)
returns jsonb
language plpgsql
stable
security definer
set search_path = pg_catalog, public, private, extensions, pg_temp
as $function$
declare
  v_date date:=coalesce(p_evaluation_date,(transaction_timestamp() at time zone 'Europe/London')::date);
  v_authority jsonb;
  v_values jsonb;
  v_sources jsonb;
  v_global public.settings_defaults%rowtype;
  v_email text;
  v_email_ready boolean;
  v_result jsonb;
  v_manager_policy jsonb;
  v_agency_group record;
  v_agency_group_count integer;
  v_fixed_from date;
  v_fixed_to date;
begin
  if p_client_id is null then
    raise exception 'CANDIDATE_POLICY_CLIENT_REQUIRED' using errcode='22023';
  end if;
  v_authority:=private._contract_settings_effective_core_v1(
    p_client_id,p_contract_id,v_date,'WEEKLY',null
  );
  v_values:=v_authority->'values';
  v_sources:=v_authority->'sources';
  select * into v_global from public.settings_defaults where id=1;
  if not found then
    raise exception 'CANDIDATE_GLOBAL_SETTINGS_MISSING' using errcode='55000';
  end if;
  -- R242 is a system-owned dated preset policy, never an Office choice.
  -- The Contract JSON is unversioned: a future apply/clear must not change
  -- approval for an earlier week, and a cloned/new Contract must resolve its
  -- own genuine membership. Re-resolve only this key from the native dated
  -- assignment. Preserve every ordinary manager-policy byte unchanged.
  v_manager_policy:=coalesce(v_values->'candidate_manager_approval_policy_json','{}'::jsonb)-'approval';
  select greatest(contract.start_date,v_date-6),least(contract.end_date,v_date)
  into v_fixed_from,v_fixed_to from public.contracts contract
  where contract.id=p_contract_id and contract.client_id=p_client_id
    and contract.weekly_timesheet_source::text='HEALTHROSTER'
    and contract.start_date<=v_date and contract.end_date>=v_date-6;
  if found
     and v_authority->>'configured_route'='HEALTHROSTER_WEEKLY_VALIDATION'
     and coalesce((v_authority#>>'{applicability,configuration_valid}')::boolean,false)
     and not coalesce((v_authority#>>'{applicability,import_authoritative}')::boolean,false) then
    select count(*) into v_agency_group_count
    from public.weekly_source_group_clients membership
    join public.weekly_source_groups source_group on source_group.id=membership.source_group_id
      and source_group.active and source_group.source_family='ROSTER'
      and source_group.environment=v_global.candidate_app_environment
    where membership.client_id=p_client_id
      and v_fixed_from>=membership.valid_from
      and v_fixed_to<=coalesce(membership.valid_to,'infinity'::date);
    if v_agency_group_count>1 then
      raise exception 'WEEKLY_SOURCE_GROUP_CARDINALITY_INVALID' using errcode='55000';
    elsif v_agency_group_count=1 then
      select source_group.id,source_group.agency_id,source_group.environment into strict v_agency_group
      from public.weekly_source_group_clients membership
      join public.weekly_source_groups source_group on source_group.id=membership.source_group_id
        and source_group.active and source_group.source_family='ROSTER'
        and source_group.environment=v_global.candidate_app_environment
      where membership.client_id=p_client_id
        and v_fixed_from>=membership.valid_from
        and v_fixed_to<=coalesce(membership.valid_to,'infinity'::date);
      if private.weekly_source_configured_agency_invoice_v1(
        p_client_id,v_agency_group.id,v_agency_group.agency_id,v_agency_group.environment,v_fixed_to
      ) is true then
        v_manager_policy:=v_manager_policy||jsonb_build_object('approval','NOT_REQUIRED');
      end if;
    end if;
  end if;
  v_email:=nullif(btrim(v_values->>'candidate_expense_invoice_email'),'');
  v_email_ready:=v_email is not null and char_length(v_email)<=320
    and v_email~'^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$';
  v_result:=jsonb_build_object(
    'client_id',p_client_id,'contract_id',p_contract_id,'evaluation_date',v_date,
    'candidate_electronic_auto_authorise',coalesce((v_values->>'candidate_electronic_auto_authorise')::boolean,false),
    'candidate_electronic_auto_authorise_source',v_sources->>'candidate_electronic_auto_authorise',
    'expenses_require_separate_timesheet',coalesce((v_values->>'candidate_expenses_require_separate_timesheet')::boolean,false),
    'expenses_require_separate_timesheet_source',v_sources->>'candidate_expenses_require_separate_timesheet',
    'import_expense_separation_mandatory',coalesce((v_authority#>>'{applicability,import_authoritative}')::boolean,false),
    'import_source_family',v_authority->>'configured_route',
    'paper_submission_enabled',coalesce((v_values->>'candidate_paper_submission_enabled')::boolean,false),
    'paper_submission_enabled_source',v_sources->>'candidate_paper_submission_enabled',
    'expense_invoice_email',v_email,'expense_invoice_email_ready',v_email_ready,
    'manager_approval_policy',v_manager_policy,
    'allow_daily_manager_authorise_on_phone',coalesce((v_values->>'allow_daily_manager_authorise_on_phone')::boolean,true),
    'allow_daily_manager_authorise_by_email',coalesce((v_values->>'allow_daily_manager_authorise_by_email')::boolean,false),
    'hours_deviation_pct',v_global.candidate_hours_deviation_pct,
    'barred_manager_email_domains',private._candidate_normalize_domain_array_v1(v_global.candidate_barred_manager_email_domains),
    'client_setting_found',true,
    'client_settings_id',nullif(v_authority->>'client_settings_id','')::uuid,
    'contract_found',p_contract_id is not null,
    'global_settings_updated_at',nullif(v_authority->>'global_settings_updated_at','')::timestamptz,
    'authority_version',v_authority->>'authority_version',
    'authority_fingerprint',v_authority->>'authority_fingerprint'
  );
  return v_result||jsonb_build_object(
    'policy_fingerprint',encode(digest(convert_to(v_result::text,'UTF8'),'sha256'),'hex')
  );
end
$function$;

create or replace function public.candidate_workflow_transition_atomic_v1(
  p_session_id uuid,
  p_environment text,
  p_workflow_id uuid,
  p_action text,
  p_expected_generation integer,
  p_payload jsonb default '{}'::jsonb,
  p_idempotency_key text default null,
  p_now_utc timestamptz default now()
)
returns jsonb
language plpgsql
security definer
set search_path = pg_catalog, public, private, pg_temp
as $function$
declare
  v_environment text;
  v_action text:=upper(btrim(coalesce(p_action,'')));
  v_payload jsonb:=coalesce(p_payload,'{}'::jsonb);
  v_context jsonb;
  v_account_id uuid;
  v_candidate_id uuid;
  v_workflow public.candidate_submission_workflows%rowtype;
  v_source_workflow public.candidate_submission_workflows%rowtype;
  v_existing_workflow public.candidate_submission_workflows%rowtype;
  v_contract public.contracts%rowtype;
  v_week public.contract_weeks%rowtype;
  v_anchor_week public.contract_weeks%rowtype;
  v_anchor_timesheet public.timesheets%rowtype;
  v_daily_timesheet public.timesheets%rowtype;
  v_daily_fin public.timesheets_financials%rowtype;
  v_daily_receipt_context jsonb;
  v_daily_first_source boolean:=false;
  v_policy jsonb;
  v_approval public.candidate_approval_requests%rowtype;
  v_component public.candidate_submission_components%rowtype;
  v_signature_component public.candidate_submission_components%rowtype;
  v_email_check jsonb;
  v_token_hash bytea;
  v_digest bytea;
  v_submission_hash bytea;
  v_render_input_hash bytea;
  v_manifest_hash bytea;
  v_mail_id uuid;
  v_response jsonb;
  v_manifest jsonb;
  v_render_contract jsonb;
  v_receipt jsonb;
  v_immutable_submission jsonb;
  v_expense_submission jsonb;
  v_component_ids uuid[];
  v_method text;
  v_next_generation integer;
  v_component_no integer;
  v_request_generation integer;
  v_reviewed_count integer;
  v_required_count integer;
  v_constraint_name text;
  v_is_service_action boolean;
  v_is_public_manager_action boolean;
  v_is_electronic boolean;
  v_worker_only_approval boolean:=false;
  v_component_kind text;
  v_document_role text;
  v_expense_category text;
  v_requested_media_type text;
  v_requested_byte_size bigint;
  v_manager_capture_method text;
  v_expected_source_digest bytea;
  v_verified_image_width integer;
  v_verified_image_height integer;
  v_review_ordinal integer;
  v_has_expenses boolean:=false;
  v_has_mileage boolean:=false;
  v_expense_value numeric:=0;
  v_required_categories text[]:=array[]::text[];
  v_required_category text;
  v_paper_manifest jsonb;
  v_paper_source_pages jsonb;
  v_paper_mileage_only boolean:=false;
  v_paper_page_key text;
  v_paper_timesheet_id uuid;
  v_paper_pack_result jsonb;
  v_paper_retirement_result jsonb;
  v_paper_mail public.mail_outbox%rowtype;
  v_paper_mail_id uuid;
  v_paper_manifest_sha256 text;
  v_paper_pack_storage_key text;
  v_paper_pack_sha256 text;
  v_paper_pack_media_type text;
  v_paper_pack_byte_size bigint;
  v_paper_pack_page_count integer;
  v_paper_pack_attachment jsonb;
  v_paper_notification_id uuid;
  v_paper_release_idempotent boolean:=false;
  v_paper_expense_update_active boolean:=false;
  v_paper_outbox_count integer:=0;
  v_paper_base_document_sha256 text;
  v_paper_branding_contract_sha256 text;
  v_paper_renderer_contract_version text;
  v_paper_expected_storage_key text;
  v_provider_lease_token text;
  v_provider_permit_expires_at timestamptz;
  v_manager_mail public.mail_outbox%rowtype;
  v_manager_route_receipt public.candidate_manager_email_route_receipts%rowtype;
  v_manager_mail_kind text;
  v_manager_provider_accepted_at timestamptz;
  v_manager_pending_mail_count integer:=0;
  v_manager_request_ids uuid[]:=array[]::uuid[];
  v_manager_withdrawal_request_id uuid;
  v_manager_withdrawal_count integer:=0;
  v_manager_retirement_result jsonb;
  v_submission_withdrawal_reset jsonb;
  v_cancel_reason text;
  v_cancel_reason_code text;
  v_audit_reason text;
  v_unlocked_workflow_updated_at timestamptz;
  v_paper_family_key text;
  v_source_component public.candidate_submission_components%rowtype;
  v_all_final_ready boolean:=false;
  v_server_issue_codes jsonb:='[]'::jsonb;
  v_duplicate_expense_review jsonb:='{}'::jsonb;
  v_duplicate_expense_category text;
  v_request_id uuid;
  v_workflow_kind text;
  v_scope text;
  v_route text;
  v_canonical_work_date date;
  v_canonical_week_ending_date date;
  v_client_id uuid;
  v_anchor_candidate_count integer:=0;
  v_anchor_week_id uuid;
  v_anchor_submitted_work boolean:=false;
  v_target_capabilities jsonb;
  v_route_authority jsonb;
  v_weekly_source_candidate_request_allowed boolean:=false;
  v_daily_input jsonb;
  v_daily_patch jsonb;
  v_expected_save_hash bytea;
  v_daily_context jsonb;
  v_daily_context_hash bytea;
  v_current_row_signature text;
  v_insert_workflow_id uuid;
  v_replacement_of_workflow_id uuid;
  v_is_rejected_resubmission boolean:=false;
  v_creation_request_identity jsonb;
  v_creation_identity jsonb;
  v_creation_request_sha256 bytea;
  v_initial_route text;
  v_source_anchor public.timesheets%rowtype;
  v_daily_booking_id text;
  v_paper_failure_code text;
  v_paper_failure_class text;
  v_paper_failure_retryable boolean:=false;
  v_paper_pack_attempt_token text;
  v_paper_pack_attempt_count integer:=0;
  v_paper_pack_attempt_expires_at timestamptz;
  v_paper_pack_next_retry_at timestamptz;
  v_paper_pack_operation_id text;
  v_office_actor_user_id uuid;
  v_is_office_service_action boolean:=false;
  v_is_internal_paper_service_action boolean:=false;
  v_mutation_channel text;
  v_mutation_actor_identity text;
  v_mutation_semantic_payload jsonb;
  v_mutation_request_sha256 text;
  v_mutation_receipt jsonb;
  v_mutation_replay_probe_only boolean:=false;
  v_expense_update_context jsonb;
  v_pending_expense_update public.candidate_pending_expense_updates%rowtype;
  v_is_pending_expense_update boolean:=false;
  v_replaced_manager_signature_ids uuid[]:=array[]::uuid[];
  v_checklist_cycle_admission jsonb;
begin
  v_environment:=private._candidate_assert_environment(p_environment);
  if p_workflow_id is null or jsonb_typeof(v_payload)<>'object' then
    raise exception 'CANDIDATE_WORKFLOW_PAYLOAD_INVALID' using errcode='22023';
  end if;
  if v_payload ?| array['password','refresh_token','token'] then
    raise exception 'CANDIDATE_WORKFLOW_PLAINTEXT_SECRET_FORBIDDEN' using errcode='22023';
  end if;

  if v_action='SELECT_APPROVAL_METHOD' then
    v_method:=upper(coalesce(v_payload->>'method',''));
    v_action:=case v_method
      when 'PHONE' then 'SELECT_PHONE_APPROVAL'
      when 'EMAIL' then 'CREATE_EMAIL_APPROVAL_REQUEST'
      when 'PAPER' then 'PAPER_PREPARE'
      else v_action end;
  elsif v_action='EMAIL_REQUEST' then
    v_action:='CREATE_EMAIL_APPROVAL_REQUEST';
  elsif v_action='MANAGER_REVIEW' then
    v_action:='BEGIN_MANAGER_REVIEW';
  elsif v_action='REGISTER_MANAGER_REVIEW_DOCUMENT' then
    v_action:='REGISTER_REVIEW_COMPONENT';
  end if;
  v_mutation_replay_probe_only:=p_session_id is not null
    and coalesce((v_payload->>'mutation_replay_probe_only')::boolean,false);
  if v_mutation_replay_probe_only
     and jsonb_typeof(v_payload->'mutation_replay_semantic_payload') is distinct from 'object' then
    raise exception 'CANDIDATE_IDEMPOTENCY_RECEIPT_INVALID' using errcode='22023';
  end if;

  if coalesce(v_payload->>'actor_user_id','')
       ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$' then
    v_office_actor_user_id:=(v_payload->>'actor_user_id')::uuid;
  end if;
  v_is_office_service_action:=p_session_id is null
    and coalesce((v_payload->>'service_office_action')::boolean,false)
    and private._candidate_office_service_context_valid_v1(
      v_environment,v_office_actor_user_id,v_action
    );
  v_is_internal_paper_service_action:=p_session_id is null and (
    (v_action='PAPER_PACK_RELEASE'
      and coalesce((v_payload->>'service_paper_pack_release')::boolean,false))
    or (v_action='PAPER_PROVIDER_SUBMIT_PERMIT'
      and coalesce((v_payload->>'service_paper_provider_submit_permit')::boolean,false))
    or (v_action='PAPER_PACK_MARK_FAILURE'
      and coalesce((v_payload->>'service_paper_pack_failure')::boolean,false))
    or (v_action='PAPER_PACK_ATTEMPT_CLAIM'
      and coalesce((v_payload->>'service_paper_pack_attempt')::boolean,false))
  );
  if not v_is_office_service_action and not v_is_internal_paper_service_action then
    perform private._candidate_require_feature_v1(v_environment,'candidate_app_writes');
  end if;

  if v_action in (
    'SELECT_PHONE_APPROVAL','CREATE_EMAIL_APPROVAL_REQUEST','BEGIN_MANAGER_REVIEW',
    'RECORD_REVIEW_PROGRESS','PHONE_APPROVE','EMAIL_APPROVE','MANAGER_REFUSE',
    'REMIND','RENEW','MANAGER_REQUEST_CANCEL','CANCEL_MANAGER_HANDOFF',
    'REGISTER_REVIEW_COMPONENT','REGISTER_FINAL_SIGNED_DOCUMENT',
    'MANAGER_PROVIDER_SUBMIT_PERMIT'
  ) or (p_session_id is null and v_action in ('COMPONENT_PREPARE','COMPONENT_COMPLETE')) then
    if not v_is_office_service_action and not v_is_internal_paper_service_action then
    perform private._candidate_require_feature_v1(v_environment,'candidate_manager_approval');
    end if;
  end if;
  if v_action='BEGIN_CANONICAL_DAILY_SAVE' then
    if not v_is_office_service_action then
    perform private._candidate_require_feature_v1(v_environment,'candidate_daily_finalisation');
    end if;
  end if;
  if v_action in (
    'PAPER_PREPARE','PAPER_RETURN','PAPER_PACK_RELEASE',
    'PAPER_PROVIDER_SUBMIT_PERMIT','PAPER_PACK_MARK_FAILURE','PAPER_PACK_ATTEMPT_CLAIM'
  ) then
    if not v_is_office_service_action and not v_is_internal_paper_service_action then
    perform private._candidate_require_feature_v1(v_environment,'candidate_paper_qr');
    end if;
  end if;
  if v_action='MARK_READ' then
    perform private._candidate_require_feature_v1(v_environment,'candidate_notifications');
  end if;

  v_is_service_action:=v_action in (
    'REGISTER_REVIEW_COMPONENT','REGISTER_FINAL_SIGNED_DOCUMENT',
    'BEGIN_CANONICAL_DAILY_SAVE'
  ) or (p_session_id is null
    and v_action='PAPER_PACK_RELEASE'
    and coalesce((v_payload->>'service_paper_pack_release')::boolean,false)
  ) or (p_session_id is null
    and v_action='PAPER_PROVIDER_SUBMIT_PERMIT'
    and coalesce((v_payload->>'service_paper_provider_submit_permit')::boolean,false)
  ) or (p_session_id is null
    and v_action='PAPER_PACK_MARK_FAILURE'
    and coalesce((v_payload->>'service_paper_pack_failure')::boolean,false)
  ) or (p_session_id is null
    and v_action='PAPER_PACK_ATTEMPT_CLAIM'
    and coalesce((v_payload->>'service_paper_pack_attempt')::boolean,false)
  ) or (p_session_id is null
    and v_action='MANAGER_PROVIDER_SUBMIT_PERMIT'
    and coalesce((v_payload->>'service_manager_provider_submit_permit')::boolean,false)
  ) or (p_session_id is null
    and coalesce((v_payload->>'service_phone_approval')::boolean,false)
    and v_action in ('BEGIN_MANAGER_REVIEW','RECORD_REVIEW_PROGRESS','PHONE_APPROVE','MANAGER_REFUSE',
      'COMPONENT_PREPARE','COMPONENT_COMPLETE'))
  or (v_is_office_service_action
    and v_action in ('CANCEL','REMIND','RENEW','MANAGER_REQUEST_CANCEL','CANCEL_MANAGER_HANDOFF',
      'BEGIN_MANAGER_REVIEW','RECORD_REVIEW_PROGRESS','PHONE_APPROVE','MANAGER_REFUSE',
      'REGISTER_REVIEW_COMPONENT','REGISTER_FINAL_SIGNED_DOCUMENT',
      'BEGIN_CANONICAL_DAILY_SAVE','PAPER_PACK_RELEASE','PAPER_PACK_ATTEMPT_CLAIM',
      'PAPER_PACK_MARK_FAILURE','WORKER_SUBMIT'));
  v_is_public_manager_action:=not v_is_service_action and p_session_id is null and v_action in (
    'BEGIN_MANAGER_REVIEW','RECORD_REVIEW_PROGRESS','PHONE_APPROVE','EMAIL_APPROVE','MANAGER_REFUSE',
    'COMPONENT_PREPARE','COMPONENT_COMPLETE'
  );

  -- Checklist lifecycle admission precedes all workflow/TS/TF business locks.
  -- Plain native session authentication does not replace the locked recheck.
  if v_action='WORKER_SUBMIT' and (p_session_id is not null or v_is_office_service_action) then
    if p_session_id is not null then
      v_context:=private._candidate_session_context_v1(p_session_id,v_environment,null,p_now_utc,false);
      v_candidate_id:=nullif(v_context->>'selected_candidate_id','')::uuid;
      if v_candidate_id is null then raise exception 'CANDIDATE_SELECTION_REQUIRED' using errcode='28000'; end if;
    else
      select candidate_id into v_candidate_id from public.candidate_submission_workflows
        where id=p_workflow_id and environment=v_environment;
    end if;
    v_checklist_cycle_admission:=private.weekly_source_checklist_submission_cycle_admit_v1(
      p_workflow_id,v_environment,v_candidate_id);
  end if;

  if v_is_service_action then
    if v_action='PAPER_PACK_RELEASE' then
      select * into v_workflow
      from public.candidate_submission_workflows
      where id=p_workflow_id and environment=v_environment;
      if not found then raise exception 'CANDIDATE_WORKFLOW_NOT_FOUND' using errcode='P0002'; end if;
      v_paper_timesheet_id:=coalesce(v_workflow.target_timesheet_id,v_workflow.anchor_timesheet_id);
      if v_paper_timesheet_id is null then
        raise exception 'CANDIDATE_PAPER_TIMESHEET_NOT_READY' using errcode='55000';
      end if;
      perform 1 from public.timesheets
      where timesheet_id=v_paper_timesheet_id and is_current=true and archived_at_utc is null
      for update;
      if not found then raise exception 'CANDIDATE_PAPER_TIMESHEET_NOT_READY' using errcode='55000'; end if;
      select * into v_workflow
      from public.candidate_submission_workflows
      where id=p_workflow_id and environment=v_environment
      for update;
      if not found
         or coalesce(v_workflow.target_timesheet_id,v_workflow.anchor_timesheet_id)
              is distinct from v_paper_timesheet_id then
        raise exception 'CANDIDATE_WORKFLOW_CONTEXT_CONFLICT' using errcode='40001';
      end if;
    else
      select * into v_workflow
      from public.candidate_submission_workflows
      where id=p_workflow_id and environment=v_environment
      for update;
    end if;
    if not found then raise exception 'CANDIDATE_WORKFLOW_NOT_FOUND' using errcode='P0002'; end if;
    if v_is_office_service_action
       and v_action in ('REMIND','RENEW','MANAGER_REQUEST_CANCEL','CANCEL_MANAGER_HANDOFF',
         'BEGIN_MANAGER_REVIEW','RECORD_REVIEW_PROGRESS','PHONE_APPROVE','MANAGER_REFUSE') then
      if coalesce(v_payload->>'approval_request_id','')
           !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
         or coalesce(v_payload->>'approval_request_generation','') !~ '^[1-9][0-9]{0,8}$' then
        raise exception 'CANDIDATE_REQUEST_GENERATION_STALE' using errcode='40001';
      end if;
      perform 1
      from public.candidate_approval_requests office_request
      where office_request.id=(v_payload->>'approval_request_id')::uuid
        and office_request.workflow_id=v_workflow.id
        and office_request.workflow_generation=v_workflow.generation
        and office_request.request_generation=(v_payload->>'approval_request_generation')::integer;
      if not found then
        raise exception 'CANDIDATE_REQUEST_GENERATION_STALE' using errcode='40001';
      end if;
    end if;
    v_account_id:=v_workflow.account_id;
    v_candidate_id:=v_workflow.candidate_id;
  elsif v_is_public_manager_action then
    if coalesce(v_payload->>'approval_token_hash_hex','') !~ '^[0-9a-fA-F]{64}$' then
      raise exception 'MANAGER_APPROVAL_REQUEST_NOT_READY' using errcode='28000';
    end if;
    v_token_hash:=decode(v_payload->>'approval_token_hash_hex','hex');
    select a.id,a.workflow_id into v_request_id,v_workflow.id
    from public.candidate_approval_requests a
    where a.token_hash=v_token_hash and a.workflow_id=p_workflow_id;
    if not found then raise exception 'MANAGER_APPROVAL_REQUEST_NOT_READY' using errcode='28000'; end if;
    select * into v_workflow
    from public.candidate_submission_workflows
    where id=p_workflow_id and environment=v_environment
    for update;
    if not found then raise exception 'MANAGER_APPROVAL_REQUEST_NOT_READY' using errcode='28000'; end if;
    select * into v_approval
    from public.candidate_approval_requests
    where id=v_request_id
      and workflow_id=v_workflow.id
      and workflow_generation=v_workflow.generation
      and method in ('EMAIL','PHONE')
      and state='PENDING'
      and expires_at_utc>p_now_utc
      and review_manifest_sha256=v_workflow.review_manifest_sha256
    for update;
    if not found then raise exception 'MANAGER_APPROVAL_REQUEST_NOT_READY' using errcode='28000'; end if;
    v_account_id:=v_workflow.account_id;
    v_candidate_id:=v_workflow.candidate_id;
  else
    v_context:=private._candidate_session_context_v1(p_session_id,v_environment,null,p_now_utc,true);
    v_account_id:=nullif(v_context->>'account_id','')::uuid;
    v_candidate_id:=nullif(v_context->>'selected_candidate_id','')::uuid;
    if v_candidate_id is null then raise exception 'CANDIDATE_SELECTION_REQUIRED' using errcode='28000'; end if;
  end if;

  if v_action='RESUBMIT_REJECTED' then
    if nullif(btrim(coalesce(p_idempotency_key,'')),'') is null
       or btrim(p_idempotency_key) !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$' then
      raise exception 'CANDIDATE_IDEMPOTENCY_KEY_REQUIRED' using errcode='22023';
    end if;
    if p_expected_generation is null or p_expected_generation<1 then
      raise exception 'WORKFLOW_GENERATION_CONFLICT' using errcode='55000';
    end if;

    v_creation_request_identity:=jsonb_build_object(
      'version','CANDIDATE_WORKFLOW_CREATION_REQUEST_V1',
      'action','RESUBMIT_REJECTED',
      'environment',v_environment,
      'account_id',v_account_id,
      'candidate_id',v_candidate_id,
      'rejected_workflow_id',p_workflow_id,
      'rejected_workflow_generation',p_expected_generation
    );
    v_creation_request_sha256:=private._candidate_workflow_creation_request_sha256_v1(
      v_creation_request_identity
    );

    -- One account/key lock serialises exact retries. The source lock then
    -- serialises every key that attempts to replace the same rejected row.
    perform pg_advisory_xact_lock(hashtextextended(
      'candidate-workflow-idempotency|'||v_account_id::text||'|'||btrim(p_idempotency_key),0
    ));
    perform pg_advisory_xact_lock(hashtextextended(
      'candidate-rejected-source|'||p_workflow_id::text,0
    ));

    select * into v_source_workflow
    from public.candidate_submission_workflows
    where id=p_workflow_id
      and environment=v_environment
      and account_id=v_account_id
      and candidate_id=v_candidate_id
    for update;
    if not found then
      raise exception 'CANDIDATE_WORKFLOW_NOT_FOUND' using errcode='P0002';
    end if;
    if v_source_workflow.generation<>p_expected_generation then
      raise exception 'WORKFLOW_GENERATION_CONFLICT' using errcode='55000';
    end if;
    if v_source_workflow.state not in ('REJECTED','REFUSED') then
      raise exception 'CANDIDATE_REJECTED_WORKFLOW_NOT_RESUBMITTABLE' using errcode='55000';
    end if;

    select * into v_existing_workflow
    from public.candidate_submission_workflows
    where account_id=v_account_id
      and idempotency_key=btrim(p_idempotency_key)
    for update;
    if found then
      if v_existing_workflow.replacement_of_workflow_id is distinct from v_source_workflow.id
         or v_existing_workflow.candidate_id is distinct from v_source_workflow.candidate_id
         or v_existing_workflow.creation_request_sha256 is distinct from v_creation_request_sha256 then
        raise exception 'CANDIDATE_IDEMPOTENCY_CONFLICT' using errcode='55000';
      end if;
      return jsonb_build_object(
        'ok',true,'idempotent_replay',true,
        'rejected_workflow_id',v_source_workflow.id,
        'replacement_workflow_id',v_existing_workflow.id,
        'replacement_created',false,
        'workflow_id',v_existing_workflow.id,
        'state',v_existing_workflow.state,
        'generation',v_existing_workflow.generation
      );
    end if;

    select * into v_existing_workflow
    from public.candidate_submission_workflows
    where replacement_of_workflow_id=v_source_workflow.id
    for update;
    if found or private._candidate_rejection_replaced_v1(v_source_workflow.id) then
      raise exception 'CANDIDATE_REJECTED_WORKFLOW_ALREADY_REPLACED'
        using errcode='55000',detail=case when v_existing_workflow.id is null then null
          else jsonb_build_object('replacement_workflow_id',v_existing_workflow.id)::text end;
    end if;

    v_is_rejected_resubmission:=true;
    v_replacement_of_workflow_id:=v_source_workflow.id;
    v_insert_workflow_id:=gen_random_uuid();
    if v_source_workflow.workflow_kind='DAILY' then
      v_daily_booking_id:=nullif(btrim(coalesce(
        v_source_workflow.creation_identity_json#>>'{derived,daily_booking_id}',
        ''
      )), '');
      if v_daily_booking_id is null then
        select nullif(btrim(coalesce(source_timesheet.booking_id,'')),'')
        into v_daily_booking_id
        from public.timesheets source_timesheet
        where source_timesheet.timesheet_id=coalesce(
          v_source_workflow.target_timesheet_id,v_source_workflow.anchor_timesheet_id
        );
      end if;
      select current_timesheet.* into v_daily_timesheet
      from public.timesheets current_timesheet
      where current_timesheet.booking_id=v_daily_booking_id
        and current_timesheet.is_current=true
        and current_timesheet.archived_at_utc is null
        and current_timesheet.sheet_scope='DAILY'::public.timesheet_scope_enum;
      if not found then
        raise exception 'CANDIDATE_DAILY_SHIFT_NOT_FOUND' using errcode='P0002';
      end if;
      v_workflow_kind:='DAILY';
      v_scope:='DAILY';
      v_initial_route:=upper(coalesce(
        v_source_workflow.creation_identity_json#>>'{derived,initial_route}',
        v_source_workflow.route
      ));
      if v_initial_route not in ('EMAIL','PHONE') then
        raise exception 'CANDIDATE_REJECTED_REPLACEMENT_ROUTE_INVALID' using errcode='55000';
      end if;
      v_payload:=jsonb_build_object(
        'workflow_kind',v_workflow_kind,
        'scope',v_scope,
        'route',v_initial_route,
        'target_timesheet_id',v_daily_timesheet.timesheet_id
      );
    else
      v_workflow_kind:=case
        when v_source_workflow.rejection_scope='COMPLETE_EXPENSE_CLAIM'
          or v_source_workflow.workflow_kind='CONTRACT_EXPENSE'
          then 'CONTRACT_EXPENSE'
        when v_source_workflow.workflow_kind='CONTRACT_COMBINED'
          then 'CONTRACT_COMBINED'
        else 'CONTRACT_HOURS'
      end;
      v_scope:='WEEKLY';

      -- Refusal can return the exact Contract Week to an empty editable state:
      -- the refused Timesheet remains revoked history and timesheet_id becomes
      -- null.  The Contract Week is therefore the stable weekly authority.
      -- When it does own a current Timesheet, use only that exact row; never
      -- adopt another same-contract/date carrier.
      select current_week.* into v_week
      from public.contract_weeks current_week
      where current_week.id=v_source_workflow.contract_week_id
        and current_week.contract_id is not distinct from v_source_workflow.contract_id
        and current_week.week_ending_date is not distinct from v_source_workflow.week_ending_date
      for update;
      if not found then
        raise exception 'CANDIDATE_WORKFLOW_WEEK_NOT_FOUND' using errcode='P0002';
      end if;
      if v_week.timesheet_id is not null then
        select current_timesheet.* into v_anchor_timesheet
        from public.timesheets current_timesheet
        where current_timesheet.timesheet_id=v_week.timesheet_id
          and current_timesheet.is_current=true
          and current_timesheet.archived_at_utc is null
          and current_timesheet.sheet_scope='WEEKLY'::public.timesheet_scope_enum
        for update;
        if not found then
          raise exception 'CANDIDATE_WORKFLOW_ANCHOR_MISMATCH' using errcode='55000';
        end if;
      end if;

      v_initial_route:=upper(coalesce(
        v_source_workflow.creation_identity_json#>>'{derived,initial_route}',
        case when v_source_workflow.route='PAPER' then 'PAPER' else 'ELECTRONIC' end
      ));
      v_route_authority:=private._candidate_route_family_v1(
        v_week.timesheet_id,v_week.id
      );
      if v_initial_route='PAPER'
         and (
           v_route_authority->>'route_family'='QR'
           or (
             v_route_authority->>'route_family'='ELECTRONIC'
             and coalesce(
               (v_route_authority->>'candidate_paper_submission_allowed')::boolean,
               false
             )
           )
         ) then
        v_initial_route:='PAPER';
      else
        v_initial_route:='ELECTRONIC';
      end if;
      v_payload:=jsonb_build_object(
        'workflow_kind',v_workflow_kind,
        'scope',v_scope,
        'route',v_initial_route,
        'contract_id',v_source_workflow.contract_id,
        'contract_week_id',v_week.id,
        'week_ending_date',v_week.week_ending_date,
        'anchor_timesheet_id',case when v_workflow_kind='CONTRACT_EXPENSE'
          then v_source_workflow.anchor_timesheet_id else v_week.timesheet_id end
      );
    end if;
    v_action:='CREATE';
  end if;

  if v_action='CREATE' then
    if nullif(btrim(coalesce(p_idempotency_key,'')),'') is null then
      raise exception 'CANDIDATE_IDEMPOTENCY_KEY_REQUIRED' using errcode='22023';
    end if;
    if not v_is_rejected_resubmission then
      perform pg_advisory_xact_lock(hashtextextended(
        'candidate-workflow-idempotency|'||v_account_id::text||'|'||btrim(p_idempotency_key),0
      ));
      v_insert_workflow_id:=p_workflow_id;
    end if;
    v_workflow_kind:=upper(coalesce(v_payload->>'workflow_kind',''));
    v_scope:=upper(coalesce(v_payload->>'scope',''));
    v_route:=upper(coalesce(v_payload->>'route',''));
    if v_workflow_kind not in ('CONTRACT_HOURS','CONTRACT_EXPENSE','CONTRACT_COMBINED','DAILY')
       or v_scope not in ('WEEKLY','DAILY')
       or v_route not in ('ELECTRONIC','PHONE','EMAIL','PAPER') then
      raise exception 'CANDIDATE_WORKFLOW_TYPE_INVALID' using errcode='22023';
    end if;
    v_daily_first_source:=v_workflow_kind='DAILY' and v_payload ? 'daily_source';
    if v_daily_first_source and (
      v_scope<>'DAILY' or v_route<>'PHONE'
      or jsonb_typeof(v_payload->'daily_source') is distinct from 'object'
      or v_payload->'submission_requested' is distinct from 'true'::jsonb
      or v_payload ?| array['target_timesheet_id','contract_id','contract_week_id','week_ending_date','anchor_timesheet_id']
    ) then
      raise exception 'CANDIDATE_DAILY_IDENTITY_INVALID' using errcode='22023';
    end if;
    if not v_is_rejected_resubmission then
      if v_workflow_kind='DAILY' and not v_daily_first_source then
        select requested_timesheet.* into v_source_anchor
        from public.timesheets requested_timesheet
        where requested_timesheet.timesheet_id=nullif(v_payload->>'target_timesheet_id','')::uuid;
        if not found then
          raise exception 'CANDIDATE_DAILY_SHIFT_NOT_FOUND' using errcode='P0002';
        end if;
      end if;
      v_creation_request_identity:=jsonb_strip_nulls(jsonb_build_object(
        'version','CANDIDATE_WORKFLOW_CREATION_REQUEST_V1',
        'action','CREATE',
        'environment',v_environment,
        'account_id',v_account_id,
        'candidate_id',v_candidate_id,
        'workflow_kind',v_workflow_kind,
        'scope',v_scope,
        'initial_route',v_route,
        'contract_id',nullif(v_payload->>'contract_id','')::uuid,
        'contract_week_id',nullif(v_payload->>'contract_week_id','')::uuid,
        'week_ending_date',nullif(v_payload->>'week_ending_date','')::date,
        'work_date',nullif(v_payload->>'work_date','')::date,
        'daily_source',case when v_daily_first_source then v_payload->'daily_source' else null end,
        'submission_requested',case when v_daily_first_source then true else null end,
        'daily_booking_id',case when v_workflow_kind='DAILY'
          then coalesce(nullif(btrim(coalesce(v_source_anchor.booking_id,'')),''),
            v_payload#>>'{daily_source,booking_id}') else null end,
        'target_timesheet_id',case when v_workflow_kind='DAILY'
          and nullif(btrim(coalesce(v_source_anchor.booking_id,'')),'') is null
          then v_source_anchor.timesheet_id else null end,
        'requested_anchor_timesheet_id',nullif(v_payload->>'anchor_timesheet_id','')::uuid,
        'input_snapshot',coalesce(v_payload->'input_snapshot','{}'::jsonb),
        'expected_row_signature',nullif(v_payload->>'expected_row_signature','')
      ));
      v_creation_request_sha256:=private._candidate_workflow_creation_request_sha256_v1(
        v_creation_request_identity
      );
      select * into v_existing_workflow
      from public.candidate_submission_workflows
      where account_id=v_account_id
        and idempotency_key=btrim(p_idempotency_key)
      for update;
      if found then
        if v_existing_workflow.candidate_id is distinct from v_candidate_id
           or v_existing_workflow.replacement_of_workflow_id is not null
           or v_existing_workflow.creation_request_sha256 is distinct from v_creation_request_sha256 then
          raise exception 'CANDIDATE_IDEMPOTENCY_CONFLICT' using errcode='40001';
        end if;
        return jsonb_build_object(
          'ok',true,'idempotent_replay',true,
          'workflow_id',v_existing_workflow.id,
          'state',v_existing_workflow.state,
          'generation',v_existing_workflow.generation
        );
      end if;
    end if;
    if v_workflow_kind='DAILY' then
      if v_daily_first_source then
        -- CREATE is invoked by the explicit submit action, not by editing a day.
        -- Its exact request receipt above is replayed before any source recheck.
        v_payload:=v_payload||jsonb_build_object('target_timesheet_id',
          private._candidate_daily_first_receipt_v1(v_environment,v_candidate_id,
            v_payload->'daily_source',v_insert_workflow_id,true,p_now_utc));
      end if;
      if v_scope<>'DAILY' or v_route<>'PHONE'
         or nullif(v_payload->>'target_timesheet_id','') is null
         or nullif(v_payload->>'contract_week_id','') is not null
         or nullif(v_payload->>'week_ending_date','') is not null then
        raise exception 'CANDIDATE_DAILY_IDENTITY_INVALID' using errcode='22023';
      end if;
      select * into v_daily_timesheet
      from public.timesheets
      where timesheet_id=(v_payload->>'target_timesheet_id')::uuid
        and is_current=true
        and archived_at_utc is null
        and sheet_scope='DAILY'::public.timesheet_scope_enum
        and nullif(btrim(coalesce(booking_id,'')),'') is not null
      for update;
      if not found then raise exception 'CANDIDATE_DAILY_SHIFT_NOT_FOUND' using errcode='P0002'; end if;
      v_daily_receipt_context:=private._candidate_daily_receipt_context_v1(
        v_environment,v_candidate_id,v_daily_timesheet.timesheet_id,true,p_now_utc);
      if not private._candidate_daily_entitled_v1(v_candidate_id) then
        raise exception 'CANDIDATE_DAILY_ENTITLEMENT_REQUIRED' using errcode='55000';
      end if;
      select * into v_daily_fin
      from public.timesheets_financials
      where timesheet_id=v_daily_timesheet.timesheet_id
        and is_current=true
        and candidate_id=v_candidate_id
      order by computed_at_utc desc nulls last,updated_at desc,id desc
      limit 1
      for update;
      -- The locked receipt context proves ownership even before Office has
      -- assigned financial context. Absence of TSFIN is not permission to write it.
      if v_daily_fin.authorised_at_utc is not null
         or v_daily_fin.paid_at_utc is not null
         or v_daily_fin.locked_by_invoice_id is not null
         or v_daily_timesheet.archived_at_utc is not null then
        raise exception 'CANDIDATE_RECORD_MUTATION_LOCKED' using errcode='55000';
      end if;
      v_canonical_work_date:=private._candidate_daily_work_date_v1(
        coalesce(v_daily_fin.worked_start_iso,v_daily_timesheet.worked_start_iso),
        v_daily_timesheet.scheduled_start_iso,
        v_daily_timesheet.week_ending_date
      );
      if v_canonical_work_date is null
         or (nullif(v_payload->>'work_date','') is not null
             and (v_payload->>'work_date')::date<>v_canonical_work_date)
         or (nullif(v_payload->>'anchor_timesheet_id','') is not null
             and (v_payload->>'anchor_timesheet_id')::uuid<>v_daily_timesheet.timesheet_id) then
        raise exception 'CANDIDATE_DAILY_SHIFT_IDENTITY_MISMATCH' using errcode='22023';
      end if;
      if v_daily_timesheet.contract_id is not null then
        select * into v_contract
        from public.contracts
        where id=v_daily_timesheet.contract_id and candidate_id=v_candidate_id
        for update;
        if not found then raise exception 'CANDIDATE_DAILY_SHIFT_NOT_FOUND' using errcode='P0002'; end if;
      end if;
      v_client_id:=nullif(v_daily_receipt_context->>'client_id','')::uuid;
      v_policy:=v_daily_receipt_context->'policy';
      if (v_route='PHONE' and not coalesce((v_policy->>'allow_daily_manager_authorise_on_phone')::boolean,false))
         or (v_route='EMAIL' and not coalesce((v_policy->>'allow_daily_manager_authorise_by_email')::boolean,false)) then
        raise exception 'CANDIDATE_DAILY_APPROVAL_ROUTE_NOT_ALLOWED' using errcode='55000';
      end if;
      v_canonical_week_ending_date:=null;
    else
      if v_scope<>'WEEKLY' or v_route not in ('ELECTRONIC','PAPER')
         or nullif(v_payload->>'contract_id','') is null
         or nullif(v_payload->>'contract_week_id','') is null then
        raise exception 'CANDIDATE_CONTRACT_WORKFLOW_IDENTITY_REQUIRED' using errcode='22023';
      end if;
      select * into v_contract
      from public.contracts
      where id=(v_payload->>'contract_id')::uuid and candidate_id=v_candidate_id
      for update;
      if not found then raise exception 'CANDIDATE_WORKFLOW_CONTRACT_NOT_FOUND' using errcode='P0002'; end if;
      select * into v_week
      from public.contract_weeks
      where id=(v_payload->>'contract_week_id')::uuid and contract_id=v_contract.id
      for update;
      if not found then raise exception 'CANDIDATE_WORKFLOW_WEEK_NOT_FOUND' using errcode='P0002'; end if;
      v_canonical_week_ending_date:=v_week.week_ending_date;
      if nullif(v_payload->>'week_ending_date','') is not null
         and (v_payload->>'week_ending_date')::date<>v_canonical_week_ending_date then
        raise exception 'CANDIDATE_WORKFLOW_WEEK_MISMATCH' using errcode='22023';
      end if;
      v_policy:=private._expense_approval_policy_v1(v_contract.client_id,v_contract.id,v_canonical_week_ending_date,v_workflow_kind);
      -- Resolve and validate the worked anchor before route admission.  A
      -- server-created expense carrier deliberately has no worked Timesheet
      -- and uses MANUAL storage, so it cannot define the Candidate's manager
      -- approval route.
      if nullif(v_payload->>'anchor_timesheet_id','') is not null then
        select cw.* into v_anchor_week
        from public.contract_weeks cw
        join public.timesheets t on t.timesheet_id=cw.timesheet_id
          and t.is_current=true and t.archived_at_utc is null
          and t.sheet_scope='WEEKLY'::public.timesheet_scope_enum
        where cw.timesheet_id=(v_payload->>'anchor_timesheet_id')::uuid
          and cw.contract_id=v_contract.id
          and cw.week_ending_date=v_canonical_week_ending_date;
        if not found then raise exception 'CANDIDATE_WORKFLOW_ANCHOR_MISMATCH' using errcode='22023'; end if;
        if v_workflow_kind='CONTRACT_EXPENSE'
           and coalesce((private._candidate_record_capabilities_v1(v_anchor_week.timesheet_id,v_anchor_week.id,'{}'::jsonb)->>'hours_value')::numeric,0)<=0
           and coalesce((private._candidate_record_capabilities_v1(v_anchor_week.timesheet_id,v_anchor_week.id,'{}'::jsonb)->>'additional_units_value')::numeric,0)<=0 then
          -- Import-authoritative hours remain outside TSFIN until source
          -- finalisation.  The immutable Candidate hours submission for this
          -- exact anchor is positive worked-week evidence, while the expense
          -- itself still opens as a separate manager-approved workflow.
          select exists(
            select 1
            from public.candidate_submission_workflows submitted_workflow
            cross join lateral (
              select
                coalesce(
                  submitted_workflow.input_snapshot_json#>'{hours_submission,timesheet_patch_json,actual_schedule_json}',
                  submitted_workflow.input_snapshot_json#>'{timesheet_patch_json,actual_schedule_json}',
                  submitted_workflow.input_snapshot_json->'actual_schedule_json',
                  '[]'::jsonb
                ) as actual_schedule_json,
                coalesce(
                  submitted_workflow.input_snapshot_json#>'{hours_submission,timesheet_patch_json,additional_units_week}',
                  submitted_workflow.input_snapshot_json#>'{timesheet_patch_json,additional_units_week}',
                  submitted_workflow.input_snapshot_json->'additional_units_week',
                  '{}'::jsonb
                ) as additional_units_week,
                coalesce(
                  submitted_workflow.input_snapshot_json#>'{hours_submission,timesheet_patch_json,additional_units_per_day}',
                  submitted_workflow.input_snapshot_json#>'{timesheet_patch_json,additional_units_per_day}',
                  submitted_workflow.input_snapshot_json->'additional_units_per_day',
                  '{}'::jsonb
                ) as additional_units_per_day
            ) submitted
            where submitted_workflow.environment=v_environment
              and submitted_workflow.candidate_id=v_candidate_id
              and submitted_workflow.contract_id=v_contract.id
              and submitted_workflow.contract_week_id=v_anchor_week.id
              and submitted_workflow.week_ending_date=v_canonical_week_ending_date
              and submitted_workflow.anchor_timesheet_id=v_anchor_week.timesheet_id
              and submitted_workflow.workflow_kind in ('CONTRACT_HOURS','CONTRACT_COMBINED')
              and submitted_workflow.state in (
                'WORKER_SUBMITTED','WORKER_SUBMITTED_PENDING_REVIEW_DOCUMENT',
                'READY_FOR_MANAGER_APPROVAL','AWAITING_MANAGER_APPROVAL',
                'MANAGER_APPROVED','MANAGER_APPROVED_PENDING_FINAL_DOCUMENT',
                'READY_TO_FINALISE','RECEIVED','FINALISED'
              )
              and (
                (pg_catalog.jsonb_typeof(submitted.actual_schedule_json)='array'
                  and pg_catalog.jsonb_array_length(submitted.actual_schedule_json)>0)
                or private._candidate_json_numeric_sum(submitted.additional_units_week)>0
                or private._candidate_json_numeric_sum(submitted.additional_units_per_day)>0
              )
          ) into v_anchor_submitted_work;
          if not v_anchor_submitted_work then
            raise exception 'CANDIDATE_WORKFLOW_ANCHOR_NOT_WORKED' using errcode='22023';
          end if;
        end if;
      elsif v_workflow_kind='CONTRACT_EXPENSE' then
        -- A terminal workflow does not invalidate its immutable anchor receipt.
        -- Reuse one exact historical anchor for this carrier; contradictory
        -- history remains blocked. Only a carrier with no history uses the
        -- original same-week single-worked-row fallback.
        select count(distinct prior.anchor_timesheet_id)::integer,
          case when count(distinct prior.anchor_timesheet_id)=1
            then min(prior.anchor_timesheet_id::text)::uuid else null::uuid end
        into v_anchor_candidate_count,v_anchor_week_id
        from public.candidate_submission_workflows prior
        where prior.environment=v_environment
          and prior.candidate_id=v_candidate_id
          and prior.contract_id=v_contract.id
          and prior.contract_week_id=v_week.id
          and prior.week_ending_date=v_canonical_week_ending_date
          and prior.workflow_kind in ('CONTRACT_EXPENSE','CONTRACT_COMBINED')
          and prior.anchor_timesheet_id is not null;

        if v_anchor_candidate_count>1 then
          raise exception 'EXPENSE_WORKED_ANCHOR_HISTORY_AMBIGUOUS' using errcode='55000';
        elsif v_anchor_candidate_count=1 then
          select cw.* into v_anchor_week
          from public.contract_weeks cw
          join public.timesheets t on t.timesheet_id=cw.timesheet_id
            and t.is_current=true and t.archived_at_utc is null
            and t.sheet_scope='WEEKLY'::public.timesheet_scope_enum
          where cw.timesheet_id=v_anchor_week_id
            and cw.contract_id=v_contract.id
            and cw.week_ending_date=v_canonical_week_ending_date;
          if not found then
            raise exception 'CANDIDATE_WORKFLOW_ANCHOR_MISMATCH' using errcode='22023';
          end if;
          if coalesce((private._candidate_record_capabilities_v1(
               v_anchor_week.timesheet_id,v_anchor_week.id,'{}'::jsonb
             )->>'hours_value')::numeric,0)<=0
             and coalesce((private._candidate_record_capabilities_v1(
               v_anchor_week.timesheet_id,v_anchor_week.id,'{}'::jsonb
             )->>'additional_units_value')::numeric,0)<=0 then
            raise exception 'CANDIDATE_WORKFLOW_ANCHOR_NOT_WORKED' using errcode='22023';
          end if;
        else
          select count(*)::integer,min(worked.id::text)::uuid
          into v_anchor_candidate_count,v_anchor_week_id
          from public.contract_weeks worked
          join public.timesheets t on t.timesheet_id=worked.timesheet_id
            and t.is_current=true and t.archived_at_utc is null
            and t.sheet_scope='WEEKLY'::public.timesheet_scope_enum
          join public.timesheets_financials tf on tf.timesheet_id=t.timesheet_id and tf.is_current=true
          where worked.contract_id=v_contract.id
            and worked.week_ending_date=v_canonical_week_ending_date
            and (
              coalesce(tf.total_hours,0)>0
              or private._candidate_json_numeric_sum(coalesce(tf.additional_units_json,'{}'::jsonb))>0
              or private._candidate_json_numeric_sum(coalesce(t.additional_units_week,'{}'::jsonb))
                +private._candidate_json_numeric_sum(coalesce(t.additional_units_per_day,'{}'::jsonb))>0
            );
          if v_anchor_candidate_count=0 then raise exception 'NO_POSITIVE_WORKED_TIME' using errcode='55000'; end if;
          if v_anchor_candidate_count>1 then raise exception 'EXPENSE_WORKED_ANCHOR_AMBIGUOUS' using errcode='55000'; end if;
          select * into v_anchor_week from public.contract_weeks where id=v_anchor_week_id;
        end if;
      elsif v_week.timesheet_id is not null then
        v_anchor_week:=v_week;
      end if;
      v_route_authority:=private._expense_approval_route_v1(
        case when v_workflow_kind='CONTRACT_EXPENSE' then v_anchor_week.timesheet_id else v_week.timesheet_id end,
        case when v_workflow_kind='CONTRACT_EXPENSE' then v_anchor_week.id else v_week.id end,v_workflow_kind
      );
      -- Source-authority hours use either an exact live Office request or the
      -- candidate-initiated CHECK_ONLY week route.  This only admits a draft;
      -- the dedicated signed submit RPC rechecks all source and week guards.
      if v_route_authority->>'route_family'='IMPORT_AUTHORITATIVE'
         and v_workflow_kind='CONTRACT_HOURS'
         and v_route='ELECTRONIC' then
        select exists(
          select 1
          from public.weekly_timesheet_submission_requests submission
          join public.weekly_candidate_outreach_generations generation
            on generation.candidate_cohort_id=submission.candidate_cohort_id
           and generation.source_cycle_id=submission.source_cycle_id
           and generation.candidate_id=submission.candidate_id
           and generation.generation_number=submission.request_generation
           and generation.request_kind='SUBMIT_TIMESHEET'
          join public.weekly_timesheet_submission_request_memberships membership
            on membership.submission_request_id=submission.id
          where v_week.timesheet_id is null
            and submission.candidate_id=v_candidate_id
            and submission.state in ('ACTIVE','PARTLY_SUBMITTED')
            and generation.state='ACTIVE'
            and generation.deadline_at_utc>=p_now_utc
            and membership.state='WAITING'
            and membership.contract_id=v_contract.id
            and membership.week_ending=v_canonical_week_ending_date
        ) or exists(
          select 1
          from public.weekly_candidate_outreach_generations generation
          join public.weekly_candidate_outreach_memberships membership
            on membership.candidate_generation_id=generation.id
          join public.weekly_discrepancy_incidents incident
            on incident.id=membership.incident_id
          join public.weekly_issue_comparison_revisions comparison
            on comparison.id=incident.current_comparison_revision_id
          where v_week.timesheet_id is not null
            and generation.candidate_id=v_candidate_id
            and generation.request_kind='CHECK_HOURS'
            and generation.state='ACTIVE'
            and generation.deadline_at_utc>=p_now_utc
            and membership.state='ACTIONABLE'
            and comparison.candidate_timesheet_id=v_week.timesheet_id
            and comparison.contract_id=v_contract.id
        ) into v_weekly_source_candidate_request_allowed;
        if not v_weekly_source_candidate_request_allowed then
          v_weekly_source_candidate_request_allowed:=
            v_canonical_week_ending_date-6 <= (p_now_utc at time zone 'Europe/London')::date
            and v_week.additional_seq=0 and not v_week.is_adjustment
            and v_week.status not in (
              'AUTHORISED'::public.contract_week_status_enum,
              'INVOICED'::public.contract_week_status_enum,
              'CANCELLED'::public.contract_week_status_enum
            )
            and (private._weekly_source_effective_policy_v1(
              v_contract.client_id,v_contract.id,v_canonical_week_ending_date
            )->>'authority_mode')='SOURCE_AUTHORITY'
            and (private._weekly_source_effective_policy_v1(
              v_contract.client_id,v_contract.id,v_canonical_week_ending_date
            )->>'document_mode')='CHECK_ONLY';
        end if;
      end if;
      -- A later separate expense starts on the neutral ELECTRONIC draft route.
      -- Its approval-method step may then select PHONE, EMAIL or PAPER even
      -- when the completed worked Timesheet used the QR/PAPER family.
      if v_route_authority->>'route_family'='MANUAL_NON_QR'
         or (v_route_authority->>'route_family'='IMPORT_AUTHORITATIVE'
           and v_workflow_kind<>'CONTRACT_EXPENSE'
           and not v_weekly_source_candidate_request_allowed) then
        raise exception 'CANDIDATE_RECORD_VIEW_ONLY' using errcode='55000',detail=v_route_authority::text;
      end if;
      if (v_route_authority->>'route_family'='QR' and v_route<>'PAPER'
            and v_workflow_kind<>'CONTRACT_EXPENSE')
         or (v_route_authority->>'route_family'='ELECTRONIC' and v_route='PAPER'
           and not coalesce((v_route_authority->>'candidate_paper_submission_allowed')::boolean,false))
         or (v_route_authority->>'route_family'='IMPORT_AUTHORITATIVE' and v_route='PAPER'
           and (v_workflow_kind<>'CONTRACT_EXPENSE'
             or not coalesce((v_route_authority->>'candidate_paper_submission_allowed')::boolean,false))) then
        raise exception 'CANDIDATE_ROUTE_FAMILY_MISMATCH' using errcode='55000',detail=v_route_authority::text;
      end if;
      if v_week.timesheet_id is not null then
        select * into v_anchor_timesheet
        from public.timesheets
        where timesheet_id=v_week.timesheet_id
          and is_current=true
          and archived_at_utc is null;
        if not found then raise exception 'CANDIDATE_WORKFLOW_TARGET_NOT_CURRENT' using errcode='55000'; end if;
        if v_anchor_timesheet.sheet_scope is distinct from 'WEEKLY'::public.timesheet_scope_enum then
          raise exception 'CANDIDATE_WORKFLOW_ANCHOR_MISMATCH' using errcode='22023';
        end if;
        if v_workflow_kind in ('CONTRACT_HOURS','CONTRACT_COMBINED') then
          v_target_capabilities:=private._candidate_record_capabilities_v1(
            v_week.timesheet_id,v_week.id,'{}'::jsonb
          );
          if coalesce((v_target_capabilities->>'candidate_mutation_locked')::boolean,false)
             or coalesce((v_target_capabilities->>'protected')::boolean,false)
             or (
               not coalesce((v_target_capabilities->>'can_edit_hours')::boolean,false)
               and not v_weekly_source_candidate_request_allowed
             ) then
            raise exception 'CANDIDATE_RECORD_MUTATION_LOCKED' using errcode='55000';
          end if;
        end if;
      end if;
      if nullif(v_payload->>'target_timesheet_id','') is not null then
        if v_workflow_kind='CONTRACT_EXPENSE' then
          raise exception 'CANDIDATE_EXPENSE_TARGET_SERVER_RESOLVED' using errcode='22023';
        end if;
        if v_week.timesheet_id is null
           or (v_payload->>'target_timesheet_id')::uuid<>v_week.timesheet_id then
          raise exception 'CANDIDATE_WORKFLOW_TARGET_MISMATCH' using errcode='22023';
        end if;
      end if;
    end if;

    -- Store the immutable request receipt together with the canonical identity
    -- that the server derived at creation time. Later workflow lifecycle changes
    -- may alter route, target, contract-week and generation fields, but must never
    -- alter this receipt or make an exact creation retry conflict.
    v_creation_identity:=jsonb_build_object(
      'version','CANDIDATE_WORKFLOW_CREATION_IDENTITY_V1',
      'request',v_creation_request_identity,
      'derived',jsonb_strip_nulls(jsonb_build_object(
        'workflow_kind',v_workflow_kind,
        'scope',v_scope,
        'initial_route',v_route,
        'contract_id',v_contract.id,
        'contract_week_id',case when v_workflow_kind='DAILY' then null else v_week.id end,
        'anchor_timesheet_id',case when v_workflow_kind='DAILY'
          then v_daily_timesheet.timesheet_id else v_anchor_week.timesheet_id end,
        'daily_booking_id',case when v_workflow_kind='DAILY'
          then nullif(btrim(coalesce(v_daily_timesheet.booking_id,'')),'') else null end,
        'work_date',v_canonical_work_date,
        'week_ending_date',v_canonical_week_ending_date,
        'replacement_of_workflow_id',v_replacement_of_workflow_id
      ))
    );

    select * into v_existing_workflow
    from public.candidate_submission_workflows
    where account_id=v_account_id
      and idempotency_key=btrim(p_idempotency_key)
    for update;
    if found then
      if v_existing_workflow.candidate_id is distinct from v_candidate_id
         or v_existing_workflow.replacement_of_workflow_id is distinct from v_replacement_of_workflow_id
         or v_existing_workflow.creation_request_sha256 is distinct from v_creation_request_sha256 then
        raise exception 'CANDIDATE_IDEMPOTENCY_CONFLICT'
          using errcode=case when v_is_rejected_resubmission then '55000' else '40001' end;
      end if;
      if v_is_rejected_resubmission then
        return jsonb_build_object(
          'ok',true,'idempotent_replay',true,
          'rejected_workflow_id',v_replacement_of_workflow_id,
          'replacement_workflow_id',v_existing_workflow.id,
          'replacement_created',false,
          'workflow_id',v_existing_workflow.id,
          'state',v_existing_workflow.state,
          'generation',v_existing_workflow.generation
        );
      end if;
      return jsonb_build_object('ok',true,'idempotent_replay',true,
        'workflow_id',v_existing_workflow.id,'state',v_existing_workflow.state,
        'generation',v_existing_workflow.generation);
    end if;

    if v_workflow_kind in ('CONTRACT_EXPENSE','CONTRACT_COMBINED') then
      perform pg_advisory_xact_lock(hashtext(
        v_candidate_id::text||'|'||v_contract.id::text||'|'||
        v_canonical_week_ending_date::text||
        '|CANDIDATE_EXPENSE_CLAIM'
      ));
      if exists(
        select 1
        from public.candidate_submission_workflows prior
        where prior.candidate_id=v_candidate_id
          and prior.contract_id=v_contract.id
          and prior.week_ending_date=v_canonical_week_ending_date
          and prior.workflow_kind in ('CONTRACT_EXPENSE','CONTRACT_COMBINED')
          and prior.state not in (
            'CANCELLED','REJECTED','REFUSED','EXPIRED','SUPERSEDED','FINALISED'
          )
      ) or exists(
        select 1
        from public.contract_weeks prior_week
        join public.timesheets prior_timesheet
          on prior_timesheet.timesheet_id=prior_week.timesheet_id
         and prior_timesheet.is_current=true
         and prior_timesheet.archived_at_utc is null
        join public.timesheets_financials prior_fin
          on prior_fin.timesheet_id=prior_timesheet.timesheet_id
         and prior_fin.is_current=true
        where prior_week.contract_id=v_contract.id
          and prior_week.week_ending_date=v_canonical_week_ending_date
          and prior_fin.authorised_at_utc is null
          and not exists(
            select 1
            from public.candidate_submission_workflows approved_claim
            where approved_claim.candidate_id=v_candidate_id
              and approved_claim.contract_id=v_contract.id
              and approved_claim.week_ending_date=v_canonical_week_ending_date
              and approved_claim.workflow_kind in ('CONTRACT_EXPENSE','CONTRACT_COMBINED')
              and approved_claim.state='FINALISED'
              and approved_claim.target_timesheet_id=prior_timesheet.timesheet_id
          )
          and (
            abs(coalesce(prior_fin.expenses_pay_ex_vat,0))
            +abs(coalesce(prior_fin.expenses_charge_ex_vat,0))
            +abs(coalesce(prior_fin.mileage_units,0))
            +abs(coalesce(prior_fin.mileage_pay_ex_vat,0))
            +abs(coalesce(prior_fin.mileage_charge_ex_vat,0))
            +abs(coalesce(prior_fin.travel_pay_ex_vat,0))
            +abs(coalesce(prior_fin.travel_charge_ex_vat,0))
            +abs(coalesce(prior_fin.accommodation_pay_ex_vat,0))
            +abs(coalesce(prior_fin.accommodation_charge_ex_vat,0))
            +abs(coalesce(prior_fin.other_pay_ex_vat,0))
            +abs(coalesce(prior_fin.other_charge_ex_vat,0))
          )>0
      ) then
        raise exception 'CANDIDATE_EXPENSE_CLAIM_ALREADY_ACTIVE' using errcode='55000';
      end if;
    end if;
    insert into public.candidate_submission_workflows(
      id,environment,account_id,candidate_id,workflow_kind,scope,route,state,generation,
      contract_id,contract_week_id,anchor_timesheet_id,target_timesheet_id,work_date,week_ending_date,
      policy_snapshot_json,input_snapshot_json,issue_codes,expected_row_signature,idempotency_key,
      replacement_of_workflow_id,creation_request_sha256,creation_identity_json,
      last_mutation_idempotency_key,created_at_utc,updated_at_utc
    ) values (
      v_insert_workflow_id,v_environment,v_account_id,v_candidate_id,v_workflow_kind,
      v_scope,v_route,'WORKER_DRAFT',1,v_contract.id,
      case when v_workflow_kind='DAILY' then null else v_week.id end,
      case when v_workflow_kind='DAILY' then v_daily_timesheet.timesheet_id else v_anchor_week.timesheet_id end,
      case
        when v_workflow_kind='DAILY' then v_daily_timesheet.timesheet_id
        when v_workflow_kind='CONTRACT_EXPENSE' then null
        else v_week.timesheet_id
      end,
      v_canonical_work_date,v_canonical_week_ending_date,
      v_policy,coalesce(v_payload->'input_snapshot','{}'::jsonb),'[]'::jsonb,
      nullif(v_payload->>'expected_row_signature',''),btrim(p_idempotency_key),
      v_replacement_of_workflow_id,v_creation_request_sha256,v_creation_identity,
      btrim(p_idempotency_key),p_now_utc,p_now_utc
    ) returning * into v_workflow;
    perform private._candidate_audit_v1('candidate_submission_workflow',v_workflow.id::text,
      'CANDIDATE_WORKFLOW_CREATED',null,
      jsonb_build_object('kind',v_workflow.workflow_kind,'scope',v_workflow.scope,'route',v_workflow.route),
      null,null,p_idempotency_key,p_now_utc);
    if v_is_rejected_resubmission then
      return jsonb_build_object(
        'ok',true,'idempotent_replay',false,
        'rejected_workflow_id',v_replacement_of_workflow_id,
        'replacement_workflow_id',v_workflow.id,
        'replacement_created',true,
        'workflow_id',v_workflow.id,'state',v_workflow.state,
        'generation',v_workflow.generation,'policy',v_policy
      );
    end if;
    return jsonb_build_object('ok',true,'idempotent_replay',false,
      'workflow_id',v_workflow.id,'state',v_workflow.state,
      'generation',v_workflow.generation,'policy',v_policy);
  end if;

  if v_workflow.id is null then
    if v_action in ('PAPER_PREPARE','PAPER_RETURN','AMEND','CANCEL','SUPERSEDE') then
      -- Keep the canonical route/document lock order used by
      -- timesheet_qr_send_enqueue_v1: current timesheet, then workflow.
      -- The unlocked identity read is rechecked after both locks are held.
      select * into v_workflow
      from public.candidate_submission_workflows
      where id=p_workflow_id
        and environment=v_environment
        and candidate_id=v_candidate_id;
      if not found then
        raise exception 'CANDIDATE_WORKFLOW_NOT_FOUND' using errcode='P0002';
      end if;
      v_unlocked_workflow_updated_at:=v_workflow.updated_at_utc;
      v_paper_timesheet_id:=coalesce(v_workflow.target_timesheet_id,v_workflow.anchor_timesheet_id);
      v_paper_family_key:='CANDIDATE_PAPER_FAMILY:'||v_workflow.environment||':'
        ||coalesce(v_workflow.contract_id::text,'-')||':'
        ||coalesce(v_workflow.week_ending_date::text,v_workflow.work_date::text,'-');
      perform pg_advisory_xact_lock(hashtextextended(v_paper_family_key,0));
      if v_action='PAPER_PREPARE' and v_paper_timesheet_id is null then
        raise exception 'CANDIDATE_PAPER_TIMESHEET_NOT_READY' using errcode='55000';
      end if;
      if v_paper_timesheet_id is not null
         and (v_action in ('PAPER_PREPARE','PAPER_RETURN')
           or (v_workflow.route='PAPER'
             and v_workflow.state in ('AWAITING_PAPER_RETURN','RECEIVED'))) then
        perform 1
        from public.timesheets
        where timesheet_id=v_paper_timesheet_id
          and is_current=true
          and archived_at_utc is null
        for update;
        if not found then
          raise exception 'CANDIDATE_PAPER_TIMESHEET_NOT_READY' using errcode='55000';
        end if;
      end if;
      select * into v_workflow
      from public.candidate_submission_workflows
      where id=p_workflow_id
        and environment=v_environment
        and candidate_id=v_candidate_id
      for update;
      if not found
         or coalesce(v_workflow.target_timesheet_id,v_workflow.anchor_timesheet_id)
              is distinct from v_paper_timesheet_id then
        raise exception 'CANDIDATE_WORKFLOW_CONTEXT_CONFLICT' using errcode='40001';
      end if;
      if v_action in ('PAPER_RETURN','AMEND','CANCEL','SUPERSEDE')
         and v_workflow.updated_at_utc is distinct from v_unlocked_workflow_updated_at then
        raise exception 'CANDIDATE_WORKFLOW_CONTEXT_CONFLICT' using errcode='40001';
      end if;
    else
      select * into v_workflow
      from public.candidate_submission_workflows
      where id=p_workflow_id
      for update;
    end if;
  end if;
  if not found or v_workflow.environment<>v_environment
     or (not v_is_service_action and not v_is_public_manager_action and v_workflow.candidate_id<>v_candidate_id) then
    raise exception 'CANDIDATE_WORKFLOW_NOT_FOUND' using errcode='P0002';
  end if;
  if v_action='WORKER_SUBMIT' and nullif(v_payload->>'update_id','') is not null then
    begin
      v_expense_update_context:=nullif(current_setting(
        'cloudtms.candidate_expense_update_submit_context',true
      ),'')::jsonb;
    exception when others then
      v_expense_update_context:=null;
    end;
    if coalesce(v_expense_update_context->>'contract_version','')
         <>'CANDIDATE_EXPENSE_UPDATE_SUBMIT_CONTEXT_V1'
       or v_expense_update_context->>'workflow_id'<>v_workflow.id::text
       or v_expense_update_context->>'workflow_generation'<>v_workflow.generation::text
       or v_expense_update_context->>'update_id'<>v_payload->>'update_id'
       or v_expense_update_context->>'idempotency_key'<>btrim(coalesce(p_idempotency_key,'')) then
      raise exception 'CANDIDATE_EXPENSE_UPDATE_RECEIPT_INVALID' using errcode='28000';
    end if;
    select update_row.* into v_pending_expense_update
    from public.candidate_pending_expense_updates update_row
    where update_row.update_id=(v_payload->>'update_id')::uuid
      and update_row.workflow_id=v_workflow.id
      and update_row.current_workflow_generation=v_workflow.generation
      and update_row.state='EDITING'
      and update_row.actor_kind=v_expense_update_context->>'actor_kind'
      and update_row.actor_id is not distinct from nullif(
        v_expense_update_context->>'actor_id',''
      )::uuid
    for update;
    if not found then
      raise exception 'CANDIDATE_EXPENSE_UPDATE_APPROVAL_CHANGED' using errcode='40001';
    end if;
    v_is_pending_expense_update:=true;
  end if;
  if nullif(btrim(coalesce(p_idempotency_key,'')),'') is not null then
    if nullif(btrim(coalesce(v_workflow.idempotency_key,'')),'')=btrim(p_idempotency_key) then
      raise exception 'CANDIDATE_IDEMPOTENCY_CONFLICT'
        using errcode='40001',detail=jsonb_build_object(
          'code','CANDIDATE_IDEMPOTENCY_CONFLICT',
          'workflow_id',v_workflow.id,
          'idempotency_key',btrim(p_idempotency_key),
          'reason','CREATION_KEY_REUSED_FOR_MUTATION'
        )::text;
    end if;
    v_mutation_channel:=case
      when v_is_office_service_action then 'OFFICE'
      when v_is_public_manager_action then 'MANAGER_PUBLIC'
      when v_is_service_action then 'SERVICE'
      else 'CANDIDATE_CLIENT' end;
    v_mutation_actor_identity:=case
      when v_is_office_service_action then v_office_actor_user_id::text
      when v_is_public_manager_action then 'MANAGER_REQUEST:'||coalesce(v_request_id::text,'UNKNOWN')
      when v_is_service_action then 'SERVICE:'||v_action
      else 'ACCOUNT:'||coalesce(v_account_id::text,'UNKNOWN')
        ||':CANDIDATE:'||coalesce(v_candidate_id::text,'UNKNOWN') end;
    v_mutation_semantic_payload:=case
      when v_mutation_replay_probe_only then
        v_payload->'mutation_replay_semantic_payload'
      when v_action='COMPONENT_PREPARE' then
        v_payload-'service_office_action'-'actor_user_id'-'storage_key'
      when v_action='SELECT_PHONE_APPROVAL' then
        v_payload-'service_office_action'-'actor_user_id'-'expires_at_utc'
          -'approval_token_hash_hex'-'handoff_token_key_version'-'broker_handoff_key_version'
      when v_action='WORKER_SUBMIT' then
        case when jsonb_typeof(v_payload->'submission_request_identity')='object'
          then jsonb_build_object(
            'submission_request_identity',v_payload->'submission_request_identity'
          )
          else (v_payload-'service_office_action'-'actor_user_id'-'renderer_contract_version'-'immutable_submission')
            ||jsonb_build_object(
              'immutable_submission',coalesce(v_payload->'immutable_submission','{}'::jsonb)-'official_presentation'
            )
        end
      when v_action='CREATE_EMAIL_APPROVAL_REQUEST' then
        v_payload-'service_office_action'-'actor_user_id'-'mail'-'approval_token_hash_hex'
      when v_action in ('REMIND','RENEW') then
        v_payload-'service_office_action'-'actor_user_id'-'mail'-'approval_token_hash_hex'-'manager_email'
      else v_payload-'service_office_action'-'actor_user_id'
    end;
    v_mutation_request_sha256:=encode(extensions.digest(convert_to(jsonb_build_object(
      'contract_version','CANDIDATE_WORKFLOW_MUTATION_REQUEST_V1',
      'workflow_id',v_workflow.id,
      'action',v_action,
      'expected_generation',p_expected_generation,
      'payload',v_mutation_semantic_payload,
      'channel',v_mutation_channel,
      'actor_identity',v_mutation_actor_identity
    )::text,'UTF8'),'sha256'),'hex');
    v_mutation_receipt:=private._candidate_workflow_mutation_receipt_v1(
      v_workflow.id,btrim(p_idempotency_key),v_mutation_request_sha256,
      v_action,v_mutation_channel,v_mutation_actor_identity,null,p_now_utc
    );
    if coalesce((v_mutation_receipt->>'found')::boolean,false) then
      return v_mutation_receipt->'response';
    end if;
    if v_mutation_replay_probe_only then
      return jsonb_build_object(
        'ok',true,'replay_found',false,'workflow_id',v_workflow.id,
        'expected_generation',p_expected_generation
      );
    end if;
  end if;
  if p_expected_generation is not null and v_workflow.generation<>p_expected_generation then
    raise exception 'WORKFLOW_GENERATION_CONFLICT'
      using errcode='40001',detail=jsonb_build_object(
        'code','WORKFLOW_GENERATION_CONFLICT','current_generation',v_workflow.generation)::text;
  end if;
  v_next_generation:=v_workflow.generation+1;
  if v_workflow.workflow_kind='DAILY' then
    v_daily_receipt_context:=private._candidate_daily_receipt_context_v1(
      v_environment,v_workflow.candidate_id,v_workflow.target_timesheet_id,true,p_now_utc);
    v_policy:=v_daily_receipt_context->'policy';
  elsif v_workflow.contract_id is not null then
    select * into v_contract from public.contracts where id=v_workflow.contract_id;
    v_policy:=private._expense_approval_policy_v1(v_contract.client_id,v_contract.id,
      coalesce(v_workflow.week_ending_date,v_workflow.work_date,(p_now_utc at time zone 'Europe/London')::date),v_workflow.workflow_kind);
  else
    v_policy:=v_workflow.policy_snapshot_json;
  end if;

  v_worker_only_approval:=v_workflow.scope='WEEKLY' and v_workflow.workflow_kind='CONTRACT_HOURS'
    and v_workflow.route='ELECTRONIC'
    and coalesce(v_policy#>'{manager_approval_policy,approval}'='"NOT_REQUIRED"'::jsonb,false)
    and (v_action='WORKER_SUBMIT' or (
      coalesce(v_workflow.policy_snapshot_json#>'{manager_approval_policy,approval}'='"NOT_REQUIRED"'::jsonb,false)
      and coalesce(v_policy->>'policy_fingerprint'=v_workflow.policy_snapshot_json->>'policy_fingerprint',false)));
  if v_workflow.scope='WEEKLY' and v_workflow.workflow_kind='CONTRACT_HOURS'
     and v_workflow.policy_snapshot_json#>'{manager_approval_policy,approval}'='"NOT_REQUIRED"'::jsonb
     and v_action in ('REGISTER_REVIEW_COMPONENT','SELECT_PHONE_APPROVAL','CREATE_EMAIL_APPROVAL_REQUEST')
     and v_worker_only_approval is distinct from true then
    raise exception 'CANDIDATE_POLICY_CHANGED' using errcode='40001';
  end if;

  if v_action='AMEND' then
    if v_workflow.state not in (
      'WORKER_SUBMITTED','WORKER_SUBMITTED_PENDING_REVIEW_DOCUMENT',
      'READY_FOR_MANAGER_APPROVAL','AWAITING_MANAGER_APPROVAL',
      'AWAITING_PAPER_RETURN','REFUSED'
    ) then
      raise exception 'CANDIDATE_WORKFLOW_AMENDMENT_NOT_ALLOWED' using errcode='55000';
    end if;
    if nullif(btrim(coalesce(p_idempotency_key,'')),'') is null then
      raise exception 'CANDIDATE_IDEMPOTENCY_KEY_REQUIRED' using errcode='22023';
    end if;
    if v_workflow.route='PAPER' and v_workflow.state='AWAITING_PAPER_RETURN' then
      v_paper_retirement_result:=private._candidate_paper_delivery_retire_v1(
        v_workflow.id,v_workflow.generation,'WORKFLOW_AMENDED',p_now_utc
      );
    end if;
    update public.candidate_approval_requests set
      state='SUPERSEDED',superseded_at_utc=p_now_utc,updated_at_utc=p_now_utc
    where workflow_id=v_workflow.id and state in ('PENDING','APPROVED');
    v_component_no:=0;
    for v_source_component in
      select canonical_source.*
      from (
        select distinct on (
          source_component.component_kind,source_component.expense_category,
          source_component.document_role,
          coalesce(source_component.source_component_id,source_component.id),
          source_component.source_content_sha256
        ) source_component.*
        from public.candidate_submission_components source_component
        where source_component.workflow_id=v_workflow.id
          and source_component.workflow_generation=v_workflow.generation
          and source_component.component_kind in ('MILEAGE_FORM','EXPENSE_EVIDENCE')
          and source_component.state='IMMUTABLE'
          and source_component.source_content_sha256 is not null
        order by source_component.component_kind,source_component.expense_category,
          source_component.document_role,
          coalesce(source_component.source_component_id,source_component.id),
          source_component.source_content_sha256,
          source_component.component_no,source_component.id
      ) canonical_source
      order by canonical_source.component_no,canonical_source.id
    loop
      v_component_no:=v_component_no+1;
      insert into public.candidate_submission_components(
        workflow_id,workflow_generation,component_no,timesheet_id,component_kind,expense_category,
        document_role,state,source_component_id,storage_key,media_type,byte_size,source_content_sha256,
        immutable_at_utc,required,review_render_state,final_signed_render_state,created_at_utc
      ) values (
        v_workflow.id,v_next_generation,v_component_no,v_workflow.target_timesheet_id,
        v_source_component.component_kind,v_source_component.expense_category,v_source_component.document_role,
        'IMMUTABLE',coalesce(v_source_component.source_component_id,v_source_component.id),
        v_source_component.storage_key,v_source_component.media_type,v_source_component.byte_size,
        v_source_component.source_content_sha256,p_now_utc,false,'NOT_REQUIRED','NOT_REQUIRED',p_now_utc
      );
    end loop;
    update public.candidate_submission_components set
      state='SUPERSEDED',superseded_at_utc=p_now_utc,
      review_render_state=case when review_render_state='NOT_REQUIRED' then review_render_state else 'SUPERSEDED' end,
      final_signed_render_state=case when final_signed_render_state='NOT_REQUIRED' then final_signed_render_state else 'SUPERSEDED' end
    where workflow_id=v_workflow.id
      and workflow_generation=v_workflow.generation
      and state<>'SUPERSEDED';
    v_response:=jsonb_build_object(
      'ok',true,'workflow_id',v_workflow.id,'state','WORKER_DRAFT',
      'generation',v_next_generation,'preserved_source_component_count',v_component_no
    );
    update public.candidate_submission_workflows set
      state='WORKER_DRAFT',generation=v_next_generation,
      input_snapshot_json=coalesce(v_payload->'input_snapshot',input_snapshot_json),
      candidate_signature_component_id=null,candidate_signature_sha256=null,candidate_signed_at_utc=null,
      review_manifest_json=null,review_manifest_sha256=null,paper_return_manifest_json=null,
      paper_return_manifest_sha256=null,renderer_contract_version=null,
      manager_name=null,manager_position=null,manager_signature_component_id=null,
      manager_signature_sha256=null,manager_approved_at_utc=null,
      issue_codes='[]'::jsonb,worker_submitted_at_utc=null,
      daily_context_sha256=null,canonical_financial_sha256=null,
      canonical_save_input_sha256=null,canonical_save_row_signature=null,
      canonical_save_financials_id=null,canonical_save_receipt_json=null,canonical_saved_at_utc=null,
      last_mutation_idempotency_key=p_idempotency_key,last_mutation_response_json=v_response,
      updated_at_utc=p_now_utc
    where id=v_workflow.id returning * into v_workflow;
    perform private._candidate_audit_v1('candidate_submission_workflow',v_workflow.id::text,
      'CANDIDATE_WORKFLOW_AMENDED',null,
      jsonb_build_object('generation',v_workflow.generation,'preserved_source_component_count',v_component_no),
      null,v_candidate_id,p_idempotency_key,p_now_utc);
    if v_mutation_request_sha256 is not null then
      perform private._candidate_workflow_mutation_receipt_v1(
        v_workflow.id,p_idempotency_key,v_mutation_request_sha256,v_action,
        v_mutation_channel,v_mutation_actor_identity,v_response,p_now_utc
      );
    end if;
    return v_response;
  elsif v_action='COMPONENT_PREPARE' then
    if v_workflow.state in ('FINALISED','CANCELLED','REJECTED','SUPERSEDED') then
      raise exception 'CANDIDATE_WORKFLOW_NOT_MUTABLE' using errcode='55000';
    end if;
    if nullif(btrim(coalesce(p_idempotency_key,'')),'') is null then
      raise exception 'CANDIDATE_IDEMPOTENCY_KEY_REQUIRED' using errcode='22023';
    end if;
    v_component_kind:=upper(btrim(coalesce(v_payload->>'component_kind','')));
    v_document_role:=upper(btrim(coalesce(v_payload->>'document_role','')));
    v_expense_category:=nullif(upper(btrim(coalesce(v_payload->>'expense_category',''))),'');
    v_paper_page_key:=nullif(btrim(coalesce(v_payload->>'paper_return_page_key','')),'');
    v_requested_media_type:=nullif(lower(btrim(coalesce(v_payload->>'media_type',''))),'');
    begin
      v_requested_byte_size:=nullif(v_payload->>'byte_size','')::bigint;
    exception when invalid_text_representation or numeric_value_out_of_range then
      raise exception 'CANDIDATE_COMPONENT_SIZE_INVALID' using errcode='22023';
    end;
    v_manager_capture_method:=nullif(upper(btrim(coalesce(
      v_payload->>'manager_signature_capture_method',''
    ))),'');
    if nullif(v_payload->>'expected_source_content_sha256_hex','') is not null then
      if (v_payload->>'expected_source_content_sha256_hex') !~ '^[0-9a-fA-F]{64}$' then
        raise exception 'CANDIDATE_COMPONENT_DIGEST_INVALID' using errcode='22023';
      end if;
      v_expected_source_digest:=decode(v_payload->>'expected_source_content_sha256_hex','hex');
    end if;
    select * into v_component from public.candidate_submission_components
    where workflow_id=v_workflow.id and upload_idempotency_key=p_idempotency_key;
    if found then
      if v_component.workflow_generation is distinct from v_workflow.generation then
        raise exception 'CANDIDATE_COMPONENT_PREPARE_GENERATION_CONFLICT' using errcode='40001';
      end if;
      if v_component.state not in ('PENDING','IMMUTABLE') then
        raise exception 'CANDIDATE_COMPONENT_PREPARE_STATE_CONFLICT' using errcode='55000';
      end if;
      if v_component.component_kind is distinct from v_component_kind
         or v_component.document_role is distinct from v_document_role
         or v_component.expense_category is distinct from v_expense_category
         or lower(v_component.media_type) is distinct from v_requested_media_type
         or v_component.byte_size is distinct from v_requested_byte_size
         or v_component.manager_signature_capture_method is distinct from v_manager_capture_method
         or v_component.expected_source_content_sha256 is distinct from v_expected_source_digest
         or v_component.paper_return_page_key is distinct from v_paper_page_key then
        raise exception 'CANDIDATE_COMPONENT_PREPARE_IDEMPOTENCY_CONFLICT' using errcode='23505';
      end if;
      v_response:=jsonb_build_object('ok',true,'idempotent_replay',true,
        'component_id',v_component.id,'component_no',v_component.component_no,
        'workflow_generation',v_component.workflow_generation,
        'storage_key',v_component.storage_key,'media_type',v_component.media_type,
        'byte_size',v_component.byte_size,'component_kind',v_component.component_kind,
        'document_role',v_component.document_role,'expense_category',v_component.expense_category,
        'paper_return_page_key',v_component.paper_return_page_key,'state',v_component.state)
        ||case when v_component.component_kind='MANAGER_SIGNATURE' then jsonb_build_object(
          'approval_request_id',v_component.approval_request_id,
          'approval_request_generation',v_approval.request_generation
        ) else '{}'::jsonb end;
      if v_mutation_request_sha256 is not null then
        perform private._candidate_workflow_mutation_receipt_v1(
          v_workflow.id,p_idempotency_key,v_mutation_request_sha256,v_action,
          v_mutation_channel,v_mutation_actor_identity,v_response,p_now_utc
        );
      end if;
      return v_response;
    end if;
    select coalesce(max(component_no),0)+1 into v_component_no
    from public.candidate_submission_components
    where workflow_id=v_workflow.id and workflow_generation=v_workflow.generation;
    if v_is_public_manager_action then
      if v_component_kind<>'MANAGER_SIGNATURE' or v_document_role<>'MANAGER_SIGNATURE' then
        raise exception 'MANAGER_SIGNATURE_COMPONENT_REQUIRED' using errcode='28000';
      end if;
      if v_approval.id is null
         or v_approval.state<>'PENDING'
         or v_approval.expires_at_utc<=p_now_utc
         or v_approval.workflow_generation<>v_workflow.generation
         or v_approval.review_manifest_sha256 is distinct from v_workflow.review_manifest_sha256 then
        raise exception 'MANAGER_APPROVAL_REQUEST_NOT_READY' using errcode='28000';
      end if;
    elsif v_component_kind='MANAGER_SIGNATURE' then
      select * into v_approval
      from public.candidate_approval_requests
      where id=nullif(v_payload->>'approval_request_id','')::uuid
        and workflow_id=v_workflow.id
        and workflow_generation=v_workflow.generation
        and method='PHONE'
        and state='PENDING'
        and review_manifest_sha256=v_workflow.review_manifest_sha256
      for update;
      if not found then raise exception 'MANAGER_APPROVAL_REQUEST_NOT_READY' using errcode='28000'; end if;
    elsif not coalesce((
      (v_component_kind='CANDIDATE_SIGNATURE' and v_document_role='CANDIDATE_SIGNATURE' and v_expense_category is null)
      or (v_component_kind='MILEAGE_FORM' and v_document_role='MILEAGE_CLAIM_FORM' and v_expense_category='MILEAGE')
      or (v_component_kind='EXPENSE_EVIDENCE' and v_document_role='SOURCE_EVIDENCE'
          and v_expense_category in ('TRAVEL','ACCOMMODATION','OTHER','MILEAGE'))
      or (v_component_kind='SIGNED_RETURN' and v_document_role='SIGNED_RETURN' and v_expense_category is null)
      or (v_component_kind='MANAGER_SIGNATURE' and v_document_role='MANAGER_SIGNATURE'
          and v_expense_category is null
          and v_workflow.state='AWAITING_MANAGER_APPROVAL'
          and exists(
            select 1 from public.candidate_approval_requests approval
            where approval.workflow_id=v_workflow.id
              and approval.workflow_generation=v_workflow.generation
              and approval.method='PHONE' and approval.state='PENDING'
          ))
    ),false) then
      raise exception 'CANDIDATE_COMPONENT_TYPE_INVALID' using errcode='22023';
    end if;
    if v_component_kind='MANAGER_SIGNATURE' and v_approval.method='PHONE'
       and v_manager_capture_method is null then
      v_manager_capture_method:='DRAW';
    end if;
    if v_component_kind='MANAGER_SIGNATURE'
       and (coalesce(v_manager_capture_method,'') not in ('DRAW','UPLOAD')
         or (v_is_public_manager_action and v_approval.method='EMAIL'
           and v_expected_source_digest is null)) then
      raise exception 'MANAGER_SIGNATURE_CAPTURE_METHOD_INVALID' using errcode='22023';
    elsif v_component_kind<>'MANAGER_SIGNATURE'
       and (v_manager_capture_method is not null or v_expected_source_digest is not null) then
      raise exception 'CANDIDATE_COMPONENT_DIGEST_INVALID' using errcode='22023';
    end if;
    if v_component_kind in ('CANDIDATE_SIGNATURE','MILEAGE_FORM','EXPENSE_EVIDENCE')
       and v_workflow.state<>'WORKER_DRAFT' then
      raise exception 'CANDIDATE_COMPONENT_AMENDMENT_REQUIRED' using errcode='55000';
    end if;
    if v_component_kind='SIGNED_RETURN' then
      if v_workflow.route<>'PAPER' or v_workflow.state<>'AWAITING_PAPER_RETURN'
         or v_workflow.paper_return_manifest_sha256 is null
         or not exists(
           select 1
           from jsonb_array_elements(v_workflow.paper_return_manifest_json->'pages') page
           where page->>'page_key'=v_paper_page_key
         ) then
        raise exception 'CANDIDATE_PAPER_RETURN_PAGE_NOT_EXPECTED' using errcode='22023';
      end if;
    elsif v_paper_page_key is not null then
      raise exception 'CANDIDATE_PAPER_RETURN_PAGE_KEY_FORBIDDEN' using errcode='22023';
    end if;
    -- A manager may safely reopen the original approval link after a browser,
    -- network or dependency interruption.  The approval itself is still
    -- PENDING, so any earlier signature reservation is not an approval fact.
    -- Replace that unfinished/unused reservation atomically before inserting
    -- the newly drawn signature.  Exact retries already returned above by
    -- idempotency key, and an approved request can never enter this branch.
    if v_component_kind='MANAGER_SIGNATURE' and v_approval.id is not null then
      with replaced as (
        update public.candidate_submission_components
        set state='SUPERSEDED',superseded_at_utc=p_now_utc,
            review_render_state=case
              when review_render_state='NOT_REQUIRED' then review_render_state
              else 'SUPERSEDED'
            end,
            final_signed_render_state=case
              when final_signed_render_state='NOT_REQUIRED' then final_signed_render_state
              else 'SUPERSEDED'
            end
        where approval_request_id=v_approval.id
          and component_kind='MANAGER_SIGNATURE'
          and state in ('PENDING','IMMUTABLE')
          and upload_idempotency_key is distinct from p_idempotency_key
        returning id
      )
      select coalesce(array_agg(id),array[]::uuid[])
      into v_replaced_manager_signature_ids
      from replaced;
      if cardinality(v_replaced_manager_signature_ids)>0 then
        perform private._candidate_audit_v1(
          'candidate_approval_request',v_approval.id::text,
          'MANAGER_SIGNATURE_REPLACED_BEFORE_DECISION',null,
          jsonb_build_object(
            'workflow_id',v_workflow.id,
            'workflow_generation',v_workflow.generation,
            'replaced_component_ids',to_jsonb(v_replaced_manager_signature_ids)
          ),null,null,p_idempotency_key,p_now_utc
        );
      end if;
    end if;
    if nullif(v_payload->>'source_component_id','') is not null then
      select source_component.* into v_source_component
      from public.candidate_submission_components source_component
      join public.candidate_submission_workflows source_workflow on source_workflow.id=source_component.workflow_id
      where source_component.id=(v_payload->>'source_component_id')::uuid
        and source_component.state in ('IMMUTABLE','SUPERSEDED','REJECTED')
        and source_component.immutable_at_utc is not null
        and source_component.source_content_sha256 is not null
        and source_component.source_component_id is null
        and source_workflow.environment=v_environment
        and source_workflow.account_id=v_account_id
        and source_workflow.candidate_id=v_candidate_id
        and (
          source_workflow.id=v_workflow.id
          or (
            source_workflow.contract_id is not distinct from v_workflow.contract_id
            and source_workflow.week_ending_date is not distinct from v_workflow.week_ending_date
            and source_workflow.state in ('CANCELLED','REJECTED','REFUSED','SUPERSEDED')
          )
        );
      if not found or v_source_component.component_kind<>v_component_kind
         or v_source_component.document_role<>v_document_role
         or v_source_component.expense_category is distinct from v_expense_category then
        raise exception 'CANDIDATE_SOURCE_COMPONENT_NOT_ALLOWED' using errcode='28000';
      end if;
    end if;
    insert into public.candidate_submission_components(
      workflow_id,workflow_generation,component_no,approval_request_id,timesheet_id,component_kind,expense_category,
      document_role,state,source_component_id,storage_key,media_type,byte_size,source_content_sha256,
      upload_idempotency_key,immutable_at_utc,
      required,review_ordinal,review_render_state,final_signed_render_state,paper_return_page_key,
      manager_signature_capture_method,expected_source_content_sha256,created_at_utc
    ) values (
      v_workflow.id,v_workflow.generation,v_component_no,
      case when v_component_kind='MANAGER_SIGNATURE' then v_approval.id else null end,
      v_workflow.target_timesheet_id,
      v_component_kind,v_expense_category,v_document_role,
      case when v_source_component.id is null then 'PENDING' else 'IMMUTABLE' end,
      v_source_component.id,
      coalesce(v_source_component.storage_key,nullif(v_payload->>'storage_key','')),
      coalesce(v_source_component.media_type,v_requested_media_type),
      coalesce(v_source_component.byte_size,v_requested_byte_size),
      v_source_component.source_content_sha256,p_idempotency_key,
      case when v_source_component.id is null then null else p_now_utc end,
      false,null,'NOT_REQUIRED','NOT_REQUIRED',v_paper_page_key,
      v_manager_capture_method,v_expected_source_digest,
      p_now_utc
    ) returning * into v_component;
    v_response:=jsonb_build_object('ok',true,'idempotent_replay',false,'component_id',v_component.id,
      'component_no',v_component.component_no,'workflow_generation',v_component.workflow_generation,
      'storage_key',v_component.storage_key,'media_type',v_component.media_type,
      'byte_size',v_component.byte_size,'component_kind',v_component.component_kind,
      'document_role',v_component.document_role,'expense_category',v_component.expense_category,
      'paper_return_page_key',v_component.paper_return_page_key,'state',v_component.state)
      ||case when v_component.component_kind='MANAGER_SIGNATURE' then jsonb_build_object(
        'approval_request_id',v_component.approval_request_id,
        'approval_request_generation',v_approval.request_generation
      ) else '{}'::jsonb end;
    perform private._candidate_workflow_mutation_receipt_v1(
      v_workflow.id,p_idempotency_key,v_mutation_request_sha256,v_action,
      v_mutation_channel,v_mutation_actor_identity,v_response,p_now_utc
    );
    return v_response;
  elsif v_action='COMPONENT_COMPLETE' then
    select * into v_component from public.candidate_submission_components
    where id=nullif(v_payload->>'component_id','')::uuid and workflow_id=v_workflow.id
      and workflow_generation=v_workflow.generation for update;
    if not found then raise exception 'CANDIDATE_COMPONENT_NOT_FOUND' using errcode='P0002'; end if;
    if v_is_public_manager_action and v_component.component_kind<>'MANAGER_SIGNATURE' then
      raise exception 'MANAGER_SIGNATURE_COMPONENT_REQUIRED' using errcode='28000';
    end if;
    if v_component.component_kind='MANAGER_SIGNATURE' then
      if v_approval.id is null then
        select * into v_approval
        from public.candidate_approval_requests
        where id=v_component.approval_request_id
          and workflow_id=v_workflow.id
          and workflow_generation=v_workflow.generation
          and method='PHONE'
          and state='PENDING'
          and review_manifest_sha256=v_workflow.review_manifest_sha256
        for update;
      end if;
      if not found or v_component.approval_request_id is distinct from v_approval.id
         or v_approval.state<>'PENDING'
         or v_approval.workflow_generation<>v_workflow.generation
         or v_approval.review_manifest_sha256 is distinct from v_workflow.review_manifest_sha256
         or v_approval.expires_at_utc<=p_now_utc then
        raise exception 'MANAGER_APPROVAL_REQUEST_NOT_READY' using errcode='28000';
      end if;
    elsif v_component.component_kind in ('CANDIDATE_SIGNATURE','MILEAGE_FORM','EXPENSE_EVIDENCE')
          and v_workflow.state<>'WORKER_DRAFT' then
      raise exception 'CANDIDATE_COMPONENT_AMENDMENT_REQUIRED' using errcode='55000';
    elsif v_component.component_kind='SIGNED_RETURN' and v_workflow.state<>'AWAITING_PAPER_RETURN' then
      raise exception 'CANDIDATE_PAPER_RETURN_PAGE_NOT_EXPECTED' using errcode='55000';
    end if;
    if coalesce(v_payload->>'source_content_sha256_hex','') !~ '^[0-9a-fA-F]{64}$' then
      raise exception 'CANDIDATE_COMPONENT_DIGEST_INVALID' using errcode='22023';
    end if;
    v_digest:=decode(v_payload->>'source_content_sha256_hex','hex');
    if v_component.expected_source_content_sha256 is not null
       and v_component.expected_source_content_sha256<>v_digest then
      raise exception 'CANDIDATE_COMPONENT_DIGEST_MISMATCH' using errcode='22023';
    end if;
    if v_component.component_kind in ('MILEAGE_FORM','EXPENSE_EVIDENCE')
       and v_component.expected_source_content_sha256 is not null
       and (
         nullif(btrim(coalesce(v_component.storage_key,'')),'') is null
         or coalesce(nullif(v_payload->>'verified_byte_size','')::bigint,
              v_component.byte_size) is distinct from v_component.byte_size
         or lower(coalesce(nullif(v_payload->>'verified_media_type',''),
              v_component.media_type)) is distinct from lower(v_component.media_type)
       ) then
      raise exception 'CANDIDATE_COMPONENT_MEDIA_INVALID' using errcode='22023';
    end if;
    v_manager_capture_method:=nullif(upper(btrim(coalesce(
      v_payload->>'manager_signature_capture_method',''
    ))),'');
    if v_component.component_kind='MANAGER_SIGNATURE' and v_approval.method='PHONE'
       and v_manager_capture_method is null then
      v_manager_capture_method:='DRAW';
    end if;
    begin
      v_verified_image_width:=nullif(v_payload->>'verified_image_width','')::integer;
      v_verified_image_height:=nullif(v_payload->>'verified_image_height','')::integer;
    exception when invalid_text_representation or numeric_value_out_of_range then
      raise exception 'CANDIDATE_COMPONENT_MEDIA_INVALID' using errcode='22023';
    end;
    if v_component.component_kind='MANAGER_SIGNATURE'
       and (v_manager_capture_method is distinct from v_component.manager_signature_capture_method
         or (v_approval.method='EMAIL' and (
           v_verified_image_width not between 1 and 10000
           or v_verified_image_height not between 1 and 10000
         ))) then
      raise exception 'MANAGER_SIGNATURE_CAPTURE_METHOD_INVALID' using errcode='22023';
    end if;
    if (v_component.component_kind in ('CANDIDATE_SIGNATURE','MANAGER_SIGNATURE')
          and lower(coalesce(v_payload->>'verified_media_type',v_component.media_type,''))
            not in ('image/jpeg','image/png','image/webp'))
       or (v_component.component_kind in ('MILEAGE_FORM','SIGNED_RETURN','EXPENSE_EVIDENCE')
          and lower(coalesce(v_payload->>'verified_media_type',v_component.media_type,''))
            not in ('application/pdf','image/jpeg','image/png','image/webp'))
       or coalesce(nullif(v_payload->>'verified_byte_size','')::bigint,v_component.byte_size,0)
          not between 1 and 15728640 then
      raise exception 'CANDIDATE_COMPONENT_MEDIA_INVALID' using errcode='22023';
    end if;
    if v_component.state='IMMUTABLE' then
      if v_component.source_content_sha256=v_digest
         and v_component.byte_size=coalesce(nullif(v_payload->>'verified_byte_size','')::bigint,v_component.byte_size)
         and lower(v_component.media_type)=lower(coalesce(nullif(v_payload->>'verified_media_type',''),v_component.media_type)) then
        v_response:=jsonb_build_object('ok',true,'idempotent_replay',true,
          'component_id',v_component.id,'state',v_component.state);
        if v_mutation_request_sha256 is not null then
          perform private._candidate_workflow_mutation_receipt_v1(
            v_workflow.id,p_idempotency_key,v_mutation_request_sha256,v_action,
            v_mutation_channel,v_mutation_actor_identity,v_response,p_now_utc
          );
        end if;
        return v_response;
      end if;
      raise exception 'CANDIDATE_COMPONENT_IMMUTABLE_CONFLICT' using errcode='40001';
    end if;
    if v_component.state<>'PENDING' then
      raise exception 'CANDIDATE_COMPONENT_COMPLETE_STATE_CONFLICT' using errcode='55000';
    end if;
    update public.candidate_submission_components set
      state='IMMUTABLE',source_content_sha256=v_digest,
      byte_size=coalesce(nullif(v_payload->>'verified_byte_size','')::bigint,byte_size),
      media_type=coalesce(nullif(lower(v_payload->>'verified_media_type'),''),media_type),
      validated_image_width=case when component_kind='MANAGER_SIGNATURE' then v_verified_image_width else validated_image_width end,
      validated_image_height=case when component_kind='MANAGER_SIGNATURE' then v_verified_image_height else validated_image_height end,
      immutable_at_utc=p_now_utc
    where id=v_component.id and state='PENDING' returning * into v_component;
    if not found then
      raise exception 'CANDIDATE_COMPONENT_COMPLETE_STATE_CONFLICT' using errcode='40001';
    end if;
    v_response:=jsonb_build_object('ok',true,'idempotent_replay',false,'component_id',v_component.id,
      'state',v_component.state,'immutable_at_utc',v_component.immutable_at_utc);
    perform private._candidate_workflow_mutation_receipt_v1(
      v_workflow.id,p_idempotency_key,v_mutation_request_sha256,v_action,
      v_mutation_channel,v_mutation_actor_identity,v_response,p_now_utc
    );
    return v_response;
  elsif v_action='COMPONENT_SUPERSEDE' then
    if v_workflow.state<>'WORKER_DRAFT' then
      raise exception 'CANDIDATE_COMPONENT_AMENDMENT_REQUIRED' using errcode='55000';
    end if;
    update public.candidate_submission_components set
      state='SUPERSEDED',superseded_at_utc=p_now_utc,
      review_render_state=case when review_render_state='NOT_REQUIRED' then review_render_state else 'SUPERSEDED' end,
      final_signed_render_state=case when final_signed_render_state='NOT_REQUIRED' then final_signed_render_state else 'SUPERSEDED' end
    where id=nullif(v_payload->>'component_id','')::uuid and workflow_id=v_workflow.id
      and workflow_generation=v_workflow.generation and state<>'SUPERSEDED'
      and component_kind in ('CANDIDATE_SIGNATURE','MILEAGE_FORM','EXPENSE_EVIDENCE')
    returning * into v_component;
    if not found then raise exception 'CANDIDATE_COMPONENT_NOT_FOUND' using errcode='P0002'; end if;
    v_response:=jsonb_build_object('ok',true,'component_id',v_component.id,'state',v_component.state);
    if v_mutation_request_sha256 is not null then
      perform private._candidate_workflow_mutation_receipt_v1(
        v_workflow.id,p_idempotency_key,v_mutation_request_sha256,v_action,
        v_mutation_channel,v_mutation_actor_identity,v_response,p_now_utc
      );
    end if;
    return v_response;
  end if;

  if v_action='WORKER_SUBMIT' then
    if v_workflow.state<>'WORKER_DRAFT' then
      raise exception 'CANDIDATE_WORKFLOW_TRANSITION_INVALID' using errcode='55000';
    end if;
    if v_workflow.workflow_kind='DAILY'
       and upper(coalesce(v_payload->>'approval_route',v_workflow.route))<>'PHONE' then
      raise exception 'CANDIDATE_DAILY_APPROVAL_ROUTE_INVALID' using errcode='22023';
    end if;
    if v_worker_only_approval and upper(coalesce(v_payload->>'approval_route',v_workflow.route))<>'ELECTRONIC' then
      raise exception 'CANDIDATE_FIXED_APPROVAL_ROUTE_INVALID' using errcode='22023';
    end if;
    v_is_electronic:=upper(coalesce(v_payload->>'approval_route',v_workflow.route))<>'PAPER';
    v_immutable_submission:=coalesce(v_payload->'immutable_submission',v_payload->'input_snapshot');
    if jsonb_typeof(v_immutable_submission)<>'object' then
      raise exception 'CANDIDATE_IMMUTABLE_SUBMISSION_REQUIRED' using errcode='22023';
    end if;
    if v_workflow.workflow_kind='DAILY' then
      if not private._candidate_daily_entitled_v1(v_candidate_id) then
        raise exception 'CANDIDATE_DAILY_ENTITLEMENT_REQUIRED' using errcode='55000';
      end if;
      select * into v_daily_timesheet
      from public.timesheets
      where timesheet_id=v_workflow.target_timesheet_id
        and is_current=true and archived_at_utc is null
        and sheet_scope='DAILY'::public.timesheet_scope_enum
      for update;
      if not found then raise exception 'CANDIDATE_DAILY_SHIFT_NOT_FOUND' using errcode='P0002'; end if;
      select * into v_daily_fin
      from public.timesheets_financials
      where timesheet_id=v_daily_timesheet.timesheet_id and is_current=true and candidate_id=v_candidate_id
      order by computed_at_utc desc nulls last,updated_at desc,id desc limit 1 for update;
      -- _candidate_daily_receipt_context_v1 already locked and verified this
      -- exact Candidate receipt and any existing protected financial state.
      v_canonical_work_date:=private._candidate_daily_work_date_v1(
        coalesce(
          nullif(v_immutable_submission#>>'{timesheet_patch_json,worked_start_iso}','')::timestamptz,
          nullif(v_immutable_submission->>'worked_start_iso','')::timestamptz,
          v_daily_fin.worked_start_iso,
          v_daily_timesheet.worked_start_iso
        ),
        v_daily_timesheet.scheduled_start_iso,
        v_daily_timesheet.week_ending_date
      );
      if v_canonical_work_date is distinct from v_workflow.work_date then
        raise exception 'CANDIDATE_DAILY_SHIFT_IDENTITY_MISMATCH' using errcode='22023';
      end if;
    elsif v_workflow.workflow_kind in ('CONTRACT_HOURS','CONTRACT_COMBINED') then
      select * into v_week
      from public.contract_weeks
      where id=v_workflow.contract_week_id
        and contract_id=v_workflow.contract_id
        and week_ending_date=v_workflow.week_ending_date
      for update;
      if not found then
        raise exception 'CANDIDATE_WORKFLOW_ANCHOR_MISMATCH' using errcode='40001';
      end if;
      if v_week.timesheet_id is null then
        -- A first electronic submission is reviewed before its Timesheet is
        -- materialised.  Its frozen canonical create/snapshot payload is
        -- applied only by the established manager-approved finalisation.
        if v_workflow.target_timesheet_id is not null then
          raise exception 'CANDIDATE_WORKFLOW_ANCHOR_MISMATCH' using errcode='40001';
        end if;
      else
        select * into v_anchor_timesheet
        from public.timesheets
        where timesheet_id=v_workflow.target_timesheet_id
          and timesheet_id=v_week.timesheet_id
          and is_current=true
          and archived_at_utc is null
          and sheet_scope='WEEKLY'::public.timesheet_scope_enum
        for update;
        if not found then
          raise exception 'CANDIDATE_WORKFLOW_ANCHOR_MISMATCH' using errcode='40001';
        end if;
      end if;
      v_target_capabilities:=private._candidate_record_capabilities_v1(v_workflow.target_timesheet_id,v_week.id,'{}'::jsonb);
      v_route_authority:=private._candidate_route_family_v1(v_workflow.target_timesheet_id,v_week.id);
      if not coalesce((v_target_capabilities->>'can_edit_hours')::boolean,false)
         or (v_workflow.route='PAPER' and not coalesce((v_route_authority->>'candidate_paper_submission_allowed')::boolean,false))
         or (v_workflow.route<>'PAPER' and v_route_authority->>'route_family'<>'ELECTRONIC') then
        raise exception 'CANDIDATE_ROUTE_FAMILY_MISMATCH' using errcode='55000',detail=v_route_authority::text;
      end if;
    elsif v_workflow.workflow_kind='CONTRACT_EXPENSE' then
      select week_row.* into v_anchor_week
      from public.contract_weeks week_row
      join public.timesheets anchor_timesheet
        on anchor_timesheet.timesheet_id=week_row.timesheet_id
       and anchor_timesheet.is_current=true
       and anchor_timesheet.archived_at_utc is null
       and anchor_timesheet.sheet_scope='WEEKLY'::public.timesheet_scope_enum
      where week_row.timesheet_id=v_workflow.anchor_timesheet_id
        and week_row.contract_id=v_workflow.contract_id
        and week_row.week_ending_date=v_workflow.week_ending_date
      for update of week_row,anchor_timesheet;
      if not found then raise exception 'CANDIDATE_WORKFLOW_ANCHOR_MISMATCH' using errcode='40001'; end if;
      v_route_authority:=private._expense_approval_route_v1(v_workflow.anchor_timesheet_id,v_anchor_week.id,v_workflow.workflow_kind);
      if not coalesce((v_route_authority->>'candidate_expenses_allowed')::boolean,false)
         or (v_workflow.route='PAPER' and not coalesce((v_route_authority->>'candidate_paper_submission_allowed')::boolean,false))
         or (v_workflow.route<>'PAPER' and v_route_authority->>'route_family' not in ('ELECTRONIC','IMPORT_AUTHORITATIVE','QR')) then
        raise exception 'CANDIDATE_ROUTE_FAMILY_MISMATCH' using errcode='55000',detail=v_route_authority::text;
      end if;
    end if;
    if exists(
      select 1
      from (values
        (v_immutable_submission#>>'{canonical_tsfin_snapshot,candidate_id}'),
        (v_immutable_submission#>>'{hours_submission,canonical_tsfin_snapshot,candidate_id}'),
        (v_immutable_submission#>>'{expense_submission,canonical_tsfin_snapshot,candidate_id}')
      ) supplied(candidate_id_text)
      where nullif(supplied.candidate_id_text,'') is not null
        and supplied.candidate_id_text::uuid<>v_workflow.candidate_id
    ) or exists(
      select 1
      from (values
        (v_immutable_submission#>>'{canonical_tsfin_snapshot,client_id}'),
        (v_immutable_submission#>>'{hours_submission,canonical_tsfin_snapshot,client_id}'),
        (v_immutable_submission#>>'{expense_submission,canonical_tsfin_snapshot,client_id}')
      ) supplied(client_id_text)
      where nullif(supplied.client_id_text,'') is not null
        and supplied.client_id_text::uuid<>coalesce(v_contract.client_id,v_daily_fin.client_id)
    ) then
      raise exception 'CANDIDATE_IMMUTABLE_SUBMISSION_IDENTITY_MISMATCH' using errcode='22023';
    end if;
    if v_workflow.workflow_kind='DAILY' and exists(
      select 1
      from jsonb_array_elements(coalesce(
        v_immutable_submission#>'{timesheet_patch_json,actual_schedule_json}',
        v_immutable_submission#>'{hours_submission,timesheet_patch_json,actual_schedule_json}',
        '[]'::jsonb
      )) schedule_row
      where nullif(schedule_row->>'date','') is null
         or (schedule_row->>'date')::date<>v_workflow.work_date
    ) then
      raise exception 'CANDIDATE_DAILY_SHIFT_IDENTITY_MISMATCH' using errcode='22023';
    elsif v_workflow.scope='WEEKLY' and exists(
      select 1
      from jsonb_array_elements(coalesce(
        v_immutable_submission#>'{timesheet_patch_json,actual_schedule_json}',
        v_immutable_submission#>'{hours_submission,timesheet_patch_json,actual_schedule_json}',
        '[]'::jsonb
      )) schedule_row
      where nullif(schedule_row->>'date','') is null
         or (schedule_row->>'date')::date not between v_workflow.week_ending_date-6 and v_workflow.week_ending_date
    ) then
      raise exception 'CANDIDATE_WEEK_DATE_OUT_OF_RANGE' using errcode='22023';
    end if;
    v_submission_hash:=private._candidate_sha256_jsonb_v1(v_immutable_submission);
    v_expense_submission:=case
      when v_workflow.workflow_kind='CONTRACT_COMBINED'
        and jsonb_typeof(v_immutable_submission->'expense_submission')='object'
        then v_immutable_submission->'expense_submission'
      else v_immutable_submission
    end;
    begin
      v_expense_value:=
        abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,expenses_pay_ex_vat}','')::numeric,0))+
        abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,expenses_charge_ex_vat}','')::numeric,0))+
        abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,mileage_pay_ex_vat}','')::numeric,0))+
        abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,mileage_charge_ex_vat}','')::numeric,0))+
        abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,mileage_units}','')::numeric,0))+
        abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,travel_pay_ex_vat}','')::numeric,0))+
        abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,travel_charge_ex_vat}','')::numeric,0))+
        abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,accommodation_pay_ex_vat}','')::numeric,0))+
        abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,accommodation_charge_ex_vat}','')::numeric,0))+
        abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,other_pay_ex_vat}','')::numeric,0))+
        abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,other_charge_ex_vat}','')::numeric,0));
      v_has_mileage:=
        abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,mileage_units}','')::numeric,0))>0
        or abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,mileage_pay_ex_vat}','')::numeric,0))>0
        or abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,mileage_charge_ex_vat}','')::numeric,0))>0;
      v_required_categories:=array[]::text[];
      if abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,travel_pay_ex_vat}','')::numeric,0))>0
         or abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,travel_charge_ex_vat}','')::numeric,0))>0 then
        v_required_categories:=array_append(v_required_categories,'TRAVEL');
      end if;
      if abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,accommodation_pay_ex_vat}','')::numeric,0))>0
         or abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,accommodation_charge_ex_vat}','')::numeric,0))>0 then
        v_required_categories:=array_append(v_required_categories,'ACCOMMODATION');
      end if;
      if abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,other_pay_ex_vat}','')::numeric,0))>0
         or abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,other_charge_ex_vat}','')::numeric,0))>0
         or (
           (
             abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,expenses_pay_ex_vat}','')::numeric,0))>0
             or abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,expenses_charge_ex_vat}','')::numeric,0))>0
           )
           and (
             abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,travel_pay_ex_vat}','')::numeric,0))
             +abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,travel_charge_ex_vat}','')::numeric,0))
             +abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,accommodation_pay_ex_vat}','')::numeric,0))
             +abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,accommodation_charge_ex_vat}','')::numeric,0))
             +abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,other_pay_ex_vat}','')::numeric,0))
             +abs(coalesce(nullif(v_expense_submission#>>'{canonical_tsfin_snapshot,other_charge_ex_vat}','')::numeric,0))
           )=0
         ) then
        v_required_categories:=array_append(v_required_categories,'OTHER');
      end if;
      if v_has_mileage then
        v_required_categories:=array_append(v_required_categories,'MILEAGE');
      end if;
    exception when invalid_text_representation or numeric_value_out_of_range then
      raise exception 'CANDIDATE_EXPENSE_VALUE_INVALID' using errcode='22023';
    end;
    v_has_expenses:=v_expense_value>0;
    if v_workflow.workflow_kind in ('CONTRACT_HOURS','DAILY') and v_has_expenses then
      raise exception 'CANDIDATE_WORKFLOW_KIND_ECONOMICS_MISMATCH' using errcode='22023';
    end if;
    if v_workflow.workflow_kind in ('CONTRACT_COMBINED','CONTRACT_EXPENSE') and not v_has_expenses then
      raise exception 'CANDIDATE_EXPENSE_CLAIM_REQUIRED' using errcode='22023';
    end if;
    v_server_issue_codes:=private._candidate_submission_issue_codes_v1(
      v_workflow.id,v_immutable_submission,v_policy
    );
    v_duplicate_expense_review:=case
      when v_workflow.workflow_kind in ('CONTRACT_COMBINED','CONTRACT_EXPENSE')
       and cardinality(v_required_categories)>0
      then private._expense_duplicate_review_v1(v_workflow.id,v_required_categories)
      else jsonb_build_object(
        'required',false,
        'categories','[]'::jsonb,
        'prior_claim_count',0,
        'confirmation_digest',null
      )
    end;
    if coalesce((v_duplicate_expense_review->>'required')::boolean,false) then
      if not v_is_pending_expense_update and (
         lower(coalesce(v_payload#>>'{duplicate_expense_confirmation,confirmed}','false'))
           not in ('true','t','1','yes')
         or nullif(v_payload#>>'{duplicate_expense_confirmation,confirmation_digest}','')
              is distinct from v_duplicate_expense_review->>'confirmation_digest') then
        raise exception 'CANDIDATE_DUPLICATE_EXPENSE_CONFIRMATION_REQUIRED'
          using errcode='PT409',detail=v_duplicate_expense_review::text;
      end if;
      v_server_issue_codes:=v_server_issue_codes||jsonb_build_array('DUPLICATE_EXPENSE_REVIEW');
      for v_duplicate_expense_category in
        select jsonb_array_elements_text(v_duplicate_expense_review->'categories')
      loop
        v_server_issue_codes:=v_server_issue_codes
          ||jsonb_build_array('DUPLICATE_EXPENSE_'||v_duplicate_expense_category);
      end loop;
      select coalesce(jsonb_agg(distinct issue_code order by issue_code),'[]'::jsonb)
      into v_server_issue_codes
      from jsonb_array_elements_text(v_server_issue_codes) issue_code;
    end if;
    update public.candidate_approval_requests set
      state='SUPERSEDED',superseded_at_utc=p_now_utc,updated_at_utc=p_now_utc
    where workflow_id=v_workflow.id and state in ('PENDING','APPROVED')
      and not exists (
        select 1 from public.candidate_pending_expense_updates pending_update
        where pending_update.workflow_id=v_workflow.id
          and pending_update.state in ('EDITING','RENDERING')
      );

    if v_is_electronic then
      v_component_no:=0;
      v_review_ordinal:=0;
      if v_workflow.workflow_kind<>'CONTRACT_EXPENSE' then
        select * into v_source_component
        from public.candidate_submission_components
        where id=nullif(v_payload->>'candidate_signature_component_id','')::uuid
          and workflow_id=v_workflow.id and component_kind='CANDIDATE_SIGNATURE'
          and document_role='CANDIDATE_SIGNATURE' and state='IMMUTABLE'
          and source_content_sha256 is not null
          and (
            v_workflow.immutable_submission_sha256 is null
            or v_workflow.immutable_submission_sha256=v_submission_hash
            or (
              v_is_pending_expense_update
              and id=v_workflow.candidate_signature_component_id
              and exists(
                select 1
                from public.candidate_submission_components current_hours
                join public.candidate_submission_components prior_hours
                  on prior_hours.workflow_id=current_hours.workflow_id
                  and prior_hours.workflow_generation=
                    v_pending_expense_update.from_workflow_generation
                  and prior_hours.component_kind='HOURS_TIMESHEET'
                  and prior_hours.state='IMMUTABLE'
                  and prior_hours.source_content_sha256=current_hours.source_content_sha256
                where current_hours.workflow_id=v_workflow.id
                  and current_hours.workflow_generation=v_workflow.generation
                  and current_hours.component_kind='HOURS_TIMESHEET'
                  and current_hours.state='IMMUTABLE'
              )
            )
            or (
              source_component_id is null
              and created_at_utc>=coalesce(v_workflow.worker_submitted_at_utc,'-infinity'::timestamptz)
            )
          )
        for update;
        if not found then
          if v_workflow.immutable_submission_sha256 is not null
             and v_workflow.immutable_submission_sha256<>v_submission_hash then
            raise exception 'CANDIDATE_SIGNATURE_REQUIRED_AFTER_AMENDMENT' using errcode='55000';
          end if;
          raise exception 'CANDIDATE_SIGNATURE_REQUIRED' using errcode='55000';
        end if;
        v_component_no:=v_component_no+1;
        insert into public.candidate_submission_components(
          workflow_id,workflow_generation,component_no,timesheet_id,component_kind,document_role,state,
          source_component_id,storage_key,media_type,byte_size,source_content_sha256,immutable_at_utc,
          required,review_ordinal,review_render_state,final_signed_render_state,created_at_utc
        ) values (
          v_workflow.id,v_next_generation,v_component_no,v_workflow.target_timesheet_id,
          'CANDIDATE_SIGNATURE','CANDIDATE_SIGNATURE','IMMUTABLE',
          coalesce(v_source_component.source_component_id,v_source_component.id),v_source_component.storage_key,
          v_source_component.media_type,v_source_component.byte_size,v_source_component.source_content_sha256,p_now_utc,
          false,null,'NOT_REQUIRED','NOT_REQUIRED',p_now_utc
        ) returning * into v_signature_component;
        v_component_no:=v_component_no+1;
        v_review_ordinal:=v_review_ordinal+1;
        insert into public.candidate_submission_components(
          workflow_id,workflow_generation,component_no,timesheet_id,component_kind,document_role,state,
          immutable_at_utc,required,review_ordinal,review_render_state,final_signed_render_state,created_at_utc
        ) values (
          v_workflow.id,v_next_generation,v_component_no,v_workflow.target_timesheet_id,'HOURS_TIMESHEET',
          'ELECTRONIC_TIMESHEET_MANAGER_REVIEW','IMMUTABLE',p_now_utc,true,v_review_ordinal,
          'PENDING','PENDING',p_now_utc
        ) returning * into v_component;
      elsif nullif(v_payload->>'candidate_signature_component_id','') is not null then
        raise exception 'CONTRACT_EXPENSE_CANDIDATE_SIGNATURE_FORBIDDEN' using errcode='22023';
      end if;

      if v_workflow.workflow_kind in ('CONTRACT_COMBINED','CONTRACT_EXPENSE') then
        foreach v_required_category in array v_required_categories loop
          if not exists(
            select 1 from public.candidate_submission_components source_component
            where source_component.workflow_id=v_workflow.id
              and source_component.workflow_generation=v_workflow.generation
              and source_component.component_kind in ('EXPENSE_EVIDENCE','MILEAGE_FORM')
              and source_component.expense_category=v_required_category
              and source_component.state='IMMUTABLE'
              and source_component.source_content_sha256 is not null
          ) then raise exception 'EXPENSE_EVIDENCE_REQUIRED'
            using errcode='22023',detail=jsonb_build_object('category',v_required_category)::text; end if;
        end loop;
        if v_has_mileage and not exists(
          select 1 from public.candidate_submission_components source_component
          where source_component.workflow_id=v_workflow.id
            and source_component.workflow_generation=v_workflow.generation
            and source_component.component_kind='MILEAGE_FORM'
            and source_component.state='IMMUTABLE'
            and source_component.source_content_sha256 is not null
        ) then raise exception 'EXPENSE_EVIDENCE_REQUIRED'
          using errcode='22023',detail=jsonb_build_object('category','MILEAGE')::text; end if;

        v_component_no:=v_component_no+1;
        insert into public.candidate_submission_components(
          workflow_id,workflow_generation,component_no,timesheet_id,component_kind,document_role,state,
          immutable_at_utc,required,review_ordinal,review_render_state,final_signed_render_state,created_at_utc
        ) values (
          v_workflow.id,v_next_generation,v_component_no,v_workflow.target_timesheet_id,'EXPENSE_SUMMARY',
          'EXPENSE_MILEAGE_APPROVAL_SUMMARY','IMMUTABLE',p_now_utc,false,null,
          'NOT_REQUIRED','NOT_REQUIRED',p_now_utc
        );

        for v_source_component in
          select canonical_source.*
          from (
            select distinct on (
              source_component.component_kind,source_component.expense_category,
              source_component.document_role,
              coalesce(source_component.source_component_id,source_component.id),
              source_component.source_content_sha256
            ) source_component.*
            from public.candidate_submission_components source_component
            where source_component.workflow_id=v_workflow.id
              and source_component.workflow_generation=v_workflow.generation
              and source_component.component_kind in ('MILEAGE_FORM','EXPENSE_EVIDENCE')
              and source_component.state='IMMUTABLE'
              and source_component.source_content_sha256 is not null
            order by source_component.component_kind,source_component.expense_category,
              source_component.document_role,
              coalesce(source_component.source_component_id,source_component.id),
              source_component.source_content_sha256,
              source_component.component_no,source_component.id
          ) canonical_source
          order by case canonical_source.component_kind when 'MILEAGE_FORM' then 0 else 1 end,
            case canonical_source.expense_category
              when 'ACCOMMODATION' then 1 when 'TRAVEL' then 2 when 'MILEAGE' then 3
              when 'OTHER' then 4 else 5 end,
            canonical_source.component_no,canonical_source.id
        loop
          v_component_no:=v_component_no+1;
          v_review_ordinal:=v_review_ordinal+1;
          insert into public.candidate_submission_components(
            workflow_id,workflow_generation,component_no,timesheet_id,component_kind,expense_category,
            document_role,state,source_component_id,storage_key,media_type,byte_size,source_content_sha256,
            immutable_at_utc,required,review_ordinal,review_render_state,final_signed_render_state,created_at_utc
          ) values (
            v_workflow.id,v_next_generation,v_component_no,v_workflow.target_timesheet_id,
            v_source_component.component_kind,v_source_component.expense_category,v_source_component.document_role,
            'IMMUTABLE',coalesce(v_source_component.source_component_id,v_source_component.id),
            v_source_component.storage_key,v_source_component.media_type,v_source_component.byte_size,
            v_source_component.source_content_sha256,p_now_utc,true,v_review_ordinal,'PENDING','PENDING',p_now_utc
          );
        end loop;
      end if;

      update public.candidate_submission_components set
        state='SUPERSEDED',superseded_at_utc=p_now_utc,
        review_render_state=case when review_render_state='NOT_REQUIRED' then review_render_state else 'SUPERSEDED' end,
        final_signed_render_state=case when final_signed_render_state='NOT_REQUIRED' then final_signed_render_state else 'SUPERSEDED' end
      where workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
        and (required=true or document_role='MANAGER_SIGNATURE') and state<>'SUPERSEDED'
        and not exists(
          select 1 from public.candidate_pending_expense_updates pending_update
          where pending_update.workflow_id=v_workflow.id
            and pending_update.state in ('EDITING','RENDERING')
        );

      update public.candidate_submission_workflows set
        state='WORKER_SUBMITTED_PENDING_REVIEW_DOCUMENT',generation=v_next_generation,
        route=case when upper(coalesce(v_payload->>'approval_route',route)) in ('PHONE','EMAIL')
          then upper(coalesce(v_payload->>'approval_route',route)) else 'ELECTRONIC' end,
        input_snapshot_json=v_immutable_submission,immutable_submission_json=v_immutable_submission,
        immutable_submission_sha256=v_submission_hash,
        policy_snapshot_json=v_policy,policy_snapshot_sha256=private._candidate_sha256_jsonb_v1(v_policy),
        candidate_signature_component_id=case when workflow_kind='CONTRACT_EXPENSE' then null else v_signature_component.id end,
        candidate_signature_sha256=case when workflow_kind='CONTRACT_EXPENSE' then null else v_signature_component.source_content_sha256 end,
        candidate_signed_at_utc=case when workflow_kind='CONTRACT_EXPENSE' then null
          when v_is_pending_expense_update then nullif(
            v_pending_expense_update.prior_workflow_snapshot_json->>'candidate_signed_at_utc',''
          )::timestamptz
          else coalesce(nullif(v_payload->>'candidate_signed_at_utc','')::timestamptz,p_now_utc) end,
        renderer_contract_version=coalesce(nullif(btrim(v_payload->>'renderer_contract_version'),''),'TIMESHEET_OFFICIAL_PDF_V1'),
        review_manifest_json=null,review_manifest_sha256=null,
        manager_name=null,manager_position=null,manager_signature_component_id=null,
        manager_signature_sha256=null,manager_approved_at_utc=null,
        issue_codes=v_server_issue_codes,worker_submitted_at_utc=p_now_utc,
        daily_context_sha256=null,canonical_financial_sha256=null,
        canonical_save_input_sha256=null,canonical_save_row_signature=null,
        canonical_save_financials_id=null,canonical_save_receipt_json=null,canonical_saved_at_utc=null,
        last_mutation_idempotency_key=p_idempotency_key,updated_at_utc=p_now_utc
      where id=v_workflow.id returning * into v_workflow;
      v_render_contract:=private._candidate_render_contract_v1(
        v_workflow.id,v_workflow.generation,'ELECTRONIC_MANAGER_REVIEW');
      v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,
        'state',v_workflow.state,'generation',v_workflow.generation,
        'review_document_component_id',case when v_workflow.workflow_kind='CONTRACT_EXPENSE' then null else v_component.id end,
        'render_contract',v_render_contract,'idempotent_replay',false);
    else
      v_component_no:=0;
      if v_workflow.workflow_kind in ('CONTRACT_COMBINED','CONTRACT_EXPENSE') then
        foreach v_required_category in array v_required_categories loop
          if not exists(
            select 1 from public.candidate_submission_components source_component
            where source_component.workflow_id=v_workflow.id
              and source_component.workflow_generation=v_workflow.generation
              and source_component.component_kind in ('EXPENSE_EVIDENCE','MILEAGE_FORM')
              and source_component.expense_category=v_required_category
              and source_component.state='IMMUTABLE'
              and source_component.source_content_sha256 is not null
          ) then raise exception 'EXPENSE_EVIDENCE_REQUIRED'
            using errcode='22023',detail=jsonb_build_object('category',v_required_category)::text; end if;
        end loop;
        if v_has_mileage and not exists(
          select 1 from public.candidate_submission_components source_component
          where source_component.workflow_id=v_workflow.id
            and source_component.workflow_generation=v_workflow.generation
            and source_component.component_kind='MILEAGE_FORM'
            and source_component.expense_category='MILEAGE'
            and source_component.state='IMMUTABLE'
            and source_component.source_content_sha256 is not null
        ) then raise exception 'EXPENSE_EVIDENCE_REQUIRED'
          using errcode='22023',detail=jsonb_build_object('category','MILEAGE')::text; end if;

        for v_source_component in
          select canonical_source.*
          from (
            select distinct on (
              source_component.component_kind,source_component.expense_category,
              source_component.document_role,
              coalesce(source_component.source_component_id,source_component.id),
              source_component.source_content_sha256
            ) source_component.*
            from public.candidate_submission_components source_component
            where source_component.workflow_id=v_workflow.id
              and source_component.workflow_generation=v_workflow.generation
              and source_component.component_kind in ('MILEAGE_FORM','EXPENSE_EVIDENCE')
              and source_component.state='IMMUTABLE'
              and source_component.source_content_sha256 is not null
            order by source_component.component_kind,source_component.expense_category,
              source_component.document_role,
              coalesce(source_component.source_component_id,source_component.id),
              source_component.source_content_sha256,
              source_component.component_no,source_component.id
          ) canonical_source
          order by case canonical_source.component_kind when 'MILEAGE_FORM' then 0 else 1 end,
            canonical_source.component_no,canonical_source.id
        loop
          v_component_no:=v_component_no+1;
          insert into public.candidate_submission_components(
            workflow_id,workflow_generation,component_no,timesheet_id,component_kind,expense_category,
            document_role,state,source_component_id,storage_key,media_type,byte_size,source_content_sha256,
            immutable_at_utc,required,review_ordinal,review_render_state,final_signed_render_state,created_at_utc
          ) values (
            v_workflow.id,v_next_generation,v_component_no,v_workflow.target_timesheet_id,
            v_source_component.component_kind,v_source_component.expense_category,v_source_component.document_role,
            'IMMUTABLE',coalesce(v_source_component.source_component_id,v_source_component.id),
            v_source_component.storage_key,v_source_component.media_type,v_source_component.byte_size,
            v_source_component.source_content_sha256,p_now_utc,false,null,'NOT_REQUIRED','NOT_REQUIRED',p_now_utc
          );
        end loop;
      end if;
      update public.candidate_submission_components set
        state='SUPERSEDED',superseded_at_utc=p_now_utc,
        review_render_state=case when review_render_state='NOT_REQUIRED' then review_render_state else 'SUPERSEDED' end,
        final_signed_render_state=case when final_signed_render_state='NOT_REQUIRED' then final_signed_render_state else 'SUPERSEDED' end
      where workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
        and (required=true or document_role='MANAGER_SIGNATURE') and state<>'SUPERSEDED'
        and not exists(
          select 1 from public.candidate_pending_expense_updates pending_update
          where pending_update.workflow_id=v_workflow.id
            and pending_update.state in ('EDITING','RENDERING')
        );
      update public.candidate_submission_workflows set
        state='WORKER_SUBMITTED',generation=v_next_generation,route='PAPER',
        input_snapshot_json=v_immutable_submission,immutable_submission_json=v_immutable_submission,
        immutable_submission_sha256=private._candidate_sha256_jsonb_v1(v_immutable_submission),
        policy_snapshot_json=v_policy,policy_snapshot_sha256=private._candidate_sha256_jsonb_v1(v_policy),
        paper_return_manifest_json=null,paper_return_manifest_sha256=null,
        issue_codes=v_server_issue_codes,worker_submitted_at_utc=p_now_utc,
        daily_context_sha256=null,canonical_financial_sha256=null,
        canonical_save_input_sha256=null,canonical_save_row_signature=null,
        canonical_save_financials_id=null,canonical_save_receipt_json=null,canonical_saved_at_utc=null,
        last_mutation_idempotency_key=p_idempotency_key,updated_at_utc=p_now_utc
      where id=v_workflow.id returning * into v_workflow;
      v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,
        'state',v_workflow.state,'generation',v_workflow.generation,'idempotent_replay',false);
    end if;
    update public.candidate_submission_workflows
    set last_mutation_response_json=v_response where id=v_workflow.id;

    -- The unchanged native owner has now stored the immutable HOURS claim,
    -- its real Candidate signature and artifact generation. No Weekly upload
    -- or publication is required to prepare genuine signed-client metadata.
    if v_checklist_cycle_admission->'applies'='true'::jsonb then
      if v_workflow.target_timesheet_id is distinct from (v_checklist_cycle_admission->>'timesheet_id')::uuid then
        raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_WORKFLOW_STALE' using errcode='40001';
      end if;
      perform private.weekly_source_checklist_submission_cycle_prepare_v1(v_workflow.target_timesheet_id,null);
    end if;

  elsif v_action='REGISTER_REVIEW_COMPONENT' then
    if v_workflow.state not in ('WORKER_SUBMITTED_PENDING_REVIEW_DOCUMENT','READY_FOR_MANAGER_APPROVAL') then
      raise exception 'MANAGER_REVIEW_DOCUMENT_STALE' using errcode='55000';
    end if;
    select * into v_component from public.candidate_submission_components
    where id=nullif(v_payload->>'component_id','')::uuid
      and workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
      and required=true and state<>'SUPERSEDED' for update;
    if not found then raise exception 'MANAGER_REVIEW_DOCUMENT_STALE' using errcode='55000'; end if;
    if coalesce(v_payload->>'content_sha256_hex','') !~ '^[0-9a-fA-F]{64}$'
       or coalesce(v_payload->>'render_input_sha256_hex','') !~ '^[0-9a-fA-F]{64}$' then
      raise exception 'MANAGER_REVIEW_RENDER_FAILED' using errcode='22023',
        detail=jsonb_build_object(
          'component_id',v_component.id,
          'expected_contract',v_render_contract,
          'received_receipt',v_receipt,
          'received_render_input_sha256',lower(coalesce(v_payload->>'render_input_sha256_hex',''))
        )::text;
    end if;
    v_digest:=decode(v_payload->>'content_sha256_hex','hex');
    v_render_input_hash:=decode(v_payload->>'render_input_sha256_hex','hex');
    v_receipt:=coalesce(v_payload->'renderer_receipt','{}'::jsonb);
    v_render_contract:=private._candidate_component_render_contract_v1(
      v_workflow.id,v_workflow.generation,v_component.id,'REVIEW');
    if v_render_input_hash<>decode(v_render_contract->>'render_input_sha256','hex')
       or nullif(btrim(v_payload->>'storage_key'),'') is null
       or lower(coalesce(v_payload->>'media_type','')) not in ('application/pdf','image/jpeg','image/png','image/webp')
       or coalesce((v_payload->>'page_count')::integer,0)<>1
       or coalesce((v_payload->>'byte_size')::bigint,0)<=0
       or upper(coalesce(v_receipt->>'form_variant',''))<>v_render_contract->>'form_variant'
       or nullif(v_receipt->>'workflow_id','')::uuid is distinct from v_workflow.id
       or coalesce((v_receipt->>'workflow_generation')::integer,0)<>v_workflow.generation
       or nullif(v_receipt->>'component_id','')::uuid is distinct from v_component.id
       or upper(coalesce(v_receipt->>'component_kind',''))<>v_component.component_kind
       or upper(coalesce(v_receipt->>'document_role',''))<>v_component.document_role
       or coalesce((v_receipt->>'review_ordinal')::integer,0)<>v_component.review_ordinal
       or upper(coalesce(v_receipt->>'scope',''))<>v_workflow.scope
       or coalesce((v_receipt->>'candidate_signature_embedded')::boolean,false)
          is distinct from (v_component.component_kind='HOURS_TIMESHEET')
       or coalesce((v_receipt->>'manager_signature_embedded')::boolean,false)=true
       or coalesce((v_receipt->>'manager_approval_date_embedded')::boolean,false)=true
       or coalesce((v_receipt->>'page_count')::integer,0)<>1
       or lower(coalesce(v_receipt->>'render_input_sha256',''))<>encode(v_render_input_hash,'hex') then
      raise exception 'MANAGER_REVIEW_RENDER_FAILED' using errcode='22023',
        detail=jsonb_build_object(
          'component_id',v_component.id,
          'expected_contract',v_render_contract,
          'received_receipt',v_receipt,
          'received_render_input_sha256',lower(coalesce(v_payload->>'render_input_sha256_hex',''))
        )::text;
    end if;
    if v_component.review_render_state='READY' then
      if v_component.review_storage_key=v_payload->>'storage_key'
         and v_component.review_content_sha256=v_digest
         and v_component.review_render_input_sha256=v_render_input_hash then
        v_response:=jsonb_build_object('ok',true,'idempotent_replay',true,
          'workflow_id',v_workflow.id,'generation',v_workflow.generation,
          'component_id',v_component.id,'state',v_workflow.state);
        if v_mutation_request_sha256 is not null then
          perform private._candidate_workflow_mutation_receipt_v1(
            v_workflow.id,p_idempotency_key,v_mutation_request_sha256,v_action,
            v_mutation_channel,v_mutation_actor_identity,v_response,p_now_utc
          );
        end if;
        return v_response;
      end if;
      raise exception 'MANAGER_REVIEW_DOCUMENT_STALE' using errcode='55000';
    end if;
    update public.candidate_submission_components set
      review_storage_key=v_payload->>'storage_key',review_content_sha256=v_digest,
      review_media_type=lower(v_payload->>'media_type'),review_byte_size=(v_payload->>'byte_size')::bigint,
      review_page_count=1,review_render_input_sha256=v_render_input_hash,
      review_renderer_contract_version=coalesce(nullif(v_payload->>'renderer_contract_version',''),v_workflow.renderer_contract_version),
      review_renderer_receipt_json=v_receipt,review_generated_at_utc=p_now_utc,
      review_render_state='READY'
    where id=v_component.id returning * into v_component;
    if v_worker_only_approval then
      if v_component.component_kind<>'HOURS_TIMESHEET'
         or v_render_contract->>'form_variant'<>'ELECTRONIC_WORKER_SIGNED'
         or v_receipt->>'form_variant'<>'ELECTRONIC_WORKER_SIGNED'
         or v_receipt->>'candidate_signature_sha256' is distinct from encode(v_workflow.candidate_signature_sha256,'hex')
         or coalesce((v_receipt->>'manager_signature_embedded')::boolean,false)
         or coalesce((v_receipt->>'manager_approval_date_embedded')::boolean,false) then
        raise exception 'CANDIDATE_WORKER_ONLY_DOCUMENT_INVALID' using errcode='55000';
      end if;
      update public.candidate_submission_components set
        final_signed_storage_key=review_storage_key,final_signed_content_sha256=review_content_sha256,
        final_signed_media_type=review_media_type,final_signed_byte_size=review_byte_size,
        final_signed_page_count=review_page_count,final_signed_render_input_sha256=review_render_input_sha256,
        final_signed_renderer_contract_version=review_renderer_contract_version,
        final_signed_renderer_receipt_json=review_renderer_receipt_json,
        final_signed_generated_at_utc=review_generated_at_utc,final_signed_render_state='READY'
      where id=v_component.id returning * into v_component;
    end if;
    v_manifest:=private._candidate_review_manifest_v1(v_workflow.id,v_workflow.generation);
    if coalesce((v_manifest->>'all_ready')::boolean,false) then
      update public.candidate_submission_workflows set
        state=case when v_worker_only_approval then 'READY_TO_FINALISE' else 'READY_FOR_MANAGER_APPROVAL' end,review_manifest_json=v_manifest,
        review_manifest_sha256=decode(v_manifest->>'manifest_sha256','hex'),
        last_mutation_idempotency_key=p_idempotency_key,updated_at_utc=p_now_utc
      where id=v_workflow.id returning * into v_workflow;
    end if;
    v_response:=jsonb_build_object('ok',true,'idempotent_replay',false,
      'workflow_id',v_workflow.id,'state',v_workflow.state,'generation',v_workflow.generation,
      'component_id',v_component.id,'review_document_ready',v_component.review_render_state='READY',
      'review_manifest',v_manifest)||case when v_worker_only_approval
        then jsonb_build_object('worker_only_approval',true) else '{}'::jsonb end;
    update public.candidate_submission_workflows set last_mutation_response_json=v_response where id=v_workflow.id;

  elsif v_action in ('SELECT_PHONE_APPROVAL','CREATE_EMAIL_APPROVAL_REQUEST') then
    if v_worker_only_approval then
      raise exception 'CANDIDATE_MANAGER_APPROVAL_NOT_REQUIRED' using errcode='55000';
    end if;
    if v_workflow.state not in ('READY_FOR_MANAGER_APPROVAL','AWAITING_MANAGER_APPROVAL') then
      raise exception 'MANAGER_REVIEW_DOCUMENT_NOT_READY' using errcode='55000';
    end if;
    v_manifest:=private._candidate_review_manifest_v1(v_workflow.id,v_workflow.generation);
    if coalesce((v_manifest->>'all_ready')::boolean,false)=false
       or decode(v_manifest->>'manifest_sha256','hex') is distinct from v_workflow.review_manifest_sha256 then
      raise exception 'MANAGER_REVIEW_DOCUMENT_NOT_READY' using errcode='55000';
    end if;
    select array_agg(c.id order by c.review_ordinal,c.id) into v_component_ids
    from public.candidate_submission_components c
    where c.workflow_id=v_workflow.id and c.workflow_generation=v_workflow.generation
      and c.required=true and c.state<>'SUPERSEDED';
    select coalesce(max(request_generation),0)+1 into v_request_generation
    from public.candidate_approval_requests where workflow_id=v_workflow.id;
    update public.candidate_approval_requests set
      state='SUPERSEDED',superseded_at_utc=p_now_utc,updated_at_utc=p_now_utc
    where workflow_id=v_workflow.id and state='PENDING';
    if v_action='CREATE_EMAIL_APPROVAL_REQUEST' then
      if coalesce(v_payload->>'approval_token_hash_hex','') !~ '^[0-9a-fA-F]{64}$' then
        raise exception 'CANDIDATE_APPROVAL_TOKEN_INVALID' using errcode='22023';
      end if;
      v_token_hash:=decode(v_payload->>'approval_token_hash_hex','hex');
      v_email_check:=private._candidate_manager_email_allowed_v1(
        v_policy->'manager_approval_policy',v_payload->>'manager_email',
        v_policy->'barred_manager_email_domains');
      if coalesce((v_email_check->>'allowed')::boolean,false)=false then
        raise exception 'MANAGER_EMAIL_NOT_ALLOWED' using errcode='22023',detail=v_email_check::text;
      end if;
      insert into public.candidate_approval_requests(
        workflow_id,workflow_generation,request_generation,method,state,manager_email_normalized,
        token_hash,expires_at_utc,initial_sent_at_utc,last_sent_at_utc,next_reminder_at_utc,
        review_manifest_sha256,required_component_ids,required_component_manifest_json,
        manager_review_timesheet_component_id,manager_review_timesheet_sha256,
        idempotency_key,created_at_utc,updated_at_utc
      ) values (
        v_workflow.id,v_workflow.generation,v_request_generation,'EMAIL','PENDING',
        v_email_check->>'email_normalized',v_token_hash,p_now_utc+interval '7 days',
        null,null,null,
        decode(v_manifest->>'manifest_sha256','hex'),v_component_ids,v_manifest->'required_components',
        nullif(v_manifest->>'manager_review_timesheet_component_id','')::uuid,
        case when nullif(v_manifest->>'manager_review_timesheet_sha256','') is null then null
          else decode(v_manifest->>'manager_review_timesheet_sha256','hex') end,
        p_idempotency_key,p_now_utc,p_now_utc
      ) returning * into v_approval;
      v_mail_id:=private._candidate_queue_mail_v1(
        coalesce(v_payload->'mail','{}'::jsonb)||jsonb_build_object(
          'payment_scope_json',jsonb_build_object(
            'candidate_mail_authority','MANAGER_APPROVAL_V1',
            'candidate_manager_mail_kind','INITIAL',
            'candidate_manager_workflow_id',v_workflow.id,
            'candidate_manager_workflow_generation',v_workflow.generation,
            'candidate_approval_request_id',v_approval.id,
            'candidate_approval_request_generation',v_approval.request_generation,
            'candidate_manager_mail_retired',false
          )
        ),v_approval.manager_email_normalized,
        'CANDIDATE_MANAGER_APPROVAL_V1:'||v_approval.id::text||':0',
        'candidate-manager-approval:'||v_approval.id::text,v_workflow.id,p_now_utc);
    else
      if coalesce(v_payload->>'approval_token_hash_hex','') !~ '^[0-9a-fA-F]{64}$'
         or nullif(v_payload->>'expires_at_utc','')::timestamptz<=p_now_utc
         or nullif(v_payload->>'expires_at_utc','')::timestamptz>p_now_utc+interval '2 hours' then
        raise exception 'CANDIDATE_APPROVAL_TOKEN_INVALID' using errcode='22023';
      end if;
      v_token_hash:=decode(v_payload->>'approval_token_hash_hex','hex');
      insert into public.candidate_approval_requests(
        workflow_id,workflow_generation,request_generation,method,state,token_hash,expires_at_utc,
        review_manifest_sha256,required_component_ids,required_component_manifest_json,
        manager_review_timesheet_component_id,manager_review_timesheet_sha256,
        idempotency_key,created_at_utc,updated_at_utc
      ) values (
        v_workflow.id,v_workflow.generation,v_request_generation,'PHONE','PENDING',v_token_hash,
        nullif(v_payload->>'expires_at_utc','')::timestamptz,
        decode(v_manifest->>'manifest_sha256','hex'),v_component_ids,v_manifest->'required_components',
        nullif(v_manifest->>'manager_review_timesheet_component_id','')::uuid,
        case when nullif(v_manifest->>'manager_review_timesheet_sha256','') is null then null
          else decode(v_manifest->>'manager_review_timesheet_sha256','hex') end,
        p_idempotency_key,p_now_utc,p_now_utc
      ) returning * into v_approval;
    end if;
    v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,
      'state','AWAITING_MANAGER_APPROVAL','generation',v_workflow.generation,
      'approval_request_id',v_approval.id,'approval_request_generation',v_approval.request_generation,
      'method',v_approval.method,
      'review_manifest_sha256',encode(v_approval.review_manifest_sha256,'hex'),
      'issued_at_utc',v_approval.created_at_utc,
      'expires_at_utc',v_approval.expires_at_utc,'mail_outbox_id',v_mail_id);
    if v_action='SELECT_PHONE_APPROVAL' then
      if coalesce(v_payload->>'handoff_token_key_version','') !~ '^[1-9][0-9]{0,2}$'
         or (v_payload->>'handoff_token_key_version')::integer>32 then
        raise exception 'CANDIDATE_REPLAY_KEY_VERSION_INVALID' using errcode='22023';
      end if;
      if jsonb_typeof(v_payload->'public_broker_binding')<>'object'
         or coalesce(v_payload#>>'{public_broker_binding,contract_version}','')
              <>'CANDIDATE_PUBLIC_PHONE_BINDING_V1'
         or coalesce(v_payload#>>'{public_broker_binding,public_session_binding_sha256}','')
              !~ '^[0-9a-f]{64}$'
         or (v_payload#>'{public_broker_binding,device_binding_sha256}') is not null
            and jsonb_typeof(v_payload#>'{public_broker_binding,device_binding_sha256}')<>'null'
            and coalesce(v_payload#>>'{public_broker_binding,device_binding_sha256}','')
                  !~ '^[0-9a-f]{64}$'
         or coalesce(v_payload->>'broker_handoff_key_version','') !~ '^[1-9][0-9]{0,4}$'
         or (v_payload->>'broker_handoff_key_version')::integer>65535 then
        raise exception 'CANDIDATE_PHONE_HANDOFF_BINDING_INVALID' using errcode='22023';
      end if;
      v_response:=v_response||jsonb_build_object(
        'approval_token_hash_hex',encode(v_approval.token_hash,'hex'),
        'handoff_token_key_version',(v_payload->>'handoff_token_key_version')::integer,
        'public_broker_binding',v_payload->'public_broker_binding',
        'broker_handoff_key_version',(v_payload->>'broker_handoff_key_version')::integer
      );
    end if;
    update public.candidate_submission_workflows set
      state='AWAITING_MANAGER_APPROVAL',route=v_approval.method,policy_snapshot_json=v_policy,
      last_mutation_idempotency_key=p_idempotency_key,last_mutation_response_json=v_response,
      updated_at_utc=p_now_utc where id=v_workflow.id;

  elsif v_action='BEGIN_MANAGER_REVIEW' then
    if v_is_public_manager_action then
      select * into v_approval from public.candidate_approval_requests
      where workflow_id=v_workflow.id and token_hash=v_token_hash for update;
    else
      select * into v_approval from public.candidate_approval_requests
      where workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
        and method='PHONE' and state='PENDING'
        and (not coalesce((v_payload->>'service_office_action')::boolean,false)
          or (id=(v_payload->>'approval_request_id')::uuid
            and request_generation=(v_payload->>'approval_request_generation')::integer))
      for update;
    end if;
    if not found or v_approval.state<>'PENDING' then
      raise exception 'MANAGER_APPROVAL_REQUEST_NOT_READY' using errcode='28000';
    end if;
    if v_approval.expires_at_utc<=p_now_utc then
      raise exception 'MANAGER_APPROVAL_REQUEST_EXPIRED' using errcode='28000';
    end if;
    if v_approval.workflow_generation<>v_workflow.generation
       or v_approval.review_manifest_sha256 is distinct from v_workflow.review_manifest_sha256 then
      raise exception 'MANAGER_APPROVAL_REQUEST_SUPERSEDED' using errcode='40001';
    end if;
    update public.candidate_approval_requests set
      review_started_at_utc=coalesce(review_started_at_utc,p_now_utc),updated_at_utc=p_now_utc
    where id=v_approval.id returning * into v_approval;
    select count(*) into v_reviewed_count from unnest(v_approval.required_component_ids) u(id)
    where v_approval.review_progress_json ? u.id::text;
    v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,
      'workflow_generation',v_workflow.generation,'approval_request_id',v_approval.id,
      'approval_request_generation',v_approval.request_generation,
      'workflow_kind',v_workflow.workflow_kind,
      'method',v_approval.method,'expires_at_utc',v_approval.expires_at_utc,
      'manifest_sha256',encode(v_approval.review_manifest_sha256,'hex'),
      'page_count',coalesce((select sum(coalesce(c.review_page_count,1))
        from public.candidate_submission_components c where c.id=any(v_approval.required_component_ids)),0),
      'ordered_components',(select coalesce(jsonb_agg(
        component.value||jsonb_build_object(
          'viewed',v_approval.review_progress_json ? (component.value->>'component_id')
        ) order by (component.value->>'ordinal')::integer
      ),'[]'::jsonb) from jsonb_array_elements(v_approval.required_component_manifest_json) component),
      'reviewed_count',v_reviewed_count,
      'all_pages_viewed',v_reviewed_count=cardinality(v_approval.required_component_ids),
      'manager_identity_requirements',jsonb_build_object('name_required',true,'position_required',true,'signature_required',true),
      'can_approve',true,'can_refuse',true);
    if v_mutation_request_sha256 is not null then
      perform private._candidate_workflow_mutation_receipt_v1(
        v_workflow.id,p_idempotency_key,v_mutation_request_sha256,v_action,
        v_mutation_channel,v_mutation_actor_identity,v_response,p_now_utc
      );
    end if;
    return v_response;

  elsif v_action='RECORD_REVIEW_PROGRESS' then
    if v_is_public_manager_action then
      select * into v_approval from public.candidate_approval_requests
      where workflow_id=v_workflow.id and token_hash=v_token_hash for update;
    else
      select * into v_approval from public.candidate_approval_requests
      where workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
        and method='PHONE' and state='PENDING'
        and (not coalesce((v_payload->>'service_office_action')::boolean,false)
          or (id=(v_payload->>'approval_request_id')::uuid
            and request_generation=(v_payload->>'approval_request_generation')::integer))
      for update;
    end if;
    if not found or v_approval.state<>'PENDING' then
      raise exception 'MANAGER_APPROVAL_REQUEST_NOT_READY' using errcode='28000';
    end if;
    if v_approval.expires_at_utc<=p_now_utc then
      raise exception 'MANAGER_APPROVAL_REQUEST_EXPIRED' using errcode='28000';
    end if;
    if lower(coalesce(v_payload->>'manifest_sha256_hex',''))<>encode(v_approval.review_manifest_sha256,'hex') then
      raise exception 'MANAGER_REVIEW_MANIFEST_MISMATCH' using errcode='40001';
    end if;
    select count(*) into v_reviewed_count from unnest(v_approval.required_component_ids) u(id)
    where v_approval.review_progress_json ? u.id::text;
    if (v_approval.method='EMAIL' or nullif(v_payload->>'progress_version','') is not null)
       and coalesce(nullif(v_payload->>'progress_version','')::integer,-1)<>v_reviewed_count then
      raise exception 'MANAGER_REVIEW_PROGRESS_CONFLICT' using errcode='40001';
    end if;
    select * into v_component from public.candidate_submission_components
    where id=nullif(v_payload->>'component_id','')::uuid
      and id=any(v_approval.required_component_ids)
      and workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
      and review_render_state='READY' for update;
    if not found or lower(coalesce(v_payload->>'component_sha256_hex',''))<>encode(v_component.review_content_sha256,'hex') then
      raise exception 'MANAGER_REVIEW_MANIFEST_MISMATCH' using errcode='40001';
    end if;
    update public.candidate_approval_requests set
      review_progress_json=review_progress_json||jsonb_build_object(v_component.id::text,jsonb_build_object(
        'component_id',v_component.id,'component_sha256',encode(v_component.review_content_sha256,'hex'),
        'manifest_sha256',encode(v_approval.review_manifest_sha256,'hex'),
        'viewed_receipt',coalesce(v_payload->'viewed_receipt','{}'::jsonb),
        'reviewed_at_utc',p_now_utc)),
      review_started_at_utc=coalesce(review_started_at_utc,p_now_utc),updated_at_utc=p_now_utc
    where id=v_approval.id returning * into v_approval;
    update public.candidate_submission_components set manager_reviewed_at_utc=p_now_utc
    where id=v_component.id;
    select count(*) into v_reviewed_count from unnest(v_approval.required_component_ids) u(id)
    where v_approval.review_progress_json ? u.id::text;
    v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,
      'generation',v_workflow.generation,'approval_request_id',v_approval.id,
      'approval_request_generation',v_approval.request_generation,
      'component_id',v_component.id,'reviewed_count',v_reviewed_count,
      'required_count',cardinality(v_approval.required_component_ids),
      'progress_version',v_reviewed_count,
      'all_pages_viewed',v_reviewed_count=cardinality(v_approval.required_component_ids));
    update public.candidate_submission_workflows set
      last_mutation_idempotency_key=p_idempotency_key,last_mutation_response_json=v_response,
      updated_at_utc=p_now_utc where id=v_workflow.id;

  elsif v_action in ('PHONE_APPROVE','EMAIL_APPROVE') then
    if v_is_public_manager_action then
      select * into v_approval from public.candidate_approval_requests
      where workflow_id=v_workflow.id and token_hash=v_token_hash for update;
    else
      select * into v_approval from public.candidate_approval_requests
      where workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
        and method='PHONE' and state='PENDING'
        and (not coalesce((v_payload->>'service_office_action')::boolean,false)
          or (id=(v_payload->>'approval_request_id')::uuid
            and request_generation=(v_payload->>'approval_request_generation')::integer))
      for update;
    end if;
    if not found or v_approval.state<>'PENDING' then
      raise exception 'MANAGER_APPROVAL_REQUEST_NOT_READY' using errcode='28000';
    end if;
    if v_approval.expires_at_utc<=p_now_utc then
      raise exception 'MANAGER_APPROVAL_REQUEST_EXPIRED' using errcode='28000';
    end if;
    if (v_action='EMAIL_APPROVE' and v_approval.method<>'EMAIL')
       or (v_action='PHONE_APPROVE' and v_approval.method<>'PHONE') then
      raise exception 'MANAGER_APPROVAL_METHOD_MISMATCH' using errcode='28000';
    end if;
    if lower(coalesce(v_payload->>'manifest_sha256_hex',''))<>encode(v_approval.review_manifest_sha256,'hex')
       or v_approval.workflow_generation<>v_workflow.generation
       or v_approval.review_manifest_sha256 is distinct from v_workflow.review_manifest_sha256 then
      raise exception 'MANAGER_REVIEW_MANIFEST_MISMATCH' using errcode='40001';
    end if;
    if exists(
      select 1 from unnest(v_approval.required_component_ids) u(id)
      join public.candidate_submission_components c on c.id=u.id
      where not (v_approval.review_progress_json ? u.id::text)
         or v_approval.review_progress_json#>>array[u.id::text,'component_sha256']
            is distinct from encode(c.review_content_sha256,'hex')
    ) then
      raise exception 'MANAGER_REVIEW_COMPONENT_NOT_REVIEWED' using errcode='55000';
    end if;
    if nullif(btrim(coalesce(v_payload->>'manager_name','')),'') is null
       or nullif(btrim(coalesce(v_payload->>'manager_position','')),'') is null
       or pg_catalog.length(btrim(v_payload->>'manager_name'))>200
       or pg_catalog.length(btrim(v_payload->>'manager_position'))>200
       or (v_approval.method='EMAIL' and (
         coalesce(v_payload->>'attestation_version','')<>'MANAGER_APPROVAL_ATTESTATION_V1'
         or coalesce((v_payload->>'attestation_accepted')::boolean,false)<>true
       )) then
      raise exception 'MANAGER_SIGNATURE_REQUIRED' using errcode='22023';
    end if;
    select * into v_signature_component from public.candidate_submission_components
    where id=nullif(v_payload->>'signature_component_id','')::uuid
      and workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
      and document_role='MANAGER_SIGNATURE' and state='IMMUTABLE'
      and approval_request_id=v_approval.id
      and source_content_sha256 is not null for update;
    if not found then raise exception 'MANAGER_SIGNATURE_REQUIRED' using errcode='22023'; end if;
    update public.candidate_approval_requests set
      state='APPROVED',manager_name=btrim(v_payload->>'manager_name'),
      manager_position=btrim(v_payload->>'manager_position'),signature_component_id=v_signature_component.id,
      approved_at_utc=p_now_utc,review_completed_at_utc=p_now_utc,updated_at_utc=p_now_utc
    where id=v_approval.id returning * into v_approval;
    update public.candidate_approval_requests set
      state='SUPERSEDED',superseded_at_utc=p_now_utc,updated_at_utc=p_now_utc
    where workflow_id=v_workflow.id and id<>v_approval.id and state='PENDING';
    perform public.candidate_manager_email_route_receipt_retire_v1(
      v_workflow.id,v_approval.id,'MANAGER_APPROVED',p_now_utc
    );
    update public.candidate_submission_components set manager_approved_at_utc=p_now_utc
    where id=any(v_approval.required_component_ids);
    update public.candidate_submission_workflows set
      state='MANAGER_APPROVED_PENDING_FINAL_DOCUMENT',route=v_approval.method,
      manager_name=v_approval.manager_name,manager_position=v_approval.manager_position,
      manager_signature_component_id=v_signature_component.id,
      manager_signature_sha256=v_signature_component.source_content_sha256,
      manager_approved_at_utc=p_now_utc,last_mutation_idempotency_key=p_idempotency_key,
      updated_at_utc=p_now_utc
    where id=v_workflow.id returning * into v_workflow;
    v_render_contract:=private._candidate_render_contract_v1(
      v_workflow.id,v_workflow.generation,'FINAL_SIGNED');
    v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,
      'state',v_workflow.state,'generation',v_workflow.generation,
      'approval_request_id',v_approval.id,'approval_request_generation',v_approval.request_generation,
      'approved_at_utc',v_approval.approved_at_utc,
      'final_render_contract',v_render_contract);
    update public.candidate_submission_workflows set last_mutation_response_json=v_response
    where id=v_workflow.id;
    perform private._candidate_notification_insert_v1(v_account_id,v_candidate_id,v_workflow.id,
      v_workflow.target_timesheet_id,'MANAGER_APPROVED','manager_approval',
      'candidate-manager-approved-v1','{}'::jsonb,
      jsonb_build_object('type','workflow','workflow_id',v_workflow.id),
      'CANDIDATE_MANAGER_APPROVED_V1:'||v_workflow.id::text||':'||v_workflow.generation::text,p_now_utc);

  elsif v_action='REGISTER_FINAL_SIGNED_DOCUMENT' then
    if v_workflow.state not in ('MANAGER_APPROVED_PENDING_FINAL_DOCUMENT','READY_TO_FINALISE') then
      raise exception 'FINAL_SIGNED_DOCUMENT_STALE' using errcode='55000';
    end if;
    select * into v_component from public.candidate_submission_components
    where id=nullif(v_payload->>'component_id','')::uuid
      and workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
      and required=true and state='IMMUTABLE'
      and review_render_state='READY' for update;
    if not found then raise exception 'FINAL_SIGNED_DOCUMENT_STALE' using errcode='55000'; end if;
    if coalesce(v_payload->>'content_sha256_hex','') !~ '^[0-9a-fA-F]{64}$'
       or coalesce(v_payload->>'render_input_sha256_hex','') !~ '^[0-9a-fA-F]{64}$' then
      raise exception 'FINAL_SIGNED_DOCUMENT_NOT_READY' using errcode='22023';
    end if;
    v_digest:=decode(v_payload->>'content_sha256_hex','hex');
    v_render_input_hash:=decode(v_payload->>'render_input_sha256_hex','hex');
    v_receipt:=coalesce(v_payload->'renderer_receipt','{}'::jsonb);
    v_render_contract:=private._candidate_component_render_contract_v1(
      v_workflow.id,v_workflow.generation,v_component.id,'FINAL');
    if v_render_input_hash<>decode(v_render_contract->>'render_input_sha256','hex')
       or v_render_input_hash is distinct from v_component.review_render_input_sha256
       or nullif(btrim(v_payload->>'storage_key'),'') is null
       or lower(coalesce(v_payload->>'media_type',''))<>'application/pdf'
       or coalesce((v_payload->>'page_count')::integer,0)<>1
       or coalesce((v_payload->>'byte_size')::bigint,0)<=0
       or upper(coalesce(v_receipt->>'form_variant',''))<>v_render_contract->>'form_variant'
       or nullif(v_receipt->>'workflow_id','')::uuid is distinct from v_workflow.id
       or coalesce((v_receipt->>'workflow_generation')::integer,0)<>v_workflow.generation
       or nullif(v_receipt->>'component_id','')::uuid is distinct from v_component.id
       or upper(coalesce(v_receipt->>'component_kind',''))<>v_component.component_kind
       or upper(coalesce(v_receipt->>'document_role',''))<>v_component.document_role
       or coalesce((v_receipt->>'review_ordinal')::integer,0)<>v_component.review_ordinal
       or upper(coalesce(v_receipt->>'scope',''))<>v_workflow.scope
       or coalesce((v_receipt->>'candidate_signature_embedded')::boolean,false)
          is distinct from (v_component.component_kind='HOURS_TIMESHEET')
       or coalesce((v_receipt->>'manager_signature_embedded')::boolean,false)=false
       or coalesce((v_receipt->>'manager_approval_date_embedded')::boolean,false)=false
       or coalesce((v_receipt->>'page_count')::integer,0)<>1
       or lower(coalesce(v_receipt->>'render_input_sha256',''))<>encode(v_render_input_hash,'hex')
       or (v_component.component_kind='HOURS_TIMESHEET' and
          lower(coalesce(v_receipt->>'candidate_signature_sha256',''))<>encode(v_workflow.candidate_signature_sha256,'hex'))
       or lower(coalesce(v_receipt->>'manager_signature_sha256',''))<>encode(v_workflow.manager_signature_sha256,'hex')
       or btrim(coalesce(v_receipt->>'manager_name',''))<>v_workflow.manager_name
       or btrim(coalesce(v_receipt->>'manager_position',''))<>v_workflow.manager_position
       or nullif(v_receipt->>'manager_approved_at_utc','')::timestamptz is distinct from v_workflow.manager_approved_at_utc then
      raise exception 'FINAL_RENDER_INPUT_MISMATCH' using errcode='40001';
    end if;
    if v_component.final_signed_render_state='READY' then
      if v_component.final_signed_storage_key=v_payload->>'storage_key'
         and v_component.final_signed_content_sha256=v_digest
         and v_component.final_signed_render_input_sha256=v_render_input_hash then
        v_response:=jsonb_build_object('ok',true,'idempotent_replay',true,
          'workflow_id',v_workflow.id,'generation',v_workflow.generation,
          'component_id',v_component.id,'state',v_workflow.state);
        if v_mutation_request_sha256 is not null then
          perform private._candidate_workflow_mutation_receipt_v1(
            v_workflow.id,p_idempotency_key,v_mutation_request_sha256,v_action,
            v_mutation_channel,v_mutation_actor_identity,v_response,p_now_utc
          );
        end if;
        return v_response;
      end if;
      raise exception 'FINAL_SIGNED_DOCUMENT_STALE' using errcode='55000';
    end if;
    update public.candidate_submission_components set
      final_signed_storage_key=v_payload->>'storage_key',final_signed_content_sha256=v_digest,
      final_signed_media_type='application/pdf',final_signed_byte_size=(v_payload->>'byte_size')::bigint,
      final_signed_page_count=1,final_signed_render_input_sha256=v_render_input_hash,
      final_signed_renderer_contract_version=coalesce(nullif(v_payload->>'renderer_contract_version',''),v_workflow.renderer_contract_version),
      final_signed_renderer_receipt_json=v_receipt,final_signed_generated_at_utc=p_now_utc,
      final_signed_render_state='READY'
    where id=v_component.id returning * into v_component;
    select exists(
      select 1 from public.candidate_submission_components c
      where c.workflow_id=v_workflow.id and c.workflow_generation=v_workflow.generation
        and c.required=true and c.state<>'SUPERSEDED'
    ) and not exists(
      select 1 from public.candidate_submission_components c
      where c.workflow_id=v_workflow.id and c.workflow_generation=v_workflow.generation
        and c.required=true and c.state<>'SUPERSEDED'
        and c.final_signed_render_state<>'READY'
    ) into v_all_final_ready;
    v_response:=jsonb_build_object('ok',true,'idempotent_replay',false,
      'workflow_id',v_workflow.id,
      'state',case when v_all_final_ready then 'READY_TO_FINALISE' else 'MANAGER_APPROVED_PENDING_FINAL_DOCUMENT' end,
      'generation',v_workflow.generation,'component_id',v_component.id,
      'component_final_signed_document_ready',true,'all_final_signed_documents_ready',v_all_final_ready);
    update public.candidate_submission_workflows set
      state=case when v_all_final_ready then 'READY_TO_FINALISE' else 'MANAGER_APPROVED_PENDING_FINAL_DOCUMENT' end,
      last_mutation_idempotency_key=p_idempotency_key,
      last_mutation_response_json=v_response,updated_at_utc=p_now_utc where id=v_workflow.id;

  elsif v_action='BEGIN_CANONICAL_DAILY_SAVE' then
    if v_workflow.workflow_kind<>'DAILY' or v_workflow.scope<>'DAILY'
       or v_workflow.state<>'READY_TO_FINALISE' or v_workflow.route not in ('PHONE','EMAIL') then
      raise exception 'CANDIDATE_DAILY_CANONICAL_SAVE_NOT_READY' using errcode='55000';
    end if;
    if not private._candidate_daily_entitled_v1(v_workflow.candidate_id) then
      raise exception 'CANDIDATE_DAILY_ENTITLEMENT_REQUIRED' using errcode='55000';
    end if;
    v_daily_input:=private._candidate_daily_canonical_save_input_v1(v_workflow.id,v_workflow.generation);
    v_expected_save_hash:=private._candidate_sha256_jsonb_v1(v_daily_input);
    -- An unresolved new Daily receipt must not enter the financial save/process
    -- path. Its finaliser still verifies the same manager, documents and input.
    if coalesce((v_daily_receipt_context->>'candidate_first_receipt')::boolean,false)
       and coalesce((v_daily_receipt_context->>'office_resolution_pending')::boolean,false) then
      v_response:=jsonb_build_object(
        'ok',true,'workflow_id',v_workflow.id,'generation',v_workflow.generation,
        'state',v_workflow.state,'receipt_mode','DAILY_FACTUAL',
        'timesheet_id',v_workflow.target_timesheet_id,
        'canonical_save_input_sha256_hex',encode(v_expected_save_hash,'hex'));
      if v_mutation_request_sha256 is not null then
        perform private._candidate_workflow_mutation_receipt_v1(
          v_workflow.id,p_idempotency_key,v_mutation_request_sha256,v_action,
          v_mutation_channel,v_mutation_actor_identity,v_response,p_now_utc);
      end if;
      return v_response;
    end if;
    v_daily_context:=private._candidate_daily_context_contract_v1(
      v_workflow.id,v_workflow.generation
    );
    v_daily_context_hash:=private._candidate_sha256_jsonb_v1(v_daily_context);
    if v_workflow.canonical_saved_at_utc is not null
       and v_workflow.canonical_save_input_sha256=v_expected_save_hash
       and v_workflow.canonical_save_financials_id is not null
       and nullif(btrim(coalesce(v_workflow.canonical_save_row_signature,'')),'') is not null then
      v_response:=jsonb_build_object(
        'ok',true,'idempotent_replay',true,'workflow_id',v_workflow.id,
        'generation',v_workflow.generation,'state',v_workflow.state,
        'canonical_save_registered',true,
        'canonical_save_input_sha256_hex',encode(v_expected_save_hash,'hex'),
        'canonical_context_sha256_hex',encode(v_workflow.daily_context_sha256,'hex'),
        'canonical_save_row_signature',v_workflow.canonical_save_row_signature,
        'canonical_save_financials_id',v_workflow.canonical_save_financials_id
      );
      if v_mutation_request_sha256 is not null then
        perform private._candidate_workflow_mutation_receipt_v1(
          v_workflow.id,p_idempotency_key,v_mutation_request_sha256,v_action,
          v_mutation_channel,v_mutation_actor_identity,v_response,p_now_utc
        );
      end if;
      return v_response;
    end if;
    v_current_row_signature:=nullif(btrim(v_daily_context->>'pre_save_row_signature'),'');
    if v_current_row_signature is null then
      raise exception 'CANDIDATE_DAILY_ROW_SIGNATURE_REQUIRED' using errcode='55000';
    end if;
    v_response:=jsonb_build_object(
      'ok',true,'idempotent_replay',false,'workflow_id',v_workflow.id,
      'generation',v_workflow.generation,'state',v_workflow.state,
      'canonical_save_registered',false,'canonical_save_input',v_daily_input,
      'canonical_save_input_sha256_hex',encode(v_expected_save_hash,'hex'),
      'canonical_context',v_daily_context,
      'canonical_context_sha256_hex',encode(v_daily_context_hash,'hex'),
      'expected_row_signature',v_current_row_signature
    );
    update public.candidate_submission_workflows set
      daily_context_sha256=v_daily_context_hash,canonical_financial_sha256=null,
      canonical_save_input_sha256=null,canonical_save_row_signature=null,
      canonical_save_financials_id=null,canonical_save_receipt_json=null,canonical_saved_at_utc=null,
      last_mutation_idempotency_key=p_idempotency_key,last_mutation_response_json=v_response,
      updated_at_utc=p_now_utc
    where id=v_workflow.id returning * into v_workflow;

  elsif v_action='MANAGER_REFUSE' then
    if v_is_public_manager_action then
      select * into v_approval from public.candidate_approval_requests
      where workflow_id=v_workflow.id and token_hash=v_token_hash for update;
    else
      select * into v_approval from public.candidate_approval_requests
      where workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
        and state='PENDING'
        and (not coalesce((v_payload->>'service_office_action')::boolean,false)
          or (id=(v_payload->>'approval_request_id')::uuid
            and request_generation=(v_payload->>'approval_request_generation')::integer))
      for update;
    end if;
    if not found or v_approval.state<>'PENDING' then
      raise exception 'MANAGER_APPROVAL_REQUEST_NOT_READY' using errcode='28000';
    end if;
    if v_approval.expires_at_utc<=p_now_utc then
      raise exception 'MANAGER_APPROVAL_REQUEST_EXPIRED' using errcode='28000';
    end if;
    if nullif(btrim(coalesce(v_payload->>'reason','')),'') is null
       or pg_catalog.length(btrim(v_payload->>'reason'))>1000 then
      raise exception 'MANAGER_REFUSAL_REASON_REQUIRED' using errcode='22023';
    end if;
    update public.candidate_approval_requests set
      state='REFUSED',refusal_reason=btrim(v_payload->>'reason'),refused_at_utc=p_now_utc,
      updated_at_utc=p_now_utc where id=v_approval.id;
    update public.candidate_approval_requests set
      state='SUPERSEDED',superseded_at_utc=p_now_utc,updated_at_utc=p_now_utc
    where workflow_id=v_workflow.id and id<>v_approval.id and state='PENDING';
    perform public.candidate_manager_email_route_receipt_retire_v1(
      v_workflow.id,v_approval.id,'MANAGER_REFUSED',p_now_utc
    );
    v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,'state','REFUSED',
      'generation',v_workflow.generation,'approval_request_id',v_approval.id,
      'approval_request_generation',v_approval.request_generation,
      'refused_at_utc',p_now_utc,'rejection_scope','COMPLETE_ELECTRONIC_TRANSACTION');
    update public.candidate_submission_workflows set
      state='REFUSED',rejection_reason=btrim(v_payload->>'reason'),
      rejection_scope='COMPLETE_ELECTRONIC_TRANSACTION',last_mutation_idempotency_key=p_idempotency_key,
      last_mutation_response_json=v_response,updated_at_utc=p_now_utc where id=v_workflow.id;
    perform private._candidate_notification_insert_v1(v_account_id,v_candidate_id,v_workflow.id,
      v_workflow.target_timesheet_id,'MANAGER_REFUSED','manager_refusal','candidate-manager-refused-v1',
      jsonb_build_object('reason',btrim(v_payload->>'reason')),
      jsonb_build_object('type','workflow','workflow_id',v_workflow.id),
      'CANDIDATE_MANAGER_REFUSED_V1:'||v_workflow.id::text||':'||v_workflow.generation::text,p_now_utc);

  elsif v_action='REMIND' then
    if nullif(v_payload->>'approval_request_id','') is null
       or nullif(v_payload->>'approval_request_generation','') is null then
      raise exception 'CANDIDATE_REQUEST_GENERATION_STALE' using errcode='40001';
    end if;
    select * into v_approval from public.candidate_approval_requests
    where workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
      and method='EMAIL' and state='PENDING'
      and id=(v_payload->>'approval_request_id')::uuid
      and request_generation=(v_payload->>'approval_request_generation')::integer
    for update skip locked;
    if not found or v_approval.review_manifest_sha256 is distinct from v_workflow.review_manifest_sha256 then
      raise exception 'MANAGER_REMINDER_NOT_ELIGIBLE' using errcode='55000';
    end if;
    if coalesce(v_payload->>'approval_token_hash_hex','') !~ '^[0-9a-fA-F]{64}$' then
      raise exception 'CANDIDATE_APPROVAL_TOKEN_INVALID' using errcode='22023';
    end if;
    select max(manager_mail.sent_at),count(*) filter (
      where manager_mail.status='QUEUED' and manager_mail.sent_at is null
        and lower(coalesce(manager_mail.payment_scope_json->>'candidate_manager_mail_retired','false'))
              in ('false','f','0','no')
    )::integer
    into v_manager_provider_accepted_at,v_manager_pending_mail_count
    from public.mail_outbox manager_mail
    where upper(coalesce(manager_mail.payment_scope_json->>'candidate_mail_authority',''))
            ='MANAGER_APPROVAL_V1'
      and manager_mail.payment_scope_json->>'candidate_manager_workflow_id'=v_workflow.id::text
      and manager_mail.payment_scope_json->>'candidate_manager_workflow_generation'=v_workflow.generation::text
      and manager_mail.payment_scope_json->>'candidate_approval_request_id'=v_approval.id::text
      and manager_mail.payment_scope_json->>'candidate_approval_request_generation'=v_approval.request_generation::text
      and upper(coalesce(manager_mail.payment_scope_json->>'candidate_manager_mail_kind',''))
            in ('INITIAL','REMINDER','RENEWAL')
      and (
        manager_mail.status='QUEUED'
        or (manager_mail.status='SENT' and manager_mail.sent_at is not null
          and upper(coalesce(manager_mail.provider_status,'')) in ('ACCEPTED','SENT','SUCCESS','OK'))
      );
    if v_approval.expires_at_utc<=p_now_utc or v_approval.resend_count>=5
       or v_manager_provider_accepted_at is null
       or v_manager_provider_accepted_at+interval '24 hours'>p_now_utc
       or v_manager_pending_mail_count>0 then
      raise exception 'MANAGER_REMINDER_NOT_ELIGIBLE' using errcode='55000';
    end if;
    v_token_hash:=decode(v_payload->>'approval_token_hash_hex','hex');
    update public.candidate_approval_requests set
      token_hash=v_token_hash,resend_count=resend_count+1,
      initial_sent_at_utc=null,last_sent_at_utc=null,next_reminder_at_utc=null,
      updated_at_utc=p_now_utc
    where id=v_approval.id returning * into v_approval;
    v_mail_id:=private._candidate_queue_mail_v1(
      coalesce(v_payload->'mail','{}'::jsonb)||jsonb_build_object(
        'payment_scope_json',jsonb_build_object(
          'candidate_mail_authority','MANAGER_APPROVAL_V1',
          'candidate_manager_mail_kind','REMINDER',
          'candidate_manager_workflow_id',v_workflow.id,
          'candidate_manager_workflow_generation',v_workflow.generation,
          'candidate_approval_request_id',v_approval.id,
          'candidate_approval_request_generation',v_approval.request_generation,
          'candidate_manager_mail_retired',false
        )
      ),v_approval.manager_email_normalized,
      'CANDIDATE_MANAGER_REMINDER_V1:'||v_approval.id::text||':'||v_approval.resend_count::text,
      'candidate-manager-reminder:'||v_approval.id::text||':'||v_approval.resend_count::text,
      v_workflow.id,p_now_utc);
    v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,'state',v_workflow.state,
      'generation',v_workflow.generation,'approval_request_id',v_approval.id,
      'resend_count',v_approval.resend_count,
      'previous_provider_accepted_at_utc',v_manager_provider_accepted_at,
      'reminder_delivery_pending',true,
      'mail_outbox_id',v_mail_id);
    update public.candidate_submission_workflows set
      last_mutation_idempotency_key=p_idempotency_key,last_mutation_response_json=v_response,
      updated_at_utc=p_now_utc where id=v_workflow.id;

  elsif v_action='RENEW' then
    if v_workflow.state<>'AWAITING_MANAGER_APPROVAL'
       or v_workflow.review_manifest_sha256 is null then
      raise exception 'MANAGER_APPROVAL_NOT_RENEWABLE' using errcode='55000';
    end if;
    if nullif(v_payload->>'approval_request_id','') is null
       or nullif(v_payload->>'approval_request_generation','') is null then
      raise exception 'CANDIDATE_REQUEST_GENERATION_STALE' using errcode='40001';
    end if;
    select * into v_approval from public.candidate_approval_requests
    where workflow_id=v_workflow.id and method='EMAIL'
      and id=(v_payload->>'approval_request_id')::uuid
      and request_generation=(v_payload->>'approval_request_generation')::integer
    for update;
    if found and v_approval.state='PENDING' and v_approval.expires_at_utc<=p_now_utc then
      update public.candidate_approval_requests set
        state='EXPIRED',updated_at_utc=p_now_utc
      where id=v_approval.id returning * into v_approval;
    end if;
    if not found or v_approval.state<>'EXPIRED'
       or v_approval.review_manifest_sha256 is distinct from v_workflow.review_manifest_sha256 then
      raise exception 'MANAGER_APPROVAL_NOT_RENEWABLE' using errcode='55000';
    end if;
    if coalesce(v_payload->>'approval_token_hash_hex','') !~ '^[0-9a-fA-F]{64}$' then
      raise exception 'CANDIDATE_APPROVAL_TOKEN_INVALID' using errcode='22023';
    end if;
    v_token_hash:=decode(v_payload->>'approval_token_hash_hex','hex');
    update public.candidate_approval_requests set
      state='SUPERSEDED',superseded_at_utc=p_now_utc,updated_at_utc=p_now_utc where id=v_approval.id;
    insert into public.candidate_approval_requests(
      workflow_id,workflow_generation,request_generation,method,state,manager_email_normalized,
      token_hash,expires_at_utc,initial_sent_at_utc,last_sent_at_utc,next_reminder_at_utc,
      renewal_count,review_manifest_sha256,required_component_ids,required_component_manifest_json,
      manager_review_timesheet_component_id,manager_review_timesheet_sha256,
      idempotency_key,created_at_utc,updated_at_utc
    ) values (
      v_workflow.id,v_workflow.generation,v_approval.request_generation+1,'EMAIL','PENDING',
      v_approval.manager_email_normalized,v_token_hash,p_now_utc+interval '7 days',null,null,
      null,v_approval.renewal_count+1,v_approval.review_manifest_sha256,
      v_approval.required_component_ids,v_approval.required_component_manifest_json,
      v_approval.manager_review_timesheet_component_id,v_approval.manager_review_timesheet_sha256,
      p_idempotency_key,p_now_utc,p_now_utc
    ) returning * into v_approval;
    v_mail_id:=private._candidate_queue_mail_v1(
      coalesce(v_payload->'mail','{}'::jsonb)||jsonb_build_object(
        'payment_scope_json',jsonb_build_object(
          'candidate_mail_authority','MANAGER_APPROVAL_V1',
          'candidate_manager_mail_kind','RENEWAL',
          'candidate_manager_workflow_id',v_workflow.id,
          'candidate_manager_workflow_generation',v_workflow.generation,
          'candidate_approval_request_id',v_approval.id,
          'candidate_approval_request_generation',v_approval.request_generation,
          'candidate_manager_mail_retired',false
        )
      ),v_approval.manager_email_normalized,
      'CANDIDATE_MANAGER_RENEW_V1:'||v_approval.id::text,
      'candidate-manager-renew:'||v_approval.id::text,v_workflow.id,p_now_utc);
    v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,
      'state','AWAITING_MANAGER_APPROVAL','generation',v_workflow.generation,
      'approval_request_id',v_approval.id,'expires_at_utc',v_approval.expires_at_utc,
      'renewal_count',v_approval.renewal_count,'mail_outbox_id',v_mail_id);
    update public.candidate_submission_workflows set
      last_mutation_idempotency_key=p_idempotency_key,last_mutation_response_json=v_response,
      updated_at_utc=p_now_utc where id=v_workflow.id;

  elsif v_action='MANAGER_REQUEST_CANCEL' then
    if not v_is_service_action then
      raise exception 'CANDIDATE_MANAGER_REQUEST_CANCEL_SERVICE_REQUIRED' using errcode='42501';
    end if;
    v_cancel_reason:=nullif(btrim(coalesce(v_payload->>'reason_note',v_payload->>'reason','')), '');
    v_cancel_reason_code:=coalesce(
      nullif(upper(btrim(coalesce(v_payload->>'reason_code',''))),''),
      'OFFICE_MANAGER_REQUEST_CANCELLED'
    );
    if v_cancel_reason is null then
      raise exception 'CANDIDATE_CANCELLATION_REASON_REQUIRED' using errcode='22023';
    end if;
    if length(v_cancel_reason)>1000 then
      raise exception 'CANDIDATE_CANCELLATION_REASON_INVALID' using errcode='22023';
    end if;
    v_audit_reason:=v_cancel_reason;
    if v_workflow.state<>'AWAITING_MANAGER_APPROVAL' then
      raise exception 'MANAGER_APPROVAL_REQUEST_NOT_CANCELLABLE' using errcode='55000';
    end if;
    select request_row.* into v_approval
    from public.candidate_approval_requests request_row
    where request_row.id=(v_payload->>'approval_request_id')::uuid
      and request_row.workflow_id=v_workflow.id
      and request_row.workflow_generation=v_workflow.generation
      and request_row.request_generation=(v_payload->>'approval_request_generation')::integer
      and request_row.method='EMAIL'
      and request_row.state='PENDING'
    for update;
    if not found then
      raise exception 'MANAGER_APPROVAL_REQUEST_NOT_CANCELLABLE' using errcode='55000';
    end if;
    v_manager_retirement_result:=private._candidate_manager_mail_retire_v1(
      v_workflow.id,v_workflow.generation,array[v_approval.id],
      'APPROVAL_REQUEST_CANCELLED',p_now_utc
    );
    perform public.candidate_manager_email_route_receipt_retire_v1(
      v_workflow.id,v_approval.id,'APPROVAL_REQUEST_CANCELLED',p_now_utc
    );
    update public.candidate_approval_requests set
      state='CANCELLED',cancelled_at_utc=p_now_utc,updated_at_utc=p_now_utc
    where id=v_approval.id;
    update public.candidate_submission_components set
      state='SUPERSEDED',superseded_at_utc=p_now_utc
    where workflow_id=v_workflow.id
      and workflow_generation=v_workflow.generation
      and approval_request_id=v_approval.id
      and component_kind='MANAGER_SIGNATURE'
      and state<>'SUPERSEDED';
    if coalesce((v_manager_retirement_result->>'withdrawal_required')::boolean,false) then
      perform private._candidate_queue_mail_v1(
        private._candidate_manager_terminal_mail_payload_v1(
          v_payload->'manager_terminal_mail','WITHDRAWAL'
        )||jsonb_build_object(
          'payment_scope_json',jsonb_build_object(
            'candidate_mail_authority','MANAGER_APPROVAL_V1',
            'candidate_manager_mail_kind','WITHDRAWAL',
            'candidate_manager_workflow_id',v_workflow.id,
            'candidate_manager_workflow_generation',v_workflow.generation,
            'candidate_approval_request_id',v_approval.id,
            'candidate_approval_request_generation',v_approval.request_generation,
            'candidate_manager_template_version',(v_payload->'manager_terminal_mail'->>'manager_template_version')::bigint,
            'candidate_manager_template_sha256',v_payload->'manager_terminal_mail'->>'manager_template_sha256',
            'candidate_manager_submission_type',v_payload->'manager_terminal_mail'->>'manager_submission_type',
            'candidate_manager_mail_retired',false
          )
        ),v_approval.manager_email_normalized,
        'CANDIDATE_MANAGER_WITHDRAWAL_V1:'||v_approval.id::text||':'||v_workflow.generation::text,
        'candidate-manager-withdrawal:'||v_approval.id::text,v_workflow.id,p_now_utc
      );
      v_manager_withdrawal_count:=1;
    end if;
    v_response:=jsonb_build_object(
      'ok',true,'workflow_id',v_workflow.id,
      'state','READY_FOR_MANAGER_APPROVAL','generation',v_workflow.generation,
      'approval_request_id',v_approval.id,'manager_request_cancelled',true,
      'cancellation_reason',v_cancel_reason,
      'cancellation_reason_code',v_cancel_reason_code,
      'manager_withdrawal_count',v_manager_withdrawal_count,
      'manager_mail_retirement',v_manager_retirement_result,
      'claim_cancelled',false
    );
    update public.candidate_submission_workflows set
      state='READY_FOR_MANAGER_APPROVAL',route='ELECTRONIC',
      last_mutation_idempotency_key=p_idempotency_key,
      last_mutation_response_json=v_response,updated_at_utc=p_now_utc
    where id=v_workflow.id returning * into v_workflow;

  elsif v_action='CANCEL_MANAGER_HANDOFF' then
    if v_workflow.state<>'AWAITING_MANAGER_APPROVAL' or v_workflow.route<>'PHONE' then
      raise exception 'MANAGER_PHONE_HANDOFF_NOT_CANCELLABLE' using errcode='55000';
    end if;
    select * into v_approval from public.candidate_approval_requests
    where workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
      and method='PHONE' and state='PENDING'
      and (not coalesce((v_payload->>'service_office_action')::boolean,false)
        or (id=(v_payload->>'approval_request_id')::uuid
          and request_generation=(v_payload->>'approval_request_generation')::integer))
    order by request_generation desc limit 1 for update;
    if not found then raise exception 'MANAGER_PHONE_HANDOFF_NOT_CANCELLABLE' using errcode='55000'; end if;
    update public.candidate_approval_requests set
      state='CANCELLED',cancelled_at_utc=p_now_utc,updated_at_utc=p_now_utc
    where id=v_approval.id;
    update public.candidate_submission_components set
      state='SUPERSEDED',superseded_at_utc=p_now_utc
    where workflow_id=v_workflow.id and workflow_generation=v_workflow.generation
      and approval_request_id=v_approval.id and component_kind='MANAGER_SIGNATURE'
      and state<>'SUPERSEDED';
    v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,
      'state','READY_FOR_MANAGER_APPROVAL','generation',v_workflow.generation,
      'approval_request_id',v_approval.id,'handoff_cancelled',true);
    update public.candidate_submission_workflows set
      state='READY_FOR_MANAGER_APPROVAL',
      route=case when v_workflow.workflow_kind='DAILY' then 'PHONE' else 'ELECTRONIC' end,
      last_mutation_idempotency_key=p_idempotency_key,last_mutation_response_json=v_response,
      updated_at_utc=p_now_utc where id=v_workflow.id returning * into v_workflow;

  elsif v_action='MANAGER_PROVIDER_SUBMIT_PERMIT' then
    if not v_is_service_action then
      raise exception 'CANDIDATE_MANAGER_PROVIDER_SUBMIT_PERMIT_SERVICE_REQUIRED'
        using errcode='42501';
    end if;
    v_provider_lease_token:=nullif(btrim(coalesce(v_payload->>'attempt_lease_token','')),'');
    if v_provider_lease_token is null
       or coalesce(v_payload->>'mail_outbox_id','')
          !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then
      raise exception 'CANDIDATE_MANAGER_PROVIDER_PERMIT_INVALID' using errcode='22023';
    end if;
    select candidate_mail.* into v_manager_mail
    from public.mail_outbox candidate_mail
    where candidate_mail.id=(v_payload->>'mail_outbox_id')::uuid
      and candidate_mail.type='TIMESHEET_GENERAL'
      and candidate_mail.context_kind='CANDIDATE_WORKFLOW'
      and candidate_mail.context_id=v_workflow.id
      and candidate_mail.status='QUEUED'
      and candidate_mail.sent_at is null
      and candidate_mail.attempt_lease_token=v_provider_lease_token
      and candidate_mail.attempt_lease_expires_at_utc>p_now_utc
      and upper(coalesce(candidate_mail.payment_scope_json->>'candidate_mail_authority',''))
            ='MANAGER_APPROVAL_V1'
      and lower(coalesce(candidate_mail.payment_scope_json->>'candidate_manager_mail_retired','false'))
            in ('false','f','0','no')
    for update;
    if not found then
      raise exception 'CANDIDATE_MANAGER_PROVIDER_MAIL_STALE' using errcode='40001';
    end if;
    v_manager_mail_kind:=upper(coalesce(
      v_manager_mail.payment_scope_json->>'candidate_manager_mail_kind',''
    ));
    if v_manager_mail_kind not in ('INITIAL','REMINDER','RENEWAL','WITHDRAWAL','CANCELLATION')
       or coalesce(v_manager_mail.payment_scope_json->>'candidate_approval_request_id','')
          !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
       or coalesce(v_manager_mail.payment_scope_json->>'candidate_approval_request_generation','')
          !~ '^[1-9][0-9]{0,8}$'
       or coalesce(v_manager_mail.payment_scope_json->>'candidate_manager_workflow_generation','')
          !~ '^[1-9][0-9]{0,8}$' then
      raise exception 'CANDIDATE_MANAGER_PROVIDER_MAIL_STALE' using errcode='40001';
    end if;
    select request_row.* into v_approval
    from public.candidate_approval_requests request_row
    where request_row.id=(v_manager_mail.payment_scope_json->>'candidate_approval_request_id')::uuid
      and request_row.workflow_id=v_workflow.id
      and request_row.workflow_generation=
            (v_manager_mail.payment_scope_json->>'candidate_manager_workflow_generation')::integer
      and request_row.request_generation=
            (v_manager_mail.payment_scope_json->>'candidate_approval_request_generation')::integer
      and request_row.method='EMAIL'
      and request_row.manager_email_normalized=v_manager_mail."to"
    for update;
    if not found then
      raise exception 'CANDIDATE_MANAGER_PROVIDER_MAIL_STALE' using errcode='40001';
    end if;
    if v_manager_mail_kind in ('INITIAL','REMINDER','RENEWAL') then
      select route_receipt.* into v_manager_route_receipt
      from public.candidate_manager_email_route_receipts route_receipt
      where route_receipt.route_receipt_id=v_approval.current_manager_route_receipt_id
        and route_receipt.workflow_id=v_workflow.id
        and route_receipt.approval_request_id=v_approval.id
        and route_receipt.request_generation=v_approval.request_generation
        and route_receipt.manager_token_hash_snapshot=v_approval.token_hash
        and route_receipt.state='CURRENT'
        and route_receipt.route_receipt_id::text=
              v_manager_mail.payment_scope_json->>'candidate_manager_route_receipt_id'
        and route_receipt.manager_route_ticket_id::text=
              v_manager_mail.payment_scope_json->>'candidate_manager_route_ticket_id'
        and route_receipt.route_revision::text=
              v_manager_mail.payment_scope_json->>'candidate_manager_route_revision'
        and pg_catalog.encode(route_receipt.registration_receipt_sha256,'hex')=
              v_manager_mail.payment_scope_json->>'candidate_manager_route_registration_sha256'
      for update;
      if not found then
        raise exception 'CANDIDATE_MANAGER_ROUTE_RECEIPT_NOT_CURRENT' using errcode='40001';
      end if;
    end if;
    if v_manager_mail_kind in ('WITHDRAWAL','CANCELLATION') then
      if v_approval.state not in ('CANCELLED','SUPERSEDED','EXPIRED','REFUSED') then
        raise exception 'CANDIDATE_MANAGER_PROVIDER_MAIL_STALE' using errcode='40001';
      end if;
    elsif v_approval.state<>'PENDING' or v_approval.expires_at_utc<=p_now_utc
       or v_workflow.route<>'EMAIL' or v_workflow.state<>'AWAITING_MANAGER_APPROVAL'
       or v_workflow.generation<>v_approval.workflow_generation
       or v_approval.review_manifest_sha256 is distinct from v_workflow.review_manifest_sha256 then
      raise exception 'CANDIDATE_MANAGER_PROVIDER_MAIL_STALE' using errcode='40001';
    end if;
    v_provider_permit_expires_at:=greatest(
      v_manager_mail.attempt_lease_expires_at_utc,p_now_utc+interval '15 minutes'
    );
    update public.mail_outbox candidate_mail
    set attempt_lease_expires_at_utc=v_provider_permit_expires_at
    where candidate_mail.id=v_manager_mail.id
      and candidate_mail.status='QUEUED' and candidate_mail.sent_at is null
      and candidate_mail.attempt_lease_token=v_provider_lease_token
      and candidate_mail.attempt_lease_expires_at_utc>p_now_utc
      and lower(coalesce(candidate_mail.payment_scope_json->>'candidate_manager_mail_retired','false'))
            in ('false','f','0','no');
    if not found then
      raise exception 'CANDIDATE_MANAGER_PROVIDER_MAIL_STALE' using errcode='40001';
    end if;
    v_response:=jsonb_build_object(
      'ok',true,'workflow_id',v_workflow.id,'generation',v_workflow.generation,
      'approval_request_id',v_approval.id,'mail_outbox_id',v_manager_mail.id,
      'approval_request_generation',v_approval.request_generation,
      'approval_workflow_generation',v_approval.workflow_generation,
      'manager_mail_kind',v_manager_mail_kind,'provider_submit_permit',true,
      'provider_submit_permit_expires_at_utc',v_provider_permit_expires_at
    );

  elsif v_action='PAPER_PROVIDER_SUBMIT_PERMIT' then
    if not v_is_service_action or p_session_id is not null then
      raise exception 'CANDIDATE_PAPER_PROVIDER_SUBMIT_PERMIT_SERVICE_REQUIRED'
        using errcode='28000';
    end if;
    v_paper_mail_id:=nullif(btrim(coalesce(v_payload->>'mail_outbox_id','')),'')::uuid;
    v_provider_lease_token:=nullif(btrim(coalesce(v_payload->>'attempt_lease_token','')),'');
    v_paper_manifest_sha256:=lower(btrim(coalesce(
      v_payload->>'paper_return_manifest_sha256',''
    )));
    if v_paper_mail_id is null or v_provider_lease_token is null
       or v_paper_manifest_sha256 !~ '^[0-9a-f]{64}$' then
      raise exception 'CANDIDATE_PAPER_PROVIDER_BINDING_INVALID' using errcode='22023';
    end if;
    if v_workflow.route<>'PAPER'
       or v_workflow.state<>'AWAITING_PAPER_RETURN'
       or v_workflow.paper_return_manifest_sha256 is null
       or encode(v_workflow.paper_return_manifest_sha256,'hex')<>v_paper_manifest_sha256
       or jsonb_typeof(v_workflow.paper_return_manifest_json->'pages') is distinct from 'array'
       or exists(
         select 1
         from jsonb_array_elements(v_workflow.paper_return_manifest_json->'pages') manifest_page
         where upper(coalesce(manifest_page->>'component_kind',''))='EXPENSE_SUMMARY'
            or upper(coalesce(manifest_page->>'page_key',''))='EXPENSE_SUMMARY'
       ) then
      raise exception 'CANDIDATE_PAPER_PROVIDER_WORKFLOW_STALE' using errcode='40001';
    end if;
    if exists(
      select 1 from public.candidate_pending_expense_updates update_row
      where update_row.workflow_id=v_workflow.id
        and update_row.state in ('EDITING','RENDERING')
    ) then
      raise exception 'CANDIDATE_EXPENSE_UPDATE_IN_PROGRESS' using errcode='40001';
    end if;
    select candidate_mail.* into v_paper_mail
    from public.mail_outbox candidate_mail
    where candidate_mail.id=v_paper_mail_id
      and candidate_mail.type='TIMESHEET_QR'
      and candidate_mail.status='QUEUED'
      and candidate_mail.sent_at is null
      and candidate_mail.context_kind='timesheets'
      and candidate_mail.context_id=coalesce(
        v_workflow.target_timesheet_id,v_workflow.anchor_timesheet_id
      )
      and candidate_mail.attempt_lease_token=v_provider_lease_token
      and candidate_mail.attempt_lease_expires_at_utc>p_now_utc
      and candidate_mail.payment_scope_json->>'candidate_mail_authority' in (
        'CANDIDATE_PAPER_V1','CANDIDATE_PAPER_PACK_EMAIL_V1'
      )
      and candidate_mail.payment_scope_json->>'candidate_workflow_id'=v_workflow.id::text
      and candidate_mail.payment_scope_json->>'candidate_workflow_generation'=v_workflow.generation::text
      and lower(coalesce(candidate_mail.payment_scope_json->>'paper_return_manifest_sha256',''))
            =v_paper_manifest_sha256
      and lower(coalesce(candidate_mail.payment_scope_json->>'candidate_paper_generation_retired','false'))
            in ('false','f','0','no')
      and lower(coalesce(candidate_mail.payment_scope_json->>'candidate_paper_pack_ready','false'))
            in ('true','t','1','yes')
      and lower(coalesce(candidate_mail.payment_scope_json->>'mail_held_until_pdf_rendered','false'))
            in ('false','f','0','no')
      and jsonb_typeof(candidate_mail.attachments)='array'
      and jsonb_array_length(candidate_mail.attachments)>0
      and candidate_mail.attachments->0->>'candidate_workflow_id'=v_workflow.id::text
      and candidate_mail.attachments->0->>'candidate_workflow_generation'=v_workflow.generation::text
      and lower(coalesce(candidate_mail.attachments->0->>'paper_return_manifest_sha256',''))
            =v_paper_manifest_sha256
    for update;
    if not found then
      raise exception 'CANDIDATE_PAPER_PROVIDER_MAIL_STALE' using errcode='40001';
    end if;
    v_provider_permit_expires_at:=greatest(
      v_paper_mail.attempt_lease_expires_at_utc,
      p_now_utc+interval '15 minutes'
    );
    update public.mail_outbox candidate_mail
    set attempt_lease_expires_at_utc=v_provider_permit_expires_at
    where candidate_mail.id=v_paper_mail.id
      and candidate_mail.status='QUEUED'
      and candidate_mail.sent_at is null
      and candidate_mail.attempt_lease_token=v_provider_lease_token
      and candidate_mail.attempt_lease_expires_at_utc>p_now_utc
      and lower(coalesce(candidate_mail.payment_scope_json->>'candidate_paper_generation_retired','false'))
            in ('false','f','0','no');
    if not found then
      raise exception 'CANDIDATE_PAPER_PROVIDER_MAIL_STALE' using errcode='40001';
    end if;
    v_response:=jsonb_build_object(
      'ok',true,'workflow_id',v_workflow.id,'state',v_workflow.state,
      'generation',v_workflow.generation,'mail_outbox_id',v_paper_mail.id,
      'provider_submit_permit',true,
      'provider_submit_permit_expires_at_utc',v_provider_permit_expires_at
    );

  elsif v_action in ('CANCEL','SUPERSEDE') then
    if v_workflow.state in ('CANCELLED','REJECTED','SUPERSEDED')
       or (v_action='SUPERSEDE' and v_workflow.state='FINALISED') then
      raise exception 'CANDIDATE_WORKFLOW_NOT_CANCELLABLE' using errcode='55000';
    end if;
    if v_action='CANCEL' then
      v_cancel_reason:=nullif(btrim(coalesce(v_payload->>'reason_note',v_payload->>'reason','')), '');
      v_cancel_reason_code:=nullif(upper(btrim(coalesce(v_payload->>'reason_code',''))),'');
      if v_cancel_reason is null then
        raise exception 'CANDIDATE_CANCELLATION_REASON_REQUIRED' using errcode='22023';
      end if;
      if length(v_cancel_reason)>1000 then
        raise exception 'CANDIDATE_CANCELLATION_REASON_INVALID' using errcode='22023';
      end if;
      v_audit_reason:=v_cancel_reason;
    end if;
    if v_workflow.route='PAPER'
       and v_workflow.state in ('AWAITING_PAPER_RETURN','RECEIVED') then
      v_paper_retirement_result:=private._candidate_paper_delivery_retire_set_v1(
        array[v_workflow.id],array[v_workflow.generation],
        case when v_action='CANCEL' then 'WORKFLOW_CANCELLED' else 'WORKFLOW_SUPERSEDED' end,
        p_now_utc
      );
      if not coalesce((v_paper_retirement_result->>'retired')::boolean,false)
         or not coalesce(
           (v_paper_retirement_result->>'qr_invalidation_proven')::boolean,false
         ) then
        raise exception 'CANDIDATE_PAPER_QR_INVALIDATION_NOT_PROVEN'
          using errcode='40001',detail=v_paper_retirement_result::text;
      end if;
    end if;
    select coalesce(array_agg(locked_request.id order by locked_request.id),array[]::uuid[])
    into v_manager_request_ids
    from (
      select request_row.id
      from public.candidate_approval_requests request_row
      where request_row.workflow_id=v_workflow.id
        and request_row.workflow_generation=v_workflow.generation
        and request_row.method='EMAIL'
        and request_row.state in ('PENDING','APPROVED')
      order by request_row.id
      for update
    ) locked_request;
    if cardinality(v_manager_request_ids)>0 then
      v_manager_retirement_result:=private._candidate_manager_mail_retire_v1(
        v_workflow.id,v_workflow.generation,v_manager_request_ids,
        case when v_action='CANCEL' then 'WORKFLOW_CANCELLED' else 'WORKFLOW_SUPERSEDED' end,
        p_now_utc
      );
      foreach v_manager_withdrawal_request_id in array v_manager_request_ids loop
        perform public.candidate_manager_email_route_receipt_retire_v1(
          v_workflow.id,v_manager_withdrawal_request_id,
          case when v_action='CANCEL' then 'WORKFLOW_CANCELLED' else 'WORKFLOW_SUPERSEDED' end,
          p_now_utc
        );
      end loop;
    end if;
    update public.candidate_approval_requests set
      state=case when v_action='CANCEL' then 'CANCELLED' else 'SUPERSEDED' end,
      cancelled_at_utc=case when v_action='CANCEL' then p_now_utc else cancelled_at_utc end,
      superseded_at_utc=case when v_action='SUPERSEDE' then p_now_utc else superseded_at_utc end,
      updated_at_utc=p_now_utc where workflow_id=v_workflow.id and state in ('PENDING','APPROVED');
    if v_action='CANCEL' and coalesce((v_manager_retirement_result->>'withdrawal_required')::boolean,false) then
      for v_manager_withdrawal_request_id in
        select value::uuid
        from jsonb_array_elements_text(coalesce(
          v_manager_retirement_result->'withdrawal_request_ids','[]'::jsonb
        )) value
      loop
        select request_row.* into v_approval
        from public.candidate_approval_requests request_row
        where request_row.id=v_manager_withdrawal_request_id
          and request_row.workflow_id=v_workflow.id
          and request_row.workflow_generation=v_workflow.generation
          and request_row.method='EMAIL'
          and request_row.state='CANCELLED';
        if found then
          perform private._candidate_queue_mail_v1(
            private._candidate_manager_terminal_mail_payload_v1(
              v_payload->'manager_terminal_mail','CANCELLATION'
            )||jsonb_build_object(
              'payment_scope_json',jsonb_build_object(
                'candidate_mail_authority','MANAGER_APPROVAL_V1',
                'candidate_manager_mail_kind','CANCELLATION',
                'candidate_manager_workflow_id',v_workflow.id,
                'candidate_manager_workflow_generation',v_workflow.generation,
                'candidate_approval_request_id',v_approval.id,
                'candidate_approval_request_generation',v_approval.request_generation,
                'candidate_manager_template_version',(v_payload->'manager_terminal_mail'->>'manager_template_version')::bigint,
                'candidate_manager_template_sha256',v_payload->'manager_terminal_mail'->>'manager_template_sha256',
                'candidate_manager_submission_type',v_payload->'manager_terminal_mail'->>'manager_submission_type',
                'candidate_manager_mail_retired',false
              )
            ),v_approval.manager_email_normalized,
            'CANDIDATE_MANAGER_CANCELLATION_V1:'||v_approval.id::text||':'||v_workflow.generation::text,
            'candidate-manager-cancellation:'||v_approval.id::text,v_workflow.id,p_now_utc
          );
          v_manager_withdrawal_count:=v_manager_withdrawal_count+1;
        end if;
      end loop;
    end if;
    update public.candidate_submission_components set
      state='SUPERSEDED',superseded_at_utc=p_now_utc,
      review_render_state=case when review_render_state='NOT_REQUIRED' then review_render_state else 'SUPERSEDED' end,
      final_signed_render_state=case when final_signed_render_state='NOT_REQUIRED' then final_signed_render_state else 'SUPERSEDED' end
    where workflow_id=v_workflow.id and state not in ('SUPERSEDED','REJECTED');
    if v_action='CANCEL'
       and v_workflow.scope='WEEKLY'
       and v_workflow.workflow_kind in ('CONTRACT_HOURS','CONTRACT_COMBINED') then
      v_submission_withdrawal_reset:=private._candidate_weekly_withdrawal_reset_v1(
        v_workflow.id,v_cancel_reason,p_now_utc
      );
    elsif v_action='CANCEL'
       and v_workflow.scope='DAILY'
       and v_workflow.workflow_kind='DAILY' then
      v_submission_withdrawal_reset:=private._candidate_daily_receipt_reset_v1(
        v_environment,v_workflow.candidate_id,
        coalesce(v_workflow.target_timesheet_id,v_workflow.anchor_timesheet_id),
        coalesce(v_workflow.target_timesheet_id,v_workflow.anchor_timesheet_id),
        v_cancel_reason,v_workflow.candidate_id,'CANDIDATE_WITHDRAWN',p_now_utc
      );
    end if;
    v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,
      'state',v_action||case when v_action='CANCEL' then 'LED' else 'D' end,
      'generation',v_next_generation,
      'cancellation_reason',case when v_action='CANCEL' then v_cancel_reason else null end,
      'cancellation_reason_code',case when v_action='CANCEL' then v_cancel_reason_code else null end,
      'submission_withdrawal_reset',v_submission_withdrawal_reset,
      'manager_withdrawal_count',v_manager_withdrawal_count,
      'manager_mail_retirement',v_manager_retirement_result);
    update public.candidate_submission_workflows set
      state=case when v_action='CANCEL' then 'CANCELLED' else 'SUPERSEDED' end,
      generation=v_next_generation,cancelled_at_utc=case when v_action='CANCEL' then p_now_utc else cancelled_at_utc end,
      last_mutation_idempotency_key=p_idempotency_key,last_mutation_response_json=v_response,
      updated_at_utc=p_now_utc where id=v_workflow.id;

  elsif v_action='PAPER_PREPARE' then
    if nullif(btrim(coalesce(p_idempotency_key,'')),'') is null then
      raise exception 'CANDIDATE_IDEMPOTENCY_KEY_REQUIRED' using errcode='22023';
    end if;
    if v_workflow.state not in ('WORKER_SUBMITTED','AWAITING_PAPER_RETURN') then
      raise exception 'CANDIDATE_WORKFLOW_TRANSITION_INVALID' using errcode='55000';
    end if;
    if v_workflow.scope='DAILY' then
      raise exception 'CANDIDATE_PAPER_ROUTE_NOT_ALLOWED' using errcode='55000';
    end if;
    if v_workflow.workflow_kind='CONTRACT_EXPENSE'
       and v_workflow.target_timesheet_id is null then
      select week_row.* into v_anchor_week
      from public.contract_weeks week_row
      where week_row.timesheet_id=v_workflow.anchor_timesheet_id
        and week_row.contract_id=v_workflow.contract_id
        and week_row.week_ending_date=v_workflow.week_ending_date;
      if not found then raise exception 'CANDIDATE_WORKFLOW_ANCHOR_MISMATCH' using errcode='40001'; end if;
      if not coalesce((v_policy->>'paper_submission_enabled')::boolean,false) then
        raise exception 'CANDIDATE_PAPER_ROUTE_NOT_ALLOWED' using errcode='55000';
      end if;
    else
      v_route_authority:=private._candidate_route_family_v1(v_workflow.target_timesheet_id,v_workflow.contract_week_id);
      if not coalesce((v_route_authority->>'candidate_paper_submission_allowed')::boolean,false) then
        raise exception 'CANDIDATE_PAPER_ROUTE_NOT_ALLOWED' using errcode='55000',detail=v_route_authority::text;
      end if;
    end if;
    update public.candidate_approval_requests set
      state='SUPERSEDED',superseded_at_utc=p_now_utc,updated_at_utc=p_now_utc
    where workflow_id=v_workflow.id and state='PENDING';

    select coalesce(jsonb_agg(jsonb_build_object(
      'page_key',case source_component.component_kind
        when 'MILEAGE_FORM' then 'MILEAGE_FORM:' else 'EXPENSE_EVIDENCE:' end
        ||coalesce(source_component.source_component_id,source_component.id)::text,
      'component_kind',source_component.component_kind,
      'expense_category',source_component.expense_category,
      'source_component_id',coalesce(source_component.source_component_id,source_component.id),
      'source_content_sha256',encode(source_component.source_content_sha256,'hex')
    ) order by source_component.component_no,source_component.id),'[]'::jsonb)
    into v_paper_source_pages
    from (
      select distinct on (
        component.component_kind,component.expense_category,component.document_role,
        coalesce(component.source_component_id,component.id),component.source_content_sha256
      ) component.*
      from public.candidate_submission_components component
      where component.workflow_id=v_workflow.id
        and component.workflow_generation=v_workflow.generation
        and component.component_kind in ('MILEAGE_FORM','EXPENSE_EVIDENCE')
        and component.state='IMMUTABLE'
        and component.source_content_sha256 is not null
      order by component.component_kind,component.expense_category,component.document_role,
        coalesce(component.source_component_id,component.id),component.source_content_sha256,
        component.component_no,component.id
    ) source_component;

    v_paper_mileage_only:=jsonb_array_length(v_paper_source_pages)>0
      and not exists(
        select 1
        from jsonb_array_elements(v_paper_source_pages) source_page
        where source_page->>'component_kind'<>'MILEAGE_FORM'
           or source_page->>'expense_category'<>'MILEAGE'
      );

    v_paper_manifest:=jsonb_build_object(
      'workflow_id',v_workflow.id,
      'workflow_generation',v_workflow.generation,
      'immutable_submission_sha256',encode(v_workflow.immutable_submission_sha256,'hex'),
      'pages',
        case when v_workflow.workflow_kind<>'CONTRACT_EXPENSE'
          then jsonb_build_array(jsonb_build_object(
            'page_key','HOURS_TIMESHEET','component_kind','HOURS_TIMESHEET'))
          else '[]'::jsonb end
        -- The expense summary is an internal, automatically regenerated aid;
        -- it is never a manager-decision or signed-return page.
        || '[]'::jsonb
        || v_paper_source_pages
    );
    update public.candidate_submission_workflows set
      state='AWAITING_PAPER_RETURN',route='PAPER',policy_snapshot_json=v_policy,
      policy_snapshot_sha256=private._candidate_sha256_jsonb_v1(v_policy),
      paper_return_manifest_json=v_paper_manifest,
      paper_return_manifest_sha256=private._candidate_sha256_jsonb_v1(v_paper_manifest),
      updated_at_utc=p_now_utc where id=v_workflow.id returning * into v_workflow;

    -- The existing QR/document/email authority is composed inside this
    -- transaction. A PAPER workflow is not accepted unless its exact held
    -- email operation exists and is bound to this frozen manifest.
    if v_workflow.workflow_kind='CONTRACT_EXPENSE'
       and v_workflow.target_timesheet_id is null then
      execute
        'select public.candidate_targetless_expense_paper_pack_enqueue_v1($1,$2,$3,$4,$5)'
        into v_paper_pack_result
        using v_environment,v_workflow.id,v_workflow.generation,
          p_idempotency_key||':paper-pack',p_now_utc;
    else
      execute
        'select public.timesheet_qr_send_enqueue_v1($1,$2,$3,$4,$5)'
        into v_paper_pack_result
        using v_paper_timesheet_id,v_paper_timesheet_id,null::uuid,
          p_idempotency_key||':paper-pack',p_now_utc;
    end if;

    if not coalesce((v_paper_pack_result->>'ok')::boolean,false)
       or not coalesce((v_paper_pack_result->>'queued')::boolean,false)
       or not coalesce((v_paper_pack_result->>'recipient_available')::boolean,false) then
      if coalesce(v_paper_pack_result->>'error_code','') in (
        'CANDIDATE_EMAIL_MISSING','CANDIDATE_EMAIL_OPTED_OUT','CANDIDATE_NOT_FOUND'
      ) then
        raise exception 'CANDIDATE_PAPER_EMAIL_NOT_AVAILABLE'
          using errcode='55000',detail=jsonb_build_object(
            'code','CANDIDATE_PAPER_EMAIL_NOT_AVAILABLE',
            'cause',v_paper_pack_result->>'error_code'
          )::text;
      end if;
      raise exception 'CANDIDATE_PAPER_PACK_QUEUE_FAILED'
        using errcode='55000',detail=jsonb_build_object(
          'code','CANDIDATE_PAPER_PACK_QUEUE_FAILED',
          'cause',coalesce(v_paper_pack_result->>'error_code','UNKNOWN')
        )::text;
    end if;

    v_mail_id:=nullif(v_paper_pack_result->>'mail_outbox_id','')::uuid;
    if v_mail_id is null then
      raise exception 'CANDIDATE_PAPER_OUTBOX_NOT_READY' using errcode='55000';
    end if;
    perform 1
    from public.mail_outbox candidate_paper_mail
    where candidate_paper_mail.id=v_mail_id
      and candidate_paper_mail.type='TIMESHEET_QR'
      and candidate_paper_mail.context_kind='timesheets'
      and candidate_paper_mail.context_id=v_paper_timesheet_id
      and candidate_paper_mail.status='QUEUED'
      and candidate_paper_mail.attempt_lease_token is null
      and candidate_paper_mail.payment_scope_json->>'candidate_workflow_id'=v_workflow.id::text
      and candidate_paper_mail.payment_scope_json->>'candidate_workflow_generation'=v_workflow.generation::text
      and lower(coalesce(candidate_paper_mail.payment_scope_json->>'paper_return_manifest_sha256',''))
            =encode(v_workflow.paper_return_manifest_sha256,'hex')
      and lower(coalesce(candidate_paper_mail.payment_scope_json->>'candidate_paper_pack_ready','false'))
            in ('false','f','0','no')
      and lower(coalesce(candidate_paper_mail.payment_scope_json->>'mail_held_until_pdf_rendered','false'))
            in ('true','t','1','yes')
      and candidate_paper_mail.payment_scope_json->>'mail_hold_reason'='CANDIDATE_PAPER_PACK_PENDING'
      and jsonb_typeof(candidate_paper_mail.attachments)='array'
      and jsonb_array_length(candidate_paper_mail.attachments)=0
    for update;
    if not found then
      raise exception 'CANDIDATE_PAPER_OUTBOX_NOT_READY' using errcode='55000';
    end if;

    v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,
      'state','AWAITING_PAPER_RETURN','generation',v_workflow.generation,
      'paper_return_manifest_sha256',encode(v_workflow.paper_return_manifest_sha256,'hex'),
      'paper_return_page_count',jsonb_array_length(v_paper_manifest->'pages'),
      'paper_pack',jsonb_build_object(
        'queued',true,
        'recipient_available',true,
        'mail_outbox_id',v_mail_id,
        'send_state',v_paper_pack_result->>'send_state',
        'document_operation_id',v_paper_pack_result->>'document_operation_id',
        'document_version_id',v_paper_pack_result->>'document_version_id',
        'document_version_status',v_paper_pack_result->>'document_version_status',
        'current_timesheet_id',v_paper_pack_result->>'current_timesheet_id',
        'current_version',v_paper_pack_result->'current_version'
      ));
    update public.candidate_submission_workflows set
      last_mutation_idempotency_key=p_idempotency_key,
      last_mutation_response_json=v_response,
      updated_at_utc=p_now_utc
    where id=v_workflow.id returning * into v_workflow;

  elsif v_action='PAPER_PACK_ATTEMPT_CLAIM' then
    if not v_is_service_action or p_session_id is not null
       or not coalesce((v_payload->>'service_paper_pack_attempt')::boolean,false) then
      raise exception 'CANDIDATE_PAPER_PACK_ATTEMPT_SERVICE_REQUIRED' using errcode='28000';
    end if;
    if v_workflow.state<>'AWAITING_PAPER_RETURN' or v_workflow.route<>'PAPER'
       or v_workflow.paper_return_manifest_sha256 is null then
      raise exception 'CANDIDATE_PAPER_WORKFLOW_STALE' using errcode='40001';
    end if;
    v_paper_mail_id:=nullif(btrim(coalesce(v_payload->>'mail_outbox_id','')),'')::uuid;
    v_paper_manifest_sha256:=lower(btrim(coalesce(v_payload->>'paper_return_manifest_sha256','')));
    v_paper_pack_attempt_token:=lower(btrim(coalesce(v_payload->>'paper_pack_attempt_token','')));
    v_paper_pack_operation_id:=nullif(btrim(coalesce(
      v_payload->>'paper_pack_operation_id',p_idempotency_key,''
    )), '');
    if v_paper_mail_id is null
       or v_paper_manifest_sha256 !~ '^[0-9a-f]{64}$'
       or v_paper_manifest_sha256<>encode(v_workflow.paper_return_manifest_sha256,'hex')
       or v_paper_pack_attempt_token !~ '^[0-9a-f]{64}$'
       or v_paper_pack_operation_id is null
       or length(v_paper_pack_operation_id)>200 then
      raise exception 'CANDIDATE_PAPER_PACK_ATTEMPT_RECEIPT_INVALID' using errcode='22023';
    end if;
    select * into v_paper_mail
    from public.mail_outbox candidate_paper_mail
    where candidate_paper_mail.id=v_paper_mail_id
      and candidate_paper_mail.type='TIMESHEET_QR'
      and candidate_paper_mail.context_kind='timesheets'
      and candidate_paper_mail.payment_scope_json->>'candidate_mail_authority'='CANDIDATE_PAPER_V1'
      and candidate_paper_mail.payment_scope_json->>'candidate_workflow_id'=v_workflow.id::text
      and candidate_paper_mail.payment_scope_json->>'candidate_workflow_generation'=v_workflow.generation::text
      and lower(coalesce(candidate_paper_mail.payment_scope_json->>'paper_return_manifest_sha256',''))
            =v_paper_manifest_sha256
    for update;
    if not found then
      raise exception 'CANDIDATE_PAPER_OUTBOX_NOT_READY' using errcode='40001';
    end if;
    if lower(coalesce(v_paper_mail.payment_scope_json->>'candidate_paper_generation_retired','false'))
         in ('true','t','1','yes') then
      raise exception 'CANDIDATE_PAPER_WORKFLOW_STALE' using errcode='40001';
    end if;
    if lower(coalesce(v_paper_mail.payment_scope_json->>'candidate_paper_pack_ready','false'))
         in ('true','t','1','yes') then
      v_response:=jsonb_build_object(
        'ok',true,'workflow_id',v_workflow.id,'generation',v_workflow.generation,
        'mail_outbox_id',v_paper_mail.id,'paper_pack_attempt_state','READY',
        'paper_pack_operation_id',v_paper_mail.payment_scope_json->>'candidate_paper_pack_operation_id',
        'claim_acquired_new',false,
        'paper_pack_attempt_count',coalesce(
          nullif(v_paper_mail.payment_scope_json->>'candidate_paper_pack_attempt_count','')::integer,0
        )
      );
    else
      v_paper_failure_class:=upper(coalesce(
        v_paper_mail.payment_scope_json->>'candidate_paper_pack_failure_class',''
      ));
      if v_paper_failure_class='TERMINAL' then
        raise exception 'CANDIDATE_PAPER_PACK_FAILED_TERMINAL' using errcode='55000';
      end if;
      v_paper_pack_next_retry_at:=nullif(
        v_paper_mail.payment_scope_json->>'candidate_paper_pack_next_retry_at_utc',''
      )::timestamptz;
      if v_paper_failure_class='RETRYABLE'
         and v_paper_pack_next_retry_at is not null and v_paper_pack_next_retry_at>p_now_utc then
        raise exception 'CANDIDATE_PAPER_PACK_RETRY_BACKOFF_ACTIVE'
          using errcode='55000',detail=jsonb_build_object(
            'code','CANDIDATE_PAPER_PACK_RETRY_BACKOFF_ACTIVE',
            'next_retry_at_utc',v_paper_pack_next_retry_at
          )::text;
      end if;
      if nullif(v_paper_mail.payment_scope_json->>'candidate_paper_pack_attempt_token','') is not null
         and nullif(v_paper_mail.payment_scope_json->>'candidate_paper_pack_attempt_expires_at_utc','')::timestamptz
               >p_now_utc then
        raise exception 'CANDIDATE_PAPER_PACK_ATTEMPT_IN_PROGRESS' using errcode='40001';
      end if;
      v_paper_pack_attempt_count:=coalesce(
        nullif(v_paper_mail.payment_scope_json->>'candidate_paper_pack_attempt_count','')::integer,0
      )+1;
      v_paper_pack_attempt_expires_at:=p_now_utc+interval '10 minutes';
      update public.mail_outbox candidate_paper_mail
      set payment_scope_json=candidate_paper_mail.payment_scope_json||jsonb_build_object(
        'candidate_paper_pack_attempt_token',v_paper_pack_attempt_token,
        'candidate_paper_pack_attempt_expires_at_utc',v_paper_pack_attempt_expires_at,
        'candidate_paper_pack_attempt_count',v_paper_pack_attempt_count,
        'candidate_paper_pack_last_attempted_at_utc',p_now_utc,
        'candidate_paper_pack_operation_id',v_paper_pack_operation_id,
        'candidate_paper_pack_operation_state','CLAIMED'
      )
      where candidate_paper_mail.id=v_paper_mail.id;
      v_response:=jsonb_build_object(
        'ok',true,'workflow_id',v_workflow.id,'generation',v_workflow.generation,
        'mail_outbox_id',v_paper_mail.id,'paper_pack_attempt_state','CLAIMED',
        'paper_pack_operation_id',v_paper_pack_operation_id,
        'claim_acquired_new',true,
        'paper_pack_attempt_token',v_paper_pack_attempt_token,
        'paper_pack_attempt_count',v_paper_pack_attempt_count,
        'paper_pack_attempt_expires_at_utc',v_paper_pack_attempt_expires_at
      );
    end if;

  elsif v_action='PAPER_PACK_MARK_FAILURE' then
    if not v_is_service_action or p_session_id is not null
       or not coalesce((v_payload->>'service_paper_pack_failure')::boolean,false) then
      raise exception 'CANDIDATE_PAPER_PACK_FAILURE_SERVICE_REQUIRED' using errcode='28000';
    end if;
    if v_workflow.state<>'AWAITING_PAPER_RETURN' or v_workflow.route<>'PAPER'
       or v_workflow.paper_return_manifest_sha256 is null then
      raise exception 'CANDIDATE_PAPER_WORKFLOW_STALE' using errcode='40001';
    end if;
    v_paper_mail_id:=nullif(btrim(coalesce(v_payload->>'mail_outbox_id','')),'')::uuid;
    v_paper_manifest_sha256:=lower(btrim(coalesce(v_payload->>'paper_return_manifest_sha256','')));
    v_paper_failure_code:=upper(btrim(coalesce(v_payload->>'error_code','')));
    v_paper_pack_operation_id:=nullif(btrim(coalesce(
      v_payload->>'paper_pack_operation_id',''
    )), '');
    if v_paper_manifest_sha256 !~ '^[0-9a-f]{64}$'
       or v_paper_manifest_sha256<>encode(v_workflow.paper_return_manifest_sha256,'hex')
       or v_paper_failure_code='' then
      raise exception 'CANDIDATE_PAPER_PACK_FAILURE_RECEIPT_INVALID' using errcode='22023';
    end if;
    if v_paper_failure_code not in (
      'CANDIDATE_PAPER_PACK_ASSEMBLY_TRANSIENT',
      'CANDIDATE_PAPER_SOURCE_READ_TRANSIENT',
      'CANDIDATE_PAPER_R2_WRITE_TRANSIENT',
      'CANDIDATE_PAPER_DOCUMENT_FAILED',
      'CANDIDATE_PAPER_OUTBOX_NOT_READY',
      'CANDIDATE_PAPER_RETURN_MANIFEST_STALE',
      'CANDIDATE_PAPER_PACK_MEDIA_TYPE_INVALID',
      'CANDIDATE_PAPER_PACK_COMPONENT_MISSING',
      'CANDIDATE_PAPER_PACK_INCOMPLETE',
      'CANDIDATE_PAPER_PACK_IDENTITY_INVALID',
      'CANDIDATE_PAPER_PACK_IDENTITY_CONFLICT',
      'CANDIDATE_PAPER_OUTBOX_CONFLICT',
      'CANDIDATE_PAPER_PACK_OPERATIONAL_REVIEW_REQUIRED'
    ) then
      v_paper_failure_code:='CANDIDATE_PAPER_PACK_OPERATIONAL_REVIEW_REQUIRED';
    end if;
    v_paper_failure_class:=case
      when v_paper_failure_code in (
        'CANDIDATE_PAPER_PACK_ASSEMBLY_TRANSIENT',
        'CANDIDATE_PAPER_SOURCE_READ_TRANSIENT',
        'CANDIDATE_PAPER_R2_WRITE_TRANSIENT'
      ) then 'RETRYABLE'
      when v_paper_failure_code in (
        'CANDIDATE_PAPER_RETURN_MANIFEST_STALE',
        'CANDIDATE_PAPER_DOCUMENT_FAILED',
        'CANDIDATE_PAPER_OUTBOX_NOT_READY',
        'CANDIDATE_PAPER_PACK_MEDIA_TYPE_INVALID',
        'CANDIDATE_PAPER_PACK_COMPONENT_MISSING',
        'CANDIDATE_PAPER_PACK_INCOMPLETE',
        'CANDIDATE_PAPER_PACK_IDENTITY_INVALID',
        'CANDIDATE_PAPER_PACK_IDENTITY_CONFLICT',
        'CANDIDATE_PAPER_OUTBOX_CONFLICT',
        'CANDIDATE_PAPER_PACK_OPERATIONAL_REVIEW_REQUIRED'
      ) then 'TERMINAL'
      else 'TERMINAL' end;
    v_paper_failure_retryable:=v_paper_failure_class='RETRYABLE';
    v_paper_pack_attempt_token:=lower(btrim(coalesce(v_payload->>'paper_pack_attempt_token','')));
    if v_paper_mail_id is null then
      v_response:=jsonb_build_object(
        'ok',true,'workflow_id',v_workflow.id,'generation',v_workflow.generation,
        'mail_outbox_id',null,'paper_pack_state','FAILED_TERMINAL',
        'failure_scope','WORKFLOW','failure_class','TERMINAL',
        'failure_code',v_paper_failure_code,'retryable',false,
        'paper_pack_operation_id',v_paper_pack_operation_id,
        'failure_contract_version','CANDIDATE_PAPER_PACK_FAILURE_V2'
      );
    else
    select * into v_paper_mail
    from public.mail_outbox candidate_paper_mail
    where candidate_paper_mail.id=v_paper_mail_id
      and candidate_paper_mail.type='TIMESHEET_QR'
      and candidate_paper_mail.context_kind='timesheets'
      and candidate_paper_mail.payment_scope_json->>'candidate_mail_authority'='CANDIDATE_PAPER_V1'
      and candidate_paper_mail.payment_scope_json->>'candidate_workflow_id'=v_workflow.id::text
      and candidate_paper_mail.payment_scope_json->>'candidate_workflow_generation'=v_workflow.generation::text
      and lower(coalesce(candidate_paper_mail.payment_scope_json->>'paper_return_manifest_sha256',''))
            =v_paper_manifest_sha256
    for update;
    if not found then
      raise exception 'CANDIDATE_PAPER_OUTBOX_NOT_READY' using errcode='40001';
    end if;
    if nullif(btrim(coalesce(v_paper_mail.attempt_lease_token,'')),'') is not null
       and v_paper_mail.attempt_lease_expires_at_utc>p_now_utc then
      raise exception 'CANDIDATE_PAPER_MAIL_DELIVERY_IN_PROGRESS' using errcode='40001';
    end if;
    if lower(coalesce(v_paper_mail.payment_scope_json->>'candidate_paper_generation_retired','false'))
         in ('true','t','1','yes') then
      raise exception 'CANDIDATE_PAPER_WORKFLOW_STALE' using errcode='40001';
    end if;
    if nullif(v_paper_mail.payment_scope_json->>'candidate_paper_pack_attempt_token','') is not null
       and lower(v_paper_mail.payment_scope_json->>'candidate_paper_pack_attempt_token')
             is distinct from nullif(v_paper_pack_attempt_token,'') then
      raise exception 'CANDIDATE_PAPER_PACK_ATTEMPT_STALE' using errcode='40001';
    end if;
    if v_paper_pack_operation_id is not null
       and nullif(v_paper_mail.payment_scope_json->>'candidate_paper_pack_operation_id','')
             is distinct from v_paper_pack_operation_id then
      raise exception 'CANDIDATE_PAPER_PACK_ATTEMPT_STALE' using errcode='40001';
    end if;
    v_paper_pack_attempt_count:=coalesce(
      nullif(v_paper_mail.payment_scope_json->>'candidate_paper_pack_attempt_count','')::integer,0
    );
    v_paper_pack_next_retry_at:=case when v_paper_failure_retryable then p_now_utc+case
      when v_paper_pack_attempt_count<=1 then interval '1 minute'
      when v_paper_pack_attempt_count=2 then interval '5 minutes'
      when v_paper_pack_attempt_count=3 then interval '15 minutes'
      else interval '30 minutes' end else null end;
    update public.mail_outbox candidate_paper_mail
    set payment_scope_json=candidate_paper_mail.payment_scope_json||jsonb_build_object(
      'candidate_paper_pack_ready',false,
      'candidate_paper_pack_retryable',v_paper_failure_retryable,
      'candidate_paper_pack_failure_class',v_paper_failure_class,
      'candidate_paper_pack_failure_code',v_paper_failure_code,
      'candidate_paper_pack_failure_contract_version','CANDIDATE_PAPER_PACK_FAILURE_V2',
      'candidate_paper_pack_failed_at_utc',p_now_utc,
      'candidate_paper_pack_next_retry_at_utc',v_paper_pack_next_retry_at,
      'candidate_paper_pack_attempt_token',null,
      'candidate_paper_pack_attempt_expires_at_utc',null,
      'candidate_paper_pack_operation_id',coalesce(
        v_paper_pack_operation_id,
        candidate_paper_mail.payment_scope_json->>'candidate_paper_pack_operation_id'
      ),
      'candidate_paper_pack_operation_state',case when v_paper_failure_retryable
        then 'FAILED_RETRYABLE' else 'FAILED_TERMINAL' end
    )
    where candidate_paper_mail.id=v_paper_mail.id;
    v_response:=jsonb_build_object(
      'ok',true,'workflow_id',v_workflow.id,'generation',v_workflow.generation,
      'mail_outbox_id',v_paper_mail.id,'paper_pack_state',
        case when v_paper_failure_retryable then 'FAILED_RETRYABLE' else 'FAILED_TERMINAL' end,
      'failure_class',v_paper_failure_class,'failure_code',v_paper_failure_code,
      'paper_pack_operation_id',coalesce(
        v_paper_pack_operation_id,
        v_paper_mail.payment_scope_json->>'candidate_paper_pack_operation_id'
      ),
      'retryable',v_paper_failure_retryable,
      'failure_contract_version','CANDIDATE_PAPER_PACK_FAILURE_V2',
      'paper_pack_attempt_count',v_paper_pack_attempt_count,
      'next_retry_at_utc',v_paper_pack_next_retry_at
    );
    end if;
    update public.candidate_submission_workflows
    set last_mutation_idempotency_key=p_idempotency_key,
        last_mutation_response_json=v_response,updated_at_utc=p_now_utc
    where id=v_workflow.id and generation=v_workflow.generation;

  elsif v_action='PAPER_PACK_RELEASE' then
    if not v_is_service_action or p_session_id is not null then
      raise exception 'CANDIDATE_PAPER_PACK_RELEASE_SERVICE_REQUIRED' using errcode='28000';
    end if;
    if v_workflow.state<>'AWAITING_PAPER_RETURN' or v_workflow.route<>'PAPER' then
      raise exception 'CANDIDATE_PAPER_WORKFLOW_STALE' using errcode='40001';
    end if;
    if v_workflow.paper_return_manifest_sha256 is null
       or private._candidate_sha256_jsonb_v1(v_workflow.paper_return_manifest_json)
          is distinct from v_workflow.paper_return_manifest_sha256
       or jsonb_typeof(v_workflow.paper_return_manifest_json->'pages') is distinct from 'array'
       or exists(
         select 1
         from jsonb_array_elements(v_workflow.paper_return_manifest_json->'pages') manifest_page
         where upper(coalesce(manifest_page->>'component_kind',''))='EXPENSE_SUMMARY'
            or upper(coalesce(manifest_page->>'page_key',''))='EXPENSE_SUMMARY'
       ) then
      raise exception 'CANDIDATE_PAPER_RETURN_MANIFEST_STALE' using errcode='55000';
    end if;
    -- RELEASE is a separate transaction from ATTEMPT_CLAIM. Recompute the
    -- update hold while the workflow row is locked; rebind/abort take the
    -- same lock, so this truth cannot change before the outbox update.
    select exists(
      select 1 from public.candidate_pending_expense_updates update_row
      where update_row.workflow_id=v_workflow.id
        and update_row.update_mode='PAPER_REPLACEMENT'
        and update_row.current_workflow_generation=v_workflow.generation
        and update_row.state in ('EDITING','RENDERING')
    ) into v_paper_expense_update_active;

    v_paper_timesheet_id:=coalesce(v_workflow.target_timesheet_id,v_workflow.anchor_timesheet_id);
    v_paper_mail_id:=nullif(btrim(coalesce(v_payload->>'mail_outbox_id','')),'')::uuid;
    v_paper_manifest_sha256:=lower(btrim(coalesce(v_payload->>'paper_return_manifest_sha256','')));
    v_paper_pack_storage_key:=nullif(btrim(coalesce(v_payload->>'complete_pack_storage_key','')),'');
    v_paper_pack_sha256:=lower(btrim(coalesce(v_payload->>'complete_pack_sha256','')));
    v_paper_pack_media_type:=lower(btrim(coalesce(v_payload->>'complete_pack_media_type','')));
    v_paper_base_document_sha256:=lower(btrim(coalesce(v_payload->>'base_document_sha256','')));
    v_paper_branding_contract_sha256:=lower(btrim(coalesce(v_payload->>'branding_contract_sha256','')));
    v_paper_renderer_contract_version:=btrim(coalesce(v_payload->>'renderer_contract_version',''));
    v_paper_pack_attempt_token:=lower(btrim(coalesce(v_payload->>'paper_pack_attempt_token','')));
    v_paper_pack_operation_id:=nullif(btrim(coalesce(
      v_payload->>'paper_pack_operation_id',''
    )), '');
    begin
      v_paper_pack_byte_size:=(v_payload->>'complete_pack_byte_size')::bigint;
      v_paper_pack_page_count:=(v_payload->>'complete_pack_page_count')::integer;
    exception when others then
      raise exception 'CANDIDATE_PAPER_PACK_RECEIPT_INVALID' using errcode='22023';
    end;
    if v_paper_mail_id is null
       or v_paper_manifest_sha256 !~ '^[0-9a-f]{64}$'
       or v_paper_pack_sha256 !~ '^[0-9a-f]{64}$'
       or v_paper_base_document_sha256 !~ '^[0-9a-f]{64}$'
       or v_paper_branding_contract_sha256 !~ '^[0-9a-f]{64}$'
       or v_paper_pack_media_type<>'application/pdf'
       or coalesce(v_paper_pack_byte_size,0)<1
       or coalesce(v_paper_pack_page_count,0)<1
       or v_paper_renderer_contract_version=''
       or (v_paper_pack_attempt_token<>'' and v_paper_pack_operation_id is null)
       or v_paper_manifest_sha256<>encode(v_workflow.paper_return_manifest_sha256,'hex')
       or v_paper_renderer_contract_version<>coalesce(
         v_workflow.renderer_contract_version,
         v_workflow.immutable_submission_json#>>'{official_presentation,renderer_contract_version}'
       )
       or v_paper_branding_contract_sha256<>lower(coalesce(
         v_workflow.immutable_submission_json#>>'{official_presentation,branding,branding_contract_sha256}',''
       )) then
      raise exception 'CANDIDATE_PAPER_PACK_RECEIPT_INVALID' using errcode='22023';
    end if;
    v_paper_expected_storage_key:='candidate-app/'||lower(v_environment)||'/'
      ||v_workflow.id::text||'/'||v_workflow.generation::text||'/paper-pack/'
      ||v_paper_manifest_sha256||'-'||v_paper_base_document_sha256||'-'
      ||v_paper_branding_contract_sha256||'-'||v_paper_renderer_contract_version||'.pdf';
    if v_paper_pack_storage_key is distinct from v_paper_expected_storage_key then
      raise exception 'CANDIDATE_PAPER_PACK_IDENTITY_CONFLICT' using errcode='40001';
    end if;
    if jsonb_array_length(coalesce(v_workflow.paper_return_manifest_json->'pages','[]'::jsonb))
         <>v_paper_pack_page_count then
      raise exception 'CANDIDATE_PAPER_PACK_PAGE_COUNT_MISMATCH' using errcode='22023';
    end if;

    select count(*)::integer into v_paper_outbox_count
    from public.mail_outbox candidate_paper_mail
    where candidate_paper_mail.type='TIMESHEET_QR'
      and candidate_paper_mail.context_kind='timesheets'
      and candidate_paper_mail.context_id=v_paper_timesheet_id
      and candidate_paper_mail.payment_scope_json->>'candidate_mail_authority'='CANDIDATE_PAPER_V1'
      and candidate_paper_mail.payment_scope_json->>'candidate_workflow_id'=v_workflow.id::text
      and candidate_paper_mail.payment_scope_json->>'candidate_workflow_generation'=v_workflow.generation::text
      and lower(coalesce(candidate_paper_mail.payment_scope_json->>'paper_return_manifest_sha256',''))
            =v_paper_manifest_sha256;
    if v_paper_outbox_count<>1 then
      raise exception 'CANDIDATE_PAPER_OUTBOX_CONFLICT' using errcode='40001';
    end if;

    select * into v_paper_mail
    from public.mail_outbox candidate_paper_mail
    where candidate_paper_mail.id=v_paper_mail_id
      and candidate_paper_mail.type='TIMESHEET_QR'
      and candidate_paper_mail.context_kind='timesheets'
      and candidate_paper_mail.context_id=v_paper_timesheet_id
      and candidate_paper_mail.payment_scope_json->>'candidate_mail_authority'='CANDIDATE_PAPER_V1'
      and candidate_paper_mail.payment_scope_json->>'candidate_workflow_id'=v_workflow.id::text
      and candidate_paper_mail.payment_scope_json->>'candidate_workflow_generation'=v_workflow.generation::text
      and lower(coalesce(candidate_paper_mail.payment_scope_json->>'paper_return_manifest_sha256',''))
            =v_paper_manifest_sha256
    for update;
    if not found then
      raise exception 'CANDIDATE_PAPER_OUTBOX_NOT_READY' using errcode='40001';
    end if;
    if v_paper_mail.status='FAILED' then
      raise exception 'CANDIDATE_PAPER_OUTBOX_FAILED' using errcode='55000';
    end if;
    if nullif(btrim(coalesce(v_paper_mail.attempt_lease_token,'')),'') is not null then
      raise exception 'CANDIDATE_PAPER_MAIL_DELIVERY_IN_PROGRESS' using errcode='40001';
    end if;
    if nullif(v_paper_mail.payment_scope_json->>'candidate_paper_pack_attempt_token','') is not null
       and lower(v_paper_mail.payment_scope_json->>'candidate_paper_pack_attempt_token')
             is distinct from nullif(v_paper_pack_attempt_token,'') then
      raise exception 'CANDIDATE_PAPER_PACK_ATTEMPT_STALE' using errcode='40001';
    end if;
    if v_paper_pack_operation_id is not null
       and nullif(v_paper_mail.payment_scope_json->>'candidate_paper_pack_operation_id','')
             is distinct from v_paper_pack_operation_id then
      raise exception 'CANDIDATE_PAPER_PACK_ATTEMPT_STALE' using errcode='40001';
    end if;
    if lower(coalesce(v_paper_mail.payment_scope_json->>'candidate_paper_generation_retired','false'))
         in ('true','t','1','yes') then
      raise exception 'CANDIDATE_PAPER_WORKFLOW_STALE' using errcode='40001';
    end if;

    v_paper_pack_attachment:=jsonb_build_array(jsonb_build_object(
      'r2_key',v_paper_pack_storage_key,
      'filename',case when v_workflow.workflow_kind='CONTRACT_EXPENSE'
        then 'Expense_' else 'Timesheet_' end
        ||coalesce(v_workflow.week_ending_date::text,v_paper_timesheet_id::text)||'.pdf',
      'content_type','application/pdf','sha256',v_paper_pack_sha256,
      'size_bytes',v_paper_pack_byte_size,'page_count',v_paper_pack_page_count,
      'candidate_workflow_id',v_workflow.id,
      'candidate_workflow_generation',v_workflow.generation,
      'paper_return_manifest_sha256',v_paper_manifest_sha256
    ));

    if v_paper_mail.status in ('QUEUED','SENT')
       and lower(coalesce(v_paper_mail.payment_scope_json->>'candidate_paper_pack_ready','false'))
            in ('true','t','1','yes')
       and v_paper_mail.attachments=v_paper_pack_attachment
       and v_paper_mail.payment_scope_json->>'candidate_complete_pack_storage_key'=v_paper_pack_storage_key
       and lower(coalesce(v_paper_mail.payment_scope_json->>'candidate_complete_pack_sha256',''))=v_paper_pack_sha256
       and v_paper_mail.payment_scope_json->>'candidate_complete_pack_size_bytes'=v_paper_pack_byte_size::text
       and v_paper_mail.payment_scope_json->>'candidate_complete_pack_page_count'=v_paper_pack_page_count::text then
      v_paper_release_idempotent:=true;
    elsif v_paper_mail.status='SENT' then
      raise exception 'CANDIDATE_PAPER_OUTBOX_ALREADY_SENT' using errcode='55000';
    elsif v_paper_mail.status<>'QUEUED'
       or lower(coalesce(v_paper_mail.payment_scope_json->>'candidate_paper_pack_ready','false'))
            not in ('false','f','0','no')
       or lower(coalesce(v_paper_mail.payment_scope_json->>'mail_held_until_pdf_rendered','false'))
            not in ('true','t','1','yes')
       or v_paper_mail.payment_scope_json->>'mail_hold_reason'<>'CANDIDATE_PAPER_PACK_PENDING'
       or jsonb_typeof(v_paper_mail.attachments)<>'array'
       or jsonb_array_length(v_paper_mail.attachments)<>0 then
      raise exception 'CANDIDATE_PAPER_OUTBOX_NOT_READY' using errcode='40001';
    else
      update public.mail_outbox candidate_paper_mail
      set attachments=v_paper_pack_attachment,
          scheduled_for_utc=case when v_paper_expense_update_active
            then 'infinity'::timestamptz else p_now_utc end,
          next_attempt_at_utc=case when v_paper_expense_update_active
            then 'infinity'::timestamptz else p_now_utc end,
          payment_scope_json=candidate_paper_mail.payment_scope_json||jsonb_build_object(
            'candidate_paper_pack_ready',true,
            'candidate_paper_pack_retryable',false,
            'candidate_paper_pack_failure_class',null,
            'candidate_paper_pack_failure_code',null,
            'candidate_paper_pack_failure_contract_version',null,
            'candidate_paper_pack_failed_at_utc',null,
            'candidate_paper_pack_next_retry_at_utc',null,
            'candidate_paper_pack_attempt_token',null,
            'candidate_paper_pack_attempt_expires_at_utc',null,
            'candidate_paper_pack_operation_id',coalesce(
              v_paper_pack_operation_id,
              candidate_paper_mail.payment_scope_json->>'candidate_paper_pack_operation_id'
            ),
            'candidate_paper_pack_operation_state','READY',
            'mail_held_until_pdf_rendered',v_paper_expense_update_active,
            'mail_delayed_for_pdf_render',v_paper_expense_update_active,
            'mail_hold_reason',case when v_paper_expense_update_active
              then 'CANDIDATE_EXPENSE_UPDATE_PENDING' end,
            'candidate_expense_update_hold',v_paper_expense_update_active,
            'candidate_complete_pack_storage_key',v_paper_pack_storage_key,
            'candidate_complete_pack_sha256',v_paper_pack_sha256,
            'candidate_complete_pack_size_bytes',v_paper_pack_byte_size,
            'candidate_complete_pack_page_count',v_paper_pack_page_count,
            'candidate_complete_pack_media_type','application/pdf',
            'candidate_complete_pack_ready_at_utc',p_now_utc,
            'candidate_complete_pack_base_document_sha256',v_paper_base_document_sha256,
            'candidate_complete_pack_branding_contract_sha256',v_paper_branding_contract_sha256,
            'candidate_complete_pack_renderer_contract_version',v_paper_renderer_contract_version
          )
      where candidate_paper_mail.id=v_paper_mail.id
        and candidate_paper_mail.status='QUEUED'
        and candidate_paper_mail.attempt_lease_token is null
        and lower(coalesce(candidate_paper_mail.payment_scope_json->>'candidate_paper_pack_ready','false'))
              in ('false','f','0','no')
        and lower(coalesce(candidate_paper_mail.payment_scope_json->>'candidate_paper_generation_retired','false'))
              in ('false','f','0','no');
      if not found then
        raise exception 'CANDIDATE_PAPER_OUTBOX_NOT_READY' using errcode='40001';
      end if;
    end if;

    if not v_paper_expense_update_active then
      insert into public.candidate_notifications(
        account_id,candidate_id,workflow_id,timesheet_id,event_type,preference_category,
        template_key,template_params,deep_link_json,state,push_state,dedupe_key,created_at_utc
      ) values (
        v_workflow.account_id,v_workflow.candidate_id,v_workflow.id,v_paper_timesheet_id,
        'PAPER_PACK_READY','resubmission_required','candidate-paper-pack-ready-v1',
        jsonb_build_object('page_count',v_paper_pack_page_count,'workflow_generation',v_workflow.generation),
        jsonb_build_object('type','paper_pack','timesheet_id',v_paper_timesheet_id,
          'workflow_id',v_workflow.id,'workflow_generation',v_workflow.generation),
        'UNREAD','PENDING',
        'CANDIDATE_PAPER_PACK_READY_V1:'||v_workflow.id::text||':'
          ||v_workflow.generation::text||':'||v_paper_manifest_sha256,
        p_now_utc
      ) on conflict(dedupe_key) do nothing
      returning id into v_paper_notification_id;
      if v_paper_notification_id is null then
        select notification.id into v_paper_notification_id
        from public.candidate_notifications notification
        where notification.dedupe_key='CANDIDATE_PAPER_PACK_READY_V1:'||v_workflow.id::text||':'
          ||v_workflow.generation::text||':'||v_paper_manifest_sha256;
      end if;
    end if;

    update public.candidate_submission_workflows
    set updated_at_utc=p_now_utc
    where id=v_workflow.id
      and generation=v_workflow.generation
      and state='AWAITING_PAPER_RETURN'
      and route='PAPER';
    if not found then
      raise exception 'CANDIDATE_PAPER_WORKFLOW_STALE' using errcode='40001';
    end if;

    v_response:=jsonb_build_object(
      'ok',true,'workflow_id',v_workflow.id,'generation',v_workflow.generation,
      'state',v_workflow.state,'timesheet_id',v_paper_timesheet_id,
      'mail_outbox_id',v_paper_mail.id,'notification_id',v_paper_notification_id,
      'paper_return_manifest_sha256',v_paper_manifest_sha256,
      'paper_pack_operation_id',coalesce(
        v_paper_pack_operation_id,
        v_paper_mail.payment_scope_json->>'candidate_paper_pack_operation_id'
      ),
      'complete_pack_storage_key',v_paper_pack_storage_key,
      'complete_pack_sha256',v_paper_pack_sha256,
      'complete_pack_byte_size',v_paper_pack_byte_size,
      'complete_pack_page_count',v_paper_pack_page_count,
      'paper_pack_held_for_expense_update',v_paper_expense_update_active,
      'idempotent_replay',v_paper_release_idempotent
    );

  elsif v_action='PAPER_RETURN' then
    if v_workflow.state<>'AWAITING_PAPER_RETURN' then
      raise exception 'CANDIDATE_WORKFLOW_TRANSITION_INVALID' using errcode='55000';
    end if;
    if v_workflow.paper_return_manifest_sha256 is null
       or private._candidate_sha256_jsonb_v1(v_workflow.paper_return_manifest_json)
          is distinct from v_workflow.paper_return_manifest_sha256 then
      raise exception 'CANDIDATE_PAPER_RETURN_MANIFEST_STALE' using errcode='55000';
    end if;
    -- The claimed mail lease is the provider-submit permit. PAPER return and
    -- every authority-changing transition lock the same exact delivery row,
    -- so provider submission cannot be authorised and then invalidated before
    -- its external call. An active permit is a controlled retryable conflict.
    select count(*)::integer into v_paper_outbox_count
    from public.mail_outbox candidate_mail
    where candidate_mail.type='TIMESHEET_QR'
      and candidate_mail.context_kind='timesheets'
      and candidate_mail.payment_scope_json->>'candidate_workflow_id'=v_workflow.id::text
      and candidate_mail.payment_scope_json->>'candidate_workflow_generation'=v_workflow.generation::text
      and lower(coalesce(candidate_mail.payment_scope_json->>'paper_return_manifest_sha256',''))
            =encode(v_workflow.paper_return_manifest_sha256,'hex');
    if v_paper_outbox_count<>1 then
      raise exception 'CANDIDATE_PAPER_OUTBOX_CONFLICT' using errcode='40001';
    end if;
    select candidate_mail.* into v_paper_mail
    from public.mail_outbox candidate_mail
    where candidate_mail.type='TIMESHEET_QR'
      and candidate_mail.context_kind='timesheets'
      and candidate_mail.payment_scope_json->>'candidate_workflow_id'=v_workflow.id::text
      and candidate_mail.payment_scope_json->>'candidate_workflow_generation'=v_workflow.generation::text
      and lower(coalesce(candidate_mail.payment_scope_json->>'paper_return_manifest_sha256',''))
            =encode(v_workflow.paper_return_manifest_sha256,'hex')
    for update;
    if nullif(btrim(coalesce(v_paper_mail.attempt_lease_token,'')),'') is not null
       and (v_paper_mail.attempt_lease_expires_at_utc is null
         or v_paper_mail.attempt_lease_expires_at_utc>p_now_utc) then
      raise exception 'CANDIDATE_PAPER_MAIL_DELIVERY_IN_PROGRESS'
        using errcode='40001',detail=jsonb_build_object(
          'workflow_id',v_workflow.id,'generation',v_workflow.generation,
          'mail_outbox_id',v_paper_mail.id
        )::text;
    end if;
    if lower(coalesce(v_paper_mail.payment_scope_json->>'candidate_paper_generation_retired','false'))
         in ('true','t','1','yes') then
      raise exception 'CANDIDATE_PAPER_WORKFLOW_STALE' using errcode='40001';
    end if;
    if exists(
      select 1
      from jsonb_array_elements(v_workflow.paper_return_manifest_json->'pages') expected_page
      where (
        select count(*)
        from public.candidate_submission_components returned_page
        where returned_page.workflow_id=v_workflow.id
          and returned_page.workflow_generation=v_workflow.generation
          and returned_page.component_kind='SIGNED_RETURN'
          and returned_page.paper_return_page_key=expected_page->>'page_key'
          and returned_page.state='IMMUTABLE'
          and returned_page.source_content_sha256 is not null
      )<>1
    ) or exists(
      select 1
      from public.candidate_submission_components returned_page
      where returned_page.workflow_id=v_workflow.id
        and returned_page.workflow_generation=v_workflow.generation
        and returned_page.component_kind='SIGNED_RETURN'
        and returned_page.state='IMMUTABLE'
        and not exists(
          select 1
          from jsonb_array_elements(v_workflow.paper_return_manifest_json->'pages') expected_page
          where expected_page->>'page_key'=returned_page.paper_return_page_key
        )
    ) then raise exception 'CANDIDATE_PAPER_RETURN_INCOMPLETE' using errcode='22023'; end if;
    v_response:=jsonb_build_object('ok',true,'workflow_id',v_workflow.id,
      'state','RECEIVED','generation',v_workflow.generation);
    update public.candidate_submission_workflows set
      state='RECEIVED',last_mutation_idempotency_key=p_idempotency_key,
      last_mutation_response_json=v_response,updated_at_utc=p_now_utc
    where id=v_workflow.id returning * into v_workflow;

  elsif v_action='MARK_READ' then
    update public.candidate_notifications set state='READ',read_at_utc=p_now_utc
    where id=nullif(v_payload->>'notification_id','')::uuid
      and account_id=v_account_id and state='UNREAD';
    v_response:=jsonb_build_object('ok',true,
      'notification_id',nullif(v_payload->>'notification_id','')::uuid,'state','READ');
  else
    raise exception 'CANDIDATE_WORKFLOW_ACTION_INVALID'
      using errcode='22023',detail=jsonb_build_object(
        'code','CANDIDATE_WORKFLOW_ACTION_INVALID','action',v_action)::text;
  end if;

  perform private._candidate_audit_v1('candidate_submission_workflow',v_workflow.id::text,
    'CANDIDATE_WORKFLOW_'||v_action,
    jsonb_build_object('state',v_workflow.state,'generation',v_workflow.generation),
    v_response,v_audit_reason,null,p_idempotency_key,p_now_utc);
  if v_mutation_request_sha256 is not null then
    perform private._candidate_workflow_mutation_receipt_v1(
      v_workflow.id,p_idempotency_key,v_mutation_request_sha256,v_action,
      v_mutation_channel,v_mutation_actor_identity,v_response,p_now_utc
    );
  end if;
  return v_response;
exception
  when unique_violation then
    get stacked diagnostics v_constraint_name=constraint_name;
    if v_constraint_name='candidate_submission_components_source_sha256_uq' then
      raise exception 'CANDIDATE_EVIDENCE_BYTES_ALREADY_USED' using errcode='23505';
    elsif v_constraint_name in (
      'candidate_submission_components_hours_review_uq',
      'candidate_submission_components_required_ordinal_uq'
    ) then
      raise exception 'MANAGER_REVIEW_DOCUMENT_STALE' using errcode='23505';
    elsif v_constraint_name='candidate_submission_workflows_one_active_expense_uq' then
      raise exception 'CANDIDATE_EXPENSE_CLAIM_ALREADY_ACTIVE' using errcode='23505';
    elsif v_constraint_name='candidate_submission_workflows_account_idempotency_uq' then
      raise exception 'CANDIDATE_IDEMPOTENCY_CONFLICT'
        using errcode=case when v_is_rejected_resubmission then '55000' else '40001' end;
    elsif v_constraint_name='candidate_submission_workflows_replacement_source_uq' then
      raise exception 'CANDIDATE_REJECTED_WORKFLOW_ALREADY_REPLACED' using errcode='55000';
    elsif v_constraint_name='candidate_submission_components_paper_return_page_uq' then
      raise exception 'CANDIDATE_PAPER_RETURN_PAGE_DUPLICATE' using errcode='23505';
    end if;
    raise;
end;
$function$;

create or replace function private._candidate_component_render_contract_v1(
  p_workflow_id uuid,
  p_workflow_generation integer,
  p_component_id uuid,
  p_phase text
)
returns jsonb
language plpgsql
stable
security definer
set search_path = pg_catalog, public, private, pg_temp
as $function$
declare
  v_phase text:=upper(btrim(coalesce(p_phase,'')));
  v_workflow public.candidate_submission_workflows%rowtype;
  v_component public.candidate_submission_components%rowtype;
  v_manager_signature public.candidate_submission_components%rowtype;
  v_component_input jsonb;
  v_form_variant text;
  v_manager jsonb:='null'::jsonb;
  v_candidate_required boolean;
  v_worker_only_approval boolean:=false;
begin
  if v_phase not in ('REVIEW','FINAL') then
    raise exception 'CANDIDATE_RENDER_PHASE_INVALID' using errcode='22023';
  end if;
  select * into v_workflow from public.candidate_submission_workflows
  where id=p_workflow_id and generation=p_workflow_generation;
  if not found then raise exception 'WORKFLOW_GENERATION_CONFLICT' using errcode='40001'; end if;
  select * into v_component from public.candidate_submission_components
  where id=p_component_id and workflow_id=v_workflow.id
    and workflow_generation=v_workflow.generation and required=true and state<>'SUPERSEDED';
  if not found then raise exception 'MANAGER_REVIEW_DOCUMENT_STALE' using errcode='55000'; end if;

  v_candidate_required:=v_component.component_kind='HOURS_TIMESHEET';
  v_worker_only_approval:=v_candidate_required and v_workflow.scope='WEEKLY'
    and v_workflow.workflow_kind='CONTRACT_HOURS' and v_workflow.route='ELECTRONIC'
    and coalesce(v_workflow.policy_snapshot_json#>'{manager_approval_policy,approval}'='"NOT_REQUIRED"'::jsonb,false);
  v_form_variant:=case
    when v_worker_only_approval then 'ELECTRONIC_WORKER_SIGNED'
    when v_phase='REVIEW' and v_candidate_required then 'ELECTRONIC_MANAGER_REVIEW'
    when v_phase='REVIEW' then 'EXPENSE_MANAGER_REVIEW'
    when v_candidate_required then 'ELECTRONIC_SIGNED'
    else 'EXPENSE_MANAGER_SIGNED' end;
  v_component_input:=private._candidate_component_render_input_v1(
    p_workflow_id,p_workflow_generation,p_component_id);

  if v_phase='FINAL' and not v_worker_only_approval then
    select * into v_manager_signature
    from public.candidate_submission_components
    where id=v_workflow.manager_signature_component_id
      and workflow_id=v_workflow.id
      and workflow_generation=v_workflow.generation
      and component_kind='MANAGER_SIGNATURE'
      and document_role='MANAGER_SIGNATURE'
      and state='IMMUTABLE';
    if not found
       or v_manager_signature.source_content_sha256 is distinct from v_workflow.manager_signature_sha256
       or v_workflow.manager_approved_at_utc is null then
      raise exception 'MANAGER_SIGNATURE_REQUIRED' using errcode='55000';
    end if;
    v_manager:=jsonb_build_object(
      'name',v_workflow.manager_name,
      'position',v_workflow.manager_position,
      'signature_component_id',v_manager_signature.id,
      'signature_storage_key',v_manager_signature.storage_key,
      'signature_sha256',encode(v_manager_signature.source_content_sha256,'hex'),
      'approval_date_utc',v_workflow.manager_approved_at_utc
    );
  end if;

  return jsonb_build_object(
    'form_variant',v_form_variant,
    'phase',v_phase,
    'workflow_id',v_workflow.id,
    'workflow_generation',v_workflow.generation,
    'workflow_kind',v_workflow.workflow_kind,
    'scope',v_workflow.scope,
    'component_id',v_component.id,
    'component_kind',v_component.component_kind,
    'document_role',v_component.document_role,
    'expense_category',v_component.expense_category,
    'review_ordinal',v_component.review_ordinal,
    'render_input_sha256',v_component_input->>'render_input_sha256',
    'render_input',v_component_input,
    'manager',v_manager,
    'candidate_signature_embedded',v_candidate_required,
    'manager_signature_embedded',v_phase='FINAL' and not v_worker_only_approval,
    'manager_approval_date_embedded',v_phase='FINAL' and not v_worker_only_approval
  )||case when v_worker_only_approval then jsonb_build_object('worker_only_approval',true) else '{}'::jsonb end;
end;
$function$;

create or replace function public.candidate_submission_finalize_atomic_v1(
  p_session_id uuid,
  p_environment text,
  p_workflow_id uuid,
  p_expected_generation integer,
  p_expected_row_signature text default null,
  p_idempotency_key text default null,
  p_now_utc timestamptz default now(),
  p_daily_materialisation_json jsonb default null
)
returns jsonb
language plpgsql
security definer
set search_path = pg_catalog, public, private, pg_temp
set lock_timeout = '5s'
set statement_timeout = '120s'
as $function$
declare
  v_environment text;
  v_context jsonb;
  v_candidate_id uuid;
  v_workflow public.candidate_submission_workflows%rowtype;
  v_hours_component public.candidate_submission_components%rowtype;
  v_candidate_signature public.candidate_submission_components%rowtype;
  v_manager_signature public.candidate_submission_components%rowtype;
  v_approved_request public.candidate_approval_requests%rowtype;
  v_paper_hours_return public.candidate_submission_components%rowtype;
  v_contract public.contracts%rowtype;
  v_week public.contract_weeks%rowtype;
  v_anchor_week public.contract_weeks%rowtype;
  v_anchor_timesheet public.timesheets%rowtype;
  v_daily_timesheet public.timesheets%rowtype;
  v_daily_fin public.timesheets_financials%rowtype;
  v_daily_receipt_context jsonb;
  v_daily_receipt_only boolean:=false;
  v_completion_state text:='FINALISED';
  v_completion_generation integer;
  v_current_policy jsonb;
  v_system_actor uuid;
  v_input jsonb;
  v_electronic_patch jsonb:='{}'::jsonb;
  v_render_input jsonb;
  v_result jsonb;
  v_authorise_result jsonb;
  v_expense_authorise_result jsonb;
  v_response jsonb;
  v_target_timesheet_id uuid;
  v_hours_timesheet_id uuid;
  v_expense_timesheet_id uuid;
  v_evidence_component_ids uuid[];
  v_placement jsonb;
  v_hours_result jsonb;
  v_hours_input jsonb;
  v_expense_input jsonb;
  v_effective_separation boolean:=false;
  v_after_signature text;
  v_auto_requested boolean:=false;
  v_auto_blocked boolean:=false;
  v_auto_blockers jsonb:='[]'::jsonb;
  v_constraint_name text;
  v_target_capabilities jsonb;
  v_route_authority jsonb;
  v_daily_save_input jsonb;
  v_daily_patch jsonb;
  v_daily_signature jsonb;
  v_daily_save_receipt jsonb;
  v_canonical_financials_id uuid;
  v_canonical_financial_sha256 bytea;
  v_service_finalisation jsonb;
  v_is_office_service boolean:=false;
  v_replay_probe_only boolean:=false;
  v_key_replay_probe_only boolean:=false;
  v_mutation_channel text;
  v_mutation_actor_identity text;
  v_mutation_request_hash text;
  v_mutation_receipt jsonb;
  v_prior_receipt_before jsonb;
  v_prior_receipt_after jsonb;
  v_finalisation_identity jsonb;
  v_finalisation_identity_hash text;
  v_completion_before jsonb;
  v_completion_after jsonb;
  v_worker_only_approval boolean:=false;
  v_worker_only_final_state jsonb;
  v_checklist_candidate_id uuid;
begin
  v_environment:=private._candidate_assert_environment(p_environment);
  v_service_finalisation:=coalesce(p_daily_materialisation_json->'service_finalisation','{}'::jsonb);
  v_is_office_service:=p_session_id is null
    and private._candidate_office_service_context_valid_v1(
      v_environment,nullif(v_service_finalisation->>'actor_user_id','')::uuid,'RETRY_FINALISATION'
    );
  v_replay_probe_only:=p_session_id is null
    and coalesce((v_service_finalisation->>'replay_probe_only')::boolean,false);
  v_key_replay_probe_only:=p_session_id is null
    and coalesce((v_service_finalisation->>'replay_key_probe_only')::boolean,false);
  if not v_is_office_service then
    perform private._candidate_require_feature_v1(v_environment,'candidate_app_writes');
  end if;
  if nullif(btrim(coalesce(p_idempotency_key,'')),'') is null then raise exception 'CANDIDATE_IDEMPOTENCY_KEY_REQUIRED' using errcode='22023'; end if;

  -- SP-12: plain existing session authentication, then early admission.
  if (select active_owner from private.bpay_next_module_control where id=1)='NEXT' then
    if p_session_id is not null then
      v_context:=private._candidate_session_context_v1(
        p_session_id,v_environment,null,p_now_utc,false
      );
      v_candidate_id:=nullif(v_context->>'selected_candidate_id','')::uuid;
      if v_candidate_id is null then
        raise exception 'CANDIDATE_SELECTION_REQUIRED' using errcode='28000';
      end if;
    end if;
    perform private.weekly_source_pay_query_admit_v2();
  end if;

  -- Resolve only the existing native workflow target. This acquires I1/F1
  -- before the unchanged finalizer's first workflow business lock; its later
  -- locked session/actor, generation, signature and receipt checks stay intact.
  select w.candidate_id into v_checklist_candidate_id from public.candidate_submission_workflows w
    where w.id=p_workflow_id and w.environment=v_environment;
  if p_session_id is not null then
    v_context:=private._candidate_session_context_v1(p_session_id,v_environment,null,p_now_utc,false);
    v_checklist_candidate_id:=nullif(v_context->>'selected_candidate_id','')::uuid;
    if v_checklist_candidate_id is null then raise exception 'CANDIDATE_SELECTION_REQUIRED' using errcode='28000'; end if;
  end if;
  perform private.weekly_source_checklist_submission_cycle_admit_v1(
    p_workflow_id,v_environment,v_checklist_candidate_id);

  select * into v_workflow from public.candidate_submission_workflows where id=p_workflow_id for update;
  if not found or v_workflow.environment<>v_environment then
    raise exception 'CANDIDATE_WORKFLOW_NOT_FOUND' using errcode='P0002';
  end if;
  if p_session_id is null then
    v_candidate_id:=v_workflow.candidate_id;
  else
    v_context:=private._candidate_session_context_v1(p_session_id,v_environment,null,p_now_utc,true);
    v_candidate_id:=nullif(v_context->>'selected_candidate_id','')::uuid;
    if v_candidate_id is null then raise exception 'CANDIDATE_SELECTION_REQUIRED' using errcode='28000'; end if;
  end if;
  if v_workflow.candidate_id<>v_candidate_id then
    raise exception 'CANDIDATE_WORKFLOW_NOT_FOUND' using errcode='P0002';
  end if;
  if nullif(btrim(coalesce(v_workflow.idempotency_key,'')),'')=btrim(p_idempotency_key) then
    raise exception 'CANDIDATE_IDEMPOTENCY_CONFLICT'
      using errcode='40001',detail=jsonb_build_object(
        'code','CANDIDATE_IDEMPOTENCY_CONFLICT','workflow_id',v_workflow.id,
        'idempotency_key',btrim(p_idempotency_key),
        'reason','CREATION_KEY_REUSED_FOR_MUTATION'
      )::text;
  end if;
  v_mutation_channel:=case when v_is_office_service then 'OFFICE'
    when p_session_id is null then 'SERVICE' else 'CANDIDATE_CLIENT' end;
  v_mutation_actor_identity:=case when v_is_office_service
    then v_service_finalisation->>'actor_user_id' else coalesce(p_session_id::text,'SERVICE') end;
  if v_key_replay_probe_only then
    select ae.before_json,ae.after_json
    into v_prior_receipt_before,v_prior_receipt_after
    from public.audit_events ae
    where ae.object_type='candidate_workflow_mutation_receipt'
      and ae.object_id_text=v_workflow.id::text
      and ae.correlation_id=btrim(p_idempotency_key)
    order by ae.ts_utc desc,ae.id desc
    limit 1;
    if found then
      if upper(coalesce(v_prior_receipt_before->>'workflow_action',''))<>'RETRY_FINALISATION'
         or upper(coalesce(v_prior_receipt_before->>'channel',''))<>v_mutation_channel
         or coalesce(v_prior_receipt_before->>'actor_identity','')
              is distinct from coalesce(v_mutation_actor_identity,'')
         or nullif(v_prior_receipt_after->>'generation','')::integer
              is distinct from (p_expected_generation+case
                when v_workflow.workflow_kind='DAILY'
                  and v_prior_receipt_after->>'state'='RECEIVED'
                  and v_prior_receipt_after->>'office_resolution_pending'='true' then 0 else 1 end) then
        raise exception 'CANDIDATE_IDEMPOTENCY_CONFLICT'
          using errcode='40001',detail=jsonb_build_object(
            'code','CANDIDATE_IDEMPOTENCY_CONFLICT','workflow_id',v_workflow.id,
            'idempotency_key',btrim(p_idempotency_key)
          )::text;
      end if;
      return coalesce(v_prior_receipt_after,'{}'::jsonb)
        ||jsonb_build_object('idempotent_replay',true);
    end if;
    return jsonb_build_object(
      'ok',true,'replay_found',false,'workflow_id',v_workflow.id,
      'expected_generation',p_expected_generation
    );
  end if;
  -- Candidate-session calls retain their established lifecycle errors before
  -- an immutable approval identity exists. Service replay/finalisation calls
  -- continue through the receipt path below before mutable lifecycle checks.
  if p_session_id is not null then
    if v_workflow.route='PAPER' and v_workflow.state<>'RECEIVED' then
      raise exception 'CANDIDATE_PAPER_RETURN_INCOMPLETE' using errcode='55000';
    elsif v_workflow.route<>'PAPER' and v_workflow.state<>'READY_TO_FINALISE' then
      raise exception 'FINAL_SIGNED_DOCUMENT_NOT_READY' using errcode='55000';
    end if;
  end if;
  v_worker_only_approval:=v_workflow.scope='WEEKLY' and v_workflow.workflow_kind='CONTRACT_HOURS'
    and v_workflow.route='ELECTRONIC'
    and coalesce(v_workflow.policy_snapshot_json#>'{manager_approval_policy,approval}'='"NOT_REQUIRED"'::jsonb,false);
  v_finalisation_identity:=v_service_finalisation->'finalisation_identity';
  if jsonb_typeof(v_finalisation_identity) is distinct from 'object' then
    if v_worker_only_approval then
      v_finalisation_identity:=jsonb_build_object(
        'contract_version','CANDIDATE_FINALISATION_IDENTITY_V1',
        'workflow_id',v_workflow.id,'workflow_generation',p_expected_generation,
        'approval_method','ELECTRONIC','approval_request_id',null,'approval_request_generation',null,
        'review_manifest_sha256_hex',encode(v_workflow.review_manifest_sha256,'hex'),
        'paper_return_manifest_sha256_hex',null,
        'candidate_signature_sha256_hex',encode(v_workflow.candidate_signature_sha256,'hex'),
        'policy_snapshot_sha256_hex',encode(v_workflow.policy_snapshot_sha256,'hex'));
    elsif v_workflow.route='PAPER' then
      v_finalisation_identity:=jsonb_build_object(
        'contract_version','CANDIDATE_FINALISATION_IDENTITY_V1',
        'workflow_id',v_workflow.id,'workflow_generation',p_expected_generation,
        'approval_method','PAPER','approval_request_id',null,
        'approval_request_generation',null,'review_manifest_sha256_hex',null,
        'paper_return_manifest_sha256_hex',case when v_workflow.paper_return_manifest_sha256 is null
          then null else encode(v_workflow.paper_return_manifest_sha256,'hex') end
      );
    else
      select approved.* into v_approved_request
      from public.candidate_approval_requests approved
      where approved.workflow_id=v_workflow.id
        and approved.workflow_generation=p_expected_generation
        and approved.state='APPROVED'
        and (nullif(v_service_finalisation->>'approval_request_id','') is null
          or approved.id=(v_service_finalisation->>'approval_request_id')::uuid)
      order by approved.approved_at_utc desc,approved.id desc
      limit 1;
      v_finalisation_identity:=jsonb_build_object(
        'contract_version','CANDIDATE_FINALISATION_IDENTITY_V1',
        'workflow_id',v_workflow.id,'workflow_generation',p_expected_generation,
        'approval_method',coalesce(v_approved_request.method,v_service_finalisation->>'approval_method'),
        'approval_request_id',coalesce(v_approved_request.id,
          nullif(v_service_finalisation->>'approval_request_id','')::uuid),
        'approval_request_generation',v_approved_request.request_generation,
        'review_manifest_sha256_hex',case when v_approved_request.review_manifest_sha256 is null
          then null else encode(v_approved_request.review_manifest_sha256,'hex') end,
        'paper_return_manifest_sha256_hex',null
      );
    end if;
    v_service_finalisation:=v_service_finalisation||jsonb_build_object(
      'contract_version','CANDIDATE_MANAGER_FINALISATION_V1',
      'workflow_generation',p_expected_generation,
      'approval_method',v_finalisation_identity->>'approval_method',
      'approval_request_id',v_finalisation_identity->'approval_request_id',
      'approval_request_generation',v_finalisation_identity->'approval_request_generation',
      'review_manifest_sha256_hex',coalesce(v_finalisation_identity->>'review_manifest_sha256_hex',''),
      'paper_return_manifest_sha256_hex',coalesce(v_finalisation_identity->>'paper_return_manifest_sha256_hex',''),
      'finalisation_identity',v_finalisation_identity
    );
  end if;
  if jsonb_typeof(v_finalisation_identity) is distinct from 'object'
     or coalesce(v_finalisation_identity->>'contract_version','')
          <>'CANDIDATE_FINALISATION_IDENTITY_V1'
     or nullif(v_finalisation_identity->>'workflow_id','')::uuid is distinct from v_workflow.id
     or coalesce((v_finalisation_identity->>'workflow_generation')::integer,0)
          <>p_expected_generation
     or (upper(coalesce(v_finalisation_identity->>'approval_method','')) not in ('EMAIL','PHONE','PAPER')
       and not (v_worker_only_approval and v_finalisation_identity->>'approval_method'='ELECTRONIC')) then
    raise exception 'CANDIDATE_SERVICE_FINALISATION_INVALID'
      using errcode='28000',detail=jsonb_build_object('stage','IDENTITY')::text;
  end if;
  v_finalisation_identity_hash:=encode(extensions.digest(convert_to(
    v_finalisation_identity::text,'UTF8'
  ),'sha256'),'hex');
  v_mutation_request_hash:=encode(extensions.digest(convert_to(jsonb_build_object(
    'contract_version','CANDIDATE_FINALISATION_MUTATION_REQUEST_V3',
    'workflow_id',v_workflow.id,
    'action','RETRY_FINALISATION',
    'expected_generation',p_expected_generation,
    'service_finalisation',v_service_finalisation-'replay_probe_only',
    'channel',v_mutation_channel,
    'actor_identity',v_mutation_actor_identity
  )::text,'UTF8'),'sha256'),'hex');
  if v_replay_probe_only then
    if p_session_id is null and (
      coalesce(v_service_finalisation->>'contract_version','')
        <>'CANDIDATE_MANAGER_FINALISATION_V1'
       or coalesce((v_service_finalisation->>'workflow_generation')::integer,0)
         <>p_expected_generation
    ) then
      raise exception 'CANDIDATE_SERVICE_FINALISATION_INVALID'
        using errcode='28000',detail=jsonb_build_object('stage','REPLAY_ENVELOPE')::text;
    end if;
    select ae.before_json,ae.after_json
    into v_prior_receipt_before,v_prior_receipt_after
    from public.audit_events ae
    where ae.object_type='candidate_workflow_mutation_receipt'
      and ae.object_id_text=v_workflow.id::text
      and ae.correlation_id=btrim(p_idempotency_key)
    order by ae.ts_utc desc,ae.id desc
    limit 1;
    if found then
      if v_prior_receipt_before->>'request_sha256' is distinct from v_mutation_request_hash
         or upper(coalesce(v_prior_receipt_before->>'workflow_action',''))<>'RETRY_FINALISATION'
         or upper(coalesce(v_prior_receipt_before->>'channel',''))<>v_mutation_channel
         or coalesce(v_prior_receipt_before->>'actor_identity','')
              is distinct from coalesce(v_mutation_actor_identity,'')
         or nullif(v_prior_receipt_after->>'generation','')::integer
              is distinct from (p_expected_generation+case
                when v_workflow.workflow_kind='DAILY'
                  and v_prior_receipt_after->>'state'='RECEIVED'
                  and v_prior_receipt_after->>'office_resolution_pending'='true' then 0 else 1 end) then
        raise exception 'CANDIDATE_IDEMPOTENCY_CONFLICT'
          using errcode='40001',detail=jsonb_build_object(
            'code','CANDIDATE_IDEMPOTENCY_CONFLICT','workflow_id',v_workflow.id,
            'idempotency_key',btrim(p_idempotency_key)
          )::text;
      end if;
      return coalesce(v_prior_receipt_after,'{}'::jsonb)
        ||jsonb_build_object('idempotent_replay',true);
    end if;
    select ae.before_json,ae.after_json
    into v_completion_before,v_completion_after
    from public.audit_events ae
    where ae.object_type='candidate_workflow_finalisation_completion'
      and ae.object_id_text=v_workflow.id::text
      and ae.correlation_id=p_expected_generation::text||':'||v_finalisation_identity_hash
    order by ae.ts_utc desc,ae.id desc
    limit 1;
    if found then
      if v_completion_before->>'finalisation_identity_sha256'
           is distinct from v_finalisation_identity_hash
         or nullif(v_completion_after->>'generation','')::integer
           is distinct from (p_expected_generation+case
             when v_workflow.workflow_kind='DAILY'
               and v_completion_after->>'state'='RECEIVED'
               and v_completion_after->>'office_resolution_pending'='true' then 0 else 1 end) then
        raise exception 'CANDIDATE_IDEMPOTENCY_CONFLICT' using errcode='40001';
      end if;
      return coalesce(v_completion_after,'{}'::jsonb)
        ||jsonb_build_object('idempotent_replay',true);
    end if;
    return jsonb_build_object('ok',true,'replay_found',false,'workflow_id',v_workflow.id,
      'expected_generation',p_expected_generation);
  end if;
  v_mutation_receipt:=private._candidate_workflow_mutation_receipt_v1(
    v_workflow.id,p_idempotency_key,v_mutation_request_hash,'RETRY_FINALISATION',
    v_mutation_channel,v_mutation_actor_identity,
    null,p_now_utc
  );
  if coalesce((v_mutation_receipt->>'found')::boolean,false) then
    return coalesce(v_mutation_receipt->'response','{}'::jsonb)||jsonb_build_object('idempotent_replay',true);
  end if;
  select ae.before_json,ae.after_json
  into v_completion_before,v_completion_after
  from public.audit_events ae
  where ae.object_type='candidate_workflow_finalisation_completion'
    and ae.object_id_text=v_workflow.id::text
    and ae.correlation_id=p_expected_generation::text||':'||v_finalisation_identity_hash
  order by ae.ts_utc desc,ae.id desc
  limit 1;
  if found then
    return coalesce(v_completion_after,'{}'::jsonb)
      ||jsonb_build_object('idempotent_replay',true);
  end if;
  if p_session_id is null then
    if coalesce(v_service_finalisation->>'contract_version','')<>'CANDIDATE_MANAGER_FINALISATION_V1'
       or coalesce((v_service_finalisation->>'workflow_generation')::integer,0)<>v_workflow.generation
       or upper(coalesce(v_service_finalisation->>'approval_method',''))<>v_workflow.route then
      raise exception 'CANDIDATE_SERVICE_FINALISATION_INVALID'
        using errcode='28000',detail=jsonb_build_object('stage','SERVICE_ENVELOPE')::text;
    end if;
    if v_worker_only_approval then
      if nullif(v_service_finalisation->>'approval_request_id','') is not null
         or nullif(v_finalisation_identity->>'approval_request_id','') is not null
         or v_finalisation_identity->'approval_request_generation' is distinct from 'null'::jsonb
         or v_finalisation_identity->>'approval_method' is distinct from 'ELECTRONIC'
         or v_finalisation_identity->>'review_manifest_sha256_hex' is distinct from encode(v_workflow.review_manifest_sha256,'hex')
         or v_finalisation_identity->>'candidate_signature_sha256_hex' is distinct from encode(v_workflow.candidate_signature_sha256,'hex')
         or v_finalisation_identity->>'policy_snapshot_sha256_hex' is distinct from encode(v_workflow.policy_snapshot_sha256,'hex') then
        raise exception 'CANDIDATE_SERVICE_FINALISATION_INVALID' using errcode='28000',
          detail=jsonb_build_object('stage','WORKER_ONLY_IDENTITY')::text;
      end if;
    elsif v_workflow.route='PAPER' then
      if nullif(v_service_finalisation->>'approval_request_id','') is not null
         or nullif(v_finalisation_identity->>'approval_request_id','') is not null
         or upper(v_finalisation_identity->>'approval_method')<>'PAPER'
         or lower(coalesce(v_finalisation_identity->>'paper_return_manifest_sha256_hex',''))
              <>encode(v_workflow.paper_return_manifest_sha256,'hex') then
        raise exception 'CANDIDATE_SERVICE_FINALISATION_INVALID'
          using errcode='28000',detail=jsonb_build_object('stage','PAPER_IDENTITY')::text;
      end if;
    else
      select * into v_approved_request
      from public.candidate_approval_requests a
      where a.id=nullif(v_service_finalisation->>'approval_request_id','')::uuid
        and a.workflow_id=v_workflow.id
        and a.workflow_generation=p_expected_generation
        and a.request_generation=coalesce(
          nullif(v_service_finalisation->>'approval_request_generation','')::integer,0
        )
        and a.method=upper(coalesce(v_service_finalisation->>'approval_method',''))
        and a.state='APPROVED'
        and encode(a.review_manifest_sha256,'hex')=lower(coalesce(v_service_finalisation->>'review_manifest_sha256_hex',''))
        and v_finalisation_identity->>'approval_request_id'=a.id::text
        and coalesce((v_finalisation_identity->>'approval_request_generation')::integer,0)=a.request_generation
        and upper(v_finalisation_identity->>'approval_method')=a.method
        and lower(coalesce(v_finalisation_identity->>'review_manifest_sha256_hex',''))
              =encode(a.review_manifest_sha256,'hex')
      for update;
      if not found then
        raise exception 'CANDIDATE_SERVICE_FINALISATION_INVALID'
          using errcode='28000',detail=jsonb_build_object('stage','APPROVAL_IDENTITY')::text;
      end if;
    end if;
  end if;
  if v_workflow.generation<>p_expected_generation then
    raise exception 'WORKFLOW_VERSION_MISMATCH'
      using errcode='40001',detail=jsonb_build_object('code','WORKFLOW_VERSION_MISMATCH','current_generation',v_workflow.generation)::text;
  end if;
  if v_workflow.workflow_kind='DAILY' then
    if v_workflow.scope<>'DAILY' or v_workflow.route not in ('PHONE','EMAIL')
       or v_workflow.contract_week_id is not null or v_workflow.week_ending_date is not null
       or v_workflow.target_timesheet_id is null
       or v_workflow.anchor_timesheet_id is distinct from v_workflow.target_timesheet_id then
      raise exception 'CANDIDATE_DAILY_IDENTITY_INVALID' using errcode='22023';
    end if;
    v_daily_receipt_context:=private._candidate_daily_receipt_context_v1(
      v_environment,v_candidate_id,v_workflow.target_timesheet_id,true,p_now_utc);
    v_daily_receipt_only:=coalesce((v_daily_receipt_context->>'candidate_first_receipt')::boolean,false)
      and coalesce((v_daily_receipt_context->>'office_resolution_pending')::boolean,false);
    select * into v_daily_timesheet
    from public.timesheets
    where timesheet_id=v_workflow.target_timesheet_id
      and is_current=true and archived_at_utc is null
      and sheet_scope='DAILY'::public.timesheet_scope_enum
      and nullif(btrim(coalesce(booking_id,'')),'') is not null
    for update;
    if not found then raise exception 'CANDIDATE_DAILY_SHIFT_NOT_FOUND' using errcode='P0002'; end if;
    if not private._candidate_daily_entitled_v1(v_candidate_id) then
      raise exception 'CANDIDATE_DAILY_ENTITLEMENT_REQUIRED' using errcode='55000';
    end if;
    select * into v_daily_fin
    from public.timesheets_financials
    where timesheet_id=v_daily_timesheet.timesheet_id
      and is_current=true and candidate_id=v_candidate_id
    order by computed_at_utc desc nulls last,updated_at desc,id desc
    limit 1
    for update;
    if (not found and not v_daily_receipt_only)
       or v_workflow.work_date is distinct from private._candidate_daily_work_date_v1(
         coalesce(v_daily_fin.worked_start_iso,v_daily_timesheet.worked_start_iso),
         v_daily_timesheet.scheduled_start_iso,
         v_daily_timesheet.week_ending_date
       ) then
      raise exception 'CANDIDATE_DAILY_SHIFT_IDENTITY_MISMATCH' using errcode='40001';
    end if;
    if v_daily_fin.authorised_at_utc is not null
       or v_daily_fin.paid_at_utc is not null
       or v_daily_fin.locked_by_invoice_id is not null
       or v_daily_timesheet.archived_at_utc is not null then
      raise exception 'CANDIDATE_RECORD_MUTATION_LOCKED' using errcode='55000';
    end if;
    if v_daily_timesheet.contract_id is not null then
      select * into v_contract
      from public.contracts
      where id=v_daily_timesheet.contract_id and candidate_id=v_candidate_id
      for update;
      if not found then raise exception 'CANDIDATE_WORKFLOW_OWNERSHIP_MISMATCH' using errcode='28000'; end if;
    end if;
    if v_daily_receipt_only then
      v_current_policy:=v_daily_receipt_context->'policy';
    else
      if coalesce(v_daily_fin.client_id,v_contract.client_id) is null then
        raise exception 'CANDIDATE_DAILY_CLIENT_NOT_FOUND' using errcode='P0002';
      end if;
      v_current_policy:=private._candidate_policy_resolve_v1(
        coalesce(v_daily_fin.client_id,v_contract.client_id),v_contract.id,v_workflow.work_date
      );
    end if;
    if (v_workflow.route='PHONE' and not coalesce((v_current_policy->>'allow_daily_manager_authorise_on_phone')::boolean,false))
       or (v_workflow.route='EMAIL' and not coalesce((v_current_policy->>'allow_daily_manager_authorise_by_email')::boolean,false)) then
      raise exception 'CANDIDATE_DAILY_APPROVAL_ROUTE_NOT_ALLOWED' using errcode='55000';
    end if;
  else
    if v_workflow.workflow_kind not in ('CONTRACT_HOURS','CONTRACT_EXPENSE','CONTRACT_COMBINED')
       or v_workflow.scope<>'WEEKLY' or v_workflow.contract_id is null
       or v_workflow.contract_week_id is null or v_workflow.week_ending_date is null then
      raise exception 'CANDIDATE_CONTRACT_WORKFLOW_IDENTITY_INVALID' using errcode='22023';
    end if;
    select * into v_contract
    from public.contracts
    where id=v_workflow.contract_id and candidate_id=v_candidate_id
    for update;
    if not found then raise exception 'CANDIDATE_WORKFLOW_OWNERSHIP_MISMATCH' using errcode='28000'; end if;
    select * into v_week
    from public.contract_weeks
    where id=v_workflow.contract_week_id
      and contract_id=v_contract.id
      and week_ending_date=v_workflow.week_ending_date
    for update;
    if not found then raise exception 'CANDIDATE_CONTRACT_WEEK_IDENTITY_MISMATCH' using errcode='40001'; end if;
    if v_workflow.anchor_timesheet_id is not null then
      select cw.* into v_anchor_week
      from public.contract_weeks cw
      join public.timesheets t on t.timesheet_id=cw.timesheet_id
        and t.is_current=true and t.archived_at_utc is null
      where cw.timesheet_id=v_workflow.anchor_timesheet_id
        and cw.contract_id=v_contract.id
        and cw.week_ending_date=v_workflow.week_ending_date;
      if not found then raise exception 'CANDIDATE_WORKFLOW_ANCHOR_MISMATCH' using errcode='40001'; end if;
    end if;
    if v_workflow.workflow_kind='CONTRACT_EXPENSE' then
      if v_workflow.anchor_timesheet_id is null
         or coalesce((private._candidate_record_capabilities_v1(
           v_workflow.anchor_timesheet_id,v_anchor_week.id,'{}'::jsonb
         )->>'hours_value')::numeric,0)<=0
            and coalesce((private._candidate_record_capabilities_v1(
              v_workflow.anchor_timesheet_id,v_anchor_week.id,'{}'::jsonb
            )->>'additional_units_value')::numeric,0)<=0 then
        -- Reuse the existing expense-admission authority for source weeks:
        -- immutable Candidate worked-hours evidence may precede source TSFIN.
        -- This neither writes nor unlocks the source-owned hours record.
        if v_workflow.anchor_timesheet_id is null
           or not coalesce((private._candidate_record_capabilities_v1(
             v_workflow.anchor_timesheet_id,v_anchor_week.id,'{}'::jsonb
           )->>'import_authoritative')::boolean,false) then
          raise exception 'NO_POSITIVE_WORKED_TIME' using errcode='55000';
        end if;
        v_placement:=public.expense_placement_resolve_v1(
          v_candidate_id,v_environment,v_workflow.anchor_timesheet_id,
          v_anchor_week.id,'{}'::jsonb,p_now_utc);
        if not coalesce((v_placement->>'ok')::boolean,false)
           or coalesce(v_placement->>'placement','') not in ('REUSE_CARRIER','CREATE_CARRIER') then
          raise exception 'CANDIDATE_EXPENSE_FINALISATION_ADMISSION_BLOCKED'
            using errcode='55000',detail=coalesce(v_placement->>'reason_code','NO_POSITIVE_WORKED_TIME');
        end if;
      end if;
    end if;
    if v_workflow.workflow_kind='CONTRACT_EXPENSE' and v_workflow.target_timesheet_id is not null then
      raise exception 'CANDIDATE_EXPENSE_TARGET_SERVER_RESOLVED' using errcode='40001';
    elsif v_workflow.workflow_kind in ('CONTRACT_HOURS','CONTRACT_COMBINED')
       and v_workflow.target_timesheet_id is distinct from v_week.timesheet_id then
      raise exception 'CANDIDATE_WORKFLOW_TARGET_MISMATCH' using errcode='40001';
    end if;
    if v_workflow.workflow_kind in ('CONTRACT_HOURS','CONTRACT_COMBINED')
       and v_week.timesheet_id is not null then
      v_target_capabilities:=private._candidate_record_capabilities_v1(
        v_week.timesheet_id,v_week.id,'{}'::jsonb
      );
      if coalesce((v_target_capabilities->>'candidate_mutation_locked')::boolean,false)
         or coalesce((v_target_capabilities->>'protected')::boolean,false)
         or not coalesce((v_target_capabilities->>'can_edit_hours')::boolean,false) then
        raise exception 'CANDIDATE_RECORD_MUTATION_LOCKED' using errcode='55000';
      end if;
    end if;
    v_route_authority:=private._expense_approval_route_v1(
      case when v_workflow.workflow_kind='CONTRACT_EXPENSE' then v_workflow.anchor_timesheet_id
        else v_week.timesheet_id end,
      case when v_workflow.workflow_kind='CONTRACT_EXPENSE' then v_anchor_week.id else v_week.id end,v_workflow.workflow_kind
    );
    if v_route_authority->>'route_family'='MANUAL_NON_QR'
       or (v_route_authority->>'route_family'='IMPORT_AUTHORITATIVE'
         and v_workflow.workflow_kind<>'CONTRACT_EXPENSE')
       or (v_workflow.route='PAPER' and not coalesce((v_route_authority->>'candidate_paper_submission_allowed')::boolean,false))
       or (v_workflow.route<>'PAPER' and v_route_authority->>'route_family'='QR') then
      raise exception 'CANDIDATE_ROUTE_FAMILY_MISMATCH' using errcode='55000',detail=v_route_authority::text;
    end if;
    v_current_policy:=private._expense_approval_policy_v1(
      v_contract.client_id,v_contract.id,v_workflow.week_ending_date,v_workflow.workflow_kind
    );
    -- Already-approved electronic claims retain their original policy comparison.
    -- Switching to PAPER always requires the current expense permission.
    if v_workflow.route<>'PAPER'
       and v_workflow.policy_snapshot_json->>'paper_submission_enabled_source'='IMPORT_DISABLED' then
      v_current_policy:=private._candidate_policy_resolve_v1(
        v_contract.client_id,v_contract.id,v_workflow.week_ending_date);
    end if;
    if v_workflow.route='PAPER'
       and not coalesce((v_current_policy->>'paper_submission_enabled')::boolean,false) then
      raise exception 'CANDIDATE_PAPER_ROUTE_NOT_ALLOWED' using errcode='55000';
    end if;
  end if;
  if v_workflow.route='PAPER' then
    if v_workflow.state<>'RECEIVED'
       or v_workflow.paper_return_manifest_sha256 is null
       or private._candidate_sha256_jsonb_v1(v_workflow.paper_return_manifest_json)
          is distinct from v_workflow.paper_return_manifest_sha256
       or exists(
         select 1
         from jsonb_array_elements(v_workflow.paper_return_manifest_json->'pages') expected_page
         where (
           select count(*)
           from public.candidate_submission_components returned_page
           where returned_page.workflow_id=v_workflow.id
             and returned_page.workflow_generation=v_workflow.generation
             and returned_page.component_kind='SIGNED_RETURN'
             and returned_page.paper_return_page_key=expected_page->>'page_key'
             and returned_page.state='IMMUTABLE'
             and returned_page.source_content_sha256 is not null
         )<>1
       )
       or exists(
         select 1
         from public.candidate_submission_components returned_page
         where returned_page.workflow_id=v_workflow.id
           and returned_page.workflow_generation=v_workflow.generation
           and returned_page.component_kind='SIGNED_RETURN'
           and returned_page.state='IMMUTABLE'
           and not exists(
             select 1
             from jsonb_array_elements(v_workflow.paper_return_manifest_json->'pages') expected_page
             where expected_page->>'page_key'=returned_page.paper_return_page_key
           )
       ) then
      raise exception 'CANDIDATE_PAPER_RETURN_INCOMPLETE' using errcode='55000';
    end if;
  else
    if v_workflow.state<>'READY_TO_FINALISE' then
      raise exception 'FINAL_SIGNED_DOCUMENT_NOT_READY' using errcode='55000';
    end if;
    if not v_worker_only_approval then
      select * into v_approved_request
      from public.candidate_approval_requests a
        where a.workflow_id=v_workflow.id and a.workflow_generation=v_workflow.generation
          and a.state='APPROVED' and a.review_manifest_sha256=v_workflow.review_manifest_sha256
      for update;
      if not found then raise exception 'FINAL_SIGNED_DOCUMENT_NOT_READY' using errcode='55000'; end if;
    end if;

    if not exists(
      select 1 from public.candidate_submission_components c
      where c.workflow_id=v_workflow.id and c.workflow_generation=v_workflow.generation
        and c.required=true and c.state<>'SUPERSEDED'
    ) or exists(
      select 1 from public.candidate_submission_components c
      where c.workflow_id=v_workflow.id and c.workflow_generation=v_workflow.generation
        and c.required=true and c.state<>'SUPERSEDED'
        and (c.state<>'IMMUTABLE' or c.review_render_state<>'READY'
          or c.final_signed_render_state<>'READY'
          or c.review_render_input_sha256 is distinct from c.final_signed_render_input_sha256)
    ) then
      raise exception 'FINAL_SIGNED_DOCUMENT_NOT_READY' using errcode='55000';
    end if;
    select * into v_hours_component from public.candidate_submission_components c
    where c.workflow_id=v_workflow.id and c.workflow_generation=v_workflow.generation
      and c.component_kind='HOURS_TIMESHEET' and c.required=true and c.state='IMMUTABLE'
    for update;
    if v_workflow.workflow_kind in ('CONTRACT_HOURS','CONTRACT_COMBINED','DAILY') and not found then
      raise exception 'FINAL_SIGNED_DOCUMENT_NOT_READY' using errcode='55000';
    elsif v_workflow.workflow_kind='CONTRACT_EXPENSE' and found then
      raise exception 'CONTRACT_EXPENSE_HOURS_COMPONENT_FORBIDDEN' using errcode='55000';
    end if;
    if v_hours_component.id is not null and v_hours_component.review_render_input_sha256
       is distinct from v_hours_component.final_signed_render_input_sha256 then
      raise exception 'FINAL_RENDER_INPUT_MISMATCH' using errcode='40001';
    end if;
    if v_workflow.workflow_kind<>'CONTRACT_EXPENSE' then
      select * into v_candidate_signature from public.candidate_submission_components c
      where c.id=v_workflow.candidate_signature_component_id and c.workflow_id=v_workflow.id
        and c.document_role='CANDIDATE_SIGNATURE' and c.state='IMMUTABLE' for update;
    elsif v_workflow.candidate_signature_component_id is not null
       or v_workflow.candidate_signature_sha256 is not null then
      raise exception 'CONTRACT_EXPENSE_CANDIDATE_SIGNATURE_FORBIDDEN' using errcode='55000';
    end if;
    if not v_worker_only_approval then
      select * into v_manager_signature from public.candidate_submission_components c
      where c.id=v_workflow.manager_signature_component_id and c.workflow_id=v_workflow.id
        and c.document_role='MANAGER_SIGNATURE' and c.state='IMMUTABLE'
        and c.approval_request_id=v_approved_request.id for update;
    end if;
    if (v_workflow.workflow_kind<>'CONTRACT_EXPENSE' and (
          v_candidate_signature.id is null
          or v_candidate_signature.source_content_sha256 is distinct from v_workflow.candidate_signature_sha256))
       or (not v_worker_only_approval and (v_manager_signature.id is null
         or v_manager_signature.source_content_sha256 is distinct from v_workflow.manager_signature_sha256
         or v_workflow.manager_approved_at_utc is null)) then
      raise exception 'ELECTRONIC_SIGNATURE_PAIR_INCOMPLETE' using errcode='55000';
    end if;
    if v_worker_only_approval and (
      v_hours_component.final_signed_renderer_receipt_json->>'form_variant' is distinct from 'ELECTRONIC_WORKER_SIGNED'
      or v_hours_component.final_signed_renderer_receipt_json->>'candidate_signature_sha256'
        is distinct from encode(v_candidate_signature.source_content_sha256,'hex')
      or v_hours_component.final_signed_renderer_receipt_json->'candidate_signature_embedded' is distinct from 'true'::jsonb
      or v_hours_component.final_signed_renderer_receipt_json->'manager_signature_embedded' is distinct from 'false'::jsonb
      or v_hours_component.final_signed_renderer_receipt_json->'manager_approval_date_embedded' is distinct from 'false'::jsonb
      or v_workflow.manager_signature_component_id is not null or v_workflow.manager_signature_sha256 is not null
      or v_workflow.manager_name is not null or v_workflow.manager_position is not null
      or v_workflow.manager_approved_at_utc is not null
      or exists(select 1 from public.candidate_approval_requests approval where approval.workflow_id=v_workflow.id
        and approval.workflow_generation=v_workflow.generation and approval.state in ('PENDING','APPROVED'))
    ) then raise exception 'CANDIDATE_WORKER_ONLY_DOCUMENT_INVALID' using errcode='55000';end if;
    v_render_input:=private._candidate_render_input_v1(v_workflow.id,v_workflow.generation);
    if v_hours_component.id is not null and decode(v_render_input->>'render_input_sha256','hex')
       is distinct from decode(
         private._candidate_component_render_input_v1(
           v_workflow.id,v_workflow.generation,v_hours_component.id
         )->>'workflow_render_input_sha256','hex'
       ) then
      raise exception 'FINAL_RENDER_INPUT_MISMATCH' using errcode='40001';
    end if;
    v_electronic_patch:=jsonb_build_object(
      'submission_mode','ELECTRONIC',
      'auth_name',v_workflow.manager_name,
      'auth_job_title',v_workflow.manager_position,
      'r2_nurse_key',v_candidate_signature.storage_key,
      'r2_auth_key',v_manager_signature.storage_key,
      'img_sha256_nurse',case when v_candidate_signature.source_content_sha256 is null then null
        else encode(v_candidate_signature.source_content_sha256,'hex') end,
      'img_sha256_auth',encode(v_manager_signature.source_content_sha256,'hex'),
      'candidate_workflow_id',v_workflow.id,
      'candidate_workflow_generation',v_workflow.generation,
      'candidate_manager_approved_at_utc',v_workflow.manager_approved_at_utc
    );
  end if;
  if v_workflow.route='PAPER' then
    v_electronic_patch:=jsonb_build_object(
      'submission_mode','MANUAL',
      'r2_nurse_key',null,
      'r2_auth_key',null,
      'candidate_workflow_id',v_workflow.id,
      'candidate_workflow_generation',v_workflow.generation,
      'candidate_manager_approved_at_utc',null
    );
  end if;

  if coalesce(v_current_policy->>'policy_fingerprint','')
     is distinct from coalesce(v_workflow.policy_snapshot_json->>'policy_fingerprint','') then
    update public.candidate_approval_requests set state='SUPERSEDED',superseded_at_utc=p_now_utc,updated_at_utc=p_now_utc
    where workflow_id=v_workflow.id and state='PENDING';
    v_response:=jsonb_build_object('ok',false,'error_code','CANDIDATE_POLICY_CHANGED','workflow_id',v_workflow.id,
      'state','SUPERSEDED','generation',v_workflow.generation+1,'current_policy',v_current_policy);
    update public.candidate_submission_workflows set state='SUPERSEDED',generation=generation+1,
      policy_snapshot_json=v_current_policy,policy_snapshot_sha256=private._candidate_sha256_jsonb_v1(v_current_policy),
      last_mutation_idempotency_key=p_idempotency_key,
      last_mutation_response_json=v_response,updated_at_utc=p_now_utc where id=v_workflow.id;
    perform private._candidate_workflow_mutation_receipt_v1(
      v_workflow.id,p_idempotency_key,v_mutation_request_hash,'RETRY_FINALISATION',
      case when v_is_office_service then 'OFFICE' when p_session_id is null then 'SERVICE' else 'CANDIDATE_CLIENT' end,
      case when v_is_office_service then v_service_finalisation->>'actor_user_id' else coalesce(p_session_id::text,'SERVICE') end,
      v_response,p_now_utc
    );
    return v_response;
  end if;

  select candidate_app_system_actor_user_id into v_system_actor from public.settings_defaults where id=1;
  if v_system_actor is null then raise exception 'CANDIDATE_SYSTEM_ACTOR_NOT_CONFIGURED' using errcode='55000'; end if;
  v_input:=v_workflow.immutable_submission_json;
  if v_input is null or private._candidate_sha256_jsonb_v1(v_input)
     is distinct from v_workflow.immutable_submission_sha256 then
    raise exception 'CANDIDATE_IMMUTABLE_SUBMISSION_MISMATCH' using errcode='40001';
  end if;
  if v_worker_only_approval then
    if v_current_policy#>'{manager_approval_policy,approval}' is distinct from '"NOT_REQUIRED"'::jsonb then
      raise exception 'CANDIDATE_POLICY_CHANGED' using errcode='40001';end if;
  end if;
  v_workflow.issue_codes:=private._candidate_finalisation_issue_codes_v1(
    v_workflow.issue_codes,
    private._candidate_submission_issue_codes_v1(
      v_workflow.id,v_input,v_current_policy
    )
  );
  v_effective_separation:=coalesce((v_current_policy->>'expenses_require_separate_timesheet')::boolean,false);
  if v_workflow.workflow_kind in ('CONTRACT_EXPENSE','CONTRACT_COMBINED')
     and coalesce((v_current_policy->>'import_expense_separation_mandatory')::boolean,false)
     and not coalesce((v_current_policy->>'expense_invoice_email_ready')::boolean,false) then
    raise exception 'EXPENSE_INVOICE_EMAIL_REQUIRED' using errcode='55000';
  end if;

  if v_workflow.scope='WEEKLY' then
    select * into v_week from public.contract_weeks where id=v_workflow.contract_week_id for update;
    if not found then raise exception 'CANDIDATE_CONTRACT_WEEK_NOT_FOUND' using errcode='P0002'; end if;
    if v_workflow.workflow_kind='CONTRACT_COMBINED' then
      v_hours_input:=coalesce(v_input->'hours_submission',v_input);
      v_expense_input:=coalesce(v_input->'expense_submission',v_input);
      if jsonb_typeof(v_hours_input)<>'object' or jsonb_typeof(v_expense_input)<>'object' then
        raise exception 'CANDIDATE_COMBINED_SNAPSHOTS_REQUIRED' using errcode='22023';
      end if;
    elsif v_workflow.workflow_kind='CONTRACT_EXPENSE' then
      v_expense_input:=v_input;
    else
      v_hours_input:=v_input;
    end if;

    if v_hours_input is not null then
      if v_hours_input->'canonical_tsfin_snapshot' is null then
        raise exception 'CANDIDATE_CANONICAL_TSFIN_SNAPSHOT_REQUIRED' using errcode='22023';
      end if;
      perform set_config('cloudtms.candidate_electronic_finalise',v_workflow.id::text||':'||v_workflow.generation::text,true);
      if v_worker_only_approval then
        v_worker_only_final_state:=private._candidate_weekly_final_state_guard_v1(
          v_workflow.contract_week_id,v_workflow.target_timesheet_id,
          v_hours_input->'timesheet_create_json',coalesce(v_hours_input->'timesheet_patch_json','{}'::jsonb),
          v_hours_input->'canonical_tsfin_snapshot');
        if v_worker_only_final_state->>'expected_line_type' is distinct from 'HOURS'
           or v_worker_only_final_state->>'record_role'='IMPORT_HOURS'
           or coalesce((v_worker_only_final_state->>'expense_value')::numeric,-1)<>0 then
          raise exception 'CANDIDATE_FIXED_APPROVAL_HOURS_SCOPE_INVALID' using errcode='55000';end if;
      end if;
      v_hours_result:=public.contract_week_manual_upsert_atomic(
        p_week_id=>v_week.id,
        p_expected_timesheet_id=>v_workflow.target_timesheet_id,
        p_timesheet_create_json=>case when v_workflow.target_timesheet_id is null
          then coalesce(v_hours_input->'timesheet_create_json','{}'::jsonb)||v_electronic_patch else null end,
        p_timesheet_patch_json=>coalesce(v_hours_input->'timesheet_patch_json','{}'::jsonb)||v_electronic_patch,
        p_contract_week_patch_json=>coalesce(v_hours_input->'contract_week_patch_json','{}'::jsonb),
        p_tsfin_snapshot_json=>v_hours_input->'canonical_tsfin_snapshot',
        p_rotation_json=>null,p_actor_user_id=>v_system_actor,p_materialise_staged_evidence=>false,
        p_now_utc=>p_now_utc,p_expected_row_signature=>coalesce(p_expected_row_signature,v_workflow.expected_row_signature),
        p_queue_timesheet_materialisation_json=>jsonb_build_object('suppress_timesheet_evidence_materialisation',true)
      );
      if coalesce((v_hours_result->>'ok')::boolean,false)=false then
        raise exception 'CANDIDATE_FINALISE_CANONICAL_APPLY_FAILED' using errcode='55000',detail=v_hours_result::text;
      end if;
      v_hours_timesheet_id:=coalesce(nullif(v_hours_result->>'timesheet_id','')::uuid,
        nullif(v_hours_result#>>'{timesheet,timesheet_id}','')::uuid);
      v_after_signature:=coalesce(v_hours_result->>'row_signature',v_hours_result->>'backend_row_signature',
        v_hours_result#>>'{timesheet,row_signature}');
    end if;

    if v_expense_input is not null then
      if v_workflow.workflow_kind='CONTRACT_EXPENSE' or v_effective_separation then
        v_placement:=public.expense_carrier_resolve_or_create_atomic_v1(
          v_candidate_id,v_environment,coalesce(v_hours_timesheet_id,v_workflow.anchor_timesheet_id),
          coalesce(v_after_signature,p_expected_row_signature,v_workflow.expected_row_signature),
          p_idempotency_key||':carrier',p_now_utc);
      else
        v_placement:=jsonb_build_object(
          'placement','SAME_RECORD','target_timesheet_id',coalesce(v_hours_timesheet_id,v_workflow.target_timesheet_id),
          'target_contract_week_id',v_week.id);
      end if;
      if v_workflow.route='PAPER' then
        select array_agg(c.id order by c.component_no,c.id) into v_evidence_component_ids
        from public.candidate_submission_components c
        where c.workflow_id=v_workflow.id and c.workflow_generation=v_workflow.generation
          and c.component_kind='SIGNED_RETURN' and c.state='IMMUTABLE'
          and c.paper_return_page_key<>'HOURS_TIMESHEET';
      else
        select array_agg(c.id order by c.review_ordinal,c.id) into v_evidence_component_ids
        from public.candidate_submission_components c
        where c.workflow_id=v_workflow.id and c.workflow_generation=v_workflow.generation
          and c.required=true and c.state<>'SUPERSEDED' and c.component_kind<>'HOURS_TIMESHEET';
      end if;
      update public.candidate_submission_workflows set
        -- A first combined weekly submission has no anchor until its hours row
        -- is materialised above. Bind that worked row before expense apply so
        -- SAME_RECORD stays a combined HOURS Timesheet. A genuinely separate
        -- expense carrier still has a different target and remains EXPENSES.
        anchor_timesheet_id=case when v_workflow.workflow_kind='CONTRACT_COMBINED'
          then coalesce(anchor_timesheet_id,v_hours_timesheet_id)
          else anchor_timesheet_id end,
        contract_week_id=nullif(v_placement->>'target_contract_week_id','')::uuid,
        target_timesheet_id=nullif(v_placement->>'target_timesheet_id','')::uuid,
        updated_at_utc=p_now_utc
      where id=v_workflow.id;
      perform set_config('cloudtms.candidate_finalize_workflow',v_workflow.id::text||':'||v_workflow.generation::text,true);
      v_result:=public.timesheet_expense_apply_atomic_v1(
        v_candidate_id,v_environment,nullif(v_placement->>'target_timesheet_id','')::uuid,
        v_workflow.id,v_workflow.generation,
        case when v_placement->>'placement'='SAME_RECORD' then coalesce(v_after_signature,p_expected_row_signature,v_workflow.expected_row_signature)
          else null end,
        v_expense_input,v_evidence_component_ids,p_idempotency_key||':expense',p_now_utc);
      v_expense_timesheet_id:=nullif(v_result->>'target_timesheet_id','')::uuid;
      v_target_timesheet_id:=coalesce(v_expense_timesheet_id,v_hours_timesheet_id);
      if v_hours_result is not null then
        v_result:=jsonb_build_object('ok',true,'hours_result',v_hours_result,'expense_result',v_result,
          'hours_timesheet_id',v_hours_timesheet_id,'expense_timesheet_id',v_expense_timesheet_id);
      end if;
    else
      v_result:=v_hours_result;
      v_target_timesheet_id:=v_hours_timesheet_id;
    end if;
  else
    if not v_is_office_service then
      perform private._candidate_require_feature_v1(v_environment,'candidate_daily_finalisation');
    end if;
    v_target_timesheet_id:=v_workflow.target_timesheet_id;
    if v_target_timesheet_id is null then
      raise exception 'CANDIDATE_DAILY_TIMESHEET_REQUIRED' using errcode='22023';
    end if;
    v_daily_save_input:=private._candidate_daily_canonical_save_input_v1(
      v_workflow.id,v_workflow.generation
    );
    v_daily_patch:=v_daily_save_input->'timesheet_patch_json';
    if jsonb_typeof(p_daily_materialisation_json)<>'object' then
      raise exception 'CANDIDATE_DAILY_MATERIALISATION_REQUIRED' using errcode='22023';
    end if;
    if v_daily_receipt_only then
      if p_daily_materialisation_json->>'contract_version' is distinct from 'CANDIDATE_DAILY_FACTUAL_RECEIPT_V1'
         or p_daily_materialisation_json->>'workflow_id' is distinct from v_workflow.id::text
         or (p_daily_materialisation_json->>'workflow_generation')::integer is distinct from v_workflow.generation
         or p_daily_materialisation_json->>'timesheet_id' is distinct from v_target_timesheet_id::text then
        raise exception 'CANDIDATE_DAILY_RECEIPT_CONTEXT_CHANGED' using errcode='40001';
      end if;
      v_result:=private._candidate_daily_factual_receipt_v1(
        v_workflow.id,v_workflow.generation,
        p_daily_materialisation_json->>'canonical_save_input_sha256_hex',v_electronic_patch,p_now_utc);
      v_completion_state:='RECEIVED';
    else
    -- This private composition performs the pre-write row-signature check,
    -- factual save and bounded TSFIN write in this same finalisation transaction.
    -- Any later Process/Authorise error rolls the factual and financial write back.
    v_daily_save_receipt:=private._candidate_daily_save_recalculate_atomic_v1(
      v_workflow.id,v_workflow.generation,p_daily_materialisation_json,
      v_system_actor,p_now_utc
    );
    select * into v_daily_timesheet from public.timesheets
    where timesheet_id=v_target_timesheet_id and is_current=true for update;
    select * into v_daily_fin from public.timesheets_financials
    where id=nullif(v_daily_save_receipt->>'financials_id','')::uuid
      and timesheet_id=v_target_timesheet_id and is_current=true
    for update;
    if not found or v_daily_fin.processing_status<>'UNPROCESSED' then
      raise exception 'CANDIDATE_DAILY_CANONICAL_RECALCULATION_NOT_READY' using errcode='55000';
    end if;
    v_after_signature:=nullif(v_daily_save_receipt->>'post_save_row_signature','');
    if v_after_signature is null then
      raise exception 'CANDIDATE_DAILY_CANONICAL_SAVE_RECEIPT_INVALID' using errcode='55000';
    end if;
    perform set_config('cloudtms.candidate_electronic_finalise','on',true);
    v_result:=public.timesheet_daily_manual_process_atomic(
      v_target_timesheet_id,v_target_timesheet_id,v_system_actor,
      v_electronic_patch,'{}'::jsonb,p_now_utc,v_after_signature
    );
    v_result:=jsonb_build_object(
      'ok',coalesce((v_result->>'ok')::boolean,false),
      'canonical_save_receipt',v_daily_save_receipt,
      'process_result',v_result,'timesheet_id',v_target_timesheet_id,
      'row_signature',coalesce(v_result->>'row_signature',v_result->>'backend_row_signature')
    );
    end if;
    v_hours_timesheet_id:=v_target_timesheet_id;
    v_after_signature:=coalesce(v_result->>'row_signature',v_result->>'backend_row_signature');
  end if;
  if coalesce((v_result->>'ok')::boolean,false)=false then
    raise exception 'CANDIDATE_FINALISE_CANONICAL_APPLY_FAILED'
      using errcode='55000',detail=jsonb_build_object(
        'code',coalesce(v_result->>'error_code','CANDIDATE_FINALISE_CANONICAL_APPLY_FAILED'),
        'canonical_result',v_result)::text;
  end if;
  if v_target_timesheet_id is null then raise exception 'CANDIDATE_FINALISE_TARGET_MISSING' using errcode='55000'; end if;

  if v_workflow.route<>'PAPER' and v_hours_component.id is not null then
    update public.candidate_submission_components set timesheet_id=coalesce(v_hours_timesheet_id,v_target_timesheet_id)
    where id=v_hours_component.id;
    insert into public.timesheet_evidence(
      timesheet_id,kind,display_name,storage_key,created_at,created_by,
      document_role,candidate_component_id,processing_state
    ) values (
      coalesce(v_hours_timesheet_id,v_target_timesheet_id),'TIMESHEET','Official electronically signed timesheet',
      v_hours_component.final_signed_storage_key,p_now_utc,v_system_actor,
      'SIGNED_TIMESHEET',v_hours_component.id,'READY'
    ) on conflict (candidate_component_id) where candidate_component_id is not null do nothing;
  elsif v_workflow.route='PAPER' and v_workflow.workflow_kind<>'CONTRACT_EXPENSE' then
    select * into v_paper_hours_return
    from public.candidate_submission_components c
    where c.workflow_id=v_workflow.id and c.workflow_generation=v_workflow.generation
      and c.component_kind='SIGNED_RETURN' and c.paper_return_page_key='HOURS_TIMESHEET'
      and c.state='IMMUTABLE' and c.source_content_sha256 is not null
    for update;
    if not found then raise exception 'CANDIDATE_PAPER_RETURN_INCOMPLETE' using errcode='55000'; end if;
    update public.candidate_submission_components set
      timesheet_id=coalesce(v_hours_timesheet_id,v_target_timesheet_id)
    where id=v_paper_hours_return.id;
    insert into public.timesheet_evidence(
      timesheet_id,kind,display_name,storage_key,created_at,created_by,
      document_role,candidate_component_id,processing_state
    ) values (
      coalesce(v_hours_timesheet_id,v_target_timesheet_id),'TIMESHEET','Returned signed paper timesheet',
      v_paper_hours_return.storage_key,p_now_utc,v_system_actor,
      'SIGNED_TIMESHEET',v_paper_hours_return.id,'READY'
    ) on conflict (candidate_component_id) where candidate_component_id is not null do nothing;
  end if;

  v_auto_requested:=coalesce((v_current_policy->>'candidate_electronic_auto_authorise')::boolean,false)
    and v_workflow.route<>'PAPER' and not v_worker_only_approval;
  if v_workflow.issue_codes ?| array[
    'UNEXPECTED_HOURS','DAILY_BREAK_UNEXPECTED','DUPLICATE_EXPENSE_REVIEW',
    'HEALTHROSTER_VALIDATION_REQUIRED','EVIDENCE_REVIEW_REQUIRED',
    'ADDITIONAL_UNITS_NEEDS_CHECKING','PLANNED_HOURS_UNRESOLVED'
  ] then
    v_auto_blocked:=true;
    v_auto_blockers:=v_auto_blockers||v_workflow.issue_codes;
  end if;
  if v_workflow.route='PAPER' then
    v_auto_blocked:=true;v_auto_blockers:=v_auto_blockers||'"PAPER_NEVER_AUTO_AUTHORISES"'::jsonb;
  end if;
  if v_daily_receipt_only then
    v_auto_blocked:=true;
    v_auto_blockers:=v_auto_blockers||'"OFFICE_RESOLUTION_REQUIRED"'::jsonb;
  end if;
  if v_auto_requested and not v_auto_blocked then
    if v_hours_timesheet_id is not null then
      v_authorise_result:=public.timesheet_authorise_generic_atomic(
        v_hours_timesheet_id,v_hours_timesheet_id,v_system_actor,p_now_utc,v_after_signature
      );
      if coalesce((v_authorise_result->>'ok')::boolean,false)=false then
        raise exception 'CANDIDATE_AUTO_AUTHORISE_FAILED' using errcode='55000',detail=v_authorise_result::text;
      end if;
    end if;
    if v_expense_timesheet_id is not null and v_expense_timesheet_id is distinct from v_hours_timesheet_id then
      v_expense_authorise_result:=public.timesheet_authorise_generic_atomic(
        v_expense_timesheet_id,v_expense_timesheet_id,v_system_actor,p_now_utc,null);
      if coalesce((v_expense_authorise_result->>'ok')::boolean,false)=false then
        raise exception 'CANDIDATE_AUTO_AUTHORISE_FAILED' using errcode='55000',detail=v_expense_authorise_result::text;
      end if;
      v_authorise_result:=jsonb_build_object(
        'ok',true,'hours',v_authorise_result,'expenses',v_expense_authorise_result);
    end if;
    if coalesce((v_authorise_result->>'ok')::boolean,false)=false then
      v_auto_blocked:=true;
      v_auto_blockers:=v_auto_blockers||jsonb_build_array(coalesce(v_authorise_result->>'error_code','AUTHORISE_NOT_ADVANCED'));
    end if;
  end if;

  select financials.id into v_canonical_financials_id
  from public.timesheets_financials financials
  where financials.timesheet_id=coalesce(v_hours_timesheet_id,v_target_timesheet_id)
    and financials.is_current=true
  order by financials.computed_at_utc desc nulls last,financials.updated_at desc,financials.id desc
  limit 1;
  if not v_daily_receipt_only then
    if v_canonical_financials_id is null then
      raise exception 'CANDIDATE_CANONICAL_FINANCIALS_NOT_FOUND' using errcode='55000';
    end if;
    v_canonical_financial_sha256:=private._candidate_financial_content_sha256_v1(
      v_canonical_financials_id
    );
  end if;
  -- A received factual claim retains its artifact generation. It is not
  -- financial finalisation and never carries a fabricated financial hash.
  v_completion_generation:=v_workflow.generation+case when v_daily_receipt_only then 0 else 1 end;

  v_response:=jsonb_build_object(
    'ok',true,'idempotent_replay',false,'workflow_id',v_workflow.id,
    'state',v_completion_state,'generation',v_completion_generation,
    'office_resolution_pending',v_daily_receipt_only,
    'timesheet_id',v_target_timesheet_id,'canonical_result',v_result,
    'candidate_auto_authorise_effective',v_auto_requested,
    'auto_authorised',v_auto_requested and not v_auto_blocked,
    'canonical_financial_sha256_hex',encode(v_canonical_financial_sha256,'hex'),
    'auto_authorise_blockers',v_auto_blockers,
    'authorise_result',v_authorise_result
  );
  update public.candidate_submission_workflows set state=v_completion_state,generation=v_completion_generation,
    target_timesheet_id=v_target_timesheet_id,policy_snapshot_json=v_current_policy,
    canonical_financial_sha256=v_canonical_financial_sha256,
    issue_codes=v_workflow.issue_codes,
    finalised_at_utc=case when v_daily_receipt_only then null else p_now_utc end,
    last_mutation_idempotency_key=p_idempotency_key,last_mutation_response_json=v_response,updated_at_utc=p_now_utc
  where id=v_workflow.id;
  perform private._candidate_notification_insert_v1(v_workflow.account_id,v_candidate_id,v_workflow.id,v_target_timesheet_id,
    case when v_auto_requested and not v_auto_blocked then 'AUTHORISED' else 'SUBMISSION_RECEIVED' end,
    'authorisation','candidate-submission-finalised-v1',jsonb_build_object('auto_authorised',v_auto_requested and not v_auto_blocked),
    jsonb_build_object('type','timesheet','timesheet_id',v_target_timesheet_id),
    'CANDIDATE_FINALISED_V1:'||v_workflow.id::text||':'||v_completion_generation::text,p_now_utc);
  perform private._candidate_audit_v1('candidate_submission_workflow',v_workflow.id::text,
    case when v_daily_receipt_only then 'CANDIDATE_SUBMISSION_RECEIVED' else 'CANDIDATE_SUBMISSION_FINALISED' end,
    jsonb_build_object('state',v_workflow.state,'generation',v_workflow.generation),
    jsonb_build_object('state',v_completion_state,'generation',v_completion_generation,'timesheet_id',v_target_timesheet_id,
      'auto_authorised',v_auto_requested and not v_auto_blocked),null,v_system_actor,p_idempotency_key,p_now_utc);
  insert into public.audit_events(
    actor_user_id,object_type,object_id_text,action,before_json,after_json,
    reason,correlation_id,ts_utc
  ) values (
    case when v_is_office_service then nullif(v_service_finalisation->>'actor_user_id','')::uuid
      else null end,
    'candidate_workflow_finalisation_completion',v_workflow.id::text,
    'CANDIDATE_WORKFLOW_FINALISATION_COMPLETED',jsonb_build_object(
      'contract_version','CANDIDATE_FINALISATION_COMPLETION_V1',
      'workflow_generation',p_expected_generation,
      'finalisation_identity_sha256',v_finalisation_identity_hash,
      'finalisation_identity',v_finalisation_identity
    ),v_response,'Canonical finalisation completion receipt',
    p_expected_generation::text||':'||v_finalisation_identity_hash,p_now_utc
  );
  perform private._candidate_workflow_mutation_receipt_v1(
    v_workflow.id,p_idempotency_key,v_mutation_request_hash,'RETRY_FINALISATION',
    case when v_is_office_service then 'OFFICE' when p_session_id is null then 'SERVICE' else 'CANDIDATE_CLIENT' end,
    case when v_is_office_service then v_service_finalisation->>'actor_user_id' else coalesce(p_session_id::text,'SERVICE') end,
    v_response,p_now_utc
  );
  -- Retained native finalisation receipt now proves any artifact-generation
  -- bookkeeping advance. HOURS identity stays the real hours row, including
  -- a combined claim whose separate expense carrier is the final target.
  if v_hours_timesheet_id is not null then
    perform private.weekly_source_checklist_submission_cycle_prepare_v1(v_hours_timesheet_id,null);
  end if;
  return v_response;
exception
  when unique_violation then
    get stacked diagnostics v_constraint_name=constraint_name;
    if v_constraint_name='timesheet_evidence_one_active_timesheet_uq' then
      raise exception 'TIMESHEET_EVIDENCE_ALREADY_ATTACHED' using errcode='23505';
    end if;
    raise;
end;
$function$;

CREATE OR REPLACE FUNCTION public.tsfin_prepare_write(p_timesheet_id uuid)
RETURNS void
LANGUAGE plpgsql
AS $function$
DECLARE
  -- Plan 6.2 G6-11 (proof/34 section 3, entry point E7).
  v_weekly_source_guard jsonb;
  -- WP-09b finding F1: is there a protected position this call could displace?
  v_weekly_source_protected_rotation boolean := false;
  v_agency_write_purpose jsonb;
BEGIN
  -- Plan 6.2 G6-11 (proof/34 section 3, entry point E7): this owner is
  -- SECURITY INVOKER and is executable by service_role, so it calls WP-03's
  -- definer-rights decision shim, which is the only rotation-authority routine
  -- service_role may execute.  The refusal is taken before this owner's first
  -- write, which is the demotion below.
  -- WP-09b review finding F2: the earlier claim here, that an undecidable
  -- family is "left to behave exactly as today", was FALSE and is withdrawn.
  -- The shim returns the guard's fail-closed managed = true for every family it
  -- cannot resolve -- a missing or blank booking identity, a family split by a
  -- whitespace variant, no current row, an ambiguous canonical row, an unknown
  -- or null id -- so those ordinary families now refuse here where they
  -- previously proceeded.  That cost is measured, by shape, in the WP-09b
  -- report; it is the price of WP-03 handoff N11's unconditional predicate and
  -- is owner decision OQ-1, not an accident of this call site.
  -- The lock context is the caller's: reached through E25 or E26 this owner
  -- already holds the family and TSFIN locks.  Called standalone by
  -- service_role it holds none, which WP-09b records as an accepted residual
  -- (report section on F1) rather than taking a family lock inside a
  -- SECURITY INVOKER owner whose callers lock in the opposite order.
  v_weekly_source_guard := private.weekly_source_managed_root_guard_decision_v1(p_timesheet_id);
  -- WP-09b, WP-17b touchpoint reconciliation finding F1 (18 September 2026).
  -- The protected-pay clause was OVER-APPLIED here and refused Weekly Source's
  -- own protected-family preparer,
  -- public.weekly_source_target_managed_root_prepare_atomic_v1, which calls this
  -- owner to write the legitimate zero current TSFIN a protected family needs
  -- BEFORE first authorisation.  One defect failed four release verifiers.
  --
  -- That is not the case the approver ruled on.  HANDOVER 2 round-5 Part E names
  -- PROTECTED_ROOT_AUTHORITY_MISSING as the answer to an ordinary ROTATION
  -- attempt on a protected root, not to the preparer that creates the conditions
  -- for an authorisation record in the first place: a protected-pay root
  -- legitimately has no authorisation record at the moment the preparer runs.
  --
  -- The distinction is a STATE, not a caller.  Exempting this entry point would
  -- reopen the hole the guard exists to close, because it is a genuine rotation
  -- surface.  What it rotates is the CURRENT timesheets_financials row: it
  -- demotes that row and promotes a replacement.  A protected family therefore
  -- has a position to defend exactly when there is something to displace --
  -- a current financial row, or a root that is already authorised.
  --
  -- Measured on a real build from empty, the preparer's call has neither: no
  -- current financial row, authorised_at_server null, no live root
  -- authorisation, and the protected family at ownership_state=TARGET_MANAGED
  -- with current_generation_id null, generation 0, lifecycle PENDING_APPROVAL,
  -- c1_publication_state NONE and 0 components.  Nothing can be rotated; the
  -- first snapshot is being created.  A rotation attempt on a protected root
  -- that DOES hold a current financial row, or whose root is authorised, still
  -- refuses -- proved in both directions.
  v_weekly_source_protected_rotation :=
    (v_weekly_source_guard->>'protected_target_ownership_state') is not null
    and (exists (select 1 from public.timesheets_financials tf
                  where tf.timesheet_id = p_timesheet_id and tf.is_current)
         or exists (select 1 from public.timesheets t
                     where t.timesheet_id = p_timesheet_id
                       and t.authorised_at_server is not null));
  -- HANDOVER 2 round-5 ruling B3 and A4 (18 September 2026).  The refusal is
  -- NARROWED: it applies to a Weekly-Source managed root, to a bound or
  -- protected family whose identity cannot be resolved, to a family carrying
  -- protected pay evidence but no authorisation row
  -- (PROTECTED_ROOT_AUTHORITY_MISSING), and to the live-record-on-an-
  -- unauthorised-Timesheet contradiction, which must never be allowed to
  -- continue merely because managed is false.  An unrelated, UNBOUND ordinary
  -- family -- including a malformed one -- keeps exactly the behaviour it had
  -- before this feature was installed.  Absent, null and non-boolean take the
  -- unsafe value at every read (Part 1 addendum rule 4).
  IF (COALESCE((v_weekly_source_guard->>'managed')::boolean, true)
       and (COALESCE((v_weekly_source_guard->>'ok')::boolean, true)
            or COALESCE((v_weekly_source_guard->>'weekly_source_bound')::boolean, true)))
     or COALESCE((v_weekly_source_guard->>'authorisation_record_without_authorised_timesheet')::boolean, false)
     or (v_weekly_source_protected_rotation and not
         private.weekly_source_local_preauthorisation_write_allowed_v1(p_timesheet_id,null::jsonb)) THEN
    RAISE EXCEPTION 'WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED'
      USING ERRCODE = '55000',
            DETAIL = jsonb_build_object(
              'code','WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED',
              'entry_point','E7:public.tsfin_prepare_write',
              'block_reason','WEEKLY_SOURCE_MANAGED_ROOT',
              'refusal_basis', case
                -- HANDOVER 2 round-5 Part E: the trim-equivalent split family is a
                -- canonical booking-reference collision and must be named as one.
                -- WP-03 handoff N20: accept BOTH the installed token and the ruled name for one
                -- release, so the order of this edit and WP-03's rename cannot open a gap in
                -- which Office stops seeing the ruled name.
                when v_weekly_source_guard->>'reason' in (
                       'FAMILY_SPLIT_BY_WHITESPACE','BOOKING_REFERENCE_CANONICAL_COLLISION')
                  then 'BOOKING_REFERENCE_CANONICAL_COLLISION'
                when coalesce((v_weekly_source_guard->>'managed')::boolean, true) and coalesce((v_weekly_source_guard->>'ok')::boolean, true)
                  then 'WEEKLY_SOURCE_MANAGED_ROOT'
                when coalesce((v_weekly_source_guard->>'managed')::boolean, true)
                  then 'WEEKLY_SOURCE_BOUND_OR_PROTECTED_ROOT_UNRESOLVABLE'
                when coalesce((v_weekly_source_guard->>'authorisation_record_without_authorised_timesheet')::boolean, false)
                  then 'AUTHORISATION_RECORD_WITHOUT_AUTHORISED_TIMESHEET'
                else 'PROTECTED_ROOT_AUTHORITY_MISSING' end,
              'integrity_failure', not coalesce((v_weekly_source_guard->>'ok')::boolean,false),
              'timesheet_id', p_timesheet_id,
              'reason', v_weekly_source_guard->>'reason'
            )::text;
  END IF;

  -- Actual ACTIVE Agency scope is admitted only by a current-XID/current-PID native frame.
  -- All preceding managed/protected guards and the invoice-lock refusal stay intact.
  v_agency_write_purpose := private.weekly_source_agency_financial_write_assert_v1(
    p_timesheet_id,null::jsonb,null::uuid,null::uuid);

  -- Guard: refuse writes if the current snapshot is paid OR whole-timesheet locked by an invoice.
  -- IMPORTANT: Do NOT block just because some SEGMENTS are invoice-locked; partial recompute is allowed.
  IF EXISTS (
    SELECT 1
    FROM public.timesheets_financials tf
    WHERE tf.timesheet_id = p_timesheet_id
      AND tf.is_current = true
      AND (
        (tf.paid_at_utc IS NOT NULL AND v_agency_write_purpose IS NULL)
        OR tf.locked_by_invoice_id IS NOT NULL
      )
  ) THEN
    RAISE EXCEPTION 'TSFIN_LOCKED';
  END IF;

  -- Make any current snapshots non-current (we keep history)
  UPDATE public.timesheets_financials tfu
  SET is_current = false
  WHERE tfu.timesheet_id = p_timesheet_id
    AND tfu.is_current = true;
END;
$function$;

CREATE OR REPLACE FUNCTION public.tsfin_write_current_snapshot_single_bounded(p_timesheet_id uuid, p_timesheet_version integer DEFAULT NULL::integer, p_snapshot_json jsonb DEFAULT '{}'::jsonb, p_actor_user_id uuid DEFAULT NULL::uuid, p_now_utc timestamp with time zone DEFAULT now())
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  snap jsonb := COALESCE(p_snapshot_json, '{}'::jsonb);
  prev public.timesheets_financials%ROWTYPE;
  -- WP-09b finding F1: is there a protected position this call could displace?
  v_weekly_source_protected_rotation boolean := false;
  inserted_row public.timesheets_financials%ROWTYPE;
  v_current_ts public.timesheets%ROWTYPE;
  v_prev_id uuid := NULL;
  did_prepare boolean := false;

  v_ib jsonb := '{}'::jsonb;
  v_bad integer := 0;

  v_cat_pay numeric := 0;
  v_cat_charge numeric := 0;
  v_fallback_exp_pay numeric := 0;
  v_fallback_exp_charge numeric := 0;
  v_exp_pay numeric := 0;
  v_exp_charge numeric := 0;

  v_add_units_json jsonb := '{}'::jsonb;
  v_add_pay numeric := 0;
  v_add_charge numeric := 0;
  v_mil_pay numeric := 0;
  v_mil_charge numeric := 0;

  v_nonseg_pay numeric := 0;
  v_nonseg_charge numeric := 0;
  v_nonseg_margin numeric := 0;
  v_core_pay numeric := 0;
  v_core_charge numeric := 0;
  v_total_pay numeric := 0;
  v_total_charge numeric := 0;
  v_margin numeric := 0;

  v_add_obj jsonb := '{}'::jsonb;
  v_tot_obj jsonb := '{}'::jsonb;
  v_mode text := NULL;
  v_seg jsonb := NULL;
  v_exclude boolean := false;

  v_policy jsonb := '{}'::jsonb;
  v_apply_to text := 'PAYE_ONLY';
  v_erni_pct_raw numeric := 0;
  v_erni_mult numeric := 1;
  v_pay_method_u text := NULL;
  v_erni_applies boolean := false;
  v_wage_pay numeric := 0;
  v_wage_pay_cost numeric := 0;
  v_reimb_pay numeric := 0;
  v_pay_cost numeric := 0;
  v_nonseg_wage_pay numeric := 0;
  v_nonseg_wage_pay_cost numeric := 0;
  v_nonseg_reimb_pay numeric := 0;
  v_nonseg_pay_cost numeric := 0;

  v_processing_status public.ts_fin_processing_status_enum := 'UNASSIGNED'::public.ts_fin_processing_status_enum;
  v_candidate_assignment public.candidate_assignment_enum := 'UNASSIGNED'::public.candidate_assignment_enum;
  v_basis public.timesheet_fin_basis_enum := 'SELF_REPORTED'::public.timesheet_fin_basis_enum;
  v_timesheet_version integer := 1;
  v_is_stale boolean := false;
  v_stale_reason text := NULL;
  v_now timestamp with time zone := COALESCE(p_now_utc, now());
  v_pay_method_insert text := NULL;
  v_mileage_units numeric := 0;
  v_error_state text := NULL;
  v_error_message text := NULL;

  v_live_contract_week_id uuid := NULL::uuid;
  v_live_contract_week_status text := NULL::text;
  v_incoming_processing_status text := NULL::text;
  v_incoming_authorised_at_utc timestamptz := NULL::timestamptz;
  v_result_authorised_at_utc timestamptz := NULL::timestamptz;
  v_result_authorised_by_user_id uuid := NULL::uuid;
  v_live_authorised boolean := false;
  v_can_preserve_authorised_at boolean := false;
  v_lifecycle_decision text := 'WRITTEN';

  -- Plan 6.2 G6-11 (proof/34 section 3, entry point E25).
  v_weekly_source_guard jsonb;
  v_agency_write_purpose jsonb;
BEGIN
  perform public._ctms_assert_tsfin_snapshot_policy_v1(p_timesheet_id, coalesce(p_snapshot_json, '{}'::jsonb));
  PERFORM set_config('lock_timeout', '2500ms', true);

  IF p_timesheet_id IS NULL THEN
    RAISE EXCEPTION USING MESSAGE = 'INVALID_PAYLOAD', DETAIL = jsonb_build_object('field', 'p_timesheet_id')::text;
  END IF;

  IF p_snapshot_json IS NOT NULL AND jsonb_typeof(p_snapshot_json) <> 'object' THEN
    RAISE EXCEPTION USING MESSAGE = 'INVALID_PAYLOAD', DETAIL = jsonb_build_object('field', 'p_snapshot_json')::text;
  END IF;

  SELECT ts.*
    INTO v_current_ts
  FROM public.timesheets AS ts
  WHERE ts.timesheet_id = p_timesheet_id
  LIMIT 1
  FOR UPDATE;

  IF v_current_ts.timesheet_id IS NULL THEN
    RAISE EXCEPTION USING MESSAGE = 'TARGET_NOT_FOUND', DETAIL = jsonb_build_object('timesheet_id', p_timesheet_id)::text;
  END IF;

  IF NULLIF(BTRIM(COALESCE(snap ->> 'timesheet_id', '')), '') IS NOT NULL
     AND NULLIF(BTRIM(COALESCE(snap ->> 'timesheet_id', '')), '')::uuid IS DISTINCT FROM p_timesheet_id THEN
    RAISE EXCEPTION USING
      MESSAGE = 'TSFIN_SNAPSHOT_MISMATCH',
      DETAIL = jsonb_build_object(
        'field', 'timesheet_id',
        'expected_value', p_timesheet_id::text,
        'supplied_value', snap ->> 'timesheet_id'
      )::text;
  END IF;

  snap := snap || jsonb_build_object(
    'timesheet_id', p_timesheet_id::text,
    'timesheet_version', COALESCE(p_timesheet_version, NULLIF(snap ->> 'timesheet_version', '')::integer, v_current_ts.version, 1)
  );

  SELECT tf.*
    INTO prev
  FROM public.timesheets_financials AS tf
  WHERE tf.timesheet_id = p_timesheet_id
    AND tf.is_current = true
  ORDER BY tf.computed_at_utc DESC NULLS LAST, tf.created_at DESC NULLS LAST, tf.updated_at DESC NULLS LAST, tf.id DESC
  LIMIT 1
  FOR UPDATE;

  v_agency_write_purpose := private.weekly_source_agency_financial_write_assert_v1(
    p_timesheet_id,snap,p_actor_user_id,null::uuid);
  IF prev.id IS NOT NULL AND prev.paid_at_utc IS NOT NULL AND v_agency_write_purpose IS NULL THEN
    RAISE EXCEPTION USING MESSAGE = 'TIMESHEET_PAID', DETAIL = jsonb_build_object('timesheet_id', p_timesheet_id, 'timesheet_financials_id', prev.id)::text;
  END IF;

  IF prev.id IS NOT NULL AND prev.locked_by_invoice_id IS NOT NULL THEN
    RAISE EXCEPTION USING MESSAGE = 'TIMESHEET_LOCKED_BY_INVOICE', DETAIL = jsonb_build_object('timesheet_id', p_timesheet_id, 'invoice_id', prev.locked_by_invoice_id)::text;
  END IF;

  v_prev_id := prev.id;

  v_timesheet_version := COALESCE(NULLIF(snap ->> 'timesheet_version', '')::integer, v_current_ts.version, 1);
  v_basis := COALESCE(NULLIF(snap ->> 'basis', '')::public.timesheet_fin_basis_enum, 'SELF_REPORTED'::public.timesheet_fin_basis_enum);
  v_candidate_assignment := COALESCE(NULLIF(snap ->> 'candidate_assignment', '')::public.candidate_assignment_enum, 'UNASSIGNED'::public.candidate_assignment_enum);
  v_processing_status := COALESCE(NULLIF(snap ->> 'processing_status', '')::public.ts_fin_processing_status_enum, 'UNASSIGNED'::public.ts_fin_processing_status_enum);

  v_ib := COALESCE(snap -> 'invoice_breakdown_json', '{}'::jsonb);
  IF v_ib IS NULL OR jsonb_typeof(v_ib) <> 'object' THEN
    v_ib := '{}'::jsonb;
  END IF;

  v_bad := public._tsfin_invalid_segment_count(v_ib);
  IF v_bad > 0 THEN
    RAISE EXCEPTION USING MESSAGE = 'TSFIN_SNAPSHOT_MISMATCH', DETAIL = jsonb_build_object('field', 'invoice_breakdown_json', 'invalid_segment_count', v_bad)::text;
  END IF;

  SELECT cw.id,
         cw.status::text
    INTO v_live_contract_week_id,
         v_live_contract_week_status
  FROM public.contract_weeks AS cw
  WHERE cw.timesheet_id = p_timesheet_id
  ORDER BY cw.updated_at DESC NULLS LAST,
           cw.created_at DESC NULLS LAST,
           cw.id DESC
  LIMIT 1
  FOR UPDATE;

  v_incoming_processing_status := CASE
    WHEN v_processing_status IS NULL THEN NULL::text
    ELSE v_processing_status::text
  END;
  v_incoming_authorised_at_utc := NULLIF(snap ->> 'authorised_at_utc', '')::timestamptz;
  v_result_authorised_at_utc := COALESCE(v_incoming_authorised_at_utc, prev.authorised_at_utc);
  v_result_authorised_by_user_id := COALESCE(
    NULLIF(snap ->> 'authorised_by_user_id', '')::uuid,
    prev.authorised_by_user_id
  );
  v_live_authorised := (
       v_current_ts.authorised_at_server IS NOT NULL
    OR UPPER(BTRIM(COALESCE(v_live_contract_week_status, ''))) = 'AUTHORISED'
    OR prev.authorised_at_utc IS NOT NULL
    OR prev.processing_status IN (
         'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum,
         'READY_FOR_HR'::public.ts_fin_processing_status_enum
       )
  );

  IF v_live_authorised
     AND (
          v_processing_status = 'PENDING_AUTH'::public.ts_fin_processing_status_enum
       OR v_processing_status NOT IN (
            'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum,
            'READY_FOR_HR'::public.ts_fin_processing_status_enum
          )
       OR v_result_authorised_at_utc IS NULL
     ) THEN
    v_can_preserve_authorised_at := COALESCE(
      prev.authorised_at_utc,
      v_current_ts.authorised_at_server,
      v_incoming_authorised_at_utc
    ) IS NOT NULL;

    IF NOT v_can_preserve_authorised_at THEN
      v_lifecycle_decision := 'REJECTED';
      PERFORM public._temp_diag_log(
        'TSFIN_SNAPSHOT_LIFECYCLE_DOWNGRADE_REJECTED',
        'TEMP_TIMESHEET_LIFECYCLE',
        p_timesheet_id::text,
        jsonb_strip_nulls(
          jsonb_build_object(
            'function_name', 'tsfin_write_current_snapshot_single_bounded',
            'timesheet_id', p_timesheet_id::text,
            'previous_financials_id', CASE WHEN v_prev_id IS NULL THEN NULL::text ELSE v_prev_id::text END,
            'incoming_processing_status', v_incoming_processing_status,
            'incoming_authorised_at_utc_present', v_incoming_authorised_at_utc IS NOT NULL,
            'live_timesheet_authorised_at_server_present', v_current_ts.authorised_at_server IS NOT NULL,
            'live_contract_week_status', v_live_contract_week_status,
            'previous_tsfin_processing_status', CASE WHEN prev.processing_status IS NULL THEN NULL::text ELSE prev.processing_status::text END,
            'previous_tsfin_authorised_at_utc_present', prev.authorised_at_utc IS NOT NULL,
            'decision', v_lifecycle_decision,
            'result_processing_status', CASE WHEN v_processing_status IS NULL THEN NULL::text ELSE v_processing_status::text END,
            'result_authorised_at_utc_present', false,
            'rejection_reason', 'LIVE_AUTHORISED_STATE_WITHOUT_AUTHORISATION_TIMESTAMP',
            'policy_x_boundary', 'LIFECYCLE_FIELDS_ONLY_NO_ECONOMICS_CHANGE'
          )
        )
      );
      RAISE EXCEPTION USING
        ERRCODE = '40001',
        MESSAGE = 'TSFIN_SNAPSHOT_LIFECYCLE_DOWNGRADE_REJECTED',
        DETAIL = jsonb_build_object(
          'timesheet_id', p_timesheet_id::text,
          'previous_financials_id', CASE WHEN v_prev_id IS NULL THEN NULL::text ELSE v_prev_id::text END,
          'incoming_processing_status', v_incoming_processing_status,
          'live_contract_week_status', v_live_contract_week_status,
          'reason', 'LIVE_AUTHORISED_STATE_WITHOUT_AUTHORISATION_TIMESTAMP'
        )::text;
    END IF;

    v_processing_status := CASE
      WHEN prev.processing_status IN (
             'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum,
             'READY_FOR_HR'::public.ts_fin_processing_status_enum
           )
        THEN prev.processing_status
      WHEN v_processing_status IN (
             'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum,
             'READY_FOR_HR'::public.ts_fin_processing_status_enum
           )
        THEN v_processing_status
      ELSE 'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum
    END;
    v_result_authorised_at_utc := COALESCE(
      prev.authorised_at_utc,
      v_current_ts.authorised_at_server,
      v_incoming_authorised_at_utc
    );
    v_result_authorised_by_user_id := COALESCE(
      prev.authorised_by_user_id,
      v_result_authorised_by_user_id,
      p_actor_user_id
    );
    v_lifecycle_decision := 'PRESERVED';
  END IF;

  PERFORM public._temp_diag_log(
    'TSFIN_SNAPSHOT_LIVE_LIFECYCLE_GUARD',
    'TEMP_TIMESHEET_LIFECYCLE',
    p_timesheet_id::text,
    jsonb_strip_nulls(
      jsonb_build_object(
        'function_name', 'tsfin_write_current_snapshot_single_bounded',
        'timesheet_id', p_timesheet_id::text,
        'previous_financials_id', CASE WHEN v_prev_id IS NULL THEN NULL::text ELSE v_prev_id::text END,
        'incoming_processing_status', v_incoming_processing_status,
        'incoming_authorised_at_utc_present', v_incoming_authorised_at_utc IS NOT NULL,
        'live_timesheet_authorised_at_server_present', v_current_ts.authorised_at_server IS NOT NULL,
        'live_contract_week_id', CASE WHEN v_live_contract_week_id IS NULL THEN NULL::text ELSE v_live_contract_week_id::text END,
        'live_contract_week_status', v_live_contract_week_status
      )
      || jsonb_build_object(
        'previous_tsfin_processing_status', CASE WHEN prev.processing_status IS NULL THEN NULL::text ELSE prev.processing_status::text END,
        'previous_tsfin_authorised_at_utc_present', prev.authorised_at_utc IS NOT NULL,
        'decision', v_lifecycle_decision,
        'result_processing_status', CASE WHEN v_processing_status IS NULL THEN NULL::text ELSE v_processing_status::text END,
        'result_authorised_at_utc_present', v_result_authorised_at_utc IS NOT NULL,
        'policy_x_boundary', 'LIFECYCLE_FIELDS_ONLY_NO_ECONOMICS_CHANGE'
      )
    )
  );

  IF v_lifecycle_decision = 'PRESERVED' THEN
    PERFORM public._temp_diag_log(
      'TSFIN_SNAPSHOT_LIFECYCLE_STATUS_PRESERVED',
      'TEMP_TIMESHEET_LIFECYCLE',
      p_timesheet_id::text,
      jsonb_strip_nulls(
        jsonb_build_object(
          'function_name', 'tsfin_write_current_snapshot_single_bounded',
          'timesheet_id', p_timesheet_id::text,
          'previous_financials_id', CASE WHEN v_prev_id IS NULL THEN NULL::text ELSE v_prev_id::text END,
          'incoming_processing_status', v_incoming_processing_status,
          'incoming_authorised_at_utc_present', v_incoming_authorised_at_utc IS NOT NULL,
          'live_timesheet_authorised_at_server_present', v_current_ts.authorised_at_server IS NOT NULL,
          'live_contract_week_status', v_live_contract_week_status,
          'previous_tsfin_processing_status', CASE WHEN prev.processing_status IS NULL THEN NULL::text ELSE prev.processing_status::text END,
          'previous_tsfin_authorised_at_utc_present', prev.authorised_at_utc IS NOT NULL,
          'decision', v_lifecycle_decision,
          'result_processing_status', CASE WHEN v_processing_status IS NULL THEN NULL::text ELSE v_processing_status::text END,
          'result_authorised_at_utc_present', v_result_authorised_at_utc IS NOT NULL
        )
      )
    );
  END IF;

  -- Plan 6.2 G6-11 (proof/34 section 3, entry point E25): this owner demotes
  -- the current TSFIN row and promotes a replacement, and its error path
  -- promotes the previous row again.  An authorised Weekly-Source-managed root
  -- refuses here: before this owner's first write, which is the
  -- tsfin_prepare_write demotion immediately below, and while it holds the
  -- timesheet and financial row locks taken above.  A Weekly Source root that
  -- is not yet authorised is not managed, so first authorisation and
  -- re-authorisation still write their snapshot; an unmanaged family is
  -- unaffected (proof/34 section 3 E7; contract open ruling OR-2).
  v_weekly_source_guard := private.weekly_source_managed_root_guard_v1(p_timesheet_id);
  -- WP-09b, WP-17b touchpoint reconciliation finding F1 (18 September 2026).
  -- The protected-pay clause was OVER-APPLIED here and refused Weekly Source's
  -- own protected-family preparer,
  -- public.weekly_source_target_managed_root_prepare_atomic_v1, which calls this
  -- owner to write the legitimate zero current TSFIN a protected family needs
  -- BEFORE first authorisation.  One defect failed four release verifiers.
  --
  -- That is not the case the approver ruled on.  HANDOVER 2 round-5 Part E names
  -- PROTECTED_ROOT_AUTHORITY_MISSING as the answer to an ordinary ROTATION
  -- attempt on a protected root, not to the preparer that creates the conditions
  -- for an authorisation record in the first place: a protected-pay root
  -- legitimately has no authorisation record at the moment the preparer runs.
  --
  -- The distinction is a STATE, not a caller.  Exempting this entry point would
  -- reopen the hole the guard exists to close, because it is a genuine rotation
  -- surface.  What it rotates is the CURRENT timesheets_financials row: it
  -- demotes that row and promotes a replacement.  A protected family therefore
  -- has a position to defend exactly when there is something to displace --
  -- a current financial row, or a root that is already authorised.
  --
  -- Measured on a real build from empty, the preparer's call has neither: no
  -- current financial row, authorised_at_server null, no live root
  -- authorisation, and the protected family at ownership_state=TARGET_MANAGED
  -- with current_generation_id null, generation 0, lifecycle PENDING_APPROVAL,
  -- c1_publication_state NONE and 0 components.  Nothing can be rotated; the
  -- first snapshot is being created.  A rotation attempt on a protected root
  -- that DOES hold a current financial row, or whose root is authorised, still
  -- refuses -- proved in both directions.
  v_weekly_source_protected_rotation :=
    (v_weekly_source_guard->>'protected_target_ownership_state') is not null
    and (prev.id is not null
         or v_current_ts.authorised_at_server is not null);
  -- HANDOVER 2 round-5 ruling B3 and A4 (18 September 2026).  The refusal is
  -- NARROWED: it applies to a Weekly-Source managed root, to a bound or
  -- protected family whose identity cannot be resolved, to a family carrying
  -- protected pay evidence but no authorisation row
  -- (PROTECTED_ROOT_AUTHORITY_MISSING), and to the live-record-on-an-
  -- unauthorised-Timesheet contradiction, which must never be allowed to
  -- continue merely because managed is false.  An unrelated, UNBOUND ordinary
  -- family -- including a malformed one -- keeps exactly the behaviour it had
  -- before this feature was installed.  Absent, null and non-boolean take the
  -- unsafe value at every read (Part 1 addendum rule 4).
  IF (COALESCE((v_weekly_source_guard->>'managed')::boolean, true)
       and (COALESCE((v_weekly_source_guard->>'ok')::boolean, true)
            or COALESCE((v_weekly_source_guard->>'weekly_source_bound')::boolean, true)))
     or COALESCE((v_weekly_source_guard->>'authorisation_record_without_authorised_timesheet')::boolean, false)
     or (v_weekly_source_protected_rotation and not
         private.weekly_source_local_preauthorisation_write_allowed_v1(p_timesheet_id,snap)) THEN
    RAISE EXCEPTION 'WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED'
      USING ERRCODE = '55000',
            DETAIL = jsonb_build_object(
              'code','WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED',
              'entry_point','E25:public.tsfin_write_current_snapshot_single_bounded',
              'block_reason','WEEKLY_SOURCE_MANAGED_ROOT',
              'refusal_basis', case
                -- HANDOVER 2 round-5 Part E: the trim-equivalent split family is a
                -- canonical booking-reference collision and must be named as one.
                -- WP-03 handoff N20: accept BOTH the installed token and the ruled name for one
                -- release, so the order of this edit and WP-03's rename cannot open a gap in
                -- which Office stops seeing the ruled name.
                when v_weekly_source_guard->>'reason' in (
                       'FAMILY_SPLIT_BY_WHITESPACE','BOOKING_REFERENCE_CANONICAL_COLLISION')
                  then 'BOOKING_REFERENCE_CANONICAL_COLLISION'
                when coalesce((v_weekly_source_guard->>'managed')::boolean, true) and coalesce((v_weekly_source_guard->>'ok')::boolean, true)
                  then 'WEEKLY_SOURCE_MANAGED_ROOT'
                when coalesce((v_weekly_source_guard->>'managed')::boolean, true)
                  then 'WEEKLY_SOURCE_BOUND_OR_PROTECTED_ROOT_UNRESOLVABLE'
                when coalesce((v_weekly_source_guard->>'authorisation_record_without_authorised_timesheet')::boolean, false)
                  then 'AUTHORISATION_RECORD_WITHOUT_AUTHORISED_TIMESHEET'
                else 'PROTECTED_ROOT_AUTHORITY_MISSING' end,
              'integrity_failure', not coalesce((v_weekly_source_guard->>'ok')::boolean,false),
              'timesheet_id', p_timesheet_id,
              'reason', v_weekly_source_guard->>'reason'
            )::text;
  END IF;

  PERFORM public.tsfin_prepare_write(p_timesheet_id);
  did_prepare := true;

  v_cat_pay :=
      COALESCE(NULLIF(snap ->> 'travel_pay_ex_vat', '')::numeric, prev.travel_pay_ex_vat, 0)
    + COALESCE(NULLIF(snap ->> 'accommodation_pay_ex_vat', '')::numeric, prev.accommodation_pay_ex_vat, 0)
    + COALESCE(NULLIF(snap ->> 'other_pay_ex_vat', '')::numeric, prev.other_pay_ex_vat, 0);

  v_cat_charge :=
      COALESCE(NULLIF(snap ->> 'travel_charge_ex_vat', '')::numeric, prev.travel_charge_ex_vat, 0)
    + COALESCE(NULLIF(snap ->> 'accommodation_charge_ex_vat', '')::numeric, prev.accommodation_charge_ex_vat, 0)
    + COALESCE(NULLIF(snap ->> 'other_charge_ex_vat', '')::numeric, prev.other_charge_ex_vat, 0);

  v_fallback_exp_pay := COALESCE(NULLIF(snap ->> 'expenses_pay_ex_vat', '')::numeric, prev.expenses_pay_ex_vat, 0);
  v_fallback_exp_charge := COALESCE(NULLIF(snap ->> 'expenses_charge_ex_vat', '')::numeric, prev.expenses_charge_ex_vat, 0);
  v_exp_pay := CASE WHEN COALESCE(v_cat_pay, 0) <> 0 THEN v_cat_pay ELSE v_fallback_exp_pay END;
  v_exp_charge := CASE WHEN COALESCE(v_cat_charge, 0) <> 0 THEN v_cat_charge ELSE v_fallback_exp_charge END;
  v_exp_pay := round(COALESCE(v_exp_pay, 0), 2);
  v_exp_charge := round(COALESCE(v_exp_charge, 0), 2);

  v_add_units_json := COALESCE(snap -> 'additional_units_json', prev.additional_units_json, '{}'::jsonb);
  v_add_pay := round(COALESCE(NULLIF(snap ->> 'additional_pay_ex_vat', '')::numeric, prev.additional_pay_ex_vat, 0), 2);
  v_add_charge := round(COALESCE(NULLIF(snap ->> 'additional_charge_ex_vat', '')::numeric, prev.additional_charge_ex_vat, 0), 2);
  v_mil_pay := round(COALESCE(NULLIF(snap ->> 'mileage_pay_ex_vat', '')::numeric, prev.mileage_pay_ex_vat, 0), 2);
  v_mil_charge := round(COALESCE(NULLIF(snap ->> 'mileage_charge_ex_vat', '')::numeric, prev.mileage_charge_ex_vat, 0), 2);

  v_nonseg_pay := round(v_add_pay + v_exp_pay + v_mil_pay, 2);
  v_nonseg_charge := round(v_add_charge + v_exp_charge + v_mil_charge, 2);

  v_core_pay := 0;
  v_core_charge := 0;
  v_mode := UPPER(COALESCE(v_ib ->> 'mode', ''));

  IF v_mode = 'SEGMENTS' AND jsonb_typeof(v_ib -> 'segments') = 'array' THEN
    FOR v_seg IN
      SELECT segment_value.value
      FROM jsonb_array_elements(v_ib -> 'segments') AS segment_value(value)
    LOOP
      IF v_seg IS NULL OR jsonb_typeof(v_seg) <> 'object' THEN
        CONTINUE;
      END IF;

      BEGIN
        v_core_charge := v_core_charge + COALESCE(NULLIF(BTRIM(COALESCE(v_seg ->> 'charge_amount', '')), '')::numeric, 0);
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;

      v_exclude := false;
      BEGIN
        v_exclude := COALESCE(NULLIF(BTRIM(COALESCE(v_seg ->> 'exclude_from_pay', '')), '')::boolean, false);
      EXCEPTION WHEN OTHERS THEN
        v_exclude := false;
      END;

      IF NOT v_exclude THEN
        BEGIN
          v_core_pay := v_core_pay + COALESCE(NULLIF(BTRIM(COALESCE(v_seg ->> 'pay_amount', '')), '')::numeric, 0);
        EXCEPTION WHEN OTHERS THEN
          NULL;
        END;
      END IF;
    END LOOP;
  ELSE
    BEGIN
      v_core_pay := COALESCE(NULLIF(BTRIM(COALESCE(v_ib #>> '{base_hours,pay_ex_vat}', '')), '')::numeric, 0);
    EXCEPTION WHEN OTHERS THEN
      v_core_pay := 0;
    END;

    BEGIN
      v_core_charge := COALESCE(NULLIF(BTRIM(COALESCE(v_ib #>> '{base_hours,charge_ex_vat}', '')), '')::numeric, 0);
    EXCEPTION WHEN OTHERS THEN
      v_core_charge := 0;
    END;
  END IF;

  v_core_pay := round(COALESCE(v_core_pay, 0), 2);
  v_core_charge := round(COALESCE(v_core_charge, 0), 2);
  v_total_pay := round(v_core_pay + v_nonseg_pay, 2);
  v_total_charge := round(v_core_charge + v_nonseg_charge, 2);

  v_policy := COALESCE(snap -> 'policy_snapshot_json', prev.policy_snapshot_json, '{}'::jsonb);
  IF v_policy IS NULL OR jsonb_typeof(v_policy) <> 'object' THEN
    v_policy := '{}'::jsonb;
  END IF;

  v_apply_to := UPPER(COALESCE(NULLIF(BTRIM(COALESCE(v_policy ->> 'apply_erni_to', '')), ''), 'PAYE_ONLY'));
  BEGIN
    v_erni_pct_raw := COALESCE(NULLIF(BTRIM(COALESCE(v_policy ->> 'erni_pct', '')), '')::numeric, 0);
  EXCEPTION WHEN OTHERS THEN
    v_erni_pct_raw := 0;
  END;

  v_erni_mult := 1;
  IF COALESCE(v_erni_pct_raw, 0) > 0 THEN
    IF v_erni_pct_raw > 1 THEN
      v_erni_mult := 1 + (v_erni_pct_raw / 100);
    ELSE
      v_erni_mult := 1 + v_erni_pct_raw;
    END IF;
  END IF;

  v_pay_method_u := UPPER(COALESCE(NULLIF(BTRIM(COALESCE(snap ->> 'pay_method', '')), ''), NULLIF(BTRIM(COALESCE(prev.pay_method::text, '')), ''), ''));
  IF v_pay_method_u IN ('PAYE', 'UMBRELLA') THEN
    v_pay_method_insert := v_pay_method_u;
  ELSE
    v_pay_method_insert := NULL;
  END IF;
  v_erni_applies := (v_pay_method_insert = 'PAYE') AND (v_apply_to = 'ALL' OR v_apply_to = 'PAYE_ONLY');

  v_wage_pay := round(v_core_pay + v_add_pay, 2);
  v_reimb_pay := round(v_exp_pay + v_mil_pay, 2);
  v_wage_pay_cost := v_wage_pay;
  IF v_erni_applies THEN
    v_wage_pay_cost := round(v_wage_pay * v_erni_mult, 2);
  END IF;
  v_pay_cost := round(v_wage_pay_cost + v_reimb_pay, 2);
  v_margin := round(v_total_charge - v_pay_cost, 2);

  v_nonseg_wage_pay := v_add_pay;
  v_nonseg_reimb_pay := round(v_exp_pay + v_mil_pay, 2);
  v_nonseg_wage_pay_cost := v_nonseg_wage_pay;
  IF v_erni_applies THEN
    v_nonseg_wage_pay_cost := round(v_nonseg_wage_pay * v_erni_mult, 2);
  END IF;
  v_nonseg_pay_cost := round(v_nonseg_wage_pay_cost + v_nonseg_reimb_pay, 2);
  v_nonseg_margin := round(v_nonseg_charge - v_nonseg_pay_cost, 2);

  v_add_obj := CASE WHEN v_ib ? 'additional' AND jsonb_typeof(v_ib -> 'additional') = 'object' THEN v_ib -> 'additional' ELSE '{}'::jsonb END;
  IF NOT (v_add_obj ? 'units') OR jsonb_typeof(v_add_obj -> 'units') <> 'object' THEN
    IF v_add_units_json IS NULL OR jsonb_typeof(v_add_units_json) <> 'object' THEN
      v_add_units_json := '{}'::jsonb;
    END IF;
    v_add_obj := jsonb_set(v_add_obj, '{units}', v_add_units_json, true);
  END IF;
  v_add_obj := jsonb_set(v_add_obj, '{pay_ex_vat}', to_jsonb(v_nonseg_pay), true);
  v_add_obj := jsonb_set(v_add_obj, '{charge_ex_vat}', to_jsonb(v_nonseg_charge), true);
  v_add_obj := jsonb_set(v_add_obj, '{margin_ex_vat}', to_jsonb(v_nonseg_margin), true);
  v_ib := jsonb_set(v_ib, '{additional}', v_add_obj, true);

  v_tot_obj := CASE WHEN v_ib ? 'totals' AND jsonb_typeof(v_ib -> 'totals') = 'object' THEN v_ib -> 'totals' ELSE '{}'::jsonb END;
  v_tot_obj := jsonb_set(v_tot_obj, '{total_pay_ex_vat}', to_jsonb(v_total_pay), true);
  v_tot_obj := jsonb_set(v_tot_obj, '{total_charge_ex_vat}', to_jsonb(v_total_charge), true);
  v_tot_obj := jsonb_set(v_tot_obj, '{margin_ex_vat}', to_jsonb(v_margin), true);
  v_ib := jsonb_set(v_ib, '{totals}', v_tot_obj, true);

  v_is_stale := COALESCE(NULLIF(snap ->> 'is_stale', '')::boolean, false);
  v_stale_reason := NULLIF(snap ->> 'stale_reason', '');
  IF v_processing_status = 'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum THEN
    v_is_stale := false;
    v_stale_reason := NULL;
  END IF;

  v_mileage_units := GREATEST(COALESCE(NULLIF(snap ->> 'mileage_units', '')::numeric, prev.mileage_units, 0), 0);

  INSERT INTO public.timesheets_financials (
    timesheet_id,
    timesheet_version,
    basis,
    is_current,
    is_stale,
    stale_reason,
    worked_start_iso,
    worked_end_iso,
    break_start_iso,
    break_end_iso,
    break_minutes,
    candidate_id,
    client_id,
    role,
    band,
    pay_method,
    policy_snapshot_json,
    rate_source_refs_json,
    hours_day,
    hours_night,
    hours_sat,
    hours_sun,
    hours_bh,
    pay_day,
    pay_night,
    pay_sat,
    pay_sun,
    pay_bh,
    charge_day,
    charge_night,
    charge_sat,
    charge_sun,
    charge_bh,
    total_hours,
    total_pay_ex_vat,
    total_charge_ex_vat,
    margin_ex_vat,
    computed_at_utc,
    occupant_key_norm,
    candidate_assignment,
    processing_status,
    expenses_pay_ex_vat,
    expenses_charge_ex_vat,
    expenses_description,
    expenses_evidence_r2_key,
    expenses_evidence_manifest,
    travel_pay_ex_vat,
    travel_charge_ex_vat,
    accommodation_pay_ex_vat,
    accommodation_charge_ex_vat,
    other_pay_ex_vat,
    other_charge_ex_vat,
    mileage_pay_ex_vat,
    mileage_charge_ex_vat,
    mileage_units,
    mileage_evidence_r2_key,
    mileage_evidence_manifest,
    mileage_pay_rate,
    mileage_charge_rate,
    po_number,
    pay_on_hold,
    pay_on_hold_reason,
    pay_on_hold_since_utc,
    pay_wtr_rate_pct_snapshot,
    pay_vat_rate_pct_snapshot,
    pay_vat_amount_snapshot,
    pay_total_inc_vat_snapshot,
    payment_reference,
    remittance_last_sent_at_utc,
    remittance_send_count,
    processed_by_user_id,
    processed_at_utc,
    authorised_by_user_id,
    authorised_at_utc,
    additional_units_json,
    additional_pay_ex_vat,
    additional_charge_ex_vat,
    additional_margin_ex_vat,
    invoice_breakdown_json,
    nhsp_import_id,
    has_rate_issue,
    has_pay_channel_issue,
    hr_crosscheck_status,
    hr_crosscheck_issues,
    external_source_rows_json,
    actual_schedule_json,
    actual_minutes_by_day_json
  )
  VALUES (
    p_timesheet_id,
    v_timesheet_version,
    v_basis,
    true,
    v_is_stale,
    v_stale_reason,
    NULLIF(snap ->> 'worked_start_iso', '')::timestamptz,
    NULLIF(snap ->> 'worked_end_iso', '')::timestamptz,
    NULLIF(snap ->> 'break_start_iso', '')::timestamptz,
    NULLIF(snap ->> 'break_end_iso', '')::timestamptz,
    NULLIF(snap ->> 'break_minutes', '')::integer,
    NULLIF(snap ->> 'candidate_id', '')::uuid,
    NULLIF(snap ->> 'client_id', '')::uuid,
    NULLIF(snap ->> 'role', ''),
    NULLIF(snap ->> 'band', ''),
    v_pay_method_insert,
    COALESCE(snap -> 'policy_snapshot_json', '{}'::jsonb),
    COALESCE(snap -> 'rate_source_refs_json', '{}'::jsonb),
    COALESCE(NULLIF(snap ->> 'hours_day', '')::numeric, 0),
    COALESCE(NULLIF(snap ->> 'hours_night', '')::numeric, 0),
    COALESCE(NULLIF(snap ->> 'hours_sat', '')::numeric, 0),
    COALESCE(NULLIF(snap ->> 'hours_sun', '')::numeric, 0),
    COALESCE(NULLIF(snap ->> 'hours_bh', '')::numeric, 0),
    NULLIF(snap ->> 'pay_day', '')::numeric,
    NULLIF(snap ->> 'pay_night', '')::numeric,
    NULLIF(snap ->> 'pay_sat', '')::numeric,
    NULLIF(snap ->> 'pay_sun', '')::numeric,
    NULLIF(snap ->> 'pay_bh', '')::numeric,
    NULLIF(snap ->> 'charge_day', '')::numeric,
    NULLIF(snap ->> 'charge_night', '')::numeric,
    NULLIF(snap ->> 'charge_sat', '')::numeric,
    NULLIF(snap ->> 'charge_sun', '')::numeric,
    NULLIF(snap ->> 'charge_bh', '')::numeric,
    COALESCE(NULLIF(snap ->> 'total_hours', '')::numeric, 0),
    COALESCE(v_total_pay, 0),
    COALESCE(v_total_charge, 0),
    COALESCE(v_margin, 0),
    v_now,
    NULLIF(snap ->> 'occupant_key_norm', ''),
    v_candidate_assignment,
    v_processing_status,
    COALESCE(v_exp_pay, 0),
    COALESCE(v_exp_charge, 0),
    NULLIF(snap ->> 'expenses_description', ''),
    NULLIF(snap ->> 'expenses_evidence_r2_key', ''),
    COALESCE(snap -> 'expenses_evidence_manifest', prev.expenses_evidence_manifest),
    COALESCE(NULLIF(snap ->> 'travel_pay_ex_vat', '')::numeric, prev.travel_pay_ex_vat, 0),
    COALESCE(NULLIF(snap ->> 'travel_charge_ex_vat', '')::numeric, prev.travel_charge_ex_vat, 0),
    COALESCE(NULLIF(snap ->> 'accommodation_pay_ex_vat', '')::numeric, prev.accommodation_pay_ex_vat, 0),
    COALESCE(NULLIF(snap ->> 'accommodation_charge_ex_vat', '')::numeric, prev.accommodation_charge_ex_vat, 0),
    COALESCE(NULLIF(snap ->> 'other_pay_ex_vat', '')::numeric, prev.other_pay_ex_vat, 0),
    COALESCE(NULLIF(snap ->> 'other_charge_ex_vat', '')::numeric, prev.other_charge_ex_vat, 0),
    COALESCE(NULLIF(snap ->> 'mileage_pay_ex_vat', '')::numeric, prev.mileage_pay_ex_vat, 0),
    COALESCE(NULLIF(snap ->> 'mileage_charge_ex_vat', '')::numeric, prev.mileage_charge_ex_vat, 0),
    v_mileage_units,
    NULLIF(snap ->> 'mileage_evidence_r2_key', ''),
    COALESCE(snap -> 'mileage_evidence_manifest', prev.mileage_evidence_manifest),
    NULLIF(snap ->> 'mileage_pay_rate', '')::numeric,
    NULLIF(snap ->> 'mileage_charge_rate', '')::numeric,
    COALESCE(NULLIF(snap ->> 'po_number', ''), prev.po_number),
    COALESCE(NULLIF(snap ->> 'pay_on_hold', '')::boolean, prev.pay_on_hold, false),
    COALESCE(NULLIF(snap ->> 'pay_on_hold_reason', ''), prev.pay_on_hold_reason),
    COALESCE(NULLIF(snap ->> 'pay_on_hold_since_utc', '')::timestamptz, prev.pay_on_hold_since_utc),
    NULLIF(snap ->> 'pay_wtr_rate_pct_snapshot', '')::numeric,
    NULLIF(snap ->> 'pay_vat_rate_pct_snapshot', '')::numeric,
    COALESCE(NULLIF(snap ->> 'pay_vat_amount_snapshot', '')::numeric, 0),
    COALESCE(NULLIF(snap ->> 'pay_total_inc_vat_snapshot', '')::numeric, 0),
    COALESCE(NULLIF(snap ->> 'payment_reference', ''), prev.payment_reference),
    COALESCE(NULLIF(snap ->> 'remittance_last_sent_at_utc', '')::timestamptz, prev.remittance_last_sent_at_utc),
    COALESCE(NULLIF(snap ->> 'remittance_send_count', '')::integer, prev.remittance_send_count, 0),
    COALESCE(NULLIF(snap ->> 'processed_by_user_id', '')::uuid, prev.processed_by_user_id, p_actor_user_id),
    COALESCE(NULLIF(snap ->> 'processed_at_utc', '')::timestamptz, prev.processed_at_utc, v_now),
    v_result_authorised_by_user_id,
    v_result_authorised_at_utc,
    COALESCE(snap -> 'additional_units_json', prev.additional_units_json, '{}'::jsonb),
    COALESCE(NULLIF(snap ->> 'additional_pay_ex_vat', '')::numeric, prev.additional_pay_ex_vat, 0),
    COALESCE(NULLIF(snap ->> 'additional_charge_ex_vat', '')::numeric, prev.additional_charge_ex_vat, 0),
    COALESCE(NULLIF(snap ->> 'additional_margin_ex_vat', '')::numeric, prev.additional_margin_ex_vat, 0),
    v_ib,
    NULLIF(snap ->> 'nhsp_import_id', '')::uuid,
    COALESCE(NULLIF(snap ->> 'has_rate_issue', '')::boolean, false),
    COALESCE(NULLIF(snap ->> 'has_pay_channel_issue', '')::boolean, false),
    COALESCE(NULLIF(snap ->> 'hr_crosscheck_status', ''), prev.hr_crosscheck_status),
    COALESCE(
      CASE
        WHEN snap ? 'hr_crosscheck_issues' AND jsonb_typeof(snap -> 'hr_crosscheck_issues') = 'array'
          THEN ARRAY(SELECT jsonb_array_elements_text(snap -> 'hr_crosscheck_issues'))
        ELSE NULL
      END,
      prev.hr_crosscheck_issues
    ),
    COALESCE(snap -> 'external_source_rows_json', prev.external_source_rows_json),
    COALESCE(snap -> 'actual_schedule_json', prev.actual_schedule_json),
    COALESCE(snap -> 'actual_minutes_by_day_json', prev.actual_minutes_by_day_json)
  )
  RETURNING * INTO inserted_row;

  PERFORM private.weekly_source_agency_financial_write_observe_v1(
    p_timesheet_id,snap,null::uuid);

  RETURN jsonb_build_object(
    'ok', true,
    'timesheet_id', inserted_row.timesheet_id,
    'timesheet_financials_id', inserted_row.id,
    'processing_status', inserted_row.processing_status::text,
    'timesheet_version', inserted_row.timesheet_version,
    'updated_at', inserted_row.updated_at,
    'computed_at_utc', inserted_row.computed_at_utc,
    'version_marker', md5(jsonb_build_object(
      'id', inserted_row.id,
      'timesheet_id', inserted_row.timesheet_id,
      'timesheet_version', inserted_row.timesheet_version,
      'processing_status', inserted_row.processing_status::text,
      'updated_at', inserted_row.updated_at,
      'computed_at_utc', inserted_row.computed_at_utc,
      'total_hours', inserted_row.total_hours,
      'total_pay_ex_vat', inserted_row.total_pay_ex_vat,
      'total_charge_ex_vat', inserted_row.total_charge_ex_vat,
      'margin_ex_vat', inserted_row.margin_ex_vat
    )::text)
  );
EXCEPTION
  WHEN OTHERS THEN
    GET STACKED DIAGNOSTICS
      v_error_state = RETURNED_SQLSTATE,
      v_error_message = MESSAGE_TEXT;

    IF did_prepare AND v_prev_id IS NOT NULL THEN
      UPDATE public.timesheets_financials AS restore_tf
         SET is_current = true,
             updated_at = COALESCE(p_now_utc, now())
       WHERE restore_tf.id = v_prev_id
         AND restore_tf.locked_by_invoice_id IS NULL
         AND restore_tf.paid_at_utc IS NULL;
    END IF;

    IF v_error_state IN ('55P03', '57014') THEN
      RAISE EXCEPTION USING
        MESSAGE = 'LOCK_TIMEOUT',
        DETAIL = jsonb_build_object('timesheet_id', p_timesheet_id, 'error_state', v_error_state)::text;
    END IF;

    IF v_error_message = 'TSFIN_LOCKED' THEN
      RAISE EXCEPTION USING MESSAGE = 'TIMESHEET_LOCKED_OR_PAID', DETAIL = jsonb_build_object('timesheet_id', p_timesheet_id)::text;
    END IF;

    IF v_error_state IN ('22P02', '22007', '22008', '22003', '22018') THEN
      RAISE EXCEPTION USING
        MESSAGE = 'TSFIN_SNAPSHOT_MISMATCH',
        DETAIL = jsonb_build_object('timesheet_id', p_timesheet_id, 'error_state', v_error_state, 'error_message', v_error_message)::text;
    END IF;

    RAISE;
END;
$function$;

CREATE OR REPLACE FUNCTION public.tsfin_write_snapshots_and_complete(p_rows jsonb)
 RETURNS TABLE(ok_count integer, fail_count integer, errors jsonb)
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'extensions', 'pg_temp'
 SET plpgsql_check.mode TO 'disabled'
AS $function$
declare
  v_ok int := 0;
  v_fail int := 0;
  v_errors jsonb := '[]'::jsonb;

  r record;
  snap jsonb;

  prev public.timesheets_financials%rowtype;
  v_prev_id uuid;

  v_outbox_id uuid;
  v_timesheet_id uuid;

  v_err text;
  did_prepare boolean;

  -- ✅ validate segments JSON before writing
  v_ib  jsonb;
  v_bad int;

  -- ✅ expense component rollup (sum components; fallback to expenses_* only if sum == 0)
  v_cat_pay numeric;
  v_cat_charge numeric;
  v_fallback_exp_pay numeric;
  v_fallback_exp_charge numeric;
  v_exp_pay numeric;
  v_exp_charge numeric;

  -- ✅ additional + mileage rollup + patched totals/breakdown
  v_add_units_json jsonb;
  v_add_pay numeric;
  v_add_charge numeric;
  v_mil_pay numeric;
  v_mil_charge numeric;

  v_nonseg_pay numeric;
  v_nonseg_charge numeric;
  v_nonseg_margin numeric;

  v_core_pay numeric;
  v_core_charge numeric;

  v_total_pay numeric;
  v_total_charge numeric;
  v_margin numeric;

  v_add_obj jsonb;
  v_tot_obj jsonb;

  v_mode text;
  v_seg jsonb;
  v_exclude boolean;

  -- ✅ ERNI policy (PAYE only; NEVER applies to expenses/mileage)
  v_policy jsonb;
  v_apply_to text;
  v_erni_pct_raw numeric;
  v_erni_mult numeric;
  v_pay_method_u text;
  v_erni_applies boolean;

  v_wage_pay numeric;
  v_wage_pay_cost numeric;
  v_reimb_pay numeric;
  v_pay_cost numeric;

  v_nonseg_wage_pay numeric;
  v_nonseg_wage_pay_cost numeric;
  v_nonseg_reimb_pay numeric;
  v_nonseg_pay_cost numeric;

  v_processing_status public.ts_fin_processing_status_enum;
  v_candidate_assignment public.candidate_assignment_enum;
  v_basis public.timesheet_fin_basis_enum;
  v_timesheet_version int;
  v_is_stale boolean;
  v_stale_reason text;
  v_temp_log_enabled boolean := false;
  v_signature_diag_json jsonb := '{}'::jsonb;

  v_live_timesheet_authorised_at_server timestamptz := NULL::timestamptz;
  v_live_contract_week_id uuid := NULL::uuid;
  v_live_contract_week_status text := NULL::text;
  v_incoming_processing_status text := NULL::text;
  v_incoming_authorised_at_utc timestamptz := NULL::timestamptz;
  v_result_authorised_at_utc timestamptz := NULL::timestamptz;
  v_result_authorised_by_user_id uuid := NULL::uuid;
  v_live_authorised boolean := false;
  v_can_preserve_authorised_at boolean := false;
  v_lifecycle_decision text := 'WRITTEN';

  -- Plan 6.2 G6-11 (proof/34 section 3, entry point E26).
  v_weekly_source_guard jsonb;
  v_agency_request_id uuid; v_agency_request_count integer; v_agency_write_purpose jsonb;
begin
  perform public._ctms_assert_tsfin_batch_units_v1(coalesce(p_rows, '[]'::jsonb));
  BEGIN
    SELECT COALESCE(sd.temp_log, false)
      INTO v_temp_log_enabled
    FROM public.settings_defaults AS sd
    ORDER BY sd.id
    LIMIT 1;
  EXCEPTION
    WHEN undefined_table OR undefined_column THEN
      v_temp_log_enabled := false;
    WHEN OTHERS THEN
      v_temp_log_enabled := false;
  END;

  if p_rows is null or jsonb_typeof(p_rows) <> 'array' then
    ok_count := 0;
    fail_count := 0;
    errors := '[]'::jsonb;
    return next;
    return;
  end if;

  for r in
    select
      nullif(elem->>'outbox_id','')::uuid     as outbox_id,
      nullif(elem->>'timesheet_id','')::uuid  as timesheet_id,
      elem->'snapshot'                        as snapshot
    from jsonb_array_elements(p_rows) as elem
  loop
    v_outbox_id := r.outbox_id;
    v_timesheet_id := r.timesheet_id;
    snap := r.snapshot;
    v_agency_request_id := null; v_agency_request_count := 0; v_agency_write_purpose := null;

    did_prepare := false;
    v_prev_id := null;
    v_live_timesheet_authorised_at_server := NULL::timestamptz;
    v_live_contract_week_id := NULL::uuid;
    v_live_contract_week_status := NULL::text;
    v_incoming_processing_status := NULL::text;
    v_incoming_authorised_at_utc := NULL::timestamptz;
    v_result_authorised_at_utc := NULL::timestamptz;
    v_result_authorised_by_user_id := NULL::uuid;
    v_live_authorised := false;
    v_can_preserve_authorised_at := false;
    v_lifecycle_decision := 'WRITTEN';

    begin
      if v_outbox_id is null or v_timesheet_id is null or snap is null then
        raise exception 'INVALID_BATCH_ROW';
      end if;

      -- A queued Agency write is the exact native request/outbox, not a caller phase.
      select count(*),(array_agg(id order by id))[1] into v_agency_request_count,v_agency_request_id
      from private.weekly_source_agency_timesheet_change_requests
      where current_timesheet_id=v_timesheet_id and state='ACTIVE';
      if v_agency_request_count>1 then
        raise exception 'AGENCY_CHANGE_CURRENT_REQUEST_AMBIGUOUS'; end if;
      if v_agency_request_count=1 then
        perform private.weekly_source_agency_financial_frame_open_v1(
          v_agency_request_id,'RECOMPUTE',snap,v_outbox_id);
        v_agency_write_purpose := private.weekly_source_agency_financial_write_assert_v1(
          v_timesheet_id,snap,null::uuid,v_outbox_id);
      end if;

      -- SAFETY: do not write if current snapshot is paid
      if exists (
        select 1
        from public.timesheets_financials tf
        where tf.timesheet_id = v_timesheet_id
          and tf.is_current = true
          and tf.paid_at_utc is not null
      ) and v_agency_write_purpose is null then
        perform public.tsfin_work_success(v_outbox_id);
        v_ok := v_ok + 1;
        continue;
      end if;

      -- Capture live lifecycle and current snapshot (for restore-on-fail + preserving manual fields).
      select ts.authorised_at_server
      into v_live_timesheet_authorised_at_server
      from public.timesheets AS ts
      where ts.timesheet_id = v_timesheet_id
        and coalesce(ts.is_current, true) = true
      order by ts.updated_at desc nulls last,
               ts.created_at desc nulls last,
               ts.timesheet_id desc
      limit 1
      for update;

      select cw.id,
             cw.status::text
      into v_live_contract_week_id,
           v_live_contract_week_status
      from public.contract_weeks AS cw
      where cw.timesheet_id = v_timesheet_id
      order by cw.updated_at desc nulls last,
               cw.created_at desc nulls last,
               cw.id desc
      limit 1
      for update;

      select *
      into prev
      from public.timesheets_financials tf
      where tf.timesheet_id = v_timesheet_id
        and tf.is_current = true
      order by tf.computed_at_utc desc nulls last,
               tf.created_at desc nulls last,
               tf.updated_at desc nulls last,
               tf.id desc
      limit 1
      for update;

      v_prev_id := prev.id;

      -- Resolve enums/typed fields once (avoid divergence between flags and stored status)
      v_timesheet_version :=
        coalesce(nullif(snap->>'timesheet_version','')::int, 1);

      v_basis :=
        coalesce(
          nullif(snap->>'basis','')::public.timesheet_fin_basis_enum,
          'SELF_REPORTED'::public.timesheet_fin_basis_enum
        );

      v_candidate_assignment :=
        coalesce(
          nullif(snap->>'candidate_assignment','')::public.candidate_assignment_enum,
          'UNASSIGNED'::public.candidate_assignment_enum
        );

      v_processing_status :=
        coalesce(
          nullif(snap->>'processing_status','')::public.ts_fin_processing_status_enum,
          'UNASSIGNED'::public.ts_fin_processing_status_enum
        );

      -- ✅ validate invoice_breakdown_json (prevents persisting null/invalid segments)
      v_ib := coalesce(snap->'invoice_breakdown_json', '{}'::jsonb);
      if v_ib is null or jsonb_typeof(v_ib) <> 'object' then
        v_ib := '{}'::jsonb;
      end if;

      v_bad := public._tsfin_invalid_segment_count(v_ib);
      if v_bad > 0 then
        raise exception 'INVALID_SEGMENTS_JSON:%', v_bad;
      end if;

      v_incoming_processing_status := CASE
        WHEN v_processing_status IS NULL THEN NULL::text
        ELSE v_processing_status::text
      END;
      v_incoming_authorised_at_utc := NULLIF(snap->>'authorised_at_utc','')::timestamptz;
      v_result_authorised_at_utc := coalesce(v_incoming_authorised_at_utc, prev.authorised_at_utc);
      v_result_authorised_by_user_id := coalesce(
        nullif(snap->>'authorised_by_user_id','')::uuid,
        prev.authorised_by_user_id
      );
      v_live_authorised := (
           v_live_timesheet_authorised_at_server IS NOT NULL
        OR upper(btrim(coalesce(v_live_contract_week_status, ''))) = 'AUTHORISED'
        OR prev.authorised_at_utc IS NOT NULL
        OR prev.processing_status IN (
             'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum,
             'READY_FOR_HR'::public.ts_fin_processing_status_enum
           )
      );

      IF v_live_authorised
         AND (
              v_processing_status = 'PENDING_AUTH'::public.ts_fin_processing_status_enum
           OR v_processing_status NOT IN (
                'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum,
                'READY_FOR_HR'::public.ts_fin_processing_status_enum
              )
           OR v_result_authorised_at_utc IS NULL
         ) THEN
        v_can_preserve_authorised_at := coalesce(
          prev.authorised_at_utc,
          v_live_timesheet_authorised_at_server,
          v_incoming_authorised_at_utc
        ) IS NOT NULL;

        IF NOT v_can_preserve_authorised_at THEN
          v_lifecycle_decision := 'REJECTED';
          PERFORM public._temp_diag_log(
            'TSFIN_SNAPSHOT_LIFECYCLE_DOWNGRADE_REJECTED',
            'TEMP_TIMESHEET_LIFECYCLE',
            v_timesheet_id::text,
            jsonb_strip_nulls(
              jsonb_build_object(
                'function_name', 'tsfin_write_snapshots_and_complete',
                'outbox_id', CASE WHEN v_outbox_id IS NULL THEN NULL::text ELSE v_outbox_id::text END,
                'timesheet_id', v_timesheet_id::text,
                'previous_financials_id', CASE WHEN v_prev_id IS NULL THEN NULL::text ELSE v_prev_id::text END,
                'incoming_processing_status', v_incoming_processing_status,
                'incoming_authorised_at_utc_present', v_incoming_authorised_at_utc IS NOT NULL,
                'live_timesheet_authorised_at_server_present', v_live_timesheet_authorised_at_server IS NOT NULL,
                'live_contract_week_status', v_live_contract_week_status,
                'previous_tsfin_processing_status', CASE WHEN prev.processing_status IS NULL THEN NULL::text ELSE prev.processing_status::text END,
                'previous_tsfin_authorised_at_utc_present', prev.authorised_at_utc IS NOT NULL,
                'decision', v_lifecycle_decision,
                'result_processing_status', CASE WHEN v_processing_status IS NULL THEN NULL::text ELSE v_processing_status::text END,
                'result_authorised_at_utc_present', false,
                'rejection_reason', 'LIVE_AUTHORISED_STATE_WITHOUT_AUTHORISATION_TIMESTAMP',
                'policy_x_boundary', 'LIFECYCLE_FIELDS_ONLY_NO_ECONOMICS_CHANGE'
              )
            )
          );
          RAISE EXCEPTION USING
            ERRCODE = '40001',
            MESSAGE = 'TSFIN_SNAPSHOT_LIFECYCLE_DOWNGRADE_REJECTED',
            DETAIL = jsonb_build_object(
              'outbox_id', CASE WHEN v_outbox_id IS NULL THEN NULL::text ELSE v_outbox_id::text END,
              'timesheet_id', v_timesheet_id::text,
              'previous_financials_id', CASE WHEN v_prev_id IS NULL THEN NULL::text ELSE v_prev_id::text END,
              'incoming_processing_status', v_incoming_processing_status,
              'live_contract_week_status', v_live_contract_week_status,
              'reason', 'LIVE_AUTHORISED_STATE_WITHOUT_AUTHORISATION_TIMESTAMP'
            )::text;
        END IF;

        v_processing_status := CASE
          WHEN prev.processing_status IN (
                 'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum,
                 'READY_FOR_HR'::public.ts_fin_processing_status_enum
               )
            THEN prev.processing_status
          WHEN v_processing_status IN (
                 'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum,
                 'READY_FOR_HR'::public.ts_fin_processing_status_enum
               )
            THEN v_processing_status
          ELSE 'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum
        END;
        v_result_authorised_at_utc := coalesce(
          prev.authorised_at_utc,
          v_live_timesheet_authorised_at_server,
          v_incoming_authorised_at_utc
        );
        v_result_authorised_by_user_id := coalesce(
          prev.authorised_by_user_id,
          v_result_authorised_by_user_id
        );
        v_lifecycle_decision := 'PRESERVED';
      END IF;

      PERFORM public._temp_diag_log(
        'TSFIN_SNAPSHOT_LIVE_LIFECYCLE_GUARD',
        'TEMP_TIMESHEET_LIFECYCLE',
        v_timesheet_id::text,
        jsonb_strip_nulls(
          jsonb_build_object(
            'function_name', 'tsfin_write_snapshots_and_complete',
            'outbox_id', CASE WHEN v_outbox_id IS NULL THEN NULL::text ELSE v_outbox_id::text END,
            'timesheet_id', v_timesheet_id::text,
            'previous_financials_id', CASE WHEN v_prev_id IS NULL THEN NULL::text ELSE v_prev_id::text END,
            'incoming_processing_status', v_incoming_processing_status,
            'incoming_authorised_at_utc_present', v_incoming_authorised_at_utc IS NOT NULL,
            'live_timesheet_authorised_at_server_present', v_live_timesheet_authorised_at_server IS NOT NULL,
            'live_contract_week_id', CASE WHEN v_live_contract_week_id IS NULL THEN NULL::text ELSE v_live_contract_week_id::text END,
            'live_contract_week_status', v_live_contract_week_status
          )
          || jsonb_build_object(
            'previous_tsfin_processing_status', CASE WHEN prev.processing_status IS NULL THEN NULL::text ELSE prev.processing_status::text END,
            'previous_tsfin_authorised_at_utc_present', prev.authorised_at_utc IS NOT NULL,
            'decision', v_lifecycle_decision,
            'result_processing_status', CASE WHEN v_processing_status IS NULL THEN NULL::text ELSE v_processing_status::text END,
            'result_authorised_at_utc_present', v_result_authorised_at_utc IS NOT NULL,
            'policy_x_boundary', 'LIFECYCLE_FIELDS_ONLY_NO_ECONOMICS_CHANGE'
          )
        )
      );

      IF v_lifecycle_decision = 'PRESERVED' THEN
        PERFORM public._temp_diag_log(
          'TSFIN_SNAPSHOT_LIFECYCLE_STATUS_PRESERVED',
          'TEMP_TIMESHEET_LIFECYCLE',
          v_timesheet_id::text,
          jsonb_strip_nulls(
            jsonb_build_object(
              'function_name', 'tsfin_write_snapshots_and_complete',
              'outbox_id', CASE WHEN v_outbox_id IS NULL THEN NULL::text ELSE v_outbox_id::text END,
              'timesheet_id', v_timesheet_id::text,
              'previous_financials_id', CASE WHEN v_prev_id IS NULL THEN NULL::text ELSE v_prev_id::text END,
              'incoming_processing_status', v_incoming_processing_status,
              'incoming_authorised_at_utc_present', v_incoming_authorised_at_utc IS NOT NULL,
              'live_timesheet_authorised_at_server_present', v_live_timesheet_authorised_at_server IS NOT NULL,
              'live_contract_week_status', v_live_contract_week_status,
              'previous_tsfin_processing_status', CASE WHEN prev.processing_status IS NULL THEN NULL::text ELSE prev.processing_status::text END,
              'previous_tsfin_authorised_at_utc_present', prev.authorised_at_utc IS NOT NULL,
              'decision', v_lifecycle_decision,
              'result_processing_status', CASE WHEN v_processing_status IS NULL THEN NULL::text ELSE v_processing_status::text END,
              'result_authorised_at_utc_present', v_result_authorised_at_utc IS NOT NULL
            )
          )
        );
      END IF;

      -- Plan 6.2 G6-11 (proof/34 section 3, entry point E26): this owner demotes
      -- the current TSFIN row and promotes a replacement, and its error path
      -- promotes the previous row again.  An authorised Weekly-Source-managed
      -- root refuses here: before this row's first write, which is the
      -- tsfin_prepare_write demotion immediately below, and while it holds the
      -- timesheet and financial row locks taken above.  A Weekly Source root
      -- that is not yet authorised is not managed, so first authorisation and
      -- re-authorisation still write their snapshot; an unmanaged family is
      -- unaffected (proof/34 section 3 E7; contract open ruling OR-2).
      v_weekly_source_guard := private.weekly_source_managed_root_guard_v1(v_timesheet_id);
      -- HANDOVER 2 round-5 ruling B3 and A4 (18 September 2026).  The refusal is
      -- NARROWED: it applies to a Weekly-Source managed root, to a bound or
      -- protected family whose identity cannot be resolved, to a family carrying
      -- protected pay evidence but no authorisation row
      -- (PROTECTED_ROOT_AUTHORITY_MISSING), and to the live-record-on-an-
      -- unauthorised-Timesheet contradiction, which must never be allowed to
      -- continue merely because managed is false.  An unrelated, UNBOUND ordinary
      -- family -- including a malformed one -- keeps exactly the behaviour it had
      -- before this feature was installed.  Absent, null and non-boolean take the
      -- unsafe value at every read (Part 1 addendum rule 4).
      if (coalesce((v_weekly_source_guard->>'managed')::boolean, true)
           and (coalesce((v_weekly_source_guard->>'ok')::boolean, true)
                or coalesce((v_weekly_source_guard->>'weekly_source_bound')::boolean, true)))
         or coalesce((v_weekly_source_guard->>'authorisation_record_without_authorised_timesheet')::boolean, false)
         or (v_weekly_source_guard->>'protected_target_ownership_state') is not null then
        raise exception 'WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED'
          using errcode = '55000',
                detail = jsonb_build_object(
                  'code','WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED',
                  'entry_point','E26:public.tsfin_write_snapshots_and_complete',
                  'block_reason','WEEKLY_SOURCE_MANAGED_ROOT',
                  'refusal_basis', case
                    -- HANDOVER 2 round-5 Part E: the trim-equivalent split family is a
                    -- canonical booking-reference collision and must be named as one.
                    -- WP-03 handoff N20: accept BOTH the installed token and the ruled name for one
                    -- release, so the order of this edit and WP-03's rename cannot open a gap in
                    -- which Office stops seeing the ruled name.
                    when v_weekly_source_guard->>'reason' in (
                           'FAMILY_SPLIT_BY_WHITESPACE','BOOKING_REFERENCE_CANONICAL_COLLISION')
                      then 'BOOKING_REFERENCE_CANONICAL_COLLISION'
                    when coalesce((v_weekly_source_guard->>'managed')::boolean, true) and coalesce((v_weekly_source_guard->>'ok')::boolean, true)
                      then 'WEEKLY_SOURCE_MANAGED_ROOT'
                    when coalesce((v_weekly_source_guard->>'managed')::boolean, true)
                      then 'WEEKLY_SOURCE_BOUND_OR_PROTECTED_ROOT_UNRESOLVABLE'
                    when coalesce((v_weekly_source_guard->>'authorisation_record_without_authorised_timesheet')::boolean, false)
                      then 'AUTHORISATION_RECORD_WITHOUT_AUTHORISED_TIMESHEET'
                    else 'PROTECTED_ROOT_AUTHORITY_MISSING' end,
                  'integrity_failure', not coalesce((v_weekly_source_guard->>'ok')::boolean,false),
                  'timesheet_id', v_timesheet_id,
                  'reason', v_weekly_source_guard->>'reason'
                )::text;
      end if;

      -- Guard + rotate current -> history (invoice-lock protected)
      perform public.tsfin_prepare_write(v_timesheet_id);
      did_prepare := true;

      -- ✅ compute expense totals (sum components first; fallback to expenses_* only if sum == 0)
      v_cat_pay :=
          coalesce(nullif(snap->>'travel_pay_ex_vat','')::numeric, prev.travel_pay_ex_vat, 0)
        + coalesce(nullif(snap->>'accommodation_pay_ex_vat','')::numeric, prev.accommodation_pay_ex_vat, 0)
        + coalesce(nullif(snap->>'other_pay_ex_vat','')::numeric, prev.other_pay_ex_vat, 0);

      v_cat_charge :=
          coalesce(nullif(snap->>'travel_charge_ex_vat','')::numeric, prev.travel_charge_ex_vat, 0)
        + coalesce(nullif(snap->>'accommodation_charge_ex_vat','')::numeric, prev.accommodation_charge_ex_vat, 0)
        + coalesce(nullif(snap->>'other_charge_ex_vat','')::numeric, prev.other_charge_ex_vat, 0);

      v_fallback_exp_pay :=
        coalesce(nullif(snap->>'expenses_pay_ex_vat','')::numeric, prev.expenses_pay_ex_vat, 0);

      v_fallback_exp_charge :=
        coalesce(nullif(snap->>'expenses_charge_ex_vat','')::numeric, prev.expenses_charge_ex_vat, 0);

      v_exp_pay :=
        case when coalesce(v_cat_pay, 0) <> 0 then v_cat_pay else v_fallback_exp_pay end;

      v_exp_charge :=
        case when coalesce(v_cat_charge, 0) <> 0 then v_cat_charge else v_fallback_exp_charge end;

      v_exp_pay := round(coalesce(v_exp_pay,0), 2);
      v_exp_charge := round(coalesce(v_exp_charge,0), 2);

      -- ✅ additional + mileage rollup (snap → prev fallback)
      v_add_units_json := coalesce(snap->'additional_units_json', prev.additional_units_json, '{}'::jsonb);

      v_add_pay := coalesce(nullif(snap->>'additional_pay_ex_vat','')::numeric, prev.additional_pay_ex_vat, 0);
      v_add_charge := coalesce(nullif(snap->>'additional_charge_ex_vat','')::numeric, prev.additional_charge_ex_vat, 0);

      v_mil_pay := coalesce(nullif(snap->>'mileage_pay_ex_vat','')::numeric, prev.mileage_pay_ex_vat, 0);
      v_mil_charge := coalesce(nullif(snap->>'mileage_charge_ex_vat','')::numeric, prev.mileage_charge_ex_vat, 0);

      v_add_pay := round(coalesce(v_add_pay,0), 2);
      v_add_charge := round(coalesce(v_add_charge,0), 2);
      v_mil_pay := round(coalesce(v_mil_pay,0), 2);
      v_mil_charge := round(coalesce(v_mil_charge,0), 2);

      -- Non-segment totals (additional + expenses + mileage)
      v_nonseg_pay := round(v_add_pay + v_exp_pay + v_mil_pay, 2);
      v_nonseg_charge := round(v_add_charge + v_exp_charge + v_mil_charge, 2);

      -- ✅ recompute core totals from breakdown (SEGMENTS sums; else base_hours)
      v_core_pay := 0;
      v_core_charge := 0;

      v_mode := upper(coalesce(v_ib->>'mode',''));

      if v_mode = 'SEGMENTS' and jsonb_typeof(v_ib->'segments') = 'array' then
        for v_seg in
          select value from jsonb_array_elements(v_ib->'segments') value
        loop
          if v_seg is null or jsonb_typeof(v_seg) <> 'object' then
            continue;
          end if;

          -- charge sum includes all segments (negative allowed)
          begin
            v_core_charge := v_core_charge
              + coalesce(nullif(btrim(coalesce(v_seg->>'charge_amount','')), '')::numeric, 0);
          exception when others then
            null;
          end;

          -- pay sum respects exclude_from_pay when present/true
          v_exclude := false;
          begin
            v_exclude := coalesce(nullif(btrim(coalesce(v_seg->>'exclude_from_pay','')), '')::boolean, false);
          exception when others then
            v_exclude := false;
          end;

          if not v_exclude then
            begin
              v_core_pay := v_core_pay
                + coalesce(nullif(btrim(coalesce(v_seg->>'pay_amount','')), '')::numeric, 0);
            exception when others then
              null;
            end;
          end if;
        end loop;
      else
        begin
          v_core_pay := coalesce(nullif(btrim(coalesce(v_ib#>>'{base_hours,pay_ex_vat}','')), '')::numeric, 0);
        exception when others then
          v_core_pay := 0;
        end;

        begin
          v_core_charge := coalesce(nullif(btrim(coalesce(v_ib#>>'{base_hours,charge_ex_vat}','')), '')::numeric, 0);
        exception when others then
          v_core_charge := 0;
        end;
      end if;

      v_core_pay := round(coalesce(v_core_pay,0), 2);
      v_core_charge := round(coalesce(v_core_charge,0), 2);

      -- Totals (pay/charge) are pure ex-vat figures (NO ERNI in totals)
      v_total_pay := round(v_core_pay + v_nonseg_pay, 2);
      v_total_charge := round(v_core_charge + v_nonseg_charge, 2);

      -- ✅ ERNI-aware margin:
      -- - ERNI applies ONLY to PAYE candidates
      -- - ERNI uplifts ONLY wage-like pay (core pay + additional pay)
      -- - ERNI NEVER applies to expenses or mileage
      v_policy := coalesce(snap->'policy_snapshot_json', prev.policy_snapshot_json, '{}'::jsonb);
      if v_policy is null or jsonb_typeof(v_policy) <> 'object' then
        v_policy := '{}'::jsonb;
      end if;

      v_apply_to := upper(coalesce(nullif(btrim(coalesce(v_policy->>'apply_erni_to','')), ''), 'PAYE_ONLY'));

      v_erni_pct_raw := 0;
      begin
        v_erni_pct_raw := coalesce(nullif(btrim(coalesce(v_policy->>'erni_pct','')), '')::numeric, 0);
      exception when others then
        v_erni_pct_raw := 0;
      end;

      v_erni_mult := 1;
      if coalesce(v_erni_pct_raw,0) > 0 then
        if v_erni_pct_raw > 1 then
          v_erni_mult := 1 + (v_erni_pct_raw / 100);
        else
          v_erni_mult := 1 + v_erni_pct_raw;
        end if;
      end if;

      v_pay_method_u :=
        upper(
          coalesce(
            nullif(btrim(coalesce(snap->>'pay_method','')), ''),
            nullif(btrim(coalesce(prev.pay_method::text,'')), ''),
            ''
          )
        );

      -- IMPORTANT: PAYE only. apply_erni_to can be ALL/PAYE_ONLY but never makes it apply to non-PAYE.
      v_erni_applies :=
        (v_pay_method_u = 'PAYE')
        and (v_apply_to = 'ALL' or v_apply_to = 'PAYE_ONLY');

      -- overall margin cost:
      v_wage_pay := round(v_core_pay + v_add_pay, 2);         -- wage-like pay only
      v_reimb_pay := round(v_exp_pay + v_mil_pay, 2);         -- reimbursements (never ERNI)

      v_wage_pay_cost := v_wage_pay;
      if v_erni_applies then
        v_wage_pay_cost := round(v_wage_pay * v_erni_mult, 2);
      end if;

      v_pay_cost := round(v_wage_pay_cost + v_reimb_pay, 2);
      v_margin := round(v_total_charge - v_pay_cost, 2);

      -- non-segment contribution margin (apply ERNI only to additional pay; never to expenses/mileage)
      v_nonseg_wage_pay := v_add_pay;
      v_nonseg_reimb_pay := round(v_exp_pay + v_mil_pay, 2);

      v_nonseg_wage_pay_cost := v_nonseg_wage_pay;
      if v_erni_applies then
        v_nonseg_wage_pay_cost := round(v_nonseg_wage_pay * v_erni_mult, 2);
      end if;

      v_nonseg_pay_cost := round(v_nonseg_wage_pay_cost + v_nonseg_reimb_pay, 2);
      v_nonseg_margin := round(v_nonseg_charge - v_nonseg_pay_cost, 2);

      -- ✅ patch invoice_breakdown_json.additional (preserve units if present; else set from stored additional_units_json)
      v_add_obj := case
        when v_ib ? 'additional' and jsonb_typeof(v_ib->'additional') = 'object' then v_ib->'additional'
        else '{}'::jsonb
      end;

      if not (v_add_obj ? 'units') or jsonb_typeof(v_add_obj->'units') <> 'object' then
        if v_add_units_json is null or jsonb_typeof(v_add_units_json) <> 'object' then
          v_add_units_json := '{}'::jsonb;
        end if;
        v_add_obj := jsonb_set(v_add_obj, '{units}', v_add_units_json, true);
      end if;

      -- additional now represents combined non-segment totals (additional + expenses + mileage)
      v_add_obj := jsonb_set(v_add_obj, '{pay_ex_vat}', to_jsonb(v_nonseg_pay), true);
      v_add_obj := jsonb_set(v_add_obj, '{charge_ex_vat}', to_jsonb(v_nonseg_charge), true);
      v_add_obj := jsonb_set(v_add_obj, '{margin_ex_vat}', to_jsonb(v_nonseg_margin), true);

      v_ib := jsonb_set(v_ib, '{additional}', v_add_obj, true);

      -- ✅ patch invoice_breakdown_json.totals to match computed totals (margin includes PAYE-only ERNI on wage pay)
      v_tot_obj := case
        when v_ib ? 'totals' and jsonb_typeof(v_ib->'totals') = 'object' then v_ib->'totals'
        else '{}'::jsonb
      end;

      v_tot_obj := jsonb_set(v_tot_obj, '{total_pay_ex_vat}', to_jsonb(v_total_pay), true);
      v_tot_obj := jsonb_set(v_tot_obj, '{total_charge_ex_vat}', to_jsonb(v_total_charge), true);
      v_tot_obj := jsonb_set(v_tot_obj, '{margin_ex_vat}', to_jsonb(v_margin), true);

      v_ib := jsonb_set(v_ib, '{totals}', v_tot_obj, true);

      -- ✅ stale flag tie-off (clear stale on a successful READY_FOR_INVOICE snapshot)
      v_is_stale := coalesce(nullif(snap->>'is_stale','')::boolean, false);
      v_stale_reason := nullif(snap->>'stale_reason','');

      if v_processing_status = 'READY_FOR_INVOICE'::public.ts_fin_processing_status_enum then
        v_is_stale := false;
        v_stale_reason := null;
      end if;

      -- Insert new current snapshot (explicit columns)
      insert into public.timesheets_financials (
        timesheet_id,
        timesheet_version,
        basis,
        is_current,
        is_stale,
        stale_reason,

        worked_start_iso,
        worked_end_iso,
        break_start_iso,
        break_end_iso,
        break_minutes,

        candidate_id,
        client_id,
        role,
        band,
        pay_method,

        policy_snapshot_json,
        rate_source_refs_json,

        hours_day,
        hours_night,
        hours_sat,
        hours_sun,
        hours_bh,

        pay_day, pay_night, pay_sat, pay_sun, pay_bh,
        charge_day, charge_night, charge_sat, charge_sun, charge_bh,

        total_hours,
        total_pay_ex_vat,
        total_charge_ex_vat,
        margin_ex_vat,

        computed_at_utc,

        occupant_key_norm,
        candidate_assignment,
        processing_status,

        -- Totals + description + legacy evidence pointers
        expenses_pay_ex_vat,
        expenses_charge_ex_vat,
        expenses_description,
        expenses_evidence_r2_key,
        expenses_evidence_manifest,

        -- category expense columns
        travel_pay_ex_vat,
        travel_charge_ex_vat,
        accommodation_pay_ex_vat,
        accommodation_charge_ex_vat,
        other_pay_ex_vat,
        other_charge_ex_vat,

        mileage_pay_ex_vat,
        mileage_charge_ex_vat,
        mileage_units,
        mileage_evidence_r2_key,
        mileage_evidence_manifest,
        mileage_pay_rate,
        mileage_charge_rate,

        po_number,

        pay_on_hold,
        pay_on_hold_reason,
        pay_on_hold_since_utc,

        pay_wtr_rate_pct_snapshot,
        pay_vat_rate_pct_snapshot,
        pay_vat_amount_snapshot,
        pay_total_inc_vat_snapshot,

        payment_reference,
        remittance_last_sent_at_utc,
        remittance_send_count,

        processed_by_user_id,
        processed_at_utc,
        authorised_by_user_id,
        authorised_at_utc,

        additional_units_json,
        additional_pay_ex_vat,
        additional_charge_ex_vat,
        additional_margin_ex_vat,

        invoice_breakdown_json,

        nhsp_import_id,

        has_rate_issue,
        has_pay_channel_issue,

        hr_crosscheck_status,
        hr_crosscheck_issues,

        external_source_rows_json,

        actual_schedule_json,
        actual_minutes_by_day_json
      )
      values (
        v_timesheet_id,
        v_timesheet_version,
        v_basis,
        true,

        v_is_stale,
        v_stale_reason,

        nullif(snap->>'worked_start_iso','')::timestamptz,
        nullif(snap->>'worked_end_iso','')::timestamptz,
        nullif(snap->>'break_start_iso','')::timestamptz,
        nullif(snap->>'break_end_iso','')::timestamptz,
        nullif(snap->>'break_minutes','')::int,

        nullif(snap->>'candidate_id','')::uuid,
        nullif(snap->>'client_id','')::uuid,
        nullif(snap->>'role',''),
        nullif(snap->>'band',''),
        nullif(snap->>'pay_method',''),

        coalesce(snap->'policy_snapshot_json', '{}'::jsonb),
        coalesce(snap->'rate_source_refs_json', '{}'::jsonb),

        coalesce(nullif(snap->>'hours_day','')::numeric, 0),
        coalesce(nullif(snap->>'hours_night','')::numeric, 0),
        coalesce(nullif(snap->>'hours_sat','')::numeric, 0),
        coalesce(nullif(snap->>'hours_sun','')::numeric, 0),
        coalesce(nullif(snap->>'hours_bh','')::numeric, 0),

        nullif(snap->>'pay_day','')::numeric,
        nullif(snap->>'pay_night','')::numeric,
        nullif(snap->>'pay_sat','')::numeric,
        nullif(snap->>'pay_sun','')::numeric,
        nullif(snap->>'pay_bh','')::numeric,

        nullif(snap->>'charge_day','')::numeric,
        nullif(snap->>'charge_night','')::numeric,
        nullif(snap->>'charge_sat','')::numeric,
        nullif(snap->>'charge_sun','')::numeric,
        nullif(snap->>'charge_bh','')::numeric,

        coalesce(nullif(snap->>'total_hours','')::numeric, 0),

        -- totals are computed from core + (additional + expenses + mileage) (NO ERNI in totals)
        coalesce(v_total_pay, 0),
        coalesce(v_total_charge, 0),

        -- margin includes PAYE-only ERNI on wage pay (core + additional), never on expenses/mileage
        coalesce(v_margin, 0),

        now(),

        nullif(snap->>'occupant_key_norm',''),
        v_candidate_assignment,
        v_processing_status,

        -- expenses_pay_ex_vat: rollup (category sum or fallback)
        coalesce(v_exp_pay, 0),

        -- expenses_charge_ex_vat: rollup (category sum or fallback)
        coalesce(v_exp_charge, 0),

        nullif(snap->>'expenses_description',''),
        nullif(snap->>'expenses_evidence_r2_key',''),
        coalesce(snap->'expenses_evidence_manifest', prev.expenses_evidence_manifest),

        -- category columns (preserved from prev if absent in snapshot)
        coalesce(nullif(snap->>'travel_pay_ex_vat','')::numeric, prev.travel_pay_ex_vat, 0),
        coalesce(nullif(snap->>'travel_charge_ex_vat','')::numeric, prev.travel_charge_ex_vat, 0),
        coalesce(nullif(snap->>'accommodation_pay_ex_vat','')::numeric, prev.accommodation_pay_ex_vat, 0),
        coalesce(nullif(snap->>'accommodation_charge_ex_vat','')::numeric, prev.accommodation_charge_ex_vat, 0),
        coalesce(nullif(snap->>'other_pay_ex_vat','')::numeric, prev.other_pay_ex_vat, 0),
        coalesce(nullif(snap->>'other_charge_ex_vat','')::numeric, prev.other_charge_ex_vat, 0),

        -- preserve mileage pay/charge from prev if absent
        coalesce(nullif(snap->>'mileage_pay_ex_vat','')::numeric, prev.mileage_pay_ex_vat, 0),
        coalesce(nullif(snap->>'mileage_charge_ex_vat','')::numeric, prev.mileage_charge_ex_vat, 0),

        coalesce(nullif(snap->>'mileage_units','')::numeric, prev.mileage_units, 0),
        nullif(snap->>'mileage_evidence_r2_key',''),
        coalesce(snap->'mileage_evidence_manifest', prev.mileage_evidence_manifest),
        nullif(snap->>'mileage_pay_rate','')::numeric,
        nullif(snap->>'mileage_charge_rate','')::numeric,

        coalesce(nullif(snap->>'po_number',''), prev.po_number),

        coalesce(nullif(snap->>'pay_on_hold','')::boolean, prev.pay_on_hold, false),
        coalesce(nullif(snap->>'pay_on_hold_reason',''), prev.pay_on_hold_reason),
        coalesce(nullif(snap->>'pay_on_hold_since_utc','')::timestamptz, prev.pay_on_hold_since_utc),

        nullif(snap->>'pay_wtr_rate_pct_snapshot','')::numeric,
        nullif(snap->>'pay_vat_rate_pct_snapshot','')::numeric,
        coalesce(nullif(snap->>'pay_vat_amount_snapshot','')::numeric, 0),
        coalesce(nullif(snap->>'pay_total_inc_vat_snapshot','')::numeric, 0),

        coalesce(nullif(snap->>'payment_reference',''), prev.payment_reference),
        coalesce(nullif(snap->>'remittance_last_sent_at_utc','')::timestamptz, prev.remittance_last_sent_at_utc),
        coalesce(nullif(snap->>'remittance_send_count','')::int, prev.remittance_send_count, 0),

        coalesce(nullif(snap->>'processed_by_user_id','')::uuid, prev.processed_by_user_id),
        coalesce(nullif(snap->>'processed_at_utc','')::timestamptz, prev.processed_at_utc),
        v_result_authorised_by_user_id,
        v_result_authorised_at_utc,

        -- preserve additional units from prev if absent
        coalesce(snap->'additional_units_json', prev.additional_units_json, '{}'::jsonb),

        -- preserve additional pay/charge/margin from prev if absent
        coalesce(nullif(snap->>'additional_pay_ex_vat','')::numeric, prev.additional_pay_ex_vat, 0),
        coalesce(nullif(snap->>'additional_charge_ex_vat','')::numeric, prev.additional_charge_ex_vat, 0),
        coalesce(nullif(snap->>'additional_margin_ex_vat','')::numeric, prev.additional_margin_ex_vat, 0),

        -- patched breakdown (additional + totals updated)
        v_ib,

        nullif(snap->>'nhsp_import_id','')::uuid,

        coalesce(nullif(snap->>'has_rate_issue','')::boolean, false),
        coalesce(nullif(snap->>'has_pay_channel_issue','')::boolean, false),

        coalesce(nullif(snap->>'hr_crosscheck_status',''), prev.hr_crosscheck_status),
        coalesce(
          case
            when snap ? 'hr_crosscheck_issues' and jsonb_typeof(snap->'hr_crosscheck_issues') = 'array'
              then array(select jsonb_array_elements_text(snap->'hr_crosscheck_issues'))
            else null
          end,
          prev.hr_crosscheck_issues
        ),

        coalesce(snap->'external_source_rows_json', prev.external_source_rows_json),

        coalesce(snap->'actual_schedule_json', prev.actual_schedule_json),
        coalesce(snap->'actual_minutes_by_day_json', prev.actual_minutes_by_day_json)
      );

      perform private.weekly_source_agency_financial_write_observe_v1(
        v_timesheet_id,snap,v_outbox_id);

      perform public.tsfin_work_success(v_outbox_id);
      v_ok := v_ok + 1;

      IF COALESCE(v_temp_log_enabled, false) THEN
        v_signature_diag_json := public.timesheet_lifecycle_guard_signature_v1(v_timesheet_id, NULL::uuid, true);
        PERFORM public._temp_diag_log(
          'TSFIN_SIGNATURE_AFTER_SNAPSHOT',
          'TEMP_TIMESHEET_LIFECYCLE',
          v_timesheet_id::text,
          jsonb_strip_nulls(jsonb_build_object(
            'tag', 'TSFIN_SIGNATURE_AFTER_SNAPSHOT',
            'function_name', 'tsfin_write_snapshots_and_complete',
            'outbox_id', v_outbox_id,
            'timesheet_id', v_timesheet_id,
            'signature', NULLIF(BTRIM(COALESCE(v_signature_diag_json ->> 'backend_row_signature', v_signature_diag_json ->> 'row_signature', v_signature_diag_json ->> 'signature', '')), ''),
            'signature_payload', v_signature_diag_json,
            'processing_status', CASE WHEN v_processing_status IS NULL THEN NULL ELSE v_processing_status::text END,
            'previous_financials_id', v_prev_id
          ))
        );
      END IF;

    exception
      when others then
        v_err := sqlerrm;

        -- Restore previous snapshot if we already rotated current->history and insert failed.
        if did_prepare and v_prev_id is not null then
          update public.timesheets_financials
          set is_current = true,
              updated_at = now()
          where id = v_prev_id
            and locked_by_invoice_id is null
            and paid_at_utc is null;
        end if;

        -- If locked, don't retry forever: delete outbox row
        if v_err = 'TSFIN_LOCKED' then
          perform public.tsfin_work_success(v_outbox_id);
          v_ok := v_ok + 1;
        else
          perform public.tsfin_work_fail(v_outbox_id, v_err);
          v_fail := v_fail + 1;

          v_errors := v_errors || jsonb_build_array(
            jsonb_build_object(
              'outbox_id', v_outbox_id::text,
              'timesheet_id', v_timesheet_id::text,
              'error', v_err
            )
          );
        end if;
    end;
  end loop;

  ok_count := v_ok;
  fail_count := v_fail;
  errors := v_errors;
  return next;
end;
$function$;

CREATE OR REPLACE FUNCTION public.timesheets_invalidate_prevalidation_on_change()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO 'public'
AS $function$
declare
  v_tv_status public.validation_status_enum;
  v_tv_pre_validated boolean;
  v_tv_hr_request_id text;
  v_tv_hr_request_source public.reference_source_enum;

  v_changed boolean := false;
  v_agency_main uuid; v_agency_facts jsonb;

  -- DAILY change flags
  v_daily_changed_worked boolean := false;
  v_daily_changed_break boolean := false;
  v_daily_changed_refnum boolean := false;
  v_daily_changed_dayrefs boolean := false;

  -- WEEKLY change flags
  v_weekly_changed_sched boolean := false;
  v_weekly_changed_refnum boolean := false;
  v_weekly_changed_dayrefs boolean := false;
  v_weekly_changed_units_week boolean := false;
  v_weekly_changed_units_per_day boolean := false;

  v_ignore_daily_ref_autoset boolean := false;
begin
  if tg_op <> 'UPDATE' then
    return new;
  end if;

  -- Only apply to current row updates
  if coalesce(new.is_current, false) is not true then
    return new;
  end if;

  -- If the old row was not current, do not invalidate (avoid version-rotation noise)
  if coalesce(old.is_current, false) is not true then
    return new;
  end if;

  -- Load current validation row (if any)
  select
    tv.status,
    coalesce(tv.pre_validated, false),
    tv.hr_request_id,
    tv.hr_request_source
  into
    v_tv_status,
    v_tv_pre_validated,
    v_tv_hr_request_id,
    v_tv_hr_request_source
  from public.timesheet_validations tv
  where tv.timesheet_id = new.timesheet_id
  limit 1;

  if not found then
    return new;
  end if;

  -- Only invalidate when validation was previously "good" OR pre_validated was set
  if not (
    v_tv_pre_validated is true
    or v_tv_status = 'VALIDATION_OK'::public.validation_status_enum
    or v_tv_status = 'OVERRIDDEN'::public.validation_status_enum
  ) then
    return new;
  end if;

  -- ─────────────────────────────────────────────
  -- Determine whether validation-relevant truth changed
  -- ─────────────────────────────────────────────
  if new.sheet_scope = 'DAILY'::public.timesheet_scope_enum then
    v_daily_changed_worked :=
      (new.worked_start_iso is distinct from old.worked_start_iso)
      or (new.worked_end_iso is distinct from old.worked_end_iso);

    v_daily_changed_break :=
      (new.break_start_iso is distinct from old.break_start_iso)
      or (new.break_end_iso is distinct from old.break_end_iso)
      or (new.break_minutes is distinct from old.break_minutes);

    v_daily_changed_refnum :=
      (new.reference_number is distinct from old.reference_number);

    v_daily_changed_dayrefs :=
      (new.day_references_json is distinct from old.day_references_json);

    -- Special-case: DAILY reference_number auto-set to imported HR request id
    -- Do NOT invalidate if the ONLY relevant change is reference_number and it matches the imported hr_request_id.
    if v_daily_changed_refnum is true
       and v_daily_changed_worked is false
       and v_daily_changed_break is false
       and v_daily_changed_dayrefs is false
       and v_tv_hr_request_source = 'IMPORTED'::public.reference_source_enum
       and v_tv_hr_request_id is not null
       and new.reference_number is not distinct from v_tv_hr_request_id
    then
      v_ignore_daily_ref_autoset := true;
    end if;

    v_changed :=
      (v_daily_changed_worked or v_daily_changed_break or v_daily_changed_dayrefs or v_daily_changed_refnum)
      and v_ignore_daily_ref_autoset is false;

  elsif new.sheet_scope = 'WEEKLY'::public.timesheet_scope_enum then
    v_weekly_changed_sched :=
      (new.actual_schedule_json is distinct from old.actual_schedule_json);

    v_weekly_changed_refnum :=
      (new.reference_number is distinct from old.reference_number);

    v_weekly_changed_dayrefs :=
      (new.day_references_json is distinct from old.day_references_json);

    v_weekly_changed_units_week :=
      (new.additional_units_week is distinct from old.additional_units_week);

    v_weekly_changed_units_per_day :=
      (new.additional_units_per_day is distinct from old.additional_units_per_day);

    v_changed :=
      v_weekly_changed_sched
      or v_weekly_changed_refnum
      or v_weekly_changed_dayrefs
      or v_weekly_changed_units_week
      or v_weekly_changed_units_per_day;
  else
    return new;
  end if;

  if v_changed is not true then
    return new;
  end if;

  -- ─────────────────────────────────────────────
  -- Invalidate pre-validation + force re-validation
  -- ─────────────────────────────────────────────
  if private.weekly_source_agency_invoice_check_only_v1(new.timesheet_id) is true then
    select cw.timesheet_id into strict v_agency_main from public.contract_weeks cw
      where cw.contract_id=new.contract_id and cw.week_ending_date=new.week_ending_date
        and coalesce(cw.additional_seq,0)=0 and not cw.is_adjustment;
    v_agency_facts:=private.weekly_source_agency_week_facts_v1(v_agency_main);
    perform public.weekly_source_agency_week_validation_refresh_v1(v_agency_main,(v_agency_facts->>'publication_id')::uuid);
    return new;
  end if;
  update public.timesheet_validations tvu
     set status = 'PENDING'::public.validation_status_enum,
         pre_validated = false,
         validated_at_utc = null,
         reason_code = 'TIMESHEET_CHANGED',
         updated_at = now()
   where tvu.timesheet_id = new.timesheet_id;

  return new;
end;
$function$;

create or replace function public.weekly_source_projection_publish_atomic_v1(
  p_request jsonb
) returns jsonb
language plpgsql volatile security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_actor uuid;
  v_publication_id uuid;
  v_expected_comparison bytea;
  v_expected_issue bytea;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_scope public.weekly_source_report_scopes%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_correction public.weekly_final_source_correction_sessions%rowtype;
  v_scope_version bigint;
  v_scope_upload uuid;
  v_client_id uuid;
  v_comparison_hash bytea;
  v_issue_hash bytea;
  v_fingerprint bytea;
  v_resolution_count integer;
  v_generation integer;
  v_ready_session_version bigint;
  v_signed_fence jsonb; v_prior_publication_i1_context text:=current_setting('cloudtms.weekly_source_publication_i1_context',true);
begin
  if p_request is null or pg_catalog.jsonb_typeof(p_request)<>'object'
     or exists(
       select 1 from pg_catalog.jsonb_object_keys(p_request) key
       where key not in ('actor_user_id','publication_id',
         'expected_comparison_manifest_hash','expected_issue_set_hash')
     ) then
    raise exception 'WEEKLY_SOURCE_PROJECTION_PUBLISH_REQUEST_INVALID' using errcode='22023';
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_publication_id:=(p_request->>'publication_id')::uuid;
  exception when invalid_text_representation then
    raise exception 'WEEKLY_SOURCE_PROJECTION_PUBLISH_REQUEST_INVALID' using errcode='22023';
  end;
  if v_actor is null or v_publication_id is null then
    raise exception 'WEEKLY_SOURCE_PROJECTION_PUBLISH_REQUEST_INVALID' using errcode='22023';
  end if;
  v_expected_comparison:=case
    when nullif(p_request->>'expected_comparison_manifest_hash','') is null then null
    else private.weekly_source_hex32_v1(
      p_request->>'expected_comparison_manifest_hash',
      'WEEKLY_SOURCE_COMPARISON_MANIFEST_HASH_INVALID'
    ) end;
  v_expected_issue:=case
    when nullif(p_request->>'expected_issue_set_hash','') is null then null
    else private.weekly_source_hex32_v1(
      p_request->>'expected_issue_set_hash','WEEKLY_SOURCE_ISSUE_SET_HASH_INVALID'
    ) end;

  select * into v_publication
  from public.weekly_source_projection_publications
  where id=v_publication_id;
  if not found then
    raise exception 'WEEKLY_SOURCE_PUBLICATION_NOT_FOUND' using errcode='22023';
  end if;
  select * into strict v_upload
  from public.weekly_source_uploads where id=v_publication.upload_id;
  select * into strict v_cycle
  from public.weekly_source_cycles where id=v_publication.source_cycle_id;
  select * into strict v_group
  from public.weekly_source_groups where id=v_cycle.source_group_id;
  if v_publication.authority_scope_kind='CYCLE' then
    v_scope_version:=v_cycle.version;
    v_scope_upload:=v_cycle.current_complete_upload_id;
    begin
      v_client_id:=nullif(v_upload.file_metadata_json->>'client_id','')::uuid;
    exception when invalid_text_representation then
      raise exception 'WEEKLY_SOURCE_PROJECTION_SCOPE_INVALID' using errcode='55000';
    end;
  else
    select * into strict v_scope
    from public.weekly_source_report_scopes
    where id=v_publication.report_scope_id;
    v_scope_version:=v_scope.version;
    v_scope_upload:=v_scope.current_complete_upload_id;
    v_client_id:=v_scope.client_id;
  end if;
  perform private.weekly_source_pay_query_admit_v2();
  if v_publication.authority_scope_kind='CYCLE' and v_publication.correction_session_id is null then
    -- Full signed set, including an empty set, captured before any business lock.
    v_signed_fence:=private.weekly_source_publication_signed_family_fence_v1(v_publication.id,null);
    perform set_config('cloudtms.weekly_source_publication_i1_context',jsonb_build_object('schema_version','WEEKLY_SOURCE_PUBLICATION_I1_CONTEXT_V1',
      'publication_id',v_publication.id,'root_ids',v_signed_fence->'signed_root_ids')::text,true);
  end if;
  perform pg_catalog.pg_advisory_xact_lock(
    pg_catalog.hashtextextended(pg_catalog.encode(v_upload.declared_scope_fingerprint,'hex'),73241837)
  );
  -- Retain the native scope advisory before group/cycle to match upload owners.
  -- Signed physical I-1 was acquired above. Binding's group lock is pre-held.
  select * into strict v_group from public.weekly_source_groups where id=v_group.id for update;
  perform 1 from public.weekly_source_cycles where id=v_cycle.id for update;
  if v_publication.authority_scope_kind='SELF_BILL_REPORT_SCOPE' then
    perform private.weekly_source_self_bill_report_seal_assert_v1(v_upload.id);
  end if;
  if v_publication.authority_scope_kind='CYCLE' then
    select * into strict v_cycle
    from public.weekly_source_cycles where id=v_publication.source_cycle_id for update;
    v_scope_version:=v_cycle.version;
    v_scope_upload:=v_cycle.current_complete_upload_id;
  else
    -- Each NHSP Trust publishes independently under its report-scope head.
    select * into strict v_cycle
    from public.weekly_source_cycles where id=v_publication.source_cycle_id;
    select * into strict v_scope
    from public.weekly_source_report_scopes
    where id=v_publication.report_scope_id for update;
    if v_scope.source_cycle_id is distinct from v_cycle.id
       or v_scope.source_group_id is distinct from v_group.id
       or v_scope.environment is distinct from v_group.environment
       or v_scope.agency_id is distinct from v_group.agency_id
       or v_scope.cutoff_at_utc is distinct from v_cycle.cutoff_at_utc then
      raise exception 'WEEKLY_SOURCE_PROJECTION_SCOPE_CHANGED' using errcode='55000';
    end if;
    v_scope_version:=v_scope.version;
    v_scope_upload:=v_scope.current_complete_upload_id;
    v_client_id:=v_scope.client_id;
  end if;
  select * into strict v_publication
  from public.weekly_source_projection_publications
  where id=v_publication_id for update;
  select * into strict v_upload
  from public.weekly_source_uploads where id=v_publication.upload_id;
  if v_signed_fence is not null then
    perform private.weekly_source_publication_signed_family_fence_v1(v_publication.id,v_signed_fence);
  end if;
  if private.weekly_source_scope_fingerprint_v1(
       v_group.environment,v_group.agency_id,v_group.id,v_cycle.id,
       v_publication.report_scope_id,v_client_id
     ) is distinct from v_upload.declared_scope_fingerprint then
    raise exception 'WEEKLY_SOURCE_PROJECTION_SCOPE_CHANGED' using errcode='55000';
  end if;
  perform private.weekly_source_office_authority_v1(
    v_actor,'RECHECK_SOURCE',v_group.id,v_client_id,v_cycle.finalisation_week_ending
  );
  if v_publication.correction_session_id is not null then
    select * into v_correction
    from public.weekly_final_source_correction_sessions
    where id=v_publication.correction_session_id for update;
    if not found
       or v_correction.source_cycle_id is distinct from v_cycle.id
       or v_correction.authority_scope_kind is distinct from v_publication.authority_scope_kind
       or v_correction.report_scope_id is distinct from v_publication.report_scope_id
       or v_correction.replacement_correction_upload_id is distinct from v_upload.id
       or v_correction.actor_user_id is distinct from v_actor
       or v_upload.purpose<>'FINAL_SOURCE_CORRECTION'
       or v_upload.state<>'CORRECTION_READY'
       or v_scope_version<>v_publication.authority_scope_version
       or coalesce(v_scope.current_final_revision_id,v_cycle.current_final_revision_id)
            is distinct from v_correction.expected_current_final_revision_id then
      raise exception 'WEEKLY_SOURCE_CORRECTION_PUBLICATION_STALE' using errcode='40001';
    end if;
    if v_publication.state='CORRECTION_READY' then
      if v_correction.replacement_projection_publication_id is distinct from v_publication.id
         or (v_publication.rebuild_idempotency_key is not null
             and v_publication.ready_session_version is null) then
        raise exception 'WEEKLY_SOURCE_CORRECTION_PUBLICATION_STALE' using errcode='40001';
      end if;
      if (v_expected_comparison is not null
            and v_expected_comparison<>v_publication.comparison_manifest_hash)
         or (v_expected_issue is not null
            and v_expected_issue<>v_publication.issue_set_hash) then
        raise exception 'WEEKLY_SOURCE_PUBLICATION_HASH_MISMATCH' using errcode='40001';
      end if;
      perform private.weekly_source_agency_publication_validation_v1(v_publication.id);
      v_fingerprint:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_PUBLICATION_FINGERPRINT_V1',
        pg_catalog.jsonb_build_object(
          'publication_id',v_publication.id,'upload_id',v_publication.upload_id,
          'authority_scope_version',v_publication.authority_scope_version,
          'comparison_manifest_hash',pg_catalog.encode(v_publication.comparison_manifest_hash,'hex'),
          'issue_set_hash',pg_catalog.encode(v_publication.issue_set_hash,'hex')
        )
      );
      perform set_config('cloudtms.weekly_source_publication_i1_context',coalesce(v_prior_publication_i1_context,''),true);
      return pg_catalog.jsonb_build_object(
        'ok',true,'status','CORRECTION_READY','publication_id',v_publication.id,
        'upload_id',v_publication.upload_id,
        'authority_scope_version',v_publication.authority_scope_version,
        'projection_generation',v_publication.projection_generation,
        'ready_session_version',v_publication.ready_session_version,
        'comparison_manifest_hash',pg_catalog.encode(v_publication.comparison_manifest_hash,'hex'),
        'issue_set_hash',pg_catalog.encode(v_publication.issue_set_hash,'hex'),
        'publication_fingerprint',pg_catalog.encode(v_fingerprint,'hex'),'idempotent',true
      );
    end if;
    if (v_publication.rebuild_idempotency_key is null and (
         v_correction.state<>'READY'
         or v_correction.replacement_projection_publication_id is not null
       ))
       or (v_publication.rebuild_idempotency_key is not null and (
         v_publication.projection_generation is null
         or v_publication.ready_session_version is null
         or v_correction.state<>'REVIEWED'
         or v_correction.version<>v_publication.ready_session_version
         or v_correction.replacement_projection_publication_id is null
         or v_correction.replacement_projection_publication_id=v_publication.id
       )) then
      raise exception 'WEEKLY_SOURCE_CORRECTION_PUBLICATION_STALE' using errcode='40001';
    end if;
  end if;
  if v_publication.state='CURRENT'
      and v_publication.correction_session_id is null
      and v_scope_upload=v_publication.upload_id
      and v_scope_version=v_publication.authority_scope_version then
    if (v_expected_comparison is not null
          and v_expected_comparison<>v_publication.comparison_manifest_hash)
       or (v_expected_issue is not null
          and v_expected_issue<>v_publication.issue_set_hash) then
      raise exception 'WEEKLY_SOURCE_PUBLICATION_HASH_MISMATCH' using errcode='40001';
    end if;
    perform private.weekly_source_agency_publication_validation_v1(v_publication.id);
    v_fingerprint:=private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PUBLICATION_FINGERPRINT_V1',
      pg_catalog.jsonb_build_object(
        'publication_id',v_publication.id,'upload_id',v_publication.upload_id,
        'authority_scope_version',v_publication.authority_scope_version,
        'comparison_manifest_hash',pg_catalog.encode(v_publication.comparison_manifest_hash,'hex'),
        'issue_set_hash',pg_catalog.encode(v_publication.issue_set_hash,'hex')
      )
    );
    perform set_config('cloudtms.weekly_source_publication_i1_context',coalesce(v_prior_publication_i1_context,''),true);
    return pg_catalog.jsonb_build_object(
      'ok',true,'status',v_publication.state,'publication_id',v_publication.id,
      'upload_id',v_publication.upload_id,
      'authority_scope_version',v_publication.authority_scope_version,
      'projection_generation',v_publication.projection_generation,
      'comparison_manifest_hash',pg_catalog.encode(v_publication.comparison_manifest_hash,'hex'),
      'issue_set_hash',pg_catalog.encode(v_publication.issue_set_hash,'hex'),
      'publication_fingerprint',pg_catalog.encode(v_fingerprint,'hex'),'idempotent',true
    );
  end if;
  if v_publication.state not in ('BUILDING','FAILED')
     or v_scope_version<>v_publication.authority_scope_version
     or (v_publication.correction_session_id is null and (
       v_scope_upload is distinct from v_publication.upload_id
       or v_upload.state<>'CURRENT'
     )) then
    if v_publication.state in ('BUILDING','FAILED') then
      update public.weekly_source_projection_publications
      set state='STALE',failure_code='AUTHORITY_SCOPE_CHANGED'
      where id=v_publication.id;
    end if;
    perform set_config('cloudtms.weekly_source_publication_i1_context',coalesce(v_prior_publication_i1_context,''),true);
    return pg_catalog.jsonb_build_object(
      'ok',false,'status','STALE','reason_code','WEEKLY_SOURCE_PUBLICATION_CAS_STALE',
      'publication_id',v_publication.id,'current_upload_id',v_scope_upload,
      'current_authority_scope_version',v_scope_version
    );
  end if;

  if v_publication.authority_scope_version>2147483647
     or coalesce(v_publication.projection_generation,0)>2147483647 then
    raise exception 'WEEKLY_SOURCE_PROJECTION_GENERATION_OVERFLOW' using errcode='22003';
  end if;
  v_generation:=coalesce(
    v_publication.projection_generation,
    v_publication.authority_scope_version::integer
  );
  select pg_catalog.count(*)::integer into v_resolution_count
  from public.weekly_source_row_resolutions resolution
  join public.weekly_source_upload_rows source_row
    on source_row.id=resolution.upload_row_id
  where source_row.upload_id=v_upload.id
    and resolution.generation=v_generation;
  if v_resolution_count<>(select count(*) from public.weekly_source_upload_rows r
       where r.upload_id=v_upload.id and r.row_finalisation_state<>'SOURCE_REPORT_LINE')
     or exists(
       select 1
       from public.weekly_source_upload_rows source_row
       where source_row.upload_id=v_upload.id
         and source_row.row_finalisation_state<>'SOURCE_REPORT_LINE'
         and not exists(
           select 1
            from public.weekly_source_row_resolutions resolution
            where resolution.upload_row_id=source_row.id
              and resolution.generation=v_generation
              and resolution.source_row_fingerprint=source_row.normalised_row_hash
         )
     )
     or (v_publication.projection_generation is null and exists(
        select 1
        from public.weekly_source_row_resolutions resolution
       join public.weekly_source_upload_rows source_row
         on source_row.id=resolution.upload_row_id
        where source_row.upload_id=v_upload.id
          and resolution.generation<>v_generation
     )) then
    raise exception 'WEEKLY_SOURCE_PROJECTION_RESOLUTION_CENSUS_INCOMPLETE'
      using errcode='55000';
  end if;

  v_comparison_hash:=private.weekly_source_projection_comparison_manifest_hash_v1(
    v_publication.id
  );
  v_issue_hash:=private.weekly_source_projection_issue_set_hash_v1(v_publication.id);
  if (v_expected_comparison is not null and v_expected_comparison<>v_comparison_hash)
     or (v_expected_issue is not null and v_expected_issue<>v_issue_hash) then
    update public.weekly_source_projection_publications
    set state='FAILED',failure_code='PUBLICATION_HASH_MISMATCH'
    where id=v_publication.id;
    if v_publication.correction_session_id is not null then
      update public.weekly_final_source_correction_sessions
      set updated_at_utc=pg_catalog.transaction_timestamp()
      where id=v_publication.correction_session_id;
    elsif v_publication.authority_scope_kind='CYCLE' then
      update public.weekly_source_cycles
      set projection_state='FAILED',current_projection_publication_id=null
      where id=v_cycle.id and current_complete_upload_id=v_publication.upload_id
        and version=v_publication.authority_scope_version;
    else
      update public.weekly_source_report_scopes
      set projection_state='FAILED',current_projection_publication_id=null,
          updated_at_utc=pg_catalog.transaction_timestamp()
      where id=v_scope.id and current_complete_upload_id=v_publication.upload_id
        and version=v_publication.authority_scope_version;
    end if;
    perform set_config('cloudtms.weekly_source_publication_i1_context',coalesce(v_prior_publication_i1_context,''),true);
    return pg_catalog.jsonb_build_object(
      'ok',false,'status','FAILED','reason_code','WEEKLY_SOURCE_PUBLICATION_HASH_MISMATCH',
      'publication_id',v_publication.id
    );
  end if;

  v_ready_session_version:=case when v_publication.correction_session_id is null then null
    else v_correction.version+1 end;
  update public.weekly_source_projection_publications
  set comparison_manifest_hash=v_comparison_hash,issue_set_hash=v_issue_hash,
      state=case when v_publication.correction_session_id is null
        then 'CURRENT' else 'CORRECTION_READY' end,
      ready_session_version=v_ready_session_version,
      failure_code=null,published_at_utc=pg_catalog.transaction_timestamp()
  where id=v_publication.id;
  if v_publication.correction_session_id is not null then
    if v_publication.rebuild_idempotency_key is null then
      update public.weekly_final_source_correction_sessions
      set replacement_projection_publication_id=v_publication.id,
          version=version+1,updated_at_utc=pg_catalog.transaction_timestamp()
      where id=v_publication.correction_session_id and state='READY'
        and version=v_correction.version
        and replacement_correction_upload_id=v_publication.upload_id
        and replacement_projection_publication_id is null;
    else
      update public.weekly_final_source_correction_sessions
      set replacement_projection_publication_id=v_publication.id,
          state='READY',review_idempotency_key=null,review_request_hash=null,
          review_result_json=null,review_result_hash=null,
          version=version+1,updated_at_utc=pg_catalog.transaction_timestamp()
      where id=v_publication.correction_session_id and state='REVIEWED'
        and version=v_publication.ready_session_version
        and replacement_correction_upload_id=v_publication.upload_id
        and replacement_projection_publication_id is not null
        and replacement_projection_publication_id<>v_publication.id;
    end if;
    if not found then
      raise exception 'WEEKLY_SOURCE_CORRECTION_PUBLICATION_CAS_LOST' using errcode='40001';
    end if;
  elsif v_publication.authority_scope_kind='CYCLE' then
    update public.weekly_source_cycles
    set projection_state='CURRENT',current_projection_publication_id=v_publication.id
    where id=v_cycle.id and current_complete_upload_id=v_publication.upload_id
      and version=v_publication.authority_scope_version;
  else
    update public.weekly_source_report_scopes
    set projection_state='CURRENT',current_projection_publication_id=v_publication.id,
        updated_at_utc=pg_catalog.transaction_timestamp()
    where id=v_scope.id and current_complete_upload_id=v_publication.upload_id
      and version=v_publication.authority_scope_version;
  end if;
  if not found then
    raise exception 'WEEKLY_SOURCE_PUBLICATION_CAS_LOST' using errcode='40001';
  end if;
  if v_publication.correction_session_id is null and exists (
    select 1 from public.weekly_source_format_profiles profile
    where profile.id=v_upload.source_format_profile_id
      and (profile.profile_code='NHSP_PREFINAL_RELEASED_V1'
        or (v_group.source_family='ROSTER' and profile.profile_code in (
          'HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1','ROSTER_WEEKLY_SUMMARY_ACTUAL_V1')))
  ) and v_publication.authority_scope_kind='CYCLE' then
    -- Recheck already-signed candidate evidence in the same publication
    -- transaction. This writes comparison/query evidence only: no source
    -- financial movement or Timesheet hours are created here.
    perform private.weekly_source_candidate_prefinal_publish_recheck_v1(
      v_actor,v_publication.id
    );
  end if;
  if v_publication.correction_session_id is null then
    perform private.weekly_source_self_bill_report_bind_v1(v_publication.id);
  end if;
  if v_publication.correction_session_id is null and v_publication.authority_scope_kind<>'SELF_BILL_REPORT_SCOPE' then
    perform private.weekly_source_import_outreach_v1(v_publication.id);
  end if;
  perform private.weekly_source_agency_publication_validation_v1(v_publication.id);
  v_fingerprint:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_PUBLICATION_FINGERPRINT_V1',
    pg_catalog.jsonb_build_object(
      'publication_id',v_publication.id,'upload_id',v_publication.upload_id,
      'authority_scope_version',v_publication.authority_scope_version,
      'comparison_manifest_hash',pg_catalog.encode(v_comparison_hash,'hex'),
      'issue_set_hash',pg_catalog.encode(v_issue_hash,'hex')
    )
  );
  perform set_config('cloudtms.weekly_source_publication_i1_context',coalesce(v_prior_publication_i1_context,''),true);
  return pg_catalog.jsonb_build_object(
    'ok',true,'status',case when v_publication.correction_session_id is null
      then 'CURRENT' else 'CORRECTION_READY' end,
    'publication_id',v_publication.id,
    'upload_id',v_publication.upload_id,
    'authority_scope_version',v_publication.authority_scope_version,
    'projection_generation',v_publication.projection_generation,
    'ready_session_version',v_ready_session_version,
    'comparison_manifest_hash',pg_catalog.encode(v_comparison_hash,'hex'),
    'issue_set_hash',pg_catalog.encode(v_issue_hash,'hex'),
    'publication_fingerprint',pg_catalog.encode(v_fingerprint,'hex'),
    'idempotent',false
  );
exception when others then
  perform set_config('cloudtms.weekly_source_publication_i1_context',coalesce(v_prior_publication_i1_context,''),true);
  raise;
end;
$function$;

create or replace function public.invoice_issue_one(
  p_invoice_id uuid,
  p_actor_user_id uuid
)
returns table (
  status text,
  issued_at_utc timestamptz,
  on_hold_reason text,
  reasons text[]
)
language plpgsql
security definer
set search_path = public
as $$
declare
  v_now timestamptz := now();
  v_anchor_ymd date := (now() at time zone 'Europe/London')::date;

  v_terms_days int := null;
  v_due_at timestamptz := null;
  v_hdr jsonb := null;
  v_client_id uuid := null;

  v_group_nightsat_sunbh boolean := null;

  v_ts_ids uuid[];
  v_worked_ts_ids uuid[];

  v_reasons text[] := array[]::text[];
  v_precheck_reasons text[] := array[]::text[];
  v_hr_reasons text[] := array[]::text[];
  v_issue_ref_reasons text[] := array[]::text[];

  v_on_hold_reason text := null;

  -- ref-to-issue flag (effective: contract override aware via v_ts_invoice_precheck)
  v_ref_required_to_issue boolean := false;

  -- Weekly Source Plan 6.2, Gate 7 item G7-3 (24 section 11, 25 section 4).
  -- The verdict of the one source-aware issue validator, fetched once below.
  -- {"is_source_invoice": false} for every ordinary invoice.
  v_weekly_source_issue jsonb := null;

  v_agency_issue_codes text[]:=array[]::text[];

  -- ======================================================
  -- DEBUG (optional): single audit row per RPC call
  -- ======================================================
  v_invoice_debug boolean := false;
  v_dbg_started timestamptz := now();
  v_dbg_steps jsonb := '[]'::jsonb;
  v_dbg_ts jsonb := '[]'::jsonb;

  -- ======================================================
  -- PDF invalidation helpers (optional columns; dynamic update)
  -- ======================================================
  v_has_updated_at boolean := false;
  v_has_pdf_fresh boolean := false;

begin
  -- Load invoice_debug flag (safe even if column not yet present)
  begin
    select coalesce(sd.invoice_debug, false)
    into v_invoice_debug
    from public.settings_defaults sd
    where sd.id = 1
    limit 1;
  exception when undefined_column then
    v_invoice_debug := false;
  end;

  v_dbg_steps := v_dbg_steps || jsonb_build_array(jsonb_build_object(
    'step','start',
    'now_utc', public._inv_iso_utc(v_now),
    'anchor_ymd', v_anchor_ymd::text,
    'invoice_id', case when p_invoice_id is null then null else p_invoice_id::text end
  ));

  if p_invoice_id is null then
    raise exception 'invoice_id is required';
  end if;

  -- Weekly Source Plan 6.2, Gate 7 item G7-3: ONE early call into the
  -- source-aware issue validator.  For every ordinary invoice this returns
  -- {"is_source_invoice": false} and everything below runs exactly as before.
  v_weekly_source_issue := private.weekly_source_invoice_issue_validate_v1(p_invoice_id);

  -- 25 section 4 Removed, bullet 3: an admitted Weekly final-source self-bill
  -- is not judged by the ordinary correction-unit family.  Its own movement
  -- allocation has just been proved above; a source invoice that failed that
  -- proof keeps every ordinary control and is blocked below.
  if not coalesce(
       (v_weekly_source_issue->>'is_source_invoice')::boolean and
       (v_weekly_source_issue->>'ok')::boolean, false) then
    perform public._ctms_assert_invoice_correction_lines_v1(
      p_invoice_id,p_actor_user_id,true,'INVOICE_ISSUE'
    );
  end if;

  -- Detect optional invoice columns used to invalidate invoice PDF freshness on ISSUE
  begin
    select exists(
      select 1
      from information_schema.columns c
      where c.table_schema = 'public'
        and c.table_name = 'invoices'
        and c.column_name = 'updated_at'
    )
    into v_has_updated_at;

    select exists(
      select 1
      from information_schema.columns c
      where c.table_schema = 'public'
        and c.table_name = 'invoices'
        and c.column_name = 'pdf_fresh'
    )
    into v_has_pdf_fresh;
  exception when others then
    v_has_updated_at := false;
    v_has_pdf_fresh := false;
  end;

  -- Load invoice + basic guards
  declare
    v_inv record;
  begin
    select *
    into v_inv
    from public.invoices
    where id = p_invoice_id;

    if not found then
      raise exception 'Invoice not found';
    end if;

    if v_inv.type::text = 'CREDIT_NOTE' then
      raise exception 'Cannot issue a CREDIT_NOTE';
    end if;

    if v_inv.status::text = 'PAID' then
      raise exception 'Cannot issue a PAID invoice';
    end if;

    if v_inv.status::text = 'ISSUED' then
      status := 'ISSUED';
      issued_at_utc := v_inv.issued_at_utc;
      on_hold_reason := v_inv.on_hold_reason;
      reasons := array[]::text[];

      if v_invoice_debug then
        begin
          perform public._inv_write_audit(
            p_actor_user_id,
            'INVOICE_ISSUE_DEBUG',
            jsonb_build_object(
              'result','ALREADY_ISSUED',
              'invoice_id', p_invoice_id::text,
              'status', v_inv.status::text,
              'issued_at_utc', to_jsonb(v_inv.issued_at_utc),
              'steps', v_dbg_steps
            ),
            'invoices',
            p_invoice_id::text,
            null,
            'INVOICE_DEBUG',
            null, null, null
          );
        exception when others then
          null;
        end;
      end if;

      return next;
      return;
    end if;

    -- ✅ HARD BLOCK:
    -- If invoice is currently ON_HOLD, do not re-evaluate blockers; require UNHOLD first.
    if v_inv.status::text = 'ON_HOLD' then
      status := 'ON_HOLD';
      issued_at_utc := null;
      on_hold_reason := 'Unhold first';
      reasons := array['Unhold first']::text[];
      return next;
      return;
    end if;

    if v_inv.status::text not in ('DRAFT','ON_HOLD') then
      raise exception 'Only DRAFT/ON_HOLD invoices can be issued (current status=%)', v_inv.status::text;
    end if;
  end;

  -- Invoice client_id (used for settings lookup and header snapshot)
  select i.client_id
  into v_client_id
  from public.invoices i
  where i.id = p_invoice_id
  limit 1;

  -- Timesheets on invoice
  select array_agg(distinct l.timesheet_id)
  into v_ts_ids
  from public.invoice_lines l
  where l.invoice_id = p_invoice_id
    and l.timesheet_id is not null;

  if v_ts_ids is null or coalesce(array_length(v_ts_ids, 1), 0) = 0 then
    raise exception 'Invoice has no timesheets to validate';
  end if;

  -- Timesheets that have WORKED content on this invoice (hours/additional only)
  select array_agg(distinct l.timesheet_id)
  into v_worked_ts_ids
  from public.invoice_lines l
  where l.invoice_id = p_invoice_id
    and l.timesheet_id is not null
    and upper(coalesce(l.meta_json->>'line_type','')) in (
      'HOURS_DAILY','HOURS_WEEKLY','ADDITIONAL_RATE','ADDITIONAL_RATE_DAILY'
    );

  v_dbg_steps := v_dbg_steps || jsonb_build_array(jsonb_build_object(
    'step','collected_timesheets',
    'timesheet_count', coalesce(array_length(v_ts_ids,1),0),
    'worked_timesheet_count', coalesce(array_length(v_worked_ts_ids,1),0)
  ));

  -- ✅ Determine whether ref-to-issue is enabled for THIS invoice (contract override aware)
  -- We treat this as: any worked timesheet on the invoice has reference_number_required_to_issue_invoice = true
  begin
    select coalesce(bool_or(coalesce(pc.reference_number_required_to_issue_invoice,false)), false)
    into v_ref_required_to_issue
    from unnest(coalesce(v_worked_ts_ids, array[]::uuid[])) as x(timesheet_id)
    left join public.v_ts_invoice_precheck pc
      on pc.timesheet_id = x.timesheet_id;
  exception when others then
    v_ref_required_to_issue := false;
  end;

  v_dbg_steps := v_dbg_steps || jsonb_build_array(jsonb_build_object(
    'step','computed_issue_ref_policy',
    'reference_number_required_to_issue_invoice', v_ref_required_to_issue
  ));

  -- ------------------------------------------------------------
  -- 1) Precheck blockers (authoritative: PDF/reference/evidence)
  -- ------------------------------------------------------------
  select array_agg(
    case
      when pc.timesheet_id is null
        then 'TS ' || x.timesheet_id::text || ': precheck missing'

      when upper(coalesce(pc.precheck_status,'')) = 'OK'
        then null

      when upper(coalesce(pc.precheck_status,'')) = 'BLOCK_NO_REFERENCE'
        then 'TS ' || pc.timesheet_id::text || ': missing reference/PO'

      when upper(coalesce(pc.precheck_status,'')) = 'BLOCK_NO_PDF'
        then 'TS ' || pc.timesheet_id::text || ': missing timesheet PDF'

      when upper(coalesce(pc.precheck_status,'')) = 'BLOCK_NO_MILEAGE_EVIDENCE'
        then 'TS ' || pc.timesheet_id::text || ': missing mileage evidence'

      when upper(coalesce(pc.precheck_status,'')) = 'BLOCK_NO_EXPENSES_EVIDENCE'
        then 'TS ' || pc.timesheet_id::text || ': missing expenses evidence'

      else
        'TS ' || pc.timesheet_id::text || ': precheck blocker ' || upper(coalesce(pc.precheck_status,''))
    end
  )
  into v_precheck_reasons
  from unnest(v_ts_ids) as x(timesheet_id)
  left join public.v_ts_invoice_precheck pc
    on pc.timesheet_id = x.timesheet_id;

  v_precheck_reasons := array_remove(v_precheck_reasons, null);

  -- ------------------------------------------------------------
  -- 2) OPTIONAL HARDENING: HR validation blockers
  -- ------------------------------------------------------------
  select array_agg(
    case
      when s.timesheet_id is null
        then 'TS ' || x.timesheet_id::text || ': summary missing'

      when coalesce(s.hr_validation_required_for_invoice, false) = true
        and (
          s.validation_status is null
          or s.validation_status <> all (array[
            'VALIDATION_OK'::public.validation_status_enum,
            'OVERRIDDEN'::public.validation_status_enum
          ])
        )
        then 'TS ' || x.timesheet_id::text || ': HR validation not passed'

      else null
    end
  )
  into v_hr_reasons
  from unnest(v_ts_ids) as x(timesheet_id)
  left join public.v_timesheets_summary_base s
    on s.timesheet_id = x.timesheet_id;

  v_hr_reasons := array_remove(v_hr_reasons, null);

  -- ------------------------------------------------------------
  -- 3) ISSUE-TIME reference gating (contract override aware, per-timesheet)
  -- ------------------------------------------------------------

  -- 3) ISSUE-TIME reference gating (scoped to this invoice)
  -- Only segments locked to THIS invoice can block issuing (so other-invoice segments never block).
  select array_agg(
    case
      when t.timesheet_id is null then null
      when t.issue_missing_count > 0
        then 'TS '||t.timesheet_id::text||': missing reference/PO for '||t.issue_missing_count::text||' shift(s) (required to issue)'
      else null
    end
  )
  into v_issue_ref_reasons
  from (
    select
      x.timesheet_id,
      case
        when coalesce(pc.reference_number_required_to_issue_invoice,false) is not true then 0

        when tf.invoice_breakdown_json is not null
          and jsonb_typeof(tf.invoice_breakdown_json) = 'object'
          and upper(coalesce(tf.invoice_breakdown_json->>'mode','')) = 'SEGMENTS'
          and jsonb_typeof(tf.invoice_breakdown_json->'segments') = 'array'
        then (
          select count(*)::int
          from jsonb_array_elements(tf.invoice_breakdown_json->'segments') as s(seg)
          where nullif(btrim(coalesce(s.seg->>'invoice_locked_invoice_id','')), '') = p_invoice_id::text
            and (
              (
                (case when coalesce(s.seg->>'hours_day','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (s.seg->>'hours_day')::numeric else 0 end)
              + (case when coalesce(s.seg->>'hours_night','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (s.seg->>'hours_night')::numeric else 0 end)
              + (case when coalesce(s.seg->>'hours_sat','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (s.seg->>'hours_sat')::numeric else 0 end)
              + (case when coalesce(s.seg->>'hours_sun','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (s.seg->>'hours_sun')::numeric else 0 end)
              + (case when coalesce(s.seg->>'hours_bh','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (s.seg->>'hours_bh')::numeric else 0 end)
              ) > 0
              or (case when coalesce(s.seg->>'charge_amount','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (s.seg->>'charge_amount')::numeric else 0 end) > 0
            )
            and nullif(btrim(coalesce(s.seg->>'ref_num','')), '') is null
        )

        else (
          case
            when public._inv_timesheet_has_invoice_reference(
              ts.sheet_scope::text,
              coalesce(ts.submission_mode::text,''),
              ts.reference_number,
              ts.day_references_json,
              ts.actual_schedule_json
            )
            then 0 else 1 end
        )
      end as issue_missing_count
    from unnest(coalesce(v_worked_ts_ids, array[]::uuid[])) as x(timesheet_id)
    left join public.v_ts_invoice_precheck pc
      on pc.timesheet_id = x.timesheet_id
    left join public.timesheets ts
      on ts.timesheet_id = x.timesheet_id
     and ts.is_current = true
    left join public.timesheets_financials tf
      on tf.timesheet_id = x.timesheet_id
     and tf.is_current = true
  ) t;

  v_issue_ref_reasons := array_remove(v_issue_ref_reasons, null);

  -- Merge blockers
  v_reasons := array_cat(v_precheck_reasons, v_hr_reasons);
  v_reasons := array_cat(v_reasons, v_issue_ref_reasons);
  v_reasons := array_remove(v_reasons, null);

  -- Weekly Source Plan 6.2, Gate 7 item G7-3 (24 section 11).  Ordinary
  -- invoice: returns v_reasons unchanged.  Admitted source self-bill: drops
  -- only the four irrelevant ordinary evidence categories.  Failing source
  -- invoice: keeps every ordinary reason and adds the source refusals.
  v_reasons := private.weekly_source_invoice_issue_reasons_v1(
    v_weekly_source_issue, v_reasons
  );
  select coalesce(array_agg(code order by code),array[]::text[]) into v_agency_issue_codes
  from private._invoice_issue_validate_batch(jsonb_build_array(jsonb_build_object(
    'request_key',p_invoice_id::text,'invoice_id',p_invoice_id,
    'expected_revision',(select i.document_revision from public.invoices i where i.id=p_invoice_id),
    'allow_early',true,'deliver',false)),v_anchor_ymd) native_issue
  cross join lateral jsonb_array_elements_text(native_issue.hard_blocker_codes) code
  where code in ('HEALTHROSTER_VALIDATION_REQUIRED','AGENCY_INVOICE_CREDIT_NOTE_NOT_ISSUED','HEALTHROSTER_EVIDENCE_MISSING');
  v_reasons:=array_cat(v_reasons,v_agency_issue_codes);

  -- Debug per-timesheet snapshot (only if enabled)
  if v_invoice_debug then
    begin
      select coalesce(jsonb_agg(
        jsonb_build_object(
          'timesheet_id', x.timesheet_id::text,
          'has_worked_lines', (v_worked_ts_ids is not null and x.timesheet_id = any(v_worked_ts_ids)),
          'precheck_status', coalesce(pc.precheck_status,'')::text,
          'ref_required_to_issue_effective', coalesce(pc.reference_number_required_to_issue_invoice,false),
          'issue_missing_reference_on_invoice', ((
            case
              when x.has_worked_lines is not true then 0
              when coalesce(pc.reference_number_required_to_issue_invoice,false) is not true then 0

              when s.invoice_breakdown_json is not null
                and jsonb_typeof(s.invoice_breakdown_json) = 'object'
                and upper(coalesce(s.invoice_breakdown_json->>'mode','')) = 'SEGMENTS'
                and jsonb_typeof(s.invoice_breakdown_json->'segments') = 'array'
              then coalesce((
                select count(*)::int
                from jsonb_array_elements(s.invoice_breakdown_json->'segments') as sg(seg)
                where nullif(btrim(coalesce(sg.seg->>'invoice_locked_invoice_id','')), '') = p_invoice_id::text
                  and (
                    (
                      (case when coalesce(sg.seg->>'hours_day','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (sg.seg->>'hours_day')::numeric else 0 end)
                    + (case when coalesce(sg.seg->>'hours_night','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (sg.seg->>'hours_night')::numeric else 0 end)
                    + (case when coalesce(sg.seg->>'hours_sat','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (sg.seg->>'hours_sat')::numeric else 0 end)
                    + (case when coalesce(sg.seg->>'hours_sun','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (sg.seg->>'hours_sun')::numeric else 0 end)
                    + (case when coalesce(sg.seg->>'hours_bh','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (sg.seg->>'hours_bh')::numeric else 0 end)
                    ) > 0
                    or (case when coalesce(sg.seg->>'charge_amount','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (sg.seg->>'charge_amount')::numeric else 0 end) > 0
                  )
                  and nullif(btrim(coalesce(sg.seg->>'ref_num','')), '') is null
              ),0)

              else (
                case
                  when public._inv_timesheet_has_invoice_reference(
                    t0.sheet_scope::text,
                    coalesce(t0.submission_mode::text,''),
                    t0.reference_number,
                    t0.day_references_json,
                    t0.actual_schedule_json
                  ) then 0 else 1 end
              )
            end
          ) > 0),
          'issue_missing_reference_on_invoice_count', (
            case
              when x.has_worked_lines is not true then 0
              when coalesce(pc.reference_number_required_to_issue_invoice,false) is not true then 0

              when s.invoice_breakdown_json is not null
                and jsonb_typeof(s.invoice_breakdown_json) = 'object'
                and upper(coalesce(s.invoice_breakdown_json->>'mode','')) = 'SEGMENTS'
                and jsonb_typeof(s.invoice_breakdown_json->'segments') = 'array'
              then coalesce((
                select count(*)::int
                from jsonb_array_elements(s.invoice_breakdown_json->'segments') as sg(seg)
                where nullif(btrim(coalesce(sg.seg->>'invoice_locked_invoice_id','')), '') = p_invoice_id::text
                  and (
                    (
                      (case when coalesce(sg.seg->>'hours_day','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (sg.seg->>'hours_day')::numeric else 0 end)
                    + (case when coalesce(sg.seg->>'hours_night','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (sg.seg->>'hours_night')::numeric else 0 end)
                    + (case when coalesce(sg.seg->>'hours_sat','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (sg.seg->>'hours_sat')::numeric else 0 end)
                    + (case when coalesce(sg.seg->>'hours_sun','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (sg.seg->>'hours_sun')::numeric else 0 end)
                    + (case when coalesce(sg.seg->>'hours_bh','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (sg.seg->>'hours_bh')::numeric else 0 end)
                    ) > 0
                    or (case when coalesce(sg.seg->>'charge_amount','') ~ '^[-]?[0-9]+(\.[0-9]+)?$' then (sg.seg->>'charge_amount')::numeric else 0 end) > 0
                  )
                  and nullif(btrim(coalesce(sg.seg->>'ref_num','')), '') is null
              ),0)

              else (
                case
                  when public._inv_timesheet_has_invoice_reference(
                    t0.sheet_scope::text,
                    coalesce(t0.submission_mode::text,''),
                    t0.reference_number,
                    t0.day_references_json,
                    t0.actual_schedule_json
                  ) then 0 else 1 end
              )
            end
          ),
          'hr_required', coalesce(s.hr_validation_required_for_invoice,false),
          'validation_status', case when s.validation_status is null then null else s.validation_status::text end
        )
      ), '[]'::jsonb)
      into v_dbg_ts
      from unnest(v_ts_ids) as x(timesheet_id)
      left join public.v_ts_invoice_precheck pc on pc.timesheet_id = x.timesheet_id
      left join public.v_timesheets_summary_base s on s.timesheet_id = x.timesheet_id;
    exception when others then
      v_dbg_ts := '[]'::jsonb;
    end;
  end if;

  v_dbg_steps := v_dbg_steps || jsonb_build_array(jsonb_build_object(
    'step','computed_blockers',
    'precheck_reasons_count', coalesce(array_length(v_precheck_reasons,1),0),
    'hr_reasons_count', coalesce(array_length(v_hr_reasons,1),0),
    'issue_ref_reasons_count', coalesce(array_length(v_issue_ref_reasons,1),0),
    'total_reasons_count', coalesce(array_length(v_reasons,1),0)
  ));

  -- Any blockers => ON_HOLD
  if coalesce(array_length(v_reasons, 1), 0) > 0 then
    v_on_hold_reason := array_to_string(v_reasons, '; ');

    update public.invoices
    set status = 'ON_HOLD'::public.invoice_status_enum,
        status_date_utc = v_now,
        issued_at_utc = null,
        on_hold_reason = v_on_hold_reason
    where id = p_invoice_id;

    perform public._audit_insert(
      'invoice',
      p_invoice_id::text,
      'INVOICE_ON_HOLD',
      null,
      jsonb_build_object('reasons', v_reasons),
      null,
      p_actor_user_id
    );

    status := 'ON_HOLD';
    issued_at_utc := null;
    on_hold_reason := v_on_hold_reason;
    reasons := v_reasons;

    if v_invoice_debug then
      begin
        perform public._inv_write_audit(
          p_actor_user_id,
          'INVOICE_ISSUE_DEBUG',
          jsonb_build_object(
            'result','ON_HOLD',
            'invoice_id', p_invoice_id::text,
            'client_id', case when v_client_id is null then null else v_client_id::text end,
            'reference_number_required_to_issue_invoice', v_ref_required_to_issue,
            'timesheet_ids', to_jsonb(coalesce(v_ts_ids, array[]::uuid[])),
            'worked_timesheet_ids', to_jsonb(coalesce(v_worked_ts_ids, array[]::uuid[])),
            'reasons', to_jsonb(coalesce(v_reasons, array[]::text[])),
            'timesheets_debug', v_dbg_ts,
            'steps', v_dbg_steps,
            'run_started_at_utc', public._inv_iso_utc(v_dbg_started),
            'run_finished_at_utc', public._inv_iso_utc(now())
          ),
          'invoices',
          p_invoice_id::text,
          null,
          'INVOICE_DEBUG',
          null, null, null
        );
      exception when others then
        null;
      end;
    end if;

    return next;
    return;
  end if;

  -- ------------------------------------------------------------
  -- No blockers => issue
  -- ------------------------------------------------------------
  select i.client_id, i.header_snapshot_json
  into v_client_id, v_hdr
  from public.invoices i
  where i.id = p_invoice_id;

  if v_hdr is null or jsonb_typeof(v_hdr) <> 'object' then
    v_hdr := '{}'::jsonb;
  end if;

  if not (v_hdr ? 'group_nightsat_sunbh') then
    select cs0.group_nightsat_sunbh
    into v_group_nightsat_sunbh
    from public.client_settings cs0
    where cs0.client_id = v_client_id
      and (cs0.effective_from <= v_anchor_ymd or cs0.effective_from is null)
    order by cs0.effective_from desc nulls last
    limit 1;

    v_hdr := v_hdr || jsonb_build_object('group_nightsat_sunbh', coalesce(v_group_nightsat_sunbh, false));
  end if;

  begin
    if (v_hdr ? 'payment_terms_days') then
      v_terms_days := (v_hdr->>'payment_terms_days')::int;
    end if;
  exception when others then
    v_terms_days := null;
  end;

  if v_terms_days is null then
    begin
      select c.payment_terms_days
      into v_terms_days
      from public.clients c
      where c.id = v_client_id;
    exception when others then
      v_terms_days := null;
    end;
  end if;

  v_terms_days := coalesce(v_terms_days, 30);
  v_due_at := v_now + make_interval(days => v_terms_days);

  update public.invoices
  set status = 'ISSUED'::public.invoice_status_enum,
      status_date_utc = v_now,
      issued_at_utc = v_now,
      due_at_utc = v_due_at,
      on_hold_reason = null,
      header_snapshot_json = v_hdr
  where id = p_invoice_id;

  -- ✅ FIX: invalidate invoice PDF freshness on ISSUE so invpdf regeneration will occur
  -- (uses optional columns if present; never fails function creation)
  begin
    if v_has_updated_at then
      execute 'update public.invoices set updated_at = $1 where id = $2'
      using v_now, p_invoice_id;
    end if;

    if v_has_pdf_fresh then
      execute 'update public.invoices set pdf_fresh = false where id = $1'
      using p_invoice_id;
    end if;
  exception when others then
    null;
  end;

  perform public._audit_insert(
    'invoice',
    p_invoice_id::text,
    'INVOICE_ISSUED',
    null,
    '{}'::jsonb,
    null,
    p_actor_user_id
  );

  -- Only after this owner's actual new ISSUE update and real native audit.
  perform private.weekly_source_agency_issue_close_v1(p_invoice_id);

  status := 'ISSUED';
  issued_at_utc := v_now;
  on_hold_reason := null;
  reasons := array[]::text[];

  if v_invoice_debug then
    begin
      perform public._inv_write_audit(
        p_actor_user_id,
        'INVOICE_ISSUE_DEBUG',
        jsonb_build_object(
          'result','ISSUED',
          'invoice_id', p_invoice_id::text,
          'client_id', case when v_client_id is null then null else v_client_id::text end,
          'reference_number_required_to_issue_invoice', v_ref_required_to_issue,
          'timesheet_ids', to_jsonb(coalesce(v_ts_ids, array[]::uuid[])),
          'worked_timesheet_ids', to_jsonb(coalesce(v_worked_ts_ids, array[]::uuid[])),
          'timesheets_debug', v_dbg_ts,
          'steps', v_dbg_steps,
          'run_started_at_utc', public._inv_iso_utc(v_dbg_started),
          'run_finished_at_utc', public._inv_iso_utc(now())
        ),
        'invoices',
        p_invoice_id::text,
        null,
        'INVOICE_DEBUG',
        null, null, null
      );
    exception when others then
      null;
    end;
  end if;

  return next;

exception when others then
  if v_invoice_debug then
    begin
      perform public._inv_write_audit(
        p_actor_user_id,
        'INVOICE_ISSUE_DEBUG',
        jsonb_build_object(
          'result','ERROR',
          'invoice_id', case when p_invoice_id is null then null else p_invoice_id::text end,
          'client_id', case when v_client_id is null then null else v_client_id::text end,
          'reference_number_required_to_issue_invoice', v_ref_required_to_issue,
          'sqlstate', sqlstate,
          'error', sqlerrm,
          'timesheet_ids', to_jsonb(coalesce(v_ts_ids, array[]::uuid[])),
          'worked_timesheet_ids', to_jsonb(coalesce(v_worked_ts_ids, array[]::uuid[])),
          'timesheets_debug', v_dbg_ts,
          'steps', v_dbg_steps,
          'run_started_at_utc', public._inv_iso_utc(v_dbg_started),
          'run_finished_at_utc', public._inv_iso_utc(now())
        ),
        'invoices',
        case when p_invoice_id is null then null else p_invoice_id::text end,
        null,
        'INVOICE_DEBUG',
        null, null, null
      );
    exception when others then
      null;
    end;
  end if;
  raise;
end;
$$;

create or replace function private._invoice_issue_advance_core_v8(
  p_claims jsonb,
  p_now_utc timestamptz
) returns jsonb
language plpgsql
security definer
set search_path to 'public','private','extensions','pg_temp'
as $function$
declare
  v_now timestamptz:=coalesce(p_now_utc,now());
  v_result jsonb:='[]'::jsonb;
  v_part jsonb;
  v_agency_issued_ids uuid[];
  v_agency_invoice_id uuid;
begin
  if p_claims is null or jsonb_typeof(p_claims) is distinct from 'array' then
    raise exception using errcode='22023',
      message='p_claims must be a JSON array containing 1..100 claims';
  end if;
  if jsonb_array_length(p_claims) < 1 or jsonb_array_length(p_claims) > 100 then
    raise exception using errcode='22023',
      message='p_claims must be a JSON array containing 1..100 claims';
  end if;

  -- VALIDATE preserves stable issue blocker codes and makes no legal transition.
  with ids as materialized (
    select case when coalesce(x->>'chunk_id','')~
      '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
      then (x->>'chunk_id')::uuid end chunk_id
    from jsonb_array_elements(p_claims) x
    where x->>'phase'='VALIDATE'
  ),
  requests as materialized (
    select c.id chunk_id,c.operation_id,c.entity_id invoice_id,
      case when pg_input_is_valid(
          nullif(c.payload_json->>'evaluation_date',''),'date')
        then(c.payload_json->>'evaluation_date')::date end
        evaluation_date,
      jsonb_build_object(
        'request_key',c.id::text,
        'invoice_id',c.entity_id,
        'operation_id',c.operation_id,
        'expected_revision',case
          when coalesce(c.payload_json->>'source_revision','')~'^[0-9]+$'
            then to_jsonb((c.payload_json->>'source_revision')::bigint)
          else c.payload_json->'source_revision'
        end,
        'allow_early',coalesce(c.payload_json->'allow_early','false'::jsonb),
        'deliver',coalesce(c.payload_json->'deliver','false'::jsonb),
        'recipient_set',coalesce(c.payload_json#>'{delivery_intent,recipient_set}',
          '[]'::jsonb),
        'cc',coalesce(c.payload_json#>'{delivery_intent,cc}','[]'::jsonb),
        'bcc',coalesce(c.payload_json#>'{delivery_intent,bcc}','[]'::jsonb)
      ) request_json
    from ids x
    join public.invoice_operation_chunks c on c.id=x.chunk_id
  ),
  validation_groups as materialized (
    select r.evaluation_date,
      jsonb_agg(r.request_json order by r.chunk_id) request_json
    from requests r
    group by r.evaluation_date
  ),
  shared_validation as materialized (
    select v.*
    from validation_groups g
    cross join lateral private._invoice_issue_validate_batch(
      g.request_json,g.evaluation_date) v
  ),
  eval as materialized (
    select r.chunk_id,r.operation_id,r.invoice_id,
      array(select jsonb_array_elements_text(
        coalesce(v.hard_blocker_codes,'[]'::jsonb))) blockers
    from requests r
    left join shared_validation v
      on v.request_key=r.chunk_id::text and v.invoice_id=r.invoice_id
  ),
  updated as (
    update public.invoice_operation_chunks c set
      phase=case when cardinality(e.blockers)=0 then 'FREEZE' else 'BLOCKED' end,
      status=case when cardinality(e.blockers)=0 then 'QUEUED' else 'BLOCKED' end,
      error_json=case when cardinality(e.blockers)=0 then null else
        jsonb_build_object('code',e.blockers[1],'blocker_codes',to_jsonb(e.blockers),'invoice_id',e.invoice_id) end,
      progress_json=jsonb_build_object('status_message',
        case when cardinality(e.blockers)=0 then 'Issue validation passed' else 'Issue blocked' end,
        'blocker_codes',to_jsonb(e.blockers)),
      lease_owner=null,lease_token=null,lease_expires_at_utc=null,
      updated_at_utc=v_now
    from eval e where c.id=e.chunk_id returning c.id,c.status,c.phase,c.error_json
  )
  select coalesce(jsonb_agg(jsonb_build_object('chunk_id',id,'status',status,'phase',phase,'error',error_json)),'[]')
    into v_part from updated;
  v_result:=v_result||coalesce(v_part,'[]');

  -- FREEZE: immutable legal/render snapshot; invoice deliberately remains DRAFT.
  with ids as materialized (
    select case when coalesce(x->>'chunk_id','') ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then (x->>'chunk_id')::uuid end chunk_id from jsonb_array_elements(p_claims) x where x->>'phase'='FREEZE'
  ),
  freeze_route_requests as materialized (
    select c.id chunk_id,
      case when pg_input_is_valid(
          nullif(c.payload_json->>'evaluation_date',''),'date')
        then(c.payload_json->>'evaluation_date')::date end
        evaluation_date,
      jsonb_build_object(
      'request_key',c.id::text,
      'invoice_id',c.entity_id,
      'recipient_set',coalesce(
        c.payload_json#>'{delivery_intent,recipient_set}','[]'::jsonb),
      'cc',coalesce(c.payload_json#>'{delivery_intent,cc}','[]'::jsonb),
      'bcc',coalesce(c.payload_json#>'{delivery_intent,bcc}','[]'::jsonb),
      'delivery_policy',coalesce(
        c.payload_json#>>'{delivery_intent,delivery_policy}','ATTACH'),
      'template_version',coalesce(
        c.payload_json#>>'{delivery_intent,template_version}',
        'invoice-delivery-v1')
    ) request_json
    from ids x join public.invoice_operation_chunks c on c.id=x.chunk_id
  ),
  freeze_route_groups as materialized (
    select q.evaluation_date,
      jsonb_agg(q.request_json order by q.chunk_id) request_json
    from freeze_route_requests q
    group by q.evaluation_date
  ),
  frozen_routes as materialized (
    select r.*
    from freeze_route_groups g
    cross join lateral private._invoice_delivery_routes_batch(
      g.request_json,g.evaluation_date) r
  ),
  freeze_seed as materialized (
    select c.id chunk_id,c.operation_id,c.entity_id invoice_id,c.payload_json,
      i.document_revision,i.invoice_no,i.client_id,
      frozen_clock.issue_at_utc,
      frozen_clock.issue_at_utc tax_point_utc,
      frozen_clock.issue_at_utc+make_interval(days=>coalesce(
        case when pg_input_is_valid(nullif(i.header_snapshot_json->>'payment_terms_days',''),'integer')
          then greatest(0,least(3650,(i.header_snapshot_json->>'payment_terms_days')::integer)) end,
        cl.payment_terms_days,30)) due_at_utc,
      rr.request_json routing_request,
      jsonb_build_object(
        'request_key',dr.request_key,
        'to',coalesce(dr.canonical_to,'[]'::jsonb),
        'cc',coalesce(dr.canonical_cc,'[]'::jsonb),
        'bcc',coalesce(dr.canonical_bcc,'[]'::jsonb),
        'recipient_set_hash',dr.recipient_set_hash,
        'route_policy_hash',dr.route_policy_hash,
        'route_source',dr.route_source,
        'do_not_send',dr.do_not_send,
        'delivery_suppressed',dr.delivery_suppressed,
        'suppression_reason',dr.suppression_reason,
        'client_settings_id',dr.client_settings_id,
        'contract_settings_ids',dr.contract_settings_ids,
        'effective_date',dr.effective_date,
        'client_id',dr.client_id,
        'invoice_group_identity',dr.invoice_group_identity,
        'self_bill',dr.self_bill,
        'grouping_identity',dr.grouping_identity,
        'template_version',coalesce(c.payload_json#>>'{delivery_intent,template_version}','invoice-delivery-v1'),
        'delivery_policy',upper(coalesce(c.payload_json#>>'{delivery_intent,delivery_policy}','ATTACH')),
        'warning_codes',coalesce(dr.warning_codes,'[]'::jsonb),
        'blocker_codes',coalesce(dr.blocker_codes,'[]'::jsonb),
        'evaluated_date',dr.effective_date
      ) delivery_route,
      coalesce(nullif(c.payload_json->>'delivery_request_token',''),
        'ISSUE:'||coalesce(c.payload_json->>'command_token',c.id::text)) delivery_request_token,
      coalesce(c.payload_json->'deliver','false'::jsonb) deliver
    from ids x
    join public.invoice_operation_chunks c on c.id=x.chunk_id
    join public.invoices i on i.id=c.entity_id and i.status='DRAFT'
    join public.clients cl on cl.id=i.client_id
    cross join lateral (
      select case when pg_input_is_valid(nullif(c.payload_json->>'frozen_issue_at_utc',''),'timestamptz')
        then (c.payload_json->>'frozen_issue_at_utc')::timestamptz else v_now end issue_at_utc
    ) frozen_clock
    left join frozen_routes dr on dr.request_key=c.id::text and dr.invoice_id=i.id
    left join freeze_route_requests rr on rr.chunk_id=c.id
  ),
  presentation_requests as materialized (
    select coalesce(jsonb_agg(jsonb_build_object(
        'request_key',fs.chunk_id::text,
        'entity_type','INVOICE',
        'entity_id',fs.invoice_id,
        'purpose','FINAL_ISSUE',
        'template_version','invoice-professional-v2',
        'issue_at_utc',fs.issue_at_utc,
        'tax_point_utc',fs.tax_point_utc,
        'due_at_utc',fs.due_at_utc
      ) order by fs.chunk_id),'[]'::jsonb) requests
    from freeze_seed fs
  ),
  presentation_batch as materialized (
    select p.*
    from (
      select pr.requests
      from presentation_requests pr
      where jsonb_typeof(pr.requests)='array'
        and jsonb_array_length(pr.requests)>0
    ) pr
    cross join lateral private._invoice_presentation_snapshot_batch(
      pr.requests,v_now) p
  ),
  frozen as materialized (
    select fs.chunk_id,fs.operation_id,fs.invoice_id,fs.payload_json,
      fs.document_revision,fs.invoice_no,fs.client_id,
      (
        pb.snapshot_json
        || jsonb_build_object(
          'snapshot_schema_version','FINAL_ISSUE_PRESENTATION_SNAPSHOT_V5',
          'issue_date_utc',fs.issue_at_utc,
          'tax_point_utc',fs.tax_point_utc,
          'due_date_utc',fs.due_at_utc,
          'routing_request',coalesce(fs.routing_request,'{}'::jsonb),
          'delivery_route',coalesce(fs.delivery_route,'{}'::jsonb),
          'delivery_intent',coalesce(fs.payload_json->'delivery_intent','{}'::jsonb),
          'delivery_request_token',fs.delivery_request_token,
          'deliver',fs.deliver,
          'presentation_model_hash',coalesce(pb.presentation_model->>'presentation_model_hash',pb.snapshot_json->>'presentation_model_hash',encode(digest(coalesce(pb.presentation_model,'{}'::jsonb)::text,'sha256'),'hex'))
        )
      ) snapshot,
      pb.valid presentation_valid,
      pb.error_code presentation_error_code,
      pb.error_detail presentation_error_detail
    from freeze_seed fs
    left join presentation_batch pb on pb.request_key=fs.chunk_id::text
  ),
  existing_versions as materialized (
    select f.*,v.id existing_document_version_id,v.operation_id doc_operation_id,
      o.control_version doc_control_version,v.status document_status,
      v.snapshot_hash existing_snapshot_hash
    from frozen f join public.invoice_document_versions v
      on coalesce(f.presentation_valid,false) is true
      and v.entity_type='INVOICE' and v.entity_id=f.invoice_id
      and v.purpose='FINAL_ISSUE'
      and v.snapshot_hash=encode(digest(f.snapshot::text,'sha256'),'hex')
      and v.template_version='invoice-professional-v2'
      and v.status in('PLANNING','WAITING_FOR_INPUTS','RENDERING',
        'ASSEMBLING','VERIFYING','READY')
    join public.invoice_operations o on o.id=v.operation_id
  ),
  doc_ops as materialized (
    insert into public.invoice_operations(parent_operation_id,operation_type,entity_type,entity_id,actor_user_id,
      idempotency_key,status,phase,priority,source_revision,template_version,input_json,config_json,progress_json,
      total_units,chunk_count,control_version,change_seq,created_at_utc,updated_at_utc)
    select f.operation_id,'BUILD_DOCUMENT','INVOICE',f.invoice_id,o.actor_user_id,
      encode(digest('FINAL_ISSUE|'||f.invoice_id||'|'||
        encode(digest(f.snapshot::text,'sha256'),'hex')||
        '|invoice-professional-v2','sha256'),'hex'),
      'QUEUED','BUILD_MANIFEST',850,f.document_revision::text,'invoice-professional-v2',
      jsonb_build_object('invoice_id',f.invoice_id,'purpose','FINAL_ISSUE'),
      jsonb_build_object('processor_policy',o.config_json->'processor_policy'),
      '{}',1,1,1,
      nextval('public.invoice_operation_change_seq'),v_now,v_now
    from frozen f join public.invoice_operations o on o.id=f.operation_id
    where coalesce(f.presentation_valid,false) is true
      and not exists(select 1 from existing_versions e where e.chunk_id=f.chunk_id)
    on conflict(idempotency_key) where status in ('QUEUED','RUNNING','WAITING','RETRY_WAIT','BLOCKED')
    do update set priority=greatest(invoice_operations.priority,850),updated_at_utc=v_now
    returning *
  ),
  selected as materialized (
    select f.chunk_id,f.operation_id,f.invoice_id,f.payload_json,f.document_revision,
      f.invoice_no,f.client_id,f.snapshot,d.id doc_operation_id,d.control_version doc_control_version,
      null::uuid existing_document_version_id,null::text document_status,
      null::text existing_snapshot_hash
    from frozen f join doc_ops d on d.entity_id=f.invoice_id
    where coalesce(f.presentation_valid,false) is true
    union all
    select f.chunk_id,f.operation_id,f.invoice_id,f.payload_json,f.document_revision,
      f.invoice_no,f.client_id,f.snapshot,e.doc_operation_id,e.doc_control_version,
      e.existing_document_version_id,e.document_status,e.existing_snapshot_hash
    from frozen f join existing_versions e on e.chunk_id=f.chunk_id
    where coalesce(f.presentation_valid,false) is true
  ),
  presentation_blocked as (
    update public.invoice_operation_chunks c set
      status='BLOCKED',phase='BLOCKED',failed_at_utc=v_now,
      error_json=jsonb_build_object(
        'code',coalesce(f.presentation_error_code,'FINAL_ISSUE_PRESENTATION_INVALID'),
        'detail',coalesce(f.presentation_error_detail,'{}'::jsonb),
        'invoice_id',f.invoice_id),
      lease_owner=null,lease_token=null,lease_expires_at_utc=null,
      updated_at_utc=v_now
    from frozen f
    where c.id=f.chunk_id and coalesce(f.presentation_valid,false) is not true
    returning c.id,c.status,c.phase,c.document_version_id
  ),
  versions as materialized (
    insert into public.invoice_document_versions(entity_type,entity_id,purpose,operation_id,source_revision,
      template_version,status,snapshot_json,snapshot_hash,manifest_json,manifest_hash,created_at_utc)
    select 'INVOICE',s.invoice_id,'FINAL_ISSUE',s.doc_operation_id,s.document_revision::text,
      'invoice-professional-v2','PLANNING',s.snapshot,encode(digest(s.snapshot::text,'sha256'),'hex'),
      '[]',encode(digest('[]','sha256'),'hex'),v_now
    from selected s
    where s.existing_document_version_id is null
    on conflict(entity_type,entity_id,purpose,snapshot_hash,template_version)
      where purpose='FINAL_ISSUE'
        and status in ('PLANNING','WAITING_FOR_INPUTS','RENDERING','ASSEMBLING','VERIFYING','READY')
    do nothing
    returning id,entity_id,operation_id,snapshot_hash
  ),
  exact_versions as materialized (
    select s.*,coalesce(s.existing_document_version_id,v.id) document_version_id,
      coalesce(s.existing_snapshot_hash,v.snapshot_hash) snapshot_hash,
      coalesce(s.document_status,'PLANNING') exact_document_status
    from selected s left join versions v
      on v.entity_id=s.invoice_id and v.operation_id=s.doc_operation_id
  ),
  doc_chunks as (
    insert into public.invoice_operation_chunks(operation_id,chunk_type,phase,work_key,sequence_no,entity_type,entity_id,
      document_version_id,status,priority,run_after_utc,payload_json,operation_control_version,created_at_utc,updated_at_utc)
    select s.doc_operation_id,'DOCUMENT_PLAN','BUILD_MANIFEST',
      encode(digest(concat_ws('|','DOCUMENT_PLAN',
        s.document_version_id::text,s.document_revision::text,
        'invoice-professional-v2','1'),'sha256'),'hex'),
      0,'INVOICE',s.invoice_id,s.document_version_id,
      'QUEUED',850,v_now,jsonb_build_object('purpose','FINAL_ISSUE'),s.doc_control_version,v_now,v_now
    from exact_versions s
    where s.exact_document_status<>'READY'
    on conflict(operation_id,chunk_type,level_no,sequence_no,work_key) do nothing returning id
  ),
  invoice_state as (
    update public.invoices i set issue_state='PREPARING_DOCUMENT',
      active_issue_operation_id=s.operation_id,
      active_document_operation_id=case when s.exact_document_status='READY'
        then i.active_document_operation_id else s.doc_operation_id end,
      document_state=case when s.exact_document_status='READY'
        then i.document_state else 'PREPARING' end,updated_at=v_now
    from exact_versions s where i.id=s.invoice_id and i.status='DRAFT' returning i.id
  ),
  advanced as (
    update public.invoice_operation_chunks c set
      phase=case when s.exact_document_status='READY' then 'FINALISE' else 'WAIT_DOCUMENT' end,
      status=case when s.exact_document_status='READY' then 'QUEUED' else 'WAITING' end,
      document_version_id=s.document_version_id,
      payload_json=c.payload_json||jsonb_build_object('frozen_document_revision',s.document_revision,
        'document_version_id',s.document_version_id,'document_operation_id',s.doc_operation_id,
        'snapshot_hash',s.snapshot_hash,
        'routing_request',s.snapshot->'routing_request',
        'frozen_delivery_route',s.snapshot->'delivery_route',
        'delivery_request_token',s.snapshot->>'delivery_request_token'),
      progress_json=jsonb_build_object('status_message',
        case when s.exact_document_status='READY'
          then 'Exact final document is ready' else 'Final issue document is preparing' end),
      lease_owner=null,lease_token=null,lease_expires_at_utc=null,
      updated_at_utc=v_now
    from exact_versions s where c.id=s.chunk_id
    returning c.id,c.status,c.phase,c.document_version_id
  ),
  freeze_outcomes as (
    select id,status,phase,document_version_id from advanced
    union all
    select id,status,phase,document_version_id from presentation_blocked
  )
  select coalesce(jsonb_agg(jsonb_build_object('chunk_id',id,'status',status,'phase',phase,
    'document_version_id',document_version_id)),'[]') into v_part from freeze_outcomes;
  v_result:=v_result||coalesce(v_part,'[]');

  -- WAIT_DOCUMENT observes only the exact row and never R2.
  with ids as materialized (
    select case when coalesce(x->>'chunk_id','') ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then (x->>'chunk_id')::uuid end chunk_id from jsonb_array_elements(p_claims) x where x->>'phase'='WAIT_DOCUMENT'
  ),
  updated as (
    update public.invoice_operation_chunks c set
      phase=case when v.status='READY' then 'FINALISE'
                 when v.status in ('FAILED','SUPERSEDED','CANCELLED') then 'BLOCKED'
                 else 'WAIT_DOCUMENT' end,
      status=case when v.status='READY' then 'QUEUED'
                  when v.status in ('FAILED','SUPERSEDED','CANCELLED') then 'BLOCKED'
                  else 'WAITING' end,
      error_json=case when v.status in ('FAILED','SUPERSEDED','CANCELLED')
        then jsonb_build_object('code','FINAL_DOCUMENT_'||v.status,'document_version_id',v.id,'detail',v.error_json)
        else null end,run_after_utc=case when v.status='READY' then v_now else c.run_after_utc end,
      lease_owner=null,lease_token=null,lease_expires_at_utc=null,
      updated_at_utc=v_now
    from ids x,public.invoice_document_versions v
    where c.id=x.chunk_id and v.id=c.document_version_id
    returning c.id,c.status,c.phase,c.error_json
  ),
  missing as (
    update public.invoice_operation_chunks c set
      phase='BLOCKED',status='BLOCKED',
      error_json=jsonb_build_object(
        'code','FINAL_DOCUMENT_VERSION_MISSING',
        'document_version_id',c.document_version_id),
      lease_owner=null,lease_token=null,lease_expires_at_utc=null,
      updated_at_utc=v_now
    from ids x
    where c.id=x.chunk_id
      and not exists(
        select 1 from public.invoice_document_versions v
        where v.id=c.document_version_id)
    returning c.id,c.status,c.phase,c.error_json
  ),
  outcomes as (
    select * from updated
    union all
    select * from missing
  )
  select coalesce(jsonb_agg(jsonb_build_object('chunk_id',id,'status',status,'phase',phase,'error',error_json)),'[]')
    into v_part from outcomes;
  v_result:=v_result||coalesce(v_part,'[]');

  -- FINALISE is the only legal issue transition and demands the exact verified version.
  with ids as materialized (
    select case when coalesce(x->>'chunk_id','') ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then (x->>'chunk_id')::uuid end chunk_id from jsonb_array_elements(p_claims) x where x->>'phase'='FINALISE'
  ),
  locked_invoices as materialized (
    select invoice.id
    from ids supplied
    join public.invoice_operation_chunks carrier
      on carrier.id=supplied.chunk_id
    join public.invoices invoice
      on invoice.id=carrier.entity_id
    order by invoice.id
    for update of invoice
  ),
  eligible as materialized (
    select c.*,i.document_revision,v.id final_document_version_id,v.r2_key,v.sha256,v.size_bytes,v.page_count,
      v.verified_at_utc,
      case when pg_input_is_valid(
        nullif(v.snapshot_json->>'issue_date_utc',''),'timestamptz')
        then (v.snapshot_json->>'issue_date_utc')::timestamptz
        else v_now end issue_at,
      case when pg_input_is_valid(
        nullif(v.snapshot_json->>'tax_point_utc',''),'timestamptz')
        then (v.snapshot_json->>'tax_point_utc')::timestamptz end tax_point_at,
      case when pg_input_is_valid(
        nullif(v.snapshot_json->>'due_date_utc',''),'timestamptz')
        then (v.snapshot_json->>'due_date_utc')::timestamptz end due_at,
      v.snapshot_hash
    from ids x join public.invoice_operation_chunks c on c.id=x.chunk_id
    join locked_invoices locked_invoice on locked_invoice.id=c.entity_id
    join public.invoices i on i.id=locked_invoice.id and i.status='DRAFT'
      and i.issue_state='PREPARING_DOCUMENT'
      and i.active_issue_operation_id=c.operation_id
    join public.invoice_document_versions v on v.id=c.document_version_id and v.purpose='FINAL_ISSUE'
      and v.entity_type='INVOICE' and v.entity_id=c.entity_id
      and v.status='READY' and v.verified_at_utc is not null and v.r2_key is not null
      and v.sha256 is not null and v.size_bytes>0 and v.page_count>0
    where case when pg_input_is_valid(
        nullif(c.payload_json->>'frozen_document_revision',''),'bigint')
      then(c.payload_json->>'frozen_document_revision')::bigint=i.document_revision
      else false end
      and v.source_revision=i.document_revision::text
      and c.payload_json->>'snapshot_hash'=v.snapshot_hash
      -- Recheck the same three planned codes after actual invoice retention,
      -- immediately before the true transition; no second send/issue gate.
      and not exists(select 1 from private._invoice_issue_validate_batch(jsonb_build_array(jsonb_build_object(
        'request_key',i.id::text,'invoice_id',i.id,'expected_revision',i.document_revision,
        'allow_early',true,'deliver',false)),v_now::date) native_issue
        cross join lateral jsonb_array_elements_text(native_issue.hard_blocker_codes) code
        where code in ('HEALTHROSTER_VALIDATION_REQUIRED','AGENCY_INVOICE_CREDIT_NOTE_NOT_ISSUED','HEALTHROSTER_EVIDENCE_MISSING'))
  ),
  issued as (
    update public.invoices i set status='ISSUED',status_date_utc=v_now,
      issued_at_utc=e.issue_at,due_at_utc=e.due_at,
      on_hold_reason=null,issued_document_version_id=e.final_document_version_id,
      invoice_pdf_r2_key=e.r2_key,invoice_pdf_generated_at_utc=e.verified_at_utc,
      issue_state='ISSUED',document_state='READY',active_issue_operation_id=null,
      active_document_operation_id=case
        when pg_input_is_valid(
          nullif(e.payload_json->>'document_operation_id',''),'uuid')
          then case when i.active_document_operation_id=
              (e.payload_json->>'document_operation_id')::uuid
            then null else i.active_document_operation_id end
        else i.active_document_operation_id end,updated_at=v_now
    from eligible e where i.id=e.entity_id returning i.id
  ),
  audits as (
    insert into public.audit_events(ts_utc,actor_user_id,actor_display,actor_role_at_time,
      object_type,object_id_text,action,after_json,reason)
    select v_now,o.actor_user_id,u.display_name,u.role,'invoice',e.entity_id::text,'INVOICE_ISSUED',
      jsonb_build_object('invoice_id',e.entity_id,'document_version_id',e.final_document_version_id,
        'issue_at_utc',e.issue_at,'tax_point_utc',e.tax_point_at,'due_at_utc',e.due_at,
        'sha256',e.sha256,'size_bytes',e.size_bytes,'page_count',e.page_count),'INVOICE_OPERATION_QUEUE'
    from eligible e join public.invoice_operations o on o.id=e.operation_id
    left join public.tms_users u on u.id=o.actor_user_id returning id
  ),
  advanced as (
    update public.invoice_operation_chunks c set
      phase=case when lower(coalesce(c.payload_json->>'deliver','false'))
        in('true','t','1','yes') then 'QUEUE_DELIVERY' else 'COMPLETE' end,
      status=case when lower(coalesce(c.payload_json->>'deliver','false'))
        in('true','t','1','yes') then 'QUEUED' else 'COMPLETE' end,
      completed_at_utc=case when lower(coalesce(
        c.payload_json->>'deliver','false')) in('true','t','1','yes')
        then null else v_now end,
      result_json=jsonb_build_object('invoice_id',e.entity_id,'document_version_id',e.final_document_version_id,
        'issue_at_utc',e.issue_at,'tax_point_utc',e.tax_point_at,'due_at_utc',e.due_at,
        'r2_key',e.r2_key,'sha256',e.sha256,'size_bytes',e.size_bytes,'page_count',e.page_count),
      lease_owner=null,lease_token=null,lease_expires_at_utc=null,
      updated_at_utc=v_now
    from eligible e where c.id=e.id
    returning c.id,c.status,c.phase,c.result_json,c.error_json
  ),
  ineligible as (
    update public.invoice_operation_chunks c
    set status='BLOCKED',phase='BLOCKED',failed_at_utc=v_now,
        error_json=jsonb_build_object(
          'code','ISSUE_FINALISE_OWNERSHIP_OR_DOCUMENT_MISMATCH',
          'invoice_id',c.entity_id,
          'document_version_id',c.document_version_id),
        lease_owner=null,lease_token=null,lease_expires_at_utc=null,
        updated_at_utc=v_now
    from ids x
    where c.id=x.chunk_id
      and not exists(select 1 from eligible e where e.id=c.id)
    returning c.id,c.status,c.phase,c.result_json,c.error_json
  ),
  outcomes as (
    select * from advanced
    union all
    select * from ineligible
  )
  select coalesce(jsonb_agg(jsonb_build_object(
    'chunk_id',id,'status',status,'phase',phase,
    'result',result_json,'error',error_json)),'[]'),
    (select coalesce(array_agg(id order by id),array[]::uuid[]) from issued)
    into v_part,v_agency_issued_ids from outcomes;
  v_result:=v_result||coalesce(v_part,'[]');
  -- Data-modifying CTEs share their statement snapshot. The next command sees
  -- the genuine issued RETURNING rows and native audits; only those new IDs
  -- cause retirement. Replayed/already-issued or ineligible chunks do not.
  foreach v_agency_invoice_id in array v_agency_issued_ids loop
    perform private.weekly_source_agency_issue_close_v1(v_agency_invoice_id);
  end loop;

  -- QUEUE_DELIVERY durably delegates to the single delivery-routing authority.
  with ids as materialized (
    select case when coalesce(x->>'chunk_id','') ~*
      '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
      then (x->>'chunk_id')::uuid end chunk_id
    from jsonb_array_elements(p_claims) x
    where x->>'phase'='QUEUE_DELIVERY'
  ),
  delivery_specs as materialized (
    select c.id chunk_id,c.operation_id parent_operation_id,c.entity_id invoice_id,
      o.actor_user_id,i.issued_document_version_id,
      coalesce(c.payload_json->'delivery_intent','{}'::jsonb) delivery_intent,
      coalesce(c.payload_json->'routing_request','{}'::jsonb)
        routing_request,
      coalesce(c.payload_json->'frozen_delivery_route','{}'::jsonb)
        frozen_delivery_route,
      coalesce(nullif(c.payload_json->>'delivery_request_token',''),
        'ISSUE:'||coalesce(c.payload_json->>'command_token',c.id::text))
        delivery_request_token,
      nullif(c.payload_json#>>'{frozen_delivery_route,template_version}','')
        template_version,
      nullif(c.payload_json#>>'{frozen_delivery_route,recipient_set_hash}','')
        recipient_set_hash,
      nullif(c.payload_json#>>'{frozen_delivery_route,route_policy_hash}','')
        route_policy_hash,
      coalesce(c.payload_json#>'{frozen_delivery_route,to}','[]'::jsonb)
        canonical_to,
      coalesce(c.payload_json#>'{frozen_delivery_route,cc}','[]'::jsonb)
        canonical_cc,
      coalesce(c.payload_json#>'{frozen_delivery_route,bcc}','[]'::jsonb)
        canonical_bcc,
      lower(coalesce(
        c.payload_json#>>'{frozen_delivery_route,do_not_send}','false'))
        in('true','t','1','yes') do_not_send,
      lower(coalesce(
        c.payload_json#>>'{frozen_delivery_route,delivery_suppressed}','false'))
        in('true','t','1','yes') delivery_suppressed,
      c.payload_json#>>'{frozen_delivery_route,route_source}' route_source,
      coalesce(c.payload_json#>'{frozen_delivery_route,warning_codes}',
        '[]'::jsonb) route_warnings,
      coalesce(c.payload_json#>'{frozen_delivery_route,blocker_codes}',
        '[]'::jsonb) route_blockers,
      c.payload_json#>>'{frozen_delivery_route,route_policy_hash}' is not null
        and c.payload_json#>>'{frozen_delivery_route,recipient_set_hash}'
          is not null
        and c.payload_json#>>'{frozen_delivery_route,template_version}'
          is not null
        and upper(coalesce(
          c.payload_json#>>'{frozen_delivery_route,delivery_policy}',''))
          in('ATTACH','SPLIT','SECURE_LINK')
        and lower(coalesce(
          c.payload_json#>>'{frozen_delivery_route,do_not_send}','false'))
          not in('true','t','1','yes')
        and lower(coalesce(
          c.payload_json#>>'{frozen_delivery_route,delivery_suppressed}','false'))
          not in('true','t','1','yes')
        and (case
          when jsonb_typeof(c.payload_json#>'{frozen_delivery_route,blocker_codes}')='array'
            then jsonb_array_length(c.payload_json#>'{frozen_delivery_route,blocker_codes}')
          when c.payload_json#>'{frozen_delivery_route,blocker_codes}' is null then 0
          else 1
        end)=0
        frozen_route_usable,
      coalesce(case when coalesce(c.payload_json#>>'{delivery_intent,part_number}','') ~
        '^[0-9]+$' then(c.payload_json#>>'{delivery_intent,part_number}')::integer end,1)
        part_number,
      case when upper(coalesce(
          c.payload_json#>>'{delivery_intent,delivery_policy}','')) in(
            'ATTACH','SPLIT','SECURE_LINK')
        then upper(c.payload_json#>>'{delivery_intent,delivery_policy}')
        when upper(coalesce(
          c.payload_json#>>'{frozen_delivery_route,delivery_policy}','')) in(
            'ATTACH','SPLIT','SECURE_LINK')
        then upper(c.payload_json#>>'{frozen_delivery_route,delivery_policy}')
      end delivery_policy
    from ids x join public.invoice_operation_chunks c on c.id=x.chunk_id
    join public.invoice_operations o on o.id=c.operation_id
    join public.invoices i on i.id=c.entity_id and i.status='ISSUED'
      and i.issued_document_version_id=c.document_version_id
  ),
  delivery_groups as materialized (
    select d.parent_operation_id,
      (array_agg(d.actor_user_id order by d.chunk_id))[1] actor_user_id,
      (array_agg(d.template_version order by d.chunk_id))[1] template_version,
      encode(digest(string_agg(concat_ws('|',d.invoice_id::text,
        d.route_policy_hash),'||' order by d.invoice_id),'sha256'),'hex')
        route_policy_hash,
      (array_agg(d.delivery_policy order by d.chunk_id))[1] delivery_policy,
      array_agg(d.invoice_id order by d.invoice_id) invoice_ids,
      array_agg(d.issued_document_version_id order by d.invoice_id)
        issued_document_version_ids,
      array_agg(d.delivery_request_token order by d.invoice_id)
        delivery_request_tokens,
      count(*)::integer unit_count,
      encode(digest(string_agg(concat_ws('|',d.invoice_id::text,
        d.issued_document_version_id::text,d.delivery_request_token),
        '||' order by d.invoice_id),'sha256'),'hex') group_request_hash,
      encode(digest(string_agg(concat_ws('|',d.invoice_id::text,
        d.issued_document_version_id::text,d.delivery_request_token,
        d.route_policy_hash),
        '||' order by d.invoice_id),'sha256'),'hex') delivery_revision,
      encode(digest(concat_ws('|','DELIVER_INVOICES',d.parent_operation_id::text,
        encode(digest(string_agg(concat_ws('|',d.invoice_id::text,
          d.issued_document_version_id::text,d.delivery_request_token),
          '||' order by d.invoice_id),'sha256'),'hex')),'sha256'),'hex')
        delivery_key
    from delivery_specs d
    group by d.parent_operation_id
  ),
  existing_delivery as materialized (
    select g.parent_operation_id,o.id operation_id,o.control_version,o.status
    from delivery_groups g join lateral(
      select x.* from public.invoice_operations x
      where x.idempotency_key=g.delivery_key
        and x.status in(
          'QUEUED','RUNNING','WAITING','RETRY_WAIT','BLOCKED','COMPLETE')
      order by(x.status='COMPLETE') desc,x.created_at_utc desc limit 1
    ) o on true
  ),
  inserted_delivery as materialized (
    insert into public.invoice_operations(parent_operation_id,operation_type,
      entity_type,entity_id,actor_user_id,idempotency_key,status,phase,priority,
      source_revision,template_version,input_json,config_json,progress_json,
      total_units,chunk_count,control_version,change_seq,requires_user_action,
      error_json,created_at_utc,updated_at_utc)
    select g.parent_operation_id,'DELIVER_INVOICES','INVOICE_BATCH',null,
      g.actor_user_id,g.delivery_key,'QUEUED','PREPARE',700,
      g.delivery_revision,g.template_version,
      jsonb_build_object('invoice_ids',to_jsonb(g.invoice_ids),
        'issued_document_version_ids',to_jsonb(g.issued_document_version_ids),
        'template_version',g.template_version,
        'delivery_request_tokens',to_jsonb(g.delivery_request_tokens),
        'group_request_hash',g.group_request_hash,
        'route_policy_hash',g.route_policy_hash,
        'delivery_policy',g.delivery_policy),
      jsonb_build_object(
        'delivery_request_tokens',to_jsonb(g.delivery_request_tokens),
        'group_request_hash',g.group_request_hash,
        'route_policy_hash',g.route_policy_hash,
        'processor_policy',parent.config_json->'processor_policy'),
      jsonb_build_object('status_message','Batch delivery preparation queued'),
      g.unit_count,g.unit_count,1,nextval('public.invoice_operation_change_seq'),
      false,null,v_now,v_now
    from delivery_groups g
    join public.invoice_operations parent on parent.id=g.parent_operation_id
    where not exists(
      select 1 from existing_delivery e
      where e.parent_operation_id=g.parent_operation_id)
    on conflict do nothing
    returning *
  ),
  selected_delivery_groups as materialized (
    select g.*,coalesce(e.operation_id,n.id) delivery_operation_id,
      coalesce(e.control_version,n.control_version) delivery_control_version,
      coalesce(e.status,n.status) delivery_status
    from delivery_groups g
    left join existing_delivery e
      on e.parent_operation_id=g.parent_operation_id
    left join inserted_delivery n on n.idempotency_key=g.delivery_key
  ),
  selected_delivery as materialized (
    select d.*,g.delivery_operation_id,g.delivery_control_version,
      g.delivery_status
    from delivery_specs d
    join selected_delivery_groups g
      on g.parent_operation_id=d.parent_operation_id
  ),
  delivery_chunk_specs as materialized (
    select d.*,gen_random_uuid() delivery_chunk_id
    from selected_delivery d
    where d.delivery_status<>'COMPLETE'
  ),
  delivery_chunks as (
    insert into public.invoice_operation_chunks(id,operation_id,chunk_type,phase,
      work_key,sequence_no,entity_type,entity_id,document_version_id,status,priority,
      run_after_utc,payload_json,error_json,operation_control_version,
      created_at_utc,updated_at_utc)
    select d.delivery_chunk_id,d.delivery_operation_id,'DELIVERY_PREPARE',
      case when d.frozen_route_usable then 'PREPARE' else 'BLOCKED' end,
      encode(digest(concat_ws('|','DELIVERY_PREPARE',
        d.issued_document_version_id::text,d.route_policy_hash,
        d.template_version,d.part_number::text,d.delivery_request_token),
        'sha256'),'hex'),
      row_number() over(partition by d.delivery_operation_id
        order by d.invoice_id)::integer-1,
      'INVOICE',d.invoice_id,d.issued_document_version_id,
      case when d.frozen_route_usable then 'QUEUED' else 'BLOCKED' end,
      700,v_now,
      jsonb_build_object('request_key',d.delivery_chunk_id::text,
        'invoice_id',d.invoice_id,
        'issued_document_version_id',d.issued_document_version_id,
        'recipient_set',d.canonical_to,'cc',d.canonical_cc,'bcc',d.canonical_bcc,
        'recipient_set_hash',d.recipient_set_hash,'template_version',d.template_version,
        'route_policy_hash',d.route_policy_hash,
        'delivery_part_number',d.part_number,'do_not_send',d.do_not_send,
        'delivery_suppressed',d.delivery_suppressed,
        'delivery_policy',d.delivery_policy,
        'route_source',d.route_source,
        'delivery_request_token',d.delivery_request_token,
        'routing_request',d.routing_request,
        'frozen_delivery_route',d.frozen_delivery_route),
      case when d.frozen_route_usable then null else jsonb_build_object(
        'code','FROZEN_DELIVERY_ROUTE_UNUSABLE',
        'frozen_route',d.frozen_delivery_route,
        'route_blockers',d.route_blockers) end,
      d.delivery_control_version,v_now,v_now
    from delivery_chunk_specs d
    on conflict(operation_id,chunk_type,level_no,sequence_no,work_key) do nothing
    returning id
  ),
  completed_delivery_request as (
    update public.invoice_operation_chunks c set status='COMPLETE',phase='COMPLETE',
      completed_at_utc=v_now,updated_at_utc=v_now,
      lease_owner=null,lease_token=null,lease_expires_at_utc=null,
      payload_json=coalesce(c.payload_json,'{}'::jsonb)
        || jsonb_build_object(
          'blocked_for_sending',
          not d.frozen_route_usable
        ),
      result_json=coalesce(c.result_json,'{}')||jsonb_build_object(
        'delivery_operation_id',d.delivery_operation_id,
        'delivery_status',case when d.frozen_route_usable
          then d.delivery_status else 'BLOCKED' end,
        'delivery_requested',true,
        'delivery_request_token',d.delivery_request_token,
        'delivery_blocker',case when d.frozen_route_usable then null
          else jsonb_build_object('code','FROZEN_DELIVERY_ROUTE_UNUSABLE',
            'frozen_route',d.frozen_delivery_route,
            'route_blockers',d.route_blockers) end)
    from selected_delivery d where c.id=d.chunk_id
    returning c.id,c.status,c.phase,c.result_json
  )
  select coalesce(jsonb_agg(jsonb_build_object('chunk_id',id,'status',status,
    'phase',phase,'result',result_json)),'[]') into v_part
  from completed_delivery_request;
  v_result:=v_result||coalesce(v_part,'[]');

  return coalesce(v_result,'[]'::jsonb);
end;
$function$;

create or replace function public._import_review_ready_action_ids_core_v1(p_import_id uuid)
returns table(action_id text)
language plpgsql
stable
security definer
set search_path to 'public', 'pg_temp'
as $function$
begin
  return query
  with preset_units as materialized (
    select n.candidate_id,n.client_id
    from private.weekly_source_agency_mode_a_units_v1(p_import_id) n where n.has_preset
  ), selected_units as (
    select distinct d.candidate_id,d.client_id
    from public.import_review_decisions d
    where d.import_id=p_import_id and d.is_current and d.selectable and d.selected
      and not d.blocking and d.candidate_id is not null and d.client_id is not null
      and not exists (
        select 1 from public.import_review_action_outcomes o where o.action_id=d.action_id
      )
      and not (d.action_kind='NO_ACTION' and exists (
        select 1 from public.import_review_action_outcomes o
        where o.import_id=d.import_id and o.source_identity=d.source_identity
      ))
  ), eligible_units as (
    select u.candidate_id,u.client_id
    from selected_units u
    -- Preserve the native COMPLETE Candidate/Client unit boundary. A unit with
    -- a dated preset week is reserved for its sole completeness writer; other
    -- candidates/clients remain the existing native ready set.
    where not exists(select 1 from preset_units p
      where p.candidate_id=u.candidate_id and p.client_id=u.client_id)
      and not exists (
      select 1 from public.import_review_decisions b
      where b.import_id=p_import_id and b.is_current and b.blocking
        -- A blocker only owns a resolved candidate/client unit when both
        -- identities are known.  An unresolved source worker or source client
        -- must remain pending without freezing unrelated ready candidates in
        -- the same Trust/import.
        and b.candidate_id=u.candidate_id
        and b.client_id=u.client_id
    )
  )
  select d.action_id
  from public.import_review_decisions d
  join eligible_units u on u.candidate_id=d.candidate_id and u.client_id=d.client_id
  where d.import_id=p_import_id and d.is_current and d.selectable and d.selected and not d.blocking
    and not exists (
      select 1 from public.import_review_action_outcomes o where o.action_id=d.action_id
    )
    and not (d.action_kind='NO_ACTION' and exists (
      select 1 from public.import_review_action_outcomes o
      where o.import_id=d.import_id and o.source_identity=d.source_identity
    ))
  order by d.action_id;
end
$function$;

CREATE OR REPLACE FUNCTION public.hr_weekly_apply_transactional(p_import_id uuid, p_payload jsonb, p_actor_user_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
 SET plpgsql_check.mode TO 'disabled'
AS $function$
declare
  v_now timestamptz := now();

  -- import header
  v_import_source_system text;
  v_import_client_id uuid;

  -- payload parts
  v_payload jsonb := coalesce(p_payload, '{}'::jsonb);
  v_actions_json jsonb := '[]'::jsonb;

  -- Expanded only from persisted, selected review decisions.
  v_invalidation_actions jsonb := '[]'::jsonb;
  v_invalidation_actions_count int := 0;

  -- normalized selections
  v_selected_action_ids text[] := array[]::text[];
  v_selected_truth_keys text[] := array[]::text[];
  v_selected_cancel_shift_ids uuid[] := array[]::uuid[];

  -- derived mode key sets
  v_mode_a_external_keys text[] := array[]::text[];
  v_mode_b_external_keys text[] := array[]::text[];

  -- selected truth keys constrained to MODE_B
  v_selected_truth_keys_mode_b text[] := array[]::text[];

  -- Mode B tick-only enforced lists
  v_force_keys_final text[] := array[]::text[];
  v_skip_keys_final text[] := array[]::text[];

  -- changed-hours partition (selected keys only, MODE_B)
  v_invoiced_changed_keys text[] := array[]::text[];
  v_not_invoiced_changed_keys text[] := array[]::text[];
  v_protected_source_timesheet_ids uuid[] := array[]::uuid[];
  v_force_keys_non_invoiced text[] := array[]::text[];

  v_phase3_result jsonb := null;
  v_changed_preflight jsonb := null;
  v_changed_timesheet_ids uuid[] := array[]::uuid[];
  v_reauthorise_timesheet_ids uuid[] := array[]::uuid[];
  v_lifecycle_items jsonb := '[]'::jsonb;
  v_unauthorise_result jsonb := null;
  v_reconciliation_action_ids text[] := array[]::text[];
  v_operation_bound_correction_action_ids text[] := array[]::text[];
  v_operation_bound_correction_keys text[] := array[]::text[];
  v_operation_bound_correction_timesheet_ids uuid[] := array[]::uuid[];
  v_general_authorise_timesheet_ids uuid[] := array[]::uuid[];
  v_reconciliation_transition jsonb := null;
  v_reconciliation_units jsonb := '[]'::jsonb;
  v_paid_unit jsonb;
  v_paid_timesheet_id uuid;
  v_paid_intent text;
  v_paid_current_count integer := 0;
  v_paid_current_tf public.timesheets_financials%rowtype;
  v_paid_preflight jsonb;
  v_paid_rollover jsonb;
  v_paid_mode text;
  v_paid_historical_id uuid;
  v_paid_shell_id uuid;
  v_paid_applied jsonb;
  v_paid_applied_timesheet_ids uuid[] := array[]::uuid[];
  v_paid_current_contract jsonb;
  v_paid_current_contract_fingerprint text;
  v_paid_current_policy_unit jsonb;
  v_paid_current_policy_count integer := 0;
  v_paid_current_policy jsonb;
  v_paid_origin_operation public.import_apply_operations%rowtype;
  v_paid_origin_contract jsonb;
  v_paid_origin_contract_fingerprint text;
  v_paid_origin_policy_unit jsonb;
  v_paid_origin_policy_count integer := 0;
  v_paid_historical_tf public.timesheets_financials%rowtype;
  v_paid_digest text;

  -- Phase 1 / 1.5 (MODE_B)
  v_phase1_result jsonb := null;
  v_phase15_ok int := 0;
  v_phase15_updated int := 0;

  -- cancellations (MODE_B)
  v_cancel_actions jsonb := '[]'::jsonb;
  v_cancellations_result jsonb := null;

  -- mirror (MODE_A)
  v_mirror_result jsonb := null;

  -- validation (MODE_A)
  v_weekly_val_payload jsonb := null;
  v_validations_upserted int := 0;
  v_mismatched_tsids uuid[] := array[]::uuid[];

  -- ✅ NEW: validation-changed timesheets (MODE_A) that must trigger TSFIN recompute
  v_validation_changed_timesheet_ids uuid[] := array[]::uuid[];

  -- ✅ NEW: count of ref clears due to missing shifts (MODE_A)
  v_mode_a_ref_cleared_count int := 0;

  -- ✅ NEW: count of ref sets due to matched shifts (MODE_A)
  v_mode_a_ref_set_count int := 0;

  -- ✅ NEW: timesheets whose reference truth changed (for post-apply QR reissue + regen)
  v_ref_updated_timesheet_ids uuid[] := array[]::uuid[];
  v_ref_updated_timesheet_ids_count int := 0;

  -- ✅ NEW: consolidated email jobs + items
  v_email_jobs jsonb := '[]'::jsonb;

  -- affected timesheets for TSFIN drain (MODE_B + MODE_A validation changes)
  v_affected_timesheet_ids uuid[] := array[]::uuid[];
  -- MODE_B targets are ordinary authoritative work.  MODE_A targets are kept
  -- in a separate array and enter auto-authorisation only after the stricter
  -- complete whole-timesheet validation gate below.
  v_authoritative_affected_timesheet_ids uuid[] := array[]::uuid[];
  v_validation_auto_authorise_timesheet_ids uuid[] := array[]::uuid[];
  v_auto_authorise_timesheet_ids uuid[] := array[]::uuid[];

  -- policy A replacement-day
  v_selected_cancel_shift_id_set text[] := array[]::text[];

  -- debug counts
  v_steps jsonb := '[]'::jsonb;

  v_selected_action_ids_count int := 0;
  v_selected_row_keys_count int := 0;
  v_selected_cancel_shift_ids_count int := 0;

  v_mode_a_ok_keys_total int := 0;
  v_mode_b_ok_keys_total int := 0;

  v_force_keys_count int := 0;
  v_skip_keys_count int := 0;

  v_invoiced_changed_keys_count int := 0;
  v_not_invoiced_changed_keys_count int := 0;

  v_cancellations_count int := 0;

  v_phase3_created_count int := 0;
  v_phase3_updated_count int := 0;
  v_cancel_adjustment_count int := 0;
  v_correction_timesheets_created_count int := 0;

  v_val_rows_count int := 0;
  v_email_actions_count int := 0;
  v_email_jobs_count int := 0;

  v_sample_force_keys jsonb := '[]'::jsonb;
  v_sample_cancel_shift_ids jsonb := '[]'::jsonb;
  v_selected_action_ids_sample jsonb := '[]'::jsonb;

  v_mode_b_phase1_called boolean := false;
  v_mode_b_phase15_called boolean := false;
  v_mode_b_cancellations_called boolean := false;
  v_mode_b_phase3_called boolean := false;

  v_mode_b_should_run_phase1 boolean := false;
  v_mode_b_should_run_phase15 boolean := false;
  v_mode_b_should_run_cancellations boolean := false;
  v_mode_b_should_run_phase3 boolean := false;

  -- Server-owned review contract. A review state is mandatory for every call.
  v_review_contract jsonb := coalesce(v_payload->'review_contract','{}'::jsonb);
  v_review_selected_ids jsonb := coalesce(v_payload->'review_selected_action_ids','[]'::jsonb);
  v_review_operation_id uuid;
  v_review_guard jsonb;
  v_review_result jsonb;
  v_post_commit_email_action_ids jsonb := '[]'::jsonb;

  v_phase1_shifts_created int := null;
  v_phase1_shifts_updated int := null;

  v_last_shift_id uuid := null;

  -- ─────────────────────────────────────────────
  -- ✅ ENSURE BASE WEEKLY TIMESHEET + ATTACH ACTIVE HEALTHROSTER SHIFTS (invariant)
  -- ─────────────────────────────────────────────
  v_ensure_pairs_count int := 0;
  v_ensure_pairs_skipped_no_active int := 0;

  v_ensure_base_week_created_count int := 0;
  v_ensure_base_week_existing_count int := 0;

  v_ensure_timesheet_created_count int := 0;
  v_ensure_timesheet_reused_count int := 0;
  v_ensure_timesheet_missing_reference_count int := 0;

  v_ensure_shifts_attached_count int := 0;
  v_ensure_shifts_relinked_invalid_ts_count int := 0;
  v_ensure_remaining_active_detached_count int := 0;

  -- ✅ NEW: MODE_A shift→timesheet linking (fix evidence + HR crosscheck + ref propagation)
  v_mode_a_shifts_attached_count int := 0;
  v_mode_a_ts_linked_count int := 0;

  v_ensure_sample_pairs jsonb := '[]'::jsonb;
  v_ensure_sample_created_ts_ids jsonb := '[]'::jsonb;

  -- loop vars for ensure
  v_pair_contract_id uuid;
  v_pair_candidate_id uuid;
  v_pair_client_id uuid;
  v_pair_week_ending_date date;

  v_active_count int := 0;

  v_base_week_id uuid := null;
  v_base_week_ts_id uuid := null;

  v_ts_exists boolean := false;

  v_candidate_display_name text := null;
  v_candidate_tms_ref text := null;
  v_client_name text := null;
  v_contract_display_site text := null;
  v_contract_ward_hint text := null;
  v_contract_role text := null;

  v_occupant_norm text := null;
  v_hospital_norm text := null;
  v_ward_norm text := null;
  v_role_norm text := null;

  v_booking_base text := null;
  v_hash_hex text := null;
  v_booking_id text := null;
  v_shift_label_norm text := null;

  v_new_ts_id uuid := null;

  v_attached_null_count int := 0;
  v_relinked_invalid_count int := 0;

  v_sqlstate text;
  v_err text;

  -- Plan 6.2 G6-11 (proof/34 section 3, entry point E14).
  v_weekly_source_guard jsonb;
  v_weekly_source_root uuid;
  v_weekly_source_family record;
begin
  v_steps := v_steps || jsonb_build_array(jsonb_build_object('step','START'));

  -- ─────────────────────────────────────────────
  -- 0) Validate import + header fields
  -- ─────────────────────────────────────────────
  select
    upper(coalesce(hi.source_system::text, '')),
    hi.client_id
  into
    v_import_source_system,
    v_import_client_id
  from public.hr_imports hi
  where hi.id = p_import_id
  limit 1;

  if v_import_source_system is null or v_import_source_system = '' then
    raise exception 'hr_weekly_apply_transactional: import % not found in hr_imports.', p_import_id;
  end if;

  if v_import_source_system <> 'HEALTHROSTER' then
    raise exception 'hr_weekly_apply_transactional: import % source_system=%; expected HEALTHROSTER.', p_import_id, v_import_source_system;
  end if;

  if v_import_client_id is null then
    raise exception 'hr_weekly_apply_transactional: import % missing client_id.', p_import_id;
  end if;

  if not exists(select 1 from public.import_review_states where import_id=p_import_id) then
    raise exception 'IMPORT_REVIEW_REQUIRED' using errcode='55000';
  end if;
  if jsonb_typeof(v_payload)<>'object' then
    raise exception 'IMPORT_REVIEW_APPLY_PAYLOAD_INVALID' using errcode='22023';
  end if;
  if exists(select 1 from jsonb_object_keys(v_payload) as keys(key_name)
    where keys.key_name not in ('review_contract','review_selected_action_ids','invalidation_action_ids')) then
    raise exception 'IMPORT_REVIEW_BROWSER_AUTHORITY_REJECTED' using errcode='22023';
  end if;
  if jsonb_typeof(v_review_contract)<>'object' or jsonb_typeof(v_review_selected_ids)<>'array'
    or not(v_payload?'invalidation_action_ids') or jsonb_typeof(v_payload->'invalidation_action_ids')<>'array' then
    raise exception 'IMPORT_REVIEW_APPLY_CONTRACT_REQUIRED' using errcode='22023';
  end if;
  -- This is refusal only: claimed action IDs resolve back to real current
  -- decisions and the native preview census. No payload grants membership.
  if exists(select 1 from private.weekly_source_agency_mode_a_units_v1(p_import_id) n
    join public.import_review_decisions d on d.import_id=p_import_id and d.is_current
      and d.candidate_id=n.candidate_id and d.client_id=n.client_id
    where n.has_preset and d.action_id in (select jsonb_array_elements_text(v_review_selected_ids))) then
    raise exception 'AGENCY_INVOICE_USES_COMPLETENESS_WRITER' using errcode='55000';end if;
  v_review_operation_id:=(v_review_contract->>'operation_id')::uuid;
  v_review_guard:=public.import_review_apply_guard_v1(p_import_id,(v_review_contract->>'state_version')::bigint,
    v_review_contract->>'coverage_fingerprint',v_review_contract->>'preview_fingerprint',v_review_operation_id,
    v_review_contract->>'request_hash',v_review_selected_ids,v_payload->'invalidation_action_ids',p_actor_user_id);
  if coalesce((v_review_guard->>'replay')::boolean,false) then return v_review_guard->'stored_response'; end if;

  -- The server guard has reduced the request to complete, ready
  -- candidate/client units.  Keep that boundary available to every MODE_A
  -- validation/mirror step; otherwise a partial batch could validate or link
  -- rows belonging to a candidate that the operator deliberately left
  -- pending.
  drop table if exists pg_temp.tmp_review_batch_units;
  create temporary table tmp_review_batch_units(
    candidate_id uuid not null,
    client_id uuid not null,
    primary key(candidate_id,client_id)
  ) on commit drop;
  insert into tmp_review_batch_units(candidate_id,client_id)
  select distinct d.candidate_id,d.client_id
  from public.import_review_decisions d
  where d.import_id=p_import_id and d.is_current
    and d.action_id in (select jsonb_array_elements_text(v_review_guard->'selected_action_ids'))
    and d.candidate_id is not null and d.client_id is not null
  on conflict do nothing;
  -- Recheck the actual guard-admitted complete units before ANY legacy
  -- validation, manager email, mirror or import auto-authorisation owner.
  if exists(select 1 from private.weekly_source_agency_mode_a_units_v1(p_import_id) n
    join pg_temp.tmp_review_batch_units u on u.candidate_id=n.candidate_id and u.client_id=n.client_id
    where n.has_preset) then
    raise exception 'AGENCY_INVOICE_USES_COMPLETENESS_WRITER' using errcode='55000';end if;
  if not exists(select 1 from tmp_review_batch_units) then
    raise exception 'IMPORT_REVIEW_BATCH_SCOPE_EMPTY' using errcode='55000';
  end if;
  select coalesce(jsonb_agg(to_jsonb(case when d.action_kind='APPLY_CANCELLATION' then 'CANCEL:'||d.shift_id::text else 'ROW:'||d.source_identity end) order by d.action_id),'[]'::jsonb)
    into v_actions_json
  from public.import_review_decisions d
  where d.import_id=p_import_id and d.is_current and d.selected
    and d.action_id in (select jsonb_array_elements_text(v_review_guard->'selected_action_ids'))
    and d.action_kind in ('INCLUDE_SHIFT','APPLY_AMENDMENT','APPLY_CANCELLATION');
  select coalesce(jsonb_agg(jsonb_build_object('timesheet_id',d.timesheet_id,'comparison_key',d.source_identity,'invalidate',true) order by d.action_id),'[]'::jsonb)
    into v_invalidation_actions
  from public.import_review_decisions d
  where d.import_id=p_import_id and d.is_current and d.selected
    and d.action_id in (select jsonb_array_elements_text(v_review_guard->'selected_action_ids'))
    and d.action_kind='INVALIDATE_REFERENCE';
  select coalesce(jsonb_agg(to_jsonb(d.action_id) order by d.action_id),'[]'::jsonb)
    into v_post_commit_email_action_ids
  from public.import_review_decisions d
  where d.import_id=p_import_id and d.is_current and d.selected
    and d.action_id in (select jsonb_array_elements_text(v_review_guard->'selected_action_ids'))
    and d.action_kind in ('EMAIL_ISSUE','EMAIL_REMINDER');
  v_email_actions_count:=jsonb_array_length(v_post_commit_email_action_ids);

  v_steps := v_steps || jsonb_build_array(jsonb_build_object('step','IMPORT_OK','client_id',v_import_client_id::text));

  -- ─────────────────────────────────────────────
  -- 1) Parse and normalize selection payload (ROW:/CANCEL:)
  -- ─────────────────────────────────────────────
  if jsonb_typeof(v_actions_json) <> 'array' then
    raise exception 'hr_weekly_apply_transactional: selected_action_ids must be a JSON array.';
  end if;

  if jsonb_typeof(v_invalidation_actions) <> 'array' then
    raise exception 'hr_weekly_apply_transactional: invalidation_actions must be a JSON array.';
  end if;

  v_invalidation_actions_count := jsonb_array_length(v_invalidation_actions);

  create temporary table tmp_sel_ids(
    action_id text primary key
  ) on commit drop;

  insert into tmp_sel_ids(action_id)
  select distinct nullif(btrim(x.value), '')
  from jsonb_array_elements_text(v_actions_json) as x(value)
  where nullif(btrim(x.value), '') is not null
  on conflict do nothing;

  if exists (
    select 1
    from tmp_sel_ids s
    where s.action_id !~ '^(ROW|CANCEL):'
  ) then
    raise exception 'hr_weekly_apply_transactional: invalid action_id in selection (expected ROW:<external_row_key> or CANCEL:<shift_id>).';
  end if;

  select coalesce(array_agg(s.action_id order by s.action_id), array[]::text[])
  into v_selected_action_ids
  from tmp_sel_ids s;

  select coalesce(array_agg(distinct substring(s.action_id from 5) order by substring(s.action_id from 5)), array[]::text[])
  into v_selected_truth_keys
  from tmp_sel_ids s
  where s.action_id like 'ROW:%';

  select coalesce(array_agg(distinct (substring(s.action_id from 8))::uuid order by (substring(s.action_id from 8))::uuid), array[]::uuid[])
  into v_selected_cancel_shift_ids
  from tmp_sel_ids s
  where s.action_id like 'CANCEL:%';

  v_selected_action_ids_count := coalesce(array_length(v_selected_action_ids, 1), 0);
  v_selected_row_keys_count := coalesce(array_length(v_selected_truth_keys, 1), 0);
  v_selected_cancel_shift_ids_count := coalesce(array_length(v_selected_cancel_shift_ids, 1), 0);

  select to_jsonb(coalesce(array_agg(x.a), array[]::text[]))
  into v_selected_action_ids_sample
  from (
    select a as a
    from unnest(coalesce(v_selected_action_ids, array[]::text[])) as a
    order by a
    limit 20
  ) as x;

  v_steps := v_steps || jsonb_build_array(
    jsonb_build_object(
      'step','SELECTION_PARSED',
      'selected_action_ids_count', v_selected_action_ids_count,
      'selected_row_keys_count', v_selected_row_keys_count,
      'selected_cancel_shift_ids_count', v_selected_cancel_shift_ids_count,
      'email_actions_count', v_email_actions_count,
      'invalidation_actions_count', v_invalidation_actions_count,
      'selected_action_ids_sample', v_selected_action_ids_sample
    )
  );

  -- ─────────────────────────────────────────────
  -- ✅ tmp_aff_ts must exist early (PK + ON CONFLICT supported)
  -- ─────────────────────────────────────────────
  drop table if exists pg_temp.tmp_aff_ts;
  create temporary table tmp_aff_ts(
    timesheet_id uuid primary key
  ) on commit drop;

  -- ✅ NEW: reference-updated timesheets (used for QR reissue + regen decisions)
  drop table if exists pg_temp.tmp_ref_updated_ts;
  create temporary table tmp_ref_updated_ts(
    timesheet_id uuid primary key
  ) on commit drop;

  -- ─────────────────────────────────────────────
  -- 2) Load weekly_import_phase2 + compute per-group authority through the
  --    shared current-setting core used by staging and catalogue generation.
  -- ─────────────────────────────────────────────
  create temporary table tmp_p2_all on commit drop as
  select *
  from public.weekly_import_phase2(p_import_id := p_import_id, p_system_type := 'HR_WEEKLY');

  create temporary table tmp_p2_ok on commit drop as
  select
    p2.external_row_key,
    p2.candidate_id,
    p2.client_id,
    p2.contract_id,
    p2.week_ending_date,
    p2.work_date,
    upper(coalesce(p2.action::text,'')) as action
  from tmp_p2_all p2
  where upper(coalesce(p2.action::text,'')) = 'OK'
    and p2.external_row_key is not null
    and p2.contract_id is not null
    and p2.candidate_id is not null
    and p2.client_id is not null
    and p2.week_ending_date is not null;

  create temporary table tmp_group_mode on commit drop as
  select distinct
    t.contract_id,
    t.candidate_id,
    t.client_id,
    t.week_ending_date,
    ('grp:' || t.contract_id::text || ':' || t.week_ending_date::text || ':' || t.candidate_id::text) as group_id,
    case a.authority_mode when 'AUTHORITATIVE' then 'MODE_B'
      when 'VALIDATION_ONLY' then 'MODE_A' else 'OUT_OF_SCOPE' end as mode
  from (
    select distinct p2ok.contract_id, p2ok.candidate_id, p2ok.client_id, p2ok.week_ending_date
    from tmp_p2_ok p2ok
  ) as t
  join public.contracts c
    on c.id = t.contract_id
  cross join lateral public._import_review_effective_authority_core_v1(
    'HR_WEEKLY',c.id,c.client_id,t.week_ending_date) a;

  if exists(select 1 from tmp_group_mode gm join tmp_review_batch_units bu
      on bu.candidate_id=gm.candidate_id and bu.client_id=gm.client_id
      where gm.mode='OUT_OF_SCOPE') then
    raise exception 'HR_WEEKLY_IMPORT_AUTHORITY_OUT_OF_SCOPE' using errcode='40001';
  end if;

  create temporary table tmp_p2_ok_mode on commit drop as
  select
    p2ok.external_row_key,
    p2ok.candidate_id,
    p2ok.client_id,
    p2ok.contract_id,
    p2ok.week_ending_date,
    p2ok.work_date,
    gm.group_id,
    gm.mode
  from tmp_p2_ok p2ok
  join tmp_group_mode gm
    on gm.contract_id = p2ok.contract_id
   and gm.candidate_id = p2ok.candidate_id
   and gm.week_ending_date = p2ok.week_ending_date;

  -- Validation-only Weekly work is atomic at the real timesheet boundary.
  -- A selected email by itself must never cause matching sibling shifts to be
  -- validated or sent to TSFIN.  The complete group is eligible only when at
  -- least one server-selected validation row exists, no unresolved action is
  -- present, and every selectable validation row in the group was selected.
  create temporary table tmp_mode_a_eligible_groups on commit drop as
  select gm.contract_id,gm.candidate_id,gm.client_id,gm.week_ending_date,gm.group_id
  from tmp_group_mode gm
  join tmp_review_batch_units bu
    on bu.candidate_id=gm.candidate_id and bu.client_id=gm.client_id
  where gm.mode='MODE_A'
    and exists (
      select 1
      from public.import_review_decisions selected_row
      where selected_row.import_id=p_import_id
        and selected_row.is_current
        and selected_row.action_id in (select jsonb_array_elements_text(v_review_guard->'selected_action_ids'))
        and selected_row.action_kind='NO_ACTION'
        and selected_row.candidate_id=gm.candidate_id
        and selected_row.client_id=gm.client_id
        and selected_row.contract_id is not distinct from gm.contract_id
        and nullif(selected_row.summary_json->>'week_ending_date','')::date=gm.week_ending_date
        and selected_row.summary_json->>'authority_mode'='VALIDATION_ONLY'
    )
    and not exists (
      select 1
      from public.import_review_decisions hold
      where hold.import_id=p_import_id
        and hold.is_current
        and hold.candidate_id=gm.candidate_id
        and hold.client_id=gm.client_id
        and hold.contract_id is not distinct from gm.contract_id
        and nullif(hold.summary_json->>'week_ending_date','')::date=gm.week_ending_date
        and hold.summary_json->>'source_route' not like '%DAILY%'
        and (hold.blocking or hold.action_category in ('EMAIL','PENDING','BLOCKED'))
    )
    and not exists (
      select 1
      from public.import_review_decisions deferred_row
      where deferred_row.import_id=p_import_id
        and deferred_row.is_current
        and deferred_row.action_kind='NO_ACTION'
        and deferred_row.selectable
        and deferred_row.candidate_id=gm.candidate_id
        and deferred_row.client_id=gm.client_id
        and deferred_row.contract_id is not distinct from gm.contract_id
        and nullif(deferred_row.summary_json->>'week_ending_date','')::date=gm.week_ending_date
        and deferred_row.summary_json->>'authority_mode'='VALIDATION_ONLY'
        and deferred_row.action_id not in (select jsonb_array_elements_text(v_review_guard->'selected_action_ids'))
    );

  select coalesce(array_agg(distinct m.external_row_key order by m.external_row_key), array[]::text[])
  into v_mode_a_external_keys
  from tmp_p2_ok_mode m
  join tmp_mode_a_eligible_groups eligible
    on eligible.contract_id=m.contract_id
   and eligible.candidate_id=m.candidate_id
   and eligible.client_id=m.client_id
   and eligible.week_ending_date=m.week_ending_date
  where m.mode = 'MODE_A';

  select coalesce(array_agg(distinct m.external_row_key order by m.external_row_key), array[]::text[])
  into v_mode_b_external_keys
  from tmp_p2_ok_mode m
  where m.mode = 'MODE_B';

  v_mode_a_ok_keys_total := coalesce(array_length(v_mode_a_external_keys, 1), 0);
  v_mode_b_ok_keys_total := coalesce(array_length(v_mode_b_external_keys, 1), 0);

  if exists (
    select 1
    from unnest(coalesce(v_selected_truth_keys, array[]::text[])) as k(external_row_key)
    left join (select distinct mb.external_row_key from tmp_p2_ok_mode mb where mb.mode = 'MODE_B') as mbok
      on mbok.external_row_key = k.external_row_key
    where mbok.external_row_key is null
  ) then
    raise exception 'hr_weekly_apply_transactional: selection includes ROW:<external_row_key> that is not MODE_B (timesheet required).';
  end if;

  select coalesce(array_agg(k.external_row_key order by k.external_row_key), array[]::text[])
  into v_selected_truth_keys_mode_b
  from (
    select distinct k.external_row_key
    from unnest(coalesce(v_selected_truth_keys, array[]::text[])) as k(external_row_key)
    join (select distinct mb.external_row_key from tmp_p2_ok_mode mb where mb.mode = 'MODE_B') as mbok
      on mbok.external_row_key = k.external_row_key
  ) as k;

  v_steps := v_steps || jsonb_build_array(
    jsonb_build_object(
      'step','PHASE2_OK_LOADED',
      'mode_a_ok_keys_total', v_mode_a_ok_keys_total,
      'mode_b_ok_keys_total', v_mode_b_ok_keys_total
    )
  );

  -- ─────────────────────────────────────────────
  -- 3) MODE_B tick = PROCEED (no decisions)
  -- ─────────────────────────────────────────────
  v_force_keys_final := coalesce(v_selected_truth_keys_mode_b, array[]::text[]);

  select coalesce(array_agg(x.external_row_key order by x.external_row_key), array[]::text[])
  into v_skip_keys_final
  from (
    select distinct okk.external_row_key
    from unnest(coalesce(v_mode_b_external_keys, array[]::text[])) as okk(external_row_key)
    left join unnest(coalesce(v_force_keys_final, array[]::text[])) as fk(external_row_key)
      on fk.external_row_key = okk.external_row_key
    where fk.external_row_key is null
  ) as x;

  v_force_keys_count := coalesce(array_length(v_force_keys_final, 1), 0);
  v_skip_keys_count := coalesce(array_length(v_skip_keys_final, 1), 0);
  v_cancellations_count := coalesce(array_length(v_selected_cancel_shift_ids, 1), 0);

  -- Only MODE_B is import-authoritative.  Ignore unrelated expense-only
  -- timesheets, but refuse to reuse a base contract-week timesheet occupied by
  -- calculated expenses or to amend/reverse an imported shift whose own linked
  -- timesheet contains them.  This runs before any source mutation.
  if exists (
    select 1
    from (
      select cw.timesheet_id
      from tmp_p2_ok_mode p2
      join public.contract_weeks cw
        on cw.contract_id=p2.contract_id
       and cw.week_ending_date=p2.week_ending_date
       and cw.is_adjustment=false
       and coalesce(cw.additional_seq,0)=0
      where p2.mode='MODE_B'
        and p2.external_row_key=any(coalesce(v_force_keys_final,array[]::text[]))
        and cw.timesheet_id is not null
        and not exists (
          select 1
          from public.nhsp_shifts existing_import_shift
          where existing_import_shift.source_system='HEALTHROSTER'::public.hr_source_enum
            and existing_import_shift.client_id=v_import_client_id
            and existing_import_shift.external_row_key=p2.external_row_key
            and existing_import_shift.cancelled_at_utc is null
        )
      union
      select ns.timesheet_id
      from public.nhsp_shifts ns
      where ns.source_system='HEALTHROSTER'::public.hr_source_enum
        and ns.client_id=v_import_client_id
        and ns.timesheet_id is not null
        and (
          ns.external_row_key=any(coalesce(v_force_keys_final,array[]::text[]))
          or ns.id=any(coalesce(v_selected_cancel_shift_ids,array[]::uuid[]))
        )
    ) expense_target
    where public._import_review_timesheet_has_calculated_expenses_core_v1(expense_target.timesheet_id)
  ) then
    raise exception using
      message='IMPORT_AUTHORITATIVE_EXPENSE_SEPARATION_REQUIRED',
      errcode='P0001',
      detail=jsonb_build_object(
        'code','IMPORT_AUTHORITATIVE_EXPENSE_SEPARATION_REQUIRED',
        'message','Timesheet occupied by expenses. Remove the expenses from this timesheet, save or recalculate it, then choose Recheck. Expenses must be invoiced on a separate timesheet for import-authoritative work; no import mutation was applied.'
      )::text;
  end if;

  v_mode_b_should_run_phase1 := (v_force_keys_count > 0);
  v_mode_b_should_run_phase15 := (v_force_keys_count > 0);
  v_mode_b_should_run_cancellations := (v_cancellations_count > 0);

  v_steps := v_steps || jsonb_build_array(
    jsonb_build_object(
      'step','TICK_PROCEED_KEYS_READY',
      'mode_b_force_keys_count', v_force_keys_count,
      'mode_b_skip_keys_count', v_skip_keys_count,
      'mode_b_cancellations_count', v_cancellations_count
    )
  );

  -- ─────────────────────────────────────────────
  -- 4) MODE_B: do NOT run truth mutation work when there is nothing to apply
  -- ─────────────────────────────────────────────
  if (v_mode_b_should_run_phase1 is false) and (v_mode_b_should_run_cancellations is false) then
    v_steps := v_steps || jsonb_build_array(
      jsonb_build_object(
        'step','MODE_B_NOOP_GUARD',
        'reason','NO_SELECTION_NO_CANCELLATION => SKIP_MODE_B_TRUTH_MUTATION',
        'should_run_phase1', false,
        'should_run_phase15', false,
        'should_run_phase3', false,
        'should_run_cancellations', false
      )
    );
  else
    -- MODE_B PHASE3 / PHASE1 / PHASE1.5 / CANCELLATIONS BLOCKS
    create temporary table tmp_changed_sel on commit drop as
    select
      ch.external_row_key,
      ch.timesheet_id,
      ch.is_paid,
      ch.is_invoiced
    from public.weekly_import_changed_hours_phase3(p_import_id := p_import_id, p_system_type := 'HEALTHROSTER') as ch
    where ch.external_row_key = any(coalesce(v_force_keys_final, array[]::text[]));

    if to_regclass('pg_temp.import_review_reconciliation_units_v1') is not null then
      if exists(select 1 from pg_temp.import_review_reconciliation_units_v1 u
        where u.unit_json->>'source_system'<>'HEALTHROSTER'
           or u.unit_json->>'schema_version'<>'IMPORT_AUTHORITATIVE_RECONCILIATION_V1'
           or u.route not in ('AMEND_SOURCE','AMEND_PAID_UNINVOICED_SOURCE','AMEND_EXISTING_REPLACEMENT','CREATE_REVERSAL_REPLACEMENT')) then
        raise exception 'IMPORT_REVIEW_RECONCILIATION_UNIT_INVALID' using errcode='22023';
      end if;
      select coalesce(array_agg(u.action_id order by u.action_id),array[]::text[]),
        coalesce(array_agg(u.action_id order by u.action_id) filter(where u.route in ('AMEND_PAID_UNINVOICED_SOURCE','AMEND_EXISTING_REPLACEMENT','CREATE_REVERSAL_REPLACEMENT')),array[]::text[]),
        coalesce(array_agg(u.source_identity order by u.source_identity) filter(where u.route in ('AMEND_EXISTING_REPLACEMENT','CREATE_REVERSAL_REPLACEMENT')),array[]::text[])
      into v_reconciliation_action_ids,v_operation_bound_correction_action_ids,v_operation_bound_correction_keys
      from pg_temp.import_review_reconciliation_units_v1 u;
    end if;

    select coalesce(array_agg(cs.external_row_key order by cs.external_row_key), array[]::text[])
    into v_invoiced_changed_keys
    from tmp_changed_sel cs
    where cs.is_invoiced is true
       or cs.is_paid is true;

    select coalesce(array_agg(cs.external_row_key order by cs.external_row_key), array[]::text[])
    into v_not_invoiced_changed_keys
    from tmp_changed_sel cs
    where cs.is_invoiced is false
      and cs.is_paid is false;

    if cardinality(v_reconciliation_action_ids)>0 then
      select coalesce(array_agg(u.source_identity order by u.source_identity)
        filter(where u.route in ('AMEND_EXISTING_REPLACEMENT','CREATE_REVERSAL_REPLACEMENT')),array[]::text[]),
        coalesce(array_agg(u.source_identity order by u.source_identity)
        filter(where u.route in ('AMEND_SOURCE','AMEND_PAID_UNINVOICED_SOURCE')),array[]::text[])
      into v_invoiced_changed_keys,v_not_invoiced_changed_keys
      from pg_temp.import_review_reconciliation_units_v1 u;
      if cardinality(v_operation_bound_correction_action_ids)>0 then
        v_reconciliation_transition:=public.import_review_correction_generation_transition_v1(
          p_import_id,v_review_operation_id,v_review_contract->>'request_hash','PREPARE',p_actor_user_id,
          v_operation_bound_correction_action_ids,v_now);
      end if;
    end if;

    v_invoiced_changed_keys_count := coalesce(array_length(v_invoiced_changed_keys, 1), 0);
    v_not_invoiced_changed_keys_count := coalesce(array_length(v_not_invoiced_changed_keys, 1), 0);

    select coalesce(array_agg(distinct cs.timesheet_id order by cs.timesheet_id), array[]::uuid[])
      into v_changed_timesheet_ids
    from tmp_changed_sel cs
    where cs.timesheet_id is not null;

    select coalesce(array_agg(distinct protected.timesheet_id order by protected.timesheet_id),array[]::uuid[])
      into v_protected_source_timesheet_ids
    from (
      select cs.timesheet_id
      from tmp_changed_sel cs
      where cs.timesheet_id is not null
        and (cs.is_invoiced is true or cs.is_paid is true)
      union all
      -- A financial-position-only action may have no legacy changed-hours row.
      -- Its reviewed reconciliation unit is then the durable authority proving
      -- that the ordinary source is protected history and only the mutable
      -- correction members may enter the post-commit TSFIN target set.
      select nullif(u.unit_json->>'source_timesheet_id','')::uuid
      from pg_temp.import_review_reconciliation_units_v1 u
      where u.route in ('AMEND_EXISTING_REPLACEMENT','CREATE_REVERSAL_REPLACEMENT')
        and nullif(u.unit_json->>'source_timesheet_id','') is not null
    ) protected
    where protected.timesheet_id is not null;

    if coalesce(array_length(v_changed_timesheet_ids, 1), 0) > 0 then
      select public.import_timesheet_financial_preflight_v1(
        p_timesheet_ids := v_changed_timesheet_ids,
        p_action := 'IMPORT_CHANGED_HOURS',
        p_actor_user_id := p_actor_user_id,
        p_expected_state_json := '{}'::jsonb,
        p_lock_rows := true,
        p_max_scope := 100
      ) into v_changed_preflight;

      if coalesce((v_changed_preflight->>'allowed')::boolean, false) is not true then
        raise exception using
          message = 'IMPORT_FINANCIAL_PREFLIGHT_BLOCKED',
          errcode = 'P0001',
          detail = v_changed_preflight::text;
      end if;

    end if;

    -- Mode B only: preserve the lifecycle state of authorised, mutable source
    -- timesheets.  Reauthorisation is deliberately deferred until the Worker
    -- has completed the bounded TSFIN refresh for this committed operation.
    select coalesce(array_agg(distinct lifecycle_scope.timesheet_id order by lifecycle_scope.timesheet_id),array[]::uuid[])
    into v_reauthorise_timesheet_ids
    from (
      select cs.timesheet_id
      from tmp_changed_sel cs
      join public.timesheets ts on ts.timesheet_id=cs.timesheet_id and ts.is_current=true
      left join public.timesheets_financials tf on tf.timesheet_id=ts.timesheet_id and tf.is_current=true
      left join public.contract_weeks cw on cw.timesheet_id=ts.timesheet_id
      where cs.timesheet_id is not null
        and not (cs.external_row_key=any(coalesce(v_operation_bound_correction_keys,array[]::text[])))
        and cs.is_invoiced is false
        and (cs.is_paid is false or exists(select 1 from pg_temp.import_review_reconciliation_units_v1 paid_unit
          where paid_unit.source_identity=cs.external_row_key
            and paid_unit.route='AMEND_PAID_UNINVOICED_SOURCE'
            and paid_unit.unit_json->>'intended_authorisation_action'='REAUTHORISE'))
        and (ts.authorised_at_server is not null or tf.authorised_at_utc is not null
          or cw.status='AUTHORISED'::public.contract_week_status_enum)
      union
      select ns.timesheet_id
      from public.nhsp_shifts ns
      join public.timesheets ts on ts.timesheet_id=ns.timesheet_id and ts.is_current=true
      left join public.timesheets_financials tf on tf.timesheet_id=ts.timesheet_id and tf.is_current=true
      left join public.contract_weeks cw on cw.timesheet_id=ts.timesheet_id
      where ns.id=any(coalesce(v_selected_cancel_shift_ids,array[]::uuid[]))
        and ns.timesheet_id is not null
        and coalesce((public._import_review_timesheet_protection_core_v1(ns.timesheet_id)->>'paid')::boolean,false)=false
        and coalesce((public._import_review_timesheet_protection_core_v1(ns.timesheet_id)->>'invoice_locked')::boolean,false)=false
        and (ts.authorised_at_server is not null or tf.authorised_at_utc is not null
          or cw.status='AUTHORISED'::public.contract_week_status_enum)
    ) lifecycle_scope;

    if cardinality(v_reauthorise_timesheet_ids)>100 then
      raise exception 'IMPORT_REVIEW_REAUTHORISE_SCOPE_TOO_LARGE' using errcode='54000';
    end if;
    -- Plan 6.2 G6-11 (proof/34 section 3, entry point E14): an authorised
    -- Weekly-Source-managed root may never be unauthorised, re-pointed or
    -- re-promoted by an import apply.  Checked before this owner's first write
    -- of any kind, which is the canonical bulk unauthorise immediately below.
    -- Weekly Source withdraws a first authorisation only through its own
    -- withdrawal owner (proof/36).  An unmanaged family is unaffected.
    -- WP-09b review finding F1: the guard verdict must be read under the
    -- compatible locks of proof/34 section 5, not before them.  Every family in
    -- scope is locked here first, in the deadlock-free trimmed-then-raw order,
    -- and still before this owner's first write, so a first authorisation that
    -- holds the family and commits cannot overtake an unlocked read.
    for v_weekly_source_family in
      select distinct btrim(family_timesheet.booking_id) as trimmed_booking_id,
        family_timesheet.booking_id as booking_id
      from unnest(coalesce(v_reauthorise_timesheet_ids,array[]::uuid[])) as scope(timesheet_id)
      join public.timesheets family_timesheet
        on family_timesheet.timesheet_id=scope.timesheet_id
      where family_timesheet.booking_id is not null
        and btrim(family_timesheet.booking_id)<>''
      order by 1,2
    loop
      perform pg_advisory_xact_lock(hashtext(v_weekly_source_family.trimmed_booking_id));
      if v_weekly_source_family.booking_id<>v_weekly_source_family.trimmed_booking_id then
        perform pg_advisory_xact_lock(hashtext(v_weekly_source_family.booking_id));
      end if;
      perform 1 from public.timesheets locked_member
      where locked_member.booking_id=v_weekly_source_family.booking_id for update;
    end loop;
    foreach v_weekly_source_root in array coalesce(v_reauthorise_timesheet_ids,array[]::uuid[])
    loop
      v_weekly_source_guard:=private.weekly_source_managed_root_guard_v1(v_weekly_source_root);
      -- HANDOVER 2 round-5 ruling B3 and A4 (18 September 2026).  The refusal is
      -- NARROWED: it applies to a Weekly-Source managed root, to a bound or
      -- protected family whose identity cannot be resolved, to a family carrying
      -- protected pay evidence but no authorisation row
      -- (PROTECTED_ROOT_AUTHORITY_MISSING), and to the live-record-on-an-
      -- unauthorised-Timesheet contradiction, which must never be allowed to
      -- continue merely because managed is false.  An unrelated, UNBOUND ordinary
      -- family -- including a malformed one -- keeps exactly the behaviour it had
      -- before this feature was installed.  Absent, null and non-boolean take the
      -- unsafe value at every read (Part 1 addendum rule 4).
      if (coalesce((v_weekly_source_guard->>'managed')::boolean, true)
           and (coalesce((v_weekly_source_guard->>'ok')::boolean, true)
                or coalesce((v_weekly_source_guard->>'weekly_source_bound')::boolean, true)))
         or coalesce((v_weekly_source_guard->>'authorisation_record_without_authorised_timesheet')::boolean, false)
         or (v_weekly_source_guard->>'protected_target_ownership_state') is not null then
        raise exception 'WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED'
          using errcode='55000',detail=jsonb_build_object(
            'code','WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED',
            'entry_point','E14:public.hr_weekly_apply_transactional',
            'block_reason','WEEKLY_SOURCE_MANAGED_ROOT',
            'refusal_basis', case
              -- HANDOVER 2 round-5 Part E: the trim-equivalent split family is a
              -- canonical booking-reference collision and must be named as one.
              -- WP-03 handoff N20: accept BOTH the installed token and the ruled name for one
              -- release, so the order of this edit and WP-03's rename cannot open a gap in
              -- which Office stops seeing the ruled name.
              when v_weekly_source_guard->>'reason' in (
                     'FAMILY_SPLIT_BY_WHITESPACE','BOOKING_REFERENCE_CANONICAL_COLLISION')
                then 'BOOKING_REFERENCE_CANONICAL_COLLISION'
              when coalesce((v_weekly_source_guard->>'managed')::boolean, true) and coalesce((v_weekly_source_guard->>'ok')::boolean, true)
                then 'WEEKLY_SOURCE_MANAGED_ROOT'
              when coalesce((v_weekly_source_guard->>'managed')::boolean, true)
                then 'WEEKLY_SOURCE_BOUND_OR_PROTECTED_ROOT_UNRESOLVABLE'
              when coalesce((v_weekly_source_guard->>'authorisation_record_without_authorised_timesheet')::boolean, false)
                then 'AUTHORISATION_RECORD_WITHOUT_AUTHORISED_TIMESHEET'
              else 'PROTECTED_ROOT_AUTHORITY_MISSING' end,
            'integrity_failure', not coalesce((v_weekly_source_guard->>'ok')::boolean,false),
            'timesheet_id',v_weekly_source_root,
            'reason',v_weekly_source_guard->>'reason'
          )::text;
      end if;
    end loop;
    if cardinality(v_reauthorise_timesheet_ids)>0 then
      select coalesce(jsonb_agg(jsonb_build_object(
        'timesheet_id',target_id::text,
        'expected_timesheet_id',target_id::text
      ) order by target_id),'[]'::jsonb)
      into v_lifecycle_items
      from unnest(v_reauthorise_timesheet_ids) as lifecycle_target(target_id);

      select public.timesheet_unauthorise_bulk_atomic(v_lifecycle_items,p_actor_user_id,v_now)
      into v_unauthorise_result;
      if coalesce((v_unauthorise_result->>'ok')::boolean,false) is not true
        or coalesce((v_unauthorise_result->>'all_success')::boolean,false) is not true then
        raise exception using message='IMPORT_REVIEW_CANONICAL_UNAUTHORISE_FAILED',errcode='P0001',
          detail=jsonb_build_object(
            'code','IMPORT_REVIEW_CANONICAL_UNAUTHORISE_FAILED',
            'timesheet_ids',to_jsonb(v_reauthorise_timesheet_ids),
            'failure_count',coalesce((v_unauthorise_result->>'failure_count')::int,cardinality(v_reauthorise_timesheet_ids))
          )::text;
      end if;
      v_steps:=v_steps||jsonb_build_array(jsonb_build_object(
        'step','CANONICAL_UNAUTHORISE_COMPLETE',
        'reauthorise_timesheet_count',cardinality(v_reauthorise_timesheet_ids)
      ));
    end if;

    -- Execute the reviewed ordinary paid-but-uninvoiced route before source
    -- truth is amended. Paid status alone never routes a source through phase 3.
    for v_paid_unit in
      select u.unit_json from pg_temp.import_review_reconciliation_units_v1 u
      where u.route='AMEND_PAID_UNINVOICED_SOURCE'
      order by u.source_timesheet_id
    loop
      v_paid_timesheet_id:=nullif(v_paid_unit->>'source_timesheet_id','')::uuid;
      v_paid_intent:=v_paid_unit->>'intended_authorisation_action';
      if v_paid_timesheet_id is null
         or v_paid_intent not in ('REAUTHORISE','AUTHORISE','LEAVE_UNAUTHORISED') then
        raise exception 'IMPORT_REVIEW_RECONCILIATION_UNIT_INVALID' using errcode='22023';
      end if;

      select operation_row.response_json#>'{correction_operation_contract}'
      into v_paid_current_contract from public.import_apply_operations operation_row
      where operation_row.id=v_review_operation_id;
      v_paid_current_contract_fingerprint:=encode(extensions.digest(convert_to(
        (v_paid_current_contract-'operation_contract_fingerprint')::text,'UTF8'),'sha256'),'hex');
      if jsonb_typeof(v_paid_current_contract)<>'object'
         or v_paid_current_contract->>'operation_contract_fingerprint' is distinct from v_paid_current_contract_fingerprint then
        raise exception 'PAID_TSFIN_ROLLOVER_ORDINARY_SOURCE_POLICY_INVALID' using errcode='P0001';
      end if;
      select count(*)::integer,min(policy_unit::text)::jsonb
      into v_paid_current_policy_count,v_paid_current_policy_unit
      from jsonb_array_elements(coalesce(v_paid_current_contract->'correction_units','[]'::jsonb)) policy_unit
      where policy_unit->>'action_id'=v_paid_unit->>'action_id'
        and policy_unit->>'root_timesheet_id'=v_paid_timesheet_id::text
        and policy_unit->>'source_row_key'=v_paid_unit->>'source_identity';
      if v_paid_current_policy_count<>1
         or jsonb_typeof(v_paid_current_policy_unit->'policy_envelope')<>'object' then
        raise exception 'PAID_TSFIN_ROLLOVER_ORDINARY_SOURCE_POLICY_INVALID' using errcode='P0001';
      end if;
      v_paid_current_policy:=v_paid_current_policy_unit->'policy_envelope';

      perform 1 from public.timesheets exact_source
      where exact_source.timesheet_id=v_paid_timesheet_id
        and exact_source.is_current and exact_source.archived_at_utc is null for update;
      if not found then
        raise exception 'IMPORT_REVIEW_SELECTED_ACTION_STALE' using errcode='40001';
      end if;
      perform 1 from public.timesheets_financials current_lock
      where current_lock.timesheet_id=v_paid_timesheet_id and current_lock.is_current
      order by current_lock.id for update;
      select count(*)::integer into v_paid_current_count from public.timesheets_financials current_tf
      where current_tf.timesheet_id=v_paid_timesheet_id and current_tf.is_current;
      if v_paid_current_count<>1 then
        raise exception 'IMPORT_REVIEW_SELECTED_ACTION_STALE' using errcode='40001';
      end if;
      select current_tf.* into v_paid_current_tf from public.timesheets_financials current_tf
      where current_tf.timesheet_id=v_paid_timesheet_id and current_tf.is_current;

      if v_paid_current_tf.paid_at_utc is not null then
        v_paid_preflight:=public.import_timesheet_financial_preflight_v1(
          array[v_paid_timesheet_id]::uuid[],'PAID_UNINVOICED_ROLLOVER',p_actor_user_id,
          '{}'::jsonb,false,100);
        if coalesce((v_paid_preflight->>'allowed')::boolean,false) is not true
           or v_paid_preflight->>'required_path' is distinct from 'PAID_UNINVOICED_ROLLOVER'
           or coalesce((v_paid_preflight->>'input_count')::integer,0)<>1
           or coalesce((v_paid_preflight->>'member_count')::integer,0)<>1
           or coalesce((v_paid_preflight->>'paid_count')::integer,0)<>1
           or coalesce((v_paid_preflight->>'invoice_lined_count')::integer,0)<>0
           or coalesce((v_paid_preflight->>'blocking_batch_count')::integer,0)<>0
           or coalesce((v_paid_preflight->>'stale_tsfin_count')::integer,0)<>0
           or jsonb_array_length(coalesce(v_paid_preflight->'errors','[]'::jsonb))<>0 then
          raise exception 'PAID_TSFIN_ROLLOVER_ORDINARY_SOURCE_PREFLIGHT_INVALID' using errcode='P0001';
        end if;
        v_paid_rollover:=public.timesheet_paid_uninvoiced_rollover_v1(
          v_paid_timesheet_id,p_actor_user_id,v_review_operation_id,v_paid_current_tf.id,
          v_paid_preflight->>'preflight_fingerprint',v_now);
        v_paid_historical_id:=nullif(v_paid_rollover->>'historical_paid_tsfin_id','')::uuid;
        v_paid_shell_id:=nullif(v_paid_rollover->>'new_current_tsfin_id','')::uuid;
        v_paid_mode:='CREATED_CURRENT_OPERATION_SHELL';
        if coalesce((v_paid_rollover->>'ok')::boolean,false) is not true
           or v_paid_historical_id is distinct from v_paid_current_tf.id
           or v_paid_shell_id is null
           or not exists(select 1 from public.timesheets_financials shell
             where shell.id=v_paid_shell_id and shell.timesheet_id=v_paid_timesheet_id and shell.is_current
               and shell.paid_at_utc is null and shell.processing_status='PENDING_AUTH'::public.ts_fin_processing_status_enum
               and shell.stale_reason='IMPORT_PAID_TSFIN_ROLLOVER_PENDING_CALCULATION'
               and coalesce((shell.policy_snapshot_json->>'requires_frozen_correction_policy')::boolean,false)
               and shell.policy_snapshot_json->>'import_apply_operation_id'=v_review_operation_id::text
               and shell.policy_snapshot_json->>'rollover_source_tsfin_id'=v_paid_historical_id::text)
           or (select count(*) from public.timesheets_financials shell
             where shell.timesheet_id=v_paid_timesheet_id and shell.is_current)<>1 then
          raise exception 'PAID_TSFIN_ROLLOVER_ORDINARY_SOURCE_PREFLIGHT_INVALID' using errcode='P0001';
        end if;
      else
        -- Reuse only a settled shell from a completed prior operation whose own
        -- frozen contract and paid lineage prove it, then compare only stable
        -- policy facts with this operation.
        if v_paid_current_tf.locked_by_invoice_id is not null
           or exists(select 1 from public.invoice_lines il where il.timesheet_id=v_paid_timesheet_id)
           or v_paid_current_tf.authorised_at_utc is not null
           or v_paid_current_tf.processing_status<>'PENDING_AUTH'::public.ts_fin_processing_status_enum
           or coalesce(v_paid_current_tf.is_stale,false)
           or v_paid_current_tf.stale_reason is not null
           or not coalesce((v_paid_current_tf.policy_snapshot_json->>'requires_frozen_correction_policy')::boolean,false)
         or coalesce(v_paid_current_tf.policy_snapshot_json->>'import_apply_operation_id','')!~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
         or coalesce(v_paid_current_tf.policy_snapshot_json->>'rollover_source_tsfin_id','')!~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
           or nullif(v_paid_current_tf.policy_snapshot_json->>'rollover_source_paid_digest','') is null then
          raise exception 'IMPORT_REVIEW_PAID_ROLLOVER_SHELL_INVALID' using errcode='P0001';
        end if;
        select origin.* into v_paid_origin_operation from public.import_apply_operations origin
        where origin.id=(v_paid_current_tf.policy_snapshot_json->>'import_apply_operation_id')::uuid for update;
        if not found or v_paid_origin_operation.state<>'COMPLETE' then
          raise exception 'IMPORT_REVIEW_PAID_ROLLOVER_SHELL_ORIGIN_INCOMPLETE' using errcode='P0001';
        end if;
        v_paid_origin_contract:=v_paid_origin_operation.response_json#>'{correction_operation_contract}';
        v_paid_origin_contract_fingerprint:=encode(extensions.digest(convert_to(
          (v_paid_origin_contract-'operation_contract_fingerprint')::text,'UTF8'),'sha256'),'hex');
        if jsonb_typeof(v_paid_origin_contract)<>'object'
           or v_paid_origin_contract->>'operation_contract_fingerprint' is distinct from v_paid_origin_contract_fingerprint then
          raise exception 'IMPORT_REVIEW_PAID_ROLLOVER_SHELL_INVALID' using errcode='P0001';
        end if;
        select count(*)::integer,min(origin_unit::text)::jsonb
        into v_paid_origin_policy_count,v_paid_origin_policy_unit
        from jsonb_array_elements(coalesce(v_paid_origin_contract->'correction_units','[]'::jsonb)) origin_unit
        where origin_unit->>'root_timesheet_id'=v_paid_timesheet_id::text
          and origin_unit->>'source_row_key'=v_paid_unit->>'source_identity';
        if v_paid_origin_policy_count<>1
           or v_paid_origin_policy_unit->'policy_envelope' is distinct from
             v_paid_current_tf.policy_snapshot_json->'correction_financials_policy_envelope'
           or v_paid_origin_policy_unit->>'policy_envelope_fingerprint' is distinct from
             v_paid_current_tf.policy_snapshot_json->>'correction_financials_policy_envelope_fingerprint' then
          raise exception 'IMPORT_REVIEW_PAID_ROLLOVER_SHELL_INVALID' using errcode='P0001';
        end if;
        select historical.* into v_paid_historical_tf from public.timesheets_financials historical
        where historical.id=(v_paid_current_tf.policy_snapshot_json->>'rollover_source_tsfin_id')::uuid
          and historical.timesheet_id=v_paid_timesheet_id and not historical.is_current
          and historical.paid_at_utc is not null and historical.locked_by_invoice_id is null;
        if not found then raise exception 'IMPORT_REVIEW_PAID_ROLLOVER_SHELL_INVALID' using errcode='P0001'; end if;
        v_paid_digest:=encode(extensions.digest(convert_to(jsonb_build_object(
          'id',v_paid_historical_tf.id::text,'timesheet_id',v_paid_historical_tf.timesheet_id::text,
          'timesheet_version',v_paid_historical_tf.timesheet_version,'paid_at_utc',v_paid_historical_tf.paid_at_utc,
          'paid_by_user_id',case when v_paid_historical_tf.paid_by_user_id is null then null else v_paid_historical_tf.paid_by_user_id::text end,
          'payment_reference',v_paid_historical_tf.payment_reference,'total_hours',v_paid_historical_tf.total_hours,
          'total_pay_ex_vat',v_paid_historical_tf.total_pay_ex_vat,'total_charge_ex_vat',v_paid_historical_tf.total_charge_ex_vat,
          'pay_vat_rate_pct_snapshot',v_paid_historical_tf.pay_vat_rate_pct_snapshot,
          'pay_vat_amount_snapshot',v_paid_historical_tf.pay_vat_amount_snapshot,
          'pay_total_inc_vat_snapshot',v_paid_historical_tf.pay_total_inc_vat_snapshot,
          'policy_snapshot_json',v_paid_historical_tf.policy_snapshot_json,'rate_source_refs_json',v_paid_historical_tf.rate_source_refs_json,
          'actual_schedule_json',v_paid_historical_tf.actual_schedule_json)::text,'UTF8'),'sha256'),'hex');
        if v_paid_digest is distinct from v_paid_current_tf.policy_snapshot_json->>'rollover_source_paid_digest' then
          raise exception 'IMPORT_REVIEW_PAID_ROLLOVER_SHELL_INVALID' using errcode='P0001';
        end if;
        if v_paid_origin_contract->>'source_system' is distinct from v_paid_current_contract->>'source_system'
           or v_paid_origin_policy_unit#>>'{policy_envelope,classification,source_shift_id}' is distinct from v_paid_current_policy#>>'{classification,source_shift_id}'
           or v_paid_origin_policy_unit#>>'{policy_envelope,classification,source_row_key}' is distinct from v_paid_current_policy#>>'{classification,source_row_key}'
           or v_paid_origin_policy_unit#>>'{policy_envelope,root_timesheet_id}' is distinct from v_paid_current_policy->>'root_timesheet_id'
           or v_paid_origin_policy_unit#>>'{policy_envelope,replacement,leg_fingerprint}' is distinct from v_paid_current_policy#>>'{replacement,leg_fingerprint}'
           or v_paid_origin_policy_unit#>>'{policy_envelope,replacement,tsfin_policy,tsfin_policy_fingerprint}' is distinct from v_paid_current_policy#>>'{replacement,tsfin_policy,tsfin_policy_fingerprint}'
           or v_paid_origin_policy_unit#>>'{policy_envelope,replacement,invoice_policy,invoice_policy_fingerprint}' is distinct from v_paid_current_policy#>>'{replacement,invoice_policy,invoice_policy_fingerprint}'
           or v_paid_origin_policy_unit#>>'{policy_envelope,replacement,invoice_policy,invoice_stream}' is distinct from v_paid_current_policy#>>'{replacement,invoice_policy,invoice_stream}' then
          raise exception 'IMPORT_REVIEW_PAID_ROLLOVER_SHELL_POLICY_CHANGED' using errcode='P0001';
        end if;
        v_paid_historical_id:=v_paid_historical_tf.id;
        v_paid_shell_id:=v_paid_current_tf.id;
        v_paid_mode:='REUSED_COMPLETED_OPERATION_SHELL';
      end if;

      v_paid_applied:=jsonb_build_object(
        'applied_timesheet_id',v_paid_timesheet_id,'rollover_mode',v_paid_mode,
        'historical_paid_tsfin_id',v_paid_historical_id,'current_shell_tsfin_id',v_paid_shell_id,
        'intended_authorisation_action',v_paid_intent,
        'reviewed_unit_fingerprint',v_paid_unit->>'unit_fingerprint',
        'reconciliation_fingerprint',v_paid_unit->>'reconciliation_fingerprint');
      update pg_temp.import_review_reconciliation_units_v1 applied_unit
      set unit_json=applied_unit.unit_json||v_paid_applied||jsonb_build_object(
        'applied_result_fingerprint',encode(extensions.digest(convert_to(v_paid_applied::text,'UTF8'),'sha256'),'hex'))
      where applied_unit.action_id=v_paid_unit->>'action_id';
      v_paid_applied_timesheet_ids:=array_append(v_paid_applied_timesheet_ids,v_paid_timesheet_id);
    end loop;

    v_mode_b_should_run_phase3 := (v_invoiced_changed_keys_count > 0);

    v_steps := v_steps || jsonb_build_array(
      jsonb_build_object(
        'step','CHANGED_HOURS_PARTITIONED',
        'invoiced_changed_keys_count', v_invoiced_changed_keys_count,
        'not_invoiced_changed_keys_count', v_not_invoiced_changed_keys_count
      )
    );

    create temporary table tmp_selected_replacement_keys(
      candidate_id uuid,
      client_id uuid,
      old_work_date date,
      replacement_day_key text
    ) on commit drop;

    if array_length(v_force_keys_final, 1) is not null then
      create temporary table tmp_sel_truth_p2 on commit drop as
      select
        m.external_row_key,
        m.candidate_id,
        m.client_id,
        m.work_date as import_work_date
      from tmp_p2_ok_mode m
      where m.mode = 'MODE_B'
        and m.external_row_key = any(v_force_keys_final);

      create temporary table tmp_existing_by_key on commit drop as
      select distinct on (ns.external_row_key)
        ns.external_row_key,
        ns.id as shift_id,
        ns.candidate_id as candidate_id,
        ns.client_id as client_id,
        ns.work_date as old_work_date
      from public.nhsp_shifts ns
      where ns.source_system = 'HEALTHROSTER'::public.hr_source_enum
        and ns.client_id = v_import_client_id
        and ns.cancelled_at_utc is null
        and ns.external_row_key = any(v_force_keys_final)
        and ns.work_date is not null
      order by ns.external_row_key, ns.updated_at desc nulls last, ns.created_at desc nulls last;

      insert into tmp_selected_replacement_keys(candidate_id, client_id, old_work_date, replacement_day_key)
      select distinct
        (coalesce(ex.candidate_id, st.candidate_id))::uuid as candidate_id,
        (coalesce(ex.client_id, st.client_id))::uuid as client_id,
        ex.old_work_date as old_work_date,
        ((coalesce(ex.candidate_id, st.candidate_id))::text || '|' ||
         (coalesce(ex.client_id, st.client_id))::text || '|' ||
         (ex.old_work_date)::text) as replacement_day_key
      from tmp_sel_truth_p2 st
      join tmp_existing_by_key ex
        on ex.external_row_key = st.external_row_key
      where ex.old_work_date is not null
        and st.import_work_date is not null
        and ex.old_work_date <> st.import_work_date;

      select coalesce(array_agg(x::text), array[]::text[])
      into v_selected_cancel_shift_id_set
      from unnest(coalesce(v_selected_cancel_shift_ids, array[]::uuid[])) as x;

      if exists (select 1 from tmp_selected_replacement_keys) then
        create temporary table tmp_required_cancel_ids on commit drop as
        select distinct
          rk.replacement_day_key,
          ns2.id as shift_id
        from tmp_selected_replacement_keys rk
        join public.nhsp_shifts ns2
          on ns2.source_system = 'HEALTHROSTER'::public.hr_source_enum
         and ns2.client_id = v_import_client_id
         and ns2.cancelled_at_utc is null
         and ns2.candidate_id = rk.candidate_id
         and ns2.client_id = rk.client_id
         and ns2.work_date = rk.old_work_date;

        if exists (
          select 1
          from tmp_required_cancel_ids rc
          left join unnest(coalesce(v_selected_cancel_shift_id_set, array[]::text[])) as sel(shift_id_text)
            on sel.shift_id_text = rc.shift_id::text
          where sel.shift_id_text is null
        ) then
          raise exception 'hr_weekly_apply_transactional: Policy A violation (replacement-day selected without selecting all required cancellations).';
        end if;
      end if;
    end if;

    v_steps := v_steps || jsonb_build_array(jsonb_build_object('step','POLICY_A_OK'));

    if v_mode_b_should_run_phase3 then
      select public.hr_weekly_phase3_apply_adjustment_truth(
        p_import_id := p_import_id,
        p_selected_external_row_keys := v_invoiced_changed_keys,
        p_actor_user_id := p_actor_user_id
      )
      into v_phase3_result;

      v_mode_b_phase3_called := true;
    end if;

    v_phase3_created_count := jsonb_array_length(coalesce(v_phase3_result->'created_timesheet_ids', '[]'::jsonb));
    v_phase3_updated_count := jsonb_array_length(coalesce(v_phase3_result->'updated_timesheet_ids', '[]'::jsonb));

    v_steps := v_steps || jsonb_build_array(
      jsonb_build_object(
        'step','PHASE3_CORRECTIONS_DONE',
        'phase3_called', v_mode_b_phase3_called,
        'phase3_created_count', v_phase3_created_count,
        'phase3_updated_count', v_phase3_updated_count
      )
    );

    if v_mode_b_should_run_phase1 then
      select public.hr_autoprocess_apply_phase1(
        import_id := p_import_id,
        selected_group_ids := array[]::text[],
        p_skip_external_row_keys := v_skip_keys_final,
        p_force_overwrite_external_row_keys := v_force_keys_final
      )
      into v_phase1_result;

      v_mode_b_phase1_called := true;

      v_phase1_shifts_created :=
        case
          when v_phase1_result is not null
           and jsonb_typeof(v_phase1_result) = 'object'
           and (v_phase1_result ? 'shifts_created')
           and (v_phase1_result->>'shifts_created') ~ '^[0-9]+$'
          then (v_phase1_result->>'shifts_created')::int
          else null
        end;

      v_phase1_shifts_updated :=
        case
          when v_phase1_result is not null
           and jsonb_typeof(v_phase1_result) = 'object'
           and (v_phase1_result ? 'shifts_updated')
           and (v_phase1_result->>'shifts_updated') ~ '^[0-9]+$'
          then (v_phase1_result->>'shifts_updated')::int
          else null
        end;

      if v_mode_b_should_run_phase15 then
        create temporary table tmp_phase15_rows on commit drop as
        select *
        from public.weekly_import_apply_phase2(p_import_id := p_import_id, p_system_type := 'HR_WEEKLY');

        select count(*)::int
        into v_phase15_ok
        from tmp_phase15_rows r
        where upper(coalesce(r.action::text,'')) = 'OK';

        select count(*)::int
        into v_phase15_updated
        from tmp_phase15_rows r
        where coalesce(r.shift_updated,false) is true;

        v_mode_b_phase15_called := true;
      end if;
    end if;

    v_steps := v_steps || jsonb_build_array(
      jsonb_build_object(
        'step','PHASE1_PHASE15_DONE',
        'phase1_called', v_mode_b_phase1_called,
        'phase15_called', v_mode_b_phase15_called,
        'phase1_shifts_created', v_phase1_shifts_created,
        'phase1_shifts_updated', v_phase1_shifts_updated,
        'phase15_ok_rows', v_phase15_ok,
        'phase15_shift_updated_rows', v_phase15_updated
      )
    );

    if v_mode_b_should_run_cancellations then
      create temporary table tmp_cancel_meta on commit drop as
      select
        ns.id as shift_id,
        ns.candidate_id,
        ns.client_id,
        ns.work_date
      from public.nhsp_shifts ns
      where ns.id = any(coalesce(v_selected_cancel_shift_ids, array[]::uuid[]));

      create temporary table tmp_selected_rep_keys_text on commit drop as
      select distinct rk.replacement_day_key
      from tmp_selected_replacement_keys rk;

      select coalesce(
        jsonb_agg(
          jsonb_build_object(
            'shift_id', cm.shift_id::text,
            'reason',
              case
                when exists (
                  select 1
                  from tmp_selected_rep_keys_text sr
                  where sr.replacement_day_key = (cm.candidate_id::text || '|' || cm.client_id::text || '|' || cm.work_date::text)
                ) then 'REPLACEMENT_DAY'
                else 'MISSING_FROM_IMPORT'
              end
          )
        ),
        '[]'::jsonb
      )
      into v_cancel_actions
      from tmp_cancel_meta cm;

      select public.weekly_import_apply_cancellations(
        p_import_id := p_import_id,
        p_actions := v_cancel_actions,
        p_actor_user_id := p_actor_user_id
      )
      into v_cancellations_result;

      v_mode_b_cancellations_called := true;
    end if;

    v_steps := v_steps || jsonb_build_array(jsonb_build_object('step','CANCELLATIONS_DONE'));

    -- ─────────────────────────────────────────────
    -- 8.5) ENSURE BASE WEEKLY TIMESHEET + ATTACH ACTIVE HEALTHROSTER MODE_B SHIFTS
    --
    -- Policy X guardrail:
    --   * This block runs only for HEALTHROSTER MODE_B / import-authoritative groups.
    --   * It creates/reuses the canonical weekly timesheet container and links active
    --     imported shifts to that container.
    --   * It does not use imported shift identifiers as Banking Pay economic keys.
    --   * It refuses to silently relink protected detached rows.
    -- ─────────────────────────────────────────────
    v_steps := v_steps || jsonb_build_array(jsonb_build_object('step','HR_MODE_B_ENSURE_BASE_WEEKLY_START'));

    drop table if exists pg_temp.tmp_hr_mode_b_groups;
    create temporary table tmp_hr_mode_b_groups(
      contract_id uuid not null,
      candidate_id uuid not null,
      client_id uuid not null,
      week_ending_date date not null,
      primary key (contract_id, candidate_id, client_id, week_ending_date)
    ) on commit drop;

    insert into tmp_hr_mode_b_groups(contract_id, candidate_id, client_id, week_ending_date)
    select distinct
      p2ok.contract_id,
      p2ok.candidate_id,
      p2ok.client_id,
      p2ok.week_ending_date
    from tmp_p2_ok_mode p2ok
    where p2ok.mode = 'MODE_B'
      and p2ok.external_row_key = any(coalesce(v_force_keys_final, array[]::text[]))
      and p2ok.contract_id is not null
      and p2ok.candidate_id is not null
      and p2ok.client_id is not null
      and p2ok.week_ending_date is not null
    on conflict do nothing;

    if array_length(v_selected_cancel_shift_ids, 1) is not null then
      insert into tmp_hr_mode_b_groups(contract_id, candidate_id, client_id, week_ending_date)
      select distinct
        ns.contract_id,
        ns.candidate_id,
        ns.client_id,
        ns.week_ending_date
      from public.nhsp_shifts ns
      join public.contracts c_cancel on c_cancel.id = ns.contract_id
      cross join lateral public._import_review_effective_authority_core_v1(
        'HR_WEEKLY',c_cancel.id,c_cancel.client_id,ns.week_ending_date) a_cancel
      where ns.id = any(v_selected_cancel_shift_ids)
        and ns.source_system = 'HEALTHROSTER'::public.hr_source_enum
        and ns.client_id = v_import_client_id
        and ns.contract_id is not null
        and ns.candidate_id is not null
        and ns.client_id is not null
        and ns.week_ending_date is not null
        and a_cancel.import_authoritative
      on conflict do nothing;
    end if;

    -- Include all active HealthRoster shifts in the affected MODE_B groups.  This
    -- makes the transaction repair the whole canonical week bucket, not just the
    -- single selected row, while staying inside the MODE_B classification.
    insert into tmp_hr_mode_b_groups(contract_id, candidate_id, client_id, week_ending_date)
    select distinct
      ns.contract_id,
      ns.candidate_id,
      ns.client_id,
      ns.week_ending_date
    from public.nhsp_shifts ns
    join tmp_group_mode gm2
      on gm2.contract_id = ns.contract_id
     and gm2.candidate_id = ns.candidate_id
     and gm2.client_id = ns.client_id
     and gm2.week_ending_date = ns.week_ending_date
     and gm2.mode = 'MODE_B'
    where ns.source_system = 'HEALTHROSTER'::public.hr_source_enum
      and ns.cancelled_at_utc is null
      and ns.contract_id is not null
      and ns.candidate_id is not null
      and ns.client_id is not null
      and ns.week_ending_date is not null
      and (
        ns.external_row_key = any(coalesce(v_force_keys_final, array[]::text[]))
        or ns.id = any(coalesce(v_selected_cancel_shift_ids, array[]::uuid[]))
        or exists (
          select 1
          from tmp_hr_mode_b_groups g0
          where g0.contract_id = ns.contract_id
            and g0.candidate_id = ns.candidate_id
            and g0.client_id = ns.client_id
            and g0.week_ending_date = ns.week_ending_date
        )
      )
    on conflict do nothing;

    select count(*)::int
    into v_ensure_pairs_count
    from tmp_hr_mode_b_groups g;

    select coalesce(jsonb_agg(jsonb_build_object(
      'contract_id', g.contract_id::text,
      'candidate_id', g.candidate_id::text,
      'client_id', g.client_id::text,
      'week_ending_date', g.week_ending_date::text
    )), '[]'::jsonb)
    into v_ensure_sample_pairs
    from (
      select g.contract_id, g.candidate_id, g.client_id, g.week_ending_date
      from tmp_hr_mode_b_groups g
      order by g.contract_id::text, g.candidate_id::text, g.client_id::text, g.week_ending_date::text
      limit 20
    ) as g;

    drop table if exists pg_temp.tmp_hr_mode_b_created_ts_ids;
    create temporary table tmp_hr_mode_b_created_ts_ids(
      timesheet_id uuid primary key
    ) on commit drop;

    drop table if exists pg_temp.tmp_hr_mode_b_protected_shift_ids;
    create temporary table tmp_hr_mode_b_protected_shift_ids(
      shift_id uuid primary key,
      reason text not null
    ) on commit drop;

    for v_pair_contract_id, v_pair_candidate_id, v_pair_client_id, v_pair_week_ending_date in
      select g.contract_id, g.candidate_id, g.client_id, g.week_ending_date
      from tmp_hr_mode_b_groups g
      order by g.contract_id::text, g.candidate_id::text, g.client_id::text, g.week_ending_date::text
    loop
      select count(*)::int
      into v_active_count
      from public.nhsp_shifts ns_active
      where ns_active.source_system = 'HEALTHROSTER'::public.hr_source_enum
        and ns_active.cancelled_at_utc is null
        and ns_active.contract_id = v_pair_contract_id
        and ns_active.candidate_id = v_pair_candidate_id
        and ns_active.client_id = v_pair_client_id
        and ns_active.week_ending_date = v_pair_week_ending_date;

      if coalesce(v_active_count, 0) <= 0 then
        v_ensure_pairs_skipped_no_active := v_ensure_pairs_skipped_no_active + 1;
        continue;
      end if;

      v_base_week_id := null;
      v_base_week_ts_id := null;

      select cw0.id, cw0.timesheet_id
      into v_base_week_id, v_base_week_ts_id
      from public.contract_weeks cw0
      where cw0.contract_id = v_pair_contract_id
        and cw0.week_ending_date = v_pair_week_ending_date
        and cw0.is_adjustment is false
        and coalesce(cw0.additional_seq, 0) = 0
      limit 1
      for update;

      if v_base_week_id is null then
        insert into public.contract_weeks(
          contract_id,
          week_ending_date,
          additional_seq,
          status,
          submission_mode_snapshot,
          timesheet_id,
          planned_schedule_json,
          created_at,
          updated_at,
          is_adjustment
        )
        values (
          v_pair_contract_id,
          v_pair_week_ending_date,
          0,
          'SUBMITTED'::public.contract_week_status_enum,
          'MANUAL'::public.submission_mode_enum,
          null,
          null,
          v_now,
          v_now,
          false
        )
        returning id into v_base_week_id;

        v_ensure_base_week_created_count := v_ensure_base_week_created_count + 1;
        v_base_week_ts_id := null;
      else
        v_ensure_base_week_existing_count := v_ensure_base_week_existing_count + 1;
      end if;

      if v_base_week_ts_id is not null then
        select exists(
          select 1
          from public.timesheets tchk
          where tchk.timesheet_id = v_base_week_ts_id
            and tchk.is_current is true
            and tchk.revoked_at is null
          limit 1
        )
        into v_ts_exists;

        if v_ts_exists is not true then
          update public.contract_weeks cw0u
          set
            timesheet_id = null,
            updated_at = v_now
          where cw0u.id = v_base_week_id;

          v_ensure_timesheet_missing_reference_count := v_ensure_timesheet_missing_reference_count + 1;
          v_base_week_ts_id := null;
        end if;
      end if;

      -- Plan 6.2 G6-11 (proof/34 section 3, entry point E14): the base-week
      -- root this pair is about to re-point or promote.  Checked before the
      -- first write to that family in this iteration.  An unmanaged family is
      -- unaffected.
      if v_base_week_ts_id is not null then
        v_weekly_source_guard:=private.weekly_source_managed_root_guard_v1(v_base_week_ts_id);
        -- HANDOVER 2 round-5 ruling B3 and A4 (18 September 2026).  The refusal is
        -- NARROWED: it applies to a Weekly-Source managed root, to a bound or
        -- protected family whose identity cannot be resolved, to a family carrying
        -- protected pay evidence but no authorisation row
        -- (PROTECTED_ROOT_AUTHORITY_MISSING), and to the live-record-on-an-
        -- unauthorised-Timesheet contradiction, which must never be allowed to
        -- continue merely because managed is false.  An unrelated, UNBOUND ordinary
        -- family -- including a malformed one -- keeps exactly the behaviour it had
        -- before this feature was installed.  Absent, null and non-boolean take the
        -- unsafe value at every read (Part 1 addendum rule 4).
        if (coalesce((v_weekly_source_guard->>'managed')::boolean, true)
             and (coalesce((v_weekly_source_guard->>'ok')::boolean, true)
                  or coalesce((v_weekly_source_guard->>'weekly_source_bound')::boolean, true)))
           or coalesce((v_weekly_source_guard->>'authorisation_record_without_authorised_timesheet')::boolean, false)
           or (v_weekly_source_guard->>'protected_target_ownership_state') is not null then
          raise exception 'WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED'
            using errcode='55000',detail=jsonb_build_object(
              'code','WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED',
              'entry_point','E14:public.hr_weekly_apply_transactional',
              'block_reason','WEEKLY_SOURCE_MANAGED_ROOT',
              'refusal_basis', case
                -- HANDOVER 2 round-5 Part E: the trim-equivalent split family is a
                -- canonical booking-reference collision and must be named as one.
                -- WP-03 handoff N20: accept BOTH the installed token and the ruled name for one
                -- release, so the order of this edit and WP-03's rename cannot open a gap in
                -- which Office stops seeing the ruled name.
                when v_weekly_source_guard->>'reason' in (
                       'FAMILY_SPLIT_BY_WHITESPACE','BOOKING_REFERENCE_CANONICAL_COLLISION')
                  then 'BOOKING_REFERENCE_CANONICAL_COLLISION'
                when coalesce((v_weekly_source_guard->>'managed')::boolean, true) and coalesce((v_weekly_source_guard->>'ok')::boolean, true)
                  then 'WEEKLY_SOURCE_MANAGED_ROOT'
                when coalesce((v_weekly_source_guard->>'managed')::boolean, true)
                  then 'WEEKLY_SOURCE_BOUND_OR_PROTECTED_ROOT_UNRESOLVABLE'
                when coalesce((v_weekly_source_guard->>'authorisation_record_without_authorised_timesheet')::boolean, false)
                  then 'AUTHORISATION_RECORD_WITHOUT_AUTHORISED_TIMESHEET'
                else 'PROTECTED_ROOT_AUTHORITY_MISSING' end,
              'integrity_failure', not coalesce((v_weekly_source_guard->>'ok')::boolean,false),
              'timesheet_id',v_base_week_ts_id,
              'reason',v_weekly_source_guard->>'reason'
            )::text;
        end if;
      end if;

      select ct.display_site, ct.ward_hint, ct.role
      into v_contract_display_site, v_contract_ward_hint, v_contract_role
      from public.contracts ct
      where ct.id = v_pair_contract_id
      limit 1;

      select cand.display_name, cand.tms_ref
      into v_candidate_display_name, v_candidate_tms_ref
      from public.candidates cand
      where cand.id = v_pair_candidate_id
      limit 1;

      select cli.name
      into v_client_name
      from public.clients cli
      where cli.id = v_pair_client_id
      limit 1;

      v_occupant_norm := lower(coalesce(v_candidate_tms_ref, v_candidate_display_name, v_pair_candidate_id::text));
      v_hospital_norm := lower(coalesce(v_contract_display_site, v_client_name, v_pair_client_id::text));
      v_ward_norm := lower(coalesce(v_contract_ward_hint, 'contract'));
      v_role_norm := lower(coalesce(v_contract_role, 'weekly'));

      v_shift_label_norm := 'weekly-0';

      v_booking_base :=
        v_occupant_norm || '|' ||
        v_pair_week_ending_date::text || '|' ||
        v_hospital_norm || '|' ||
        v_ward_norm || '|' ||
        v_role_norm || '|' ||
        v_shift_label_norm;

      v_hash_hex := encode(extensions.digest(convert_to(v_booking_base, 'utf8'), 'sha256'::text), 'hex');
      v_booking_id := 'bk_' || substr(v_hash_hex, 1, 16);

      if v_base_week_ts_id is null then
        v_new_ts_id := null;

        insert into public.timesheets(
          booking_id,
          version,
          is_current,
          status,

          sheet_scope,
          submission_mode,
          line_type,
          authorised_at_server,

          occupant_key_norm,
          hospital_norm,
          ward_norm,
          job_title_norm,
          shift_label_norm,

          week_ending_date,
          contract_id,

          manual_pdf_r2_key,
          actual_schedule_json,

          qr_payload_json,
          candidate_hint_text,

          is_adjustment,
          parent_timesheet_id,
          correction_id,
          correction_kind,
          adjustment_origin,

          created_at,
          updated_at
        )
        values (
          v_booking_id,
          1,
          true,
          'RECEIVED'::public.timesheet_status_enum,

          'WEEKLY'::public.timesheet_scope_enum,
          'MANUAL'::public.submission_mode_enum,
          'HOURS'::public.timesheet_line_type_enum,
          null,

          v_occupant_norm,
          v_hospital_norm,
          v_ward_norm,
          v_role_norm,
          v_shift_label_norm,

          v_pair_week_ending_date,
          v_pair_contract_id,

          null,
          '[]'::jsonb,

          '{}'::jsonb,
          null,

          false,
          null,
          null,
          null,
          null,

          v_now,
          v_now
        )
        returning timesheet_id into v_new_ts_id;

        v_ensure_timesheet_created_count := v_ensure_timesheet_created_count + 1;
        v_base_week_ts_id := v_new_ts_id;

        insert into tmp_hr_mode_b_created_ts_ids(timesheet_id)
        values (v_new_ts_id)
        on conflict do nothing;

        update public.contract_weeks cw0link
        set
          timesheet_id = v_new_ts_id,
          status = case
            when cw0link.status = 'AUTHORISED'::public.contract_week_status_enum then cw0link.status
            else 'SUBMITTED'::public.contract_week_status_enum
          end,
          submission_mode_snapshot = 'MANUAL'::public.submission_mode_enum,
          updated_at = v_now
        where cw0link.id = v_base_week_id;

        perform public._audit_insert(
          'timesheets',
          v_new_ts_id::text,
          'HEALTHROSTER_IMPORT_TIMESHEET_CREATED',
          null,
          jsonb_build_object(
            'import_id', p_import_id::text,
            'source_system', 'HEALTHROSTER',
            'mode', 'MODE_B',
            'kind', 'BASE_WEEKLY',
            'contract_id', v_pair_contract_id::text,
            'contract_week_id', v_base_week_id::text,
            'candidate_id', v_pair_candidate_id::text,
            'client_id', v_pair_client_id::text,
            'week_ending_date', v_pair_week_ending_date::text,
            'booking_id', v_booking_id,
            'active_shifts_count', v_active_count
          ),
          'IMPORT_BIRTH',
          p_actor_user_id
        );
      else
        v_ensure_timesheet_reused_count := v_ensure_timesheet_reused_count + 1;

        update public.contract_weeks cw0keep
        set
          status = case
            when cw0keep.status = 'AUTHORISED'::public.contract_week_status_enum then cw0keep.status
            else 'SUBMITTED'::public.contract_week_status_enum
          end,
          submission_mode_snapshot = 'MANUAL'::public.submission_mode_enum,
          updated_at = v_now
        where cw0keep.id = v_base_week_id;

        if exists (
          select 1
          from public.timesheets identity_target
          where identity_target.timesheet_id=v_base_week_ts_id
            and (
              identity_target.week_ending_date is distinct from v_pair_week_ending_date
              or identity_target.contract_id is distinct from v_pair_contract_id
              or identity_target.occupant_key_norm is distinct from v_occupant_norm
              or identity_target.hospital_norm is distinct from v_hospital_norm
              or identity_target.ward_norm is distinct from v_ward_norm
              or identity_target.job_title_norm is distinct from v_role_norm
            )
        ) then
          select public.import_timesheet_financial_preflight_v1(
            p_timesheet_ids := array[v_base_week_ts_id]::uuid[],
            p_action := 'IMPORT_FINANCIAL_IDENTITY_CHANGE',
            p_actor_user_id := p_actor_user_id,
            p_expected_state_json := '{}'::jsonb,
            p_lock_rows := true,
            p_max_scope := 100
          ) into v_changed_preflight;

          if coalesce((v_changed_preflight->>'allowed')::boolean,false) is not true then
            raise exception using message='IMPORT_FINANCIAL_PREFLIGHT_BLOCKED',errcode='P0001',detail=v_changed_preflight::text;
          end if;

          if v_changed_preflight->>'required_path'='CREATE_OR_UPDATE_CORRECTION_CHAIN' then
            raise exception using message='IMPORT_INVOICED_CORRECTION_REQUIRED',errcode='P0001',
              detail=jsonb_build_object(
                'code','IMPORT_INVOICED_CORRECTION_REQUIRED','timesheet_id',v_base_week_ts_id,
                'reason','FINANCIAL_IDENTITY_CHANGE',
                'required_path','CREATE_OR_UPDATE_CORRECTION_CHAIN'
              )::text;
          elsif v_changed_preflight->>'required_path'='UNAUTHORISE_AMEND_RECALCULATE_REAUTHORISE' then
            raise exception using message='CANONICAL_UNAUTHORISE_REQUIRED',errcode='P0001',
              detail=jsonb_build_object(
                'code','CANONICAL_UNAUTHORISE_REQUIRED','timesheet_id',v_base_week_ts_id,
                'reason','FINANCIAL_IDENTITY_CHANGE',
                'required_path',jsonb_build_array('UNAUTHORISE','AMEND','RECALCULATE','REAUTHORISE'),
                'paid_uninvoiced_rollover_required',false
              )::text;
          elsif v_changed_preflight->>'required_path'='PAID_UNINVOICED_ROLLOVER'
            and not exists (
              select 1 from public.timesheets_financials rollover_identity
              where rollover_identity.timesheet_id=v_base_week_ts_id
                and rollover_identity.is_current=true
                and rollover_identity.stale_reason='IMPORT_PAID_TSFIN_ROLLOVER_PENDING_CALCULATION'
                and coalesce((rollover_identity.policy_snapshot_json->>'requires_frozen_correction_policy')::boolean,false)=true
            ) then
            raise exception using message='PAID_UNINVOICED_ROLLOVER_REQUIRED',errcode='P0001',
              detail=jsonb_build_object(
                'code','PAID_UNINVOICED_ROLLOVER_REQUIRED','timesheet_id',v_base_week_ts_id,
                'reason','FINANCIAL_IDENTITY_CHANGE',
                'required_path',jsonb_build_array(
                  'UNAUTHORISE','PAID_UNINVOICED_ROLLOVER','AMEND','RECALCULATE','REAUTHORISE'
                ),
                'invoice_policy_without_history','NOW'
              )::text;
          end if;
        end if;

        update public.timesheets tnorm
        set
          is_current = true,
          status = 'RECEIVED'::public.timesheet_status_enum,
          sheet_scope = 'WEEKLY'::public.timesheet_scope_enum,
          submission_mode = 'MANUAL'::public.submission_mode_enum,
          line_type = 'HOURS'::public.timesheet_line_type_enum,
          week_ending_date = v_pair_week_ending_date,
          contract_id = v_pair_contract_id,
          occupant_key_norm = v_occupant_norm,
          hospital_norm = v_hospital_norm,
          ward_norm = v_ward_norm,
          job_title_norm = v_role_norm,
          shift_label_norm = v_shift_label_norm,
          updated_at = v_now
        where tnorm.timesheet_id = v_base_week_ts_id;
      end if;

      truncate table tmp_hr_mode_b_protected_shift_ids;

      insert into tmp_hr_mode_b_protected_shift_ids(shift_id, reason)
      select distinct
        ns_lock.id,
        case
          when ns_lock.invoice_id is not null then 'SHIFT_INVOICED'
          when tf_lock.timesheet_id is not null then 'TIMESHEET_FINANCIALS_LOCKED_OR_PAID'
          when pbi_lock.timesheet_id is not null then 'PAY_BATCH_ITEM_EXISTS'
          when t_lock.timesheet_id is not null then 'CORRECTION_OR_ADJUSTMENT_OWNED_TIMESHEET'
          else 'PROTECTED_DETACHED_OR_INVALID_LINK'
        end as reason
      from public.nhsp_shifts ns_lock
      left join public.timesheets_financials tf_lock
        on tf_lock.timesheet_id = ns_lock.timesheet_id
       and tf_lock.is_current is true
       and (
         tf_lock.locked_by_invoice_id is not null
         or tf_lock.paid_at_utc is not null
       )
      left join public.pay_batch_items pbi_lock
        on pbi_lock.timesheet_id = ns_lock.timesheet_id
       and coalesce(pbi_lock.is_voided, false) is false
      left join public.timesheets t_lock
        on t_lock.timesheet_id = ns_lock.timesheet_id
       and (
         coalesce(t_lock.is_adjustment, false) is true
         or t_lock.parent_timesheet_id is not null
         or t_lock.correction_id is not null
         or t_lock.correction_kind is not null
         or t_lock.adjustment_origin is not null
       )
      where ns_lock.source_system = 'HEALTHROSTER'::public.hr_source_enum
        and ns_lock.cancelled_at_utc is null
        and ns_lock.contract_id = v_pair_contract_id
        and ns_lock.candidate_id = v_pair_candidate_id
        and ns_lock.client_id = v_pair_client_id
        and ns_lock.week_ending_date = v_pair_week_ending_date
        and (
          ns_lock.timesheet_id is null
          or not exists (
            select 1
            from public.timesheets tvalid
            where tvalid.timesheet_id = ns_lock.timesheet_id
              and tvalid.is_current is true
              and tvalid.revoked_at is null
            limit 1
          )
        )
        and (
          ns_lock.invoice_id is not null
          or tf_lock.timesheet_id is not null
          or pbi_lock.timesheet_id is not null
          or t_lock.timesheet_id is not null
        )
      on conflict do nothing;

      select count(*)::int
      into v_active_count
      from tmp_hr_mode_b_protected_shift_ids p;

      if coalesce(v_active_count, 0) > 0 then
        raise exception
          'hr_weekly_apply_transactional: protected active HEALTHROSTER MODE_B shifts are detached or linked to an invalid timesheet; refusing silent relink. contract_id=% candidate_id=% client_id=% week_ending_date=% protected_count=% sample=%',
          v_pair_contract_id,
          v_pair_candidate_id,
          v_pair_client_id,
          v_pair_week_ending_date,
          v_active_count,
          (
            select coalesce(jsonb_agg(jsonb_build_object('shift_id', p2.shift_id::text, 'reason', p2.reason)), '[]'::jsonb)
            from (
              select p.shift_id, p.reason
              from tmp_hr_mode_b_protected_shift_ids p
              order by p.shift_id::text
              limit 10
            ) p2
          );
      end if;

      if exists (
        select 1 from public.nhsp_shifts ns_scope
        where ns_scope.source_system = 'HEALTHROSTER'::public.hr_source_enum
            and ns_scope.cancelled_at_utc is null
            and ns_scope.contract_id = v_pair_contract_id
            and ns_scope.candidate_id = v_pair_candidate_id
            and ns_scope.client_id = v_pair_client_id
            and ns_scope.week_ending_date = v_pair_week_ending_date
            and (
              ns_scope.timesheet_id is null
              or not exists (
                select 1 from public.timesheets existing_link
                where existing_link.timesheet_id=ns_scope.timesheet_id
                  and existing_link.is_current=true
                  and existing_link.revoked_at is null
              )
            )
            and not exists (
              select 1 from tmp_hr_mode_b_protected_shift_ids protected
              where protected.shift_id=ns_scope.id
            )
      ) then
        select public.import_timesheet_financial_preflight_v1(
          p_timesheet_ids := array[v_base_week_ts_id]::uuid[],
          p_action := 'IMPORT_SOURCE_ASSIGNMENT',
          p_actor_user_id := p_actor_user_id,
          p_expected_state_json := '{}'::jsonb,
          p_lock_rows := true,
          p_max_scope := 100
        ) into v_changed_preflight;

        if coalesce((v_changed_preflight->>'allowed')::boolean,false) is not true then
          raise exception using message='IMPORT_FINANCIAL_PREFLIGHT_BLOCKED',errcode='P0001',detail=v_changed_preflight::text;
        end if;

        if v_changed_preflight->>'required_path'='CREATE_OR_UPDATE_CORRECTION_CHAIN' then
          raise exception using message='IMPORT_INVOICED_CORRECTION_REQUIRED',errcode='P0001',
            detail=jsonb_build_object(
              'code','IMPORT_INVOICED_CORRECTION_REQUIRED','timesheet_id',v_base_week_ts_id,
              'reason','FINANCIAL_SOURCE_ASSIGNMENT_CHANGE',
              'required_path','CREATE_OR_UPDATE_CORRECTION_CHAIN'
            )::text;
        end if;

        if exists (
          select 1 from public.timesheets source_target
          left join public.timesheets_financials source_target_tf
            on source_target_tf.timesheet_id=source_target.timesheet_id and source_target_tf.is_current=true
          where source_target.timesheet_id=v_base_week_ts_id
            and (source_target.authorised_at_server is not null or source_target_tf.authorised_at_utc is not null)
            and not exists (
              select 1 from public.timesheets_financials paid_target
              where paid_target.timesheet_id=source_target.timesheet_id
                and paid_target.paid_at_utc is not null
            )
        ) then
          raise exception using message='CANONICAL_UNAUTHORISE_REQUIRED',errcode='P0001',
            detail=jsonb_build_object(
              'code','CANONICAL_UNAUTHORISE_REQUIRED','timesheet_id',v_base_week_ts_id,
              'reason','FINANCIAL_SOURCE_ASSIGNMENT_CHANGE',
              'required_path',jsonb_build_array('UNAUTHORISE','AMEND','RECALCULATE','REAUTHORISE'),
              'paid_uninvoiced_rollover_required',false
            )::text;
        end if;

        if exists (
          select 1 from public.timesheets_financials paid_source
          where paid_source.timesheet_id=v_base_week_ts_id and paid_source.paid_at_utc is not null
        ) and not exists (
          select 1 from public.timesheets_financials rollover_source
          where rollover_source.timesheet_id=v_base_week_ts_id and rollover_source.is_current=true
            and rollover_source.stale_reason='IMPORT_PAID_TSFIN_ROLLOVER_PENDING_CALCULATION'
            and coalesce((rollover_source.policy_snapshot_json->>'requires_frozen_correction_policy')::boolean,false)=true
        ) then
          raise exception using message='PAID_UNINVOICED_ROLLOVER_REQUIRED',errcode='P0001',
            detail=jsonb_build_object(
              'code','PAID_UNINVOICED_ROLLOVER_REQUIRED','timesheet_id',v_base_week_ts_id,
              'reason','FINANCIAL_SOURCE_ASSIGNMENT_CHANGE',
              'required_path',jsonb_build_array(
                'UNAUTHORISE','PAID_UNINVOICED_ROLLOVER','AMEND','RECALCULATE','REAUTHORISE'
              ),
              'invoice_policy_without_history','NOW'
            )::text;
        end if;
      end if;

      update public.nhsp_shifts nsu0
      set
        timesheet_id = v_base_week_ts_id,
        updated_at = v_now
      where nsu0.source_system = 'HEALTHROSTER'::public.hr_source_enum
        and nsu0.cancelled_at_utc is null
        and nsu0.contract_id = v_pair_contract_id
        and nsu0.candidate_id = v_pair_candidate_id
        and nsu0.client_id = v_pair_client_id
        and nsu0.week_ending_date = v_pair_week_ending_date
        and nsu0.timesheet_id is null
        and not exists (
          select 1
          from tmp_hr_mode_b_protected_shift_ids p
          where p.shift_id = nsu0.id
        );

      get diagnostics v_attached_null_count = row_count;
      v_ensure_shifts_attached_count := v_ensure_shifts_attached_count + coalesce(v_attached_null_count, 0);

      update public.nhsp_shifts nsu1
      set
        timesheet_id = v_base_week_ts_id,
        updated_at = v_now
      where nsu1.source_system = 'HEALTHROSTER'::public.hr_source_enum
        and nsu1.cancelled_at_utc is null
        and nsu1.contract_id = v_pair_contract_id
        and nsu1.candidate_id = v_pair_candidate_id
        and nsu1.client_id = v_pair_client_id
        and nsu1.week_ending_date = v_pair_week_ending_date
        and nsu1.timesheet_id is not null
        and not exists (
          select 1
          from public.timesheets tvalid2
          where tvalid2.timesheet_id = nsu1.timesheet_id
            and tvalid2.is_current is true
            and tvalid2.revoked_at is null
          limit 1
        )
        and not exists (
          select 1
          from tmp_hr_mode_b_protected_shift_ids p2
          where p2.shift_id = nsu1.id
        );

      get diagnostics v_relinked_invalid_count = row_count;
      v_ensure_shifts_relinked_invalid_ts_count := v_ensure_shifts_relinked_invalid_ts_count + coalesce(v_relinked_invalid_count, 0);

      select count(*)::int
      into v_active_count
      from public.nhsp_shifts nscheck
      where nscheck.source_system = 'HEALTHROSTER'::public.hr_source_enum
        and nscheck.cancelled_at_utc is null
        and nscheck.contract_id = v_pair_contract_id
        and nscheck.candidate_id = v_pair_candidate_id
        and nscheck.client_id = v_pair_client_id
        and nscheck.week_ending_date = v_pair_week_ending_date
        and (
          nscheck.timesheet_id is null
          or not exists (
            select 1
            from public.timesheets tchk2
            where tchk2.timesheet_id = nscheck.timesheet_id
              and tchk2.is_current is true
              and tchk2.revoked_at is null
            limit 1
          )
        );

      if coalesce(v_active_count, 0) > 0 then
        v_ensure_remaining_active_detached_count := v_ensure_remaining_active_detached_count + v_active_count;
        raise exception
          'hr_weekly_apply_transactional: ENSURE invariant failed (active HEALTHROSTER MODE_B shifts remain detached or linked to missing/non-current/revoked timesheets) contract_id=% candidate_id=% client_id=% week_ending_date=% remaining=%.',
          v_pair_contract_id, v_pair_candidate_id, v_pair_client_id, v_pair_week_ending_date, v_active_count;
      end if;

      insert into tmp_aff_ts(timesheet_id)
      values (v_base_week_ts_id)
      on conflict do nothing;
    end loop;

    select coalesce(jsonb_agg(x.ts_id), '[]'::jsonb)
    into v_ensure_sample_created_ts_ids
    from (
      select tct.timesheet_id::text as ts_id
      from tmp_hr_mode_b_created_ts_ids tct
      order by tct.timesheet_id::text
      limit 20
    ) as x;

    v_steps := v_steps || jsonb_build_array(jsonb_build_object(
      'step','HR_MODE_B_ENSURE_BASE_WEEKLY_DONE',
      'ensure_pairs_count', v_ensure_pairs_count,
      'ensure_pairs_skipped_no_active', v_ensure_pairs_skipped_no_active,
      'base_week_created_count', v_ensure_base_week_created_count,
      'base_week_existing_count', v_ensure_base_week_existing_count,
      'base_timesheet_created_count', v_ensure_timesheet_created_count,
      'base_timesheet_reused_count', v_ensure_timesheet_reused_count,
      'missing_timesheet_reference_count', v_ensure_timesheet_missing_reference_count,
      'shifts_attached_null_count', v_ensure_shifts_attached_count,
      'shifts_relinked_invalid_ts_count', v_ensure_shifts_relinked_invalid_ts_count,
      'remaining_active_detached_count', v_ensure_remaining_active_detached_count,
      'sample_pairs', v_ensure_sample_pairs,
      'sample_created_ts_ids', v_ensure_sample_created_ts_ids
    ));
  end if;

  -- ─────────────────────────────────────────────
  -- 9) MODE_A mirror ingestion
  -- ─────────────────────────────────────────────
  if array_length(v_mode_a_external_keys, 1) is not null then
    select public.hr_weekly_mirror_upsert_deterministic(
      p_import_id := p_import_id,
      p_external_row_keys := v_mode_a_external_keys,
      p_actor_user_id := p_actor_user_id
    )
    into v_mirror_result;
  end if;

  v_steps := v_steps || jsonb_build_array(jsonb_build_object('step','MODE_A_MIRROR_DONE'));

  -- ─────────────────────────────────────────────
  -- ✅ MODE_A shift→timesheet linking
  -- ─────────────────────────────────────────────
  create temporary table tmp_mode_a_ts_map(
    external_row_key text primary key,
    timesheet_id uuid not null
  ) on commit drop;

  insert into tmp_mode_a_ts_map(external_row_key, timesheet_id)
  select distinct
    p2m.external_row_key,
    cw0.timesheet_id
  from tmp_p2_ok_mode p2m
  join public.contract_weeks cw0
    on cw0.contract_id = p2m.contract_id
   and cw0.week_ending_date = p2m.week_ending_date
   and cw0.is_adjustment is false
   and coalesce(cw0.additional_seq, 0) = 0
  where p2m.mode = 'MODE_A'
    and p2m.external_row_key = any(coalesce(v_mode_a_external_keys,array[]::text[]))
    and p2m.external_row_key is not null
    and cw0.timesheet_id is not null
  on conflict do nothing;

  select count(*)::int
  into v_mode_a_ts_linked_count
  from tmp_mode_a_ts_map mt;

  create temporary table tmp_mode_a_locked_shift_ids(
    shift_id uuid primary key
  ) on commit drop;

  insert into tmp_mode_a_locked_shift_ids(shift_id)
  select distinct ns_lock.id as shift_id
  from public.nhsp_shifts ns_lock
  join tmp_mode_a_ts_map mt_lock
    on mt_lock.external_row_key = ns_lock.external_row_key
  where ns_lock.source_system = 'HEALTHROSTER'::public.hr_source_enum
    and ns_lock.cancelled_at_utc is null
    and ns_lock.latest_import_id = p_import_id
    and (
      ns_lock.invoice_id is not null
      or exists (
        select 1
        from public.timesheets_financials tf_lock
        cross join lateral jsonb_array_elements(coalesce(tf_lock.invoice_breakdown_json->'segments','[]'::jsonb)) as seg_lock(value)
        where tf_lock.is_current = true
          and tf_lock.timesheet_id = ns_lock.timesheet_id
          and nullif(btrim(seg_lock.value->>'nhsp_shift_id'), '') = ns_lock.id::text
          and nullif(btrim(seg_lock.value->>'invoice_locked_invoice_id'), '') is not null
        limit 1
      )
    )
  on conflict do nothing;

  update public.nhsp_shifts nsu
     set timesheet_id = mt.timesheet_id,
         updated_at = v_now
    from tmp_mode_a_ts_map mt
   where nsu.source_system = 'HEALTHROSTER'::public.hr_source_enum
     and nsu.cancelled_at_utc is null
     and nsu.latest_import_id = p_import_id
     and nsu.external_row_key = mt.external_row_key
     and (nsu.timesheet_id is distinct from mt.timesheet_id)
     and not exists (
       select 1
       from tmp_mode_a_locked_shift_ids l
       where l.shift_id = nsu.id
     );

  get diagnostics v_mode_a_shifts_attached_count = row_count;

  insert into tmp_aff_ts(timesheet_id)
  select distinct mt2.timesheet_id
  from tmp_mode_a_ts_map mt2
  where mt2.timesheet_id is not null
  on conflict do nothing;

  v_steps := v_steps || jsonb_build_array(
    jsonb_build_object(
      'step','MODE_A_SHIFTS_LINKED',
      'mode_a_ts_linked_count', v_mode_a_ts_linked_count,
      'mode_a_shifts_attached_count', v_mode_a_shifts_attached_count,
      'mode_a_locked_shift_count', (select count(*)::int from tmp_mode_a_locked_shift_ids)
    )
  );

  -- ─────────────────────────────────────────────
  -- 10) MODE_A weekly validation upserts + email state
  -- ─────────────────────────────────────────────
  select public.hr_weekly_validation_preview(p_import_id := p_import_id)
  into v_weekly_val_payload;

  if v_weekly_val_payload is null or jsonb_typeof(v_weekly_val_payload) <> 'object' then
    raise exception 'hr_weekly_apply_transactional: hr_weekly_validation_preview returned non-object payload.';
  end if;

  if jsonb_typeof(v_weekly_val_payload->'rows') <> 'array' then
    raise exception 'hr_weekly_apply_transactional: hr_weekly_validation_preview payload missing rows array.';
  end if;

  create temporary table tmp_val_rows on commit drop as
  select
    nullif(btrim(r.value->>'timesheet_id'), '')::uuid as timesheet_id,
    nullif(btrim(r.value->>'candidate_id'), '')::uuid as candidate_id,
    nullif(btrim(r.value->>'contract_id'), '')::uuid as contract_id,
    nullif(btrim(r.value->>'week_ending_date'), '')::date as week_ending_date,
    nullif(btrim(r.value->>'client_id'), '')::uuid as client_id,
    upper(coalesce(r.value->>'overall_status','')) as overall_status,
    (lower(coalesce(r.value->>'has_mismatch','false')) in ('true','1')) as has_mismatch,
    r.value as row_json
  from jsonb_array_elements(v_weekly_val_payload->'rows') as r(value)
  where nullif(btrim(r.value->>'timesheet_id'), '') is not null
    and nullif(btrim(r.value->>'candidate_id'), '') is not null
    and nullif(btrim(r.value->>'contract_id'), '') is not null
    and nullif(btrim(r.value->>'week_ending_date'), '') is not null
    and nullif(btrim(r.value->>'client_id'), '') is not null
    and exists (
      select 1 from tmp_mode_a_eligible_groups eligible
      where eligible.candidate_id=nullif(btrim(r.value->>'candidate_id'), '')::uuid
        and eligible.client_id=nullif(btrim(r.value->>'client_id'), '')::uuid
        and eligible.contract_id=nullif(btrim(r.value->>'contract_id'), '')::uuid
        and eligible.week_ending_date=nullif(btrim(r.value->>'week_ending_date'), '')::date
    );

  select count(*)::int
  into v_val_rows_count
  from tmp_val_rows;

  create temporary table tmp_val_mode on commit drop as
  select
    vr.timesheet_id,
    case aval.authority_mode when 'VALIDATION_ONLY' then 'MODE_A'
      when 'AUTHORITATIVE' then 'MODE_B' else 'OUT_OF_SCOPE' end as mode
  from tmp_val_rows vr
  join public.contracts cval
    on cval.id = vr.contract_id
  cross join lateral public._import_review_effective_authority_core_v1(
    'HR_WEEKLY',cval.id,cval.client_id,vr.week_ending_date) aval;

  if exists(select 1 from tmp_val_mode where mode='OUT_OF_SCOPE') then
    raise exception 'HR_WEEKLY_VALIDATION_AUTHORITY_OUT_OF_SCOPE' using errcode='40001';
  end if;

  create temporary table tmp_invalidation_actions(
    timesheet_id uuid not null,
    comparison_key text not null,
    invalidate boolean not null,
    primary key (timesheet_id, comparison_key)
  ) on commit drop;

  if v_invalidation_actions_count > 0 then
    insert into tmp_invalidation_actions(timesheet_id, comparison_key, invalidate)
    select
      nullif(btrim(a.value->>'timesheet_id'), '')::uuid as timesheet_id,
      nullif(btrim(a.value->>'comparison_key'), '') as comparison_key,
      (lower(coalesce(a.value->>'invalidate','true')) in ('true','1')) as invalidate
    from jsonb_array_elements(v_invalidation_actions) as a(value)
    where nullif(btrim(a.value->>'timesheet_id'), '') is not null
      and nullif(btrim(a.value->>'comparison_key'), '') is not null
    on conflict (timesheet_id, comparison_key) do update
      set invalidate = excluded.invalidate;
  end if;

  create temporary table tmp_mode_a_missing_ref_clear(
    timesheet_id uuid not null,
    comparison_key text not null,
    work_date date not null,
    ts_start_hhmm text not null,
    ts_end_hhmm text not null,
    ts_break_mins int not null,
    ref_before text null,
    primary key (timesheet_id, comparison_key)
  ) on commit drop;

  insert into tmp_mode_a_missing_ref_clear(timesheet_id, comparison_key, work_date, ts_start_hhmm, ts_end_hhmm, ts_break_mins, ref_before)
  select distinct
    vr.timesheet_id,
    nullif(btrim(coalesce(cx.value->>'comparison_key','')), '') as comparison_key,
    nullif(btrim(cx.value->>'work_date'), '')::date as work_date,
    nullif(btrim(cx.value->>'timesheet_start'), '') as ts_start_hhmm,
    nullif(btrim(cx.value->>'timesheet_end'), '') as ts_end_hhmm,
    coalesce(nullif(btrim(cx.value->>'timesheet_break_mins'), '')::int, 0) as ts_break_mins,
    nullif(btrim(cx.value->>'ref_before'), '') as ref_before
  from tmp_val_rows vr
  join tmp_val_mode vmc
    on vmc.timesheet_id = vr.timesheet_id
   and vmc.mode = 'MODE_A'
  cross join lateral jsonb_array_elements(coalesce(vr.row_json->'comparisons', '[]'::jsonb)) as cx(value)
  left join tmp_invalidation_actions ia
    on ia.timesheet_id = vr.timesheet_id
   and ia.comparison_key = nullif(btrim(coalesce(cx.value->>'comparison_key','')), '')
  where upper(coalesce(cx.value->>'match_status','')) in ('UNMATCHED','MISMATCH')
    and (lower(coalesce(cx.value->>'invoice_locked','false')) in ('true','1')) is false
    and nullif(btrim(coalesce(cx.value->>'invoice_locked_invoice_id','')), '') is null
    and nullif(btrim(coalesce(cx.value->>'ref_before','')), '') is not null
    and nullif(btrim(coalesce(cx.value->>'timesheet_start','')), '') is not null
    and nullif(btrim(coalesce(cx.value->>'timesheet_end','')), '') is not null
    and nullif(btrim(coalesce(cx.value->>'work_date','')), '') is not null
    and ia.timesheet_id is not null
    and ia.invalidate is true
  on conflict (timesheet_id, comparison_key) do nothing;

  -- ✅ Capture exact timesheets whose refs were cleared (for post-apply QR reissue + regen)
  drop table if exists pg_temp.tmp_mode_a_ref_clear_upd;
  create temporary table tmp_mode_a_ref_clear_upd(
    timesheet_id uuid not null
  ) on commit drop;

  with upd as (
    update public.nhsp_shifts nsclr
       set ref_num = null,
           hr_request_id = null,
           updated_at = v_now
      from tmp_mode_a_missing_ref_clear mrc
      left join public.timesheets_financials tfc
        on tfc.timesheet_id = mrc.timesheet_id
       and tfc.is_current = true
     where nsclr.source_system = 'HEALTHROSTER'::public.hr_source_enum
       and nsclr.cancelled_at_utc is null
       and nsclr.timesheet_id = mrc.timesheet_id
       and nsclr.work_date = mrc.work_date
       and nsclr.ref_num is not null
       and nsclr.invoice_id is null
       and (tfc.timesheet_id is null or (tfc.locked_by_invoice_id is null and tfc.paid_at_utc is null))
       and to_char((date_trunc('minute', nsclr.start_utc) at time zone 'Europe/London'), 'HH24:MI') = mrc.ts_start_hhmm
       and to_char((date_trunc('minute', nsclr.end_utc) at time zone 'Europe/London'), 'HH24:MI') = mrc.ts_end_hhmm
       and coalesce(nsclr.break_mins,0) = coalesce(mrc.ts_break_mins,0)
       and not exists (
         select 1
         from public.timesheets_financials tf_lock
         cross join lateral jsonb_array_elements(coalesce(tf_lock.invoice_breakdown_json->'segments','[]'::jsonb)) as seg(value)
         where tf_lock.is_current = true
           and tf_lock.timesheet_id = nsclr.timesheet_id
           and nullif(btrim(seg.value->>'nhsp_shift_id'), '') = nsclr.id::text
           and nullif(btrim(seg.value->>'invoice_locked_invoice_id'), '') is not null
         limit 1
       )
    returning nsclr.timesheet_id
  )
  insert into tmp_mode_a_ref_clear_upd(timesheet_id)
  select upd.timesheet_id
  from upd
  where upd.timesheet_id is not null;

  get diagnostics v_mode_a_ref_cleared_count = row_count;

  insert into tmp_ref_updated_ts(timesheet_id)
  select distinct u.timesheet_id
  from tmp_mode_a_ref_clear_upd u
  where u.timesheet_id is not null
  on conflict do nothing;

  insert into tmp_aff_ts(timesheet_id)
  select distinct u2.timesheet_id
  from tmp_mode_a_ref_clear_upd u2
  where u2.timesheet_id is not null
  on conflict do nothing;

  insert into tmp_aff_ts(timesheet_id)
  select distinct mrc2.timesheet_id
  from tmp_mode_a_missing_ref_clear mrc2
  where mrc2.timesheet_id is not null
  on conflict do nothing;

  v_steps := v_steps || jsonb_build_array(
    jsonb_build_object(
      'step','MODE_A_MISSING_SHIFT_REF_CLEARED',
      'ref_cleared_count', v_mode_a_ref_cleared_count,
      'invalidation_actions_count', v_invalidation_actions_count
    )
  );

  -- ─────────────────────────────────────────────
  -- ✅ MODE_A matched ref propagation (Request Id / booking reference)
  -- ─────────────────────────────────────────────
  drop table if exists pg_temp.tmp_mode_a_ref_set;
  create temporary table tmp_mode_a_ref_set(
    timesheet_id uuid not null,
    comparison_key text not null,
    work_date date not null,
    ts_start_hhmm text not null,
    ts_end_hhmm text not null,
    ts_break_mins int not null,
    ref_after text not null,
    primary key (timesheet_id, comparison_key)
  ) on commit drop;

  insert into tmp_mode_a_ref_set(timesheet_id, comparison_key, work_date, ts_start_hhmm, ts_end_hhmm, ts_break_mins, ref_after)
  select distinct
    vrm.timesheet_id,
    nullif(btrim(coalesce(cx2.value->>'comparison_key','')), '') as comparison_key,
    nullif(btrim(cx2.value->>'work_date'), '')::date as work_date,
    nullif(btrim(cx2.value->>'timesheet_start'), '') as ts_start_hhmm,
    nullif(btrim(cx2.value->>'timesheet_end'), '') as ts_end_hhmm,
    coalesce(nullif(btrim(cx2.value->>'timesheet_break_mins'), '')::int, 0) as ts_break_mins,
    nullif(btrim(coalesce(cx2.value->>'ref_after','')), '') as ref_after
  from tmp_val_rows vrm
  join tmp_val_mode vmm
    on vmm.timesheet_id = vrm.timesheet_id
   and vmm.mode = 'MODE_A'
  cross join lateral jsonb_array_elements(coalesce(vrm.row_json->'comparisons', '[]'::jsonb)) as cx2(value)
  where vrm.timesheet_id is not null
    and (
      upper(coalesce(cx2.value->>'match_status','')) in ('MATCH','MATCHED','OK','PASS')
      or (lower(coalesce(cx2.value->>'match','false')) in ('true','1'))
    )
    and nullif(btrim(coalesce(cx2.value->>'ref_after','')), '') is not null
    and nullif(btrim(coalesce(cx2.value->>'timesheet_start','')), '') is not null
    and nullif(btrim(coalesce(cx2.value->>'timesheet_end','')), '') is not null
    and nullif(btrim(coalesce(cx2.value->>'work_date','')), '') is not null
  on conflict (timesheet_id, comparison_key) do nothing;

  drop table if exists pg_temp.tmp_mode_a_ref_set_upd;
  create temporary table tmp_mode_a_ref_set_upd(
    timesheet_id uuid not null
  ) on commit drop;

  with upd as (
    update public.nhsp_shifts nsset
       set ref_num = mrs.ref_after,
           hr_request_id = mrs.ref_after,
           updated_at = v_now
      from tmp_mode_a_ref_set mrs
      left join public.timesheets_financials tfm
        on tfm.timesheet_id = mrs.timesheet_id
       and tfm.is_current = true
     where nsset.source_system = 'HEALTHROSTER'::public.hr_source_enum
       and nsset.cancelled_at_utc is null
       and nsset.timesheet_id = mrs.timesheet_id
       and nsset.work_date = mrs.work_date
       and nsset.invoice_id is null
       and (tfm.timesheet_id is null or (tfm.locked_by_invoice_id is null and tfm.paid_at_utc is null))
       and to_char((date_trunc('minute', nsset.start_utc) at time zone 'Europe/London'), 'HH24:MI') = mrs.ts_start_hhmm
       and to_char((date_trunc('minute', nsset.end_utc) at time zone 'Europe/London'), 'HH24:MI') = mrs.ts_end_hhmm
       and coalesce(nsset.break_mins,0) = coalesce(mrs.ts_break_mins,0)
       and (
         nsset.ref_num is distinct from mrs.ref_after
         or nsset.hr_request_id is distinct from mrs.ref_after
       )
       and not exists (
         select 1
         from public.timesheets_financials tf_lock2
         cross join lateral jsonb_array_elements(coalesce(tf_lock2.invoice_breakdown_json->'segments','[]'::jsonb)) as seg2(value)
         where tf_lock2.is_current = true
           and tf_lock2.timesheet_id = nsset.timesheet_id
           and nullif(btrim(seg2.value->>'nhsp_shift_id'), '') = nsset.id::text
           and nullif(btrim(seg2.value->>'invoice_locked_invoice_id'), '') is not null
         limit 1
       )
    returning nsset.timesheet_id
  )
  insert into tmp_mode_a_ref_set_upd(timesheet_id)
  select upd.timesheet_id
  from upd
  where upd.timesheet_id is not null;

  get diagnostics v_mode_a_ref_set_count = row_count;

  insert into tmp_ref_updated_ts(timesheet_id)
  select distinct u.timesheet_id
  from tmp_mode_a_ref_set_upd u
  where u.timesheet_id is not null
  on conflict do nothing;

  insert into tmp_aff_ts(timesheet_id)
  select distinct u2.timesheet_id
  from tmp_mode_a_ref_set_upd u2
  where u2.timesheet_id is not null
  on conflict do nothing;

  v_steps := v_steps || jsonb_build_array(
    jsonb_build_object(
      'step','MODE_A_MATCHED_REF_SET',
      'ref_set_count', v_mode_a_ref_set_count
    )
  );

  -- ─────────────────────────────────────────────
  -- ✅ UPDATED: tmp_val_upsert now computes new_pre_validated
  --   new_pre_validated = true when:
  --     - validation result is OK/OVERRIDDEN (=> new_status VALIDATION_OK)
  --     - AND timesheet is NOT authorised yet (timesheets.authorised_at_server IS NULL)
  -- ─────────────────────────────────────────────
  create temporary table tmp_val_upsert on commit drop as
  select
    vr.timesheet_id,
    case
      when vr.overall_status in ('OK','PASS','VALIDATION_OK','OVERRIDDEN','OVERRIDE') then 'VALIDATION_OK'::public.validation_status_enum
      else 'VALIDATION_ERROR'::public.validation_status_enum
    end as new_status,
    'HEALTHROSTER_WEEKLY'::text as new_reason_code,
    case when vr.overall_status in ('OK','PASS','VALIDATION_OK','OVERRIDDEN','OVERRIDE') then v_now else null end as new_validated_at_utc,
    p_import_id as new_last_source,
    case
      when vr.overall_status in ('OK','PASS','VALIDATION_OK','OVERRIDDEN','OVERRIDE')
       and tva.timesheet_id is not null
       and tva.authorised_at_server is null
      then true
      else false
    end as new_pre_validated
  from tmp_val_rows vr
  join tmp_val_mode vm
    on vm.timesheet_id = vr.timesheet_id
  left join public.timesheets tva
    on tva.timesheet_id = vr.timesheet_id
   and tva.is_current = true
  where vm.mode = 'MODE_A'
    and vr.timesheet_id is not null;

  -- ✅ UPDATED: include pre_validated changes as "validation_changed"
  select coalesce(array_agg(distinct x.timesheet_id order by x.timesheet_id), array[]::uuid[])
  into v_validation_changed_timesheet_ids
  from (
    select u.timesheet_id
    from tmp_val_upsert u
    left join public.timesheet_validations tv
      on tv.timesheet_id = u.timesheet_id
    where tv.timesheet_id is null
       or tv.status is distinct from u.new_status
       or tv.validated_at_utc is distinct from u.new_validated_at_utc
       or tv.last_source is distinct from u.new_last_source
       or tv.reason_code is distinct from u.new_reason_code
       or tv.pre_validated is distinct from u.new_pre_validated
  ) as x;

  -- ✅ UPDATED: insert/upsert includes pre_validated
  insert into public.timesheet_validations(
    timesheet_id,
    status,
    reason_code,
    validated_at_utc,
    last_source,
    pre_validated,
    updated_at
  )
  select
    u.timesheet_id,
    u.new_status,
    u.new_reason_code,
    u.new_validated_at_utc,
    u.new_last_source,
    u.new_pre_validated,
    v_now
  from tmp_val_upsert u
  on conflict (timesheet_id) do update
    set status = excluded.status,
        reason_code = excluded.reason_code,
        validated_at_utc = excluded.validated_at_utc,
        last_source = excluded.last_source,
        pre_validated = excluded.pre_validated,
        updated_at = excluded.updated_at;

  get diagnostics v_validations_upserted = row_count;

  insert into tmp_aff_ts(timesheet_id)
  select distinct t.tsid
  from unnest(coalesce(v_validation_changed_timesheet_ids, array[]::uuid[])) as t(tsid)
  where t.tsid is not null
  on conflict do nothing;

  select coalesce(array_agg(distinct vr.timesheet_id), array[]::uuid[])
  into v_mismatched_tsids
  from tmp_val_rows vr
  join tmp_val_mode vm
    on vm.timesheet_id = vr.timesheet_id
  where vm.mode = 'MODE_A'
    and vr.has_mismatch is true
    and vr.timesheet_id is not null;

  -- A validation-only Weekly timesheet is eligible for configured
  -- auto-authorisation only when the immutable coverage says omissions are
  -- meaningful and every segment on the whole timesheet has one exact
  -- HealthRoster match. A durable reference is additionally required only
  -- where the frozen effective Timesheet policy says a reference is required
  -- before pay. Processing one selected row, one day or one matching segment
  -- can never authorise the rest of the timesheet by implication.
  select coalesce(array_agg(distinct vr.timesheet_id order by vr.timesheet_id),array[]::uuid[])
  into v_validation_auto_authorise_timesheet_ids
  from tmp_val_rows vr
  join tmp_val_mode vm
    on vm.timesheet_id=vr.timesheet_id
   and vm.mode='MODE_A'
  join tmp_val_upsert vu
    on vu.timesheet_id=vr.timesheet_id
  join public.timesheets t
    on t.timesheet_id=vr.timesheet_id
   and t.is_current=true
   and t.revoked_at is null
  join public.hr_imports hi
    on hi.id=p_import_id
  left join public.timesheets_financials tf
    on tf.timesheet_id=t.timesheet_id
   and tf.is_current=true
  cross join lateral (
    select case
      when jsonb_typeof(t.actual_schedule_json)='array'
       and jsonb_array_length(t.actual_schedule_json)>0
        then jsonb_array_length(t.actual_schedule_json)
      when jsonb_typeof(tf.invoice_breakdown_json)='object'
       and jsonb_typeof(tf.invoice_breakdown_json->'segments')='array'
        then jsonb_array_length(tf.invoice_breakdown_json->'segments')
      else 0
    end as segment_count
  ) whole_timesheet
  cross join lateral (
    select public.contract_settings_effective_get_v1(
      vr.client_id,
      vr.contract_id,
      nullif(vr.row_json->>'week_ending_date','')::date,
      'IMPORT',
      vr.timesheet_id
    ) as payload
  ) effective_settings
  where vu.new_status='VALIDATION_OK'::public.validation_status_enum
    and vu.new_pre_validated=true
    and hi.coverage_mode in ('COMPLETE_ALL','COMPLETE_SELECTED_CANDIDATES')
    and (
      hi.coverage_mode='COMPLETE_ALL'
      or exists (
        select 1
        from public.import_review_scope_candidates scoped_candidate
        where scoped_candidate.import_id=p_import_id
          and scoped_candidate.candidate_id=vr.candidate_id
      )
    )
    and jsonb_typeof(vr.row_json->'comparisons')='array'
    and jsonb_array_length(vr.row_json->'comparisons')>0
    and whole_timesheet.segment_count=jsonb_array_length(vr.row_json->'comparisons')
    and not exists (
      select 1
      from jsonb_array_elements(vr.row_json->'comparisons') comparison(value)
      where not (
        (
          upper(coalesce(comparison.value->>'match_status','')) in ('MATCH','MATCHED','OK','PASS')
          or lower(coalesce(comparison.value->>'match','false')) in ('true','1')
        )
        and lower(coalesce(comparison.value->>'time_match','false')) in ('true','1')
        and (
          not coalesce(
            (effective_settings.payload#>>'{values,require_reference_to_pay}')::boolean,
            false
          )
          or nullif(btrim(comparison.value->>'ref_after'),'') is not null
        )
        and nullif(btrim(comparison.value->>'work_date'),'') is not null
        and nullif(btrim(comparison.value->>'timesheet_start'),'') is not null
        and nullif(btrim(comparison.value->>'timesheet_end'),'') is not null
        and exists (
          select 1
          from public.nhsp_shifts matched_shift
          where matched_shift.source_system='HEALTHROSTER'::public.hr_source_enum
            and matched_shift.cancelled_at_utc is null
            and matched_shift.timesheet_id=vr.timesheet_id
            and matched_shift.work_date=(comparison.value->>'work_date')::date
            and to_char((date_trunc('minute',matched_shift.start_utc) at time zone 'Europe/London'),'HH24:MI')=
              comparison.value->>'timesheet_start'
            and to_char((date_trunc('minute',matched_shift.end_utc) at time zone 'Europe/London'),'HH24:MI')=
              comparison.value->>'timesheet_end'
            and coalesce(matched_shift.break_mins,0)=coalesce(nullif(btrim(comparison.value->>'timesheet_break_mins'),'')::integer,0)
            and (
              not coalesce(
                (effective_settings.payload#>>'{values,require_reference_to_pay}')::boolean,
                false
              )
              or (
                matched_shift.ref_num=comparison.value->>'ref_after'
                and matched_shift.hr_request_id=comparison.value->>'ref_after'
              )
            )
        )
      )
    );

  -- Query emails are intentionally outside the source transaction. The
  -- database returns selected action IDs; the Worker later calls the
  -- idempotent outbox-backed enqueue RPC after source commit.

  v_steps := v_steps || jsonb_build_array(
    jsonb_build_object(
      'step','MODE_A_VALIDATIONS_DONE',
      'val_rows_count', v_val_rows_count,
      'validations_upserted', v_validations_upserted,
      'validation_changed_timesheet_ids_count', coalesce(array_length(v_validation_changed_timesheet_ids, 1), 0),
      'mismatched_timesheet_ids_count', coalesce(array_length(v_mismatched_tsids, 1), 0),
      'email_actions_count', v_email_actions_count,
      'email_jobs_count', v_email_jobs_count,
      'mode_a_ref_cleared_count', v_mode_a_ref_cleared_count
    )
  );

  -- ─────────────────────────────────────────────
  -- ✅ Compute ref_updated_timesheet_ids (for post-apply QR reissue + tspdf regen decisions)
  -- ─────────────────────────────────────────────
  select coalesce(array_agg(distinct rts.timesheet_id order by rts.timesheet_id), array[]::uuid[])
  into v_ref_updated_timesheet_ids
  from tmp_ref_updated_ts rts
  where rts.timesheet_id is not null;

  v_ref_updated_timesheet_ids_count := coalesce(array_length(v_ref_updated_timesheet_ids, 1), 0);

  -- ─────────────────────────────────────────────
  -- 11) Compute affected_timesheet_ids (MODE_B work + MODE_A validation changes)
  -- ─────────────────────────────────────────────
  -- Build the ordinary authoritative MODE_B scope separately from the
  -- whole-timesheet MODE_A validation scope calculated above.
  -- active imported rows, protected amendment correction pairs and
  -- cancellation/reversal results.  MODE_A validation/reference work is
  -- deliberately excluded even though it remains part of the TSFIN refresh.
  select coalesce(array_agg(distinct target.timesheet_id order by target.timesheet_id),array[]::uuid[])
  into v_authoritative_affected_timesheet_ids
  from (
    select ns.timesheet_id
    from public.nhsp_shifts ns
    where ns.source_system='HEALTHROSTER'::public.hr_source_enum
      and ns.client_id=v_import_client_id
      and ns.cancelled_at_utc is null
      and ns.external_row_key=any(coalesce(v_force_keys_final,array[]::text[]))
      -- Protected changed-hours rows are represented financially by their
      -- immutable reversal/replacement pair.  The source shift remains linked
      -- to the root for import identity, but refreshing that settled root as
      -- well would count the same delta twice in the correction-chain
      -- residual (live root truth plus the signed pair).
      and not (
        ns.external_row_key=any(
          coalesce(v_invoiced_changed_keys,array[]::text[])
        )
      )
      and ns.timesheet_id is not null
    union all
    select phase3_created.value::uuid
    from jsonb_array_elements_text(coalesce(v_phase3_result->'created_timesheet_ids','[]'::jsonb)) phase3_created(value)
    union all
    select phase3_updated.value::uuid
    from jsonb_array_elements_text(coalesce(v_phase3_result->'updated_timesheet_ids','[]'::jsonb)) phase3_updated(value)
    union all
    select cancelled.value::uuid
    from jsonb_array_elements_text(coalesce(v_cancellations_result->'affected_timesheet_ids','[]'::jsonb)) cancelled(value)
  ) target
  where target.timesheet_id is not null;

  -- A protected correction must remain a complete TSFIN/lifecycle unit even
  -- when this batch changes only its mutable replacement member.
  select coalesce(array_agg(distinct expanded.timesheet_id order by expanded.timesheet_id),array[]::uuid[])
  into v_authoritative_affected_timesheet_ids
  from (
    select requested.timesheet_id
    from unnest(coalesce(v_authoritative_affected_timesheet_ids,array[]::uuid[])) requested(timesheet_id)
    where requested.timesheet_id is not null
    union
    select partner.timesheet_id
    from unnest(coalesce(v_authoritative_affected_timesheet_ids,array[]::uuid[])) requested(timesheet_id)
    join public.timesheets seed
      on seed.timesheet_id=requested.timesheet_id
     and seed.is_current=true
     and seed.correction_id is not null
     and upper(btrim(coalesce(seed.adjustment_origin,''))) in (
       'IMPORT_CORRECTION','IMPORT_CANCELLATION','HEALTHROSTER_CHANGED_HOURS',
       'NHSP_CHANGED_HOURS','HEALTHROSTER_CANCELLATION','NHSP_CANCELLATION'
     )
    join public.timesheets partner
      on partner.correction_id=seed.correction_id
     and partner.is_current=true
     and upper(btrim(coalesce(partner.adjustment_origin,''))) in (
       'IMPORT_CORRECTION','IMPORT_CANCELLATION','HEALTHROSTER_CHANGED_HOURS',
       'NHSP_CHANGED_HOURS','HEALTHROSTER_CANCELLATION','NHSP_CANCELLATION'
     )
  ) expanded
  where expanded.timesheet_id is not null;
  insert into tmp_aff_ts(timesheet_id)
  select authoritative.timesheet_id
  from unnest(coalesce(v_authoritative_affected_timesheet_ids,array[]::uuid[])) authoritative(timesheet_id)
  where authoritative.timesheet_id is not null
  on conflict do nothing;

  select coalesce(array_agg(distinct a.timesheet_id order by a.timesheet_id), array[]::uuid[])
  into v_affected_timesheet_ids
  from tmp_aff_ts a
  where a.timesheet_id is not null
    -- A protected source is immutable financial history. It can enter the
    -- generic affected set through MODE_A validation/reference bookkeeping
    -- even though the authoritative MODE_B scope above correctly selected
    -- only the new correction pair. Never let that bookkeeping requeue the
    -- settled root for TSFIN recalculation.
    and not (
      a.timesheet_id=any(
        coalesce(v_protected_source_timesheet_ids,array[]::uuid[])
      )
      and not (a.timesheet_id=any(coalesce(v_paid_applied_timesheet_ids,array[]::uuid[])))
    );

  -- Restore every previously-authorised mutable source and authorise every
  -- financial correction member regardless of the ordinary setting.  A
  -- changed-hours reversal/replacement pair therefore moves together, while
  -- a true cancellation contributes its reversal only.
  select coalesce(array_agg(distinct required.timesheet_id order by required.timesheet_id),array[]::uuid[])
  into v_reauthorise_timesheet_ids
  from (
    select existing.timesheet_id
    from unnest(coalesce(v_reauthorise_timesheet_ids,array[]::uuid[])) existing(timesheet_id)
    union all
    select correction.timesheet_id
    from unnest(coalesce(v_authoritative_affected_timesheet_ids,array[]::uuid[])) affected(timesheet_id)
    join public.timesheets correction on correction.timesheet_id=affected.timesheet_id
    where correction.is_current=true
      and correction.revoked_at is null
      and coalesce(correction.is_adjustment,false)
      and correction.correction_id is not null
  ) required
  where required.timesheet_id is not null;

  if to_regclass('pg_temp.import_review_reconciliation_units_v1') is not null then
    if exists(
      select 1 from pg_temp.import_review_reconciliation_units_v1 u
      where u.route in ('AMEND_EXISTING_REPLACEMENT','CREATE_REVERSAL_REPLACEMENT') and (
        nullif(u.unit_json->>'correction_id','') is null
        or jsonb_typeof(u.unit_json->'applied_member_ids')<>'array'
        or jsonb_array_length(u.unit_json->'applied_member_ids')<>2
        or (select count(*)=2
              and count(*) filter(where t.correction_kind='CHANGED_HOURS_REVERSAL')=1
              and count(*) filter(where t.correction_kind='CHANGED_HOURS_REPLACEMENT')=1
              and count(distinct t.parent_timesheet_id)=1
              and count(t.parent_timesheet_id)=2
            from public.timesheets t
            where t.correction_id=u.unit_json->>'correction_id' and t.is_current and t.archived_at_utc is null
              and t.adjustment_origin='IMPORT_CORRECTION'
              and t.correction_kind in ('CHANGED_HOURS_REVERSAL','CHANGED_HOURS_REPLACEMENT')) is not true
      )
    ) then
      raise exception 'IMPORT_REVIEW_APPLY_POSTCONDITION_FAILED' using errcode='55000',
        detail=jsonb_build_object('reason_code','CORRECTION_MEMBER_SET_INCOMPLETE')::text;
    end if;
    if exists(select 1 from pg_temp.import_review_reconciliation_units_v1 u
      where u.route='AMEND_PAID_UNINVOICED_SOURCE' and (
        nullif(u.unit_json->>'applied_timesheet_id','')::uuid is distinct from u.source_timesheet_id
        or nullif(u.unit_json->>'reviewed_unit_fingerprint','') is distinct from u.unit_fingerprint
        or coalesce(u.unit_json->>'rollover_mode','') not in ('CREATED_CURRENT_OPERATION_SHELL','REUSED_COMPLETED_OPERATION_SHELL')
        or coalesce(u.unit_json->>'historical_paid_tsfin_id','')!~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        or coalesce(u.unit_json->>'current_shell_tsfin_id','')!~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        or u.unit_json->>'applied_result_fingerprint' is distinct from encode(extensions.digest(convert_to(
          jsonb_build_object(
            'applied_timesheet_id',(u.unit_json->>'applied_timesheet_id')::uuid,
            'rollover_mode',u.unit_json->>'rollover_mode',
            'historical_paid_tsfin_id',(u.unit_json->>'historical_paid_tsfin_id')::uuid,
            'current_shell_tsfin_id',(u.unit_json->>'current_shell_tsfin_id')::uuid,
            'intended_authorisation_action',u.unit_json->>'intended_authorisation_action',
            'reviewed_unit_fingerprint',u.unit_json->>'reviewed_unit_fingerprint',
            'reconciliation_fingerprint',u.unit_json->>'reconciliation_fingerprint')::text,'UTF8'),'sha256'),'hex')
        or not exists(select 1 from public.timesheets_financials historical
          where historical.id=(u.unit_json->>'historical_paid_tsfin_id')::uuid
            and historical.timesheet_id=u.source_timesheet_id and not historical.is_current
            and historical.paid_at_utc is not null and historical.locked_by_invoice_id is null)
        or not exists(select 1 from public.timesheets_financials shell
          where shell.id=(u.unit_json->>'current_shell_tsfin_id')::uuid
            and shell.timesheet_id=u.source_timesheet_id and shell.is_current and shell.paid_at_utc is null)
      )) then
      raise exception 'IMPORT_REVIEW_APPLY_POSTCONDITION_FAILED' using errcode='55000',
        detail=jsonb_build_object('reason_code','PAID_SOURCE_ROLLOVER_RESULT_INVALID')::text;
    end if;
    select coalesce(array_agg(distinct x.value::uuid order by x.value::uuid) filter (where x.value is not null),array[]::uuid[])
    into v_operation_bound_correction_timesheet_ids
    from pg_temp.import_review_reconciliation_units_v1 u
    left join lateral jsonb_array_elements_text(coalesce(u.unit_json->'applied_member_ids','[]'::jsonb)) x(value) on true
    where u.route in ('AMEND_EXISTING_REPLACEMENT','CREATE_REVERSAL_REPLACEMENT');
    select coalesce(jsonb_agg(u.unit_json order by u.action_id),'[]'::jsonb) into v_reconciliation_units
    from pg_temp.import_review_reconciliation_units_v1 u;
    select coalesce(array_agg(x order by x),array[]::uuid[]) into v_reauthorise_timesheet_ids
    from unnest(coalesce(v_reauthorise_timesheet_ids,array[]::uuid[])) x
    where not (x=any(coalesce(v_operation_bound_correction_timesheet_ids,array[]::uuid[])));
  end if;

  v_auto_authorise_timesheet_ids:=public._import_review_auto_authorise_targets_core_v1(
    v_authoritative_affected_timesheet_ids,'HEALTHROSTER'::public.hr_source_enum,false
  );

  select coalesce(array_agg(distinct eligible.timesheet_id order by eligible.timesheet_id),array[]::uuid[])
  into v_auto_authorise_timesheet_ids
  from (
    select unnest(coalesce(v_auto_authorise_timesheet_ids,array[]::uuid[])) as timesheet_id
    union all
    select unnest(public._import_review_auto_authorise_targets_core_v1(
      v_validation_auto_authorise_timesheet_ids,'HEALTHROSTER'::public.hr_source_enum,true
    )) as timesheet_id
  ) eligible
  where eligible.timesheet_id is not null;
  select coalesce(array_agg(distinct target_id order by target_id),array[]::uuid[])
  into v_auto_authorise_timesheet_ids from (
    select target_id from unnest(coalesce(v_auto_authorise_timesheet_ids,array[]::uuid[])) x(target_id)
    where not (target_id=any(coalesce(v_paid_applied_timesheet_ids,array[]::uuid[])))
    union all
    select u.source_timesheet_id from pg_temp.import_review_reconciliation_units_v1 u
    where u.route='AMEND_PAID_UNINVOICED_SOURCE'
      and u.unit_json->>'intended_authorisation_action'='AUTHORISE'
  ) reviewed_auto;
  select coalesce(array_agg(distinct target_id order by target_id),array[]::uuid[])
  into v_reauthorise_timesheet_ids from (
    select target_id from unnest(coalesce(v_reauthorise_timesheet_ids,array[]::uuid[])) x(target_id)
    where not (target_id=any(coalesce(v_paid_applied_timesheet_ids,array[]::uuid[])))
    union all
    select u.source_timesheet_id from pg_temp.import_review_reconciliation_units_v1 u
    where u.route='AMEND_PAID_UNINVOICED_SOURCE'
      and u.unit_json->>'intended_authorisation_action'='REAUTHORISE'
  ) reviewed_reauthorise;
  select coalesce(array_agg(x order by x),array[]::uuid[]) into v_general_authorise_timesheet_ids
  from unnest(coalesce(v_auto_authorise_timesheet_ids,array[]::uuid[])||coalesce(v_reauthorise_timesheet_ids,array[]::uuid[])) x
  where not (x=any(coalesce(v_operation_bound_correction_timesheet_ids,array[]::uuid[])));

  if array_length(v_affected_timesheet_ids, 1) is not null then
    perform public.enqueue_ts_financials_priority(v_affected_timesheet_ids, 'CONTEXT_CHANGED'::public.ts_fin_reason_enum);
  end if;

  -- ─────────────────────────────────────────────
  -- 12) Preserve the source route.  Whole-import completion is owned by
  -- _import_review_apply_complete_core_v1 after it has proved that no
  -- deferred/selectable work or blockers remain.  An incremental batch must
  -- never make the staged import look globally applied.
  -- ─────────────────────────────────────────────
  update public.hr_imports hi3
  set import_scope = 'HR_WEEKLY'
  where hi3.id = p_import_id;

  v_steps := v_steps || jsonb_build_array(jsonb_build_object('step','IMPORT_BATCH_APPLIED'));

  -- ─────────────────────────────────────────────
  -- 13) Logging (invoice_debug only, via _imp_debug_audit)
  -- ─────────────────────────────────────────────
  perform public._imp_debug_audit(
    p_actor_user_id,
    'HR_WEEKLY_VALIDATIONS_DEBUG',
    jsonb_build_object(
      'import_id', p_import_id::text,
      'client_id', v_import_client_id::text,
      'val_rows_count', v_val_rows_count,
      'validations_upserted', v_validations_upserted,
      'validation_changed_timesheet_ids_count', coalesce(array_length(v_validation_changed_timesheet_ids, 1), 0),
      'mismatched_timesheet_ids_count', coalesce(array_length(v_mismatched_tsids, 1), 0),
      'email_actions_count', v_email_actions_count,
      'email_jobs_count', v_email_jobs_count,
      'mode_a_ref_cleared_count', v_mode_a_ref_cleared_count,
      'mode_a_ref_set_count', v_mode_a_ref_set_count,
      'ref_updated_timesheet_ids_count', v_ref_updated_timesheet_ids_count,
      'invalidation_actions_count', v_invalidation_actions_count
    ),
    'hr_imports',
    p_import_id::text,
    null,
    null,
    null,
    null
  );

  perform public._imp_debug_audit(
    p_actor_user_id,
    'HR_WEEKLY_APPLY_DEBUG',
    jsonb_build_object(
      'import_id', p_import_id::text,
      'client_id', v_import_client_id::text,
      'steps', v_steps
    ),
    'hr_imports',
    p_import_id::text,
    null,
    null,
    null,
    null
  );

  v_review_result:=jsonb_build_object(
    'import_id', p_import_id,
    'client_id', v_import_client_id,
    'mode_b', jsonb_build_object(
      'selected_truth_keys', to_jsonb(coalesce(v_selected_truth_keys_mode_b, array[]::text[])),
      'force_overwrite_external_row_keys', to_jsonb(coalesce(v_force_keys_final, array[]::text[])),
      'skip_external_row_keys', to_jsonb(coalesce(v_skip_keys_final, array[]::text[])),
      'phase1', v_phase1_result,
      'phase15', jsonb_build_object(
        'ok_rows', v_phase15_ok,
        'shift_updated_rows', v_phase15_updated
      ),
      'phase3', v_phase3_result,
      'cancellations', v_cancellations_result
    ),
    'mode_a', jsonb_build_object(
      'mirror', v_mirror_result,
      'validations_upserted', v_validations_upserted,
      'mismatched_timesheet_ids', to_jsonb(coalesce(v_mismatched_tsids, array[]::uuid[])),
      'validation_affected_timesheet_ids', to_jsonb(coalesce(v_validation_changed_timesheet_ids, array[]::uuid[])),
      'mode_a_ref_cleared_count', v_mode_a_ref_cleared_count,
      'mode_a_ref_set_count', v_mode_a_ref_set_count,
      'ref_updated_timesheet_ids', to_jsonb(coalesce(v_ref_updated_timesheet_ids, array[]::uuid[])),
      'whole_timesheet_auto_authorise_eligible_ids',to_jsonb(coalesce(v_validation_auto_authorise_timesheet_ids,array[]::uuid[]))
    ),
    'email_jobs', v_email_jobs,
    'affected_timesheet_ids', to_jsonb(coalesce(v_affected_timesheet_ids, array[]::uuid[])),
    'auto_authorise_timesheet_ids',to_jsonb(coalesce(v_auto_authorise_timesheet_ids,array[]::uuid[])),
    'post_commit_reauthorise_timesheet_ids',to_jsonb(coalesce(v_reauthorise_timesheet_ids,array[]::uuid[])),
    'reconciliation_action_ids',to_jsonb(coalesce(v_reconciliation_action_ids,array[]::text[])),
    'operation_bound_correction_action_ids',to_jsonb(coalesce(v_operation_bound_correction_action_ids,array[]::text[])),
    'general_authorise_timesheet_ids',to_jsonb(coalesce(v_general_authorise_timesheet_ids,array[]::uuid[])),
    'operation_bound_correction_timesheet_ids',to_jsonb(coalesce(v_operation_bound_correction_timesheet_ids,array[]::uuid[])),
    'reconciliation_units',coalesce(v_reconciliation_units,'[]'::jsonb),
    'validation_affected_timesheet_ids', to_jsonb(coalesce(v_validation_changed_timesheet_ids, array[]::uuid[])),
    'ref_updated_timesheet_ids', to_jsonb(coalesce(v_ref_updated_timesheet_ids, array[]::uuid[])),
    'post_commit_email_action_ids',v_post_commit_email_action_ids,
    'review_operation_id',v_review_operation_id
  );
  perform public._import_review_apply_complete_core_v1(p_import_id,v_review_operation_id,p_actor_user_id,v_review_result,
    jsonb_array_length(v_post_commit_email_action_ids)>0 or cardinality(v_affected_timesheet_ids)>0);
  return v_review_result;

exception when others then
  get stacked diagnostics v_sqlstate = returned_sqlstate, v_err = message_text;

  begin
    perform public._imp_debug_audit(
      p_actor_user_id,
      'HR_WEEKLY_APPLY_ERROR',
      jsonb_build_object(
        'import_id', p_import_id::text,
        'client_id', case when v_import_client_id is null then null else v_import_client_id::text end,
        'steps', v_steps,
        'sqlstate', v_sqlstate,
        'error', v_err,
        'last_shift_id', case when v_last_shift_id is null then null else v_last_shift_id::text end
      ),
      'hr_imports',
      p_import_id::text,
      null,
      null,
      null,
      null
    );
  exception when others then
    null;
  end;

  raise;
end;
$function$;

create or replace function public.weekly_source_mode_a_reference_apply_atomic_v1(
  p_request jsonb
) returns jsonb
language plpgsql
volatile
security definer
set search_path to 'public','private','extensions','pg_catalog','pg_temp'
as $function$
declare
  v_actor uuid;
  v_publication_id uuid;
  v_operation_id uuid;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_client_id uuid;
  v_operation_key text;
  v_import public.hr_imports%rowtype;
  v_state public.import_review_states%rowtype;
  v_envelope jsonb;
  v_request_hash text;
  v_apply jsonb;
  v_auto_requested boolean;
  v_timesheet_id uuid;
  v_timesheet public.timesheets%rowtype;
  v_items jsonb;
  v_item_count integer;
  v_manifest_hash bytea;
  v_operation_row_id uuid;
  v_comparison public.weekly_timesheet_source_comparisons%rowtype;
  v_ordinal integer;
  v_applied_ids uuid[];
  v_native_units jsonb;
  v_preset_refused integer:=0;
  -- WP-37: the established family resolver's answer for one physical id.
  v_root_identity jsonb;
  v_root_reason text;
  v_refused integer:=0;
  v_results jsonb:='[]'::jsonb;
  v_client_results jsonb:='[]'::jsonb;
begin
  if coalesce(current_setting('request.jwt.claim.role',true),
       nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
  end if;
  if p_request is null or pg_catalog.jsonb_typeof(p_request)<>'object'
     or exists(
       select 1 from pg_catalog.jsonb_object_keys(p_request) key
       where key not in ('actor_user_id','publication_id','operation_id')
     ) then
    raise exception 'WEEKLY_SOURCE_MODE_A_REQUEST_INVALID' using errcode='22023';
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_publication_id:=(p_request->>'publication_id')::uuid;
    v_operation_id:=coalesce(nullif(p_request->>'operation_id','')::uuid,pg_catalog.gen_random_uuid());
  exception when invalid_text_representation then
    raise exception 'WEEKLY_SOURCE_MODE_A_REQUEST_INVALID' using errcode='22023';
  end;
  if v_actor is null or v_publication_id is null then
    raise exception 'WEEKLY_SOURCE_MODE_A_REQUEST_INVALID' using errcode='22023';
  end if;

  select * into v_publication
  from public.weekly_source_projection_publications where id=v_publication_id for update;
  if not found then
    raise exception 'WEEKLY_SOURCE_PUBLICATION_NOT_FOUND' using errcode='22023';
  end if;
  select * into strict v_upload from public.weekly_source_uploads where id=v_publication.upload_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_publication.source_cycle_id;
  select * into strict v_group from public.weekly_source_groups where id=v_cycle.source_group_id;
  perform private.weekly_source_office_authority_v1(
    v_actor,'RECHECK_SOURCE',v_group.id,null,v_cycle.finalisation_week_ending
  );
  perform public._import_review_assert_actor_v1(v_actor);

  for v_client_id in
    select distinct contract.client_id
    from public.weekly_timesheet_source_comparisons comparison
    join public.contracts contract on contract.id=comparison.contract_id
    where comparison.projection_publication_id=v_publication_id
    order by 1
  loop
    v_operation_key:=private.weekly_source_mode_a_operation_key_v1(v_publication_id,v_client_id);
    select * into v_import from public.hr_imports where coverage_operation_key=v_operation_key;
    if not found then
      raise exception 'WEEKLY_SOURCE_MODE_A_NOT_DISPATCHED' using errcode='55000',
        detail=pg_catalog.jsonb_build_object('client_id',v_client_id)::text;
    end if;
    select * into strict v_state from public.import_review_states where import_id=v_import.id;
    select coalesce(jsonb_agg(to_jsonb(n) order by n.candidate_id,n.client_id),'[]'::jsonb)
      into v_native_units from private.weekly_source_agency_mode_a_units_v1(v_import.id) n;

    -- Every Weekly Source reference-apply operation is recorded before the
    -- established owner runs, one row per signed Timesheet with at least one
    -- exact match, so the Weekly Source side carries its own evidence of what
    -- it asked for.
    --
    -- WP-37, closing WP-31's finding F3.  A CloudTMS Timesheet id ROTATES when
    -- the Timesheet is replaced by a newer version (`24 §9A`), and the
    -- comparisons written against the superseded head remain.  Iterating those
    -- physical ids used to hand a non-current id to the established settings
    -- resolver, which raised `P0002 CONTRACT_SETTINGS_CURRENT_TIMESHEET_NOT_FOUND`
    -- and aborted the whole call — so one superseded head blocked the CURRENT
    -- head's reference and its auto-authorisation decision.  Each physical id
    -- is therefore resolved through the established family resolver
    -- `private.weekly_source_resolve_root_identity_v1` (itself the installed
    -- `public._pay_timesheet_rotation_scope`; no second resolver is written
    -- here), and only the family's canonical current head proceeds.  A
    -- superseded member is recorded as REFUSED with its reason and skipped —
    -- `24 §9A`: "the older id is never authorised" — and a family whose
    -- identity cannot be established fails closed the same way.
    for v_timesheet_id in
      select distinct comparison.timesheet_id
      from public.weekly_timesheet_source_comparisons comparison
      join public.contracts contract on contract.id=comparison.contract_id
      where comparison.projection_publication_id=v_publication_id
        and contract.client_id=v_client_id
        and comparison.comparison_state='EXACT_MATCH'
      order by 1
    loop
      v_root_identity:=private.weekly_source_resolve_root_identity_v1(v_timesheet_id);
      -- A boolean read from JSON is three-valued: an absent key, a JSON null
      -- and a non-boolean value must all be the UNSAFE answer, so every read
      -- below is gated on `jsonb_typeof` before it is trusted.
      v_root_reason:=case
        when pg_catalog.jsonb_typeof(v_root_identity->'ok')<>'boolean'
          or (v_root_identity->>'ok')::boolean is not true
          then coalesce(nullif(v_root_identity->>'reason',''),'ROOT_IDENTITY_UNRESOLVED')
        when pg_catalog.jsonb_typeof(v_root_identity->'requested_is_canonical')<>'boolean'
          or (v_root_identity->>'requested_is_canonical')::boolean is not true
          then 'TIMESHEET_SUPERSEDED'
        when pg_catalog.jsonb_typeof(v_root_identity->'family_is_current')<>'boolean'
          or (v_root_identity->>'family_is_current')::boolean is not true
          then 'TIMESHEET_NOT_CURRENT'
        else null
      end;
      if v_root_reason is not null then
        perform private.weekly_source_mode_a_refuse_operation_v1(
          v_cycle.id,v_upload.id,v_publication_id,v_timesheet_id,v_actor,
          'WEEKLY_SOURCE_MODE_A_'||v_root_reason
        );
        v_refused:=v_refused+1;
        continue;
      end if;
      select * into strict v_timesheet from public.timesheets where timesheet_id=v_timesheet_id;
      if exists(select 1 from jsonb_to_recordset(v_native_units) n(candidate_id uuid,client_id uuid,has_preset boolean)
        join public.contracts c on c.id=v_timesheet.contract_id and c.candidate_id=n.candidate_id and c.client_id=n.client_id
        where n.has_preset) then
        perform private.weekly_source_mode_a_refuse_operation_v1(v_cycle.id,v_upload.id,
          v_publication_id,v_timesheet_id,v_actor,'AGENCY_INVOICE_USES_COMPLETENESS_WRITER');
        v_preset_refused:=v_preset_refused+1;
        continue;
      end if;
      select coalesce(pg_catalog.jsonb_agg(
               pg_catalog.jsonb_build_object(
                 'comparison_id',comparison.id,'upload_row_id',comparison.upload_row_id,
                 'work_event_id',comparison.work_event_id,'work_date',comparison.work_date,
                 'reference_number',comparison.source_reference_number
               ) order by comparison.work_date,comparison.id
             ),'[]'::jsonb),
             count(*)::integer
      into v_items,v_item_count
      from public.weekly_timesheet_source_comparisons comparison
      where comparison.projection_publication_id=v_publication_id
        and comparison.timesheet_id=v_timesheet_id
        and comparison.comparison_state='EXACT_MATCH';
      if v_item_count=0 then continue; end if;

      v_manifest_hash:=private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_TIMESHEET_REFERENCE_APPLY_MANIFEST_V1',v_items
      );
      -- The auto-authorisation decision is the established resolver's, taken
      -- in validation context exactly as
      -- public._import_review_auto_authorise_targets_core_v1 reads it.
      v_auto_requested:=coalesce((
        public.import_auto_authorise_policy_resolve_v2(
          'HEALTHROSTER'::public.hr_source_enum,v_client_id,v_timesheet.contract_id,
          v_timesheet_id,v_timesheet.week_ending_date,true
        )->>'effective_value')::boolean,false);

      insert into public.weekly_timesheet_reference_apply_operations(
        source_cycle_id,upload_id,projection_publication_id,timesheet_id,
        expected_timesheet_revision,expected_item_count,expected_item_manifest_hash,
        auto_authorise_requested,auto_authorise_applied,state,actor_user_id,
        idempotency_key,operation_hash
      ) values (
        v_cycle.id,v_upload.id,v_publication_id,v_timesheet_id,
        v_timesheet.version,v_item_count,v_manifest_hash,
        v_auto_requested,false,'READY',v_actor,
        'weekly-source-mode-a-apply:'||v_publication_id::text||':'||v_timesheet_id::text
          ||':'||v_timesheet.version::text,
        private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_TIMESHEET_REFERENCE_APPLY_OPERATION_V1',
          pg_catalog.jsonb_build_object(
            'projection_publication_id',v_publication_id,'timesheet_id',v_timesheet_id,
            'timesheet_revision',v_timesheet.version,'manifest',v_items
          )
        )
      )
      on conflict (idempotency_key) do nothing
      returning id into v_operation_row_id;
      if v_operation_row_id is null then
        select id into v_operation_row_id
        from public.weekly_timesheet_reference_apply_operations
        where idempotency_key='weekly-source-mode-a-apply:'||v_publication_id::text||':'
          ||v_timesheet_id::text||':'||v_timesheet.version::text;
        continue;
      end if;

      v_ordinal:=0;
      for v_comparison in
        select * from public.weekly_timesheet_source_comparisons comparison
        where comparison.projection_publication_id=v_publication_id
          and comparison.timesheet_id=v_timesheet_id
          and comparison.comparison_state='EXACT_MATCH'
        order by comparison.work_date,comparison.id
      loop
        v_ordinal:=v_ordinal+1;
        insert into public.weekly_timesheet_reference_apply_items(
          operation_id,item_ordinal,comparison_id,upload_row_id,work_event_id,
          work_date,reference_number,reference_fact_hash
        ) values (
          v_operation_row_id,v_ordinal,v_comparison.id,v_comparison.upload_row_id,
          v_comparison.work_event_id,v_comparison.work_date,
          v_comparison.source_reference_number,
          private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_TIMESHEET_REFERENCE_FACT_V1',
            pg_catalog.jsonb_build_object(
              'comparison_id',v_comparison.id,'work_event_id',v_comparison.work_event_id,
              'work_date',v_comparison.work_date,
              'reference_number',v_comparison.source_reference_number
            )
          )
        );
      end loop;
      v_results:=v_results||pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
        'operation_id',v_operation_row_id,'timesheet_id',v_timesheet_id,
        'item_count',v_item_count,'auto_authorise_requested',v_auto_requested
      ));
    end loop;

    -- The established reference and apply owner.  The apply contract is the
    -- server's own envelope, hashed by the import-review owner, never composed
    -- from caller facts.
    v_envelope:=public._import_review_apply_envelope_core_v1(v_import.id);
    v_request_hash:=public._import_review_hash_v1(v_envelope::text);
    if pg_catalog.jsonb_array_length(coalesce(v_envelope->'selected_action_ids','[]'::jsonb))=0 then
      update public.weekly_timesheet_reference_apply_operations
      set state='REFUSED',result_code='IMPORT_REVIEW_NO_READY_SELECTED_ACTIONS',
        completed_at_utc=pg_catalog.transaction_timestamp()
      where projection_publication_id=v_publication_id and state='READY'
        and timesheet_id in (
          select comparison.timesheet_id from public.weekly_timesheet_source_comparisons comparison
          join public.contracts contract on contract.id=comparison.contract_id
          where comparison.projection_publication_id=v_publication_id and contract.client_id=v_client_id
        );
      v_client_results:=v_client_results||pg_catalog.jsonb_build_array(
        pg_catalog.jsonb_build_object('client_id',v_client_id,'import_id',v_import.id,
          'applied',false,'reason_code','IMPORT_REVIEW_NO_READY_SELECTED_ACTIONS')
      );
      continue;
    end if;

    v_apply:=public.hr_weekly_apply_transactional(
      v_import.id,
      pg_catalog.jsonb_build_object(
        'review_contract',pg_catalog.jsonb_build_object(
          'schema_version','IMPORT_REVIEW_APPLY_CONTRACT_V1',
          'operation_id',v_operation_id,
          'state_version',v_state.state_version,
          'coverage_fingerprint',v_import.coverage_fingerprint,
          'preview_fingerprint',v_state.preview_fingerprint,
          'request_hash',v_request_hash
        ),
        'review_selected_action_ids',coalesce(v_envelope->'selected_action_ids','[]'::jsonb),
        'invalidation_action_ids',coalesce(v_envelope->'reference_invalidation_action_ids','[]'::jsonb)
      ),
      v_actor
    );

    -- The established owner names the Timesheets it auto-authorised.  This
    -- owner only records that answer; it never authorises anything itself.
    select coalesce(array_agg(distinct value::uuid),array[]::uuid[]) into v_applied_ids
    from pg_catalog.jsonb_array_elements_text(
      coalesce(v_apply->'auto_authorise_timesheet_ids','[]'::jsonb)
    ) value;

    update public.weekly_timesheet_reference_apply_operations operation
    set state='APPLIED',result_code='IMPORT_REVIEW_APPLIED',
      auto_authorise_applied=operation.timesheet_id=any(v_applied_ids),
      completed_at_utc=pg_catalog.transaction_timestamp()
    where operation.projection_publication_id=v_publication_id and operation.state='READY'
      and operation.timesheet_id in (
        select comparison.timesheet_id from public.weekly_timesheet_source_comparisons comparison
        join public.contracts contract on contract.id=comparison.contract_id
        where comparison.projection_publication_id=v_publication_id and contract.client_id=v_client_id
      );
    update public.weekly_timesheet_reference_apply_items item
    set applied_at_utc=pg_catalog.transaction_timestamp()
    where item.operation_id in (
      select operation.id from public.weekly_timesheet_reference_apply_operations operation
      where operation.projection_publication_id=v_publication_id and operation.state='APPLIED'
    ) and item.applied_at_utc is null;

    v_client_results:=v_client_results||pg_catalog.jsonb_build_array(
      pg_catalog.jsonb_build_object('client_id',v_client_id,'import_id',v_import.id,
        'applied',true,'apply_result',v_apply,
        -- WP-37.  `hr_weekly_apply_transactional` does not authorise: it records
        -- the committed operation and NAMES the post-commit targets in
        -- `auto_authorise_timesheet_ids`, which the established import-review
        -- follow-up owner then acts on.  These three values are that owner's
        -- own handle (`public.import_review_apply_status_get_v1`), so the
        -- acceptance route can run the SAME follow-up the ordinary Imports
        -- route runs instead of inventing a second authorisation path
        -- (`25 §9` "Complete coverage may auto-authorise…").
        'operation_id',v_operation_id,
        'request_hash',v_request_hash,
        'auto_authorise_timesheet_ids',
          coalesce(v_apply->'auto_authorise_timesheet_ids','[]'::jsonb))
    );
  end loop;

  return pg_catalog.jsonb_build_object(
    'ok',true,'publication_id',v_publication_id,
    'operations',v_results,'clients',v_client_results,
    -- WP-37: physical Timesheet ids skipped because the family's canonical
    -- current head is a different row (`24 §9A`), recorded as REFUSED.
    'superseded_heads_refused',v_refused,
    'preset_units_refused',v_preset_refused
  );
end;
$function$;

create or replace function public.weekly_source_mode_a_dispatch_atomic_v1(
  p_request jsonb
) returns jsonb
language plpgsql
volatile
security definer
set search_path to 'public','private','extensions','pg_catalog','pg_temp'
as $function$
declare
  v_actor uuid;
  v_publication_id uuid;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_upload public.weekly_source_uploads%rowtype;
  v_cycle public.weekly_source_cycles%rowtype;
  v_group public.weekly_source_groups%rowtype;
  v_client_id uuid;
  v_client public.clients%rowtype;
  v_authority record;
  v_operation_key text;
  v_import_id uuid;
  v_existing public.hr_imports%rowtype;
  v_min_date date;
  v_max_date date;
  v_staged integer;
  v_preview jsonb;
  v_group_row jsonb;
  v_comparison jsonb;
  v_timesheet public.timesheets%rowtype;
  v_work_event_id uuid;
  v_upload_row public.weekly_source_upload_rows%rowtype;
  v_resolution public.weekly_source_row_resolutions%rowtype;
  v_state text;
  v_reference text;
  v_break_match boolean;
  v_fingerprint bytea;
  v_written integer:=0;
  v_unrepresentable jsonb:='[]'::jsonb;
  v_client_results jsonb:='[]'::jsonb;
  v_source_row_total integer:=0;
  v_dispatched boolean:=false;
  v_reference_apply_required boolean:=false;
  v_preset_units integer:=0;
begin
  if coalesce(current_setting('request.jwt.claim.role',true),
       nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','')<>'service_role' then
    raise exception 'WEEKLY_SOURCE_SERVICE_ROLE_REQUIRED' using errcode='42501';
  end if;
  if p_request is null or pg_catalog.jsonb_typeof(p_request)<>'object'
     or exists(
       select 1 from pg_catalog.jsonb_object_keys(p_request) key
       where key not in ('actor_user_id','publication_id')
     ) then
    raise exception 'WEEKLY_SOURCE_MODE_A_REQUEST_INVALID' using errcode='22023';
  end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid;
    v_publication_id:=(p_request->>'publication_id')::uuid;
  exception when invalid_text_representation then
    raise exception 'WEEKLY_SOURCE_MODE_A_REQUEST_INVALID' using errcode='22023';
  end;
  if v_actor is null or v_publication_id is null then
    raise exception 'WEEKLY_SOURCE_MODE_A_REQUEST_INVALID' using errcode='22023';
  end if;

  select * into v_publication
  from public.weekly_source_projection_publications where id=v_publication_id for update;
  if not found then
    raise exception 'WEEKLY_SOURCE_PUBLICATION_NOT_FOUND' using errcode='22023';
  end if;
  if v_publication.state not in ('CURRENT','CORRECTION_READY') then
    raise exception 'WEEKLY_SOURCE_MODE_A_PUBLICATION_NOT_PUBLISHED' using errcode='55000',
      detail=v_publication.state;
  end if;
  select * into strict v_upload from public.weekly_source_uploads where id=v_publication.upload_id;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_publication.source_cycle_id;
  select * into strict v_group from public.weekly_source_groups where id=v_cycle.source_group_id;

  perform private.weekly_source_office_authority_v1(
    v_actor,'RECHECK_SOURCE',v_group.id,null,v_cycle.finalisation_week_ending
  );
  perform public._import_review_assert_actor_v1(v_actor);

  -- The signed-Timesheet-authority subset of this publication.  Mode A
  -- membership is the resolved authority the projection owner already wrote
  -- to public.weekly_timesheet_authority_resolutions; it is never recomputed
  -- here and never taken from a caller.
  create temporary table if not exists pg_temp.weekly_source_mode_a_rows(
    resolution_id uuid primary key,
    upload_row_id uuid not null,
    work_event_id uuid not null,
    candidate_id uuid not null,
    client_id uuid not null,
    contract_id uuid not null,
    work_date date not null,
    start_at_local timestamp without time zone not null,
    end_at_local timestamp without time zone not null,
    break_minutes integer not null,
    source_candidate_identity text not null,
    role_band_source text,
    external_source_key text
  ) on commit drop;
  delete from pg_temp.weekly_source_mode_a_rows;

  insert into pg_temp.weekly_source_mode_a_rows
  select resolution.id,source_row.id,resolution.work_event_id,resolution.candidate_id,
    resolution.client_id,resolution.contract_id,source_row.work_date,
    source_row.start_at_local,source_row.end_at_local,coalesce(source_row.break_minutes,0),
    source_row.source_candidate_identity,
    coalesce(nullif(pg_catalog.btrim(source_row.role_band_source),''),
      nullif(pg_catalog.btrim(contract.band),''),nullif(pg_catalog.btrim(contract.role),'')),
    source_row.external_source_key
  from public.weekly_source_row_resolutions resolution
  join public.weekly_source_upload_rows source_row on source_row.id=resolution.upload_row_id
  join public.contracts contract on contract.id=resolution.contract_id
  where source_row.upload_id=v_upload.id
    and resolution.generation=coalesce(
      v_publication.projection_generation,v_publication.authority_scope_version::integer)
    and resolution.mapping_state='RESOLVED'
    and resolution.work_event_id is not null
    and resolution.contract_id is not null
    and resolution.candidate_id is not null
    and resolution.client_id is not null
    and source_row.start_at_local is not null
    and source_row.end_at_local is not null
    and (exists(
      select 1 from public.weekly_timesheet_authority_resolutions authority
      where authority.source_cycle_id=v_cycle.id
        and authority.contract_id=resolution.contract_id
        and authority.work_date=source_row.work_date
    ) or private.weekly_source_configured_agency_invoice_v1(resolution.client_id,v_group.id,
      v_group.agency_id,v_group.environment,source_row.work_date));

  select count(*)::integer into v_source_row_total from pg_temp.weekly_source_mode_a_rows;
  if v_source_row_total=0 then
    return pg_catalog.jsonb_build_object(
      'ok',true,'dispatched',false,'reason_code','NO_TIMESHEET_AUTHORITY_ROWS',
      'publication_id',v_publication_id,'clients','[]'::jsonb,
      'reference_apply_required',false,'preset_units',0
    );
  end if;

  for v_client_id in
    select distinct mode_a.client_id from pg_temp.weekly_source_mode_a_rows mode_a order by 1
  loop
    select * into strict v_client from public.clients where id=v_client_id;

    -- Route eligibility is the import-review authority's own answer, per
    -- Contract and worked date.  A Contract that the installed authority does
    -- not consider validation eligible is never bridged.
    if exists(
      select 1 from pg_temp.weekly_source_mode_a_rows mode_a
      cross join lateral public._import_review_effective_authority_core_v1(
        'HR_WEEKLY',mode_a.contract_id,mode_a.client_id,mode_a.work_date
      ) authority
      where mode_a.client_id=v_client_id
        and (coalesce(authority.route_eligible,false) is not true
          or coalesce(authority.validation_eligible,false) is not true)
    ) then
      raise exception 'WEEKLY_SOURCE_MODE_A_ROUTE_NOT_ELIGIBLE' using errcode='55000',
        detail=pg_catalog.jsonb_build_object('client_id',v_client_id)::text;
    end if;

    v_operation_key:=private.weekly_source_mode_a_operation_key_v1(v_publication_id,v_client_id);
    perform pg_catalog.pg_advisory_xact_lock(
      pg_catalog.hashtextextended(v_operation_key,17092026)
    );

    select * into v_existing from public.hr_imports
    where coverage_operation_key=v_operation_key for update;
    if found then
      v_import_id:=v_existing.id;
      v_staged:=(select count(*)::integer from public.hr_rows where import_id=v_import_id);
    else
      -- WP-37 (WP-31 finding F4).  The bridged import's coverage is the
      -- OFFICE-CONFIRMED coverage of the upload, not the min/max of the rows
      -- the file happened to contain.  Deriving it from the rows meant a signed
      -- day the source omitted was never compared at all: no UNMATCHED, no
      -- `SOURCE_SHIFT_MISSING`, and `24 §14`'s "a mismatch uses the existing
      -- manager correction email journey" was bypassed for exactly the case it
      -- exists for.  Confirmed coverage is nullable on the relation, so an
      -- unconfirmed upload fails CLOSED here rather than silently falling back
      -- to the rows.
      v_min_date:=v_upload.confirmed_coverage_start_local_date;
      v_max_date:=v_upload.confirmed_coverage_end_local_date;
      if v_min_date is null or v_max_date is null then
        raise exception 'WEEKLY_SOURCE_MODE_A_COVERAGE_UNCONFIRMED' using errcode='55000',
          detail=pg_catalog.jsonb_build_object(
            'upload_id',v_upload.id,'client_id',v_client_id,
            'coverage_state',v_upload.coverage_state
          )::text;
      end if;
      if exists(
        select 1 from pg_temp.weekly_source_mode_a_rows mode_a
        where mode_a.client_id=v_client_id
          and mode_a.work_date not between v_min_date and v_max_date
      ) then
        raise exception 'WEEKLY_SOURCE_MODE_A_ROW_OUTSIDE_CONFIRMED_COVERAGE' using errcode='55000',
          detail=pg_catalog.jsonb_build_object(
            'upload_id',v_upload.id,'client_id',v_client_id,
            'confirmed_coverage_start',v_min_date,'confirmed_coverage_end',v_max_date
          )::text;
      end if;

      v_import_id:=pg_catalog.gen_random_uuid();
      insert into public.hr_imports(
        id,filename,uploaded_by,uploaded_at_utc,tz_assumption,parse_summary_json,
        source_system,file_r2_key,client_id,import_scope,source_file_sha256,parser_version
      ) values (
        v_import_id,
        'Weekly Source signed-Timesheet authority · '||v_upload.original_filename,
        v_actor,pg_catalog.now(),'Europe/London',
        pg_catalog.jsonb_build_object(
          'status','PARSED','input_format','WEEKLY_SOURCE_MODE_A_BRIDGE',
          'notes','Bridged from a Weekly Source upload for the established validation-only Mode A route',
          'weekly_source_upload_id',v_upload.id,
          'weekly_source_projection_publication_id',v_publication_id,
          'header_rows','[]'::jsonb,'header_columns','[]'::jsonb
        ),
        'HEALTHROSTER'::public.hr_source_enum,null,v_client_id,'HR_WEEKLY',
        pg_catalog.encode(v_upload.content_sha256,'hex'),
        'WEEKLY_SOURCE_MODE_A_BRIDGE_V1'
      );

      -- Staged exactly as the installed HealthRoster weekly parser stages a
      -- file (`broker/src/index.js:114280-114322`): the same payload keys the
      -- validation preview reads, and the raw Candidate identity the source
      -- file carried, so the preview resolves the Candidate through the same
      -- installed alias and mapping authorities.
      insert into public.hr_rows(
        import_id,hr_request_id,date_local,start_time_local,end_time_local,
        staff_norm,role_type,unit_raw,unit_hint,agency_raw,external_row_key,
        payload_json,staff_raw,assignment_grade_norm,hours_worked
      )
      select v_import_id,
        nullif(pg_catalog.btrim(coalesce(mode_a.external_source_key,'')),''),
        mode_a.work_date,
        mode_a.start_at_local::time,
        mode_a.end_at_local::time,
        pg_catalog.lower(pg_catalog.btrim(mode_a.source_candidate_identity)),
        private.weekly_source_mode_a_role_type_v1(
          mode_a.role_band_source,mode_a.source_candidate_identity
        ),
        nullif(pg_catalog.btrim(coalesce(mode_a.role_band_source,'')),''),
        null,'WEEKLY_SOURCE',
        'ws:'||mode_a.upload_row_id::text,
        pg_catalog.jsonb_build_object(
          'type','WEEKLY_SOURCE_MODE_A',
          'staff_name',mode_a.source_candidate_identity,
          'work_date',mode_a.work_date::text,
          'request_id',nullif(pg_catalog.btrim(coalesce(mode_a.external_source_key,'')),''),
          'grade_raw',nullif(pg_catalog.btrim(coalesce(mode_a.role_band_source,'')),''),
          'start_local',pg_catalog.to_char(mode_a.start_at_local,'HH24:MI'),
          'end_local',pg_catalog.to_char(mode_a.end_at_local,'HH24:MI'),
          'break_mins',mode_a.break_minutes,
          'actual_break_mins',mode_a.break_minutes,
          'break_evidence_supplied',true,
          'break_inferred_from_worked_hours',false,
          'start_utc',(mode_a.start_at_local at time zone 'Europe/London'),
          'end_utc',(mode_a.end_at_local at time zone 'Europe/London'),
          'weekly_source_upload_row_id',mode_a.upload_row_id,
          'weekly_source_work_event_id',mode_a.work_event_id
        ),
        mode_a.source_candidate_identity,
        nullif(pg_catalog.btrim(coalesce(mode_a.role_band_source,'')),''),
        pg_catalog.round(
          (pg_catalog.date_part('epoch',mode_a.end_at_local-mode_a.start_at_local)/60
            -mode_a.break_minutes)::numeric/60,2
        )
      from pg_temp.weekly_source_mode_a_rows mode_a
      where mode_a.client_id=v_client_id;
      get diagnostics v_staged=row_count;

      update public.hr_imports
      set parse_summary_json=parse_summary_json||pg_catalog.jsonb_build_object(
        'rows_total',v_staged,'rows_parsed',v_staged,'rows_skipped',0
      )
      where id=v_import_id;

      perform public._import_review_create_core_v2(
        v_import_id,'COMPLETE_ALL',v_min_date,v_max_date,
        pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
          'source_client_key','client:'||v_client_id::text,
          'source_display_label',v_client.name,
          'client_id',v_client_id
        )),
        '[]'::jsonb,
        pg_catalog.encode(v_upload.content_sha256,'hex'),
        'WEEKLY_SOURCE_MODE_A_BRIDGE_V1',
        v_actor,v_operation_key,null,null
      );
    end if;

    -- THE established validation-only comparison engine.  Nothing below
    -- recomputes hours, breaks or references; it only records what this owner
    -- decided.
    v_preview:=public.hr_weekly_validation_preview(v_import_id);

    for v_group_row in
      select value from pg_catalog.jsonb_array_elements(coalesce(v_preview->'rows','[]'::jsonb))
    loop
      if nullif(v_group_row->>'timesheet_id','') is null then
        v_unrepresentable:=v_unrepresentable||pg_catalog.jsonb_build_array(
          pg_catalog.jsonb_build_object(
            'reason','NO_TIMESHEET','candidate_id',v_group_row->>'candidate_id',
            'week_ending_date',v_group_row->>'week_ending_date'
          )
        );
        continue;
      end if;
      select * into v_timesheet from public.timesheets
      where timesheet_id=(v_group_row->>'timesheet_id')::uuid;
      if not found then continue; end if;

      for v_comparison in
        select value from pg_catalog.jsonb_array_elements(
          coalesce(v_group_row->'comparisons','[]'::jsonb)
        )
      loop
        -- Only a comparison that the established owner paired to exactly one
        -- staged source row can be represented: the relation requires both a
        -- Weekly Source work event and the signed Candidate times.
        if nullif(v_comparison->>'hr_row_id','') is null
           or nullif(v_comparison->>'timesheet_start','') is null
           or nullif(v_comparison->>'timesheet_end','') is null then
          v_unrepresentable:=v_unrepresentable||pg_catalog.jsonb_build_array(
            pg_catalog.jsonb_build_object(
              'reason',coalesce(v_comparison->>'match_status','UNKNOWN'),
              'timesheet_id',v_group_row->>'timesheet_id',
              'work_date',v_comparison->>'work_date'
            )
          );
          continue;
        end if;

        select * into v_upload_row from public.weekly_source_upload_rows
        where id=(
          select (row_data.payload_json->>'weekly_source_upload_row_id')::uuid
          from public.hr_rows row_data where row_data.id=(v_comparison->>'hr_row_id')::uuid
        );
        if not found then continue; end if;
        select * into v_resolution from public.weekly_source_row_resolutions resolution
        where resolution.upload_row_id=v_upload_row.id
          and resolution.generation=coalesce(
            v_publication.projection_generation,v_publication.authority_scope_version::integer);
        if not found or v_resolution.work_event_id is null then continue; end if;
        v_work_event_id:=v_resolution.work_event_id;

        v_reference:=nullif(pg_catalog.btrim(coalesce(v_comparison->>'ref_after','')),'');
        v_break_match:=coalesce(
          (v_comparison->>'timesheet_break_mins')::integer,0
        )=coalesce((v_comparison->>'healthroster_break_mins')::integer,0);
        v_state:=case
          when pg_catalog.upper(coalesce(v_comparison->>'match_status',''))='MATCH'
            and v_reference is not null and v_break_match then 'EXACT_MATCH'
          when pg_catalog.upper(coalesce(v_comparison->>'match_status',''))='MATCH'
            then 'REFERENCE_MISSING'
          when pg_catalog.upper(coalesce(v_comparison->>'match_status',''))='AMBIGUOUS'
            then 'AMBIGUOUS_SOURCE_ROW'
          else 'HOURS_MISMATCH' end;

        v_fingerprint:=private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_TIMESHEET_SOURCE_COMPARISON_V1',
          pg_catalog.jsonb_build_object(
            'projection_publication_id',v_publication_id,
            'timesheet_id',v_timesheet.timesheet_id,
            'timesheet_revision',v_timesheet.version,
            'work_event_id',v_work_event_id,
            'comparison',v_comparison
          )
        );

        insert into public.weekly_timesheet_source_comparisons(
          source_cycle_id,upload_id,projection_publication_id,upload_row_id,
          timesheet_id,timesheet_revision,work_event_id,contract_id,work_date,
          comparison_state,candidate_start_at_local,candidate_end_at_local,
          candidate_break_minutes,source_start_at_local,source_end_at_local,
          source_break_minutes,total_break_minutes_match,source_reference_number,
          comparison_fingerprint
        ) values (
          v_cycle.id,v_upload.id,v_publication_id,v_upload_row.id,
          v_timesheet.timesheet_id,v_timesheet.version,v_work_event_id,
          v_resolution.contract_id,(v_comparison->>'work_date')::date,
          v_state,
          ((v_comparison->>'work_date')||' '||(v_comparison->>'timesheet_start'))::timestamp,
          ((v_comparison->>'work_date')||' '||(v_comparison->>'timesheet_end'))::timestamp
            +case when (v_comparison->>'timesheet_end')::time<=(v_comparison->>'timesheet_start')::time
                  then interval '1 day' else interval '0' end,
          coalesce((v_comparison->>'timesheet_break_mins')::integer,0),
          v_upload_row.start_at_local,v_upload_row.end_at_local,
          v_upload_row.break_minutes,v_break_match,v_reference,
          v_fingerprint
        ) on conflict (projection_publication_id,timesheet_id,timesheet_revision,work_event_id)
          do nothing;
        if found then v_written:=v_written+1; end if;
      end loop;
    end loop;

    -- Native units are read AFTER the unchanged comparison/bridge writer.
    -- The caller gets only the owner's continuation choice, never raw units.
    v_reference_apply_required:=v_reference_apply_required or exists(
      select 1 from private.weekly_source_agency_mode_a_units_v1(v_import_id) n where not n.has_preset);
    v_preset_units:=v_preset_units+(select count(*)::integer
      from private.weekly_source_agency_mode_a_units_v1(v_import_id) n where n.has_preset);
    v_dispatched:=true;
    v_client_results:=v_client_results||pg_catalog.jsonb_build_array(
      pg_catalog.jsonb_build_object(
        'client_id',v_client_id,'import_id',v_import_id,
        'staged_source_rows',v_staged,
        'unmapped_candidate_rows',v_preview->'unmapped_candidate_rows',
        'unmatched_timesheet_triples',v_preview->'unmatched_timesheet_triples'
      )
    );
  end loop;

  -- Comparison staging remains Mode A's. Validation is the one typed
  -- whole-week writer and observes the actual bridge/comparisons now present.
  perform private.weekly_source_agency_publication_validation_v1(v_publication_id);
  return pg_catalog.jsonb_build_object(
    'ok',true,'dispatched',v_dispatched,'publication_id',v_publication_id,
    'timesheet_authority_rows',v_source_row_total,
    'comparisons_written',v_written,
    'comparisons_not_representable',v_unrepresentable,
    'clients',v_client_results,
    'reference_apply_required',v_reference_apply_required,'preset_units',v_preset_units
  );
end;
$function$;

create or replace function public.contracts_clone_and_extend_atomic(
  p_contract_id uuid,
  p_new_start_date date,
  p_new_end_date date,
  p_end_existing_on date,
  p_assign_existing_candidate boolean,
  p_new_candidate_id uuid default null,
  p_split_worker_note text default null,
  p_successor_overrides jsonb default null,
  p_force_schedule_clashes boolean default false,
  p_force_already_split_week boolean default false,
  p_confirmed_split_week boolean default false,
  p_actor_user_id uuid default null
) returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare
  v_now                 timestamptz := now();

  v_cur                 public.contracts%rowtype;
  v_succ                public.contracts%rowtype;

  v_ov                  jsonb := coalesce(p_successor_overrides, '{}'::jsonb);

  v_close_to            date := p_end_existing_on;
  v_new_start           date := p_new_start_date;
  v_new_end             date := p_new_end_date;

  v_wew_pred            int;
  v_wew_succ            int;

  v_end_we_old          date;
  v_boundary_week_end   date;
  v_boundary_week_start date;

  v_split_week          boolean := false;
  v_already_split       boolean := false;
  v_split_note          text := null;
  v_split_group_key     text := null;
  v_old_mask            text := null;
  v_new_mask            text := null;

  v_schedule_clashes    jsonb := null;
  v_overlap_warnings    jsonb := '[]'::jsonb;
  v_clash_count         int := 0;

  v_err                 jsonb;

  -- Successor computed fields (merged overrides)
  v_succ_candidate_id   uuid;
  v_succ_client_id      uuid;
  v_succ_role           text;
  v_succ_band           text;
  v_succ_display_site   text;
  v_succ_ward_hint      text;

  v_succ_pay_method_snapshot text;
  v_succ_rates_json          jsonb;
  v_succ_std_schedule_json   jsonb;
  v_succ_std_hours_json      jsonb;
  v_succ_bucket_labels_json  jsonb;
  v_succ_additional_rates_json jsonb;

  v_succ_weekly_timesheet_source public.weekly_timesheet_source_enum;
  v_succ_overrideclientsettings boolean;
  v_succ_no_timesheet_required boolean;
  v_succ_daily_calc_of_invoices boolean;
  v_succ_group_nightsat_sunbh boolean;
  v_succ_is_nhsp boolean;
  v_succ_autoprocess_hr boolean;
  v_succ_requires_hr boolean;
  v_succ_hr_attach_to_invoice boolean;
  v_succ_ts_attach_to_invoice boolean;
  v_succ_reference_number_required_to_issue_invoice boolean;
  v_succ_send_manual_invoices_to_different_email boolean;
  v_succ_manual_invoices_alt_email_address text;
  v_succ_send_ts_queries_to_different_email boolean;
  v_succ_ts_queries_alt_email_address text;
  v_succ_is_ad_hoc boolean;
  v_succ_default_submission_mode public.submission_mode_enum;
  v_succ_timesheet_break_entry_mode public.timesheet_break_entry_mode_enum;

  -- std_hours derivation scratch
  v_day_key text;
  v_day_cfg jsonb;
  v_start_str text;
  v_end_str text;
  v_break_minutes numeric;
  v_start_h int;
  v_start_m int;
  v_end_h int;
  v_end_m int;
  v_start_mins int;
  v_end_mins int;
  v_minutes int;
  v_expected_minutes int;
  v_hours numeric;

  -- Split boundary hard-block helper
  v_bad_contract_id uuid;
  v_bad_timesheet_id uuid;

  -- Audit helpers
  v_before_state jsonb;
  v_after_state jsonb;
  v_audit_reason text;

  -- sink for CTE
  v_dummy int;

  -- =====================================================
  -- DEBUGGING (gated by settings_defaults.invoice_debug)
  -- =====================================================
  v_invoice_debug boolean := false;
  v_dbg_started_at timestamptz := clock_timestamp();
  v_dbg_steps jsonb := '[]'::jsonb;
  v_dbg_sqlstate text := null;
  v_dbg_error text := null;
  v_dbg_detail text := null;
  v_dbg_hint text := null;
  v_dbg_context text := null;
  v_dbg_stats jsonb := '{}'::jsonb;

  v_rc int := 0;

begin
  -- ─────────────────────────────────────────────────────────────
  -- Load invoice_debug flag (safe if column/table not present)
  -- ─────────────────────────────────────────────────────────────
  begin
    select coalesce(sd.invoice_debug, false)
      into v_invoice_debug
      from public.settings_defaults sd
     where sd.id = 1
     limit 1;
  exception
    when undefined_column then
      v_invoice_debug := false;
    when undefined_table then
      v_invoice_debug := false;
    when others then
      -- never allow debug flag read to break functional flow
      v_invoice_debug := false;
  end;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','start',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'inputs', jsonb_build_object(
          'p_contract_id', coalesce(p_contract_id::text,''),
          'p_new_start_date', coalesce(p_new_start_date::text,''),
          'p_new_end_date', coalesce(p_new_end_date::text,''),
          'p_end_existing_on', coalesce(p_end_existing_on::text,''),
          'p_assign_existing_candidate', coalesce(p_assign_existing_candidate, true),
          'p_new_candidate_id', coalesce(p_new_candidate_id::text,''),
          'p_split_worker_note', coalesce(p_split_worker_note,''),
          'p_successor_overrides_type', case when p_successor_overrides is null then 'null' else jsonb_typeof(p_successor_overrides) end,
          'p_force_schedule_clashes', coalesce(p_force_schedule_clashes,false),
          'p_force_already_split_week', coalesce(p_force_already_split_week,false),
          'p_confirmed_split_week', coalesce(p_confirmed_split_week,false),
          'p_actor_user_id', coalesce(p_actor_user_id::text,'')
        )
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Basic input validation
  -- ─────────────────────────────────────────────────────────────
  if p_contract_id is null then
    v_err := jsonb_build_object('error','INVALID_INPUT','message','p_contract_id is required');

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','fail_validation',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'reason','p_contract_id is null',
          'error', v_err
        )
      );
    end if;

    raise exception using message = v_err::text;
  end if;

  if v_new_start is null or v_new_end is null then
    v_err := jsonb_build_object('error','INVALID_INPUT','message','p_new_start_date and p_new_end_date are required');

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','fail_validation',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'reason','new_start or new_end is null',
          'error', v_err,
          'computed', jsonb_build_object('v_new_start', coalesce(v_new_start::text,''), 'v_new_end', coalesce(v_new_end::text,''))
        )
      );
    end if;

    raise exception using message = v_err::text;
  end if;

  if v_new_start > v_new_end then
    v_err := jsonb_build_object('error','INVALID_INPUT','message','p_new_start_date must be <= p_new_end_date');

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','fail_validation',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'reason','v_new_start > v_new_end',
          'computed', jsonb_build_object('v_new_start', v_new_start, 'v_new_end', v_new_end),
          'error', v_err
        )
      );
    end if;

    raise exception using message = v_err::text;
  end if;

  if v_close_to is null then
    v_err := jsonb_build_object('error','INVALID_INPUT','message','p_end_existing_on is required');

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','fail_validation',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'reason','v_close_to is null',
          'error', v_err
        )
      );
    end if;

    raise exception using message = v_err::text;
  end if;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','validation_ok',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'computed', jsonb_build_object('v_new_start', v_new_start, 'v_new_end', v_new_end, 'v_close_to', v_close_to)
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Lock predecessor contract
  -- ─────────────────────────────────────────────────────────────
  select c.*
    into v_cur
    from public.contracts as c
   where c.id = p_contract_id
   for update;

  if not found then
    v_err := jsonb_build_object('error','CONTRACT_NOT_FOUND','contract_id',p_contract_id);

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','contract_not_found',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'error', v_err
        )
      );
    end if;

    raise exception using message = v_err::text;
  end if;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','locked_predecessor',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'predecessor', jsonb_build_object(
          'id', v_cur.id,
          'candidate_id', coalesce(v_cur.candidate_id::text,''),
          'client_id', coalesce(v_cur.client_id::text,''),
          'start_date', v_cur.start_date,
          'end_date', v_cur.end_date,
          'week_ending_weekday_snapshot', v_cur.week_ending_weekday_snapshot
        )
      )
    );
  end if;

  -- Close window rules (end-existing enforced)
  if v_close_to < v_cur.start_date then
    v_err := jsonb_build_object(
      'error','INVALID_INPUT',
      'message','p_end_existing_on must be >= predecessor.start_date',
      'predecessor_start_date', v_cur.start_date,
      'end_existing_on', v_close_to
    );

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','fail_close_window_rule',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'reason','close_to < predecessor.start_date',
          'error', v_err
        )
      );
    end if;

    raise exception using message = v_err::text;
  end if;

  if v_close_to > (v_new_start - 1) then
    v_err := jsonb_build_object(
      'error','INVALID_INPUT',
      'message','p_end_existing_on must be <= p_new_start_date - 1 day',
      'end_existing_on', v_close_to,
      'new_start_date', v_new_start
    );

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','fail_close_window_rule',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'reason','close_to > new_start - 1',
          'error', v_err,
          'computed', jsonb_build_object('new_start_minus_1', (v_new_start - 1))
        )
      );
    end if;

    raise exception using message = v_err::text;
  end if;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','close_window_rules_ok',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'computed', jsonb_build_object(
          'predecessor_start_date', v_cur.start_date,
          'close_to', v_close_to,
          'new_start', v_new_start,
          'close_to_max', (v_new_start - 1)
        )
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Determine successor candidate assignment
  -- ─────────────────────────────────────────────────────────────
  if coalesce(p_assign_existing_candidate, true) then
    v_succ_candidate_id := v_cur.candidate_id;

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','succ_candidate_assignment',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'path','assign_existing_candidate',
          'successor_candidate_id', coalesce(v_succ_candidate_id::text,'')
        )
      );
    end if;

  else
    if p_new_candidate_id is not null then
      v_succ_candidate_id := p_new_candidate_id;

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','succ_candidate_assignment',
            'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
            'path','explicit_param_new_candidate_id',
            'successor_candidate_id', coalesce(v_succ_candidate_id::text,'')
          )
        );
      end if;

    elsif (v_ov ? 'candidate_id') and nullif(btrim(v_ov->>'candidate_id'), '') is not null then
      v_succ_candidate_id := (v_ov->>'candidate_id')::uuid;

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','succ_candidate_assignment',
            'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
            'path','override_candidate_id',
            'successor_candidate_id', coalesce(v_succ_candidate_id::text,'')
          )
        );
      end if;

    else
      v_succ_candidate_id := null;

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','succ_candidate_assignment',
            'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
            'path','no_candidate_assigned',
            'successor_candidate_id',''
          )
        );
      end if;

    end if;
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Predecessor week-ending snapshot validation + derived dates
  -- ─────────────────────────────────────────────────────────────
  v_wew_pred := coalesce(v_cur.week_ending_weekday_snapshot, 0);

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','predecessor_wew_loaded',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'week_ending_weekday_snapshot', v_wew_pred
      )
    );
  end if;

  if v_wew_pred < 0 or v_wew_pred > 6 then
    v_err := jsonb_build_object(
      'error','INVALID_CONTRACT_STATE',
      'message','predecessor.week_ending_weekday_snapshot must be 0..6',
      'week_ending_weekday_snapshot', v_cur.week_ending_weekday_snapshot
    );

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','fail_predecessor_wew_validation',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'error', v_err
        )
      );
    end if;

    raise exception using message = v_err::text;
  end if;

  -- endWEOld = week ending date of the week containing close_to (using predecessor snapshot)
  v_end_we_old :=
    (v_close_to + (((v_wew_pred - extract(dow from v_close_to)::int + 7) % 7)) * interval '1 day')::date;

  -- boundary week for newStart (using predecessor snapshot)
  v_boundary_week_end :=
    (v_new_start + (((v_wew_pred - extract(dow from v_new_start)::int + 7) % 7)) * interval '1 day')::date;
  v_boundary_week_start := (v_boundary_week_end - interval '6 days')::date;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','derived_dates',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'computed', jsonb_build_object(
          'v_wew_pred', v_wew_pred,
          'v_end_we_old', v_end_we_old,
          'v_boundary_week_start', v_boundary_week_start,
          'v_boundary_week_end', v_boundary_week_end,
          'v_new_start', v_new_start,
          'v_new_end', v_new_end,
          'v_close_to', v_close_to
        )
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Hard block: submitted beyond close window
  -- ─────────────────────────────────────────────────────────────
  if exists (
    select 1
      from public.contract_weeks as cw
     where cw.contract_id = v_cur.id
       and cw.timesheet_id is not null
       and cw.week_ending_date > v_end_we_old
  ) then
    v_err := jsonb_build_object(
      'error','SUBMITTED_BEYOND_CLOSE',
      'contract_id', v_cur.id,
      'end_week_ending_date', v_end_we_old
    );

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','fail_submitted_beyond_close',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'error', v_err
        )
      );
    end if;

    raise exception using message = v_err::text;
  end if;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','submitted_beyond_close_check_ok',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'contract_id', v_cur.id::text,
        'end_we_old', v_end_we_old
      )
    );
  end if;

  -- NEW HARD RULE: ending week submitted + midweek truncation
  if v_close_to < v_end_we_old then
    if exists (
      select 1
        from public.contract_weeks as cw
       where cw.contract_id = v_cur.id
         and cw.week_ending_date = v_end_we_old
         and cw.timesheet_id is not null
    ) then
      v_err := jsonb_build_object(
        'error','ENDING_WEEK_SUBMITTED_CANNOT_TRUNCATE',
        'contract_id', v_cur.id,
        'close_to', v_close_to,
        'week_ending_date', v_end_we_old
      );

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','fail_ending_week_submitted_midweek_truncation',
            'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
            'error', v_err
          )
        );
      end if;

      raise exception using message = v_err::text;
    end if;
  end if;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','ending_week_truncation_rule_ok',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'close_to', v_close_to,
        'end_we_old', v_end_we_old,
        'is_midweek_truncation', (v_close_to < v_end_we_old)
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Split-week eligibility (same candidate on both halves + newStart midweek + predecessor ends in that same week)
  -- ─────────────────────────────────────────────────────────────
  v_split_week := (
    v_cur.candidate_id is not null
    and v_succ_candidate_id is not null
    and v_cur.candidate_id = v_succ_candidate_id
    and v_new_start <> v_boundary_week_start
    and v_end_we_old = v_boundary_week_end
  );

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','split_week_eligibility',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'components', jsonb_build_object(
          'pred_candidate_not_null', (v_cur.candidate_id is not null),
          'succ_candidate_not_null', (v_succ_candidate_id is not null),
          'same_candidate', (v_cur.candidate_id is not null and v_succ_candidate_id is not null and v_cur.candidate_id = v_succ_candidate_id),
          'new_start_is_midweek', (v_new_start <> v_boundary_week_start),
          'pred_end_week_equals_boundary_week', (v_end_we_old = v_boundary_week_end)
        ),
        'result', v_split_week
      )
    );
  end if;

  if v_split_week then
    -- Hard block: boundary week already submitted (contract-based definition)
    select cw2.contract_id, cw2.timesheet_id
      into v_bad_contract_id, v_bad_timesheet_id
      from public.contracts as c2
      join public.contract_weeks as cw2
        on cw2.contract_id = c2.id
     where c2.candidate_id = v_cur.candidate_id
       and c2.client_id = v_cur.client_id
       and c2.start_date <= v_boundary_week_end
       and c2.end_date >= v_boundary_week_start
       and cw2.week_ending_date = v_boundary_week_end
       and cw2.timesheet_id is not null
     limit 1;

    if found then
      v_err := jsonb_build_object(
        'error','BOUNDARY_WEEK_TIMESHEET_ALREADY_SUBMITTED',
        'candidate_id', v_cur.candidate_id,
        'client_id', v_cur.client_id,
        'week_start', v_boundary_week_start,
        'week_end', v_boundary_week_end,
        'boundary_week_end', v_boundary_week_end,
        'contract_id', v_bad_contract_id,
        'timesheet_id', v_bad_timesheet_id
      );

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','fail_boundary_week_already_submitted',
            'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
            'found_contract_id', coalesce(v_bad_contract_id::text,''),
            'found_timesheet_id', coalesce(v_bad_timesheet_id::text,''),
            'error', v_err
          )
        );
      end if;

      raise exception using message = v_err::text;
    end if;

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','boundary_week_submitted_check_ok',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'boundary_week_end', v_boundary_week_end
        )
      );
    end if;

    -- Already split detection (another overlapping contract for same candidate+client in boundary week)
    select exists (
      select 1
        from public.contracts as c2
       where c2.id <> v_cur.id
         and c2.candidate_id = v_cur.candidate_id
         and c2.client_id = v_cur.client_id
         and c2.start_date <= v_boundary_week_end
         and c2.end_date >= v_boundary_week_start
    ) into v_already_split;

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','already_split_detection',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'already_split', v_already_split,
          'p_force_already_split_week', coalesce(p_force_already_split_week,false)
        )
      );
    end if;

    if v_already_split and not coalesce(p_force_already_split_week, false) then
      v_err := jsonb_build_object(
        'error','ALREADY_SPLIT_WEEK',
        'candidate_id', v_cur.candidate_id,
        'client_id', v_cur.client_id,
        'week_start', v_boundary_week_start,
        'week_end', v_boundary_week_end,
        'boundary_date', v_new_start,
        'overlapping_contract_ids', (
          select coalesce(jsonb_agg(c2.id order by c2.start_date), '[]'::jsonb)
            from public.contracts as c2
           where c2.candidate_id = v_cur.candidate_id
             and c2.client_id = v_cur.client_id
             and c2.start_date <= v_boundary_week_end
             and c2.end_date >= v_boundary_week_start
        )
      );

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','fail_already_split_week_not_forced',
            'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
            'error', v_err
          )
        );
      end if;

      raise exception using message = v_err::text;
    end if;

    -- Allowed day masks (Mon..Sun)
    -- Old half: max(predecessor.start_date, week_start) .. closeTo
    if greatest(v_cur.start_date, v_boundary_week_start) > v_close_to then
      v_old_mask := '0000000';

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','old_mask_computed',
            'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
            'path','empty_range',
            'old_allowed_from', greatest(v_cur.start_date, v_boundary_week_start),
            'old_allowed_to', v_close_to,
            'old_mask', v_old_mask
          )
        );
      end if;

    else
      select string_agg(case when d.pos is not null then '1' else '0' end, '' order by p.pos)
        into v_old_mask
        from generate_series(0, 6) as p(pos)
        left join (
          select distinct ((extract(dow from dt)::int + 6) % 7) as pos
            from generate_series(
                   greatest(v_cur.start_date, v_boundary_week_start)::timestamp,
                   v_close_to::timestamp,
                   interval '1 day'
                 ) as dt
        ) as d
          on d.pos = p.pos;

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','old_mask_computed',
            'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
            'path','generate_series',
            'old_allowed_from', greatest(v_cur.start_date, v_boundary_week_start),
            'old_allowed_to', v_close_to,
            'old_mask', v_old_mask
          )
        );
      end if;

    end if;

    -- New half: newStart .. min(newEnd, week_end)
    if v_new_start > least(v_new_end, v_boundary_week_end) then
      v_new_mask := '0000000';

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','new_mask_computed',
            'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
            'path','empty_range',
            'new_allowed_from', v_new_start,
            'new_allowed_to', least(v_new_end, v_boundary_week_end),
            'new_mask', v_new_mask
          )
        );
      end if;

    else
      select string_agg(case when d.pos is not null then '1' else '0' end, '' order by p.pos)
        into v_new_mask
        from generate_series(0, 6) as p(pos)
        left join (
          select distinct ((extract(dow from dt)::int + 6) % 7) as pos
            from generate_series(
                   v_new_start::timestamp,
                   least(v_new_end, v_boundary_week_end)::timestamp,
                   interval '1 day'
                 ) as dt
        ) as d
          on d.pos = p.pos;

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','new_mask_computed',
            'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
            'path','generate_series',
            'new_allowed_from', v_new_start,
            'new_allowed_to', least(v_new_end, v_boundary_week_end),
            'new_mask', v_new_mask
          )
        );
      end if;

    end if;

    -- Confirm gating (note required)
    v_split_note := btrim(coalesce(p_split_worker_note, ''));

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','split_week_confirm_gating',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'p_confirmed_split_week', coalesce(p_confirmed_split_week,false),
          'split_note_empty', (v_split_note = ''),
          'split_note_len', length(v_split_note),
          'old_mask', v_old_mask,
          'new_mask', v_new_mask
        )
      );
    end if;

    if (not coalesce(p_confirmed_split_week, false)) or v_split_note = '' then
      v_err := jsonb_build_object(
        'error','SPLIT_WEEK_CONFIRM_REQUIRED',
        'candidate_id', v_cur.candidate_id,
        'client_id', v_cur.client_id,
        'week_start', v_boundary_week_start,
        'week_end', v_boundary_week_end,
        'boundary_date', v_new_start,
        'old_allowed_from', greatest(v_cur.start_date, v_boundary_week_start),
        'old_allowed_to', v_close_to,
        'new_allowed_from', v_new_start,
        'new_allowed_to', least(v_new_end, v_boundary_week_end),
        'old_allowed_mask', v_old_mask,
        'new_allowed_mask', v_new_mask,
        'suggested_worker_note',
          ('Contract rates have changed this week and therefore you need to submit two timesheets. One timesheet for work completed for ' ||
           to_char(greatest(v_cur.start_date, v_boundary_week_start),'YYYY-MM-DD') || ' to ' ||
           to_char(v_close_to,'YYYY-MM-DD') || ' and another timesheet for ' ||
           to_char(v_new_start,'YYYY-MM-DD') || ' to ' ||
           to_char(least(v_new_end, v_boundary_week_end),'YYYY-MM-DD') || '.')
      );

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','fail_split_week_confirm_required',
            'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
            'error', v_err
          )
        );
      end if;

      raise exception using message = v_err::text;
    end if;

    v_split_group_key := gen_random_uuid()::text;

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','split_week_confirmed',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'split_group_key', v_split_group_key,
          'worker_note', v_split_note
        )
      );
    end if;

  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Build successor merged fields from overrides
  -- ─────────────────────────────────────────────────────────────
  v_succ_client_id := coalesce(nullif(btrim(v_ov->>'client_id'), '')::uuid, v_cur.client_id);
  v_succ_role := coalesce(v_ov->>'role', v_cur.role);
  v_succ_band := coalesce(v_ov->>'band', v_cur.band);
  v_succ_display_site := coalesce(v_ov->>'display_site', v_cur.display_site);
  v_succ_ward_hint := coalesce(v_ov->>'ward_hint', v_cur.ward_hint);

  v_succ_pay_method_snapshot := coalesce(nullif(btrim(v_ov->>'pay_method_snapshot'), ''), v_cur.pay_method_snapshot);

  if (v_ov ? 'rates_json') and jsonb_typeof(v_ov->'rates_json') <> 'null' then
    v_succ_rates_json := v_ov->'rates_json';
  else
    v_succ_rates_json := v_cur.rates_json;
  end if;
  v_succ_rates_json := coalesce(v_succ_rates_json, '{}'::jsonb);

  if (v_ov ? 'std_schedule_json') then
    if jsonb_typeof(v_ov->'std_schedule_json') = 'null' then
      v_succ_std_schedule_json := null;
    else
      v_succ_std_schedule_json := v_ov->'std_schedule_json';
    end if;
  else
    v_succ_std_schedule_json := v_cur.std_schedule_json;
  end if;

  if v_succ_std_schedule_json is not null and jsonb_typeof(v_succ_std_schedule_json) = 'object' then
    -- Derive std_hours_json from std_schedule_json
    v_succ_std_hours_json := '{}'::jsonb;

    foreach v_day_key in array array['mon','tue','wed','thu','fri','sat','sun'] loop
      v_day_cfg := v_succ_std_schedule_json->v_day_key;

      if v_day_cfg is not null and jsonb_typeof(v_day_cfg) = 'object' then
        v_start_str := v_day_cfg->>'start';
        v_end_str := v_day_cfg->>'end';

        if v_start_str ~ '^[0-9]{1,2}:[0-9]{2}$' then
          v_start_h := split_part(v_start_str,':',1)::int;
          v_start_m := split_part(v_start_str,':',2)::int;
          if v_start_h between 0 and 23 and v_start_m between 0 and 59 then
            v_start_mins := v_start_h * 60 + v_start_m;
          else
            v_start_mins := null;
          end if;
        else
          v_start_mins := null;
        end if;

        if v_end_str ~ '^[0-9]{1,2}:[0-9]{2}$' then
          v_end_h := split_part(v_end_str,':',1)::int;
          v_end_m := split_part(v_end_str,':',2)::int;
          if v_end_h between 0 and 23 and v_end_m between 0 and 59 then
            v_end_mins := v_end_h * 60 + v_end_m;
          else
            v_end_mins := null;
          end if;
        else
          v_end_mins := null;
        end if;

        v_break_minutes := 0;
        if (v_day_cfg ? 'break_minutes')
          and (v_day_cfg->>'break_minutes') is not null
          and (v_day_cfg->>'break_minutes') ~ '^[0-9]+(\.[0-9]+)?$'
        then
          v_break_minutes := (v_day_cfg->>'break_minutes')::numeric;
        end if;

        if v_start_mins is not null and v_end_mins is not null then
          if v_end_mins <= v_start_mins then
            v_minutes := 1440 - v_start_mins + v_end_mins;
          else
            v_minutes := v_end_mins - v_start_mins;
          end if;

          v_expected_minutes := greatest(0, (v_minutes - v_break_minutes)::int);
          v_hours := round((v_expected_minutes::numeric / 60.0), 2);
        else
          v_hours := 0;
        end if;
      else
        v_hours := 0;
      end if;

      v_succ_std_hours_json := v_succ_std_hours_json || jsonb_build_object(v_day_key, v_hours);
    end loop;
  else
    if (v_ov ? 'std_hours_json') then
      if jsonb_typeof(v_ov->'std_hours_json') = 'null' then
        v_succ_std_hours_json := null;
      else
        v_succ_std_hours_json := v_ov->'std_hours_json';
      end if;
    else
      v_succ_std_hours_json := v_cur.std_hours_json;
    end if;
  end if;

  if (v_ov ? 'bucket_labels_json') then
    if jsonb_typeof(v_ov->'bucket_labels_json') = 'null' then
      v_succ_bucket_labels_json := null;
    else
      v_succ_bucket_labels_json := v_ov->'bucket_labels_json';
    end if;
  else
    v_succ_bucket_labels_json := v_cur.bucket_labels_json;
  end if;

  if (v_ov ? 'additional_rates_json') then
    if jsonb_typeof(v_ov->'additional_rates_json') = 'null' then
      v_succ_additional_rates_json := null;
    else
      v_succ_additional_rates_json := v_ov->'additional_rates_json';
    end if;
  else
    v_succ_additional_rates_json := v_cur.additional_rates_json;
  end if;

  if (v_ov ? 'weekly_timesheet_source') then
    v_succ_weekly_timesheet_source := nullif(btrim(v_ov->>'weekly_timesheet_source'), '')::public.weekly_timesheet_source_enum;
  else
    v_succ_weekly_timesheet_source := v_cur.weekly_timesheet_source;
  end if;

  if (v_ov ? 'overrideclientsettings') and jsonb_typeof(v_ov->'overrideclientsettings') <> 'null' then
    v_succ_overrideclientsettings := (v_ov->>'overrideclientsettings')::boolean;
  else
    v_succ_overrideclientsettings := v_cur.overrideclientsettings;
  end if;
  v_succ_overrideclientsettings := coalesce(v_succ_overrideclientsettings, false);

  if (v_ov ? 'no_timesheet_required') then
    if jsonb_typeof(v_ov->'no_timesheet_required') = 'null' then
      v_succ_no_timesheet_required := null;
    else
      v_succ_no_timesheet_required := (v_ov->>'no_timesheet_required')::boolean;
    end if;
  else
    v_succ_no_timesheet_required := v_cur.no_timesheet_required;
  end if;

  if (v_ov ? 'daily_calc_of_invoices') then
    if jsonb_typeof(v_ov->'daily_calc_of_invoices') = 'null' then
      v_succ_daily_calc_of_invoices := null;
    else
      v_succ_daily_calc_of_invoices := (v_ov->>'daily_calc_of_invoices')::boolean;
    end if;
  else
    v_succ_daily_calc_of_invoices := v_cur.daily_calc_of_invoices;
  end if;

  if (v_ov ? 'group_nightsat_sunbh') then
    if jsonb_typeof(v_ov->'group_nightsat_sunbh') = 'null' then
      v_succ_group_nightsat_sunbh := null;
    else
      v_succ_group_nightsat_sunbh := (v_ov->>'group_nightsat_sunbh')::boolean;
    end if;
  else
    v_succ_group_nightsat_sunbh := v_cur.group_nightsat_sunbh;
  end if;

  if (v_ov ? 'is_nhsp') then
    if jsonb_typeof(v_ov->'is_nhsp') = 'null' then
      v_succ_is_nhsp := null;
    else
      v_succ_is_nhsp := (v_ov->>'is_nhsp')::boolean;
    end if;
  else
    v_succ_is_nhsp := v_cur.is_nhsp;
  end if;

  if (v_ov ? 'autoprocess_hr') then
    if jsonb_typeof(v_ov->'autoprocess_hr') = 'null' then
      v_succ_autoprocess_hr := null;
    else
      v_succ_autoprocess_hr := (v_ov->>'autoprocess_hr')::boolean;
    end if;
  else
    v_succ_autoprocess_hr := v_cur.autoprocess_hr;
  end if;

  if (v_ov ? 'requires_hr') then
    if jsonb_typeof(v_ov->'requires_hr') = 'null' then
      v_succ_requires_hr := null;
    else
      v_succ_requires_hr := (v_ov->>'requires_hr')::boolean;
    end if;
  else
    v_succ_requires_hr := v_cur.requires_hr;
  end if;

  if (v_ov ? 'hr_attach_to_invoice') then
    if jsonb_typeof(v_ov->'hr_attach_to_invoice') = 'null' then
      v_succ_hr_attach_to_invoice := null;
    else
      v_succ_hr_attach_to_invoice := (v_ov->>'hr_attach_to_invoice')::boolean;
    end if;
  else
    v_succ_hr_attach_to_invoice := v_cur.hr_attach_to_invoice;
  end if;

  if (v_ov ? 'ts_attach_to_invoice') then
    if jsonb_typeof(v_ov->'ts_attach_to_invoice') = 'null' then
      v_succ_ts_attach_to_invoice := null;
    else
      v_succ_ts_attach_to_invoice := (v_ov->>'ts_attach_to_invoice')::boolean;
    end if;
  else
    v_succ_ts_attach_to_invoice := v_cur.ts_attach_to_invoice;
  end if;

  if (v_ov ? 'reference_number_required_to_issue_invoice') then
    if jsonb_typeof(v_ov->'reference_number_required_to_issue_invoice') = 'null' then
      v_succ_reference_number_required_to_issue_invoice := null;
    else
      v_succ_reference_number_required_to_issue_invoice := (v_ov->>'reference_number_required_to_issue_invoice')::boolean;
    end if;
  else
    v_succ_reference_number_required_to_issue_invoice := v_cur.reference_number_required_to_issue_invoice;
  end if;

  if (v_ov ? 'send_manual_invoices_to_different_email') then
    if jsonb_typeof(v_ov->'send_manual_invoices_to_different_email') = 'null' then
      v_succ_send_manual_invoices_to_different_email := null;
    else
      v_succ_send_manual_invoices_to_different_email := (v_ov->>'send_manual_invoices_to_different_email')::boolean;
    end if;
  else
    v_succ_send_manual_invoices_to_different_email := v_cur.send_manual_invoices_to_different_email;
  end if;

  if (v_ov ? 'manual_invoices_alt_email_address') then
    v_succ_manual_invoices_alt_email_address := nullif(btrim(v_ov->>'manual_invoices_alt_email_address'), '');
  else
    v_succ_manual_invoices_alt_email_address := v_cur.manual_invoices_alt_email_address;
  end if;

  if (v_ov ? 'send_ts_queries_to_different_email') then
    if jsonb_typeof(v_ov->'send_ts_queries_to_different_email') = 'null' then
      v_succ_send_ts_queries_to_different_email := coalesce(v_cur.send_ts_queries_to_different_email,false);
    else
      v_succ_send_ts_queries_to_different_email := (v_ov->>'send_ts_queries_to_different_email')::boolean;
    end if;
  else
    v_succ_send_ts_queries_to_different_email := coalesce(v_cur.send_ts_queries_to_different_email,false);
  end if;

  if (v_ov ? 'ts_queries_alt_email_address') then
    v_succ_ts_queries_alt_email_address := nullif(btrim(v_ov->>'ts_queries_alt_email_address'), '');
  else
    v_succ_ts_queries_alt_email_address := v_cur.ts_queries_alt_email_address;
  end if;

  if (v_ov ? 'is_ad_hoc') and jsonb_typeof(v_ov->'is_ad_hoc') <> 'null' then
    v_succ_is_ad_hoc := (v_ov->>'is_ad_hoc')::boolean;
  else
    v_succ_is_ad_hoc := v_cur.is_ad_hoc;
  end if;
  v_succ_is_ad_hoc := coalesce(v_succ_is_ad_hoc, false);

  if (v_ov ? 'default_submission_mode') then
    v_succ_default_submission_mode := nullif(btrim(v_ov->>'default_submission_mode'), '')::public.submission_mode_enum;
  else
    v_succ_default_submission_mode := v_cur.default_submission_mode;
  end if;

  if (v_ov ? 'timesheet_break_entry_mode') then
    if jsonb_typeof(v_ov->'timesheet_break_entry_mode')='null' then
      v_succ_timesheet_break_entry_mode:=null;
    else
      v_succ_timesheet_break_entry_mode:=
        nullif(btrim(v_ov->>'timesheet_break_entry_mode'),'')::public.timesheet_break_entry_mode_enum;
    end if;
  else
    v_succ_timesheet_break_entry_mode:=v_cur.timesheet_break_entry_mode;
  end if;

  if (v_ov ? 'week_ending_weekday_snapshot') and nullif(btrim(v_ov->>'week_ending_weekday_snapshot'), '') is not null then
    v_wew_succ := (v_ov->>'week_ending_weekday_snapshot')::int;
  else
    v_wew_succ := coalesce(v_cur.week_ending_weekday_snapshot, 0);
  end if;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','successor_fields_merged',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'merged', jsonb_build_object(
          'succ_candidate_id', coalesce(v_succ_candidate_id::text,''),
          'succ_client_id', coalesce(v_succ_client_id::text,''),
          'succ_role', coalesce(v_succ_role,''),
          'succ_band', coalesce(v_succ_band,''),
          'succ_display_site', coalesce(v_succ_display_site,''),
          'succ_ward_hint', coalesce(v_succ_ward_hint,''),
          'succ_pay_method_snapshot', coalesce(v_succ_pay_method_snapshot,''),
          'succ_week_ending_weekday_snapshot', v_wew_succ,
          'succ_overrideclientsettings', coalesce(v_succ_overrideclientsettings,false),
          'succ_weekly_timesheet_source', coalesce(v_succ_weekly_timesheet_source::text,''),
          'succ_no_timesheet_required', case when v_succ_no_timesheet_required is null then null else v_succ_no_timesheet_required end,
          'succ_daily_calc_of_invoices', case when v_succ_daily_calc_of_invoices is null then null else v_succ_daily_calc_of_invoices end,
          'succ_group_nightsat_sunbh', case when v_succ_group_nightsat_sunbh is null then null else v_succ_group_nightsat_sunbh end,
          'succ_is_nhsp', case when v_succ_is_nhsp is null then null else v_succ_is_nhsp end,
          'succ_autoprocess_hr', case when v_succ_autoprocess_hr is null then null else v_succ_autoprocess_hr end,
          'succ_requires_hr', case when v_succ_requires_hr is null then null else v_succ_requires_hr end,
          'succ_hr_attach_to_invoice', case when v_succ_hr_attach_to_invoice is null then null else v_succ_hr_attach_to_invoice end,
          'succ_ts_attach_to_invoice', case when v_succ_ts_attach_to_invoice is null then null else v_succ_ts_attach_to_invoice end,
          'succ_reference_number_required_to_issue_invoice', case when v_succ_reference_number_required_to_issue_invoice is null then null else v_succ_reference_number_required_to_issue_invoice end,
          'succ_send_manual_invoices_to_different_email', case when v_succ_send_manual_invoices_to_different_email is null then null else v_succ_send_manual_invoices_to_different_email end,
          'succ_manual_invoices_alt_email_address', coalesce(v_succ_manual_invoices_alt_email_address,''),
          'succ_send_ts_queries_to_different_email', case when v_succ_send_ts_queries_to_different_email is null then null else v_succ_send_ts_queries_to_different_email end,
          'succ_ts_queries_alt_email_address', coalesce(v_succ_ts_queries_alt_email_address,''),
          'succ_is_ad_hoc', coalesce(v_succ_is_ad_hoc,false),
          'succ_default_submission_mode', coalesce(v_succ_default_submission_mode::text,''),
          'succ_timesheet_break_entry_mode',v_succ_timesheet_break_entry_mode
        ),
        'overrides_keys', (
          select coalesce(jsonb_agg(k), '[]'::jsonb)
          from jsonb_object_keys(v_ov) as k
        )
      )
    );
  end if;

  if v_wew_succ < 0 or v_wew_succ > 6 then
    v_err := jsonb_build_object(
      'error','INVALID_INPUT',
      'message','successor.week_ending_weekday_snapshot must be 0..6',
      'week_ending_weekday_snapshot', v_wew_succ
    );

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','fail_successor_wew_validation',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'error', v_err
        )
      );
    end if;

    raise exception using message = v_err::text;
  end if;

  -- Route flag validations
  if v_succ_is_nhsp is true and v_succ_autoprocess_hr is true then
    v_err := jsonb_build_object(
      'error','INVALID_INPUT',
      'message','is_nhsp and autoprocess_hr cannot both be true for successor'
    );

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','fail_route_flag_validation',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'which','is_nhsp && autoprocess_hr',
          'error', v_err
        )
      );
    end if;

    raise exception using message = v_err::text;
  end if;

  if v_succ_no_timesheet_required is true and v_succ_autoprocess_hr is distinct from true then
    v_err := jsonb_build_object(
      'error','INVALID_INPUT',
      'message','no_timesheet_required=true requires autoprocess_hr=true for successor'
    );

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','fail_route_flag_validation',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'which','no_timesheet_required && autoprocess_hr != true',
          'error', v_err
        )
      );
    end if;

    raise exception using message = v_err::text;
  end if;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','route_flags_ok',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"')
      )
    );
  end if;

  -- Snapshot predecessor state for audit before mutations
  v_before_state := jsonb_build_object(
    'predecessor_id', v_cur.id,
    'predecessor_start_date', v_cur.start_date,
    'predecessor_end_date', v_cur.end_date,
    'predecessor_candidate_id', v_cur.candidate_id,
    'predecessor_client_id', v_cur.client_id,
    'new_start_date', v_new_start,
    'new_end_date', v_new_end,
    'end_existing_on', v_close_to
  );

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','before_state_snapshot',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'before_state', v_before_state
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Insert successor contract
  -- ─────────────────────────────────────────────────────────────
  insert into public.contracts as c (
    candidate_id,
    client_id,
    role,
    band,
    display_site,
    ward_hint,
    start_date,
    end_date,
    pay_method_snapshot,
    rates_json,
    std_hours_json,
    default_submission_mode,
    week_ending_weekday_snapshot,
    auto_invoice,
    require_reference_to_pay,
    require_reference_to_invoice,
    bucket_labels_json,
    std_schedule_json,
    mileage_pay_rate,
    mileage_charge_rate,
    additional_rates_json,
    created_at,
    updated_at,
    self_bill,
    weekly_timesheet_source,
    no_timesheet_required,
    daily_calc_of_invoices,
    group_nightsat_sunbh,
    is_nhsp,
    autoprocess_hr,
    requires_hr,
    hr_attach_to_invoice,
    ts_attach_to_invoice,
    overrideclientsettings,
    reference_number_required_to_issue_invoice,
    send_manual_invoices_to_different_email,
    manual_invoices_alt_email_address,
    send_ts_queries_to_different_email,
    ts_queries_alt_email_address,
    is_ad_hoc,
    timesheet_break_entry_mode,
    candidate_paper_submission_enabled_override,
    candidate_manager_approval_policy_json
  ) values (
    v_succ_candidate_id,
    v_succ_client_id,
    v_succ_role,
    v_succ_band,
    v_succ_display_site,
    v_succ_ward_hint,
    v_new_start,
    v_new_end,
    v_succ_pay_method_snapshot,
    v_succ_rates_json,
    v_succ_std_hours_json,
    v_succ_default_submission_mode,
    v_wew_succ::smallint,
    v_cur.auto_invoice,
    v_cur.require_reference_to_pay,
    v_cur.require_reference_to_invoice,
    v_succ_bucket_labels_json,
    v_succ_std_schedule_json,
    v_cur.mileage_pay_rate,
    v_cur.mileage_charge_rate,
    v_succ_additional_rates_json,
    v_now,
    v_now,
    v_cur.self_bill,
    v_succ_weekly_timesheet_source,
    v_succ_no_timesheet_required,
    v_succ_daily_calc_of_invoices,
    v_succ_group_nightsat_sunbh,
    v_succ_is_nhsp,
    v_succ_autoprocess_hr,
    v_succ_requires_hr,
    v_succ_hr_attach_to_invoice,
    v_succ_ts_attach_to_invoice,
    v_succ_overrideclientsettings,
    v_succ_reference_number_required_to_issue_invoice,
    v_succ_send_manual_invoices_to_different_email,
    v_succ_manual_invoices_alt_email_address,
    v_succ_send_ts_queries_to_different_email,
    v_succ_ts_queries_alt_email_address,
    v_succ_is_ad_hoc,
    v_succ_timesheet_break_entry_mode,
    v_cur.candidate_paper_submission_enabled_override,
    v_cur.candidate_manager_approval_policy_json
  )
  returning c.* into v_succ;
  v_succ:=private.weekly_source_contract_fixed_approval_sync_v1(v_succ.id,p_actor_user_id);

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','inserted_successor_contract',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'successor', jsonb_build_object(
          'id', v_succ.id,
          'candidate_id', coalesce(v_succ.candidate_id::text,''),
          'client_id', coalesce(v_succ.client_id::text,''),
          'start_date', v_succ.start_date,
          'end_date', v_succ.end_date,
          'week_ending_weekday_snapshot', v_succ.week_ending_weekday_snapshot
        )
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Update predecessor end_date (end-existing enforced)
  -- ─────────────────────────────────────────────────────────────
  update public.contracts as c
     set end_date = v_close_to,
         updated_at = v_now
   where c.id = v_cur.id;

  get diagnostics v_rc = row_count;

  v_cur.end_date := v_close_to;
  v_cur:=private.weekly_source_contract_fixed_approval_sync_v1(v_cur.id,p_actor_user_id);

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','updated_predecessor_end_date',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'row_count', v_rc,
        'predecessor_id', v_cur.id::text,
        'new_end_date', v_close_to
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Generate/ensure base contract_weeks rows for predecessor + successor in their final windows
  -- (including planned_schedule_json derived from std_schedule_json when present)
  -- ─────────────────────────────────────────────────────────────
  with contract_targets as (
    select
      v_cur.id as contract_id,
      v_cur.client_id as client_id,
      v_cur.start_date as start_date,
      v_cur.end_date as end_date,
      v_wew_pred as wew,
      v_cur.std_schedule_json as std_schedule_json,
      v_cur.overrideclientsettings as overrideclientsettings,
      v_cur.default_submission_mode as default_submission_mode
    union all
    select
      v_succ.id as contract_id,
      v_succ.client_id as client_id,
      v_succ.start_date as start_date,
      v_succ.end_date as end_date,
      v_wew_succ as wew,
      v_succ.std_schedule_json as std_schedule_json,
      v_succ.overrideclientsettings as overrideclientsettings,
      v_succ.default_submission_mode as default_submission_mode
  ),
  targets as (
    select
      ct.contract_id,
      ct.client_id,
      ct.start_date,
      ct.end_date,
      ct.wew,
      ct.std_schedule_json,
      ct.overrideclientsettings,
      ct.default_submission_mode,
      (
        select cs.default_submission_mode
          from public.client_settings as cs
         where cs.client_id = ct.client_id
         order by cs.effective_from desc nulls last, cs.updated_at desc
         limit 1
      ) as client_default_submission_mode
    from contract_targets as ct
  ),
  targets2 as (
    select
      t.contract_id,
      t.start_date,
      t.end_date,
      t.wew,
      t.std_schedule_json,
      case
        when t.overrideclientsettings is true
          then coalesce(t.default_submission_mode, t.client_default_submission_mode, 'ELECTRONIC'::public.submission_mode_enum)
        else coalesce(t.client_default_submission_mode, 'ELECTRONIC'::public.submission_mode_enum)
      end as submission_mode_snapshot,
      (t.start_date + (((t.wew - extract(dow from t.start_date)::int + 7) % 7)) * interval '1 day')::date as start_we,
      (t.end_date   + (((t.wew - extract(dow from t.end_date)::int   + 7) % 7)) * interval '1 day')::date as end_we
    from targets as t
  ),
  weeks as (
    select
      t2.contract_id,
      t2.start_date,
      t2.end_date,
      t2.wew,
      t2.std_schedule_json,
      t2.submission_mode_snapshot,
      gs::date as week_end
    from targets2 as t2
    cross join lateral generate_series(t2.start_we::timestamp, t2.end_we::timestamp, interval '7 days') as gs
  ),
  ins as (
    insert into public.contract_weeks as cw (
      contract_id,
      week_ending_date,
      additional_seq,
      status,
      timesheet_id,
      planned_schedule_json,
      created_at,
      updated_at,
      submission_mode_snapshot,
      is_adjustment,
      enforce_day_partition,
      allowed_days_mask,
      split_boundary_date,
      worker_note,
      split_group_key
    )
    select
      w.contract_id,
      w.week_end,
      0 as additional_seq,
      case
        when w.week_end <= current_date then 'OPEN'::public.contract_week_status_enum
        else 'PLANNED'::public.contract_week_status_enum
      end as status,
      null::uuid as timesheet_id,
      case
        when pj.plan_json is null then null
        when jsonb_typeof(pj.plan_json) <> 'array' then pj.plan_json
        when jsonb_array_length(pj.plan_json) = 0 then null
        else pj.plan_json
      end as planned_schedule_json,
      v_now as created_at,
      v_now as updated_at,
      w.submission_mode_snapshot,
      false as is_adjustment,
      false as enforce_day_partition,
      null::text as allowed_days_mask,
      null::date as split_boundary_date,
      null::text as worker_note,
      null::text as split_group_key
    from weeks as w
    left join lateral (
      select jsonb_agg(ent.entry_json order by ent.entry_date) as plan_json
      from (
        select
          (dt)::date as entry_date,
          jsonb_build_object(
            'date', to_char((dt)::date, 'YYYY-MM-DD'),
            'start', sc.cfg->>'start',
            'end',   sc.cfg->>'end',
            'breaks', case when jsonb_typeof(sc.cfg->'breaks') = 'array' then sc.cfg->'breaks' else '[]'::jsonb end,
            'break_minutes', br.break_minutes,
            'overnight', ov.overnight_flag,
            'expected_minutes', ov.expected_minutes
          ) as entry_json
        from generate_series(
               greatest(((w.week_end - interval '6 days')::date), w.start_date)::timestamp,
               least(w.week_end, w.end_date)::timestamp,
               interval '1 day'
             ) as dt
        cross join lateral (
          select case extract(dow from dt)::int
            when 1 then 'mon'
            when 2 then 'tue'
            when 3 then 'wed'
            when 4 then 'thu'
            when 5 then 'fri'
            when 6 then 'sat'
            else 'sun'
          end as day_key
        ) as dk
        cross join lateral (
          select (w.std_schedule_json -> dk.day_key) as cfg
        ) as sc
        cross join lateral (
          select
            case
              when (sc.cfg ? 'break_minutes')
               and (sc.cfg->>'break_minutes') is not null
               and (sc.cfg->>'break_minutes') ~ '^[0-9]+(\.[0-9]+)?$'
              then (sc.cfg->>'break_minutes')::numeric
              else 0::numeric
            end as break_minutes
        ) as br
        cross join lateral (
          select
            (sc.cfg->>'start') as start_str,
            (sc.cfg->>'end')   as end_str
        ) as se
        cross join lateral (
          select
            case
              when se.start_str ~ '^[0-9]{1,2}:[0-9]{2}$'
               and split_part(se.start_str,':',1)::int between 0 and 23
               and split_part(se.start_str,':',2)::int between 0 and 59
              then (split_part(se.start_str,':',1)::int * 60 + split_part(se.start_str,':',2)::int)
              else null
            end as start_mins,
            case
              when se.end_str ~ '^[0-9]{1,2}:[0-9]{2}$'
               and split_part(se.end_str,':',1)::int between 0 and 23
               and split_part(se.end_str,':',2)::int between 0 and 59
              then (split_part(se.end_str,':',1)::int * 60 + split_part(se.end_str,':',2)::int)
              else null
            end as end_mins
        ) as tm
        cross join lateral (
          select
            case
              when tm.start_mins is null or tm.end_mins is null then false
              when tm.end_mins <= tm.start_mins then true
              else false
            end as overnight_flag,
            case
              when tm.start_mins is null or tm.end_mins is null then 0
              when tm.end_mins <= tm.start_mins then (1440 - tm.start_mins + tm.end_mins)
              else (tm.end_mins - tm.start_mins)
            end as minutes_diff
        ) as md
        cross join lateral (
          select
            md.overnight_flag,
            greatest(0, (md.minutes_diff - br.break_minutes)::int) as expected_minutes
        ) as ov
        where w.std_schedule_json is not null
          and jsonb_typeof(w.std_schedule_json) = 'object'
          and jsonb_typeof(sc.cfg) = 'object'
          and tm.start_mins is not null
          and tm.end_mins is not null
      ) as ent
    ) as pj on true
    on conflict on constraint uq_contract_week do nothing
    returning 1
  )
  select 1 into v_dummy from ins limit 1;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','ensure_contract_weeks_done',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'note','weeks ensure CTE executed (v_dummy indicates at least one insert when non-null)',
        'v_dummy', v_dummy,
        'predecessor_id', v_cur.id::text,
        'successor_id', v_succ.id::text
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Delete predecessor draft weeks beyond truncated window (never touches submitted weeks)
  -- ─────────────────────────────────────────────────────────────
  delete from public.contract_weeks as cw
   where cw.contract_id = v_cur.id
     and cw.timesheet_id is null
     and cw.week_ending_date > v_end_we_old;

  get diagnostics v_rc = row_count;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','deleted_predecessor_draft_weeks_beyond_trunc',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'row_count', v_rc,
        'contract_id', v_cur.id::text,
        'v_end_we_old', v_end_we_old
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Clamp predecessor ending week planned schedule (draft rows only; never delete the week row)
  -- If none remain, set planned_schedule_json = []
  -- ─────────────────────────────────────────────────────────────
  with tgt as (
    select
      cw.id as contract_week_id,
      case
        when cw.planned_schedule_json is null then '[]'::jsonb
        when jsonb_typeof(cw.planned_schedule_json) <> 'array' then cw.planned_schedule_json
        else (
          select coalesce(jsonb_agg(e.elem order by e.ord), '[]'::jsonb)
          from jsonb_array_elements(cw.planned_schedule_json) with ordinality as e(elem, ord)
          where (e.elem->>'date') ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
            and (e.elem->>'date')::date <= v_close_to
        )
      end as new_plan
    from public.contract_weeks as cw
    where cw.contract_id = v_cur.id
      and cw.week_ending_date = v_end_we_old
      and cw.timesheet_id is null
  )
  update public.contract_weeks as cw
     set planned_schedule_json = tgt.new_plan,
         updated_at = v_now
    from tgt
   where cw.id = tgt.contract_week_id;

  get diagnostics v_rc = row_count;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','clamped_predecessor_ending_week_plan',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'row_count', v_rc,
        'contract_id', v_cur.id::text,
        'week_ending_date', v_end_we_old,
        'clamp_to_date', v_close_to
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Split-week enforcement patch (draft rows only; includes additional_seq variants)
  -- ─────────────────────────────────────────────────────────────
  if v_split_week then
    update public.contract_weeks as cw
       set enforce_day_partition = true,
           allowed_days_mask = v_old_mask,
           split_boundary_date = v_new_start,
           worker_note = v_split_note,
           split_group_key = v_split_group_key,
           updated_at = v_now
     where cw.contract_id = v_cur.id
       and cw.week_ending_date = v_boundary_week_end
       and cw.timesheet_id is null;

    get diagnostics v_rc = row_count;

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','split_week_patch_predecessor_weeks',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'row_count', v_rc,
          'contract_id', v_cur.id::text,
          'week_end', v_boundary_week_end,
          'allowed_days_mask', v_old_mask,
          'split_boundary_date', v_new_start,
          'split_group_key', v_split_group_key
        )
      );
    end if;

    update public.contract_weeks as cw
       set enforce_day_partition = true,
           allowed_days_mask = v_new_mask,
           split_boundary_date = v_new_start,
           worker_note = v_split_note,
           split_group_key = v_split_group_key,
           updated_at = v_now
     where cw.contract_id = v_succ.id
       and cw.week_ending_date = v_boundary_week_end
       and cw.timesheet_id is null;

    get diagnostics v_rc = row_count;

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','split_week_patch_successor_weeks',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'row_count', v_rc,
          'contract_id', v_succ.id::text,
          'week_end', v_boundary_week_end,
          'allowed_days_mask', v_new_mask,
          'split_boundary_date', v_new_start,
          'split_group_key', v_split_group_key
        )
      );
    end if;

  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Compute schedule clashes inside DB (block unless forced)
  -- NOTE: avoid using CTE name "overlaps" (keyword/operator in SQL); use ovl_rows instead.
  -- ─────────────────────────────────────────────────────────────
  if v_succ_candidate_id is not null then
    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','schedule_clash_scan_start',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'candidate_id', v_succ_candidate_id::text,
          'new_start', v_new_start,
          'new_end', v_new_end,
          'p_force_schedule_clashes', coalesce(p_force_schedule_clashes,false)
        )
      );
    end if;

    with params as (
      select
        (v_new_start - 1) as scan_from,
        (v_new_end + 1) as scan_to,
        (v_new_start - 7) as check_we_from,
        (v_new_end + 7) as check_we_to
    ),
    a_entries as (
      select
        cw.id as a_contract_week_id,
        cw.contract_id as a_contract_id,
        cw.week_ending_date as a_week_end,
        cw.additional_seq as a_additional_seq,
        (e.elem->>'date')::date as a_day_date,
        (e.elem->>'start') as a_start,
        (e.elem->>'end') as a_end,
        coalesce((e.elem->>'overnight')::boolean, false) as a_overnight
      from public.contract_weeks as cw
      cross join lateral jsonb_array_elements(cw.planned_schedule_json) as e(elem)
      where cw.contract_id = v_succ.id
        and cw.planned_schedule_json is not null
        and jsonb_typeof(cw.planned_schedule_json) = 'array'
        and (e.elem->>'date') ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        and (e.elem->>'date')::date >= v_new_start
        and (e.elem->>'date')::date <= v_new_end
    ),
    a_ts as (
      select
        a.*,
        (a.a_day_date::timestamp + (tm.start_mins * interval '1 minute')) as start_ts,
        (
          case
            when (a.a_overnight is true) or (tm.end_mins <= tm.start_mins)
              then ((a.a_day_date + 1)::timestamp + (tm.end_mins * interval '1 minute'))
            else (a.a_day_date::timestamp + (tm.end_mins * interval '1 minute'))
          end
        ) as end_ts
      from a_entries as a
      cross join lateral (
        select
          case
            when a.a_start ~ '^[0-9]{1,2}:[0-9]{2}$'
             and split_part(a.a_start,':',1)::int between 0 and 23
             and split_part(a.a_start,':',2)::int between 0 and 59
            then (split_part(a.a_start,':',1)::int * 60 + split_part(a.a_start,':',2)::int)
            else null
          end as start_mins,
          case
            when a.a_end ~ '^[0-9]{1,2}:[0-9]{2}$'
             and split_part(a.a_end,':',1)::int between 0 and 23
             and split_part(a.a_end,':',2)::int between 0 and 59
            then (split_part(a.a_end,':',1)::int * 60 + split_part(a.a_end,':',2)::int)
            else null
          end as end_mins
      ) as tm
      where tm.start_mins is not null
        and tm.end_mins is not null
    ),
    b_entries as (
      select
        cw.id as b_contract_week_id,
        cw.contract_id as b_contract_id,
        c.client_id as b_client_id,
        cw.week_ending_date as b_week_end,
        cw.additional_seq as b_additional_seq,
        (e.elem->>'date')::date as b_day_date,
        (e.elem->>'start') as b_start,
        (e.elem->>'end') as b_end,
        coalesce((e.elem->>'overnight')::boolean, false) as b_overnight
      from public.contract_weeks as cw
      join public.contracts as c
        on c.id = cw.contract_id
      cross join lateral jsonb_array_elements(cw.planned_schedule_json) as e(elem)
      cross join params as p
      where c.candidate_id = v_succ_candidate_id
        and c.id <> v_succ.id
        and cw.planned_schedule_json is not null
        and jsonb_typeof(cw.planned_schedule_json) = 'array'
        and cw.week_ending_date >= p.check_we_from
        and cw.week_ending_date <= p.check_we_to
        and (e.elem->>'date') ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        and (e.elem->>'date')::date >= p.scan_from
        and (e.elem->>'date')::date <= p.scan_to
    ),
    b_ts as (
      select
        b.*,
        (b.b_day_date::timestamp + (tm.start_mins * interval '1 minute')) as start_ts,
        (
          case
            when (b.b_overnight is true) or (tm.end_mins <= tm.start_mins)
              then ((b.b_day_date + 1)::timestamp + (tm.end_mins * interval '1 minute'))
            else (b.b_day_date::timestamp + (tm.end_mins * interval '1 minute'))
          end
        ) as end_ts
      from b_entries as b
      cross join lateral (
        select
          case
            when b.b_start ~ '^[0-9]{1,2}:[0-9]{2}$'
             and split_part(b.b_start,':',1)::int between 0 and 23
             and split_part(b.b_start,':',2)::int between 0 and 59
            then (split_part(b.b_start,':',1)::int * 60 + split_part(b.b_start,':',2)::int)
            else null
          end as start_mins,
          case
            when b.b_end ~ '^[0-9]{1,2}:[0-9]{2}$'
             and split_part(b.b_end,':',1)::int between 0 and 23
             and split_part(b.b_end,':',2)::int between 0 and 59
            then (split_part(b.b_end,':',1)::int * 60 + split_part(b.b_end,':',2)::int)
            else null
          end as end_mins
      ) as tm
      where tm.start_mins is not null
        and tm.end_mins is not null
    ),
    ovl_rows as (
      select
        greatest(a.start_ts, b.start_ts) as overlap_start,
        least(a.end_ts, b.end_ts) as overlap_end,

        a.a_contract_week_id,
        a.a_contract_id,
        a.a_week_end,
        a.a_additional_seq,
        to_char(a.a_day_date, 'YYYY-MM-DD') as a_date,
        a.a_start as a_start,
        a.a_end as a_end,

        b.b_contract_week_id,
        b.b_contract_id,
        b.b_client_id,
        b.b_week_end,
        b.b_additional_seq,
        to_char(b.b_day_date, 'YYYY-MM-DD') as b_date,
        b.b_start as b_start,
        b.b_end as b_end,

        row_number() over (order by greatest(a.start_ts, b.start_ts)) as rn,
        count(*) over () as total_count
      from a_ts as a
      join b_ts as b
        on a.start_ts < b.end_ts
       and a.end_ts > b.start_ts
      where least(a.end_ts, b.end_ts) > greatest(a.start_ts, b.start_ts)
    )
    select
      coalesce(max(o.total_count), 0),
      coalesce(
        jsonb_agg(
          jsonb_build_object(
            'overlap_start_utc', to_char(o.overlap_start, 'YYYY-MM-DD"T"HH24:MI:SS"Z"'),
            'overlap_end_utc', to_char(o.overlap_end, 'YYYY-MM-DD"T"HH24:MI:SS"Z"'),

            'a_source', 'proposed',
            'a_contract_week_id', o.a_contract_week_id,
            'a_contract_id', o.a_contract_id,
            'a_week_end', o.a_week_end,
            'a_additional_seq', o.a_additional_seq,
            'a_date', o.a_date,
            'a_start', o.a_start,
            'a_end', o.a_end,

            'b_source', 'existing',
            'b_contract_week_id', o.b_contract_week_id,
            'b_contract_id', o.b_contract_id,
            'b_client_id', o.b_client_id,
            'b_week_end', o.b_week_end,
            'b_additional_seq', o.b_additional_seq,
            'b_date', o.b_date,
            'b_start', o.b_start,
            'b_end', o.b_end
          )
          order by o.overlap_start
        ) filter (where o.rn <= 500),
        '[]'::jsonb
      )
      into v_clash_count, v_schedule_clashes
      from ovl_rows as o;

    v_schedule_clashes := jsonb_build_object(
      'candidate_id', v_succ_candidate_id,
      'scan_from', to_char(v_new_start - 1, 'YYYY-MM-DD'),
      'scan_to', to_char(v_new_end + 1, 'YYYY-MM-DD'),
      'check_we_from', to_char(v_new_start - 7, 'YYYY-MM-DD'),
      'check_we_to', to_char(v_new_end + 7, 'YYYY-MM-DD'),
      'clash_count', coalesce(v_clash_count, 0),
      'clashes', coalesce(v_schedule_clashes, '[]'::jsonb)
    );

    if v_invoice_debug then
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','schedule_clash_scan_done',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'clash_count', coalesce(v_clash_count,0),
          'forced', coalesce(p_force_schedule_clashes,false)
        )
      );
    end if;

    if coalesce(v_clash_count, 0) > 0 and not coalesce(p_force_schedule_clashes, false) then
      v_err := v_schedule_clashes || jsonb_build_object('error','SCHEDULE_CLASH');

      if v_invoice_debug then
        v_dbg_steps := v_dbg_steps || jsonb_build_array(
          jsonb_build_object(
            'step','fail_schedule_clash_not_forced',
            'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
            'error', v_err
          )
        );
      end if;

      raise exception using message = v_err::text;
    end if;
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Overlap warnings (date-range overlap with other contracts for successor candidate)
  -- ─────────────────────────────────────────────────────────────
  if v_succ_candidate_id is not null then
    select coalesce(
      jsonb_agg(
        jsonb_build_object(
          'contract_id', c2.id,
          'client_id', c2.client_id,
          'overlap_from', greatest(c2.start_date, v_new_start),
          'overlap_to', least(c2.end_date, v_new_end)
        )
        order by greatest(c2.start_date, v_new_start)
      ),
      '[]'::jsonb
    )
    into v_overlap_warnings
    from (
      select c2.*
      from public.contracts as c2
      where c2.candidate_id = v_succ_candidate_id
        and c2.id <> v_cur.id
        and c2.id <> v_succ.id
        and c2.start_date <= v_new_end
        and c2.end_date >= v_new_start
      order by c2.start_date
      limit 50
    ) as c2;
  end if;

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','overlap_warnings_computed',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'overlap_warning_count', case when v_overlap_warnings is null or jsonb_typeof(v_overlap_warnings) <> 'array' then null else jsonb_array_length(v_overlap_warnings) end
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Audit event (non-debug canonical writer)
  -- ─────────────────────────────────────────────────────────────
  v_after_state := jsonb_build_object(
    'predecessor_id', v_cur.id,
    'predecessor_closed_at', v_close_to,
    'successor_id', v_succ.id,
    'successor_start_date', v_succ.start_date,
    'successor_end_date', v_succ.end_date,
    'successor_candidate_id', v_succ.candidate_id,
    'successor_client_id', v_succ.client_id,
    'split_week', v_split_week,
    'split_group_key', v_split_group_key,
    'forced_schedule_clashes', coalesce(p_force_schedule_clashes, false),
    'forced_already_split_week', coalesce(p_force_already_split_week, false)
  );

  v_audit_reason :=
    'Clone & Extend: predecessor ' || v_cur.id::text ||
    ' closed to ' || to_char(v_close_to,'YYYY-MM-DD') ||
    '; successor ' || v_succ.id::text ||
    ' ' || to_char(v_succ.start_date,'YYYY-MM-DD') || '→' || to_char(v_succ.end_date,'YYYY-MM-DD') ||
    case when v_split_week then '; split week boundary ' || to_char(v_new_start,'YYYY-MM-DD') else '' end ||
    case when coalesce(p_force_schedule_clashes,false) then '; schedule clashes forced' else '' end ||
    case when coalesce(p_force_already_split_week,false) then '; already-split-week forced' else '' end;

  perform public._audit_insert(
    'contracts',
    v_cur.id::text,
    'CLONE_EXTEND',
    v_before_state,
    v_after_state,
    v_audit_reason,
    p_actor_user_id
  );

  if v_invoice_debug then
    v_dbg_steps := v_dbg_steps || jsonb_build_array(
      jsonb_build_object(
        'step','canonical_audit_written',
        'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
        'event','CLONE_EXTEND',
        'actor_user_id', coalesce(p_actor_user_id::text,'')
      )
    );
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- DEBUG AUDIT (single row per call; best-effort, never breaks flow)
  -- ─────────────────────────────────────────────────────────────
  if v_invoice_debug then
    begin
      v_dbg_stats := jsonb_build_object(
        'predecessor_id', v_cur.id,
        'successor_id', v_succ.id,
        'split_week', v_split_week,
        'already_split', v_already_split,
        'boundary_week_start', v_boundary_week_start,
        'boundary_week_end', v_boundary_week_end,
        'end_we_old', v_end_we_old,
        'clash_count', coalesce(v_clash_count,0),
        'forced_schedule_clashes', coalesce(p_force_schedule_clashes,false),
        'forced_already_split_week', coalesce(p_force_already_split_week,false)
      );

      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','finish',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'stats', v_dbg_stats
        )
      );

      perform public._inv_write_audit(
        null,
        'CONTRACTS_CLONE_EXTEND_DEBUG',
        jsonb_build_object(
          'predecessor_id', v_cur.id::text,
          'successor_id', v_succ.id::text,
          'stats', v_dbg_stats,
          'steps', v_dbg_steps,
          'warnings', jsonb_build_object(
            'schedule_clashes', v_schedule_clashes,
            'overlap_warnings', v_overlap_warnings
          )
        ),
        'contracts',
        ('contract:' || v_cur.id::text),
        null,
        'INVOICE_DEBUG',
        null, null, null
      );
    exception when others then
      null;
    end;
  end if;

  -- ─────────────────────────────────────────────────────────────
  -- Return payload
  -- ─────────────────────────────────────────────────────────────
  return jsonb_build_object(
    'successor', jsonb_build_object(
      'id', v_succ.id,
      'candidate_id', v_succ.candidate_id,
      'client_id', v_succ.client_id,
      'role', v_succ.role,
      'band', v_succ.band,
      'display_site', v_succ.display_site,
      'ward_hint', v_succ.ward_hint,
      'start_date', v_succ.start_date,
      'end_date', v_succ.end_date,
      'timesheet_break_entry_mode',v_succ.timesheet_break_entry_mode
    ),
    'closed_at', v_close_to,
    'split', case
      when v_split_week then jsonb_build_object(
        'week_start', v_boundary_week_start,
        'week_end', v_boundary_week_end,
        'boundary_date', v_new_start,
        'old_allowed_mask', v_old_mask,
        'new_allowed_mask', v_new_mask,
        'split_boundary_date', v_new_start,
        'worker_note', v_split_note,
        'split_group_key', v_split_group_key,
        'already_split', v_already_split
      )
      else null
    end,
    'overlap_warnings', v_overlap_warnings,
    'warnings', jsonb_build_object(
      'schedule_clashes', v_schedule_clashes,
      'overlap_warnings', v_overlap_warnings
    )
  );

exception when others then
  v_dbg_sqlstate := SQLSTATE;
  v_dbg_error := SQLERRM;

  begin
    get stacked diagnostics
      v_dbg_detail = PG_EXCEPTION_DETAIL,
      v_dbg_hint = PG_EXCEPTION_HINT,
      v_dbg_context = PG_EXCEPTION_CONTEXT;
  exception when others then
    v_dbg_detail := null;
    v_dbg_hint := null;
    v_dbg_context := null;
  end;

  if v_invoice_debug then
    begin
      v_dbg_steps := v_dbg_steps || jsonb_build_array(
        jsonb_build_object(
          'step','exception',
          'at_utc', to_char(clock_timestamp() at time zone 'utc', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
          'sqlstate', v_dbg_sqlstate,
          'error', v_dbg_error,
          'detail', v_dbg_detail,
          'hint', v_dbg_hint
        )
      );

      v_dbg_stats := jsonb_build_object(
        'predecessor_id', coalesce(v_cur.id::text,''),
        'successor_id', coalesce(v_succ.id::text,''),
        'split_week', v_split_week,
        'already_split', v_already_split,
        'boundary_week_start', coalesce(v_boundary_week_start::text,''),
        'boundary_week_end', coalesce(v_boundary_week_end::text,''),
        'end_we_old', coalesce(v_end_we_old::text,''),
        'clash_count', coalesce(v_clash_count,0),
        'forced_schedule_clashes', coalesce(p_force_schedule_clashes,false),
        'forced_already_split_week', coalesce(p_force_already_split_week,false)
      );

      perform public._inv_write_audit(
        null,
        'CONTRACTS_CLONE_EXTEND_ERROR',
        jsonb_build_object(
          'predecessor_id', coalesce(v_cur.id::text,''),
          'successor_id', coalesce(v_succ.id::text,''),
          'sqlstate', v_dbg_sqlstate,
          'error', v_dbg_error,
          'detail', v_dbg_detail,
          'hint', v_dbg_hint,
          'context', v_dbg_context,
          'stats', v_dbg_stats,
          'steps', v_dbg_steps
        ),
        'contracts',
        ('contract:' || coalesce(p_contract_id::text,'')),
        null,
        'INVOICE_DEBUG',
        null, null, null
      );
    exception when others then
      null;
    end;
  end if;

  raise;
end;
$$;

CREATE OR REPLACE FUNCTION public.contract_week_delete_planned(
  p_contract_week_id uuid,
  p_actor_user_id uuid
)
RETURNS TABLE (
  deleted boolean,
  contract_week_id uuid
)
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_deleted boolean;
  v_preserve_contract_boundary boolean;
  v_deleted_contract_week_id uuid;
  v_contract_id uuid;
  v_contract_start date;
  v_contract_end date;
  v_week_ending_weekday integer;
  v_first_remaining_week date;
  v_last_remaining_week date;
  v_start_week date;
  v_end_week date;
  v_first_remaining_planned_date date;
  v_last_remaining_planned_date date;
  v_new_start date;
  v_new_end date;
BEGIN
  v_preserve_contract_boundary:=private._candidate_provisional_expense_carrier_v1(p_contract_week_id);
  SELECT cw.contract_id
  INTO v_contract_id
  FROM public.contract_weeks cw
  WHERE cw.id = p_contract_week_id;

  SELECT result.deleted, result.contract_week_id
  INTO v_deleted, v_deleted_contract_week_id
  FROM private.contract_week_delete_planned_base_v1(
    p_contract_week_id,
    p_actor_user_id
  ) AS result;

  IF v_deleted IS NOT TRUE OR v_contract_id IS NULL OR v_preserve_contract_boundary THEN
    deleted := v_deleted;
    contract_week_id := v_deleted_contract_week_id;
    RETURN NEXT;
    RETURN;
  END IF;

  SELECT c.start_date, c.end_date, COALESCE(c.week_ending_weekday_snapshot, 0)
  INTO v_contract_start, v_contract_end, v_week_ending_weekday
  FROM public.contracts c
  WHERE c.id = v_contract_id
  FOR UPDATE;

  IF FOUND THEN
    SELECT min(cw.week_ending_date), max(cw.week_ending_date)
    INTO v_first_remaining_week, v_last_remaining_week
    FROM public.contract_weeks cw
    WHERE cw.contract_id = v_contract_id;

    v_new_start := v_contract_start;
    v_new_end := v_contract_end;

    IF v_first_remaining_week IS NOT NULL THEN
      v_start_week := v_contract_start
        + mod(v_week_ending_weekday - extract(dow from v_contract_start)::integer + 7, 7);
      v_end_week := v_contract_end
        + mod(v_week_ending_weekday - extract(dow from v_contract_end)::integer + 7, 7);

      IF v_first_remaining_week > v_start_week THEN
        SELECT min((entry.item ->> 'date')::date)
        INTO v_first_remaining_planned_date
        FROM public.contract_weeks remaining
        CROSS JOIN LATERAL jsonb_array_elements(COALESCE(remaining.planned_schedule_json, '[]'::jsonb)) entry(item)
        WHERE remaining.contract_id = v_contract_id
          AND remaining.week_ending_date = v_first_remaining_week
          AND jsonb_typeof(entry.item) = 'object'
          AND COALESCE(entry.item ->> 'date', '') ~ '^\d{4}-\d{2}-\d{2}$';

        v_new_start := COALESCE(v_first_remaining_planned_date, v_first_remaining_week - 6);
      END IF;

      IF v_last_remaining_week < v_end_week THEN
        SELECT max((entry.item ->> 'date')::date)
        INTO v_last_remaining_planned_date
        FROM public.contract_weeks remaining
        CROSS JOIN LATERAL jsonb_array_elements(COALESCE(remaining.planned_schedule_json, '[]'::jsonb)) entry(item)
        WHERE remaining.contract_id = v_contract_id
          AND remaining.week_ending_date = v_last_remaining_week
          AND jsonb_typeof(entry.item) = 'object'
          AND COALESCE(entry.item ->> 'date', '') ~ '^\d{4}-\d{2}-\d{2}$';

        v_new_end := COALESCE(v_last_remaining_planned_date, v_last_remaining_week);
      END IF;

      IF v_new_start IS DISTINCT FROM v_contract_start
         OR v_new_end IS DISTINCT FROM v_contract_end THEN
        UPDATE public.contracts
        SET start_date = v_new_start,
            end_date = v_new_end
        WHERE id = v_contract_id;
      PERFORM private.weekly_source_contract_fixed_approval_sync_v1(v_contract_id,p_actor_user_id);

        INSERT INTO public.audit_events(
          actor_user_id,
          object_type,
          object_id_text,
          action,
          before_json,
          after_json,
          reason
        )
        VALUES (
          p_actor_user_id,
          'contract',
          v_contract_id::text,
          'CONTRACT_DATES_RECONCILED_AFTER_WEEK_DELETE',
          jsonb_build_object('start_date', v_contract_start, 'end_date', v_contract_end),
          jsonb_build_object('start_date', v_new_start, 'end_date', v_new_end),
          'PLANNED_CONTRACT_WEEK_DELETED'
        );
      END IF;
    END IF;
  END IF;

  deleted := v_deleted;
  contract_week_id := v_deleted_contract_week_id;
  RETURN NEXT;
END;
$function$;

CREATE OR REPLACE FUNCTION public.timesheet_weekly_chain_delete_apply(
  p_timesheet_id uuid,
  p_actor_user_id uuid,
  p_expected_timesheet_ids uuid[] DEFAULT NULL::uuid[],
  p_expected_contract_week_ids uuid[] DEFAULT NULL::uuid[],
  p_expected_nhsp_shift_ids uuid[] DEFAULT NULL::uuid[],
  p_expected_row_signature text DEFAULT NULL::text
)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO 'public', 'pg_temp'
AS $function$
DECLARE
  v_preview jsonb;
  v_result jsonb;
  -- Plan 6.2 G6-11 (proof/34 section 3, entry point E23).
  v_weekly_source_guard jsonb;
  v_weekly_source_root uuid;
  v_contract_id uuid;
  v_contract_start date;
  v_contract_end date;
  v_week_ending_weekday integer;
  v_first_remaining_week date;
  v_last_remaining_week date;
  v_start_week date;
  v_end_week date;
  v_first_remaining_planned_date date;
  v_last_remaining_planned_date date;
  v_new_start date;
  v_new_end date;
BEGIN
  v_preview := public.timesheet_weekly_chain_delete_preview(p_timesheet_id, p_actor_user_id);
  v_contract_id := NULLIF(v_preview ->> 'contract_id', '')::uuid;

  -- SP-12: after existing plain preview/auth, before the original locking owner.
  if (select active_owner from private.bpay_next_module_control where id=1)='NEXT' then
    perform private.weekly_source_pay_query_admit_v2();
  end if;

  -- Plan 6.2 G6-11 (proof/34 section 3, entry point E23).  The delete base
  -- owner carries the same refusal under its own locks; this call covers the
  -- upgrade path, where the base body is not recreated because the rename block
  -- above is already satisfied.  Checked before any write of this chain.  An
  -- unmanaged family is unaffected.
  FOR v_weekly_source_root IN
    SELECT DISTINCT target.timesheet_id
    FROM (
      SELECT p_timesheet_id AS timesheet_id
      UNION
      SELECT unnest(COALESCE(p_expected_timesheet_ids, ARRAY[]::uuid[]))
      UNION
      SELECT NULLIF(element.value, '')::uuid
      FROM jsonb_array_elements_text(
        CASE WHEN jsonb_typeof(v_preview -> 'timesheet_ids') = 'array'
          THEN v_preview -> 'timesheet_ids' ELSE '[]'::jsonb END
      ) AS element(value)
    ) AS target(timesheet_id)
    WHERE target.timesheet_id IS NOT NULL
    ORDER BY 1
  LOOP
    v_weekly_source_guard := private.weekly_source_managed_root_guard_v1(v_weekly_source_root);
    -- HANDOVER 2 round-5 ruling B3 and A4 (18 September 2026).  The refusal is
    -- NARROWED: it applies to a Weekly-Source managed root, to a bound or
    -- protected family whose identity cannot be resolved, to a family carrying
    -- protected pay evidence but no authorisation row
    -- (PROTECTED_ROOT_AUTHORITY_MISSING), and to the live-record-on-an-
    -- unauthorised-Timesheet contradiction, which must never be allowed to
    -- continue merely because managed is false.  An unrelated, UNBOUND ordinary
    -- family -- including a malformed one -- keeps exactly the behaviour it had
    -- before this feature was installed.  Absent, null and non-boolean take the
    -- unsafe value at every read (Part 1 addendum rule 4).
    IF (COALESCE((v_weekly_source_guard->>'managed')::boolean, true)
         and (COALESCE((v_weekly_source_guard->>'ok')::boolean, true)
              or COALESCE((v_weekly_source_guard->>'weekly_source_bound')::boolean, true)))
       or COALESCE((v_weekly_source_guard->>'authorisation_record_without_authorised_timesheet')::boolean, false)
       or (v_weekly_source_guard->>'protected_target_ownership_state') is not null THEN
      RAISE EXCEPTION 'WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED'
        USING ERRCODE = '55000',
              DETAIL = jsonb_build_object(
                'code','WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED',
                'entry_point','E23:public.timesheet_weekly_chain_delete_apply',
                'block_reason','WEEKLY_SOURCE_MANAGED_ROOT',
                'refusal_basis', case
                  -- HANDOVER 2 round-5 Part E: the trim-equivalent split family is a
                  -- canonical booking-reference collision and must be named as one.
                  -- WP-03 handoff N20: accept BOTH the installed token and the ruled name for one
                  -- release, so the order of this edit and WP-03's rename cannot open a gap in
                  -- which Office stops seeing the ruled name.
                  when v_weekly_source_guard->>'reason' in (
                         'FAMILY_SPLIT_BY_WHITESPACE','BOOKING_REFERENCE_CANONICAL_COLLISION')
                    then 'BOOKING_REFERENCE_CANONICAL_COLLISION'
                  when coalesce((v_weekly_source_guard->>'managed')::boolean, true) and coalesce((v_weekly_source_guard->>'ok')::boolean, true)
                    then 'WEEKLY_SOURCE_MANAGED_ROOT'
                  when coalesce((v_weekly_source_guard->>'managed')::boolean, true)
                    then 'WEEKLY_SOURCE_BOUND_OR_PROTECTED_ROOT_UNRESOLVABLE'
                  when coalesce((v_weekly_source_guard->>'authorisation_record_without_authorised_timesheet')::boolean, false)
                    then 'AUTHORISATION_RECORD_WITHOUT_AUTHORISED_TIMESHEET'
                  else 'PROTECTED_ROOT_AUTHORITY_MISSING' end,
                'integrity_failure', not coalesce((v_weekly_source_guard->>'ok')::boolean,false),
                'timesheet_id', v_weekly_source_root,
                'reason', v_weekly_source_guard->>'reason'
              )::text;
    END IF;
  END LOOP;

  v_result := private.timesheet_weekly_chain_delete_apply_base_v1(
    p_timesheet_id,
    p_actor_user_id,
    p_expected_timesheet_ids,
    p_expected_contract_week_ids,
    p_expected_nhsp_shift_ids,
    p_expected_row_signature
  );

  IF COALESCE((v_result ->> 'ok')::boolean, false) IS NOT TRUE
     OR COALESCE((v_result ->> 'apply_performed')::boolean, false) IS NOT TRUE THEN
    RETURN v_result;
  END IF;

  IF v_contract_id IS NULL THEN
    RETURN v_result;
  END IF;

  SELECT c.start_date, c.end_date, COALESCE(c.week_ending_weekday_snapshot, 0)
  INTO v_contract_start, v_contract_end, v_week_ending_weekday
  FROM public.contracts c
  WHERE c.id = v_contract_id
  FOR UPDATE;

  IF NOT FOUND THEN
    RETURN v_result;
  END IF;

  SELECT min(cw.week_ending_date), max(cw.week_ending_date)
  INTO v_first_remaining_week, v_last_remaining_week
  FROM public.contract_weeks cw
  WHERE cw.contract_id = v_contract_id;

  v_new_start := v_contract_start;
  v_new_end := v_contract_end;

  IF v_first_remaining_week IS NOT NULL THEN
    v_start_week := v_contract_start
      + mod(v_week_ending_weekday - extract(dow from v_contract_start)::integer + 7, 7);
    v_end_week := v_contract_end
      + mod(v_week_ending_weekday - extract(dow from v_contract_end)::integer + 7, 7);

    IF v_first_remaining_week > v_start_week THEN
      SELECT min((entry.item ->> 'date')::date)
      INTO v_first_remaining_planned_date
      FROM public.contract_weeks remaining
      CROSS JOIN LATERAL jsonb_array_elements(COALESCE(remaining.planned_schedule_json, '[]'::jsonb)) entry(item)
      WHERE remaining.contract_id = v_contract_id
        AND remaining.week_ending_date = v_first_remaining_week
        AND jsonb_typeof(entry.item) = 'object'
        AND COALESCE(entry.item ->> 'date', '') ~ '^\d{4}-\d{2}-\d{2}$';

      v_new_start := COALESCE(v_first_remaining_planned_date, v_first_remaining_week - 6);
    END IF;

    IF v_last_remaining_week < v_end_week THEN
      SELECT max((entry.item ->> 'date')::date)
      INTO v_last_remaining_planned_date
      FROM public.contract_weeks remaining
      CROSS JOIN LATERAL jsonb_array_elements(COALESCE(remaining.planned_schedule_json, '[]'::jsonb)) entry(item)
      WHERE remaining.contract_id = v_contract_id
        AND remaining.week_ending_date = v_last_remaining_week
        AND jsonb_typeof(entry.item) = 'object'
        AND COALESCE(entry.item ->> 'date', '') ~ '^\d{4}-\d{2}-\d{2}$';

      v_new_end := COALESCE(v_last_remaining_planned_date, v_last_remaining_week);
    END IF;

    IF v_new_start IS DISTINCT FROM v_contract_start
       OR v_new_end IS DISTINCT FROM v_contract_end THEN
      UPDATE public.contracts
      SET start_date = v_new_start,
          end_date = v_new_end
      WHERE id = v_contract_id;
      PERFORM private.weekly_source_contract_fixed_approval_sync_v1(v_contract_id,p_actor_user_id);

      INSERT INTO public.audit_events(
        actor_user_id,
        object_type,
        object_id_text,
        action,
        before_json,
        after_json,
        reason
      )
      VALUES (
        p_actor_user_id,
        'contract',
        v_contract_id::text,
        'CONTRACT_DATES_RECONCILED_AFTER_WEEK_DELETE',
        jsonb_build_object('start_date', v_contract_start, 'end_date', v_contract_end),
        jsonb_build_object('start_date', v_new_start, 'end_date', v_new_end),
        'WEEKLY_TIMESHEET_CHAIN_DELETED'
      );
    END IF;
  END IF;

  RETURN v_result || jsonb_build_object(
    'contract_dates', jsonb_build_object(
      'start_date', v_new_start,
      'end_date', v_new_end,
      'changed', v_new_start IS DISTINCT FROM v_contract_start
        OR v_new_end IS DISTINCT FROM v_contract_end
    )
  );
END;
$function$;

create or replace function private.weekly_source_actual_timesheet_submission_v1(p_timesheet_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare t public.timesheets%rowtype; c public.contracts%rowtype; f public.timesheets_financials%rowtype;
  w public.candidate_submission_workflows%rowtype; h public.candidate_submission_components%rowtype;
  sig public.candidate_submission_components%rowtype; v_client uuid; v_candidate uuid;
  v_count integer; v_date date; v_input jsonb; v_patch jsonb; v_evidence jsonb; v_reason text;
  v_artifact_generation integer; v_final_receipt jsonb;
begin
  select * into t from public.timesheets where timesheet_id=p_timesheet_id;
  if t.timesheet_id is null or not t.is_current or t.archived_at_utc is not null or t.revoked_at is not null
    or t.status::text in('REVOKED','ARCHIVED','CANCELLED') or t.line_type::text<>'HOURS' or t.sheet_scope::text not in('WEEKLY','DAILY') then
    return jsonb_build_object('actual_submitted',false,'support_state','NOT_SUBMITTED','reason','NO_CURRENT_HOURS_TIMESHEET');
  end if;
  -- A waiting Office proposal is never a worker submission. Applied pair
  -- selection excludes displaced original and reversal before aggregation.
  if t.correction_kind='WHOLE_TIMESHEET_REVERSAL'
    or exists(select 1 from private.timesheet_correction_requests r where
      (r.state='WAITING' and r.replacement_timesheet_id=t.timesheet_id)
      or (r.state='APPLIED' and r.reversed_timesheet_id=t.timesheet_id)) then
    return jsonb_build_object('actual_submitted',false,'support_state','NOT_SUBMITTED','reason','CORRECTION_MEMBER_NOT_COUNTED');
  end if;
  select count(*),(array_agg(id order by id))[1] into v_count,f.id from public.timesheets_financials
    where timesheet_id=t.timesheet_id and is_current and timesheet_version=t.version;
  if v_count>1 then
    return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','CURRENT_FINANCIAL_IDENTITY_AMBIGUOUS');
  end if;
  if f.id is not null then select * into f from public.timesheets_financials where id=f.id; end if;
  if t.contract_id is not null then
    select * into c from public.contracts where id=t.contract_id;
    if c.id is null then
      return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','ACTUAL_CONTRACT_UNAVAILABLE');
    end if;
    v_client:=c.client_id; v_candidate:=c.candidate_id;
    if f.id is not null and (f.client_id is distinct from v_client or f.candidate_id is distinct from v_candidate) then
      return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','ACTUAL_FINANCIAL_OWNER_MISMATCH');
    end if;
  elsif t.sheet_scope::text='DAILY' and f.id is not null then
    v_client:=f.client_id; v_candidate:=f.candidate_id;
  else
    return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','NULL_CONTRACT_DAILY_OWNER_UNAVAILABLE');
  end if;
  if v_client is null or v_candidate is null or (nullif(t.settings_authority_json->>'client_id','') is not null
    and lower(t.settings_authority_json->>'client_id') is distinct from v_client::text) then
    return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','ACTUAL_OWNER_UNAVAILABLE');
  end if;
  -- Exact target binding can precede final TS workflow bookkeeping. Require
  -- one real submitted HOURS workflow for the actual Candidate and target.
  select count(*),(array_agg(id order by id))[1] into v_count,w.id
  from public.candidate_submission_workflows wf where (wf.target_timesheet_id=t.timesheet_id
    or (wf.state='FINALISED' and wf.workflow_kind='CONTRACT_COMBINED' and wf.id=t.candidate_workflow_id
      and exists(select 1 from public.candidate_submission_components actual_hours
        where actual_hours.workflow_id=wf.id and actual_hours.workflow_generation=wf.generation-1
          and actual_hours.component_kind='HOURS_TIMESHEET' and actual_hours.state='IMMUTABLE'
          and actual_hours.required and actual_hours.timesheet_id=t.timesheet_id)))
    and wf.candidate_id=v_candidate and wf.workflow_kind in('CONTRACT_HOURS','CONTRACT_COMBINED','DAILY')
    and wf.state in('WORKER_SUBMITTED','WORKER_SUBMITTED_PENDING_REVIEW_DOCUMENT','READY_FOR_MANAGER_APPROVAL',
      'AWAITING_MANAGER_APPROVAL','MANAGER_APPROVED','MANAGER_APPROVED_PENDING_FINAL_DOCUMENT',
      'READY_TO_FINALISE','AWAITING_PAPER_RETURN','RECEIVED','FINALISED')
    and wf.worker_submitted_at_utc is not null and wf.cancelled_at_utc is null
    and (t.candidate_workflow_id is null or wf.id=t.candidate_workflow_id);
  if v_count>1 then
    return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','SUBMISSION_WORKFLOW_AMBIGUOUS');
  end if;
  if w.id is not null then
    select * into w from public.candidate_submission_workflows where id=w.id;
    if jsonb_typeof(w.immutable_submission_json) is distinct from 'object'
      or octet_length(w.immutable_submission_sha256) is distinct from 32
      or private._candidate_sha256_jsonb_v1(w.immutable_submission_json) is distinct from w.immutable_submission_sha256
      or w.contract_id is distinct from t.contract_id
      or (t.sheet_scope::text='WEEKLY' and w.week_ending_date is distinct from t.week_ending_date)
      or (t.sheet_scope::text='DAILY' and (w.week_ending_date is not null or w.contract_week_id is not null))
      or w.scope is distinct from t.sheet_scope::text
      or (t.sheet_scope::text='DAILY') is distinct from (w.workflow_kind='DAILY') then
      return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','IMMUTABLE_SUBMISSION_IDENTITY_UNPROVED');
    end if;
    -- Native WORKER_SUBMIT owns the signed artifact generation. Ordinary
    -- FINALISED bookkeeping advances the workflow exactly once without
    -- replacing those immutable components or the TS artifact binding.
    -- Accept that finite arm only with the actual retained native receipt.
    v_artifact_generation:=w.generation;
    if w.state='FINALISED' then
      select count(*),(jsonb_agg(a.after_json order by a.id))->0 into v_count,v_final_receipt
        from public.audit_events a where a.object_type='candidate_workflow_finalisation_completion'
          and a.object_id_text=w.id::text and a.action='CANDIDATE_WORKFLOW_FINALISATION_COMPLETED'
          and a.before_json->>'contract_version'='CANDIDATE_FINALISATION_COMPLETION_V1'
          and a.before_json->>'workflow_generation'=(w.generation-1)::text
          and a.after_json->'ok'='true'::jsonb and a.after_json->>'workflow_id'=w.id::text
          and a.after_json->>'generation'=w.generation::text and a.after_json->>'state'='FINALISED'
          and (a.after_json->>'timesheet_id'=t.timesheet_id::text
            or (w.workflow_kind='CONTRACT_COMBINED'
              and a.after_json#>>'{canonical_result,hours_timesheet_id}'=t.timesheet_id::text
              and a.after_json#>'{canonical_result,hours_result,ok}'='true'::jsonb))
          and a.after_json->>'canonical_financial_sha256_hex'=encode(w.canonical_financial_sha256,'hex')
          and a.before_json->>'finalisation_identity_sha256'=encode(private._candidate_sha256_jsonb_v1(
            a.before_json->'finalisation_identity'),'hex');
      if v_count<>1 or w.finalised_at_utc is null or octet_length(w.canonical_financial_sha256) is distinct from 32 then
        return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','NATIVE_FINALISATION_ARTIFACT_BINDING_UNPROVED');
      end if;
      v_artifact_generation:=w.generation-1;
    end if;
    -- A freshly re-submitted pending claim can precede native TS bookkeeping;
    -- its exact current target, immutable claim and signature own the new
    -- witness. A future/absent TS generation is never accepted, and FINALISED
    -- still requires its exact retained artifact generation/receipt binding.
    if t.candidate_workflow_id is not null and (t.candidate_workflow_generation is null
      or t.candidate_workflow_generation<1 or t.candidate_workflow_generation>v_artifact_generation
      or (w.state='FINALISED' and t.candidate_workflow_generation is distinct from v_artifact_generation)) then
      return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','NATIVE_ARTIFACT_GENERATION_MISMATCH');
    end if;
    v_input:=coalesce(w.immutable_submission_json->'hours_submission',w.immutable_submission_json);
    if jsonb_typeof(v_input) is distinct from 'object' then
      return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','IMMUTABLE_HOURS_SUBMISSION_UNAVAILABLE');
    end if;
    v_patch:=coalesce(v_input->'timesheet_patch_json',v_input);
    if jsonb_typeof(v_patch) is distinct from 'object' or (t.sheet_scope::text='WEEKLY'
      and jsonb_typeof(coalesce(v_patch->'actual_schedule_json',v_input#>'{canonical_tsfin_snapshot,actual_schedule_json}')) is distinct from 'array') then
      return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','FROZEN_WORKER_HOURS_CLAIM_UNAVAILABLE');
    end if;
    select count(*),(array_agg(id order by id))[1] into v_count,h.id
    from public.candidate_submission_components component where component.workflow_id=w.id
      and component.workflow_generation=v_artifact_generation and component.component_kind='HOURS_TIMESHEET'
      and component.required and component.state='IMMUTABLE' and component.immutable_at_utc is not null
      and (component.timesheet_id is null or component.timesheet_id=t.timesheet_id);
    if v_count<>1 then
      return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','IMMUTABLE_HOURS_COMPONENT_UNPROVED');
    end if;
    select * into h from public.candidate_submission_components where id=h.id;
    -- Electronic submission requires its native immutable Candidate signature.
    -- Paper workflows without that receipt remain a precise engineering gate;
    -- a later verified manual/QR source can qualify through the legacy arm.
    select * into sig from public.candidate_submission_components where id=w.candidate_signature_component_id
      and workflow_id=w.id and workflow_generation=v_artifact_generation and document_role='CANDIDATE_SIGNATURE'
      and state='IMMUTABLE' and immutable_at_utc is not null;
    if sig.id is null or w.candidate_signed_at_utc is null or nullif(btrim(sig.storage_key),'') is null
      or octet_length(sig.source_content_sha256) is distinct from 32
      or sig.source_content_sha256 is distinct from w.candidate_signature_sha256 then
      v_reason:='CANDIDATE_SUBMISSION_SIGNATURE_UNPROVED';
    else
      if t.sheet_scope::text='DAILY' then
        -- This unchanged native helper performs the actual submitted-hours
        -- patch projection; no guessed Daily JSON layout or booked fallback.
        v_patch:=private._candidate_daily_canonical_save_input_v1(w.id,w.generation)->'timesheet_patch_json';
        if not pg_input_is_valid(coalesce(v_patch->>'worked_start_iso',''),'timestamp with time zone')
          or not pg_input_is_valid(coalesce(v_patch->>'worked_end_iso',''),'timestamp with time zone') then
          return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','SUBMITTED_DAILY_WORK_DATE_UNAVAILABLE');
        end if;
        v_date:=( (v_patch->>'worked_start_iso')::timestamptz at time zone 'Europe/London')::date;
        if v_date is distinct from w.work_date or v_date<t.week_ending_date-6 or v_date>t.week_ending_date then
          return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','SUBMITTED_DAILY_WORK_DATE_MISMATCH');
        end if;
      else v_date:=t.week_ending_date; end if;
      return jsonb_build_object('actual_submitted',true,'support_state','PROVED','authority','CANDIDATE_IMMUTABLE_HOURS',
        'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'client_id',v_client,'candidate_id',v_candidate,
        'contract_id',t.contract_id,'sheet_scope',t.sheet_scope,'week_ending_date',t.week_ending_date,'work_date',v_date,
        'workflow_id',w.id,'workflow_generation',v_artifact_generation,'submission_sha256',encode(w.immutable_submission_sha256,'hex'),
        'hours_component_id',h.id,'candidate_signature_component_id',sig.id,'submitted_at_utc',w.worker_submitted_at_utc,
        'manager_approved_at_utc',w.manager_approved_at_utc,'workflow_state',w.state);
    end if;
  end if;
  -- Reuse the normal read-only complete source/document contract. A manual
  -- key, planned clocks or bare schedule alone can never qualify this arm.
  v_evidence:=public._import_review_query_evidence_core_v1(t.timesheet_id);
  if coalesce((v_evidence->>'source_complete')::boolean,false)
    and coalesce((v_evidence->>'document_ready')::boolean,false) then
    v_date:=case when t.sheet_scope::text='DAILY' then (t.worked_start_iso at time zone 'Europe/London')::date else t.week_ending_date end;
    if v_date is null or v_date<t.week_ending_date-6 or v_date>t.week_ending_date then
      return jsonb_build_object('actual_submitted',false,'support_state','UNPROVED','reason','LEGACY_ACTUAL_WORK_DATE_UNAVAILABLE');
    end if;
    return jsonb_build_object('actual_submitted',true,'support_state','PROVED','authority','VERIFIED_LEGACY_SOURCE_DOCUMENT',
      'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'client_id',v_client,'candidate_id',v_candidate,
      'contract_id',t.contract_id,'sheet_scope',t.sheet_scope,'week_ending_date',t.week_ending_date,'work_date',v_date,
      'document_version_id',v_evidence->'document_version_id','source_evidence_fingerprint',v_evidence->'evidence_fingerprint');
  end if;
  return jsonb_build_object('actual_submitted',false,'support_state',case when w.id is null
    and not coalesce((v_evidence->>'source_complete')::boolean,false) then 'NOT_SUBMITTED' else 'UNPROVED' end,
    'reason',coalesce(v_reason,'ACTUAL_SUBMISSION_SOURCE_WITNESS_UNAVAILABLE'));
end;
$function$;

create or replace function private.weekly_source_signed_submission_read_context_v1(
  p_timesheet_id uuid,p_source_group_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare t public.timesheets%rowtype; v_witness jsonb; v_client uuid; v_work_date date;
  v_policy jsonb; v_route record; v_native boolean;
begin
  v_witness:=private.weekly_source_actual_timesheet_submission_v1(p_timesheet_id);
  if (v_witness->>'actual_submitted')::boolean is distinct from true then
    return jsonb_build_object('eligible',false,'submission_witness',v_witness,'read_only',true);
  end if;
  select * into t from public.timesheets where timesheet_id=p_timesheet_id;
  v_client:=(v_witness->>'client_id')::uuid; v_work_date:=(v_witness->>'work_date')::date;
  if not exists(select 1 from public.weekly_source_groups g
    join public.weekly_source_group_clients member on member.source_group_id=g.id and member.client_id=v_client
    join public.weekly_source_client_policies policy on policy.source_group_id=g.id and policy.client_id=v_client
    join public.weekly_source_group_rule_assignments assignment on assignment.source_group_id=g.id
      and assignment.feature_enabled and assignment.feature_purpose='SIGNED_CHECK_ONLY' and assignment.rule_set_version_id is null
    where g.id=p_source_group_id and g.active and g.source_family='ROSTER'
      and v_work_date between member.valid_from and coalesce(member.valid_to,'infinity'::date)
      and t.week_ending_date between member.valid_from and coalesce(member.valid_to,'infinity'::date)
      and v_work_date between policy.effective_from and coalesce(policy.effective_to,'infinity'::date)
      and t.week_ending_date between assignment.effective_from_week_ending and coalesce(assignment.effective_to_week_ending,'infinity'::date)
      and policy.authority_mode='TIMESHEET_AUTHORITY' and policy.document_mode='INVOICE_EVIDENCE_REQUIRED' and not policy.self_bill_enabled) then
    return jsonb_build_object('eligible',false,'submission_witness',v_witness,'read_only',true);
  end if;
  v_native:=private.weekly_source_signed_check_only_v1(p_timesheet_id);
  if v_native then
    return jsonb_build_object('eligible',true,'read_only',true,'submission_witness',v_witness,
      'route_state','NATIVE_ROUTE_AVAILABLE','query_route_available',true,'pending_materialisation',false);
  end if;
  -- This exception admits an actual submitted record to a read, never query,
  -- manager/correction/Send/Authorise or financial mutation. Client/Contract,
  -- Candidate, work date, workflow/generation and signature are already proved
  -- by the unchanged canonical submitted-hours projection in the witness.
  if t.sheet_scope::text<>'DAILY' or t.worked_start_iso is not null
    or v_witness->>'authority' is distinct from 'CANDIDATE_IMMUTABLE_HOURS' then
    return jsonb_build_object('eligible',false,'submission_witness',v_witness,'read_only',true);
  end if;
  v_policy:=private._weekly_source_effective_policy_v1(v_client,t.contract_id,v_work_date);
  select * into v_route from public._import_review_effective_authority_core_v1('HR_DAILY',t.contract_id,v_client,v_work_date);
  if v_policy->>'source_family' is distinct from 'ROSTER' or v_policy->>'authority_mode' is distinct from 'TIMESHEET_AUTHORITY'
    or v_policy->>'document_mode' is distinct from 'INVOICE_EVIDENCE_REQUIRED'
    or coalesce((v_policy->>'self_bill_enabled')::boolean,true)
    or not coalesce(v_route.route_eligible,false) or not coalesce(v_route.validation_eligible,false)
    or coalesce(v_route.import_authoritative,true) or v_route.authority_mode is distinct from 'VALIDATION_ONLY'
    or coalesce(v_route.effective_is_nhsp,true) or coalesce(v_route.effective_no_timesheet_required,true) then
    return jsonb_build_object('eligible',false,'submission_witness',v_witness,'read_only',true);
  end if;
  return jsonb_build_object('eligible',true,'read_only',true,'submission_witness',v_witness,
    'route_state','SUBMITTED_PENDING_NATIVE_MATERIALISATION','query_route_available',false,
    'pending_materialisation',true,'actions_held',true,'action_hold_reason','NATIVE_DAILY_MATERIALISATION_PENDING');
end;
$function$;

create or replace function private.weekly_source_checklist_client_calendar_v1(
  p_client_id uuid,p_local_today date
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare authority jsonb; weekday integer; latest_week date;
begin
  if p_client_id is null or p_local_today is null then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_CLIENT_WEEK_AUTHORITY_UNAVAILABLE' using errcode='22023';
  end if;
  authority:=private._contract_settings_effective_core_v1(p_client_id,null,p_local_today,'OFFICE',null);
  if authority->>'authority_version' is distinct from 'CONTRACT_SETTINGS_AUTHORITY_V1'
    or authority->>'client_id' is distinct from p_client_id::text
    or not pg_input_is_valid(coalesce(authority#>>'{values,week_ending_weekday}',''),'integer')
    or coalesce(authority->>'authority_fingerprint','')!~'^[0-9a-f]{64}$' then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_CLIENT_WEEK_AUTHORITY_UNAVAILABLE' using errcode='55000';
  end if;
  weekday:=(authority#>>'{values,week_ending_weekday}')::integer;
  if weekday not between 0 and 6 then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_CLIENT_WEEK_AUTHORITY_UNAVAILABLE' using errcode='55000';
  end if;
  -- A week ending today has not ended yet. Walk back from yesterday.
  latest_week:=p_local_today-1-((extract(dow from p_local_today-1)::integer-weekday+7)%7);
  return jsonb_build_object('contract','WEEKLY_SOURCE_CHECKLIST_CLIENT_CALENDAR_V1',
    'client_id',p_client_id,'local_today',p_local_today,'week_ending_weekday',weekday,
    'latest_ended_week',latest_week,'authority_fingerprint',authority->>'authority_fingerprint');
end;
$function$;

create or replace function private.weekly_source_check_only_query_rows_v1(
  p_source_cycle_id uuid,p_client_id uuid,p_filters jsonb
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare c public.weekly_source_cycles%rowtype; v_actor uuid; v_week date; v_limit integer:=50;
  v_cursor jsonb; v_binding text; v_revision text; v_rows jsonb; v_more boolean; v_last jsonb; v_admin boolean;
begin
  perform private._weekly_source_settings_assert_request_v1(p_filters,
    array['actor_user_id','source_group_id','week_ending','cursor','limit'], 'WEEKLY_SOURCE_CHECK_ONLY_FILTER_INVALID');
  v_actor:=nullif(p_filters->>'actor_user_id','')::uuid;
  if nullif(p_filters->>'week_ending','') is null or not pg_input_is_valid(p_filters->>'week_ending','date') then
    raise exception 'WEEKLY_SOURCE_CHECK_ONLY_FILTER_INVALID' using errcode='22023';
  end if;
  v_week:=(p_filters->>'week_ending')::date;
  select * into c from public.weekly_source_cycles where id=p_source_cycle_id;
  if c.id is null or p_client_id is null or (c.scope_client_id is not null and c.scope_client_id<>p_client_id)
    or v_week not between c.finalisation_week_ending-6 and c.finalisation_week_ending
    or (nullif(p_filters->>'source_group_id','') is not null and (p_filters->>'source_group_id')::uuid<>c.source_group_id) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_SCOPE_UNAVAILABLE' using errcode='22023';
  end if;
  select lower(btrim(coalesce(role,'')))='admin' into v_admin from public.tms_users where id=v_actor and is_active;
  perform private.weekly_source_office_authority_v1(v_actor,case when v_admin then 'VIEW_SOURCE_PROGRESS' else 'VIEW_PAY_WORK' end,
    c.source_group_id,p_client_id,v_week);
  v_limit:=coalesce((p_filters->>'limit')::integer,50);
  if v_limit not between 1 and 100 then raise exception 'WEEKLY_SOURCE_CHECK_ONLY_FILTER_INVALID' using errcode='22023'; end if;
  v_binding:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECK_ONLY_BINDING_V1',
    jsonb_build_object('actor',v_actor,'view',case when v_admin then 'ADMIN' else 'PAY_READONLY' end,
      'cycle',c.id,'client',p_client_id,'filters',p_filters-'cursor'-'limit')),'hex');
  if nullif(p_filters->>'cursor','') is not null then
    begin
      if length(p_filters->>'cursor')>4096 then raise exception 'cursor'; end if;
      v_cursor:=convert_from(decode(p_filters->>'cursor','base64'),'UTF8')::jsonb;
      if v_cursor->>'contract' is distinct from 'WEEKLY_SOURCE_CHECK_ONLY_CURSOR_V1' or v_cursor->>'binding' is distinct from v_binding
        or jsonb_typeof(v_cursor->'after') is distinct from 'array' or jsonb_array_length(v_cursor->'after')<>3
        or coalesce(v_cursor->>'read_revision','')!~'^[0-9a-f]{64}$'
        or jsonb_typeof(v_cursor#>'{after,0}') is distinct from 'string'
        or jsonb_typeof(v_cursor#>'{after,1}') is distinct from 'string'
        or jsonb_typeof(v_cursor#>'{after,2}') is distinct from 'string'
        or not pg_input_is_valid(coalesce(v_cursor#>>'{after,1}',''),'date')
        or length(coalesce(v_cursor#>>'{after,2}','')) not between 1 and 512 then raise exception 'cursor'; end if;
      perform private._weekly_source_settings_assert_request_v1(v_cursor,array['contract','binding','read_revision','after'],'CURSOR');
    exception when others then raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001'; end;
  end if;
  with actual as materialized (
    select t.*,s.witness,rctx.route_read,ca.id actual_candidate_id,cl.name client_name,coalesce(nullif(btrim(ca.first_name||' '||ca.last_name),''),ca.id::text) worker_name,
      private.weekly_source_query_ascii_fold_v1(coalesce(nullif(btrim(ca.first_name||' '||ca.last_name),''),ca.id::text)) collate "C" worker_sort,
      case when rctx.route_read->>'route_state'='NATIVE_AGENCY_INVOICE' then t.week_ending_date else (s.witness->>'work_date')::date end actual_work_date
    from public.timesheets t
    cross join lateral(select private.weekly_source_signed_submission_read_context_v1(t.timesheet_id,c.source_group_id) signed_read) signed_context
    cross join lateral(select case when signed_context.signed_read->'eligible'='true'::jsonb then signed_context.signed_read
      when private.weekly_source_agency_invoice_check_only_v1(t.timesheet_id) is true
        and private.weekly_source_effective_rule_set_v1(p_client_id,c.id)#>>'{values,invoice_sender}'='AGENCY_INVOICE' then
        jsonb_build_object('eligible',true,'read_only',true,'submission_witness',private.weekly_source_actual_timesheet_submission_v1(t.timesheet_id),
          'route_state','NATIVE_AGENCY_INVOICE','query_route_available',true,'pending_materialisation',false)
      else signed_context.signed_read end route_read) rctx
    cross join lateral(select rctx.route_read->'submission_witness' witness) s
    left join public.contracts actual_contract on actual_contract.id=t.contract_id
    join public.clients cl on cl.id=p_client_id join public.candidates ca on ca.id=case
      when rctx.route_read->>'route_state'='NATIVE_AGENCY_INVOICE' then actual_contract.candidate_id else (s.witness->>'candidate_id')::uuid end
    where ((s.witness->>'actual_submitted')::boolean is true and s.witness->>'client_id'=p_client_id::text
      or (rctx.route_read->>'route_state'='NATIVE_AGENCY_INVOICE' and actual_contract.client_id=p_client_id))
      and t.week_ending_date between c.finalisation_week_ending-6 and c.finalisation_week_ending
      and t.week_ending_date=v_week
      and (rctx.route_read->>'eligible')::boolean is true
      and (rctx.route_read->>'route_state'='NATIVE_AGENCY_INVOICE' or exists(select 1 from public.weekly_source_groups g
        join public.weekly_source_group_clients gc on gc.source_group_id=g.id and gc.client_id=p_client_id
        join public.weekly_source_client_policies cp on cp.source_group_id=g.id and cp.client_id=gc.client_id
        join public.weekly_source_group_rule_assignments ga on ga.source_group_id=g.id and ga.feature_enabled
          and ga.feature_purpose='SIGNED_CHECK_ONLY' and ga.rule_set_version_id is null
        where g.id=c.source_group_id and g.active and g.source_family='ROSTER'
          and (s.witness->>'work_date')::date between gc.valid_from and coalesce(gc.valid_to,'infinity'::date)
          and t.week_ending_date between gc.valid_from and coalesce(gc.valid_to,'infinity'::date)
          and (s.witness->>'work_date')::date between cp.effective_from and coalesce(cp.effective_to,'infinity'::date)
          and t.week_ending_date between ga.effective_from_week_ending and coalesce(ga.effective_to_week_ending,'infinity'::date)
          and cp.authority_mode='TIMESHEET_AUTHORITY' and cp.document_mode='INVOICE_EVIDENCE_REQUIRED' and not cp.self_bill_enabled))
  ), context as materialized (
    select a.*,tv.id validation_id,tv.status::text validation_status,tv.reason_code validation_reason,
      tv.last_source validation_import_id,tv.validated_at_utc,tf.id financial_id,tf.processing_status::text processing_status,
      r.id request_id,r.state request_state,r.state_revision request_state_revision,r.replacement_timesheet_id,
      pw.id replacement_workflow_id,pw.generation replacement_workflow_generation,pw.state replacement_workflow_state,
      pw.worker_submitted_at_utc replacement_submitted_at,pw.manager_approved_at_utc replacement_manager_approved_at,
      qi.id query_import_id,qi.uploaded_at_utc query_import_uploaded_at,qs.preview_generation,qs.state_version,
      qs.preview_fingerprint,qi.import_scope,qi.source_file_sha256,
      case when (a.route_read->>'query_route_available')::boolean is not true then null
        when qi.id is not null then private.weekly_source_issued_signed_query_evidence_v1(a.timesheet_id,qi.id)
        else public._import_review_query_evidence_core_v1(a.timesheet_id) end query_evidence
    from actual a
    left join lateral(select * from public.timesheet_validations v where v.timesheet_id=a.timesheet_id
      order by v.updated_at desc,v.created_at desc,v.id desc limit 1) tv on true
    left join public.timesheets_financials tf on tf.timesheet_id=a.timesheet_id and tf.is_current and tf.timesheet_version=a.version
    left join lateral(select * from private.timesheet_correction_requests request where request.state='WAITING'
      and request.reversed_timesheet_id=a.timesheet_id order by request.id limit 1) r on true
    left join public.timesheets pt on pt.timesheet_id=r.replacement_timesheet_id
    left join public.candidate_submission_workflows pw on pw.id=pt.candidate_workflow_id and pw.generation=pt.candidate_workflow_generation
    left join lateral(select hi.* from public.hr_imports hi
      where hi.pruned_at is null and hi.source_system::text in('HEALTHROSTER','HEALTHROSTER_DAILY')
        and (hi.client_id is null or hi.client_id=p_client_id)
        and (hi.id=tv.last_source or exists(select 1 from public.import_review_decisions d join public.import_review_states st on st.import_id=d.import_id
          and st.preview_generation=d.preview_generation and st.superseded_at_utc is null and st.abandoned_at_utc is null
          where d.import_id=hi.id and d.timesheet_id=a.timesheet_id and d.client_id=p_client_id and d.is_current))
      order by hi.uploaded_at_utc desc,hi.id desc limit 1) qi on true
    left join public.import_review_states qs on qs.import_id=qi.id
  ), rows as materialized (
    select x.worker_sort,x.actual_work_date,('timesheet:'||x.timesheet_id) collate "C" item_sort,
      jsonb_build_object('item_id','timesheet:'||x.timesheet_id,'timesheet_id',x.timesheet_id,'item_kind','ACTUAL_TIMESHEET',
      'source_group_id',c.source_group_id,'source_cycle_id',c.id,'client_id',p_client_id,'client',x.client_name,
      'candidate_id',x.actual_candidate_id,'worker',x.worker_name,'week_ending',x.week_ending_date,
      'work_date',x.actual_work_date,'sheet_scope',x.sheet_scope,'submission_witness',x.witness,
      'submission_read_context',x.route_read,
      'validation',jsonb_build_object('id',x.validation_id,'status',x.validation_status,'reason_code',x.validation_reason,
        'last_source',x.validation_import_id,'validated_at_utc',x.validated_at_utc),
      'ordinary_authorised',x.authorised_at_server is not null,'financial_id',x.financial_id,'processing_status',x.processing_status,
      'correction_owns_read_item',x.request_id is not null,'ordinary_query_reminder_suppressed',x.request_id is not null,
      'correction',case when x.request_id is not null then jsonb_build_object('request_id',x.request_id,'state',x.request_state,
        'state_revision',x.request_state_revision,'replacement_timesheet_id',x.replacement_timesheet_id,
        'workflow_id',x.replacement_workflow_id,'workflow_generation',x.replacement_workflow_generation,
        'workflow_state',x.replacement_workflow_state,'worker_submitted_at_utc',x.replacement_submitted_at,
        'manager_approved_at_utc',x.replacement_manager_approved_at) end,
      -- Pay work remains available for native subject admission, but invoice
      -- query evidence, recipients and delivery history are admin-only.
      'query_import_id',case when v_admin then x.query_import_id end,
      'query_preview',case when v_admin and x.query_import_id is not null then jsonb_build_object('import_id',x.query_import_id,
        'preview_generation',x.preview_generation,'state_version',x.state_version,'preview_fingerprint',x.preview_fingerprint) end,
      'query_evidence',case when v_admin then x.query_evidence end,
      'native_issues',case when v_admin and (x.route_read->>'query_route_available')::boolean is true
        then coalesce(issues.value,'[]'::jsonb) else '[]'::jsonb end,
      'unfinished_daily_review',review.unfinished_daily_review,
      -- One native open fact, before actor redaction. Retention and rendering
      -- consume this fact; neither owns another query/preview classifier.
      'open_read_item',x.request_id is not null
        or x.route_read->>'route_state' is not distinct from 'SUBMITTED_PENDING_NATIVE_MATERIALISATION'
        or x.authorised_at_server is null or review.unfinished_daily_review
        or ((x.route_read->>'query_route_available')::boolean is true and jsonb_array_length(coalesce(issues.value,'[]'::jsonb))>0)
        or x.validation_status is distinct from 'VALIDATION_OK' or x.processing_status is not distinct from 'READY_FOR_HR',
      'engineering_gate',case when x.validation_reason is not null and x.validation_status<>'VALIDATION_OK'
        and x.query_import_id is null then 'CURRENT_IMPORT_REVIEW_ISSUE_SNAPSHOT_UNAVAILABLE' end) value
    from context x
    cross join lateral(select case when x.sheet_scope::text='DAILY' and x.query_import_id is not null
      and upper(coalesce(x.import_scope,''))='HR_DAILY' then exists(select 1 from public.import_review_states ds
        where ds.import_id=x.query_import_id and ds.applied_at_utc is null and ds.superseded_at_utc is null and ds.abandoned_at_utc is null)
      else false end unfinished_daily_review) review
    left join lateral(select jsonb_agg(jsonb_build_object('action_id',d.action_id,'action_kind',d.action_kind,
      'import_id',d.import_id,'preview_generation',d.preview_generation,'timesheet_id',d.timesheet_id,'client_id',d.client_id,
      'evidence_fingerprint',d.evidence_fingerprint,'reason_code',d.summary_json->'reason_code','summary',d.summary_json,
      'issue_id',e.id,'issue_fingerprint',e.issue_fingerprint,'recipient_scope',e.recipient_scope,
      'sent_verified',e.delivery_history_status='SENT_VERIFIED' and delivery.status='SENT'
        and delivery.accepted_at_utc is not null and delivery.marked_at_utc is not null
        and item.marked_sent_at_utc is not null and (upper(mail.status::text)='SENT' or mail.sent_at is not null),
      'last_sent_at',e.last_sent_at,'sent_count',e.sent_count,'delivery_id',delivery.id,
      'recipient_email',delivery.recipient_email,'reminder_sequence',delivery.reminder_sequence,
      'mail_outbox_id',mail.id,'mail_status',mail.status,'accepted_at_utc',delivery.accepted_at_utc) order by d.action_id) value
      from public.import_review_decisions d
      left join public.hr_issue_emails e on e.issue_fingerprint=coalesce(nullif(d.summary_json->>'issue_fingerprint',''),d.source_identity)
        and e.timesheet_id=x.timesheet_id and e.client_id=p_client_id
      left join public.hr_issue_email_deliveries delivery on delivery.id=e.last_successful_delivery_id
      left join public.hr_issue_email_delivery_items item on item.delivery_id=delivery.id and item.issue_id=e.id
        and item.issue_fingerprint=e.issue_fingerprint and item.action_id=d.action_id
      left join public.mail_outbox mail on mail.id=delivery.mail_outbox_id and mail.deterministic_outbox_key=delivery.deterministic_outbox_key
      where d.import_id=x.query_import_id and d.preview_generation=x.preview_generation and d.is_current
        and d.timesheet_id=x.timesheet_id and d.client_id=p_client_id
        and d.action_kind in('EMAIL_ISSUE','EMAIL_REMINDER')) issues on true
  ), source_information as materialized (
    -- R-254 is informational inside an admitted actual-submission row. Native
    -- missing-source advisories never create a Checklist row or Timesheet count.
    -- They carry native action identity/reason, with no fabricated TS target.
    select private.weekly_source_query_ascii_fold_v1(coalesce(nullif(btrim(ca.first_name||' '||ca.last_name),''),
        d.summary_json->>'candidate_name',hr.staff_raw,hr.staff_norm)) collate "C" worker_sort,
      hr.date_local actual_work_date,('native-action:'||d.action_id) collate "C" item_sort,
      jsonb_build_object('item_id','native-action:'||d.action_id,'item_kind','SOURCE_INFORMATION',
        'timesheet_id',null,'counted_timesheet_id',null,'counts_for_row_admission',false,'open_read_item',false,
        'source_group_id',c.source_group_id,'source_cycle_id',c.id,'client_id',p_client_id,
        'client',cl.name,'candidate_id',d.candidate_id,
        'worker',coalesce(nullif(btrim(ca.first_name||' '||ca.last_name),''),d.summary_json->>'candidate_name',hr.staff_raw,hr.staff_norm),
        'work_date',hr.date_local,'week_ending',own_week.week_ending_date,
        'sheet_scope',case when upper(coalesce(d.summary_json->>'source_route','')) like '%DAILY%' then 'DAILY' else 'WEEKLY' end,
        'query_import_id',d.import_id,'hr_row_id',d.hr_row_id,'action_id',d.action_id,
        'query_preview',jsonb_build_object('import_id',d.import_id,'preview_generation',st.preview_generation,
          'state_version',st.state_version,'preview_fingerprint',st.preview_fingerprint),
        'action_kind',d.action_kind,'evidence_fingerprint',d.evidence_fingerprint,'summary',d.summary_json,
        'native_reason_code',d.summary_json->>'reason_code','writable_action',null) value
    from public.import_review_decisions d
    join public.import_review_states st on st.import_id=d.import_id and st.preview_generation=d.preview_generation
      and st.superseded_at_utc is null and st.abandoned_at_utc is null
    join public.hr_imports hi on hi.id=d.import_id and hi.pruned_at is null
      and hi.source_system::text in('HEALTHROSTER','HEALTHROSTER_DAILY') and (hi.client_id is null or hi.client_id=p_client_id)
    join public.hr_rows hr on hr.id=d.hr_row_id and hr.import_id=d.import_id
    join lateral(select min(admitted.week_ending_date) week_ending_date from actual admitted
      where hr.date_local between admitted.week_ending_date-6 and admitted.week_ending_date
      having count(distinct admitted.week_ending_date)=1) own_week on true
    join public.clients cl on cl.id=p_client_id left join public.candidates ca on ca.id=d.candidate_id
    where v_admin and d.client_id=p_client_id and d.timesheet_id is null and d.is_current
      and d.action_kind='ADVISORY' and d.summary_json->>'authority_mode'='VALIDATION_ONLY'
      and d.summary_json->>'reason_code' in('DAILY_TIMESHEET_NOT_SUBMITTED','WEEKLY_TIMESHEET_NOT_SUBMITTED',
        'WEEKLY_TIMESHEET_AWAITING_MANAGER_APPROVAL','WEEKLY_TIMESHEET_COMPLETING')
      and own_week.week_ending_date between c.finalisation_week_ending-6 and c.finalisation_week_ending
      and own_week.week_ending_date=v_week
      and exists(select 1 from actual admitted where admitted.week_ending_date=own_week.week_ending_date)
      and exists(select 1 from public.weekly_source_group_clients member
        join public.weekly_source_client_policies policy on policy.source_group_id=member.source_group_id and policy.client_id=member.client_id
        where member.source_group_id=c.source_group_id and member.client_id=p_client_id
          and hr.date_local between member.valid_from and coalesce(member.valid_to,'infinity'::date)
          and hr.date_local between policy.effective_from and coalesce(policy.effective_to,'infinity'::date)
          and policy.authority_mode='TIMESHEET_AUTHORITY' and policy.document_mode='INVOICE_EVIDENCE_REQUIRED' and not policy.self_bill_enabled)
      and hi.id=(select latest.id from public.hr_imports latest
        join public.import_review_states latest_state on latest_state.import_id=latest.id
          and latest_state.superseded_at_utc is null and latest_state.abandoned_at_utc is null
        where latest.pruned_at is null and latest.source_system=hi.source_system
          and (latest.client_id is null or latest.client_id=p_client_id)
          and exists(select 1 from public.import_review_decisions latest_decision
            left join public.hr_rows latest_row on latest_row.id=latest_decision.hr_row_id and latest_row.import_id=latest.id
            where latest_decision.import_id=latest.id and latest_decision.preview_generation=latest_state.preview_generation
              and latest_decision.is_current and latest_decision.client_id=p_client_id
              and (latest_row.date_local between own_week.week_ending_date-6 and own_week.week_ending_date
                or exists(select 1 from actual latest_actual where latest_actual.timesheet_id=latest_decision.timesheet_id
                  and latest_actual.week_ending_date=own_week.week_ending_date)))
        order by latest.uploaded_at_utc desc,latest.id desc limit 1)
  ), all_rows as materialized (
    select * from rows union all select * from source_information
  ), version as (
    select encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECK_ONLY_READ_REVISION_V1',
      coalesce(jsonb_agg(value order by worker_sort,actual_work_date,item_sort),'[]'::jsonb)),'hex') hash from all_rows
  ), page as (
    select * from all_rows where v_cursor is null or (worker_sort,actual_work_date,item_sort)>
      (v_cursor#>>'{after,0}',(v_cursor#>>'{after,1}')::date,v_cursor#>>'{after,2}')
    order by worker_sort,actual_work_date,item_sort limit v_limit+1
  ) select (select hash from version),coalesce(jsonb_agg(value order by worker_sort,actual_work_date,item_sort),'[]'::jsonb),count(*)>v_limit
    into v_revision,v_rows,v_more from page;
  if v_cursor is not null and v_cursor->>'read_revision' is distinct from v_revision then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001';
  end if;
  if v_more then v_rows:=v_rows-(jsonb_array_length(v_rows)-1); end if;
  v_last:=v_rows->(jsonb_array_length(v_rows)-1);
  return jsonb_build_object('ok',true,'contract','WEEKLY_SOURCE_CHECK_ONLY_QUERY_ROWS_V1','rows',v_rows,
    'read_only',true,'invoice_subjects_hidden',not coalesce(v_admin,false),
    'read_revision',v_revision,'binding',v_binding,'has_more',v_more,'next_cursor',case when v_more then
      encode(convert_to(jsonb_build_object('contract','WEEKLY_SOURCE_CHECK_ONLY_CURSOR_V1','binding',v_binding,'read_revision',v_revision,
        'after',jsonb_build_array(private.weekly_source_query_ascii_fold_v1(v_last->>'worker'),v_last->'work_date',v_last->'item_id'))::text,'UTF8'),'base64') end);
end;
$function$;

create or replace function private.weekly_source_check_only_issue_filter_keys_v1(p_action_kind text,p_summary jsonb)
returns jsonb language plpgsql immutable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare keys jsonb:='[]'::jsonb; comparisons jsonb; evidence jsonb;
begin
  if p_action_kind is null or p_action_kind not in('EMAIL_ISSUE','EMAIL_REMINDER','ADVISORY') or jsonb_typeof(p_summary) is distinct from 'object' then
    raise exception 'WEEKLY_SOURCE_CHECK_ONLY_NATIVE_FILTER_FACT_INVALID' using errcode='55000';
  end if;
  comparisons:=case when jsonb_typeof(p_summary->'comparisons')='array' then p_summary->'comparisons' else '[]'::jsonb end;
  evidence:=case when jsonb_typeof(p_summary->'evidence_rows')='array' then p_summary->'evidence_rows' else '[]'::jsonb end;
  if p_action_kind='ADVISORY' and p_summary->>'authority_mode'='VALIDATION_ONLY'
    and p_summary->>'reason_code' in('DAILY_TIMESHEET_NOT_SUBMITTED','WEEKLY_TIMESHEET_NOT_SUBMITTED') then
    keys:=keys||jsonb_build_array('TIMESHEET_MISSING');
  end if;
  if p_action_kind in('EMAIL_ISSUE','EMAIL_REMINDER') and (
    p_summary->>'reason_code' in('ACTUAL_HOURS_MISMATCH','START_END_MISMATCH','BREAK_MINUTES_MISMATCH')
    or exists(select 1 from jsonb_array_elements(comparisons) cx where cx->>'match_status'='MISMATCH')
    or exists(select 1 from jsonb_array_elements(evidence) e cross join lateral jsonb_array_elements_text(
      case when jsonb_typeof(e->'difference_codes')='array' then e->'difference_codes' else '[]'::jsonb end) code
      where code in('WORKED_HOURS','START_TIME','END_TIME','BREAK_MINUTES'))) then
    keys:=keys||jsonb_build_array('HOURS_DIFFER');
  end if;
  if p_action_kind in('EMAIL_ISSUE','EMAIL_REMINDER') and (p_summary->>'reason_code'='MISSING_FROM_IMPORT'
    or exists(select 1 from jsonb_array_elements(comparisons) cx where cx->>'match_status' in('UNMATCHED','HR_ONLY'))) then
    keys:=keys||jsonb_build_array('MISSING_SHIFT');
  end if;
  return keys;
end;
$function$;

create or replace function private.weekly_source_check_only_query_groups_v1(
  p_source_cycle_id uuid,p_client_id uuid,p_filters jsonb
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  actor public.tms_users%rowtype; cycle public.weekly_source_cycles%rowtype;
  scope jsonb; view text; authority jsonb; page jsonb; cursor text; raw_revision text;
  rows jsonb:='[]'::jsonb; raw jsonb; preview jsonb; native_issue jsonb;
  groups jsonb:='[]'::jsonb; targets jsonb:='[]'::jsonb; children jsonb; child jsonb;
  parent_identity jsonb; parent_key text; parent_proof text; binding text; revision text;
  action_bindings jsonb; child_binding jsonb; review_action jsonb; latest_decision public.import_review_decisions%rowtype;
  state public.import_review_states%rowtype; first_seen timestamptz; group_row jsonb;
  native_status jsonb; native_summary jsonb; actual_item_id text; native_actions text[]; child_filter_keys jsonb; group_filter_keys jsonb;
  reminder_facts jsonb; reminder_action jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  perform private._weekly_source_settings_assert_request_v1(p_filters,
    array['actor_user_id','source_group_id','week_ending'],'WEEKLY_SOURCE_CHECK_ONLY_GROUP_FILTER_INVALID');
  select u.* into actor from public.tms_users u where u.id=(p_filters->>'actor_user_id')::uuid and u.is_active;
  if actor.id is null then raise exception 'WEEKLY_SOURCE_OFFICE_ACTOR_INACTIVE' using errcode='42501'; end if;
  view:=case when lower(btrim(coalesce(actor.role,'')))='admin' then 'ADMIN' else 'PAY_READONLY' end;
  if not pg_input_is_valid(coalesce(p_filters->>'week_ending',''),'date') then
    raise exception 'WEEKLY_SOURCE_CHECK_ONLY_GROUP_FILTER_INVALID' using errcode='22023';
  end if;
  select c.* into cycle from public.weekly_source_cycles c where c.id=p_source_cycle_id;
  if cycle.id is null or cycle.source_group_id::text is distinct from p_filters->>'source_group_id'
    or p_client_id is null or (cycle.scope_client_id is not null and cycle.scope_client_id<>p_client_id)
    or (p_filters->>'week_ending')::date not between cycle.finalisation_week_ending-6 and cycle.finalisation_week_ending then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_SCOPE_UNAVAILABLE' using errcode='22023';
  end if;
  scope:=jsonb_build_object('source_group_id',cycle.source_group_id,'client_id',p_client_id,
    'source_cycle_id',cycle.id,'week_ending',p_filters->>'week_ending');
  authority:=private.weekly_source_office_authority_v1(actor.id,
    case when view='ADMIN' then 'VIEW_SOURCE_PROGRESS' else 'VIEW_PAY_WORK' end,
    cycle.source_group_id,p_client_id,(p_filters->>'week_ending')::date);
  binding:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECK_ONLY_QUERY_GROUP_BINDING_V1',
    jsonb_build_object('actor',actor.id,'view',view,'authority',authority,'scope',scope)),'hex');
  cursor:=null;
  loop
    page:=private.weekly_source_check_only_query_rows_v1(cycle.id,p_client_id,
      jsonb_strip_nulls(p_filters||jsonb_build_object('limit',100,'cursor',cursor)));
    if page->'ok' is distinct from 'true'::jsonb then
      raise exception 'WEEKLY_SOURCE_CHECK_ONLY_NATIVE_GROUP_READ_UNAVAILABLE' using errcode='55000';
    end if;
    if raw_revision is not null and raw_revision is distinct from page->>'read_revision' then
      raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001';
    end if;
    raw_revision:=page->>'read_revision'; rows:=rows||page->'rows';
    exit when page->'has_more'='false'::jsonb;
    if cursor is not distinct from page->>'next_cursor' then
      raise exception 'WEEKLY_SOURCE_CHECK_ONLY_NATIVE_GROUP_READ_UNAVAILABLE' using errcode='55000';
    end if;
    cursor:=page->>'next_cursor';
  end loop;
  -- HR comparison/questions are invoice subjects. Pay-only actors see no D10
  -- parents or private import/action frames; their authority still binds this
  -- empty census. Native Source pay subjects retain their separate existing path.
  if view='ADMIN' then
    for raw in select value from jsonb_array_elements(rows) loop
      preview:=raw->'query_preview';
      if preview is null or preview='null'::jsonb then continue; end if;
      select s.* into state from public.import_review_states s where s.import_id=(preview->>'import_id')::uuid
        and s.preview_generation=(preview->>'preview_generation')::integer and s.state_version=(preview->>'state_version')::bigint
        and s.preview_fingerprint=preview->>'preview_fingerprint' and s.superseded_at_utc is null and s.abandoned_at_utc is null;
      if state.import_id is null then raise exception 'WEEKLY_SOURCE_CHECKLIST_QUERY_TARGET_STALE' using errcode='40001'; end if;
      children:='[]'::jsonb; action_bindings:='[]'::jsonb; native_actions:='{}'::text[]; first_seen:=null; group_filter_keys:='[]'::jsonb;
      for native_issue in select value from jsonb_array_elements(case when raw->>'item_kind'='SOURCE_INFORMATION' then
        jsonb_build_array(jsonb_build_object('action_id',raw->'action_id','action_kind',raw->'action_kind',
          'evidence_fingerprint',raw->'evidence_fingerprint','reason_code',raw->'native_reason_code','summary',raw->'summary'))
        else coalesce(raw->'native_issues','[]'::jsonb) end) order by value->>'action_id'
      loop
        -- Action IDs are the native decision PK. Reprove current import/preview,
        -- actual subject and evidence; no lookup by a display name or guessed TS.
        select d.* into latest_decision from public.import_review_decisions d
          where d.action_id=native_issue->>'action_id' and d.import_id=state.import_id
            and d.preview_generation=state.preview_generation and d.client_id=p_client_id and d.is_current
            and d.evidence_fingerprint=native_issue->>'evidence_fingerprint'
            and d.action_kind=native_issue->>'action_kind'
            and ((raw->>'item_kind'='SOURCE_INFORMATION' and d.timesheet_id is null
              and d.hr_row_id=(raw->>'hr_row_id')::uuid and d.action_kind='ADVISORY'
              and d.summary_json->>'authority_mode'='VALIDATION_ONLY')
              or (raw->>'item_kind'='ACTUAL_TIMESHEET' and d.timesheet_id=(raw->>'timesheet_id')::uuid
                and d.action_kind in('EMAIL_ISSUE','EMAIL_REMINDER')));
        if latest_decision.action_id is null then raise exception 'WEEKLY_SOURCE_CHECKLIST_QUERY_TARGET_STALE' using errcode='40001'; end if;
        if latest_decision.action_id=any(native_actions) then
          raise exception 'WEEKLY_SOURCE_CHECK_ONLY_NATIVE_GROUP_ACTION_AMBIGUOUS' using errcode='55000';
        end if;
        native_actions:=array_append(native_actions,latest_decision.action_id);
        child_binding:=jsonb_build_object('owner','public.import_review_actions_page_v1','actor_user_id',actor.id,
          'scope',scope,'import_id',state.import_id,'preview_generation',state.preview_generation,'state_version',state.state_version,
          'preview_fingerprint',state.preview_fingerprint,'action_id',latest_decision.action_id,
          'action_kind',latest_decision.action_kind,'evidence_fingerprint',latest_decision.evidence_fingerprint);
        action_bindings:=action_bindings||jsonb_build_array(child_binding);
        native_summary:=latest_decision.summary_json;
        child_filter_keys:=private.weekly_source_check_only_issue_filter_keys_v1(latest_decision.action_kind,native_summary);
        select coalesce(jsonb_agg(key order by key),'[]'::jsonb) into group_filter_keys
          from(select distinct key from jsonb_array_elements_text(group_filter_keys||child_filter_keys) key) native_keys;
        native_status:=case when jsonb_typeof(native_summary->'status')='object' then native_summary->'status'
          else jsonb_build_object('text',coalesce(nullif(native_summary->>'outcome_label',''),
            nullif(native_summary->>'reason_code',''),latest_decision.action_kind),'tone','muted') end;
        first_seen:=least(first_seen,latest_decision.created_at_utc);
        child:=jsonb_build_object('row_key',latest_decision.action_id,'origin','CHECK_ONLY_D10',
          'day_date',to_char((raw->>'work_date')::date,'Dy FMDD Mon YYYY'),
          'job_role',coalesce(native_summary#>>'{imported_evidence,role}',''),
          'candidate_hours',coalesce(native_summary#>>'{current_evidence,worked_hours}',''),
          'system_hours',coalesce(native_summary#>>'{imported_evidence,worked_hours}',''),
          'issue',coalesce(native_summary->>'outcome_label',native_summary->>'reason_code',latest_decision.action_kind),
          'issue_filter_keys',child_filter_keys,
          'status',native_status,'incident_id',null,'accept_eligible',false,'actions','[]'::jsonb,
          'native_action_binding',child_binding,
          'delivery',case when raw->>'item_kind'='ACTUAL_TIMESHEET' then jsonb_build_object(
            'sent_verified',native_issue->'sent_verified','last_sent_at',native_issue->'last_sent_at',
            'sent_count',native_issue->'sent_count','issue_id',native_issue->'issue_id','issue_fingerprint',native_issue->'issue_fingerprint') end);
        children:=children||jsonb_build_array(child);
      end loop;
      if jsonb_array_length(children)=0 then continue; end if;
      actual_item_id:=raw->>'item_id';
      -- This owner creates the new native parent once from authentic identities.
      -- Consumers receive the literal key and proof; they never re-hash a child
      -- or infer a parent from candidate/client text. Preview/CAS changes make an
      -- old exact target stale, even when the physical Timesheet is unchanged.
      parent_identity:=jsonb_build_object('scope',scope,'item_id',actual_item_id,'preview',preview,'actions',action_bindings);
      -- Strip actor only from the ordered native action frames, preserving one
      -- stable parent across authorised Admin readers. Permission is in binding.
      parent_identity:=jsonb_set(parent_identity,'{actions}',(select jsonb_agg(a.value-'actor_user_id' order by a.ordinality)
        from jsonb_array_elements(action_bindings) with ordinality a(value,ordinality)),false);
      parent_key:='d10g_'||encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECK_ONLY_QUERY_PARENT_V1',parent_identity),'hex');
      parent_proof:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECK_ONLY_QUERY_PARENT_PROOF_V1',
        jsonb_build_object('owner_identity',parent_identity,'actor',actor.id,'authority',authority,'children',children)),'hex');
      -- Deliberate navigation delegates the complete existing native D10
      -- selection/APPLY/committed-email owner. A GET never invokes that owner.
      -- This descriptor grants no send, selection, Source outreach or Reminder.
      review_action:=jsonb_build_object('label','View details','kind','CHECK_ONLY_D10_REVIEW','enabled',true,
        'payload',jsonb_build_object('contract','WEEKLY_SOURCE_CHECK_ONLY_D10_REVIEW_ACTION_V1',
          'actor_user_id',actor.id,'permission_view',view,'scope',scope,'parent_group_key',parent_key,
          'item_id',actual_item_id,'proof_hash',parent_proof,'action_bindings',action_bindings),
        'context',jsonb_build_object('candidate',raw->'worker','client',raw->'client'));
      reminder_action:=null;
      if raw->>'item_kind'='SOURCE_INFORMATION' and raw->>'native_reason_code' in('DAILY_TIMESHEET_NOT_SUBMITTED','WEEKLY_TIMESHEET_NOT_SUBMITTED') then
        reminder_facts:=private.weekly_source_check_only_candidate_reminder_context_v1(actor.id,scope,raw->>'action_id');
        if reminder_facts->'available'='true'::jsonb then
          reminder_action:=jsonb_build_object('label','Remind candidate','kind','CHECK_ONLY_D10_CANDIDATE_REMINDER','enabled',true,
            'payload',jsonb_build_object('contract','WEEKLY_SOURCE_CHECK_ONLY_D10_CANDIDATE_REMINDER_ACTION_V1',
              'actor_user_id',actor.id,'permission_view',view,'scope',scope,'parent_group_key',parent_key,
              'parent_proof_hash',parent_proof,'action_id',raw->>'action_id','candidate_context_hash',reminder_facts->>'context_hash'),
            'context',jsonb_build_object('candidate',raw->'worker','client',raw->'client'));
        end if;
      end if;
      group_row:=jsonb_build_object('row_key',parent_key,'group_key',parent_key,'origin','CHECK_ONLY_D10',
        'client_id',p_client_id,'candidate_id',raw->'candidate_id','candidate_sort',private.weekly_source_query_ascii_fold_v1(raw->>'worker'),
        'candidate',raw->'worker','client',raw->'client','issues',jsonb_array_length(children),'issue_filter_keys',group_filter_keys,
        'candidate_asked',null,'manager_informed',null,'status',jsonb_build_object('text','HealthRoster comparison','tone','muted'),
        'age',case when first_seen is null then '—' when transaction_timestamp()-first_seen<interval '1 hour' then 'Less than 1 hour'
          when transaction_timestamp()-first_seen<interval '24 hours' then floor(extract(epoch from (transaction_timestamp()-first_seen))/3600)::integer||' hours'
          else floor(extract(epoch from (transaction_timestamp()-first_seen))/86400)::integer||' days' end,
        'first_seen_at_utc',first_seen,'children',children,'actions',jsonb_build_array(review_action),
        'outreach_eligible',false,'manager_eligible',false,'candidate_app_available',false,
        'source_outreach_eligible',false,'bulk_actions','{}'::jsonb,'proof_hash',parent_proof);
      if exists(select 1 from jsonb_array_elements(groups) g where g->>'group_key'=parent_key) then
        raise exception 'WEEKLY_SOURCE_CHECK_ONLY_NATIVE_GROUP_PARENT_AMBIGUOUS' using errcode='55000';
      end if;
      if reminder_action is not null then group_row:=jsonb_set(group_row,'{actions}',group_row->'actions'||jsonb_build_array(reminder_action),false); end if;
      groups:=groups||jsonb_build_array(group_row);
      targets:=targets||jsonb_build_array(jsonb_build_object('item_id',actual_item_id,'parent_group_key',parent_key,
        'owner','private.weekly_source_check_only_query_groups_v1','actor_user_id',actor.id,'permission_view',view,
        'import_id',state.import_id,'preview_generation',state.preview_generation,'state_version',state.state_version,
        'preview_fingerprint',state.preview_fingerprint,'proof_hash',parent_proof));
    end loop;
  end if;
  select coalesce(jsonb_agg(g.value order by g.value->>'candidate_sort' collate "C",g.value->>'group_key' collate "C"),'[]'::jsonb)
    into groups from jsonb_array_elements(groups) g(value);
  select coalesce(jsonb_agg(t.value order by t.value->>'item_id' collate "C"),'[]'::jsonb)
    into targets from jsonb_array_elements(targets) t(value);
  revision:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECK_ONLY_QUERY_GROUP_READ_V1',
    jsonb_build_object('binding',binding,'source_read_revision',raw_revision,'groups',groups,'item_targets',targets)),'hex');
  return jsonb_build_object('contract','WEEKLY_SOURCE_CHECK_ONLY_QUERY_GROUPS_V1','actor_user_id',actor.id,
    'permission_view',view,'scope',scope,'binding',binding,'read_revision',revision,'source_read_revision',raw_revision,
    'groups',groups,'item_targets',targets,'source_outreach_eligible',false,'bulk_actions','{}'::jsonb);
end;
$function$;

create or replace function private.weekly_source_checklist_native_initial_certificate_core_v1(p_root_authorisation_id uuid,p_native_locks boolean)
returns jsonb language plpgsql security definer
set search_path=pg_catalog,private,public
as $function$
declare
  a public.weekly_source_root_authorisations%rowtype;
  t public.timesheets%rowtype;f public.timesheets_financials%rowtype;
  w private.bpay_next_work%rowtype;r private.bpay_next_work_revision%rowtype;
  p private.bpay_next_publication%rowtype;c public.contracts%rowtype;
  inventory jsonb;basis jsonb;origin jsonb;details jsonb;n integer;epoch bigint;
begin
  if p_native_locks is null then raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_ACCESS_MODE_REQUIRED' using errcode='22023'; end if;
  if p_root_authorisation_id is null then
    raise exception 'BPAY_NEXT_INITIAL_AUTH_ID_REQUIRED' using errcode='22023';end if;
  if p_native_locks then
  select m.owner_epoch into epoch from private.bpay_next_module_control m
    where m.id=1 and m.active_owner='NEXT' for share;
  else
  select m.owner_epoch into epoch from private.bpay_next_module_control m
    where m.id=1 and m.active_owner='NEXT';
  end if;
  if epoch is null then raise exception 'BPAY_NEXT_BINDING_NEXT_REQUIRED' using errcode='55000';end if;
  select x.* into strict a from public.weekly_source_root_authorisations x where x.id=p_root_authorisation_id;
  select x.* into strict t from public.timesheets x where x.timesheet_id=a.root_timesheet_id;
  select x.* into strict c from public.contracts x where x.id=t.contract_id;
  select x.* into strict r from private.bpay_next_work_revision x where x.source_event_id=a.id;
  select x.* into strict w from private.bpay_next_work x where x.id=r.work_id;
  select x.* into strict f from public.timesheets_financials x where x.id=r.financial_snapshot_id;
  select x.* into strict p from private.bpay_next_publication x
    where x.command_id=private.bpay_next_source_command_id_v1(a.id);
  if a.withdrawn_at_utc is not null or a.current_entitlement_head_id is not null
     or exists(select 1 from public.weekly_source_entitlement_heads h where btrim(h.root_family_booking_id)=btrim(t.booking_id))
     or t.is_current is distinct from true or t.authorised_at_server is null
     or t.revoked_at is not null or t.archived_at_utc is not null
     or (a.family_booking_id,a.timesheet_version) is distinct from (t.booking_id,t.version)
     or (w.work_kind,w.candidate_id,w.contract_id,w.original_timesheet_id,w.booking_id,w.week_ending_date,(case when w.current_revision_id is not null and exists(select 1 from private.bpay_next_work_revision cr where cr.id=w.current_revision_id and cr.sealed_at_utc is not null and cr.payment_treatment_approval_revision_id is not null) then private.bpay_next_treatment_approval_revision_v1(w.current_revision_id) else w.current_revision_id end))
       is distinct from ('SOURCE'::text,c.candidate_id,c.id,t.timesheet_id,t.booking_id,t.week_ending_date,r.id)
     or w.approval_state is distinct from 'APPROVED'
     or (r.source_kind,r.source_head_id,r.source_event_id,r.physical_timesheet_id,r.physical_timesheet_version,r.week_ending_date)
       is distinct from ('SOURCE'::text,null::uuid,a.id,t.timesheet_id,t.version,t.week_ending_date)
     or r.approved_at_utc is null or r.sealed_at_utc is null
     or f.is_current is distinct from true or f.is_stale is distinct from false or f.authorised_at_utc is null
     or (f.timesheet_id,f.timesheet_version,f.candidate_id,f.client_id)
       is distinct from (t.timesheet_id,t.version,w.candidate_id,c.client_id)
     or (p.work_id,p.revision_id,p.candidate_id,p.revision_no)
       is distinct from (w.id,r.id,w.candidate_id,r.revision_no)
     or not exists(select 1 from private.bpay_next_command command
       join private.bpay_next_command_member member on member.command_id=command.id and member.candidate_id=w.candidate_id
       where command.id=p.command_id and command.command_kind='POSITION_APPLY'
         and command.module_epoch=epoch and command.status in ('SEALED','COMPLETE')
         and command.sealed_at_utc is not null and command.expected_member_count=1 and member.member_no=1
         -- INITIAL_METADATA_PHASE_V2_BEGIN: no fabricated enrollment/job.
         and ((command.status='SEALED' and command.enrolled_member_count=0
           and p.status='QUEUED' and p.phase='NEW' and p.applied_at_utc is null
           and not exists(select 1 from private.bpay_next_job job where job.command_id=command.id))
          or (command.status='COMPLETE' and command.enrolled_member_count=1
           and p.status='APPLIED' and p.phase='DONE' and p.applied_at_utc is not null
           and (select count(*) from private.bpay_next_job job where job.command_id=command.id)=1
           and exists(select 1 from private.bpay_next_job job
             join private.bpay_next_worker_control ctl on ctl.candidate_id=job.candidate_id
             where job.command_id=command.id and job.candidate_id=w.candidate_id
               and job.job_kind='POSITION_APPLY' and job.command_sequence=command.agency_sequence
               and job.module_epoch=command.module_epoch and job.status='DONE' and job.phase='DONE'
               and job.owner_epoch>0 and job.owner_epoch<=ctl.active_owner_epoch
               and job.lease_nonce is null and job.lease_until_utc is null)))
         -- INITIAL_METADATA_PHASE_V2_END
       )
  then raise exception 'BPAY_NEXT_INITIAL_AUTH_NOT_CURRENT' using errcode='55000';end if;
  inventory:=private.weekly_source_effective_inventory_v1(t.timesheet_id);
  basis:=inventory->'approval_basis';origin:=basis->'origin';
  details:=jsonb_build_object('segments',f.invoice_breakdown_json->'segments','additional_units',f.additional_units_json,
    'actual_schedule',f.actual_schedule_json,'rate_source_refs',f.rate_source_refs_json);
  if inventory->>'ok' is distinct from 'true' or inventory->>'authority' is distinct from 'TSFIN'
     or inventory->>'head_id' is not null or jsonb_typeof(inventory->'components') is distinct from 'array'
     or jsonb_typeof(basis) is distinct from 'object' or basis->'coverage_complete' is distinct from 'true'::jsonb
     or basis is distinct from private.weekly_source_inventory_approval_basis_v2(t.timesheet_id,inventory)
     or origin is distinct from jsonb_build_object('kind','INITIAL_AUTHORISED_TSFIN_V1',
       'root_authorisation_id',a.id,'financial_snapshot_id',f.id,'authorisation_generation',a.authorisation_generation,
       'root_timesheet_id',t.timesheet_id,'root_version',t.version::text,'authorised_row_signature',a.authorised_row_signature,
       'financial_snapshot_digest',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_APPROVED_FINANCIAL_SNAPSHOT_V2',
         jsonb_build_object('policy',f.policy_snapshot_json,'details',details,'components',inventory->'components')),'hex'),
       'inventory_digest',basis->>'inventory_digest','entitlement_digest',basis->>'entitlement_digest')
     or basis->>'detail_digest' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_APPROVED_DETAIL_V2',details),'hex')
     or basis->>'policy_fingerprint' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_APPROVED_POLICY_V2',f.policy_snapshot_json),'hex')
     or r.source_inventory_digest is distinct from decode(basis->>'inventory_digest','hex')
     or r.approved_source_ex_vat is distinct from (basis->>'approved_pay_ex_vat')::numeric
     or r.expected_line_count is distinct from jsonb_array_length(inventory->'components')
  then raise exception 'BPAY_NEXT_INITIAL_I1_CERTIFICATE_REQUIRED' using errcode='55000';end if;
  select count(*) into n from private.bpay_next_approved_line l where l.revision_id=r.id;
  if n<>r.expected_line_count or exists(select 1 from jsonb_array_elements(inventory->'components') component
      left join private.bpay_next_approved_line l on l.revision_id=r.id
        and l.source_component_id=(component.value->>'component_id')::uuid
        and l.component_key='SOURCE:'||(component.value->>'component_id')
      where l.id is null or l.line_no is distinct from (component.value->>'component_ordinal')::integer
        or l.evidence_ref is distinct from 'source-component:'||(component.value->>'component_id')||'#'||(component.value->>'component_sha256')
        or l.source_pay_ex_vat is distinct from case when (component.value->>'exclude_from_pay')::boolean then 0 else (component.value->>'pay_ex_vat')::numeric end
        or l.component_kind is distinct from case component.value->>'component_kind' when 'WORKED_TIME' then 'WORK' when 'ADDITIONAL_UNIT' then 'ADDITIONAL' else 'EXPENSE' end
        or l.tax_treatment is distinct from case when component.value->>'component_kind' in ('WORKED_TIME','ADDITIONAL_UNIT') then 'TAXABLE'::text
          when component.value->>'component_kind' in ('EXPENSE','SOURCE_FIXED_EXPENSE') then 'NON_TAXABLE'::text else null::text end)
  then raise exception 'BPAY_NEXT_INITIAL_SEALED_COMPONENTS_MISMATCH' using errcode='23514';end if;
  return jsonb_build_object('candidate_id',w.candidate_id,'work_id',w.id,'revision_id',r.id,'command_id',p.command_id,
    'source_channel',r.source_pay_channel,'origin',origin,'basis',basis,'components',inventory->'components',
    'certificate_digest',encode(private.weekly_source_sha256_jsonb_v1('BPAY_NEXT_INITIAL_TSFIN_CERTIFICATE_V1',basis),'hex'));
end
$function$;

create or replace function private.weekly_source_checklist_native_initial_bound_assert_core_v1(p_binding_version_id uuid,p_native_locks boolean)
returns void language plpgsql security definer set search_path=pg_catalog,private,public
as $function$
declare v private.bpay_next_source_component_binding_version%rowtype;l private.bpay_next_approved_line%rowtype;
  cert jsonb;origin jsonb;basis jsonb;component jsonb;
begin
  if p_native_locks is null then raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_ACCESS_MODE_REQUIRED' using errcode='22023'; end if;
  select x.* into strict v from private.bpay_next_source_component_binding_version x where x.id=p_binding_version_id;
  if v.origin_kind is distinct from 'INITIAL_AUTHORISED_TSFIN_V1' then
    raise exception 'BPAY_NEXT_INITIAL_ORIGIN_REQUIRED' using errcode='23514';end if;
  cert:=private.weekly_source_checklist_native_initial_certificate_core_v1(v.initial_root_authorisation_id,p_native_locks);origin:=cert->'origin';basis:=cert->'basis';
  select value into strict component from jsonb_array_elements(cert->'components') x(value)
    where (value->>'component_id')::uuid=v.source_component_id;
  select x.* into strict l from private.bpay_next_approved_line x
    where x.revision_id=(cert->>'revision_id')::uuid and x.source_component_id=v.source_component_id;
  if (v.candidate_id,v.canonical_work_id,v.approval_work_id,v.approval_revision_id,v.publication_command_id_1,
      v.initial_financial_snapshot_id,v.initial_root_timesheet_id,v.initial_root_version,v.initial_authorisation_generation,
      v.initial_authorised_row_signature,v.initial_financial_snapshot_digest,v.initial_inventory_digest,v.initial_entitlement_digest,
      v.initial_detail_digest,v.initial_policy_digest,v.initial_certificate_digest,v.component_sha256)
    is distinct from ((cert->>'candidate_id')::uuid,(cert->>'work_id')::uuid,(cert->>'work_id')::uuid,(cert->>'revision_id')::uuid,
      (cert->>'command_id')::uuid,(origin->>'financial_snapshot_id')::uuid,(origin->>'root_timesheet_id')::uuid,
      (origin->>'root_version')::integer,(origin->>'authorisation_generation')::integer,origin->>'authorised_row_signature',
      decode(origin->>'financial_snapshot_digest','hex'),decode(basis->>'inventory_digest','hex'),decode(basis->>'entitlement_digest','hex'),
      decode(basis->>'detail_digest','hex'),decode(basis->>'policy_fingerprint','hex'),decode(cert->>'certificate_digest','hex'),
      decode(component->>'component_sha256','hex'))
     or (v.approved_line_id,v.classification_line_id,v.canonical_component_key,v.approval_component_key,
         v.approval_source_channel,v.tax_treatment,v.publication_work_id_1,v.publication_revision_id_1)
       is distinct from (l.id,l.id,l.component_key,l.component_key,cert->>'source_channel',l.tax_treatment,
         (cert->>'work_id')::uuid,(cert->>'revision_id')::uuid)
     or v.binding_digest is distinct from sha256(convert_to(jsonb_build_array('INITIAL_AUTHORISED_TSFIN_V1',v.canonical_work_id,
       v.canonical_component_key,v.approval_revision_id,v.approved_line_id,v.initial_root_authorisation_id,
       cert->>'certificate_digest',cert->>'command_id',component->>'component_sha256')::text,'UTF8'))
  then raise exception 'BPAY_NEXT_INITIAL_CAPTURE_CERTIFICATE_CHANGED' using errcode='23514';end if;
end
$function$;

create or replace function private.weekly_source_checklist_native_bound_snapshot_core_v1(p_binding_version_id uuid,p_expected_book_revision bigint,p_native_locks boolean)
returns table(qualification_state text,selection_state text,candidate_id uuid,
  canonical_work_id uuid,canonical_component_key text,binding_version_id uuid,source_book_revision bigint,
  approval_work_id uuid,approval_revision_id uuid,approved_line_id uuid,head_id uuid,source_receipt_id uuid,
  source_channel text,tax_treatment text,classification_line_id uuid,valuation_policy_id uuid,
  approved_source_ex_vat private.bpay_next_penny_amount,
  native_realised_paye private.bpay_next_penny_amount,native_realised_umbrella private.bpay_next_penny_amount,
  native_held_paye private.bpay_next_penny_amount,native_held_umbrella private.bpay_next_penny_amount)
language plpgsql security definer
set search_path=pg_catalog,private,public
as $function$
declare v_version private.bpay_next_source_component_binding_version%rowtype;
  v_binding private.bpay_next_source_component_binding%rowtype;
  v_position private.bpay_next_position%rowtype;v_line private.bpay_next_approved_line%rowtype;
  v_revision private.bpay_next_work_revision%rowtype;v_count integer;
begin
  if p_native_locks is null then raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_ACCESS_MODE_REQUIRED' using errcode='22023'; end if;
  if p_binding_version_id is null or p_expected_book_revision is null or p_expected_book_revision<1 then
    raise exception using errcode='22023',message='BPAY_NEXT_BOUND_SNAPSHOT_ID_REQUIRED';end if;
  if p_native_locks then
  perform 1 from private.bpay_next_module_control c where c.id=1 and c.active_owner='NEXT' for share;
  else
  perform 1 from private.bpay_next_module_control c where c.id=1 and c.active_owner='NEXT';
  end if;
  if not found then raise exception using errcode='55000',message='BPAY_NEXT_BINDING_NEXT_REQUIRED';end if;
  select v.* into strict v_version from private.bpay_next_source_component_binding_version v where v.id=p_binding_version_id;
  if p_native_locks then
  perform 1 from private.bpay_next_worker_control c where c.candidate_id=v_version.candidate_id for share;
  else
  perform 1 from private.bpay_next_worker_control c where c.candidate_id=v_version.candidate_id;
  end if;
  if not found then raise exception using errcode='55000',message='BPAY_NEXT_SOURCE_BOOK_CONTROL_REQUIRED';end if;
  if p_native_locks then
  select b.* into strict v_binding from private.bpay_next_source_component_binding b
    where b.canonical_work_id=v_version.canonical_work_id and b.canonical_component_key=v_version.canonical_component_key for share;
  else
  select b.* into strict v_binding from private.bpay_next_source_component_binding b
    where b.canonical_work_id=v_version.canonical_work_id and b.canonical_component_key=v_version.canonical_component_key;
  end if;
  if v_binding.current_binding_version_id is distinct from p_binding_version_id then
    qualification_state:='SUPERSEDED';return next;return;end if;
  if v_version.origin_kind='INITIAL_AUTHORISED_TSFIN_V1' then
    perform private.weekly_source_checklist_native_initial_bound_assert_core_v1(v_version.id,p_native_locks);
  else
  if not exists(select 1 from public.weekly_source_entitlement_decision_bundles b
    where b.decision_bundle_id=v_version.decision_bundle_id and b.bundle_revision=v_version.bundle_revision
      and b.state='COMMITTED') then
    qualification_state:='BUNDLE_PENDING';return next;return;end if;
  end if;
  if p_native_locks then
  select p.* into v_position from private.bpay_next_position p
    where p.work_id=v_version.canonical_work_id and p.component_key=v_version.canonical_component_key for share;
  else
  select p.* into v_position from private.bpay_next_position p
    where p.work_id=v_version.canonical_work_id and p.component_key=v_version.canonical_component_key;
  end if;
  if not found then qualification_state:='POSITION_PENDING';return next;return;end if;
  -- Retain actual Position applicability during the native apply interval:
  -- Work.applied may still be the predecessor while this Position is new.
  if not exists(select 1 from private.bpay_next_work w where w.id=v_position.work_id
    and (v_position.applied_revision_id=w.current_revision_id or v_position.applied_revision_id=w.applied_revision_id)) then
    qualification_state:='POSITION_PENDING';return next;return;end if;
  if v_version.origin_kind='INITIAL_AUTHORISED_TSFIN_V1' then
    select pg_catalog.count(*) into v_count from private.bpay_next_publication p
      join private.bpay_next_work w on w.id=p.work_id
      join private.bpay_next_command c on c.id=p.command_id
      join private.bpay_next_command_member m on m.command_id=c.id and m.candidate_id=w.candidate_id
      join private.bpay_next_job j on j.command_id=c.id and j.candidate_id=w.candidate_id and j.job_kind='POSITION_APPLY'
      join private.bpay_next_worker_control ctl on ctl.candidate_id=w.candidate_id
      join private.bpay_next_module_control module on module.id=1 and module.active_owner='NEXT'
      where p.command_id=v_version.publication_command_id_1 and p.work_id=v_version.approval_work_id
        and p.revision_id=v_version.approval_revision_id and p.candidate_id=v_version.candidate_id
        and p.status='APPLIED' and p.phase='DONE' and p.applied_at_utc is not null
        and (case when w.current_revision_id is not null and exists(select 1 from private.bpay_next_work_revision cr where cr.id=w.current_revision_id and cr.sealed_at_utc is not null and cr.payment_treatment_approval_revision_id is not null) then private.bpay_next_treatment_approval_revision_v1(w.current_revision_id) else w.current_revision_id end)=p.revision_id and (case when w.applied_revision_id is not null and exists(select 1 from private.bpay_next_work_revision apr where apr.id=w.applied_revision_id and apr.sealed_at_utc is not null and apr.payment_treatment_approval_revision_id is not null) then private.bpay_next_treatment_approval_revision_v1(w.applied_revision_id) else w.applied_revision_id end)=p.revision_id
        and c.id=private.bpay_next_source_command_id_v1(v_version.initial_root_authorisation_id)
        and c.command_kind='POSITION_APPLY' and c.status='COMPLETE' and c.module_epoch=module.owner_epoch
        and c.expected_member_count=1 and c.enrolled_member_count=1 and c.sealed_at_utc is not null
        and j.status='DONE' and j.phase='DONE' and j.module_epoch=c.module_epoch
        and j.command_sequence=c.agency_sequence and j.owner_epoch>0 and j.owner_epoch<=ctl.active_owner_epoch
        and j.lease_nonce is null and j.lease_until_utc is null
        and (case when v_position.applied_revision_id is not null and exists(select 1 from private.bpay_next_work_revision pr where pr.id=v_position.applied_revision_id and pr.sealed_at_utc is not null and pr.payment_treatment_approval_revision_id is not null) then private.bpay_next_treatment_approval_revision_v1(v_position.applied_revision_id) else v_position.applied_revision_id end)=p.revision_id;
  else
  select pg_catalog.count(*) into v_count from private.bpay_next_source_binding_members_v1(v_version.source_receipt_id) m
    join private.bpay_next_publication p on p.command_id=m.publication_command_id
    join private.bpay_next_work w on w.id=m.work_id
    where p.status='APPLIED' and p.phase='DONE' and p.applied_at_utc is not null
      and (case when w.current_revision_id is not null and exists(select 1 from private.bpay_next_work_revision cr where cr.id=w.current_revision_id and cr.sealed_at_utc is not null and cr.payment_treatment_approval_revision_id is not null) then private.bpay_next_treatment_approval_revision_v1(w.current_revision_id) else w.current_revision_id end)=m.revision_id and (case when w.applied_revision_id is not null and exists(select 1 from private.bpay_next_work_revision apr where apr.id=w.applied_revision_id and apr.sealed_at_utc is not null and apr.payment_treatment_approval_revision_id is not null) then private.bpay_next_treatment_approval_revision_v1(w.applied_revision_id) else w.applied_revision_id end)=m.revision_id
      and ((m.publication_command_id=v_version.publication_command_id_1
            and m.work_id=v_version.publication_work_id_1 and m.revision_id=v_version.publication_revision_id_1)
        or (m.publication_command_id=v_version.publication_command_id_2
            and m.work_id=v_version.publication_work_id_2 and m.revision_id=v_version.publication_revision_id_2));
  end if;
  if v_count is distinct from (case when v_version.publication_command_id_2 is null then 1 else 2 end) then
    qualification_state:='PUBLICATION_PENDING';return next;return;end if;
  if v_position.source_book_state is distinct from 'READY' then qualification_state:='BOOK_UNBOUND';return next;return;end if;
  if v_position.source_book_revision is distinct from p_expected_book_revision then
    qualification_state:='BOOK_REVISION_STALE';return next;return;end if;
  if v_position.source_basis_channel is distinct from v_position.source_book_seed_channel
     or (v_position.source_book_seed_channel='PAYE' and
       (v_position.native_realised_paye is distinct from v_position.realised_source_ex_vat
        or v_position.native_held_paye is distinct from v_position.held_source_ex_vat))
     or (v_position.source_book_seed_channel='UMBRELLA' and
       (v_position.native_realised_umbrella is distinct from v_position.realised_source_ex_vat
        or v_position.native_held_umbrella is distinct from v_position.held_source_ex_vat)) then
    qualification_state:='BOOK_POSTING_REQUIRED';return next;return;end if;
  if v_version.tax_treatment is null or v_version.classification_line_id is null then
    qualification_state:='CLASSIFICATION_UNBOUND';return next;return;end if;
  select r.* into strict v_revision from private.bpay_next_work_revision r where r.id=v_version.approval_revision_id;
  if v_version.component_state='PRESENT' then
    select l.* into strict v_line from private.bpay_next_approved_line l where l.id=v_version.approved_line_id;
    approved_source_ex_vat:=v_line.source_pay_ex_vat;
  else
    if exists(select 1 from private.bpay_next_approved_line l
      where l.revision_id=v_version.approval_revision_id and l.component_key=v_version.approval_component_key) then
      raise exception using errcode='23514',message='BPAY_NEXT_BINDING_REMOVAL_LINE_CONFLICT';end if;
    approved_source_ex_vat:=0;
  end if;
  candidate_id:=v_version.candidate_id;canonical_work_id:=v_version.canonical_work_id;
  canonical_component_key:=v_version.canonical_component_key;binding_version_id:=v_version.id;
  source_book_revision:=v_position.source_book_revision;approval_work_id:=v_version.approval_work_id;
  approval_revision_id:=v_version.approval_revision_id;approved_line_id:=v_version.approved_line_id;
  head_id:=v_version.head_id;source_receipt_id:=v_version.source_receipt_id;source_channel:=v_version.approval_source_channel;
  tax_treatment:=v_version.tax_treatment;classification_line_id:=v_version.classification_line_id;
  valuation_policy_id:=v_revision.valuation_policy_id;
  native_realised_paye:=v_position.native_realised_paye;native_realised_umbrella:=v_position.native_realised_umbrella;
  native_held_paye:=v_position.native_held_paye;native_held_umbrella:=v_position.native_held_umbrella;
  selection_state:='UNBOUND';qualification_state:='READY';return next;
end
$function$;

create or replace function private.weekly_source_checklist_native_members_core_v1(p_work_id uuid,p_revision_id uuid,p_native_locks boolean)
returns table(component_key text,approved_line_id uuid,approved_segment_id uuid,segment_key text,
  component_kind text,tax_treatment text,work_date date,approved_quantity numeric,unit_label text,
  approved_amount numeric,realised_amount numeric,held_amount numeric,source_pay_channel text,
  parent_complete boolean,segment_attribution_complete boolean)
language plpgsql security definer set search_path=pg_catalog,private
as $function$
declare v_revision private.bpay_next_work_revision%rowtype;v_approval uuid;v_event uuid;
begin
  if p_native_locks is null then raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_ACCESS_MODE_REQUIRED' using errcode='22023'; end if;
  perform private.bpay_next_workbench_require_next_v1();
  select x.* into v_revision from private.bpay_next_work_revision x where x.id=p_revision_id and x.work_id=p_work_id;
  v_approval:=p_revision_id;v_event:=v_revision.source_event_id;
  if v_revision.payment_treatment_approval_revision_id is not null and v_revision.sealed_at_utc is not null then
    v_approval:=private.bpay_next_treatment_approval_revision_v1(v_revision.id);
    select x.source_event_id into v_event from private.bpay_next_work_revision x where x.id=v_approval and x.work_id=p_work_id;
  end if;
  return query
  with source_books as materialized (
    select p.component_key,book.qualification_state,book.approval_revision_id,book.approved_line_id,
      book.source_channel,book.approved_source_ex_vat,book.native_realised_paye,book.native_realised_umbrella,
      book.native_held_paye,book.native_held_umbrella
    from private.bpay_next_work w join private.bpay_next_work_revision r on r.id=p_revision_id and r.work_id=w.id
    join private.bpay_next_position p on p.work_id=w.id and p.source_book_state='READY' and p.source_book_revision>0
    left join private.bpay_next_approved_line a on a.revision_id=r.id and a.component_key=p.component_key
    join private.bpay_next_source_component_binding b on b.canonical_work_id=w.id and b.canonical_component_key=p.component_key
    join private.bpay_next_source_component_binding_version v on v.id=b.current_binding_version_id
      and v.approval_work_id=w.id and v.approval_revision_id=v_approval and v.approval_component_key=p.component_key
    left join private.bpay_next_approved_line original_class on original_class.id=coalesce(v.classification_line_id,b.canonical_line_id)
    cross join lateral private.weekly_source_checklist_native_bound_snapshot_core_v1(v.id,p.source_book_revision,p_native_locks) book
    where w.id=p_work_id and w.work_kind='SOURCE' and coalesce(a.component_kind,original_class.component_kind)='WORK' and (r.source_head_id is not null
      or (r.source_kind='SOURCE' and v_event is not null and r.financial_snapshot_id is not null))
  ), keys as (
    select a.component_key from private.bpay_next_approved_line a where a.revision_id=p_revision_id
    union select p.component_key from private.bpay_next_position p where p.work_id=p_work_id
  ), parents as (
    select k.component_key,a.id line_id,coalesce(a.component_kind,original_class.component_kind) component_kind,
      case when a.id is not null then a.tax_treatment else original_class.tax_treatment end tax_treatment,
      case when a.id is not null then a.work_date else original_class.work_date end work_date,a.approved_quantity,a.unit_label,
      p.approved_source_ex_vat a,p.realised_source_ex_vat c,p.held_source_ex_vat h,p.source_basis_channel,
      p.realised_target_ex_vat,p.realised_target_vat,p.realised_target_inc_vat,
      p.held_target_ex_vat,p.held_target_vat,p.held_target_inc_vat,
      (p.work_id is not null and p.applied_revision_id=p_revision_id
        and p.approved_source_ex_vat=coalesce(a.source_pay_ex_vat,0)
        and (a.id is not null or p.approved_source_ex_vat=0)
        and (w.work_kind<>'SOURCE' or a.id is not null or original_class.id is not null)
        and (not (w.work_kind='SOURCE' and coalesce(a.component_kind,original_class.component_kind)='WORK' and (r.source_head_id is not null
          or (r.source_kind='SOURCE' and v_event is not null and r.financial_snapshot_id is not null)))
          or (book.qualification_state='READY' and book.approval_revision_id=v_approval
            and book.approved_line_id is not distinct from aa.id and book.source_channel=r.source_pay_channel
            and (book.approved_source_ex_vat,book.native_realised_paye,book.native_held_paye,book.native_realised_umbrella,book.native_held_umbrella)
              is not distinct from (p.approved_source_ex_vat,
                case when r.source_pay_channel='PAYE' then p.realised_source_ex_vat else 0::numeric end,
                case when r.source_pay_channel='PAYE' then p.held_source_ex_vat else 0::numeric end,
                case when r.source_pay_channel='UMBRELLA' then p.realised_source_ex_vat else 0::numeric end,
                case when r.source_pay_channel='UMBRELLA' then p.held_source_ex_vat else 0::numeric end)))) complete,
      (exists(select 1 from private.bpay_next_approved_segment s where s.revision_id=p_revision_id and s.component_key=k.component_key)
        or exists(select 1 from private.bpay_next_work_segment_origin_share s where s.work_id=p_work_id and s.component_key=k.component_key)) segmented
    from keys k left join private.bpay_next_approved_line a on a.revision_id=p_revision_id and a.component_key=k.component_key
    left join private.bpay_next_approved_line aa on aa.revision_id=v_approval and aa.component_key=k.component_key
    left join private.bpay_next_position p on p.work_id=p_work_id and p.component_key=k.component_key
    join private.bpay_next_work w on w.id=p_work_id
    left join private.bpay_next_work_revision r on r.id=p_revision_id and r.work_id=w.id
    left join private.bpay_next_source_component_binding binding on binding.canonical_work_id=w.id and binding.canonical_component_key=k.component_key
    left join private.bpay_next_source_component_binding_version version on version.id=binding.current_binding_version_id
    left join private.bpay_next_approved_line original_class on original_class.id=coalesce(version.classification_line_id,binding.canonical_line_id)
    left join source_books book on book.component_key=k.component_key
  ), segment_keys as (
    select s.component_key,s.segment_key from private.bpay_next_approved_segment s where s.revision_id=p_revision_id
    union select s.component_key,s.segment_key from private.bpay_next_work_segment_origin_share s where s.work_id=p_work_id
  ), members as (
    select p.*,s.segment_key,seg.id segment_id,seg.work_date segment_date,seg.approved_hours,
      coalesce(seg.approved_source_ex_vat,0) segment_a,b.realised_source_ex_vat segment_c,b.active_held_source_ex_vat segment_h
    from parents p join segment_keys s on s.component_key=p.component_key
    left join private.bpay_next_approved_segment seg on seg.revision_id=p_revision_id
      and seg.component_key=s.component_key and seg.segment_key=s.segment_key
    cross join lateral private.bpay_next_work_segment_gross_balance_v1(p_work_id,s.component_key,s.segment_key) b
  ), totals as (
    select m.component_key,sum(m.segment_a) a,sum(m.segment_c) c,sum(m.segment_h) h from members m group by m.component_key
  ), target_credit as (
    select e.component_key,sum(e.target_ex_vat) ex,sum(e.target_vat) vat,sum(e.target_inc_vat) inc
    from private.bpay_next_work_segment_effect_share e where e.work_id=p_work_id group by e.component_key
  ), target_hold as (
    select s.component_key,sum(s.target_reserved_ex_vat) ex,sum(s.target_reserved_vat) vat,sum(s.target_reserved_inc_vat) inc
    from private.bpay_next_work_segment_origin_share s join private.bpay_next_hold h on h.id=s.hold_id and h.status='ACTIVE'
    where s.work_id=p_work_id group by s.component_key
  )
  select m.component_key,m.line_id,m.segment_id,m.segment_key,m.component_kind,m.tax_treatment,
    m.segment_date,m.approved_hours,'hours'::text,m.segment_a,m.segment_c,m.segment_h,m.source_basis_channel,
    coalesce(m.complete,false),
    ((t.a,t.c,t.h,coalesce(c.ex,0),coalesce(c.vat,0),coalesce(c.inc,0),coalesce(h.ex,0),coalesce(h.vat,0),coalesce(h.inc,0))
      is not distinct from (m.a,m.c,m.h,m.realised_target_ex_vat,m.realised_target_vat,m.realised_target_inc_vat,
        m.held_target_ex_vat,m.held_target_vat,m.held_target_inc_vat))
    from members m join totals t on t.component_key=m.component_key
      left join target_credit c on c.component_key=m.component_key left join target_hold h on h.component_key=m.component_key
  union all
  select p.component_key,p.line_id,null::uuid,null::text,p.component_kind,p.tax_treatment,p.work_date,
    p.approved_quantity,p.unit_label,p.a,p.c,p.h,p.source_basis_channel,coalesce(p.complete,false),true
    from parents p where not p.segmented;
end
$function$;

create or replace function private.weekly_source_invoice_hold_release_context_core_v1(p_request jsonb,p_native_locks boolean)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $release_context$
declare actor uuid; row_id uuid; expected_hash bytea; expected_version bigint; kind text; choice text;
  s public.weekly_source_upload_rows%rowtype; u public.weekly_source_uploads%rowtype; c public.weekly_source_cycles%rowtype;
  g public.weekly_source_groups%rowtype; scope_row public.weekly_source_report_scopes%rowtype; rules jsonb; v_client_id uuid; existing public.weekly_source_invoice_hold_releases%rowtype;
  net bigint; vat bigint; gross bigint; h bytea; id uuid;
begin
  if p_native_locks is null then raise exception 'WEEKLY_SOURCE_INVOICE_HOLD_NATIVE_MODE_INVALID' using errcode='55000'; end if;
  perform private._weekly_source_settings_assert_request_v1(p_request,array['actor_user_id','upload_row_id','source_cycle_id','report_scope_id','expected_source_row_hash','expected_authority_scope_version','hold_kind','action'],'WEEKLY_SOURCE_INVOICE_HOLD_REQUEST_INVALID');
  begin actor:=(p_request->>'actor_user_id')::uuid; row_id:=(p_request->>'upload_row_id')::uuid;
    expected_hash:=private.weekly_source_finalisation_hex32_v1(p_request->>'expected_source_row_hash','WEEKLY_SOURCE_INVOICE_HOLD_HASH_INVALID');
    expected_version:=(p_request->>'expected_authority_scope_version')::bigint;
    kind:=p_request->>'hold_kind'; choice:=coalesce(p_request->>'action',case when kind='VAT_FIT' then 'BILL_AT_NET_PLUS_20' else 'BILL_AS_FILE' end);
  exception when others then raise exception 'WEEKLY_SOURCE_INVOICE_HOLD_REQUEST_INVALID' using errcode='22023'; end;
  perform private._weekly_source_settings_require_admin_v1(actor);
  if kind is null or choice is null or kind not in ('VAT_FIT','DUPLICATE_REQUEST_ID') or choice not in ('BILL_AT_NET_PLUS_20','BILL_AS_FILE')
    or (kind='DUPLICATE_REQUEST_ID' and choice<>'BILL_AS_FILE') then raise exception 'WEEKLY_SOURCE_INVOICE_HOLD_CHOICE_INVALID' using errcode='22023'; end if;
  select * into strict s from public.weekly_source_upload_rows where weekly_source_upload_rows.id=row_id;
  select * into strict u from public.weekly_source_uploads where weekly_source_uploads.id=s.upload_id;
  if p_native_locks then
  select * into strict g from public.weekly_source_groups where weekly_source_groups.id=(select source_group_id from public.weekly_source_cycles where weekly_source_cycles.id=u.source_cycle_id) for update;
  else
  select * into strict g from public.weekly_source_groups where weekly_source_groups.id=(select source_group_id from public.weekly_source_cycles where weekly_source_cycles.id=u.source_cycle_id);
  end if;
  if p_native_locks then
  select * into strict c from public.weekly_source_cycles where weekly_source_cycles.id=u.source_cycle_id for update;
  else
  select * into strict c from public.weekly_source_cycles where weekly_source_cycles.id=u.source_cycle_id;
  end if;
  if u.report_scope_id is not null then
    if p_native_locks then
    select * into strict scope_row from public.weekly_source_report_scopes where weekly_source_report_scopes.id=u.report_scope_id for update;
    else
    select * into strict scope_row from public.weekly_source_report_scopes where weekly_source_report_scopes.id=u.report_scope_id;
    end if;
    if scope_row.source_cycle_id<>c.id or scope_row.source_group_id<>g.id or scope_row.current_complete_upload_id is distinct from u.id
      or s.row_finalisation_state<>'SOURCE_REPORT_LINE' then raise exception 'WEEKLY_SOURCE_INVOICE_HOLD_REPORT_SCOPE_INVALID' using errcode='55000'; end if;
  elsif c.current_complete_upload_id is distinct from u.id and u.state<>'CORRECTION_READY' then
    raise exception 'WEEKLY_SOURCE_INVOICE_HOLD_SCOPE_STALE' using errcode='40001'; end if;
  if u.report_scope_id is distinct from nullif(p_request->>'report_scope_id','')::uuid or c.id is distinct from nullif(p_request->>'source_cycle_id','')::uuid or s.normalised_row_hash is distinct from expected_hash
    or coalesce(scope_row.version,c.version) is distinct from expected_version or u.state not in ('CURRENT','CORRECTION_READY') or not g.active or g.source_family<>'ROSTER' then
    raise exception 'WEEKLY_SOURCE_INVOICE_HOLD_SCOPE_STALE' using errcode='40001'; end if;
  perform private._weekly_source_settings_deployment_v1(g.agency_id,g.environment);
  v_client_id:=coalesce(scope_row.client_id,c.scope_client_id,nullif(u.file_metadata_json->>'client_id','')::uuid);
  if v_client_id is null or (nullif(u.file_metadata_json->>'client_id','')::uuid is not null and nullif(u.file_metadata_json->>'client_id','')::uuid<>v_client_id) or (c.scope_client_id is not null and nullif(u.file_metadata_json->>'client_id','')::uuid is distinct from c.scope_client_id) then
    raise exception 'WEEKLY_SOURCE_INVOICE_HOLD_CLIENT_SCOPE_INVALID' using errcode='55000'; end if;
  perform private.weekly_source_office_authority_v1(actor,'FINALISE_WEEK',g.id,v_client_id,c.finalisation_week_ending);
  rules:=private.weekly_source_effective_rule_set_v1(v_client_id,c.id)->'values';
  if rules is null or rules->>'invoice_sender'<>'CLIENT_SELF_BILL' or rules->>'invoice_amount_basis'<>'SOURCE_AMOUNT'
    or s.source_money_parse_state<>'VALID' or s.source_shift_charge_pence is null or s.source_gross_pence is null or s.source_vat_pence is null then
    raise exception 'WEEKLY_SOURCE_INVOICE_HOLD_NOT_ELIGIBLE' using errcode='55000'; end if;
  if kind='VAT_FIT' and (rules->>'source_amount_basis'<>'EXPORT_ACTUAL_COST_INC_VAT_NET_AGENCY_WORKER_PAY'
    or abs(5::numeric*s.source_gross_pence-6::numeric*s.source_shift_charge_pence)<=5) then
    raise exception 'WEEKLY_SOURCE_INVOICE_HOLD_NOT_ELIGIBLE' using errcode='55000'; end if;
  if kind='DUPLICATE_REQUEST_ID' and (u.report_scope_id is null or s.row_finalisation_state<>'SOURCE_REPORT_LINE' or rules->>'self_bill_source' is distinct from 'SEPARATE_FINAL_REPORT' or rules->>'source_amount_basis' is distinct from 'REPORT_LINE_NET') then raise exception 'WEEKLY_SOURCE_INVOICE_DUPLICATE_HOLD_NOT_PROVED' using errcode='55000'; end if;
  if kind='DUPLICATE_REQUEST_ID' and private.weekly_source_self_bill_report_duplicate_prior_v1(s.id) is distinct from true then
    raise exception 'WEEKLY_SOURCE_INVOICE_DUPLICATE_HOLD_NOT_PROVED' using errcode='55000'; end if;
  return jsonb_build_object('actor_user_id',actor,'upload_row_id',row_id,'expected_source_row_hash',encode(expected_hash,'hex'),
    'expected_authority_scope_version',expected_version,'hold_kind',kind,'choice',choice,'row',to_jsonb(s),'upload',to_jsonb(u),
    'group',to_jsonb(g),'cycle',to_jsonb(c),'report_scope',to_jsonb(scope_row),'rules',rules,'client_id',v_client_id);
end;
$release_context$;

create or replace function private.weekly_source_invoice_hold_first_invoice_assert_v1(p_upload_row_id uuid)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $first_invoice$
begin
  if exists(select 1 from public.weekly_source_billing_movements m where
      (m.source_facts_json->>'upload_row_id'=p_upload_row_id::text or m.self_bill_report_row_id=p_upload_row_id)
      and m.movement_role in ('POSITIVE','REPLACEMENT','STANDALONE_NEGATIVE')
      and (m.placement_state<>'UNPLACED' or exists(select 1 from public.weekly_source_invoice_line_bindings b
        where b.billing_movement_id=m.id and b.state='CURRENT')
        or exists(select 1 from public.weekly_source_invoice_placements p join public.invoices i on i.id=p.invoice_id
          where p.billing_movement_id=m.id and i.status::text='ISSUED')))
    or exists(select 1 from public.weekly_source_final_snapshot_lines line join public.weekly_source_final_revisions r on r.id=line.final_revision_id
      where line.upload_row_id=p_upload_row_id and r.state='PREPARED') then
    raise exception 'WEEKLY_SOURCE_INVOICE_HOLD_ALREADY_PLACED' using errcode='55000'; end if;
end;
$first_invoice$;

create or replace function private.weekly_source_invoice_unreleased_vat_fit_movements_v1(p_client_manifest_id uuid)
returns setof public.weekly_source_billing_movements language sql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $native_blocker$
select m.* from public.weekly_source_manifest_movements mm join public.weekly_source_billing_movements m on m.id=mm.billing_movement_id
    where mm.client_manifest_id=p_client_manifest_id and m.source_facts_json->>'invoice_hold'='VAT_FIT'
      and not exists(select 1 from public.weekly_source_invoice_hold_releases receipt where receipt.upload_row_id::text=m.source_facts_json->>'upload_row_id' and receipt.hold_kind='VAT_FIT');
$native_blocker$;

create or replace function private.bpay_next_work_period_proof_v1(
 p_work_id uuid,p_revision_id uuid,p_business_date date
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $native_period$
declare w private.bpay_next_work%rowtype;r private.bpay_next_work_revision%rowtype;
 t public.timesheets%rowtype;c public.contracts%rowtype;s jsonb;weekday integer;
begin
 if p_work_id is null or p_business_date is null or not isfinite(p_business_date) then
  return jsonb_build_object('valid',false,'reason','NATIVE_WORK_PERIOD_UNPROVED');end if;
 select a.* into w from private.bpay_next_work a where a.id=p_work_id;
 if w.id is null or w.week_ending_date is null or not isfinite(w.week_ending_date) then
  return jsonb_build_object('valid',false,'reason','NATIVE_WORK_PERIOD_UNPROVED');end if;
 -- Preserve every pre-existing native Sunday admission and its later native
 -- approval/current/physical/member guards. This helper adds no new approval.
 if extract(isodow from w.week_ending_date)=7 then
  return jsonb_build_object('valid',true,'basis','NATIVE_SUNDAY_PERIOD',
   'work_id',w.id,'revision_id',p_revision_id,'week_ending',w.week_ending_date,
   'period_start',w.week_ending_date-6,'business_date',p_business_date,
   'future',w.week_ending_date-6>p_business_date);end if;
 -- Only a genuine contracted Weekly physical period extends the old native
 -- calendar domain. Daily, missing snapshots, Cases and invented dates do not.
 select a.* into r from private.bpay_next_work_revision a where a.id=p_revision_id and a.work_id=w.id;
 select a.* into t from public.timesheets a where a.timesheet_id=r.physical_timesheet_id;
 select a.* into c from public.contracts a where a.id=w.contract_id;
 s:=t.settings_authority_json;
 if r.id is null or c.id is null or c.client_id is null or c.candidate_id is null
  or t.timesheet_id is null or w.origin_kind is distinct from 'CONTRACT'
  or w.work_kind not in('ORDINARY','SOURCE','EXPENSE')
  or r.source_kind not in('ORDINARY','SOURCE','PROTECTED','EXPENSE')
  or r.week_ending_date is distinct from w.week_ending_date
  or t.week_ending_date is distinct from w.week_ending_date
  or t.sheet_scope::text is distinct from 'WEEKLY' or t.contract_id is distinct from c.id
  or t.booking_id is distinct from w.booking_id or t.version is distinct from r.physical_timesheet_version
  or t.is_current is distinct from true or t.revoked_at is not null or t.archived_at_utc is not null
  or c.candidate_id is distinct from w.candidate_id
  or t.settings_authority_version is distinct from 'CONTRACT_SETTINGS_AUTHORITY_V1'
  or jsonb_typeof(s) is distinct from 'object' or s->>'authority_version' is distinct from 'CONTRACT_SETTINGS_AUTHORITY_V1'
  or s->>'client_id' is distinct from c.client_id::text or s->>'contract_id' is distinct from c.id::text
  or s->>'relevant_date' is distinct from t.week_ending_date::text
  or s->>'workflow' is null or s->>'workflow' not in('WEEKLY','IMPORT')
  or s->>'authority_fingerprint' is distinct from t.settings_authority_fingerprint
  or t.settings_authority_fingerprint is null
  or encode(sha256(convert_to((s-'authority_fingerprint'-'resolved_at_utc')::text,'UTF8')),'hex')
    is distinct from t.settings_authority_fingerprint
  or pg_input_is_valid(s#>>'{values,week_ending_weekday}','integer') is distinct from true
  or (select count(*) from public.timesheets a where a.booking_id=w.booking_id and a.is_current)<>1 then
  return jsonb_build_object('valid',false,'reason','NATIVE_CAPTURED_WORK_PERIOD_UNPROVED');end if;
 weekday:=(s#>>'{values,week_ending_weekday}')::integer;
 if weekday not between 0 and 6 or extract(dow from w.week_ending_date)::integer<>weekday then
  return jsonb_build_object('valid',false,'reason','NATIVE_CAPTURED_WORK_PERIOD_UNPROVED');end if;
 return jsonb_build_object('valid',true,'basis','NATIVE_CAPTURED_CONTRACT_PERIOD',
  'work_id',w.id,'revision_id',r.id,'timesheet_id',t.timesheet_id,'timesheet_version',t.version,
  'contract_id',c.id,'candidate_id',c.candidate_id,'client_id',c.client_id,
  'settings_authority_fingerprint',t.settings_authority_fingerprint,'week_ending_weekday',weekday,
  'week_ending',w.week_ending_date,'period_start',w.week_ending_date-6,
  'business_date',p_business_date,'future',w.week_ending_date-6>p_business_date);
end;
$native_period$;

CREATE OR REPLACE FUNCTION private.weekly_source_checklist_legacy_pay_state_core_v1(p_timesheet_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql STABLE
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_out jsonb;
  v_has_tsfin boolean := false;
  v_today_uk date := (now() AT TIME ZONE 'Europe/London')::date;
BEGIN
  IF p_timesheet_id IS NULL THEN
    RAISE EXCEPTION 'timesheet_pay_state: timesheet_id is required';
  END IF;

  WITH
  tf AS (
    SELECT
      tf.timesheet_id,
      tf.candidate_id,
      ts.booking_id,
      tf.pay_on_hold,
      tf.invoice_breakdown_json,
      ts.sheet_scope,
      ts.reference_number,
      ts.worked_start_iso AS ts_worked_start_iso,
      ts.worked_end_iso AS ts_worked_end_iso,
      ts.break_start_iso AS ts_break_start_iso,
      ts.break_end_iso AS ts_break_end_iso,
      ts.break_minutes AS ts_break_minutes,
      ts.actual_schedule_json AS ts_actual_schedule_json,
      tf.worked_start_iso AS tf_worked_start_iso,
      tf.worked_end_iso AS tf_worked_end_iso,
      tf.break_start_iso AS tf_break_start_iso,
      tf.break_end_iso AS tf_break_end_iso,
      tf.break_minutes AS tf_break_minutes,
      tf.actual_schedule_json AS tf_actual_schedule_json
    FROM public.timesheets_financials tf
    LEFT JOIN public.timesheets ts
      ON ts.timesheet_id = tf.timesheet_id
     AND ts.is_current = true
    WHERE tf.timesheet_id = p_timesheet_id
      AND tf.is_current = true
    LIMIT 1
  ),
  tf_norm AS (
    SELECT
      t.timesheet_id,
      t.candidate_id,
      t.booking_id,
      COALESCE(t.pay_on_hold, false) AS pay_on_hold,
      CASE
        WHEN t.invoice_breakdown_json IS NOT NULL AND jsonb_typeof(t.invoice_breakdown_json) = 'object'
          THEN t.invoice_breakdown_json
        ELSE NULL
      END AS invoice_breakdown_json,
      upper(coalesce(t.sheet_scope::text, '')) AS sheet_scope,
      nullif(btrim(coalesce(t.reference_number, '')), '') AS reference_number,
      coalesce(t.tf_worked_start_iso, t.ts_worked_start_iso) AS effective_worked_start_iso,
      coalesce(t.tf_worked_end_iso, t.ts_worked_end_iso) AS effective_worked_end_iso,
      coalesce(t.tf_break_start_iso, t.ts_break_start_iso) AS effective_break_start_iso,
      coalesce(t.tf_break_end_iso, t.ts_break_end_iso) AS effective_break_end_iso,
      coalesce(t.tf_break_minutes, t.ts_break_minutes) AS effective_break_minutes,
      CASE
        WHEN jsonb_typeof(t.tf_actual_schedule_json) = 'object' THEN t.tf_actual_schedule_json
        WHEN jsonb_typeof(t.tf_actual_schedule_json) = 'array' THEN (
          SELECT tf_sched_item.value
          FROM jsonb_array_elements(t.tf_actual_schedule_json) AS tf_sched_item(value)
          WHERE tf_sched_item.value IS NOT NULL
            AND jsonb_typeof(tf_sched_item.value) = 'object'
          LIMIT 1
        )
        WHEN jsonb_typeof(t.ts_actual_schedule_json) = 'object' THEN t.ts_actual_schedule_json
        WHEN jsonb_typeof(t.ts_actual_schedule_json) = 'array' THEN (
          SELECT ts_sched_item.value
          FROM jsonb_array_elements(t.ts_actual_schedule_json) AS ts_sched_item(value)
          WHERE ts_sched_item.value IS NOT NULL
            AND jsonb_typeof(ts_sched_item.value) = 'object'
          LIMIT 1
        )
        ELSE NULL::jsonb
      END AS effective_daily_schedule_json
    FROM tf t
  ),
  mode_flags AS (
    SELECT
      tn.timesheet_id,
      tn.candidate_id,
      tn.booking_id,
      tn.pay_on_hold,
      tn.invoice_breakdown_json,
      tn.sheet_scope,
      tn.reference_number,
      tn.effective_worked_start_iso,
      tn.effective_worked_end_iso,
      tn.effective_break_start_iso,
      tn.effective_break_end_iso,
      tn.effective_break_minutes,
      tn.effective_daily_schedule_json,
      CASE
        WHEN tn.invoice_breakdown_json IS NOT NULL
         AND upper(coalesce(tn.invoice_breakdown_json->>'mode','')) = 'SEGMENTS'
         AND jsonb_typeof(tn.invoice_breakdown_json->'segments') = 'array'
          THEN true
        ELSE false
      END AS actual_segments_mode,
      CASE
        WHEN tn.sheet_scope = 'DAILY'
         AND coalesce(
           CASE
             WHEN tn.effective_worked_start_iso IS NOT NULL THEN ((tn.effective_worked_start_iso AT TIME ZONE 'Europe/London')::date)::text
             ELSE coalesce(
               nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'date','')), ''),
               nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'work_date','')), ''),
               nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'ymd','')), ''),
               nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'date_ymd','')), '')
             )
           END,
           ''
         ) <> ''
          THEN true
        ELSE false
      END AS synthetic_daily_mode,
      CASE
        WHEN tn.effective_worked_start_iso IS NOT NULL THEN ((tn.effective_worked_start_iso AT TIME ZONE 'Europe/London')::date)::text
        ELSE coalesce(
          nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'date','')), ''),
          nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'work_date','')), ''),
          nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'ymd','')), ''),
          nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'date_ymd','')), '')
        )
      END AS synthetic_component_date,
      jsonb_strip_nulls(
        case
          when jsonb_typeof(tn.effective_daily_schedule_json->'breaks') = 'array' then tn.effective_daily_schedule_json->'breaks'
          when tn.effective_break_start_iso is not null and tn.effective_break_end_iso is not null then
            jsonb_build_array(
              jsonb_build_object(
                'start', to_char((tn.effective_break_start_iso AT TIME ZONE 'Europe/London'), 'HH24:MI'),
                'end', to_char((tn.effective_break_end_iso AT TIME ZONE 'Europe/London'), 'HH24:MI'),
                'break_mins', coalesce(
                  tn.effective_break_minutes::numeric,
                  case
                    when tn.effective_break_start_iso is not null and tn.effective_break_end_iso is not null
                      then greatest(
                        0::numeric,
                        round((extract(epoch from (tn.effective_break_end_iso - tn.effective_break_start_iso)) / 60.0)::numeric, 0)
                      )
                    else null::numeric
                  end
                )
              )
            )
          when nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'break_start','')), '') is not null
           and nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'break_end','')), '') is not null then
            jsonb_build_array(
              jsonb_build_object(
                'start', nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'break_start','')), ''),
                'end', nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'break_end','')), ''),
                'break_mins', coalesce(
                  tn.effective_break_minutes::numeric,
                  nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'break_minutes','')), '')::numeric,
                  nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'break_mins','')), '')::numeric,
                  nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'breakMinutes','')), '')::numeric,
                  nullif(btrim(coalesce(tn.effective_daily_schedule_json->>'breakMin','')), '')::numeric
                )
              )
            )
          else '[]'::jsonb
        end
      ) AS synthetic_component_breaks
    FROM tf_norm tn
  ),
  segment_components AS (
    SELECT
      nullif(btrim(COALESCE(seg.value->>'segment_id','')), '') AS component_id,
      nullif(btrim(COALESCE(seg.value->>'date','')), '') AS component_date,
      coalesce(
        nullif(btrim(COALESCE(seg.value->>'segment_stable_key','')), ''),
        nullif(btrim(COALESCE(seg.value->>'segment_id','')), ''),
        nullif(btrim(COALESCE(seg.value->>'segment_key','')), ''),
        nullif(btrim(COALESCE(seg.value->>'ref_num','')), ''),
        nullif(btrim(COALESCE(seg.value->>'date','')), '')
      ) AS component_stable_key,
      nullif(btrim(COALESCE(seg.value->>'ref_num','')), '') AS component_ref_num,
      COALESCE(NULLIF(seg.value->>'exclude_from_pay','')::boolean, false) AS is_on_hold,
      nullif(btrim(COALESCE(seg.value->>'start_utc','')), '') AS component_start_utc,
      nullif(btrim(COALESCE(seg.value->>'end_utc','')), '') AS component_end_utc,
      case
        when nullif(btrim(COALESCE(seg.value->>'start','')), '') is not null then nullif(btrim(COALESCE(seg.value->>'start','')), '')
        when nullif(btrim(COALESCE(seg.value->>'start_utc','')), '') is not null then to_char(((seg.value->>'start_utc')::timestamptz AT TIME ZONE 'Europe/London'), 'HH24:MI')
        else null
      end AS component_start,
      case
        when nullif(btrim(COALESCE(seg.value->>'end','')), '') is not null then nullif(btrim(COALESCE(seg.value->>'end','')), '')
        when nullif(btrim(COALESCE(seg.value->>'end_utc','')), '') is not null then to_char(((seg.value->>'end_utc')::timestamptz AT TIME ZONE 'Europe/London'), 'HH24:MI')
        else null
      end AS component_end,
      nullif(btrim(COALESCE(seg.value->>'break_start','')), '') AS component_break_start,
      nullif(btrim(COALESCE(seg.value->>'break_end','')), '') AS component_break_end,
      coalesce(
        nullif(seg.value->>'break_mins','')::numeric,
        nullif(seg.value->>'break_minutes','')::numeric
      ) AS component_break_mins,
      case
        when jsonb_typeof(seg.value->'breaks') = 'array' then seg.value->'breaks'
        else '[]'::jsonb
      end AS component_breaks
    FROM mode_flags mf
    JOIN LATERAL jsonb_array_elements(COALESCE(mf.invoice_breakdown_json->'segments','[]'::jsonb)) AS seg(value)
      ON true
    WHERE mf.actual_segments_mode = true
      AND seg.value IS NOT NULL
      AND jsonb_typeof(seg.value) = 'object'
      AND nullif(btrim(COALESCE(seg.value->>'segment_id','')), '') IS NOT NULL

    UNION ALL

    SELECT
      ('ts:' || mf.timesheet_id::text) AS component_id,
      mf.synthetic_component_date AS component_date,
      ('timesheet:' || COALESCE(mf.booking_id, mf.timesheet_id::text)) AS component_stable_key,
      coalesce(
        mf.reference_number,
        nullif(btrim(coalesce(mf.effective_daily_schedule_json->>'ref_num','')), '')
      ) AS component_ref_num,
      mf.pay_on_hold AS is_on_hold,
      CASE
        WHEN mf.effective_worked_start_iso IS NULL THEN NULL
        ELSE mf.effective_worked_start_iso::text
      END AS component_start_utc,
      CASE
        WHEN mf.effective_worked_end_iso IS NULL THEN NULL
        ELSE mf.effective_worked_end_iso::text
      END AS component_end_utc,
      case
        when mf.effective_worked_start_iso is not null then to_char((mf.effective_worked_start_iso AT TIME ZONE 'Europe/London'), 'HH24:MI')
        else coalesce(
          nullif(btrim(coalesce(mf.effective_daily_schedule_json->>'start','')), ''),
          nullif(btrim(coalesce(mf.effective_daily_schedule_json->>'worked_start','')), '')
        )
      end AS component_start,
      case
        when mf.effective_worked_end_iso is not null then to_char((mf.effective_worked_end_iso AT TIME ZONE 'Europe/London'), 'HH24:MI')
        else coalesce(
          nullif(btrim(coalesce(mf.effective_daily_schedule_json->>'end','')), ''),
          nullif(btrim(coalesce(mf.effective_daily_schedule_json->>'worked_end','')), '')
        )
      end AS component_end,
      case
        when mf.effective_break_start_iso is not null then to_char((mf.effective_break_start_iso AT TIME ZONE 'Europe/London'), 'HH24:MI')
        else nullif(btrim(coalesce(mf.effective_daily_schedule_json->>'break_start','')), '')
      end AS component_break_start,
      case
        when mf.effective_break_end_iso is not null then to_char((mf.effective_break_end_iso AT TIME ZONE 'Europe/London'), 'HH24:MI')
        else nullif(btrim(coalesce(mf.effective_daily_schedule_json->>'break_end','')), '')
      end AS component_break_end,
      coalesce(
        mf.effective_break_minutes::numeric,
        nullif(btrim(coalesce(mf.effective_daily_schedule_json->>'break_minutes','')), '')::numeric,
        nullif(btrim(coalesce(mf.effective_daily_schedule_json->>'break_mins','')), '')::numeric,
        nullif(btrim(coalesce(mf.effective_daily_schedule_json->>'breakMinutes','')), '')::numeric,
        nullif(btrim(coalesce(mf.effective_daily_schedule_json->>'breakMin','')), '')::numeric,
        case
          when mf.effective_break_start_iso is not null and mf.effective_break_end_iso is not null
            then greatest(
              0::numeric,
              round((extract(epoch from (mf.effective_break_end_iso - mf.effective_break_start_iso)) / 60.0)::numeric, 0)
            )
          else null::numeric
        end
      ) AS component_break_mins,
      coalesce(mf.synthetic_component_breaks, '[]'::jsonb) AS component_breaks
    FROM mode_flags mf
    WHERE mf.actual_segments_mode = false
      AND mf.synthetic_daily_mode = true
  ),
  components AS (
    SELECT
      sc.component_id,
      sc.component_date,
      sc.component_stable_key,
      sc.component_ref_num,
      sc.is_on_hold,
      sc.component_start_utc,
      sc.component_end_utc,
      sc.component_start,
      sc.component_end,
      sc.component_break_start,
      sc.component_break_end,
      sc.component_break_mins,
      sc.component_breaks
    FROM segment_components sc

    UNION ALL

    SELECT
      'TOTAL'::text AS component_id,
      NULL::text AS component_date,
      ('timesheet:' || COALESCE(mf.booking_id, mf.timesheet_id::text))::text AS component_stable_key,
      NULL::text AS component_ref_num,
      mf.pay_on_hold AS is_on_hold,
      NULL::text AS component_start_utc,
      NULL::text AS component_end_utc,
      NULL::text AS component_start,
      NULL::text AS component_end,
      NULL::text AS component_break_start,
      NULL::text AS component_break_end,
      NULL::numeric AS component_break_mins,
      '[]'::jsonb AS component_breaks
    FROM mode_flags mf
    WHERE mf.actual_segments_mode = false
      AND mf.synthetic_daily_mode = false
  ),
  active_override AS (
    SELECT
      tpo.id AS override_id,
      tpo.timesheet_id,
      tpo.reason,
      tpo.created_at_utc,
      tpo.consumed_at_utc,
      CASE
        WHEN pb.id IS NOT NULL AND upper(COALESCE(pb.status::text,'')) <> 'CANCELLED'
          THEN pb.id
        ELSE NULL
      END AS consumed_by_batch_id,
      CASE
        WHEN pb.id IS NOT NULL AND upper(COALESCE(pb.status::text,'')) <> 'CANCELLED'
          THEN upper(COALESCE(pb.status::text,''))
        ELSE NULL
      END AS consumed_batch_status,
      CASE
        WHEN pb.id IS NOT NULL AND upper(COALESCE(pb.status::text,'')) <> 'CANCELLED'
          THEN false
        ELSE true
      END AS can_unadvance,
      CASE
        WHEN tpo.consumed_by_pay_batch_id IS NULL THEN 'ADVANCED_PENDING_BATCH'
        WHEN pb.id IS NOT NULL AND upper(COALESCE(pb.status::text,'')) = 'CANCELLED' THEN 'ADVANCED_BATCH_CANCELLED'
        WHEN pb.id IS NOT NULL THEN 'ADVANCED_IN_BATCH'
        ELSE 'ADVANCED_PENDING_BATCH'
      END AS advance_status
    FROM public.timesheet_payment_overrides tpo
    LEFT JOIN public.pay_batches pb
      ON pb.id = tpo.consumed_by_pay_batch_id
    WHERE tpo.timesheet_id = p_timesheet_id
      AND tpo.cleared_at_utc IS NULL
      AND upper(coalesce(tpo.override_type, '')) = 'ADVANCE_THIS_PAYMENT'
    ORDER BY tpo.created_at_utc DESC, tpo.id DESC
    LIMIT 1
  ),
  active_payment_snooze AS (
    SELECT
      s.id AS snooze_id,
      s.snooze_until_date,
      s.note
    FROM tf_norm tn
    JOIN public.pay_item_snoozes s
      ON s.candidate_id = tn.candidate_id
     AND s.source_ref IS NULL
     AND s.segment_id IS NULL
     AND s.segment_stable_key IS NULL
     AND s.cleared_at_utc IS NULL
     AND upper(COALESCE(s.snooze_kind,'')) = 'TIMESHEET_PAYMENT'
     AND (s.snooze_until_date IS NULL OR s.snooze_until_date >= v_today_uk)
     AND (
       (tn.booking_id IS NOT NULL AND s.booking_id IS NOT DISTINCT FROM tn.booking_id)
       OR
       (s.booking_id IS NULL AND s.timesheet_id = p_timesheet_id)
     )
    ORDER BY s.updated_at_utc DESC NULLS LAST, s.created_at_utc DESC, s.id DESC
    LIMIT 1
  ),
  active_segment_snoozes_source AS (
    SELECT
      s.id AS snooze_id,
      s.candidate_id,
      s.timesheet_id,
      s.booking_id,
      s.segment_id,
      coalesce(
        nullif(btrim(COALESCE(s.segment_stable_key,'')), ''),
        nullif(btrim(COALESCE(s.segment_id,'')), '')
      ) AS segment_stable_key,
      upper(COALESCE(s.snooze_kind,'')) AS snooze_kind,
      s.snooze_until_date,
      s.note,
      s.created_at_utc,
      s.updated_at_utc
    FROM tf_norm tn
    JOIN public.pay_item_snoozes s
      ON s.candidate_id = tn.candidate_id
     AND s.source_ref IS NULL
     AND s.cleared_at_utc IS NULL
     AND upper(COALESCE(s.snooze_kind,'')) IN ('DO_NOT_PAY', 'BLOCKED_TIMESHEET')
     AND (s.snooze_until_date IS NULL OR s.snooze_until_date >= v_today_uk)
     AND coalesce(
           nullif(btrim(COALESCE(s.segment_stable_key,'')), ''),
           nullif(btrim(COALESCE(s.segment_id,'')), '')
         ) IS NOT NULL
     AND (
       (tn.booking_id IS NOT NULL AND s.booking_id IS NOT DISTINCT FROM tn.booking_id)
       OR
       (s.booking_id IS NULL AND s.timesheet_id = p_timesheet_id)
     )
  ),
  active_segment_snooze_matches AS (
    SELECT
      sc.component_id,
      sc.component_date,
      sc.component_stable_key,
      sc.component_ref_num,
      sc.component_start_utc,
      sc.component_end_utc,
      sc.component_start,
      sc.component_end,
      sc.component_break_start,
      sc.component_break_end,
      sc.component_break_mins,
      sc.component_breaks,
      ass.snooze_id,
      ass.candidate_id,
      ass.timesheet_id,
      ass.booking_id,
      ass.segment_id,
      ass.segment_stable_key,
      ass.snooze_kind,
      ass.snooze_until_date,
      ass.note,
      ass.created_at_utc,
      ass.updated_at_utc,
      row_number() OVER (
        PARTITION BY sc.component_id
        ORDER BY ass.updated_at_utc DESC NULLS LAST, ass.created_at_utc DESC, ass.snooze_id DESC
      ) AS rn
    FROM segment_components sc
    JOIN active_segment_snoozes_source ass
      ON (
        (
          ass.booking_id IS NOT NULL
          AND (
            ass.segment_stable_key IS NOT DISTINCT FROM sc.component_stable_key
            OR ass.segment_id IS NOT DISTINCT FROM sc.component_id
          )
        )
        OR
        (
          ass.booking_id IS NULL
          AND ass.timesheet_id IS NOT DISTINCT FROM p_timesheet_id
          AND (
            ass.segment_id IS NOT DISTINCT FROM sc.component_id
            OR ass.segment_stable_key IS NOT DISTINCT FROM sc.component_stable_key
          )
        )
      )
  ),
  active_segment_snoozes AS (
    SELECT
      asm.component_id,
      asm.component_date,
      asm.component_stable_key,
      asm.component_ref_num,
      asm.component_start_utc,
      asm.component_end_utc,
      asm.component_start,
      asm.component_end,
      asm.component_break_start,
      asm.component_break_end,
      asm.component_break_mins,
      asm.component_breaks,
      asm.snooze_id,
      asm.candidate_id,
      asm.timesheet_id,
      asm.booking_id,
      asm.segment_id,
      asm.segment_stable_key,
      asm.snooze_kind,
      asm.snooze_until_date,
      asm.note,
      asm.created_at_utc,
      asm.updated_at_utc
    FROM active_segment_snooze_matches asm
    WHERE asm.rn = 1
  ),
  pay_items AS (
    SELECT
      CASE
        WHEN nullif(btrim(COALESCE(pbi.segment_key,'')), '') IS NOT NULL
          THEN nullif(btrim(COALESCE(pbi.segment_key,'')), '')
        WHEN pbi.source_ref IS NOT NULL AND btrim(COALESCE(pbi.source_ref,'')) LIKE 'seg:%'
          THEN nullif(btrim(substring(btrim(COALESCE(pbi.source_ref,'')) from 5)), '')
        ELSE 'TOTAL'
      END AS component_id,
      pb.status AS batch_status,
      pb.completed_at_utc AS completed_at_utc,
      pbt.status AS transfer_status,
      pbt.rail_state AS transfer_rail_state,
      COALESCE(pbt_classifier.is_final_money_moved, false) AS transfer_final_money_moved,
      COALESCE(pbt_classifier.is_pending_non_final, false) AS transfer_pending_non_final,
      COALESCE(pbt_classifier.is_terminal_no_money, false) AS transfer_terminal_no_money
    FROM public.pay_batch_items pbi
    JOIN public.pay_batch_candidates pbc
      ON pbc.id = pbi.pay_batch_candidate_id
    JOIN public.pay_batches pb
      ON pb.id = pbc.pay_batch_id
    LEFT JOIN public.pay_bank_transfers pbt
      ON pbt.id = pbi.pay_bank_transfer_id
     AND pbt.pay_batch_id = pb.id
    LEFT JOIN LATERAL public._pay_rail_state_money_movement_classify(
      pbt.status,
      pbt.rail_state,
      COALESCE(pbt.rail_meta_json, '{}'::jsonb),
      COALESCE(pbt.rail_meta_json, '{}'::jsonb)
    ) AS pbt_classifier
      ON pbt.id IS NOT NULL
    WHERE pbi.timesheet_id = p_timesheet_id
      AND pbi.is_voided = false
      AND pbi.item_type IN ('SEGMENT_DELTA','EXPENSE_DELTA','ADJUSTMENT_DELTA','MILEAGE_DELTA')
      AND pb.cancelled_at_utc IS NULL
  ),
  agg AS (
    SELECT
      pi.component_id,
      max(CASE WHEN upper(COALESCE(pi.batch_status::text,'')) = 'SETTLED' THEN 1 ELSE 0 END)::int AS has_settled_norm,
      max(CASE WHEN upper(COALESCE(pi.batch_status::text,'')) = 'SETTLED' THEN pi.completed_at_utc ELSE NULL END) AS settled_at_utc,
      max(CASE
            WHEN COALESCE(pi.transfer_final_money_moved, false) = false
             AND COALESCE(pi.transfer_terminal_no_money, false) = false
             AND (
               COALESCE(pi.transfer_pending_non_final, false) = true
               OR upper(COALESCE(pi.batch_status::text,'')) IN ('EXECUTING','WAITING_BANK_CONFIRM')
               OR upper(COALESCE(pi.transfer_status::text,'')) IN ('PENDING','PROCESSING','UNKNOWN')
             )
              THEN 1
            ELSE 0
          END)::int AS has_proc_any
    FROM pay_items pi
    WHERE pi.component_id IS NOT NULL
    GROUP BY pi.component_id
  ),
  comp_state AS (
    SELECT
      c.component_id,
      c.component_date,
      c.component_stable_key,
      c.component_ref_num,
      c.is_on_hold,
      c.component_start_utc,
      c.component_end_utc,
      c.component_start,
      c.component_end,
      c.component_break_start,
      c.component_break_end,
      c.component_break_mins,
      c.component_breaks,
      CASE
        WHEN c.is_on_hold = true THEN 'ON_HOLD'
        WHEN COALESCE(a.has_settled_norm,0) = 1 THEN 'PAID'
        WHEN ao.override_id IS NOT NULL AND COALESCE(a.has_proc_any,0) = 1 THEN 'ADVANCE_PROCESSING'
        WHEN COALESCE(a.has_proc_any,0) = 1 THEN 'PAY_PROCESSING'
        WHEN ao.override_id IS NOT NULL THEN 'ADVANCED'
        ELSE 'UNPAID'
      END AS stage,
      a.settled_at_utc,
      CASE
        WHEN c.component_id = 'TOTAL' THEN 'NONE'
        WHEN ass.snooze_id IS NULL THEN 'NONE'
        WHEN ass.snooze_until_date IS NULL THEN 'INDEFINITE_SNOOZED'
        ELSE 'DATED_SNOOZED'
      END AS snooze_state,
      ass.snooze_id,
      ass.snooze_until_date,
      ass.note AS snooze_note,
      ass.segment_id AS snooze_segment_id,
      ass.segment_stable_key AS snooze_segment_stable_key
    FROM components c
    LEFT JOIN agg a
      ON a.component_id = c.component_id
    LEFT JOIN active_override ao
      ON true
    LEFT JOIN active_segment_snoozes ass
      ON ass.component_id = c.component_id
  ),
  counts AS (
    SELECT
      count(*)::int AS total_components,
      count(*) FILTER (WHERE cs.is_on_hold = true)::int AS on_hold_components,
      count(*) FILTER (WHERE cs.is_on_hold = false)::int AS payable_components,
      count(*) FILTER (WHERE cs.is_on_hold = false AND cs.stage = 'PAID')::int AS paid_components,
      count(*) FILTER (WHERE cs.is_on_hold = false AND cs.stage = 'ADVANCED')::int AS advanced_components,
      count(*) FILTER (WHERE cs.is_on_hold = false AND cs.stage IN ('PAY_PROCESSING','ADVANCE_PROCESSING'))::int AS processing_components,
      count(*) FILTER (WHERE cs.is_on_hold = false AND cs.stage = 'UNPAID')::int AS unpaid_components,
      max(CASE WHEN cs.is_on_hold = false AND cs.stage IN ('PAY_PROCESSING','ADVANCE_PROCESSING') THEN 1 ELSE 0 END)::int AS any_processing,
      max(CASE WHEN cs.is_on_hold = false AND cs.stage = 'ADVANCED' THEN 1 ELSE 0 END)::int AS any_advanced,
      max(CASE WHEN cs.is_on_hold = false AND cs.stage = 'PAID' THEN cs.settled_at_utc ELSE NULL END) AS paid_at_utc
    FROM comp_state cs
  ),
  pay_cache AS (
    SELECT
      cache_row.timesheet_id,
      CASE
        WHEN upper(coalesce(cache_row.summary_pay_status_code, '')) IN ('PAID','PARTIALLY_PAID','PROCESSING','ADVANCED')
          THEN upper(coalesce(cache_row.summary_pay_status_code, ''))
        WHEN cache_row.last_settled_at_utc IS NOT NULL
          THEN 'PAID'
        WHEN upper(coalesce(cache_row.summary_pay_status_code, '')) = 'UNPAID'
          THEN 'UNPAID'
        ELSE NULL::text
      END AS cached_pay_status_code,
      coalesce(cache_row.summary_pay_paid_at_utc, cache_row.last_settled_at_utc) AS cached_paid_at_utc,
      cache_row.summary_pay_icon_code,
      cache_row.summary_net_delta_ex_vat,
      cache_row.last_settled_pay_batch_id,
      cache_row.last_settled_at_utc
    FROM (SELECT 1) seed(seed_id)
    LEFT JOIN LATERAL (
      SELECT
        tps.timesheet_id,
        tps.summary_pay_status_code,
        tps.summary_pay_icon_code,
        tps.summary_pay_paid_at_utc,
        tps.summary_net_delta_ex_vat,
        tps.last_settled_pay_batch_id,
        tps.last_settled_at_utc
      FROM public.timesheet_pay_state tps
      WHERE tps.timesheet_id = p_timesheet_id
      LIMIT 1
    ) cache_row
      ON true
  ),
  unpaid_sample AS (
    SELECT
      coalesce(
        jsonb_agg(cs.component_date ORDER BY cs.component_date) FILTER (WHERE cs.component_date IS NOT NULL),
        '[]'::jsonb
      ) AS dates
    FROM (
      SELECT cs.component_date
      FROM comp_state cs
      WHERE cs.is_on_hold = false
        AND cs.stage = 'UNPAID'
        AND cs.component_date IS NOT NULL
      ORDER BY cs.component_date
      LIMIT 3
    ) cs
  ),
  delta AS (
    SELECT
      round(coalesce(sum(coalesce(oc.truth_ex_vat,0) - coalesce(oc.baseline_ex_vat,0)),0),2)::numeric AS net_delta_ex_vat,
      round(coalesce(sum(coalesce(oc.outstanding_ex_vat,0)),0),2)::numeric AS outstanding_ex_vat,
      round(coalesce(sum(coalesce(oc.reserved_ex_vat,0)),0),2)::numeric AS reserved_ex_vat
    FROM public._pay_outstanding_components(ARRAY[p_timesheet_id]) oc
  ),
  paid_totals AS (
    SELECT
      round(coalesce(sum(coalesce(paid_item.amount_ex_vat, 0)), 0), 2)::numeric AS paid_to_date_ex_vat,
      count(paid_item.id)::int AS paid_item_count,
      max(coalesce(paid_candidate.settled_at_utc, paid_transfer.completed_at_utc, paid_batch.completed_at_utc)) AS last_paid_at_utc
    FROM public.pay_batch_items AS paid_item
    JOIN public.pay_batch_candidates AS paid_candidate
      ON paid_candidate.id = paid_item.pay_batch_candidate_id
    JOIN public.pay_batches AS paid_batch
      ON paid_batch.id = paid_candidate.pay_batch_id
    LEFT JOIN public.pay_bank_transfers AS paid_transfer
      ON paid_transfer.id = paid_item.pay_bank_transfer_id
     AND paid_transfer.pay_batch_id = paid_batch.id
    LEFT JOIN LATERAL public._pay_rail_state_money_movement_classify(
      paid_transfer.status,
      paid_transfer.rail_state,
      coalesce(paid_transfer.rail_meta_json, '{}'::jsonb),
      coalesce(paid_transfer.rail_meta_json, '{}'::jsonb)
    ) AS paid_transfer_classifier
      ON paid_transfer.id IS NOT NULL
    WHERE paid_item.timesheet_id = p_timesheet_id
      AND coalesce(paid_item.is_voided, false) = false
      AND paid_item.item_type IN ('SEGMENT_DELTA','EXPENSE_DELTA','ADJUSTMENT_DELTA','MILEAGE_DELTA')
      AND paid_batch.cancelled_at_utc IS NULL
      AND upper(btrim(coalesce(paid_batch.status, ''))) <> 'CANCELLED'
      AND (
        upper(btrim(coalesce(paid_candidate.settlement_status, ''))) IN ('SETTLED','PAID','CONFIRMED')
        OR upper(btrim(coalesce(paid_batch.status, ''))) = 'SETTLED'
        OR coalesce(paid_transfer_classifier.is_final_money_moved, false) = true
        OR upper(btrim(coalesce(paid_transfer.status, ''))) IN ('COMPLETED','COMPLETE','SETTLED','PAID','EXECUTED','COMMITTED','SUCCESS','SUCCESSFUL','SUCCEEDED')
        OR upper(btrim(coalesce(paid_transfer.rail_state, ''))) IN ('COMPLETED','COMPLETE','SETTLED','PAID','EXECUTED','COMMITTED','SUCCESS','SUCCESSFUL','SUCCEEDED')
        OR paid_transfer.completed_at_utc IS NOT NULL
        OR EXISTS (
          SELECT 1
          FROM public.banking_pay_operation_settlement_scope AS paid_settlement_scope
          WHERE paid_settlement_scope.pay_batch_id = paid_batch.id
            AND paid_settlement_scope.pay_batch_candidate_id = paid_candidate.id
            AND paid_settlement_scope.status = 'SETTLED'
            AND (
              (
                paid_item.pay_bank_transfer_id IS NOT NULL
                AND paid_settlement_scope.payload_json #>> '{payment_scope_json,pay_bank_transfer_id}' = paid_item.pay_bank_transfer_id::text
              )
              OR coalesce(paid_settlement_scope.payload_json->'pay_batch_item_ids', '[]'::jsonb) ? paid_item.id::text
            )
        )
      )
  ),
  mode AS (
    SELECT
      COALESCE((SELECT (mf.actual_segments_mode OR mf.synthetic_daily_mode) FROM mode_flags mf LIMIT 1), false) AS is_segments_mode
  ),
  comp_json AS (
    SELECT
      coalesce(
        jsonb_agg(
          jsonb_build_object(
            'component_id', cs.component_id,
            'date', cs.component_date,
            'segment_stable_key', cs.component_stable_key,
            'ref_num', cs.component_ref_num,
            'is_on_hold', cs.is_on_hold,
            'stage', cs.stage,
            'paid_at_utc', cs.settled_at_utc,
            'paid_at_label_uk',
              CASE
                WHEN cs.settled_at_utc IS NULL THEN NULL
                ELSE to_char(cs.settled_at_utc AT TIME ZONE 'Europe/London', 'Dy DD/MM/YYYY HH24:MI') || 'hrs'
              END,
            'snooze_state', cs.snooze_state,
            'snooze_id', CASE WHEN cs.snooze_id IS NULL THEN NULL ELSE cs.snooze_id::text END,
            'snooze_until_date', CASE WHEN cs.snooze_until_date IS NULL THEN NULL ELSE cs.snooze_until_date::text END,
            'snooze_note', cs.snooze_note,
            'snooze_segment_id', cs.snooze_segment_id,
            'snooze_segment_stable_key', cs.snooze_segment_stable_key,
            'start_utc', cs.component_start_utc,
            'end_utc', cs.component_end_utc,
            'start', cs.component_start,
            'end', cs.component_end,
            'break_start', cs.component_break_start,
            'break_end', cs.component_break_end,
            'break_mins', cs.component_break_mins,
            'breaks', coalesce(cs.component_breaks, '[]'::jsonb)
          )
          ORDER BY
            CASE WHEN cs.component_id = 'TOTAL' THEN 0 ELSE 1 END,
            cs.component_date NULLS LAST,
            cs.component_id
        ),
        '[]'::jsonb
      ) AS components
    FROM comp_state cs
  ),
  segment_snoozes_json AS (
    SELECT
      coalesce(
        jsonb_agg(
          jsonb_build_object(
            'snooze_id', ass.snooze_id::text,
            'candidate_id', ass.candidate_id::text,
            'timesheet_id', CASE WHEN ass.timesheet_id IS NULL THEN NULL ELSE ass.timesheet_id::text END,
            'booking_id', ass.booking_id,
            'segment_id', ass.segment_id,
            'segment_stable_key', ass.segment_stable_key,
            'snooze_kind', ass.snooze_kind,
            'snooze_until_date', CASE WHEN ass.snooze_until_date IS NULL THEN NULL ELSE ass.snooze_until_date::text END,
            'note', ass.note,
            'snooze_note', ass.note,
            'date', ass.component_date,
            'work_date', ass.component_date,
            'ref_num', ass.component_ref_num,
            'start_utc', ass.component_start_utc,
            'end_utc', ass.component_end_utc,
            'start', ass.component_start,
            'end', ass.component_end,
            'break_start', ass.component_break_start,
            'break_end', ass.component_break_end,
            'break_mins', ass.component_break_mins,
            'breaks', coalesce(ass.component_breaks, '[]'::jsonb),
            'snooze_state',
              CASE
                WHEN ass.snooze_until_date IS NULL THEN 'INDEFINITE_SNOOZED'
                ELSE 'DATED_SNOOZED'
              END
          )
          ORDER BY ass.component_date NULLS LAST, ass.segment_stable_key NULLS LAST, ass.segment_id NULLS LAST
        ),
        '[]'::jsonb
      ) AS segment_snoozes
    FROM active_segment_snoozes ass
  ),
  paid_status AS (
    SELECT
      resolved.paid_status_code,
      resolved.paid_at_utc,
      CASE
        WHEN resolved.paid_at_utc IS NULL THEN NULL
        ELSE to_char(resolved.paid_at_utc AT TIME ZONE 'Europe/London', 'Dy DD/MM/YYYY HH24:MI') || 'hrs'
      END AS paid_at_label_uk
    FROM (
      SELECT
        CASE
          WHEN c.processing_components > 0 OR pc.cached_pay_status_code = 'PROCESSING' THEN 'PROCESSING'
          WHEN coalesce(pt.paid_to_date_ex_vat,0) > 0
               AND greatest(coalesce(d.reserved_ex_vat,0),0) <= 0
               AND greatest(coalesce(d.outstanding_ex_vat,0),0) <= 0
               AND coalesce(d.net_delta_ex_vat,0) <= 0 THEN 'PAID'
          WHEN coalesce(pt.paid_to_date_ex_vat,0) > 0 THEN 'PARTIALLY_PAID'
          ELSE 'UNPAID'
        END AS paid_status_code,
        coalesce(pt.last_paid_at_utc, pc.cached_paid_at_utc, c.paid_at_utc) AS paid_at_utc
      FROM counts c
      CROSS JOIN pay_cache pc
      CROSS JOIN paid_totals pt
      CROSS JOIN delta d
    ) resolved
  ),
  adjusted AS (
    SELECT
      coalesce(d.net_delta_ex_vat,0) AS net_delta_ex_vat,
      greatest(coalesce(d.outstanding_ex_vat,0),0) AS outstanding_ex_vat,
      greatest(coalesce(d.reserved_ex_vat,0),0) AS reserved_ex_vat,
      CASE
        WHEN greatest(coalesce(d.outstanding_ex_vat,0),0) > 0 THEN 'PAY_OUTSTANDING'
        WHEN coalesce(d.net_delta_ex_vat,0) < 0 THEN 'OVERPAID'
        ELSE 'NONE'
      END AS adjusted_pill,
      CASE
        WHEN greatest(coalesce(d.outstanding_ex_vat,0),0) > 0 THEN
          'Timesheet adjusted after payment. Additional pay outstanding: £' || to_char(greatest(coalesce(d.outstanding_ex_vat,0),0), 'FM999999990D00')
        WHEN coalesce(d.net_delta_ex_vat,0) > 0
             AND greatest(coalesce(d.reserved_ex_vat,0),0) >= coalesce(d.net_delta_ex_vat,0)
             AND greatest(coalesce(d.outstanding_ex_vat,0),0) <= 0 THEN
          'Timesheet adjusted after payment. Additional pay is reserved. No unreserved amount is currently owed.'
        WHEN coalesce(d.net_delta_ex_vat,0) < 0 THEN
          'Timesheet adjusted after payment. Current overpaid position: £' || to_char(abs(coalesce(d.net_delta_ex_vat,0)), 'FM999999990D00')
        ELSE NULL
      END AS adjusted_message
    FROM delta d
  ),
  hover AS (
    SELECT
      jsonb_build_object(
        'paid', c.paid_components,
        'processing', c.processing_components,
        'unpaid', c.unpaid_components,
        'on_hold', c.on_hold_components,
        'total', c.total_components,
        'payable', c.payable_components,
        'last_payment_utc', ps.paid_at_utc,
        'last_payment_label_uk', ps.paid_at_label_uk,
        'unpaid_sample_dates', us.dates,
        'net_delta_ex_vat', d.net_delta_ex_vat,
        'outstanding_ex_vat', d.outstanding_ex_vat,
        'reserved_ex_vat', d.reserved_ex_vat
      ) AS hover_summary
    FROM counts c
    CROSS JOIN unpaid_sample us
    CROSS JOIN delta d
    CROSS JOIN paid_status ps
  ),
  override_json AS (
    SELECT
      COALESCE((SELECT ao.override_id IS NOT NULL FROM active_override ao LIMIT 1), false) AS is_advanced,
      COALESCE((SELECT ao.can_unadvance FROM active_override ao LIMIT 1), false) AS can_unadvance,
      (SELECT ao.consumed_by_batch_id FROM active_override ao LIMIT 1) AS advanced_consumed_by_batch_id,
      (SELECT ao.consumed_at_utc FROM active_override ao LIMIT 1) AS advanced_consumed_at_utc,
      (SELECT ao.consumed_batch_status FROM active_override ao LIMIT 1) AS advanced_batch_status,
      COALESCE((SELECT ao.advance_status FROM active_override ao LIMIT 1), 'NOT_ADVANCED') AS advance_status
  ),
  snooze_json AS (
    SELECT
      COALESCE((SELECT aps.snooze_id IS NOT NULL FROM active_payment_snooze aps LIMIT 1), false) AS is_snoozed,
      (SELECT aps.snooze_until_date FROM active_payment_snooze aps LIMIT 1) AS snooze_until_date,
      COALESCE((SELECT aps.snooze_until_date IS NULL FROM active_payment_snooze aps LIMIT 1), false) AS snooze_is_indefinite,
      (SELECT aps.note FROM active_payment_snooze aps LIMIT 1) AS snooze_note
  )
  SELECT
    jsonb_build_object(
      'ok', true,
      'timesheet_id', p_timesheet_id::text,
      'is_segments_mode', m.is_segments_mode,
      'paid_status', ps.paid_status_code,
      'paid_at_utc', ps.paid_at_utc,
      'paid_at_label_uk', ps.paid_at_label_uk,
      'advanced_any', ((c.any_advanced = 1) OR ps.paid_status_code = 'ADVANCED'),
      'processing_any', ((c.any_processing = 1) OR ps.paid_status_code = 'PROCESSING'),
      'is_advanced', oj.is_advanced,
      'can_unadvance', oj.can_unadvance,
      'advanced_consumed_by_batch_id', CASE WHEN oj.advanced_consumed_by_batch_id IS NULL THEN NULL ELSE oj.advanced_consumed_by_batch_id::text END,
      'advanced_consumed_at_utc', oj.advanced_consumed_at_utc,
      'advanced_batch_status', oj.advanced_batch_status,
      'advance_status', oj.advance_status,
      'is_snoozed', sj.is_snoozed,
      'snooze_until_date', CASE WHEN sj.snooze_until_date IS NULL THEN NULL ELSE sj.snooze_until_date::text END,
      'snooze_is_indefinite', sj.snooze_is_indefinite,
      'snooze_note', sj.snooze_note,
      'counts', jsonb_build_object(
        'total_components', c.total_components,
        'payable_components', c.payable_components,
        'on_hold_components', c.on_hold_components,
        'paid_components', c.paid_components,
        'advanced_components', c.advanced_components,
        'processing_components', c.processing_components,
        'unpaid_components', c.unpaid_components
      ),
      'adjusted', jsonb_build_object(
        'net_delta_ex_vat', a.net_delta_ex_vat,
        'pill', a.adjusted_pill,
        'message', a.adjusted_message,
        'outstanding_ex_vat', a.outstanding_ex_vat,
        'reserved_ex_vat', a.reserved_ex_vat
      ),
      'paid_totals', jsonb_build_object(
        'paid_to_date_ex_vat', coalesce(pt.paid_to_date_ex_vat, 0),
        'paid_item_count', coalesce(pt.paid_item_count, 0),
        'last_paid_at_utc', pt.last_paid_at_utc
      ),
      'hover', h.hover_summary,
      'components', cj.components,
      'segment_snoozes', ssj.segment_snoozes
    )
  INTO v_out
  FROM counts c
  CROSS JOIN mode m
  CROSS JOIN paid_status ps
  CROSS JOIN adjusted a
  CROSS JOIN paid_totals pt
  CROSS JOIN hover h
  CROSS JOIN comp_json cj
  CROSS JOIN segment_snoozes_json ssj
  CROSS JOIN override_json oj
  CROSS JOIN snooze_json sj;

  v_has_tsfin := EXISTS (
    SELECT 1
    FROM public.timesheets_financials tf
    WHERE tf.timesheet_id = p_timesheet_id
      AND tf.is_current = true
  );

  IF v_out IS NULL THEN
    v_out := jsonb_build_object(
      'ok', false,
      'timesheet_id', p_timesheet_id::text,
      'error', 'NO_DATA'
    );
  END IF;

  -- Native diagnostic audit belongs to the unchanged public owner only.

  RETURN v_out;
END;
$function$;

create or replace function private.weekly_source_checklist_legacy_read_frame_v1(
 p_timesheet_id uuid,p_scope jsonb,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $legacy_frame$
declare actor public.tms_users%rowtype;t public.timesheets%rowtype;f public.timesheets_financials%rowtype;
 module private.bpay_next_module_control%rowtype;witness jsonb;permission jsonb;facts jsonb;
 financial_scope jsonb;financial_scope_after jsonb;state jsonb;state_after jsonb;
 frame jsonb;frame_after jsonb;n bigint;proof text;
begin
 perform private.weekly_source_query_require_service_v1();
 perform private._weekly_source_settings_assert_request_v1(p_scope,array['source_group_id','source_cycle_id','client_id','week_ending'],
  'WEEKLY_SOURCE_CHECKLIST_LEGACY_SCOPE_INVALID');
 if p_timesheet_id is null or p_actor_user_id is null or exists(select 1 from unnest(array['source_group_id','source_cycle_id','client_id']) k
  where jsonb_typeof(p_scope->k) is distinct from 'string' or pg_input_is_valid(p_scope->>k,'uuid') is distinct from true)
  or jsonb_typeof(p_scope->'week_ending') is distinct from 'string' or pg_input_is_valid(p_scope->>'week_ending','date') is distinct from true then
  raise exception 'WEEKLY_SOURCE_CHECKLIST_LEGACY_SCOPE_INVALID' using errcode='22023';end if;
 select a.* into actor from public.tms_users a where a.id=p_actor_user_id and a.is_active;
 if actor.id is null or (lower(btrim(coalesce(actor.role,'')))<>'admin' and private.weekly_source_pay_actor_allowed_v1(actor.id) is distinct from true) then
  raise exception 'WEEKLY_SOURCE_CHECKLIST_ACTOR_DENIED' using errcode='42501';end if;
 permission:=private.weekly_source_office_authority_v1(actor.id,'VIEW_PAY_WORK',(p_scope->>'source_group_id')::uuid,
  (p_scope->>'client_id')::uuid,(p_scope->>'week_ending')::date);
 if not exists(select 1 from public.weekly_source_cycles c join public.weekly_source_groups g on g.id=c.source_group_id and g.active
  join public.weekly_source_group_clients m on m.source_group_id=g.id and m.client_id=(p_scope->>'client_id')::uuid
  where c.id=(p_scope->>'source_cycle_id')::uuid and g.id=(p_scope->>'source_group_id')::uuid
   and (c.scope_client_id is null or c.scope_client_id=m.client_id)
   and (p_scope->>'week_ending')::date between c.finalisation_week_ending-6 and c.finalisation_week_ending
   and (p_scope->>'week_ending')::date between m.valid_from and coalesce(m.valid_to,'infinity'::date)) then
  raise exception 'WEEKLY_SOURCE_CHECKLIST_LEGACY_SCOPE_UNPROVED' using errcode='55000';end if;
 witness:=private.weekly_source_actual_timesheet_submission_v1(p_timesheet_id);
 if witness->'actual_submitted' is distinct from 'true'::jsonb or witness->>'client_id' is distinct from p_scope->>'client_id'
  or witness->>'week_ending_date' is distinct from p_scope->>'week_ending' then
  raise exception 'WEEKLY_SOURCE_CHECKLIST_LEGACY_SUBJECT_UNPROVED' using errcode='55000';end if;
 select m.* into module from private.bpay_next_module_control m where m.id=1;
 facts:=jsonb_build_object('scope',p_scope,'actor_user_id',actor.id,'permission',permission,'actual_submission',witness,'module',to_jsonb(module));
 if module.active_owner is distinct from 'LEGACY' then
  return jsonb_build_object('known',false,'reason','NATIVE_LEGACY_OWNER_UNAVAILABLE','native_facts',facts);end if;
 select r.* into t from public.timesheets r where r.timesheet_id=p_timesheet_id;
 select count(*),(array_agg(r.id order by r.id))[1] into n,f.id from public.timesheets_financials r where r.timesheet_id=t.timesheet_id and r.is_current;
 if n<>1 then return jsonb_build_object('known',false,'reason','NATIVE_CURRENT_FINANCIAL_AMBIGUOUS','native_facts',facts);end if;
 select r.* into strict f from public.timesheets_financials r where r.id=f.id;
 facts:=facts||jsonb_build_object('root',to_jsonb(t),'current_financial',to_jsonb(f));
 if t.is_current is distinct from true or t.revoked_at is not null or t.archived_at_utc is not null or t.authorised_at_server is null
  or t.line_type::text is distinct from 'HOURS' or t.sheet_scope::text not in('WEEKLY','DAILY')
  or f.timesheet_version is distinct from t.version or f.is_stale is distinct from false or f.authorised_at_utc is null
  or f.client_id::text is distinct from witness->>'client_id' or f.candidate_id::text is distinct from witness->>'candidate_id'
  or private.weekly_source_pay_query_scope_v1(t.timesheet_id) is not null
  or (select count(*) from public.timesheets r where r.booking_id=t.booking_id and r.is_current)<>1 then
  return jsonb_build_object('known',false,'reason','NATIVE_CURRENT_LEGACY_IDENTITY_UNAVAILABLE','native_facts',facts);end if;
 select coalesce(jsonb_agg(to_jsonb(s) order by s.family_timesheet_id),'[]'::jsonb) into financial_scope
  from private.bpay_entitlement_financial_scope_v1(array[t.timesheet_id]) s;
 if jsonb_array_length(financial_scope)=0 or exists(select 1 from jsonb_array_elements(financial_scope) s
  where s->>'requested_timesheet_id' is distinct from t.timesheet_id::text
   or s->>'canonical_timesheet_id' is distinct from t.timesheet_id::text
   or s->>'booking_id' is distinct from t.booking_id or s->'requested_is_canonical' is distinct from 'true'::jsonb) then
  return jsonb_build_object('known',false,'reason','NATIVE_LEGACY_FAMILY_SCOPE_UNAVAILABLE',
   'native_facts',facts||jsonb_build_object('financial_scope',financial_scope));end if;
 frame:=jsonb_build_object('root',to_jsonb(t),'financial',to_jsonb(f),'module',to_jsonb(module),'permission',permission,'submission',witness);
 -- This is the whole actual native read body with only its optional debug
 -- audit removed. It preserves every native component/settled/reserved/stage,
 -- treatment, advance, snooze and outstanding calculation. No fake actor.
 state:=private.weekly_source_checklist_legacy_pay_state_core_v1(t.timesheet_id);
 state_after:=private.weekly_source_checklist_legacy_pay_state_core_v1(t.timesheet_id);
 select coalesce(jsonb_agg(to_jsonb(s) order by s.family_timesheet_id),'[]'::jsonb) into financial_scope_after
  from private.bpay_entitlement_financial_scope_v1(array[t.timesheet_id]) s;
 frame_after:=jsonb_build_object('root',(select to_jsonb(r) from public.timesheets r where r.timesheet_id=t.timesheet_id),
  'financial',(select to_jsonb(r) from public.timesheets_financials r where r.id=f.id),
  'module',(select to_jsonb(m) from private.bpay_next_module_control m where m.id=1),
  'permission',private.weekly_source_office_authority_v1(actor.id,'VIEW_PAY_WORK',(p_scope->>'source_group_id')::uuid,
   (p_scope->>'client_id')::uuid,(p_scope->>'week_ending')::date),'submission',private.weekly_source_actual_timesheet_submission_v1(t.timesheet_id));
 if frame is distinct from frame_after or state is distinct from state_after or financial_scope is distinct from financial_scope_after
  or (select count(*) from public.timesheets_financials r where r.timesheet_id=t.timesheet_id and r.is_current)<>1
  or (select count(*) from public.timesheets r where r.booking_id=t.booking_id and r.is_current)<>1 then
  raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001';end if;
 facts:=facts||jsonb_build_object('financial_scope',financial_scope,'native_position',state,'frame',frame);
 proof:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECKLIST_LEGACY_READ_FRAME_V1',facts),'hex');
 if state->'ok' is distinct from 'true'::jsonb or state->>'timesheet_id' is distinct from t.timesheet_id::text then
  return jsonb_build_object('known',false,'reason','NATIVE_LEGACY_POSITION_UNAVAILABLE','native_facts',facts);end if;
 return jsonb_build_object('known',true,'contract','WEEKLY_SOURCE_CHECKLIST_LEGACY_READ_FRAME_V1',
  'timesheet_id',t.timesheet_id,'financial_id',f.id,'scope',p_scope,'native_position',state,'read_proof_hash',proof,
  'withholding_known',false,'native_facts',facts);
end;
$legacy_frame$;

create or replace function private.weekly_source_checklist_timesheet_hold_facts_v1(
  p_timesheet_id uuid,p_scope jsonb,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  actor public.tms_users%rowtype; witness jsonb; native_scope jsonb;
  query_facts jsonb; first_auth jsonb; financial jsonb; facts jsonb; owner text;
  t public.timesheets%rowtype; f public.timesheets_financials%rowtype; count_rows integer;
  next_owner boolean; route text; hash text; reason text;legacy_frame jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  select u.* into actor from public.tms_users u where u.id=p_actor_user_id and u.is_active;
  if actor.id is null or (lower(btrim(coalesce(actor.role,'')))<>'admin' and not private.weekly_source_pay_actor_allowed_v1(actor.id)) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ACTOR_DENIED' using errcode='42501';
  end if;
  witness:=private.weekly_source_actual_timesheet_submission_v1(p_timesheet_id);
  if witness->'actual_submitted' is distinct from 'true'::jsonb
    or witness->>'client_id' is distinct from p_scope->>'client_id'
    or witness->>'week_ending_date' is distinct from p_scope->>'week_ending' then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_HOLD_SUBJECT_UNPROVED' using errcode='55000';
  end if;
  if not exists(select 1 from public.weekly_source_cycles c
    join public.weekly_source_groups g on g.id=c.source_group_id and g.active
    join public.weekly_source_group_clients m on m.source_group_id=g.id and m.client_id=(p_scope->>'client_id')::uuid
    where c.id=(p_scope->>'source_cycle_id')::uuid and g.id=(p_scope->>'source_group_id')::uuid
      and ((p_scope->>'week_ending')::date) between c.finalisation_week_ending-6 and c.finalisation_week_ending
      and ((p_scope->>'week_ending')::date) between m.valid_from and coalesce(m.valid_to,'infinity'::date)
      and (c.scope_client_id is null or c.scope_client_id=m.client_id)) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_HOLD_SCOPE_UNPROVED' using errcode='55000';
  end if;
  select ts.* into strict t from public.timesheets ts where ts.timesheet_id=p_timesheet_id;
  select count(*),(array_agg(tf.id order by tf.id))[1] into count_rows,f.id
    from public.timesheets_financials tf where tf.timesheet_id=t.timesheet_id and tf.is_current and tf.timesheet_version=t.version;
  if count_rows=1 then select tf.* into strict f from public.timesheets_financials tf where tf.id=f.id; end if;
  -- These are genuine ordinary first-authorisation facts, including Daily;
  -- they are not a Source authorisation record fabricated for ordinary work.
  financial:=jsonb_build_object('timesheet_id',t.timesheet_id,'timesheet_version',t.version,
    'timesheet_authorised_at_server',t.authorised_at_server,'current_financial_count',count_rows,
    'financial_id',case when count_rows=1 then f.id end,'financial_authorised_at_utc',case when count_rows=1 then f.authorised_at_utc end,
    'financial_is_stale',case when count_rows=1 then f.is_stale end,
    'financial_candidate_id',case when count_rows=1 then f.candidate_id end,
    'financial_client_id',case when count_rows=1 then f.client_id end,
    'financial_processing_status',case when count_rows=1 then f.processing_status::text end);
  select active_owner='NEXT' into next_owner from private.bpay_next_module_control where id=1;
  if next_owner is null then raise exception 'WEEKLY_SOURCE_CHECKLIST_FINANCIAL_OWNER_UNPROVED' using errcode='55000'; end if;
  -- ScopeV2 executes the existing resolved Source classifier and returns null
  -- for ordinary/Daily work. No public Banking page, broader actor scope or
  -- mutable stage/publish/prepare method is called from this read adapter.
  native_scope:=private.weekly_source_pay_query_scope_v1(t.timesheet_id);
  if native_scope is not null then
    if native_scope->>'client_id' is distinct from witness->>'client_id'
      or native_scope->>'candidate_id' is distinct from witness->>'candidate_id'
      or native_scope->>'contract_id' is distinct from witness->>'contract_id'
      or native_scope->>'week_ending_date' is distinct from witness->>'week_ending_date'
      or native_scope->>'root_timesheet_id' is distinct from t.timesheet_id::text then
      raise exception 'WEEKLY_SOURCE_CHECKLIST_FINANCIAL_SCOPE_CONFLICT' using errcode='55000';
    end if;
    query_facts:=private.weekly_source_pay_query_facts_v1(t.timesheet_id);
    first_auth:=private.weekly_source_first_authorisation_context_v1(t.timesheet_id);
    owner:='SOURCE';
    reason:=case when query_facts->'ok' is distinct from 'true'::jsonb then 'NATIVE_PAY_QUERY_FACTS_UNAVAILABLE'
      when first_auth->'ok' is distinct from 'true'::jsonb then 'NATIVE_FIRST_AUTHORISATION_UNAVAILABLE'
      else 'NATIVE_WITHHELD_QUANTITY_CERTIFICATE_REQUIRED' end;
  else
    owner:=case when next_owner then 'NEXT' else 'ORDINARY' end;
    if next_owner then route:=private.bpay_next_approval_route_v1(t.timesheet_id); end if;
    reason:=case when count_rows<>1 then 'NATIVE_CURRENT_FINANCIAL_IDENTITY_UNAVAILABLE'
      when f.candidate_id::text is distinct from witness->>'candidate_id' or f.client_id::text is distinct from witness->>'client_id'
        or f.is_stale is distinct from false then 'NATIVE_CURRENT_FINANCIAL_SCOPE_UNAVAILABLE'
      else 'NATIVE_WITHHELD_QUANTITY_CERTIFICATE_REQUIRED' end;
  end if;
  if not next_owner and native_scope is null then
    legacy_frame:=private.weekly_source_checklist_legacy_read_frame_v1(t.timesheet_id,p_scope,p_actor_user_id);end if;
  facts:=jsonb_build_object('legacy_native_position_frame',legacy_frame,'scope',p_scope,'timesheet_id',t.timesheet_id,'actual_submission',witness,
    'active_pay_owner',case when next_owner then 'NEXT' else 'LEGACY' end,'native_approval_route',route,
    'ordinary_authorisation',financial,'source_scope',native_scope,'pay_query_facts',query_facts,
    'source_first_authorisation',first_auth,'withheld_quantity_unavailable_reason',reason);
  hash:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECKLIST_FINANCIAL_FACTS_V1',facts),'hex');
  return jsonb_build_object('native_facts',facts,'hold',jsonb_build_object('holds_pay',null,'holds_pay_scope',null,
    'withheld_amount_pence',null,'holds_invoice',null,'pending_decision',null,
    'authority',jsonb_build_object('owner',owner,'hash',hash,'withholding_known',false)));
end;
$function$;

create or replace function private.weekly_source_checklist_information_hold_facts_v1(
  p_raw jsonb,p_scope jsonb,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare actor public.tms_users%rowtype; decision public.import_review_decisions%rowtype;
  facts jsonb; hash text; count_rows integer;
begin
  perform private.weekly_source_query_require_service_v1();
  select u.* into actor from public.tms_users u where u.id=p_actor_user_id and u.is_active and lower(btrim(coalesce(u.role,'')))='admin';
  if actor.id is null then raise exception 'WEEKLY_SOURCE_CHECKLIST_ACTOR_DENIED' using errcode='42501'; end if;
  if p_raw->>'item_kind' is distinct from 'SOURCE_INFORMATION'
    or p_raw->'counts_for_row_admission' is distinct from 'false'::jsonb
    or p_raw->'timesheet_id' is distinct from 'null'::jsonb
    or p_raw->>'client_id' is distinct from p_scope->>'client_id'
    or p_raw->>'week_ending' is distinct from p_scope->>'week_ending'
    or p_raw->>'source_group_id' is distinct from p_scope->>'source_group_id'
    or p_raw->>'source_cycle_id' is distinct from p_scope->>'source_cycle_id' then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_INFORMATION_FINANCIAL_SUBJECT_UNPROVED' using errcode='55000';
  end if;
  select count(*),(array_agg(d.action_id order by d.action_id))[1] into count_rows,decision.action_id
    from public.import_review_decisions d
    join public.import_review_states st on st.import_id=d.import_id and st.preview_generation=d.preview_generation
      and st.superseded_at_utc is null and st.abandoned_at_utc is null
    join public.hr_imports hi on hi.id=d.import_id and hi.pruned_at is null
      and hi.source_system::text in('HEALTHROSTER','HEALTHROSTER_DAILY')
    join public.hr_rows hr on hr.id=d.hr_row_id and hr.import_id=d.import_id
    where d.import_id=(p_raw->>'query_import_id')::uuid and d.hr_row_id=(p_raw->>'hr_row_id')::uuid
      and d.action_id=p_raw->>'action_id' and d.evidence_fingerprint=p_raw->>'evidence_fingerprint'
      and d.client_id=(p_scope->>'client_id')::uuid and d.timesheet_id is null and d.is_current and not d.blocking
      and d.action_kind='ADVISORY' and d.summary_json->>'authority_mode'='VALIDATION_ONLY'
      and d.summary_json->>'reason_code'=p_raw->>'native_reason_code'
      and d.summary_json->>'reason_code' in('DAILY_TIMESHEET_NOT_SUBMITTED','WEEKLY_TIMESHEET_NOT_SUBMITTED',
        'WEEKLY_TIMESHEET_AWAITING_MANAGER_APPROVAL','WEEKLY_TIMESHEET_COMPLETING')
      and hr.date_local=(p_raw->>'work_date')::date
      and hr.date_local between (p_scope->>'week_ending')::date-6 and (p_scope->>'week_ending')::date
      and exists(select 1 from public.weekly_source_cycles c
        join public.weekly_source_groups g on g.id=c.source_group_id and g.active and g.source_family='ROSTER'
        join public.weekly_source_group_clients m on m.source_group_id=g.id and m.client_id=d.client_id
        join public.weekly_source_client_policies p on p.source_group_id=g.id and p.client_id=d.client_id
        join public.weekly_source_group_rule_assignments a on a.source_group_id=g.id
          and a.feature_enabled and a.feature_purpose='SIGNED_CHECK_ONLY' and a.rule_set_version_id is null
        where c.id=(p_scope->>'source_cycle_id')::uuid and g.id=(p_scope->>'source_group_id')::uuid
          and ((p_scope->>'week_ending')::date) between c.finalisation_week_ending-6 and c.finalisation_week_ending
          and (c.scope_client_id is null or c.scope_client_id=d.client_id)
          and hr.date_local between m.valid_from and coalesce(m.valid_to,'infinity'::date)
          and ((p_scope->>'week_ending')::date) between m.valid_from and coalesce(m.valid_to,'infinity'::date)
          and hr.date_local between p.effective_from and coalesce(p.effective_to,'infinity'::date)
          and ((p_scope->>'week_ending')::date) between a.effective_from_week_ending and coalesce(a.effective_to_week_ending,'infinity'::date)
          and p.authority_mode='TIMESHEET_AUTHORITY' and p.document_mode='INVOICE_EVIDENCE_REQUIRED' and not p.self_bill_enabled);
  if count_rows<>1 then raise exception 'WEEKLY_SOURCE_CHECKLIST_INFORMATION_FINANCIAL_SUBJECT_UNPROVED' using errcode='55000'; end if;
  select d.* into strict decision from public.import_review_decisions d where d.action_id=decision.action_id;
  facts:=jsonb_build_object('owner','private.weekly_source_check_only_query_rows_v1','scope',p_scope,
    'decision',to_jsonb(decision),'financial_subject','NONE','counts_for_row_admission',false);
  hash:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECKLIST_INFORMATION_FINANCIAL_FACTS_V1',facts),'hex');
  return jsonb_build_object('native_facts',facts,'hold',jsonb_build_object('holds_pay',false,'holds_pay_scope',null,
    'withheld_amount_pence','0','holds_invoice',false,'pending_decision',false,
    'authority',jsonb_build_object('owner','SOURCE','hash',hash,'withholding_known',true)));
end;
$function$;

create or replace function private.weekly_source_checklist_ordinary_next_hold_money_v1(
  p_timesheet_id uuid,p_scope jsonb,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $ordinary_hold$
declare actor public.tms_users%rowtype; root public.timesheets%rowtype; financial public.timesheets_financials%rowtype;
  contract public.contracts%rowtype; work private.bpay_next_work%rowtype; revision private.bpay_next_work_revision%rowtype;
  group_row private.bpay_next_workbench_group%rowtype; metadata private.bpay_next_workbench_candidate_metadata%rowtype;
  module_row private.bpay_next_module_control%rowtype; permission jsonb; witness jsonb; route text;
  facts jsonb; members jsonb; members_after jsonb; items jsonb; count_rows bigint; worker_revision bigint;
  native_sequence bigint; sequence_after bigint; native_today date:=(transaction_timestamp() at time zone 'Europe/London')::date;
  frame jsonb; frame_after jsonb; source_amount numeric; pence numeric; positive_count bigint; proof text;
  native_daily boolean:=false;v_identity_candidate uuid;v_identity_client uuid;daily_date date;daily_evidence jsonb;v_native_period jsonb;
  approval_revision_id uuid;approval_revision_id_after uuid;approval_revision jsonb;native_publication jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  perform private._weekly_source_settings_assert_request_v1(p_scope,
    array['source_group_id','source_cycle_id','client_id','week_ending'],'WEEKLY_SOURCE_CHECKLIST_ORDINARY_MONEY_SCOPE_INVALID');
  if p_timesheet_id is null or jsonb_typeof(p_scope->'source_group_id') is distinct from 'string'
    or not pg_input_is_valid(p_scope->>'source_group_id','uuid')
    or jsonb_typeof(p_scope->'source_cycle_id') is distinct from 'string' or not pg_input_is_valid(p_scope->>'source_cycle_id','uuid')
    or jsonb_typeof(p_scope->'client_id') is distinct from 'string' or not pg_input_is_valid(p_scope->>'client_id','uuid')
    or jsonb_typeof(p_scope->'week_ending') is distinct from 'string' or not pg_input_is_valid(p_scope->>'week_ending','date') then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ORDINARY_MONEY_SCOPE_INVALID' using errcode='22023'; end if;
  select u.* into actor from public.tms_users u where u.id=p_actor_user_id and u.is_active;
  if actor.id is null or (lower(btrim(coalesce(actor.role,'')))<>'admin' and not private.weekly_source_pay_actor_allowed_v1(actor.id)) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ACTOR_DENIED' using errcode='42501'; end if;
  permission:=private.weekly_source_office_authority_v1(actor.id,'VIEW_PAY_WORK',(p_scope->>'source_group_id')::uuid,
    (p_scope->>'client_id')::uuid,(p_scope->>'week_ending')::date);
  witness:=private.weekly_source_actual_timesheet_submission_v1(p_timesheet_id);
  if witness->'actual_submitted' is distinct from 'true'::jsonb or witness->>'client_id' is distinct from p_scope->>'client_id'
    or witness->>'week_ending_date' is distinct from p_scope->>'week_ending' then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ORDINARY_MONEY_SUBJECT_UNPROVED' using errcode='55000'; end if;
  if not exists(select 1 from public.weekly_source_cycles c join public.weekly_source_groups g on g.id=c.source_group_id
    join public.weekly_source_group_clients m on m.source_group_id=g.id and m.client_id=(p_scope->>'client_id')::uuid
    where c.id=(p_scope->>'source_cycle_id')::uuid and g.id=(p_scope->>'source_group_id')::uuid and g.active and g.source_family='ROSTER'
      and (p_scope->>'week_ending')::date between c.finalisation_week_ending-6 and c.finalisation_week_ending
      and (p_scope->>'week_ending')::date between m.valid_from and coalesce(m.valid_to,'infinity'::date)
      and (c.scope_client_id is null or c.scope_client_id=m.client_id)) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ORDINARY_MONEY_SCOPE_UNPROVED' using errcode='55000'; end if;
  facts:=jsonb_build_object('scope',p_scope,'actor_user_id',actor.id,'permission',permission,'actual_submission',witness,
    'amount_basis','SOURCE_EX_VAT','grain','CURRENT_ORDINARY_WORK_AVAILABLE');
  select c.* into module_row from private.bpay_next_module_control c where c.id=1;
  facts:=facts||jsonb_build_object('module',to_jsonb(module_row));
  if module_row.active_owner is distinct from 'NEXT' then
    return jsonb_build_object('known',false,'reason','NATIVE_NEXT_OWNER_UNAVAILABLE','native_facts',facts); end if;
  select t.* into root from public.timesheets t where t.timesheet_id=p_timesheet_id;
  route:=private.bpay_next_approval_route_v1(p_timesheet_id);
  facts:=facts||jsonb_build_object('root',to_jsonb(root),'native_approval_route',route);
  native_daily:=root.sheet_scope::text='DAILY' and root.contract_id is null and route='DAILY_HOURS';
  -- The real Daily publisher owns its Sunday work week. No GET calendar
  -- conversion, rate lookup or native projection refresh is introduced.
  if (not native_daily and (root.sheet_scope::text is distinct from 'WEEKLY' or root.contract_id is null or route is distinct from 'ORDINARY_HOURS'))
    or root.line_type::text is distinct from 'HOURS'
    or root.is_current is distinct from true or root.authorised_at_server is null
    or root.revoked_at is not null or root.archived_at_utc is not null
    or private.weekly_source_pay_query_scope_v1(root.timesheet_id) is not null then
    return jsonb_build_object('known',false,'reason','NATIVE_ORDINARY_WEEKLY_CONTRACT_GRAIN_UNAVAILABLE','native_facts',facts); end if;
  if not native_daily then
  select c.* into contract from public.contracts c where c.id=root.contract_id;
  if contract.id is null or contract.client_id::text is distinct from witness->>'client_id'
    or contract.candidate_id::text is distinct from witness->>'candidate_id'
    or contract.id::text is distinct from witness->>'contract_id' then
    return jsonb_build_object('known',false,'reason','NATIVE_CURRENT_CONTRACT_IDENTITY_UNAVAILABLE','native_facts',facts); end if;
    v_identity_candidate:=contract.candidate_id;v_identity_client:=contract.client_id;
  else
    v_identity_candidate:=(witness->>'candidate_id')::uuid;v_identity_client:=(witness->>'client_id')::uuid;
    daily_date:=(root.worked_start_iso at time zone 'Europe/London')::date;
    if witness->'contract_id' is distinct from 'null'::jsonb or witness->>'sheet_scope' is distinct from 'DAILY'
      or witness->>'work_date' is distinct from daily_date::text or daily_date is null
      or root.week_ending_date is distinct from daily_date+(7-extract(isodow from daily_date)::integer)
      or root.is_adjustment or root.parent_timesheet_id is not null or root.correction_id is not null then
      return jsonb_build_object('known',false,'reason','NATIVE_DAILY_SUBMISSION_IDENTITY_UNAVAILABLE','native_facts',facts); end if;
  end if;
  select count(*) into count_rows from public.timesheets t where t.booking_id=root.booking_id and t.is_current;
  if count_rows<>1 then return jsonb_build_object('known',false,'reason','NATIVE_CURRENT_BOOKING_AMBIGUOUS','native_facts',facts); end if;
  -- Match the native classifier's ALL current TF predicate, not a historical
  -- fallback or a narrower version-only query hiding another current TF.
  select count(*),(array_agg(f.id order by f.id))[1] into count_rows,financial.id from public.timesheets_financials f
    where f.timesheet_id=root.timesheet_id and f.is_current;
  if count_rows<>1 then return jsonb_build_object('known',false,'reason','NATIVE_CURRENT_FINANCIAL_AMBIGUOUS','native_facts',facts); end if;
  select f.* into strict financial from public.timesheets_financials f where f.id=financial.id;
  facts:=facts||jsonb_build_object('contract',to_jsonb(contract),'current_financial',to_jsonb(financial));
  if financial.timesheet_version is distinct from root.version or financial.is_stale is distinct from false or financial.authorised_at_utc is null
    or financial.candidate_id is distinct from v_identity_candidate or financial.client_id is distinct from v_identity_client
    or financial.pay_on_hold is distinct from true
    or (native_daily and (financial.basis::text is distinct from 'SELF_REPORTED' or financial.processed_at_utc is null
      or (financial.worked_start_iso,financial.worked_end_iso,financial.break_start_iso,financial.break_end_iso,financial.break_minutes)
        is distinct from (root.worked_start_iso,root.worked_end_iso,root.break_start_iso,root.break_end_iso,root.break_minutes))) then
    return jsonb_build_object('known',false,'reason','NATIVE_CURRENT_FINANCIAL_HOLD_UNAVAILABLE','native_facts',facts); end if;
  select count(*),(array_agg(w.id order by w.id))[1] into count_rows,work.id from private.bpay_next_work w
    join private.bpay_next_work_revision r on r.id=w.current_revision_id and r.work_id=w.id
    where w.work_kind='ORDINARY'
      and ((not native_daily and w.origin_kind='CONTRACT' and w.origin_work_date is null)
        or (native_daily and w.origin_kind='DAILY' and w.origin_work_date=daily_date))
      and w.booking_id=root.booking_id and w.contract_id is not distinct from root.contract_id and w.candidate_id=v_identity_candidate
      and w.week_ending_date=root.week_ending_date and r.source_kind='ORDINARY'
      and r.physical_timesheet_id=root.timesheet_id and r.physical_timesheet_version=root.version and r.financial_snapshot_id=financial.id;
  if count_rows<>1 then return jsonb_build_object('known',false,'reason','NATIVE_ORDINARY_WORK_IDENTITY_UNAVAILABLE','native_facts',facts); end if;
  select w.* into strict work from private.bpay_next_work w where w.id=work.id;
  select r.* into strict revision from private.bpay_next_work_revision r where r.id=work.current_revision_id and r.work_id=work.id;
  begin
    approval_revision_id:=private.bpay_next_treatment_approval_revision_v1(revision.id);
  exception when sqlstate '23514' then
    return jsonb_build_object('known',false,'reason','NATIVE_TREATMENT_APPROVAL_UNAVAILABLE',
      'native_facts',facts||jsonb_build_object('native_qualification_sqlstate',sqlstate));end;
  select to_jsonb(a) into approval_revision from private.bpay_next_work_revision a where a.id=approval_revision_id and a.work_id=work.id;
  select to_jsonb(p) into native_publication from private.bpay_next_publication p where p.work_id=work.id and p.revision_id=revision.id;
  facts:=facts||jsonb_build_object('native_approval_revision_id',approval_revision_id,'native_approval_revision',approval_revision,
    'native_treatment_publication',native_publication);
  v_native_period:=private.bpay_next_work_period_proof_v1(work.id,revision.id,native_today);
  facts:=facts||jsonb_build_object('native_work_period',v_native_period);
  if v_native_period->'valid' is distinct from 'true'::jsonb then
    return jsonb_build_object('known',false,'reason','NATIVE_WORK_PERIOD_UNAVAILABLE','native_facts',facts);end if;
  daily_evidence:=revision.daily_approval_evidence_json;
  facts:=facts||jsonb_build_object('work',to_jsonb(work),'revision',to_jsonb(revision),'native_daily',native_daily);
  if native_daily and (daily_evidence->>'contract_version' is distinct from 'BPAY_NEXT_DAILY_APPROVAL_EVIDENCE_V1'
    or daily_evidence->>'timesheet_id' is distinct from root.timesheet_id::text
    or daily_evidence->>'timesheet_version' is distinct from root.version::text
    or daily_evidence->>'financial_id' is distinct from financial.id::text
    or daily_evidence->>'booking_id' is distinct from root.booking_id
    or daily_evidence->>'candidate_id' is distinct from v_identity_candidate::text
    or daily_evidence->>'client_id' is distinct from v_identity_client::text
    or daily_evidence->>'work_date' is distinct from daily_date::text) then
    return jsonb_build_object('known',false,'reason','NATIVE_DAILY_APPROVAL_EVIDENCE_UNAVAILABLE','native_facts',facts); end if;
  if work.approval_state<>'APPROVED' or work.applied_revision_id is distinct from revision.id or revision.sealed_at_utc is null
    or revision.source_head_id is not null or revision.source_event_id is not null
    or revision.source_pay_channel is distinct from upper(financial.pay_method)
    or (select count(*) from private.bpay_next_approved_line l where l.revision_id=revision.id)<>revision.expected_line_count
    or work.pay_hold is distinct from true or work.pay_hold_control_version is null or work.pay_hold_control_version<=0 or work.pay_hold_changed_at_utc is null
    or work.pay_hold_physical_timesheet_id is distinct from root.timesheet_id or work.pay_hold_financial_id is distinct from financial.id
    or work.pay_hold_reason is distinct from financial.pay_on_hold_reason then
    return jsonb_build_object('known',false,'reason','NATIVE_CURRENT_SEALED_HOLD_CONTROL_UNAVAILABLE','native_facts',facts); end if;
  select g.* into group_row from private.bpay_next_workbench_group g where g.group_key='WORK:'||work.id::text and g.work_id=work.id;
  select m.* into metadata from private.bpay_next_workbench_candidate_metadata m where m.candidate_id=work.candidate_id;
  select c.financial_view_revision into worker_revision from private.bpay_next_worker_control c where c.candidate_id=work.candidate_id;
  facts:=facts||jsonb_build_object('group',to_jsonb(group_row),'metadata',to_jsonb(metadata),'worker_financial_view_revision',worker_revision);
  if group_row.group_key is null or metadata.candidate_id is null or worker_revision is null
    or group_row.group_kind<>'WORK' or group_row.complete is distinct from true or group_row.dirty is distinct from false or group_row.progress_state<>'CURRENT'
    or group_row.current_revision_id is distinct from revision.id or group_row.physical_timesheet_id is distinct from root.timesheet_id
    or group_row.candidate_id is distinct from v_identity_candidate or group_row.client_id is distinct from v_identity_client
    or group_row.contract_id is distinct from root.contract_id or group_row.week_ending_date is distinct from root.week_ending_date
    or group_row.financial_view_revision is distinct from worker_revision or metadata.continuation_pending is distinct from false
    or metadata.adopted_metadata_version is distinct from metadata.metadata_version or group_row.metadata_version is distinct from metadata.metadata_version
    or not exists(select 1 from public.candidates c left join public.umbrellas u on u.id=c.umbrella_id
      where c.id=work.candidate_id and c.active and c.pay_method::text in('PAYE','UMBRELLA') and group_row.target_pay_channel=c.pay_method::text
        and (c.pay_method::text<>'UMBRELLA' or (u.enabled and u.vat_chargeable is not null))) then
    return jsonb_build_object('known',false,'reason','NATIVE_CURRENT_PROJECTION_METADATA_UNAVAILABLE','native_facts',facts); end if;
  begin
    select coalesce(jsonb_agg(to_jsonb(m) order by m.component_key,m.segment_key nulls first),'[]'::jsonb) into members
      from private.weekly_source_checklist_native_members_core_v1(work.id,revision.id,false) m;
  exception when sqlstate '55000' or sqlstate '23514' or no_data_found or too_many_rows then
    return jsonb_build_object('known',false,'reason','NATIVE_MEMBER_CERTIFICATE_UNAVAILABLE',
      'native_facts',facts||jsonb_build_object('native_qualification_sqlstate',sqlstate)); end;
  select coalesce(jsonb_agg(to_jsonb(i) order by i.component_key,i.member_key,i.portion_kind),'[]'::jsonb) into items
    from private.bpay_next_workbench_item i where i.group_key=group_row.group_key;
  facts:=facts||jsonb_build_object('members',members,'items',items);
  if jsonb_array_length(members)=0 or exists(select 1 from jsonb_array_elements(members) m
      where m->'parent_complete' is distinct from 'true'::jsonb or m->'segment_attribution_complete' is distinct from 'true'::jsonb)
    or exists(select 1 from jsonb_array_elements(members) m group by m->>'component_key',m->>'segment_key' having count(*)<>1)
    or exists(select 1 from private.bpay_next_workbench_item i where i.group_key=group_row.group_key and
      (i.work_id is distinct from work.id or i.revision_id is distinct from revision.id or i.progress_state<>'CURRENT'
        or i.projection_revision is distinct from group_row.projection_revision or i.financial_view_revision is distinct from worker_revision
        or i.metadata_version is distinct from metadata.metadata_version or i.amount_known is distinct from true
        or i.candidate_id is distinct from v_identity_candidate or i.client_id is distinct from v_identity_client or i.contract_id is distinct from root.contract_id
        or i.physical_timesheet_id is distinct from root.timesheet_id or i.week_ending_date is distinct from root.week_ending_date
        or i.target_pay_channel is distinct from group_row.target_pay_channel or i.is_selected is null or i.selectable is null
        or i.query_qualified is null or i.query_state is null or i.reason_code is null or i.reason_priority is null or i.section is null)) then
    return jsonb_build_object('known',false,'reason','NATIVE_COMPLETE_MEMBER_PROJECTION_UNAVAILABLE','native_facts',facts); end if;
  -- Aggregate the native split ONCE for all members. This is a conservation
  -- comparison, not a new GREATEST/priority/quantity classification.
  if exists(with projected as (
      select i.component_key,i.member_kind,i.member_key,i.approved_line_id,i.approved_segment_id,
        count(*) n,sum(i.approved_source_ex_vat) a,sum(i.realised_source_ex_vat) c,sum(i.active_reserved_source_ex_vat) h,
        sum(i.residual_source_ex_vat) residual,
        sum(i.included_source_ex_vat+i.excluded_source_ex_vat-i.recovery_source_ex_vat-i.held_overhang_source_ex_vat) split_residual
      from private.bpay_next_workbench_item i where i.group_key=group_row.group_key
      group by i.component_key,i.member_kind,i.member_key,i.approved_line_id,i.approved_segment_id)
    select 1 from jsonb_array_elements(members) m left join projected p on p.component_key=m->>'component_key'
      and p.member_kind=case when m->>'segment_key' is null then 'WORK_COMPONENT' else 'WORK_SEGMENT' end
      and p.member_key=coalesce(m->>'segment_key',m->>'component_key')
      and p.approved_line_id is not distinct from (m->>'approved_line_id')::uuid
      and p.approved_segment_id is not distinct from (m->>'approved_segment_id')::uuid
    where p.n is null or (p.a,p.c,p.h,p.residual,p.split_residual) is distinct from
      ((m->>'approved_amount')::numeric,(m->>'realised_amount')::numeric,(m->>'held_amount')::numeric,
        (m->>'approved_amount')::numeric-(m->>'realised_amount')::numeric-(m->>'held_amount')::numeric,
        (m->>'approved_amount')::numeric-(m->>'realised_amount')::numeric-(m->>'held_amount')::numeric))
    or exists(select 1 from private.bpay_next_workbench_item i where i.group_key=group_row.group_key and not exists(
      select 1 from jsonb_array_elements(members) m where m->>'component_key'=i.component_key and coalesce(m->>'segment_key',m->>'component_key')=i.member_key
        and (m->>'approved_line_id')::uuid is not distinct from i.approved_line_id and (m->>'approved_segment_id')::uuid is not distinct from i.approved_segment_id
        and i.member_kind=case when m->>'segment_key' is null then 'WORK_COMPONENT' else 'WORK_SEGMENT' end
        and i.segment_key is not distinct from m->>'segment_key' and i.component_kind is not distinct from m->>'component_kind'
        and i.source_pay_channel is not distinct from m->>'source_pay_channel' and i.work_date is not distinct from (m->>'work_date')::date)) then
    return jsonb_build_object('known',false,'reason','NATIVE_FULL_MEMBER_CONSERVATION_UNAVAILABLE','native_facts',facts); end if;
  select c.last_sequence into native_sequence from private.bpay_next_command_clock c where c.id=1;
  if native_sequence is null or root.week_ending_date-6>native_today then
    return jsonb_build_object('known',false,'reason','NATIVE_CURRENT_CUT_UNAVAILABLE','native_facts',facts); end if;
  -- The native writer alone classified PAY_ON_HOLD. Recheck actual accepted
  -- and snooze owners; no cached null or higher-priority caption proves a cut.
  if exists(select 1 from private.bpay_next_workbench_item i where i.group_key=group_row.group_key
    and i.portion_kind='AVAILABLE' and not i.is_selected and i.included_source_ex_vat>0 and
      (exists(select 1 from private.bpay_next_workbench_accepted_work_v1(work.id,i.component_key,i.segment_key))
        or private.bpay_next_snooze_at_cut_v1(work.id,revision.id,i.segment_key,i.component_key,native_sequence,native_today) is not null
        or i.reason_code<>'PAY_ON_HOLD' or i.reason_priority<>40 or i.section<>'BLOCKED' or i.selectable
        or i.pay_hold is distinct from true or i.pay_hold_reason is distinct from financial.pay_on_hold_reason
        or i.query_qualified is distinct from false or i.query_state<>'NOT_APPLICABLE'
        or i.direction<>'PAYMENT' or i.accepted_run_id is not null or i.accepted_command_id is not null)) then
    return jsonb_build_object('known',false,'reason','NATIVE_POSITIVE_HOLD_CLASSIFICATION_UNAVAILABLE','native_facts',facts); end if;
  select count(*),sum(i.included_source_ex_vat) into positive_count,source_amount from private.bpay_next_workbench_item i
    where i.group_key=group_row.group_key and i.portion_kind='AVAILABLE' and not i.is_selected and i.included_source_ex_vat>0
      and i.reason_code='PAY_ON_HOLD' and i.reason_priority=40 and i.section='BLOCKED' and not i.selectable and i.direction='PAYMENT'
      and i.pay_hold and not i.query_qualified and i.query_state='NOT_APPLICABLE' and i.accepted_run_id is null and i.accepted_command_id is null;
  if positive_count=0 or source_amount is null or source_amount<=0 then
    return jsonb_build_object('known',false,'reason','NATIVE_POSITIVE_AVAILABLE_HOLD_AMOUNT_UNAVAILABLE','native_facts',facts); end if;
  frame:=jsonb_build_object('root',to_jsonb(root),'financial',to_jsonb(financial),'contract',case when root.contract_id is null then null else to_jsonb(contract) end,'work',to_jsonb(work),
    'revision',to_jsonb(revision),'group',to_jsonb(group_row),'metadata',to_jsonb(metadata),'worker_revision',worker_revision,'items',items,'module',to_jsonb(module_row));
  select jsonb_build_object('root',to_jsonb(t),'financial',to_jsonb(f),'contract',case when t.contract_id is null then null else to_jsonb(c) end,'work',to_jsonb(w),'revision',to_jsonb(r),
    'group',to_jsonb(g),'metadata',to_jsonb(md),'worker_revision',ctl.financial_view_revision,'module',to_jsonb(module),
    'items',(select coalesce(jsonb_agg(to_jsonb(i) order by i.component_key,i.member_key,i.portion_kind),'[]'::jsonb)
      from private.bpay_next_workbench_item i where i.group_key=g.group_key)) into frame_after
    from public.timesheets t join public.timesheets_financials f on f.id=financial.id left join public.contracts c on c.id=t.contract_id
    join private.bpay_next_work w on w.id=work.id join private.bpay_next_work_revision r on r.id=w.current_revision_id and r.work_id=w.id
    join private.bpay_next_workbench_group g on g.group_key=group_row.group_key join private.bpay_next_workbench_candidate_metadata md on md.candidate_id=w.candidate_id
    join private.bpay_next_worker_control ctl on ctl.candidate_id=w.candidate_id join private.bpay_next_module_control module on module.id=1
    where t.timesheet_id=root.timesheet_id;
  begin
    select coalesce(jsonb_agg(to_jsonb(m) order by m.component_key,m.segment_key nulls first),'[]'::jsonb) into members_after
      from private.weekly_source_checklist_native_members_core_v1(work.id,revision.id,false) m;
  exception when sqlstate '55000' or sqlstate '23514' or no_data_found or too_many_rows then
    return jsonb_build_object('known',false,'reason','NATIVE_MEMBER_CERTIFICATE_CHANGED',
      'native_facts',facts||jsonb_build_object('native_qualification_sqlstate',sqlstate)); end;
  select c.last_sequence into sequence_after from private.bpay_next_command_clock c where c.id=1;
  permission:=private.weekly_source_office_authority_v1(actor.id,'VIEW_PAY_WORK',(p_scope->>'source_group_id')::uuid,
    (p_scope->>'client_id')::uuid,(p_scope->>'week_ending')::date);
  begin
    approval_revision_id_after:=private.bpay_next_treatment_approval_revision_v1(revision.id);
  exception when sqlstate '23514' then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001';end;
  if approval_revision_id is distinct from approval_revision_id_after
    or approval_revision is distinct from (select to_jsonb(a) from private.bpay_next_work_revision a where a.id=approval_revision_id and a.work_id=work.id)
    or native_publication is distinct from (select to_jsonb(p) from private.bpay_next_publication p where p.work_id=work.id and p.revision_id=revision.id)
    or v_native_period is distinct from private.bpay_next_work_period_proof_v1(work.id,revision.id,native_today)
    or frame is distinct from frame_after or members is distinct from members_after or native_sequence is distinct from sequence_after
    or witness is distinct from private.weekly_source_actual_timesheet_submission_v1(root.timesheet_id)
    or (select count(*) from public.timesheets t where t.booking_id=root.booking_id and t.is_current)<>1
    or (select count(*) from public.timesheets_financials f where f.timesheet_id=root.timesheet_id and f.is_current)<>1 then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001'; end if;
  if not exists(select 1 from public.tms_users u where u.id=actor.id and u.is_active
    and (lower(btrim(coalesce(u.role,'')))='admin' or private.weekly_source_pay_actor_allowed_v1(u.id))) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ACTOR_DENIED' using errcode='42501'; end if;
  pence:=source_amount*100;
  if pence<>trunc(pence) or pence<1 or pence>999999999999999999 then
    return jsonb_build_object('known',false,'reason','NATIVE_MINOR_UNIT_RANGE_UNAVAILABLE','native_facts',facts); end if;
  facts:=facts||jsonb_build_object('native_sequence',native_sequence,'native_business_date',native_today,
    'positive_available_item_count',positive_count,'withheld_available_source_ex_vat',source_amount);
  proof:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECKLIST_ORDINARY_NEXT_AVAILABLE_HOLD_V1',facts),'hex');
  return jsonb_build_object('known',true,'native_facts',facts,
    'worker',coalesce(nullif(btrim(metadata.candidate_sort_name),''),work.candidate_id::text),
    'sheet_scope',root.sheet_scope::text,'work_date',case when native_daily then daily_date else root.week_ending_date end,
    'status',jsonb_build_object('text','Holds pay','tone','danger','subtext','Pay held: £'||to_char(source_amount,'FM9999999999999990.00')||
      case when native_daily then ' ex VAT for '||to_char(daily_date,'DD/MM/YYYY')
        else ' ex VAT for w/e '||to_char(root.week_ending_date,'DD/MM/YYYY') end||' · '||coalesce(financial.pay_on_hold_reason,'Pay on hold'), 'subtone','muted'),
    'native_ordinary_money_witness',jsonb_build_object('owner','private.bpay_next_workbench_refresh_work_core_v1',
      'actor_user_id',actor.id,'scope',p_scope,'timesheet_id',root.timesheet_id,'financial_id',financial.id,'work_id',work.id,
      'revision_id',revision.id,'amount_basis','SOURCE_EX_VAT','grain','CURRENT_ORDINARY_WORK_AVAILABLE',
      'daily_work_date',case when native_daily then daily_date end,'counts_for_row_admission',false,'read_proof_hash',proof),
    'hold',jsonb_build_object('holds_pay',true,'holds_pay_scope','TIMESHEET','withheld_amount_pence',pence::bigint::text,
      'holds_invoice',null,'pending_decision',null,
      'authority',jsonb_build_object('owner','ORDINARY_NEXT_AVAILABLE_EX_VAT','hash',proof,'withholding_known',true)));
end;
$ordinary_hold$;

create or replace function private.weekly_source_checklist_source_shift_query_money_v1(
  p_root_timesheet_id uuid,p_work_event_id uuid,p_scope jsonb,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare actor public.tms_users%rowtype; root public.timesheets%rowtype; financial public.timesheets_financials%rowtype;
  event public.weekly_work_events%rowtype; work private.bpay_next_work%rowtype; revision private.bpay_next_work_revision%rowtype;
  group_row private.bpay_next_workbench_group%rowtype; metadata private.bpay_next_workbench_candidate_metadata%rowtype;
  gate jsonb; gate_after jsonb; native_scope jsonb; exclusions jsonb; members jsonb; members_after jsonb; member jsonb; items jsonb;
  count_rows bigint; worker_revision bigint; approval_revision_id uuid; source_event_id uuid; native_sequence bigint;
  native_today date:=(transaction_timestamp() at time zone 'Europe/London')::date;
  totals record; actual_member_count bigint; matching_count bigint; positive_count bigint; source_amount numeric; pence numeric;
  facts jsonb; proof_hash text; permission jsonb; current_frame jsonb; current_frame_after jsonb;v_native_period jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  perform private._weekly_source_settings_assert_request_v1(p_scope,
    array['source_group_id','source_cycle_id','client_id','week_ending'],'WEEKLY_SOURCE_CHECKLIST_SOURCE_MONEY_SCOPE_INVALID');
  if jsonb_typeof(p_scope->'source_group_id') is distinct from 'string' or not pg_input_is_valid(p_scope->>'source_group_id','uuid')
    or jsonb_typeof(p_scope->'source_cycle_id') is distinct from 'string' or not pg_input_is_valid(p_scope->>'source_cycle_id','uuid')
    or jsonb_typeof(p_scope->'client_id') is distinct from 'string' or not pg_input_is_valid(p_scope->>'client_id','uuid')
    or jsonb_typeof(p_scope->'week_ending') is distinct from 'string' or not pg_input_is_valid(p_scope->>'week_ending','date')
    or p_root_timesheet_id is null or p_work_event_id is null then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_SOURCE_MONEY_SCOPE_INVALID' using errcode='22023';
  end if;
  select u.* into actor from public.tms_users u where u.id=p_actor_user_id and u.is_active;
  if actor.id is null or (lower(btrim(coalesce(actor.role,'')))<>'admin' and not private.weekly_source_pay_actor_allowed_v1(actor.id)) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ACTOR_DENIED' using errcode='42501';
  end if;
  permission:=private.weekly_source_office_authority_v1(actor.id,'VIEW_PAY_WORK',(p_scope->>'source_group_id')::uuid,
    (p_scope->>'client_id')::uuid,(p_scope->>'week_ending')::date);
  facts:=jsonb_build_object('scope',p_scope,'actor_user_id',actor.id,'permission',permission,
    'root_timesheet_id',p_root_timesheet_id,'work_event_id',p_work_event_id,'amount_basis','SOURCE_EX_VAT','grain','WORK_SEGMENT');
  if not exists(select 1 from private.bpay_next_module_control c where c.id=1 and c.active_owner='NEXT') then
    return jsonb_build_object('known',false,'reason','NATIVE_NEXT_OWNER_UNAVAILABLE','native_facts',facts);
  end if;
  select t.* into root from public.timesheets t where t.timesheet_id=p_root_timesheet_id;
  native_scope:=private.weekly_source_pay_query_scope_v1(p_root_timesheet_id);
  select e.* into event from public.weekly_work_events e where e.id=p_work_event_id
    and e.client_id=(p_scope->>'client_id')::uuid and e.first_source_group_id=(p_scope->>'source_group_id')::uuid
    and e.work_date between (p_scope->>'week_ending')::date-6 and (p_scope->>'week_ending')::date;
  facts:=facts||jsonb_build_object('native_scope',native_scope,'root',to_jsonb(root),'work_event',to_jsonb(event));
  if native_scope is null or root.authorised_at_server is null or event.id is null
    or root.is_current is distinct from true or root.revoked_at is not null or root.archived_at_utc is not null
    or native_scope->>'root_timesheet_id' is distinct from root.timesheet_id::text
    or native_scope->>'client_id' is distinct from p_scope->>'client_id'
    or native_scope->>'candidate_id' is distinct from event.candidate_id::text
    or native_scope->>'week_ending_date' is distinct from p_scope->>'week_ending'
    or not exists(select 1 from public.weekly_source_row_timesheet_lineages l
      where l.work_event_id=event.id and l.timesheet_id=root.timesheet_id)
    or not exists(select 1 from public.weekly_source_cycles c join public.weekly_source_group_clients m on m.source_group_id=c.source_group_id
      where c.id=(p_scope->>'source_cycle_id')::uuid and c.source_group_id=(p_scope->>'source_group_id')::uuid
        and m.client_id=event.client_id and event.work_date between m.valid_from and coalesce(m.valid_to,'infinity'::date)
        and root.week_ending_date between c.finalisation_week_ending-6 and c.finalisation_week_ending
        and (c.scope_client_id is null or c.scope_client_id=event.client_id)) then
    return jsonb_build_object('known',false,'reason','ACTUAL_SOURCE_SHIFT_SCOPE_UNAVAILABLE','native_facts',facts);
  end if;
  select count(*),(array_agg(f.id order by f.id))[1] into count_rows,financial.id from public.timesheets_financials f
    where f.timesheet_id=root.timesheet_id and f.timesheet_version=root.version and f.is_current;
  if count_rows<>1 then return jsonb_build_object('known',false,'reason','CURRENT_FINANCIAL_IDENTITY_UNAVAILABLE','native_facts',facts); end if;
  select f.* into strict financial from public.timesheets_financials f where f.id=financial.id;
  facts:=facts||jsonb_build_object('current_financial',to_jsonb(financial));
  if financial.is_stale is distinct from false or financial.authorised_at_utc is null
    or financial.candidate_id is distinct from event.candidate_id or financial.client_id is distinct from event.client_id
    or coalesce(financial.pay_on_hold,false) then
    return jsonb_build_object('known',false,'reason','CURRENT_FINANCIAL_OR_OTHER_HOLD_UNAVAILABLE','native_facts',facts);
  end if;
  select count(*),(array_agg(w.id order by w.id))[1] into count_rows,work.id
    from private.bpay_next_work w join private.bpay_next_work_revision r on r.id=w.current_revision_id and r.work_id=w.id
    where w.work_kind='SOURCE' and w.candidate_id=event.candidate_id and w.contract_id=(native_scope->>'contract_id')::uuid
      and w.booking_id=root.booking_id and w.week_ending_date=root.week_ending_date
      and r.physical_timesheet_id=root.timesheet_id and r.physical_timesheet_version=root.version
      and r.source_kind in('SOURCE','PROTECTED');
  if count_rows<>1 then return jsonb_build_object('known',false,'reason','NATIVE_WORK_IDENTITY_UNAVAILABLE','native_facts',facts); end if;
  select w.* into strict work from private.bpay_next_work w where w.id=work.id;
  select r.* into strict revision from private.bpay_next_work_revision r where r.id=work.current_revision_id and r.work_id=work.id;
  v_native_period:=private.bpay_next_work_period_proof_v1(work.id,revision.id,native_today);
  facts:=facts||jsonb_build_object('work',to_jsonb(work),'revision',to_jsonb(revision),'native_work_period',v_native_period);
  if v_native_period->'valid' is distinct from 'true'::jsonb then
    return jsonb_build_object('known',false,'reason','NATIVE_WORK_PERIOD_UNAVAILABLE','native_facts',facts);end if;
  if work.approval_state<>'APPROVED' or work.applied_revision_id is distinct from revision.id or revision.sealed_at_utc is null
    or (select count(*) from private.bpay_next_approved_line l where l.revision_id=revision.id)<>revision.expected_line_count then
    return jsonb_build_object('known',false,'reason','NATIVE_CURRENT_SEALED_WORK_UNAVAILABLE','native_facts',facts);
  end if;
  approval_revision_id:=revision.id;source_event_id:=revision.source_event_id;
  if revision.payment_treatment_approval_revision_id is not null then
    approval_revision_id:=private.bpay_next_treatment_approval_revision_v1(revision.id);
    select r.source_event_id into source_event_id from private.bpay_next_work_revision r where r.id=approval_revision_id and r.work_id=work.id;
  end if;
  if source_event_id is null then return jsonb_build_object('known',false,'reason','NATIVE_SOURCE_EVENT_UNAVAILABLE','native_facts',facts); end if;
  select g.* into group_row from private.bpay_next_workbench_group g where g.group_key='WORK:'||work.id::text and g.work_id=work.id;
  select m.* into metadata from private.bpay_next_workbench_candidate_metadata m where m.candidate_id=work.candidate_id;
  select c.financial_view_revision into worker_revision from private.bpay_next_worker_control c where c.candidate_id=work.candidate_id;
  facts:=facts||jsonb_build_object('group',to_jsonb(group_row),'metadata',to_jsonb(metadata),'worker_financial_view_revision',worker_revision);
  if group_row.group_key is null or metadata.candidate_id is null or worker_revision is null
    or group_row.group_kind<>'WORK' or group_row.complete is distinct from true or group_row.dirty is distinct from false or group_row.progress_state<>'CURRENT'
    or group_row.current_revision_id is distinct from revision.id or group_row.physical_timesheet_id is distinct from root.timesheet_id
    or group_row.candidate_id is distinct from event.candidate_id or group_row.client_id is distinct from event.client_id
    or group_row.contract_id is distinct from work.contract_id or group_row.week_ending_date is distinct from root.week_ending_date
    or group_row.financial_view_revision is distinct from worker_revision or metadata.continuation_pending is distinct from false
    or metadata.adopted_metadata_version is distinct from metadata.metadata_version or group_row.metadata_version is distinct from metadata.metadata_version
    or not exists(select 1 from public.candidates c left join public.umbrellas u on u.id=c.umbrella_id
      where c.id=work.candidate_id and c.active and c.pay_method::text in('PAYE','UMBRELLA')
        and group_row.target_pay_channel=c.pay_method::text
        and (c.pay_method::text<>'UMBRELLA' or (u.enabled and u.vat_chargeable is not null))) then
    return jsonb_build_object('known',false,'reason','NATIVE_PROJECTION_FRESHNESS_UNAVAILABLE','native_facts',facts);
  end if;
  gate:=private.weekly_source_pay_query_gate_v1(root.timesheet_id);
  facts:=facts||jsonb_build_object('query_gate',gate);
  if gate->'ok' is distinct from 'true'::jsonb or gate->>'code' is distinct from 'OK' or gate->'scope' is distinct from native_scope
    or gate->'blocked' is distinct from 'true'::jsonb then
    return jsonb_build_object('known',false,'reason','NATIVE_OPEN_QUERY_SCOPE_UNAVAILABLE','native_facts',facts);
  end if;
  exclusions:=private.bpay_next_source_query_segment_exclusions_v1(revision.id,gate);
  facts:=facts||jsonb_build_object('segment_query_exclusions',exclusions);
  if jsonb_typeof(exclusions) is distinct from 'array' or not exists(select 1 from jsonb_array_elements(exclusions) e where e->>'segment_key'=event.id::text) then
    return jsonb_build_object('known',false,'reason','NATIVE_SHIFT_QUERY_EXCLUSION_UNAVAILABLE','native_facts',facts);
  end if;
  -- This is the SAME complete native member/binding/publication/command/job/
  -- treatment/attribution derivation consumed by the native locked wrapper.
  -- No new positive amount is computed, and no browser can select its mode.
  begin
    select coalesce(jsonb_agg(to_jsonb(m) order by m.component_key,m.segment_key nulls first),'[]'::jsonb),count(*)
      into members,actual_member_count from private.weekly_source_checklist_native_members_core_v1(work.id,revision.id,false) m;
  exception when sqlstate '55000' or sqlstate '23514' or no_data_found or too_many_rows then
    return jsonb_build_object('known',false,'reason','NATIVE_BINDING_MEMBER_CERTIFICATE_UNAVAILABLE',
      'native_facts',facts||jsonb_build_object('native_qualification_sqlstate',sqlstate));
  end;
  select coalesce(jsonb_agg(to_jsonb(i) order by i.component_key,i.member_key,i.portion_kind),'[]'::jsonb)
    into items from private.bpay_next_workbench_item i where i.group_key=group_row.group_key;
  facts:=facts||jsonb_build_object('members',members,'items',items,'source_event_id',source_event_id);
  if actual_member_count=0 or exists(select 1 from jsonb_array_elements(members) m
    where m->'parent_complete' is distinct from 'true'::jsonb or m->'segment_attribution_complete' is distinct from 'true'::jsonb)
    or exists(select 1 from jsonb_array_elements(members) m group by m->>'component_key',m->>'segment_key' having count(*)<>1)
    or exists(select 1 from private.bpay_next_workbench_item i where i.group_key=group_row.group_key and
      (i.work_id is distinct from work.id or i.revision_id is distinct from revision.id or i.progress_state<>'CURRENT'
        or i.projection_revision is distinct from group_row.projection_revision or i.financial_view_revision is distinct from worker_revision
        or i.metadata_version is distinct from metadata.metadata_version or i.amount_known is distinct from true
        or i.candidate_id is distinct from event.candidate_id or i.client_id is distinct from event.client_id
        or i.contract_id is distinct from work.contract_id or i.physical_timesheet_id is distinct from root.timesheet_id
        or i.week_ending_date is distinct from root.week_ending_date
        or i.target_pay_channel is distinct from group_row.target_pay_channel)) then
    return jsonb_build_object('known',false,'reason','NATIVE_COMPLETE_MEMBER_PROJECTION_UNAVAILABLE','native_facts',facts);
  end if;
  -- Reprove full actual membership and the native conserved member quantities.
  -- Do not reproduce GREATEST(A-C-H), a priority ladder or a booking quantity.
  for member in select value from jsonb_array_elements(members) loop
    select count(*),sum(i.approved_source_ex_vat) a,sum(i.realised_source_ex_vat) c,sum(i.active_reserved_source_ex_vat) h,
      sum(i.residual_source_ex_vat) residual,
      sum(i.included_source_ex_vat+i.excluded_source_ex_vat-i.recovery_source_ex_vat-i.held_overhang_source_ex_vat) split_residual
      into totals from private.bpay_next_workbench_item i where i.group_key=group_row.group_key and i.component_key=member->>'component_key'
        and i.member_kind=case when member->>'segment_key' is null then 'WORK_COMPONENT' else 'WORK_SEGMENT' end
        and i.member_key=coalesce(member->>'segment_key',member->>'component_key')
        and i.approved_line_id is not distinct from (member->>'approved_line_id')::uuid
        and i.approved_segment_id is not distinct from (member->>'approved_segment_id')::uuid;
    if totals.count=0 or (totals.a,totals.c,totals.h,totals.residual,totals.split_residual) is distinct from
      ((member->>'approved_amount')::numeric,(member->>'realised_amount')::numeric,(member->>'held_amount')::numeric,
        (member->>'approved_amount')::numeric-(member->>'realised_amount')::numeric-(member->>'held_amount')::numeric,
        (member->>'approved_amount')::numeric-(member->>'realised_amount')::numeric-(member->>'held_amount')::numeric) then
      return jsonb_build_object('known',false,'reason','NATIVE_MEMBER_CONSERVATION_UNAVAILABLE','native_facts',facts);
    end if;
  end loop;
  if exists(select 1 from private.bpay_next_workbench_item i where i.group_key=group_row.group_key and not exists(
    select 1 from jsonb_array_elements(members) m where m->>'component_key'=i.component_key
      and coalesce(m->>'segment_key',m->>'component_key')=i.member_key
      and (m->>'approved_line_id')::uuid is not distinct from i.approved_line_id
      and (m->>'approved_segment_id')::uuid is not distinct from i.approved_segment_id
      and i.member_kind=case when m->>'segment_key' is null then 'WORK_COMPONENT' else 'WORK_SEGMENT' end
      and i.segment_key is not distinct from m->>'segment_key'
      and i.component_kind is not distinct from m->>'component_kind'
      and i.source_pay_channel is not distinct from m->>'source_pay_channel'
      and i.work_date is not distinct from (m->>'work_date')::date)) then
    return jsonb_build_object('known',false,'reason','NATIVE_FOREIGN_MEMBER_PROJECTION_UNAVAILABLE','native_facts',facts);
  end if;
  select count(*) into matching_count from jsonb_array_elements(members) m
    where m->>'segment_key'=event.id::text and m->>'component_kind' in('WORK','PROTECTED_WORK');
  select c.last_sequence into native_sequence from private.bpay_next_command_clock c where c.id=1;
  -- Reuse the exact current native accepted/snooze readers. Their genuine
  -- frozen selection/cut is never inferred from a cached null accepted ID.
  if native_sequence is null or root.week_ending_date-6>native_today
    or exists(select 1 from private.bpay_next_workbench_item i where i.group_key=group_row.group_key
      and i.segment_key=event.id::text and i.component_kind in('WORK','PROTECTED_WORK') and i.portion_kind='AVAILABLE'
      and (exists(select 1 from private.bpay_next_workbench_accepted_work_v1(work.id,i.component_key,i.segment_key))
        or private.bpay_next_snooze_at_cut_v1(work.id,revision.id,i.segment_key,i.component_key,native_sequence,native_today) is not null)) then
    return jsonb_build_object('known',false,'reason','NATIVE_CURRENT_ACCEPTED_OR_EXCLUDED_CUT_UNAVAILABLE',
      'native_facts',facts||jsonb_build_object('native_sequence',native_sequence,'native_business_date',native_today));
  end if;
  select count(*),sum(i.included_source_ex_vat) into positive_count,source_amount from private.bpay_next_workbench_item i
    where i.group_key=group_row.group_key and i.member_kind='WORK_SEGMENT' and i.segment_key=event.id::text
      and i.component_kind in('WORK','PROTECTED_WORK') and i.portion_kind='AVAILABLE' and i.direction='PAYMENT'
      and i.query_qualified and i.query_state='OPEN' and i.reason_code='PAY_QUERY_OPEN' and i.section='ACTION'
      and not i.selectable and not i.is_selected and i.amount_known and i.included_source_ex_vat>0
      and i.pay_hold is false and i.accepted_run_id is null and i.accepted_command_id is null;
  if matching_count=0 or positive_count=0 or source_amount is null or source_amount<=0 or exists(
    select 1 from private.bpay_next_workbench_item i where i.group_key=group_row.group_key and i.segment_key=event.id::text
      and i.component_kind in('WORK','PROTECTED_WORK') and i.portion_kind='AVAILABLE' and not i.is_selected and i.included_source_ex_vat>0
      and (i.query_qualified is distinct from true or i.query_state<>'OPEN' or i.reason_code<>'PAY_QUERY_OPEN' or i.section<>'ACTION')) then
    return jsonb_build_object('known',false,'reason','NATIVE_POSITIVE_QUERY_MONEY_UNAVAILABLE','native_facts',facts);
  end if;
  -- The false-mode native core is VOLATILE to preserve its original locked
  -- caller. Recheck its entire observation before certifying a GET, rather
  -- than treating a dirty flag or binding timestamp as a sealed snapshot.
  current_frame:=jsonb_build_object('root',to_jsonb(root),'financial',to_jsonb(financial),'event',to_jsonb(event),
    'work',to_jsonb(work),'revision',to_jsonb(revision),'group',to_jsonb(group_row),'metadata',to_jsonb(metadata),
    'worker_revision',worker_revision,'items',items);
  select jsonb_build_object('root',to_jsonb(t),'financial',to_jsonb(f),'event',to_jsonb(e),'work',to_jsonb(w),'revision',to_jsonb(r),
    'group',to_jsonb(g),'metadata',to_jsonb(md),'worker_revision',ctl.financial_view_revision,
    'items',(select coalesce(jsonb_agg(to_jsonb(i) order by i.component_key,i.member_key,i.portion_kind),'[]'::jsonb)
      from private.bpay_next_workbench_item i where i.group_key=g.group_key)) into current_frame_after
    from public.timesheets t join public.timesheets_financials f on f.id=financial.id
    join public.weekly_work_events e on e.id=event.id join private.bpay_next_work w on w.id=work.id
    join private.bpay_next_work_revision r on r.id=w.current_revision_id and r.work_id=w.id
    join private.bpay_next_workbench_group g on g.group_key=group_row.group_key
    join private.bpay_next_workbench_candidate_metadata md on md.candidate_id=w.candidate_id
    join private.bpay_next_worker_control ctl on ctl.candidate_id=w.candidate_id where t.timesheet_id=root.timesheet_id;
  begin
    select coalesce(jsonb_agg(to_jsonb(m) order by m.component_key,m.segment_key nulls first),'[]'::jsonb)
      into members_after from private.weekly_source_checklist_native_members_core_v1(work.id,revision.id,false) m;
  exception when sqlstate '55000' or sqlstate '23514' or no_data_found or too_many_rows then
    return jsonb_build_object('known',false,'reason','NATIVE_BINDING_MEMBER_CERTIFICATE_CHANGED',
      'native_facts',facts||jsonb_build_object('native_qualification_sqlstate',sqlstate));
  end;
  gate_after:=private.weekly_source_pay_query_gate_v1(root.timesheet_id);
  permission:=private.weekly_source_office_authority_v1(actor.id,'VIEW_PAY_WORK',(p_scope->>'source_group_id')::uuid,
    (p_scope->>'client_id')::uuid,(p_scope->>'week_ending')::date);
  if v_native_period is distinct from private.bpay_next_work_period_proof_v1(work.id,revision.id,native_today)
    or current_frame_after is distinct from current_frame or members_after is distinct from members or gate_after is distinct from gate
    or exclusions is distinct from private.bpay_next_source_query_segment_exclusions_v1(revision.id,gate_after) then
    return jsonb_build_object('known',false,'reason','NATIVE_COMPLETE_OBSERVATION_CHANGED','native_facts',facts);
  end if;
  if not exists(select 1 from public.tms_users u where u.id=actor.id and u.is_active
    and (lower(btrim(coalesce(u.role,'')))='admin' or private.weekly_source_pay_actor_allowed_v1(u.id))) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ACTOR_DENIED' using errcode='42501';
  end if;
  pence:=source_amount*100;
  if pence<>trunc(pence) or pence<1 or pence>999999999999999999 then
    return jsonb_build_object('known',false,'reason','NATIVE_MINOR_UNIT_RANGE_UNAVAILABLE','native_facts',facts);
  end if;
  facts:=facts||jsonb_build_object('native_scope',native_scope,'work',to_jsonb(work),'revision',to_jsonb(revision),'source_event_id',source_event_id,
    'group',to_jsonb(group_row),'metadata',to_jsonb(metadata),'worker_financial_view_revision',worker_revision,
    'members',members,'items',items,'query_gate',gate,'segment_query_exclusions',exclusions,
    'positive_query_item_count',positive_count,'withheld_source_ex_vat',source_amount);
  proof_hash:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECKLIST_SOURCE_SHIFT_QUERY_MONEY_V1',facts),'hex');
  return jsonb_build_object('known',true,'native_facts',facts,'hold',jsonb_build_object('holds_pay',true,'holds_pay_scope','SHIFT',
    'withheld_amount_pence',pence::bigint::text,'holds_invoice',null,'pending_decision',null,
    'authority',jsonb_build_object('owner','SOURCE_QUERY_EX_VAT','hash',proof_hash,'withholding_known',true)));
end;
$function$;

create or replace function private.weekly_source_checklist_source_invoice_block_items_v1(p_scope jsonb,p_actor_user_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare actor public.tms_users%rowtype; cycle public.weekly_source_cycles%rowtype;
  group_row public.weekly_source_groups%rowtype; revision public.weekly_source_final_revisions%rowtype;
  manifest public.weekly_source_client_manifests%rowtype; source_row public.weekly_source_upload_rows%rowtype;
  upload public.weekly_source_uploads%rowtype; member public.weekly_source_billing_movements%rowtype;
  worker public.candidates%rowtype; fact jsonb; facts jsonb:='[]'::jsonb; items jsonb:='[]'::jsonb;
  witness jsonb; hash text; seen uuid[]:='{}'::uuid[]; row_text text;
begin
  perform private.weekly_source_query_require_service_v1();
  perform private._weekly_source_settings_assert_request_v1(p_scope,
    array['source_group_id','source_cycle_id','client_id','week_ending'],'WEEKLY_SOURCE_CHECKLIST_INVOICE_SCOPE_INVALID');
  if jsonb_typeof(p_scope->'source_group_id') is distinct from 'string' or not pg_input_is_valid(p_scope->>'source_group_id','uuid')
    or jsonb_typeof(p_scope->'source_cycle_id') is distinct from 'string' or not pg_input_is_valid(p_scope->>'source_cycle_id','uuid')
    or jsonb_typeof(p_scope->'client_id') is distinct from 'string' or not pg_input_is_valid(p_scope->>'client_id','uuid')
    or jsonb_typeof(p_scope->'week_ending') is distinct from 'string' or not pg_input_is_valid(p_scope->>'week_ending','date') then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_INVOICE_SCOPE_INVALID' using errcode='22023'; end if;
  select u.* into actor from public.tms_users u where u.id=p_actor_user_id and u.is_active
    and lower(btrim(coalesce(u.role,'')))='admin';
  if actor.id is null then raise exception 'WEEKLY_SOURCE_CHECKLIST_INVOICE_ACTOR_DENIED' using errcode='42501'; end if;
  -- Finance and invoice-only population are never read under a reduced pay actor.
  perform private.weekly_source_office_authority_v1(actor.id,'VIEW_SOURCE_PROGRESS',
    (p_scope->>'source_group_id')::uuid,(p_scope->>'client_id')::uuid,(p_scope->>'week_ending')::date);
  select c.* into cycle from public.weekly_source_cycles c where c.id=(p_scope->>'source_cycle_id')::uuid
    and c.source_group_id=(p_scope->>'source_group_id')::uuid
    and (c.scope_client_id is null or c.scope_client_id=(p_scope->>'client_id')::uuid)
    and (p_scope->>'week_ending')::date between c.finalisation_week_ending-6 and c.finalisation_week_ending;
  select g.* into group_row from public.weekly_source_groups g where g.id=cycle.source_group_id and g.active and g.source_family='ROSTER';
  if group_row.id is null or not exists(select 1 from public.weekly_source_group_clients m
    where m.source_group_id=group_row.id and m.client_id=(p_scope->>'client_id')::uuid
      and (p_scope->>'week_ending')::date between m.valid_from and coalesce(m.valid_to,'infinity'::date)) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_INVOICE_SCOPE_UNPROVED' using errcode='55000'; end if;
  -- Match the native CURRENT CYCLE completion/revision grain. A subsequent
  -- report publication does not erase the actual export invoice ledger.
  for manifest in select cm.* from public.weekly_source_client_manifests cm
    join public.weekly_source_final_revisions fr on fr.id=cm.final_revision_id and fr.state='CURRENT'
      and fr.source_cycle_id=cycle.id and fr.authority_scope_kind='CYCLE' and fr.report_scope_id is null
    where cm.source_cycle_id=cycle.id and cm.source_group_id=group_row.id and cm.client_id=(p_scope->>'client_id')::uuid
      and cm.invoice_state='READY'
    order by cm.id
  loop
    select fr.* into strict revision from public.weekly_source_final_revisions fr where fr.id=manifest.final_revision_id;
    -- Only conserved actual native manifest members can present a hold fact.
    -- Do not turn malformed native scope into a shorter/empty catalogue.
    if octet_length(manifest.manifest_hash) is distinct from 32 or octet_length(revision.manifest_hash) is distinct from 32
      or (select count(*) from public.weekly_source_manifest_movements mm where mm.client_manifest_id=manifest.id)<>manifest.movement_count
      or exists(select 1 from public.weekly_source_manifest_movements mm left join public.weekly_source_billing_movements m on m.id=mm.billing_movement_id
        where mm.client_manifest_id=manifest.id and (m.id is null or mm.movement_hash is distinct from m.movement_economic_hash
          or m.final_revision_id is distinct from revision.id or m.finalisation_cycle_id is distinct from cycle.id
          or m.actual_client_id is distinct from manifest.client_id)) then
      raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_INVOICE_MANIFEST_UNAVAILABLE' using errcode='55000'; end if;
    fact:=jsonb_build_object('scope',p_scope,'actor',to_jsonb(actor),'cycle',to_jsonb(cycle),
      'manifest',to_jsonb(manifest),'revision',to_jsonb(revision));
    facts:=facts||jsonb_build_array(fact);
    for member in select m.* from private.weekly_source_invoice_unreleased_vat_fit_movements_v1(manifest.id) m order by m.id loop
      if not exists(select 1 from public.weekly_source_client_cycle_completions c where c.source_cycle_id=cycle.id
        and c.client_id=manifest.client_id and c.final_revision_id=revision.id and c.completion_kind='FINAL_SOURCE' and c.state='CURRENT') then
        raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_INVOICE_COMPLETION_UNAVAILABLE' using errcode='55000'; end if;
      row_text:=member.source_facts_json->>'upload_row_id';
      if not pg_input_is_valid(row_text,'uuid') or row_text is null then
        raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_INVOICE_ITEM_IDENTITY_UNAVAILABLE' using errcode='55000'; end if;
      select s.* into source_row from public.weekly_source_upload_rows s where s.id=row_text::uuid;
      select u.* into upload from public.weekly_source_uploads u where u.id=source_row.upload_id and u.source_cycle_id=cycle.id
        and u.report_scope_id is null;
      if source_row.id is null or upload.id is null or source_row.work_date is null or source_row.work_date='infinity'::date
        or source_row.work_date='-infinity'::date or member.candidate_id is null or octet_length(member.movement_economic_hash) is distinct from 32 then
        raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_INVOICE_ITEM_IDENTITY_UNAVAILABLE' using errcode='55000'; end if;
      fact:=fact||jsonb_build_object('movement',to_jsonb(member),'source_row',to_jsonb(source_row),'upload',to_jsonb(upload));
      -- Observe all exact native blockers for revision freshness, including
      -- rows whose own Client week is outside this expansion's date interval.
      facts:=facts||jsonb_build_array(fact);
      if source_row.work_date not between (p_scope->>'week_ending')::date-6 and (p_scope->>'week_ending')::date then continue; end if;
      select c.* into worker from public.candidates c where c.id=member.candidate_id;
      if worker.id is null then raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_INVOICE_ITEM_IDENTITY_UNAVAILABLE' using errcode='55000'; end if;
      if member.id=any(seen) then raise exception 'WEEKLY_SOURCE_CHECKLIST_INVOICE_ITEM_AMBIGUOUS' using errcode='55000'; end if;
      seen:=array_append(seen,member.id);
      -- An already admitted movement cannot be called a current admission
      -- hold; native admission refuses its placement before the hold guard.
      if member.placement_state<>'UNPLACED' or exists(select 1 from public.weekly_source_invoice_line_bindings b
        where b.billing_movement_id=member.id and b.state='CURRENT') then
        raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_INVOICE_PLACEMENT_CONFLICT' using errcode='55000'; end if;
      hash:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECKLIST_NATIVE_INVOICE_BLOCK_V1',fact),'hex');
      witness:=jsonb_build_object('owner','private.weekly_source_invoice_unreleased_vat_fit_movements_v1',
        'actor_user_id',actor.id,'scope',p_scope,'final_revision_id',revision.id,'client_manifest_id',manifest.id,
        'billing_movement_id',member.id,'upload_row_id',source_row.id,'work_event_id',member.work_event_id,
        'manifest_hash',encode(manifest.manifest_hash,'hex'),'movement_economic_hash',encode(member.movement_economic_hash,'hex'),'read_proof_hash',hash);
      items:=items||jsonb_build_array(jsonb_build_object('item_id','native-invoice:'||member.id::text,'worker',
        coalesce(nullif(btrim(worker.first_name||' '||worker.last_name),''),worker.id::text),
        'work_date',source_row.work_date,'native_invoice_witness',witness,
        'hold',jsonb_build_object('holds_pay',null,'holds_pay_scope',null,'withheld_amount_pence',null,'holds_invoice',true,'pending_decision',null,
          'authority',jsonb_build_object('owner','SOURCE_INVOICE_BLOCK','hash',hash,'withholding_known',false))));
    end loop;
  end loop;
  return jsonb_build_object('items',items,'native_facts',facts);
end;
$function$;

create or replace function private.weekly_source_checklist_source_invoice_decision_items_v1(
  p_scope jsonb,p_actor_user_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $decision_items$
declare blocks jsonb; again jsonb; item jsonb; items jsonb:='[]'::jsonb;
  source_row public.weekly_source_upload_rows%rowtype; cycle public.weekly_source_cycles%rowtype;
  row_id uuid; request jsonb; context jsonb; context_again jsonb; fact jsonb;
  decisions jsonb:='[]'::jsonb; witness jsonb; proof text; known boolean; choices_known boolean;
  file_request jsonb; file_context jsonb; file_context_again jsonb;
begin
  -- One complete scope census precedes ALL row qualifications. It owns fresh
  -- service/Admin/VIEW_SOURCE_PROGRESS, dated membership and actual catalogue.
  blocks:=private.weekly_source_checklist_source_invoice_block_items_v1(p_scope,p_actor_user_id);
  select c.* into strict cycle from public.weekly_source_cycles c
    where c.id=(p_scope->>'source_cycle_id')::uuid;
  for item in select value from jsonb_array_elements(blocks->'items') loop
    row_id:=(item#>>'{native_invoice_witness,upload_row_id}')::uuid;
    select s.* into strict source_row from public.weekly_source_upload_rows s where s.id=row_id;
    known:=false;choices_known:=false;context:=null;context_again:=null;request:=null;
    file_request:=null;file_context:=null;file_context_again:=null;item:=item||jsonb_build_object('action',null);
    fact:=jsonb_build_object('native_invoice_witness',item->'native_invoice_witness');
    if cycle.version is null or cycle.version<0 or cycle.version>9007199254740991 then
      fact:=fact||jsonb_build_object('decision_known',false,'reason','NATIVE_RELEASE_VERSION_TRANSPORT_UNAVAILABLE');
    elsif octet_length(source_row.normalised_row_hash) is distinct from 32 then
      fact:=fact||jsonb_build_object('decision_known',false,'reason','NATIVE_RELEASE_ROW_HASH_UNAVAILABLE');
    else
      request:=jsonb_build_object('actor_user_id',p_actor_user_id,'upload_row_id',row_id,
        'source_cycle_id',cycle.id,'report_scope_id',null,
        'expected_source_row_hash',encode(source_row.normalised_row_hash,'hex'),
        'expected_authority_scope_version',cycle.version,'hold_kind','VAT_FIT','action','BILL_AT_NET_PLUS_20');
      fact:=fact||jsonb_build_object('native_release_request',request);
      begin
        -- Read mode is an owner-private literal. The complete current native
        -- qualification and first-invoice predicates remain their sole owners.
        context:=private.weekly_source_invoice_hold_release_context_core_v1(request,false);
        perform private.weekly_source_invoice_hold_first_invoice_assert_v1(row_id);
        context_again:=private.weekly_source_invoice_hold_release_context_core_v1(request,false);
        perform private.weekly_source_invoice_hold_first_invoice_assert_v1(row_id);
        if context is distinct from context_again then
          raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001'; end if;
        known:=true;
      exception when sqlstate '55000' or sqlstate '40001' or sqlstate '22023' then
        -- Preserve the base item and actual invoice hold on unsupported native
        -- qualification. Permission/unexpected failures propagate to the owner.
        if sqlerrm='WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' then raise; end if;
        fact:=fact||jsonb_build_object('decision_known',false,'reason','NATIVE_RELEASE_QUALIFICATION_UNAVAILABLE',
          'qualification_sqlstate',sqlstate,'qualification_code',sqlerrm);
      end;
      fact:=fact||jsonb_build_object('native_release_context',context,'native_release_context_again',context_again);
      if known and (context->>'actor_user_id' is distinct from p_actor_user_id::text
        or context->>'upload_row_id' is distinct from row_id::text
        or context->>'client_id' is distinct from p_scope->>'client_id'
        or context#>>'{cycle,id}' is distinct from p_scope->>'source_cycle_id'
        or context#>>'{group,id}' is distinct from p_scope->>'source_group_id'
        or context->>'expected_source_row_hash' is distinct from request->>'expected_source_row_hash'
        or context->>'expected_authority_scope_version' is distinct from request->>'expected_authority_scope_version'
        or context#>>'{upload,report_scope_id}' is not null or context->>'hold_kind' is distinct from 'VAT_FIT'
        or context->>'choice' is distinct from 'BILL_AT_NET_PLUS_20'
        or context#>>'{rules,invoice_sender}' is distinct from 'CLIENT_SELF_BILL'
        or context#>>'{rules,invoice_amount_basis}' is distinct from 'SOURCE_AMOUNT'
        or context#>>'{rules,source_amount_basis}' is distinct from 'EXPORT_ACTUAL_COST_INC_VAT_NET_AGENCY_WORKER_PAY') then
        known:=false;fact:=fact||jsonb_build_object('decision_known',false,'reason','NATIVE_RELEASE_DECISION_GRAIN_UNAVAILABLE');
      end if;
    end if;
    if known then
      if exists(select 1 from public.weekly_source_invoice_hold_releases r
        where r.upload_row_id=row_id and r.hold_kind='VAT_FIT') then
        raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001'; end if;
      -- Choice eligibility is native-owned. Do not infer BILL_AS_FILE from the
      -- default qualification, calculate money or expose a public lock mode.
      file_request:=request||jsonb_build_object('action','BILL_AS_FILE');
      begin
        file_context:=private.weekly_source_invoice_hold_release_context_core_v1(file_request,false);
        perform private.weekly_source_invoice_hold_first_invoice_assert_v1(row_id);
        file_context_again:=private.weekly_source_invoice_hold_release_context_core_v1(file_request,false);
        perform private.weekly_source_invoice_hold_first_invoice_assert_v1(row_id);
        if file_context is distinct from file_context_again or (file_context-'choice') is distinct from (context-'choice')
          or file_context->>'choice' is distinct from 'BILL_AS_FILE' then
          raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001'; end if;
        choices_known:=true;
      exception when sqlstate '55000' or sqlstate '40001' or sqlstate '22023' then
        if sqlerrm='WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' then raise; end if;
        fact:=fact||jsonb_build_object('choice_qualification_sqlstate',sqlstate,'choice_qualification_code',sqlerrm);
      end;
      fact:=fact||jsonb_build_object('decision_known',true,'pending_decision',true,'native_release_choices_known',choices_known,
        'native_file_release_request',file_request,'native_file_release_context',file_context,'native_file_release_context_again',file_context_again);
      proof:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECKLIST_NATIVE_INVOICE_DECISION_V1',fact),'hex');
      witness:=jsonb_build_object('owner','private.weekly_source_invoice_hold_release_context_core_v1',
        'actor_user_id',p_actor_user_id,'scope',p_scope,
        'billing_movement_id',item#>>'{native_invoice_witness,billing_movement_id}',
        'client_manifest_id',item#>>'{native_invoice_witness,client_manifest_id}','upload_row_id',row_id,
        'invoice_block_read_proof_hash',item#>>'{native_invoice_witness,read_proof_hash}',
        'source_row_hash',encode(source_row.normalised_row_hash,'hex'),'authority_scope_version',cycle.version,
        'hold_kind','VAT_FIT','qualification_choice','BILL_AT_NET_PLUS_20','read_proof_hash',proof);
      item:=item||jsonb_build_object('action',case when choices_known then jsonb_build_object(
          'kind','INVOICE_HOLD_DECISION','label','Review invoice hold','native_allowed',true,
          'target',jsonb_build_object('contract','WEEKLY_SOURCE_CHECKLIST_INVOICE_HOLD_DECISION_ACTION_V1',
            'actor_user_id',p_actor_user_id,'permission_view','ADMIN','scope',p_scope,
            'billing_movement_id',witness->'billing_movement_id','client_manifest_id',witness->'client_manifest_id','upload_row_id',row_id,
            'expected_source_row_hash',witness->'source_row_hash','expected_authority_scope_version',cycle.version,
            'hold_kind','VAT_FIT','decision_read_proof_hash',proof,'choices',jsonb_build_array('BILL_AT_NET_PLUS_20','BILL_AS_FILE'))) end,
        'native_invoice_decision_witness',witness,
        'hold',jsonb_build_object('holds_pay',null,'holds_pay_scope',null,'withheld_amount_pence',null,
          'holds_invoice',true,'pending_decision',true,
          'authority',jsonb_build_object('owner','SOURCE_INVOICE_DECISION','hash',proof,'withholding_known',false)));
    end if;
    -- Both positive and unknown decision outcomes keep every base item.
    items:=items||jsonb_build_array(item);decisions:=decisions||jsonb_build_array(fact);
  end loop;
  -- One second complete census for the entire scope proves the same actor,
  -- catalogue and binding. Never re-census the whole scope for every movement.
  again:=private.weekly_source_checklist_source_invoice_block_items_v1(p_scope,p_actor_user_id);
  if blocks is distinct from again then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001'; end if;
  return jsonb_build_object('items',items,'native_facts',jsonb_build_object(
    'native_invoice_blocks',blocks->'native_facts','native_release_qualifications',decisions));
end;
$decision_items$;

create or replace function private.weekly_source_checklist_process_publication_v1(p_receipt_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $process_publication$
declare receipt public.weekly_source_ordinary_pay_projection_receipts%rowtype;
 fr public.weekly_source_final_revisions%rowtype;root public.timesheets%rowtype;
 head public.weekly_source_entitlement_heads%rowtype;bundle public.weekly_source_entitlement_decision_bundles%rowtype;
 publication private.weekly_source_entitlement_publication_receipts%rowtype;
 generation public.weekly_exceptional_pay_generations%rowtype;approval public.weekly_exceptional_payment_approvals%rowtype;
 local_receipt private.weekly_source_local_protected_decision_receipts%rowtype;
 c1_request public.weekly_exceptional_c1_publication_requests%rowtype;
 inventory jsonb;basis jsonb;native_origin jsonb;witness jsonb;current_receipt jsonb;next_application jsonb;
 event record;current_root uuid;current_approval uuid;current_event uuid;member integer;n bigint;
 facts jsonb;events jsonb:='[]'::jsonb;event_fact jsonb;proved boolean:=false;event_proved boolean;
 source_units jsonb;source_expenses jsonb;expected_events jsonb;expected_event jsonb;event_matches bigint;
begin
 select r.* into receipt from public.weekly_source_ordinary_pay_projection_receipts r where r.id=p_receipt_id;
 select r.* into fr from public.weekly_source_final_revisions r where r.id=receipt.final_revision_id;
 select t.* into root from public.timesheets t where t.timesheet_id=receipt.root_timesheet_id;
 facts:=jsonb_build_object('receipt',to_jsonb(receipt),'final_revision',to_jsonb(fr),'root',to_jsonb(root));
 if receipt.id is null or fr.id is null or root.timesheet_id is null
  or private.weekly_source_report_projection_receipt_assert_v1(receipt) is distinct from true
  or receipt.source_cycle_id is distinct from fr.source_cycle_id
  or receipt.final_manifest_hash is distinct from fr.manifest_hash
  or receipt.final_policy_fingerprint is distinct from fr.policy_fingerprint
  or fr.state not in('CURRENT','SUPERSEDED')
  or not exists(select 1 from public.contracts c where c.id=root.contract_id and c.client_id=receipt.client_id)
  or receipt.outcome not in('PROPOSED','TARGET_MANAGED_SUPPRESSED') then
  return jsonb_build_object('proved',false,'native_facts',facts);end if;
 -- The caller proves its immutable task/run/context. This private leaf proves
 -- the current native publication only, at that SAME receipt revision.
 if receipt.outcome='PROPOSED' then
  inventory:=private.weekly_source_effective_inventory_v1(root.timesheet_id);basis:=inventory->'approval_basis';
  if basis->'coverage_complete'='true'::jsonb and inventory->>'authority'='HEAD' then
   select h.* into head from public.weekly_source_entitlement_heads h where h.id=(inventory->>'head_id')::uuid;
   select b.* into bundle from public.weekly_source_entitlement_decision_bundles b
    where b.decision_bundle_id=head.decision_bundle_id and b.bundle_revision=head.bundle_revision;
   select count(*) into n from private.weekly_source_entitlement_publication_receipts p
    where p.decision_bundle_id=head.decision_bundle_id and p.bundle_revision=head.bundle_revision and p.request_digest=bundle.request_digest;
   if n=1 then
    select p.* into strict publication from private.weekly_source_entitlement_publication_receipts p
     where p.decision_bundle_id=head.decision_bundle_id and p.bundle_revision=head.bundle_revision and p.request_digest=bundle.request_digest;
    member:=array_position(publication.head_ids,head.id);native_origin:=head.source_origin_json;
    if bundle.state='COMMITTED' and bundle.bundle_kind='SINGLE_ROOT' and cardinality(publication.head_ids)=1
     and member=1 and publication.member_root_ids[member]=root.timesheet_id
     and publication.member_family_booking_ids[member]=root.booking_id
     and publication.member_root_versions[member]=head.root_timesheet_version
     and publication.candidate_id=(select c.candidate_id from public.contracts c where c.id=root.contract_id)
     and head.authority_kind='LOCKED_FINAL_SOURCE'
     and native_origin->>'final_revision_id'=fr.id::text and native_origin->>'source_cycle_id'=fr.source_cycle_id::text
     and native_origin->>'revision_number'=fr.revision_number::text
     and native_origin->>'manifest_hash'=encode(fr.manifest_hash,'hex')
     and native_origin->>'policy_fingerprint'=encode(fr.policy_fingerprint,'hex')
     and head.source_generation_digest=private.weekly_source_publication_request_digest_v1(native_origin)
     and bundle.source_revision_digest=head.source_generation_digest
     and head.decision_bundle_id=private.weekly_source_entitlement_derived_uuid_v1(
      'WEEKLY_SOURCE_DECISION_BUNDLE_V1',btrim(root.booking_id)||'|'||fr.id::text) then proved:=true;end if;
   end if;
  end if;
  facts:=facts||jsonb_build_object('inventory',inventory,'head',to_jsonb(head),'bundle',to_jsonb(bundle),'publication',to_jsonb(publication));
 end if;
 if not proved then
  -- A task can contain multiple actual Source work events. Every corresponding
  -- snapshot/lineage member must carry its OWN current generation publication.
  source_units:=private.weekly_source_ordinary_projection_source_units_v1(fr.id,root.timesheet_id);
  source_expenses:=private.weekly_source_ordinary_projection_current_expenses_v1(root.timesheet_id,fr.id);
  facts:=facts||jsonb_build_object('native_source_units',source_units,'native_source_expenses',source_expenses);
  if source_units is distinct from receipt.source_unit_outcomes_json
   or source_expenses is distinct from receipt.source_expense_authorities_json
   or exists(select 1 from jsonb_array_elements(source_units||source_expenses) unit
    where jsonb_typeof(unit->'work_event_id') is distinct from 'string'
     or pg_input_is_valid(unit->>'work_event_id','uuid') is distinct from true) then
   return jsonb_build_object('proved',false,'native_facts',facts);end if;
  select coalesce(jsonb_agg(event_id order by event_id),'[]'::jsonb) into expected_events
   from (select distinct unit->>'work_event_id' event_id from jsonb_array_elements(source_units||source_expenses) unit) complete_events;
  facts:=facts||jsonb_build_object('expected_native_events',expected_events);
  n:=0;proved:=true;
  for expected_event in select value from jsonb_array_elements(expected_events)
  loop
   select count(*) into event_matches
   from public.weekly_source_final_snapshot_lines fs
   join public.weekly_source_row_resolutions rr on rr.id=fs.row_resolution_id and rr.upload_row_id=fs.upload_row_id
    and rr.work_event_id=fs.work_event_id and rr.candidate_id=fs.candidate_id and rr.client_id=fs.client_id
    and rr.contract_id=fs.contract_id and rr.mapping_state='RESOLVED'
   join public.weekly_source_row_timesheet_lineages l on l.row_resolution_id=rr.id
    and l.work_event_id=fs.work_event_id and l.candidate_id=fs.candidate_id and l.client_id=fs.client_id
    and l.contract_id=fs.contract_id and l.source_cycle_id=fr.source_cycle_id
    and l.family_booking_id=root.booking_id and l.week_ending_date=root.week_ending_date
    and l.timesheet_id=any(private.weekly_source_invoice_family_timesheet_ids_v1(root.timesheet_id))
   where fs.final_revision_id=fr.id and fs.work_event_id=(expected_event#>>'{}')::uuid
    and fs.client_id=receipt.client_id and fs.contract_id=root.contract_id
    and fs.candidate_id=(select c.candidate_id from public.contracts c where c.id=root.contract_id)
    and exists(select 1 from public.weekly_source_projection_publications p
     where p.upload_id=fr.upload_id and p.source_cycle_id=fr.source_cycle_id
      and p.authority_scope_kind=fr.authority_scope_kind and p.report_scope_id is not distinct from fr.report_scope_id
      and p.state in('CURRENT','SUPERSEDED') and rr.generation=coalesce(p.projection_generation,p.authority_scope_version));
   if event_matches<>1 then
    return jsonb_build_object('proved',false,'native_facts',facts||jsonb_build_object(
     'unproved_expected_event',expected_event,'exact_snapshot_lineage_matches',event_matches));end if;
   select fs.work_event_id,fs.candidate_id,fs.client_id,fs.contract_id into strict event
    from public.weekly_source_final_snapshot_lines fs where fs.final_revision_id=fr.id and fs.work_event_id=(expected_event#>>'{}')::uuid;
   n:=n+1;event_proved:=false;current_receipt:=null;current_approval:=null;current_event:=null;
   approval:=null;generation:=null;local_receipt:=null;c1_request:=null;inventory:=null;basis:=null;next_application:=null;
   witness:=private.weekly_source_protected_wait_witness_v1(event.work_event_id,fr.source_cycle_id);
   if witness is not null and exists(select 1 from public.timesheets t
    where t.timesheet_id=(witness->>'root_timesheet_id')::uuid and t.booking_id=root.booking_id
     and t.contract_id=root.contract_id and t.week_ending_date=root.week_ending_date
     and t.sheet_scope='WEEKLY' and t.line_type='HOURS' and t.is_adjustment is false) then
    current_root:=(witness->>'root_timesheet_id')::uuid;
    select g.* into strict generation from public.weekly_exceptional_pay_generations g where g.id=(witness->>'current_generation_id')::uuid;
    select count(*),(array_agg(t.approval_id))[1] into member,current_approval
     from public.weekly_exceptional_pay_target_events t where t.family_id=(witness->>'family_id')::uuid and t.financial_generation_id=generation.id;
    if member=1 then
     select a.* into strict approval from public.weekly_exceptional_payment_approvals a where a.id=current_approval;
     select count(*),(array_agg(e.id))[1] into member,current_event
      from public.weekly_exceptional_pay_family_events e where e.family_id=approval.pay_target_family_id
       and e.durable_work_event_id=approval.work_event_id and e.evidence_approval_id=approval.id and e.state='WAIT'
       and not exists(select 1 from public.weekly_exceptional_pay_family_events newer where newer.family_id=e.family_id
        and newer.durable_work_event_id=e.durable_work_event_id and newer.event_sequence>e.event_sequence);
     if member=1 then current_receipt:=private.weekly_source_protected_wait_receipt_v1(current_root,current_event)->'accepted_receipt';end if;
    end if;
    if current_receipt->>'receipt_state' in('COMPLETE','PUBLISHED') and current_receipt->>'generation_id'=generation.id::text
     and approval.candidate_id=event.candidate_id and approval.client_id=event.client_id and approval.contract_id=event.contract_id then
     if current_receipt->>'lane'='SOURCE_LOCAL' then
      select l.* into local_receipt from private.weekly_source_local_protected_decision_receipts l
       where l.generation_id=generation.id and l.publication_request_id=(current_receipt->>'publication_request_id')::uuid;
      inventory:=private.weekly_source_effective_inventory_v1(current_root);basis:=inventory->'approval_basis';
      if basis->'coverage_complete'='true'::jsonb and basis#>>'{scope,candidate_id}'=event.candidate_id::text
       and basis#>>'{scope,client_id}'=event.client_id::text and basis#>>'{scope,contract_id}'=event.contract_id::text then
       if local_receipt.result_json->>'authority'='COMMON_ENTITLEMENT_HEAD'
        and basis#>>'{origin,source_revision,generation_id}'=generation.id::text
        and basis#>>'{origin,source_revision,publication_request_id}'=local_receipt.publication_request_id::text then event_proved:=true;
       elsif local_receipt.result_json->>'authority'='UNAUTHORISED_TSFIN'
        and basis#>>'{origin,financial_snapshot_id}'=local_receipt.result_json->>'timesheet_financials_id' then event_proved:=true;end if;
      end if;
     elsif current_receipt->>'lane'='RETAINED_C1' then
      select c.* into c1_request from public.weekly_exceptional_c1_publication_requests c
       where c.id=(current_receipt->>'publication_request_id')::uuid and c.generation_id=generation.id;
      if c1_request.state='PUBLISHED' and c1_request.financial_row_id is not null then event_proved:=true;end if;
     elsif current_receipt->>'lane'='DIRECT_NEXT' then
      next_application:=private.bpay_next_source_origin_state_v1((current_receipt->>'work_id')::uuid,(current_receipt->>'revision_id')::uuid);
      event_proved:=true;
     end if;
    end if;
   end if;
   event_fact:=jsonb_build_object('work_event_id',event.work_event_id,'candidate_id',event.candidate_id,'client_id',event.client_id,
    'contract_id',event.contract_id,'witness',witness,'generation',to_jsonb(generation),'approval',to_jsonb(approval),
    'current_receipt',current_receipt,'local_receipt',to_jsonb(local_receipt),'c1_request',to_jsonb(c1_request),
    'inventory',inventory,'next_application',next_application,'proved',event_proved);
   events:=events||jsonb_build_array(event_fact);proved:=proved and event_proved;
  end loop;
  proved:=proved and n>0 and n=jsonb_array_length(expected_events);
  facts:=facts||jsonb_build_object('native_current_publications',events);
 end if;
 return jsonb_build_object('proved',coalesce(proved,false),'native_facts',facts);
end;
$process_publication$;

create or replace function private.weekly_source_checklist_process_v1(p_cycle uuid,p_client uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare revision record; task record; run public.weekly_source_finalisation_pay_runs%rowtype;
  receipt public.weekly_source_ordinary_pay_projection_receipts%rowtype; contexts jsonb;
  facts jsonb:='[]'::jsonb; proof boolean; tasks_proved boolean; count_tasks integer;
  publication_proof jsonb;publication_proof_after jsonb;publication_facts jsonb;
begin
  for revision in
    -- History is independent per real scope. A report completion must never
    -- erase the export pay revision merely by superseding a client completion.
    select distinct on(fr.authority_scope_kind,fr.report_scope_id) fr.*,cm.id client_manifest_id,cm.manifest_hash client_manifest_hash
    from public.weekly_source_final_revisions fr
    join public.weekly_source_client_manifests cm on cm.final_revision_id=fr.id and cm.client_id=p_client
      and cm.source_cycle_id=fr.source_cycle_id
    where fr.source_cycle_id=p_cycle and fr.state in('CURRENT','SUPERSEDED')
    order by fr.authority_scope_kind,fr.report_scope_id,fr.revision_number desc,fr.id desc
  loop
    proof:=isfinite(revision.finalised_at_utc) and octet_length(revision.manifest_hash)=32
      and octet_length(revision.client_manifest_hash)=32
      and exists(select 1 from public.weekly_source_uploads u
        join public.weekly_source_upload_attempts a on a.logical_upload_id=u.id and a.result='ACCEPTED'
        join public.weekly_source_projection_publications publication on publication.upload_id=u.id
          and publication.source_cycle_id=p_cycle
          and publication.report_scope_id is not distinct from revision.report_scope_id
          and publication.authority_scope_kind=revision.authority_scope_kind
        where u.id=revision.upload_id and u.source_cycle_id=p_cycle
          and u.report_scope_id is not distinct from revision.report_scope_id);
    publication_facts:='[]'::jsonb;
    if revision.authority_scope_kind<>'SELF_BILL_REPORT_SCOPE' then
      select * into run from public.weekly_source_finalisation_pay_runs r where r.final_revision_id=revision.id;
      select coalesce(jsonb_agg(t.prepared_context_json||jsonb_build_object(
        'prepared_context_hash',encode(t.prepared_context_hash,'hex')) order by t.root_timesheet_id),'[]'::jsonb),count(*)::integer
        into contexts,count_tasks from public.weekly_source_finalisation_pay_tasks t where t.run_id=run.id;
      proof:=proof and run.id is not null and run.source_cycle_id=p_cycle and run.state='COMPLETE'
        and isfinite(run.completed_at_utc) and run.final_revision_manifest_hash=revision.manifest_hash
        and run.task_count=count_tasks and run.terminal_task_count=run.task_count and run.action_required_task_count=0
        and run.run_hash=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_FINALISATION_PAY_RUN_V1',jsonb_build_object(
          'final_revision_id',run.final_revision_id,'source_cycle_id',run.source_cycle_id,'requested_by_user_id',run.requested_by_user_id,
          'final_revision_manifest_hash',encode(run.final_revision_manifest_hash,'hex'),
          'task_manifest_hash',encode(run.task_manifest_hash,'hex'),'task_count',run.task_count))
        and run.task_manifest_hash=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_FINALISATION_PAY_TASK_MANIFEST_V1',contexts);
      tasks_proved:=true;
      for task in select t.*,m.client_id from public.weekly_source_finalisation_pay_tasks t
        join public.weekly_source_client_manifests m on m.id=t.client_manifest_id where t.run_id=run.id
      loop
        select * into receipt from public.weekly_source_ordinary_pay_projection_receipts r where r.id=task.projection_receipt_id;
        tasks_proved:=tasks_proved and task.state in('PREPARED_FOR_AUTHORISATION','PROPOSED','NO_OP_FIRST_NEGATIVE','TARGET_MANAGED_SUPPRESSED')
          and isfinite(task.completed_at_utc) and receipt.id is not null
          and receipt.final_revision_id=revision.id and receipt.source_cycle_id=p_cycle
          and receipt.client_id=task.client_id and receipt.root_timesheet_id=task.root_timesheet_id
          and receipt.actor_user_id=run.requested_by_user_id and receipt.outcome=task.state
          and receipt.idempotency_key=task.projection_idempotency_key
          and receipt.final_manifest_hash=revision.manifest_hash and receipt.final_policy_fingerprint=revision.policy_fingerprint
          and private.weekly_source_report_projection_receipt_assert_v1(receipt) is true
          and task.prepared_context_hash=private.weekly_source_sha256_jsonb_v1(
            'WEEKLY_SOURCE_FINALISATION_PAY_ROOT_CONTEXT_V1',task.prepared_context_json)
          and task.prepared_context_json->>'schema_version'='WEEKLY_SOURCE_FINALISATION_PAY_ROOT_CONTEXT_V1'
          and task.prepared_context_json->>'final_revision_id'=revision.id::text
          and task.prepared_context_json->>'source_cycle_id'=p_cycle::text
          and task.prepared_context_json->>'client_id'=task.client_id::text
          and task.prepared_context_json->>'client_manifest_id'=task.client_manifest_id::text
          and task.prepared_context_json->>'root_timesheet_id'=task.root_timesheet_id::text;
        -- Orchestration alone still proves nothing. Require the SAME actual
        -- receipt revision's current native publication, for every actual event.
        if task.client_id=p_client and task.state in('PROPOSED','TARGET_MANAGED_SUPPRESSED') then
          publication_proof:=private.weekly_source_checklist_process_publication_v1(receipt.id);
          publication_proof_after:=private.weekly_source_checklist_process_publication_v1(receipt.id);
          if publication_proof is distinct from publication_proof_after then
            raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001';end if;
          publication_facts:=publication_facts||jsonb_build_array(jsonb_build_object('task_id',task.id,'publication',publication_proof));
          tasks_proved:=tasks_proved and publication_proof->'proved'='true'::jsonb;
        end if;
        if task.state='PREPARED_FOR_AUTHORISATION' and not exists(select 1 from public.timesheets_financials f
          join public.timesheets root on root.timesheet_id=task.root_timesheet_id
          where f.id=receipt.published_timesheet_financial_id and f.timesheet_id=task.root_timesheet_id
            and f.client_id=task.client_id and f.timesheet_version=task.root_timesheet_version
            and root.booking_id=task.root_family_booking_id) then tasks_proved:=false; end if;
      end loop;
      proof:=proof and tasks_proved;
    end if;
    facts:=facts||jsonb_build_array(jsonb_build_object('final_revision_id',revision.id,
      'authority_scope_kind',revision.authority_scope_kind,'report_scope_id',revision.report_scope_id,
      'client_manifest_id',revision.client_manifest_id,'manifest_hash',encode(revision.manifest_hash,'hex'),
      'client_manifest_hash',encode(revision.client_manifest_hash,'hex'),'finalised_at_utc',revision.finalised_at_utc,
      'process_complete',coalesce(proof,false),'native_publication_facts',publication_facts,'pay_run_id',case when revision.authority_scope_kind<>'SELF_BILL_REPORT_SCOPE' then run.id end,
      'pay_run_hash',case when revision.authority_scope_kind<>'SELF_BILL_REPORT_SCOPE' then encode(run.run_hash,'hex') end));
  end loop;
  return jsonb_build_object('contract','WEEKLY_SOURCE_CHECKLIST_PROCESS_V1','source_cycle_id',p_cycle,'client_id',p_client,
    'scopes',facts,'financial_withholding_proved',false,
    'read_revision',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECKLIST_PROCESS_V1',facts),'hex'));
end;
$function$;

create or replace function private.weekly_source_checklist_page_v1(
  p_records jsonb,p_request jsonb,p_actor uuid,p_view text,p_binding text,p_revision text
) returns jsonb language plpgsql immutable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  command text:=p_request->>'command'; direction text:=p_request->>'direction';
  page_limit integer:=(p_request->>'limit')::integer; token jsonb; anchor jsonb;
  selected jsonb; page jsonb; last_record jsonb; more boolean; after_key jsonb;
begin
  if jsonb_typeof(p_records) is distinct from 'array' or p_view not in('ADMIN','PAY_READONLY')
    or p_binding !~ '^[0-9a-f]{64}$' or p_revision !~ '^[0-9a-f]{64}$'
    or command not in('CHECKLIST','CHECKLIST_ISSUES') or direction not in('ASC','DESC')
    or page_limit not between 1 and 100 then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_RESPONSE_INVALID' using errcode='55000';
  end if;
  if nullif(p_request->>'cursor','') is not null then
    begin
      token:=convert_from(decode(p_request->>'cursor','base64'),'UTF8')::jsonb;
      perform private._weekly_source_settings_assert_request_v1(token,
        array['contract','binding','read_revision','after'],'CURSOR');
      if token->>'contract' is distinct from 'WEEKLY_SOURCE_CHECKLIST_CURSOR_V1'
        or token->>'binding' is distinct from p_binding or token->>'read_revision' is distinct from p_revision
        or jsonb_typeof(token->'after') is distinct from 'array'
        or jsonb_array_length(token->'after')<>6
        -- A cursor must name an actual admitted row in this exact revision.
        -- A changed/closed subject cannot be used to manufacture an empty end.
        or not exists(select 1 from jsonb_array_elements(p_records) r where r->'_key'=token->'after') then
        raise exception 'cursor';
      end if;
      after_key:=token->'after';
    exception when others then
      raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001';
    end;
  end if;
  if nullif(p_request->>'anchor','') is not null then
    begin
      anchor:=convert_from(decode(p_request->>'anchor','base64'),'UTF8')::jsonb;
      perform private._weekly_source_settings_assert_request_v1(anchor,array['contract','binding','identity'],'ANCHOR');
      if anchor->>'contract' is distinct from 'WEEKLY_SOURCE_CHECKLIST_ANCHOR_V1'
        or anchor->>'binding' is distinct from p_binding
        or jsonb_typeof(anchor->'identity') is distinct from 'string'
        or length(anchor->>'identity') not between 1 and 512 then raise exception 'anchor'; end if;
      -- Anchored refresh starts at the origin. The Office consumes its previous
      -- prefix and finds the nearest surviving visible identity itself.
    exception when others then
      raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001';
    end;
  end if;
  with candidates as (
    select r from jsonb_array_elements(p_records) r
    where after_key is null
      or (direction='ASC' and (r#>>'{_key,0}') collate "C">(after_key->>0) collate "C")
      or (direction='DESC' and (r#>>'{_key,0}') collate "C"<(after_key->>0) collate "C")
      or (r#>>'{_key,0}'=after_key->>0 and
        ((r#>>'{_key,1}') collate "C",(r#>>'{_key,2}') collate "C",(r#>>'{_key,3}') collate "C",(r#>>'{_key,4}') collate "C",(r#>>'{_key,5}') collate "C")>
        ((after_key->>1) collate "C",(after_key->>2) collate "C",(after_key->>3) collate "C",(after_key->>4) collate "C",(after_key->>5) collate "C"))
    order by case when direction='ASC' then r#>>'{_key,0}' end collate "C" asc,
      case when direction='DESC' then r#>>'{_key,0}' end collate "C" desc,
      r#>>'{_key,1}' collate "C",r#>>'{_key,2}' collate "C",r#>>'{_key,3}' collate "C",
      r#>>'{_key,4}' collate "C",r#>>'{_key,5}' collate "C"
    limit page_limit+1
  ) select coalesce(jsonb_agg(r order by
      case when direction='ASC' then r#>>'{_key,0}' end collate "C" asc,
      case when direction='DESC' then r#>>'{_key,0}' end collate "C" desc,
      r#>>'{_key,1}' collate "C",r#>>'{_key,2}' collate "C",r#>>'{_key,3}' collate "C",
      r#>>'{_key,4}' collate "C",r#>>'{_key,5}' collate "C"),'[]'::jsonb),count(*)>page_limit into selected,more from candidates;
  if more then selected:=selected-page_limit; end if;
  last_record:=selected->(jsonb_array_length(selected)-1);
  select coalesce(jsonb_agg(r-'_key' order by ordinal),'[]'::jsonb) into page from jsonb_array_elements(selected) with ordinality a(r,ordinal);
  return jsonb_build_object('ok',true,'contract','WEEKLY_SOURCE_CHECKLIST_V1','command',command,
    'actor_user_id',p_actor,'permission_view',p_view,'binding',p_binding,'read_revision',p_revision,
    'rows',case when command='CHECKLIST' then page else '[]'::jsonb end,
    'items',case when command='CHECKLIST_ISSUES' then page else '[]'::jsonb end,
    'has_more',more,'next_cursor',case when more then replace(encode(convert_to(jsonb_build_object(
      'contract','WEEKLY_SOURCE_CHECKLIST_CURSOR_V1','binding',p_binding,'read_revision',p_revision,
      'after',last_record->'_key')::text,'UTF8'),'base64'),chr(10),'') end,
    'refresh_required',false,'anchor',case when last_record is not null then replace(encode(convert_to(jsonb_build_object(
      'contract','WEEKLY_SOURCE_CHECKLIST_ANCHOR_V1','binding',p_binding,
      'identity',coalesce(last_record->>'row_id',last_record->>'item_id'))::text,'UTF8'),'base64'),chr(10),'') end);
end;
$function$;

create or replace function private.weekly_source_office_tracker_v1(p_cycle_id uuid,p_actor_user_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare v_actor uuid:=p_actor_user_id; v_cycle public.weekly_source_cycles%rowtype;
  v_group public.weekly_source_groups%rowtype; v_tracker jsonb;
begin
  select c.* into v_cycle from public.weekly_source_cycles c where c.id=p_cycle_id;
  select g.* into v_group from public.weekly_source_groups g where g.id=v_cycle.source_group_id and g.active;
  if v_cycle.id is null or v_group.id is null then raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_SCOPE_UNAVAILABLE' using errcode='22023'; end if;
  perform private.weekly_source_office_authority_v1(v_actor,'VIEW_SOURCE_PROGRESS',v_group.id);
  select pg_catalog.jsonb_build_object(
    'title','Finalisation progress','cycle_label','Week ending '||to_char(v_cycle.finalisation_week_ending,'FMDD Mon YYYY'),
    'cycle_id',v_cycle.id,
    'cycle_options',coalesce((select pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
      'value',item.id,'label','Week ending '||to_char(item.finalisation_week_ending,'FMDD Mon YYYY'))
      order by item.finalisation_week_ending desc,item.id)
      from public.weekly_source_cycles item where item.source_group_id=v_group.id),'[]'::jsonb),
    'complete',not exists(
      select 1 from public.weekly_source_group_clients membership
      where membership.source_group_id=v_group.id
        and (v_cycle.scope_client_id is null or membership.client_id=v_cycle.scope_client_id)
        and v_cycle.finalisation_week_ending between membership.valid_from and coalesce(membership.valid_to,'infinity'::date)
        and not exists(select 1 from public.weekly_source_client_cycle_completions completion
          where completion.source_cycle_id=v_cycle.id and completion.client_id=membership.client_id and completion.state='CURRENT')
    ),
    'rows',coalesce((select pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object(
      'row_key','tracker-'||membership.client_id::text,'source',v_group.display_name,'client',client.name,
      'status',pg_catalog.jsonb_build_object(
        'text',case when completion.id is not null then case completion.completion_kind
          when 'FINAL_SOURCE' then 'Finalised' else 'No shifts this week' end else 'Not finalised' end,
        'tone',case when completion.id is not null then 'positive' else 'warning' end),
      'detail',case when completion.id is not null then to_char(completion.attested_at_utc at time zone 'Europe/London','DD Mon YYYY HH24:MI') else '' end,
      'actions',case
        when completion.id is null
         and v_cycle.state not in ('FINALISING','FINALISED')
         and not exists(select 1 from public.weekly_source_final_revisions revision
           join public.weekly_source_final_snapshot_lines snapshot on snapshot.final_revision_id=revision.id
           where revision.source_cycle_id=v_cycle.id and revision.state in ('PREPARED','CURRENT')
             and snapshot.client_id=membership.client_id)
         and not exists(select 1 from public.weekly_source_uploads upload
           join public.weekly_source_upload_rows source_row on source_row.upload_id=upload.id
           left join lateral (select resolution.* from public.weekly_source_row_resolutions resolution
             where resolution.upload_row_id=source_row.id order by resolution.generation desc,resolution.id desc limit 1) resolution on true
           where upload.source_cycle_id=v_cycle.id
             and (upload.id=v_cycle.current_complete_upload_id or upload.state='CURRENT')
             and resolution.mapping_state is distinct from 'RESOLVED')
         and not exists(select 1 from public.weekly_source_report_scopes scope
           where scope.source_cycle_id=v_cycle.id and scope.client_id=membership.client_id
             and (scope.current_complete_upload_id is not null or scope.current_projection_publication_id is not null or scope.current_final_revision_id is not null))
         and not exists(select 1 from public.weekly_source_upload_rows source_row
           join public.weekly_source_uploads upload on upload.id=source_row.upload_id and upload.source_cycle_id=v_cycle.id and upload.state='CURRENT'
           join lateral (select resolution.* from public.weekly_source_row_resolutions resolution
             where resolution.upload_row_id=source_row.id order by resolution.generation desc,resolution.id desc limit 1) resolution
             on resolution.mapping_state='RESOLVED' and resolution.client_id=membership.client_id)
         and not exists(select 1 from public.weekly_discrepancy_incidents incident
           where incident.source_cycle_id=v_cycle.id and incident.client_id=membership.client_id and incident.state='OPEN')
        then pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
          'label','No shifts to import','enabled',true,'kind','COMMAND','command','NO_SHIFTS_TO_IMPORT',
          'context',pg_catalog.jsonb_build_object(
            'trust',client.name,
            'cutoff',to_char(v_cycle.cutoff_at_utc at time zone 'Europe/London','Dy FMDD Mon YYYY HH24:MI')
          ),
          'payload',pg_catalog.jsonb_build_object(
            'actor_user_id',v_actor,
            'source_cycle_id',v_cycle.id,'source_group_id',v_group.id,
            'client_id',membership.client_id,'expected_cycle_version',v_cycle.version,
            'attestation_text','No shifts to import'
          )))
        else pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
          'label','View','enabled',true,'payload',pg_catalog.jsonb_build_object('client_id',membership.client_id)
        )) end
    ) order by private.weekly_source_query_ascii_fold_v1(client.name) collate "C",client.id)
    from public.weekly_source_group_clients membership
    join public.clients client on client.id=membership.client_id
    left join public.weekly_source_client_cycle_completions completion
      on completion.source_cycle_id=v_cycle.id and completion.client_id=membership.client_id and completion.state='CURRENT'
    where membership.source_group_id=v_group.id
      and (v_cycle.scope_client_id is null or membership.client_id=v_cycle.scope_client_id)
      and v_cycle.finalisation_week_ending between membership.valid_from and coalesce(membership.valid_to,'infinity'::date)),'[]'::jsonb)
  ) into v_tracker;
  return v_tracker;
end;
$function$;

create or replace function private.weekly_source_healthroster_checklist_leaf_v1(p_request jsonb)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare c public.weekly_source_cycles%rowtype; g public.weekly_source_groups%rowtype;
  v_actor uuid; v_client uuid; v_week date; v_today date; v_admin boolean; v_rule jsonb;
  v_route text; v_actual jsonb; v_facts jsonb; v_unproved jsonb; v_gate jsonb:='[]'::jsonb;
  v_latest_week date; v_latest_timesheet_week date; v_calendar_authority jsonb;
  v_open integer; v_earlier_open integer; v_count integer; v_wait integer:=0; v_wait_fact jsonb; v_event record;
  v_read_scope record; v_page jsonb; v_cursor text; v_rows jsonb; v_revision text; v_query_revision text;
  v_scope_count integer; v_scope_open integer; v_retention_reads jsonb:='[]'::jsonb;
  v_money jsonb;v_legacy jsonb;v_money_row jsonb;v_money_scope jsonb;v_scope_money jsonb;v_scope_money_facts jsonb;
  v_financial_items jsonb:='[]'::jsonb;v_financial_facts jsonb:='[]'::jsonb;
begin
  perform private._weekly_source_settings_assert_request_v1(p_request,
    array['actor_user_id','source_cycle_id','source_group_id','client_id','week_ending','command','cursor','limit'],
    'WEEKLY_SOURCE_CHECKLIST_LEAF_REQUEST_INVALID');
  v_actor:=(p_request->>'actor_user_id')::uuid; v_client:=(p_request->>'client_id')::uuid;
  if coalesce(p_request->>'command','CONTEXT') not in('CONTEXT','ISSUES') then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_LEAF_REQUEST_INVALID' using errcode='22023';
  end if;
  v_week:=(p_request->>'week_ending')::date;
  select * into c from public.weekly_source_cycles where id=(p_request->>'source_cycle_id')::uuid;
  select * into g from public.weekly_source_groups where id=c.source_group_id and active;
  if c.id is null or g.id is null or v_client is null or v_week is null
    or v_week not between c.finalisation_week_ending-6 and c.finalisation_week_ending
    or (c.scope_client_id is not null and c.scope_client_id<>v_client)
    or (nullif(p_request->>'source_group_id','') is not null and (p_request->>'source_group_id')::uuid<>g.id)
    or not exists(select 1 from public.weekly_source_group_clients membership where membership.source_group_id=g.id
      and membership.client_id=v_client and v_week between membership.valid_from and coalesce(membership.valid_to,'infinity'::date)) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_SCOPE_UNAVAILABLE' using errcode='22023';
  end if;
  select lower(btrim(coalesce(role,'')))='admin' into v_admin from public.tms_users where id=v_actor and is_active;
  perform private.weekly_source_office_authority_v1(v_actor,case when v_admin then 'VIEW_SOURCE_PROGRESS' else 'VIEW_PAY_WORK' end,g.id,v_client,v_week);
  v_today:=(statement_timestamp() at time zone g.timezone)::date;
  if g.source_family<>'ROSTER' then return jsonb_build_object('applies',false,'preserve_native',true); end if;
  v_rule:=private.weekly_source_effective_rule_set_v1(v_client,c.id);
  v_route:=case when v_rule is not null then case when v_rule#>>'{values,invoice_sender}'='AGENCY_INVOICE'
    then 'AGENCY_INVOICE' else 'SELF_BILL' end end;
  if v_route is null and exists(select 1 from public.weekly_source_group_rule_assignments a
    join public.weekly_source_client_policies p on p.source_group_id=a.source_group_id and p.client_id=v_client
    where a.source_group_id=g.id and a.feature_enabled and a.feature_purpose='SIGNED_CHECK_ONLY' and a.rule_set_version_id is null
      and v_week between a.effective_from_week_ending and coalesce(a.effective_to_week_ending,'infinity'::date)
      and v_week between p.effective_from and coalesce(p.effective_to,'infinity'::date)
      and p.authority_mode='TIMESHEET_AUTHORITY' and p.document_mode='INVOICE_EVIDENCE_REQUIRED' and not p.self_bill_enabled) then
    v_route:='SIGNED_TIMESHEETS';
  end if;
  if v_route is null then return jsonb_build_object('applies',false,'preserve_native',true); end if;
  -- R-252 retains the client's latest ended calendar week, not its latest
  -- week containing a Timesheet. A completed old week must disappear even
  -- when no worker submitted a newer week. Reuse the native settings owner.
  v_calendar_authority:=private.weekly_source_checklist_client_calendar_v1(v_client,v_today);
  v_latest_week:=(v_calendar_authority->>'latest_ended_week')::date;
  -- Only actual Client authority narrows the witness scan. There is no booked
  -- Client/booking-name or live current-setting substitute for nullable Daily.
  with scoped as materialized (
    select t.*,s.witness,rctx.route_read,tv.status::text validation_status,tv.last_source validation_import_id,tf.processing_status::text processing_status,
      exists(select 1 from private.timesheet_correction_requests r where r.state='WAITING'
        and r.reversed_timesheet_id=t.timesheet_id) correction_waiting
    from public.timesheets t left join public.contracts con on con.id=t.contract_id
    left join public.timesheets_financials tf on tf.timesheet_id=t.timesheet_id and tf.is_current and tf.timesheet_version=t.version
    cross join lateral(select case when v_route='SIGNED_TIMESHEETS'
      then private.weekly_source_signed_submission_read_context_v1(t.timesheet_id,g.id)
      else jsonb_build_object('eligible',true,'submission_witness',private.weekly_source_actual_timesheet_submission_v1(t.timesheet_id)) end route_read) rctx
    cross join lateral(select rctx.route_read->'submission_witness' witness) s
    left join lateral(select * from public.timesheet_validations v where v.timesheet_id=t.timesheet_id
      order by v.updated_at desc,v.created_at desc,v.id desc limit 1) tv on true
    where t.is_current and t.archived_at_utc is null and t.revoked_at is null
      and coalesce(con.client_id,case when t.contract_id is null and t.sheet_scope::text='DAILY' then tf.client_id end)=v_client
      and t.week_ending_date<v_today
      and exists(select 1 from public.weekly_source_group_clients m where m.source_group_id=g.id and m.client_id=v_client
        and t.week_ending_date between m.valid_from and coalesce(m.valid_to,'infinity'::date))
  ), counted as (
    select * from scoped where (witness->>'actual_submitted')::boolean is true and (route_read->>'eligible')::boolean is true
  ) select max(week_ending_date),count(*) filter(where week_ending_date=v_week)::integer,
    null::integer,
    coalesce(jsonb_agg(jsonb_build_object('timesheet_id',timesheet_id,'witness',witness,'submission_read_context',route_read,
      'ordinary_authorised',authorised_at_server is not null,'validation_status',validation_status,
      'processing_status',processing_status,'correction_waiting',correction_waiting)
      order by timesheet_id) filter(where week_ending_date=v_week),'[]'::jsonb),
    null::integer,
    coalesce((select jsonb_agg(jsonb_build_object('code',reason,'unproved_timesheet_count',number) order by reason)
      from(select witness->>'reason' reason,count(distinct timesheet_id) number from scoped
        where week_ending_date=v_week and witness->>'support_state'='UNPROVED'
        group by witness->>'reason') unproved),'[]'::jsonb)
    into v_latest_timesheet_week,v_count,v_open,v_actual,v_earlier_open,v_unproved from counted;
  v_gate:=v_gate||v_unproved;
  if v_route='SIGNED_TIMESHEETS' then
    -- P1-CHECKLIST-RETENTION1: obtain open work from the actual raw owner
    -- before old-week admission. Discover real submitted weeks/cycles only;
    -- no fixed lookback, fake cycle or R254 information-only admission.
    v_count:=0; v_open:=0; v_earlier_open:=0; v_actual:='[]'::jsonb; v_latest_timesheet_week:=null;
    for v_read_scope in
      with signed_weeks as materialized (
        select distinct t.week_ending_date from public.timesheets t
        cross join lateral(select private.weekly_source_signed_submission_read_context_v1(t.timesheet_id,g.id) context) signed_read
        where signed_read.context->'eligible'='true'::jsonb
          and signed_read.context#>'{submission_witness,actual_submitted}'='true'::jsonb
          and signed_read.context#>>'{submission_witness,client_id}'=v_client::text and t.week_ending_date<v_today
          and exists(select 1 from public.weekly_source_group_clients m where m.source_group_id=g.id and m.client_id=v_client
            and t.week_ending_date between m.valid_from and coalesce(m.valid_to,'infinity'::date))
      ) select week.week_ending_date,owner.cycle_id,owner.owner_count from signed_weeks week
      cross join lateral(select count(*) owner_count,(array_agg(cycle.id order by cycle.id))[1] cycle_id
        from public.weekly_source_cycles cycle where cycle.source_group_id=g.id
          and week.week_ending_date between cycle.finalisation_week_ending-6 and cycle.finalisation_week_ending
          and (cycle.scope_client_id=v_client or (cycle.scope_client_id is null and not exists(
            select 1 from public.weekly_source_cycles preferred where preferred.source_group_id=g.id
              and preferred.scope_client_id=v_client
              and week.week_ending_date between preferred.finalisation_week_ending-6 and preferred.finalisation_week_ending)))) owner
      order by week.week_ending_date
    loop
      if v_read_scope.owner_count<>1 then raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
      if v_read_scope.week_ending_date=v_week and v_read_scope.cycle_id<>c.id then
        raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001';
      end if;
      v_cursor:=null; v_revision:=null; v_rows:='[]'::jsonb;
      loop
        v_page:=private.weekly_source_check_only_query_rows_v1(v_read_scope.cycle_id,v_client,
          jsonb_strip_nulls(jsonb_build_object('actor_user_id',v_actor,'source_group_id',g.id,
            'week_ending',v_read_scope.week_ending_date,'limit',100,'cursor',v_cursor)));
        if v_page->'ok' is distinct from 'true'::jsonb then raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_READ_UNAVAILABLE' using errcode='55000'; end if;
        if v_revision is not null and v_revision is distinct from v_page->>'read_revision' then
          raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001';
        end if;
        v_revision:=v_page->>'read_revision'; v_rows:=v_rows||v_page->'rows';
        exit when v_page->'has_more'='false'::jsonb;
        if v_cursor is not distinct from v_page->>'next_cursor' then raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_READ_UNAVAILABLE' using errcode='55000'; end if;
        v_cursor:=v_page->>'next_cursor';
      end loop;
      if exists(select 1 from jsonb_array_elements(v_rows) r where r->>'item_kind'='ACTUAL_TIMESHEET'
        and jsonb_typeof(r->'open_read_item') is distinct from 'boolean') then
        raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_READ_UNAVAILABLE' using errcode='55000';
      end if;
      select count(*)::integer,count(*) filter(where r->'open_read_item'='true'::jsonb)::integer
        into v_scope_count,v_scope_open from jsonb_array_elements(v_rows) r
        where r->>'item_kind'='ACTUAL_TIMESHEET' and r#>'{submission_witness,actual_submitted}'='true'::jsonb;
      v_money_scope:=jsonb_build_object('source_group_id',g.id,'source_cycle_id',v_read_scope.cycle_id,
        'client_id',v_client,'week_ending',v_read_scope.week_ending_date);
      v_scope_money:='[]'::jsonb;v_scope_money_facts:='[]'::jsonb;
      for v_money_row in select r from jsonb_array_elements(v_rows) r
        where r->>'item_kind'='ACTUAL_TIMESHEET' and r#>'{submission_witness,actual_submitted}'='true'::jsonb loop
        v_money:=private.weekly_source_checklist_ordinary_next_hold_money_v1((v_money_row->>'timesheet_id')::uuid,v_money_scope,v_actor);
        v_scope_money_facts:=v_scope_money_facts||jsonb_build_array(v_money->'native_facts');
        if v_money->'known'='true'::jsonb then
          v_scope_money:=v_scope_money||jsonb_build_array(v_money-'native_facts');
          -- Retain the week using the SAME native financial truth. No R254
          -- information row can enter this authentic counted-Timesheet arm.
          v_scope_open:=v_scope_open+1;
        end if;
        v_legacy:=private.weekly_source_checklist_legacy_hold_review_v1((v_money_row->>'timesheet_id')::uuid,v_money_scope,v_actor);
        v_scope_money_facts:=v_scope_money_facts||jsonb_build_array(v_legacy->'native_facts');
        if v_legacy->'review_required'='true'::jsonb then
          v_scope_money:=v_scope_money||jsonb_build_array((v_legacy-'native_facts')||jsonb_build_object('native_financial_kind','LEGACY_REVIEW'));
          v_scope_open:=v_scope_open+1;
        end if;
      end loop;
      if v_read_scope.week_ending_date=v_week then
        v_financial_items:=v_scope_money;v_financial_facts:=v_scope_money_facts;
      end if;
      if v_scope_count>0 then v_latest_timesheet_week:=v_read_scope.week_ending_date; end if;
      if v_scope_count>0 and v_scope_open>0 and v_read_scope.week_ending_date<v_latest_week then v_earlier_open:=v_earlier_open+1; end if;
      if v_read_scope.week_ending_date=v_week then
        v_count:=v_scope_count; v_open:=v_scope_open; v_query_revision:=v_revision;
        select coalesce(jsonb_agg(r order by r->>'timesheet_id'),'[]'::jsonb) into v_actual from jsonb_array_elements(v_rows) r
          where r->>'item_kind'='ACTUAL_TIMESHEET' and r#>'{submission_witness,actual_submitted}'='true'::jsonb;
      end if;
      v_retention_reads:=v_retention_reads||jsonb_build_array(jsonb_build_object('week_ending',v_read_scope.week_ending_date,
        'source_cycle_id',v_read_scope.cycle_id,'read_revision',v_revision,'actual_timesheet_count',v_scope_count,'open_read_items',v_scope_open,
        'native_financial_facts',v_scope_money_facts));
    end loop;
  end if;
  if v_route='AGENCY_INVOICE' then
    v_money_scope:=jsonb_build_object('source_group_id',g.id,'source_cycle_id',c.id,'client_id',v_client,'week_ending',v_week);
    for v_money_row in select value from jsonb_array_elements(v_actual) loop
      v_money:=private.weekly_source_checklist_ordinary_next_hold_money_v1((v_money_row->>'timesheet_id')::uuid,v_money_scope,v_actor);
      v_financial_facts:=v_financial_facts||jsonb_build_array(v_money->'native_facts');
      if v_money->'known'='true'::jsonb then v_financial_items:=v_financial_items||jsonb_build_array(v_money-'native_facts'); end if;
      v_legacy:=private.weekly_source_checklist_legacy_hold_review_v1((v_money_row->>'timesheet_id')::uuid,v_money_scope,v_actor);
      v_financial_facts:=v_financial_facts||jsonb_build_array(v_legacy->'native_facts');
      if v_legacy->'review_required'='true'::jsonb then
        v_financial_items:=v_financial_items||jsonb_build_array((v_legacy-'native_facts')||jsonb_build_object('native_financial_kind','LEGACY_REVIEW'));end if;
    end loop;
  end if;
  if v_route='SIGNED_TIMESHEETS' and (v_count=0 or (v_week<>v_latest_week and v_open=0)) then
    return jsonb_build_object('applies',true,'admitted',false,'route',v_route,'preserve_native',false,
      'actual_timesheet_count',v_count,'engineering_gates',v_gate);
  end if;
  -- This cell duty is process completion, not cash settlement. Keep every
  -- final scope/revision receipt; a CURRENT client completion is not enough
  -- for separate export pay plus invoice report history.
  select jsonb_build_object(
    'expected_contract_weeks',coalesce((select jsonb_agg(jsonb_build_object('contract_week_id',cw.id,
      'contract_id',cw.contract_id,'status',cw.status,'week_ending',cw.week_ending_date,'timesheet_id',cw.timesheet_id) order by cw.id)
      from public.contract_weeks cw join public.contracts con on con.id=cw.contract_id and con.client_id=v_client
      where cw.week_ending_date=v_week and cw.additional_seq=0 and not cw.is_adjustment
        and cw.status::text in('PLANNED','OPEN','SUBMITTED')),'[]'::jsonb),
    'accepted_checking_uploads',coalesce((select jsonb_agg(jsonb_build_object('upload_id',u.id,'uploaded_at_utc',u.uploaded_at_utc,
      'coverage_start',u.confirmed_coverage_start_local_date,'coverage_end',u.confirmed_coverage_end_local_date,
      'coverage_confirmed_at_utc',u.coverage_confirmed_at_utc,'coverage_confirmed_by',u.coverage_confirmed_by_user_id,
      'covers_whole_week',u.confirmed_coverage_start_local_date<=v_week-6 and u.confirmed_coverage_end_local_date>=v_week,
      'state',u.state,'accepted_attempt_id',attempt.id,'import_use',u.file_metadata_json->'import_use') order by u.uploaded_at_utc desc,u.id)
      from public.weekly_source_uploads u
      join lateral(select a.id from public.weekly_source_upload_attempts a where a.logical_upload_id=u.id and a.result='ACCEPTED'
        order by a.attempted_at_utc desc,a.id desc limit 1) attempt on true
      where u.source_cycle_id=c.id and u.report_scope_id is null and u.state in('CURRENT','SUPERSEDED')
        and upper(coalesce(u.file_metadata_json->>'import_use','CHECKING'))='CHECKING'
        and (c.scope_client_id=v_client or exists(select 1 from public.weekly_source_row_resolutions rr
          where rr.upload_row_id in(select ur.id from public.weekly_source_upload_rows ur where ur.upload_id=u.id)
            and rr.client_id=v_client and rr.mapping_state='RESOLVED'))),'[]'::jsonb),
    'completion_history',coalesce((select jsonb_agg(to_jsonb(completion) order by completion.completion_generation,completion.id)
      from public.weekly_source_client_cycle_completions completion where completion.source_cycle_id=c.id and completion.client_id=v_client),'[]'::jsonb),
    'final_revision_history',coalesce((select jsonb_agg(jsonb_build_object('final_revision_id',fr.id,'authority_scope_kind',fr.authority_scope_kind,
      'report_scope_id',fr.report_scope_id,'state',fr.state,'revision_number',fr.revision_number,'finalised_at_utc',fr.finalised_at_utc,
      'manifest_hash',encode(fr.manifest_hash,'hex'),'client_manifest_id',cm.id,'invoice_state',cm.invoice_state) order by fr.revision_number,fr.id)
      from public.weekly_source_final_revisions fr join public.weekly_source_client_manifests cm on cm.final_revision_id=fr.id and cm.client_id=v_client
      where fr.source_cycle_id=c.id),'[]'::jsonb),
    'report_scopes',coalesce((select jsonb_agg(jsonb_build_object('report_scope_id',rs.id,'self_bill_report_id',rs.self_bill_report_id,
      'version',rs.version,'current_complete_upload_id',rs.current_complete_upload_id,'current_projection_publication_id',rs.current_projection_publication_id,
      'current_final_revision_id',rs.current_final_revision_id) order by rs.id) from public.weekly_source_report_scopes rs
      where rs.source_cycle_id=c.id and rs.client_id=v_client),'[]'::jsonb)
  ) into v_facts;
  if v_week>=v_today then return jsonb_build_object('applies',true,'admitted',false,'route',v_route); end if;
  if v_route<>'SIGNED_TIMESHEETS' and jsonb_array_length(v_facts->'expected_contract_weeks')=0
    and jsonb_array_length(v_facts->'accepted_checking_uploads')=0 and jsonb_array_length(v_facts->'completion_history')=0
    and jsonb_array_length(v_facts->'report_scopes')=0 then
    return jsonb_build_object('applies',true,'admitted',false,'route',v_route);
  end if;
  if v_route='SIGNED_TIMESHEETS' and coalesce(p_request->>'command','CONTEXT')='ISSUES' then
    return private.weekly_source_check_only_query_rows_v1(c.id,v_client,jsonb_build_object('actor_user_id',v_actor,
      'source_group_id',g.id,'week_ending',v_week,'cursor',p_request->'cursor','limit',coalesce(p_request->'limit','50'::jsonb)));
  end if;
  -- A proved WAIT is an approved Source decision, never paid=true. Missing or
  -- partial proof stays unknown; it is not quietly reduced to zero waiting.
  if to_regprocedure('private.weekly_source_protected_wait_witness_v1(uuid,uuid)') is null then
    v_wait:=null; v_gate:=v_gate||jsonb_build_array('QUALIFIED_WAIT_READER_UNAVAILABLE');
  else
    for v_event in select e.id from public.weekly_work_events e where e.client_id=v_client
      and e.first_source_group_id=g.id and e.work_date between v_week-6 and v_week order by e.id loop
      begin
        execute 'select private.weekly_source_protected_wait_witness_v1($1,$2)' into v_wait_fact using v_event.id,c.id;
        if v_wait_fact is not null then
          if v_wait_fact->>'state' is distinct from 'QUALIFIED_WAIT' then raise exception 'WAIT'; end if;
          v_wait:=v_wait+1;
        end if;
      exception when sqlstate '55000' then
        v_wait:=null; v_gate:=v_gate||jsonb_build_array(jsonb_build_object('code','QUALIFIED_WAIT_WITNESS_UNAVAILABLE','work_event_id',v_event.id));
      end;
    end loop;
  end if;
  return jsonb_build_object('applies',true,'admitted',true,'contract','WEEKLY_SOURCE_HEALTHROSTER_CHECKLIST_CONTEXT_V1',
    'scope',jsonb_build_object('source_group_id',g.id,'source_cycle_id',c.id,'client_id',v_client,
      'week_ending',v_week,'cycle_week_ending',c.finalisation_week_ending),'route',v_route,
    'permission_view',case when v_admin then 'ADMIN' else 'PAY_READONLY' end,
    'source_cycle_version',c.version,'effective_rule',v_rule,'native_process_facts',v_facts,
    'checking_due_local_date',v_week+(8-extract(isodow from v_week)::integer),
    'checking_due',v_today>=v_week+(8-extract(isodow from v_week)::integer),
    'actual_timesheet_count',v_count,'actual_timesheet_authority_hash',
      encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECKLIST_ACTUAL_SET_V1',v_actual),'hex'),
    'most_recent_ended_timesheet_week',v_latest_timesheet_week,
    'most_recent_ended_client_week',v_latest_week,
    'client_week_authority_fingerprint',v_calendar_authority->>'authority_fingerprint','open_timesheet_read_items',v_open,
    'earlier_open_weeks',v_earlier_open,'native_query_read_revision',v_query_revision,
    'qualified_waiting_count',v_wait,'engineering_gates',v_gate,
    'native_financial_items',v_financial_items,'native_financial_facts',v_financial_facts,
    'pay_financial_evidence_required',true,'root_checklist_union_required',true,
    'read_revision',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_HEALTHROSTER_CHECKLIST_CONTEXT_V1',
      jsonb_build_object('scope',p_request-'cursor'-'limit','cycle_version',c.version,'actual',v_actual,'facts',v_facts,
        'latest_week',v_latest_week,'latest_timesheet_week',v_latest_timesheet_week,
        'client_week_authority_fingerprint',v_calendar_authority->>'authority_fingerprint',
        'earlier_open_weeks',v_earlier_open,'actual_count',v_count,'open_read_items',v_open,'retention_reads',v_retention_reads,
        'wait_count',v_wait,'gates',v_gate,'native_financial_items',v_financial_items,'native_financial_facts',v_financial_facts)),'hex'));
end;
$function$;

create or replace function private.weekly_source_check_only_candidate_reminder_subject_v1(
  p_scope jsonb,p_action_id text,p_candidate_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare decision public.import_review_decisions%rowtype; hr public.hr_rows%rowtype;
  preview public.import_review_states%rowtype; cycle public.weekly_source_cycles%rowtype;
  witness jsonb; submitted jsonb:='[]'::jsonb; ts record;
begin
  perform private._weekly_source_settings_assert_request_v1(p_scope,
    array['source_group_id','source_cycle_id','client_id','week_ending'],'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_SCOPE_INVALID');
  if jsonb_typeof(p_scope->'source_group_id') is distinct from 'string'
    or jsonb_typeof(p_scope->'source_cycle_id') is distinct from 'string'
    or jsonb_typeof(p_scope->'client_id') is distinct from 'string'
    or jsonb_typeof(p_scope->'week_ending') is distinct from 'string'
    or not pg_input_is_valid(p_scope->>'source_group_id','uuid')
    or not pg_input_is_valid(p_scope->>'source_cycle_id','uuid')
    or not pg_input_is_valid(p_scope->>'client_id','uuid')
    or not pg_input_is_valid(p_scope->>'week_ending','date')
    or p_action_id is null or p_action_id!~'^[0-9a-f]{64}$' or p_candidate_id is null then
    raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_SCOPE_INVALID' using errcode='22023';
  end if;
  select c.* into cycle from public.weekly_source_cycles c where c.id=(p_scope->>'source_cycle_id')::uuid
    and c.source_group_id=(p_scope->>'source_group_id')::uuid
    and (c.scope_client_id is null or c.scope_client_id=(p_scope->>'client_id')::uuid)
    and (p_scope->>'week_ending')::date between c.finalisation_week_ending-6 and c.finalisation_week_ending;
  if cycle.id is null then return jsonb_build_object('current_native_action',false,'reason','SCOPE_UNAVAILABLE'); end if;
  select d.* into decision from public.import_review_decisions d join public.hr_imports i on i.id=d.import_id
    and i.pruned_at is null and i.source_system::text in('HEALTHROSTER','HEALTHROSTER_DAILY')
    and (i.client_id is null or i.client_id=d.client_id)
    where d.action_id=p_action_id and d.is_current and d.client_id=(p_scope->>'client_id')::uuid
      and d.candidate_id=p_candidate_id and d.timesheet_id is null and d.action_kind='ADVISORY'
      and d.summary_json->>'authority_mode'='VALIDATION_ONLY'
      and d.summary_json->>'reason_code' in('DAILY_TIMESHEET_NOT_SUBMITTED','WEEKLY_TIMESHEET_NOT_SUBMITTED');
  if decision.action_id is null then return jsonb_build_object('current_native_action',false,'reason','NATIVE_ACTION_NO_LONGER_CURRENT'); end if;
  select h.* into hr from public.hr_rows h where h.id=decision.hr_row_id and h.import_id=decision.import_id
    and h.date_local between (p_scope->>'week_ending')::date-6 and (p_scope->>'week_ending')::date;
  select s.* into preview from public.import_review_states s where s.import_id=decision.import_id
    and s.preview_generation=decision.preview_generation and s.superseded_at_utc is null and s.abandoned_at_utc is null;
  if hr.id is null or preview.import_id is null then
    return jsonb_build_object('current_native_action',false,'reason','NATIVE_PREVIEW_NO_LONGER_CURRENT');
  end if;
  -- No planned clocks, workflow-state shortcut or new submission predicate.
  -- A genuine pending Daily immutable submission can precede physical clocks;
  -- that native witness already resolves the submit reminder, while the real
  -- D10 catalogue/ADVISORY remains unchanged for its existing review owner.
  for ts in select t.timesheet_id from public.timesheets t
    where t.week_ending_date=(p_scope->>'week_ending')::date
      and t.sheet_scope::text=case when decision.summary_json->>'reason_code'='DAILY_TIMESHEET_NOT_SUBMITTED' then 'DAILY' else 'WEEKLY' end
    order by t.timesheet_id
  loop
    witness:=private.weekly_source_actual_timesheet_submission_v1(ts.timesheet_id);
    if witness->'actual_submitted'='true'::jsonb and witness->>'candidate_id'=p_candidate_id::text
      and witness->>'client_id'=p_scope->>'client_id'
      and ((decision.summary_json->>'reason_code'='DAILY_TIMESHEET_NOT_SUBMITTED' and witness->>'work_date'=hr.date_local::text)
        or (decision.summary_json->>'reason_code'='WEEKLY_TIMESHEET_NOT_SUBMITTED'
          and decision.contract_id is not null and witness->>'contract_id'=decision.contract_id::text)) then
      submitted:=submitted||jsonb_build_array(witness);
    end if;
  end loop;
  return jsonb_build_object('current_native_action',true,'actual_submission_present',jsonb_array_length(submitted)>0,
    'native_action',jsonb_build_object('action_id',decision.action_id,'candidate_id',decision.candidate_id,
      'import_id',decision.import_id,'hr_row_id',hr.id,'work_date',hr.date_local,'contract_id',decision.contract_id,
      'preview_generation',preview.preview_generation,'state_version',preview.state_version,
      'preview_fingerprint',preview.preview_fingerprint,'evidence_fingerprint',decision.evidence_fingerprint,
      'native_reason_code',decision.summary_json->>'reason_code'),
    'actual_submission_witnesses',submitted);
end;
$function$;

create or replace function private.weekly_source_check_only_candidate_reminder_context_v1(
  p_actor_user_id uuid,p_scope jsonb,p_action_id text
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare actor public.tms_users%rowtype; cycle public.weekly_source_cycles%rowtype; source_group public.weekly_source_groups%rowtype;
  decision public.import_review_decisions%rowtype; account public.candidate_app_accounts%rowtype;
  link public.candidate_app_global_membership_links%rowtype; settings public.weekly_source_global_settings%rowtype;
  page jsonb; cursor text; revision text; raw jsonb; found_row jsonb; subject jsonb; matches integer:=0;
  links integer; target jsonb; contract_week_id uuid; context jsonb; last_reminder timestamptz; now_at timestamptz:=statement_timestamp();
begin
  perform private.weekly_source_query_require_service_v1();
  perform private._weekly_source_settings_assert_request_v1(p_scope,
    array['source_group_id','source_cycle_id','client_id','week_ending'],'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_SCOPE_INVALID');
  if jsonb_typeof(p_scope->'source_group_id') is distinct from 'string'
    or jsonb_typeof(p_scope->'source_cycle_id') is distinct from 'string'
    or jsonb_typeof(p_scope->'client_id') is distinct from 'string'
    or jsonb_typeof(p_scope->'week_ending') is distinct from 'string'
    or not pg_input_is_valid(p_scope->>'source_group_id','uuid')
    or not pg_input_is_valid(p_scope->>'source_cycle_id','uuid')
    or not pg_input_is_valid(p_scope->>'client_id','uuid')
    or not pg_input_is_valid(p_scope->>'week_ending','date') then
    raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_SCOPE_INVALID' using errcode='22023';
  end if;
  select u.* into actor from public.tms_users u where u.id=p_actor_user_id and u.is_active;
  if actor.id is null or actor.role::text is distinct from 'admin' then
    raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_ACTOR_FORBIDDEN' using errcode='42501';
  end if;
  select c.* into cycle from public.weekly_source_cycles c where c.id=(p_scope->>'source_cycle_id')::uuid;
  select g.* into source_group from public.weekly_source_groups g where g.id=cycle.source_group_id and g.active and g.source_family='ROSTER';
  if source_group.id is null or source_group.id::text is distinct from p_scope->>'source_group_id'
    or nullif(p_action_id,'') is null then raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_SCOPE_INVALID' using errcode='22023'; end if;
  perform private.weekly_source_office_authority_v1(actor.id,'VIEW_SOURCE_PROGRESS',source_group.id,
    (p_scope->>'client_id')::uuid,(p_scope->>'week_ending')::date);
  cursor:=null;
  loop
    page:=private.weekly_source_check_only_query_rows_v1(cycle.id,(p_scope->>'client_id')::uuid,
      jsonb_strip_nulls(jsonb_build_object('actor_user_id',actor.id,'source_group_id',source_group.id,
        'week_ending',p_scope->>'week_ending','limit',100,'cursor',cursor)));
    if page->'ok' is distinct from 'true'::jsonb or (revision is not null and revision is distinct from page->>'read_revision') then
      raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_STALE' using errcode='40001';
    end if;
    revision:=page->>'read_revision';
    for raw in select value from jsonb_array_elements(page->'rows') loop
      if raw->>'item_kind'='SOURCE_INFORMATION' and raw->>'action_id'=p_action_id then found_row:=raw; matches:=matches+1; end if;
    end loop;
    exit when page->'has_more'='false'::jsonb;
    if cursor is not distinct from page->>'next_cursor' then raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_STALE' using errcode='40001'; end if;
    cursor:=page->>'next_cursor';
  end loop;
  if matches<>1 or found_row->'counts_for_row_admission' is distinct from 'false'::jsonb
    or found_row->'open_read_item' is distinct from 'false'::jsonb then
    raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_SUBJECT_UNAVAILABLE' using errcode='55000';
  end if;
  select d.* into decision from public.import_review_decisions d where d.action_id=p_action_id and d.is_current
    and d.import_id=(found_row->>'query_import_id')::uuid and d.hr_row_id=(found_row->>'hr_row_id')::uuid
    and d.client_id=(p_scope->>'client_id')::uuid and d.candidate_id=(found_row->>'candidate_id')::uuid
    and d.timesheet_id is null and d.action_kind='ADVISORY'
    and d.summary_json->>'authority_mode'='VALIDATION_ONLY'
    and d.summary_json->>'reason_code' in('DAILY_TIMESHEET_NOT_SUBMITTED','WEEKLY_TIMESHEET_NOT_SUBMITTED')
    and d.evidence_fingerprint=found_row->>'evidence_fingerprint';
  if decision.action_id is null or not exists(select 1 from public.candidates c where c.id=decision.candidate_id and c.active) then
    raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_SUBJECT_UNAVAILABLE' using errcode='55000';
  end if;
  subject:=private.weekly_source_check_only_candidate_reminder_subject_v1(p_scope,p_action_id,decision.candidate_id);
  if subject->'current_native_action' is distinct from 'true'::jsonb then
    return jsonb_build_object('available',false,'reason','NATIVE_ACTION_NO_LONGER_CURRENT');
  end if;
  if subject->'actual_submission_present' is distinct from 'false'::jsonb then
    return jsonb_build_object('available',false,'reason','ACTUAL_SUBMISSION_ALREADY_PRESENT');
  end if;
  perform private._candidate_assert_environment(source_group.environment);
  if private._candidate_feature_enabled_v1(source_group.environment,'candidate_notifications') is not true then
    return jsonb_build_object('available',false,'reason','CANDIDATE_NOTIFICATIONS_DISABLED');
  end if;
  select count(*),(array_agg(l.membership_id order by l.membership_id))[1] into links,link.membership_id
    from public.candidate_app_global_membership_links l join public.candidate_app_accounts a on a.id=l.account_id
    where l.candidate_id=decision.candidate_id and l.state='ACTIVE' and a.status='ACTIVE' and a.environment=source_group.environment;
  if links<>1 then return jsonb_build_object('available',false,'reason','CANDIDATE_APP_UNAVAILABLE'); end if;
  select l.* into link from public.candidate_app_global_membership_links l where l.membership_id=link.membership_id;
  select a.* into account from public.candidate_app_accounts a where a.id=link.account_id;
  select s.* into strict settings from public.weekly_source_global_settings s where s.singleton;
  -- Existing target contract only: Daily hub, real unique Contract week, or
  -- native Home. Never fabricate a Timesheet/workflow/Source request identity.
  target:=case when decision.summary_json->>'reason_code'='DAILY_TIMESHEET_NOT_SUBMITTED'
    then jsonb_build_object('type','daily') else '{}'::jsonb end;
  if decision.summary_json->>'reason_code'='WEEKLY_TIMESHEET_NOT_SUBMITTED' and decision.contract_id is not null then
    select case when count(*)=1 then (array_agg(cw.id))[1] end into contract_week_id
      from public.contract_weeks cw join public.contracts c on c.id=cw.contract_id
      where cw.contract_id=decision.contract_id and c.client_id=decision.client_id and c.candidate_id=decision.candidate_id
        and cw.week_ending_date=(p_scope->>'week_ending')::date and cw.additional_seq=0 and not cw.is_adjustment;
    if contract_week_id is not null then target:=jsonb_build_object('contract_week_id',contract_week_id); end if;
  end if;
  select max(n.created_at_utc) into last_reminder from public.candidate_notifications n
    where n.candidate_id=decision.candidate_id and n.event_type='CHECK_ONLY_TIMESHEET_REMINDER'
      and n.template_params->>'client_id'=decision.client_id::text
      and n.template_params->>'week_ending'=p_scope->>'week_ending';
  context:=jsonb_build_object('actor_user_id',actor.id,'scope',p_scope,'item_id',found_row->'item_id',
    'action_id',decision.action_id,'import_id',decision.import_id,'preview_generation',decision.preview_generation,
    'state_version',found_row#>'{query_preview,state_version}','preview_fingerprint',found_row#>'{query_preview,preview_fingerprint}',
    'evidence_fingerprint',decision.evidence_fingerprint,'native_reason_code',decision.summary_json->>'reason_code',
    'native_action',subject->'native_action','candidate_id',decision.candidate_id,'account_id',account.id,'membership_id',link.membership_id,
    'membership_generation',link.membership_generation,'target',target,
    'candidate_manual_reminder_cooldown_seconds',extract(epoch from settings.candidate_manual_reminder_cooldown),
    'next_available_at_utc',last_reminder+settings.candidate_manual_reminder_cooldown);
  return jsonb_build_object('available',last_reminder is null or now_at>=last_reminder+settings.candidate_manual_reminder_cooldown,
    'reason',case when last_reminder is not null and now_at<last_reminder+settings.candidate_manual_reminder_cooldown then 'CANDIDATE_REMINDER_COOLDOWN' end,
    'context',context,'context_hash',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECK_ONLY_CANDIDATE_REMINDER_CONTEXT_V1',
      jsonb_build_object('native_row',found_row,'source_revision',revision,'subject',subject,'actor',to_jsonb(actor),'account',to_jsonb(account),'link',to_jsonb(link),'context',context)),'hex'));
end;
$function$;

create or replace function public.weekly_source_check_only_candidate_reminder_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare actor public.tms_users%rowtype; actor_before jsonb; scope jsonb; context jsonb; facts jsonb;
  group_page jsonb; parent jsonb; parent_count integer; child_count integer; fresh_count integer;
  notification public.candidate_notifications%rowtype; native_result jsonb; settings public.weekly_source_global_settings%rowtype;
  dedupe text; request_hash text; idempotency_key uuid; now_at timestamptz:=transaction_timestamp(); next_at timestamptz;
begin
  perform private.weekly_source_query_require_service_v1();
  perform private._weekly_source_settings_assert_request_v1(p_request,
    array['actor_user_id','scope','parent_group_key','action_id','parent_proof_hash','candidate_context_hash','idempotency_key'],
    'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_REQUEST_INVALID');
  if jsonb_typeof(p_request->'actor_user_id') is distinct from 'string'
    or jsonb_typeof(p_request->'scope') is distinct from 'object'
    or jsonb_typeof(p_request->'parent_group_key') is distinct from 'string'
    or jsonb_typeof(p_request->'action_id') is distinct from 'string'
    or jsonb_typeof(p_request->'parent_proof_hash') is distinct from 'string'
    or jsonb_typeof(p_request->'candidate_context_hash') is distinct from 'string'
    or jsonb_typeof(p_request->'idempotency_key') is distinct from 'string'
    or p_request->>'parent_group_key'!~'^d10g_[0-9a-f]{64}$'
    or p_request->>'action_id'!~'^[0-9a-f]{64}$' or p_request->>'parent_proof_hash'!~'^[0-9a-f]{64}$'
    or p_request->>'candidate_context_hash'!~'^[0-9a-f]{64}$' then
    raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_REQUEST_INVALID' using errcode='22023';
  end if;
  scope:=p_request->'scope'; idempotency_key:=(p_request->>'idempotency_key')::uuid;
  perform private._weekly_source_settings_assert_request_v1(scope,
    array['source_group_id','source_cycle_id','client_id','week_ending'],'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_SCOPE_INVALID');
  select u.* into actor from public.tms_users u where u.id=(p_request->>'actor_user_id')::uuid and u.is_active;
  if actor.id is null or actor.role::text is distinct from 'admin' then
    raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_ACTOR_FORBIDDEN' using errcode='42501';
  end if;
  actor_before:=to_jsonb(actor);
  perform private.weekly_source_office_authority_v1(actor.id,'VIEW_SOURCE_PROGRESS',
    (scope->>'source_group_id')::uuid,(scope->>'client_id')::uuid,(scope->>'week_ending')::date);
  dedupe:='check-only-d10-candidate-reminder:'||actor.id::text||':'||idempotency_key::text;
  request_hash:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECK_ONLY_CANDIDATE_REMINDER_REQUEST_V1',p_request),'hex');
  -- A committed exact replay returns its real first notification before mutable
  -- action/cooldown consultation. A reused key with changed input is refused.
  select n.* into notification from public.candidate_notifications n where n.dedupe_key=dedupe;
  if notification.id is not null then
    if notification.event_type is distinct from 'CHECK_ONLY_TIMESHEET_REMINDER'
      or notification.template_params->>'request_hash' is distinct from request_hash then
      raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_IDEMPOTENCY_CONFLICT' using errcode='23505';
    end if;
    return jsonb_build_object('ok',true,'contract','WEEKLY_SOURCE_CHECK_ONLY_CANDIDATE_REMINDER_V1',
      'actor_user_id',actor.id,'scope',scope,'action_id',p_request->>'action_id','idempotency_key',idempotency_key,
      'notification_id',notification.id,'queued',true,'replay',true,
      'next_available_at_utc',notification.template_params->'next_available_at_utc');
  end if;
  facts:=private.weekly_source_check_only_candidate_reminder_context_v1(actor.id,scope,p_request->>'action_id');
  if facts->'available' is distinct from 'true'::jsonb or facts->>'context_hash' is distinct from p_request->>'candidate_context_hash' then
    raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_UNAVAILABLE_OR_STALE' using errcode='40001';
  end if;
  context:=facts->'context';
  -- Native I1 admission before the finite Candidate cooldown/import/account
  -- locks. No TS/TF family or money is written by this purpose-bound intent.
  perform private.weekly_source_pay_query_admit_v2();
  perform pg_advisory_xact_lock(hashtextextended('check-only-d10-candidate-reminder:'||(context->>'candidate_id')||':'
    ||(scope->>'client_id')||':'||(scope->>'week_ending'),0));
  perform pg_advisory_xact_lock(hashtextextended('candidate-federated-membership:'||(context->>'membership_id'),0));
  perform 1 from public.hr_imports i where i.id=(context->>'import_id')::uuid for update;
  perform 1 from public.import_review_states s where s.import_id=(context->>'import_id')::uuid for update;
  perform 1 from public.candidate_app_global_membership_links l where l.membership_id=(context->>'membership_id')::uuid for update;
  perform 1 from public.candidate_app_accounts a where a.id=(context->>'account_id')::uuid for update;
  select n.* into notification from public.candidate_notifications n where n.dedupe_key=dedupe;
  if notification.id is not null then
    if notification.event_type is distinct from 'CHECK_ONLY_TIMESHEET_REMINDER'
      or notification.template_params->>'request_hash' is distinct from request_hash then
      raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_IDEMPOTENCY_CONFLICT' using errcode='23505';
    end if;
    return jsonb_build_object('ok',true,'contract','WEEKLY_SOURCE_CHECK_ONLY_CANDIDATE_REMINDER_V1',
      'actor_user_id',actor.id,'scope',scope,'action_id',p_request->>'action_id','idempotency_key',idempotency_key,
      'notification_id',notification.id,'queued',true,'replay',true,
      'next_available_at_utc',notification.template_params->'next_available_at_utc');
  end if;
  facts:=private.weekly_source_check_only_candidate_reminder_context_v1(actor.id,scope,p_request->>'action_id');
  if facts->'available' is distinct from 'true'::jsonb or facts->>'context_hash' is distinct from p_request->>'candidate_context_hash' then
    raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_UNAVAILABLE_OR_STALE' using errcode='40001';
  end if;
  context:=facts->'context';
  group_page:=private.weekly_source_check_only_query_groups_v1((scope->>'source_cycle_id')::uuid,(scope->>'client_id')::uuid,
    jsonb_build_object('actor_user_id',actor.id,'source_group_id',scope->>'source_group_id','week_ending',scope->>'week_ending'));
  select count(*),(jsonb_agg(g))->0 into parent_count,parent from jsonb_array_elements(group_page->'groups') g
    where g->>'group_key'=p_request->>'parent_group_key' and g->>'proof_hash'=p_request->>'parent_proof_hash';
  if parent_count<>1 then raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_PARENT_STALE' using errcode='40001'; end if;
  select count(*) into child_count from jsonb_array_elements(parent->'children') child
    where child->>'row_key'=p_request->>'action_id' and child#>>'{native_action_binding,action_kind}'='ADVISORY';
  if child_count<>1 then raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_PARENT_STALE' using errcode='40001'; end if;
  -- This explicit action reproves through the actual current native D10
  -- catalogue. Its temp-table writes remain outside every GET/read graph.
  -- No second comparison of schedules or workflow submission is implemented.
  select count(*) into fresh_count from public._import_review_action_catalog_core_v1((context->>'import_id')::uuid,
    (context->>'preview_generation')::integer,5000) current_action
    where current_action.action_id=p_request->>'action_id' and current_action.action_kind='ADVISORY'
      and current_action.timesheet_id is null
      and current_action.client_id=(scope->>'client_id')::uuid and current_action.candidate_id=(context->>'candidate_id')::uuid
      and current_action.evidence_fingerprint=context->>'evidence_fingerprint'
      and current_action.summary_json->>'authority_mode'='VALIDATION_ONLY'
      and current_action.summary_json->>'reason_code'=context->>'native_reason_code';
  if fresh_count<>1 then raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_SUBJECT_STALE' using errcode='40001'; end if;
  select s.* into strict settings from public.weekly_source_global_settings s where s.singleton;
  next_at:=now_at+settings.candidate_manual_reminder_cooldown;
  native_result:=private._candidate_notification_insert_v1((context->>'account_id')::uuid,(context->>'candidate_id')::uuid,
    null,null,'CHECK_ONLY_TIMESHEET_REMINDER','timesheet_expense_attention','check-only-submit-timesheet-v1',
    jsonb_build_object('request_hash',request_hash,'scope',scope,'client_id',scope->>'client_id','week_ending',scope->>'week_ending',
      'sheet_scope',case when context->>'native_reason_code'='DAILY_TIMESHEET_NOT_SUBMITTED' then 'DAILY' else 'WEEKLY' end,
      'work_date',(select r.date_local from public.hr_rows r where r.id=(select d.hr_row_id from public.import_review_decisions d where d.action_id=p_request->>'action_id')),
      'client_name',(select c.name from public.clients c where c.id=(scope->>'client_id')::uuid),
      'action_id',p_request->>'action_id','native_action',context->'native_action','membership_id',context->'membership_id',
      'next_available_at_utc',next_at),context->'target',dedupe,now_at);
  select u.* into actor from public.tms_users u where u.id=actor.id and u.is_active;
  if to_jsonb(actor) is distinct from actor_before then raise exception 'WEEKLY_SOURCE_CHECK_ONLY_REMINDER_ACTOR_FORBIDDEN' using errcode='42501'; end if;
  perform public._audit_insert('weekly_source_check_only_candidate_reminder',native_result->>'notification_id',
    'WEEKLY_SOURCE_CHECK_ONLY_CANDIDATE_REMINDER_STAGED',null,
    jsonb_build_object('scope',scope,'action_id',p_request->>'action_id','idempotency_key',idempotency_key),
    'Candidate check-only reminder staged',actor.id);
  return jsonb_build_object('ok',true,'contract','WEEKLY_SOURCE_CHECK_ONLY_CANDIDATE_REMINDER_V1',
    'actor_user_id',actor.id,'scope',scope,'action_id',p_request->>'action_id','idempotency_key',idempotency_key,
    'notification_id',native_result->'notification_id','queued',true,'replay',false,'next_available_at_utc',next_at);
end;
$function$;

create or replace function private.weekly_source_checklist_submission_cycle_admit_v1(
  p_workflow_id uuid,p_environment text,p_candidate_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  workflow public.candidate_submission_workflows%rowtype;
  target public.timesheets%rowtype; v_client_id uuid; groups integer; family_lock jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  select w.* into workflow from public.candidate_submission_workflows w
    where w.id=p_workflow_id and w.environment=p_environment and w.candidate_id=p_candidate_id;
  if workflow.id is null or workflow.workflow_kind not in('CONTRACT_HOURS','CONTRACT_COMBINED','DAILY')
    or workflow.target_timesheet_id is null or workflow.cancelled_at_utc is not null then
    return jsonb_build_object('applies',false);
  end if;
  select t.* into target from public.timesheets t where t.timesheet_id=workflow.target_timesheet_id
    and t.is_current and t.archived_at_utc is null and t.revoked_at is null
    and t.status::text not in('REVOKED','ARCHIVED','CANCELLED') and t.line_type::text='HOURS'
    and t.sheet_scope::text in('WEEKLY','DAILY') and t.contract_id is not distinct from workflow.contract_id
    and ((workflow.scope='WEEKLY' and t.week_ending_date=workflow.week_ending_date)
      or (workflow.scope='DAILY' and workflow.week_ending_date is null and workflow.contract_week_id is null
        and workflow.work_date between t.week_ending_date-6 and t.week_ending_date));
  if target.timesheet_id is null or target.correction_kind='WHOLE_TIMESHEET_REVERSAL'
    or exists(select 1 from private.timesheet_correction_requests r where
      (r.state='WAITING' and r.replacement_timesheet_id=target.timesheet_id)
      or (r.state='APPLIED' and r.reversed_timesheet_id=target.timesheet_id)) then
    return jsonb_build_object('applies',false);
  end if;
  if target.contract_id is not null then
    select c.client_id into v_client_id from public.contracts c where c.id=target.contract_id and c.candidate_id=p_candidate_id;
  else
    -- Native Daily may have a null Contract. Require exactly one current TF
    -- owner, including the actual Candidate, rather than inventing a Contract.
    select case when count(*)=1 then (array_agg(f.client_id))[1] end into v_client_id
      from public.timesheets_financials f where f.timesheet_id=target.timesheet_id
        and f.is_current and f.timesheet_version=target.version and f.candidate_id=p_candidate_id;
  end if;
  if v_client_id is null then return jsonb_build_object('applies',false); end if;
  -- This is a potential signed scope only, used to acquire native locks early.
  -- No claim, financial verdict or cycle is manufactured from a draft.
  select count(distinct g.id) into groups from public.weekly_source_groups g
    join public.weekly_source_group_clients m on m.source_group_id=g.id and m.client_id=v_client_id
    join public.weekly_source_group_rule_assignments a on a.source_group_id=g.id
      and a.feature_enabled and a.feature_purpose='SIGNED_CHECK_ONLY' and a.rule_set_version_id is null
    join public.weekly_source_client_policies p on p.source_group_id=g.id and p.client_id=v_client_id
    where g.active and g.environment=p_environment and g.source_family='ROSTER'
      and target.week_ending_date between m.valid_from and coalesce(m.valid_to,'infinity'::date)
      and coalesce(workflow.work_date,target.week_ending_date) between m.valid_from and coalesce(m.valid_to,'infinity'::date)
      and target.week_ending_date between a.effective_from_week_ending and coalesce(a.effective_to_week_ending,'infinity'::date)
      and coalesce(workflow.work_date,target.week_ending_date) between p.effective_from and coalesce(p.effective_to,'infinity'::date)
      and p.authority_mode='TIMESHEET_AUTHORITY' and p.document_mode='INVOICE_EVIDENCE_REQUIRED' and not p.self_bill_enabled;
  if groups=0 then return jsonb_build_object('applies',false); end if;
  if groups<>1 then raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_SIGNED_SCOPE_AMBIGUOUS' using errcode='55000'; end if;
  -- The complete current transition calls here before its workflow/TS/TF row
  -- locks. Post-freeze prepare reacquires these same locks reentrantly, then
  -- takes the existing lifecycle advisory/G1 locks. Preserve I1 -> F1 -> G1.
  perform private.weekly_source_pay_query_admit_v2();
  family_lock:=private.weekly_source_lock_family_rows_v1(array[target.timesheet_id],null);
  if family_lock->'ok' is distinct from 'true'::jsonb then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_FAMILY_UNAVAILABLE' using errcode='55000';
  end if;
  if not exists(select 1 from public.candidate_submission_workflows w where w.id=workflow.id
    and w.environment=workflow.environment and w.candidate_id=workflow.candidate_id
    and w.target_timesheet_id=target.timesheet_id and w.generation=workflow.generation
    and w.updated_at_utc is not distinct from workflow.updated_at_utc) then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_WORKFLOW_STALE' using errcode='40001';
  end if;
  return jsonb_build_object('applies',true,'timesheet_id',target.timesheet_id,'workflow_id',workflow.id,
    'workflow_generation',workflow.generation);
end;
$function$;

create or replace function private._weekly_source_settings_ensure_open_cycle_v1(
  p_source_group_id uuid,p_timesheet_id uuid,p_expected_witness_hash bytea,p_actor_user_id uuid default null
) returns uuid language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  group_row public.weekly_source_groups%rowtype; ts public.timesheets%rowtype;
  witnessed jsonb; route_read jsonb; family_lock jsonb; calendar jsonb; client_id uuid;
  own_week date; cycle_week date; cutoff_at timestamptz; cycle_id uuid; owners integer; expected_group jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_source_group_id is null or p_timesheet_id is null or octet_length(p_expected_witness_hash) is distinct from 32 then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_REQUEST_INVALID' using errcode='22023';
  end if;
  select t.* into ts from public.timesheets t where t.timesheet_id=p_timesheet_id;
  witnessed:=private.weekly_source_actual_timesheet_submission_v1(p_timesheet_id);
  if witnessed->'actual_submitted' is distinct from 'true'::jsonb then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_ACTUAL_SUBMISSION_REQUIRED' using errcode='55000';
  end if;
  if p_expected_witness_hash is distinct from private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_SUBMISSION_CYCLE_WITNESS_V1',witnessed) then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_WITNESS_STALE' using errcode='40001';
  end if;
  route_read:=private.weekly_source_signed_submission_read_context_v1(p_timesheet_id,p_source_group_id);
  if route_read->'eligible' is distinct from 'true'::jsonb then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_SIGNED_SCOPE_REQUIRED' using errcode='55000';
  end if;
  client_id:=(witnessed->>'client_id')::uuid; own_week:=(witnessed->>'week_ending_date')::date;
  if p_actor_user_id is not null then
    perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_SOURCE_PROGRESS',p_source_group_id,client_id,own_week);
  end if;
  select g.* into group_row from public.weekly_source_groups g where g.id=p_source_group_id and g.active and g.source_family='ROSTER';
  if group_row.id is null then raise exception 'WEEKLY_SOURCE_CYCLE_GROUP_NOT_ACTIVE' using errcode='22023'; end if;
  expected_group:=to_jsonb(group_row);
  -- Native Source ordering is I1/F1 before G1. Reuse the actual family owner,
  -- then the existing cycle-lifecycle lock identity and native group lock.
  perform private.weekly_source_pay_query_admit_v2();
  family_lock:=private.weekly_source_lock_family_rows_v1(array[p_timesheet_id],null);
  if family_lock->'ok' is distinct from 'true'::jsonb then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_FAMILY_UNAVAILABLE' using errcode='55000';
  end if;
  perform pg_advisory_xact_lock(hashtextextended('weekly-source-cycle-lifecycle:'||p_source_group_id::text,0));
  select g.* into group_row from public.weekly_source_groups g where g.id=p_source_group_id for update;
  if to_jsonb(group_row) is distinct from expected_group then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_GROUP_STALE' using errcode='40001';
  end if;
  -- Reprove actual membership, effective policy, submitted immutable claim and
  -- current physical member after the same native family/group locks.
  route_read:=private.weekly_source_signed_submission_read_context_v1(p_timesheet_id,p_source_group_id);
  if route_read->'eligible' is distinct from 'true'::jsonb
    or private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_SUBMISSION_CYCLE_WITNESS_V1',route_read->'submission_witness') is distinct from p_expected_witness_hash then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_WITNESS_STALE' using errcode='40001';
  end if;
  if p_actor_user_id is not null then
    perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_SOURCE_PROGRESS',p_source_group_id,client_id,own_week);
  end if;
  calendar:=private.weekly_source_checklist_client_calendar_v1(client_id,own_week+1);
  if calendar->>'latest_ended_week' is distinct from own_week::text then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_CLIENT_WEEK_UNPROVED' using errcode='55000';
  end if;
  cycle_week:=own_week+((7-extract(dow from own_week)::integer)%7);
  -- Same historical cutoff expression as the original lifecycle owner; this
  -- does not supply a fake p_now_utc or alter created_at_utc's genuine default.
  cutoff_at:=((cycle_week+group_row.cutoff_weekday)+group_row.cutoff_local_time) at time zone group_row.timezone;
  select case when count(*) filter(where c.scope_client_id=client_id)>0
      then count(*) filter(where c.scope_client_id=client_id) else count(*) end,
    (array_agg(c.id order by (c.scope_client_id is not null) desc,c.id))[1] into owners,cycle_id from public.weekly_source_cycles c
    where c.source_group_id=p_source_group_id and c.finalisation_week_ending=cycle_week
      and (c.scope_client_id is null or c.scope_client_id=client_id);
  if owners>1 then raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_OWNER_AMBIGUOUS' using errcode='55000'; end if;
  if owners=1 then return cycle_id; end if;
  -- Metadata only, at the original native unique constraint and lock identity.
  -- No completion, comparison, Timesheet, finance, email, pay or provider work.
  -- Missing historical signed-client bookkeeping is Client-scoped, an existing
  -- native scope. The original owner counts only group-scoped open cycles;
  -- backfill must not introduce MULTIPLE_OPEN_CYCLES into that current view.
  insert into public.weekly_source_cycles(source_group_id,scope_client_id,finalisation_week_ending,cutoff_at_utc,state,version,projection_state)
    values(p_source_group_id,client_id,cycle_week,cutoff_at,'OPEN',0,'NONE')
    on conflict on constraint weekly_source_cycles_group_week_client_uq do nothing returning id into cycle_id;
  if cycle_id is null then
    select c.id into strict cycle_id from public.weekly_source_cycles c where c.source_group_id=p_source_group_id
      and c.finalisation_week_ending=cycle_week and c.scope_client_id=client_id;
  end if;
  return cycle_id;
end;
$function$;

create or replace function private.weekly_source_checklist_submission_cycle_prepare_v1(
  p_timesheet_id uuid,p_actor_user_id uuid default null
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare witness jsonb; group_id uuid; groups integer; v_client_id uuid; own_week date; cycle_id uuid;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_timesheet_id is null then return jsonb_build_object('applies',false,'reason','NO_TIMESHEET'); end if;
  witness:=private.weekly_source_actual_timesheet_submission_v1(p_timesheet_id);
  if witness->'actual_submitted' is distinct from 'true'::jsonb then
    return jsonb_build_object('applies',false,'reason','NO_ACTUAL_SUBMISSION');
  end if;
  v_client_id:=(witness->>'client_id')::uuid; own_week:=(witness->>'week_ending_date')::date;
  select count(distinct g.id),(array_agg(distinct g.id order by g.id))[1] into groups,group_id
    from public.weekly_source_groups g
    join public.weekly_source_group_clients member on member.source_group_id=g.id and member.client_id=v_client_id
      and own_week between member.valid_from and coalesce(member.valid_to,'infinity'::date)
    cross join lateral(select private.weekly_source_signed_submission_read_context_v1(p_timesheet_id,g.id) context) read_context
    where g.active and g.source_family='ROSTER' and read_context.context->'eligible'='true'::jsonb;
  if groups=0 then return jsonb_build_object('applies',false,'reason','NO_SIGNED_GROUP'); end if;
  if groups<>1 then raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_SIGNED_SCOPE_AMBIGUOUS' using errcode='55000'; end if;
  cycle_id:=private._weekly_source_settings_ensure_open_cycle_v1(group_id,p_timesheet_id,
    private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_SUBMISSION_CYCLE_WITNESS_V1',witness),p_actor_user_id);
  return jsonb_build_object('applies',true,'source_group_id',group_id,'client_id',v_client_id,'week_ending',own_week,
    'source_cycle_id',cycle_id,'timesheet_id',p_timesheet_id,
    'submission_witness_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_SUBMISSION_CYCLE_WITNESS_V1',witness),'hex'));
end;
$function$;

create or replace function public.weekly_source_submitted_timesheet_prepare_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare actor public.tms_users%rowtype; timesheet_id uuid; result jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  perform private._weekly_source_settings_assert_request_v1(p_request,
    array['actor_user_id','timesheet_id'],'WEEKLY_SOURCE_SUBMISSION_CYCLE_REQUEST_INVALID');
  if jsonb_typeof(p_request->'actor_user_id') is distinct from 'string'
    or jsonb_typeof(p_request->'timesheet_id') is distinct from 'string' then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_REQUEST_INVALID' using errcode='22023';
  end if;
  timesheet_id:=(p_request->>'timesheet_id')::uuid;
  select u.* into actor from public.tms_users u where u.id=(p_request->>'actor_user_id')::uuid and u.is_active;
  if actor.id is null or actor.role::text is distinct from 'admin' then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_ACTOR_FORBIDDEN' using errcode='42501';
  end if;
  -- The existing dispatcher resolves fresh actual submission, Client/date,
  -- dated signed membership/policy, and the same native I1/F1/lifecycle/G1.
  -- Ordinary, planned/draft/expense-only/P0-only and non-signed rows are noops.
  result:=private.weekly_source_checklist_submission_cycle_prepare_v1(timesheet_id,actor.id);
  return jsonb_build_object('ok',true,'contract','WEEKLY_SOURCE_SUBMITTED_TIMESHEET_PREPARE_V1',
    'actor_user_id',actor.id,'timesheet_id',timesheet_id,'result',result);
end;
$function$;

create or replace function private.weekly_source_checklist_historical_submission_descriptor_v1(p_timesheet_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare witness jsonb; route_read jsonb; g public.weekly_source_groups%rowtype;
  v_client_id uuid; own_week date; work_date date; cycle_week date; group_id uuid; groups integer;
  calendar jsonb; dated_calendar jsonb; membership jsonb; policies jsonb; assignments jsonb;
  cycle_id uuid; owners integer; admission jsonb; witness_identity jsonb;
begin
  witness:=private.weekly_source_actual_timesheet_submission_v1(p_timesheet_id);
  if witness->'actual_submitted' is distinct from 'true'::jsonb then return null; end if;
  v_client_id:=(witness->>'client_id')::uuid; own_week:=(witness->>'week_ending_date')::date;
  work_date:=(witness->>'work_date')::date;
  select count(distinct source.id),(array_agg(distinct source.id order by source.id))[1] into groups,group_id
    from public.weekly_source_groups source
    cross join lateral(select private.weekly_source_signed_submission_read_context_v1(p_timesheet_id,source.id) context) signed_read
    where source.active and source.source_family='ROSTER' and signed_read.context->'eligible'='true'::jsonb;
  if groups=0 then return null; end if;
  if groups<>1 then raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_SIGNED_SCOPE_AMBIGUOUS' using errcode='55000'; end if;
  select source.* into g from public.weekly_source_groups source where source.id=group_id;
  calendar:=private.weekly_source_checklist_client_calendar_v1(v_client_id,(statement_timestamp() at time zone g.timezone)::date);
  if own_week>(calendar->>'latest_ended_week')::date then return null; end if;
  dated_calendar:=private.weekly_source_checklist_client_calendar_v1(v_client_id,own_week+1);
  if dated_calendar->>'latest_ended_week' is distinct from own_week::text then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_CLIENT_WEEK_UNPROVED' using errcode='55000';
  end if;
  route_read:=private.weekly_source_signed_submission_read_context_v1(p_timesheet_id,group_id);
  select coalesce(jsonb_agg(to_jsonb(m) order by to_jsonb(m)::text),'[]'::jsonb) into membership
    from public.weekly_source_group_clients m where m.source_group_id=group_id and m.client_id=v_client_id
      and own_week between m.valid_from and coalesce(m.valid_to,'infinity'::date)
      and work_date between m.valid_from and coalesce(m.valid_to,'infinity'::date);
  select coalesce(jsonb_agg(to_jsonb(p) order by to_jsonb(p)::text),'[]'::jsonb) into policies
    from public.weekly_source_client_policies p where p.source_group_id=group_id and p.client_id=v_client_id
      and work_date between p.effective_from and coalesce(p.effective_to,'infinity'::date)
      and p.authority_mode='TIMESHEET_AUTHORITY' and p.document_mode='INVOICE_EVIDENCE_REQUIRED' and not p.self_bill_enabled;
  select coalesce(jsonb_agg(to_jsonb(a) order by to_jsonb(a)::text),'[]'::jsonb) into assignments
    from public.weekly_source_group_rule_assignments a where a.source_group_id=group_id and a.feature_enabled
      and a.feature_purpose='SIGNED_CHECK_ONLY' and a.rule_set_version_id is null
      and own_week between a.effective_from_week_ending and coalesce(a.effective_to_week_ending,'infinity'::date);
  if route_read->'eligible' is distinct from 'true'::jsonb or jsonb_array_length(membership)=0
    or jsonb_array_length(policies)=0 or jsonb_array_length(assignments)=0 then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_WITNESS_STALE' using errcode='40001';
  end if;
  -- Seal real dated admission independently of mutable cycle bookkeeping so
  -- separate Timesheets in the same week may safely reuse the first receipt.
  admission:=jsonb_build_object('submission_read',route_read,'source_group',to_jsonb(g),
    'membership',membership,'policies',policies,'assignments',assignments,
    'client_calendar',calendar,'dated_client_calendar',dated_calendar);
  cycle_week:=own_week+((7-extract(dow from own_week)::integer)%7);
  select case when count(*) filter(where c.scope_client_id=v_client_id)>0
      then count(*) filter(where c.scope_client_id=v_client_id) else count(*) end,
    (array_agg(c.id order by (c.scope_client_id is not null) desc,c.id))[1] into owners,cycle_id
    from public.weekly_source_cycles c where c.source_group_id=group_id and c.finalisation_week_ending=cycle_week
      and (c.scope_client_id is null or c.scope_client_id=v_client_id);
  if owners>1 then raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_OWNER_AMBIGUOUS' using errcode='55000'; end if;
  witness_identity:=jsonb_build_object('authority',witness->>'authority',
    'workflow_id',witness->'workflow_id','workflow_generation',witness->'workflow_generation',
    'hours_component_id',witness->'hours_component_id','candidate_signature_component_id',witness->'candidate_signature_component_id',
    'document_version_id',witness->'document_version_id');
  return jsonb_build_object('timesheet_id',p_timesheet_id,'timesheet_version',witness->'timesheet_version',
    'source_group_id',group_id,'client_id',v_client_id,'week_ending',own_week,'native_cycle_week_ending',cycle_week,
    'source_cycle_id',cycle_id,'witness_identity',witness_identity,
    'submission_witness_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_SUBMISSION_CYCLE_WITNESS_V1',witness),'hex'),
    'admission_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_HISTORICAL_SUBMISSION_ADMISSION_V1',admission),'hex'));
end;
$function$;

create or replace function public.weekly_source_checklist_submission_manifest_v1(p_request jsonb)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare actor public.tms_users%rowtype; all_rows jsonb; missing jsonb; selected jsonb; entry jsonb;
  binding text; revision text; token jsonb; after_id uuid; last_id text; more boolean; page_limit integer:=100;
begin
  perform private.weekly_source_query_require_service_v1();
  perform private._weekly_source_settings_assert_request_v1(p_request,array['actor_user_id','cursor','limit'],'WEEKLY_SOURCE_SUBMISSION_MANIFEST_REQUEST_INVALID');
  if jsonb_typeof(p_request->'actor_user_id') is distinct from 'string'
    or (p_request?'cursor' and jsonb_typeof(p_request->'cursor') is distinct from 'string')
    or (p_request?'limit' and (jsonb_typeof(p_request->'limit') is distinct from 'number'
      or not pg_input_is_valid(p_request->>'limit','integer'))) then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_MANIFEST_REQUEST_INVALID' using errcode='22023';
  end if;
  page_limit:=coalesce((p_request->>'limit')::integer,100);
  if page_limit not between 1 and 100 then raise exception 'WEEKLY_SOURCE_SUBMISSION_MANIFEST_REQUEST_INVALID' using errcode='22023'; end if;
  if p_request?'cursor' and length(p_request->>'cursor') not between 1 and 4096 then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_MANIFEST_REQUEST_INVALID' using errcode='22023';
  end if;
  select u.* into actor from public.tms_users u where u.id=(p_request->>'actor_user_id')::uuid and u.is_active;
  if actor.id is null or actor.role::text is distinct from 'admin' then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_ACTOR_FORBIDDEN' using errcode='42501';
  end if;
  with candidates as materialized (
    select private.weekly_source_checklist_historical_submission_descriptor_v1(t.timesheet_id) descriptor
      from public.timesheets t where t.is_current and t.archived_at_utc is null and t.revoked_at is null
        and t.line_type::text='HOURS' and t.sheet_scope::text in('DAILY','WEEKLY')
  ) select coalesce(jsonb_agg(descriptor order by descriptor->>'timesheet_id') filter(where descriptor is not null),'[]'::jsonb)
    into all_rows from candidates;
  for entry in select r from jsonb_array_elements(all_rows) r loop
    perform private.weekly_source_office_authority_v1(actor.id,'VIEW_SOURCE_PROGRESS',
      (entry->>'source_group_id')::uuid,(entry->>'client_id')::uuid,(entry->>'week_ending')::date);
  end loop;
  binding:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_SUBMISSION_MANIFEST_BINDING_V1',
    jsonb_build_object('actor',to_jsonb(actor),'order','ACTUAL_TIMESHEET_UUID_ASC')),'hex');
  revision:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_SUBMISSION_MANIFEST_REVISION_V1',all_rows),'hex');
  select coalesce(jsonb_agg(r order by r->>'timesheet_id'),'[]'::jsonb) into missing
    from jsonb_array_elements(all_rows) r where r->'source_cycle_id'='null'::jsonb;
  if p_request?'cursor' then
    begin
      token:=convert_from(decode(p_request->>'cursor','base64'),'UTF8')::jsonb;
      perform private._weekly_source_settings_assert_request_v1(token,array['contract','binding','read_revision','after'],'CURSOR');
      if token->>'contract' is distinct from 'WEEKLY_SOURCE_SUBMISSION_MANIFEST_CURSOR_V1'
        or token->>'binding' is distinct from binding or token->>'read_revision' is distinct from revision
        or jsonb_typeof(token->'after') is distinct from 'string'
        or not exists(select 1 from jsonb_array_elements(missing) r where r->>'timesheet_id'=token->>'after') then raise exception 'cursor'; end if;
      after_id:=(token->>'after')::uuid;
    exception when others then raise exception 'WEEKLY_SOURCE_SUBMISSION_MANIFEST_REFRESH_REQUIRED' using errcode='40001'; end;
  end if;
  select coalesce(jsonb_agg(r order by r->>'timesheet_id'),'[]'::jsonb),count(*)>page_limit into selected,more
    from(select r from jsonb_array_elements(missing) r where after_id is null or (r->>'timesheet_id')::uuid>after_id
      order by (r->>'timesheet_id')::uuid limit page_limit+1) page;
  if more then selected:=selected-page_limit; end if;
  last_id:=selected->(jsonb_array_length(selected)-1)->>'timesheet_id';
  return jsonb_build_object('ok',true,'contract','WEEKLY_SOURCE_SUBMISSION_MANIFEST_V1','actor_user_id',actor.id,'permission_view','ADMIN',
    'binding',binding,'read_revision',revision,'eligible_count',jsonb_array_length(all_rows),'missing_count',jsonb_array_length(missing),
    'rows',selected,'has_more',more,'next_cursor',case when more then replace(encode(convert_to(jsonb_build_object(
      'contract','WEEKLY_SOURCE_SUBMISSION_MANIFEST_CURSOR_V1','binding',binding,'read_revision',revision,'after',last_id)::text,'UTF8'),'base64'),chr(10),'') end);
end;
$function$;

create or replace function public.weekly_source_checklist_historical_prepare_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare actor public.tms_users%rowtype; expected_actor jsonb; descriptor jsonb; after_descriptor jsonb; result jsonb;
  timesheet_id uuid; expected_witness text; expected_admission text;
begin
  perform private.weekly_source_query_require_service_v1();
  perform private._weekly_source_settings_assert_request_v1(p_request,
    array['actor_user_id','timesheet_id','submission_witness_sha256','admission_sha256'],'WEEKLY_SOURCE_SUBMISSION_MANIFEST_REQUEST_INVALID');
  if jsonb_typeof(p_request->'actor_user_id') is distinct from 'string'
    or jsonb_typeof(p_request->'timesheet_id') is distinct from 'string'
    or jsonb_typeof(p_request->'submission_witness_sha256') is distinct from 'string'
    or jsonb_typeof(p_request->'admission_sha256') is distinct from 'string'
    or p_request->>'submission_witness_sha256'!~'^[0-9a-f]{64}$' or p_request->>'admission_sha256'!~'^[0-9a-f]{64}$' then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_MANIFEST_REQUEST_INVALID' using errcode='22023';
  end if;
  timesheet_id:=(p_request->>'timesheet_id')::uuid;
  expected_witness:=p_request->>'submission_witness_sha256'; expected_admission:=p_request->>'admission_sha256';
  select u.* into actor from public.tms_users u where u.id=(p_request->>'actor_user_id')::uuid and u.is_active;
  if actor.id is null or actor.role::text is distinct from 'admin' then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_ACTOR_FORBIDDEN' using errcode='42501';
  end if;
  expected_actor:=to_jsonb(actor);
  descriptor:=private.weekly_source_checklist_historical_submission_descriptor_v1(timesheet_id);
  if descriptor is null or descriptor->>'submission_witness_sha256' is distinct from expected_witness
    or descriptor->>'admission_sha256' is distinct from expected_admission then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_WITNESS_STALE' using errcode='40001';
  end if;
  -- Reuse the complete established lifecycle owner: genuine witness/dated
  -- membership/client calendar, I1 -> F1 -> lifecycle advisory/G1, native
  -- Sunday/cutoff/default created_at and unique/CAS. No business save here.
  result:=private.weekly_source_checklist_submission_cycle_prepare_v1(timesheet_id,actor.id);
  after_descriptor:=private.weekly_source_checklist_historical_submission_descriptor_v1(timesheet_id);
  if result->'applies' is distinct from 'true'::jsonb or after_descriptor is null
    or after_descriptor->>'submission_witness_sha256' is distinct from expected_witness
    or after_descriptor->>'admission_sha256' is distinct from expected_admission
    or after_descriptor->'source_cycle_id' is distinct from result->'source_cycle_id' then
    -- Exception rolls this metadata-only transaction back; earlier distinct
    -- Timesheet transactions remain accurately recorded by the setup caller.
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_WITNESS_STALE' using errcode='40001';
  end if;
  select u.* into actor from public.tms_users u where u.id=actor.id and u.is_active;
  if to_jsonb(actor) is distinct from expected_actor then
    raise exception 'WEEKLY_SOURCE_SUBMISSION_CYCLE_ACTOR_FORBIDDEN' using errcode='42501';
  end if;
  return jsonb_build_object('ok',true,'contract','WEEKLY_SOURCE_HISTORICAL_SUBMISSION_PREPARE_V1',
    'actor_user_id',actor.id,'timesheet_id',timesheet_id,'metadata_only',true,'descriptor',after_descriptor);
end;
$function$;

create or replace function public.weekly_source_checklist_v1(p_request jsonb)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  actor public.tms_users%rowtype; command text; view text; sort text; direction text; request jsonb;
  scope record; own_week date; local_today date; calendar jsonb; leaf jsonb; process jsonb; rule jsonb;
  route text; row_scope jsonb; raw_page jsonb; raw_cursor text; raw_rows jsonb; raw jsonb; witness jsonb;
  rows jsonb:='[]'::jsonb; items jsonb:='[]'::jsonb; row_items jsonb; fingerprints jsonb:='[]'::jsonb;
  row_id text; checked boolean; completed boolean; pay_complete boolean; checked_at timestamptz;
  checked_text text; complete_text text; latest_week date; earlier integer; actual_count integer;
  open_count integer; pay_count integer; checked_count integer; source_count integer; query_count integer;
  checking_upload uuid; completion public.weekly_source_client_cycle_completions%rowtype;
  action jsonb; reason text; item jsonb; correction jsonb; pending jsonb; signed jsonb; authority jsonb;
  subject text; pay_subject boolean; rank integer; status jsonb; sort_name text; native_issue jsonb;
  source_native record; source_witness jsonb; seen_items text[];
  native_workspace jsonb; tracker_action jsonb; finalise_link jsonb;
  agency_native record; agency_facts jsonb; comparison_accepted boolean; query_unsent boolean;
  report_bindings jsonb; needs_export boolean;
  hold_facts jsonb; source_money jsonb; item_hold jsonb; financial_facts jsonb; native_root uuid; native_roots integer;
  d10_groups jsonb; query_parent jsonb; query_targets jsonb; invoice_blocks jsonb;
  unknown_hold constant jsonb:='{"holds_pay":null,"holds_pay_scope":null,"withheld_amount_pence":null,"holds_invoice":null,"pending_decision":null,"authority":{"owner":"UNAVAILABLE","hash":null,"withholding_known":false}}';
  binding text; revision text; records jsonb; result jsonb; primary_key text; sort_key jsonb;
  empty_cell jsonb; admin_actions jsonb; no_work boolean; no_work_line text; limit_rows integer;
begin
  perform private.weekly_source_query_require_service_v1();
  perform private._weekly_source_settings_assert_request_v1(p_request,
    array['actor_user_id','command','source_group_id','client_id','source_cycle_id','week_ending','cursor','anchor','sort','direction','limit'],
    'WEEKLY_SOURCE_CHECKLIST_REQUEST_INVALID');
  command:=coalesce(p_request->>'command','CHECKLIST');
  sort:=coalesce(p_request->>'sort',case when command='CHECKLIST' then 'week_ending' else 'worker' end);
  direction:=coalesce(p_request->>'direction',case when command='CHECKLIST' then 'DESC' else 'ASC' end);
  if command not in('CHECKLIST','CHECKLIST_ISSUES') or direction not in('ASC','DESC')
    or (command='CHECKLIST' and sort not in('week_ending','client','group','checked','completed'))
    or (command='CHECKLIST_ISSUES' and (sort<>'worker' or direction<>'ASC'))
    or coalesce(p_request->>'limit','50') !~ '^[1-9][0-9]{0,2}$'
    or (p_request ? 'cursor' and p_request ? 'anchor') then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_REQUEST_INVALID' using errcode='22023';
  end if;
  limit_rows:=coalesce((p_request->>'limit')::integer,50);
  if limit_rows not between 1 and 100 then raise exception 'WEEKLY_SOURCE_CHECKLIST_REQUEST_INVALID' using errcode='22023'; end if;
  for reason in select key from jsonb_object_keys(p_request) key where key in('actor_user_id','source_group_id','client_id','source_cycle_id') loop
    if jsonb_typeof(p_request->reason) is distinct from 'string' or not pg_input_is_valid(p_request->>reason,'uuid') then
      raise exception 'WEEKLY_SOURCE_CHECKLIST_REQUEST_INVALID' using errcode='22023';
    end if;
  end loop;
  if (p_request ? 'week_ending' and (coalesce(p_request->>'week_ending','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
      or not pg_input_is_valid(p_request->>'week_ending','date')))
    or (command='CHECKLIST_ISSUES' and not(p_request ?& array['source_group_id','client_id','source_cycle_id','week_ending'])) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_REQUEST_INVALID' using errcode='22023';
  end if;
  for reason in select key from jsonb_object_keys(p_request) key where key in('cursor','anchor') loop
    if jsonb_typeof(p_request->reason) is distinct from 'string' or length(p_request->>reason) not between 1 and 4096
      or p_request->>reason ~ '[[:cntrl:]]' then raise exception 'WEEKLY_SOURCE_CHECKLIST_REQUEST_INVALID' using errcode='22023'; end if;
  end loop;
  select a.* into actor from public.tms_users a where a.id=(p_request->>'actor_user_id')::uuid;
  if actor.id is null or actor.is_active is distinct from true then
    raise exception 'WEEKLY_SOURCE_OFFICE_ACTOR_INACTIVE' using errcode='42501';
  end if;
  view:=case when lower(btrim(coalesce(actor.role,'')))='admin' then 'ADMIN' else 'PAY_READONLY' end;
  if view='PAY_READONLY' and private.weekly_source_pay_actor_allowed_v1(actor.id) is distinct from true then
    raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501';
  end if;
  request:=p_request||jsonb_build_object('command',command,'sort',sort,'direction',direction,'limit',limit_rows);
  binding:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECKLIST_BINDING_V1',jsonb_build_object(
    'actor_user_id',actor.id,'permission_view',view,'role',actor.role,'payment_authoriser',actor.payment_authoriser,
    'payment_golden_key',actor.payment_golden_key,'scope',request-'cursor'-'anchor'-'limit')),'hex');
  -- An actual signed submission must not disappear because a real bookkeeping
  -- cycle is absent. Reads cannot create one; report that dependency explicitly.
  if exists(select 1 from public.timesheets t
    cross join lateral(select private.weekly_source_actual_timesheet_submission_v1(t.timesheet_id) witness) submitted
    join public.weekly_source_group_clients m on m.client_id=(submitted.witness->>'client_id')::uuid
      and t.week_ending_date between m.valid_from and coalesce(m.valid_to,'infinity'::date)
    join public.weekly_source_groups g on g.id=m.source_group_id and g.active
    cross join lateral(select private.weekly_source_signed_submission_read_context_v1(t.timesheet_id,g.id) context) signed_read
    where (submitted.witness->>'actual_submitted')::boolean is true and (signed_read.context->>'eligible')::boolean is true
      and t.week_ending_date<(statement_timestamp() at time zone g.timezone)::date
      and not exists(select 1 from public.weekly_source_cycles c where c.source_group_id=g.id
        and t.week_ending_date between c.finalisation_week_ending-6 and c.finalisation_week_ending
        and (c.scope_client_id is null or c.scope_client_id=m.client_id))) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_SCOPE_UNAVAILABLE' using errcode='55000';
  end if;
  -- Discover every actual own week and every existing native cycle. There is
  -- no fixed historical window. Prefer the native Client-specific cycle, as
  -- the native scope owner does, but refuse ambiguous equal-priority authority.
  for scope in
    with source_members as materialized (
      select g.id group_id,g.display_name,g.source_family,g.timezone,m.client_id,cl.name client_name,m.valid_from,m.valid_to
      from public.weekly_source_groups g join public.weekly_source_group_clients m on m.source_group_id=g.id
      join public.clients cl on cl.id=m.client_id where g.active
    ), actual as materialized (
      select t.timesheet_id,t.week_ending_date,(s.witness->>'client_id')::uuid client_id
      from public.timesheets t cross join lateral(select private.weekly_source_actual_timesheet_submission_v1(t.timesheet_id) witness) s
      where (s.witness->>'actual_submitted')::boolean is true
    ), candidates as (
      select m.*,c.id cycle_id,c.scope_client_id,c.finalisation_week_ending,c.version cycle_version,
        c.state cycle_state,calendar.value calendar,own.value week_ending
      from source_members m join public.weekly_source_cycles c on c.source_group_id=m.group_id
        and (c.scope_client_id is null or c.scope_client_id=m.client_id)
      cross join lateral(select private.weekly_source_checklist_client_calendar_v1(m.client_id,
        (statement_timestamp() at time zone m.timezone)::date) value) calendar
      cross join lateral(
        select distinct actual.week_ending_date value from actual where actual.client_id=m.client_id
          and actual.week_ending_date between c.finalisation_week_ending-6 and c.finalisation_week_ending
        union select c.finalisation_week_ending-((extract(dow from c.finalisation_week_ending)::integer-
          (calendar.value->>'week_ending_weekday')::integer+7)%7)
      ) own
      where own.value between m.valid_from and coalesce(m.valid_to,'infinity'::date)
        and own.value<(statement_timestamp() at time zone m.timezone)::date
        and exists(select 1 from public.weekly_source_client_policies policy where policy.source_group_id=m.group_id
          and policy.client_id=m.client_id and own.value between policy.effective_from and coalesce(policy.effective_to,'infinity'::date)
          and (policy.authority_mode='SOURCE_AUTHORITY' or (policy.authority_mode='TIMESHEET_AUTHORITY'
            and policy.document_mode='INVOICE_EVIDENCE_REQUIRED' and not policy.self_bill_enabled)))
    ), priority as (
      select candidates.*,max(case when scope_client_id is not null then 1 else 0 end)
        over(partition by group_id,client_id,week_ending) best from candidates
    ), chosen as (
      select *,count(*) over(partition by group_id,client_id,week_ending) owner_count
      from priority where (case when scope_client_id is not null then 1 else 0 end)=best
    ) select * from chosen order by group_id,client_id,week_ending,cycle_id
  loop
    if scope.owner_count<>1 then raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_SCOPE_AMBIGUOUS' using errcode='55000'; end if;
    own_week:=scope.week_ending; calendar:=scope.calendar; latest_week:=(calendar->>'latest_ended_week')::date;
    local_today:=(statement_timestamp() at time zone scope.timezone)::date;
    row_scope:=jsonb_build_object('source_group_id',scope.group_id,'client_id',scope.client_id,'source_cycle_id',scope.cycle_id,'week_ending',own_week);
    row_id:=scope.group_id::text||':'||scope.client_id::text||':'||own_week::text;
    perform private.weekly_source_office_authority_v1(actor.id,case when view='ADMIN' then 'VIEW_SOURCE_PROGRESS' else 'VIEW_PAY_WORK' end,
      scope.group_id,scope.client_id,own_week);
    leaf:=private.weekly_source_healthroster_checklist_leaf_v1(row_scope||jsonb_build_object('actor_user_id',actor.id));
    if leaf->'applies'='true'::jsonb and leaf->'admitted' is distinct from 'true'::jsonb then continue; end if;
    route:=case when leaf->'applies'='true'::jsonb then leaf->>'route' else 'NATIVE' end;
    if route='NATIVE' and scope.source_family<>'NHSP'
      and private.weekly_source_is_import_authoritative_v1(scope.client_id,null,own_week) is distinct from true then continue; end if;
    actual_count:=coalesce((leaf->>'actual_timesheet_count')::integer,0); earlier:=coalesce((leaf->>'earlier_open_weeks')::integer,0);
    checked_count:=0; open_count:=0; pay_count:=0; row_items:='[]'::jsonb; raw_rows:='[]'::jsonb; financial_facts:='[]'::jsonb;
    checked_at:=null; checking_upload:=null; admin_actions:='[]'::jsonb; finalise_link:=null; query_targets:='[]'::jsonb;
    if route in('SIGNED_TIMESHEETS','AGENCY_INVOICE') then
      d10_groups:=private.weekly_source_check_only_query_groups_v1(scope.cycle_id,scope.client_id,
        jsonb_build_object('actor_user_id',actor.id,'source_group_id',scope.group_id,'week_ending',own_week));
      query_targets:=d10_groups->'item_targets';
      if route='SIGNED_TIMESHEETS' and d10_groups->>'source_read_revision' is distinct from leaf->>'native_query_read_revision' then
        raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001';
      end if;
      fingerprints:=fingerprints||jsonb_build_array(jsonb_build_object('row_id',row_id,'native_d10_groups',d10_groups));
    end if;
    if route='SIGNED_TIMESHEETS' then
      raw_cursor:=null;
      loop
        raw_page:=private.weekly_source_check_only_query_rows_v1(scope.cycle_id,scope.client_id,
          jsonb_strip_nulls(jsonb_build_object('actor_user_id',actor.id,'source_group_id',scope.group_id,'week_ending',own_week,'limit',100,'cursor',raw_cursor)));
        if raw_page->'ok' is distinct from 'true'::jsonb then raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_READ_UNAVAILABLE' using errcode='55000'; end if;
        if raw_page->>'read_revision' is distinct from d10_groups->>'source_read_revision' then
          raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001';
        end if;
        raw_rows:=raw_rows||(raw_page->'rows');
        exit when raw_page->'has_more'='false'::jsonb;
        if raw_cursor is not distinct from raw_page->>'next_cursor' then raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_READ_UNAVAILABLE' using errcode='55000'; end if;
        raw_cursor:=raw_page->>'next_cursor';
      end loop;
      for raw in select value from jsonb_array_elements(raw_rows) loop
        action:=null; correction:=null; pending:=null; pay_subject:=false; signed:=null; item_hold:=unknown_hold; query_parent:=null;
        select value into query_parent from jsonb_array_elements(query_targets) where value->>'item_id'=raw->>'item_id';
        if raw->>'item_kind'='SOURCE_INFORMATION' then
          hold_facts:=private.weekly_source_checklist_information_hold_facts_v1(raw,row_scope,actor.id);
          item_hold:=hold_facts->'hold'; financial_facts:=financial_facts||jsonb_build_array(hold_facts->'native_facts');
          reason:=raw->>'native_reason_code'; subject:='INFORMATION'; rank:=90;
          status:=jsonb_build_object('text','No hold','tone','warning','subtext',coalesce(raw#>>'{summary,reason}',reason),'subtone','muted');
          item:=jsonb_build_object('source_information_witness',jsonb_build_object('native_action_id',raw->'action_id',
            'evidence_fingerprint',raw->'evidence_fingerprint','import_id',raw->'query_import_id','hr_row_id',raw->'hr_row_id',
            'existing_row_id',coalesce(query_parent->'parent_group_key',raw->'item_id'),'counts_for_row_admission',false),'counted_timesheet_id',null);
          if reason in('WEEKLY_TIMESHEET_NOT_SUBMITTED','DAILY_TIMESHEET_NOT_SUBMITTED') and query_parent is not null then
            action:=jsonb_build_object('kind','QUERIES','label','View missing Timesheet in Queries ›','native_allowed',true,
              'target',row_scope-'week_ending'||jsonb_build_object('row_key',query_parent->>'parent_group_key'));
          end if;
        else
          witness:=raw->'submission_witness';
          if jsonb_typeof(raw->'open_read_item') is distinct from 'boolean' then
            raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_READ_UNAVAILABLE' using errcode='55000';
          end if;
          hold_facts:=private.weekly_source_checklist_timesheet_hold_facts_v1((raw->>'timesheet_id')::uuid,row_scope,actor.id);
          item_hold:=hold_facts->'hold'; financial_facts:=financial_facts||jsonb_build_array(hold_facts->'native_facts');
          if raw#>>'{validation,last_source}' is not null and exists(select 1 from public.hr_imports hi
            join public.import_review_states st on st.import_id=hi.id and st.applied_at_utc is not null
            where hi.id=(raw#>>'{validation,last_source}')::uuid and hi.pruned_at is null
              and hi.source_system::text in('HEALTHROSTER','HEALTHROSTER_DAILY')) then
            checked_count:=checked_count+1;
          end if;
          if raw->'open_read_item'='false'::jsonb then continue; end if;
          if raw->'correction_owns_read_item'='true'::jsonb then
            select jsonb_build_object('request_id',r.id,'state',r.state,'state_revision',r.state_revision,
              'original_timesheet_id',r.reversed_timesheet_id,'replacement_timesheet_id',r.replacement_timesheet_id,
              'reversal_timesheet_id',r.reversal_timesheet_id) into correction from private.timesheet_correction_requests r
              where r.id=(raw#>>'{correction,request_id}')::uuid and r.state='WAITING' and r.reversed_timesheet_id=(raw->>'timesheet_id')::uuid;
            if correction is null then raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001'; end if;
            begin signed:=private.timesheet_correction_signed_witness_v1((correction->>'replacement_timesheet_id')::uuid,false);
            exception when sqlstate '55000' then signed:=null; end;
            reason:=case when signed is not null then 'SIGNED_CORRECTION_RECEIVED' else 'CORRECTION_WAITING' end;
            pay_subject:=signed is not null; subject:=case when pay_subject then 'PAY_AND_INVOICE' else 'INVOICE_ONLY' end; rank:=10;
            status:=jsonb_build_object('text','Decision needed','tone','warning','subtext',case when signed is not null
              then 'Signed correction received' when raw#>>'{correction,worker_submitted_at_utc}' is not null
              then 'Correction with the manager' else 'Correction sent to the worker' end,'subtone','muted');
            action:=jsonb_build_object('kind','TIMESHEET','label','View correction in Timesheet ›','native_allowed',true,
              'target',jsonb_build_object('timesheet_id',correction->'replacement_timesheet_id'));
          elsif raw#>>'{submission_read_context,route_state}'='SUBMITTED_PENDING_NATIVE_MATERIALISATION' then
            reason:='NATIVE_DAILY_MATERIALISATION_PENDING'; subject:='PAY_AND_INVOICE'; pay_subject:=true; rank:=15;
            status:=jsonb_build_object('text','Decision needed','tone','warning','subtext','Submitted Timesheet · native materialisation pending','subtone','muted');
            pending:=jsonb_build_object('state','SUBMITTED_PENDING_NATIVE_MATERIALISATION','timesheet_id',raw->'timesheet_id',
              'client_id',witness->'client_id','candidate_id',witness->'candidate_id','work_date',raw->'work_date',
              'workflow_id',witness->'workflow_id','workflow_generation',witness->'workflow_generation',
              'submission_sha256',witness->'submission_sha256','actions_held',true);
          elsif raw->'ordinary_authorised' is distinct from 'true'::jsonb then
            reason:=case when witness->>'authority'='CANDIDATE_IMMUTABLE_HOURS' and witness->>'manager_approved_at_utc' is null
              then 'WAITING_FOR_MANAGER_SIGNATURE' else 'SIGNED_NOT_AUTHORISED' end;
            subject:='PAY_AND_INVOICE'; pay_subject:=true; rank:=20;
            status:=jsonb_build_object('text','Decision needed','tone','warning','subtext',case when reason='WAITING_FOR_MANAGER_SIGNATURE'
              then 'Waiting for the manager to sign' else 'Timesheet not authorised' end,'subtone','muted');
            action:=jsonb_build_object('kind','TIMESHEET','label','Open Timesheet ›','native_allowed',true,'target',jsonb_build_object('timesheet_id',raw->'timesheet_id'));
          elsif raw->'unfinished_daily_review'='true'::jsonb then
            reason:='DAILY_REVIEW_UNFINISHED'; subject:='INFORMATION'; rank:=30;
            status:=jsonb_build_object('text','No hold','tone','warning','subtext','Daily check not finished','subtone','muted');
            action:=jsonb_build_object('kind','DAILY_REVIEW','label','Continue daily check ›','native_allowed',true,'target',jsonb_build_object('import_id',raw->'query_import_id'));
          elsif jsonb_array_length(raw->'native_issues')>0 or raw#>>'{validation,status}' is distinct from 'VALIDATION_OK'
            or raw->>'processing_status'='READY_FOR_HR' then
            select value into native_issue from jsonb_array_elements(raw->'native_issues') order by value->>'action_id' limit 1;
            reason:=coalesce(native_issue->>'reason_code',raw#>>'{validation,reason_code}','NOT_YET_CHECKED'); subject:='INVOICE_ONLY'; rank:=40;
            status:=jsonb_build_object('text','Decision needed','tone','warning','subtext',case when native_issue is not null then
              case when native_issue->'sent_verified'='true'::jsonb then 'Query sent to Temp Staffing '||coalesce(native_issue->>'last_sent_at','')
              else 'Query not sent yet' end else 'Not yet checked against HealthRoster' end,'subtone','muted');
            action:=case when native_issue is not null and query_parent is not null then jsonb_build_object('kind','QUERIES','label','View query in Queries ›','native_allowed',true,
              'target',row_scope-'week_ending'||jsonb_build_object('row_key',query_parent->>'parent_group_key')) when native_issue is null then
              jsonb_build_object('kind','UPLOAD','label','Upload source file ›','native_allowed',true,'target',row_scope-'week_ending') end;
          else continue;
          end if;
          open_count:=open_count+1;
          if pay_subject then pay_count:=pay_count+1; end if;
          item:=jsonb_build_object('counted_timesheet_id',raw->'timesheet_id','source_information_witness',null);
        end if;
        if view='PAY_READONLY' and not pay_subject then continue; end if;
        item:=item||jsonb_build_object('item_id',raw->'item_id','item_kind',raw->'item_kind','scope',row_scope,'route',route,
          'worker',raw->'worker','work_date',raw->'work_date','sheet_scope',raw->'sheet_scope','reason_code',reason,
          'status',status,'hold',item_hold,'subject',subject,'permitted_pay_subject',pay_subject,
          'action',case when view='ADMIN' then action end,'queries_parent_witness',case when view='ADMIN' and action->>'kind'='QUERIES' then query_parent end,
          'correction_binding',correction,'submission_read',pending,
          '_rank',rank);
        row_items:=row_items||jsonb_build_array(item);
      end loop;
      checked:=checked_count=actual_count; completed:=open_count=0; pay_complete:=pay_count=0;
      checked_text:=case when checked then 'Checked' else (actual_count-checked_count)::text||' Timesheets not yet checked' end;
      complete_text:=case when completed and own_week=latest_week then case when earlier=0 then 'Nothing outstanding · earlier weeks all done'
        else 'Nothing outstanding this week · '||earlier::text||' earlier weeks open' end
        when completed then 'Nothing outstanding' else open_count::text||' items' end;
      fingerprints:=fingerprints||jsonb_build_array(jsonb_build_object('row_id',row_id,'context',leaf,'native_query_rows',raw_rows));
    else
      process:=private.weekly_source_checklist_process_v1(scope.cycle_id,scope.client_id);
      select u.id,u.uploaded_at_utc into checking_upload,checked_at from public.weekly_source_uploads u
        join public.weekly_source_format_profiles profile on profile.id=u.source_format_profile_id
        join public.weekly_source_projection_publications publication on publication.upload_id=u.id and publication.state in('CURRENT','SUPERSEDED')
        where u.source_cycle_id=scope.cycle_id and u.report_scope_id is null and u.state in('CURRENT','SUPERSEDED')
          and exists(select 1 from public.weekly_source_upload_attempts a where a.logical_upload_id=u.id and a.result='ACCEPTED')
          and u.confirmed_coverage_start_local_date<=own_week-6 and u.confirmed_coverage_end_local_date>=own_week
          and (upper(coalesce(u.file_metadata_json->>'import_use','CHECKING'))='CHECKING' or profile.profile_code='NHSP_PREFINAL_RELEASED_V1')
          and exists(select 1 from public.weekly_source_upload_rows ur join public.weekly_source_row_resolutions rr on rr.upload_row_id=ur.id
            where ur.upload_id=u.id and rr.client_id=scope.client_id and rr.mapping_state='RESOLVED'
              and rr.generation=coalesce(publication.projection_generation,publication.authority_scope_version))
        order by u.uploaded_at_utc desc,u.id desc limit 1;
      select c.* into completion from public.weekly_source_client_cycle_completions c where c.source_cycle_id=scope.cycle_id
        and c.client_id=scope.client_id and c.state='CURRENT' and c.completion_kind='NO_SHIFTS_TO_IMPORT';
      select count(*)::integer into source_count from public.weekly_source_upload_rows ur
        join public.weekly_source_uploads u on u.id=ur.upload_id and u.source_cycle_id=scope.cycle_id and u.state='CURRENT'
        join public.weekly_source_row_resolutions rr on rr.upload_row_id=ur.id and rr.client_id=scope.client_id and rr.mapping_state='RESOLVED';
      no_work:=completion.id is not null and actual_count=0 and source_count=0
        and not exists(select 1 from public.contract_weeks cw join public.contracts con on con.id=cw.contract_id
          where con.client_id=scope.client_id and cw.week_ending_date=own_week and cw.status::text='SUBMITTED');
      checked:=checking_upload is not null or no_work;
      pay_complete:=exists(select 1 from jsonb_array_elements(process->'scopes') f where f->>'authority_scope_kind' in('CYCLE','NHSP_REPORT_SCOPE')
        and f->'process_complete'='true'::jsonb);
      rule:=leaf->'effective_rule';
      completed:=case when no_work then true when scope.source_family='NHSP' then
        exists(select 1 from public.weekly_source_report_scopes rs where rs.source_cycle_id=scope.cycle_id and rs.client_id=scope.client_id)
        and not exists(select 1 from public.weekly_source_report_scopes rs where rs.source_cycle_id=scope.cycle_id and rs.client_id=scope.client_id
          and not exists(select 1 from jsonb_array_elements(process->'scopes') f where f->>'report_scope_id'=rs.id::text and f->'process_complete'='true'::jsonb))
        when rule#>>'{values,invoice_membership}'='FOLLOW_FINAL_REPORT_LINES' then pay_complete
          and exists(select 1 from public.weekly_source_report_scopes rs where rs.source_cycle_id=scope.cycle_id and rs.client_id=scope.client_id and rs.self_bill_report_id is not null)
          and not exists(select 1 from public.weekly_source_report_scopes rs where rs.source_cycle_id=scope.cycle_id and rs.client_id=scope.client_id and rs.self_bill_report_id is not null
            and not exists(select 1 from jsonb_array_elements(process->'scopes') f where f->>'report_scope_id'=rs.id::text
              and f->>'authority_scope_kind'='SELF_BILL_REPORT_SCOPE' and f->'process_complete'='true'::jsonb))
        else pay_complete end;
      pay_complete:=pay_complete or no_work;
      if no_work then
        select 'No one worked · '||coalesce(nullif(a.display_name,''),a.id::text)||' · '||
          to_char(completion.attested_at_utc at time zone scope.timezone,'DD/MM/YYYY HH24:MI') into no_work_line
          from public.tms_users a where a.id=completion.attested_by_user_id;
      else no_work_line:=null; end if;
      checked_text:=case when no_work then no_work_line when checked then 'Checked '||to_char(checked_at at time zone scope.timezone,'DD/MM/YYYY HH24:MI:SS') else 'To do · upload the source file' end;
      if rule#>>'{values,invoice_membership}'='FOLLOW_FINAL_REPORT_LINES' then
        -- Q-NOPAY uses the native binding owner's exact finalised-export fact,
        -- independent of pay preparation/approval or report arrival time.
        select coalesce(jsonb_agg(jsonb_build_object('report_row_id',report_row.id,'binding',to_jsonb(b),
          'export_row_id',export_row.id,'export_row_state',export_row.row_finalisation_state,'finalised_by',export_row.finalised_by)
          order by report_row.id),'[]'::jsonb),coalesce(bool_or(b.id is null or export_row.row_finalisation_state is distinct from 'SOURCE_WORKED'
            or nullif(btrim(export_row.finalised_by),'') is null),false)
          into report_bindings,needs_export from public.weekly_source_report_scopes rs
          join public.weekly_source_projection_publications rp on rp.id=rs.current_projection_publication_id
            and rp.upload_id=rs.current_complete_upload_id and rp.report_scope_id=rs.id and rp.state='CURRENT'
            and rp.authority_scope_kind='SELF_BILL_REPORT_SCOPE' and rp.authority_scope_version=rs.version
          join public.weekly_source_uploads ru on ru.id=rp.upload_id and ru.state='CURRENT'
          join public.weekly_source_upload_rows report_row on report_row.upload_id=ru.id and report_row.row_finalisation_state='SOURCE_REPORT_LINE'
            and report_row.source_shift_charge_pence>=0 and report_row.work_date between own_week-6 and own_week
          left join public.weekly_source_self_bill_report_line_bindings b on b.report_row_id=report_row.id and b.state='CURRENT'
          left join public.weekly_source_upload_rows export_row on export_row.id=b.export_upload_row_id
          where rs.source_group_id=scope.group_id and rs.client_id=scope.client_id;
        if needs_export then checked:=false; checked_text:='Import a new export covering '||to_char(own_week-6,'DD/MM/YYYY')||' to '||to_char(own_week,'DD/MM/YYYY'); end if;
        fingerprints:=fingerprints||jsonb_build_array(jsonb_build_object('row_id',row_id,'accepted_report_export_bindings',report_bindings));
      end if;
      complete_text:=case when no_work then no_work_line when completed then 'Processing complete' when pay_complete then 'Pay processing complete · report outstanding' else 'Processing outstanding' end;
      if view='ADMIN' then
        native_workspace:=private.weekly_source_office_tracker_v1(scope.cycle_id,actor.id);
        for tracker_action in select a.value from jsonb_array_elements(coalesce(native_workspace->'rows','[]'::jsonb)) r
          cross join lateral jsonb_array_elements(coalesce(r->'actions','[]'::jsonb)) a(value)
          where r->>'row_key'='tracker-'||scope.client_id::text and a.value->>'command'='NO_SHIFTS_TO_IMPORT' and a.value->'enabled'='true'::jsonb
        loop
          admin_actions:=admin_actions||jsonb_build_array(jsonb_build_object('kind','NO_ONE_WORKED','label','No one worked','native_allowed',true,
            'payload',(tracker_action->'payload'-'actor_user_id')||jsonb_build_object('attestation_text','No one worked')));
        end loop;
        if completion.id is not null and scope.cycle_state<>'FINALISING' then
          admin_actions:=jsonb_build_array(jsonb_build_object('kind','UNDO_NO_ONE_WORKED','label','Undo','native_allowed',true,
            'payload',row_scope-'week_ending'||jsonb_build_object('completion_id',completion.id,'expected_cycle_version',scope.cycle_version)));
        end if;
        if route in('SELF_BILL','NATIVE') then
          select jsonb_build_object('kind','FINALISE','label','View Finalise ›','native_allowed',true,
            'target',row_scope-'week_ending'||jsonb_build_object('report_scope_id',rs.id)) into finalise_link
            from public.weekly_source_report_scopes rs where rs.source_cycle_id=scope.cycle_id and rs.client_id=scope.client_id order by rs.id limit 1;
          finalise_link:=coalesce(finalise_link,jsonb_build_object('kind','FINALISE','label','View Finalise ›','native_allowed',true,'target',row_scope-'week_ending'));
        end if;
      end if;
      if route='NATIVE' and not exists(select 1 from public.contract_weeks cw join public.contracts con on con.id=cw.contract_id
        where con.client_id=scope.client_id and cw.week_ending_date=own_week and cw.additional_seq=0 and not cw.is_adjustment
          and cw.status::text in('PLANNED','OPEN','SUBMITTED')) and checking_upload is null and completion.id is null
        and jsonb_array_length(process->'scopes')=0 and not exists(select 1 from public.weekly_source_report_scopes rs
          where rs.source_cycle_id=scope.cycle_id and rs.client_id=scope.client_id) then continue; end if;
      fingerprints:=fingerprints||jsonb_build_array(jsonb_build_object('row_id',row_id,'context',leaf,'process',process,
        'checking_upload',checking_upload,'checked_at',checked_at,'completion',to_jsonb(completion),'source_count',source_count));
      -- Reuse the native Queries owner for Source reason/status/population.
      -- Its work-event subject is distinct from a submitted Timesheet and from
      -- R-254 HR information. The witness retains actual catalogue identities.
      seen_items:='{}'::text[];
      for source_native in
        select publication.id publication_id,q.group_key parent_group_key,q.candidate_name,child.value native_row,
          event.id work_event_id,event.work_date,
          coalesce(comparison.source_row_id,review.upload_row_id,missing_row.id) upload_row_id,
          mapping.id row_resolution_id,incident.id incident_id,comparison.id comparison_revision_id,review.id manual_review_id,
          coalesce(comparison.issue_family,case when review.id is not null then 'MANUAL_REVIEW' else 'CANDIDATE_TIMESHEET_MISSING' end) native_reason
        from public.weekly_source_cycles cycle
        join public.weekly_source_projection_publications publication on publication.source_cycle_id=cycle.id and publication.state='CURRENT'
          and (publication.id=cycle.current_projection_publication_id or (cycle.current_projection_publication_id is null and
            exists(select 1 from public.weekly_source_report_scopes rs where rs.source_cycle_id=cycle.id and rs.client_id=scope.client_id
              and rs.current_projection_publication_id=publication.id)))
        cross join lateral private.weekly_source_office_query_groups_v1(cycle.id,publication.id,jsonb_build_object('client_id',scope.client_id)) q
        cross join lateral jsonb_array_elements(q.children) child(value)
        left join public.weekly_discrepancy_incidents incident on incident.id=nullif(child.value->>'incident_id','')::uuid
          and incident.client_id=scope.client_id and incident.source_group_id=scope.group_id and incident.state='OPEN'
        left join public.weekly_issue_comparison_revisions comparison on comparison.id=incident.current_comparison_revision_id
          and comparison.incident_id=incident.id
        left join private.weekly_source_manual_reviews review on review.id=nullif(child.value->>'manual_review_id','')::uuid
          and review.client_id=scope.client_id and review.source_group_id=scope.group_id and review.source_cycle_id=scope.cycle_id and review.state='OPEN'
        left join public.weekly_source_upload_rows missing_row on child.value->>'row_key'='missing-'||missing_row.id::text
          and missing_row.upload_id=publication.upload_id
        left join public.weekly_source_row_resolutions mapping on mapping.upload_row_id=missing_row.id
          and mapping.client_id=scope.client_id and mapping.mapping_state='RESOLVED'
          and mapping.generation=coalesce(publication.projection_generation,publication.authority_scope_version)
        join public.weekly_work_events event on event.id=coalesce(incident.work_event_id,review.work_event_id,mapping.work_event_id)
          and event.client_id=scope.client_id and event.first_source_group_id=scope.group_id
        where route<>'AGENCY_INVOICE' and cycle.id=scope.cycle_id and q.client_id=scope.client_id and event.work_date between own_week-6 and own_week
        order by publication.id,q.group_key,child.value->>'row_key'
      loop
        source_witness:=jsonb_build_object('owner','private.weekly_source_office_query_groups_v1',
          'projection_publication_id',source_native.publication_id,'work_event_id',source_native.work_event_id,
          'upload_row_id',source_native.upload_row_id,'row_resolution_id',source_native.row_resolution_id,
          'incident_id',source_native.incident_id,'comparison_revision_id',source_native.comparison_revision_id,
          'manual_review_id',source_native.manual_review_id,'native_row_key',source_native.native_row->>'row_key',
          'parent_group_key',source_native.parent_group_key,
          'evidence_fingerprint',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECKLIST_NATIVE_QUERY_WITNESS_V1',
            jsonb_build_object('scope',row_scope,'publication_id',source_native.publication_id,'parent_group_key',source_native.parent_group_key,'work_event_id',source_native.work_event_id,
              'comparison_revision_id',source_native.comparison_revision_id,'row_resolution_id',source_native.row_resolution_id,
              'manual_review_id',source_native.manual_review_id,'native_row',source_native.native_row)),'hex'));
        if source_native.native_row->>'row_key'=any(seen_items) then
          raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_ITEM_AMBIGUOUS' using errcode='55000';
        end if;
        seen_items:=array_append(seen_items,source_native.native_row->>'row_key');
        pay_subject:=source_native.native_row->'accept_eligible'='true'::jsonb
          or jsonb_typeof(source_native.native_row->'protected_pay_seed')='object';
        item_hold:=unknown_hold;
        -- Resolve only real existing native lineage roots. A Source work event
        -- does not acquire a counted Timesheet or invented family to read pay.
        select count(distinct t.timesheet_id),(array_agg(distinct t.timesheet_id order by t.timesheet_id))[1]
          into native_roots,native_root from public.weekly_source_row_timesheet_lineages l
          join public.timesheets t on t.timesheet_id=l.timesheet_id and t.is_current
          join public.contracts con on con.id=t.contract_id and con.client_id=scope.client_id
          where l.work_event_id=source_native.work_event_id and t.week_ending_date=own_week
            and t.line_type::text='HOURS' and t.archived_at_utc is null and t.revoked_at is null;
        if native_roots=1 and private.weekly_source_actual_timesheet_submission_v1(native_root)->'actual_submitted'='true'::jsonb then
          hold_facts:=private.weekly_source_checklist_timesheet_hold_facts_v1(native_root,row_scope,actor.id);
          item_hold:=hold_facts->'hold'; financial_facts:=financial_facts||jsonb_build_array(hold_facts->'native_facts');
        end if;
        if native_roots=1 then
          -- A genuine Source-owned authorised root may have no Candidate
          -- submission. The native money owner proves its real event/root,
          -- publication/command/job/member and current query qualification;
          -- it never creates a counted Timesheet or ordinary money subject.
          source_money:=private.weekly_source_checklist_source_shift_query_money_v1(
            native_root,source_native.work_event_id,row_scope,actor.id);
          financial_facts:=financial_facts||jsonb_build_array(source_money->'native_facts');
          if source_money->'known'='true'::jsonb then item_hold:=source_money->'hold';pay_subject:=true; end if;
        end if;
        if pay_subject then pay_count:=pay_count+1; end if;
        if view='PAY_READONLY' and pay_subject is distinct from true then continue; end if;
        row_items:=row_items||jsonb_build_array(jsonb_build_object('item_id','native-source:'||(source_native.native_row->>'row_key'),
          'item_kind','NATIVE_SOURCE','scope',row_scope,'route',route,'worker',source_native.candidate_name,
          'work_date',source_native.work_date,'sheet_scope','WEEKLY','reason_code',source_native.native_reason,
          'status',jsonb_build_object('text',coalesce(source_native.native_row#>>'{status,text}','Decision needed'),
            'tone',case when source_native.native_row#>>'{status,tone}' in('positive','warning','danger','muted')
              then source_native.native_row#>>'{status,tone}' else 'muted' end,
            'subtext',coalesce(source_native.native_row->>'issue',''),'subtone','muted'),'hold',item_hold,
          'subject',case when pay_subject then 'PAY' else 'INFORMATION' end,'permitted_pay_subject',coalesce(pay_subject,false),
          'action',case when view='ADMIN' then jsonb_build_object('kind','QUERIES','label','View item in Queries ›','native_allowed',true,
            'target',row_scope-'week_ending'||jsonb_build_object('row_key',source_native.parent_group_key)) end,
          'counted_timesheet_id',null,'correction_binding',null,'submission_read',null,'source_information_witness',null,
          'native_source_witness',source_witness,'_rank',50));
      end loop;
      if route='SELF_BILL' and view='ADMIN' then
        -- The same exact native admission blocker supplies invoice-only work.
        -- Missing amount/action qualification never suppresses its catalogue.
        -- Reduced pay readers do not execute this invoice population reader.
        invoice_blocks:=private.weekly_source_checklist_source_invoice_decision_items_v1(row_scope,actor.id);
        financial_facts:=financial_facts||jsonb_build_array(invoice_blocks->'native_facts');
        for raw in select value from jsonb_array_elements(invoice_blocks->'items') loop
          row_items:=row_items||jsonb_build_array(raw||jsonb_build_object('item_kind','NATIVE_INVOICE','scope',row_scope,'route',route,
            'sheet_scope','WEEKLY','reason_code','VAT_FIT','status',jsonb_build_object('text','Holds invoice','tone','danger',
              'subtext',case when raw#>>'{hold,pending_decision}'='true' then 'Office decision needed: native VAT_FIT release is qualified.'
              else 'Invoice held: source net and gross do not fit 20% VAT.' end,'subtone','muted'),
            'subject','INVOICE_ONLY','permitted_pay_subject',false,'action',raw->'action','counted_timesheet_id',null,
            'correction_binding',null,'submission_read',null,'source_information_witness',null,'native_source_witness',null,'_rank',55));
        end loop;
        if jsonb_array_length(invoice_blocks->'items')>0 then
          completed:=false;complete_text:=jsonb_array_length(row_items)::text||' items';
        end if;
      end if;
      if route='AGENCY_INVOICE' then
        -- This route is led by actual native ordinary Timesheets. Invoicing is
        -- not the Completed predicate, and a Source finalisation is not used
        -- as an ordinary Authorise/validation/query/correction substitute.
        agency_facts:='[]'::jsonb; actual_count:=0; checked_count:=0; open_count:=0; pay_count:=0;
        for agency_native in
          select t.timesheet_id,t.authorised_at_server,t.version,con.candidate_id,
            coalesce(nullif(btrim(ca.first_name||' '||ca.last_name),''),ca.id::text) worker,
            validation.id validation_id,validation.status::text validation_status,validation.last_source,
            fin.id financial_id,fin.processing_status::text processing_status,
            correction_request.id request_id,correction_request.state_revision,
            correction_request.reversed_timesheet_id,correction_request.replacement_timesheet_id,correction_request.reversal_timesheet_id,
            exists(select 1 from public.import_review_decisions d join public.import_review_states st on st.import_id=d.import_id
              and st.preview_generation=d.preview_generation and st.superseded_at_utc is null and st.abandoned_at_utc is null
              where d.timesheet_id=t.timesheet_id and d.client_id=scope.client_id and d.is_current
                and d.import_id=validation.last_source and d.action_kind in('EMAIL_ISSUE','EMAIL_REMINDER')
                and not exists(select 1 from public.hr_issue_emails e
                  join public.hr_issue_email_deliveries delivery on delivery.id=e.last_successful_delivery_id
                  join public.hr_issue_email_delivery_items delivery_item on delivery_item.delivery_id=delivery.id and delivery_item.issue_id=e.id
                    and delivery_item.issue_fingerprint=e.issue_fingerprint and delivery_item.action_id=d.action_id
                  join public.mail_outbox mail on mail.id=delivery.mail_outbox_id and mail.deterministic_outbox_key=delivery.deterministic_outbox_key
                  where e.timesheet_id=t.timesheet_id and e.client_id=scope.client_id
                    and e.issue_fingerprint=coalesce(nullif(d.summary_json->>'issue_fingerprint',''),d.source_identity)
                    and e.delivery_history_status='SENT_VERIFIED' and delivery.status='SENT'
                    and delivery.accepted_at_utc is not null and delivery.marked_at_utc is not null and delivery_item.marked_sent_at_utc is not null
                    and (upper(mail.status::text)='SENT' or mail.sent_at is not null))) query_unsent,
            exists(select 1 from public.hr_imports hi join public.import_review_states st on st.import_id=hi.id
              where hi.id=validation.last_source and hi.pruned_at is null and st.applied_at_utc is not null
                and hi.source_system::text in('HEALTHROSTER','HEALTHROSTER_DAILY')) comparison_accepted
          from public.timesheets t join public.contracts con on con.id=t.contract_id and con.client_id=scope.client_id
          join public.candidates ca on ca.id=con.candidate_id
          left join public.timesheets_financials fin on fin.timesheet_id=t.timesheet_id and fin.is_current and fin.timesheet_version=t.version
          left join lateral(select v.* from public.timesheet_validations v where v.timesheet_id=t.timesheet_id
            order by v.updated_at desc,v.created_at desc,v.id desc limit 1) validation on true
          left join private.timesheet_correction_requests correction_request on correction_request.state='WAITING'
            and correction_request.reversed_timesheet_id=t.timesheet_id
          where t.week_ending_date=own_week and t.is_current and t.line_type::text='HOURS'
            and t.archived_at_utc is null and t.revoked_at is null and t.correction_kind is distinct from 'WHOLE_TIMESHEET_REVERSAL'
            and private.weekly_source_agency_invoice_check_only_v1(t.timesheet_id) is true
            and not exists(select 1 from private.timesheet_correction_requests r where
              (r.state='WAITING' and r.replacement_timesheet_id=t.timesheet_id) or (r.state='APPLIED' and r.reversed_timesheet_id=t.timesheet_id))
          order by t.timesheet_id
        loop
          if exists(select 1 from jsonb_array_elements(agency_facts) f where f->>'timesheet_id'=agency_native.timesheet_id::text) then
            raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_ITEM_AMBIGUOUS' using errcode='55000';
          end if;
          agency_facts:=agency_facts||jsonb_build_array(to_jsonb(agency_native)); actual_count:=actual_count+1;
          if agency_native.comparison_accepted then checked_count:=checked_count+1; end if;
          correction:=null; action:=null; pay_subject:=false; signed:=null; item_hold:=unknown_hold; query_parent:=null;
          select value into query_parent from jsonb_array_elements(query_targets) where value->>'item_id'='timesheet:'||agency_native.timesheet_id::text;
          if private.weekly_source_actual_timesheet_submission_v1(agency_native.timesheet_id)->'actual_submitted'='true'::jsonb then
            hold_facts:=private.weekly_source_checklist_timesheet_hold_facts_v1(agency_native.timesheet_id,row_scope,actor.id);
            item_hold:=hold_facts->'hold'; financial_facts:=financial_facts||jsonb_build_array(hold_facts->'native_facts');
          end if;
          if agency_native.request_id is not null then
            correction:=jsonb_build_object('request_id',agency_native.request_id,'state','WAITING','state_revision',agency_native.state_revision,
              'original_timesheet_id',agency_native.reversed_timesheet_id,'replacement_timesheet_id',agency_native.replacement_timesheet_id,
              'reversal_timesheet_id',agency_native.reversal_timesheet_id);
            begin signed:=private.timesheet_correction_signed_witness_v1(agency_native.replacement_timesheet_id,false);
            exception when sqlstate '55000' then signed:=null; end;
            reason:=case when signed is null then 'CORRECTION_WAITING' else 'SIGNED_CORRECTION_RECEIVED' end;
            pay_subject:=signed is not null; subject:=case when pay_subject then 'PAY_AND_INVOICE' else 'INVOICE_ONLY' end; rank:=10;
            complete_text:=case when signed is null then 'Correction waiting' else 'Signed correction received' end;
            action:=jsonb_build_object('kind','TIMESHEET','label','View correction in Timesheet ›','native_allowed',true,
              'target',jsonb_build_object('timesheet_id',agency_native.replacement_timesheet_id));
          elsif agency_native.authorised_at_server is null then
            reason:='TIMESHEET_NOT_AUTHORISED'; pay_subject:=true; subject:='PAY_AND_INVOICE'; rank:=20;
            complete_text:='Timesheet not authorised';
            action:=jsonb_build_object('kind','TIMESHEET','label','Open Timesheet ›','native_allowed',true,'target',jsonb_build_object('timesheet_id',agency_native.timesheet_id));
          elsif agency_native.validation_status is distinct from 'VALIDATION_OK' or agency_native.processing_status='READY_FOR_HR'
            or agency_native.query_unsent then
            reason:=case when agency_native.query_unsent then 'QUERY_NOT_SENT' when not agency_native.comparison_accepted
              then 'NOT_YET_CHECKED' else 'HEALTHROSTER_VALIDATION_OUTSTANDING' end; subject:='INVOICE_ONLY'; rank:=40;
            complete_text:=case reason when 'QUERY_NOT_SENT' then 'Query not sent yet' when 'NOT_YET_CHECKED'
              then 'Not yet checked against HealthRoster' else 'HealthRoster validation outstanding' end;
            if query_parent is not null then
              action:=jsonb_build_object('kind','QUERIES','label','View item in Queries ›','native_allowed',true,
                'target',row_scope-'week_ending'||jsonb_build_object('row_key',query_parent->>'parent_group_key'));
            end if;
          else continue;
          end if;
          open_count:=open_count+1; if pay_subject then pay_count:=pay_count+1; end if;
          if view='PAY_READONLY' and not pay_subject then continue; end if;
          row_items:=row_items||jsonb_build_array(jsonb_build_object('item_id','timesheet:'||agency_native.timesheet_id::text,
            'item_kind','ACTUAL_TIMESHEET','scope',row_scope,'route',route,'worker',agency_native.worker,'work_date',own_week,
            'sheet_scope','WEEKLY','reason_code',reason,'status',jsonb_build_object('text','Decision needed','tone','warning','subtext',complete_text,'subtone','muted'),
            'hold',item_hold,'subject',subject,'permitted_pay_subject',pay_subject,'action',case when view='ADMIN' then action end,
            'queries_parent_witness',case when view='ADMIN' and action->>'kind'='QUERIES' then query_parent end,
            'counted_timesheet_id',agency_native.timesheet_id,'correction_binding',correction,'submission_read',null,'source_information_witness',null,'_rank',rank));
        end loop;
        checked:=no_work or (actual_count>0 and checked_count=actual_count);
        completed:=no_work or (actual_count>0 and open_count=0); pay_complete:=no_work or (actual_count>0 and pay_count=0);
        checked_text:=case when no_work then no_work_line when checked then 'Checked' else 'To do · upload the HealthRoster file' end;
        complete_text:=case when no_work then no_work_line when completed then 'Nothing outstanding' else open_count::text||' items' end;
        fingerprints:=fingerprints||jsonb_build_array(jsonb_build_object('row_id',row_id,'native_agency_timesheets',agency_facts));
      end if;
      fingerprints:=fingerprints||jsonb_build_array(jsonb_build_object('row_id',row_id,'native_source_items',row_items));
    end if;
    if route in('SIGNED_TIMESHEETS','AGENCY_INVOICE') then
      if jsonb_typeof(leaf->'native_financial_items') is distinct from 'array' or jsonb_typeof(leaf->'native_financial_facts') is distinct from 'array' then
        raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_FINANCIAL_FRAME_UNAVAILABLE' using errcode='55000'; end if;
      financial_facts:=financial_facts||leaf->'native_financial_facts';
      for raw in select value from jsonb_array_elements(leaf->'native_financial_items') loop
        if raw->>'native_financial_kind'='LEGACY_REVIEW' then
          if raw->'review_required' is distinct from 'true'::jsonb
            or raw#>'{native_legacy_review_witness,scope}' is distinct from row_scope then
            raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_FINANCIAL_FRAME_UNAVAILABLE' using errcode='55000';end if;
          row_items:=row_items||jsonb_build_array(jsonb_build_object(
            'item_id','native-legacy-review:'||(raw#>>'{native_legacy_review_witness,timesheet_id}'),
            'item_kind','NATIVE_ORDINARY_FINANCIAL_REVIEW','scope',row_scope,'route',route,'worker',raw->'worker',
            'work_date',raw->'work_date','sheet_scope',raw->'sheet_scope','reason_code','NATIVE_LEGACY_PAY_HOLD_REVIEW',
            'status',raw->'status','hold',raw->'hold','subject','PAY','permitted_pay_subject',true,
            'action',case when view='ADMIN' then jsonb_build_object('kind','TIMESHEET','label','Review native pay hold in Timesheet ›',
              'native_allowed',true,'target',jsonb_build_object('timesheet_id',raw#>>'{native_legacy_review_witness,timesheet_id}')) end,
            'counted_timesheet_id',raw#>>'{native_legacy_review_witness,timesheet_id}','correction_binding',null,'submission_read',null,
            'source_information_witness',null,'native_source_witness',null,'native_invoice_witness',null,'native_invoice_decision_witness',null,
            'queries_parent_witness',null,'native_ordinary_money_witness',null,'native_legacy_review_witness',raw->'native_legacy_review_witness','_rank',35));
          open_count:=open_count+1;pay_count:=pay_count+1;completed:=false;pay_complete:=false;complete_text:=open_count::text||' items';
          continue;
        end if;
        if raw->'known' is distinct from 'true'::jsonb or raw#>>'{native_ordinary_money_witness,scope,source_group_id}' is distinct from row_scope->>'source_group_id'
          or raw#>>'{native_ordinary_money_witness,scope,source_cycle_id}' is distinct from row_scope->>'source_cycle_id'
          or raw#>>'{native_ordinary_money_witness,scope,client_id}' is distinct from row_scope->>'client_id'
          or raw#>>'{native_ordinary_money_witness,scope,week_ending}' is distinct from row_scope->>'week_ending' then
          raise exception 'WEEKLY_SOURCE_CHECKLIST_NATIVE_FINANCIAL_FRAME_UNAVAILABLE' using errcode='55000'; end if;
        -- A separate native TSFIN hold is not a HealthRoster invoice query.
        -- The genuine Timesheet was already counted by its submission owner.
        row_items:=row_items||jsonb_build_array(jsonb_build_object('item_id','native-financial:'||(raw#>>'{native_ordinary_money_witness,work_id}'),
          'item_kind','NATIVE_ORDINARY_FINANCIAL','scope',row_scope,'route',route,'worker',raw->'worker','work_date',raw->'work_date',
          'sheet_scope',raw->>'sheet_scope','reason_code','PAY_ON_HOLD','status',raw->'status','hold',raw->'hold','subject','PAY','permitted_pay_subject',true,
          'action',case when view='ADMIN' then jsonb_build_object('kind','TIMESHEET','label','View pay hold in Timesheet ›','native_allowed',true,
            'target',jsonb_build_object('timesheet_id',raw#>>'{native_ordinary_money_witness,timesheet_id}')) end,
          'counted_timesheet_id',raw#>>'{native_ordinary_money_witness,timesheet_id}','correction_binding',null,'submission_read',null,
          'source_information_witness',null,'native_source_witness',null,'native_invoice_witness',null,'native_invoice_decision_witness',null,
          'queries_parent_witness',null,'native_ordinary_money_witness',raw->'native_ordinary_money_witness','_rank',35));
        open_count:=open_count+1;pay_count:=pay_count+1;completed:=false;pay_complete:=false;complete_text:=open_count::text||' items';
      end loop;
    end if;
    if route='SIGNED_TIMESHEETS' and own_week<>latest_week and completed then continue; end if;
    fingerprints:=fingerprints||jsonb_build_array(jsonb_build_object('row_id',row_id,'native_financial_facts',financial_facts));
    if view='PAY_READONLY' and pay_count=0 then continue; end if;
    empty_cell:=jsonb_build_object('value',null,'status',jsonb_build_object('text','—','tone','muted','subtext','','subtone','muted'),'item_count',0,'link',null);
    rows:=rows||jsonb_build_array(jsonb_build_object('row_id',row_id,'scope',row_scope,'client',scope.client_name,
      'group',scope.display_name||case route when 'SIGNED_TIMESHEETS' then ' · signed Timesheets' when 'AGENCY_INVOICE' then ' · agency invoice'
        when 'SELF_BILL' then ' · self-bill' else '' end,'route',route,
      'retention',jsonb_build_object('actual_timesheet_count',actual_count,'most_recent_ended_week',latest_week,'has_open_items',not completed,'earlier_open_weeks',earlier),
      'checked',case when view='PAY_READONLY' then empty_cell else jsonb_build_object('value',checked,'item_count',actual_count-checked_count,
        'status',jsonb_build_object('text',checked_text,'tone','muted','subtext','','subtone','muted'),
        'link',case when checking_upload is not null then jsonb_build_object('kind','UPLOAD_DETAIL','label','View source file ›','native_allowed',true,'target',jsonb_build_object('upload_id',checking_upload)) end) end,
      'completed',jsonb_build_object('value',case when view='PAY_READONLY' then pay_complete else completed end,
        'item_count',case when view='PAY_READONLY' then pay_count else jsonb_array_length(row_items) end,
        'status',jsonb_build_object('text',case when view='PAY_READONLY' then case when pay_complete then 'Pay: nothing outstanding' else pay_count::text||' pay items' end else complete_text end,
          'tone','muted','subtext','','subtone','muted'),'link',case when view='ADMIN' then finalise_link end),
      'pay_completed',jsonb_build_object('value',pay_complete,'item_count',pay_count,'status',jsonb_build_object('text',case when pay_complete
        then 'Pay: nothing outstanding' else pay_count::text||' pay items' end,'tone','muted','subtext','','subtone','muted'),'link',null),
      'hold',unknown_hold,'permitted_pay_item_count',pay_count,'admin_actions',admin_actions));
    items:=items||row_items;
  end loop;
  -- One actor-wide revision is shared by main and independently paged item
  -- expansions. Filtering/sorting affect bindings, never erase change evidence.
  revision:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_CHECKLIST_READ_REVISION_V1',jsonb_build_object(
    'actor_user_id',actor.id,'permission_view',view,'native_facts',fingerprints,'rows',rows,'items',items)),'hex');
  records:='[]'::jsonb;
  for item in select value from jsonb_array_elements(case when command='CHECKLIST' then rows else items end) loop
    if exists(select 1 from unnest(array['source_group_id','client_id','source_cycle_id','week_ending']) k
      where request ? k and item#>>array['scope',k] is distinct from request->>k) then continue; end if;
    if command='CHECKLIST' then
      primary_key:=case sort when 'week_ending' then item#>>'{scope,week_ending}' when 'client' then private.weekly_source_query_ascii_fold_v1(item->>'client')
        when 'group' then private.weekly_source_query_ascii_fold_v1(item->>'group') when 'checked' then coalesce(item#>>'{checked,value}','false')
        when 'completed' then item#>>'{completed,value}' end;
      sort_key:=jsonb_build_array(primary_key,private.weekly_source_query_ascii_fold_v1(item->>'client'),item#>>'{scope,source_group_id}',
        item#>>'{scope,client_id}',item#>>'{scope,week_ending}',item->>'row_id');
    else
      sort_key:=jsonb_build_array(private.weekly_source_query_ascii_fold_v1(item->>'worker'),item->>'work_date',
        lpad(item->>'_rank',3,'0'),item->>'item_id',item#>>'{scope,client_id}',item#>>'{scope,week_ending}');
    end if;
    records:=records||jsonb_build_array((item-'_rank')||jsonb_build_object('_key',sort_key));
  end loop;
  if command='CHECKLIST_ISSUES' and not exists(select 1 from jsonb_array_elements(rows) r where r->'scope'=jsonb_build_object(
    'source_group_id',request->'source_group_id','client_id',request->'client_id','source_cycle_id',request->'source_cycle_id','week_ending',request->'week_ending')) then
    raise exception 'WEEKLY_SOURCE_CHECKLIST_ANCHORED_REFRESH_REQUIRED' using errcode='40001';
  end if;
  result:=private.weekly_source_checklist_page_v1(records,request,actor.id,view,binding,revision);
  if octet_length(result::text)>200000 then raise exception 'WEEKLY_SOURCE_CHECKLIST_RESPONSE_TOO_LARGE' using errcode='54000'; end if;
  return result;
exception when invalid_text_representation or numeric_value_out_of_range or datetime_field_overflow then
  raise exception 'WEEKLY_SOURCE_CHECKLIST_REQUEST_INVALID' using errcode='22023';
end;
$function$;

create or replace function private.bpay_next_workbench_refresh_work_core_v1(p_work_id uuid)
returns void language plpgsql security definer set search_path=pg_catalog,private
as $function$
declare
  v_work private.bpay_next_work%rowtype;v_revision private.bpay_next_work_revision%rowtype;
  v_metadata private.bpay_next_workbench_candidate_metadata%rowtype;
  v_item private.bpay_next_workbench_item%rowtype;v_base private.bpay_next_workbench_item%rowtype;
  v_before private.bpay_next_workbench_delta[];v_after private.bpay_next_workbench_delta[];
  v_member record;v_accepted record;v_totals record;v_candidate uuid;v_client uuid;v_target text;v_financial bigint;v_projection bigint;
  v_group text:='WORK:'||p_work_id::text;v_today date:=(transaction_timestamp() at time zone 'Europe/London')::date;
  v_sunday date;v_sequence bigint;v_reason text;v_priority smallint;v_section text;v_complete boolean;
  v_pay_hold record;v_hold_canonical boolean;v_native_period jsonb;
  v_target_umbrella uuid;v_target_vat boolean;v_need_operation uuid;v_resolution_need jsonb;v_resolution_date date;v_resolution_date_context jsonb;
  v_source_event uuid;
  v_query_gate jsonb;v_query_scope jsonb;v_query_loaded boolean:=false;v_query_state text:='UNAVAILABLE';v_query_exclusions jsonb;v_segment_query_state text;
  v_wait_before boolean;v_wait_after boolean;v_case_id uuid;v_withdrawn_complete boolean;v_was_dirty boolean;
  v_manual private.bpay_next_work_collection%rowtype;v_manual_observation jsonb;v_manual_position private.bpay_next_position%rowtype;v_original_line private.bpay_next_approved_line%rowtype;
  v_positive numeric;v_recovery numeric;v_overhang numeric;v_snooze jsonb;v_count bigint:=0;v_portion text;v_zero boolean;
begin
  perform private.bpay_next_workbench_require_next_v1();
  select w.candidate_id into strict v_candidate from private.bpay_next_work w where w.id=p_work_id;
  select c.financial_view_revision into strict v_financial from private.bpay_next_worker_control c where c.candidate_id=v_candidate for update;
  select w.* into strict v_work from private.bpay_next_work w where w.id=p_work_id for update;
  -- Exact current booking authority; no historical/original-row fallback.
  select t.timesheet_id,tf.id financial_id,coalesce(tf.pay_on_hold,false) pay_on_hold,
    case when tf.pay_on_hold then tf.pay_on_hold_reason end pay_on_hold_reason into v_pay_hold
    from public.timesheets t left join public.timesheets_financials tf on tf.timesheet_id=t.timesheet_id and tf.is_current
    where t.booking_id=v_work.booking_id and t.is_current;
  v_hold_canonical:=v_pay_hold.timesheet_id is not null and v_pay_hold.financial_id is not null;
  -- Read stored WAIT before replacing it; the withdrawal owner already changed work.
  select exists(select 1 from private.bpay_next_workbench_item i where i.group_key=v_group
    and i.reason_code='AWAITING_REAUTHORISATION') into v_wait_before;
  v_wait_after:=private.bpay_next_work_wait_state_v1(v_work.id);
  select exists(select 1 from private.bpay_next_workbench_group g where g.group_key=v_group and g.dirty) into v_was_dirty;
  -- Reauthorisation becomes effective only after final position application.
  -- Keep its stored WAIT marker during Processing for the final boundary hook.
  if v_wait_before and v_work.approval_state='APPROVED'
    and v_work.current_revision_id is distinct from v_work.applied_revision_id then
    update private.bpay_next_workbench_revision set workbench_revision=workbench_revision+1,
      dirty_group_count=dirty_group_count+case when v_was_dirty then 0 else 1 end,
      updated_at_utc=transaction_timestamp() where id=1 returning workbench_revision into v_projection;
    update private.bpay_next_workbench_group set complete=false,dirty=true,progress_state='PROCESSING',
      projection_revision=v_projection,financial_view_revision=v_financial,
      updated_at_utc=transaction_timestamp() where group_key=v_group;
    update private.bpay_next_workbench_item set selectable=false,progress_state='PROCESSING',
      projection_revision=v_projection,financial_view_revision=v_financial,
      updated_at_utc=transaction_timestamp() where group_key=v_group;
    return;
  end if;
  v_metadata:=private.bpay_next_workbench_ensure_metadata_v1(v_candidate);
  select c.pay_method::text,case when c.pay_method='UMBRELLA' then c.umbrella_id end,
    case when c.pay_method='UMBRELLA' then u.vat_chargeable end into v_target,v_target_umbrella,v_target_vat
    from public.candidates c left join public.umbrellas u on u.id=c.umbrella_id where c.id=v_candidate;
  if v_target not in ('PAYE','UMBRELLA') then v_target:=null;end if;
  select c.client_id into v_client from public.contracts c where c.id=v_work.contract_id;
  select r.* into v_revision from private.bpay_next_work_revision r
    where r.id=case when v_work.approval_state='WITHDRAWN' then v_work.applied_revision_id else v_work.current_revision_id end
      and r.work_id=v_work.id;
  -- Contractless DAILY authority is the existing publisher's sealed revision
  -- and its exact physical/current TF, never a name, original-row fallback or
  -- an invented Contract. Incomplete/changed evidence leaves Client unknown.
  if v_work.contract_id is null and v_work.work_kind='ORDINARY' and v_work.origin_kind='DAILY'
    and v_revision.source_kind='ORDINARY' and v_revision.sealed_at_utc is not null
    and v_revision.daily_approval_evidence_json->>'contract_version'='BPAY_NEXT_DAILY_APPROVAL_EVIDENCE_V1'
    and v_revision.daily_approval_evidence_json->>'timesheet_id'=v_revision.physical_timesheet_id::text
    and v_revision.daily_approval_evidence_json->>'timesheet_version'=v_revision.physical_timesheet_version::text
    and v_revision.daily_approval_evidence_json->>'financial_id'=v_revision.financial_snapshot_id::text
    and v_revision.daily_approval_evidence_json->>'booking_id'=v_work.booking_id
    and v_revision.daily_approval_evidence_json->>'candidate_id'=v_work.candidate_id::text
    and v_revision.daily_approval_evidence_json->>'work_date'=v_work.origin_work_date::text then
    select f.client_id into v_client from public.timesheets t join public.timesheets_financials f
      on f.id=v_revision.financial_snapshot_id and f.timesheet_id=t.timesheet_id
      where t.timesheet_id=v_revision.physical_timesheet_id and t.booking_id=v_work.booking_id
        and t.version=v_revision.physical_timesheet_version and t.is_current and t.contract_id is null
        and t.sheet_scope::text='DAILY' and t.line_type::text='HOURS'
        and t.week_ending_date=v_work.week_ending_date and t.authorised_at_server is not null
        and t.revoked_at is null and t.archived_at_utc is null and not t.is_adjustment
        and t.parent_timesheet_id is null and t.correction_id is null
        and f.is_current and not f.is_stale and f.timesheet_version=t.version and f.authorised_at_utc is not null
        and f.processed_at_utc is not null and f.basis::text='SELF_REPORTED' and f.candidate_id=v_work.candidate_id
        and f.client_id::text=v_revision.daily_approval_evidence_json->>'client_id'
        and (t.worked_start_iso at time zone 'Europe/London')::date=v_work.origin_work_date
        and (f.worked_start_iso,f.worked_end_iso,f.break_start_iso,f.break_end_iso,f.break_minutes)
          is not distinct from (t.worked_start_iso,t.worked_end_iso,t.break_start_iso,t.break_end_iso,t.break_minutes)
        and t.settings_authority_json->>'authority_version'='CONTRACT_SETTINGS_AUTHORITY_V1'
        and t.settings_authority_json->>'workflow'='DAILY'
        and t.settings_authority_json->>'client_id'=f.client_id::text
        and t.settings_authority_json->'contract_id'='null'::jsonb
        and t.settings_authority_json->>'relevant_date'=v_work.origin_work_date::text
        and (select count(*) from public.timesheets current_ts where current_ts.booking_id=t.booking_id and current_ts.is_current)=1
        and (select count(*) from public.timesheets_financials current_tf where current_tf.timesheet_id=t.timesheet_id and current_tf.is_current)=1;
  end if;
  v_native_period:=private.bpay_next_work_period_proof_v1(v_work.id,v_revision.id,v_today);
  v_source_event:=v_revision.source_event_id;
  if v_revision.source_kind in ('SOURCE','PROTECTED') and v_revision.sealed_at_utc is not null
    and v_revision.payment_treatment_approval_revision_id is not null then
    select x.source_event_id into v_source_event from private.bpay_next_work_revision x
      where x.id=private.bpay_next_treatment_approval_revision_v1(v_revision.id) and x.work_id=v_work.id;
  end if;
  v_complete:=v_work.approval_state='APPROVED' and v_revision.id is not null and v_revision.sealed_at_utc is not null
    and v_work.applied_revision_id=v_work.current_revision_id
    and (select count(*) from private.bpay_next_approved_line a where a.revision_id=v_revision.id)=v_revision.expected_line_count;
  -- Only the latest native EX08 receipt and this exact Work; retained needs
  -- are joined inside this existing projection writer, never a read RPC.
  if v_complete then
    select r.operation_id into v_need_operation from private.bpay_next_pay_method_change_receipt r
      where r.candidate_id=v_candidate order by r.post_metadata_version desc limit 1;
    if v_need_operation is not null then
      perform private.bpay_next_component_resolution_need_publish_v1(v_need_operation,v_work.id);
      v_resolution_date_context:=public.pay_banking_official_date_context_v1(null::timestamptz);
      if v_resolution_date_context->>'ok'='true' then
        v_resolution_date:=(v_resolution_date_context->>'current_official_pay_date')::date;
      end if;
    end if;
  end if;
  v_withdrawn_complete:=v_work.approval_state='WITHDRAWN' and v_revision.id is not null
    and v_revision.sealed_at_utc is not null and not exists(select 1 from private.bpay_next_position p
      where p.work_id=v_work.id and p.applied_revision_id is distinct from v_work.applied_revision_id
        and (p.approved_source_ex_vat<>0 or p.realised_source_ex_vat<>0 or p.held_source_ex_vat<>0
          or p.realised_target_ex_vat<>0 or p.realised_target_vat<>0 or p.realised_target_inc_vat<>0
          or p.held_target_ex_vat<>0 or p.held_target_vat<>0 or p.held_target_inc_vat<>0));
  select array_agg(d) into v_before from private.bpay_next_workbench_group_contribution_v1(v_group) d;
  update private.bpay_next_workbench_revision set workbench_revision=workbench_revision+1,
    dirty_group_count=dirty_group_count-case when v_was_dirty then 1 else 0 end,updated_at_utc=transaction_timestamp()
    where id=1 returning workbench_revision into v_projection;
  delete from private.bpay_next_workbench_item where group_key=v_group;
  insert into private.bpay_next_workbench_group(group_key,group_kind,work_id,candidate_id,client_id,contract_id,
    physical_timesheet_id,current_revision_id,source_pay_channel,target_pay_channel,week_ending_date,
    complete,projection_revision,financial_view_revision,metadata_version,progress_state)
  values(v_group,'WORK',v_work.id,v_candidate,v_client,v_work.contract_id,v_revision.physical_timesheet_id,v_work.current_revision_id,
    v_revision.source_pay_channel,v_target,v_work.week_ending_date,coalesce(v_complete,false),v_projection,v_financial,v_metadata.metadata_version,
    case when v_complete then 'CURRENT' when v_work.approval_state='APPROVED' then 'PROCESSING' else 'UNAVAILABLE' end)
  on conflict(group_key) do update set client_id=excluded.client_id,contract_id=excluded.contract_id,
    physical_timesheet_id=excluded.physical_timesheet_id,current_revision_id=excluded.current_revision_id,
    source_pay_channel=excluded.source_pay_channel,target_pay_channel=excluded.target_pay_channel,week_ending_date=excluded.week_ending_date,
    complete=excluded.complete,dirty=false,projection_revision=excluded.projection_revision,financial_view_revision=excluded.financial_view_revision,
    metadata_version=excluded.metadata_version,progress_state=excluded.progress_state,error_code=null,updated_at_utc=transaction_timestamp();
  v_sunday:=v_today+(7-extract(isodow from v_today)::integer);
  select last_sequence into strict v_sequence from private.bpay_next_command_clock where id=1;
  if v_work.approval_state='WITHDRAWN' then
    -- Native retained positions supply A/C/H directly. No zero revision, job,
    -- debt, current residual offer, segment repricing or Case mutation here.
    for v_member in select p.component_key,p.approved_source_ex_vat approved_amount,
      p.realised_source_ex_vat realised_amount,p.held_source_ex_vat held_amount,p.source_basis_channel,
      a.id approved_line_id,a.component_kind,a.tax_treatment,a.work_date,a.approved_quantity,a.unit_label
      from private.bpay_next_position p left join private.bpay_next_approved_line a
        on a.revision_id=v_revision.id and a.component_key=p.component_key
      where p.work_id=v_work.id and v_withdrawn_complete and (p.applied_revision_id=v_work.applied_revision_id
        or p.approved_source_ex_vat<>0 or p.realised_source_ex_vat<>0 or p.held_source_ex_vat<>0
        or p.realised_target_ex_vat<>0 or p.realised_target_vat<>0 or p.realised_target_inc_vat<>0
        or p.held_target_ex_vat<>0 or p.held_target_vat<>0 or p.held_target_inc_vat<>0) order by p.component_key loop
      v_count:=v_count+1;v_item:=null;v_item.id:=gen_random_uuid();v_item.group_key:=v_group;v_item.candidate_id:=v_candidate;
      v_item.work_id:=v_work.id;v_item.revision_id:=v_revision.id;v_item.approved_line_id:=v_member.approved_line_id;
      v_item.component_key:=v_member.component_key;v_item.member_kind:='WORK_COMPONENT';v_item.member_key:=v_member.component_key;
      v_item.portion_kind:='WITHDRAWN';v_item.direction:='INFORMATIONAL';v_item.payroll_stage:='GROSS_ADD';
      v_item.client_id:=v_client;v_item.contract_id:=v_work.contract_id;v_item.physical_timesheet_id:=v_revision.physical_timesheet_id;
      v_item.week_ending_date:=v_work.week_ending_date;v_item.work_date:=v_member.work_date;
      v_item.candidate_display_name:=v_metadata.candidate_sort_name;v_item.candidate_reference:=v_metadata.tms_ref;
      v_item.client_display_name:=v_revision.client_display_name;v_item.timesheet_reference:=v_revision.timesheet_reference;
      v_item.component_kind:=v_member.component_kind;v_item.tax_treatment:=v_member.tax_treatment;
      v_item.approved_quantity:=v_member.approved_quantity;v_item.unit_label:=v_member.unit_label;
      v_item.source_pay_channel:=v_member.source_basis_channel;v_item.target_pay_channel:=v_target;
      v_item.amount_known:=true;v_item.nominal_source_ex_vat:=v_member.approved_amount;v_item.approved_source_ex_vat:=v_member.approved_amount;
      v_item.realised_source_ex_vat:=v_member.realised_amount;v_item.active_reserved_source_ex_vat:=v_member.held_amount;
      v_item.residual_source_ex_vat:=v_member.approved_amount-v_member.realised_amount-v_member.held_amount;
      v_item.gross_due_source_ex_vat:=0;v_item.included_source_ex_vat:=0;v_item.excluded_source_ex_vat:=0;
      v_item.recovery_source_ex_vat:=0;v_item.held_overhang_source_ex_vat:=0;v_item.written_off_source_ex_vat:=0;
      v_item.section:=case when v_wait_after then 'ACTION' else 'BLOCKED' end;
      v_item.reason_code:=case when v_wait_after then 'AWAITING_REAUTHORISATION' else 'APPROVAL_WITHDRAWN' end;
      v_item.reason_priority:=case when v_wait_after then 70 else 20 end;v_item.selectable:=false;
      v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.query_qualified:=false;v_item.query_state:='NOT_APPLICABLE';
      v_item.financial_view_revision:=v_financial;v_item.projection_revision:=v_projection;v_item.metadata_version:=v_metadata.metadata_version;
      v_item.progress_state:='CURRENT';v_item.updated_at_utc:=transaction_timestamp();
      insert into private.bpay_next_workbench_item select (v_item).*;
      select b.* into v_manual from private.bpay_next_work_collection b where b.work_id=v_work.id
        and b.component_key=v_member.component_key and b.collection_mode='MANUAL' and b.case_id is null
        and b.observed_revision_id=v_revision.id and b.manual_outstanding_source_ex_vat>0;
      if v_manual.id is not null and coalesce((private.bpay_next_work_collection_observation_v1(
          v_work.id,v_manual.component_key,v_revision.id)->>'complete')::boolean,false) then
        -- The native WITHDRAWN row above alone owns A/C/H and the WAIT marker.
        v_count:=v_count+1;v_item.id:=gen_random_uuid();v_item.portion_kind:='AVAILABLE';
        v_item.nominal_source_ex_vat:=v_manual.manual_outstanding_source_ex_vat;
        v_item.approved_source_ex_vat:=0;v_item.realised_source_ex_vat:=0;v_item.active_reserved_source_ex_vat:=0;
        v_item.residual_source_ex_vat:=0;v_item.gross_due_source_ex_vat:=0;v_item.included_source_ex_vat:=0;
        v_item.excluded_source_ex_vat:=0;v_item.recovery_source_ex_vat:=0;v_item.held_overhang_source_ex_vat:=0;
        v_item.written_off_source_ex_vat:=0;v_item.deduction_balance_source_ex_vat:=0;
        v_item.section:='ACTION';v_item.reason_code:='MANUAL_COLLECTION';v_item.reason_priority:=81;
        select line.* into strict v_original_line from private.bpay_next_approved_line line where line.id=v_manual.original_approved_line_id;
        if v_item.component_kind is null then v_item.component_kind:=v_original_line.component_kind;end if;
        if v_item.tax_treatment is null then v_item.tax_treatment:=v_original_line.tax_treatment;end if;
        v_item.payroll_stage:=case v_item.tax_treatment when 'TAXABLE' then 'GROSS_DEDUCT' when 'NON_TAXABLE' then 'NET_DEDUCT' else null end;
        insert into private.bpay_next_workbench_item select (v_item).*;
      end if;
    end loop;
    update private.bpay_next_workbench_group set complete=v_count>0,certified_zero=false,
      progress_state=case when v_withdrawn_complete then 'CURRENT' when v_work.applied_revision_id is not null then 'PROCESSING' else 'UNAVAILABLE' end
      where group_key=v_group;
  else
  for v_member in select m.component_key,m.approved_line_id,m.approved_segment_id,m.segment_key,m.component_kind,m.tax_treatment,m.work_date,m.approved_quantity,m.unit_label,m.approved_amount,m.realised_amount,m.held_amount,m.source_pay_channel,m.parent_complete,m.segment_attribution_complete from private.bpay_next_workbench_work_members_v1(v_work.id,v_revision.id) m order by m.component_key,m.segment_key nulls first loop
    v_count:=v_count+1;v_item:=null;v_item.id:=gen_random_uuid();v_item.group_key:=v_group;v_item.candidate_id:=v_candidate;
    v_item.work_id:=v_work.id;v_item.revision_id:=v_revision.id;v_item.approved_line_id:=v_member.approved_line_id;
    v_item.approved_segment_id:=v_member.approved_segment_id;v_item.segment_key:=v_member.segment_key;
    v_item.component_key:=v_member.component_key;v_item.member_kind:=case when v_member.segment_key is null then 'WORK_COMPONENT' else 'WORK_SEGMENT' end;
    v_item.member_key:=coalesce(v_member.segment_key,v_member.component_key);v_item.client_id:=v_client;v_item.contract_id:=v_work.contract_id;
    v_item.physical_timesheet_id:=v_revision.physical_timesheet_id;v_item.work_date:=v_member.work_date;
    v_item.week_ending_date:=v_work.week_ending_date;v_item.candidate_display_name:=v_metadata.candidate_sort_name;
    v_item.candidate_reference:=v_metadata.tms_ref;v_item.client_display_name:=v_revision.client_display_name;
    v_item.timesheet_reference:=v_revision.timesheet_reference;v_item.component_kind:=v_member.component_kind;
    v_item.tax_treatment:=v_member.tax_treatment;v_item.source_pay_channel:=v_member.source_pay_channel;v_item.target_pay_channel:=v_target;
    v_item.direction:='PAYMENT';v_item.payroll_stage:='GROSS_ADD';v_item.approved_quantity:=v_member.approved_quantity;v_item.unit_label:=v_member.unit_label;
    v_item.amount_known:=coalesce(v_complete,false) and v_member.parent_complete and v_member.segment_attribution_complete;
    v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.query_qualified:=false;v_item.query_state:='NOT_APPLICABLE';
    v_item.financial_view_revision:=v_financial;v_item.projection_revision:=v_projection;v_item.metadata_version:=v_metadata.metadata_version;
    v_item.progress_state:=case when v_complete then 'CURRENT' else 'PROCESSING' end;v_item.updated_at_utc:=transaction_timestamp();
    v_reason:='READY';v_priority:=200;v_section:='READY';
    if v_revision.id is null or v_target is null or v_work.week_ending_date is null
      or v_native_period->'valid' is distinct from 'true'::jsonb then v_reason:='DATA_UNAVAILABLE';v_priority:=10;v_section:='BLOCKED';
    elsif v_work.approval_state<>'APPROVED' then v_reason:='MISSING_APPROVAL';v_priority:=21;v_section:='BLOCKED';
    elsif not v_complete then v_reason:='APPLY_PENDING';v_priority:=30;v_section:='BLOCKED';
    elsif not v_member.parent_complete then v_reason:='DATA_UNAVAILABLE';v_priority:=10;v_section:='BLOCKED';
    elsif not v_member.segment_attribution_complete then v_reason:='SEGMENT_CREDIT_ATTRIBUTION_UNAVAILABLE';v_priority:=12;v_section:='BLOCKED';end if;
    if v_item.amount_known then
      v_positive:=greatest(v_member.approved_amount-v_member.realised_amount-v_member.held_amount,0);
      v_recovery:=greatest(v_member.realised_amount-v_member.approved_amount,0);
      v_overhang:=greatest(v_member.held_amount-greatest(v_member.approved_amount-v_member.realised_amount,0),0);
      v_item.nominal_source_ex_vat:=v_positive;v_item.approved_source_ex_vat:=v_member.approved_amount;
      v_item.realised_source_ex_vat:=v_member.realised_amount;v_item.active_reserved_source_ex_vat:=0;
      v_item.written_off_source_ex_vat:=0;
      v_item.residual_source_ex_vat:=v_member.approved_amount-v_member.realised_amount-v_member.held_amount;
      v_item.gross_due_source_ex_vat:=v_positive;v_item.included_source_ex_vat:=v_positive;v_item.excluded_source_ex_vat:=0;
      v_item.recovery_source_ex_vat:=v_recovery;v_item.held_overhang_source_ex_vat:=v_overhang;
    else v_positive:=null;v_recovery:=null;v_overhang:=null;end if;
    select a.run_id,a.command_id,a.module_epoch,a.selected_source_ex_vat into v_accepted from private.bpay_next_workbench_accepted_work_v1(v_work.id,v_member.component_key,v_member.segment_key) a;
    if found then
      v_item.is_selected:=true;v_item.accepted_run_id:=v_accepted.run_id;v_item.accepted_command_id:=v_accepted.command_id;
      v_item.accepted_module_epoch:=v_accepted.module_epoch;v_item.selected_source_ex_vat:=v_accepted.selected_source_ex_vat;
      v_item.selected_amount_known:=v_accepted.selected_source_ex_vat is not null;
      if v_priority>50 then v_reason:='IN_PREPARATION';v_priority:=50;v_section:='WAITING';end if;
    end if;
    v_snooze:=private.bpay_next_snooze_at_cut_v1(v_work.id,v_revision.id,v_member.segment_key,v_member.component_key,v_sequence,v_today);
    if v_snooze is not null then
      v_item.snooze_id:=(v_snooze->>'id')::uuid;v_item.snooze_version:=(v_snooze->>'version')::bigint;
      v_item.snooze_scope:=v_snooze->>'scope_kind';v_item.snooze_until_date:=(v_snooze->>'until_date')::date;
      if v_positive>0 then v_item.excluded_source_ex_vat:=v_positive;v_item.included_source_ex_vat:=0;end if;
    elsif exists(select 1 from private.bpay_next_snooze s where s.work_id=v_work.id and s.active
      and (s.until_date is null or s.until_date>=v_today) and ((s.scope_kind='SEGMENT' and s.segment_key=v_member.segment_key)
        or s.scope_kind='WHOLE_TIMESHEET' or (s.scope_kind='EXPENSE_LINE' and s.component_key=v_member.component_key)
        or (s.scope_kind='EXPENSES_ALL' and v_member.component_kind in ('EXPENSE','MILEAGE')))) then
      v_item.stale_snooze_code:=case when v_member.segment_key is not null and v_member.approved_segment_id is null
        then 'SNOOZE_SEGMENT_STALE' else 'SNOOZE_BASIS_STALE' end;
    end if;
    if v_priority>100 and v_work.week_ending_date-6>v_today then
      v_reason:='FUTURE_WEEK';v_priority:=100;v_section:='WAITING';v_item.eligible_from_date:=v_work.week_ending_date-6;
    elsif v_priority>110 and v_snooze is not null and v_positive>0 then v_reason:='SNOOZED';v_priority:=110;v_section:='WAITING';end if;
    v_item.query_qualified:=coalesce(v_work.work_kind='SOURCE' and v_revision.source_kind in ('SOURCE','PROTECTED')
      and v_member.component_kind in ('WORK','PROTECTED_WORK') and v_source_event is not null
      and v_revision.physical_timesheet_id is not null and v_item.amount_known and v_item.included_source_ex_vat>0,false);
    if v_item.query_qualified then v_item.query_state:='UNAVAILABLE';end if;
    v_item.section:=v_section;v_item.reason_code:=v_reason;v_item.reason_priority:=v_priority;
    v_item.pay_hold:=coalesce(v_pay_hold.pay_on_hold,false);v_item.pay_hold_reason:=v_pay_hold.pay_on_hold_reason;
    v_item.selectable:=v_section='READY' and v_item.amount_known;v_base:=v_item;
    if not v_item.amount_known or v_positive>0 or (v_member.approved_amount=0 and v_member.realised_amount=0
      and v_member.held_amount=0 and v_revision.certified_zero and v_member.approved_line_id is not null) then
      v_item.portion_kind:=case when not v_item.amount_known then 'EVIDENCE' when v_positive=0 then 'ZERO' else 'AVAILABLE' end;
      -- WB40: only a new positive offer is blocked. The saved v_base keeps
      -- native H/R and accepted Draft selection untouched (owner E1/E3).
      if not v_item.is_selected and not v_hold_canonical and v_item.reason_priority>15 then
        v_item.reason_code:='DATA_UNAVAILABLE';v_item.reason_priority:=15;v_item.section:='BLOCKED';
      elsif not v_item.is_selected and v_item.pay_hold and v_item.reason_priority>40 then
        v_item.reason_code:='PAY_ON_HOLD';v_item.reason_priority:=40;v_item.section:='BLOCKED';
      end if;
      v_item.selectable:=v_item.section='READY' and v_item.amount_known;
      -- WB-07: query classification belongs only to this new positive portion.
      -- The original pre-query v_base/v_priority remain unchanged for H/R.
      if v_item.query_qualified and v_item.portion_kind='AVAILABLE' then
        if not v_query_loaded then
          v_query_gate:=null;v_query_state:='UNAVAILABLE';
          begin
            v_query_gate:=private.weekly_source_pay_query_gate_v1(v_revision.physical_timesheet_id);
          exception when others then
            v_query_gate:=null;
          end;
          v_query_loaded:=true;
          -- Guard object types separately: malformed scalar replies cannot
          -- reach the object-minus-keys operators or escape the unavailable path.
          if jsonb_typeof(v_query_gate)='object' then
            if (v_query_gate ?& array['ok','code','scope','blocked','query_state_sha256']
                and v_query_gate-array['ok','code','scope','blocked','query_state_sha256']='{}'::jsonb
                and v_query_gate->'ok'='true'::jsonb and v_query_gate->>'code'='OK'
                and jsonb_typeof(v_query_gate->'code')='string'
                and jsonb_typeof(v_query_gate->'blocked')='boolean'
                and jsonb_typeof(v_query_gate->'query_state_sha256')='string'
                and v_query_gate->>'query_state_sha256' ~ '^[0-9a-f]{64}$') is true then
              v_query_scope:=v_query_gate->'scope';
              if jsonb_typeof(v_query_scope)='object' then
                if (v_query_scope ?& array['root_timesheet_id','family_booking_id','target_family_id',
                    'candidate_id','client_id','contract_id','week_ending_date','root_version','family_bound_version']
                    and v_query_scope-array['root_timesheet_id','family_booking_id','target_family_id',
                      'candidate_id','client_id','contract_id','week_ending_date','root_version','family_bound_version']='{}'::jsonb
                    and v_query_scope->'root_timesheet_id'=to_jsonb(v_revision.physical_timesheet_id::text)
                    and v_query_scope->'family_booking_id'=to_jsonb(v_work.booking_id)
                    and v_query_scope->'candidate_id'=to_jsonb(v_work.candidate_id::text)
                    and v_query_scope->'client_id'=to_jsonb(v_client::text)
                    and v_query_scope->'contract_id'=to_jsonb(v_work.contract_id::text)
                    and v_query_scope->'week_ending_date'=to_jsonb(v_work.week_ending_date::text)
                    and v_query_scope->'root_version'=to_jsonb(v_revision.physical_timesheet_version::text)
                    and ((v_query_scope->'target_family_id'='null'::jsonb
                        and v_query_scope->'family_bound_version'='null'::jsonb)
                      or (jsonb_typeof(v_query_scope->'target_family_id')='string'
                        and v_query_scope->>'target_family_id' ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
                        and jsonb_typeof(v_query_scope->'family_bound_version')='string'
                        and v_query_scope->>'family_bound_version' ~ '^[1-9][0-9]{0,18}$'
                        and (char_length(v_query_scope->>'family_bound_version')<19
                          or (v_query_scope->>'family_bound_version') collate "C"<='9223372036854775807' collate "C")))) is true then
                  v_query_state:=case when v_query_gate->'blocked'='true'::jsonb then 'OPEN' else 'CLEAR' end;
                  v_query_exclusions:=private.bpay_next_source_query_segment_exclusions_v1(v_revision.id,v_query_gate);
                end if;
              end if;
            end if;
          end if;
        end if;
        v_segment_query_state:=v_query_state;
        if v_query_state='OPEN' and v_query_exclusions is not null and v_member.segment_key is not null then
          v_segment_query_state:=case when exists(select 1 from jsonb_array_elements(v_query_exclusions) reason(value)
            where reason.value->>'segment_key'=v_member.segment_key) then 'OPEN' else 'CLEAR' end;
        end if;
        v_item.query_state:=v_segment_query_state;
        if v_segment_query_state='UNAVAILABLE' and v_item.reason_priority>60 then
          v_item.reason_code:='PAY_QUERY_UNAVAILABLE';v_item.reason_priority:=60;v_item.section:='BLOCKED';
        elsif v_segment_query_state='OPEN' and v_item.reason_priority>61 then
          v_item.reason_code:='PAY_QUERY_OPEN';v_item.reason_priority:=61;v_item.section:='ACTION';
        end if;
        v_item.selectable:=v_item.section='READY' and v_item.amount_known;
      end if;
      -- A future positive portion only. Numeric priorities alone cannot
      -- supersede Future/Snoozed WAITING or any accepted/reserved history.
      if not v_item.is_selected and v_item.portion_kind='AVAILABLE' then
        if v_item.tax_treatment='TAXABLE' and v_item.component_kind in ('WORK','PROTECTED_WORK','ADDITIONAL','ADJUSTMENT')
          and v_item.source_pay_channel in ('PAYE','UMBRELLA') and v_target in ('PAYE','UMBRELLA')
          and v_item.source_pay_channel<>v_target then
          v_item.channel_note_code:='CHANNEL_RESOLVER';
        end if;
        if v_item.section='READY' and v_item.amount_known and v_item.included_source_ex_vat>0
          and v_item.tax_treatment='TAXABLE' and v_need_operation is not null then
          v_resolution_need:=private.bpay_next_component_resolution_need_v1(v_work.id,v_revision.id,
            v_member.approved_line_id,v_member.approved_segment_id,v_target,v_target_umbrella,v_target_vat,v_resolution_date);
          if v_resolution_need is not null then
            v_item.reason_code:=v_resolution_need->>'reason_code';v_item.reason_priority:=75;
            v_item.channel_note_code:='CHANNEL_RESOLUTION_REQUIRED';v_item.section:='ACTION';v_item.selectable:=false;
          end if;
        end if;
      end if;
      insert into private.bpay_next_workbench_item select (v_item).*;
    elsif v_recovery>0 then
      v_item.portion_kind:='RECOVERY';v_item.direction:='INFORMATIONAL';v_item.selectable:=false;
      select b.* into v_manual from private.bpay_next_work_collection b where b.work_id=v_work.id
        and b.component_key=v_member.component_key and b.collection_mode='MANUAL'
        and b.observed_revision_id=v_revision.id;
      if v_manual.id is not null then
        v_item.section:='ACTION';v_item.reason_priority:=81;
        -- This informational liability never borrows a frozen accepted offer.
        v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.selected_source_ex_vat:=null;
        v_item.accepted_run_id:=null;v_item.accepted_command_id:=null;v_item.accepted_module_epoch:=null;
        v_item.reason_code:=case when v_manual.case_id is not null then 'MANUAL_COLLECTION_REFERENCE'
          when v_manual.manual_outstanding_source_ex_vat is null then 'MANUAL_COLLECTION_UNAVAILABLE' else 'MANUAL_COLLECTION' end;
        v_item.nominal_source_ex_vat:=case when v_manual.case_id is not null then 0 else v_recovery end;
        if v_item.component_kind is null then
          select line.* into strict v_original_line from private.bpay_next_approved_line line where line.id=v_manual.original_approved_line_id;
          v_item.component_kind:=v_original_line.component_kind;v_item.tax_treatment:=v_original_line.tax_treatment;
        end if;
        v_item.payroll_stage:=case v_item.tax_treatment when 'TAXABLE' then 'GROSS_DEDUCT' when 'NON_TAXABLE' then 'NET_DEDUCT' else null end;
      elsif v_priority>83 then v_item.reason_code:='RECOVERY_MANAGED';v_item.reason_priority:=83;v_item.section:='ACTION';end if;
      insert into private.bpay_next_workbench_item select (v_item).*;
    end if;
    if v_item.amount_known and v_member.held_amount>0 then
      v_item:=v_base;v_item.id:=gen_random_uuid();v_item.portion_kind:='RESERVED';v_item.selectable:=false;
      v_item.active_reserved_source_ex_vat:=v_member.held_amount;v_item.nominal_source_ex_vat:=v_member.held_amount;
      v_item.gross_due_source_ex_vat:=0;v_item.included_source_ex_vat:=0;v_item.excluded_source_ex_vat:=0;
      v_item.recovery_source_ex_vat:=0;v_item.query_qualified:=false;v_item.query_state:='NOT_APPLICABLE';
      if v_positive>0 or v_recovery>0 then
        v_item.approved_source_ex_vat:=0;v_item.realised_source_ex_vat:=0;v_item.residual_source_ex_vat:=0;v_item.held_overhang_source_ex_vat:=0;
        v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.selected_source_ex_vat:=null;
      end if;
      if v_priority>111 then v_item.reason_code:='RESERVED';v_item.reason_priority:=111;v_item.section:='WAITING';end if;
      insert into private.bpay_next_workbench_item select (v_item).*;
    end if;
    if v_base.amount_known and (v_positive>0 or v_recovery>0 or v_member.held_amount>0
      or (v_member.approved_amount=0 and v_member.realised_amount=0 and v_revision.certified_zero and v_member.approved_line_id is not null)) then
      select sum(i.approved_source_ex_vat) a,sum(i.realised_source_ex_vat) c,sum(i.active_reserved_source_ex_vat) h,
        sum(i.residual_source_ex_vat) residual,
        sum(i.included_source_ex_vat+i.excluded_source_ex_vat-i.recovery_source_ex_vat-i.held_overhang_source_ex_vat) split_residual
        into v_totals from private.bpay_next_workbench_item i where i.group_key=v_group
          and i.component_key=v_member.component_key and i.member_kind=v_base.member_kind and i.member_key=v_base.member_key;
      if (v_totals.a,v_totals.c,v_totals.h,v_totals.residual,v_totals.split_residual)
        is distinct from (v_member.approved_amount,v_member.realised_amount,v_member.held_amount,
          v_member.approved_amount-v_member.realised_amount-v_member.held_amount,
          v_member.approved_amount-v_member.realised_amount-v_member.held_amount) then
        raise exception using errcode='23514',message='BPAY_NEXT_WORKBENCH_NATIVE_MEMBER_NOT_CONSERVED';end if;
    end if;
  end loop;
  end if;
  -- A known retained manual liability is independent of unavailable positive
  -- Source classification. Keep that Evidence; never certify a new offer.
  update private.bpay_next_workbench_item i set reason_code='MANUAL_COLLECTION_UNAVAILABLE'
    from private.bpay_next_work_collection b where i.group_key=v_group and i.work_id=b.work_id
      and i.component_key=b.component_key and i.portion_kind='EVIDENCE' and not i.amount_known
      and not i.is_selected and b.collection_mode='MANUAL' and b.case_id is null
      and b.observed_revision_id=v_revision.id and b.manual_outstanding_source_ex_vat is null;
  if v_work.approval_state='APPROVED' and v_work.current_revision_id=v_work.applied_revision_id then
    for v_manual in select b.* from private.bpay_next_work_collection b where b.work_id=v_work.id
      and b.collection_mode='MANUAL' and b.case_id is null and b.observed_revision_id=v_revision.id
      and b.manual_outstanding_source_ex_vat>0 and not exists(select 1 from private.bpay_next_workbench_item i
        where i.group_key=v_group and i.component_key=b.component_key and i.amount_known) order by b.component_key loop
      v_manual_observation:=private.bpay_next_work_collection_observation_v1(v_work.id,v_manual.component_key,v_revision.id);
      if not coalesce((v_manual_observation->>'complete')::boolean,false) then continue;end if;
      select pos.* into strict v_manual_position from private.bpay_next_position pos where pos.work_id=v_work.id and pos.component_key=v_manual.component_key;
      select line.* into strict v_original_line from private.bpay_next_approved_line line where line.id=v_manual.original_approved_line_id;
      v_count:=v_count+1;v_item:=null;v_item.id:=gen_random_uuid();v_item.group_key:=v_group;v_item.candidate_id:=v_candidate;
      v_item.work_id:=v_work.id;v_item.revision_id:=v_revision.id;v_item.component_key:=v_manual.component_key;
      v_item.member_kind:='WORK_COMPONENT';v_item.member_key:=v_manual.component_key;v_item.portion_kind:='RECOVERY';
      v_item.direction:='INFORMATIONAL';v_item.payroll_stage:=case v_original_line.tax_treatment when 'TAXABLE' then 'GROSS_DEDUCT' when 'NON_TAXABLE' then 'NET_DEDUCT' else null end;
      v_item.client_id:=v_client;v_item.contract_id:=v_work.contract_id;v_item.physical_timesheet_id:=v_revision.physical_timesheet_id;
      v_item.week_ending_date:=v_work.week_ending_date;v_item.work_date:=v_original_line.work_date;
      v_item.candidate_display_name:=v_metadata.candidate_sort_name;v_item.candidate_reference:=v_metadata.tms_ref;
      v_item.client_display_name:=v_revision.client_display_name;v_item.timesheet_reference:=v_revision.timesheet_reference;
      v_item.component_kind:=v_original_line.component_kind;v_item.tax_treatment:=v_original_line.tax_treatment;
      v_item.source_pay_channel:=v_manual.original_source_pay_channel;v_item.target_pay_channel:=v_target;
      v_item.amount_known:=true;v_item.nominal_source_ex_vat:=v_manual.manual_outstanding_source_ex_vat;
      v_item.approved_source_ex_vat:=v_manual_position.approved_source_ex_vat;v_item.realised_source_ex_vat:=v_manual_position.realised_source_ex_vat;
      v_item.active_reserved_source_ex_vat:=v_manual_position.held_source_ex_vat;
      v_item.residual_source_ex_vat:=v_manual_position.approved_source_ex_vat-v_manual_position.realised_source_ex_vat-v_manual_position.held_source_ex_vat;
      v_item.gross_due_source_ex_vat:=(v_manual_observation->>'positive_source_ex_vat')::numeric;
      v_item.included_source_ex_vat:=0;v_item.excluded_source_ex_vat:=v_item.gross_due_source_ex_vat;
      v_item.recovery_source_ex_vat:=(v_manual_observation->>'negative_source_ex_vat')::numeric;
      v_item.held_overhang_source_ex_vat:=(v_manual_observation->>'held_overhang_source_ex_vat')::numeric;v_item.written_off_source_ex_vat:=0;
      v_item.section:='ACTION';v_item.reason_code:='MANUAL_COLLECTION';v_item.reason_priority:=81;v_item.selectable:=false;
      v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.query_qualified:=false;v_item.query_state:='NOT_APPLICABLE';
      v_item.financial_view_revision:=v_financial;v_item.projection_revision:=v_projection;v_item.metadata_version:=v_metadata.metadata_version;
      v_item.progress_state:='CURRENT';v_item.updated_at_utc:=transaction_timestamp();
      if v_item.included_source_ex_vat+v_item.excluded_source_ex_vat-v_item.recovery_source_ex_vat-v_item.held_overhang_source_ex_vat
        is distinct from v_item.residual_source_ex_vat then raise exception using errcode='23514',message='BPAY_NEXT_COLLECTION_MANUAL_DISPLAY_NOT_CONSERVED';end if;
      insert into private.bpay_next_workbench_item select (v_item).*;
    end loop;
  end if;
  if v_count=0 then
    v_item:=null;v_item.id:=gen_random_uuid();v_item.group_key:=v_group;v_item.candidate_id:=v_candidate;v_item.work_id:=v_work.id;
    v_item.revision_id:=v_revision.id;v_item.member_kind:='GROUP_EVIDENCE';v_item.member_key:=v_work.id::text;v_item.component_key:='';v_item.portion_kind:='EVIDENCE';
    v_item.client_id:=v_client;v_item.contract_id:=v_work.contract_id;v_item.physical_timesheet_id:=v_revision.physical_timesheet_id;
    v_item.week_ending_date:=v_work.week_ending_date;v_item.candidate_display_name:=v_metadata.candidate_sort_name;v_item.candidate_reference:=v_metadata.tms_ref;
    v_item.direction:='INFORMATIONAL';v_item.amount_known:=false;v_item.selected_amount_known:=false;v_item.is_selected:=false;v_item.selectable:=false;
    v_item.section:='BLOCKED';v_item.reason_code:=case when v_work.approval_state<>'APPROVED' then 'MISSING_APPROVAL' else 'DATA_UNAVAILABLE' end;
    if v_work.approval_state='WITHDRAWN' then
      v_item.reason_code:=case when v_wait_after then 'AWAITING_REAUTHORISATION' else 'APPROVAL_WITHDRAWN' end;
      v_item.section:=case when v_wait_after then 'ACTION' else 'BLOCKED' end;
    end if;
    v_item.reason_priority:=case when v_work.approval_state='WITHDRAWN' then case when v_wait_after then 70 else 20 end
      when v_work.approval_state<>'APPROVED' then 21 else 10 end;v_item.query_state:='NOT_APPLICABLE';v_item.query_qualified:=false;
    v_item.financial_view_revision:=v_financial;v_item.projection_revision:=v_projection;v_item.metadata_version:=v_metadata.metadata_version;
    v_item.progress_state:=case when v_work.approval_state='WITHDRAWN' and v_work.applied_revision_id is not null
      and not v_withdrawn_complete then 'PROCESSING' else 'UNAVAILABLE' end;
    v_item.updated_at_utc:=transaction_timestamp();v_item.target_pay_channel:=v_target;
    v_zero:=coalesce(v_complete,false) and v_revision.certified_zero and v_revision.approved_source_ex_vat=0
      and v_revision.expected_line_count=0 and v_target is not null and v_work.week_ending_date is not null
      and v_native_period->'valid'='true'::jsonb
      and not exists(select 1 from private.bpay_next_position p where p.work_id=v_work.id);
    if v_zero then
      v_item.section:='READY';v_item.reason_code:='CERTIFIED_ZERO';v_item.reason_priority:=200;v_item.progress_state:='CURRENT';
      if v_work.week_ending_date-6>v_today then
        v_item.section:='WAITING';v_item.reason_code:='FUTURE_WEEK';v_item.reason_priority:=100;v_item.eligible_from_date:=v_work.week_ending_date-6;
      end if;
    end if;
    insert into private.bpay_next_workbench_item select (v_item).*;
  end if;
  update private.bpay_next_workbench_group g set ready_count=x.ready,action_count=x.action,blocked_count=x.blocked,waiting_count=x.waiting,
    complete=g.complete and x.unknown=0,certified_zero=coalesce(v_complete,false) and coalesce(v_revision.certified_zero,false)
    from(select count(*) filter(where section='READY') ready,count(*) filter(where section='ACTION') action,
      count(*) filter(where section='BLOCKED') blocked,count(*) filter(where section='WAITING') waiting,
      count(*) filter(where not amount_known and not (member_kind='GROUP_EVIDENCE' and coalesce(v_zero,false))) unknown
      from private.bpay_next_workbench_item where group_key=v_group) x where g.group_key=v_group;
  update private.bpay_next_workbench_group g set stale_snooze_count=x.n,
    stale_snooze_code=case when x.n>0 then 'SNOOZE_SEGMENT_STALE' end
    from(select count(*) n from private.bpay_next_snooze s where s.work_id=v_work.id and s.scope_kind='SEGMENT'
      and s.active and (s.until_date is null or s.until_date>=v_today) and not exists(select 1
        from private.bpay_next_approved_segment a where a.revision_id=v_revision.id and a.segment_key=s.segment_key)) x
    where g.group_key=v_group;
  select array_agg(d) into v_after from private.bpay_next_workbench_group_contribution_v1(v_group) d;
  perform private.bpay_next_workbench_apply_delta_v1(v_before,v_after);
  perform private.bpay_next_workbench_refresh_group_display_v1(v_group);
end
$function$;

create or replace function private.bpay_next_append_work_skip_v1(p_run_id uuid,p_work_id uuid,p_revision_id uuid)
returns text language plpgsql security invoker set search_path=pg_catalog,private,public
as $function$
declare v_run private.bpay_next_pay_run%rowtype;v_work private.bpay_next_work%rowtype;
 v_revision private.bpay_next_work_revision%rowtype;v_gate jsonb;v_skip text;
begin
 select src.* into strict v_run from private.bpay_next_pay_run src where id=p_run_id;
 -- Accepted acknowledgements use the original per-Work skip, including a
 -- held Work with no work_choice. Never read newer hold to amend that offer.
 if v_run.accepted_choice_descriptor is not null then
  select skip_code into v_skip from private.bpay_next_run_choice_member
   where run_id=p_run_id and work_id=p_work_id and member_kind='WORK';
  if found then return v_skip;end if;
  if exists(select 1 from private.bpay_next_work_choice where run_id=p_run_id and work_id=p_work_id
    and expected_revision_id=p_revision_id) then return null;end if;
  raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_DESCRIPTOR_MISSING';
 end if;
 select src.* into strict v_work from private.bpay_next_work src where id=p_work_id for share;
 if p_revision_id is not null and not exists(select 1 from private.bpay_next_work_revision
   where work_id=p_work_id and id=p_revision_id) then
  raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_REVISION_CONFLICT';end if;
 select src.* into v_revision from private.bpay_next_work_revision src
   where work_id=p_work_id and id=p_revision_id;
 if v_work.approval_state is distinct from 'APPROVED' or v_revision.approved_at_utc is null
   or v_revision.sealed_at_utc is null then return 'BPAY_NEXT_SELECTION_WORK_NOT_APPROVED';end if;
 if v_work.current_revision_id is distinct from p_revision_id or v_work.applied_revision_id is distinct from p_revision_id then
  return 'BPAY_NEXT_SELECTION_REVISION_NOT_CURRENT';end if;
 if private.bpay_next_work_period_proof_v1(v_work.id,p_revision_id,v_run.snooze_business_date)->'valid' is distinct from 'true'::jsonb then
  return 'BPAY_NEXT_SELECTION_REVISION_NOT_CURRENT';end if;
 if v_work.week_ending_date-6>v_run.snooze_business_date then
  return 'BPAY_NEXT_WORK_WEEK_NOT_YET_PAYABLE';end if;
 if not exists(select 1 from public.timesheets t join public.timesheets_financials tf
   on tf.timesheet_id=t.timesheet_id and tf.is_current
   where t.booking_id=v_work.booking_id and t.is_current) then
  return 'BPAY_NEXT_SELECTION_REVISION_NOT_CURRENT';end if;
 if exists(select 1 from public.timesheets t join public.timesheets_financials tf
   on tf.timesheet_id=t.timesheet_id and tf.is_current=true
   where t.booking_id=v_work.booking_id and t.is_current=true and tf.pay_on_hold is true) then
  return 'BPAY_NEXT_SELECTION_ON_HOLD';end if;
 if not exists(select 1 from private.bpay_next_revision_worker_basis where revision_id=p_revision_id) then
  raise exception using errcode='55000',message='BPAY_NEXT_SELECTION_BASIS_UNAVAILABLE';end if;
 if exists(select 1 from private.bpay_next_snooze sn
   join lateral(select ev.after_state from private.bpay_next_snooze_event ev
     where ev.snooze_id=sn.id and ev.control_sequence<=v_run.snooze_control_sequence
     order by ev.control_sequence desc limit 1) e on true
   join private.bpay_next_revision_worker_basis b on b.revision_id=p_revision_id
   where sn.work_id=p_work_id and sn.scope_kind='WHOLE_TIMESHEET' and (e.after_state->>'active')::boolean
     and ((e.after_state->>'until_date') is null or (e.after_state->>'until_date')::date>=v_run.snooze_business_date)
     and (e.after_state->>'worker_pay_basis')::bytea=b.whole_basis) then
  return 'BPAY_NEXT_SELECTION_SNOOZED';end if;
 if v_revision.source_kind in ('SOURCE','PROTECTED') then
  begin
   perform private.weekly_source_pay_query_admit_v2();
   v_gate:=private.weekly_source_pay_query_gate_v1(v_revision.physical_timesheet_id);
   if v_gate->'ok' is distinct from 'true'::jsonb or v_gate->>'code' is distinct from 'OK'
     or jsonb_typeof(v_gate->'blocked') is distinct from 'boolean' then
    return 'SOURCE_PAY_QUERY_EVIDENCE_UNAVAILABLE';end if;
   if v_gate->'blocked'='true'::jsonb and
     private.bpay_next_source_query_segment_exclusions_v1(p_revision_id,v_gate) is null then return 'SOURCE_PAY_QUERY_OPEN';end if;
  exception when others then return 'SOURCE_PAY_QUERY_EVIDENCE_UNAVAILABLE';end;
 end if;
 return null;
end
$function$;

create or replace function private.bpay_next_create_preparation_v1(
 p_run_id uuid,p_actor_user_id uuid,p_pay_date date,p_descriptor jsonb,p_command_id uuid,p_guard jsonb
) returns jsonb language plpgsql security definer
set search_path=pg_catalog,private,public
as $function$
declare
 v_run private.bpay_next_pay_run%rowtype;v_result jsonb;v_ns jsonb;v_intent jsonb;
 v_row jsonb;v_array text;v_keys text[];v_field text;v_id uuid;v_header jsonb;
 v_query_admitted boolean:=true;v_policy text:='NONE';v_channel text:='ALL';
 v_reason text;v_proof uuid;v_guard jsonb;v_scope jsonb;v_policy_args jsonb;
 v_locked_candidates uuid[];v_locked_works uuid[];v_locked_revisions uuid[];v_locked_cases uuid[];
 v_candidate uuid;v_work uuid;v_revision uuid;v_sequence bigint;v_gate jsonb;v_query_exclusions jsonb;v_member record;
 v_memory boolean:=p_descriptor ? 'memory_baseline_run_id';v_baseline uuid;v_page_no bigint;v_lines uuid[];v_subset record;
 v_mode text;v_selected boolean;v_count bigint;v_code text;v_week_start date;v_work_count bigint:=0;
begin
 if p_guard is not null then
  if jsonb_typeof(p_guard) is distinct from 'object' or not(p_guard ?& array['decision','reason','reauth_proof_id'])
   or p_guard-array['decision','reason','reauth_proof_id']<>'{}'::jsonb
   or jsonb_typeof(p_guard->'decision') is distinct from 'string'
   or p_guard->>'decision' not in ('UMBRELLA_ONLY','VERIFY_BOTH','VERIFY_PAYE') then
   raise exception using errcode='22023',message='BPAY_NEXT_PREPARATION_REQUEST_INVALID';end if;
  v_policy:=p_guard->>'decision';v_channel:=case v_policy when 'UMBRELLA_ONLY' then 'UMBRELLA' when 'VERIFY_PAYE' then 'PAYE' else 'ALL' end;
  if v_policy='UMBRELLA_ONLY' then
   if p_guard->'reason'<>'null'::jsonb or p_guard->'reauth_proof_id'<>'null'::jsonb then
    raise exception using errcode='22023',message='BPAY_NEXT_PREPARATION_REQUEST_INVALID';end if;
  else
   if jsonb_typeof(p_guard->'reason') is distinct from 'string' or btrim(p_guard->>'reason')=''
    or octet_length(p_guard->>'reason') not between 1 and 500
    or jsonb_typeof(p_guard->'reauth_proof_id') is distinct from 'string'
    or p_guard->>'reauth_proof_id'!~'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' then
    raise exception using errcode='22023',message='BPAY_NEXT_REAUTH_REQUEST_INVALID';end if;
   v_reason:=p_guard->>'reason';v_proof:=(p_guard->>'reauth_proof_id')::uuid;
  end if;
 end if;
 if p_command_id is null or jsonb_typeof(p_descriptor) is distinct from 'object'
   or octet_length(p_descriptor::text)>32768
   or not(p_descriptor ?& array['namespace','intent','revision','workbench_revision','adoption_revision'])
   or p_descriptor-array['namespace','intent','revision','workbench_revision','adoption_revision','memory_baseline_run_id']<>'{}'::jsonb then
  raise exception using errcode='22023',message='BPAY_NEXT_CHOICE_DESCRIPTOR_INVALID';
 end if;
 if v_memory and p_descriptor->'memory_baseline_run_id'<>'null'::jsonb and
  (jsonb_typeof(p_descriptor->'memory_baseline_run_id')<>'string' or p_descriptor->>'memory_baseline_run_id'!~'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$') then
  raise exception using errcode='22023',message='BPAY_NEXT_CHOICE_DESCRIPTOR_INVALID';end if;
 v_ns:=p_descriptor->'namespace';v_intent:=p_descriptor->'intent';
 if jsonb_typeof(v_ns) is distinct from 'object'
   or not(v_ns ?& array['agency_id','owner_epoch','actor_user_id','official_pay_date','scope'])
   or v_ns-array['agency_id','owner_epoch','actor_user_id','official_pay_date','scope']<>'{}'::jsonb
   or jsonb_typeof(v_ns->'scope') is distinct from 'object'
   or not(v_ns->'scope' ?& array['candidate_id','client_id','channel'])
   or (v_ns->'scope')-array['candidate_id','client_id','channel']<>'{}'::jsonb
   or jsonb_typeof(v_intent) is distinct from 'object'
   or not(v_intent ?& array['mode','candidates','works','components','cases'])
   or v_intent-array['mode','candidates','works','components','cases']<>'{}'::jsonb
   or jsonb_typeof(v_intent->'mode') is distinct from 'string'
   or v_intent->>'mode' not in ('ALL_MATCHING','NONE') then
  raise exception using errcode='22023',message='BPAY_NEXT_CHOICE_DESCRIPTOR_INVALID';
 end if;
 foreach v_array in array array['candidates','works','components','cases'] loop
  if jsonb_typeof(v_intent->v_array) is distinct from 'array'
    or jsonb_array_length(v_intent->v_array)>1000 then
   raise exception using errcode='22023',message='BPAY_NEXT_CHOICE_DESCRIPTOR_INVALID';end if;
  v_keys:=case v_array when 'candidates' then array['candidate_id','selected']
    when 'works' then array['candidate_id','work_id','expected_revision_id','selected','mode']
    when 'components' then array['candidate_id','work_id','expected_revision_id','approved_line_id','selected']
    else array['candidate_id','case_component_id','selected'] end;
  for v_row in select value from jsonb_array_elements(v_intent->v_array) loop
   if jsonb_typeof(v_row) is distinct from 'object' or not(v_row ?& v_keys)
     or v_row-v_keys<>'{}'::jsonb or jsonb_typeof(v_row->'selected') is distinct from 'boolean' then
    raise exception using errcode='22023',message='BPAY_NEXT_CHOICE_DESCRIPTOR_INVALID';end if;
   foreach v_field in array v_keys loop
    if v_field in ('selected','mode') then continue;end if;
    if jsonb_typeof(v_row->v_field) is distinct from 'string'
      or v_row->>v_field!~'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' then
     raise exception using errcode='22023',message='BPAY_NEXT_CHOICE_DESCRIPTOR_INVALID';end if;
   end loop;
   if v_array='works' and (jsonb_typeof(v_row->'mode') is distinct from 'string'
      or v_row->>'mode' not in ('ALL','SUBSET')) then
    raise exception using errcode='22023',message='BPAY_NEXT_CHOICE_DESCRIPTOR_INVALID';end if;
  end loop;
  if exists(select 1 from jsonb_array_elements(v_intent->v_array) a(value)
    group by case v_array when 'candidates' then a.value->>'candidate_id'
      when 'works' then a.value->>'work_id' when 'components' then a.value->>'approved_line_id'
      else a.value->>'case_component_id' end having count(*)>1) then
   raise exception using errcode='22023',message='BPAY_NEXT_CHOICE_DESCRIPTOR_INVALID';end if;
 end loop;
 if jsonb_typeof(v_ns->'agency_id') is distinct from 'string'
   or v_ns->>'agency_id'!~'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'
   or jsonb_typeof(v_ns->'actor_user_id') is distinct from 'string'
   or v_ns->>'actor_user_id'!~'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'
   or jsonb_typeof(v_ns->'owner_epoch') is distinct from 'string'
   or v_ns->>'owner_epoch'!~'^[1-9][0-9]{0,18}$'
   or jsonb_typeof(v_ns->'official_pay_date') is distinct from 'string'
   or v_ns->>'official_pay_date'!~'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
   or jsonb_typeof(v_ns->'scope'->'channel') is distinct from 'string'
   or v_ns->'scope'->>'channel' not in ('ALL','PAYE','UMBRELLA') then
  raise exception using errcode='22023',message='BPAY_NEXT_CHOICE_DESCRIPTOR_INVALID';end if;
 foreach v_field in array array['candidate_id','client_id'] loop
  if v_ns->'scope'->v_field<>'null'::jsonb and (jsonb_typeof(v_ns->'scope'->v_field) is distinct from 'string'
    or v_ns->'scope'->>v_field!~'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$') then
   raise exception using errcode='22023',message='BPAY_NEXT_CHOICE_DESCRIPTOR_INVALID';end if;
 end loop;
 if jsonb_typeof(p_descriptor->'workbench_revision') is distinct from 'string'
   or p_descriptor->>'workbench_revision'!~'^(0|[1-9][0-9]{0,18})$'
   or jsonb_typeof(p_descriptor->'adoption_revision') is distinct from 'string'
   or p_descriptor->>'adoption_revision'!~'^(0|[1-9][0-9]{0,18})$' then
  raise exception using errcode='22023',message='BPAY_NEXT_CHOICE_DESCRIPTOR_INVALID';end if;
 -- An exact receipt replay acquires no new source/cut/FK-parent locks.
 select src.* into v_run from private.bpay_next_pay_run src where id=p_run_id;
 if found then
  if v_run.accepted_choice_descriptor is null then
   raise exception using errcode='55000',message='BPAY_NEXT_CHOICE_RUN_NOT_EMPTY';end if;
  v_result:=private.bpay_next_create_preparation_v1(p_run_id,p_actor_user_id,p_pay_date);
  select src.* into strict v_run from private.bpay_next_pay_run src where id=p_run_id;
  if v_run.accepted_choice_descriptor is distinct from p_descriptor
    or v_run.accepted_choice_command_id is distinct from p_command_id then
   raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_DESCRIPTOR_REPLAY_CONFLICT';end if;
  if (v_run.paye_guard_decision,v_run.channel_scope,v_run.paye_override_reason,v_run.reauth_proof_id,
    v_run.paye_override_actor) is distinct from (v_policy,v_channel,v_reason,v_proof,
      case when v_policy='NONE' then null::uuid else p_actor_user_id end) then
   raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_DESCRIPTOR_REPLAY_CONFLICT';end if;
  if v_proof is not null then
   perform private.bpay_next_reauth_consume_v1(v_proof,p_actor_user_id,'PAYE_SAME_WEEK_OVERRIDE',v_run.paye_guard_scope_sha256,p_command_id);
  end if;
  select agency_sequence into v_sequence from private.bpay_next_command where id=p_command_id;
  return v_result||jsonb_build_object('command_id',p_command_id,'agency_sequence',v_sequence::text,
    'choice_work_count',(select count(*)::text from private.bpay_next_run_choice_member where run_id=p_run_id and member_kind='WORK'),
    'choice_case_count',(select count(*)::text from private.bpay_next_run_choice_member where run_id=p_run_id and member_kind='CASE_COMPONENT'),
    'selected_candidate_count',v_run.selected_candidate_count::text,'empty',v_run.selected_candidate_count=0,'replay',true);
 end if;
 -- Source admission precedes the original module/run/snooze cut locks.
 begin perform private.weekly_source_pay_query_admit_v2();
 exception when lock_not_available then v_query_admitted:=false;end;
 perform 1 from private.bpay_next_module_control where id=1 and active_owner='NEXT' for share;
 -- FK parent locks precede the inherited snooze command-clock SHARE.
 -- No revision-meta lock: Snooze writers already take clock before meta.
 select coalesce(array_agg(parent.id),'{}'::uuid[]) into v_locked_candidates from (select candidate.id from public.candidates candidate where exists(select 1 from private.bpay_next_workbench_item i
   where i.candidate_id=candidate.id and i.section='READY' and i.selectable
     and (v_ns->'scope'->'candidate_id'='null'::jsonb or i.candidate_id=(v_ns->'scope'->>'candidate_id')::uuid)
     and (v_ns->'scope'->'client_id'='null'::jsonb or i.client_id=(v_ns->'scope'->>'client_id')::uuid)
     and (v_ns->'scope'->>'channel'='ALL' or i.target_pay_channel=v_ns->'scope'->>'channel'))
   or exists(select 1 from unnest(array['candidates','works','components','cases']) kind
     cross join lateral jsonb_array_elements(v_intent->kind) a(value) where a.value->>'candidate_id'=candidate.id::text)
   order by candidate.id for share) parent;
 if exists(select 1 from jsonb_array_elements(v_intent->'candidates') requested
   where not ((requested->>'candidate_id')::uuid=any(v_locked_candidates))) then
  raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_NATIVE_IDENTITY_INVALID';end if;
 perform 1 from public.umbrellas umbrella where exists(select 1 from public.candidates candidate
   join private.bpay_next_workbench_item i on i.candidate_id=candidate.id and i.section='READY' and i.selectable
   where candidate.umbrella_id=umbrella.id
     and (v_ns->'scope'->'candidate_id'='null'::jsonb or i.candidate_id=(v_ns->'scope'->>'candidate_id')::uuid)
     and (v_ns->'scope'->'client_id'='null'::jsonb or i.client_id=(v_ns->'scope'->>'client_id')::uuid)
     and (v_ns->'scope'->>'channel'='ALL' or i.target_pay_channel=v_ns->'scope'->>'channel'))
   order by umbrella.id for share;
 select coalesce(array_agg(parent.id),'{}'::uuid[]) into v_locked_works from (select w.id from private.bpay_next_work w where exists(select 1 from private.bpay_next_workbench_item i
   where i.work_id=w.id and i.section='READY' and i.selectable
     and (v_ns->'scope'->'candidate_id'='null'::jsonb or i.candidate_id=(v_ns->'scope'->>'candidate_id')::uuid)
     and (v_ns->'scope'->'client_id'='null'::jsonb or i.client_id=(v_ns->'scope'->>'client_id')::uuid)
     and (v_ns->'scope'->>'channel'='ALL' or i.target_pay_channel=v_ns->'scope'->>'channel'))
   or exists(select 1 from jsonb_array_elements(v_intent->'works') a(value) where a.value->>'work_id'=w.id::text)
   order by w.id for share) parent;
 select coalesce(array_agg(parent.id),'{}'::uuid[]) into v_locked_revisions from (select r.id from private.bpay_next_work_revision r where exists(select 1 from private.bpay_next_workbench_item i
   where i.revision_id=r.id and i.section='READY' and i.selectable
     and (v_ns->'scope'->'candidate_id'='null'::jsonb or i.candidate_id=(v_ns->'scope'->>'candidate_id')::uuid)
     and (v_ns->'scope'->'client_id'='null'::jsonb or i.client_id=(v_ns->'scope'->>'client_id')::uuid)
     and (v_ns->'scope'->>'channel'='ALL' or i.target_pay_channel=v_ns->'scope'->>'channel'))
   or exists(select 1 from jsonb_array_elements(v_intent->'works') a(value) where a.value->>'expected_revision_id'=r.id::text)
   order by r.work_id,r.id for share) parent;
 select coalesce(array_agg(parent.id),'{}'::uuid[]) into v_locked_cases from (select component.id from private.bpay_next_case_component component where exists(select 1 from private.bpay_next_workbench_item i
   where i.case_component_id=component.id and i.section='READY' and i.selectable
     and (v_ns->'scope'->'candidate_id'='null'::jsonb or i.candidate_id=(v_ns->'scope'->>'candidate_id')::uuid)
     and (v_ns->'scope'->'client_id'='null'::jsonb or i.client_id=(v_ns->'scope'->>'client_id')::uuid)
     and (v_ns->'scope'->>'channel'='ALL' or i.target_pay_channel=v_ns->'scope'->>'channel'))
   or exists(select 1 from jsonb_array_elements(v_intent->'cases') a(value) where a.value->>'case_component_id'=component.id::text)
   order by component.candidate_id,component.id for share) parent;
 if exists(select 1 from private.bpay_next_command c where c.status in ('RECEIVED','ENROLLING'))
   or exists(select 1 from private.bpay_next_job j join private.bpay_next_command c on c.id=j.command_id
   where j.status<>'DONE' and j.candidate_id=any(v_locked_candidates)) then
  raise exception using errcode='55000',message='BPAY_NEXT_ACCEPT_INPUT_EARLIER_ECONOMIC_COMMAND_PENDING';end if;
 -- Acquire UPDATE once before the inherited SHARE, avoiding concurrent upgrades.
 perform 1 from private.bpay_next_command_clock where id=1 for update;
 if exists(select 1 from private.bpay_next_command c where c.status in ('RECEIVED','ENROLLING'))
   or exists(select 1 from private.bpay_next_job j join private.bpay_next_command c on c.id=j.command_id
   where j.status<>'DONE' and j.candidate_id=any(v_locked_candidates)) then
  raise exception using errcode='55000',message='BPAY_NEXT_ACCEPT_INPUT_EARLIER_ECONOMIC_COMMAND_PENDING';end if;
 if exists(select 1 from private.bpay_next_command where id=p_command_id) then
  raise exception using errcode='23514',message='BPAY_NEXT_PREPARE_COMMAND_REPLAY_CONFLICT';end if;
 -- A same-run concurrent legacy writer must never make clock->run wait.
 perform 1 from private.bpay_next_pay_run where id=p_run_id for update nowait;
 if found and exists(select 1 from private.bpay_next_pay_run where id=p_run_id and accepted_choice_descriptor is null) then
  raise exception using errcode='55000',message='BPAY_NEXT_CHOICE_RUN_NOT_EMPTY';end if;
 -- Original UUID/actor/date/deadline owner is preserved, including replay.
 v_result:=private.bpay_next_create_preparation_v1(p_run_id,p_actor_user_id,p_pay_date);
 select r.* into strict v_run from private.bpay_next_pay_run r where r.id=p_run_id for update;
 if v_run.accepted_choice_descriptor is not null then
  if v_run.accepted_choice_descriptor is distinct from p_descriptor
    or v_run.accepted_choice_command_id is distinct from p_command_id then
   raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_DESCRIPTOR_REPLAY_CONFLICT';end if;
  if (v_run.paye_guard_decision,v_run.channel_scope,v_run.paye_override_reason,v_run.reauth_proof_id,
    v_run.paye_override_actor) is distinct from (v_policy,v_channel,v_reason,v_proof,
      case when v_policy='NONE' then null::uuid else p_actor_user_id end) then
   raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_DESCRIPTOR_REPLAY_CONFLICT';end if;
  if v_proof is not null then
   perform private.bpay_next_reauth_consume_v1(v_proof,p_actor_user_id,'PAYE_SAME_WEEK_OVERRIDE',v_run.paye_guard_scope_sha256,p_command_id);
  end if;
  select agency_sequence into v_sequence from private.bpay_next_command where id=p_command_id;
  return v_result||jsonb_build_object('command_id',p_command_id,'agency_sequence',v_sequence::text,
    'choice_work_count',(select count(*)::text from private.bpay_next_run_choice_member where run_id=p_run_id and member_kind='WORK'),
    'choice_case_count',(select count(*)::text from private.bpay_next_run_choice_member where run_id=p_run_id and member_kind='CASE_COMPONENT'),
    'selected_candidate_count',v_run.selected_candidate_count::text,'empty',v_run.selected_candidate_count=0,'replay',true);
 end if;
 if v_run.status<>'PREPARING' or v_run.selection_state<>'OPEN' or v_run.selection_page_count<>0
   or v_run.selection_count<>0 or v_run.selected_candidate_count<>0
   or exists(select 1 from private.bpay_next_run_selection where run_id=p_run_id)
   or exists(select 1 from private.bpay_next_selection_candidate where run_id=p_run_id)
   or exists(select 1 from private.bpay_next_case_selection where run_id=p_run_id)
   or exists(select 1 from private.bpay_next_run_command where run_id=p_run_id)
   or v_run.preparation_expires_at_utc<=clock_timestamp() then
  raise exception using errcode='55000',message='BPAY_NEXT_CHOICE_RUN_NOT_EMPTY';end if;
 -- Compare real authenticated identity/context; caller fields are never authority.
 v_header:=public.bpay_next_workbench_page_v1(jsonb_build_object('actor_user_id',p_actor_user_id,
   'kind','HEADER','candidate_id',v_ns->'scope'->'candidate_id','client_id',v_ns->'scope'->'client_id',
   'channel',v_ns->'scope'->>'channel','section','READY','search','','sort','NAME_ASC',
   'group_key',null,'item_id',null,'reason_code',null,'count_selection',null,'after',null,'limit',100));
 if v_ns->>'agency_id' is distinct from v_header->'context'->>'agency_id'
   or v_ns->>'actor_user_id' is distinct from p_actor_user_id::text
   or v_ns->>'owner_epoch' is distinct from v_header->'context'->>'owner_epoch'
   or v_ns->>'official_pay_date' is distinct from v_run.pay_date::text
   or p_descriptor->>'workbench_revision' is distinct from v_header->'context'->>'workbench_revision'
   or p_descriptor->>'adoption_revision' is distinct from v_header->'context'->>'adoption_revision'
   or jsonb_typeof(p_descriptor->'revision') is distinct from 'number'
   or p_descriptor->>'revision'!~'^(0|[1-9][0-9]{0,15})$' then
  raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_CONTEXT_CHANGED';end if;
 -- Validate every deliberate subordinate identity before any accepted cut.
 for v_array,v_row in select k,value from unnest(array['works','components']) k
   cross join lateral jsonb_array_elements(v_intent->k) a(value) loop
  v_work:=(v_row->>'work_id')::uuid;v_candidate:=(v_row->>'candidate_id')::uuid;
  v_revision:=(v_row->>'expected_revision_id')::uuid;
  if not exists(select 1 from private.bpay_next_work w join private.bpay_next_work_revision r
    on r.work_id=w.id and r.id=v_revision where w.id=v_work and w.candidate_id=v_candidate)
    or (v_array='components' and not exists(select 1 from private.bpay_next_approved_line l
      where l.id=(v_row->>'approved_line_id')::uuid and l.revision_id=v_revision)) then
   raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_NATIVE_IDENTITY_INVALID';end if;
 end loop;
 -- WB25: component-only memory overlays retain untouched native defaults.
 -- A supplied parent must match; an absent parent must be current, scoped and
 -- eligible under the original held Work/revision locks. Legacy stays SUBSET.
 if exists(select 1 from jsonb_array_elements(v_intent->'components') c(value)
   where case when exists(select 1 from jsonb_array_elements(v_intent->'works') w(value)
      where w.value->>'work_id'=c.value->>'work_id') then
     not exists(select 1 from jsonb_array_elements(v_intent->'works') w(value)
      where w.value->>'work_id'=c.value->>'work_id' and w.value->>'candidate_id'=c.value->>'candidate_id'
       and w.value->>'expected_revision_id'=c.value->>'expected_revision_id'
       and (v_memory or w.value->>'mode'='SUBSET' and w.value->'selected'='true'::jsonb))
    else not v_memory or not exists(select 1 from private.bpay_next_work w join private.bpay_next_work_revision r on r.work_id=w.id
       join private.bpay_next_workbench_item i on i.work_id=w.id and i.revision_id=r.id
       join private.bpay_next_workbench_group g on g.group_key=i.group_key and g.candidate_id=i.candidate_id
       where w.id=(c.value->>'work_id')::uuid and w.candidate_id=(c.value->>'candidate_id')::uuid
        and r.id=(c.value->>'expected_revision_id')::uuid and w.current_revision_id=r.id and w.applied_revision_id=r.id
        and i.approved_line_id=(c.value->>'approved_line_id')::uuid and i.candidate_id=w.candidate_id
        and i.section='READY' and i.selectable and i.amount_known and not i.is_selected
        and i.portion_kind in ('AVAILABLE','ZERO') and g.complete and not g.dirty
        and g.progress_state='CURRENT' and i.progress_state='CURRENT'
        and i.projection_revision=g.projection_revision and i.financial_view_revision=g.financial_view_revision
        and (v_ns->'scope'->>'candidate_id' is null or i.candidate_id=(v_ns->'scope'->>'candidate_id')::uuid)
        and (v_ns->'scope'->>'client_id' is null or i.client_id=(v_ns->'scope'->>'client_id')::uuid)
        and (v_ns->'scope'->>'channel'='ALL' or i.target_pay_channel=v_ns->'scope'->>'channel')) end) then
  raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_NATIVE_IDENTITY_INVALID';end if;
 if exists(select 1 from jsonb_array_elements(v_intent->'cases') a(value) where not exists(
   select 1 from private.bpay_next_case_component c where c.id=(a.value->>'case_component_id')::uuid
     and c.candidate_id=(a.value->>'candidate_id')::uuid)) then
  raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_NATIVE_IDENTITY_INVALID';end if;
 -- DR-10: fresh serialized policy admission, before the original member cut.
 v_guard:=private.bpay_next_paye_guard_page_v1(p_actor_user_id,p_run_id,p_descriptor);
 if v_policy='NONE' and (v_guard->>'guard_applies')::boolean then
  raise exception using errcode='55000',message='BPAY_NEXT_PAYE_SAME_WEEK_GUARD_UNRESOLVED';end if;
 if v_policy<>'NONE' and not(v_guard->>'guard_applies')::boolean then
  raise exception using errcode='23514',message='BPAY_NEXT_PAYE_GUARD_CHANGED';end if;
 if v_policy in ('VERIFY_BOTH','VERIFY_PAYE') then
  if (v_guard->>'unexecuted')::boolean then
   raise exception using errcode='55000',message='BPAY_NEXT_PAYE_SAME_WEEK_GUARD_UNEXECUTED';end if;
  v_policy_args:=jsonb_build_object('run_id',p_run_id,'command_id',p_command_id,'decision',v_policy,'reason',v_reason,
    'context',p_descriptor-array['intent','revision','memory_baseline_run_id']);
  v_scope:=private.bpay_next_reauth_scope_v1(p_actor_user_id,'PAYE_SAME_WEEK_OVERRIDE',v_policy_args,false);
  perform private.bpay_next_reauth_consume_v1(v_proof,p_actor_user_id,'PAYE_SAME_WEEK_OVERRIDE',v_scope->>'scope_sha256',p_command_id);
 end if;
 update private.bpay_next_pay_run set paye_guard_decision=v_policy,channel_scope=v_channel,
  paye_override_actor=case when v_policy='NONE' then null else p_actor_user_id end,
  paye_override_reason=v_reason,reauth_proof_id=v_proof,paye_guard_scope_sha256=v_scope->>'scope_sha256' where id=p_run_id;
 -- The original run boundary retained its snooze cut; no second clock or kind.
 insert into private.bpay_next_run_selection_exclusion(run_id,page_no,candidate_id,actor_user_id)
   select p_run_id,(row_number() over(order by a.value->>'candidate_id')+99)/100,
     (a.value->>'candidate_id')::uuid,p_actor_user_id
   from jsonb_array_elements(v_intent->'candidates') a(value) where a.value->'selected'='false'::jsonb;
 insert into private.bpay_next_run_selection_exclusion(run_id,page_no,work_id,actor_user_id)
   select p_run_id,((select count(*) from private.bpay_next_run_selection_exclusion where run_id=p_run_id)
     +row_number() over(order by a.value->>'work_id')+99)/100,(a.value->>'work_id')::uuid,p_actor_user_id
   from jsonb_array_elements(v_intent->'works') a(value) where a.value->'selected'='false'::jsonb;
 -- No membership may acquire an unheld FK parent after the command clock.
 if exists(select 1 from private.bpay_next_workbench_item i
   where i.section='READY' and i.selectable
     and (v_ns->'scope'->'candidate_id'='null'::jsonb or i.candidate_id=(v_ns->'scope'->>'candidate_id')::uuid)
     and (v_ns->'scope'->'client_id'='null'::jsonb or i.client_id=(v_ns->'scope'->>'client_id')::uuid)
     and (v_ns->'scope'->>'channel'='ALL' or i.target_pay_channel=v_ns->'scope'->>'channel')
     and (not(i.candidate_id=any(v_locked_candidates))
       or (i.work_id is not null and (not(i.work_id=any(v_locked_works)) or not(i.revision_id=any(v_locked_revisions))))
       or (i.case_component_id is not null and not(i.case_component_id=any(v_locked_cases))))) then
  raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_CONTEXT_CHANGED';end if;
 -- The eligible leaf cut is universal; optional remembered-choice semantics remain original.
 perform private.bpay_next_selection_memory_capture_v1(p_run_id,p_descriptor);
 if v_memory then
  v_baseline:=private.bpay_next_selection_memory_resolve_v1(v_ns,jsonb_build_object('run_id',p_descriptor->'memory_baseline_run_id','scope',v_ns->'scope'));
  with choices as materialized(select * from private.bpay_next_selection_memory_choices_v1(v_ns->'scope',v_baseline,v_intent)),
  works as (select l.work_id,l.candidate_id,
    coalesce((ov.value->>'expected_revision_id')::uuid,l.revision_id) expected_revision_id,
    case when bool_and(l.selected) then 'ALL' else 'SUBSET' end selection_mode
   from choices l left join lateral(select value from jsonb_array_elements(v_intent->'works') where value->>'work_id'=l.work_id::text) ov on true
   where l.work_id is not null and l.direction='PAYMENT'
    and (v_policy<>'VERIFY_PAYE' or exists(select 1 from public.candidates c where c.id=l.candidate_id and upper(c.pay_method)='PAYE'))
   group by l.work_id,l.candidate_id,coalesce((ov.value->>'expected_revision_id')::uuid,l.revision_id)
   having bool_or(l.selected)),
  work_members as (insert into private.bpay_next_run_choice_member(run_id,member_kind,member_id,candidate_id,work_id,expected_revision_id,selection_mode,selected,member_no)
   select p_run_id,'WORK',w.work_id,w.candidate_id,w.work_id,w.expected_revision_id,w.selection_mode,true,
    row_number() over(order by (w.selection_mode='SUBSET') desc,w.work_id) from works w returning candidate_id),
  case_members as (insert into private.bpay_next_run_choice_member(run_id,member_kind,member_id,candidate_id,case_component_id,selected,member_no)
   select p_run_id,'CASE_COMPONENT',l.case_component_id,l.candidate_id,l.case_component_id,l.selected,
    row_number() over(order by l.candidate_id,l.case_component_id) from choices l
   where l.case_component_id is not null
    and (v_channel='ALL' or exists(select 1 from public.candidates c where c.id=l.candidate_id and upper(c.pay_method)=v_channel)) and
    (exists(select 1 from work_members w where w.candidate_id=l.candidate_id)
     or exists(select 1 from choices payment where payment.candidate_id=l.candidate_id and payment.case_component_id is not null and payment.direction='PAYMENT' and payment.selected))
   returning candidate_id)
  select (select count(*) from work_members)+(select count(*) from case_members) into v_count;
 else
 -- Retain Work and Case membership in one statement snapshot.
 with work_members as (insert into private.bpay_next_run_choice_member(run_id,member_kind,member_id,candidate_id,
   work_id,expected_revision_id,selection_mode,selected,member_no)
 select p_run_id,'WORK',i.work_id,i.candidate_id,i.work_id,
   coalesce((ov.value->>'expected_revision_id')::uuid,i.revision_id),coalesce(ov.value->>'mode','ALL'),true,
   row_number() over(order by (coalesce(ov.value->>'mode','ALL')='SUBSET') desc,i.work_id)
 from private.bpay_next_workbench_item i join private.bpay_next_workbench_group g
   on g.group_key=i.group_key and g.candidate_id=i.candidate_id
 left join lateral(select a.value from jsonb_array_elements(v_intent->'works') a(value)
   where a.value->>'work_id'=i.work_id::text) ov on true
 where i.section='READY' and i.selectable and i.work_id is not null and i.amount_known
   and i.direction='PAYMENT' and i.portion_kind in ('AVAILABLE','ZERO')
   and (v_policy<>'VERIFY_PAYE' or exists(select 1 from public.candidates c where c.id=i.candidate_id and upper(c.pay_method)='PAYE'))
   and g.complete and not g.dirty and g.progress_state='CURRENT' and i.progress_state='CURRENT'
   and i.projection_revision=g.projection_revision and i.financial_view_revision=g.financial_view_revision
   and (v_ns->'scope'->'candidate_id'='null'::jsonb or i.candidate_id=(v_ns->'scope'->>'candidate_id')::uuid)
   and (v_ns->'scope'->'client_id'='null'::jsonb or i.client_id=(v_ns->'scope'->>'client_id')::uuid)
   and (v_ns->'scope'->>'channel'='ALL' or i.target_pay_channel=v_ns->'scope'->>'channel')
   and not exists(select 1 from private.bpay_next_run_selection_exclusion e where e.run_id=p_run_id
     and (e.candidate_id=i.candidate_id or e.work_id=i.work_id))
   and (v_intent->>'mode'='ALL_MATCHING' or ov.value->'selected'='true'::jsonb or exists(
     select 1 from jsonb_array_elements(v_intent->'candidates') a(value)
       where a.value->>'candidate_id'=i.candidate_id::text and a.value->'selected'='true'::jsonb))
 group by i.work_id,i.candidate_id,coalesce((ov.value->>'expected_revision_id')::uuid,i.revision_id),coalesce(ov.value->>'mode','ALL') returning candidate_id),
 case_members as (insert into private.bpay_next_run_choice_member(run_id,member_kind,member_id,candidate_id,case_component_id,selected,member_no)
 select p_run_id,'CASE_COMPONENT',i.case_component_id,i.candidate_id,i.case_component_id,
   coalesce((ov.value->>'selected')::boolean,true),row_number() over(order by i.candidate_id,i.case_component_id)
 from private.bpay_next_workbench_item i join private.bpay_next_workbench_group g
   on g.group_key=i.group_key and g.candidate_id=i.candidate_id
 left join lateral(select a.value from jsonb_array_elements(v_intent->'cases') a(value)
   where a.value->>'case_component_id'=i.case_component_id::text) ov on true
 where i.section='READY' and i.selectable and i.case_component_id is not null
   and (v_channel='ALL' or exists(select 1 from public.candidates c where c.id=i.candidate_id and upper(c.pay_method)=v_channel))
   and g.complete and not g.dirty and g.progress_state='CURRENT' and i.progress_state='CURRENT'
   and i.projection_revision=g.projection_revision and i.financial_view_revision=g.financial_view_revision
   and (v_ns->'scope'->'candidate_id'='null'::jsonb or i.candidate_id=(v_ns->'scope'->>'candidate_id')::uuid)
   and (v_ns->'scope'->'client_id'='null'::jsonb or i.client_id=(v_ns->'scope'->>'client_id')::uuid)
   and (v_ns->'scope'->>'channel'='ALL' or i.target_pay_channel=v_ns->'scope'->>'channel')
   and not exists(select 1 from private.bpay_next_run_selection_exclusion e where e.run_id=p_run_id
     and e.candidate_id=i.candidate_id)
   and (exists(select 1 from work_members m where m.candidate_id=i.candidate_id)
     or exists(select 1 from private.bpay_next_workbench_item payment
       join private.bpay_next_workbench_group payment_group
         on payment_group.group_key=payment.group_key and payment_group.candidate_id=payment.candidate_id
       left join lateral(select a.value from jsonb_array_elements(v_intent->'cases') a(value)
         where a.value->>'case_component_id'=payment.case_component_id::text) chosen on true
       where payment.candidate_id=i.candidate_id and payment.case_component_id is not null
         and payment.section='READY' and payment.selectable and payment.direction='PAYMENT'
         and payment.amount_known and payment.portion_kind in ('AVAILABLE','ZERO')
         and payment_group.complete and not payment_group.dirty
         and payment_group.progress_state='CURRENT' and payment.progress_state='CURRENT'
         and payment.projection_revision=payment_group.projection_revision
         and payment.financial_view_revision=payment_group.financial_view_revision
         and coalesce((chosen.value->>'selected')::boolean,true)
         and (v_ns->'scope'->'client_id'='null'::jsonb or payment.client_id=(v_ns->'scope'->>'client_id')::uuid)
         and (v_ns->'scope'->>'channel'='ALL' or payment.target_pay_channel=v_ns->'scope'->>'channel')
         and (v_intent->>'mode'='ALL_MATCHING' or chosen.value->'selected'='true'::jsonb
           or exists(select 1 from jsonb_array_elements(v_intent->'candidates') a(value)
             where a.value->>'candidate_id'=i.candidate_id::text and a.value->'selected'='true'::jsonb))))
 group by i.case_component_id,i.candidate_id,coalesce((ov.value->>'selected')::boolean,true) returning candidate_id)
 select (select count(*) from work_members)+(select count(*) from case_members) into v_count;
 end if;
 v_week_start:=date_trunc('week',v_run.snooze_business_date::timestamp)::date;
 for v_member in select m.*,w.approval_state,w.current_revision_id,w.applied_revision_id,w.week_ending_date,
   r.physical_timesheet_id,r.source_kind,r.approved_at_utc,r.sealed_at_utc,upper(c.pay_method) as pay_channel
   from private.bpay_next_run_choice_member m join private.bpay_next_work w on w.id=m.work_id
   join private.bpay_next_work_revision r on r.work_id=w.id and r.id=m.expected_revision_id
   join public.candidates c on c.id=m.candidate_id
   where m.run_id=p_run_id and m.member_kind='WORK' order by m.member_no loop
  v_code:=null;
  if v_policy='UMBRELLA_ONLY' and v_member.pay_channel='PAYE' then
   v_code:='PAYE_EXCLUDED_BY_SAME_WEEK_GUARD';
  elsif v_member.approval_state<>'APPROVED' or v_member.approved_at_utc is null or v_member.sealed_at_utc is null then
   v_code:='BPAY_NEXT_SELECTION_WORK_NOT_APPROVED';
  elsif v_member.current_revision_id is distinct from v_member.expected_revision_id
    or v_member.applied_revision_id is distinct from v_member.expected_revision_id then
   v_code:='BPAY_NEXT_SELECTION_REVISION_NOT_CURRENT';
  elsif private.bpay_next_work_period_proof_v1(v_member.work_id,v_member.expected_revision_id,v_run.snooze_business_date)->'valid' is distinct from 'true'::jsonb then
   v_code:='BPAY_NEXT_SELECTION_REVISION_NOT_CURRENT';
  elsif v_member.week_ending_date-6>v_run.snooze_business_date then v_code:='BPAY_NEXT_WORK_WEEK_NOT_YET_PAYABLE';
  elsif not exists(select 1 from private.bpay_next_work w
    join public.timesheets t on t.booking_id=w.booking_id and t.is_current
    join public.timesheets_financials tf on tf.timesheet_id=t.timesheet_id and tf.is_current
    where w.id=v_member.work_id) then v_code:='BPAY_NEXT_SELECTION_REVISION_NOT_CURRENT';
  elsif exists(select 1 from private.bpay_next_work w
    join public.timesheets t on t.booking_id=w.booking_id and t.is_current=true
    join public.timesheets_financials tf on tf.timesheet_id=t.timesheet_id and tf.is_current=true
    where w.id=v_member.work_id and tf.pay_on_hold is true) then
   v_code:='BPAY_NEXT_SELECTION_ON_HOLD';
  elsif not exists(select 1 from private.bpay_next_revision_worker_basis where revision_id=v_member.expected_revision_id) then
   raise exception using errcode='55000',message='BPAY_NEXT_SELECTION_BASIS_UNAVAILABLE';
  elsif exists(select 1 from private.bpay_next_snooze sn
    join lateral(select ev.after_state from private.bpay_next_snooze_event ev
      where ev.snooze_id=sn.id and ev.control_sequence<=v_run.snooze_control_sequence
      order by ev.control_sequence desc limit 1) e on true
    join private.bpay_next_revision_worker_basis b on b.revision_id=v_member.expected_revision_id
    where sn.work_id=v_member.work_id and sn.scope_kind='WHOLE_TIMESHEET'
      and (e.after_state->>'active')::boolean
      and ((e.after_state->>'until_date') is null or (e.after_state->>'until_date')::date>=v_run.snooze_business_date)
      and (e.after_state->>'worker_pay_basis')::bytea=b.whole_basis) then
   v_code:='BPAY_NEXT_SELECTION_SNOOZED';
  end if;
  v_gate:=null;v_query_exclusions:=null;
  if v_code is null and v_member.source_kind in ('SOURCE','PROTECTED') then
   if not v_query_admitted then v_code:='SOURCE_PAY_QUERY_EVIDENCE_UNAVAILABLE';
   else begin v_gate:=private.weekly_source_pay_query_gate_v1(v_member.physical_timesheet_id);
    if v_gate->'ok' is distinct from 'true'::jsonb or v_gate->>'code' is distinct from 'OK'
      or jsonb_typeof(v_gate->'blocked') is distinct from 'boolean' then
     v_code:='SOURCE_PAY_QUERY_EVIDENCE_UNAVAILABLE';
    else
     v_query_exclusions:=private.bpay_next_source_query_segment_exclusions_v1(v_member.expected_revision_id,v_gate);
     if v_gate->'blocked'='true'::jsonb and v_query_exclusions is null then v_code:='SOURCE_PAY_QUERY_OPEN';end if;
    end if;
   exception when others then v_code:='SOURCE_PAY_QUERY_EVIDENCE_UNAVAILABLE';end;end if;
  end if;
  if v_code is null and v_member.selection_mode='SUBSET' and v_memory then
   if not exists(select 1 from private.bpay_next_selection_memory_choices_v1(v_ns->'scope',v_baseline,v_intent) l
     where l.work_id=v_member.work_id and l.revision_id=v_member.expected_revision_id and l.selected and l.direction='PAYMENT') then
    v_code:='BPAY_NEXT_SELECTION_SIGNED_LINE_NOT_ELIGIBLE';end if;
  elsif not v_memory then
  if v_code is null and v_member.selection_mode='SUBSET' and (not exists(
    select 1 from private.bpay_next_workbench_item i
    join jsonb_array_elements(v_intent->'components') a(value)
      on a.value->>'approved_line_id'=i.approved_line_id::text and a.value->'selected'='true'::jsonb
    where i.work_id=v_member.work_id and i.revision_id=v_member.expected_revision_id
      and i.section='READY' and i.selectable and i.amount_known and i.direction='PAYMENT'
      and i.portion_kind in ('AVAILABLE','ZERO'))
    or exists(select 1 from jsonb_array_elements(v_intent->'components') chosen
      where chosen->>'work_id'=v_member.work_id::text and chosen->'selected'='true'::jsonb
        and not exists(select 1 from private.bpay_next_workbench_item i
          where i.work_id=v_member.work_id and i.revision_id=v_member.expected_revision_id
            and i.approved_line_id=(chosen->>'approved_line_id')::uuid and i.section='READY'
            and i.selectable and i.amount_known and i.direction='PAYMENT'
            and i.portion_kind in ('AVAILABLE','ZERO')))) then
   v_code:='BPAY_NEXT_SELECTION_SIGNED_LINE_NOT_ELIGIBLE';end if;
  end if;
  if v_code is not null then
   update private.bpay_next_run_choice_member set skip_code=v_code
     where run_id=p_run_id and member_kind='WORK' and member_id=v_member.member_id;
  else
   -- Use the existing Rule B objects as the only captured financial authority.
   v_work_count:=v_work_count+1;
   insert into private.bpay_next_run_selection(run_id,selection_no,work_id,candidate_id)
     values(p_run_id,v_work_count,v_member.work_id,v_member.candidate_id);
   insert into private.bpay_next_work_choice(run_id,work_id,expected_revision_id,selection_mode,selection_state,accepted_resolution_refs)
     values(p_run_id,v_member.work_id,v_member.expected_revision_id,v_member.selection_mode,
       case when v_member.selection_mode='ALL' then 'SEALED' else 'OPEN' end,
       private.bpay_next_accepted_resolution_refs_v1(p_run_id,v_member.work_id,v_member.expected_revision_id));
   if v_gate is not null then
    insert into private.bpay_next_run_work_query_snapshot(run_id,work_id,expected_revision_id,physical_timesheet_id,gate_result,captured_at_utc,segment_query_exclusions)
      values(p_run_id,v_member.work_id,v_member.expected_revision_id,v_member.physical_timesheet_id,v_gate,transaction_timestamp(),v_query_exclusions);
   end if;
  end if;
 end loop;
 -- Seal both original descriptor paths at the accepted cut with native pages.
 update private.bpay_next_pay_run set work_choice_count=v_work_count,
  sealed_work_choice_count=(select count(*) from private.bpay_next_work_choice where run_id=p_run_id and selection_state='SEALED') where id=p_run_id;
 for v_subset in select c.* from private.bpay_next_work_choice c where c.run_id=p_run_id and c.selection_mode='SUBSET' order by c.work_id loop
  v_page_no:=0;
  for v_lines in select array_agg(q.approved_line_id order by q.approved_line_id) from
   (select chosen.approved_line_id,(row_number() over(order by chosen.approved_line_id)-1)/100 page_no from (
     select l.approved_line_id from private.bpay_next_selection_memory_choices_v1(v_ns->'scope',v_baseline,v_intent) l
      where v_memory and l.work_id=v_subset.work_id and l.revision_id=v_subset.expected_revision_id and l.selected and l.direction='PAYMENT'
     union all select (l.value->>'approved_line_id')::uuid from jsonb_array_elements(v_intent->'components') l
      where not v_memory and l.value->>'work_id'=v_subset.work_id::text
       and l.value->>'expected_revision_id'=v_subset.expected_revision_id::text and l.value->'selected'='true'::jsonb
   ) chosen) q group by q.page_no order by q.page_no loop
   v_page_no:=v_page_no+1;
   perform private.bpay_next_append_component_selection_page_v1(p_run_id,v_subset.work_id,v_subset.expected_revision_id,v_page_no,v_lines);
  end loop;
  select c.* into strict v_subset from private.bpay_next_work_choice c where c.run_id=p_run_id and c.work_id=v_subset.work_id;
  perform private.bpay_next_seal_component_selection_v1(p_run_id,v_subset.work_id,v_subset.expected_revision_id,v_subset.page_count,v_subset.component_count);
 end loop;
 -- Capture the existing Rule B Candidate settings exactly once in this cut.
 insert into private.bpay_next_selection_candidate(run_id,candidate_id,member_no,
   target_pay_channel,target_umbrella_id,target_umbrella_vat_chargeable,min_take_home_wtd)
 select p_run_id,c.id,row_number() over(order by c.id),upper(c.pay_method),c.umbrella_id,u.vat_chargeable,c.min_take_home_wtd
 from public.candidates c left join public.umbrellas u on u.id=c.umbrella_id
 where exists(select 1 from private.bpay_next_run_choice_member m where m.run_id=p_run_id
   and m.candidate_id=c.id and m.selected and m.skip_code is null
   and (m.member_kind='WORK' or exists(select 1 from private.bpay_next_workbench_item i
     where i.case_component_id=m.case_component_id and i.direction='PAYMENT' and i.section='READY')));
 get diagnostics v_count=row_count;
 -- Optimistic context check, with no meta row lock or downstream recalculation.
 if not exists(select 1 from private.bpay_next_workbench_revision r where r.id=1
   and r.workbench_revision::text=p_descriptor->>'workbench_revision'
   and r.adoption_revision::text=p_descriptor->>'adoption_revision' and r.adoption_state='CURRENT') then
  raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_CONTEXT_CHANGED';end if;
 if v_count>0 then
  v_sequence:=private.bpay_next_receive_command_v1(p_command_id,'PREPARE');
  insert into private.bpay_next_run_command(run_id,command_id) values(p_run_id,p_command_id);
 end if;
 update private.bpay_next_pay_run set accepted_choice_descriptor=p_descriptor,
   accepted_choice_command_id=p_command_id,selected_candidate_count=v_count,
   selection_count=v_work_count,work_choice_count=v_work_count,
   sealed_work_choice_count=(select count(*) from private.bpay_next_work_choice where run_id=p_run_id and selection_state='SEALED') where id=p_run_id;
 if v_memory then
  update private.bpay_next_selection_mode_memory set command_id=case when v_sequence is not null then p_command_id end,
   agency_sequence=v_sequence where run_id=p_run_id and row_kind='HEADER' and v_sequence is not null;
 end if;
 -- ACK can only acknowledge these already frozen segments; no later READY reread.
 for v_subset in select c.work_id from private.bpay_next_work_choice c where c.run_id=p_run_id and c.selection_state='SEALED' order by c.work_id loop
  perform private.bpay_next_materialise_choice_segments_v1(p_run_id,v_subset.work_id);
 end loop;
 return v_result||jsonb_build_object('command_id',p_command_id,'agency_sequence',v_sequence::text,
   'selection_count',v_work_count::text,
   'selected_candidate_count',v_count::text,'empty',v_count=0,
   'choice_work_count',(select count(*)::text from private.bpay_next_run_choice_member where run_id=p_run_id and member_kind='WORK'),
   'choice_case_count',(select count(*)::text from private.bpay_next_run_choice_member where run_id=p_run_id and member_kind='CASE_COMPONENT'),'replay',false);
end
$function$;

