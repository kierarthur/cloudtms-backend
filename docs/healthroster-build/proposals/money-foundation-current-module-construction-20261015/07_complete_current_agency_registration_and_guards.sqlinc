-- Exact complete native guard inventory after the final composition.
do $source_registration_verified$
declare expected text[]:=array['public.client_settings','public.clients','public.contracts','public.timesheets','public.timesheets_financials','public.weekly_discrepancy_incidents','public.weekly_expense_authority_generations','public.weekly_issue_comparison_revisions','public.weekly_source_billing_movements','public.weekly_source_charge_acceptances','public.weekly_source_charge_checks','public.weekly_source_client_policies','public.weekly_source_contract_policies','public.weekly_source_cycles','public.weekly_source_expense_cell_evidence','public.weekly_source_final_revisions','public.weekly_source_final_snapshot_lines','public.weekly_source_format_profiles','public.weekly_source_global_settings','public.weekly_source_group_clients','public.weekly_source_group_rule_assignments','public.weekly_source_groups','public.weekly_source_invoice_hold_releases','public.weekly_source_ordinary_pay_projection_receipts','public.weekly_source_projection_publications','public.weekly_source_report_scopes','public.weekly_source_row_economic_snapshots','public.weekly_source_row_expense_policy_snapshots','public.weekly_source_row_resolutions','public.weekly_source_row_timesheet_lineages','public.weekly_source_rule_set_versions','public.weekly_source_rule_sets','public.weekly_source_self_bill_report_line_bindings','public.weekly_source_self_bill_reports','public.weekly_source_state_transitions','public.weekly_source_upload_rows','public.weekly_source_uploads','public.weekly_work_events'];r text;guard_name text;fn_name text;matched integer;
begin
 foreach r in array expected loop
  foreach guard_name in array array['000_healthroster_source_a0_before_v1','zzz_healthroster_source_a0_before_v1'] loop
   fn_name:=case when guard_name='000_healthroster_source_a0_before_v1' then 'timesheet_correction_a0_source_reference_before_v1' else 'timesheet_correction_a0_source_reference_final_before_v1' end;
   select count(*) into matched from pg_catalog.pg_trigger trigger join pg_catalog.pg_class relation on relation.oid=trigger.tgrelid
    join pg_catalog.pg_namespace schema on schema.oid=relation.relnamespace join pg_catalog.pg_proc fn on fn.oid=trigger.tgfoid
    join pg_catalog.pg_namespace ns on ns.oid=fn.pronamespace
    where schema.nspname||'.'||relation.relname=r and trigger.tgname=guard_name and not trigger.tgisinternal
     and trigger.tgtype::integer=31 and trigger.tgnargs=0 and trigger.tgattr::text='' and trigger.tgqual is null and trigger.tgenabled='O'
     and ns.nspname='private' and fn.proname=fn_name and fn.provolatile='v' and fn.prosecdef
     and fn.proowner=(select oid from pg_catalog.pg_roles where rolname=current_user);
   if matched<>1 then raise exception 'CORRECTION_A0_SOURCE_RAW_FINAL_GUARD_INVENTORY_UNPROVED' using errcode='55000',detail=r||':'||guard_name;end if;
  end loop;
 end loop;
 if exists(select 1 from pg_catalog.pg_trigger trigger join pg_catalog.pg_class relation on relation.oid=trigger.tgrelid
  join pg_catalog.pg_namespace schema on schema.oid=relation.relnamespace
  where not trigger.tgisinternal and trigger.tgname in('000_healthroster_source_a0_before_v1','zzz_healthroster_source_a0_before_v1')
   and not(schema.nspname||'.'||relation.relname=any(expected))) then
  raise exception 'CORRECTION_A0_SOURCE_RAW_FINAL_GUARD_SCOPE_UNPROVED' using errcode='55000';end if;
end;
$source_registration_verified$;

