-- Only the genuine established Source bridge may carry preset reference work.
-- Legacy imports retain the existing preset refusal. This returns actual
-- Timesheet identities; it is not a caller selector or a validation capability.
create or replace function private.weekly_source_agency_mode_a_reference_targets_v1(p_import_id uuid,p_actor_user_id uuid)
returns uuid[] language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare hi public.hr_imports%rowtype; preview jsonb; p public.weekly_source_projection_publications%rowtype;
  u public.weekly_source_uploads%rowtype; c public.weekly_source_cycles%rowtype; ids uuid[]; item jsonb; t public.timesheets%rowtype;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict hi from public.hr_imports where id=p_import_id and pruned_at is null;
  if hi.import_scope is not null and upper(hi.import_scope::text)<>'HR_WEEKLY' then
    perform private.weekly_source_agency_legacy_import_validation_admit_v1(p_import_id);
    return array[]::uuid[];
  end if;
  preview:=public.hr_weekly_validation_preview(p_import_id);
  if preview->>'import_id' is distinct from hi.id::text or preview->>'client_id' is distinct from hi.client_id::text
    or jsonb_typeof(preview->'rows') is distinct from 'array' or jsonb_array_length(preview->'rows')>5000 then
    raise exception 'HR_VALIDATION_NATIVE_TARGETS_UNAVAILABLE' using errcode='55000';end if;
  select coalesce(array_agg(distinct (r->>'timesheet_id')::uuid order by (r->>'timesheet_id')::uuid),array[]::uuid[]) into ids
    from jsonb_array_elements(preview->'rows') r
    where nullif(r->>'timesheet_id','') is not null
      and private.weekly_source_agency_invoice_check_only_v1((r->>'timesheet_id')::uuid) is true;
  if cardinality(ids)=0 then
    perform private.weekly_source_agency_legacy_import_validation_admit_v1(p_import_id);
    return ids;
  end if;
  if hi.source_system::text<>'HEALTHROSTER' or hi.import_scope::text<>'HR_WEEKLY'
    or hi.parser_version is distinct from 'WEEKLY_SOURCE_MODE_A_BRIDGE_V1'
    or not pg_input_is_valid(coalesce(hi.parse_summary_json->>'weekly_source_projection_publication_id',''),'uuid')
    or not pg_input_is_valid(coalesce(hi.parse_summary_json->>'weekly_source_upload_id',''),'uuid') then
    -- Same native causal refusal for every real older/manual HR import.
    raise exception 'AGENCY_INVOICE_USES_COMPLETENESS_WRITER' using errcode='55000';end if;
  select * into strict p from public.weekly_source_projection_publications
    where id=(hi.parse_summary_json->>'weekly_source_projection_publication_id')::uuid;
  select * into strict u from public.weekly_source_uploads where id=p.upload_id;
  select * into strict c from public.weekly_source_cycles where id=p.source_cycle_id;
  if p.state is distinct from 'CURRENT' or p.authority_scope_kind is distinct from 'CYCLE' or p.report_scope_id is not null
    or p.correction_session_id is not null or c.current_projection_publication_id is distinct from p.id
    or c.current_complete_upload_id is distinct from u.id or u.state is distinct from 'CURRENT'
    or u.id::text is distinct from hi.parse_summary_json->>'weekly_source_upload_id'
    or u.source_cycle_id is distinct from c.id or u.report_scope_id is not null
    or hi.source_file_sha256 is distinct from encode(u.content_sha256,'hex')
    or hi.coverage_operation_key is distinct from private.weekly_source_mode_a_operation_key_v1(p.id,hi.client_id)
    or hi.coverage_start_date is distinct from u.confirmed_coverage_start_local_date
    or hi.coverage_end_date is distinct from u.confirmed_coverage_end_local_date then
    raise exception 'AGENCY_INVOICE_MODE_A_SOURCE_BRIDGE_STALE' using errcode='40001';end if;
  perform private.weekly_source_query_current_publication_v1(c.id,p.id);
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'RECHECK_SOURCE',c.source_group_id,hi.client_id,c.finalisation_week_ending);
  perform public._import_review_assert_actor_v1(p_actor_user_id);
  for item in select value from jsonb_array_elements(preview->'rows') r(value) where r->>'timesheet_id'=any(select x::text from unnest(ids) x) loop
    select * into strict t from public.timesheets where timesheet_id=(item->>'timesheet_id')::uuid;
    if t.is_current is distinct from true or t.revoked_at is not null or t.archived_at_utc is not null
      or t.sheet_scope::text<>'WEEKLY' or t.line_type::text<>'HOURS' or item->>'client_id' is distinct from hi.client_id::text
      or not exists(select 1 from public.contracts con where con.id=t.contract_id and con.client_id=hi.client_id
        and con.candidate_id::text=item->>'candidate_id')
      or not exists(select 1 from public.weekly_source_group_clients gc where gc.source_group_id=c.source_group_id
        and gc.client_id=hi.client_id and t.week_ending_date between gc.valid_from and coalesce(gc.valid_to,'infinity'::date))
      or private.weekly_source_effective_rule_set_v1(hi.client_id,c.id)#>>'{values,invoice_sender}' is distinct from 'AGENCY_INVOICE'
      or not exists(select 1 from public._import_review_effective_authority_core_v1('HR_WEEKLY',t.contract_id,hi.client_id,t.week_ending_date) a
        where a.route_eligible and a.validation_eligible and a.authority_mode='VALIDATION_ONLY') then
      raise exception 'AGENCY_INVOICE_MODE_A_REFERENCE_SCOPE_UNAVAILABLE' using errcode='55000';end if;
  end loop;
  return ids;
exception when no_data_found or too_many_rows or invalid_text_representation then
  raise exception 'AGENCY_INVOICE_MODE_A_REFERENCE_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_mode_a_reference_targets_v1(uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_mode_a_reference_targets_v1(uuid,uuid) from public,anon,authenticated,service_role;
