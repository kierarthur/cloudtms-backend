create or replace function private.invoice_daily_rate_actual_revision_assert_v1(p_operation_id uuid)
returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare o private.timesheet_contract_move_operations%rowtype;r private.timesheet_contract_move_reviews%rowtype;
 m private.timesheet_contract_move_members%rowtype;f public.timesheets_financials%rowtype;snap jsonb;actual jsonb;refs jsonb;v_keys text[];
begin
 select x.* into strict o from private.timesheet_contract_move_operations x where x.id=p_operation_id;
 if o.purpose<>'DAILY_RATE_CORRECTION' then raise exception 'DAILY_RATE_PURPOSE_INVALID' using errcode='22023';end if;
 if not(o.state='COMPLETE' or private.daily_rate_correction_accepting_v1(o.id)) then
  raise exception 'DAILY_RATE_ACTUAL_REVISION_UNBOUND' using errcode='55000';end if;
 select x.* into strict r from private.timesheet_contract_move_reviews x where x.operation_id=o.id and x.id=o.accepted_review_id;
 select x.* into strict m from private.timesheet_contract_move_members x where x.operation_id=o.id;
 snap:=r.manifest_json#>'{daily,calculation_snapshot}';
 if o.accepted_review_digest is distinct from r.review_digest or r.manifest_json#>>'{physical,version}'<>'DAILY_RATE_SCOPE_V1'
  or o.placement_receipt_json->>'version' is distinct from 'DAILY_RATE_REVISION_RECEIPT_V1'
  or o.placement_receipt_json->>'operation_id' is distinct from o.id::text
  or o.placement_receipt_json->>'review_id' is distinct from r.id::text
  or o.placement_receipt_json->>'current_timesheet_id' is distinct from o.from_timesheet_id::text
  or o.placement_receipt_json->>'previous_financial_id' is distinct from m.from_financial_id::text
  or o.placement_receipt_json->>'current_financial_id' is distinct from m.to_financial_id::text
  or m.from_timesheet_id is distinct from m.to_timesheet_id or m.from_timesheet_id is distinct from o.from_timesheet_id
  or m.from_version is distinct from m.to_version or m.from_financial_id is not distinct from m.to_financial_id
  or m.to_financial_id is distinct from private.daily_rate_correction_financial_id_v1(o.id,m.member_key)
  or o.from_contract_id is not null or o.to_contract_id is not null
  or m.from_contract_id is not null or m.to_contract_id is not null
  or jsonb_typeof(snap) is distinct from 'object'
  or r.manifest_json#>>'{daily,normalized_snapshot,id}' is distinct from m.from_financial_id::text
  or r.manifest_json#>>'{daily,normalized_snapshot,timesheet_id}' is distinct from m.from_timesheet_id::text then
  raise exception 'DAILY_RATE_ACTUAL_REVISION_UNBOUND' using errcode='55000';end if;
 select x.* into strict f from public.timesheets_financials x where x.id=m.to_financial_id;
 if not f.is_current or f.is_stale or f.timesheet_id<>m.to_timesheet_id or f.timesheet_version<>m.to_version
  or f.authorised_at_utc is null or f.authorised_by_user_id is distinct from o.created_by_user_id
  or not exists(select 1 from public.timesheets t where t.timesheet_id=m.to_timesheet_id and t.is_current
    and t.archived_at_utc is null and t.contract_id is null) then
  raise exception 'DAILY_RATE_ACTUAL_FINANCE_NOT_CURRENT_APPROVED' using errcode='55000';end if;
 select array_agg(key order by key) into v_keys from jsonb_object_keys(snap) key where key<>'rate_source_refs_json';
 select jsonb_object_agg(key,to_jsonb(f)->key) into actual from unnest(v_keys) key;
 refs:=(snap->'rate_source_refs_json')||coalesce(r.manifest_json#>'{daily,rate_provenance}','{}'::jsonb)
  ||jsonb_build_object('approval_purpose','RATE_CORRECTION','correction_operation_id',o.id,'accepted_review_id',r.id,
   'approved_by_user_id',f.authorised_by_user_id,'approved_at_utc',f.authorised_at_utc,'original_financial_id',m.from_financial_id,
   'calculation_context_sha256',r.manifest_json#>>'{daily,context,context_digest}',
   'worked_facts_sha256',r.manifest_json#>>'{daily,context,unchanged_work_sha256}');
 if actual is distinct from snap-'rate_source_refs_json' or f.rate_source_refs_json is distinct from refs then
  raise exception 'DAILY_RATE_ACCEPTED_NATIVE_VALUATION_CHANGED' using errcode='40001';end if;
end;
$function$;