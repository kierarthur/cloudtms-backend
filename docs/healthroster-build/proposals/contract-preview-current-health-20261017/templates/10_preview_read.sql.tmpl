-- Held complete Health source. Unprovided native owner slot prevents emission.
create or replace function private.timesheet_contract_move_preview_read_v1(p_request_id uuid,p_actor_user_id uuid)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,public,private,pg_temp
as $function$
declare q private.timesheet_contract_move_requests%rowtype; o private.timesheet_contract_move_operations%rowtype;
 r private.timesheet_contract_move_reviews%rowtype; actor_hash bytea; invoice jsonb; physical jsonb; preflight jsonb;
 blockers jsonb; result jsonb; ready boolean; actor_current bytea; unchanged boolean; invoice_visible boolean;
 -- Composition locals, not a proposed callable financial interface.
 bank_pay_effect jsonb; bank_financial_visible boolean; bank_ready boolean; bank_blockers jsonb; bank_links jsonb;
begin
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'CORRECTION_CURRENT_READ_ISOLATION_REQUIRED' using errcode='55000';end if;
 if private.weekly_source_pay_actor_allowed_v1(p_actor_user_id) is distinct from true then
  raise exception 'CORRECTION_ACTOR_NOT_ALLOWED' using errcode='42501';end if;
 select private.timesheet_contract_move_row_hash_v1(to_jsonb(u)) into actor_hash from public.tms_users u where u.id=p_actor_user_id and u.is_active;
 if actor_hash is null then raise exception 'CORRECTION_ACTOR_NOT_ALLOWED' using errcode='42501';end if;
 select x.* into q from private.timesheet_contract_move_requests x where x.request_id=p_request_id;
 select x.* into o from private.timesheet_contract_move_operations x where x.id=q.operation_id;
 select x.* into r from private.timesheet_contract_move_reviews x where x.id=q.review_id and x.operation_id=o.id;
 if q.request_id is null or q.request_kind is distinct from 'PREVIEW'
  or o.id is null or o.purpose is distinct from 'CONTRACT_CORRECTION' or o.created_by_user_id is distinct from p_actor_user_id
  or r.id is null or r.preview_request_id is distinct from q.request_id or r.preview_request_hash is distinct from q.request_hash
  or r.scope_hash is distinct from o.expected_scope_hash or r.pay_cut_hash is distinct from o.before_pay_cut_hash
  or r.invoice_hash is distinct from o.before_invoice_hash
  or r.manifest_json->>'reason' is distinct from o.reason then raise exception 'CORRECTION_REQUEST_CONFLICT' using errcode='22023';end if;
 physical:=r.manifest_json->'physical';invoice:=r.manifest_json->'invoice';
 -- A stale saved review is not silently refreshed or repriced. Its exact IDs,
 -- immutable hashes/reason remain private; it cannot return an old physical ID
 -- labelled current, or a new Confirm for a changed original request.
 unchanged:=o.state='REVIEWED' and not exists(select 1 from private.timesheet_contract_move_reviews newer
  where newer.operation_id=o.id and newer.review_no>r.review_no) and q.state_revision=o.state_revision;
 if unchanged then
  unchanged:=private.timesheet_contract_move_scope_v1(o.id,false) is not distinct from physical;
 end if;
 if not unchanged then raise exception 'REVIEW_STALE' using errcode='40001';end if;
 @@BANK_PREVIEW_READ@@
 if bank_financial_visible is null or bank_ready is null or jsonb_typeof(bank_blockers) is distinct from 'array'
  or jsonb_typeof(bank_links) is distinct from 'array' then raise exception 'CORRECTION_NATIVE_PREVIEW_UNBOUND' using errcode='55000';end if;
 if not bank_ready and jsonb_array_length(bank_blockers)=0 then raise exception 'CORRECTION_NATIVE_PREVIEW_UNBOUND' using errcode='55000';end if;
 perform private.timesheet_contract_move_public_assert_v1(bank_pay_effect,'EFFECT');
 if not bank_financial_visible and bank_pay_effect is distinct from '{"visibility":"REDACTED"}'::jsonb then
  raise exception 'CORRECTION_FINANCIAL_PROJECTION_DENIED' using errcode='42501';end if;
 perform private.timesheet_contract_move_actions_assert_v1(bank_links);
 preflight:=private.invoice_contract_move_preflight_v1(r.id,p_actor_user_id,false);
 unchanged:=unchanged and private.invoice_contract_move_inspect_v1(physical,p_actor_user_id,false) is not distinct from invoice;
 if not unchanged then raise exception 'REVIEW_STALE' using errcode='40001';end if;
 blockers:=bank_blockers||(preflight->'known_blockers');
 invoice_visible:=exists(select 1 from public.tms_users u where u.id=p_actor_user_id and u.is_active and upper(u.role::text)='ADMIN');
 select coalesce(jsonb_agg(a order by n),'[]'::jsonb) into bank_links
  from jsonb_array_elements(bank_links) with ordinality e(a,n)
  where (invoice_visible or a->>'target_type'<>'INVOICE')
   and (bank_financial_visible or a->>'target_type' not in('BANKING_RUN','NATIVE_TRANSFER','FINANCE_CASE','CONTRACT_MOVE_HISTORY','SOURCE_PAY_DECISION_HISTORY','NATIVE_UNPROTECT_RUN')
    and a->>'kind'<>'RESUME_FINANCIAL');
 -- Actual preflight may name private invoice-line IDs in field_key. Denied
 -- readers receive neither these IDs nor native financial/invoice actions.
 if not invoice_visible or not bank_financial_visible then
  select coalesce(jsonb_agg(jsonb_build_object('code',b->'code','native_owner',b->'native_owner',
   'field_key',null,'permitted_action',null) order by n),'[]'::jsonb) into blockers
   from jsonb_array_elements(blockers) with ordinality e(b,n);
 end if;
 select coalesce(jsonb_agg(b order by b::text),'[]'::jsonb) into blockers from(select distinct value b from jsonb_array_elements(blockers)) unique_blockers;
 ready:=unchanged and bank_ready and preflight->'ready_to_confirm'='true'::jsonb and jsonb_array_length(blockers)=0;
 result:=jsonb_build_object('version','TIMESHEET_CONTRACT_CORRECTION_V3','operation_id',o.id,'review_id',r.id,
  'review_digest',encode(r.review_digest,'hex'),'state_revision',o.state_revision::text,'ready_to_confirm',ready,
  'current_timesheet_id',o.from_timesheet_id,'to_contract_id',o.to_contract_id,
  'summary',jsonb_build_object('worked_facts_preserved',true,'pay_effect',bank_pay_effect,
   'invoice_effect',private.timesheet_contract_move_invoice_effect_v1(invoice,p_actor_user_id)),
  'known_blockers',blockers,'confirm',case when ready then jsonb_build_object('request_version','TIMESHEET_CONTRACT_CORRECTION_V3',
   'review_id',r.id,'review_digest',encode(r.review_digest,'hex'),'expected_state_revision',o.state_revision::text) else null end,'links',bank_links);
 -- Do not mix role/native reads around a concurrent change. Read retry keeps
 -- the same immutable request/review and never changes their stored receipt.
 select private.timesheet_contract_move_row_hash_v1(to_jsonb(u)) into actor_current from public.tms_users u where u.id=p_actor_user_id and u.is_active;
 if actor_hash is distinct from actor_current or private.weekly_source_pay_actor_allowed_v1(p_actor_user_id) is distinct from true
  or to_jsonb(o) is distinct from(select to_jsonb(x) from private.timesheet_contract_move_operations x where x.id=o.id)
  or unchanged and private.timesheet_contract_move_scope_v1(o.id,false) is distinct from physical then
  raise exception 'REVIEW_STALE' using errcode='40001';end if;
 return private.timesheet_contract_move_public_assert_v1(result,'PREVIEW');
end;
$function$;
revoke all on function private.timesheet_contract_move_preview_read_v1(uuid,uuid) from public,anon,authenticated,service_role;

create or replace function private.timesheet_contract_move_preview_replay_v1(p_args jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,public,private,pg_temp
as $function$
declare q private.timesheet_contract_move_requests%rowtype; actor uuid; request_hash bytea;
begin
 perform private.timesheet_contract_move_request_assert_v1(p_args,'PREVIEW');
 actor:=(p_args->>'actor_user_id')::uuid;request_hash:=private.timesheet_contract_move_request_hash_v1(p_args,'PREVIEW');
 if private.weekly_source_pay_actor_allowed_v1(actor) is distinct from true then raise exception 'CORRECTION_ACTOR_NOT_ALLOWED' using errcode='42501';end if;
 select x.* into q from private.timesheet_contract_move_requests x where x.request_id=(p_args->>'request_id')::uuid;
 if not found then return null;end if;
 if q.request_kind is distinct from 'PREVIEW' or q.request_hash is distinct from request_hash or q.receipt_json is null then
  raise exception 'CORRECTION_REQUEST_CONFLICT' using errcode='22023';end if;
 return private.timesheet_contract_move_preview_read_v1(q.request_id,actor);
end;
$function$;
revoke all on function private.timesheet_contract_move_preview_replay_v1(jsonb) from public,anon,authenticated,service_role;
