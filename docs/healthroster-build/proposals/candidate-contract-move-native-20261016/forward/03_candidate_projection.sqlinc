-- Exact Candidate-facing 17-key projection; only authenticated native readers call it.
create or replace function private.candidate_contract_move_facts_v1(p_timesheet jsonb,p_workflows jsonb)
returns jsonb language sql immutable security definer set search_path=pg_catalog,pg_temp
as $function$
 select jsonb_build_object('version','CANDIDATE_MOVE_FACTS_V1',
  'timesheet',jsonb_build_object('week_ending_date',p_timesheet->'week_ending_date',
   'actual_schedule_json',p_timesheet->'actual_schedule_json','worked_start_iso',p_timesheet->'worked_start_iso',
   'worked_end_iso',p_timesheet->'worked_end_iso','worked_minutes',p_timesheet->'worked_minutes',
   'break_start_iso',p_timesheet->'break_start_iso','break_end_iso',p_timesheet->'break_end_iso','break_minutes',p_timesheet->'break_minutes',
   'additional_units_week',p_timesheet->'additional_units_week','additional_units_per_day',p_timesheet->'additional_units_per_day',
   'reference_number',p_timesheet->'reference_number','day_references_json',p_timesheet->'day_references_json'),
  'workflows',coalesce((select jsonb_agg(jsonb_build_object('id',w->'id',
    'immutable_submission_json',w->'immutable_submission_json','input_snapshot_json',w->'input_snapshot_json') order by w->>'id')
    from jsonb_array_elements(p_workflows) w),'[]'::jsonb));
$function$;

create or replace function private.candidate_contract_move_context_v1(
 p_environment text,p_candidate_id uuid,p_timesheet_id uuid,p_workflow_id uuid default null)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,public,private,pg_temp
as $function$
declare a private.timesheet_contract_family_aliases%rowtype; m private.timesheet_contract_move_members%rowtype;
 o private.timesheet_contract_move_operations%rowtype; original_t public.timesheets%rowtype; current_t public.timesheets%rowtype;
 w public.candidate_submission_workflows%rowtype; original_c public.contracts%rowtype; current_c public.contracts%rowtype;
 placement jsonb; snapshot jsonb; source_member jsonb; requested_id uuid:=p_timesheet_id; workflow_ids uuid[];
 inherited jsonb; native_sources jsonb; native_workflows jsonb; current_week_id uuid; original_week_id uuid; dto jsonb;
 current_state text; original_label text; current_label text; original_client text; current_client text;
begin
 p_environment:=private._candidate_assert_environment(p_environment);
 if p_candidate_id is null or p_environment not in('TEST','LIVE') then raise exception 'CANDIDATE_DETAIL_NOT_FOUND' using errcode='P0002';end if;
 if p_workflow_id is not null then
  select v.* into w from public.candidate_submission_workflows v
   where v.id=p_workflow_id and v.candidate_id=p_candidate_id and v.environment=p_environment;
  if not found then raise exception 'CANDIDATE_DETAIL_NOT_FOUND' using errcode='P0002';end if;
  requested_id:=coalesce(requested_id,case when w.workflow_kind='CONTRACT_EXPENSE' or w.rejection_scope='COMPLETE_EXPENSE_CLAIM'
    then coalesce(w.anchor_timesheet_id,w.target_timesheet_id) else coalesce(w.target_timesheet_id,w.anchor_timesheet_id) end);
 end if;
 select v.* into a from private.timesheet_contract_family_aliases v where v.timesheet_id=requested_id;
 if not found then return null;end if;
 -- Candidate ownership precedes strict placement resolution; no alias is a permission grant.
 if not exists(select 1 from private.timesheet_contract_move_operations accepted
  where accepted.id=a.accepted_operation_id and accepted.candidate_id=p_candidate_id and accepted.state in('COMPLETE','SUPERSEDED')) then
  raise exception 'CANDIDATE_DETAIL_NOT_FOUND' using errcode='P0002';end if;
 placement:=private.timesheet_contract_current_placement_v1(requested_id);
 select v.* into strict current_t from public.timesheets v where v.timesheet_id=(placement->>'current_timesheet_id')::uuid;
 select v.* into strict original_t from public.timesheets v where v.timesheet_id=a.original_timesheet_id;
 select v.* into strict a from private.timesheet_contract_family_aliases v where v.timesheet_id=current_t.timesheet_id;
 select v.* into strict m from private.timesheet_contract_move_members v where v.operation_id=a.accepted_operation_id and v.member_key=a.member_key;
 select v.* into strict o from private.timesheet_contract_move_operations v where v.id=m.operation_id and v.state='COMPLETE';
 select v.* into original_c from public.contracts v where v.id=original_t.contract_id and v.candidate_id=p_candidate_id;
 select v.* into current_c from public.contracts v where v.id=current_t.contract_id and v.candidate_id=p_candidate_id;
 if original_c.id is null or current_c.id is null or original_c.client_id<>o.actual_client_id or current_c.client_id<>o.actual_client_id
  or o.candidate_id<>p_candidate_id then raise exception 'CANDIDATE_DETAIL_NOT_FOUND' using errcode='P0002';end if;
 snapshot:=private.timesheet_contract_move_evidence_v1(original_t.timesheet_id);
 if private.timesheet_contract_move_row_hash_v1(snapshot) is distinct from m.immutable_evidence_hash then
  raise exception 'CONTRACT_MOVE_ORIGINAL_EVIDENCE_CHANGED' using errcode='23514';end if;
 select value into source_member from private.timesheet_contract_move_reviews r
  cross join lateral jsonb_array_elements(r.manifest_json#>'{physical,members}') value
  where r.id=o.accepted_review_id and r.operation_id=o.id and value->>'member_key'=m.member_key
   and m.member_hash=private.timesheet_contract_move_row_hash_v1(value);
 if source_member is null then raise exception 'CONTRACT_MOVE_MEMBER_UNBOUND' using errcode='23514';end if;
 perform private.candidate_contract_move_evidence_snapshot_assert_v1((source_member->>'from_timesheet_id')::uuid,source_member->'from_evidence');
 select coalesce(array_agg(distinct v.id order by v.id),'{}'::uuid[]) into workflow_ids
  from public.candidate_submission_workflows v where v.candidate_id=p_candidate_id and v.environment=p_environment
   and (v.id=any(m.workflow_ids) or v.id=current_t.candidate_workflow_id
    or v.target_timesheet_id=current_t.timesheet_id or v.anchor_timesheet_id=current_t.timesheet_id);
 if cardinality(workflow_ids)<>cardinality(m.workflow_ids) + (select count(*) from unnest(workflow_ids) id where not id=any(m.workflow_ids))
  or p_workflow_id is not null and not p_workflow_id=any(workflow_ids) then
  raise exception 'CANDIDATE_MOVE_WORKFLOW_UNBOUND' using errcode='23514';end if;
 native_sources:=private.candidate_contract_move_sources_v1(workflow_ids);
 -- Actual immutable source fields are rechecked, including older uploaded receipt
 -- IDs reached through the real source_component_id edge; no synthetic PDF hash.
 with all_sources as (
  select value from jsonb_array_elements(snapshot->'submission_sources')
  union select value from jsonb_array_elements(native_sources)
 ) select coalesce(jsonb_agg(jsonb_build_object('kind',c.component_kind,'id',c.id,
   'version',c.workflow_generation::text,'sha256',encode(c.source_content_sha256,'hex')) order by c.id),'[]'::jsonb)
  into inherited from all_sources s join public.candidate_submission_components c on c.id=(s.value->>'id')::uuid
   and private.candidate_contract_move_component_source_v1(to_jsonb(c))=s.value
  where c.workflow_id=any(workflow_ids) and c.immutable_at_utc is not null and c.source_content_sha256 is not null;
 select coalesce(jsonb_agg(jsonb_build_object('id',v.id,'immutable_submission_json',v.immutable_submission_json,
   'input_snapshot_json',v.input_snapshot_json) order by v.id),'[]'::jsonb)
  into native_workflows from public.candidate_submission_workflows v where v.id=any(workflow_ids);
 select v.id into current_week_id from public.contract_weeks v where v.timesheet_id=current_t.timesheet_id
  and v.contract_id=current_t.contract_id and v.week_ending_date=current_t.week_ending_date;
 select v.id into original_week_id from public.contract_weeks v where v.timesheet_id=original_t.timesheet_id
  and v.contract_id=original_t.contract_id and v.week_ending_date=original_t.week_ending_date;
 if current_week_id is null then raise exception 'CANDIDATE_MOVE_CURRENT_WEEK_UNBOUND' using errcode='23514';end if;
 select v.name into original_client from public.clients v where v.id=original_c.client_id;
 select v.name into current_client from public.clients v where v.id=current_c.client_id;
 original_label:=concat_ws(' · ',original_client,nullif(original_c.role,''),nullif(original_c.band,''),nullif(original_c.display_site,''),original_c.start_date::text||'–'||original_c.end_date::text);
 current_label:=concat_ws(' · ',current_client,nullif(current_c.role,''),nullif(current_c.band,''),nullif(current_c.display_site,''),current_c.start_date::text||'–'||current_c.end_date::text);
 current_state:=case when o.financial_state='REVIEW_REQUIRED' then 'FINANCIAL_REVIEW'
  when current_t.authorised_at_server is not null then 'APPROVED'
  when exists(select 1 from public.candidate_submission_workflows v where v.id=any(workflow_ids)
   and v.workflow_kind in('CONTRACT_HOURS','CONTRACT_COMBINED') and v.state in('CREATED','WORKER_DRAFT')) then 'PENDING'
  when exists(select 1 from public.candidate_submission_workflows v where v.id=any(workflow_ids)
   and v.candidate_signed_at_utc is not null and v.state not in('DRAFT','WORKER_DRAFT','CANCELLED','REJECTED'))
   or original_t.r2_nurse_key is not null then 'SIGNED' else 'PENDING' end;
 dto:=jsonb_build_object('version','CANDIDATE_CONTRACT_MOVE_V1','operation_id',o.id,'family_root_id',a.family_root_id,
  'placement_revision',placement->'placement_revision','original_timesheet_id',original_t.timesheet_id,'current_timesheet_id',current_t.timesheet_id,
  'original_contract_label',original_label,'current_contract_label',current_label,'moved_at_utc',to_char(o.completed_at_utc at time zone 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"'),
  'evidence_origin_timesheet_id',original_t.timesheet_id,'current_mutable_timesheet_id',current_t.timesheet_id,'inherited_evidence',inherited,
  'original_detail_target',jsonb_build_object('identity_kind','TIMESHEET','id',original_t.timesheet_id,'path','/candidate-app/v1/timesheets/'||original_t.timesheet_id::text),
  'current_detail_target',jsonb_build_object('identity_kind','TIMESHEET','id',current_t.timesheet_id,'path','/candidate-app/v1/timesheets/'||current_t.timesheet_id::text),
  'unchanged_facts_sha256',encode(private.timesheet_contract_move_row_hash_v1(private.candidate_contract_move_facts_v1(to_jsonb(current_t),native_workflows)),'hex'),
  'current_state',current_state,'is_history',requested_id<>current_t.timesheet_id);
 return jsonb_build_object('dto',dto,'workflow_ids',to_jsonb(workflow_ids),'current_week_id',current_week_id,
  'original_week_id',original_week_id,'source_member',source_member,'original_evidence',snapshot);
end;
$function$;
