create or replace function private.weekly_source_pay_decision_application_finish_v1(p_application_id uuid)
returns bytea language plpgsql volatile security definer
set search_path=pg_catalog,private,public as $function$
declare
 v_app private.weekly_source_pay_decision_acceptance_applications%rowtype;
 v_request private.weekly_source_pay_decision_requests%rowtype;
 v_decision private.weekly_source_pay_decisions%rowtype;
 v_member jsonb;v_member_row private.weekly_source_pay_decision_members%rowtype;
 v_issue uuid;v_native jsonb;v_publications jsonb;v_links jsonb;v_contact jsonb;v_hash bytea;
begin
 select a.* into strict v_app from private.weekly_source_pay_decision_acceptance_applications a
  where a.id=p_application_id and a.state='STAGED' and a.backend_pid=pg_backend_pid()
   and a.transaction_id=pg_current_xact_id() for update;
 select r.* into strict v_request from private.weekly_source_pay_decision_requests r
  where r.request_id=v_app.request_id and r.decision_id=v_app.decision_id and r.review_id=v_app.review_id
   and r.actor_user_id=v_app.actor_user_id and r.metadata_state='COMMITTED' and r.receipt_json is not null;
 select d.* into strict v_decision from private.weekly_source_pay_decisions d
  where d.id=v_app.decision_id and d.accept_request_id is not null and d.current_financial_cut_id=v_app.cut_id
   and d.invoice_before_hash=d.invoice_after_hash;
 if v_request.receipt_json->>'version' is distinct from 'SOURCE_PAY_DECISION_RECEIPT_V1'
  or v_request.receipt_json->>'decision_id' is distinct from v_app.decision_id::text
  or v_request.receipt_json->>'request_id' is distinct from v_app.request_id::text
  or v_request.receipt_json->>'review_id' is distinct from v_app.review_id::text
  or jsonb_typeof(v_request.receipt_json->'members') is distinct from 'array'
  or not exists(select 1 from private.bpay_next_source_pay_decision_cut c
    join private.weekly_source_pay_decision_reviews r on r.id=c.review_id and r.decision_id=c.decision_id
     and r.preview_assembly_id=c.preview_assembly_id
    join private.weekly_source_pay_decision_preview_assemblies a on a.id=c.preview_assembly_id
     and a.review_id=r.id and a.decision_id=c.decision_id and a.state='SEALED'
    where c.id=v_app.cut_id and c.decision_id=v_app.decision_id and c.review_id=v_app.review_id
     and r.pay_cut_hash=v_app.pre_cut_sha256) then
  raise exception 'SOURCE_PAY_DECISION_FINAL_RECEIPT_INVALID' using errcode='23514';
 end if;
 perform private.weekly_source_pay_decision_publication_adoptions_assert_v1(v_app.id);
 -- Every logical member of this exact immutable cut appears once. A short or
 -- duplicated public receipt cannot hide an unverified invoice/contact outcome.
 if (select count(*) from jsonb_array_elements(v_request.receipt_json->'members'))
    <> (select count(distinct m.value->>'member_key') from jsonb_array_elements(v_request.receipt_json->'members') m)
  or (select coalesce(jsonb_agg(m.value->>'member_key' order by m.value->>'member_key'),'[]'::jsonb)
       from jsonb_array_elements(v_request.receipt_json->'members') m)
    is distinct from (select coalesce(jsonb_agg(s.member_key order by s.member_key),'[]'::jsonb)
       from (select distinct c.member_key from private.bpay_next_source_pay_decision_cut_member c where c.cut_id=v_app.cut_id) s) then
  raise exception 'SOURCE_PAY_DECISION_FINAL_MEMBER_SET_INVALID' using errcode='23514';
 end if;
 if exists(select 1 from private.bpay_next_source_pay_decision_publication p
  left join private.bpay_next_command c on c.id=p.command_id
  left join private.bpay_next_command_member cm on cm.command_id=c.id and cm.candidate_id=p.candidate_id
  where p.application_id=v_app.id and (p.decision_id<>v_app.decision_id or p.cut_id<>v_app.cut_id
    or c.id is null or cm.command_id is null or c.command_kind<>'SOURCE_PAY_DECISION_APPLY'
    or c.status not in('SEALED','COMPLETE') or c.sealed_at_utc is null)) then
  raise exception 'SOURCE_PAY_DECISION_FINAL_PUBLICATION_INVALID' using errcode='23514';
 end if;
 for v_member in select m.value from jsonb_array_elements(v_request.receipt_json->'members') m loop
  select m.* into strict v_member_row from private.weekly_source_pay_decision_members m
   where m.decision_id=v_app.decision_id and m.member_key=v_member->>'member_key';
  if v_member->'invoice_certificate' is distinct from v_member_row.source_invoice_certificate_json then
   raise exception 'SOURCE_PAY_DECISION_FINAL_INVOICE_CERTIFICATE_INVALID' using errcode='23514';
  end if;
  -- The invoice owner reads original immutable allocation/amount/document facts.
  -- All required native locks were acquired by acceptance_begin; no new late
  -- invoice lock is taken while an application metadata row is held.
  perform private.weekly_source_invoice_certificate_assert_v1(v_member->'invoice_certificate',false);
  if jsonb_typeof(v_member->'retired_issue_ids') is distinct from 'array' then
   raise exception 'SOURCE_PAY_DECISION_CONTACT_RECEIPT_INVALID' using errcode='23514';
  end if;
  if (select count(*) from jsonb_array_elements_text(v_member->'retired_issue_ids'))
    <> (select count(distinct i.value) from jsonb_array_elements_text(v_member->'retired_issue_ids') i) then
   raise exception 'SOURCE_PAY_DECISION_CONTACT_RECEIPT_INVALID' using errcode='23514';
  end if;
  for v_issue in select value::text::uuid from jsonb_array_elements_text(v_member->'retired_issue_ids') loop
   if not(v_issue=any(v_member_row.contact_issue_ids)) or not exists(select 1 from public.weekly_discrepancy_incidents i
    where i.id=v_issue and i.candidate_id=v_member_row.candidate_id and i.client_id=v_member_row.actual_client_id
     and i.state='RESOLVED') then
    raise exception 'SOURCE_PAY_DECISION_CONTACT_RECEIPT_INVALID' using errcode='23514';
   end if;
  end loop;
 end loop;
 select coalesce(jsonb_agg(to_jsonb(n) order by n.member_key),'[]'::jsonb) into v_native
  from private.weekly_source_pay_decision_native_adoptions n where n.application_id=v_app.id;
 select coalesce(jsonb_agg(jsonb_build_object('publication',to_jsonb(p),'members',(
   select coalesce(jsonb_agg(to_jsonb(pm) order by pm.member_no),'[]'::jsonb)
    from private.bpay_next_source_pay_decision_publication_member pm where pm.command_id=p.command_id))
   order by p.candidate_id),'[]'::jsonb) into v_publications
  from private.bpay_next_source_pay_decision_publication p where p.application_id=v_app.id;
 select coalesce(jsonb_agg(to_jsonb(b) order by b.command_id,b.publication_member_no,b.member_key),'[]'::jsonb) into v_links
  from private.weekly_source_pay_decision_publication_adoptions b where b.application_id=v_app.id;
 select coalesce(jsonb_agg(to_jsonb(i) order by i.id),'[]'::jsonb) into v_contact
  from public.weekly_discrepancy_incidents i where i.id in(
   select retired.value::uuid from jsonb_array_elements(v_request.receipt_json->'members') m,
    lateral jsonb_array_elements_text(m.value->'retired_issue_ids') retired);
 v_hash:=private.weekly_source_sha256_jsonb_v1('SOURCE_PAY_DECISION_ACCEPTANCE_APPLICATION_V1',
  jsonb_build_object('application_id',v_app.id,'decision_id',v_app.decision_id,'review_id',v_app.review_id,
   'cut_id',v_app.cut_id,'request_id',v_app.request_id,'actor_user_id',v_app.actor_user_id,
   'pre_cut_sha256',encode(v_app.pre_cut_sha256,'hex'),'pre_witness_sha256',encode(v_app.pre_witness_sha256,'hex'),
   'pre_witness_manifest',v_app.pre_witness_manifest_json,'native_adoptions',v_native,
   'publications',v_publications,'publication_adoptions',v_links,'selected_contact_outcomes',v_contact,
   'invoice_before_hash',encode(v_decision.invoice_before_hash,'hex'),
   'invoice_after_hash',encode(v_decision.invoice_after_hash,'hex'),'receipt',v_request.receipt_json));
 update private.weekly_source_pay_decision_acceptance_applications a set state='COMMITTED',
  application_sha256=v_hash,completed_at_utc=transaction_timestamp()
  where a.id=v_app.id and a.state='STAGED' and a.request_id=v_request.request_id
   and a.backend_pid=pg_backend_pid() and a.transaction_id=pg_current_xact_id();
 if not found then raise exception 'SOURCE_PAY_DECISION_APPLICATION_CAS_FAILED' using errcode='40001'; end if;
 return v_hash;
exception when no_data_found or too_many_rows then
 raise exception 'SOURCE_PAY_DECISION_FINAL_RECEIPT_INVALID' using errcode='23514';
end;
$function$;
revoke all on function private.weekly_source_pay_decision_application_finish_v1(uuid)
 from public,anon,authenticated,service_role;
