create or replace function public.weekly_source_keep_as_paid_decide_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_keys constant text[]:=array['schema_version','actor_user_id','work_event_id','decision',
    'reason','credit_invoice_line_id','expected_facts_fingerprint','idempotency_key'];
  v_actor uuid; v_event_id uuid; v_credit uuid; v_reason text; v_key text; v_expected bytea; v_request_hash bytea;
  v_event public.weekly_work_events%rowtype; v_decision public.weekly_source_kept_as_paid_decisions%rowtype;
  v_audit public.audit_events%rowtype; v_context jsonb; v_roots uuid[]; v_locks jsonb;
  v_facts bytea; v_sequence bigint; v_acknowledged_at timestamptz; v_result jsonb; v_audit_payload jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if jsonb_typeof(p_request) is distinct from 'object' or not p_request ?& v_keys
    or p_request-v_keys<>'{}'::jsonb or p_request->>'schema_version' is distinct from 'WEEKLY_SOURCE_KEEP_AS_PAID_REQUEST_V1'
    or p_request->>'decision' is distinct from 'KEEP_AS_PAID'
    or jsonb_typeof(p_request->'actor_user_id') is distinct from 'string'
    or jsonb_typeof(p_request->'work_event_id') is distinct from 'string'
    or jsonb_typeof(p_request->'reason') is distinct from 'string'
    or jsonb_typeof(p_request->'idempotency_key') is distinct from 'string'
    or jsonb_typeof(p_request->'expected_facts_fingerprint') is distinct from 'string'
    or p_request->>'expected_facts_fingerprint' !~ '^[0-9a-f]{64}$' then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_REQUEST_INVALID' using errcode='22023'; end if;
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid; v_event_id:=(p_request->>'work_event_id')::uuid;
    v_credit:=(p_request->>'credit_invoice_line_id')::uuid;
    v_expected:=decode(p_request->>'expected_facts_fingerprint','hex');
  exception when invalid_text_representation then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_REQUEST_INVALID' using errcode='22023'; end;
  v_reason:=p_request->>'reason'; v_key:=btrim(p_request->>'idempotency_key');
  if v_actor is null or v_event_id is null or v_reason not in ('CREDITED','NOT_INVOICED_DISAPPEARED')
    or char_length(v_key) not between 16 and 200
    or (v_reason='CREDITED') is distinct from (v_credit is not null)
    or (v_reason='CREDITED' and jsonb_typeof(p_request->'credit_invoice_line_id') is distinct from 'string')
    or (v_reason<>'CREDITED' and p_request->'credit_invoice_line_id' is distinct from 'null'::jsonb) then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_REQUEST_INVALID' using errcode='22023'; end if;
  -- Native active payment authority precedes even an exact historical replay.
  -- A former authoriser cannot use the service dispatcher to read its old ACK.
  if private.weekly_source_pay_actor_allowed_v1(v_actor) is distinct from true then
    raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
  -- Include the actual actor and complete reviewed request. Old-key collision
  -- never becomes a fresh acknowledgement or a different user's replay.
  v_request_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_KEEP_AS_PAID_REQUEST_V1',p_request);
  select audit.* into v_audit from public.audit_events audit
    where audit.action='WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED'
      and audit.object_type='weekly_source_kept_as_paid_decisions'
      and audit.after_json->>'idempotency_key'=v_key
    order by audit.ts_utc,audit.id limit 1;
  if found then
    if v_audit.actor_user_id is distinct from v_actor or v_audit.object_id_text is distinct from v_event_id::text
      or v_audit.after_json->>'schema_version' is distinct from 'WEEKLY_SOURCE_KEEP_AS_PAID_ACK_V1'
      or v_audit.after_json->>'request_sha256' is distinct from encode(v_request_hash,'hex')
      or v_audit.after_json->'request' is distinct from p_request then
      raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_IDEMPOTENCY_COLLISION' using errcode='22023'; end if;
    return v_audit.after_json->'result'||jsonb_build_object('idempotent_replay',true);
  end if;
  select * into strict v_event from public.weekly_work_events where id=v_event_id;
  v_context:=private.weekly_source_kept_as_paid_context_v1(v_event.id,v_actor);
  perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',v_event.first_source_group_id,
    v_event.client_id,(v_context->>'finalisation_week_ending')::date);
  perform private.weekly_source_pay_query_admit_v2();
  select coalesce(array_agg(value::uuid order by value::uuid),'{}'::uuid[]) into v_roots
    from jsonb_array_elements_text(v_context->'root_timesheet_ids') value;
  if cardinality(v_roots)=0 then raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_ROOT_UNAVAILABLE' using errcode='55000'; end if;
  -- Same native I-1 candidate/family boundary as accepted publication. The
  -- purpose-bound acknowledgement gates follow it, before any business rows.
  v_locks:=private.weekly_source_lock_and_resolve_families_v1(v_event.candidate_id,v_roots,
    'WORKBENCH_CANDIDATE_ENTITLEMENT_PUBLICATION',gen_random_uuid(),'WEEKLY_SOURCE_ENTITLEMENT_PUBLICATION');
  if v_locks->>'ok' is distinct from 'true' or v_locks->>'gate' is distinct from 'GRANTED' then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  perform pg_advisory_xact_lock(hashtextextended('weekly-source-kept-as-paid-request:'||v_key,0));
  perform pg_advisory_xact_lock(hashtextextended('weekly-source-kept-as-paid-event:'||v_event.id::text,0));
  select audit.* into v_audit from public.audit_events audit
    where audit.action='WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED'
      and audit.object_type='weekly_source_kept_as_paid_decisions' and audit.after_json->>'idempotency_key'=v_key
    order by audit.ts_utc,audit.id limit 1;
  if found then
    if v_audit.actor_user_id is distinct from v_actor or v_audit.object_id_text is distinct from v_event_id::text
      or v_audit.after_json->>'schema_version' is distinct from 'WEEKLY_SOURCE_KEEP_AS_PAID_ACK_V1'
      or v_audit.after_json->>'request_sha256' is distinct from encode(v_request_hash,'hex')
      or v_audit.after_json->'request' is distinct from p_request then
      raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_IDEMPOTENCY_COLLISION' using errcode='22023'; end if;
    return v_audit.after_json->'result'||jsonb_build_object('idempotent_replay',true);
  end if;
  perform 1 from public.weekly_source_groups where id=v_event.first_source_group_id for update;
  perform 1 from public.weekly_source_cycles where id=(v_context->>'source_cycle_id')::uuid for update;
  perform 1 from public.weekly_work_events where id=v_event.id for share;
  v_context:=private.weekly_source_kept_as_paid_context_v1(v_event.id,v_actor);
  if v_context->'root_timesheet_ids' is distinct from to_jsonb(v_roots) then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_SCOPE_CHANGED' using errcode='40001'; end if;
  perform private.weekly_source_office_authority_v1(v_actor,'APPROVE_PROTECTED_PAY',v_event.first_source_group_id,
    v_event.client_id,(v_context->>'finalisation_week_ending')::date);
  v_facts:=private.weekly_source_kept_as_paid_facts_v1(v_event.id,v_reason);
  if v_facts is distinct from v_expected or v_context->>'facts_fingerprint' is distinct from encode(v_facts,'hex')
    or v_context->>'reason' is distinct from v_reason then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_FACTS_CHANGED' using errcode='40001'; end if;
  if v_context->'source_present' is distinct from 'false'::jsonb
    or v_context->'current_pay_head_movement_id'='null'::jsonb
    or not (v_context->'invoiced'='true'::jsonb or v_context->'paid'='true'::jsonb)
    or (v_reason='NOT_INVOICED_DISAPPEARED' and v_context->'invoiced' is distinct from 'false'::jsonb)
    or (v_reason='CREDITED' and not exists(select 1 from jsonb_array_elements(v_context->'credit_lines') line
      where line->>'invoice_line_id'=v_credit::text)) then
    raise exception 'WEEKLY_SOURCE_KEEP_AS_PAID_NOT_ELIGIBLE' using errcode='55000'; end if;
  insert into public.weekly_source_kept_as_paid_decisions(work_event_id,decision,reason,credit_invoice_line_id,
    facts_fingerprint,actor_user_id) values(v_event.id,'KEEP_AS_PAID',v_reason,v_credit,v_facts,v_actor)
    on conflict do nothing;
  select * into strict v_decision from public.weekly_source_kept_as_paid_decisions
    where work_event_id=v_event.id and reason=v_reason and credit_invoice_line_id is not distinct from v_credit
      and facts_fingerprint=v_facts;
  -- A→B→A with a NEW reviewed request links the immutable A decision but
  -- appends a new actual acknowledgement. No old record/timestamp is updated.
  select coalesce(max((audit.after_json->>'acknowledgement_sequence')::bigint),0)+1 into v_sequence
    from public.audit_events audit where audit.action='WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED'
      and audit.object_type='weekly_source_kept_as_paid_decisions' and audit.object_id_text=v_event.id::text;
  v_acknowledged_at:=clock_timestamp();
  v_result:=jsonb_build_object('ok',true,'decision','KEEP_AS_PAID','decision_id',v_decision.id,
    'work_event_id',v_event.id,'reason',v_reason,'credit_invoice_line_id',v_credit,
    'facts_fingerprint',encode(v_facts,'hex'),'actor_user_id',v_actor,'acknowledged_at_utc',v_acknowledged_at,
    'acknowledgement_sequence',v_sequence,'idempotent_replay',false,'pay_changed',false,'invoice_changed',false);
  v_audit_payload:=jsonb_build_object('schema_version','WEEKLY_SOURCE_KEEP_AS_PAID_ACK_V1','decision_id',v_decision.id,
    'work_event_id',v_event.id,'reason',v_reason,'credit_invoice_line_id',v_credit,'facts_fingerprint',encode(v_facts,'hex'),
    'actor_user_id',v_actor,'acknowledged_at_utc',v_acknowledged_at,'acknowledgement_sequence',v_sequence,
    'idempotency_key',v_key,'request_sha256',encode(v_request_hash,'hex'),'request',p_request,'result',v_result,
    'native_backend_pid',pg_backend_pid(),'native_transaction_id',txid_current()::text);
  perform public._audit_insert('weekly_source_kept_as_paid_decisions',v_event.id::text,
    'WEEKLY_SOURCE_KEEP_AS_PAID_ACKNOWLEDGED',null,v_audit_payload,'Keep as paid',v_actor);
  return v_result;
end;
$function$;
alter function public.weekly_source_keep_as_paid_decide_atomic_v1(jsonb) owner to postgres;
revoke all on function public.weekly_source_keep_as_paid_decide_atomic_v1(jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_keep_as_paid_decide_atomic_v1(jsonb) to service_role;
