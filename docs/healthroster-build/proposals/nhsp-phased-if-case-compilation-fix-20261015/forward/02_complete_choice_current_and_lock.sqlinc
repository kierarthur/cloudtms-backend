-- Re-read the single immutable Office choice with its real journal and audit.
-- A current viewer proves current authority; the original confirmer is never
-- substituted as the current actor. Raw financial facts have one producer.
create or replace function private.weekly_source_paid_overlap_choice_current_v1(
  p_upload_row_id uuid,p_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_choice private.weekly_source_office_row_choices%rowtype;
  v_journal private.weekly_source_office_rechecks%rowtype;
  v_audit public.audit_events%rowtype;v_count integer;
  v_saved jsonb;v_observed jsonb;v_match jsonb;v_result jsonb;v_recorded jsonb;v_immutable jsonb;
  v_revision public.weekly_source_final_revisions%rowtype;v_cycle public.weekly_source_cycles%rowtype;
  v_compare_side integer;v_compare_actor uuid;
  v_compare_inputs jsonb;v_compare_item jsonb;v_compare_basis jsonb;v_compare_bases jsonb;
  v_compare_overlaps jsonb;v_compare_observed jsonb;v_compare_saved jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_actor_user_id is null then raise exception 'WEEKLY_SOURCE_ACTOR_REQUIRED' using errcode='42501';end if;
  v_immutable:=private.weekly_source_paid_choice_immutable_v1(p_upload_row_id);
  if v_immutable is null then return null;end if;
  v_choice:=pg_catalog.jsonb_populate_record(null::private.weekly_source_office_row_choices,v_immutable->'choice');
  v_journal:=pg_catalog.jsonb_populate_record(null::private.weekly_source_office_rechecks,v_immutable->'journal');
  v_saved:=v_immutable->'admission';
  select revision.* into v_revision from public.weekly_source_final_revisions revision
    join public.weekly_source_cycles cycle on cycle.id=revision.source_cycle_id
    join public.weekly_source_uploads upload on upload.id=revision.upload_id and upload.source_cycle_id=cycle.id
    join public.weekly_source_upload_rows source_row on source_row.upload_id=upload.id
    left join public.weekly_source_report_scopes scope on scope.id=upload.report_scope_id
      and scope.source_cycle_id=cycle.id and scope.source_group_id=cycle.source_group_id
    where source_row.id=p_upload_row_id and revision.state='CURRENT'
      and ((revision.authority_scope_kind='CYCLE' and revision.report_scope_id is null
          and upload.report_scope_id is null and cycle.current_final_revision_id=revision.id)
        or (revision.authority_scope_kind='NHSP_REPORT_SCOPE' and scope.self_bill_report_id is null
          and revision.report_scope_id=scope.id and scope.current_final_revision_id=revision.id
          and exists(select 1 from public.weekly_source_format_profiles profile
            where profile.id=upload.source_format_profile_id and profile.profile_code='NHSP_FINAL_BACKING_V1')));
  if found then
    select * into strict v_cycle from public.weekly_source_cycles where id=v_revision.source_cycle_id;
    perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
      v_cycle.source_group_id,v_choice.client_id,v_cycle.finalisation_week_ending);
    v_recorded:=v_revision.paid_overlap_choice_census->p_upload_row_id::text;
    if v_recorded->>'choice_id' is distinct from v_choice.id::text
      or v_recorded->>'choice_proof_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1',v_recorded-'choice_proof_sha256'),'hex') then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_FINAL_CENSUS_UNBOUND' using errcode='55000';end if;
    -- Actual finalisation, capture and invoice admission may change current
    -- header/binding facts. This is its original recorded confirmation only;
    -- it is never accepted as fresh projection/finalisation admission.
    v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_OVERLAP_RECORDED_CHOICE_V1',
      'choice_id',v_choice.id,'upload_row_id',v_choice.upload_row_id,'candidate_id',v_choice.candidate_id,
      'client_id',v_choice.client_id,'contract_id',v_choice.contract_id,'pay_effect',v_choice.pay_effect,
      'paid_overlap_target_work_event_id',v_choice.paid_overlap_target_work_event_id,
      'confirmed_by_actor_user_id',v_choice.actor_user_id,'viewer_actor_user_id',p_actor_user_id,
      'recorded_final_revision_id',v_revision.id,'recorded_choice_proof',v_recorded,
      'confirmation_request_id',v_journal.request_id,'reason',v_choice.match_reason,'recorded_only',true);
    return v_result||jsonb_build_object('recorded_choice_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PAID_OVERLAP_RECORDED_CHOICE_V1',v_result),'hex'));
  end if;
  v_observed:=private.weekly_source_paid_overlap_candidates_v1(p_upload_row_id,p_actor_user_id,
    v_choice.candidate_id,v_choice.client_id);
  -- Validate both complete raw reader proofs before comparing facts. The
  -- immutable confirmation keeps its original actor; current native facts are
  -- read under this viewer's independently proved authority, never that actor.
  -- Only the two literal actor-bound fields of the existing Legacy INPUT
  -- producer are omitted for equality. Its whole native financial/member
  -- payload, unknown fields and every NEXT page remain byte-for-byte JSONB
  -- facts. This is not a recursive actor/key scrub or a new paid classifier.
  for v_compare_side in 0..1 loop
    v_compare_inputs:=case when v_compare_side=0 then v_observed else v_saved->'inputs' end;
    v_compare_actor:=case when v_compare_side=0 then p_actor_user_id else v_choice.actor_user_id end;
    if jsonb_typeof(v_compare_inputs) is distinct from 'object'
      or v_compare_inputs->>'schema_version' is distinct from 'WEEKLY_SOURCE_PAID_OVERLAP_INPUTS_V1'
      or v_compare_inputs->>'actor_user_id' is distinct from v_compare_actor::text
      or jsonb_typeof(v_compare_inputs->'overlaps') is distinct from 'array'
      or v_compare_inputs->>'inputs_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_PAID_OVERLAP_INPUTS_V1',v_compare_inputs-'inputs_sha256'),'hex') then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_UNBOUND' using errcode='55000';end if;
    v_compare_overlaps:='[]'::jsonb;
    for v_compare_item in select value from jsonb_array_elements(v_compare_inputs->'overlaps') loop
      if v_compare_item ? 'nhsp_negative_population' then
        -- Compare only the closed rederived NHSP semantic facts locally.
        -- Both raw witnesses/audit generations remain untouched below.
        v_compare_item:=jsonb_set(v_compare_item,'{nhsp_negative_population}',
          private.weekly_source_nhsp_negative_comparison_v1(v_compare_item->'nhsp_negative_population'),false);
      end if;
      if jsonb_typeof(v_compare_item#>'{native_payment_facts,native_paid_basis}') is distinct from 'array' then
        raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_UNBOUND' using errcode='55000';end if;
      v_compare_bases:='[]'::jsonb;
      for v_compare_basis in select value from jsonb_array_elements(v_compare_item#>'{native_payment_facts,native_paid_basis}') loop
        if v_compare_basis->>'schema_version'='WEEKLY_SOURCE_LEGACY_SIGNED_SOURCE_MEMBERSHIP_INPUT_V1' then
          if v_compare_basis->>'actor_user_id' is distinct from v_compare_actor::text
            or v_compare_basis->>'inputs_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
              'WEEKLY_SOURCE_LEGACY_SIGNED_SOURCE_MEMBERSHIP_INPUT_V1',v_compare_basis-'inputs_sha256'),'hex') then
            raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_UNBOUND' using errcode='55000';end if;
          v_compare_basis:=v_compare_basis-'actor_user_id'-'inputs_sha256';
        end if;
        v_compare_bases:=v_compare_bases||jsonb_build_array(v_compare_basis);
      end loop;
      v_compare_item:=jsonb_set(v_compare_item,'{native_payment_facts,native_paid_basis}',v_compare_bases,false);
      v_compare_overlaps:=v_compare_overlaps||jsonb_build_array(v_compare_item);
    end loop;
    v_compare_inputs:=jsonb_set(v_compare_inputs,'{overlaps}',v_compare_overlaps,false)-'actor_user_id'-'inputs_sha256';
    if v_compare_side=0 then v_compare_observed:=v_compare_inputs;else v_compare_saved:=v_compare_inputs;end if;
  end loop;
  if v_compare_observed is distinct from v_compare_saved then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_FACTS_CHANGED' using errcode='40001';end if;
  select item into v_match from jsonb_array_elements(v_observed->'overlaps') item
    where item->>'work_event_id'=v_choice.paid_overlap_target_work_event_id::text;
  if v_match is null or (case when v_match ? 'nhsp_negative_population' then
      v_match#>>'{current_native_position,schema_version}' is distinct from 'WEEKLY_SOURCE_NHSP_CURRENT_OVERLAP_POSITION_INPUT_V1'
      or v_match#>>'{current_native_position,state}' is distinct from 'CURRENT_NATIVE_POSITION'
      or v_match#>'{current_native_position,work_event_id}' is distinct from v_match->'work_event_id'
      or v_match#>'{current_native_position,contract_id}' is distinct from v_match->'contract_id'
      or v_match#>'{current_native_position,native_current_basis_sha256}' is distinct from v_match#>'{nhsp_negative_population,native_current_basis,inputs_sha256}'
      or v_match#>'{nhsp_negative_population,negative_population_complete}' is distinct from 'true'::jsonb
      or v_match#>'{nhsp_negative_population,current_position_available}' is distinct from 'true'::jsonb
      or v_match#>'{nhsp_negative_population,no_reversal_proved}' is distinct from 'true'::jsonb
      or v_match#>'{nhsp_negative_population,paid_writer_permission}' is distinct from 'null'::jsonb
      else v_match#>>'{current_pay_snapshot,state}' is distinct from 'CURRENT'
    or v_match#>>'{current_pay_snapshot,snapshot_line_id}' is distinct from v_match->>'snapshot_line_id'
    or v_match#>>'{current_pay_snapshot,movement_id}' is distinct from v_match->>'current_pay_head_movement_id' end)
    or v_match#>'{native_payment_facts,paid}' is distinct from 'true'::jsonb
    or (v_match#>>'{native_payment_facts,paid_evidence_state}') is null or (v_match#>>'{native_payment_facts,paid_evidence_state}') not in ('SETTLED_ORIGINAL','SETTLED_LEGACY_SOURCE_COMPONENT')
    or (v_choice.pay_effect='NONE' and (v_choice.work_event_id is distinct from v_choice.paid_overlap_target_work_event_id
      or v_match->>'contract_id' is distinct from v_choice.contract_id::text))
    or (v_choice.pay_effect='NORMAL' and (not v_choice.separate_shift or v_choice.work_event_id is not null)) then
    raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_UNBOUND' using errcode='55000';end if;
  v_result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1',
    'choice_id',v_choice.id,'upload_row_id',v_choice.upload_row_id,'candidate_id',v_choice.candidate_id,
    'client_id',v_choice.client_id,'contract_id',v_choice.contract_id,'pay_effect',v_choice.pay_effect,
    'paid_overlap_target_work_event_id',v_choice.paid_overlap_target_work_event_id,
    'confirmed_by_actor_user_id',v_choice.actor_user_id,'viewer_actor_user_id',p_actor_user_id,
    'confirmation_request_id',v_journal.request_id,'confirmation_request_sha256',encode(v_journal.request_hash,'hex'),
    'reason',v_choice.match_reason,'inputs',v_observed);
  return v_result||jsonb_build_object('choice_proof_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1',v_result),'hex'));
end;
$function$;
alter function private.weekly_source_paid_overlap_choice_current_v1(uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_paid_overlap_choice_current_v1(uuid,uuid) from public,anon,authenticated,service_role;

-- Discover the entire upload's confirmed choice set before the existing scope
-- gate, then acquire complete native I-1 families in Candidate UUID order.
-- The caller re-proves this whole set after its retained gate/group/cycle locks.
create or replace function private.weekly_source_paid_overlap_projection_lock_v1(
  p_upload_id uuid,p_actor_user_id uuid,p_publication_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_row uuid;v_choice jsonb;v_choices jsonb:='[]'::jsonb;v_candidate uuid;v_roots uuid[];v_lock jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  for v_row in select r.id from public.weekly_source_upload_rows r
    join lateral(select c.* from private.weekly_source_office_row_choices c
      where c.upload_row_id=r.id order by c.id desc limit 1) choice on true
    where r.upload_id=p_upload_id and choice.paid_overlap_target_work_event_id is not null order by r.id
  loop
    if exists(select 1 from public.weekly_source_uploads u join public.weekly_source_format_profiles p on p.id=u.source_format_profile_id
      where u.id=p_upload_id and u.report_scope_id is not null and p.profile_code='NHSP_FINAL_BACKING_V1') then
      v_choice:=private.weekly_source_nhsp_projection_lock_input_v1(v_row,p_actor_user_id,p_publication_id);
    else
    v_choice:=private.weekly_source_paid_overlap_choice_current_v1(v_row,p_actor_user_id);
    end if;
    if v_choice is null or coalesce(v_choice->>'schema_version','') not in
      ('WEEKLY_SOURCE_PAID_OVERLAP_CURRENT_CHOICE_V1','WEEKLY_SOURCE_NHSP_PROJECTION_LOCK_INPUT_V1') then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_CHOICE_CHANGED' using errcode='40001';end if;
    v_choices:=v_choices||jsonb_build_array(v_choice);
  end loop;
  if jsonb_array_length(v_choices)=0 then return '[]'::jsonb;end if;
  perform private.weekly_source_pay_query_admit_v2();
  for v_candidate in select distinct (c->>'candidate_id')::uuid from jsonb_array_elements(v_choices) c order by 1
  loop
    select array_agg(distinct root::uuid order by root::uuid) into v_roots
      from jsonb_array_elements(v_choices) c
      cross join lateral jsonb_array_elements(c#>'{inputs,overlaps}') item
      cross join lateral jsonb_array_elements_text(item#>'{native_payment_facts,root_timesheet_ids}') root
      where (c->>'candidate_id')::uuid=v_candidate;
    if coalesce(cardinality(v_roots),0)=0 then raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_ROOT_UNAVAILABLE' using errcode='55000';end if;
    v_lock:=private.weekly_source_lock_and_resolve_families_v1(v_candidate,v_roots,
      'WORKBENCH_CANDIDATE_ENTITLEMENT_PUBLICATION',p_publication_id,'WEEKLY_SOURCE_ENTITLEMENT_PUBLICATION');
    if v_lock->>'ok' is distinct from 'true' or v_lock->>'gate' is distinct from 'GRANTED' then
      raise exception 'WEEKLY_SOURCE_PAID_OVERLAP_SCOPE_UNAVAILABLE' using errcode='55000';end if;
  end loop;
  return v_choices;
end;
$function$;
alter function private.weekly_source_paid_overlap_projection_lock_v1(uuid,uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_paid_overlap_projection_lock_v1(uuid,uuid,uuid) from public,anon,authenticated,service_role;
