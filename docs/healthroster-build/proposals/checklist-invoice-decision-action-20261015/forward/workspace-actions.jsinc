      <label class="ws-confirm"><input type="checkbox" data-wsa-invoice-confirm${state.confirmed?' checked':''}${state.busy?' disabled':''}><span>Release this invoice hold using the selected billing choice.</span></label>
      ${state.error?`<p role="alert">${escapeHtml(state.error)}</p>`:''}<div class="ws-child-actions"><button type="button" class="btn btn-outline" data-wsa-invoice-close>Cancel</button>
      <button type="button" class="btn primary" data-wsa-invoice-submit${state.confirmed&&!state.busy?'':' disabled'}>${state.pending?'Retry exact request':'Release invoice hold'}</button></div></div>`;
    setTimeout(wire,0);return typeof root.html==='function'?root.html(markup):markup;
