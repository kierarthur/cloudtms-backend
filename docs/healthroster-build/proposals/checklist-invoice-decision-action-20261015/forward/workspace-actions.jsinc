      `<label><input type="radio" name="ws-invoice-release-choice" data-wsa-invoice-choice value="${value}"${state.choice===value?' checked':''}${state.busy||state.pending?' disabled':''}><span>${label}</span></label>`).join('');
    const markup=`<div class="ws-child" data-wsa-screen="invoice-decision"><p>The amount with VAT in this export line does not equal its net plus 20% VAT. Choose how this line should be billed.</p>
