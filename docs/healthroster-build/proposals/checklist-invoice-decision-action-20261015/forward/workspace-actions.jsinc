    &&SESSION.user.id===actorId&&JSON.stringify(SESSION.user.roles)===roles&&JSON.stringify([SESSION.user.role,SESSION.user.is_active])===flags&&workspaceApi()===workspace&&detail.callerCurrent()===true;
