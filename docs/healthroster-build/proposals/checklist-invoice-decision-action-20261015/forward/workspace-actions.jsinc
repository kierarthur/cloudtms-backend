  const wire=()=>{
    if(!current())return;const host=root.document?.querySelector('[data-wsa-screen="invoice-decision"]');if(!host||host.dataset.wsaWired==='1')return;host.dataset.wsaWired='1';
    host.querySelector('[data-wsa-invoice-close]')?.addEventListener('click',()=>{if(current())closeChild();});
    host.querySelectorAll('[data-wsa-invoice-choice]').forEach(input=>input.addEventListener('change',()=>{
      if(!current()||state.busy||state.pending||!action.choices.includes(input.value))return;state.choice=input.value;state.confirmed=false;rerender(kind);
    }));
    host.querySelector('[data-wsa-invoice-confirm]')?.addEventListener('change',event=>{if(!current()||state.busy)return;state.confirmed=event.target.checked;
      host.querySelector('[data-wsa-invoice-submit]').disabled=!state.confirmed||state.busy;});
    host.querySelector('[data-wsa-invoice-submit]')?.addEventListener('click',async()=>{
      if(!current()||!state.confirmed||state.busy)return;
      if(!state.pending)state.pending={upload_row_id:action.upload_row_id,source_cycle_id:action.scope.source_cycle_id,report_scope_id:null,
        expected_source_row_hash:action.expected_source_row_hash,expected_authority_scope_version:action.expected_authority_scope_version,hold_kind:'VAT_FIT',action:state.choice};
      state.busy=true;state.error='';rerender(kind);
      try {
        const result=await workspace.issueCommand('RELEASE_INVOICE_HOLD',JSON.parse(JSON.stringify(state.pending)));
        if(!current())return;
        const keys=['ok','contract','status','idempotent','release_id','upload_row_id','hold_kind','action','net_pence','vat_pence','gross_pence'];
        const uuid=v=>typeof v==='string'&&/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(v);
        if(!result||typeof result!=='object'||Array.isArray(result)||Object.keys(result).length!==keys.length||!keys.every(k=>Object.prototype.hasOwnProperty.call(result,k))
          ||result.ok!==true||result.contract!=='WEEKLY_SOURCE_INVOICE_HOLD_RELEASE_V1'||result.status!=='RELEASED'||typeof result.idempotent!=='boolean'
          ||!uuid(result.release_id)||result.upload_row_id!==action.upload_row_id||result.hold_kind!=='VAT_FIT'||result.action!==state.pending.action
          ||!['net_pence','vat_pence','gross_pence'].every(k=>Number.isSafeInteger(result[k])))throw new Error('Unconfirmed invoice decision');
        markCompletedChildClean();closeChild();
        if(!sessionCurrent()||!parentCurrent())return;
        root.__toast?.('Invoice hold released.');await detail.returnTo();
        if(!sessionCurrent()||!parentCurrent())return;
      }catch{
        if(!current())return;state.error='The invoice decision result could not be confirmed. Retry this exact request, or close and refresh the Checklist.';
      }finally{state.busy=false;if(current())rerender(kind);}
    });
  };
  root.modalCtx=context;root.showModal('Review invoice hold',[{key:'main',label:'Review invoice hold'}],renderTab,null,false,wire,
    {kind,noParentGate:true,showSave:false,showApply:false,runOnRender:true});
  return !!frame&&current();
}

  function handleAction(detailValue) {
    const detail = asObject(detailValue);
    const label = asText(detail.label);
    if (detail.kind === 'CHECKLIST_INVOICE_HOLD_DECISION') return openChecklistInvoiceDecision(detail);
    if (detail.kind === 'CHECK_ONLY_D10_CANDIDATE_REMINDER') return openCheckOnlyD10Reminder(detail);
    if (detail.kind === 'CHECK_ONLY_D10_REVIEW') {
      const actorId = typeof SESSION !== 'undefined' ? SESSION?.user?.id : null;
      const action = normaliseCheckOnlyD10ReviewAction(detail.payload, actorId);
      if (!action || label !== 'View details' || detail.enabled === false || typeof root.CloudTmsImportReviewV1?.openReview !== 'function') {
        return openDetail({ detail: { problem: 'This HealthRoster query could not be verified. Return to Queries and recheck.' } }, 'View details');
      }
      const workspace = workspaceApi();
      return root.CloudTmsImportReviewV1.openReview(action.action_bindings[0].import_id, {
        checkOnlyD10Action: action, skipAutoRecheck: true,
        returnTo: () => (typeof SESSION !== 'undefined' ? SESSION?.user?.id : null) === actorId
          && workspaceApi() === workspace ? workspace?.refresh?.('queries') : undefined,
        view: action.action_bindings.every(binding => ['EMAIL_ISSUE','EMAIL_REMINDER'].includes(binding.action_kind)) ? 'EMAIL' : 'PENDING'
      });
    }
    if (label === 'Retry recheck' && detail.command === 'RECHECK_SOURCE' && detail.payload?.request_id) return openCommand(detail);
    if(label==='Send to Pay Queries'||label==='Send back to Queries')return openManualReview({...asObject(detail.payload),...asObject(detail.context)});
    if(label==='View'&&detail.payload?.upload_id)return openUploadDetail(detail.payload);
    if (label === 'Confirm paid shift match') return openPaidMatch(detail.payload);
    if (label === 'Confirm shift match') return openProtectedMatch(detail.payload);
    if (['Review protected pay', 'Review and reconcile'].includes(label)) return openProtectedReview(detail.payload);
    if (['Protect pay', 'Add protected shift', 'Change protected shift'].includes(label)) {
      return openProtectedShift(detail.payload, label === 'Change protected shift' ? 'amend' : 'approve');
    }
    if (['Link candidate','Link client'].includes(label) && detail.payload?.recheck_payload?.request_id) {
      const picker = label === 'Link candidate' ? root.openCandidatePicker : root.openClientPicker;
      if (typeof picker !== 'function') return openDetail({ detail: { problem: 'The matching picker is unavailable. Refresh the page and try again.' } }, label);
      const field = label === 'Link candidate' ? 'candidate_id' : 'client_id';
      const initiatingActor = typeof SESSION !== 'undefined' ? SESSION?.user?.id : null;
      const workspace = workspaceApi();
      const parentFrame = (root.__modalStack || []).at(-1);
      const pickerKind = label === 'Link candidate' ? 'candidate-picker' : 'client-picker';
      return picker(async ({ id, candidate }) => {
        const stack = root.__modalStack || [];
        if (!initiatingActor || (typeof SESSION !== 'undefined' ? SESSION?.user?.id : null) !== initiatingActor
          || workspaceApi() !== workspace || stack.at(-2) !== parentFrame || !currentChild(pickerKind)) return;
        if (label === 'Link candidate' && candidate?.active === false) {
          throw new Error('This candidate is currently inactive. Reactivate their Candidate record before linking this shift.');
        }
        const request = JSON.parse(JSON.stringify({ ...detail.payload.recheck_payload, [field]: asText(id) }));
        // Let the existing picker close, then present the exact selected choice.
        // This schedules a screen only; a separate deliberate click sends it.
        setTimeout(() => {
          if ((root.__modalStack || []).at(-1) !== parentFrame || workspaceApi() !== workspace
            || (typeof SESSION !== 'undefined' ? SESSION?.user?.id : null) !== initiatingActor) return;
          openCommand({ label, command: 'RECHECK_SOURCE', payload: request, context: detail.context });
        }, 0);
      }, { title: label, seed_hint: { display_name: detail.payload.candidate },
        seed_query: label === 'Link candidate' ? asText(detail.payload.candidate).split(/\s+/).filter(Boolean).at(-1) : '',
        context: { staffName: detail.payload.candidate, unit: detail.payload.client, dateYmd: detail.payload.shift,
          sourceReference: detail.payload.detail?.source_reference,
          bookingReference: detail.payload.detail?.booking_reference } });
    }
    if (label === 'View Timesheet' && typeof root.openTimesheet === 'function') {
      return root.openTimesheet({ timesheet_id: asText(detail.payload?.timesheet_id) });
    }
    if (label === 'Email manager') {
      const importId = asText(detail.payload?.import_id);
      if (importId && typeof root.CloudTmsImportReviewV1?.openReview === 'function') {
        return root.CloudTmsImportReviewV1.openReview(importId);
      }
      return openDetail({ detail: { problem: 'The manager correction review is unavailable.',
        guidance: 'Refresh the source checks before opening this action.' } }, 'View details');
    }
    if (label === 'Correct final source') return openCorrectFinal(detail.payload);
    if (label === 'Choose contract') return openContractChooser(detail.payload);
    if (label === 'Review' || label === 'Review pricing') {
      if (detail.payload?.preview) return openPreview(detail.payload.preview);
      return openDetail(detail.payload, label);
    }
    if ((label === 'Create contract' || label === 'Create contract for this band') && typeof root.openContract === 'function') {
      const seed = asObject(detail.payload?.contract_seed);
      if (Object.keys(seed).length) return root.openContract(seed, { noParentGate: true });
    }
    if (['View','View final source','View details','Open','Open charge details','Review source details','View query'].includes(label)) return openDetail(detail.payload, label);
    if (detail.command || ['Remind candidate','Remind missing timesheet','Accept system hours','No shifts to import','Protect pay'].includes(label)) return openCommand(detail);
    return openDetail({ detail: { problem: 'This action is not available yet.', guidance: 'Recheck the Weekly source screen and try again.' } }, 'View details');
  }

  return Object.freeze({
    CONTRACT, normalisePreview, renderPreview, buildUploadAcceptancePayload, normalisePaidMatch, buildPaidMatchRequest,
    normaliseDetail, renderDetail, normaliseContractChooser, renderContractChooser,
    normaliseCorrectFinal, normaliseCorrectFinalPreview, renderCorrectFinal, renderCommandConfirmation,
    openPreview, openBatchPreview, handleAction, _plainMessage: plainMessage,
    _test: Object.freeze({ commandAuthorityAvailable, isCandidateComparisonAmbiguity })
  });
});
