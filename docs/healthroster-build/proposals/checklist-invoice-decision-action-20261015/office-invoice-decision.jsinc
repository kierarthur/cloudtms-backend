// One purpose-bound caller for the existing native invoice release owner.
function normaliseChecklistInvoiceDecision(value,actorId) {
  const closed=(v,keys)=>v!==null&&typeof v==='object'&&!Array.isArray(v)&&Object.keys(v).length===keys.length&&keys.every(k=>Object.prototype.hasOwnProperty.call(v,k));
  const uuid=v=>typeof v==='string'&&/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(v),hash=v=>typeof v==='string'&&/^[0-9a-f]{64}$/.test(v);
  const date=v=>typeof v==='string'&&/^\d{4}-\d{2}-\d{2}$/.test(v)&&Number.isFinite(Date.parse(v+'T00:00:00Z'))&&new Date(v+'T00:00:00Z').toISOString().slice(0,10)===v;
  if(!closed(value,['contract','actor_user_id','permission_view','scope','billing_movement_id','client_manifest_id','upload_row_id',
    'expected_source_row_hash','expected_authority_scope_version','hold_kind','decision_read_proof_hash','choices'])
    ||value.contract!=='WEEKLY_SOURCE_CHECKLIST_INVOICE_HOLD_DECISION_ACTION_V1'||!uuid(actorId)||value.actor_user_id!==actorId||value.permission_view!=='ADMIN'
    ||!closed(value.scope,['source_group_id','source_cycle_id','client_id','week_ending'])
    ||!['source_group_id','source_cycle_id','client_id'].every(k=>uuid(value.scope[k]))||!date(value.scope.week_ending)
    ||!['billing_movement_id','client_manifest_id','upload_row_id'].every(k=>uuid(value[k]))
    ||!hash(value.expected_source_row_hash)||!hash(value.decision_read_proof_hash)||!Number.isSafeInteger(value.expected_authority_scope_version)
    ||value.expected_authority_scope_version<0||value.hold_kind!=='VAT_FIT'||!Array.isArray(value.choices)||value.choices.length!==2
    ||value.choices[0]!=='BILL_AT_NET_PLUS_20'||value.choices[1]!=='BILL_AS_FILE')return null;
  return JSON.parse(JSON.stringify(value));
}
function openChecklistInvoiceDecision(detail) {
  const session=typeof SESSION!=='undefined'?SESSION:null,user=session?.user,actorId=user?.id;
  const roles=JSON.stringify(user?.roles),flags=JSON.stringify([user?.role,user?.is_active]),workspace=workspaceApi();
  const action=normaliseChecklistInvoiceDecision(detail.payload,actorId);
  if(detail.label!=='Review invoice hold'||detail.enabled!==true||!action||user?.is_active!==true||String(user?.role??'').trim().toLowerCase()!=='admin'
    ||typeof workspace?.issueCommand!=='function'||typeof detail.returnTo!=='function'||typeof detail.callerCurrent!=='function'||detail.callerCurrent()!==true||typeof root.showModal!=='function')
    return openDetail({detail:{problem:'This invoice decision could not be verified. Refresh the Checklist before continuing.'}},'View details');
  const sessionCurrent=()=>!!session&&!!user&&(typeof SESSION!=='undefined'?SESSION:null)===session&&SESSION.user===user
    &&SESSION.user.id===actorId&&JSON.stringify(SESSION.user.roles)===roles&&JSON.stringify([SESSION.user.role,SESSION.user.is_active])===flags&&workspaceApi()===workspace&&detail.callerCurrent()===true;
  const parents=Array.isArray(root.__modalStack)?root.__modalStack.slice():[],parentTokens=parents.map(p=>p._token),kind='weekly-source-checklist-invoice-decision-v1';
  const context={entity:'weekly-source-child',data:{},weeklySourceChildKind:kind};
  const state={choice:'BILL_AT_NET_PLUS_20',confirmed:false,busy:false,error:'',pending:null};let frame=null,token=null;
  const parentCurrent=()=>parents.length===(root.__modalStack||[]).length&&parents.every((p,i)=>root.__modalStack[i]===p&&p._token===parentTokens[i]);
  const current=()=>sessionCurrent()&&!!frame&&frame._token===token&&(root.__modalStack||[]).length===parents.length+1
    &&parents.every((p,i)=>root.__modalStack[i]===p&&p._token===parentTokens[i])&&(root.__modalStack||[]).at(-1)===frame;
  const renderTab=()=>{
    if(!sessionCurrent())return '';
    if(!frame){const stack=root.__modalStack||[],child=stack.at(-1);
      if(stack.length!==parents.length+1||!parents.every((p,i)=>stack[i]===p&&p._token===parentTokens[i])||child?.kind!==kind
        ||child.renderTab!==renderTab||child._ctxRef!==context)return '';frame=child;token=child._token;}
    if(!current())return '';
    const choices=[['BILL_AT_NET_PLUS_20','Bill at net + 20%'],['BILL_AS_FILE','Bill as in the file']].map(([value,label])=>
      `<label><input type="radio" name="ws-invoice-release-choice" data-wsa-invoice-choice value="${value}"${state.choice===value?' checked':''}${state.busy||state.pending?' disabled':''}><span>${label}</span></label>`).join('');
    const markup=`<div class="ws-child" data-wsa-screen="invoice-decision"><p>The amount with VAT in this export line does not equal its net plus 20% VAT. Choose how this line should be billed.</p>
      ${detail.context?.client?`<p>${escapeHtml(detail.context.client)}</p>`:''}<div class="ws-child-fields">${choices}</div>
      <label class="ws-confirm"><input type="checkbox" data-wsa-invoice-confirm${state.confirmed?' checked':''}${state.busy?' disabled':''}><span>Release this invoice hold using the selected billing choice.</span></label>
      ${state.error?`<p role="alert">${escapeHtml(state.error)}</p>`:''}<div class="ws-child-actions"><button type="button" class="btn btn-outline" data-wsa-invoice-close>Cancel</button>
      <button type="button" class="btn primary" data-wsa-invoice-submit${state.confirmed&&!state.busy?'':' disabled'}>${state.pending?'Retry exact request':'Release invoice hold'}</button></div></div>`;
    setTimeout(wire,0);return typeof root.html==='function'?root.html(markup):markup;
  };
  const wire=()=>{
    if(!current())return;const host=root.document?.querySelector('[data-wsa-screen="invoice-decision"]');if(!host||host.dataset.wsaWired==='1')return;host.dataset.wsaWired='1';
    host.querySelector('[data-wsa-invoice-close]')?.addEventListener('click',()=>{if(current())closeChild();});
    host.querySelectorAll('[data-wsa-invoice-choice]').forEach(input=>input.addEventListener('change',()=>{
      if(!current()||state.busy||state.pending||!action.choices.includes(input.value))return;state.choice=input.value;state.confirmed=false;rerender(kind);
    }));
    host.querySelector('[data-wsa-invoice-confirm]')?.addEventListener('change',event=>{if(!current()||state.busy)return;state.confirmed=event.target.checked;
      host.querySelector('[data-wsa-invoice-submit]').disabled=!state.confirmed||state.busy;});
    host.querySelector('[data-wsa-invoice-submit]')?.addEventListener('click',async()=>{
      if(!current()||!state.confirmed||state.busy)return;
      if(!state.pending)state.pending={upload_row_id:action.upload_row_id,source_cycle_id:action.scope.source_cycle_id,report_scope_id:null,
        expected_source_row_hash:action.expected_source_row_hash,expected_authority_scope_version:action.expected_authority_scope_version,hold_kind:'VAT_FIT',action:state.choice};
      state.busy=true;state.error='';rerender(kind);
      try {
        const result=await workspace.issueCommand('RELEASE_INVOICE_HOLD',JSON.parse(JSON.stringify(state.pending)));
        if(!current())return;
        const keys=['ok','contract','status','idempotent','release_id','upload_row_id','hold_kind','action','net_pence','vat_pence','gross_pence'];
        const uuid=v=>typeof v==='string'&&/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(v);
        if(!result||typeof result!=='object'||Array.isArray(result)||Object.keys(result).length!==keys.length||!keys.every(k=>Object.prototype.hasOwnProperty.call(result,k))
          ||result.ok!==true||result.contract!=='WEEKLY_SOURCE_INVOICE_HOLD_RELEASE_V1'||result.status!=='RELEASED'||typeof result.idempotent!=='boolean'
          ||!uuid(result.release_id)||result.upload_row_id!==action.upload_row_id||result.hold_kind!=='VAT_FIT'||result.action!==state.pending.action
          ||!['net_pence','vat_pence','gross_pence'].every(k=>Number.isSafeInteger(result[k])))throw new Error('Unconfirmed invoice decision');
        markCompletedChildClean();closeChild();
        if(!sessionCurrent()||!parentCurrent())return;
        root.__toast?.('Invoice hold released.');await detail.returnTo();
        if(!sessionCurrent()||!parentCurrent())return;
      }catch{
        if(!current())return;state.error='The invoice decision result could not be confirmed. Retry this exact request, or close and refresh the Checklist.';
      }finally{state.busy=false;if(current())rerender(kind);}
    });
  };
  root.modalCtx=context;root.showModal('Review invoice hold',[{key:'main',label:'Review invoice hold'}],renderTab,null,false,wire,
    {kind,noParentGate:true,showSave:false,showApply:false,runOnRender:true});
  return !!frame&&current();
}
