create or replace function private.weekly_source_rule_qualification_execute_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare actor uuid; cycle_id uuid; auth jsonb; req jsonb; op text; purpose text; frame jsonb; result jsonb;
  command_id uuid:=gen_random_uuid(); stack text; parent_scope jsonb; completion jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  get diagnostics stack=pg_context;
  if stack !~ 'PL/pgSQL function (public\.)?weekly_source_group_rule_feature_set_atomic_v1\(jsonb\)' then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_CONTROLLED_OWNER_REQUIRED' using errcode='42501'; end if;
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['actor_user_id','agency_id','environment','qualification_action',
    'source_cycle_id','native_operation','native_request']) or p_request->>'qualification_action' is distinct from 'OFF_RULE_COMMAND'
    or p_request->>'environment' is distinct from 'TEST' or jsonb_typeof(p_request->'native_request') is distinct from 'object' then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_COMMAND_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid;cycle_id:=(p_request->>'source_cycle_id')::uuid;op:=p_request->>'native_operation';req:=p_request->'native_request';
  if op in ('weekly_source_office_recheck_begin_v1','weekly_source_upload_context_v1','weekly_source_upload_stage_begin_atomic_v1','weekly_source_upload_stage_rows_atomic_v1',
    'weekly_source_upload_seal_atomic_v1','weekly_source_projection_begin_atomic_v1','weekly_source_projection_rows_apply_atomic_v1',
    'weekly_source_projection_publish_atomic_v1','weekly_source_import_prepare_atomic_v1','weekly_source_finalise_atomic_v1',
    'weekly_source_finalisation_pay_open_atomic_v1','weekly_source_finalisation_pay_task_start_atomic_v1',
    'weekly_source_ordinary_pay_projection_apply_atomic_v1','weekly_source_finalisation_pay_task_finish_atomic_v1','REPORT_FIN_AB_FINALISE','weekly_source_agency_timesheet_change_v1','weekly_source_agency_change_worker_context_v1','weekly_source_agency_change_worker_apply_v1','weekly_source_agency_validation_context_v1','weekly_source_agency_validation_apply_v1','weekly_source_agency_change_authorise_step_v1','weekly_source_agency_change_return_step_v1') then
    purpose:='SOURCE_FIXTURE_SETUP';
  elsif op in ('weekly_source_automatic_reconcile_atomic_v1','weekly_exceptional_pay_prepare_action_v1',
    'weekly_exceptional_pay_action_context_v1','weekly_exceptional_pay_action_publication_status_v1',
    'weekly_exceptional_pay_stage_c1_request_v1','weekly_source_missing_accept_context_v1','weekly_source_missing_accept_prepare_atomic_v1','weekly_source_later_change_decide_atomic_v1') then purpose:='AUTOMATIC_JOURNEY';
  else raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_OPERATION_REFUSED' using errcode='42501'; end if;
  if op='weekly_source_later_change_decide_atomic_v1' and req->>'decision' is distinct from 'APPROVE_UPDATED_HOURS' then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_OPERATION_REFUSED' using errcode='42501';end if;
  auth:=private.weekly_source_rule_qualification_authorization_v1(cycle_id,actor,purpose);
  if auth->>'agency_id' is distinct from p_request->>'agency_id' or not(auth->'allowed_operations' @> jsonb_build_array(op))
    or (req ? 'actor_user_id' and req->>'actor_user_id' is distinct from actor::text)
    or (req ? 'p_actor_user_id' and req->>'p_actor_user_id' is distinct from actor::text)
    or (req ? 'source_cycle_id' and req->>'source_cycle_id' is distinct from cycle_id::text)
    or (req ? 'source_group_id' and req->>'source_group_id' is distinct from auth->>'source_group_id')
    or (req ? 'client_id' and not(auth#>'{fixture_manifest,client_ids}' @> jsonb_build_array((req->>'client_id')::uuid))) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_COMMAND_SCOPE_REFUSED' using errcode='42501'; end if;
  -- Nonwaiting same-scope gate precedes OPEN revalidation. It remains held
  -- through native dispatch/completion until transaction end. No group/row
  -- lock is acquired ahead of native I1; a CLOSE holder returns busy here.
  if not pg_try_advisory_xact_lock(hashtextextended('weekly-source-off-rule-test:'||(auth->>'scope_id'),0)) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SCOPE_BUSY' using errcode='55P03'; end if;
  perform private.weekly_source_rule_qualification_scope_assert_v1(auth,actor,false);
  if op in ('weekly_source_agency_timesheet_change_v1','weekly_source_agency_change_worker_context_v1','weekly_source_agency_change_worker_apply_v1','weekly_source_agency_validation_context_v1','weekly_source_agency_validation_apply_v1','weekly_source_agency_change_authorise_step_v1','weekly_source_agency_change_return_step_v1') then
    perform private.weekly_source_off_rule_agency_parent_v1(op,req,actor,true);
  end if;
  parent_scope:=private.weekly_source_off_rule_native_parent_scope_v1(req,actor,auth);
  if exists(select 1 from public.audit_events audit where audit.object_type='weekly_source_off_rule_command'
    and audit.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_ADMITTED' and audit.event_sequence_is_authoritative
    and audit.after_json->>'transaction_id'=pg_current_xact_id()::text and audit.after_json->>'backend_pid'=pg_backend_pid()::text
    and not exists(select 1 from public.audit_events closed where closed.object_type=audit.object_type and closed.object_id_text=audit.object_id_text
      and closed.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_COMPLETED' and closed.event_sequence_is_authoritative)) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_COMMAND_NESTED' using errcode='55000'; end if;
  frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_OFF_RULE_COMMAND_V1','command_id',command_id,
    'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid()::text,'source_cycle_id',cycle_id,'actor_user_id',actor,
    'authorization',auth,'native_operation',op,'native_request_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_OFF_RULE_NATIVE_REQUEST_V1',req),'hex'),'native_parent_scope',parent_scope,'operational_ready',false);
  if op='weekly_exceptional_pay_prepare_action_v1' then frame:=frame||jsonb_build_object('native_prepare_request',req); end if;
  frame:=frame||jsonb_build_object('command_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_COMMAND_V1',frame),'hex'));
  perform public._audit_insert('weekly_source_off_rule_command',command_id::text,'WEEKLY_SOURCE_OFF_RULE_COMMAND_ADMITTED',null,frame,'Controlled OFF fixture native command',actor);
  case op
    when 'weekly_source_office_recheck_begin_v1' then result:=public.weekly_source_office_recheck_begin_v1(req);
    when 'weekly_source_upload_context_v1' then result:=public.weekly_source_upload_context_v1(req);
    when 'weekly_source_upload_stage_begin_atomic_v1' then result:=public.weekly_source_upload_stage_begin_atomic_v1(req);
    when 'weekly_source_upload_stage_rows_atomic_v1' then result:=public.weekly_source_upload_stage_rows_atomic_v1(req);
    when 'weekly_source_upload_seal_atomic_v1' then result:=public.weekly_source_upload_seal_atomic_v1(req);
    when 'weekly_source_projection_begin_atomic_v1' then result:=public.weekly_source_projection_begin_atomic_v1(req);
    when 'weekly_source_projection_rows_apply_atomic_v1' then result:=public.weekly_source_projection_rows_apply_atomic_v1(
      (req->>'p_actor_user_id')::uuid,(req->>'p_publication_id')::uuid,req->'p_rows');
    when 'weekly_source_projection_publish_atomic_v1' then result:=public.weekly_source_projection_publish_atomic_v1(req);
    when 'weekly_source_import_prepare_atomic_v1' then result:=public.weekly_source_import_prepare_atomic_v1(req);
    when 'weekly_source_finalise_atomic_v1' then result:=public.weekly_source_finalise_atomic_v1(req);
    when 'weekly_source_finalisation_pay_open_atomic_v1' then result:=public.weekly_source_finalisation_pay_open_atomic_v1(req);
    when 'weekly_source_finalisation_pay_task_start_atomic_v1' then result:=public.weekly_source_finalisation_pay_task_start_atomic_v1(req);
    when 'weekly_source_ordinary_pay_projection_apply_atomic_v1' then result:=public.weekly_source_ordinary_pay_projection_apply_atomic_v1(req);
    when 'weekly_source_finalisation_pay_task_finish_atomic_v1' then result:=public.weekly_source_finalisation_pay_task_finish_atomic_v1(req);
    when 'REPORT_FIN_AB_FINALISE' then result:=private.weekly_source_rule_report_fixture_finalise_v1(auth,req);
    when 'weekly_source_agency_timesheet_change_v1' then result:=public.weekly_source_agency_timesheet_change_v1(
      (req->>'p_contract_week_id')::uuid,req->>'p_reason',req->>'p_expected_signature',req->>'p_request_key',(req->>'p_actor_user_id')::uuid);
    when 'weekly_source_agency_change_worker_context_v1' then result:=public.weekly_source_agency_change_worker_context_v1((req->>'p_request_id')::uuid);
    when 'weekly_source_agency_change_worker_apply_v1' then result:=public.weekly_source_agency_change_worker_apply_v1(
      (req->>'p_request_id')::uuid,(req->>'p_expected_request_version')::bigint,req->>'p_expected_context_sha256',req->'p_snapshot');
    when 'weekly_source_agency_validation_context_v1' then result:=public.weekly_source_agency_validation_context_v1((req->>'p_request_id')::uuid);
    when 'weekly_source_agency_validation_apply_v1' then result:=public.weekly_source_agency_validation_apply_v1(
      (req->>'p_request_id')::uuid,(req->>'p_expected_request_version')::bigint,req->>'p_expected_context_sha256',req->'p_snapshot');
    when 'weekly_source_agency_change_authorise_step_v1' then result:=public.weekly_source_agency_change_authorise_step_v1(
      (req->>'p_request_id')::uuid,(req->>'p_actor_user_id')::uuid);
    when 'weekly_source_agency_change_return_step_v1' then result:=public.weekly_source_agency_change_return_step_v1(
      (req->>'p_request_id')::uuid,(req->>'p_actor_user_id')::uuid);
    when 'weekly_source_automatic_reconcile_atomic_v1' then result:=public.weekly_source_automatic_reconcile_atomic_v1(req);
    when 'weekly_exceptional_pay_prepare_action_v1' then result:=public.weekly_exceptional_pay_prepare_action_v1(req);
    when 'weekly_exceptional_pay_action_context_v1' then result:=public.weekly_exceptional_pay_action_context_v1(req);
    when 'weekly_exceptional_pay_action_publication_status_v1' then result:=public.weekly_exceptional_pay_action_publication_status_v1(req);
    when 'weekly_exceptional_pay_stage_c1_request_v1' then result:=public.weekly_exceptional_pay_stage_c1_request_v1(req);
    when 'weekly_source_missing_accept_context_v1' then result:=public.weekly_source_missing_accept_context_v1(req);
    when 'weekly_source_missing_accept_prepare_atomic_v1' then result:=public.weekly_source_missing_accept_prepare_atomic_v1(req);
    when 'weekly_source_later_change_decide_atomic_v1' then result:=public.weekly_source_later_change_decide_atomic_v1(req);
  end case;
  -- The command frame is closed even for a legal native refusal result. Errors
  -- abort the whole command/audit transaction; a later session starts afresh.
  completion:=jsonb_build_object('command_id',command_id,'command_sha256',frame->>'command_sha256','native_result_sha256',
    encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_NATIVE_RESULT_V1',result),'hex'),'operational_ready',false);
  if op='weekly_exceptional_pay_prepare_action_v1' then
    if result->>'source_cycle_id' is distinct from cycle_id::text or result->>'family_id' is distinct from req->>'family_id'
      or result->>'work_event_id' is distinct from req->>'work_event_id'
      or not exists(select 1 from public.weekly_exceptional_orchestration_runs r where r.id=(result->>'orchestration_run_id')::uuid
        and r.family_id=(req->>'family_id')::uuid and r.requested_by_user_id=actor
        and r.request_fingerprint=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_PREPARE_ACTION_REQUEST_V1',req)) then
      raise exception 'WEEKLY_SOURCE_OFF_RULE_PREPARE_RESULT_CHANGED' using errcode='42501'; end if;
    completion:=completion||jsonb_build_object('native_prepare_result',result);
  end if;
  perform public._audit_insert('weekly_source_off_rule_command',command_id::text,'WEEKLY_SOURCE_OFF_RULE_COMMAND_COMPLETED',frame,
    completion,'Controlled OFF fixture native command complete',actor);
  return result;
end;
$function$;
