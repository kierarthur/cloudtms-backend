-- Exact private native pending accessor, for existing bound-origin consumers
-- before unmatched/fallback handling. Corrupt registered pending never returns NULL.
create or replace function private.timesheet_contract_native_pending_for_v1(p_timesheet_id uuid)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,public,private,pg_temp
as $function$
declare p private.timesheet_contract_current_placements%rowtype; result jsonb; placement jsonb;
begin
 select v.* into p from private.timesheet_contract_current_placements v
  join private.timesheet_contract_family_aliases a on a.family_root_id=v.family_root_id and a.member_key=v.member_key
  where a.timesheet_id=p_timesheet_id;
 if not found or p.current_timesheet_id is not null then return null;end if;
 placement:=private.timesheet_contract_current_placement_v1(p_timesheet_id);
 result:=private.timesheet_contract_native_pending_v1(to_jsonb(p),false);
 if result is null or placement->'current_timesheet_id' is distinct from 'null'::jsonb then
  raise exception 'CURRENT_PLACEMENT_NATIVE_PENDING_UNBOUND' using errcode='55000';end if;
 return result;
end;
$function$;

-- Existing exact CW read authority for pending source/ingress consumers.
create or replace function private.timesheet_contract_native_pending_week_v1(p_week_id uuid)
returns jsonb language plpgsql stable security definer set search_path=pg_catalog,public,private,pg_temp
as $function$
declare matches jsonb; result jsonb;
begin
 select jsonb_agg(jsonb_build_object('pending',private.timesheet_contract_native_pending_v1(to_jsonb(p),false))) into matches
  from private.timesheet_contract_current_placements p join public.audit_events a
   on a.after_json#>'{native_contract_placement,placement}'=to_jsonb(p)
   and a.after_json#>>'{native_contract_placement,placement,family_root_id}'=p.family_root_id::text
   and a.after_json#>>'{native_contract_placement,placement,member_key}'=p.member_key
   and a.after_json#>>'{native_contract_placement,placement,placement_revision}'=p.placement_revision::text
  where p.current_timesheet_id is null and a.action='CANDIDATE_SUBMISSION_WITHDRAWN_TO_CONTRACT_WEEK'
   and a.after_json#>>'{native_contract_placement,version}'='CANDIDATE_NATIVE_PENDING_PLACEMENT_V1'
   and a.after_json->>'contract_week_id'=p_week_id::text;
 if matches is null then return null;end if;
 if jsonb_array_length(matches)<>1 or matches#>'{0,pending}'='null'::jsonb then
  raise exception 'CURRENT_PLACEMENT_NATIVE_PENDING_UNBOUND' using errcode='55000';end if;
 result:=matches#>'{0,pending}';
 perform private.timesheet_contract_current_placement_v1((result->>'old_timesheet_id')::uuid);
 return result;
end;
$function$;

-- Native ordinary allocator calls before its first CW/TS/TF lock. Real pending
-- authority and family are reasserted under the existing sorted physical gate.
create or replace function private.timesheet_contract_native_pending_enter_week_v1(p_week_id uuid)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog,public,private,pg_temp
as $function$
declare pending jsonb; checked jsonb; source_id uuid; original_id uuid; guard jsonb; check_id uuid;
begin
 pending:=private.timesheet_contract_native_pending_week_v1(p_week_id);
 if pending is null then return null;end if;
 source_id:=(pending->>'old_timesheet_id')::uuid;
 perform private.timesheet_contract_move_family_lock_v1(source_id);
 checked:=private.timesheet_contract_native_pending_for_v1(source_id);
 if checked is distinct from pending then raise exception 'CANDIDATE_CONTEXT_STALE' using errcode='40001';end if;
 select a.original_timesheet_id into strict original_id from private.timesheet_contract_family_aliases a where a.timesheet_id=source_id;
 for check_id in select distinct id from unnest(array[source_id,original_id]) id order by id loop
  guard:=private.weekly_source_managed_root_guard_v1(check_id);
  if (coalesce((guard->>'managed')::boolean,true) and (coalesce((guard->>'ok')::boolean,true)
    or coalesce((guard->>'weekly_source_bound')::boolean,true)))
    or coalesce((guard->>'authorisation_record_without_authorised_timesheet')::boolean,false)
    or guard->>'protected_target_ownership_state' is not null then
   raise exception 'WEEKLY_SOURCE_MANAGED_ROOT_ROTATION_REFUSED' using errcode='55000';end if;
 end loop;
 return checked;
end;
$function$;
