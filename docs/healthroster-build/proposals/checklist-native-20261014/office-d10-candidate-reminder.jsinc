// Purpose-bound R254 intent UI; native SQL owns eligibility and staging.
function normaliseCheckOnlyD10Reminder(value,actorId) {
  const closed=(v,keys)=>v!==null&&typeof v==='object'&&!Array.isArray(v)&&Object.keys(v).length===keys.length&&keys.every(k=>Object.prototype.hasOwnProperty.call(v,k));
  const uuid=v=>typeof v==='string'&&/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(v),hash=v=>typeof v==='string'&&/^[0-9a-f]{64}$/.test(v);
  const date=v=>typeof v==='string'&&/^\d{4}-\d{2}-\d{2}$/.test(v)&&Number.isFinite(Date.parse(v+'T00:00:00Z'))&&new Date(v+'T00:00:00Z').toISOString().slice(0,10)===v;
  if(!closed(value,['contract','actor_user_id','permission_view','scope','parent_group_key','parent_proof_hash','action_id','candidate_context_hash'])
    ||value.contract!=='WEEKLY_SOURCE_CHECK_ONLY_D10_CANDIDATE_REMINDER_ACTION_V1'||!uuid(actorId)||value.actor_user_id!==actorId||value.permission_view!=='ADMIN'
    ||!closed(value.scope,['source_group_id','source_cycle_id','client_id','week_ending'])
    ||!['source_group_id','source_cycle_id','client_id'].every(k=>uuid(value.scope[k]))||!date(value.scope.week_ending)
    ||typeof value.parent_group_key!=='string'||!/^d10g_[0-9a-f]{64}$/.test(value.parent_group_key)
    ||!['parent_proof_hash','action_id','candidate_context_hash'].every(k=>hash(value[k])))return null;
  return JSON.parse(JSON.stringify(value));
}
function openCheckOnlyD10Reminder(detail) {
  const session=typeof SESSION!=='undefined'?SESSION:null,user=session?.user,actorId=user?.id;
  const roles=JSON.stringify(user?.roles),flags=JSON.stringify([user?.role,user?.is_active]);
  const action=normaliseCheckOnlyD10Reminder(detail.payload,actorId),workspace=workspaceApi();
  if(detail.label!=='Remind candidate'||detail.enabled!==true||!action||user?.is_active!==true||String(user?.role??'').trim().toLowerCase()!=='admin'
    ||typeof workspace?.issueCommand!=='function'||typeof root.showModal!=='function')
    return openDetail({detail:{problem:'This reminder could not be verified. Refresh Queries before continuing.'}},'View details');
  const sessionCurrent=()=>!!session&&!!user&&(typeof SESSION!=='undefined'?SESSION:null)===session&&SESSION.user===user
    &&SESSION.user.id===actorId&&JSON.stringify(SESSION.user.roles)===roles&&JSON.stringify([SESSION.user.role,SESSION.user.is_active])===flags&&workspaceApi()===workspace;
  const parents=Array.isArray(root.__modalStack)?root.__modalStack.slice():[],parentTokens=parents.map(p=>p._token),kind='weekly-source-check-only-reminder-v1';
  const context={entity:'weekly-source-child',data:{},weeklySourceChildKind:kind};
  const payload={descriptor:action,idempotency_key:root.crypto.randomUUID()},state={confirmed:false,busy:false,error:'',failed:false};
  let frame=null,token=null;
  const parentCurrent=()=>parents.length===(root.__modalStack||[]).length&&parents.every((p,i)=>root.__modalStack[i]===p&&p._token===parentTokens[i]);
  const current=()=>sessionCurrent()&&!!frame&&frame._token===token&&(root.__modalStack||[]).length===parents.length+1
    &&parents.every((p,i)=>root.__modalStack[i]===p&&p._token===parentTokens[i])&&(root.__modalStack||[]).at(-1)===frame;
  const renderTab=()=>{
    if(!sessionCurrent())return '';
    if(!frame){
      const stack=root.__modalStack||[],child=stack.at(-1);
      if(stack.length!==parents.length+1||!parents.every((p,i)=>stack[i]===p&&p._token===parentTokens[i])||child?.kind!==kind
        ||child.renderTab!==renderTab||child._ctxRef!==context)return '';
      frame=child;token=child._token;
    }
    if(!current())return '';
    const markup=renderCommandConfirmation({message:'Remind this candidate to submit the Timesheet through their Candidate App.',
      confirmation:'Send this reminder to the candidate’s active App account.',action_label:state.failed?'Retry exact request':'Remind candidate',
      context:detail.context},state);
    setTimeout(wire,0);return typeof root.html==='function'?root.html(markup):markup;
  };
  const wire=()=>{
    if(!current())return;
    const host=root.document?.querySelector('[data-wsa-screen="command"]');if(!host||host.dataset.wsaWired==='1')return;
    host.dataset.wsaWired='1';host.querySelector('[data-wsa-close]')?.addEventListener('click',()=>{if(current())closeChild();});
    host.querySelector('[data-wsa-confirm]')?.addEventListener('change',event=>{if(!current())return;state.confirmed=event.target.checked;
      host.querySelector('[data-wsa-run-command]').disabled=!state.confirmed||state.busy;});
    host.querySelector('[data-wsa-run-command]')?.addEventListener('click',async()=>{
      if(!current()||!state.confirmed||state.busy)return;state.busy=true;state.error='';rerender(kind);
      try{
        const result=await workspace.issueCommand('CHECK_ONLY_D10_REMIND_CANDIDATE',payload);
        if(!current())return;
        if(result?.ok!==true||result.contract!=='WEEKLY_SOURCE_CHECK_ONLY_CANDIDATE_REMINDER_V1'||result.actor_user_id!==actorId
          ||result.action_id!==action.action_id||result.idempotency_key!==payload.idempotency_key||result.queued!==true
          ||typeof result.notification_id!=='string'||typeof result.replay!=='boolean'
          ||!result.scope||!Object.keys(action.scope).every(k=>result.scope[k]===action.scope[k]))throw new Error('Unconfirmed reminder');
        markCompletedChildClean();closeChild();
        if(!sessionCurrent()||!parentCurrent())return;
        root.__toast?.('Reminder added to the Candidate App.');
        await workspace.refresh?.('queries');
        if(!sessionCurrent()||!parentCurrent())return;
      }catch{
        if(!current())return;state.failed=true;state.error='The reminder result could not be confirmed. Retry this exact request.';
      }finally{state.busy=false;if(current())rerender(kind);}
    });
  };
  root.modalCtx=context;
  root.showModal('Remind candidate',[{key:'main',label:'Remind candidate'}],renderTab,null,false,wire,
    {kind,noParentGate:true,showSave:false,showApply:false,runOnRender:true});
  return !!frame&&current();
}
