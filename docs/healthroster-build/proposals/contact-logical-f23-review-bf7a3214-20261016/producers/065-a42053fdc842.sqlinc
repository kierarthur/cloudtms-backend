declare i public.weekly_message_intents%rowtype;
begin
 select * into strict i from public.weekly_message_intents where id=p_intent_id;
 perform private.weekly_contact_source_intent_lock_v1(i.id);
 perform t.id from public.weekly_message_dispatch_targets t join public.weekly_message_dispatch_commands c on c.id=t.dispatch_command_id
  where c.message_intent_id=i.id order by t.id for update of t;
 perform id from public.weekly_message_dispatch_commands where message_intent_id=i.id order by id for update;
 select * into strict i from public.weekly_message_intents where id=i.id for update;
 if i.state not in('DUE','RENDERED','RETIRED') or exists(select 1 from public.weekly_message_renders r
  where r.message_intent_id=i.id and private.weekly_contact_source_render_attempted_v1(r.id)) then return false;end if;
 update public.weekly_message_dispatch_targets t set state='RETIRED',terminal_at_utc=clock_timestamp(),
  terminal_reason='OBSOLETE',next_attempt_at_utc=null,lease_owner=null,lease_token=null,lease_expires_at_utc=null
  from public.weekly_message_dispatch_commands c where c.message_intent_id=i.id and t.dispatch_command_id=c.id and t.state<>'RETIRED';
 update public.weekly_message_dispatch_commands set state='RETIRED',lease_owner=null,lease_token=null,lease_expires_at_utc=null
  where message_intent_id=i.id and state<>'RETIRED';
 update public.weekly_message_renders set state='STALE' where message_intent_id=i.id and state<>'STALE';
 update public.weekly_manager_review_batches b set state='REVOKED' from public.weekly_message_renders r
  where r.message_intent_id=i.id and b.message_render_id=r.id and b.state='ACTIVE';
 update public.weekly_manager_route_receipts receipt set state='REVOKED',revoked_at_utc=clock_timestamp()
  from public.weekly_manager_review_batches b join public.weekly_message_renders r on r.id=b.message_render_id
  where r.message_intent_id=i.id and receipt.review_batch_id=b.id and receipt.state='ACTIVE';
 update public.weekly_manager_review_items item set response_state='OBSOLETE'
  from public.weekly_manager_review_batches b join public.weekly_message_renders r on r.id=b.message_render_id
  where r.message_intent_id=i.id and item.review_batch_id=b.id and item.response_state='UNANSWERED';
 update public.weekly_manager_route_preparations set state='RETIRED',bound_at_utc=null,retired_at_utc=clock_timestamp()
  where message_intent_id=i.id and state in('PREPARED','BOUND');
 update public.weekly_message_intents set state='RETIRED' where id=i.id;
 return true;
end;