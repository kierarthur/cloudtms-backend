-- Genuine expected-week membership without inventing an incident/shift/date.
-- This internal shape is not the Office manual MemberReview DTO.
create or replace function private.weekly_contact_source_expected_week_fact_v1(p_generation_id uuid,p_member_id uuid,p_at timestamptz)
returns jsonb language plpgsql stable security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
declare g public.weekly_candidate_outreach_generations%rowtype;r public.weekly_timesheet_submission_requests%rowtype;
 m public.weekly_timesheet_submission_request_memberships%rowtype;sg public.weekly_source_groups%rowtype;cycle public.weekly_source_cycles%rowtype;
 keys jsonb;policy jsonb;guard jsonb;reason text;history jsonb;
begin
 select * into strict g from public.weekly_candidate_outreach_generations where id=p_generation_id and request_kind='SUBMIT_TIMESHEET';
 select * into strict m from public.weekly_timesheet_submission_request_memberships where id=p_member_id;
 select * into strict r from public.weekly_timesheet_submission_requests where id=m.submission_request_id
  and candidate_cohort_id=g.candidate_cohort_id and request_generation=g.generation_number and membership_hash=g.membership_hash
  and candidate_id=g.candidate_id and source_cycle_id=g.source_cycle_id;
 select * into strict cycle from public.weekly_source_cycles where id=g.source_cycle_id;
 select * into strict sg from public.weekly_source_groups where id=cycle.source_group_id;
 perform private.weekly_source_query_current_publication_v1(cycle.id,cycle.current_projection_publication_id);
 if not exists(select 1 from public.contracts c where c.id=m.contract_id and c.candidate_id=r.candidate_id and c.client_id=m.client_id) then
  raise exception 'CONTACT_SOURCE_NATIVE_LINEAGE_INVALID' using errcode='23514';end if;
 policy:=private._weekly_source_effective_policy_v1(m.client_id,m.contract_id,m.week_ending);
 guard:=private.weekly_contact_scope_guard_v1(r.candidate_id,m.client_id,'WORKER',p_at);
 keys:=private.weekly_contact_source_identity_v1(sg.agency_id,sg.environment,r.candidate_id,m.client_id,'SUBMIT_TIMESHEET','WORKER',
  jsonb_build_object('contract_id',m.contract_id,'week_ending',m.week_ending));
 history:=private.weekly_contact_source_logical_history_v1(sg.agency_id,sg.environment,r.candidate_id,m.client_id,decode(keys->>'logical_contact_key','hex'));
 reason:=case when g.state<>'ACTIVE' or not private.weekly_source_candidate_generation_current_v1(g.id) then 'ACTIVE_NATIVE_QUESTION_REQUIRED'
  when g.deadline_at_utc<=p_at then 'NATIVE_QUESTION_EXPIRED'
  when r.state not in('ACTIVE','OVERDUE','PARTLY_SUBMITTED') or m.state<>'WAITING' then 'SUBMISSION_NO_LONGER_REQUIRED'
  when guard->'allow' is distinct from 'true'::jsonb then 'CONTACT_PAUSED'
  when policy->>'source_group_id' is distinct from sg.id::text or policy->>'authority_mode' is distinct from 'SOURCE_AUTHORITY'
   or policy->>'document_mode' is distinct from 'CHECK_ONLY' or policy->'candidate_queries_enabled' is distinct from 'true'::jsonb then 'WORKER_CONTACT_DISABLED'
  when not private.weekly_source_missing_scope_unchanged_v1(r.current_projection_publication_id,cycle.current_projection_publication_id,
    r.candidate_id,m.client_id,m.contract_id,m.week_ending)
   or exists(select 1 from public.timesheets t where t.contract_id=m.contract_id and t.week_ending_date=m.week_ending and t.is_current
    and t.revoked_at is null and t.archived_at_utc is null and t.sheet_scope='WEEKLY' and t.line_type='HOURS'
    and t.r2_nurse_key is not null and t.img_sha256_nurse is not null) then 'SUBMISSION_NO_LONGER_REQUIRED'
  when history->'unknown_original'='true'::jsonb then 'ORIGINAL_SUBMISSION_UNCERTAIN'
  when history->'original_retry_pending'='true'::jsonb then 'ORIGINAL_ATTEMPT_OWNER_PENDING' end;
 return jsonb_build_object('version','CONTACT_EXPECTED_WEEK_FACT_V1','issue_id',null,'candidate_id',r.candidate_id,'client_id',m.client_id,
  'source_cycle_id',cycle.id,'projection_publication_id',cycle.current_projection_publication_id,'audience','WORKER','purpose','SUBMIT_TIMESHEET',
  'eligible',reason is null,'exclusion_reason',reason,'logical_contact_key',keys->'logical_contact_key','budget_owner_key',keys->'budget_owner_key',
  'native_member_kind','SUBMISSION_MEMBER','native_member_id',m.id,'native_basis',jsonb_build_object('kind','NATIVE_EXPECTED_WEEK_MEMBER_V1',
   'submission_request_id',r.id,'membership_id',m.id,'candidate_generation_id',g.id,'contract_id',m.contract_id,'week_ending',m.week_ending,
   'expected_source_fingerprint',encode(m.expected_source_fingerprint,'hex')),'candidate_generation_id',g.id,'recipient_route_id',null,
  'manager_address',null,'manager_row',null,'incident_id',null,'incident_episode',null,'work_event_id',null,'comparison_revision_id',null,
  'comparison_fingerprint',null,'global_policy_revision',(select version::text from public.weekly_source_global_settings where singleton),
  'policy_sha256',encode(private.weekly_source_sha256_jsonb_v1('CONTACT_MANUAL_EFFECTIVE_SOURCE_POLICY_V1',policy),'hex'));
end;
$function$;

create or replace function private.weekly_contact_source_intent_current_subset_v1(p_intent_id uuid,p_at timestamptz)
returns jsonb language plpgsql volatile security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
declare i public.weekly_message_intents%rowtype;cap public.weekly_contact_source_intent_captures%rowtype;
 g public.weekly_candidate_outreach_generations%rowtype;native record;fact jsonb;old_member jsonb;lineage jsonb;
 basis_members jsonb:='[]';result jsonb:='[]';scope_id uuid;checking jsonb;ordinal integer;history jsonb;sg public.weekly_source_groups%rowtype;
begin
 select * into strict i from public.weekly_message_intents where id=p_intent_id;
 select source_group.* into strict sg from public.weekly_source_cycles cycle join public.weekly_source_groups source_group on source_group.id=cycle.source_group_id
  where cycle.id=i.source_cycle_id;
 if i.audience_kind='CANDIDATE' and i.tranche_kind in('CANDIDATE_INITIAL','TIMESHEET_SUBMISSION_INITIAL') and exists(
  select 1 from public.weekly_message_intents later where later.candidate_generation_id=i.candidate_generation_id
   and later.tranche_kind in('CANDIDATE_REMINDER_6H','TIMESHEET_SUBMISSION_REMINDER_6H') and later.due_at_utc<=p_at) then
  return '[]'::jsonb;end if;
 select * into cap from public.weekly_contact_source_intent_captures where message_intent_id=i.id;
 if found then
  perform private.weekly_contact_source_capture_assert_v1(i.id);basis_members:=cap.manifest_json->'members';
  if cap.accepted_actor_user_id is not null then
   begin perform private.weekly_source_office_authority_v1(cap.accepted_actor_user_id,'ASK_CANDIDATES',null,null,null);
   exception when insufficient_privilege then return '[]'::jsonb;end;
  end if;
 elsif i.audience_kind='CANDIDATE' then
  select * into strict g from public.weekly_candidate_outreach_generations where id=i.candidate_generation_id;
  ordinal:=case when i.tranche_kind in('CANDIDATE_INITIAL','TIMESHEET_SUBMISSION_INITIAL') and i.tranche_sequence=1 then 1
   when i.tranche_kind='CANDIDATE_REMINDER_6H' and i.tranche_sequence=1 then 2
   when i.tranche_kind='TIMESHEET_SUBMISSION_REMINDER_6H' and i.tranche_sequence<=2147483646 then i.tranche_sequence+1
   when i.tranche_kind='CANDIDATE_MANUAL_REMINDER' and i.tranche_sequence<=2147483645 then i.tranche_sequence+2 end;
  if ordinal is null then raise exception 'CONTACT_SOURCE_NATIVE_ORDINAL_UNPROVIDED' using errcode='55000';end if;
  if g.request_kind='CHECK_HOURS' then
   select coalesce(jsonb_agg(jsonb_build_object('native_member_kind','OUTREACH_MEMBER','native_member_id',membership.id,
    'incident_id',membership.incident_id,'comparison_revision_id',membership.comparison_revision_id,'send_ordinal',ordinal) order by membership.id),'[]')
    into basis_members from public.weekly_candidate_outreach_memberships membership where candidate_generation_id=g.id;
  else
   select coalesce(jsonb_agg(jsonb_build_object('native_member_kind','SUBMISSION_MEMBER','native_member_id',membership.id,'send_ordinal',ordinal)
    order by membership.id),'[]') into basis_members from public.weekly_timesheet_submission_requests request
    join public.weekly_timesheet_submission_request_memberships membership on membership.submission_request_id=request.id
    where request.candidate_cohort_id=g.candidate_cohort_id and request.request_generation=g.generation_number
     and request.membership_hash=g.membership_hash and request.candidate_id=g.candidate_id and request.source_cycle_id=g.source_cycle_id;
  end if;
 elsif i.audience_kind='MANAGER' then
  if i.tranche_sequence<>1 or i.tranche_kind not in('MANAGER_EARLY_ALL','MANAGER_T6_RESPONDED','MANAGER_T12_REMAINDER','MANAGER_MANUAL_SELECTED') then
   raise exception 'CONTACT_SOURCE_NATIVE_ORDINAL_UNPROVIDED' using errcode='55000';end if;
  if exists(select 1 from public.weekly_message_renders where message_intent_id=i.id) then
   select coalesce(jsonb_agg(jsonb_build_object('native_member_kind','MANAGER_MEMBER','incident_id',item.incident_id,
    'comparison_revision_id',item.sent_comparison_revision_id,'send_ordinal',1) order by item.id),'[]') into basis_members
    from public.weekly_message_renders render join public.weekly_manager_review_batches batch on batch.message_render_id=render.id
    join public.weekly_manager_review_items item on item.review_batch_id=batch.id where render.message_intent_id=i.id
     and render.render_sequence=(select max(render_sequence) from public.weekly_message_renders where message_intent_id=i.id);
  else
   select coalesce(jsonb_agg(jsonb_build_object('native_member_kind','MANAGER_MEMBER','incident_id',membership.incident_id,
    'comparison_revision_id',membership.comparison_revision_id,'send_ordinal',1) order by membership.id),'[]') into basis_members
    from public.weekly_manager_recipient_memberships membership join public.weekly_discrepancy_incidents incident on incident.id=membership.incident_id
    where membership.recipient_generation_id=i.recipient_generation_id
     and(i.tranche_kind<>'MANAGER_T6_RESPONDED' or incident.candidate_action_state='RESPONDED')
     and(cardinality(i.sorted_due_event_ids)=0 or exists(select 1 from public.weekly_manager_cohort_due_events event
      where event.id=any(i.sorted_due_event_ids) and event.candidate_cohort_id=membership.candidate_cohort_id
       and private.weekly_source_manager_due_event_covers_v1(event.id,incident.id)));
  end if;
 else raise exception 'CONTACT_SOURCE_NATIVE_PURPOSE_UNPROVIDED' using errcode='55000';end if;
 if jsonb_array_length(basis_members)>500 then raise exception 'CONTACT_SOURCE_NATIVE_MEMBERSHIP_CAPACITY_EXCEEDED' using errcode='54000';end if;
 for old_member in select value from jsonb_array_elements(basis_members) loop
  if old_member->>'native_member_kind'='SUBMISSION_MEMBER' then
   fact:=private.weekly_contact_source_expected_week_fact_v1(i.candidate_generation_id,(old_member->>'native_member_id')::uuid,p_at);
  else
   fact:=private.weekly_contact_manual_member_facts_v1((old_member->>'incident_id')::uuid,
    case when i.audience_kind='MANAGER' then 'MANAGER' else 'WORKER' end,p_at);
   if fact->>'comparison_revision_id' is distinct from old_member->>'comparison_revision_id'
    or(i.audience_kind='CANDIDATE' and fact->>'candidate_generation_id' is distinct from i.candidate_generation_id::text) then continue;end if;
  end if;
  if fact->'eligible' is distinct from 'true'::jsonb and fact->>'exclusion_reason' not in('MANUAL_ENQUIRY_COOLDOWN','ORIGINAL_ENQUIRY_QUEUED') then continue;end if;
  ordinal:=(old_member->>'send_ordinal')::integer;
  if exists(select 1 from public.weekly_contact_source_ordinal_owners owner where owner.logical_contact_key=decode(fact->>'logical_contact_key','hex')
   and owner.send_ordinal=ordinal and owner.message_intent_id<>i.id) then continue;end if;
  history:=private.weekly_contact_source_logical_history_v1(sg.agency_id,sg.environment,(fact->>'candidate_id')::uuid,
   (fact->>'client_id')::uuid,decode(fact->>'logical_contact_key','hex'));
  if history->'unknown_original'='true'::jsonb or history->'original_retry_pending'='true'::jsonb or exists(
   select 1 from jsonb_array_elements(history->'events')event where(event->>'send_ordinal')::integer=ordinal and event->>'accepted_at_utc' is not null) then continue;end if;
  if cap.manual_request_id is not null and fact->>'manager_address' is distinct from cap.manifest_json->'recipient'->>'manager_address' then continue;end if;
  if cap.manual_request_id is null and i.audience_kind='MANAGER' and fact->'cutoff'->'routine'->'in_scope' is distinct from 'true'::jsonb then continue;end if;
  scope_id:=private.weekly_contact_scope_lock_v1(sg.agency_id,sg.environment,(fact->>'candidate_id')::uuid,(fact->>'client_id')::uuid);
  checking:=private.weekly_contact_checking_scope_revision_v1(scope_id);
  fact:=fact||jsonb_build_object('scope_id',scope_id,'scope_revision',(select revision::text from public.weekly_contact_pause_scopes where id=scope_id),
   'checking_revision',checking->>'revision','send_ordinal',ordinal,'eligible',true,'exclusion_reason',null);
  if cap.message_intent_id is not null then
   fact:=fact||jsonb_build_object('routine_step',old_member->'routine_step','basis_accepted_membership_id',old_member->'basis_accepted_membership_id',
    'selected_issue_ids',old_member->'selected_issue_ids');
   if cap.capture_kind in('ROUTINE_MANUAL_SELECTION','MANUAL_SELECTION_RECOMPOSITION')and old_member->'routine_step'='null'::jsonb
    and fact->'last_accepted_send'is distinct from 'null'::jsonb then continue;end if;
   if cap.capture_kind in('ROUTINE_FOLLOWUP','ROUTINE_MANUAL_FOLLOWUP','FOLLOWUP_RECOMPOSITION')
    or(cap.capture_kind in('ROUTINE_MANUAL_SELECTION','MANUAL_SELECTION_RECOMPOSITION')and old_member->'routine_step'<>'null'::jsonb)then
    lineage:=private.weekly_contact_source_manager_followup_state_v1((fact->>'incident_id')::uuid,p_at);
    if lineage->>'routine_sequence' is distinct from old_member->>'routine_step' or lineage->>'reason'<>'SCHEDULED'
     or(lineage->>'due_at_utc')::timestamptz>p_at then continue;end if;
    fact:=fact||jsonb_build_object('followup_state',lineage);
   end if;
  end if;
  result:=result||jsonb_build_array(fact);
 end loop;
 return result;
end;
$function$;
