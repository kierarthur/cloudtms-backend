declare g public.weekly_candidate_outreach_generations%rowtype;x record;guard jsonb;n integer:=0;
 publication uuid;
begin
 select * into strict g from public.weekly_candidate_outreach_generations where id=p_generation_id;
 if not private.weekly_source_candidate_generation_current_v1(g.id) or g.state<>'ACTIVE' then
  raise exception 'WEEKLY_SOURCE_CANDIDATE_MESSAGE_STALE' using errcode='40001';end if;
 select current_projection_publication_id into strict publication from public.weekly_source_cycles where id=g.source_cycle_id;
 perform private.weekly_source_query_current_publication_v1(g.source_cycle_id,publication);
 if g.request_kind='CHECK_HOURS' then
  for x in select i.*,m.state membership_state,m.comparison_revision_id,
    c.contract_id,w.work_date from public.weekly_candidate_outreach_memberships m
   join public.weekly_discrepancy_incidents i on i.id=m.incident_id
   join public.weekly_issue_comparison_revisions c on c.id=i.current_comparison_revision_id
   join public.weekly_work_events w on w.id=i.work_event_id where m.candidate_generation_id=g.id order by i.id
  loop
   n:=n+1;
   if x.candidate_id<>g.candidate_id or x.client_id<>g.client_id or x.source_cycle_id<>g.source_cycle_id
    or x.membership_state<>'ACTIONABLE' or x.state<>'OPEN' or x.candidate_action_state in('RESPONDED','NOT_REQUIRED')
    or x.comparison_revision_id<>x.current_comparison_revision_id or private.weekly_source_covered_hours_incident_v1(x.id)
    or (private._weekly_source_effective_policy_v1(x.client_id,x.contract_id,x.work_date))->'candidate_queries_enabled'
     is distinct from 'true'::jsonb then
     raise exception 'WEEKLY_SOURCE_CANDIDATE_MESSAGE_STALE' using errcode='40001';end if;
  end loop;
  guard:=private.weekly_contact_scope_guard_v1(g.candidate_id,g.client_id,'WORKER',clock_timestamp());
  if guard->'allow' is distinct from 'true'::jsonb then raise exception 'CONTACT_SOURCE_RENDER_PAUSED' using errcode='55000';end if;
 elsif g.request_kind='SUBMIT_TIMESHEET' then
  for x in select r.candidate_id,r.current_projection_publication_id,m.*
   from public.weekly_timesheet_submission_requests r
   join public.weekly_timesheet_submission_request_memberships m on m.submission_request_id=r.id
   where r.candidate_cohort_id=g.candidate_cohort_id and r.request_generation=g.generation_number
    and r.candidate_id=g.candidate_id and r.source_cycle_id=g.source_cycle_id and r.membership_hash=g.membership_hash
    and r.state in('ACTIVE','OVERDUE','PARTLY_SUBMITTED') order by m.client_id,m.contract_id,m.week_ending,m.id
  loop
   n:=n+1;
   if x.state<>'WAITING' or not private.weekly_source_missing_scope_unchanged_v1(x.current_projection_publication_id,
     publication,g.candidate_id,x.client_id,x.contract_id,x.week_ending)
    or exists(select 1 from public.timesheets t where t.contract_id=x.contract_id and t.week_ending_date=x.week_ending
      and t.is_current and t.revoked_at is null and t.archived_at_utc is null and t.sheet_scope='WEEKLY' and t.line_type='HOURS'
      and t.r2_nurse_key is not null and t.img_sha256_nurse is not null)
    or (private._weekly_source_effective_policy_v1(x.client_id,x.contract_id,x.week_ending))->'candidate_queries_enabled'
     is distinct from 'true'::jsonb then
     raise exception 'WEEKLY_SOURCE_CANDIDATE_MESSAGE_STALE' using errcode='40001';end if;
   guard:=private.weekly_contact_scope_guard_v1(g.candidate_id,x.client_id,'WORKER',clock_timestamp());
   if guard->'allow' is distinct from 'true'::jsonb then raise exception 'CONTACT_SOURCE_RENDER_PAUSED' using errcode='55000';end if;
  end loop;
 else raise exception 'CONTACT_DISPATCH_SCOPE_INVALID' using errcode='42501';end if;
 if n not between 1 and 500 then raise exception 'CONTACT_DISPATCH_SCOPE_INVALID' using errcode='42501';end if;
end;