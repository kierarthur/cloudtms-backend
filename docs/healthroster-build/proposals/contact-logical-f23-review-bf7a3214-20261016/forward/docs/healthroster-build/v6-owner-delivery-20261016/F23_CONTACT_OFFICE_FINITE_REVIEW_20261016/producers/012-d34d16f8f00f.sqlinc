declare cap public.weekly_contact_source_intent_captures%rowtype;i public.weekly_message_intents%rowtype;
 m public.weekly_contact_source_intent_capture_members%rowtype;keys jsonb;identity jsonb;expected jsonb;actual jsonb;n integer:=0;
begin
 select * into strict cap from public.weekly_contact_source_intent_captures where message_intent_id=p_intent_id;
 select * into strict i from public.weekly_message_intents where id=cap.message_intent_id;
 if (i.agency_id,i.environment,i.source_cycle_id) is distinct from(cap.agency_id,cap.environment,cap.source_cycle_id)
  or cap.manifest_json->>'version' is distinct from 'CONTACT_SOURCE_INTENT_CAPTURE_V1'
  or cap.manifest_json->>'membership_hash' is distinct from encode(cap.membership_hash,'hex')
  or cap.manifest_json->>'original_generation_membership_hash' is distinct from encode(cap.original_generation_membership_hash,'hex')
  or jsonb_typeof(cap.manifest_json->'members') is distinct from 'array'
  or jsonb_typeof(cap.manifest_json->'current_facts') is distinct from 'array'
  or(cap.capture_kind in('EXPLICIT_MANUAL','MANUAL_RECOMPOSITION'))<>(cap.manual_request_id is not null)
  or(cap.manual_request_id is not null and cap.accepted_actor_user_id is null) then
  raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
 if i.audience_kind='CANDIDATE' then
  if not exists(select 1 from public.weekly_candidate_outreach_generations g where g.id=i.candidate_generation_id
   and g.candidate_cohort_id=i.candidate_cohort_id and g.source_cycle_id=i.source_cycle_id
   and g.membership_hash=cap.original_generation_membership_hash) or cap.membership_hash<>
    private.weekly_source_sha256_jsonb_v1('CONTACT_SOURCE_CAPTURE_MEMBERSHIP_V1',cap.manifest_json->'members') then
   raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
 elsif i.audience_kind='MANAGER' then
  if not exists(select 1 from public.weekly_manager_recipient_generations g where g.id=i.recipient_generation_id
   and g.recipient_route_id=i.recipient_route_id and g.membership_hash=cap.original_generation_membership_hash)
   or jsonb_typeof(cap.manifest_json->'manager_members') is distinct from 'array' or cap.membership_hash<>
    private.weekly_source_sha256_jsonb_v1('WEEKLY_MANAGER_REVIEW_BATCH_MEMBERSHIP_V1',cap.manifest_json->'manager_members') then
   raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
 else raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
 for m in select * from public.weekly_contact_source_intent_capture_members where message_intent_id=cap.message_intent_id order by logical_contact_key loop
  n:=n+1;if n>500 then raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
  if array_position(m.selected_issue_ids,null)is not null
   or cardinality(m.selected_issue_ids)<>(select count(distinct id)from unnest(m.selected_issue_ids)id)
   or(m.purpose='CHECK_HOURS'and m.selected_issue_ids is distinct from array[m.incident_id])
   or(m.native_member_kind='SUBMISSION_MEMBER')<>(m.purpose='SUBMIT_TIMESHEET')
   or(cap.capture_kind in('ROUTINE_FOLLOWUP','ROUTINE_MANUAL_FOLLOWUP','FOLLOWUP_RECOMPOSITION')and(
    m.audience<>'MANAGER'or m.purpose<>'CHECK_HOURS'or m.routine_step is null or m.routine_step<1))
   or(cap.capture_kind in('ROUTINE_MANUAL_SELECTION','MANUAL_SELECTION_RECOMPOSITION')and(
    m.audience<>'MANAGER'or m.purpose<>'CHECK_HOURS'or(m.routine_step is not null and m.routine_step<1)
    or i.tranche_kind<>'MANAGER_MANUAL_RESEND'))
   or(cap.capture_kind in('EXPLICIT_MANUAL','MANUAL_RECOMPOSITION')and m.routine_step is not null)then
   raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID'using errcode='23514';end if;
  if m.purpose='CHECK_HOURS' then
   identity:=jsonb_build_object('work_event_id',m.work_event_id,'incident_id',m.incident_id,'incident_episode',m.incident_episode);
   if not exists(select 1 from public.weekly_discrepancy_incidents incident
    join public.weekly_issue_comparison_revisions comparison on comparison.id=m.comparison_revision_id and comparison.incident_id=incident.id
    where incident.id=m.incident_id and incident.candidate_id=m.candidate_id and incident.client_id=m.client_id
     and incident.work_event_id=m.work_event_id and incident.source_cycle_id=cap.source_cycle_id
     and comparison.material_comparison_fingerprint=m.comparison_fingerprint) then
    raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
  else identity:=jsonb_build_object('contract_id',m.native_basis_json->'contract_id','week_ending',m.native_basis_json->'week_ending');end if;
  keys:=private.weekly_contact_source_identity_v1(cap.agency_id,cap.environment,m.candidate_id,m.client_id,m.purpose,m.audience,identity);
  if keys->>'logical_contact_key'<>encode(m.logical_contact_key,'hex') or keys->>'budget_owner_key'<>encode(m.budget_owner_key,'hex')
   or (i.audience_kind='CANDIDATE')<>(m.audience='WORKER')
   or not exists(select 1 from public.weekly_contact_pause_scopes scope where scope.id=m.scope_id
    and(scope.agency_id,scope.environment,scope.candidate_id,scope.client_id)=(cap.agency_id,cap.environment,m.candidate_id,m.client_id)) then
   raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
  if m.native_member_kind='OUTREACH_MEMBER' then
   if not exists(select 1 from public.weekly_candidate_outreach_memberships native where native.id=m.native_member_id
    and native.candidate_generation_id=i.candidate_generation_id and native.incident_id=m.incident_id
    and native.comparison_revision_id=m.comparison_revision_id) then
    raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
  elsif m.native_member_kind='SUBMISSION_MEMBER' then
   if not exists(select 1 from public.weekly_timesheet_submission_request_memberships native
    join public.weekly_timesheet_submission_requests request on request.id=native.submission_request_id
    join public.weekly_candidate_outreach_generations g on g.id=i.candidate_generation_id
     and request.candidate_cohort_id=g.candidate_cohort_id and request.request_generation=g.generation_number
     and request.membership_hash=g.membership_hash and request.candidate_id=g.candidate_id and request.source_cycle_id=g.source_cycle_id
    where native.id=m.native_member_id and native.client_id=m.client_id and request.candidate_id=m.candidate_id
     and m.native_basis_json->>'submission_request_id'=request.id::text and m.native_basis_json->>'contract_id'=native.contract_id::text
     and m.native_basis_json->>'week_ending'=native.week_ending::text
     and m.native_basis_json->>'expected_source_fingerprint'=encode(native.expected_source_fingerprint,'hex')) then
    raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
    
    
    
   if exists(select 1 from unnest(m.selected_issue_ids)alias(id)where not exists(
    select 1 from public.weekly_discrepancy_incidents incident join public.weekly_work_events work on work.id=incident.work_event_id
     where incident.id=alias.id and incident.candidate_id=m.candidate_id and incident.client_id=m.client_id
      and incident.source_cycle_id=cap.source_cycle_id
      and work.work_date+(7-extract(isodow from work.work_date)::integer)=(m.native_basis_json->>'week_ending')::date
      and exists(select 1 from public.weekly_issue_comparison_revisions comparison where comparison.incident_id=incident.id
       and comparison.contract_id=(m.native_basis_json->>'contract_id')::uuid)))then
    raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID'using errcode='23514';end if;
  elsif m.native_member_kind='MANAGER_MEMBER' then
   if not exists(select 1 from public.weekly_manager_recipient_memberships native where native.id=m.native_member_id
    and native.recipient_generation_id=i.recipient_generation_id and native.incident_id=m.incident_id
    and native.comparison_revision_id=m.comparison_revision_id) then
    raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
  else raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
  expected:=jsonb_build_object('logical_contact_key',encode(m.logical_contact_key,'hex'),'budget_owner_key',encode(m.budget_owner_key,'hex'),
   'native_member_kind',m.native_member_kind,'native_member_id',m.native_member_id,'selected_issue_ids',to_jsonb(m.selected_issue_ids),
   'candidate_id',m.candidate_id,'client_id',m.client_id,'scope_id',m.scope_id,'scope_revision',m.scope_revision::text,
   'checking_revision',m.checking_revision::text,'audience',m.audience,'purpose',m.purpose,'incident_id',m.incident_id,
   'incident_episode',m.incident_episode,'work_event_id',m.work_event_id,'comparison_revision_id',m.comparison_revision_id,
   'comparison_fingerprint',encode(m.comparison_fingerprint,'hex'),'send_ordinal',m.send_ordinal,'routine_step',m.routine_step,
   'basis_accepted_membership_id',m.basis_accepted_membership_id,'native_basis',m.native_basis_json);
  select value into strict actual from jsonb_array_elements(cap.manifest_json->'members') where value->>'logical_contact_key'=encode(m.logical_contact_key,'hex');
  if actual is distinct from expected then raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
  if cap.capture_kind in('ROUTINE_MANUAL_SELECTION','MANUAL_SELECTION_RECOMPOSITION')and m.routine_step is null and exists(
   select 1 from jsonb_array_elements(cap.manifest_json->'current_facts')fact
    where fact->>'logical_contact_key'=encode(m.logical_contact_key,'hex')and fact->'last_accepted_send'is distinct from 'null'::jsonb)then
   raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID'using errcode='23514';end if;
 end loop;
 if n not between 1 and 500 or n<>jsonb_array_length(cap.manifest_json->'members') then
  raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID' using errcode='23514';end if;
 if exists(select alias.id from public.weekly_contact_source_intent_capture_members member
  cross join lateral unnest(member.selected_issue_ids)alias(id)where member.message_intent_id=cap.message_intent_id
  group by alias.id having count(*)>1)then raise exception 'CONTACT_SOURCE_CAPTURE_LINEAGE_INVALID'using errcode='23514';end if;
end;