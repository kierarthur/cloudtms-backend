-- Source proposal: explicit, expiring, fixture-only TEST admission in the
-- EXISTING audit log. No assignment/readiness mutation, table or service grant.
-- Only the existing controlled feature setup RPC calls the write owner.
create or replace function private.weekly_source_protected_test_authorization_v1(p_authorization_id uuid)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare r private.cloudtms_database_releases%rowtype; auth jsonb; n integer;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict r from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1;
  if current_database()<>'cloudtms_test_clone' or r.status<>'VERIFIED' or r.completed_at_utc is null
    or r.installed_contract_sha256 is distinct from r.repository_contract_sha256
    or r.evidence_json#>>'{managed_release,environment}' is distinct from 'TEST'
    or r.evidence_json#>>'{managed_release,expected_database}' is distinct from current_database()
    or jsonb_typeof(r.evidence_json->'weekly_source_protected_test_setup_authorizations') is distinct from 'array' then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_AUTHORIZATION_REQUIRED' using errcode='55000'; end if;
  select count(*),jsonb_agg(value)->0 into n,auth
    from jsonb_array_elements(r.evidence_json->'weekly_source_protected_test_setup_authorizations') value
    where value->>'authorization_id'=p_authorization_id::text;
  if n<>1 or not private.weekly_source_qualification_closed_object_v1(auth,array['schema_version','authorization_id','scope_id',
      'release_id','source_commit','contract_sha256','agency_id','source_group_id','source_cycle_id','setup_actor_user_id',
      'journey_actor_user_id','week_ending','expires_at_utc','fixture_namespace','fixture_manifest','original_census',
      'prerequisite_qualification_sha256','capabilities','authorization_sha256'])
    or auth->>'schema_version' is distinct from 'WEEKLY_SOURCE_PROTECTED_TEST_SETUP_AUTHORIZATION_V1'
    or auth->>'release_id' is distinct from r.release_id or auth->>'source_commit' is distinct from r.git_commit
    or auth->>'contract_sha256' is distinct from r.installed_contract_sha256
    or auth->'capabilities' is distinct from '["BULK_SIGNED"]'::jsonb
    or auth->>'fixture_namespace' is distinct from 'WSQ_TEST_'
    or auth->>'authorization_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PROTECTED_TEST_SETUP_AUTHORIZATION_V1',auth-'authorization_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_AUTHORIZATION_REQUIRED' using errcode='55000'; end if;
  -- This is an observed latest installed release, not function-presence READY.
  if private.weekly_source_protected_qualification_release_v1()->>'release_id' is distinct from r.release_id then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_INSTALLED_RELEASE_REQUIRED' using errcode='55000'; end if;
  return auth;
exception when no_data_found or too_many_rows or invalid_text_representation then
  raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_AUTHORIZATION_REQUIRED' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_protected_test_scope_assert_v1(
  p_cycle_id uuid,p_actor_user_id uuid,p_original_client_ids uuid[],p_work_event_id uuid default null
) returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare lease jsonb; auth jsonb; n integer; c public.weekly_source_cycles%rowtype;
  g public.weekly_source_groups%rowtype; clients uuid[]; expected jsonb; item jsonb; actual jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict c from public.weekly_source_cycles where id=p_cycle_id;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and active and source_family='ROSTER' and environment='TEST';
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'APPROVE_PROTECTED_PAY',g.id,null,c.finalisation_week_ending);
  select count(*),jsonb_agg(a.after_json)->0 into n,lease from public.audit_events a
    where a.object_type='weekly_source_protected_test_journey' and a.action='WEEKLY_SOURCE_TEST_JOURNEY_OPENED'
      and a.event_sequence_is_authoritative and a.after_json->>'source_cycle_id'=c.id::text
      and a.after_json->>'journey_actor_user_id'=p_actor_user_id::text
      and not exists(select 1 from public.audit_events closed where closed.object_type=a.object_type
        and closed.object_id_text=a.object_id_text and closed.event_sequence_is_authoritative
        and closed.action in ('WEEKLY_SOURCE_TEST_JOURNEY_CLOSED','WEEKLY_SOURCE_TEST_JOURNEY_REVOKED'));
  if n<>1 or lease->>'contract' is distinct from 'WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_V1'
    or lease->'operational_ready' is distinct from 'false'::jsonb
    or lease->>'scope_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_V1',lease-'scope_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  auth:=private.weekly_source_protected_test_authorization_v1((lease->>'authorization_id')::uuid);
  if lease->>'authorization_sha256' is distinct from auth->>'authorization_sha256'
    or lease->>'scope_id' is distinct from auth->>'scope_id'
    or lease->>'source_cycle_id' is distinct from auth->>'source_cycle_id'
    or lease->>'journey_actor_user_id' is distinct from auth->>'journey_actor_user_id'
    or lease->>'week_ending' is distinct from c.finalisation_week_ending::text
    or auth->>'agency_id' is distinct from g.agency_id::text or auth->>'source_group_id' is distinct from g.id::text
    or clock_timestamp()>=(auth->>'expires_at_utc')::timestamptz
    or (clock_timestamp() at time zone 'Europe/London')::date is distinct from (lease->>'opened_local_date')::date
    or exists(select 1 from public.weekly_source_group_rule_assignments a where a.source_group_id=g.id and a.feature_enabled
      and c.finalisation_week_ending between a.effective_from_week_ending and coalesce(a.effective_to_week_ending,'infinity'::date))
    or private.weekly_source_bulk_producer_ready_v1(c.id) or private.weekly_source_automatic_reconcile_producer_ready_v1(c.id) then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  select array_agg(value::uuid order by value::uuid) into clients
    from jsonb_array_elements_text(auth#>'{original_census,original_client_ids}') value;
  if p_original_client_ids is not null and to_jsonb(p_original_client_ids) is distinct from to_jsonb(clients) then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_ORIGINAL_CENSUS_CHANGED' using errcode='40001'; end if;
  if private.weekly_source_bulk_source_cas_v1(c.id,clients) is distinct from auth#>'{original_census,source_cas}' then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_SOURCE_CHANGED' using errcode='40001'; end if;
  for item in select value from jsonb_array_elements(auth#>'{original_census,original_root_identities}') value loop
    select jsonb_build_object('timesheet_id',s.timesheet_id,'booking_id',s.booking_id,'contract_id',k.id,
      'candidate_id',k.candidate_id,'client_id',s.client_id) into actual
      from public.timesheets s join public.contracts k on k.id=s.contract_id
      where s.timesheet_id=(item->>'timesheet_id')::uuid and (s.client_id is null or s.client_id=k.client_id);
    if actual is distinct from item then raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_ORIGINAL_ROOT_CHANGED' using errcode='40001'; end if;
  end loop;
  if p_work_event_id is not null and not exists(select 1 from jsonb_array_elements(auth#>'{original_census,original_items}') item
    where item->>'work_event_id'=p_work_event_id::text) then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_FOREIGN_EVENT_REFUSED' using errcode='42501'; end if;
  return lease||jsonb_build_object('original_census',auth->'original_census','capabilities',auth->'capabilities');
exception when no_data_found or too_many_rows or invalid_text_representation or datetime_field_overflow then
  raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

-- This write helper is not a new public/service RPC. The existing admin-only
-- feature setup owner dispatches OPEN/CLOSE/REVOKE, always before feature writes.
create or replace function private.weekly_source_protected_test_setup_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare actor uuid; auth jsonb; lease jsonb; result jsonb; c public.weekly_source_cycles%rowtype;
  g public.weekly_source_groups%rowtype; action text; manifest jsonb; census jsonb; n integer; q jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['actor_user_id','agency_id','environment','qualification_action',
      'authorization_id','expected_authorization_sha256','reason'])
    or not(p_request ?& array['actor_user_id','agency_id','environment','qualification_action','authorization_id','expected_authorization_sha256','reason'])
    or char_length(coalesce(p_request->>'reason','')) not between 1 and 500 then
    raise exception 'WEEKLY_SOURCE_TEST_SETUP_REQUEST_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid;action:=p_request->>'qualification_action';
  perform private._weekly_source_settings_require_admin_v1(actor);
  if private._weekly_source_settings_deployment_v1((p_request->>'agency_id')::uuid,p_request->>'environment')<>'TEST'
    or action not in ('OPEN','CLOSE','REVOKE') then raise exception 'WEEKLY_SOURCE_TEST_SETUP_REQUEST_INVALID' using errcode='22023'; end if;
  auth:=private.weekly_source_protected_test_authorization_v1((p_request->>'authorization_id')::uuid);
  if auth->>'authorization_sha256' is distinct from p_request->>'expected_authorization_sha256'
    or auth->>'setup_actor_user_id' is distinct from actor::text or auth->>'agency_id' is distinct from p_request->>'agency_id' then
    raise exception 'WEEKLY_SOURCE_TEST_SETUP_AUTHORIZATION_CHANGED' using errcode='40001'; end if;
  perform pg_advisory_xact_lock(hashtextextended('weekly-source-test-journey:'||(auth->>'scope_id'),0));
  select * into strict c from public.weekly_source_cycles where id=(auth->>'source_cycle_id')::uuid;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and id=(auth->>'source_group_id')::uuid
    and active and source_family='ROSTER' and environment='TEST';
  if g.code is distinct from auth#>>'{fixture_manifest,group_code}' or g.code !~ '^WSQ_TEST_[A-Z0-9_]+$'
    or g.agency_id::text is distinct from auth->>'agency_id'
    or c.finalisation_week_ending::text is distinct from auth->>'week_ending' then
    raise exception 'WEEKLY_SOURCE_TEST_SETUP_FIXTURE_SCOPE_INVALID' using errcode='42501'; end if;
  select count(*),jsonb_agg(a.after_json)->0 into n,lease from public.audit_events a
    where a.object_type='weekly_source_protected_test_journey' and a.object_id_text=auth->>'scope_id'
      and a.action='WEEKLY_SOURCE_TEST_JOURNEY_OPENED' and a.event_sequence_is_authoritative;
  if exists(select 1 from public.audit_events a where a.object_type='weekly_source_protected_test_journey'
    and a.object_id_text=auth->>'scope_id' and a.event_sequence_is_authoritative
    and a.action in ('WEEKLY_SOURCE_TEST_JOURNEY_CLOSED','WEEKLY_SOURCE_TEST_JOURNEY_REVOKED')) then
    raise exception 'WEEKLY_SOURCE_TEST_SETUP_SCOPE_TERMINAL' using errcode='55000'; end if;
  if action='OPEN' then
    perform private.weekly_source_office_authority_v1((auth->>'journey_actor_user_id')::uuid,'APPROVE_PROTECTED_PAY',g.id,null,c.finalisation_week_ending);
    if n<>0 or (auth->>'expires_at_utc')::timestamptz<=clock_timestamp()
      or (auth->>'expires_at_utc')::timestamptz>clock_timestamp()+interval '2 hours'
      or exists(select 1 from public.weekly_source_group_rule_assignments a where a.source_group_id=g.id and a.feature_enabled
        and c.finalisation_week_ending between a.effective_from_week_ending and coalesce(a.effective_to_week_ending,'infinity'::date))
      or private.weekly_source_bulk_producer_ready_v1(c.id) or private.weekly_source_automatic_reconcile_producer_ready_v1(c.id) then
      raise exception 'WEEKLY_SOURCE_TEST_SETUP_OPEN_REFUSED' using errcode='55000'; end if;
    census:=private.weekly_source_protected_qualification_census_v1(c.id);
    if census is distinct from auth->'original_census' then raise exception 'WEEKLY_SOURCE_TEST_SETUP_CENSUS_CHANGED' using errcode='40001'; end if;
    manifest:=auth->'fixture_manifest';
    if manifest->'client_ids' is distinct from census->'original_client_ids'
      or (select coalesce(jsonb_agg(distinct item->'candidate_id' order by item->'candidate_id'),'[]'::jsonb)
        from jsonb_array_elements(census->'original_items') item) is distinct from manifest->'candidate_ids'
      or (select coalesce(jsonb_agg(distinct item->'contract_id' order by item->'contract_id'),'[]'::jsonb)
        from jsonb_array_elements(census->'original_items') item) is distinct from manifest->'contract_ids'
      or (select coalesce(jsonb_agg(distinct item->'work_event_id' order by item->'work_event_id'),'[]'::jsonb)
        from jsonb_array_elements(census->'original_items') item) is distinct from manifest->'work_event_ids'
      or (select coalesce(jsonb_agg(item->'timesheet_id' order by item->'timesheet_id'),'[]'::jsonb)
        from jsonb_array_elements(census->'original_root_identities') item) is distinct from manifest->'original_root_ids'
      or (select coalesce(jsonb_agg(item->'client_id' order by item->'client_id'),'[]'::jsonb)
        from jsonb_array_elements(manifest->'client_refs') item) is distinct from manifest->'client_ids'
      or (select coalesce(jsonb_agg(item->'candidate_id' order by item->'candidate_id'),'[]'::jsonb)
        from jsonb_array_elements(manifest->'candidate_refs') item) is distinct from manifest->'candidate_ids'
      or exists(select 1 from jsonb_array_elements(manifest->'client_refs') item
        where coalesce(item->>'cli_ref','') !~ '^CLI-913013[0-9]{2}$'
          or not exists(select 1 from public.clients client where client.id=(item->>'client_id')::uuid and client.cli_ref=item->>'cli_ref'))
      or exists(select 1 from jsonb_array_elements(manifest->'candidate_refs') item
        where coalesce(item->>'tms_ref','') !~ '^CCR-913013[0-9]{2}$'
          or not exists(select 1 from public.candidates candidate where candidate.id=(item->>'candidate_id')::uuid and candidate.tms_ref=item->>'tms_ref')) then
      raise exception 'WEEKLY_SOURCE_TEST_SETUP_FIXTURE_SCOPE_INVALID' using errcode='42501'; end if;
    -- Explicit prerequisite evidence stays NON-OPERATIONAL. Its NEXT_PAY row
    -- must be a genuine installed Banking prerequisite; root's managed writer
    -- binds the artifact/record. Function presence is never accepted here.
    select value into strict q from private.cloudtms_database_releases r,
      lateral jsonb_array_elements(r.evidence_json->'weekly_source_protected_prerequisite_qualifications') value
      where r.release_id=auth->>'release_id' and value->>'qualification_sha256'=auth->>'prerequisite_qualification_sha256';
    perform private.weekly_source_protected_prerequisite_release_assert_v2(q,g.id,
      (q->>'effective_from_week_ending')::date,(q->>'effective_to_week_ending')::date,auth->>'prerequisite_qualification_sha256');
    if q->'capabilities' is distinct from '["BULK_SIGNED"]'::jsonb
      or not exists(select 1 from jsonb_array_elements(q->'gate_receipts') receipt
        where receipt->>'gate'='NEXT_PAY' and receipt->>'status'='PREREQUISITE_PASS') then
      raise exception 'WEEKLY_SOURCE_TEST_SETUP_NEXT_PREREQUISITE_REQUIRED' using errcode='55000'; end if;
    lease:=jsonb_build_object('contract','WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_V1','scope_id',auth->>'scope_id',
      'authorization_id',auth->>'authorization_id','authorization_sha256',auth->>'authorization_sha256',
      'source_group_id',g.id,'source_cycle_id',c.id,'agency_id',g.agency_id,'week_ending',c.finalisation_week_ending,
      'journey_actor_user_id',auth->>'journey_actor_user_id','setup_actor_user_id',actor,'expires_at_utc',auth->>'expires_at_utc',
      'opened_local_date',(clock_timestamp() at time zone 'Europe/London')::date,'operational_ready',false);
    lease:=lease||jsonb_build_object('scope_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_V1',lease),'hex'));
    perform public._audit_insert('weekly_source_protected_test_journey',auth->>'scope_id','WEEKLY_SOURCE_TEST_JOURNEY_OPENED',null,lease,p_request->>'reason',actor);
    return lease;
  end if;
  if n<>1 then raise exception 'WEEKLY_SOURCE_TEST_SETUP_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  if action='CLOSE' then
    perform private.weekly_source_protected_test_scope_assert_v1(c.id,(auth->>'journey_actor_user_id')::uuid,null,null);
    result:=jsonb_build_object('scope_id',auth->>'scope_id','scope_sha256',lease->>'scope_sha256','setup_authorization_sha256',auth->>'authorization_sha256',
      'original_census_sha256',auth#>>'{original_census,census_sha256}','actor_user_id',auth->>'journey_actor_user_id',
      'source_cycle_id',c.id,'week_ending',c.finalisation_week_ending,'execution_release_id',auth->>'release_id',
      'execution_source_commit',auth->>'source_commit','execution_contract_sha256',auth->>'contract_sha256',
      'state','CLOSED','closed_at_utc',clock_timestamp(),'all_assignments_disabled',true,'all_operational_producers_false',true);
  else
    result:=jsonb_build_object('scope_id',auth->>'scope_id','state','REVOKED','closed_at_utc',clock_timestamp(),'operational_ready',false);
  end if;
  perform public._audit_insert('weekly_source_protected_test_journey',auth->>'scope_id',
    case when action='CLOSE' then 'WEEKLY_SOURCE_TEST_JOURNEY_CLOSED' else 'WEEKLY_SOURCE_TEST_JOURNEY_REVOKED' end,
    lease,result,p_request->>'reason',actor);
  return result;
exception when no_data_found or too_many_rows or invalid_text_representation or datetime_field_overflow then
  raise exception 'WEEKLY_SOURCE_TEST_SETUP_REQUEST_INVALID' using errcode='22023';
end;
$function$;
