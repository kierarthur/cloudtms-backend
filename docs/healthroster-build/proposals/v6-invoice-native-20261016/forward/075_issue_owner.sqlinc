create or replace function private.invoice_contract_move_credit_ready_v1(p_invoice_id uuid,p_lock boolean)
returns boolean language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare g private.timesheet_contract_move_replacement_groups%rowtype;required record;credit public.invoices%rowtype;v_count integer;
begin
 select count(*) into v_count from private.timesheet_contract_move_replacement_groups x where coalesce(x.invoice_id,x.planned_invoice_id)=p_invoice_id;
 if v_count=0 then return true;end if;
 if v_count<>1 then raise exception 'CONTRACT_MOVE_INVOICE_GROUP_AMBIGUOUS' using errcode='55000';end if;
 select x.* into strict g from private.timesheet_contract_move_replacement_groups x where coalesce(x.invoice_id,x.planned_invoice_id)=p_invoice_id;
 if p_lock then perform 1 from private.timesheet_contract_move_replacement_groups x
  where x.operation_id=g.operation_id and x.billing_revision=g.billing_revision and x.group_key=g.group_key for update;end if;
 if not exists(select 1 from private.timesheet_contract_move_operations o where o.id=g.operation_id
  and o.state='COMPLETE' and o.billing_revision=g.billing_revision) then return false;end if;
 for required in select s.* from private.timesheet_contract_move_invoice_scopes s
  where s.operation_id=g.operation_id and s.billing_revision=g.billing_revision order by s.original_invoice_id loop
  if p_lock then perform 1 from public.invoices i where i.id=required.credit_note_id for update;end if;
  select i.* into credit from public.invoices i where i.id=required.credit_note_id;
  if credit.id is null or credit.type<>'CREDIT_NOTE' or credit.original_invoice_id is distinct from required.original_invoice_id
   or credit.issued_at_utc is null or credit.status::text not in('ISSUED','PAID')
   or credit.header_snapshot_json#>>'{credit_scope,original_scope_id}' is distinct from required.id::text
   or credit.header_snapshot_json#>>'{credit_scope,billing_revision}' is distinct from required.billing_revision::text
   or credit.subtotal_ex_vat is distinct from -(select sum(l.total_charge_ex_vat) from public.invoice_lines l where l.id=any(required.original_line_ids))
   or credit.vat_amount is distinct from -(select sum(l.vat_amount) from public.invoice_lines l where l.id=any(required.original_line_ids))
   or credit.total_inc_vat is distinct from -(select sum(l.total_inc_vat) from public.invoice_lines l where l.id=any(required.original_line_ids))
   or (select count(*) from public.invoice_lines l where l.invoice_id=credit.id)<>cardinality(required.original_line_ids)
   or exists(select 1 from public.invoice_lines l where l.invoice_id=credit.id and not exists(
     select 1 from public.invoice_lines original where original.id=any(required.original_line_ids)
      and l.meta_json->>'original_invoice_line_id'=original.id::text
      and l.total_charge_ex_vat=-original.total_charge_ex_vat and l.vat_amount=-original.vat_amount and l.total_inc_vat=-original.total_inc_vat))
   or not exists(select 1 from public.invoice_document_versions d where d.id=credit.issued_document_version_id
    and d.entity_id=credit.id and d.entity_type='INVOICE' and d.purpose='FINAL_ISSUE' and d.status='READY'
    and d.verified_at_utc is not null and d.r2_key is not null and d.sha256 is not null and d.size_bytes>0 and d.page_count>0)
   or not exists(select 1 from public.invoice_operation_chunks c join public.invoice_operations o on o.id=c.operation_id
    where c.entity_id=credit.id and c.chunk_type='ISSUE_INVOICE' and c.phase in('COMPLETE','QUEUE_DELIVERY')
      and o.operation_type='ISSUE_INVOICES' and c.result_json->>'document_version_id'=credit.issued_document_version_id::text) then
   return false;end if;
 end loop;
 return true;
end;
$function$;

create or replace function private.invoice_contract_move_issue_context_v1(p_invoice_id uuid,p_actor_user_id uuid,p_lock boolean)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare v_operation uuid;v_revision bigint;v_ids uuid[];v_credits uuid[];v_count integer;
begin
 select count(*) into v_count from (
  select x.operation_id,x.billing_revision from private.timesheet_contract_move_replacement_groups x where coalesce(x.invoice_id,x.planned_invoice_id)=p_invoice_id
  union select x.operation_id,x.billing_revision from private.timesheet_contract_move_invoice_scopes x where x.credit_note_id=p_invoice_id) owners;
 if v_count=0 then return null;end if;
 if v_count<>1 then raise exception 'CONTRACT_MOVE_INVOICE_GROUP_AMBIGUOUS' using errcode='55000';end if;
 select operation_id,billing_revision into v_operation,v_revision from (
  select x.operation_id,x.billing_revision from private.timesheet_contract_move_replacement_groups x where coalesce(x.invoice_id,x.planned_invoice_id)=p_invoice_id
  union select x.operation_id,x.billing_revision from private.timesheet_contract_move_invoice_scopes x where x.credit_note_id=p_invoice_id) owners;
 if not found then return null;end if;
 if not exists(select 1 from public.tms_users u where u.id=p_actor_user_id and u.is_active and upper(u.role::text)='ADMIN') then
  raise exception 'INVOICE_ISSUE_ACTOR_NOT_ALLOWED' using errcode='42501';end if;
 select array_agg(credit_note_id order by original_invoice_id) into v_credits
  from private.timesheet_contract_move_invoice_scopes where operation_id=v_operation and billing_revision=v_revision;
 select array_agg(id order by id) into v_ids from (
  select unnest(v_credits) id union select coalesce(invoice_id,planned_invoice_id) from private.timesheet_contract_move_replacement_groups
   where operation_id=v_operation and billing_revision=v_revision) members;
 if array_position(v_ids,null) is not null or cardinality(v_ids)=0 then
  raise exception 'CONTRACT_MOVE_NATIVE_DRAFT_PREPARATION_PENDING' using errcode='55000';end if;
 if p_lock then perform 1 from public.invoices i where i.id=any(v_ids) order by i.id for update;end if;
 if (select count(*) from public.invoices i where i.id=any(v_ids) and i.client_id=(select actual_client_id
  from private.timesheet_contract_move_operations where id=v_operation))<>cardinality(v_ids) then
  raise exception 'CONTRACT_MOVE_ISSUE_GROUP_SCOPE_CHANGED' using errcode='55000';end if;
 return jsonb_build_object('version','INVOICE_CONTRACT_MOVE_ISSUE_CONTEXT_V1','operation_id',v_operation,
  'billing_revision',v_revision::text,'invoice_ids',to_jsonb(v_ids),'required_credit_invoice_ids',to_jsonb(v_credits));
end;
$function$;

create or replace function private.invoice_contract_move_issue_commands_v1(p_commands jsonb,p_actor_user_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare command jsonb;value text;context jsonb;v_ids uuid[];v_group uuid[];v_result jsonb:='[]';
begin
 for command in select x from jsonb_array_elements(p_commands) x loop
  if command#>>'{credit_scope,kind}'='CONTRACT_MOVE' then
   raise exception 'CONTRACT_MOVE_CREDIT_OWNER_ONLY' using errcode='42501';end if;
  if upper(command->>'command_type')='ISSUE_INVOICES' then
   v_ids:='{}';
   for value in select x from jsonb_array_elements_text(command->'invoice_ids') x loop
    context:=private.invoice_contract_move_issue_context_v1(value::uuid,p_actor_user_id,true);
    if context is null then v_ids:=array_append(v_ids,value::uuid);
    else select array_agg(x::uuid) into v_group from jsonb_array_elements_text(context->'invoice_ids') x;
     v_ids:=v_ids||v_group;end if;
   end loop;
   select array_agg(distinct x order by x) into v_ids from unnest(v_ids) x;
   command:=jsonb_set(command,'{invoice_ids}',to_jsonb(v_ids));
  end if;
  v_result:=v_result||jsonb_build_array(command);
 end loop;
 return v_result;
end;
$function$;
