      "id": "POSTGRES_BTRIM_ASCII_SPACE_ONLY",
      "old": "const same=(a,b)=>JSON.stringify(a)===JSON.stringify(b),quote=v=>\"'\"+String(v).replaceAll(\"'\",\"''\")+\"'\";",
      "new": "const same=(a,b)=>JSON.stringify(a)===JSON.stringify(b),quote=v=>\"'\"+String(v).replaceAll(\"'\",\"''\")+\"'\";\n// PostgreSQL btrim(text) removes U+0020 only. Preserve tabs, NBSP, BOM and\n// newlines exactly; JS trim and a $ regex anchor have different semantics.\nconst nativeBtrimSpaces=value=>{let start=0,end=value.length;\n while(start<end&&value.charCodeAt(start)===32)start++;\n while(end>start&&value.charCodeAt(end-1)===32)end--;return value.slice(start,end);};"
    },
    {
      "id": "EXACT_NATIVE_MEMBER_CANONICAL_BOOKING",
      "old": "member.canonical_booking_id!==member.raw_booking_id.trim()",
      "new": "member.canonical_booking_id!==nativeBtrimSpaces(member.raw_booking_id)"
    }
  ],
