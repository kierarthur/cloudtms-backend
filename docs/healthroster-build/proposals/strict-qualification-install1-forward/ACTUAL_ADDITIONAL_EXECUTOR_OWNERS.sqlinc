-- private.bpay_next_source_query_refresh_v1(uuid,uuid); supabase/repeatable/11102026_2337_banking_pay_next_source_query_workbench_refresh_v1.sql; SHA256 6f195ed2753fac20e0b29454c5862c9780a45ae434bb03ac3a67954ff654a4bf
create or replace function private.bpay_next_source_query_refresh_v1(p_contract_id uuid,p_work_event_id uuid)
returns void language plpgsql volatile security definer set search_path=pg_catalog,private
as $function$
declare v_ids uuid[];v_id uuid;
begin
 -- Identity only; eligibility is decided by the current Workbench classifier.
 if (select m.active_owner from private.bpay_next_module_control m where m.id=1) is distinct from 'NEXT' then return;end if;
 select array_agg(x.id order by x.id) into v_ids from (
  select distinct w.id from public.weekly_work_events e
  join public.contracts c on c.id=p_contract_id and c.candidate_id=e.candidate_id and c.client_id=e.client_id
  join public.contract_weeks cw on cw.contract_id=c.id and cw.additional_seq=0 and cw.is_adjustment is false
   and cw.week_ending_date between e.work_date and e.work_date+6
  join public.timesheets t on t.timesheet_id=cw.timesheet_id and t.contract_id=c.id
   and t.week_ending_date=cw.week_ending_date and t.is_adjustment is false
   and t.sheet_scope='WEEKLY' and t.line_type='HOURS'
  join private.bpay_next_work w on w.booking_id=t.booking_id and w.contract_id=c.id and w.work_kind='SOURCE'
   and w.candidate_id=e.candidate_id and w.week_ending_date=cw.week_ending_date
  where e.id=p_work_event_id order by w.id limit 2
 ) x;
 if coalesce(cardinality(v_ids),0)=0 then return;end if;
 if cardinality(v_ids)<>1 then
  raise exception using errcode='23514',message='BPAY_NEXT_SOURCE_QUERY_WORK_IDENTITY_AMBIGUOUS';end if;
 v_id:=v_ids[1];
 perform private.bpay_next_workbench_refresh_work_v1(v_id);
end
$function$;

-- private.bpay_next_workbench_refresh_work_v1(uuid); supabase/repeatable/10102026_1438_banking_pay_next_workbench_origin_projection_v1.sql; SHA256 2085a8953d8f2f7237f37f02efad4758502ba92c9c6f789af1ffb01b5b381078
create or replace function private.bpay_next_workbench_refresh_work_v1(p_work_id uuid)
returns void language plpgsql security definer set search_path=pg_catalog,private
as $function$
declare v_work private.bpay_next_work%rowtype;v_candidate uuid;v_before boolean;v_after boolean;
  v_cases uuid[];v_id uuid;v_task private.bpay_next_workbench_task%rowtype;
begin
  perform private.bpay_next_workbench_require_next_v1();
  select candidate_id into strict v_candidate from private.bpay_next_work where id=p_work_id;
  perform 1 from private.bpay_next_worker_control where candidate_id=v_candidate for update;
  select task_row.* into strict v_work from private.bpay_next_work task_row where id=p_work_id for update;
  select task_row.* into v_task from private.bpay_next_workbench_task task_row where task_key='ORIGIN:'||p_work_id::text and status<>'DONE';
  if v_task.id is not null then
    perform private.bpay_next_workbench_queue_origin_v1(p_work_id);return;
  end if;
  select exists(select 1 from private.bpay_next_workbench_item where work_id=p_work_id
    and reason_code='AWAITING_REAUTHORISATION') into v_before;
  v_after:=private.bpay_next_work_wait_state_v1(p_work_id);
  if v_before and v_work.approval_state='APPROVED' and v_work.current_revision_id is distinct from v_work.applied_revision_id then
    perform private.bpay_next_workbench_refresh_work_core_v1(p_work_id);return;
  end if;
  if v_before is distinct from v_after then
    select array_agg(x.case_id order by x.case_id) into v_cases from(select distinct wc.case_id
      from private.bpay_next_work_collection wc where wc.work_id=p_work_id and wc.case_id is not null
      order by wc.case_id limit 100) x;
    if coalesce(cardinality(v_cases),0)=100 then
      perform private.bpay_next_workbench_queue_origin_v1(p_work_id);return;
    end if;
    perform 1 from private.bpay_next_finance_case where id=any(v_cases) order by id for update;
  end if;
  perform private.bpay_next_workbench_refresh_work_core_v1(p_work_id);
  for v_id in select unnest(v_cases) order by 1 loop
    perform private.bpay_next_workbench_refresh_case_v1(v_id);
  end loop;
end
$function$;

-- private.bpay_next_work_wait_state_v1(uuid); supabase/repeatable/10102026_1332_banking_pay_next_withdrawal_projection_v1.sql; SHA256 3c72b58b213543a9ce655d0a73f027f8c21e0d27898373863147d1d8eda3ad87
create or replace function private.bpay_next_work_wait_state_v1(p_work_id uuid)
returns boolean language plpgsql stable security definer set search_path=pg_catalog,private
as $function$
declare v_state text;
begin
  perform private.bpay_next_workbench_require_next_v1();
  select w.approval_state into strict v_state from private.bpay_next_work w where w.id=p_work_id;
  return v_state='WITHDRAWN' and coalesce((select sum(p.realised_source_ex_vat)
    from private.bpay_next_position p where p.work_id=p_work_id),0)>0;
end
$function$;

-- private.bpay_next_workbench_require_next_v1(); supabase/repeatable/10102026_1252_banking_pay_next_workbench_summary_v1.sql; SHA256 9a5ae058f859672cbae7c81d4b45f28e5ca2ab9f695316b5ca49a208b7472359
create or replace function private.bpay_next_workbench_require_next_v1()
returns void language plpgsql stable security definer set search_path=pg_catalog,private
as $function$
begin
  if not exists(select 1 from private.bpay_next_module_control m where m.id=1 and m.active_owner='NEXT') then
    raise exception using errcode='55000',message='BPAY_NEXT_MODULE_NOT_ACTIVE';
  end if;
end
$function$;

-- private.bpay_next_workbench_queue_origin_v1(uuid); supabase/repeatable/10102026_1429_banking_pay_next_workbench_current_continuation_v1.sql; SHA256 cc916b7b7d54c48b24188a88b27966a735e12deb476d9a65b104e10d91a79ad5
create or replace function private.bpay_next_workbench_queue_origin_v1(p_work_id uuid)
returns void language plpgsql security definer set search_path=pg_catalog,private
as $function$
declare v_candidate uuid;
begin
  perform private.bpay_next_workbench_require_next_v1();
  select candidate_id into strict v_candidate from private.bpay_next_work where id=p_work_id;
  perform 1 from private.bpay_next_worker_control where candidate_id=v_candidate for update;
  perform 1 from private.bpay_next_work where id=p_work_id for update;
  perform private.bpay_next_workbench_schedule_task_v1('ORIGIN',v_candidate,p_work_id,null,false,false);
  perform private.bpay_next_workbench_mark_processing_v1(p_work_id);
end
$function$;

-- private.bpay_next_workbench_mark_processing_v1(uuid); supabase/repeatable/10102026_1346_banking_pay_next_position_projection_boundary_v1.sql; SHA256 5bef5f9f0554e4a4ef83d1ffdea985357908ccb56efa960d9db2217826116323
create or replace function private.bpay_next_workbench_mark_processing_v1(p_work_id uuid)
returns void language plpgsql security definer set search_path=pg_catalog,private
as $function$
declare
  v_work private.bpay_next_work%rowtype;v_revision private.bpay_next_work_revision%rowtype;
  v_metadata private.bpay_next_workbench_candidate_metadata%rowtype;v_item private.bpay_next_workbench_item%rowtype;
  v_before private.bpay_next_workbench_delta[];v_after private.bpay_next_workbench_delta[];
  v_candidate uuid;v_client uuid;v_target text;v_financial bigint;v_projection bigint;v_was_dirty boolean;v_wait boolean;
  v_group text:='WORK:'||p_work_id::text;
begin
  perform private.bpay_next_workbench_require_next_v1();
  select w.candidate_id into strict v_candidate from private.bpay_next_work w where w.id=p_work_id;
  select c.financial_view_revision into strict v_financial from private.bpay_next_worker_control c
    where c.candidate_id=v_candidate for update;
  select w.* into strict v_work from private.bpay_next_work w where w.id=p_work_id for update;
  v_metadata:=private.bpay_next_workbench_ensure_metadata_v1(v_candidate);
  select c.pay_method::text into v_target from public.candidates c where c.id=v_candidate;
  if v_target not in ('PAYE','UMBRELLA') then v_target:=null;end if;
  select c.client_id into v_client from public.contracts c where c.id=v_work.contract_id;
  select r.* into v_revision from private.bpay_next_work_revision r where r.work_id=v_work.id
    and r.id=coalesce(v_work.current_revision_id,v_work.applied_revision_id);
  select exists(select 1 from private.bpay_next_workbench_group g where g.group_key=v_group and g.dirty) into v_was_dirty;
  -- Preserve the real stored-before WAIT marker across reauthorisation pages.
  select exists(select 1 from private.bpay_next_workbench_item i where i.group_key=v_group
    and i.reason_code='AWAITING_REAUTHORISATION') into v_wait;
  if v_work.approval_state='WITHDRAWN' then v_wait:=private.bpay_next_work_wait_state_v1(v_work.id);end if;
  select array_agg(d) into v_before from private.bpay_next_workbench_group_contribution_v1(v_group) d;
  update private.bpay_next_workbench_revision set workbench_revision=workbench_revision+1,
    dirty_group_count=dirty_group_count+case when v_was_dirty then 0 else 1 end,
    updated_at_utc=transaction_timestamp() where id=1 returning workbench_revision into v_projection;
  delete from private.bpay_next_workbench_item where group_key=v_group;
  insert into private.bpay_next_workbench_group(group_key,group_kind,work_id,candidate_id,client_id,contract_id,
    physical_timesheet_id,current_revision_id,source_pay_channel,target_pay_channel,week_ending_date,
    complete,dirty,projection_revision,financial_view_revision,metadata_version,progress_state,certified_zero,
    ready_count,action_count,blocked_count,waiting_count)
  values(v_group,'WORK',v_work.id,v_candidate,v_client,v_work.contract_id,v_revision.physical_timesheet_id,
    v_work.current_revision_id,v_revision.source_pay_channel,v_target,v_work.week_ending_date,false,true,
    v_projection,v_financial,v_metadata.metadata_version,'PROCESSING',false,0,case when v_wait then 1 else 0 end,
    case when v_wait then 0 else 1 end,0)
  on conflict(group_key) do update set client_id=excluded.client_id,contract_id=excluded.contract_id,
    physical_timesheet_id=excluded.physical_timesheet_id,current_revision_id=excluded.current_revision_id,
    source_pay_channel=excluded.source_pay_channel,target_pay_channel=excluded.target_pay_channel,
    week_ending_date=excluded.week_ending_date,complete=false,dirty=true,certified_zero=false,
    projection_revision=excluded.projection_revision,financial_view_revision=excluded.financial_view_revision,
    metadata_version=excluded.metadata_version,progress_state='PROCESSING',error_code=null,
    ready_count=excluded.ready_count,action_count=excluded.action_count,blocked_count=excluded.blocked_count,
    waiting_count=0,updated_at_utc=transaction_timestamp();
  v_item:=null;v_item.id:=gen_random_uuid();v_item.group_key:=v_group;v_item.candidate_id:=v_candidate;
  v_item.work_id:=v_work.id;v_item.revision_id:=v_revision.id;v_item.member_kind:='GROUP_EVIDENCE';
  v_item.member_key:=v_work.id::text;v_item.component_key:='';v_item.portion_kind:='EVIDENCE';
  v_item.client_id:=v_client;v_item.contract_id:=v_work.contract_id;v_item.physical_timesheet_id:=v_revision.physical_timesheet_id;
  v_item.week_ending_date:=v_work.week_ending_date;v_item.candidate_display_name:=v_metadata.candidate_sort_name;
  v_item.candidate_reference:=v_metadata.tms_ref;v_item.client_display_name:=v_revision.client_display_name;
  v_item.timesheet_reference:=v_revision.timesheet_reference;v_item.source_pay_channel:=v_revision.source_pay_channel;
  v_item.target_pay_channel:=v_target;v_item.direction:='INFORMATIONAL';v_item.amount_known:=false;
  v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.selectable:=false;
  v_item.section:=case when v_wait then 'ACTION' else 'BLOCKED' end;
  v_item.reason_code:=case when v_wait then 'AWAITING_REAUTHORISATION'
    when v_work.approval_state='WITHDRAWN' then 'APPROVAL_WITHDRAWN' else 'APPLY_PENDING' end;
  v_item.reason_priority:=case when v_wait then 70 when v_work.approval_state='WITHDRAWN' then 20 else 30 end;
  v_item.query_state:='NOT_APPLICABLE';v_item.query_qualified:=false;v_item.progress_state:='PROCESSING';
  v_item.financial_view_revision:=v_financial;v_item.projection_revision:=v_projection;v_item.metadata_version:=v_metadata.metadata_version;
  v_item.updated_at_utc:=transaction_timestamp();insert into private.bpay_next_workbench_item select (v_item).*;
  select array_agg(d) into v_after from private.bpay_next_workbench_group_contribution_v1(v_group) d;
  perform private.bpay_next_workbench_apply_delta_v1(v_before,v_after);
end
$function$;

-- private.bpay_next_workbench_apply_delta_v1(private.bpay_next_workbench_delta[],private.bpay_next_workbench_delta[]); supabase/repeatable/10102026_1252_banking_pay_next_workbench_summary_v1.sql; SHA256 dba46ba1ffe21dc729f06c1d1f795a0827037a0890f4f525c2eaf14e057b3600
create or replace function private.bpay_next_workbench_apply_delta_v1(
  p_before private.bpay_next_workbench_delta[],p_after private.bpay_next_workbench_delta[])
returns void language plpgsql security definer set search_path=pg_catalog,private
as $function$
declare v record;v_old_count bigint;v_new_count bigint;v_revision bigint;
  v_metadata private.bpay_next_workbench_candidate_metadata%rowtype;
begin
  perform private.bpay_next_workbench_require_next_v1();
  if coalesce(cardinality(p_before),0)>20 or coalesce(cardinality(p_after),0)>20
    or coalesce(pg_column_size(p_before),0)+coalesce(pg_column_size(p_after),0)>32768 then
    raise exception using errcode='22023',message='BPAY_NEXT_WORKBENCH_DELTA_ENVELOPE_EXCEEDED';
  end if;
  select r.workbench_revision into strict v_revision from private.bpay_next_workbench_revision r where r.id=1 for update;
  for v in
    with signed as (
      select b.candidate_id,b.client_id,b.client_scope,b.pay_channel,b.section,-b.item_count item_count,-b.contribution_count contribution_count,-b.segment_count segment_count,-b.payable_count payable_count,-b.selected_count selected_count,-b.snoozed_count snoozed_count,-b.held_count held_count,-b.queried_count queried_count,-b.blocked_count blocked_count,-b.deduction_item_count deduction_item_count,-b.unknown_amount_count unknown_amount_count,-b.unknown_selected_amount_count unknown_selected_amount_count,-b.amount amount,-b.waiting_amount waiting_amount,-b.ready_net_add_amount ready_net_add_amount,-b.waiting_net_add_amount waiting_net_add_amount,-b.gross_deduction_balance gross_deduction_balance,-b.net_deduction_balance net_deduction_balance,-b.approved_amount approved_amount,-b.paid_credit_amount paid_credit_amount,-b.reserved_amount reserved_amount,-b.excluded_amount excluded_amount,-b.recovery_amount recovery_amount,-b.selected_amount selected_amount
      from unnest(coalesce(p_before,array[]::private.bpay_next_workbench_delta[])) b
      union all
      select a.candidate_id,a.client_id,a.client_scope,a.pay_channel,a.section,a.item_count,a.contribution_count,a.segment_count,a.payable_count,a.selected_count,a.snoozed_count,a.held_count,a.queried_count,a.blocked_count,a.deduction_item_count,a.unknown_amount_count,a.unknown_selected_amount_count,a.amount,a.waiting_amount,a.ready_net_add_amount,a.waiting_net_add_amount,a.gross_deduction_balance,a.net_deduction_balance,a.approved_amount,a.paid_credit_amount,a.reserved_amount,a.excluded_amount,a.recovery_amount,a.selected_amount
      from unnest(coalesce(p_after,array[]::private.bpay_next_workbench_delta[])) a
    ) select candidate_id,client_id,client_scope,pay_channel,section,sum(item_count) item_count,sum(contribution_count) contribution_count,sum(segment_count) segment_count,sum(payable_count) payable_count,sum(selected_count) selected_count,sum(snoozed_count) snoozed_count,sum(held_count) held_count,sum(queried_count) queried_count,sum(blocked_count) blocked_count,sum(deduction_item_count) deduction_item_count,sum(unknown_amount_count) unknown_amount_count,sum(unknown_selected_amount_count) unknown_selected_amount_count,sum(amount) amount,sum(waiting_amount) waiting_amount,sum(ready_net_add_amount) ready_net_add_amount,sum(waiting_net_add_amount) waiting_net_add_amount,sum(gross_deduction_balance) gross_deduction_balance,sum(net_deduction_balance) net_deduction_balance,sum(approved_amount) approved_amount,sum(paid_credit_amount) paid_credit_amount,sum(reserved_amount) reserved_amount,sum(excluded_amount) excluded_amount,sum(recovery_amount) recovery_amount,sum(selected_amount) selected_amount
      from signed group by candidate_id,client_id,client_scope,pay_channel,section
      having sum(item_count)<>0 or sum(contribution_count)<>0 or sum(segment_count)<>0 or sum(payable_count)<>0 or sum(selected_count)<>0 or sum(snoozed_count)<>0 or sum(held_count)<>0 or sum(queried_count)<>0 or sum(blocked_count)<>0 or sum(deduction_item_count)<>0 or sum(unknown_amount_count)<>0 or sum(unknown_selected_amount_count)<>0 or sum(amount)<>0 or sum(waiting_amount)<>0 or sum(ready_net_add_amount)<>0 or sum(waiting_net_add_amount)<>0 or sum(gross_deduction_balance)<>0 or sum(net_deduction_balance)<>0 or sum(approved_amount)<>0 or sum(paid_credit_amount)<>0 or sum(reserved_amount)<>0 or sum(excluded_amount)<>0 or sum(recovery_amount)<>0 or sum(selected_amount)<>0
      order by candidate_id,client_scope,pay_channel,section
  loop
    select m.* into strict v_metadata from private.bpay_next_workbench_candidate_metadata m where m.candidate_id=v.candidate_id;
    insert into private.bpay_next_workbench_candidate_summary(candidate_id,client_id,client_scope,pay_channel,section,
      candidate_sort_name,tms_ref,bank_warning_code,metadata_version,projection_revision)
      values(v.candidate_id,v.client_id,v.client_scope,v.pay_channel,v.section,v_metadata.candidate_sort_name,
        v_metadata.tms_ref,v_metadata.bank_warning_code,v_metadata.metadata_version,v_revision) on conflict do nothing;
    select c.item_count into strict v_old_count from private.bpay_next_workbench_candidate_summary c
      where (c.candidate_id,c.client_scope,c.pay_channel,c.section)=(v.candidate_id,v.client_scope,v.pay_channel,v.section) for update;
    update private.bpay_next_workbench_candidate_summary c set item_count=c.item_count+v.item_count,contribution_count=c.contribution_count+v.contribution_count,segment_count=c.segment_count+v.segment_count,payable_count=c.payable_count+v.payable_count,selected_count=c.selected_count+v.selected_count,snoozed_count=c.snoozed_count+v.snoozed_count,held_count=c.held_count+v.held_count,queried_count=c.queried_count+v.queried_count,blocked_count=c.blocked_count+v.blocked_count,deduction_item_count=c.deduction_item_count+v.deduction_item_count,unknown_amount_count=c.unknown_amount_count+v.unknown_amount_count,unknown_selected_amount_count=c.unknown_selected_amount_count+v.unknown_selected_amount_count,amount=c.amount+v.amount,waiting_amount=c.waiting_amount+v.waiting_amount,ready_net_add_amount=c.ready_net_add_amount+v.ready_net_add_amount,waiting_net_add_amount=c.waiting_net_add_amount+v.waiting_net_add_amount,gross_deduction_balance=c.gross_deduction_balance+v.gross_deduction_balance,net_deduction_balance=c.net_deduction_balance+v.net_deduction_balance,approved_amount=c.approved_amount+v.approved_amount,paid_credit_amount=c.paid_credit_amount+v.paid_credit_amount,reserved_amount=c.reserved_amount+v.reserved_amount,excluded_amount=c.excluded_amount+v.excluded_amount,recovery_amount=c.recovery_amount+v.recovery_amount,selected_amount=c.selected_amount+v.selected_amount,
      projection_revision=v_revision
      where (c.candidate_id,c.client_scope,c.pay_channel,c.section)=(v.candidate_id,v.client_scope,v.pay_channel,v.section)
      returning c.item_count into v_new_count;
    insert into private.bpay_next_workbench_scope_summary(client_id,client_scope,pay_channel,section,projection_revision)
      values(v.client_id,v.client_scope,v.pay_channel,v.section,v_revision) on conflict do nothing;
    update private.bpay_next_workbench_scope_summary c set item_count=c.item_count+v.item_count,contribution_count=c.contribution_count+v.contribution_count,segment_count=c.segment_count+v.segment_count,payable_count=c.payable_count+v.payable_count,selected_count=c.selected_count+v.selected_count,snoozed_count=c.snoozed_count+v.snoozed_count,held_count=c.held_count+v.held_count,queried_count=c.queried_count+v.queried_count,blocked_count=c.blocked_count+v.blocked_count,deduction_item_count=c.deduction_item_count+v.deduction_item_count,unknown_amount_count=c.unknown_amount_count+v.unknown_amount_count,unknown_selected_amount_count=c.unknown_selected_amount_count+v.unknown_selected_amount_count,amount=c.amount+v.amount,waiting_amount=c.waiting_amount+v.waiting_amount,ready_net_add_amount=c.ready_net_add_amount+v.ready_net_add_amount,waiting_net_add_amount=c.waiting_net_add_amount+v.waiting_net_add_amount,gross_deduction_balance=c.gross_deduction_balance+v.gross_deduction_balance,net_deduction_balance=c.net_deduction_balance+v.net_deduction_balance,approved_amount=c.approved_amount+v.approved_amount,paid_credit_amount=c.paid_credit_amount+v.paid_credit_amount,reserved_amount=c.reserved_amount+v.reserved_amount,excluded_amount=c.excluded_amount+v.excluded_amount,recovery_amount=c.recovery_amount+v.recovery_amount,selected_amount=c.selected_amount+v.selected_amount,
      candidate_count=c.candidate_count+(case when v_new_count>0 then 1 else 0 end)-(case when v_old_count>0 then 1 else 0 end),
      projection_revision=v_revision
      where (c.client_scope,c.pay_channel,c.section)=(v.client_scope,v.pay_channel,v.section);
    if v_new_count=0 then
      if exists(select 1 from private.bpay_next_workbench_candidate_summary c
        where (c.candidate_id,c.client_scope,c.pay_channel,c.section)=(v.candidate_id,v.client_scope,v.pay_channel,v.section)
          and (c.contribution_count<>0 or c.segment_count<>0 or c.payable_count<>0 or c.selected_count<>0 or c.snoozed_count<>0 or c.held_count<>0 or c.queried_count<>0 or c.blocked_count<>0 or c.deduction_item_count<>0 or c.unknown_amount_count<>0 or c.unknown_selected_amount_count<>0 or c.amount<>0 or c.waiting_amount<>0 or c.ready_net_add_amount<>0 or c.waiting_net_add_amount<>0 or c.gross_deduction_balance<>0 or c.net_deduction_balance<>0 or c.approved_amount<>0 or c.paid_credit_amount<>0 or c.reserved_amount<>0 or c.excluded_amount<>0 or c.recovery_amount<>0 or c.selected_amount<>0)) then
        raise exception using errcode='23514',message='BPAY_NEXT_WORKBENCH_CANDIDATE_DELTA_NOT_CONSERVED';
      end if;
      delete from private.bpay_next_workbench_candidate_summary c
        where (c.candidate_id,c.client_scope,c.pay_channel,c.section)=(v.candidate_id,v.client_scope,v.pay_channel,v.section);
    end if;
    if exists(select 1 from private.bpay_next_workbench_scope_summary c
      where (c.client_scope,c.pay_channel,c.section)=(v.client_scope,v.pay_channel,v.section) and c.candidate_count=0
        and (c.item_count<>0 or c.contribution_count<>0 or c.segment_count<>0 or c.payable_count<>0 or c.selected_count<>0 or c.snoozed_count<>0 or c.held_count<>0 or c.queried_count<>0 or c.blocked_count<>0 or c.deduction_item_count<>0 or c.unknown_amount_count<>0 or c.unknown_selected_amount_count<>0 or c.amount<>0 or c.waiting_amount<>0 or c.ready_net_add_amount<>0 or c.waiting_net_add_amount<>0 or c.gross_deduction_balance<>0 or c.net_deduction_balance<>0 or c.approved_amount<>0 or c.paid_credit_amount<>0 or c.reserved_amount<>0 or c.excluded_amount<>0 or c.recovery_amount<>0 or c.selected_amount<>0)) then
      raise exception using errcode='23514',message='BPAY_NEXT_WORKBENCH_SCOPE_DELTA_NOT_CONSERVED';
    end if;
    delete from private.bpay_next_workbench_scope_summary c
      where (c.client_scope,c.pay_channel,c.section)=(v.client_scope,v.pay_channel,v.section) and c.candidate_count=0;
  end loop;
end
$function$;

-- private.bpay_next_workbench_ensure_metadata_v1(uuid); supabase/repeatable/10102026_1429_banking_pay_next_workbench_current_continuation_v1.sql; SHA256 552dc66c933018bf3b630333188b05206571a991c73e00e4cf84e7f3eacf3d9e
create or replace function private.bpay_next_workbench_ensure_metadata_v1(p_candidate_id uuid)
returns private.bpay_next_workbench_candidate_metadata
language plpgsql security definer set search_path=pg_catalog,private
as $function$
declare v_metadata private.bpay_next_workbench_candidate_metadata%rowtype;
begin
  perform private.bpay_next_workbench_require_next_v1();
  insert into private.bpay_next_workbench_candidate_metadata(candidate_id,candidate_sort_name,tms_ref,
    target_pay_channel,target_umbrella_id,target_umbrella_vat_chargeable,target_umbrella_enabled,bank_warning_code)
    select c.id,coalesce(nullif(btrim(c.display_name),''),nullif(btrim(concat_ws(' ',c.first_name,c.last_name)),''),c.id::text),c.tms_ref,
      case when c.pay_method in ('PAYE','UMBRELLA') then c.pay_method end,
      case when c.pay_method='UMBRELLA' then c.umbrella_id end,
      case when c.pay_method='UMBRELLA' then u.vat_chargeable end,
      case when c.pay_method='UMBRELLA' then u.enabled end,
      case when nullif(btrim(case when c.pay_method='UMBRELLA' then u.bank_details_hash else c.bank_details_hash end),'') is null
        then 'BANK_DETAILS_MISSING' end
    from public.candidates c left join public.umbrellas u on u.id=c.umbrella_id where c.id=p_candidate_id
    on conflict(candidate_id) do nothing;
  -- Initialise only the newly added mapping on a retained pre-WB44 row.
  update private.bpay_next_workbench_candidate_metadata m set target_pay_channel=c.pay_method,
    target_umbrella_id=case when c.pay_method='UMBRELLA' then c.umbrella_id end,
    target_umbrella_vat_chargeable=case when c.pay_method='UMBRELLA' then u.vat_chargeable end,
    target_umbrella_enabled=case when c.pay_method='UMBRELLA' then u.enabled end,
    bank_warning_code=case when nullif(btrim(case when c.pay_method='UMBRELLA' then u.bank_details_hash else c.bank_details_hash end),'') is null
      then 'BANK_DETAILS_MISSING' else m.bank_warning_code end
    from public.candidates c left join public.umbrellas u on u.id=c.umbrella_id
    where m.candidate_id=p_candidate_id and c.id=m.candidate_id and m.target_pay_channel is null
      and c.pay_method in ('PAYE','UMBRELLA');
  select m.* into strict v_metadata from private.bpay_next_workbench_candidate_metadata m
    where m.candidate_id=p_candidate_id for update;
  return v_metadata;
end
$function$;

-- private.bpay_next_workbench_group_contribution_v1(text); supabase/repeatable/10102026_1332_banking_pay_next_withdrawal_projection_v1.sql; SHA256 23f3d98d15fa09f4b5fb6c6216596b586f4c1331141570fb20d79b6db4ad701b
create or replace function private.bpay_next_workbench_group_contribution_v1(p_group_key text)
returns setof private.bpay_next_workbench_delta
language plpgsql stable security definer set search_path=pg_catalog,private
as $function$
begin
  perform private.bpay_next_workbench_require_next_v1();
  return query
    with scoped as (
      select g.candidate_id,cs.client_id,cs.client_scope,ch.pay_channel,sec.section,
        i.group_key,i.component_key,i.member_kind,i.member_key,i.portion_kind,i.section item_section,
        i.selectable,i.is_selected,i.direction,i.payroll_stage,i.amount_known,i.selected_amount_known,
        (g.complete and g.certified_zero and i.member_kind='GROUP_EVIDENCE') certified_zero_evidence,
        i.reason_code,i.gross_due_source_ex_vat,i.nominal_source_ex_vat,i.approved_source_ex_vat,i.realised_source_ex_vat,
        i.active_reserved_source_ex_vat,i.included_source_ex_vat,i.excluded_source_ex_vat,
        i.recovery_source_ex_vat,i.deduction_balance_source_ex_vat,i.selected_source_ex_vat
      from private.bpay_next_workbench_item i
      join private.bpay_next_workbench_group g on g.group_key=i.group_key
      cross join lateral(select distinct v.client_id,v.client_scope from (values(g.client_id,g.client_id::text),(null::uuid,'ALL'::text)) v(client_id,client_scope)
        where v.client_scope is not null) cs
      cross join lateral(select distinct v.pay_channel from (values(g.target_pay_channel),('ALL'::text)) v(pay_channel)
        where v.pay_channel is not null) ch
      cross join lateral(select distinct v.section from (values(i.section),('ALL'::text)) v(section)) sec
      where i.group_key=p_group_key
    )
    select candidate_id,client_id,client_scope,pay_channel,section,
      count(distinct group_key)::bigint,
      count(*) filter(where member_kind<>'GROUP_EVIDENCE')::bigint,
      count(distinct (component_key,member_kind,member_key)) filter(where member_kind<>'GROUP_EVIDENCE')::bigint,
      count(*) filter(where selectable and direction='PAYMENT')::bigint,
      count(distinct (component_key,member_kind,member_key)) filter(where is_selected)::bigint,
      count(*) filter(where reason_code='SNOOZED')::bigint,
      count(*) filter(where portion_kind='RESERVED' or (portion_kind='WITHDRAWN' and active_reserved_source_ex_vat>0))::bigint,
      count(*) filter(where reason_code in ('PAY_QUERY_OPEN','PAY_QUERY_UNAVAILABLE'))::bigint,
      count(*) filter(where item_section='BLOCKED')::bigint,
      count(distinct (component_key,member_kind,member_key)) filter(where selectable and direction='DEDUCTION')::bigint,
      count(*) filter(where not amount_known and not certified_zero_evidence)::bigint,
      count(*) filter(where is_selected and not selected_amount_known)::bigint,
      coalesce(sum(included_source_ex_vat) filter(where item_section='READY' and direction='PAYMENT' and payroll_stage='GROSS_ADD'),0)::numeric,
      coalesce(sum(gross_due_source_ex_vat) filter(where item_section='WAITING' and direction='PAYMENT' and payroll_stage='GROSS_ADD' and portion_kind<>'RESERVED'),0)::numeric,
      coalesce(sum(included_source_ex_vat) filter(where item_section='READY' and direction='PAYMENT' and payroll_stage='NET_ADD'),0)::numeric,
      coalesce(sum(nominal_source_ex_vat) filter(where item_section='WAITING' and direction='PAYMENT' and payroll_stage='NET_ADD' and portion_kind<>'RESERVED'),0)::numeric,
      coalesce(sum(deduction_balance_source_ex_vat) filter(where direction='DEDUCTION' and payroll_stage='GROSS_DEDUCT'),0)::numeric,
      coalesce(sum(deduction_balance_source_ex_vat) filter(where direction='DEDUCTION' and payroll_stage='NET_DEDUCT'),0)::numeric,
      coalesce(sum(approved_source_ex_vat),0)::numeric,
      coalesce(sum(realised_source_ex_vat),0)::numeric,
      coalesce(sum(active_reserved_source_ex_vat),0)::numeric,
      coalesce(sum(excluded_source_ex_vat),0)::numeric,
      coalesce(sum(recovery_source_ex_vat),0)::numeric,
      coalesce(sum(selected_source_ex_vat) filter(where is_selected and selected_amount_known),0)::numeric
    from scoped group by candidate_id,client_id,client_scope,pay_channel,section;
end
$function$;

-- private.bpay_next_workbench_schedule_task_v1(text,uuid,uuid,uuid,boolean,boolean,boolean); supabase/repeatable/10102026_1429_banking_pay_next_workbench_current_continuation_v1.sql; SHA256 266332b55033a6e0b94dbcdf02885f99842155f9201599fbe943f3a73711637a
create or replace function private.bpay_next_workbench_schedule_task_v1(
  p_type text,p_candidate_id uuid,p_work_id uuid,p_umbrella_id uuid,p_bank_changed boolean default false,
  p_control_changed boolean default false,p_previous_pending boolean default null)
returns uuid language plpgsql security definer set search_path=pg_catalog,private
as $function$
declare v_key text;v_phase text;v_epoch bigint;v_id uuid;v_task private.bpay_next_workbench_task%rowtype;
  v_metadata private.bpay_next_workbench_candidate_metadata%rowtype;v_work private.bpay_next_work%rowtype;
  v_financial bigint;v_wait boolean;v_through_case uuid;v_through_candidate uuid;v_through_work uuid;v_through_group text;v_through_summary text;
begin
  perform private.bpay_next_workbench_require_next_v1();
  select owner_epoch into strict v_epoch from private.bpay_next_module_control where id=1;
  if p_type not in ('METADATA','ORIGIN','UMBRELLA') or p_type is null or p_bank_changed is null or p_control_changed is null then
    raise exception using errcode='22023',message='BPAY_NEXT_WORKBENCH_TASK_SCOPE_INVALID';end if;
  if p_type='UMBRELLA' then
    if p_candidate_id is not null or p_work_id is not null or p_umbrella_id is null then
      raise exception using errcode='22023',message='BPAY_NEXT_WORKBENCH_TASK_SCOPE_INVALID';end if;
    v_key:='UMBRELLA:'||p_umbrella_id::text;v_phase:='UMBRELLA_CANDIDATE';
    select candidate_id into v_through_candidate from private.bpay_next_workbench_candidate_metadata
      where target_umbrella_id=p_umbrella_id and target_pay_channel='UMBRELLA' order by candidate_id desc limit 1;
  else
    if p_candidate_id is null or p_umbrella_id is not null or (p_type='ORIGIN')<>(p_work_id is not null) then
      raise exception using errcode='22023',message='BPAY_NEXT_WORKBENCH_TASK_SCOPE_INVALID';end if;
    insert into private.bpay_next_worker_control(candidate_id) values(p_candidate_id) on conflict do nothing;
    select financial_view_revision into strict v_financial from private.bpay_next_worker_control
      where candidate_id=p_candidate_id for update;
    if p_type='ORIGIN' then
      select task_row.* into strict v_work from private.bpay_next_work task_row where id=p_work_id and candidate_id=p_candidate_id for update;
      v_wait:=private.bpay_next_work_wait_state_v1(p_work_id);
      select wc.case_id into v_through_case from private.bpay_next_work_collection wc
        where wc.work_id=p_work_id and wc.case_id is not null order by wc.case_id desc limit 1;
      v_key:='ORIGIN:'||p_work_id::text;v_phase:='ORIGIN_CASE';
    else
      select group_key into v_through_group from private.bpay_next_workbench_group
        where candidate_id=p_candidate_id order by group_key desc limit 1;
      v_key:='METADATA:'||p_candidate_id::text;v_phase:='METADATA_GROUP';
      select client_scope||':'||pay_channel||':'||section into v_through_summary
        from private.bpay_next_workbench_candidate_summary where candidate_id=p_candidate_id
        order by (client_scope||':'||pay_channel||':'||section) collate "C" desc limit 1;
    end if;
  end if;
  -- Lock task before metadata/revision, always after Candidate/work.
  select task_row.* into v_task from private.bpay_next_workbench_task task_row where task_key=v_key for update;
  if p_candidate_id is not null then
    v_metadata:=private.bpay_next_workbench_ensure_metadata_v1(p_candidate_id);
    if v_task.id is not null and v_task.status<>'DONE' and v_task.module_epoch=v_epoch
      and (p_type='METADATA' and v_task.metadata_version=v_metadata.metadata_version
        or p_type='ORIGIN' and (v_task.expected_revision_id,v_task.expected_applied_revision_id,
          v_task.expected_approval_state,v_task.financial_view_revision,v_task.expected_wait_state)
          is not distinct from (v_work.current_revision_id,v_work.applied_revision_id,
            v_work.approval_state,v_financial,v_wait)) then return v_task.id;end if;
  end if;
  insert into private.bpay_next_workbench_task(task_key,task_type,candidate_id,work_id,umbrella_id,module_epoch,phase,
    through_work_id,through_case_id,through_candidate_id,through_group_key,through_summary_key,financial_view_revision,metadata_version,
    expected_revision_id,expected_applied_revision_id,expected_approval_state,expected_wait_state,bank_warning_changed,control_changed)
    values(v_key,p_type,p_candidate_id,p_work_id,p_umbrella_id,v_epoch,v_phase,v_through_work,v_through_case,v_through_candidate,v_through_group,v_through_summary,
      v_financial,v_metadata.metadata_version,v_work.current_revision_id,v_work.applied_revision_id,
      v_work.approval_state,v_wait,p_bank_changed,p_control_changed)
    on conflict(task_key) do update set generation=private.bpay_next_workbench_task.generation+1,
      module_epoch=excluded.module_epoch,owner_epoch=private.bpay_next_workbench_task.owner_epoch+1,
      status='READY',phase=excluded.phase,cursor_key=null,through_work_id=excluded.through_work_id,
      through_case_id=excluded.through_case_id,through_candidate_id=excluded.through_candidate_id,through_group_key=excluded.through_group_key,
      through_summary_key=excluded.through_summary_key,
      financial_view_revision=excluded.financial_view_revision,metadata_version=excluded.metadata_version,
      expected_revision_id=excluded.expected_revision_id,expected_applied_revision_id=excluded.expected_applied_revision_id,
      expected_approval_state=excluded.expected_approval_state,expected_wait_state=excluded.expected_wait_state,
      bank_warning_changed=excluded.bank_warning_changed or (private.bpay_next_workbench_task.status<>'DONE'
        and private.bpay_next_workbench_task.bank_warning_changed),
      control_changed=excluded.control_changed or(private.bpay_next_workbench_task.status<>'DONE' and private.bpay_next_workbench_task.control_changed),
      step_no=0,rows_visited=0,
      lease_nonce=null,lease_until_utc=null,wake_after_utc=clock_timestamp(),available_at_utc=clock_timestamp(),
      last_error_code=null,updated_at_utc=transaction_timestamp()
    returning id into v_id;
  if p_candidate_id is not null then
    update private.bpay_next_workbench_candidate_metadata set continuation_pending=true,updated_at_utc=transaction_timestamp()
      where candidate_id=p_candidate_id;
  end if;
  update private.bpay_next_workbench_revision set workbench_revision=workbench_revision+1,
    pending_task_count=pending_task_count+case when v_task.id is null or v_task.status='DONE' then 1 else 0 end,
    dirty_candidate_count=dirty_candidate_count+case when p_candidate_id is not null
      and not coalesce(p_previous_pending,v_metadata.continuation_pending) then 1 else 0 end,
    updated_at_utc=transaction_timestamp() where id=1;
  return v_id;
end
$function$;

-- private.bpay_next_workbench_refresh_case_v1(uuid); supabase/repeatable/12102026_1822_banking_pay_next_classified_work_collection_v1.sql; SHA256 fea11e6ab7a7e1e478f411cb5ceeae5bde7e54c27cbc186bcd0ad84e0d2b2987
create or replace function private.bpay_next_workbench_refresh_case_v1(p_case_id uuid)
returns void language plpgsql security definer set search_path=pg_catalog,private
as $function$
declare
  v_case private.bpay_next_finance_case%rowtype;v_component private.bpay_next_case_component%rowtype;
  v_rule private.bpay_next_case_rule%rowtype;v_metadata private.bpay_next_workbench_candidate_metadata%rowtype;
  v_item private.bpay_next_workbench_item%rowtype;v_base private.bpay_next_workbench_item%rowtype;
  v_snooze private.bpay_next_snooze%rowtype;v_accepted record;v_totals record;
  v_before private.bpay_next_workbench_delta[];v_after private.bpay_next_workbench_delta[];
  v_group text:='CASE:'||p_case_id::text;v_candidate uuid;v_client uuid;v_contract uuid;v_target text;
  v_financial bigint;v_projection bigint;v_count integer:=0;v_accepted_count integer;v_capacity numeric;
  v_available numeric;v_reserved numeric;v_realised numeric;v_balance numeric;v_due date;v_basis bytea;
  v_today date:=(transaction_timestamp() at time zone 'Europe/London')::date;
begin
  perform private.bpay_next_workbench_require_next_v1();
  select c.candidate_id into strict v_candidate from private.bpay_next_finance_case c where c.id=p_case_id;
  select c.financial_view_revision into strict v_financial from private.bpay_next_worker_control c where c.candidate_id=v_candidate for update;
  select c.* into strict v_case from private.bpay_next_finance_case c where c.id=p_case_id for update;
  v_metadata:=private.bpay_next_workbench_ensure_metadata_v1(v_candidate);
  select c.pay_method::text into v_target from public.candidates c where c.id=v_candidate;
  if v_target not in ('PAYE','UMBRELLA') then v_target:=null;end if;
  select w.contract_id,co.client_id into v_contract,v_client from private.bpay_next_work_collection wc
    join private.bpay_next_work w on w.id=wc.work_id left join public.contracts co on co.id=w.contract_id where wc.case_id=p_case_id;
  select array_agg(d) into v_before from private.bpay_next_workbench_group_contribution_v1(v_group) d;
  update private.bpay_next_workbench_revision set workbench_revision=workbench_revision+1,updated_at_utc=transaction_timestamp()
    where id=1 returning workbench_revision into v_projection;
  delete from private.bpay_next_workbench_item where group_key=v_group;
  insert into private.bpay_next_workbench_group(group_key,group_kind,case_id,candidate_id,client_id,contract_id,
    target_pay_channel,complete,projection_revision,financial_view_revision,metadata_version,progress_state)
  values(v_group,'CASE',v_case.id,v_candidate,v_client,v_contract,v_target,true,v_projection,v_financial,v_metadata.metadata_version,'CURRENT')
  on conflict(group_key) do update set client_id=excluded.client_id,contract_id=excluded.contract_id,
    target_pay_channel=excluded.target_pay_channel,complete=true,projection_revision=excluded.projection_revision,
    financial_view_revision=excluded.financial_view_revision,metadata_version=excluded.metadata_version,
    progress_state='CURRENT',error_code=null,updated_at_utc=transaction_timestamp();
  for v_component in select c.* from private.bpay_next_case_component c where c.case_id=v_case.id order by c.component_ordinal,c.id loop
    v_count:=v_count+1;
    select r.* into strict v_rule from private.bpay_next_case_rule r where r.id=v_component.rule_id
      and r.case_id=v_case.id and r.candidate_id=v_candidate;
    if v_component.direction='DEDUCTION' then
      v_capacity:=case when v_component.case_kind in ('LOAN','ADVANCE') then v_component.funded_source_ex_vat else v_component.approved_source_ex_vat end;
      v_realised:=v_component.recovered_source_ex_vat;v_reserved:=v_component.active_recovery_source_ex_vat;
      v_balance:=v_capacity-v_component.written_off_source_ex_vat-v_realised;
      v_available:=v_balance-v_reserved;
    else
      v_capacity:=v_component.approved_source_ex_vat;
      v_realised:=v_component.funded_source_ex_vat+v_component.paid_credit_source_ex_vat;
      v_reserved:=v_component.active_payout_source_ex_vat;
      v_balance:=v_capacity-v_component.written_off_source_ex_vat-v_realised;
      v_available:=v_balance-v_reserved;
    end if;
    if v_available<0 or v_balance<0 then raise exception using errcode='23514',message='BPAY_NEXT_WORKBENCH_CASE_CAPACITY_INCONSISTENT';end if;
    if v_available=0 and v_reserved=0 then continue;end if;
    v_item:=null;v_item.id:=gen_random_uuid();v_item.group_key:=v_group;v_item.candidate_id:=v_candidate;
    v_item.case_id:=v_case.id;v_item.case_component_id:=v_component.id;v_item.rule_id:=v_rule.id;
    v_item.member_kind:='CASE_COMPONENT';v_item.member_key:=v_component.id::text;v_item.component_key:=v_component.component_key;
    v_item.client_id:=v_client;v_item.contract_id:=v_contract;v_item.candidate_display_name:=v_metadata.candidate_sort_name;v_item.candidate_reference:=v_metadata.tms_ref;
    v_item.component_kind:=v_component.case_kind;v_item.tax_treatment:=v_component.tax_treatment;
    v_item.source_pay_channel:=v_component.source_pay_channel;v_item.target_pay_channel:=v_target;
    v_item.direction:=v_component.direction;v_item.payroll_stage:=v_component.payroll_stage;
    v_item.amount_known:=true;v_item.nominal_source_ex_vat:=v_available;v_item.approved_source_ex_vat:=v_capacity;
    v_item.realised_source_ex_vat:=v_realised;v_item.active_reserved_source_ex_vat:=0;
    v_item.written_off_source_ex_vat:=v_component.written_off_source_ex_vat;
    v_item.residual_source_ex_vat:=v_available;v_item.gross_due_source_ex_vat:=case when v_component.direction='PAYMENT' then v_available else 0 end;
    v_item.included_source_ex_vat:=case when v_component.direction='PAYMENT' then v_available else 0 end;
    v_item.excluded_source_ex_vat:=0;v_item.recovery_source_ex_vat:=0;v_item.held_overhang_source_ex_vat:=0;
    v_item.deduction_balance_source_ex_vat:=case when v_component.direction='DEDUCTION' then v_balance else 0 end;
    v_item.section:='READY';v_item.reason_code:='READY';v_item.reason_priority:=200;v_item.selectable:=true;
    v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.query_qualified:=false;v_item.query_state:='NOT_APPLICABLE';
    v_item.financial_view_revision:=v_financial;v_item.projection_revision:=v_projection;v_item.metadata_version:=v_metadata.metadata_version;
    v_item.progress_state:='CURRENT';v_item.updated_at_utc:=transaction_timestamp();
    if v_target is null or v_case.current_rule_id is null then
      v_item.section:='BLOCKED';v_item.reason_code:='DATA_UNAVAILABLE';v_item.reason_priority:=10;
    end if;
    v_accepted_count:=0;
    for v_accepted in
      select r.id run_id,cmd.id command_id,cmd.module_epoch,ci.nominal_source_ex_vat
      from private.bpay_next_case_selection_item si
      join private.bpay_next_case_selection s on (s.run_id,s.candidate_id,s.selection_revision)=(si.run_id,si.candidate_id,si.selection_revision) and s.status='SEALED'
      join private.bpay_next_pay_run r on r.id=si.run_id and r.selection_state='SEALED' and r.status in ('PREPARING','REVIEW','DRAFT','EXECUTING')
      join private.bpay_next_run_command rc on rc.run_id=r.id join private.bpay_next_command cmd on cmd.id=rc.command_id and cmd.command_kind='PREPARE'
      left join private.bpay_next_run_worker rw on rw.run_id=r.id and rw.candidate_id=si.candidate_id
      left join private.bpay_next_run_case_instruction ci on ci.run_worker_id=rw.id and ci.preparation_revision=rw.captured_preparation_revision
        and ci.case_component_id=si.case_component_id
      where si.case_component_id=v_component.id and si.is_selected
        and ((rw.id is not null and rw.status in ('PREPARING','REVIEW','READY','DRAFT','CANCELLING','ISSUED')
          and si.selection_revision=case when rw.case_selection_revision>0 then rw.case_selection_revision
            else (select max(cs.selection_revision::numeric)::bigint from private.bpay_next_case_selection cs
              where cs.run_id=r.id and cs.candidate_id=si.candidate_id and cs.status='SEALED') end)
          or (rw.id is null and si.selection_revision=(select max(cs.selection_revision::numeric)::bigint from private.bpay_next_case_selection cs
            where cs.run_id=r.id and cs.candidate_id=si.candidate_id and cs.status='SEALED')))
    loop
      v_accepted_count:=v_accepted_count+1;
      if v_accepted_count>1 then raise exception using errcode='23514',message='BPAY_NEXT_WORKBENCH_ACCEPTED_CASE_COLLISION';end if;
      v_item.is_selected:=true;v_item.accepted_run_id:=v_accepted.run_id;v_item.accepted_command_id:=v_accepted.command_id;
      v_item.accepted_module_epoch:=v_accepted.module_epoch;v_item.selected_source_ex_vat:=v_accepted.nominal_source_ex_vat;
      v_item.selected_amount_known:=v_accepted.nominal_source_ex_vat is not null;
      if v_item.reason_priority>50 then v_item.section:='WAITING';v_item.reason_code:='IN_PREPARATION';v_item.reason_priority:=50;end if;
    end loop;
    if v_item.reason_priority>82 and v_component.resolution_state='REVIEW' then
      v_item.section:='ACTION';v_item.reason_code:='CASE_REVIEW_REQUIRED';v_item.reason_priority:=82;
    elsif v_item.reason_priority>90 and v_case.status='PAUSED' then
      v_item.section:='WAITING';v_item.reason_code:='CASE_PAUSED';v_item.reason_priority:=90;
    elsif v_case.status in ('CLOSED','WRITTEN_OFF') and v_available>0 then
      v_item.section:='BLOCKED';v_item.reason_code:='DATA_UNAVAILABLE';v_item.reason_priority:=10;
    end if;
    v_due:=case when v_component.direction='DEDUCTION' then coalesce(v_rule.next_due_monday,v_case.due_date) else v_case.due_date end;
    if v_item.reason_priority>100 and v_due>v_today then
      v_item.section:='WAITING';v_item.reason_code:='FUTURE_WEEK';v_item.reason_priority:=100;v_item.eligible_from_date:=v_due;
    end if;
    v_basis:=sha256(convert_to(jsonb_build_array(v_candidate,v_component.case_id,v_component.id,
      v_component.case_kind,v_component.case_subtype,v_component.tax_treatment,v_component.instruction_kind,v_component.direction,
      v_component.payroll_stage,v_component.source_pay_channel,v_component.approved_source_ex_vat,v_component.funded_source_ex_vat,
      v_rule.minimum_earnings_threshold,v_rule.take_home_floor_override,v_rule.weekly_due_source_ex_vat,
      v_rule.schedule_start_monday,v_rule.next_due_monday,v_rule.schedule_week_count)::text,'UTF8'));
    select s.* into v_snooze from private.bpay_next_snooze s where s.case_component_id=v_component.id and s.scope_kind='CASE'
      and s.active and (s.until_date is null or s.until_date>=v_today) and s.worker_pay_basis=v_basis;
    if found then
      v_item.snooze_id:=v_snooze.id;v_item.snooze_version:=v_snooze.version;v_item.snooze_scope:=v_snooze.scope_kind;v_item.snooze_until_date:=v_snooze.until_date;
      if v_item.reason_priority>110 then v_item.section:='WAITING';v_item.reason_code:='SNOOZED';v_item.reason_priority:=110;end if;
      if v_component.direction='PAYMENT' then v_item.excluded_source_ex_vat:=v_item.included_source_ex_vat;v_item.included_source_ex_vat:=0;end if;
    elsif exists(select 1 from private.bpay_next_snooze s where s.case_component_id=v_component.id and s.scope_kind='CASE'
      and s.active and (s.until_date is null or s.until_date>=v_today)) then v_item.stale_snooze_code:='SNOOZE_BASIS_STALE';end if;
    v_item.selectable:=v_item.section='READY';v_base:=v_item;
    -- WB41: preserve v_base for RESERVED/accepted portions. Only this exact
    -- automatic origin's unaccepted AVAILABLE recovery can enter WAIT.
    if v_available>0 then
      if not v_item.is_selected and exists(select 1 from private.bpay_next_work_collection manual
        where manual.case_id=v_case.id and manual.case_component_id=v_component.id and manual.candidate_id=v_candidate
          and manual.collection_mode='MANUAL') then
        v_item.section:='ACTION';v_item.reason_code:='MANUAL_COLLECTION';v_item.reason_priority:=81;v_item.selectable:=false;
      end if;
      if not v_item.is_selected and v_item.reason_priority>84
        and (v_case.case_kind,v_component.case_kind,v_component.case_subtype,
          v_component.instruction_kind,v_component.direction,v_component.payroll_stage)
          is not distinct from ('OVERPAYMENT','OVERPAYMENT','OVERPAYMENT','RECOVERY','DEDUCTION',
            case when v_component.tax_treatment='TAXABLE' then 'GROSS_DEDUCT' else 'NET_DEDUCT' end)
        and exists(select 1 from private.bpay_next_work_collection origin
          join private.bpay_next_work work on work.id=origin.work_id and work.candidate_id=origin.candidate_id
          where origin.case_id=v_case.id and origin.case_component_id=v_component.id and origin.candidate_id=v_candidate
            and origin.collection_mode='AUTOMATIC' and origin.paid_basis_qualified and origin.qualification_state='READY'
            and private.bpay_next_work_wait_state_v1(work.id)) then
        v_item.section:='ACTION';v_item.reason_code:='ORIGIN_UNAUTHORISED_WAIT';v_item.reason_priority:=84;v_item.selectable:=false;
      end if;
      v_item.portion_kind:='AVAILABLE';insert into private.bpay_next_workbench_item select (v_item).*;
    end if;
    if v_reserved>0 then
      v_item:=v_base;v_item.id:=gen_random_uuid();v_item.portion_kind:='RESERVED';v_item.selectable:=false;
      v_item.nominal_source_ex_vat:=v_reserved;v_item.active_reserved_source_ex_vat:=v_reserved;
      v_item.gross_due_source_ex_vat:=0;v_item.included_source_ex_vat:=0;v_item.excluded_source_ex_vat:=0;v_item.residual_source_ex_vat:=0;
      if v_available>0 then
        v_item.approved_source_ex_vat:=0;v_item.realised_source_ex_vat:=0;v_item.written_off_source_ex_vat:=0;v_item.deduction_balance_source_ex_vat:=0;
        v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.selected_source_ex_vat:=null;
      end if;
      if v_item.reason_priority>111 then v_item.section:='WAITING';v_item.reason_code:='RESERVED';v_item.reason_priority:=111;end if;
      insert into private.bpay_next_workbench_item select (v_item).*;
    end if;
    select sum(i.approved_source_ex_vat) a,sum(i.realised_source_ex_vat) c,sum(i.active_reserved_source_ex_vat) h,
      sum(i.written_off_source_ex_vat) w,sum(i.residual_source_ex_vat) residual,
      sum(i.deduction_balance_source_ex_vat) debt into v_totals from private.bpay_next_workbench_item i
      where i.group_key=v_group and i.case_component_id=v_component.id;
    if (v_totals.a,v_totals.c,v_totals.h,v_totals.w,v_totals.residual,v_totals.debt)
      is distinct from (v_capacity,v_realised,v_reserved,v_component.written_off_source_ex_vat,v_available,
        case when v_component.direction='DEDUCTION' then v_balance else 0::numeric end) then
      raise exception using errcode='23514',message='BPAY_NEXT_WORKBENCH_CASE_MEMBER_NOT_CONSERVED';end if;
  end loop;
  if v_count=0 and v_case.status in ('OPEN','PAUSED') then
    v_item:=null;v_item.id:=gen_random_uuid();v_item.group_key:=v_group;v_item.candidate_id:=v_candidate;v_item.case_id:=v_case.id;
    v_item.member_kind:='GROUP_EVIDENCE';v_item.member_key:=v_case.id::text;v_item.component_key:='';v_item.portion_kind:='EVIDENCE';
    v_item.client_id:=v_client;v_item.contract_id:=v_contract;v_item.direction:='INFORMATIONAL';v_item.amount_known:=false;
    v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.selectable:=false;v_item.section:='BLOCKED';v_item.reason_code:='DATA_UNAVAILABLE';v_item.reason_priority:=10;
    v_item.target_pay_channel:=v_target;v_item.query_state:='NOT_APPLICABLE';v_item.query_qualified:=false;
    v_item.financial_view_revision:=v_financial;v_item.projection_revision:=v_projection;v_item.metadata_version:=v_metadata.metadata_version;
    v_item.progress_state:='UNAVAILABLE';v_item.updated_at_utc:=transaction_timestamp();insert into private.bpay_next_workbench_item select (v_item).*;
  end if;
  update private.bpay_next_workbench_group g set ready_count=x.ready,action_count=x.action,blocked_count=x.blocked,waiting_count=x.waiting,
    complete=x.unknown=0 from(select count(*) filter(where section='READY') ready,count(*) filter(where section='ACTION') action,
      count(*) filter(where section='BLOCKED') blocked,count(*) filter(where section='WAITING') waiting,count(*) filter(where not amount_known) unknown
      from private.bpay_next_workbench_item where group_key=v_group) x where g.group_key=v_group;
  select array_agg(d) into v_after from private.bpay_next_workbench_group_contribution_v1(v_group) d;
  perform private.bpay_next_workbench_apply_delta_v1(v_before,v_after);
  perform private.bpay_next_workbench_refresh_group_display_v1(v_group);
end
$function$;

-- private.bpay_next_workbench_refresh_group_display_v1(text); supabase/repeatable/13102026_0113_banking_pay_next_chosen_display_refresh_quote_v1.sql; SHA256 d71fd36e08464e9744898c49d6607875f9f80b36a79d874f5734e1cf4f96612f
create or replace function private.bpay_next_workbench_refresh_group_display_v1(p_group_key text)
returns void language plpgsql security definer set search_path=pg_catalog,private,public
as $function$
declare
 g private.bpay_next_workbench_group%rowtype;w private.bpay_next_work%rowtype;
 r private.bpay_next_work_revision%rowtype;c public.candidates%rowtype;u public.umbrellas%rowtype;
 v_date_context jsonb;v_pay_date date;v_sensitive boolean:=false;v_component record;
 v_keys text[];v_source numeric;v_quote jsonb;v_delta numeric:=0;
begin
  perform private.bpay_next_workbench_require_next_v1();
  if p_group_key is null then raise exception using errcode='22023',message='BPAY_NEXT_WORKBENCH_GROUP_INVALID';end if;
  select x.* into g from private.bpay_next_workbench_group x where x.group_key=p_group_key;
  -- Native projection owners hold Candidate then Work and prove Source A/R/H
  -- before this display-only replacement. No summary/delta money changes.
  if g.group_kind='WORK' and g.complete and not g.dirty and g.progress_state='CURRENT' then
    select x.* into strict w from private.bpay_next_work x where x.id=g.work_id;
    select x.* into strict r from private.bpay_next_work_revision x where x.id=g.current_revision_id and x.work_id=w.id;
    select x.* into strict c from public.candidates x where x.id=g.candidate_id;
    select x.* into u from public.umbrellas x where x.id=c.umbrella_id;
    v_date_context:=public.pay_banking_official_date_context_v1(null::timestamptz);
    if v_date_context->>'ok' is distinct from 'true' or v_date_context->>'current_official_pay_date' is null then
      raise exception using errcode='55000',message='BPAY_NEXT_WORKBENCH_DATE_UNAVAILABLE';end if;
    v_pay_date:=(v_date_context->>'current_official_pay_date')::date;
    -- EXISTS uses native Work/revision mappings. It cannot cap the complete
    -- number of components or mistake an incompatible older date for timeless.
    v_sensitive:=exists(select 1 from private.bpay_next_component_resolution d where d.work_id=w.id and d.state='ACTIVE'
      and (d.based_on_revision_id=r.id or d.published_revision_id=r.id));
    if not v_sensitive then
      v_sensitive:=exists(select 1 from (select distinct i.approved_line_id,i.approved_segment_id
        from private.bpay_next_workbench_item i where i.group_key=g.group_key and i.revision_id=r.id
          and i.tax_treatment='TAXABLE' and i.section in ('READY','ACTION')
          and i.approved_line_id is not null) native
        where private.bpay_next_component_resolution_need_v1(w.id,r.id,native.approved_line_id,native.approved_segment_id,
          g.target_pay_channel,case when g.target_pay_channel='UMBRELLA' then u.id end,
          case when g.target_pay_channel='UMBRELLA' then u.vat_chargeable end,null::date) is not null);
    end if;
    for v_component in select distinct i.approved_line_id,i.component_key
      from private.bpay_next_workbench_item i where i.group_key=g.group_key and i.revision_id=r.id
        and i.tax_treatment='TAXABLE' and i.section='READY' and i.selectable and i.amount_known and not i.is_selected
        and i.direction='PAYMENT' and i.portion_kind in ('AVAILABLE','ZERO')
        and exists(select 1 from private.bpay_next_component_resolution d where d.work_id=w.id and d.state='ACTIVE'
          and (d.based_on_revision_id=r.id or d.published_revision_id=r.id)
          and (case when d.based_on_revision_id=r.id then d.approved_line_id else d.published_line_id end)=i.approved_line_id)
      order by i.component_key,i.approved_line_id loop
      with native as materialized(select i.* from private.bpay_next_workbench_item i
        where i.group_key=g.group_key and i.revision_id=r.id and i.approved_line_id=v_component.approved_line_id
          and i.component_key=v_component.component_key and i.section='READY' and i.selectable and i.amount_known
          and not i.is_selected and i.direction='PAYMENT' and i.portion_kind in ('AVAILABLE','ZERO')
        order by i.member_kind,i.member_key,i.id limit 10001)
      select array_agg('WORK:'||w.id::text||':'||i.component_key||':'||i.member_kind||':'||i.member_key
        order by i.member_kind,i.member_key,i.id),sum(i.included_source_ex_vat)
        into v_keys,v_source from native i;
      if cardinality(v_keys)>10000 then
        raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_ACCEPTED_SCOPE_TOO_LARGE';end if;
      v_quote:=private.bpay_next_current_component_resolution_quote_v1(w.id,r.id,v_component.approved_line_id,
        v_pay_date,v_keys,null,true);
      if v_quote is not null then
        if jsonb_typeof(v_quote->'component_quote') is distinct from 'object'
          or v_quote->'component_quote'->>'ex' is null then
          raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
        v_delta:=v_delta+(v_quote->'component_quote'->>'ex')::numeric-v_source;
      end if;
    end loop;
  end if;
  delete from private.bpay_next_workbench_group_display where parent_group_key=p_group_key;
-- WB15 own-list display projection. Values never enter a financial command.
insert into private.bpay_next_workbench_group_display(
  presentation_key,presentation_kind,presentation_id,parent_group_key,candidate_id,case_component_id,
  section,client_id,week_ending_date,client_display_name,payment_label,timesheet_reference,
  target_pay_channel,has_deduction,selectable,reason_code,reason_priority,group_amount,ready_net_add_amount,
  gross_deduction_balance,net_deduction_balance,waiting_amount,waiting_net_add_amount,
  accepted_run_id,accepted_command_id,accepted_module_epoch,snooze_until_date,eligible_from_date,pay_hold_reason
)
with members as (
  select g.group_key parent_group_key,g.candidate_id,g.client_id,g.week_ending_date,g.target_pay_channel,g.certified_zero,
    case when g.group_kind='WORK' then 'WORK' when fc.case_kind='OVERPAYMENT' or i.case_component_id is null then 'CASE' else 'ROW' end presentation_kind,
    case when g.group_kind='WORK' then g.work_id when fc.case_kind='OVERPAYMENT' or i.case_component_id is null then g.case_id else i.case_component_id end presentation_id,
    case when g.group_kind='CASE' and fc.case_kind<>'OVERPAYMENT' then i.case_component_id end case_component_id,
    case when g.group_kind='WORK' then i.client_display_name else cl.name end client_display_name,
    case when g.group_kind='WORK' then 'Timesheet' when fc.case_kind='OVERPAYMENT' then 'Overpayment recovery'
      when cc.case_subtype in ('LOAN','PAYMENT_ADVANCE') then case when cc.direction='DEDUCTION' then 'Payment Advance repayment' else 'Payment Advance' end
      when cc.case_subtype='MANUAL_CREDIT' then 'Manual Credit' when cc.case_subtype='UNDERPAYMENT' then 'Underpayment'
      when cc.case_subtype='MANUAL_DEBT' then 'Manual Debt' else 'Payment needs attention' end payment_label,
    i.id,i.section item_section,i.direction,i.payroll_stage,i.portion_kind,i.member_kind,i.reason_code,i.reason_priority,
    i.is_selected,i.selectable,i.amount_known,i.selected_amount_known,i.timesheet_reference,i.included_source_ex_vat,
    i.gross_due_source_ex_vat,i.nominal_source_ex_vat,i.deduction_balance_source_ex_vat,
    i.active_reserved_source_ex_vat,i.selected_source_ex_vat,i.accepted_run_id,i.accepted_command_id,i.accepted_module_epoch,
    i.snooze_until_date,i.eligible_from_date,i.pay_hold_reason,
    (i.reason_code='MANUAL_COLLECTION_UNAVAILABLE' or not i.amount_known and not(g.certified_zero and i.member_kind='GROUP_EVIDENCE')
      or i.is_selected and not i.selected_amount_known) amount_unavailable,
    case when i.is_selected then i.selected_source_ex_vat
      when i.portion_kind='RESERVED' then i.active_reserved_source_ex_vat
      when i.direction='PAYMENT' and i.section='READY' then i.included_source_ex_vat
      when i.direction='PAYMENT' and i.section='WAITING' and i.payroll_stage='GROSS_ADD' then i.gross_due_source_ex_vat
      else i.nominal_source_ex_vat end display_value,
    case when i.is_selected and i.accepted_run_id is not null and i.accepted_command_id is not null and i.accepted_module_epoch is not null
      and exists(select 1 from private.bpay_next_run_command rc join private.bpay_next_command cmd on cmd.id=rc.command_id
        join private.bpay_next_pay_run pr on pr.id=rc.run_id where rc.run_id=i.accepted_run_id and rc.command_id=i.accepted_command_id
          and cmd.command_kind='PREPARE' and cmd.module_epoch=i.accepted_module_epoch and pr.selection_state='SEALED'
          and pr.status in ('PREPARING','REVIEW','DRAFT','EXECUTING'))
      then pg_catalog.jsonb_build_array(i.accepted_run_id::text,i.accepted_command_id::text,i.accepted_module_epoch::text) end accepted_pair
  from private.bpay_next_workbench_group g join private.bpay_next_workbench_item i on i.group_key=g.group_key
  left join private.bpay_next_finance_case fc on fc.id=g.case_id
  left join private.bpay_next_case_component cc on cc.id=i.case_component_id and cc.case_id=g.case_id
  left join public.clients cl on cl.id=g.client_id
  where g.group_key=p_group_key
), scoped as (
  select m.*,sec.section from members m cross join lateral(values(m.item_section),('ALL'::text)) sec(section)
), reduced as (
  select presentation_kind,presentation_id,parent_group_key,candidate_id,case_component_id,section,client_id,week_ending_date,target_pay_channel,
    min(client_display_name::text) client_display_name,min(payment_label::text) payment_label,min(timesheet_reference::text) timesheet_reference,
    bool_or(direction='DEDUCTION') has_deduction,bool_or(selectable) selectable,
    (array_agg(reason_code order by reason_priority,id))[1] reason_code,min(reason_priority::smallint) reason_priority,
    bool_or(amount_unavailable) amount_unavailable,
    coalesce(sum(case when direction='DEDUCTION' then -display_value when direction='PAYMENT' then display_value when reason_code='MANUAL_COLLECTION' and direction='INFORMATIONAL' then display_value else 0 end),0) group_amount,
    coalesce(sum(included_source_ex_vat) filter(where item_section='READY' and direction='PAYMENT' and payroll_stage='NET_ADD'),0) ready_net_add_amount,
    coalesce(sum(deduction_balance_source_ex_vat) filter(where direction='DEDUCTION' and payroll_stage='GROSS_DEDUCT'),0) gross_deduction_balance,
    coalesce(sum(deduction_balance_source_ex_vat) filter(where direction='DEDUCTION' and payroll_stage='NET_DEDUCT'),0) net_deduction_balance,
    coalesce(sum(gross_due_source_ex_vat) filter(where item_section='WAITING' and direction='PAYMENT' and payroll_stage='GROSS_ADD' and portion_kind<>'RESERVED'),0) waiting_amount,
    coalesce(sum(nominal_source_ex_vat) filter(where item_section='WAITING' and direction='PAYMENT' and payroll_stage='NET_ADD' and portion_kind<>'RESERVED'),0) waiting_net_add_amount,
    array_agg(distinct accepted_pair) filter(where accepted_pair is not null) accepted_pairs,
    min(snooze_until_date::date) snooze_until_date,min(eligible_from_date::date) eligible_from_date,min(pay_hold_reason::text) pay_hold_reason
  from scoped group by presentation_kind,presentation_id,parent_group_key,candidate_id,case_component_id,section,client_id,week_ending_date,target_pay_channel
)
select presentation_kind||':'||presentation_id::text,presentation_kind,presentation_id,parent_group_key,candidate_id,case_component_id,
  section,client_id,week_ending_date,client_display_name,payment_label,timesheet_reference,
  target_pay_channel,has_deduction,selectable,reason_code,reason_priority,
  case when not amount_unavailable then group_amount end,case when not amount_unavailable then ready_net_add_amount end,
  case when not amount_unavailable then gross_deduction_balance end,case when not amount_unavailable then net_deduction_balance end,
  case when not amount_unavailable then waiting_amount end,case when not amount_unavailable then waiting_net_add_amount end,
  case when cardinality(accepted_pairs)=1 then (accepted_pairs[1]->>0)::uuid end,
  case when cardinality(accepted_pairs)=1 then (accepted_pairs[1]->>1)::uuid end,
  case when cardinality(accepted_pairs)=1 then (accepted_pairs[1]->>2)::bigint end,
  snooze_until_date,eligible_from_date,pay_hold_reason
from reduced;
  if g.group_kind='WORK' and g.complete and not g.dirty and g.progress_state='CURRENT' then
    update private.bpay_next_workbench_group_display set group_amount=group_amount+v_delta
      where parent_group_key=p_group_key and presentation_kind='WORK' and section='READY' and group_amount is not null;
    -- Certification follows the complete replacement, never partial paging.
    update private.bpay_next_workbench_group set chosen_display_date_sensitive=v_sensitive,
      chosen_display_pay_date=case when v_sensitive then v_pay_date end where group_key=p_group_key;
  end if;
end
$function$;

-- private.bpay_next_component_resolution_need_v1(uuid,uuid,uuid,uuid,text,uuid,boolean,date); supabase/repeatable/12102026_2146_banking_pay_next_treatment_resolution_need_continuity_v1.sql; SHA256 50d7c35f65e3592ed711d4f058597b3c9f56d5c84987a1cbb0fa029352a74fd6
create or replace function private.bpay_next_component_resolution_need_v1(
 p_work_id uuid,p_revision_id uuid,p_line_id uuid,p_segment_id uuid,
 p_target_channel text,p_target_umbrella_id uuid,p_target_vat boolean,p_valuation_date date
) returns jsonb language plpgsql stable security invoker set search_path=pg_catalog,private
as $function$
declare w private.bpay_next_work%rowtype;rev private.bpay_next_work_revision%rowtype;
 r private.bpay_next_pay_method_change_receipt%rowtype;n record;v_count integer:=0;v_reason text;v_approval uuid;
begin
 select x.* into w from private.bpay_next_work x where x.id=p_work_id;
 select x.* into rev from private.bpay_next_work_revision x where x.id=p_revision_id and x.work_id=p_work_id;
 if w.id is null or rev.id is null or rev.sealed_at_utc is null or rev.approved_at_utc is null
  or not exists(select 1 from private.bpay_next_approved_line a where a.id=p_line_id
   and a.revision_id=p_revision_id and a.tax_treatment='TAXABLE') then return null;end if;
 -- Greatest native metadata version, never clock/UUID order or a target-filtered
 -- historical need. A later compatible or protected transition replaces it.
 select x.* into r from private.bpay_next_pay_method_change_receipt x where x.candidate_id=w.candidate_id
  order by x.post_metadata_version desc limit 1;
 if r.operation_id is null or(r.target_pay_channel,r.target_umbrella_id)
  is distinct from(p_target_channel,p_target_umbrella_id) then return null;end if;
 v_approval:=private.bpay_next_treatment_approval_revision_v1(p_revision_id);
 for n in
  select e.rate_family,e.rate_code
  from private.bpay_next_pay_method_change_member m
  join private.bpay_next_work_revision mr on mr.id=m.revision_id and mr.work_id=m.work_id and mr.sealed_at_utc is not null
  join private.bpay_next_approved_line ma on ma.id=m.approved_line_id and ma.revision_id=m.revision_id
  join private.bpay_next_approved_line actual on actual.id=p_line_id and actual.revision_id=p_revision_id and actual.component_key=ma.component_key
  left join private.bpay_next_approved_segment ms on ms.id=m.approved_segment_id and ms.revision_id=m.revision_id and ms.approved_line_id=ma.id
  left join private.bpay_next_approved_segment actual_s on actual_s.id=p_segment_id and actual_s.revision_id=p_revision_id and actual_s.approved_line_id=actual.id
  join private.bpay_next_component_resolution_event e on e.need_operation_id=m.operation_id
   and e.need_member_key=m.member_key and e.event_kind='NEED' and e.need_version=r.post_metadata_version
   and e.work_id=m.work_id and e.candidate_id=m.candidate_id and e.revision_id=m.revision_id
   and e.approved_line_id=m.approved_line_id
  where m.operation_id=r.operation_id and m.member_kind='WORK' and m.classification='NEEDS_DECISION'
   and m.work_id=p_work_id and (case when mr.payment_treatment_approval_revision_id is not null
    then private.bpay_next_treatment_approval_revision_v1(mr.id) else mr.id end)=v_approval
   and ((m.approved_segment_id is null and p_segment_id is null)
    or (ms.id is not null and actual_s.id is not null and ms.component_key=actual_s.component_key and ms.segment_key=actual_s.segment_key))
  order by e.rate_family,e.rate_code limit 6
 loop
  if p_valuation_date is not null and exists(select 1 from private.bpay_next_component_resolution_active_v1(
    p_work_id,p_revision_id,p_line_id,n.rate_family,n.rate_code,p_target_channel,p_target_umbrella_id,
    p_target_vat,rev.valuation_policy_id,p_valuation_date)) then continue;end if;
  v_count:=v_count+1;
  if v_count>5 then raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_NEED_IDENTITY_CHANGED';end if;
  v_reason:=case when n.rate_family='STANDARD' then 'RATE_RESOLUTION_REQUIRED' else 'GROSS_RESOLUTION_REQUIRED' end;
 end loop;
 if v_count=0 then return null;end if;
 return jsonb_build_object('reason_code',v_reason,'work_reason_code','CHANNEL_RESOLUTION_REQUIRED',
  'need_operation_id',r.operation_id,'need_version',r.post_metadata_version::text,'unresolved_bucket_count',v_count::text);
end
$function$;

-- private.bpay_next_component_resolution_active_v1(uuid,uuid,uuid,text,text,text,uuid,boolean,uuid,date); supabase/repeatable/12102026_2100_banking_pay_next_resolution_remaining_quote_v1.sql; SHA256 c84776c479dd9de85fcd475b2abffb6488914ff0174e534078e57a1f1eba065e
create or replace function private.bpay_next_component_resolution_active_v1(
 p_work_id uuid,p_boundary_revision_id uuid,p_line_id uuid,p_family text,p_code text,
 p_target_channel text,p_target_umbrella_id uuid,p_target_vat boolean,p_policy_id uuid,p_valuation_date date
) returns setof private.bpay_next_component_resolution
language plpgsql stable security invoker set search_path=pg_catalog,private
as $function$
declare b jsonb;d private.bpay_next_component_resolution%rowtype;v_count integer:=0;
begin
 if p_work_id is null or p_boundary_revision_id is null or p_line_id is null or p_family is null
  or p_family not in ('STANDARD','ADDITIONAL','ADJUSTMENT') or p_code is null or length(p_code) not between 1 and 256
  or p_target_channel is null
  or p_target_channel not in ('PAYE','UMBRELLA') or p_policy_id is null or p_valuation_date is null
  or not isfinite(p_valuation_date)
  or (p_target_channel='PAYE' and (p_target_umbrella_id is not null or p_target_vat is not null))
  or (p_target_channel='UMBRELLA' and (p_target_umbrella_id is null or p_target_vat is null)) then
  raise exception using errcode='22023',message='BPAY_NEXT_RESOLUTION_IDENTITY_INVALID';end if;
 -- No decision must leave existing Source/ordinary resolver admission unchanged.
 if not exists(select 1 from private.bpay_next_component_resolution x
  where x.work_id=p_work_id and x.rate_family=p_family and x.rate_code=p_code and x.state='ACTIVE'
   and x.target_pay_channel=p_target_channel and x.target_umbrella_id is not distinct from p_target_umbrella_id
   and x.target_umbrella_vat_chargeable is not distinct from p_target_vat
   and x.valuation_policy_id=p_policy_id and x.valuation_date=p_valuation_date
   and ((x.based_on_revision_id=p_boundary_revision_id and x.approved_line_id=p_line_id)
    or(x.published_revision_id=p_boundary_revision_id and x.published_line_id=p_line_id))) then return;end if;
 b:=private.bpay_next_component_resolution_basis_v1(p_boundary_revision_id,p_line_id,p_family,p_code);
 if (b->>'work_id')::uuid is distinct from p_work_id then
  raise exception using errcode='22023',message='BPAY_NEXT_RESOLUTION_IDENTITY_INVALID';end if;
 for d in select x.* from private.bpay_next_component_resolution x
  where x.work_id=p_work_id and x.rate_family=p_family and x.rate_code=p_code and x.state='ACTIVE'
   and x.target_pay_channel=p_target_channel and x.target_umbrella_id is not distinct from p_target_umbrella_id
   and x.target_umbrella_vat_chargeable is not distinct from p_target_vat
   and x.valuation_policy_id=p_policy_id and x.valuation_date=p_valuation_date
   and ((x.based_on_revision_id=p_boundary_revision_id and x.approved_line_id=p_line_id and x.original_basis=b)
    or (x.published_revision_id=p_boundary_revision_id and x.published_line_id=p_line_id and x.published_basis=b))
  limit 2 loop
  v_count:=v_count+1;
  if v_count>1 then raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_COMPATIBILITY_AMBIGUOUS';end if;
  return next d;
 end loop;
end
$function$;

-- private.bpay_next_component_resolution_basis_v1(uuid,uuid,text,text); supabase/repeatable/12102026_2100_banking_pay_next_resolution_remaining_quote_v1.sql; SHA256 aab65ace1b588bf1218c4a696f395d1165f784bc22e963712468b2943751d479
create or replace function private.bpay_next_component_resolution_basis_v1(
 p_revision_id uuid,p_line_id uuid,p_family text,p_code text
) returns jsonb language plpgsql stable security invoker set search_path=pg_catalog,private
as $function$
declare r private.bpay_next_work_revision%rowtype;a private.bpay_next_approved_line%rowtype;
 d private.bpay_next_rate_detail%rowtype;s private.bpay_next_rate_schedule%rowtype;
 v_units numeric;v_rate numeric;v_charge numeric;v_semantics text;
begin
 if p_revision_id is null or p_line_id is null or p_family is null or p_code is null
  or p_family not in ('STANDARD','ADDITIONAL','ADJUSTMENT') or length(p_code) not between 1 and 256 then
  raise exception using errcode='22023',message='BPAY_NEXT_RESOLUTION_IDENTITY_INVALID';end if;
 select wb45src.* into r from private.bpay_next_work_revision wb45src where id=p_revision_id;
 select wb45src.* into a from private.bpay_next_approved_line wb45src where id=p_line_id and revision_id=p_revision_id;
 if r.id is null or a.id is null or r.approved_at_utc is null or r.sealed_at_utc is null
  or a.tax_treatment is distinct from 'TAXABLE' or a.source_pay_ex_vat<0
  or a.source_pay_ex_vat::text in ('NaN','Infinity','-Infinity') then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_SOURCE_BASIS_UNAVAILABLE';end if;
 if p_family='STANDARD' then
  if a.component_kind not in ('WORK','PROTECTED_WORK') then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_IDENTITY_INVALID';end if;
  select wb45src.* into d from private.bpay_next_rate_detail wb45src where approved_line_id=a.id and bucket=p_code;
  if d.id is null then raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_BUCKET_MISSING';end if;
  select wb45src.* into s from private.bpay_next_rate_schedule wb45src where revision_id=r.id and rate_family=p_family and rate_code=p_code;
  v_units:=d.approved_hours;v_rate:=d.source_pay_rate;v_charge:=s.approved_charge_rate;
 elsif p_family='ADDITIONAL' then
  if a.component_kind<>'ADDITIONAL' or a.component_key<>'ADDITIONAL:'||p_code
   or exists(select 1 from private.bpay_next_rate_detail where approved_line_id=a.id) then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_IDENTITY_INVALID';end if;
  select wb45src.* into s from private.bpay_next_rate_schedule wb45src where revision_id=r.id and rate_family=p_family and rate_code=p_code;
  v_units:=a.approved_quantity;v_rate:=a.approved_unit_rate;v_charge:=s.approved_charge_rate;
 else
  if a.component_kind<>'ADJUSTMENT' or a.component_key<>p_code
   or exists(select 1 from private.bpay_next_rate_detail where approved_line_id=a.id) then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_IDENTITY_INVALID';end if;
  v_units:=a.approved_quantity;v_rate:=a.approved_unit_rate;
 end if;
 if (v_units is not null and (v_units::text in ('NaN','Infinity','-Infinity') or v_units<0 or v_units>=1000000000000 or v_units<>trunc(v_units,6)))
  or (v_rate is not null and (v_rate::text in ('NaN','Infinity','-Infinity') or v_rate<0 or v_rate>=1000000000000 or v_rate<>trunc(v_rate,6)))
  or (v_charge is not null and (v_charge::text in ('NaN','Infinity','-Infinity') or v_charge<0 or v_charge>=1000000000000 or v_charge<>trunc(v_charge,6))) then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_SOURCE_BASIS_UNAVAILABLE';end if;
 -- Exact original1157:439–451 admission. Available charge is never used here.
 v_semantics:=case when p_family in ('STANDARD','ADDITIONAL') and v_units>0
  and v_rate is not null and v_charge is not null then 'RATE_BEARING' else 'AMOUNT_LED' end;
 if p_family='STANDARD' and v_semantics<>'RATE_BEARING' then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_SOURCE_BASIS_UNAVAILABLE';end if;
 return jsonb_build_object('work_id',r.work_id,'physical_timesheet_id',r.physical_timesheet_id,
  'physical_timesheet_version',r.physical_timesheet_version,'financial_snapshot_id',r.financial_snapshot_id,
  'source_kind',r.source_kind,'source_head_id',r.source_head_id,'source_event_id',r.source_event_id,
  'source_pay_channel',r.source_pay_channel,'source_umbrella_id',r.source_umbrella_id,
  'valuation_policy_id',r.valuation_policy_id,'component_key',a.component_key,
  'component_kind',a.component_kind,'source_component_id',a.source_component_id,'work_date',a.work_date,
  'unit_label',a.unit_label,'tax_treatment',a.tax_treatment,'rate_family',p_family,'rate_code',p_code,
  'source_units',v_units,'source_rate',v_rate,'source_charge_rate',v_charge,
  'component_source_ex_vat',a.source_pay_ex_vat,'semantics',v_semantics);
end
$function$;

-- private.bpay_next_treatment_approval_revision_v1(uuid); supabase/repeatable/12102026_2135_banking_pay_next_treatment_native_publication_v1.sql; SHA256 f874b8fdbd62efde870310b953a49c53b2232dc65bedeb9adf13067a4eef0bd7
create or replace function private.bpay_next_treatment_approval_revision_v1(p_revision_id uuid)
returns uuid language plpgsql stable security invoker set search_path=pg_catalog,private
as $function$
declare r private.bpay_next_work_revision%rowtype; a private.bpay_next_work_revision%rowtype;
 pred private.bpay_next_work_revision%rowtype; pub private.bpay_next_publication%rowtype;
begin
 select x.* into r from private.bpay_next_work_revision x where x.id=p_revision_id;
 if r.id is null or r.approved_at_utc is null or r.sealed_at_utc is null then
  raise exception using errcode='23514',message='BPAY_NEXT_TREATMENT_APPROVAL_UNAVAILABLE';end if;
 if r.payment_treatment_approval_revision_id is null then return r.id;end if;
 select x.* into a from private.bpay_next_work_revision x
  where x.id=r.payment_treatment_approval_revision_id and x.work_id=r.work_id;
 select x.* into pub from private.bpay_next_publication x where x.work_id=r.work_id and x.revision_id=r.id;
 select x.* into pred from private.bpay_next_work_revision x where x.id=pub.predecessor_revision_id and x.work_id=r.work_id;
 if a.id is null or a.id=r.id or a.payment_treatment_approval_revision_id is not null
  or a.approved_at_utc is null or a.sealed_at_utc is null or r.source_event_id is not null
  or (to_jsonb(r)-array['id','revision_no','source_event_id','approved_at_utc','sealed_at_utc','created_at_utc','payment_treatment_approval_revision_id']) is distinct from (to_jsonb(a)-array['id','revision_no','source_event_id','approved_at_utc','sealed_at_utc','created_at_utc','payment_treatment_approval_revision_id'])
  or pub.revision_no is distinct from r.revision_no
  or pred.id is null or pred.sealed_at_utc is null or pred.approved_at_utc is null
  or coalesce(pred.payment_treatment_approval_revision_id,pred.id) is distinct from a.id
  or pred.revision_no+1 is distinct from r.revision_no
  or not exists(select 1 from private.bpay_next_command c
   join private.bpay_next_command_member m on m.command_id=c.id and m.candidate_id=pub.candidate_id
   join private.bpay_next_work w on w.id=pub.work_id and w.candidate_id=pub.candidate_id
   where c.id=pub.command_id and c.command_kind='POSITION_APPLY' and c.sealed_at_utc is not null
    and c.expected_member_count=1 and m.member_no=1) then
  raise exception using errcode='23514',message='BPAY_NEXT_TREATMENT_APPROVAL_UNAVAILABLE';end if;
 return a.id;
end
$function$;

-- private.bpay_next_current_component_resolution_quote_v1(uuid,uuid,uuid,date,text[],text,boolean); supabase/repeatable/13102026_0113_banking_pay_next_chosen_display_refresh_quote_v1.sql; SHA256 a66dbe260a32bf4e71294a775be504b81d2010d16cc3d2d276b84f9bb7b3b74b
create or replace function private.bpay_next_current_component_resolution_quote_v1(
 p_work_id uuid,p_revision_id uuid,p_approved_line_id uuid,p_pay_date date,
 p_selected_leaf_keys text[],p_through_segment_key text,p_projection_refresh boolean
) returns jsonb language plpgsql stable security invoker set search_path=pg_catalog,private
as $function$
declare
 w private.bpay_next_work%rowtype;r private.bpay_next_work_revision%rowtype;
 a private.bpay_next_approved_line%rowtype;pos private.bpay_next_position%rowtype;
 g private.bpay_next_workbench_group%rowtype;c public.candidates%rowtype;u public.umbrellas%rowtype;
 md private.bpay_next_workbench_candidate_metadata%rowtype;v_fvr bigint;v_date jsonb;
 d private.bpay_next_component_resolution%rowtype;first_d private.bpay_next_component_resolution%rowtype;active record;
 v_target text;v_umbrella uuid;v_vat boolean;v_line uuid;v_seen integer:=0;
 v_refs jsonb:='[]';v_versions jsonb:='[]';v_decision_keys text[]:='{}';v_key text;
 v_count bigint;v_bad boolean;v_approval_count bigint;v_approval_a numeric;v_selected_count bigint;
 v_segmented boolean;v_member jsonb;v_members jsonb[]:=array[]::jsonb[];v_bytes bigint:=0;
 v_a numeric:=0;v_r numeric:=0;v_h numeric:=0;v_included numeric:=0;v_excluded numeric:=0;
 v_recovery numeric:=0;v_overhang numeric:=0;v_basis jsonb;v_required_included numeric;
 v_working jsonb;v_result jsonb;leaf record;v_native_version text;
begin
 if p_projection_refresh is null or p_work_id is null or p_revision_id is null or p_approved_line_id is null or p_pay_date is null
  or not isfinite(p_pay_date) or p_selected_leaf_keys is null
  or cardinality(p_selected_leaf_keys) not between 1 and 10000
  or array_ndims(p_selected_leaf_keys) is distinct from 1
  or exists(select 1 from unnest(p_selected_leaf_keys) x where x is null or octet_length(x) not between 1 and 8192)
  or (select count(distinct x) from unnest(p_selected_leaf_keys) x)<>cardinality(p_selected_leaf_keys)
  or octet_length(to_jsonb(p_selected_leaf_keys)::text)>8388608 then
  raise exception using errcode='22023',message='BPAY_NEXT_RESOLUTION_IDENTITY_INVALID';end if;
 select x.* into w from private.bpay_next_work x where x.id=p_work_id;
 select x.* into r from private.bpay_next_work_revision x where x.id=p_revision_id and x.work_id=w.id;
 select x.* into a from private.bpay_next_approved_line x where x.id=p_approved_line_id and x.revision_id=r.id;
 select x.* into pos from private.bpay_next_position x where x.work_id=w.id and x.component_key=a.component_key;
 select x.* into c from public.candidates x where x.id=w.candidate_id;
 select x.* into u from public.umbrellas x where x.id=c.umbrella_id;
 select x.* into g from private.bpay_next_workbench_group x where x.work_id=w.id;
 select x.* into md from private.bpay_next_workbench_candidate_metadata x where x.candidate_id=w.candidate_id;
 select x.financial_view_revision into v_fvr from private.bpay_next_worker_control x where x.candidate_id=w.candidate_id;
 v_date:=public.pay_banking_official_date_context_v1(null::timestamptz);
 v_target:=upper(c.pay_method);v_umbrella:=case when v_target='UMBRELLA' then u.id end;
 v_vat:=case when v_target='UMBRELLA' then u.vat_chargeable end;
 if w.id is null or r.id is null or a.id is null or pos.work_id is null or c.id is null or g.work_id is null
  or md.candidate_id is null or v_fvr is null or c.active is not true
  or v_target is null or v_target not in ('PAYE','UMBRELLA')
  or (v_target='UMBRELLA' and (u.id is null or u.enabled is not true or u.vat_chargeable is null))
  or w.approval_state is distinct from 'APPROVED' or w.current_revision_id is distinct from r.id
  or w.applied_revision_id is distinct from r.id or pos.applied_revision_id is distinct from r.id
  or r.approved_at_utc is null or r.sealed_at_utc is null or a.tax_treatment is distinct from 'TAXABLE'
  or pos.approved_source_ex_vat is distinct from a.source_pay_ex_vat
  or g.group_kind is distinct from 'WORK' or g.candidate_id is distinct from c.id
  or g.current_revision_id is distinct from r.id or g.target_pay_channel is distinct from v_target
  or g.source_pay_channel is distinct from r.source_pay_channel or g.complete is not true or g.dirty is not false
  or g.progress_state is distinct from 'CURRENT' or g.financial_view_revision is distinct from v_fvr
  or g.metadata_version is distinct from md.metadata_version
  or (not p_projection_refresh and (md.continuation_pending is not false
    or md.adopted_metadata_version is distinct from md.metadata_version))
  or v_date->>'ok' is distinct from 'true' or (v_date->>'current_official_pay_date')::date is distinct from p_pay_date then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
 -- Physical inputs are bounded before filtering any eligibility or selected rows.
 with native as materialized(select x.* from private.bpay_next_approved_segment x
   where x.revision_id=r.id and x.component_key=a.component_key order by x.segment_key limit 10001)
 select count(*),coalesce(sum(case when pay_excluded then 0 else approved_source_ex_vat end),0),
  coalesce(bool_or(approved_line_id is distinct from a.id),false)
 into v_approval_count,v_approval_a,v_bad from native;
 if v_approval_count>10000 then raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_ACCEPTED_SCOPE_TOO_LARGE';end if;
 if v_bad then raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
 with native as materialized(select x.* from private.bpay_next_workbench_item x
   where x.work_id=w.id and x.component_key=a.component_key order by x.segment_key,x.portion_kind,x.id limit 50001)
 select count(*),coalesce(bool_or(group_key is distinct from g.group_key or candidate_id is distinct from c.id
   or revision_id is distinct from r.id or approved_line_id is distinct from a.id
   or member_kind not in ('WORK_COMPONENT','WORK_SEGMENT') or amount_known is not true or progress_state is distinct from 'CURRENT'
   or financial_view_revision is distinct from v_fvr or projection_revision is distinct from g.projection_revision
   or metadata_version is distinct from md.metadata_version or source_pay_channel is distinct from r.source_pay_channel
   or target_pay_channel is distinct from v_target),false),coalesce(bool_or(member_kind='WORK_SEGMENT'),false)
 into v_count,v_bad,v_segmented from native;
 if v_count>50000 then raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_ACCEPTED_SCOPE_TOO_LARGE';end if;
 v_segmented:=v_segmented or v_approval_count>0;
 if v_bad or (v_segmented and v_approval_a is distinct from pos.approved_source_ex_vat)
  or exists(select 1 from private.bpay_next_workbench_item x where x.work_id=w.id and x.component_key=a.component_key
    and x.member_kind is distinct from case when v_segmented then 'WORK_SEGMENT' else 'WORK_COMPONENT' end) then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
 -- Exact native READY keys only. Need checks precede the no-saved-decision return.
 v_selected_count:=0;
 for leaf in select i.* from private.bpay_next_workbench_item i where i.work_id=w.id and i.component_key=a.component_key
   and ('WORK:'||w.id::text||':'||i.component_key||':'||i.member_kind||':'||i.member_key)=any(p_selected_leaf_keys)
   and i.portion_kind in ('AVAILABLE','ZERO') order by i.member_key loop
  v_selected_count:=v_selected_count+1;
  if iSfinite(p_pay_date) is not true or leaf.section is distinct from 'READY' or leaf.selectable is not true
   or leaf.is_selected is not false or leaf.amount_known is not true or leaf.direction is distinct from 'PAYMENT'
   or coalesce(leaf.pay_hold,false) or leaf.snooze_id is not null
   or (v_segmented and not exists(select 1 from private.bpay_next_approved_segment s where s.id=leaf.approved_segment_id
     and s.revision_id=r.id and s.approved_line_id=a.id and s.component_key=a.component_key and s.segment_key=leaf.segment_key
     and not s.pay_excluded)) then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
  if leaf.included_source_ex_vat>0 and private.bpay_next_component_resolution_need_v1(w.id,r.id,a.id,
    leaf.approved_segment_id,v_target,v_umbrella,v_vat,p_pay_date) is not null then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_SOURCE_BASIS_UNAVAILABLE';end if;
 end loop;
 if v_selected_count<>cardinality(p_selected_leaf_keys) then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
 -- Complete native A/R/H coverage: all portions plus exhausted current approvals.
 with portions as materialized(select i.segment_key,count(*) n,
   sum(i.approved_source_ex_vat) a,sum(i.realised_source_ex_vat) r,sum(i.active_reserved_source_ex_vat) h,
   sum(i.residual_source_ex_vat) residual,sum(i.included_source_ex_vat+i.excluded_source_ex_vat) positive,
   sum(i.recovery_source_ex_vat) recovery,sum(i.held_overhang_source_ex_vat) overhang,
   sum(case when ('WORK:'||w.id::text||':'||i.component_key||':'||i.member_kind||':'||i.member_key)=any(p_selected_leaf_keys)
     and i.portion_kind='AVAILABLE' then i.included_source_ex_vat else 0 end) included
   from private.bpay_next_workbench_item i where i.work_id=w.id and i.component_key=a.component_key group by i.segment_key),
 native as materialized(select s.* from private.bpay_next_approved_segment s
   where s.revision_id=r.id and s.component_key=a.component_key),
 keys as materialized(select segment_key from portions union select segment_key from native)
 select count(*) into v_count from (select segment_key from keys limit 10001) bounded;
 if v_count>10000 then raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_ACCEPTED_SCOPE_TOO_LARGE';end if;
 for v_member in
  with portions as materialized(select i.segment_key,count(*) n,
    sum(i.approved_source_ex_vat) a,sum(i.realised_source_ex_vat) r,sum(i.active_reserved_source_ex_vat) h,
    sum(i.residual_source_ex_vat) residual,sum(i.included_source_ex_vat+i.excluded_source_ex_vat) positive,
    sum(i.recovery_source_ex_vat) recovery,sum(i.held_overhang_source_ex_vat) overhang,
    sum(case when ('WORK:'||w.id::text||':'||i.component_key||':'||i.member_kind||':'||i.member_key)=any(p_selected_leaf_keys)
      and i.portion_kind='AVAILABLE' then i.included_source_ex_vat else 0 end) included
    from private.bpay_next_workbench_item i where i.work_id=w.id and i.component_key=a.component_key group by i.segment_key),
  native as materialized(select s.* from private.bpay_next_approved_segment s
    where s.revision_id=r.id and s.component_key=a.component_key),
  keys as materialized(select segment_key from portions union select segment_key from native)
  select jsonb_build_object('segment_key',k.segment_key,'approved_segment_id',s.id,
    'approved_source_ex_vat',case when p.n is null then case when s.pay_excluded then 0 else s.approved_source_ex_vat end else p.a end,
    'realised_source_ex_vat',case when p.n is null then case when s.pay_excluded then 0 else s.approved_source_ex_vat end else p.r end,
    'held_source_ex_vat',coalesce(p.h,0),'included_source_ex_vat',coalesce(p.included,0),
    'excluded_source_ex_vat',coalesce(p.positive-p.included,0),'recovery_source_ex_vat',coalesce(p.recovery,0),
    'held_overhang_source_ex_vat',coalesce(p.overhang,0),'native_source_ex_vat',case when s.pay_excluded then 0 else s.approved_source_ex_vat end,
    'projected_residual',coalesce(p.residual,0),
    'hours',jsonb_build_array(s.hours_day,s.hours_night,s.hours_sat,s.hours_sun,s.hours_bh),
    'rates',jsonb_build_array(s.pay_day,s.pay_night,s.pay_sat,s.pay_sun,s.pay_bh))
  from keys k left join portions p on p.segment_key is not distinct from k.segment_key
   left join native s on s.segment_key=k.segment_key order by k.segment_key nulls first
 loop
  if ((v_member->>'approved_segment_id') is not null
      and (v_member->>'approved_source_ex_vat')::numeric is distinct from (v_member->>'native_source_ex_vat')::numeric)
   or (v_segmented and v_member->>'approved_segment_id' is null and (v_member->>'approved_source_ex_vat')::numeric<>0)
   or (v_member->>'approved_source_ex_vat')::numeric-(v_member->>'realised_source_ex_vat')::numeric
      -(v_member->>'held_source_ex_vat')::numeric is distinct from (v_member->>'projected_residual')::numeric
   or (v_member->>'included_source_ex_vat')::numeric+(v_member->>'excluded_source_ex_vat')::numeric
      -(v_member->>'recovery_source_ex_vat')::numeric-(v_member->>'held_overhang_source_ex_vat')::numeric
      is distinct from (v_member->>'projected_residual')::numeric then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
  v_a:=v_a+(v_member->>'approved_source_ex_vat')::numeric;v_r:=v_r+(v_member->>'realised_source_ex_vat')::numeric;
  v_h:=v_h+(v_member->>'held_source_ex_vat')::numeric;v_included:=v_included+(v_member->>'included_source_ex_vat')::numeric;
  v_excluded:=v_excluded+(v_member->>'excluded_source_ex_vat')::numeric;v_recovery:=v_recovery+(v_member->>'recovery_source_ex_vat')::numeric;
  v_overhang:=v_overhang+(v_member->>'held_overhang_source_ex_vat')::numeric;
  v_bytes:=v_bytes+octet_length(v_member::text)+2;
  if v_bytes>8388608 then raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_ACCEPTED_SCOPE_TOO_LARGE';end if;
  if v_segmented then v_members:=array_append(v_members,v_member);end if;
 end loop;
 if (v_a,v_r,v_h) is distinct from (pos.approved_source_ex_vat,pos.realised_source_ex_vat,pos.held_source_ex_vat)
  or v_a-v_r-v_h is distinct from v_included+v_excluded-v_recovery-v_overhang then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
 -- Same101 physical mapped-boundary discovery as the accepted owner, without a Run.
 for d in select x.* from private.bpay_next_component_resolution x where x.work_id=w.id and x.state='ACTIVE'
   and (x.based_on_revision_id=r.id or x.published_revision_id=r.id)
   and (case when x.based_on_revision_id=r.id then x.approved_line_id else x.published_line_id end)=a.id
   order by case when x.based_on_revision_id=r.id then x.approved_line_id else x.published_line_id end,
     x.rate_family,x.rate_code,x.id limit 101 loop
  v_seen:=v_seen+1;
  if v_seen>100 then raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_ACCEPTED_SCOPE_TOO_LARGE';end if;
  v_line:=case when d.based_on_revision_id=r.id then d.approved_line_id else d.published_line_id end;
  if v_line is distinct from a.id or (d.candidate_id,d.target_pay_channel,d.target_umbrella_id,d.target_umbrella_vat_chargeable,
    d.valuation_policy_id,d.valuation_date) is distinct from(c.id,v_target,v_umbrella,v_vat,r.valuation_policy_id,p_pay_date) then continue;end if;
  select x.* into active from private.bpay_next_component_resolution_active_v1(w.id,r.id,a.id,d.rate_family,d.rate_code,
    v_target,v_umbrella,v_vat,r.valuation_policy_id,p_pay_date) x;
  if active.id is distinct from d.id or active.decision_version is distinct from d.decision_version then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_BASIS_CHANGED';end if;
  v_key:=jsonb_build_array(d.rate_family,d.rate_code)::text;
  if v_key=any(v_decision_keys) then raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_COMPATIBILITY_AMBIGUOUS';end if;
  v_decision_keys:=array_append(v_decision_keys,v_key);
  if cardinality(v_decision_keys)>5 then raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_BUCKET_MISSING';end if;
  if first_d.id is null then first_d:=d;end if;
  v_refs:=v_refs||jsonb_build_array(jsonb_build_object('approved_line_id',a.id,'rate_family',d.rate_family,
    'rate_code',d.rate_code,'decision_id',d.id,'decision_version',d.decision_version::text));
  select x.xmin::text into v_native_version from private.bpay_next_component_resolution x where x.id=d.id;
  v_versions:=v_versions||jsonb_build_array(jsonb_build_array('RATE_DECISION',d.id::text,d.decision_version::text,v_native_version));
 end loop;
 if first_d.id is null then return null;end if;
 v_basis:=jsonb_build_object('approved_source_ex_vat',v_a,'realised_source_ex_vat',v_r,
   'held_source_ex_vat',v_h,'source_basis_channel',pos.source_basis_channel);
 v_required_included:=v_included;
 if p_through_segment_key is not null then
  if not v_segmented or not exists(select 1 from unnest(v_members) x where x->>'segment_key'=p_through_segment_key
    and (x->>'included_source_ex_vat')::numeric>0 and x->>'approved_segment_id' is not null) then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
  select jsonb_build_object('approved_source_ex_vat',sum((x->>'approved_source_ex_vat')::numeric),
    'realised_source_ex_vat',sum((x->>'realised_source_ex_vat')::numeric),'held_source_ex_vat',sum((x->>'held_source_ex_vat')::numeric),
    'source_basis_channel',pos.source_basis_channel),sum((x->>'included_source_ex_vat')::numeric)
   into v_basis,v_required_included from unnest(v_members) x where x->>'segment_key'<=p_through_segment_key;
 end if;
 v_working:=jsonb_build_object('work_id',w.id,'revision_id',r.id,'approved_line_id',a.id,'pay_date',p_pay_date,
  'valuation_policy_id',r.valuation_policy_id,'refs',v_refs,'members',to_jsonb(v_members),
  'included_source_ex_vat',v_included,'current_decision_versions',v_versions);
 if octet_length(v_working::text)>8388608 then raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_ACCEPTED_SCOPE_TOO_LARGE';end if;
 v_result:=private.bpay_next_component_resolution_input_quote_v1(first_d,r.id,v_basis,v_required_included,null,p_through_segment_key,v_working);
 return v_result;
end
$function$;

-- private.bpay_next_component_resolution_input_quote_v1(private.bpay_next_component_resolution,uuid,jsonb,numeric); supabase/repeatable/12102026_2357_banking_pay_next_captured_resolution_composition_v1.sql; SHA256 88d4b5cd5748515a2d67b6c67c83d23b379f846554ccfa48101ddb2c63dd74de
create or replace function private.bpay_next_component_resolution_input_quote_v1(
 p_intent private.bpay_next_component_resolution,p_boundary_revision_id uuid,p_position_basis jsonb,p_included_source_ex_vat numeric
) returns jsonb language sql stable security invoker set search_path=pg_catalog,private
as $function$
 select private.bpay_next_component_resolution_input_quote_v1(p_intent,p_boundary_revision_id,p_position_basis,p_included_source_ex_vat,null,null)
$function$;

-- private.bpay_next_component_resolution_input_quote_v1(private.bpay_next_component_resolution,uuid,jsonb,numeric,uuid,text,jsonb); supabase/repeatable/13102026_0045_banking_pay_next_current_selected_resolution_quote_v1.sql; SHA256 89c3e47d38ca4f3cf3067ff1a1110a15c583c27faf73ad8f1db8c4177bd6a90a
create or replace function private.bpay_next_component_resolution_input_quote_v1(
 p_intent private.bpay_next_component_resolution,p_boundary_revision_id uuid,
 p_position_basis jsonb,p_included_source_ex_vat numeric,p_run_position_id uuid,p_through_segment_key text,p_current_working jsonb
) returns jsonb language plpgsql stable security invoker set search_path=pg_catalog,private
as $function$
declare
 d private.bpay_next_component_resolution:=p_intent;
 b jsonb;v_line uuid;win private.bpay_next_valuation_policy_window%rowtype;
 v_approved numeric;v_realised numeric;v_held numeric;v_residual numeric;
 v_units numeric;v_full_units numeric;v_rate numeric;v_source numeric;
 v_full boolean;v_buckets integer;v_source_sum numeric:=0;v_bucket_source numeric;
 rd private.bpay_next_rate_detail%rowtype;v_native jsonb;v_quote jsonb;v_window_count bigint;
 rp private.bpay_next_run_position%rowtype;worker private.bpay_next_run_worker%rowtype;
 v_current boolean:=p_current_working is not null;
 pos private.bpay_next_position%rowtype;cw private.bpay_next_work%rowtype;cr private.bpay_next_work_revision%rowtype;
 ca private.bpay_next_approved_line%rowtype;cc public.candidates%rowtype;cu public.umbrellas%rowtype;
 v_scope_work uuid;v_scope_candidate uuid;v_scope_revision uuid;v_scope_line uuid;v_scope_component text;
 v_scope_target text;v_scope_umbrella uuid;v_scope_vat boolean;v_scope_source text;v_scope_basis text;
 v_scope_a numeric;v_scope_r numeric;v_scope_h numeric;v_scope_residual numeric;v_scope_members bigint;
 v_saved private.bpay_next_component_resolution%rowtype;v_window private.bpay_next_valuation_policy_window%rowtype;
 v_working jsonb;v_plan jsonb:='[]';v_entry jsonb;v_ref jsonb;v_required_basis jsonb;
 v_required_included numeric;v_capture_included numeric;v_captured_segments boolean:=false;
 v_prepared jsonb[]:=array[]::jsonb[];v_qualified jsonb[]:=array[]::jsonb[];
 v_quote_members jsonb[];v_bucket_facts jsonb[]:=array[]::jsonb[];v_prefixes jsonb[]:=array[]::jsonb[];
 v_member jsonb;v_member_units numeric[];v_member_source numeric[];v_member_included numeric;
 v_member_full boolean;v_member_source_known boolean;v_member_buckets integer;v_single_index integer;
 v_i integer;v_h numeric;v_r numeric;v_equivalent numeric;v_native_sum numeric;v_cell_source numeric;
 v_cum_units numeric[]:=array[0::numeric,0,0,0,0];v_cum_source numeric[]:=array[0::numeric,0,0,0,0];
 v_cum_known boolean[]:=array[true,true,true,true,true];v_zero boolean;
 v_prefix_a numeric:=0;v_prefix_r numeric:=0;v_prefix_h numeric:=0;v_prefix_source numeric:=0;
 v_component_ex numeric;v_component_vat numeric;v_component_inc numeric;v_component jsonb;
 v_requested jsonb;v_selected_requested jsonb;v_selected_component jsonb;v_selected_bucket_facts jsonb[];v_result jsonb;

begin
 -- Complete native capture and pinned scope precede the shared quote plan.
 if v_current and p_run_position_id is not null then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
 if p_run_position_id is null and not v_current then
  if p_through_segment_key is not null then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
  v_plan:=jsonb_build_array(jsonb_build_object('intent',to_jsonb(p_intent)));
 else
  if not v_current then
   v_working:=private.bpay_next_captured_resolution_operands_v1(p_run_position_id);
   rp:=jsonb_populate_record(null::private.bpay_next_run_position,v_working->'position');
   worker:=jsonb_populate_record(null::private.bpay_next_run_worker,v_working->'worker');
   v_scope_work:=rp.work_id;v_scope_candidate:=worker.candidate_id;v_scope_revision:=rp.captured_revision_id;
   v_scope_line:=rp.approved_line_id;v_scope_component:=rp.component_key;v_scope_target:=worker.target_pay_channel;
   v_scope_umbrella:=worker.target_umbrella_id;v_scope_vat:=worker.target_umbrella_vat_chargeable;
   v_scope_source:=rp.source_pay_channel;v_scope_basis:=rp.source_basis_channel;
   v_scope_a:=rp.approved_source_ex_vat;v_scope_r:=rp.realised_source_ex_vat;v_scope_h:=rp.held_source_ex_vat;
   v_scope_residual:=rp.residual_source_ex_vat;v_scope_members:=rp.segment_member_count;
  else
   v_working:=p_current_working;
   select x.* into cw from private.bpay_next_work x where x.id=p_intent.work_id;
   select x.* into cr from private.bpay_next_work_revision x where x.id=p_boundary_revision_id and x.work_id=cw.id;
   select x.* into ca from private.bpay_next_approved_line x where x.id=(v_working->>'approved_line_id')::uuid
    and x.revision_id=cr.id and x.component_key=p_intent.component_key;
   select x.* into pos from private.bpay_next_position x where x.work_id=cw.id and x.component_key=ca.component_key;
   select x.* into cc from public.candidates x where x.id=cw.candidate_id;
   select x.* into cu from public.umbrellas x where x.id=cc.umbrella_id;
   v_scope_work:=cw.id;v_scope_candidate:=cc.id;v_scope_revision:=cr.id;v_scope_line:=ca.id;
   v_scope_component:=ca.component_key;v_scope_target:=upper(cc.pay_method);
   v_scope_umbrella:=case when v_scope_target='UMBRELLA' then cu.id end;
   v_scope_vat:=case when v_scope_target='UMBRELLA' then cu.vat_chargeable end;
   v_scope_source:=cr.source_pay_channel;v_scope_basis:=pos.source_basis_channel;
   v_scope_a:=pos.approved_source_ex_vat;v_scope_r:=pos.realised_source_ex_vat;v_scope_h:=pos.held_source_ex_vat;
   v_scope_residual:=v_scope_a-v_scope_r-v_scope_h;v_scope_members:=jsonb_array_length(v_working->'members');
   if cw.id is null or cr.id is null or ca.id is null or cc.id is null or pos.work_id is null
    or cw.approval_state is distinct from 'APPROVED' or cw.current_revision_id is distinct from cr.id
    or cw.applied_revision_id is distinct from cr.id or pos.applied_revision_id is distinct from cr.id
    or cr.approved_at_utc is null or cr.sealed_at_utc is null or ca.tax_treatment is distinct from 'TAXABLE'
    or cc.active is not true or v_scope_target not in ('PAYE','UMBRELLA') or v_scope_target is null
    or (v_scope_target='UMBRELLA' and (cu.id is null or cu.enabled is not true or cu.vat_chargeable is null))
    or (v_working->>'work_id')::uuid is distinct from cw.id or (v_working->>'revision_id')::uuid is distinct from cr.id
    or (v_working->>'valuation_policy_id')::uuid is distinct from cr.valuation_policy_id
    or (v_working->>'pay_date')::date is distinct from
       (public.pay_banking_official_date_context_v1(null::timestamptz)->>'current_official_pay_date')::date
    or v_scope_a is distinct from ca.source_pay_ex_vat or v_scope_members>10000
    or jsonb_typeof(v_working->'refs') is distinct from 'array' or jsonb_array_length(v_working->'refs') not between 1 and 5
    or octet_length(v_working::text)>8388608 then
    raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
  end if;
  v_capture_included:=(v_working->>'included_source_ex_vat')::numeric;
  if p_boundary_revision_id is distinct from v_scope_revision
   or p_intent.work_id is distinct from v_scope_work or p_intent.component_key is distinct from v_scope_component
   or not exists(select 1 from jsonb_array_elements(v_working->'refs') x
     where (x.value->>'decision_id')::uuid=p_intent.id and (x.value->>'decision_version')::bigint=p_intent.decision_version) then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_ACCEPTED_BASIS_CHANGED';end if;
  select x.* into v_saved from private.bpay_next_component_resolution x
   where x.id=p_intent.id and x.decision_version=p_intent.decision_version;
  if v_saved.id is null or to_jsonb(v_saved) is distinct from to_jsonb(p_intent)
   or (v_current and v_saved.state is distinct from 'ACTIVE') then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_VERSION_MISSING';end if;
  if p_through_segment_key is null then
   v_required_basis:=jsonb_build_object('approved_source_ex_vat',v_scope_a,'realised_source_ex_vat',v_scope_r,
    'held_source_ex_vat',v_scope_h,'source_basis_channel',v_scope_basis);
   v_required_included:=v_capture_included;
  else
   if not exists(select 1 from jsonb_array_elements(v_working->'members') x where x.value->>'segment_key'=p_through_segment_key
      and (x.value->>'included_source_ex_vat')::numeric>0) then
    raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
   select jsonb_build_object('approved_source_ex_vat',sum((x.value->>'approved_source_ex_vat')::numeric),
      'realised_source_ex_vat',sum((x.value->>'realised_source_ex_vat')::numeric),
      'held_source_ex_vat',sum((x.value->>'held_source_ex_vat')::numeric),'source_basis_channel',v_scope_basis),
     sum((x.value->>'included_source_ex_vat')::numeric) into v_required_basis,v_required_included
    from jsonb_array_elements(v_working->'members') x where x.value->>'segment_key'<=p_through_segment_key;
  end if;
  if p_position_basis is distinct from v_required_basis or p_included_source_ex_vat is distinct from v_required_included then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
  v_captured_segments:=v_scope_members>0;
  if v_captured_segments then
   for rd in select x.* from private.bpay_next_rate_detail x where x.approved_line_id=v_scope_line and x.approved_hours>0
      order by case x.bucket when 'DAY' then 1 when 'NIGHT' then 2 when 'SAT' then 3 when 'SUN' then 4 when 'BH' then 5 else 6 end loop
    if rd.bucket not in ('DAY','NIGHT','SAT','SUN','BH') or jsonb_array_length(v_plan)>=5 then
     raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_BUCKET_MISSING';end if;
    v_ref:=null;
    select x.value into v_ref from jsonb_array_elements(v_working->'refs') x
     where x.value->>'rate_family'='STANDARD' and x.value->>'rate_code'=rd.bucket;
    if v_ref is not null then
     select x.* into d from private.bpay_next_component_resolution x
      where x.id=(v_ref->>'decision_id')::uuid and x.decision_version=(v_ref->>'decision_version')::bigint;
     if d.id is null then raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_VERSION_MISSING';end if;
    else
     -- Native equivalent-basis treatment, no fabricated stored decision or CM receipt.
     d:=jsonb_populate_record(null::private.bpay_next_component_resolution,jsonb_build_object('work_id',v_scope_work,
      'candidate_id',v_scope_candidate,'based_on_revision_id',v_scope_revision,'approved_line_id',v_scope_line,
      'physical_timesheet_id',p_intent.physical_timesheet_id,'component_key',v_scope_component,'rate_family','STANDARD','rate_code',rd.bucket,
      'target_pay_channel',v_scope_target,'target_umbrella_id',v_scope_umbrella,
      'target_umbrella_vat_chargeable',v_scope_vat,'valuation_policy_id',v_working->'valuation_policy_id',
      'valuation_date',v_working->'pay_date','resolution_mode','SUGGESTED_EQUIVALENT_BASIS',
      'original_basis',private.bpay_next_component_resolution_basis_v1(v_scope_revision,v_scope_line,'STANDARD',rd.bucket)));
    end if;
    v_plan:=v_plan||jsonb_build_array(jsonb_build_object('intent',to_jsonb(d),'ref',v_ref));
   end loop;
   if jsonb_array_length(v_plan)=0 or exists(select 1 from jsonb_array_elements(v_working->'refs') x
      where x.value->>'rate_family'<>'STANDARD' or not exists(select 1 from jsonb_array_elements(v_plan) y
       where y.value#>>'{intent,rate_code}'=x.value->>'rate_code')) then
    raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_ACCEPTED_BASIS_CHANGED';end if;
  else
   if p_through_segment_key is not null or jsonb_array_length(v_working->'refs')<>1 then
    raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
   v_plan:=jsonb_build_array(jsonb_build_object('intent',to_jsonb(p_intent),'ref',(v_working->'refs')->0));
  end if;
 end if;
 -- One mode/basis/window admission shared by live scalar and captured entries.
 for v_entry in select x.value from jsonb_array_elements(v_plan) x loop
 d:=jsonb_populate_record(null::private.bpay_next_component_resolution,v_entry->'intent');
 v_source_sum:=0;v_bucket_source:=null;v_units:=null;v_quote:=null;
 if p_boundary_revision_id is null or d.work_id is null or d.candidate_id is null
  or d.rate_family is null or d.rate_code is null or d.component_key is null
  or d.target_pay_channel is null or d.target_pay_channel not in ('PAYE','UMBRELLA')
  or (d.target_pay_channel='PAYE' and (d.target_umbrella_id is not null or d.target_umbrella_vat_chargeable is not null))
  or (d.target_pay_channel='UMBRELLA' and (d.target_umbrella_id is null or d.target_umbrella_vat_chargeable is null))
  or d.valuation_policy_id is null or d.valuation_date is null or not isfinite(d.valuation_date)
  or d.valuation_date not between date '0001-01-01' and date '9999-12-31'
  or d.resolution_mode is null then
  raise exception using errcode='22023',message='BPAY_NEXT_RESOLUTION_IDENTITY_INVALID';end if;
 if not exists(select 1 from private.bpay_next_work w where w.id=d.work_id and w.candidate_id=d.candidate_id) then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_IDENTITY_INVALID';end if;
 if p_boundary_revision_id=d.based_on_revision_id then v_line:=d.approved_line_id;
 elsif p_boundary_revision_id=d.published_revision_id then v_line:=d.published_line_id;
 else raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_PUBLICATION_INCOMPATIBLE';end if;
 b:=private.bpay_next_component_resolution_basis_v1(p_boundary_revision_id,v_line,d.rate_family,d.rate_code);
 if b is distinct from (case when p_boundary_revision_id=d.based_on_revision_id then d.original_basis else d.published_basis end)
  or (b->>'work_id')::uuid is distinct from d.work_id
  or (b->>'physical_timesheet_id')::uuid is distinct from d.physical_timesheet_id
  or b->>'component_key' is distinct from d.component_key
  or (b->>'valuation_policy_id')::uuid is distinct from d.valuation_policy_id then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_BASIS_CHANGED';end if;

 if p_run_position_id is not null or v_current then
  if (d.work_id,d.candidate_id,d.component_key,v_line,d.target_pay_channel,d.target_umbrella_id,d.target_umbrella_vat_chargeable,d.valuation_policy_id,d.valuation_date)
    is distinct from (v_scope_work,v_scope_candidate,v_scope_component,v_scope_line,v_scope_target,
      v_scope_umbrella,v_scope_vat,(v_working->>'valuation_policy_id')::uuid,(v_working->>'pay_date')::date)
    or (d.id is not null and not exists(select 1 from jsonb_array_elements(v_working->'refs') x
      where (x.value->>'decision_id')::uuid=d.id and (x.value->>'decision_version')::bigint=d.decision_version
       and x.value->>'rate_family'=d.rate_family and x.value->>'rate_code'=d.rate_code
       and (x.value->>'approved_line_id')::uuid=v_line)) then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_ACCEPTED_BASIS_CHANGED';end if;
 end if;
 if not v_captured_segments then
 if jsonb_typeof(p_position_basis) is distinct from 'object' then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
 if (select count(*) from jsonb_object_keys(p_position_basis))<>4
  or not(p_position_basis ?& array['approved_source_ex_vat','realised_source_ex_vat','held_source_ex_vat','source_basis_channel'])
  or exists(select 1 from jsonb_each(p_position_basis) x where x.key<>'source_basis_channel'
   and jsonb_typeof(x.value)<>'number') then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
 if exists(select 1 from jsonb_each_text(p_position_basis) x where x.key<>'source_basis_channel'
   and (x.value in ('NaN','Infinity','-Infinity') or x.value::numeric<0 or x.value::numeric>=10000000000000000
    or x.value::numeric<>trunc(x.value::numeric,2))) then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
 v_approved:=(p_position_basis->>'approved_source_ex_vat')::numeric;
 v_realised:=(p_position_basis->>'realised_source_ex_vat')::numeric;
 v_held:=(p_position_basis->>'held_source_ex_vat')::numeric;
 v_residual:=v_approved-v_realised-v_held;
 if v_approved is distinct from (b->>'component_source_ex_vat')::numeric or v_residual<0
  or p_included_source_ex_vat is null or p_included_source_ex_vat::text in ('NaN','Infinity','-Infinity')
  or p_included_source_ex_vat<0 or p_included_source_ex_vat>v_residual
  or p_included_source_ex_vat<>trunc(p_included_source_ex_vat,2)
  or ((v_realised<>0 or v_held<>0) and p_position_basis->>'source_basis_channel' is distinct from b->>'source_pay_channel') then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
 else
  -- Signed A/R and positive Included above net residual are admitted only by
  -- the complete native segment census; never by a scalar/caller basis.
  v_approved:=v_scope_a;v_realised:=v_scope_r;v_held:=v_scope_h;
  v_residual:=v_scope_residual;
  if v_approved is distinct from (b->>'component_source_ex_vat')::numeric
   or ((v_realised<>0 or v_held<>0) and v_scope_basis is distinct from b->>'source_pay_channel') then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_SOURCE_BASIS_UNAVAILABLE';end if;
 end if;
 -- Raw request precision is checked before constructing this native composite.
 -- Repeat the exact semantic admission here for every qualified caller.
 if (d.resolution_mode='SUGGESTED_EQUIVALENT_BASIS' and (d.manual_replacement_rate is not null or d.manual_amount_ex_vat is not null))
  or (d.resolution_mode='MANUAL_REPLACEMENT_RATE' and (b->>'semantics'<>'RATE_BEARING'
   or d.manual_replacement_rate is null or d.manual_replacement_rate::text in ('NaN','Infinity','-Infinity')
   or d.manual_replacement_rate<0 or d.manual_replacement_rate>=1000000000000
   or d.manual_replacement_rate<>trunc(d.manual_replacement_rate,6) or d.manual_amount_ex_vat is not null
   or nullif(btrim(d.reason),'') is null))
  or (d.resolution_mode='MANUAL_AMOUNT' and (b->>'semantics'<>'AMOUNT_LED'
   or d.manual_amount_ex_vat is null or d.manual_amount_ex_vat::text in ('NaN','Infinity','-Infinity')
   or d.manual_amount_ex_vat<0 or d.manual_amount_ex_vat>=10000000000000000
   or d.manual_amount_ex_vat<>trunc(d.manual_amount_ex_vat,2) or d.manual_replacement_rate is not null
   or nullif(btrim(d.reason),'') is null)) or octet_length(d.reason)>2000 then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_MODE_INVALID';end if;
 if d.resolution_mode='MANUAL_AMOUNT' and (d.original_position_basis is distinct from p_position_basis
  or p_included_source_ex_vat is distinct from v_residual) then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
 select x.* into win
  from private.bpay_next_valuation_policy_window x where x.policy_id=d.valuation_policy_id
   and d.valuation_date>=x.date_from and (x.date_to is null or d.valuation_date<=x.date_to)
  order by x.date_from desc,x.source_window_id desc limit 1;
 if win.source_window_id is null then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POLICY_WINDOW_MISSING';end if;
 select count(*) into v_window_count from private.bpay_next_valuation_policy_window x
  where x.policy_id=d.valuation_policy_id and x.date_from=win.date_from
   and d.valuation_date>=x.date_from and (x.date_to is null or d.valuation_date<=x.date_to);
 if v_window_count<>1 then
  raise exception using errcode='23514',message='BPAY_NEXT_TARGET_POLICY_WINDOW_AMBIGUOUS';end if;

 if not v_captured_segments then
  if p_included_source_ex_vat=0 then v_source:=0;v_units:=0;v_zero:=true;
  else
 v_full:=v_realised=0 and v_held=0 and p_included_source_ex_vat=v_approved;
 v_full_units:=(b->>'source_units')::numeric;v_rate:=(b->>'source_rate')::numeric;
 v_units:=case when v_full then v_full_units end;v_source:=p_included_source_ex_vat;
 if d.rate_family='STANDARD' then
  select count(*) into v_buckets from private.bpay_next_rate_detail where approved_line_id=v_line and approved_hours>0;
  if v_buckets>1 then
   if not v_full then
    -- Aggregate A/R/H cannot attribute paid units or SOURCE money by bucket.
    raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
   for rd in select x.* from private.bpay_next_rate_detail x where x.approved_line_id=v_line and x.approved_hours>0 loop
    if rd.approved_hours::text in ('NaN','Infinity','-Infinity') or rd.approved_hours>=1000000000000
     or rd.approved_hours<>trunc(rd.approved_hours,6) or rd.source_pay_rate is null
     or rd.source_pay_rate::text in ('NaN','Infinity','-Infinity') or rd.source_pay_rate<0
     or rd.source_pay_rate>=1000000000000 or rd.source_pay_rate<>trunc(rd.source_pay_rate,6) then
     raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_SOURCE_BASIS_UNAVAILABLE';end if;
    v_native:=private.pay_finance_selected_quote_v1('MANUAL_REPLACEMENT_RATE',null,
     b->>'source_pay_channel',b->>'source_pay_channel',rd.approved_hours,rd.source_pay_rate,null,win.erni_pct,win.vat_rate_pct,false);
    v_source_sum:=v_source_sum+(v_native->>'ex')::numeric;
    if rd.bucket=d.rate_code then v_bucket_source:=(v_native->>'ex')::numeric;end if;
   end loop;
   if v_source_sum=v_approved and v_bucket_source is not null then v_source:=v_bucket_source;
   elsif d.resolution_mode='MANUAL_REPLACEMENT_RATE' then v_source:=null;
   else raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_SOURCE_BASIS_UNAVAILABLE';end if;
  elsif v_buckets<>1 then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_SOURCE_BASIS_UNAVAILABLE';end if;
 end if;
 if not v_full and b->>'semantics'='RATE_BEARING' then
  -- One immutable unit-price basis only. Numeric division itself is not proof:
  -- exact <=6-decimal quotient, multiplication equality and native roundtrip.
  if v_rate>0 and v_full_units>0 then
   v_native:=private.pay_finance_selected_quote_v1('MANUAL_REPLACEMENT_RATE',null,
    b->>'source_pay_channel',b->>'source_pay_channel',v_full_units,v_rate,null,win.erni_pct,win.vat_rate_pct,false);
   v_units:=p_included_source_ex_vat/v_rate;
   if (v_native->>'ex')::numeric is distinct from v_approved
    or v_units::text in ('NaN','Infinity','-Infinity') or v_units<0 or v_units>=1000000000000
    or v_units>v_full_units or v_units<>trunc(v_units,6)
    or v_units*v_rate is distinct from p_included_source_ex_vat then v_units:=null;
   else
    v_native:=private.pay_finance_selected_quote_v1('MANUAL_REPLACEMENT_RATE',null,
     b->>'source_pay_channel',b->>'source_pay_channel',v_units,v_rate,null,win.erni_pct,win.vat_rate_pct,false);
    if (v_native->>'ex')::numeric is distinct from p_included_source_ex_vat then v_units:=null;end if;
   end if;
  end if;
 end if;
 if d.resolution_mode='MANUAL_REPLACEMENT_RATE' and (v_units is null or v_units<=0) then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
 v_zero:=false;
  end if;
 end if;
 v_prepared:=array_append(v_prepared,v_entry||jsonb_build_object('basis',b,'window',to_jsonb(win),
  'units',v_units,'source',v_source,'residual',v_residual,'zero',v_zero));
 end loop;

 -- Qualify each real Included member once, before any target quote/hold.
 if v_captured_segments then
  v_window:=jsonb_populate_record(null::private.bpay_next_valuation_policy_window,v_prepared[1]->'window');
  for v_member in select x.value from jsonb_array_elements(v_working->'members') x loop
   v_member_included:=(v_member->>'included_source_ex_vat')::numeric;
   v_member_units:=array[0::numeric,0,0,0,0];v_member_source:=array[0::numeric,0,0,0,0];
   if v_member_included>0 then
    v_member_full:=(v_member->>'realised_source_ex_vat')::numeric=0 and (v_member->>'held_source_ex_vat')::numeric=0
      and v_member_included=(v_member->>'approved_source_ex_vat')::numeric;
    v_member_buckets:=0;v_native_sum:=0;v_member_source_known:=true;v_single_index:=null;
    for v_i in 1..5 loop
     v_h:=(v_member->'hours'->>(v_i-1))::numeric;v_r:=(v_member->'rates'->>(v_i-1))::numeric;
     if v_h is null or v_h::text in ('NaN','Infinity','-Infinity') or v_h<0 or v_h>=1000000000000 or v_h<>trunc(v_h,6) then
      raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
     if v_h>0 then
      v_member_buckets:=v_member_buckets+1;v_single_index:=v_i;
      if not exists(select 1 from unnest(v_prepared) x where x#>>'{basis,rate_code}'=(array['DAY','NIGHT','SAT','SUN','BH'])[v_i]) then
       raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_BUCKET_MISSING';end if;
      v_member_units[v_i]:=v_h;
      if v_r is null or v_r::text in ('NaN','Infinity','-Infinity') or v_r<0 or v_r>=1000000000000 or v_r<>trunc(v_r,6) then
       v_member_source_known:=false;
      else
       v_native:=private.pay_finance_selected_quote_v1('MANUAL_REPLACEMENT_RATE',null,v_scope_source,v_scope_source,
        v_h,v_r,null,v_window.erni_pct,v_window.vat_rate_pct,false);
       v_member_source[v_i]:=(v_native->>'ex')::numeric;v_native_sum:=v_native_sum+v_member_source[v_i];
      end if;
     end if;
    end loop;
    if v_member_buckets=0 then raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
    v_member_source_known:=v_member_source_known and v_native_sum=(v_member->>'approved_source_ex_vat')::numeric;
    if not v_member_full then
     if v_member_buckets<>1 or not v_member_source_known then
      raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
     v_i:=v_single_index;v_r:=(v_member->'rates'->>(v_i-1))::numeric;v_h:=v_member_units[v_i];
     if v_r is null or v_r<=0 then raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
     v_equivalent:=v_member_included/v_r;
     if v_equivalent::text in ('NaN','Infinity','-Infinity') or v_equivalent<=0 or v_equivalent>=1000000000000
       or v_equivalent>v_h or v_equivalent<>trunc(v_equivalent,6) or v_equivalent*v_r is distinct from v_member_included then
      raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
     v_native:=private.pay_finance_selected_quote_v1('MANUAL_REPLACEMENT_RATE',null,v_scope_source,v_scope_source,
      v_equivalent,v_r,null,v_window.erni_pct,v_window.vat_rate_pct,false);
     if (v_native->>'ex')::numeric is distinct from v_member_included then
      raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
     v_member_units[v_i]:=v_equivalent;v_member_source[v_i]:=v_member_included;
    end if;
    if not v_member_source_known then
     for v_i in 1..5 loop if v_member_units[v_i]>0 then v_member_source[v_i]:=null;end if;end loop;
    end if;
   end if;
   v_qualified:=array_append(v_qualified,v_member||jsonb_build_object('included_units',to_jsonb(v_member_units),'bucket_source',to_jsonb(v_member_source)));
  end loop;
  if octet_length((v_working||jsonb_build_object('members',to_jsonb(v_qualified),'plan',to_jsonb(v_prepared)))::text)>8388608 then
   raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_ACCEPTED_SCOPE_TOO_LARGE';end if;
 end if;

 if v_captured_segments and v_capture_included>0 then v_quote_members:=v_qualified;
 else v_quote_members:=array[jsonb_build_object('zero',v_captured_segments)];end if;
 foreach v_member in array v_quote_members loop
  if v_captured_segments and v_capture_included>0 then
   v_prefix_a:=v_prefix_a+(v_member->>'approved_source_ex_vat')::numeric;
   v_prefix_r:=v_prefix_r+(v_member->>'realised_source_ex_vat')::numeric;
   v_prefix_h:=v_prefix_h+(v_member->>'held_source_ex_vat')::numeric;
   v_prefix_source:=v_prefix_source+(v_member->>'included_source_ex_vat')::numeric;
   if (v_member->>'included_source_ex_vat')::numeric=0 then continue;end if;
   for v_i in 1..5 loop
    v_cum_units[v_i]:=v_cum_units[v_i]+(v_member->'included_units'->>(v_i-1))::numeric;
    v_cell_source:=(v_member->'bucket_source'->>(v_i-1))::numeric;
    if v_cell_source is null then v_cum_known[v_i]:=false;end if;
    v_cum_source[v_i]:=case when v_cum_known[v_i] then v_cum_source[v_i]+v_cell_source end;
   end loop;
  end if;
  v_component_ex:=0;v_component_vat:=0;v_component_inc:=0;v_bucket_facts:=array[]::jsonb[];
  foreach v_entry in array v_prepared loop
   d:=jsonb_populate_record(null::private.bpay_next_component_resolution,v_entry->'intent');
   b:=v_entry->'basis';win:=jsonb_populate_record(null::private.bpay_next_valuation_policy_window,v_entry->'window');
   if v_captured_segments then
    v_i:=array_position(array['DAY','NIGHT','SAT','SUN','BH'],d.rate_code);
    v_units:=v_cum_units[v_i];v_source:=v_cum_source[v_i];
    if v_units is null or v_units<0 or v_units>=1000000000000 or v_units<>trunc(v_units,6)
      or v_units>(b->>'source_units')::numeric then
     raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_RESIDUAL_AMBIGUOUS';end if;
    if d.resolution_mode='SUGGESTED_EQUIVALENT_BASIS' and v_source is null then
     raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_SOURCE_BASIS_UNAVAILABLE';end if;
    v_zero:=v_units=0 and v_source=0;
   else
    v_units:=(v_entry->>'units')::numeric;v_source:=(v_entry->>'source')::numeric;v_zero:=(v_entry->>'zero')::boolean;
   end if;
   if v_zero then v_quote:=jsonb_build_object('ex',0,'vat',0,'inc',0,'rate',null);
   else
   -- The original2218 target arithmetic call and result admission, one shared body.
   v_quote:=private.pay_finance_selected_quote_v1(d.resolution_mode,v_source,b->>'source_pay_channel',
    d.target_pay_channel,v_units,d.manual_replacement_rate,d.manual_amount_ex_vat,
    win.erni_pct,win.vat_rate_pct,coalesce(d.target_umbrella_vat_chargeable,false));
   end if;
   if not(v_quote ?& array['ex','vat','inc']) or exists(select 1 from jsonb_each_text(v_quote) q where q.key in ('ex','vat','inc')
     and(q.value is null or q.value in ('NaN','Infinity','-Infinity') or q.value::numeric<0
      or q.value::numeric>=10000000000000000 or q.value::numeric<>trunc(q.value::numeric,2)))
    or (v_quote->>'inc')::numeric is distinct from (v_quote->>'ex')::numeric+(v_quote->>'vat')::numeric then
    raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_QUOTE_RANGE_INVALID';end if;
   v_component_ex:=v_component_ex+(v_quote->>'ex')::numeric;
   v_component_vat:=v_component_vat+(v_quote->>'vat')::numeric;v_component_inc:=v_component_inc+(v_quote->>'inc')::numeric;
   v_bucket_facts:=array_append(v_bucket_facts,jsonb_build_object('rate_family',d.rate_family,'rate_code',d.rate_code,
     'decision_id',d.id,'decision_version',case when d.id is not null then d.decision_version::text end,
     'treatment',case when d.id is null then 'NATIVE_DEFAULT' else 'PINNED' end,'resolution_mode',d.resolution_mode,
     'approved_units',b->'source_units','included_units',v_units,'source_rate',b->'source_rate','source_ex_vat',v_source,
     'manual_replacement_rate',d.manual_replacement_rate,'manual_amount_ex_vat',d.manual_amount_ex_vat,'quote',v_quote,
     'valuation_policy_id',d.valuation_policy_id,'valuation_window_id',win.source_window_id));
   if (d.rate_family,d.rate_code) is not distinct from (p_intent.rate_family,p_intent.rate_code) then
    v_requested:=jsonb_build_object('source_ex_vat',v_source,
      'source_component_residual_ex_vat',case when v_captured_segments then (p_position_basis->>'approved_source_ex_vat')::numeric
         -(p_position_basis->>'realised_source_ex_vat')::numeric-(p_position_basis->>'held_source_ex_vat')::numeric else (v_entry->>'residual')::numeric end,
      'included_source_component_ex_vat',p_included_source_ex_vat,'remaining_units',v_units,'quote',v_quote,
      'valuation_policy_id',d.valuation_policy_id,'valuation_window_id',win.source_window_id);
   end if;
  end loop;
  if v_component_ex>=10000000000000000 or v_component_vat>=10000000000000000 or v_component_inc>=10000000000000000
   or v_component_inc is distinct from v_component_ex+v_component_vat then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_QUOTE_RANGE_INVALID';end if;
  v_component:=jsonb_build_object('ex',v_component_ex,'vat',v_component_vat,'inc',v_component_inc);
  if v_captured_segments and v_capture_included>0 then
   v_prefixes:=array_append(v_prefixes,jsonb_build_object('segment_key',v_member->>'segment_key',
    case when v_current then 'approved_segment_id' else 'run_work_segment_id' end,
      case when v_current then v_member->'approved_segment_id' else v_member->'run_work_segment_id' end,
    'source_ex_vat',v_member->'included_source_ex_vat',
    'quote',v_component));
  end if;
  if p_through_segment_key is null or v_member->>'segment_key'=p_through_segment_key then
   v_selected_requested:=v_requested;v_selected_component:=v_component;v_selected_bucket_facts:=v_bucket_facts;
  end if;
 end loop;
 if p_run_position_id is null and not v_current then return v_selected_requested;end if;
 if v_selected_requested is null or v_selected_component is null then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
 if p_through_segment_key is not null then
  select coalesce(array_agg(x order by x->>'segment_key'),array[]::jsonb[]) into v_prefixes
   from unnest(v_prefixes) x where x->>'segment_key'<=p_through_segment_key;
 end if;
 v_result:=v_selected_requested||jsonb_build_object('component_quote',v_selected_component,
  'bucket_details',to_jsonb(v_selected_bucket_facts),'prefix_targets',to_jsonb(v_prefixes))
   ||case when v_current then jsonb_build_object('current_decision_versions',v_working->'current_decision_versions')
     else jsonb_build_object('accepted_resolution_refs',v_working->'refs') end;
 if octet_length((v_result||jsonb_build_object('working',v_working,'plan',v_plan,'prepared',to_jsonb(v_prepared),'qualified',to_jsonb(v_qualified)))::text)>8388608 then
  raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_ACCEPTED_SCOPE_TOO_LARGE';end if;
 return v_result;

end
$function$;

-- private.bpay_next_captured_resolution_operands_v1(uuid); supabase/repeatable/12102026_2357_banking_pay_next_captured_resolution_composition_v1.sql; SHA256 fbec5243bff1ab3f24faf87140d9d31951da3081cf1e2775e966aa992e472dba
create or replace function private.bpay_next_captured_resolution_operands_v1(p_run_position_id uuid)
returns jsonb language plpgsql stable security invoker set search_path=pg_catalog,private
as $function$
declare
 rp private.bpay_next_run_position%rowtype;rw private.bpay_next_run_work%rowtype;
 worker private.bpay_next_run_worker%rowtype;run private.bpay_next_pay_run%rowtype;
 choice private.bpay_next_work_choice%rowtype;r private.bpay_next_work_revision%rowtype;
 a private.bpay_next_approved_line%rowtype;v_refs jsonb;v_members jsonb;v_result jsonb;
 v_count bigint;v_bad boolean;v_totals jsonb;
begin
 select x.* into rp from private.bpay_next_run_position x where x.id=p_run_position_id;
 select x.* into rw from private.bpay_next_run_work x where x.id=rp.run_work_id;
 select x.* into worker from private.bpay_next_run_worker x where x.id=rp.run_worker_id;
 select x.* into run from private.bpay_next_pay_run x where x.id=worker.run_id;
 select x.* into choice from private.bpay_next_work_choice x where x.run_id=run.id and x.work_id=rp.work_id;
 select x.* into r from private.bpay_next_work_revision x where x.id=rp.captured_revision_id and x.work_id=rp.work_id;
 select x.* into a from private.bpay_next_approved_line x where x.id=rp.approved_line_id
  and x.revision_id=rp.captured_revision_id and x.component_key=rp.component_key;
 if rp.id is null or rw.id is null or worker.id is null or run.id is null or choice.work_id is null
  or r.id is null or a.id is null or r.approved_at_utc is null or r.sealed_at_utc is null
  or run.accepted_choice_descriptor is null
  or a.tax_treatment is distinct from 'TAXABLE' or choice.accepted_resolution_refs is null
  or choice.selection_state is distinct from 'SEALED' or choice.expected_revision_id is distinct from r.id
  or (rp.run_worker_id,rp.work_id,rp.captured_revision_id) is distinct from (rw.run_worker_id,rw.work_id,rw.captured_revision_id)
  or rw.candidate_id is distinct from worker.candidate_id
  or not exists(select 1 from private.bpay_next_work w where w.id=rp.work_id and w.candidate_id=worker.candidate_id)
  or not rp.segment_attribution_complete or rp.segment_member_count<>rp.segment_expected_member_count
  or rp.approved_source_ex_vat is distinct from a.source_pay_ex_vat
  or rp.source_pay_channel is distinct from r.source_pay_channel or rp.needs_financial_resolution then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
 -- Validate the immutable original Header even when all native segments are excluded.
 perform private.bpay_next_choice_leaf_eligible_v1(run.id,rp.work_id,r.id,a.id,null);
 if rp.segment_expected_member_count>10000 then
  raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_ACCEPTED_SCOPE_TOO_LARGE';end if;
 select coalesce(jsonb_agg(x.value order by x.value->>'rate_family',x.value->>'rate_code'),'[]') into v_refs
  from jsonb_array_elements(choice.accepted_resolution_refs) x where (x.value->>'approved_line_id')::uuid=a.id;
 if jsonb_array_length(v_refs) not between 1 and 5 or octet_length(v_refs::text)>8192
  or (select count(distinct jsonb_build_array(x.value->>'rate_family',x.value->>'rate_code'))
    from jsonb_array_elements(v_refs) x)<>jsonb_array_length(v_refs) then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_ACCEPTED_BASIS_CHANGED';end if;
 -- The maintained count is not an excuse to omit the physical overflow sentinel.
 with parents as materialized (
  select p.* from private.bpay_next_run_work_segment_parent p where p.run_work_id=rw.id and p.component_key=rp.component_key
   order by p.segment_key limit 10001
 ), members as materialized (
  select p.*,s.run_worker_id,s.work_id as segment_work_id,s.captured_revision_id as segment_revision,
   s.segment_key as actual_key,s.approved_segment_id as actual_approved_segment,s.disposition,
   g.id as native_segment_id,g.revision_id as native_revision,g.approved_line_id as native_line,
   g.component_key as native_component,g.segment_key as native_key,g.approved_source_ex_vat as native_source,
   jsonb_build_array(g.hours_day,g.hours_night,g.hours_sat,g.hours_sun,g.hours_bh) as hours,
   jsonb_build_array(g.pay_day,g.pay_night,g.pay_sat,g.pay_sun,g.pay_bh) as rates
  from parents p left join private.bpay_next_run_work_segment s on s.id=p.run_work_segment_id
  left join private.bpay_next_approved_segment g on g.id=p.approved_segment_id
 )
 select count(*),coalesce(bool_or(
    (work_id,captured_revision_id,segment_key) is distinct from (segment_work_id,segment_revision,actual_key)
    or run_worker_id is distinct from worker.id or captured_revision_id is distinct from r.id
    or approved_segment_id is distinct from actual_approved_segment
    or (approved_segment_id is not null and (native_segment_id,native_revision,native_line,native_component,native_key,native_source)
      is distinct from (approved_segment_id,r.id,a.id,rp.component_key,segment_key,approved_source_ex_vat))
    or (included_positive_source_ex_vat>0 and (disposition is distinct from 'INCLUDED' or native_segment_id is null
      or not private.bpay_next_choice_leaf_eligible_v1(run.id,rp.work_id,r.id,a.id,native_segment_id)))
    or residual_source_ex_vat<>approved_source_ex_vat-realised_source_ex_vat-held_source_ex_vat
    or included_positive_source_ex_vat+excluded_positive_source_ex_vat-recovery_source_ex_vat-held_overhang_source_ex_vat<>residual_source_ex_vat
   ),false),coalesce(jsonb_agg(jsonb_build_object('segment_key',segment_key,'run_work_segment_id',run_work_segment_id,
    'approved_segment_id',approved_segment_id,'approved_source_ex_vat',approved_source_ex_vat,
    'realised_source_ex_vat',realised_source_ex_vat,'held_source_ex_vat',held_source_ex_vat,
    'included_source_ex_vat',included_positive_source_ex_vat,'excluded_source_ex_vat',excluded_positive_source_ex_vat,
    'recovery_source_ex_vat',recovery_source_ex_vat,'held_overhang_source_ex_vat',held_overhang_source_ex_vat,
    'hours',hours,'rates',rates) order by segment_key),'[]'),
   jsonb_build_object('a',coalesce(sum(approved_source_ex_vat),0),'r',coalesce(sum(realised_source_ex_vat),0),
    'h',coalesce(sum(held_source_ex_vat),0),'included',coalesce(sum(included_positive_source_ex_vat),0),
    'excluded',coalesce(sum(excluded_positive_source_ex_vat),0),'recovery',coalesce(sum(recovery_source_ex_vat),0),
    'overhang',coalesce(sum(held_overhang_source_ex_vat),0))
 into v_count,v_bad,v_members,v_totals
 from members;
 if v_count>10000 then raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_ACCEPTED_SCOPE_TOO_LARGE';end if;
 if v_count=0 and not private.bpay_next_choice_leaf_eligible_v1(run.id,rp.work_id,r.id,a.id,null) then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_POSITION_INCOMPATIBLE';end if;
 if v_bad or v_count<>rp.segment_member_count
  or (v_count>0 and ((v_totals->>'a')::numeric,(v_totals->>'r')::numeric,(v_totals->>'h')::numeric,(v_totals->>'included')::numeric,
     (v_totals->>'excluded')::numeric,(v_totals->>'recovery')::numeric,(v_totals->>'overhang')::numeric)
    is distinct from (rp.approved_source_ex_vat,rp.realised_source_ex_vat,rp.held_source_ex_vat,
      rp.segment_included_positive_ex_vat,rp.segment_excluded_positive_ex_vat,rp.segment_recovery_ex_vat,rp.segment_held_overhang_ex_vat)) then
  raise exception using errcode='23514',message='BPAY_NEXT_SEGMENT_HOLD_CAPTURE_INCOMPLETE';end if;
 v_result:=jsonb_build_object('position',to_jsonb(rp),'work',to_jsonb(rw),'worker',to_jsonb(worker),
  'pay_date',run.pay_date,'valuation_policy_id',r.valuation_policy_id,'refs',v_refs,'members',v_members,
  'included_source_ex_vat',case when v_count>0 then rp.segment_included_positive_ex_vat
    else greatest(rp.residual_source_ex_vat,0)-rp.snooze_excluded_positive_ex_vat end);
 if octet_length(v_result::text)>8388608 then
  raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_ACCEPTED_SCOPE_TOO_LARGE';end if;
 return v_result;
end
$function$;

-- private.bpay_next_choice_leaf_eligible_v1(uuid,uuid,uuid,uuid,uuid); supabase/repeatable/13102026_0016_banking_pay_next_accepted_eligible_leaf_v1.sql; SHA256 7e729768583a0bfb24f970bd4af7619b36f9a5e2c1a039fcc75084beccf574e4
create or replace function private.bpay_next_choice_leaf_eligible_v1(
 p_run_id uuid,p_work_id uuid,p_revision_id uuid,p_line_id uuid,p_segment_id uuid
) returns boolean language plpgsql stable security invoker set search_path=pg_catalog,private
as $function$
declare
 r private.bpay_next_pay_run%rowtype;h private.bpay_next_selection_mode_memory%rowtype;
 c private.bpay_next_work_choice%rowtype;a private.bpay_next_approved_line%rowtype;
 s private.bpay_next_approved_segment%rowtype;v_candidate uuid;
begin
 select x.* into r from private.bpay_next_pay_run x where x.id=p_run_id;
 select x.* into h from private.bpay_next_selection_mode_memory x where x.run_id=p_run_id and x.row_kind='HEADER';
 if h.run_id is null then
  if r.id is null or r.accepted_choice_descriptor is not null then
   raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_ELIGIBLE_CAPTURE_MISSING';end if;
  -- Original non-descriptor selection owners retain their existing admission.
  return true;
 end if;
 if r.id is null or (h.actor_user_id,h.official_pay_date) is distinct from (r.actor_user_id,r.pay_date)
  or (r.accepted_choice_descriptor is not null and
    (h.accepted_context is distinct from r.accepted_choice_descriptor-'intent'
      or h.raw_intent is distinct from r.accepted_choice_descriptor->'intent')) then
  raise exception using errcode='23514',message='BPAY_NEXT_CHOICE_ELIGIBLE_CAPTURE_MISSING';end if;
 select x.* into c from private.bpay_next_work_choice x where x.run_id=p_run_id and x.work_id=p_work_id;
 select x.* into a from private.bpay_next_approved_line x where x.id=p_line_id and x.revision_id=p_revision_id;
 select x.candidate_id into v_candidate from private.bpay_next_work x where x.id=p_work_id;
 if c.work_id is null or c.expected_revision_id is distinct from p_revision_id
  or c.selection_state is distinct from 'SEALED' or a.id is null or v_candidate is null
  or not exists(select 1 from private.bpay_next_work_revision x where x.id=p_revision_id and x.work_id=p_work_id)
  or (c.selection_mode='SUBSET' and not exists(select 1 from private.bpay_next_selected_component x
    where x.run_id=p_run_id and x.work_id=p_work_id and x.expected_revision_id=p_revision_id
      and x.approved_line_id=p_line_id and x.component_key=a.component_key)) then return false;end if;
 if p_segment_id is not null then
  select x.* into s from private.bpay_next_approved_segment x where x.id=p_segment_id;
  if s.id is null or (s.revision_id,s.approved_line_id,s.component_key)
    is distinct from (p_revision_id,p_line_id,a.component_key) then return false;end if;
 end if;
 return exists(select 1 from private.bpay_next_selection_mode_memory m
  where m.run_id=p_run_id and m.row_kind='LEAF' and m.candidate_id=v_candidate
    and m.work_id=p_work_id and m.approved_line_id=p_line_id
    and m.leaf_key='WORK:'||p_work_id::text||':'||a.component_key||':'||
      case when p_segment_id is null then 'WORK_COMPONENT:'||a.component_key else 'WORK_SEGMENT:'||s.segment_key end
    and m.basis->>'revision_id'=p_revision_id::text and m.basis->>'approved_line_id'=p_line_id::text
    and m.basis->>'component_key'=a.component_key and m.basis->>'direction'='PAYMENT'
    and ((p_segment_id is null and m.basis->>'member_kind'='WORK_COMPONENT'
      and m.basis->'approved_segment_id'='null'::jsonb and m.basis->'segment_key'='null'::jsonb)
     or (p_segment_id is not null and m.basis->>'member_kind'='WORK_SEGMENT'
      and m.basis->>'approved_segment_id'=p_segment_id::text and m.basis->>'segment_key'=s.segment_key)));
end
$function$;

-- private.pay_finance_selected_quote_v1(public.pay_finance_component_resolution_mode_enum,numeric,text,text,numeric,numeric,numeric,numeric,numeric,boolean); supabase/repeatable/06102026_1157_banking_pay_shared_selected_quote_v1.sql; SHA256 11b402a9d014d1983bbdce433918eb99025bd64c9b405e3a4b49842f70518182
create or replace function private.pay_finance_selected_quote_v1(
  p_resolution_mode public.pay_finance_component_resolution_mode_enum,
  p_source_ex_vat numeric,
  p_source_pay_method text,
  p_target_pay_method text,
  p_target_units numeric,
  p_manual_replacement_rate numeric,
  p_manual_amount_ex_vat numeric,
  p_relevant_erni_pct numeric,
  p_vat_rate_pct numeric,
  p_umbrella_vat_chargeable boolean
) returns jsonb
language plpgsql
immutable
security invoker
set search_path = pg_catalog, private
as $function$
declare
  v_amounts jsonb;
  v_ex numeric;
  v_vat numeric;
  v_inc numeric;
  v_rate numeric;
begin
  if p_resolution_mode is null
     or p_source_pay_method is null or p_target_pay_method is null
     or p_source_pay_method not in ('PAYE','UMBRELLA')
     or p_target_pay_method not in ('PAYE','UMBRELLA') then
    raise exception using errcode='22023', message='PAY_FINANCE_SELECTED_QUOTE_INPUT_INVALID';
  end if;

  if p_resolution_mode='SUGGESTED_EQUIVALENT_BASIS'::public.pay_finance_component_resolution_mode_enum then
    if p_source_pay_method='PAYE' and p_target_pay_method='UMBRELLA' then
      v_amounts:=public._pay_convert_paye_to_umbrella(
        p_source_ex_vat,p_relevant_erni_pct,p_vat_rate_pct,p_umbrella_vat_chargeable);
    elsif p_source_pay_method='UMBRELLA' and p_target_pay_method='PAYE' then
      v_ex:=public._pay_convert_umbrella_to_paye_ex(p_source_ex_vat,p_relevant_erni_pct);
    elsif p_target_pay_method='UMBRELLA' then
      v_amounts:=public._pay_umbrella_vat_calc(
        p_source_ex_vat,p_vat_rate_pct,p_umbrella_vat_chargeable);
    else
      v_ex:=round(p_source_ex_vat,2);
    end if;
  elsif p_resolution_mode='MANUAL_REPLACEMENT_RATE'::public.pay_finance_component_resolution_mode_enum then
    v_ex:=round(p_target_units*p_manual_replacement_rate,2);
    if p_target_pay_method='UMBRELLA' then
      v_amounts:=public._pay_umbrella_vat_calc(v_ex,p_vat_rate_pct,p_umbrella_vat_chargeable);
    end if;
  elsif p_resolution_mode='MANUAL_AMOUNT'::public.pay_finance_component_resolution_mode_enum then
    v_ex:=round(p_manual_amount_ex_vat,2);
    if p_target_pay_method='UMBRELLA' then
      v_amounts:=public._pay_umbrella_vat_calc(v_ex,p_vat_rate_pct,p_umbrella_vat_chargeable);
    end if;
  else
    raise exception using errcode='22023', message='PAY_FINANCE_SELECTED_QUOTE_MODE_INVALID';
  end if;

  if p_target_pay_method='UMBRELLA' then
    v_ex:=round(coalesce((v_amounts->>'ex')::numeric,0),2);
    v_vat:=round(coalesce((v_amounts->>'vat')::numeric,0),2);
    v_inc:=round(coalesce((v_amounts->>'inc')::numeric,0),2);
  else
    v_vat:=0;
    v_inc:=v_ex;
  end if;

  -- Nonpositive units produce no rate here. The caller's ORIGINAL contextual
  -- guard still owns their refusal after its money assignments.
  if p_resolution_mode='SUGGESTED_EQUIVALENT_BASIS'::public.pay_finance_component_resolution_mode_enum
     and p_target_units>0 then
    v_rate:=round(v_ex/p_target_units,6);
  elsif p_resolution_mode='MANUAL_REPLACEMENT_RATE'::public.pay_finance_component_resolution_mode_enum then
    v_rate:=round(p_manual_replacement_rate,6);
  else
    v_rate:=null;
  end if;
  return jsonb_build_object('ex',v_ex,'vat',v_vat,'inc',v_inc,'rate',v_rate);
end
$function$;

-- public._pay_convert_paye_to_umbrella(numeric,numeric,numeric,boolean); supabase/repeatable/26052026_2100HRS_NEW_FUNCTIONS.sql; SHA256 7e17562629fe50815739334d7199d0a6d9af844cf66fbed53ba8435bcf2b226b
create or replace function public._pay_convert_paye_to_umbrella(
  p_paye_ex numeric,
  p_erni_pct numeric,
  p_vat_rate_pct numeric,
  p_vat_chargeable boolean
)
returns jsonb
language plpgsql
immutable
as $$
declare
  v_erni_mult numeric := public._pay_pct_to_mult(p_erni_pct);
  v_ex numeric := round(coalesce(p_paye_ex,0) * v_erni_mult, 2);
begin
  return public._pay_umbrella_vat_calc(v_ex, p_vat_rate_pct, p_vat_chargeable);
end;
$$;

-- public._pay_pct_to_mult(numeric); supabase/repeatable/26052026_2100HRS_NEW_FUNCTIONS.sql; SHA256 669175de64a6c76412e5b36f60a0552ffdd9142a64266875d3afc347d8d77380
create or replace function public._pay_pct_to_mult(p_pct numeric)
returns numeric
language plpgsql
immutable
as $$
declare
  v_frac numeric;
begin
  v_frac := public._pay_pct_to_frac(p_pct);
  return 1 + coalesce(v_frac, 0);
end;
$$;

-- public._pay_pct_to_frac(numeric); supabase/repeatable/26052026_2100HRS_NEW_FUNCTIONS.sql; SHA256 35cbb093e20e2569fa239dfe1e3d79e39c9e03073b17175f6a412faa5da44097
create or replace function public._pay_pct_to_frac(p_pct numeric)
returns numeric
language plpgsql
immutable
as $$
begin
  if p_pct is null then return 0; end if;
  if p_pct > 1 then return p_pct / 100; end if;
  return p_pct;
end;
$$;

-- public._pay_umbrella_vat_calc(numeric,numeric,boolean); supabase/repeatable/26052026_2100HRS_NEW_FUNCTIONS.sql; SHA256 92fcbf0d6b587185cd7327b2b7ea795759c07b2a9965fedd95a5930685ec62ae
create or replace function public._pay_umbrella_vat_calc(
  p_ex numeric,
  p_vat_rate_pct numeric,
  p_vat_chargeable boolean
)
returns jsonb
language plpgsql
immutable
as $$
declare
  v_ex numeric := coalesce(p_ex,0);
  v_vat numeric := 0;
  v_inc numeric := 0;
  v_frac numeric := public._pay_pct_to_frac(p_vat_rate_pct);
begin
  if coalesce(p_vat_chargeable,false) then
    v_vat := round(v_ex * v_frac, 2);
    v_inc := round(v_ex + v_vat, 2);
  else
    v_vat := 0;
    v_inc := round(v_ex, 2);
  end if;

  return jsonb_build_object(
    'ex', round(v_ex,2),
    'vat', round(v_vat,2),
    'inc', round(v_inc,2)
  );
end;
$$;

-- public._pay_convert_umbrella_to_paye_ex(numeric,numeric); supabase/repeatable/26052026_2100HRS_NEW_FUNCTIONS.sql; SHA256 ce72371ba192da15af23a152226864f447f19b5d2245b7405d2e8eae962aeb51
create or replace function public._pay_convert_umbrella_to_paye_ex(
  p_umbrella_ex numeric,
  p_erni_pct numeric
)
returns numeric
language plpgsql
immutable
as $$
declare
  v_erni_mult numeric := public._pay_pct_to_mult(p_erni_pct);
  v_ex numeric := coalesce(p_umbrella_ex,0);
begin
  if v_erni_mult <= 0 then v_erni_mult := 1; end if;
  return round(v_ex / v_erni_mult, 2);
end;
$$;

-- public.pay_banking_official_date_context_v1(timestamp with time zone); supabase/repeatable/26052026_2100HRS_NEW_FUNCTIONS.sql; SHA256 ff1122516cf2796aef7902783e90fdb9c2f57b222ce7dedc607eddd695cc78a0
CREATE OR REPLACE FUNCTION public.pay_banking_official_date_context_v1(p_as_of_utc timestamp with time zone DEFAULT NULL::timestamp with time zone)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'pg_catalog'
AS $function$
DECLARE
  v_as_of_utc timestamptz := COALESCE(p_as_of_utc, statement_timestamp());
  v_timezone_id text := 'Europe/London';
  v_official_weekday smallint;
  v_settings_updated_at timestamptz;
  v_local_timestamp timestamp without time zone;
  v_business_date date;
  v_business_dow integer;
  v_days_to_official integer;
  v_current_official_pay_date date;
  v_next_official_pay_date date;
  v_following_official_pay_date date;
  v_pay_week_start date;
  v_pay_week_end date;
  v_configuration_fingerprint text;
  v_utc_offset_seconds integer;
BEGIN
  SELECT settings_row.banking_pay_official_pay_weekday,
         settings_row.updated_at
  INTO v_official_weekday,
       v_settings_updated_at
  FROM public.settings_defaults AS settings_row
  WHERE settings_row.id = 1;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'BANKING_PAY_DATE_CONFIGURATION_MISSING'
      USING ERRCODE = 'P0001',
            DETAIL = jsonb_build_object(
              'code', 'BANKING_PAY_DATE_CONFIGURATION_MISSING',
              'message', 'Banking Pay date configuration is unavailable.'
            )::text;
  END IF;

  IF v_official_weekday IS NULL OR v_official_weekday < 0 OR v_official_weekday > 6 THEN
    RAISE EXCEPTION 'BANKING_PAY_WEEKDAY_CONFIGURATION_INVALID'
      USING ERRCODE = 'P0001',
            DETAIL = jsonb_build_object(
              'code', 'BANKING_PAY_WEEKDAY_CONFIGURATION_INVALID',
              'official_pay_weekday', v_official_weekday,
              'message', 'Banking Pay official weekday configuration is invalid.'
            )::text;
  END IF;

  v_local_timestamp := v_as_of_utc AT TIME ZONE 'Europe/London';
  v_business_date := v_local_timestamp::date;
  v_business_dow := EXTRACT(DOW FROM v_business_date)::integer;
  v_days_to_official := ((v_official_weekday::integer - v_business_dow) + 7) % 7;
  v_current_official_pay_date := v_business_date + v_days_to_official;
  -- The operational current Workbench pay date is the first configured pay
  -- weekday on or after the London business date.  That is also the next
  -- official pay run used by Snooze warnings.  The following run is exposed
  -- separately so callers never need to reinterpret "next" as +7 days.
  v_next_official_pay_date := v_current_official_pay_date;
  v_following_official_pay_date := v_current_official_pay_date + 7;
  v_pay_week_end := v_current_official_pay_date;
  v_pay_week_start := v_pay_week_end - 6;
  v_configuration_fingerprint := md5(
    COALESCE(v_timezone_id, '') || '|' ||
    COALESCE(v_official_weekday::text, '') || '|' ||
    COALESCE(v_settings_updated_at::text, '')
  );
  v_utc_offset_seconds := EXTRACT(
    EPOCH FROM (
      v_local_timestamp - (v_as_of_utc AT TIME ZONE 'UTC')
    )
  )::integer;

  RETURN jsonb_build_object(
    'ok', true,
    'server_utc', v_as_of_utc,
    'timezone_id', v_timezone_id,
    'local_timestamp', v_local_timestamp,
    'london_current_date', v_business_date::text,
    'business_date', v_business_date::text,
    'official_pay_weekday', v_official_weekday,
    'official_pay_weekday_name', TRIM(TO_CHAR(v_current_official_pay_date, 'FMDay')),
    'current_official_pay_date', v_current_official_pay_date::text,
    'next_official_pay_date', v_next_official_pay_date::text,
    'following_official_pay_date', v_following_official_pay_date::text,
    'current_pay_week_start', v_pay_week_start::text,
    'current_pay_week_end', v_pay_week_end::text,
    'current_pay_week_key', v_current_official_pay_date::text,
    'settings_defaults_updated_at', v_settings_updated_at,
    'configuration_fingerprint', v_configuration_fingerprint,
    'utc_offset_seconds', v_utc_offset_seconds,
    'as_of_override_applied', p_as_of_utc IS NOT NULL
  );
END;
$function$;

-- private.bpay_next_component_resolution_input_quote_v1(private.bpay_next_component_resolution,uuid,jsonb,numeric,uuid,text); supabase/repeatable/13102026_0045_banking_pay_next_current_selected_resolution_quote_v1.sql; SHA256 99c29c5337339a5ac5af4803b21be243a6d6fd51e3dfdfd8afff99359bbab9ad
create or replace function private.bpay_next_component_resolution_input_quote_v1(
 p_intent private.bpay_next_component_resolution,p_boundary_revision_id uuid,
 p_position_basis jsonb,p_included_source_ex_vat numeric,p_run_position_id uuid,p_through_segment_key text
) returns jsonb language sql stable security invoker set search_path=pg_catalog,private
as $function$
 select private.bpay_next_component_resolution_input_quote_v1(p_intent,p_boundary_revision_id,p_position_basis,
  p_included_source_ex_vat,p_run_position_id,p_through_segment_key,null)
$function$;

-- private.bpay_next_current_component_resolution_quote_v1(uuid,uuid,uuid,date,text[],text); supabase/repeatable/13102026_0113_banking_pay_next_chosen_display_refresh_quote_v1.sql; SHA256 8e9a7c9a60546ba1fe813b1067f7726e257fa681c5b8f589322dd2e1137f8bae
create or replace function private.bpay_next_current_component_resolution_quote_v1(
 p_work_id uuid,p_revision_id uuid,p_approved_line_id uuid,p_pay_date date,
 p_selected_leaf_keys text[],p_through_segment_key text default null
) returns jsonb language sql stable security invoker set search_path=pg_catalog,private
