 select private.bpay_next_current_component_resolution_quote_v1(
  p_work_id,p_revision_id,p_approved_line_id,p_pay_date,p_selected_leaf_keys,p_through_segment_key,false)
$function$;

-- private.bpay_next_workbench_refresh_work_core_v1(uuid); supabase/repeatable/12102026_2146_banking_pay_next_treatment_workbench_query_identity_v1.sql; SHA256 39596ef09ff413e81292f7f0bbea02df551730f343a2687c69ff8ae39b8a2769
create or replace function private.bpay_next_workbench_refresh_work_core_v1(p_work_id uuid)
returns void language plpgsql security definer set search_path=pg_catalog,private
as $function$
declare
  v_work private.bpay_next_work%rowtype;v_revision private.bpay_next_work_revision%rowtype;
  v_metadata private.bpay_next_workbench_candidate_metadata%rowtype;
  v_item private.bpay_next_workbench_item%rowtype;v_base private.bpay_next_workbench_item%rowtype;
  v_before private.bpay_next_workbench_delta[];v_after private.bpay_next_workbench_delta[];
  v_member record;v_accepted record;v_totals record;v_candidate uuid;v_client uuid;v_target text;v_financial bigint;v_projection bigint;
  v_group text:='WORK:'||p_work_id::text;v_today date:=(transaction_timestamp() at time zone 'Europe/London')::date;
  v_sunday date;v_sequence bigint;v_reason text;v_priority smallint;v_section text;v_complete boolean;
  v_pay_hold record;v_hold_canonical boolean;
  v_target_umbrella uuid;v_target_vat boolean;v_need_operation uuid;v_resolution_need jsonb;v_resolution_date date;v_resolution_date_context jsonb;
  v_source_event uuid;
  v_query_gate jsonb;v_query_scope jsonb;v_query_loaded boolean:=false;v_query_state text:='UNAVAILABLE';v_query_exclusions jsonb;v_segment_query_state text;
  v_wait_before boolean;v_wait_after boolean;v_case_id uuid;v_withdrawn_complete boolean;v_was_dirty boolean;
  v_manual private.bpay_next_work_collection%rowtype;v_manual_observation jsonb;v_manual_position private.bpay_next_position%rowtype;v_original_line private.bpay_next_approved_line%rowtype;
  v_positive numeric;v_recovery numeric;v_overhang numeric;v_snooze jsonb;v_count bigint:=0;v_portion text;v_zero boolean;
begin
  perform private.bpay_next_workbench_require_next_v1();
  select w.candidate_id into strict v_candidate from private.bpay_next_work w where w.id=p_work_id;
  select c.financial_view_revision into strict v_financial from private.bpay_next_worker_control c where c.candidate_id=v_candidate for update;
  select w.* into strict v_work from private.bpay_next_work w where w.id=p_work_id for update;
  -- Exact current booking authority; no historical/original-row fallback.
  select t.timesheet_id,tf.id financial_id,coalesce(tf.pay_on_hold,false) pay_on_hold,
    case when tf.pay_on_hold then tf.pay_on_hold_reason end pay_on_hold_reason into v_pay_hold
    from public.timesheets t left join public.timesheets_financials tf on tf.timesheet_id=t.timesheet_id and tf.is_current
    where t.booking_id=v_work.booking_id and t.is_current;
  v_hold_canonical:=v_pay_hold.timesheet_id is not null and v_pay_hold.financial_id is not null;
  -- Read stored WAIT before replacing it; the withdrawal owner already changed work.
  select exists(select 1 from private.bpay_next_workbench_item i where i.group_key=v_group
    and i.reason_code='AWAITING_REAUTHORISATION') into v_wait_before;
  v_wait_after:=private.bpay_next_work_wait_state_v1(v_work.id);
  select exists(select 1 from private.bpay_next_workbench_group g where g.group_key=v_group and g.dirty) into v_was_dirty;
  -- Reauthorisation becomes effective only after final position application.
  -- Keep its stored WAIT marker during Processing for the final boundary hook.
  if v_wait_before and v_work.approval_state='APPROVED'
    and v_work.current_revision_id is distinct from v_work.applied_revision_id then
    update private.bpay_next_workbench_revision set workbench_revision=workbench_revision+1,
      dirty_group_count=dirty_group_count+case when v_was_dirty then 0 else 1 end,
      updated_at_utc=transaction_timestamp() where id=1 returning workbench_revision into v_projection;
    update private.bpay_next_workbench_group set complete=false,dirty=true,progress_state='PROCESSING',
      projection_revision=v_projection,financial_view_revision=v_financial,
      updated_at_utc=transaction_timestamp() where group_key=v_group;
    update private.bpay_next_workbench_item set selectable=false,progress_state='PROCESSING',
      projection_revision=v_projection,financial_view_revision=v_financial,
      updated_at_utc=transaction_timestamp() where group_key=v_group;
    return;
  end if;
  v_metadata:=private.bpay_next_workbench_ensure_metadata_v1(v_candidate);
  select c.pay_method::text,case when c.pay_method='UMBRELLA' then c.umbrella_id end,
    case when c.pay_method='UMBRELLA' then u.vat_chargeable end into v_target,v_target_umbrella,v_target_vat
    from public.candidates c left join public.umbrellas u on u.id=c.umbrella_id where c.id=v_candidate;
  if v_target not in ('PAYE','UMBRELLA') then v_target:=null;end if;
  select c.client_id into v_client from public.contracts c where c.id=v_work.contract_id;
  select r.* into v_revision from private.bpay_next_work_revision r
    where r.id=case when v_work.approval_state='WITHDRAWN' then v_work.applied_revision_id else v_work.current_revision_id end
      and r.work_id=v_work.id;
  v_source_event:=v_revision.source_event_id;
  if v_revision.source_kind in ('SOURCE','PROTECTED') and v_revision.sealed_at_utc is not null
    and v_revision.payment_treatment_approval_revision_id is not null then
    select x.source_event_id into v_source_event from private.bpay_next_work_revision x
      where x.id=private.bpay_next_treatment_approval_revision_v1(v_revision.id) and x.work_id=v_work.id;
  end if;
  v_complete:=v_work.approval_state='APPROVED' and v_revision.id is not null and v_revision.sealed_at_utc is not null
    and v_work.applied_revision_id=v_work.current_revision_id
    and (select count(*) from private.bpay_next_approved_line a where a.revision_id=v_revision.id)=v_revision.expected_line_count;
  -- Only the latest native EX08 receipt and this exact Work; retained needs
  -- are joined inside this existing projection writer, never a read RPC.
  if v_complete then
    select r.operation_id into v_need_operation from private.bpay_next_pay_method_change_receipt r
      where r.candidate_id=v_candidate order by r.post_metadata_version desc limit 1;
    if v_need_operation is not null then
      perform private.bpay_next_component_resolution_need_publish_v1(v_need_operation,v_work.id);
      v_resolution_date_context:=public.pay_banking_official_date_context_v1(null::timestamptz);
      if v_resolution_date_context->>'ok'='true' then
        v_resolution_date:=(v_resolution_date_context->>'current_official_pay_date')::date;
      end if;
    end if;
  end if;
  v_withdrawn_complete:=v_work.approval_state='WITHDRAWN' and v_revision.id is not null
    and v_revision.sealed_at_utc is not null and not exists(select 1 from private.bpay_next_position p
      where p.work_id=v_work.id and p.applied_revision_id is distinct from v_work.applied_revision_id
        and (p.approved_source_ex_vat<>0 or p.realised_source_ex_vat<>0 or p.held_source_ex_vat<>0
          or p.realised_target_ex_vat<>0 or p.realised_target_vat<>0 or p.realised_target_inc_vat<>0
          or p.held_target_ex_vat<>0 or p.held_target_vat<>0 or p.held_target_inc_vat<>0));
  select array_agg(d) into v_before from private.bpay_next_workbench_group_contribution_v1(v_group) d;
  update private.bpay_next_workbench_revision set workbench_revision=workbench_revision+1,
    dirty_group_count=dirty_group_count-case when v_was_dirty then 1 else 0 end,updated_at_utc=transaction_timestamp()
    where id=1 returning workbench_revision into v_projection;
  delete from private.bpay_next_workbench_item where group_key=v_group;
  insert into private.bpay_next_workbench_group(group_key,group_kind,work_id,candidate_id,client_id,contract_id,
    physical_timesheet_id,current_revision_id,source_pay_channel,target_pay_channel,week_ending_date,
    complete,projection_revision,financial_view_revision,metadata_version,progress_state)
  values(v_group,'WORK',v_work.id,v_candidate,v_client,v_work.contract_id,v_revision.physical_timesheet_id,v_work.current_revision_id,
    v_revision.source_pay_channel,v_target,v_work.week_ending_date,coalesce(v_complete,false),v_projection,v_financial,v_metadata.metadata_version,
    case when v_complete then 'CURRENT' when v_work.approval_state='APPROVED' then 'PROCESSING' else 'UNAVAILABLE' end)
  on conflict(group_key) do update set client_id=excluded.client_id,contract_id=excluded.contract_id,
    physical_timesheet_id=excluded.physical_timesheet_id,current_revision_id=excluded.current_revision_id,
    source_pay_channel=excluded.source_pay_channel,target_pay_channel=excluded.target_pay_channel,week_ending_date=excluded.week_ending_date,
    complete=excluded.complete,dirty=false,projection_revision=excluded.projection_revision,financial_view_revision=excluded.financial_view_revision,
    metadata_version=excluded.metadata_version,progress_state=excluded.progress_state,error_code=null,updated_at_utc=transaction_timestamp();
  v_sunday:=v_today+(7-extract(isodow from v_today)::integer);
  select last_sequence into strict v_sequence from private.bpay_next_command_clock where id=1;
  if v_work.approval_state='WITHDRAWN' then
    -- Native retained positions supply A/C/H directly. No zero revision, job,
    -- debt, current residual offer, segment repricing or Case mutation here.
    for v_member in select p.component_key,p.approved_source_ex_vat approved_amount,
      p.realised_source_ex_vat realised_amount,p.held_source_ex_vat held_amount,p.source_basis_channel,
      a.id approved_line_id,a.component_kind,a.tax_treatment,a.work_date,a.approved_quantity,a.unit_label
      from private.bpay_next_position p left join private.bpay_next_approved_line a
        on a.revision_id=v_revision.id and a.component_key=p.component_key
      where p.work_id=v_work.id and v_withdrawn_complete and (p.applied_revision_id=v_work.applied_revision_id
        or p.approved_source_ex_vat<>0 or p.realised_source_ex_vat<>0 or p.held_source_ex_vat<>0
        or p.realised_target_ex_vat<>0 or p.realised_target_vat<>0 or p.realised_target_inc_vat<>0
        or p.held_target_ex_vat<>0 or p.held_target_vat<>0 or p.held_target_inc_vat<>0) order by p.component_key loop
      v_count:=v_count+1;v_item:=null;v_item.id:=gen_random_uuid();v_item.group_key:=v_group;v_item.candidate_id:=v_candidate;
      v_item.work_id:=v_work.id;v_item.revision_id:=v_revision.id;v_item.approved_line_id:=v_member.approved_line_id;
      v_item.component_key:=v_member.component_key;v_item.member_kind:='WORK_COMPONENT';v_item.member_key:=v_member.component_key;
      v_item.portion_kind:='WITHDRAWN';v_item.direction:='INFORMATIONAL';v_item.payroll_stage:='GROSS_ADD';
      v_item.client_id:=v_client;v_item.contract_id:=v_work.contract_id;v_item.physical_timesheet_id:=v_revision.physical_timesheet_id;
      v_item.week_ending_date:=v_work.week_ending_date;v_item.work_date:=v_member.work_date;
      v_item.candidate_display_name:=v_metadata.candidate_sort_name;v_item.candidate_reference:=v_metadata.tms_ref;
      v_item.client_display_name:=v_revision.client_display_name;v_item.timesheet_reference:=v_revision.timesheet_reference;
      v_item.component_kind:=v_member.component_kind;v_item.tax_treatment:=v_member.tax_treatment;
      v_item.approved_quantity:=v_member.approved_quantity;v_item.unit_label:=v_member.unit_label;
      v_item.source_pay_channel:=v_member.source_basis_channel;v_item.target_pay_channel:=v_target;
      v_item.amount_known:=true;v_item.nominal_source_ex_vat:=v_member.approved_amount;v_item.approved_source_ex_vat:=v_member.approved_amount;
      v_item.realised_source_ex_vat:=v_member.realised_amount;v_item.active_reserved_source_ex_vat:=v_member.held_amount;
      v_item.residual_source_ex_vat:=v_member.approved_amount-v_member.realised_amount-v_member.held_amount;
      v_item.gross_due_source_ex_vat:=0;v_item.included_source_ex_vat:=0;v_item.excluded_source_ex_vat:=0;
      v_item.recovery_source_ex_vat:=0;v_item.held_overhang_source_ex_vat:=0;v_item.written_off_source_ex_vat:=0;
      v_item.section:=case when v_wait_after then 'ACTION' else 'BLOCKED' end;
      v_item.reason_code:=case when v_wait_after then 'AWAITING_REAUTHORISATION' else 'APPROVAL_WITHDRAWN' end;
      v_item.reason_priority:=case when v_wait_after then 70 else 20 end;v_item.selectable:=false;
      v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.query_qualified:=false;v_item.query_state:='NOT_APPLICABLE';
      v_item.financial_view_revision:=v_financial;v_item.projection_revision:=v_projection;v_item.metadata_version:=v_metadata.metadata_version;
      v_item.progress_state:='CURRENT';v_item.updated_at_utc:=transaction_timestamp();
      insert into private.bpay_next_workbench_item select (v_item).*;
      select b.* into v_manual from private.bpay_next_work_collection b where b.work_id=v_work.id
        and b.component_key=v_member.component_key and b.collection_mode='MANUAL' and b.case_id is null
        and b.observed_revision_id=v_revision.id and b.manual_outstanding_source_ex_vat>0;
      if v_manual.id is not null and coalesce((private.bpay_next_work_collection_observation_v1(
          v_work.id,v_manual.component_key,v_revision.id)->>'complete')::boolean,false) then
        -- The native WITHDRAWN row above alone owns A/C/H and the WAIT marker.
        v_count:=v_count+1;v_item.id:=gen_random_uuid();v_item.portion_kind:='AVAILABLE';
        v_item.nominal_source_ex_vat:=v_manual.manual_outstanding_source_ex_vat;
        v_item.approved_source_ex_vat:=0;v_item.realised_source_ex_vat:=0;v_item.active_reserved_source_ex_vat:=0;
        v_item.residual_source_ex_vat:=0;v_item.gross_due_source_ex_vat:=0;v_item.included_source_ex_vat:=0;
        v_item.excluded_source_ex_vat:=0;v_item.recovery_source_ex_vat:=0;v_item.held_overhang_source_ex_vat:=0;
        v_item.written_off_source_ex_vat:=0;v_item.deduction_balance_source_ex_vat:=0;
        v_item.section:='ACTION';v_item.reason_code:='MANUAL_COLLECTION';v_item.reason_priority:=81;
        select line.* into strict v_original_line from private.bpay_next_approved_line line where line.id=v_manual.original_approved_line_id;
        if v_item.component_kind is null then v_item.component_kind:=v_original_line.component_kind;end if;
        if v_item.tax_treatment is null then v_item.tax_treatment:=v_original_line.tax_treatment;end if;
        v_item.payroll_stage:=case v_item.tax_treatment when 'TAXABLE' then 'GROSS_DEDUCT' when 'NON_TAXABLE' then 'NET_DEDUCT' else null end;
        insert into private.bpay_next_workbench_item select (v_item).*;
      end if;
    end loop;
    update private.bpay_next_workbench_group set complete=v_count>0,certified_zero=false,
      progress_state=case when v_withdrawn_complete then 'CURRENT' when v_work.applied_revision_id is not null then 'PROCESSING' else 'UNAVAILABLE' end
      where group_key=v_group;
  else
  for v_member in select m.component_key,m.approved_line_id,m.approved_segment_id,m.segment_key,m.component_kind,m.tax_treatment,m.work_date,m.approved_quantity,m.unit_label,m.approved_amount,m.realised_amount,m.held_amount,m.source_pay_channel,m.parent_complete,m.segment_attribution_complete from private.bpay_next_workbench_work_members_v1(v_work.id,v_revision.id) m order by m.component_key,m.segment_key nulls first loop
    v_count:=v_count+1;v_item:=null;v_item.id:=gen_random_uuid();v_item.group_key:=v_group;v_item.candidate_id:=v_candidate;
    v_item.work_id:=v_work.id;v_item.revision_id:=v_revision.id;v_item.approved_line_id:=v_member.approved_line_id;
    v_item.approved_segment_id:=v_member.approved_segment_id;v_item.segment_key:=v_member.segment_key;
    v_item.component_key:=v_member.component_key;v_item.member_kind:=case when v_member.segment_key is null then 'WORK_COMPONENT' else 'WORK_SEGMENT' end;
    v_item.member_key:=coalesce(v_member.segment_key,v_member.component_key);v_item.client_id:=v_client;v_item.contract_id:=v_work.contract_id;
    v_item.physical_timesheet_id:=v_revision.physical_timesheet_id;v_item.work_date:=v_member.work_date;
    v_item.week_ending_date:=v_work.week_ending_date;v_item.candidate_display_name:=v_metadata.candidate_sort_name;
    v_item.candidate_reference:=v_metadata.tms_ref;v_item.client_display_name:=v_revision.client_display_name;
    v_item.timesheet_reference:=v_revision.timesheet_reference;v_item.component_kind:=v_member.component_kind;
    v_item.tax_treatment:=v_member.tax_treatment;v_item.source_pay_channel:=v_member.source_pay_channel;v_item.target_pay_channel:=v_target;
    v_item.direction:='PAYMENT';v_item.payroll_stage:='GROSS_ADD';v_item.approved_quantity:=v_member.approved_quantity;v_item.unit_label:=v_member.unit_label;
    v_item.amount_known:=coalesce(v_complete,false) and v_member.parent_complete and v_member.segment_attribution_complete;
    v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.query_qualified:=false;v_item.query_state:='NOT_APPLICABLE';
    v_item.financial_view_revision:=v_financial;v_item.projection_revision:=v_projection;v_item.metadata_version:=v_metadata.metadata_version;
    v_item.progress_state:=case when v_complete then 'CURRENT' else 'PROCESSING' end;v_item.updated_at_utc:=transaction_timestamp();
    v_reason:='READY';v_priority:=200;v_section:='READY';
    if v_revision.id is null or v_target is null or v_work.week_ending_date is null
      or extract(isodow from v_work.week_ending_date)<>7 then v_reason:='DATA_UNAVAILABLE';v_priority:=10;v_section:='BLOCKED';
    elsif v_work.approval_state<>'APPROVED' then v_reason:='MISSING_APPROVAL';v_priority:=21;v_section:='BLOCKED';
    elsif not v_complete then v_reason:='APPLY_PENDING';v_priority:=30;v_section:='BLOCKED';
    elsif not v_member.parent_complete then v_reason:='DATA_UNAVAILABLE';v_priority:=10;v_section:='BLOCKED';
    elsif not v_member.segment_attribution_complete then v_reason:='SEGMENT_CREDIT_ATTRIBUTION_UNAVAILABLE';v_priority:=12;v_section:='BLOCKED';end if;
    if v_item.amount_known then
      v_positive:=greatest(v_member.approved_amount-v_member.realised_amount-v_member.held_amount,0);
      v_recovery:=greatest(v_member.realised_amount-v_member.approved_amount,0);
      v_overhang:=greatest(v_member.held_amount-greatest(v_member.approved_amount-v_member.realised_amount,0),0);
      v_item.nominal_source_ex_vat:=v_positive;v_item.approved_source_ex_vat:=v_member.approved_amount;
      v_item.realised_source_ex_vat:=v_member.realised_amount;v_item.active_reserved_source_ex_vat:=0;
      v_item.written_off_source_ex_vat:=0;
      v_item.residual_source_ex_vat:=v_member.approved_amount-v_member.realised_amount-v_member.held_amount;
      v_item.gross_due_source_ex_vat:=v_positive;v_item.included_source_ex_vat:=v_positive;v_item.excluded_source_ex_vat:=0;
      v_item.recovery_source_ex_vat:=v_recovery;v_item.held_overhang_source_ex_vat:=v_overhang;
    else v_positive:=null;v_recovery:=null;v_overhang:=null;end if;
    select a.run_id,a.command_id,a.module_epoch,a.selected_source_ex_vat into v_accepted from private.bpay_next_workbench_accepted_work_v1(v_work.id,v_member.component_key,v_member.segment_key) a;
    if found then
      v_item.is_selected:=true;v_item.accepted_run_id:=v_accepted.run_id;v_item.accepted_command_id:=v_accepted.command_id;
      v_item.accepted_module_epoch:=v_accepted.module_epoch;v_item.selected_source_ex_vat:=v_accepted.selected_source_ex_vat;
      v_item.selected_amount_known:=v_accepted.selected_source_ex_vat is not null;
      if v_priority>50 then v_reason:='IN_PREPARATION';v_priority:=50;v_section:='WAITING';end if;
    end if;
    v_snooze:=private.bpay_next_snooze_at_cut_v1(v_work.id,v_revision.id,v_member.segment_key,v_member.component_key,v_sequence,v_today);
    if v_snooze is not null then
      v_item.snooze_id:=(v_snooze->>'id')::uuid;v_item.snooze_version:=(v_snooze->>'version')::bigint;
      v_item.snooze_scope:=v_snooze->>'scope_kind';v_item.snooze_until_date:=(v_snooze->>'until_date')::date;
      if v_positive>0 then v_item.excluded_source_ex_vat:=v_positive;v_item.included_source_ex_vat:=0;end if;
    elsif exists(select 1 from private.bpay_next_snooze s where s.work_id=v_work.id and s.active
      and (s.until_date is null or s.until_date>=v_today) and ((s.scope_kind='SEGMENT' and s.segment_key=v_member.segment_key)
        or s.scope_kind='WHOLE_TIMESHEET' or (s.scope_kind='EXPENSE_LINE' and s.component_key=v_member.component_key)
        or (s.scope_kind='EXPENSES_ALL' and v_member.component_kind in ('EXPENSE','MILEAGE')))) then
      v_item.stale_snooze_code:=case when v_member.segment_key is not null and v_member.approved_segment_id is null
        then 'SNOOZE_SEGMENT_STALE' else 'SNOOZE_BASIS_STALE' end;
    end if;
    if v_priority>100 and v_work.week_ending_date>v_sunday then
      v_reason:='FUTURE_WEEK';v_priority:=100;v_section:='WAITING';v_item.eligible_from_date:=v_work.week_ending_date-6;
    elsif v_priority>110 and v_snooze is not null and v_positive>0 then v_reason:='SNOOZED';v_priority:=110;v_section:='WAITING';end if;
    v_item.query_qualified:=coalesce(v_work.work_kind='SOURCE' and v_revision.source_kind in ('SOURCE','PROTECTED')
      and v_member.component_kind in ('WORK','PROTECTED_WORK') and v_source_event is not null
      and v_revision.physical_timesheet_id is not null and v_item.amount_known and v_item.included_source_ex_vat>0,false);
    if v_item.query_qualified then v_item.query_state:='UNAVAILABLE';end if;
    v_item.section:=v_section;v_item.reason_code:=v_reason;v_item.reason_priority:=v_priority;
    v_item.pay_hold:=coalesce(v_pay_hold.pay_on_hold,false);v_item.pay_hold_reason:=v_pay_hold.pay_on_hold_reason;
    v_item.selectable:=v_section='READY' and v_item.amount_known;v_base:=v_item;
    if not v_item.amount_known or v_positive>0 or (v_member.approved_amount=0 and v_member.realised_amount=0
      and v_member.held_amount=0 and v_revision.certified_zero and v_member.approved_line_id is not null) then
      v_item.portion_kind:=case when not v_item.amount_known then 'EVIDENCE' when v_positive=0 then 'ZERO' else 'AVAILABLE' end;
      -- WB40: only a new positive offer is blocked. The saved v_base keeps
      -- native H/R and accepted Draft selection untouched (owner E1/E3).
      if not v_item.is_selected and not v_hold_canonical and v_item.reason_priority>15 then
        v_item.reason_code:='DATA_UNAVAILABLE';v_item.reason_priority:=15;v_item.section:='BLOCKED';
      elsif not v_item.is_selected and v_item.pay_hold and v_item.reason_priority>40 then
        v_item.reason_code:='PAY_ON_HOLD';v_item.reason_priority:=40;v_item.section:='BLOCKED';
      end if;
      v_item.selectable:=v_item.section='READY' and v_item.amount_known;
      -- WB-07: query classification belongs only to this new positive portion.
      -- The original pre-query v_base/v_priority remain unchanged for H/R.
      if v_item.query_qualified and v_item.portion_kind='AVAILABLE' then
        if not v_query_loaded then
          v_query_gate:=null;v_query_state:='UNAVAILABLE';
          begin
            v_query_gate:=private.weekly_source_pay_query_gate_v1(v_revision.physical_timesheet_id);
          exception when others then
            v_query_gate:=null;
          end;
          v_query_loaded:=true;
          -- Guard object types separately: malformed scalar replies cannot
          -- reach the object-minus-keys operators or escape the unavailable path.
          if jsonb_typeof(v_query_gate)='object' then
            if (v_query_gate ?& array['ok','code','scope','blocked','query_state_sha256']
                and v_query_gate-array['ok','code','scope','blocked','query_state_sha256']='{}'::jsonb
                and v_query_gate->'ok'='true'::jsonb and v_query_gate->>'code'='OK'
                and jsonb_typeof(v_query_gate->'code')='string'
                and jsonb_typeof(v_query_gate->'blocked')='boolean'
                and jsonb_typeof(v_query_gate->'query_state_sha256')='string'
                and v_query_gate->>'query_state_sha256' ~ '^[0-9a-f]{64}$') is true then
              v_query_scope:=v_query_gate->'scope';
              if jsonb_typeof(v_query_scope)='object' then
                if (v_query_scope ?& array['root_timesheet_id','family_booking_id','target_family_id',
                    'candidate_id','client_id','contract_id','week_ending_date','root_version','family_bound_version']
                    and v_query_scope-array['root_timesheet_id','family_booking_id','target_family_id',
                      'candidate_id','client_id','contract_id','week_ending_date','root_version','family_bound_version']='{}'::jsonb
                    and v_query_scope->'root_timesheet_id'=to_jsonb(v_revision.physical_timesheet_id::text)
                    and v_query_scope->'family_booking_id'=to_jsonb(v_work.booking_id)
                    and v_query_scope->'candidate_id'=to_jsonb(v_work.candidate_id::text)
                    and v_query_scope->'client_id'=to_jsonb(v_client::text)
                    and v_query_scope->'contract_id'=to_jsonb(v_work.contract_id::text)
                    and v_query_scope->'week_ending_date'=to_jsonb(v_work.week_ending_date::text)
                    and v_query_scope->'root_version'=to_jsonb(v_revision.physical_timesheet_version::text)
                    and ((v_query_scope->'target_family_id'='null'::jsonb
                        and v_query_scope->'family_bound_version'='null'::jsonb)
                      or (jsonb_typeof(v_query_scope->'target_family_id')='string'
                        and v_query_scope->>'target_family_id' ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
                        and jsonb_typeof(v_query_scope->'family_bound_version')='string'
                        and v_query_scope->>'family_bound_version' ~ '^[1-9][0-9]{0,18}$'
                        and (char_length(v_query_scope->>'family_bound_version')<19
                          or (v_query_scope->>'family_bound_version') collate "C"<='9223372036854775807' collate "C")))) is true then
                  v_query_state:=case when v_query_gate->'blocked'='true'::jsonb then 'OPEN' else 'CLEAR' end;
                  v_query_exclusions:=private.bpay_next_source_query_segment_exclusions_v1(v_revision.id,v_query_gate);
                end if;
              end if;
            end if;
          end if;
        end if;
        v_segment_query_state:=v_query_state;
        if v_query_state='OPEN' and v_query_exclusions is not null and v_member.segment_key is not null then
          v_segment_query_state:=case when exists(select 1 from jsonb_array_elements(v_query_exclusions) reason(value)
            where reason.value->>'segment_key'=v_member.segment_key) then 'OPEN' else 'CLEAR' end;
        end if;
        v_item.query_state:=v_segment_query_state;
        if v_segment_query_state='UNAVAILABLE' and v_item.reason_priority>60 then
          v_item.reason_code:='PAY_QUERY_UNAVAILABLE';v_item.reason_priority:=60;v_item.section:='BLOCKED';
        elsif v_segment_query_state='OPEN' and v_item.reason_priority>61 then
          v_item.reason_code:='PAY_QUERY_OPEN';v_item.reason_priority:=61;v_item.section:='ACTION';
        end if;
        v_item.selectable:=v_item.section='READY' and v_item.amount_known;
      end if;
      -- A future positive portion only. Numeric priorities alone cannot
      -- supersede Future/Snoozed WAITING or any accepted/reserved history.
      if not v_item.is_selected and v_item.portion_kind='AVAILABLE' then
        if v_item.tax_treatment='TAXABLE' and v_item.component_kind in ('WORK','PROTECTED_WORK','ADDITIONAL','ADJUSTMENT')
          and v_item.source_pay_channel in ('PAYE','UMBRELLA') and v_target in ('PAYE','UMBRELLA')
          and v_item.source_pay_channel<>v_target then
          v_item.channel_note_code:='CHANNEL_RESOLVER';
        end if;
        if v_item.section='READY' and v_item.amount_known and v_item.included_source_ex_vat>0
          and v_item.tax_treatment='TAXABLE' and v_need_operation is not null then
          v_resolution_need:=private.bpay_next_component_resolution_need_v1(v_work.id,v_revision.id,
            v_member.approved_line_id,v_member.approved_segment_id,v_target,v_target_umbrella,v_target_vat,v_resolution_date);
          if v_resolution_need is not null then
            v_item.reason_code:=v_resolution_need->>'reason_code';v_item.reason_priority:=75;
            v_item.channel_note_code:='CHANNEL_RESOLUTION_REQUIRED';v_item.section:='ACTION';v_item.selectable:=false;
          end if;
        end if;
      end if;
      insert into private.bpay_next_workbench_item select (v_item).*;
    elsif v_recovery>0 then
      v_item.portion_kind:='RECOVERY';v_item.direction:='INFORMATIONAL';v_item.selectable:=false;
      select b.* into v_manual from private.bpay_next_work_collection b where b.work_id=v_work.id
        and b.component_key=v_member.component_key and b.collection_mode='MANUAL'
        and b.observed_revision_id=v_revision.id;
      if v_manual.id is not null then
        v_item.section:='ACTION';v_item.reason_priority:=81;
        -- This informational liability never borrows a frozen accepted offer.
        v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.selected_source_ex_vat:=null;
        v_item.accepted_run_id:=null;v_item.accepted_command_id:=null;v_item.accepted_module_epoch:=null;
        v_item.reason_code:=case when v_manual.case_id is not null then 'MANUAL_COLLECTION_REFERENCE'
          when v_manual.manual_outstanding_source_ex_vat is null then 'MANUAL_COLLECTION_UNAVAILABLE' else 'MANUAL_COLLECTION' end;
        v_item.nominal_source_ex_vat:=case when v_manual.case_id is not null then 0 else v_recovery end;
        if v_item.component_kind is null then
          select line.* into strict v_original_line from private.bpay_next_approved_line line where line.id=v_manual.original_approved_line_id;
          v_item.component_kind:=v_original_line.component_kind;v_item.tax_treatment:=v_original_line.tax_treatment;
        end if;
        v_item.payroll_stage:=case v_item.tax_treatment when 'TAXABLE' then 'GROSS_DEDUCT' when 'NON_TAXABLE' then 'NET_DEDUCT' else null end;
      elsif v_priority>83 then v_item.reason_code:='RECOVERY_MANAGED';v_item.reason_priority:=83;v_item.section:='ACTION';end if;
      insert into private.bpay_next_workbench_item select (v_item).*;
    end if;
    if v_item.amount_known and v_member.held_amount>0 then
      v_item:=v_base;v_item.id:=gen_random_uuid();v_item.portion_kind:='RESERVED';v_item.selectable:=false;
      v_item.active_reserved_source_ex_vat:=v_member.held_amount;v_item.nominal_source_ex_vat:=v_member.held_amount;
      v_item.gross_due_source_ex_vat:=0;v_item.included_source_ex_vat:=0;v_item.excluded_source_ex_vat:=0;
      v_item.recovery_source_ex_vat:=0;v_item.query_qualified:=false;v_item.query_state:='NOT_APPLICABLE';
      if v_positive>0 or v_recovery>0 then
        v_item.approved_source_ex_vat:=0;v_item.realised_source_ex_vat:=0;v_item.residual_source_ex_vat:=0;v_item.held_overhang_source_ex_vat:=0;
        v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.selected_source_ex_vat:=null;
      end if;
      if v_priority>111 then v_item.reason_code:='RESERVED';v_item.reason_priority:=111;v_item.section:='WAITING';end if;
      insert into private.bpay_next_workbench_item select (v_item).*;
    end if;
    if v_base.amount_known and (v_positive>0 or v_recovery>0 or v_member.held_amount>0
      or (v_member.approved_amount=0 and v_member.realised_amount=0 and v_revision.certified_zero and v_member.approved_line_id is not null)) then
      select sum(i.approved_source_ex_vat) a,sum(i.realised_source_ex_vat) c,sum(i.active_reserved_source_ex_vat) h,
        sum(i.residual_source_ex_vat) residual,
        sum(i.included_source_ex_vat+i.excluded_source_ex_vat-i.recovery_source_ex_vat-i.held_overhang_source_ex_vat) split_residual
        into v_totals from private.bpay_next_workbench_item i where i.group_key=v_group
          and i.component_key=v_member.component_key and i.member_kind=v_base.member_kind and i.member_key=v_base.member_key;
      if (v_totals.a,v_totals.c,v_totals.h,v_totals.residual,v_totals.split_residual)
        is distinct from (v_member.approved_amount,v_member.realised_amount,v_member.held_amount,
          v_member.approved_amount-v_member.realised_amount-v_member.held_amount,
          v_member.approved_amount-v_member.realised_amount-v_member.held_amount) then
        raise exception using errcode='23514',message='BPAY_NEXT_WORKBENCH_NATIVE_MEMBER_NOT_CONSERVED';end if;
    end if;
  end loop;
  end if;
  -- A known retained manual liability is independent of unavailable positive
  -- Source classification. Keep that Evidence; never certify a new offer.
  update private.bpay_next_workbench_item i set reason_code='MANUAL_COLLECTION_UNAVAILABLE'
    from private.bpay_next_work_collection b where i.group_key=v_group and i.work_id=b.work_id
      and i.component_key=b.component_key and i.portion_kind='EVIDENCE' and not i.amount_known
      and not i.is_selected and b.collection_mode='MANUAL' and b.case_id is null
      and b.observed_revision_id=v_revision.id and b.manual_outstanding_source_ex_vat is null;
  if v_work.approval_state='APPROVED' and v_work.current_revision_id=v_work.applied_revision_id then
    for v_manual in select b.* from private.bpay_next_work_collection b where b.work_id=v_work.id
      and b.collection_mode='MANUAL' and b.case_id is null and b.observed_revision_id=v_revision.id
      and b.manual_outstanding_source_ex_vat>0 and not exists(select 1 from private.bpay_next_workbench_item i
        where i.group_key=v_group and i.component_key=b.component_key and i.amount_known) order by b.component_key loop
      v_manual_observation:=private.bpay_next_work_collection_observation_v1(v_work.id,v_manual.component_key,v_revision.id);
      if not coalesce((v_manual_observation->>'complete')::boolean,false) then continue;end if;
      select pos.* into strict v_manual_position from private.bpay_next_position pos where pos.work_id=v_work.id and pos.component_key=v_manual.component_key;
      select line.* into strict v_original_line from private.bpay_next_approved_line line where line.id=v_manual.original_approved_line_id;
      v_count:=v_count+1;v_item:=null;v_item.id:=gen_random_uuid();v_item.group_key:=v_group;v_item.candidate_id:=v_candidate;
      v_item.work_id:=v_work.id;v_item.revision_id:=v_revision.id;v_item.component_key:=v_manual.component_key;
      v_item.member_kind:='WORK_COMPONENT';v_item.member_key:=v_manual.component_key;v_item.portion_kind:='RECOVERY';
      v_item.direction:='INFORMATIONAL';v_item.payroll_stage:=case v_original_line.tax_treatment when 'TAXABLE' then 'GROSS_DEDUCT' when 'NON_TAXABLE' then 'NET_DEDUCT' else null end;
      v_item.client_id:=v_client;v_item.contract_id:=v_work.contract_id;v_item.physical_timesheet_id:=v_revision.physical_timesheet_id;
      v_item.week_ending_date:=v_work.week_ending_date;v_item.work_date:=v_original_line.work_date;
      v_item.candidate_display_name:=v_metadata.candidate_sort_name;v_item.candidate_reference:=v_metadata.tms_ref;
      v_item.client_display_name:=v_revision.client_display_name;v_item.timesheet_reference:=v_revision.timesheet_reference;
      v_item.component_kind:=v_original_line.component_kind;v_item.tax_treatment:=v_original_line.tax_treatment;
      v_item.source_pay_channel:=v_manual.original_source_pay_channel;v_item.target_pay_channel:=v_target;
      v_item.amount_known:=true;v_item.nominal_source_ex_vat:=v_manual.manual_outstanding_source_ex_vat;
      v_item.approved_source_ex_vat:=v_manual_position.approved_source_ex_vat;v_item.realised_source_ex_vat:=v_manual_position.realised_source_ex_vat;
      v_item.active_reserved_source_ex_vat:=v_manual_position.held_source_ex_vat;
      v_item.residual_source_ex_vat:=v_manual_position.approved_source_ex_vat-v_manual_position.realised_source_ex_vat-v_manual_position.held_source_ex_vat;
      v_item.gross_due_source_ex_vat:=(v_manual_observation->>'positive_source_ex_vat')::numeric;
      v_item.included_source_ex_vat:=0;v_item.excluded_source_ex_vat:=v_item.gross_due_source_ex_vat;
      v_item.recovery_source_ex_vat:=(v_manual_observation->>'negative_source_ex_vat')::numeric;
      v_item.held_overhang_source_ex_vat:=(v_manual_observation->>'held_overhang_source_ex_vat')::numeric;v_item.written_off_source_ex_vat:=0;
      v_item.section:='ACTION';v_item.reason_code:='MANUAL_COLLECTION';v_item.reason_priority:=81;v_item.selectable:=false;
      v_item.is_selected:=false;v_item.selected_amount_known:=false;v_item.query_qualified:=false;v_item.query_state:='NOT_APPLICABLE';
      v_item.financial_view_revision:=v_financial;v_item.projection_revision:=v_projection;v_item.metadata_version:=v_metadata.metadata_version;
      v_item.progress_state:='CURRENT';v_item.updated_at_utc:=transaction_timestamp();
      if v_item.included_source_ex_vat+v_item.excluded_source_ex_vat-v_item.recovery_source_ex_vat-v_item.held_overhang_source_ex_vat
        is distinct from v_item.residual_source_ex_vat then raise exception using errcode='23514',message='BPAY_NEXT_COLLECTION_MANUAL_DISPLAY_NOT_CONSERVED';end if;
      insert into private.bpay_next_workbench_item select (v_item).*;
    end loop;
  end if;
  if v_count=0 then
    v_item:=null;v_item.id:=gen_random_uuid();v_item.group_key:=v_group;v_item.candidate_id:=v_candidate;v_item.work_id:=v_work.id;
    v_item.revision_id:=v_revision.id;v_item.member_kind:='GROUP_EVIDENCE';v_item.member_key:=v_work.id::text;v_item.component_key:='';v_item.portion_kind:='EVIDENCE';
    v_item.client_id:=v_client;v_item.contract_id:=v_work.contract_id;v_item.physical_timesheet_id:=v_revision.physical_timesheet_id;
    v_item.week_ending_date:=v_work.week_ending_date;v_item.candidate_display_name:=v_metadata.candidate_sort_name;v_item.candidate_reference:=v_metadata.tms_ref;
    v_item.direction:='INFORMATIONAL';v_item.amount_known:=false;v_item.selected_amount_known:=false;v_item.is_selected:=false;v_item.selectable:=false;
    v_item.section:='BLOCKED';v_item.reason_code:=case when v_work.approval_state<>'APPROVED' then 'MISSING_APPROVAL' else 'DATA_UNAVAILABLE' end;
    if v_work.approval_state='WITHDRAWN' then
      v_item.reason_code:=case when v_wait_after then 'AWAITING_REAUTHORISATION' else 'APPROVAL_WITHDRAWN' end;
      v_item.section:=case when v_wait_after then 'ACTION' else 'BLOCKED' end;
    end if;
    v_item.reason_priority:=case when v_work.approval_state='WITHDRAWN' then case when v_wait_after then 70 else 20 end
      when v_work.approval_state<>'APPROVED' then 21 else 10 end;v_item.query_state:='NOT_APPLICABLE';v_item.query_qualified:=false;
    v_item.financial_view_revision:=v_financial;v_item.projection_revision:=v_projection;v_item.metadata_version:=v_metadata.metadata_version;
    v_item.progress_state:=case when v_work.approval_state='WITHDRAWN' and v_work.applied_revision_id is not null
      and not v_withdrawn_complete then 'PROCESSING' else 'UNAVAILABLE' end;
    v_item.updated_at_utc:=transaction_timestamp();v_item.target_pay_channel:=v_target;
    v_zero:=coalesce(v_complete,false) and v_revision.certified_zero and v_revision.approved_source_ex_vat=0
      and v_revision.expected_line_count=0 and v_target is not null and v_work.week_ending_date is not null
      and extract(isodow from v_work.week_ending_date)=7
      and not exists(select 1 from private.bpay_next_position p where p.work_id=v_work.id);
    if v_zero then
      v_item.section:='READY';v_item.reason_code:='CERTIFIED_ZERO';v_item.reason_priority:=200;v_item.progress_state:='CURRENT';
      if v_work.week_ending_date>v_sunday then
        v_item.section:='WAITING';v_item.reason_code:='FUTURE_WEEK';v_item.reason_priority:=100;v_item.eligible_from_date:=v_work.week_ending_date-6;
      end if;
    end if;
    insert into private.bpay_next_workbench_item select (v_item).*;
  end if;
  update private.bpay_next_workbench_group g set ready_count=x.ready,action_count=x.action,blocked_count=x.blocked,waiting_count=x.waiting,
    complete=g.complete and x.unknown=0,certified_zero=coalesce(v_complete,false) and coalesce(v_revision.certified_zero,false)
    from(select count(*) filter(where section='READY') ready,count(*) filter(where section='ACTION') action,
      count(*) filter(where section='BLOCKED') blocked,count(*) filter(where section='WAITING') waiting,
      count(*) filter(where not amount_known and not (member_kind='GROUP_EVIDENCE' and coalesce(v_zero,false))) unknown
      from private.bpay_next_workbench_item where group_key=v_group) x where g.group_key=v_group;
  update private.bpay_next_workbench_group g set stale_snooze_count=x.n,
    stale_snooze_code=case when x.n>0 then 'SNOOZE_SEGMENT_STALE' end
    from(select count(*) n from private.bpay_next_snooze s where s.work_id=v_work.id and s.scope_kind='SEGMENT'
      and s.active and (s.until_date is null or s.until_date>=v_today) and not exists(select 1
        from private.bpay_next_approved_segment a where a.revision_id=v_revision.id and a.segment_key=s.segment_key)) x
    where g.group_key=v_group;
  select array_agg(d) into v_after from private.bpay_next_workbench_group_contribution_v1(v_group) d;
  perform private.bpay_next_workbench_apply_delta_v1(v_before,v_after);
  perform private.bpay_next_workbench_refresh_group_display_v1(v_group);
end
$function$;

-- private.bpay_next_component_resolution_need_publish_v1(uuid,uuid); supabase/repeatable/12102026_2123_banking_pay_next_resolution_need_target_v1.sql; SHA256 b344fe628a54efdc97362ea38f9dc365f35612bafe7949b8d9628ea15ee4d7a5
create or replace function private.bpay_next_component_resolution_need_publish_v1(
 p_operation_id uuid,p_work_id uuid default null
) returns void language plpgsql volatile security invoker set search_path=pg_catalog,private
as $function$
declare r private.bpay_next_pay_method_change_receipt%rowtype;n record;v_count integer:=0;
begin
 if p_operation_id is null then raise exception using errcode='22023',message='BPAY_NEXT_RESOLUTION_NEED_INPUT_INVALID';end if;
 select x.* into r from private.bpay_next_pay_method_change_receipt x where x.operation_id=p_operation_id;
 if r.operation_id is null or r.affected_member_count>1000
  or(p_work_id is not null and not exists(select 1 from private.bpay_next_work w where w.id=p_work_id and w.candidate_id=r.candidate_id)) then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_NEED_IDENTITY_CHANGED';end if;
 -- The original envelope is <=1000 members, each with <=5 native Standard
 -- buckets or one nonbucket code. Overflow fails the whole transaction.
 for n in
  select m.member_key,m.work_id,m.candidate_id,m.revision_id,a.id approved_line_id,
   bucket.rate_family,bucket.rate_code
  from private.bpay_next_pay_method_change_member m
  join private.bpay_next_approved_line a on a.revision_id=m.revision_id
   and a.id=m.approved_line_id and a.tax_treatment='TAXABLE'
  left join private.bpay_next_approved_segment s on s.revision_id=m.revision_id
   and s.id=m.approved_segment_id and s.approved_line_id=a.id
  cross join lateral (
   select 'STANDARD'::text rate_family,d.bucket rate_code
    from private.bpay_next_rate_detail d where d.approved_line_id=a.id
     and a.component_kind in ('WORK','PROTECTED_WORK') and d.approved_hours>0
     and(m.approved_segment_id is null or case d.bucket when 'DAY' then s.hours_day
      when 'NIGHT' then s.hours_night when 'SAT' then s.hours_sat when 'SUN' then s.hours_sun
      when 'BH' then s.hours_bh end>0)
   union all
   select 'ADDITIONAL',substring(a.component_key from 12)
    where a.component_kind='ADDITIONAL' and a.component_key like 'ADDITIONAL:%'
   union all select 'ADJUSTMENT',a.component_key where a.component_kind='ADJUSTMENT'
  ) bucket
  where m.operation_id=r.operation_id and m.member_kind='WORK' and m.classification='NEEDS_DECISION'
   and m.candidate_id=r.candidate_id and(p_work_id is null or m.work_id=p_work_id)
  order by m.member_key,a.id,bucket.rate_family,bucket.rate_code limit 5001
 loop
  v_count:=v_count+1;
  if v_count>5000 then raise exception using errcode='54000',message='BPAY_NEXT_RESOLUTION_NEED_SCOPE_TOO_LARGE';end if;
  insert into private.bpay_next_component_resolution_event(event_kind,work_id,candidate_id,revision_id,approved_line_id,
   rate_family,rate_code,need_operation_id,need_member_key,need_version,actor_user_id,reason)
  values('NEED',n.work_id,n.candidate_id,n.revision_id,n.approved_line_id,n.rate_family,n.rate_code,
   r.operation_id,n.member_key,r.post_metadata_version,r.actor_user_id,'PAY_METHOD_CHANGED')
  on conflict(need_operation_id,need_member_key,approved_line_id,rate_family,rate_code,need_version)
   where event_kind='NEED' do nothing;
 end loop;
end
$function$;

-- private.bpay_next_snooze_at_cut_v1(uuid,uuid,text,text,bigint,date); supabase/repeatable/10102026_1100_banking_pay_next_snooze_v1.sql; SHA256 40fa068e6c27d9d3cfefe620576efe972b5fa30a16c2dbfe27d2c47a0e19ed40
create or replace function private.bpay_next_snooze_at_cut_v1(
  p_work_id uuid,p_revision_id uuid,p_segment_key text,p_component_key text,p_sequence bigint,p_business_date date)
returns jsonb language sql stable security invoker set search_path=pg_catalog,private
as $function$
  select e.after_state from private.bpay_next_snooze s
  join lateral(select ev.after_state from private.bpay_next_snooze_event ev
    where ev.snooze_id=s.id and ev.control_sequence<=p_sequence order by ev.control_sequence desc limit 1) e on true
  join private.bpay_next_approved_line a on a.revision_id=p_revision_id and a.component_key=p_component_key
  left join private.bpay_next_approved_segment seg on seg.revision_id=p_revision_id and seg.segment_key=p_segment_key and seg.component_key=a.component_key
  join private.bpay_next_revision_worker_basis b on b.revision_id=p_revision_id
  where s.work_id=p_work_id and (e.after_state->>'active')::boolean
    and ((e.after_state->>'until_date') is null or (e.after_state->>'until_date')::date>=p_business_date)
    and ((s.scope_kind='WHOLE_TIMESHEET' and (e.after_state->>'worker_pay_basis')::bytea=b.whole_basis)
      or (s.scope_kind='SEGMENT' and s.segment_key=p_segment_key
        and (e.after_state->>'worker_pay_basis')::bytea=private.bpay_next_segment_pay_basis_v1(seg.id))
      or (s.scope_kind='EXPENSES_ALL' and a.component_kind in ('EXPENSE','MILEAGE')
        and (e.after_state->>'worker_pay_basis')::bytea=b.expense_basis)
      or (s.scope_kind='EXPENSE_LINE' and s.component_key=p_component_key
        and (e.after_state->>'worker_pay_basis')::bytea=private.bpay_next_line_pay_basis_v1(a.id)))
  order by (e.after_state->>'until_date') is null desc,s.scope_kind,s.id limit 1
$function$;

-- private.bpay_next_line_pay_basis_v1(uuid); supabase/repeatable/10102026_1236_banking_pay_next_segment_authority_final_v1.sql; SHA256 818c2abd303df43114907cafaff5294e1d2dbc03e122a55f12a751d56be16f09
create or replace function private.bpay_next_line_pay_basis_v1(p_line_id uuid)
returns bytea language sql stable security invoker set search_path=pg_catalog,private
as $function$
  select pg_catalog.sha256(pg_catalog.convert_to(jsonb_build_array(r.work_id,a.component_key,
    r.source_pay_channel,r.source_umbrella_id,a.component_kind,
    a.tax_treatment,a.approved_quantity,case when a.approved_quantity<>0 then a.approved_unit_rate end,a.source_pay_ex_vat,
    coalesce((select jsonb_agg(jsonb_build_array(d.bucket,d.approved_hours,
      case when d.approved_hours<>0 then d.source_pay_rate end) order by d.bucket)
      from private.bpay_next_rate_detail d where d.approved_line_id=a.id),'[]'::jsonb))::text,'UTF8'))
  from private.bpay_next_approved_line a join private.bpay_next_work_revision r on r.id=a.revision_id
  where a.id=p_line_id
$function$;

-- private.bpay_next_segment_pay_basis_v1(uuid); supabase/repeatable/10102026_1236_banking_pay_next_segment_authority_final_v1.sql; SHA256 243d62acde0d820d4724dd7eb3391affa26e607bf4d58b13b287933084ae366c
create or replace function private.bpay_next_segment_pay_basis_v1(p_segment_id uuid)
returns bytea language sql stable security invoker set search_path=pg_catalog,private
as $function$
  select pg_catalog.sha256(pg_catalog.convert_to(jsonb_build_array(r.work_id,s.segment_key,
    s.component_key,r.source_pay_channel,r.source_umbrella_id,
    a.tax_treatment,s.pay_excluded,s.approved_hours,s.hours_day,s.hours_night,s.hours_sat,s.hours_sun,s.hours_bh,
    case when not s.pay_excluded and s.hours_day<>0 then s.pay_day end,
    case when not s.pay_excluded and s.hours_night<>0 then s.pay_night end,
    case when not s.pay_excluded and s.hours_sat<>0 then s.pay_sat end,
    case when not s.pay_excluded and s.hours_sun<>0 then s.pay_sun end,
    case when not s.pay_excluded and s.hours_bh<>0 then s.pay_bh end,
    s.approved_source_ex_vat)::text,'UTF8'))
  from private.bpay_next_approved_segment s
  join private.bpay_next_approved_line a on a.id=s.approved_line_id
  join private.bpay_next_work_revision r on r.id=s.revision_id where s.id=p_segment_id
$function$;

-- private.bpay_next_source_query_segment_exclusions_v1(uuid,jsonb); supabase/repeatable/11102026_2223_banking_pay_next_shift_query_exclusion_v1.sql; SHA256 f00b841fd02c29101e5fa8e6249428d98d09f7da5e05551e5c8cf799d8e624f5
create or replace function private.bpay_next_source_query_segment_exclusions_v1(p_revision_id uuid,p_gate jsonb)
returns jsonb language plpgsql stable security invoker set search_path=pg_catalog,private,public
as $function$
declare v_revision private.bpay_next_work_revision%rowtype;v_work private.bpay_next_work%rowtype;
 v_facts jsonb;v_item jsonb;v_result jsonb:='[]'::jsonb;v_key text;v_reason text;
begin
 select revision.* into v_revision from private.bpay_next_work_revision revision where id=p_revision_id;
 if not found or v_revision.source_kind not in ('SOURCE','PROTECTED') then return null;end if;
 select work.* into strict v_work from private.bpay_next_work work where id=v_revision.work_id;
 if p_gate->'ok' is distinct from 'true'::jsonb or p_gate->>'code' is distinct from 'OK'
  or jsonb_typeof(p_gate->'blocked') is distinct from 'boolean' then return null;end if;
 v_facts:=private.weekly_source_pay_query_facts_v1(v_revision.physical_timesheet_id);
 if v_facts->'ok' is distinct from 'true'::jsonb or v_facts->>'code' is distinct from 'OK'
  or (v_facts->'scope',v_facts->'blocked',v_facts->'query_state_sha256')
     is distinct from (p_gate->'scope',p_gate->'blocked',p_gate->'query_state_sha256')
  or jsonb_typeof(v_facts->'hours_incidents') is distinct from 'array'
  or jsonb_typeof(v_facts->'manual_reviews') is distinct from 'array'
  or v_facts#>>'{scope,root_timesheet_id}' is distinct from v_revision.physical_timesheet_id::text
  or v_facts#>>'{scope,root_version}' is distinct from v_revision.physical_timesheet_version::text
  or v_facts#>>'{scope,candidate_id}' is distinct from v_work.candidate_id::text
  or v_facts#>>'{scope,contract_id}' is distinct from v_work.contract_id::text
  or v_facts#>>'{scope,week_ending_date}' is distinct from v_work.week_ending_date::text
  or v_facts#>>'{scope,family_booking_id}' is distinct from v_work.booking_id then return null;end if;
 -- A free-text manual reason cannot be guessed to mean hours differ.
 -- It must have the actual same-event current typed hours-difference incident.
 for v_item in select value from jsonb_array_elements(v_facts->'manual_reviews') loop
  if not exists(select 1 from jsonb_array_elements(v_facts->'hours_incidents') i(value)
   where i.value->>'work_event_id'=v_item->>'work_event_id'
    and i.value->>'source_group_id'=v_item->>'source_group_id'
    and i.value->>'candidate_id'=v_item->>'candidate_id'
    and i.value->>'client_id'=v_item->>'client_id'
    and i.value->>'comparison_contract_id'=v_item->>'contract_id'
    and i.value->>'issue_family'='SOURCE_HOURS_DIFFER') then return null;end if;
 end loop;
 for v_item in select value from jsonb_array_elements(v_facts->'hours_incidents') loop
  v_reason:=v_item->>'issue_family';
  if v_reason='CANDIDATE_TIMESHEET_MISSING' then continue;end if;
  if v_item->'latest_qualified_exception' is distinct from 'null'::jsonb
    and not exists(select 1 from jsonb_array_elements(v_facts->'manual_reviews') m(value)
      where m.value->>'work_event_id'=v_item->>'work_event_id') then continue;end if;
  if v_reason not in ('HEALTHROSTER_NOT_FINALISED','SOURCE_MISSING_OR_NOT_AUTHORISED','SOURCE_HOURS_DIFFER')
    or v_reason is null then return null;end if;
  v_key:=v_item->>'work_event_id';
  if v_key is null or not exists(select 1 from private.bpay_next_approved_segment s
    where s.revision_id=p_revision_id and s.segment_key=v_key) then return null;end if;
  v_result:=v_result||jsonb_build_array(jsonb_build_object('segment_key',v_key,'reason',v_reason));
 end loop;
 if p_gate->'blocked'='true'::jsonb and jsonb_array_length(v_result)=0 then return null;end if;
 return (select coalesce(jsonb_agg(x.item order by x.item->>'segment_key',x.item->>'reason'),'[]'::jsonb)
  from (select distinct value item from jsonb_array_elements(v_result)) x);
end
$function$;

-- private.weekly_source_pay_query_c1_receipt_v1(uuid,uuid,uuid); supabase/repeatable/05102026_0245_weekly_source_pay_query_c1_receipt_v1.sql; SHA256 17bebf73d40a22ca9589c022573f92e7ee53e9a120d20a1d6c458fdbe84b4a61
create or replace function private.weekly_source_pay_query_c1_receipt_v1(
  p_root_timesheet_id uuid,p_approval_id uuid,p_generation_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_scope jsonb;
  v_approval public.weekly_exceptional_payment_approvals%rowtype;
  v_generation public.weekly_exceptional_pay_generations%rowtype;
  v_request public.weekly_exceptional_c1_publication_requests%rowtype;
  v_run public.weekly_exceptional_orchestration_runs%rowtype;
  v_event public.weekly_exceptional_pay_family_events%rowtype;
  v_checkpoint public.weekly_exceptional_c1_publication_checkpoints%rowtype;
  v_step public.weekly_exceptional_orchestration_steps%rowtype;
  v_publication_root public.timesheets%rowtype;
  v_publication_fin public.timesheets_financials%rowtype;
  v_after_hash bytea;
  v_count integer;
begin
  if p_root_timesheet_id is null or p_approval_id is null or p_generation_id is null then
    raise exception 'WEEKLY_SOURCE_PAY_QUERY_C1_RECEIPT_IDENTITY_REQUIRED' using errcode='22023'; end if;
  v_scope:=private.weekly_source_pay_query_scope_v1(p_root_timesheet_id);
  if v_scope is null or v_scope->>'target_family_id' is null then return null; end if;
  select a.* into v_approval from public.weekly_exceptional_payment_approvals a where a.id=p_approval_id;
  if not found or v_approval.withdrawn_at_utc is not null
     or v_approval.pay_target_family_id::text is distinct from v_scope->>'target_family_id'
     or v_approval.candidate_id::text is distinct from v_scope->>'candidate_id'
     or v_approval.client_id::text is distinct from v_scope->>'client_id'
     or v_approval.contract_id::text is distinct from v_scope->>'contract_id'
     or to_char(v_approval.week_ending,'YYYY-MM-DD') is distinct from v_scope->>'week_ending_date'
     or v_approval.protected_work_date not between
       (v_scope->>'week_ending_date')::date-6 and (v_scope->>'week_ending_date')::date
     or not exists(select 1 from public.weekly_work_events e where e.id=v_approval.work_event_id
       and e.candidate_id=v_approval.candidate_id and e.client_id=v_approval.client_id
       and e.work_date=v_approval.protected_work_date) then return null; end if;
  select e.* into v_event from public.weekly_exceptional_pay_family_events e
    where e.family_id=v_approval.pay_target_family_id and e.durable_work_event_id=v_approval.work_event_id
    order by e.event_sequence desc limit 1;
  if not found or v_event.state is distinct from 'WAIT'
     or v_event.evidence_approval_id is distinct from v_approval.id
     or v_event.work_date is distinct from v_approval.protected_work_date then return null; end if;
  select g.* into v_generation from public.weekly_exceptional_pay_generations g
    where g.id=p_generation_id and g.family_id=v_approval.pay_target_family_id;
  if not found or v_generation.lifecycle_state not in ('PUBLISHED','SUPERSEDED')
     or v_generation.published_at_utc is null or not isfinite(v_generation.published_at_utc)
     or private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',
       v_generation.complete_next_vector_json) is distinct from v_generation.complete_next_vector_hash
     or v_generation.complete_next_vector_json->'target_snapshot' is distinct from v_approval.approved_target_pay_components_json
     or not exists(select 1 from public.weekly_exceptional_pay_target_events e
       where e.family_id=v_approval.pay_target_family_id and e.approval_id=v_approval.id
         and e.financial_generation_id=v_generation.id
         and e.complete_next_family_vector_fingerprint=v_generation.complete_next_vector_hash)
     or exists(select 1 from private.weekly_source_local_protected_decision_receipts r
       where r.generation_id=v_generation.id) then return null; end if;
  select count(*) into v_count from public.weekly_exceptional_c1_publication_requests r
    where r.generation_id=v_generation.id;
  if v_count<>1 then return null; end if;
  select r.* into v_request from public.weekly_exceptional_c1_publication_requests r
    where r.generation_id=v_generation.id;
  if v_request.family_id is distinct from v_approval.pay_target_family_id
     or v_request.orchestration_run_id is distinct from v_approval.creation_orchestration_run_id
     or v_request.candidate_id is distinct from v_approval.candidate_id
     or v_request.contract_id is distinct from v_approval.contract_id
     or v_request.week_ending_date is distinct from v_approval.week_ending
     or v_request.agency_id is distinct from (select f.agency_id
       from public.weekly_exceptional_pay_target_families f where f.id=v_approval.pay_target_family_id)
     or v_request.state is distinct from 'PUBLISHED' or v_request.completed_at_utc is null
     or not isfinite(v_request.completed_at_utc)
     or v_request.c1_publication_id is null or v_request.c1_head_revision is null or v_request.c1_head_revision<1
     or v_request.c1_receipt_sha256 is null
     or v_generation.result_hash is distinct from v_request.c1_receipt_sha256 then return null; end if;
  -- The request retains its genuine publication-time physical root. A later
  -- lawful rotation does not invalidate that accepted same raw booking family.
  -- Point-read the pinned rows; never rank arbitrary historical alternatives.
  select t.* into v_publication_root from public.timesheets t
    where t.timesheet_id=v_request.root_timesheet_id;
  if not found or v_publication_root.booking_id is distinct from v_scope->>'family_booking_id'
     or v_publication_root.contract_id is distinct from v_approval.contract_id
     or v_publication_root.week_ending_date is distinct from v_approval.week_ending
     or v_publication_root.sheet_scope is distinct from 'WEEKLY'
     or v_publication_root.line_type is distinct from 'HOURS'
     or v_publication_root.is_adjustment is distinct from false
     or v_publication_root.version is null or v_publication_root.version<1 then return null; end if;
  select f.* into v_publication_fin from public.timesheets_financials f
    where f.id=v_request.financial_row_id;
  if not found or v_publication_fin.timesheet_id is distinct from v_publication_root.timesheet_id
     or private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_SOURCE_PROPOSAL_V1',
       v_event.source_proposal_snapshot_json) is distinct from v_event.source_proposal_hash
     -- Financial and physical Timesheet versions are separate domains. Prove
     -- the original stage owner's fixed-source seal, not an invented equality.
     or private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_FIXED_SOURCE_STATE_V1',
       jsonb_build_object('source_cycle_id',v_approval.source_cycle_id,
         'comparison_revision_id',v_approval.comparison_revision_id,
         'final_revision_id',v_approval.final_revision_id,
         'source_proposal_hash',encode(v_event.source_proposal_hash,'hex'),
         'financial_row_id',v_publication_fin.id,
         'financial_timesheet_version',v_publication_fin.timesheet_version))
       is distinct from v_generation.fixed_target_source_state_fingerprint then return null; end if;
  select r.* into v_run from public.weekly_exceptional_orchestration_runs r where r.id=v_request.orchestration_run_id;
  if not found or v_run.family_id is distinct from v_approval.pay_target_family_id
     or v_run.requested_by_user_id is distinct from v_approval.approved_by_user_id
     or v_run.state is distinct from 'COMPLETE' or v_run.completed_at_utc is null
     or not isfinite(v_run.completed_at_utc)
     or v_run.after_state_fingerprint is distinct from v_request.c1_receipt_sha256 then return null; end if;
  select c.* into v_checkpoint from public.weekly_exceptional_c1_publication_checkpoints c
    where c.publication_request_id=v_request.id order by c.checkpoint_sequence desc limit 1;
  if not found or v_checkpoint.phase is distinct from 'PUBLISH'
     or upper(v_checkpoint.result_json->>'status') is distinct from 'PUBLISHED'
     or v_checkpoint.result_json->'has_more' is distinct from 'false'::jsonb
     or v_checkpoint.result_json is distinct from v_request.typed_result_json
     or (v_checkpoint.result_json->>'publication_id')::uuid is distinct from v_request.c1_publication_id
     or (v_checkpoint.result_json->>'head_revision')::bigint is distinct from v_request.c1_head_revision
     or private.weekly_exceptional_hex_sha256_v1(v_checkpoint.result_json->>'request_sha256')
       is distinct from v_request.request_sha256
     or private.weekly_exceptional_hex_sha256_v1(v_checkpoint.result_json->>'receipt_sha256')
       is distinct from v_request.c1_receipt_sha256
     or (v_request.c1_operation_id is not null
       and (v_checkpoint.result_json->>'operation_id')::uuid is distinct from v_request.c1_operation_id) then return null; end if;
  v_after_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_C1_COMPLETE_AFTER_V1',
    jsonb_build_object('family_id',v_request.family_id,'generation_id',v_generation.id,
      'target_vector_hash',encode(v_generation.complete_next_vector_hash,'hex'),
      'c1_publication_id',v_request.c1_publication_id,'c1_head_revision',v_request.c1_head_revision::text,
      'c1_receipt_sha256',encode(v_request.c1_receipt_sha256,'hex')));
  select count(*) into v_count from public.weekly_exceptional_orchestration_steps s
    where s.orchestration_run_id=v_run.id and s.step_kind='COMPLETE_C1_PUBLICATION';
  if v_count<>1 then return null; end if;
  select s.* into v_step from public.weekly_exceptional_orchestration_steps s
    where s.orchestration_run_id=v_run.id and s.step_kind='COMPLETE_C1_PUBLICATION';
  if v_step.outcome is distinct from 'COMPLETE' or v_step.completed_at_utc is null
     or not isfinite(v_step.completed_at_utc)
     or v_step.allowlisted_owner_name is distinct from 'C1.weekly_source_publish_c1'
     or v_step.allowlisted_owner_signature is distinct from 'sealed C1 V1'
     or v_step.bounded_request_hash is distinct from v_request.request_sha256
     or v_step.bounded_owner_response_json is distinct from v_request.typed_result_json
     or v_step.owner_response_hash is distinct from v_request.c1_receipt_sha256
     or v_step.after_state_fingerprint is distinct from v_after_hash then return null; end if;
  return jsonb_build_object('lane','RETAINED_C1','publication_request_id',v_request.id,
    'orchestration_run_id',v_run.id,'generation_id',v_generation.id,
    'request_sha256',encode(v_request.request_sha256,'hex'),'c1_publication_id',v_request.c1_publication_id,
    'c1_head_revision',v_request.c1_head_revision::text,'c1_receipt_sha256',encode(v_request.c1_receipt_sha256,'hex'),
    'receipt_state','PUBLISHED');
end;
$function$;

-- private.weekly_source_pay_query_local_receipt_v1(uuid,uuid,uuid); supabase/repeatable/05102026_0114_weekly_source_pay_query_evidence_v1.sql; SHA256 7151384c7ce291e4f9e9431a2ea9d1c44b4de4609844d3ab69c0a5dd65a212f5
create or replace function private.weekly_source_pay_query_local_receipt_v1(
  p_root_timesheet_id uuid,p_approval_id uuid,p_generation_id uuid
) returns jsonb
language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_scope jsonb;
  v_approval public.weekly_exceptional_payment_approvals%rowtype;
  v_generation public.weekly_exceptional_pay_generations%rowtype;
  v_local private.weekly_source_local_protected_decision_receipts%rowtype;
  v_request public.weekly_exceptional_c1_publication_requests%rowtype;
  v_run public.weekly_exceptional_orchestration_runs%rowtype;
  v_event public.weekly_exceptional_pay_family_events%rowtype;
  v_original_event public.weekly_exceptional_pay_family_events%rowtype;
  v_publication private.weekly_source_entitlement_publication_receipts%rowtype;
  v_pending public.weekly_source_pending_entitlement_bundles%rowtype;
  v_head public.weekly_source_entitlement_heads%rowtype;
  v_canonical jsonb;
  v_choice jsonb;
  v_entitlement jsonb;
  v_components jsonb;
  v_origin jsonb;
  v_basis jsonb;
  v_snapshot jsonb;
  v_publication_root public.timesheets%rowtype;
  v_publication_version integer;
  v_prior_inventory jsonb;
  v_before_origin jsonb;
  v_qualification jsonb;
  v_result_hash bytea;
  v_member integer;
begin
  if p_root_timesheet_id is null or p_approval_id is null or p_generation_id is null then
    raise exception 'WEEKLY_SOURCE_PAY_QUERY_LOCAL_RECEIPT_IDENTITY_REQUIRED' using errcode='22023';
  end if;
  v_scope:=private.weekly_source_pay_query_scope_v1(p_root_timesheet_id);
  if v_scope is null or v_scope->>'target_family_id' is null then return null; end if;
  select a.* into v_approval from public.weekly_exceptional_payment_approvals a
    where a.id=p_approval_id;
  if not found or v_approval.withdrawn_at_utc is not null
     or v_approval.pay_target_family_id::text is distinct from v_scope->>'target_family_id'
     or v_approval.candidate_id::text is distinct from v_scope->>'candidate_id'
     or v_approval.client_id::text is distinct from v_scope->>'client_id'
     or v_approval.contract_id::text is distinct from v_scope->>'contract_id'
     or to_char(v_approval.week_ending,'YYYY-MM-DD') is distinct from v_scope->>'week_ending_date'
     or v_approval.protected_work_date not between
        (v_scope->>'week_ending_date')::date-6 and (v_scope->>'week_ending_date')::date then return null; end if;
  if not exists(select 1 from public.weekly_work_events w
    where w.id=v_approval.work_event_id and w.candidate_id=v_approval.candidate_id
      and w.client_id=v_approval.client_id and w.work_date=v_approval.protected_work_date) then return null; end if;
  -- Latest actual event sequence, not a timestamp or a search through JSON.
  select e.* into v_event from public.weekly_exceptional_pay_family_events e
    where e.family_id=v_approval.pay_target_family_id
      and e.durable_work_event_id=v_approval.work_event_id
    order by e.event_sequence desc limit 1;
  if not found or v_event.evidence_approval_id is distinct from v_approval.id
     or v_event.state is distinct from 'WAIT'
     or v_event.work_date is distinct from v_approval.protected_work_date then return null; end if;
  select g.* into v_generation from public.weekly_exceptional_pay_generations g
    where g.id=p_generation_id and g.family_id=v_approval.pay_target_family_id;
  if not found or private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',
       v_generation.complete_next_vector_json) is distinct from v_generation.complete_next_vector_hash
     or not exists(select 1 from public.weekly_exceptional_pay_target_events t
       where t.family_id=v_approval.pay_target_family_id and t.approval_id=v_approval.id
         and t.financial_generation_id=v_generation.id
         and t.complete_next_family_vector_fingerprint=v_generation.complete_next_vector_hash) then return null; end if;
  select l.* into v_local from private.weekly_source_local_protected_decision_receipts l
    where l.generation_id=v_generation.id;
  if not found or v_local.family_id is distinct from v_approval.pay_target_family_id
     or v_local.actor_user_id is distinct from v_approval.approved_by_user_id
     or v_local.state not in ('COMPLETE','PENDING_FREEZE')
     or v_local.completed_at_utc is null or not isfinite(v_local.completed_at_utc) then return null; end if;
  -- Accepted evidence belongs to its original physical root/version. A lawful
  -- later rotation must not invalidate the same raw booking family's receipt.
  -- Point-read that pinned root; never choose an arbitrary historical winner.
  select t.* into v_publication_root from public.timesheets t
    where t.timesheet_id=v_local.root_timesheet_id;
  if not found or v_publication_root.booking_id is distinct from v_scope->>'family_booking_id'
     or v_publication_root.contract_id is distinct from v_approval.contract_id
     or v_publication_root.week_ending_date is distinct from v_approval.week_ending
     or v_publication_root.sheet_scope is distinct from 'WEEKLY'
     or v_publication_root.line_type is distinct from 'HOURS'
     or v_publication_root.is_adjustment is distinct from false
     or v_local.approved_snapshot_json->>'timesheet_id' is distinct from v_local.root_timesheet_id::text
     or jsonb_typeof(v_local.approved_snapshot_json->'timesheet_version') is distinct from 'number'
     or coalesce(v_local.approved_snapshot_json->>'timesheet_version','') !~ '^[1-9][0-9]*$'
     or (v_local.approved_snapshot_json->>'timesheet_version')::numeric>2147483647 then return null; end if;
  v_publication_version:=(v_local.approved_snapshot_json->>'timesheet_version')::integer;
  if v_publication_root.version is distinct from v_publication_version then return null; end if;
  select r.* into v_request from public.weekly_exceptional_c1_publication_requests r
    where r.id=v_local.publication_request_id;
  if not found or v_request.state is distinct from 'RETIRED'
     or v_request.completed_at_utc is null or not isfinite(v_request.completed_at_utc)
     or v_request.family_id is distinct from v_local.family_id
     or v_request.generation_id is distinct from v_generation.id
     or v_request.orchestration_run_id is distinct from v_approval.creation_orchestration_run_id
     or v_request.root_timesheet_id is distinct from v_local.root_timesheet_id
     or v_request.candidate_id is distinct from v_approval.candidate_id
     or v_request.contract_id is distinct from v_approval.contract_id
     or v_request.week_ending_date is distinct from v_approval.week_ending
     or v_request.request_sha256 is distinct from v_local.request_sha256
     or v_request.typed_result_json is distinct from v_local.result_json
     or v_request.c1_operation_id is not null or v_request.c1_publication_id is not null
     or v_request.c1_head_revision is not null or v_request.c1_receipt_sha256 is not null then return null; end if;
  select r.* into v_run from public.weekly_exceptional_orchestration_runs r
    where r.id=v_approval.creation_orchestration_run_id;
  v_result_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_LOCAL_RESULT_V1',v_local.result_json);
  if not found or v_run.family_id is distinct from v_local.family_id
     or v_run.requested_by_user_id is distinct from v_local.actor_user_id
     or v_run.state is distinct from 'COMPLETE' or v_run.completed_at_utc is null
     or not isfinite(v_run.completed_at_utc)
     or v_run.after_state_fingerprint is distinct from v_result_hash
     or v_local.result_json->'ok' is distinct from 'true'::jsonb
     or v_local.result_json->'idempotent_replay' is distinct from 'false'::jsonb
     or v_local.result_json->>'family_id' is distinct from v_local.family_id::text
     or v_local.result_json->>'generation_id' is distinct from v_generation.id::text
     or v_local.result_json->>'publication_request_id' is distinct from v_request.id::text
     or coalesce(v_local.result_json->>'family_bound_version','') !~ '^[1-9][0-9]*$'
     or (v_local.result_json->>'family_bound_version')::numeric>
          (v_scope->>'family_bound_version')::numeric then return null; end if;
  v_snapshot:=v_generation.complete_next_vector_json#>'{target_snapshot,tsfin_snapshot_json}';
  if jsonb_typeof(v_snapshot) is distinct from 'object'
     or v_snapshot is distinct from v_approval.approved_target_pay_components_json->'tsfin_snapshot_json' then return null; end if;
  if v_local.state='COMPLETE' then
    -- A different sibling may have superseded this accepted generation. Its
    -- immutable published proof is still needed for this unchanged WAIT event.
    if v_generation.lifecycle_state not in ('PUBLISHED','SUPERSEDED')
       or v_generation.published_at_utc is null or not isfinite(v_generation.published_at_utc)
       or v_generation.result_hash is distinct from v_result_hash
       or v_local.result_json->>'outcome' is distinct from 'PUBLISHED'
       or v_local.result_json->>'state' is distinct from 'LIVE' then return null; end if;
  elsif v_generation.lifecycle_state is distinct from 'PENDING_C1'
     or v_generation.published_at_utc is not null or v_generation.result_hash is not null
     or v_local.result_json->>'outcome' is distinct from 'SAVED_PENDING_FREEZE'
     or v_local.result_json->>'state' is distinct from 'PENDING' then return null;
  end if;
  if v_local.result_json->>'authority'='UNAUTHORISED_TSFIN' then
    if v_local.state<>'COMPLETE'
       or v_local.result_json->'requires_first_authorisation' is distinct from 'true'::jsonb then return null; end if;
    v_basis:=v_local.approved_snapshot_json->'saved_unauthorised_basis';
    if private.weekly_exceptional_json_keys_exact_v1(v_basis,array['schema_version',
       'financial_snapshot_id','financial_snapshot_sha256','detail_sha256','inventory_sha256',
       'root_version','family_booking_id']) is distinct from true
       or not (v_basis ?& array['schema_version','financial_snapshot_id','financial_snapshot_sha256',
          'detail_sha256','inventory_sha256','root_version','family_booking_id'])
       or v_basis->>'schema_version' is distinct from 'SAVED_UNAUTHORISED_LOCAL_V1'
       or v_basis->>'family_booking_id' is distinct from v_scope->>'family_booking_id'
       or v_basis->>'root_version' is distinct from v_publication_version::text
       or v_basis->>'financial_snapshot_id' is distinct from v_local.result_json->>'timesheet_financials_id'
       or coalesce(v_basis->>'financial_snapshot_sha256','') !~ '^[0-9a-f]{64}$'
       or coalesce(v_basis->>'detail_sha256','') !~ '^[0-9a-f]{64}$'
       or v_basis->>'inventory_sha256' is distinct from encode(v_generation.complete_next_vector_hash,'hex')
       or (v_local.approved_snapshot_json-'saved_unauthorised_basis') is distinct from
          (v_snapshot||jsonb_build_object('timesheet_id',v_local.root_timesheet_id::text,
           'timesheet_version',v_publication_version,'actual_schedule_json',
           v_generation.complete_next_vector_json#>'{target_snapshot,actual_schedule_json}'))
       or not exists(select 1 from public.timesheets_financials f
         where f.id::text=v_basis->>'financial_snapshot_id'
           and f.timesheet_id=v_local.root_timesheet_id
           and f.timesheet_version=v_publication_version
           and f.candidate_id=v_approval.candidate_id and f.client_id=v_approval.client_id) then return null; end if;
    -- This is accepted decision evidence, not current financial eligibility.
    -- First Authorise can legitimately change current TSFIN. Do not compare
    -- today's mutable finance row to the original sealed pre-authorise hash.
  elsif v_local.result_json->>'authority'='COMMON_ENTITLEMENT_HEAD' then
    if v_local.result_json->'requires_first_authorisation' is distinct from 'false'::jsonb
       or v_local.approved_snapshot_json->>'common_decision_bundle_id'
          is distinct from v_local.result_json->>'decision_bundle_id'
       or v_local.common_decision_bundle_id::text is distinct from v_local.result_json->>'decision_bundle_id'
       or v_local.common_bundle_revision is null
       or v_local.publication_origin_kind is distinct from 'PROTECTED_LOCAL_DECISION_V1'
       or v_local.publication_origin_digest is null
       or v_local.source_qualification_digest is null then return null; end if;
    if v_local.state='PENDING_FREEZE' then
      select p.* into v_pending from public.weekly_source_pending_entitlement_bundles p
        where p.id::text=v_local.result_json#>>'{publication,pending_bundle_verified}';
      if not found or v_pending.state not in ('PENDING','RELEASING','MANUAL_REVIEW')
         or v_pending.decision_bundle_id::text is distinct from v_local.result_json->>'decision_bundle_id'
         or v_pending.bundle_revision is distinct from v_local.common_bundle_revision
         or v_pending.decided_by_user_id is distinct from v_local.actor_user_id
         or v_pending.candidate_id is distinct from v_approval.candidate_id
         or v_local.result_json#>'{publication,ok}' is distinct from 'true'::jsonb
         or v_local.result_json#>'{publication,published}' is distinct from 'false'::jsonb
         or v_local.result_json#>>'{publication,code}' is distinct from 'WEEKLY_SOURCE_PUBLICATION_DEFERRED_PENDING_FREEZE'
         or v_pending.request_digest is distinct from private.weekly_source_publication_request_digest_v1(
             private.weekly_source_publication_request_canonical_v1(v_pending.request_json,'DEFERRED',v_pending.id)) then return null; end if;
      v_member:=array_position(v_pending.member_root_ids,v_local.root_timesheet_id);
      if v_member is null or v_pending.member_family_booking_ids[v_member] is distinct from v_scope->>'family_booking_id'
         or v_pending.member_root_versions[v_member] is distinct from v_publication_version then return null; end if;
      v_canonical:=private.weekly_source_publication_request_canonical_v1(v_pending.request_json,'DEFERRED',v_pending.id);
      -- A self-consistent request digest does not prove that its identities
      -- agree with the separately stored pending row. Bind the complete member
      -- mapping before using the pending row's ordinal to select an entitlement.
      if v_canonical->>'decision_bundle_id' is distinct from v_pending.decision_bundle_id::text
         or (v_canonical->>'bundle_revision')::bigint is distinct from v_pending.bundle_revision
         or v_canonical->>'candidate_id' is distinct from v_pending.candidate_id::text
         or v_canonical->'member_root_ids' is distinct from to_jsonb(v_pending.member_root_ids)
         or v_canonical->'member_family_booking_ids' is distinct from to_jsonb(v_pending.member_family_booking_ids)
         or v_canonical->'member_root_versions' is distinct from to_jsonb(v_pending.member_root_versions)
         or v_canonical->'head_ids' is distinct from to_jsonb(v_pending.proposed_head_ids)
         or v_canonical->>'decision_id' is distinct from v_pending.decision_id::text
         or v_canonical->'member_root_ids'->>(v_member-1) is distinct from v_local.root_timesheet_id::text
         or v_canonical->'member_family_booking_ids'->>(v_member-1) is distinct from v_scope->>'family_booking_id'
         or (v_canonical->'member_root_versions'->>(v_member-1))::integer
            is distinct from v_publication_version then return null; end if;
      select c.value into strict v_choice from jsonb_array_elements(
        v_canonical#>'{financial_request,contract_choices}') c(value)
        where (c.value->>'root_ordinal')::integer=v_member;
      if v_choice->>'contract_id' is distinct from v_scope->>'contract_id'
         or v_choice->>'week_ending_date' is distinct from v_scope->>'week_ending_date' then return null; end if;
      select e.value into strict v_entitlement from jsonb_array_elements(
        v_canonical#>'{financial_request,member_entitlements}') e(value)
        where (e.value->>'root_ordinal')::integer=v_member;
      if v_entitlement->>'authority_kind' is distinct from 'PROTECTED'
         or (v_entitlement->>'component_count')::integer is distinct from jsonb_array_length(v_entitlement->'components') then return null; end if;
      v_components:=v_entitlement->'components';
      v_origin:=v_canonical#>'{financial_request,source_revision}';
    else
      select r.* into v_publication from private.weekly_source_entitlement_publication_receipts r
        where r.id::text=v_local.result_json#>>'{publication,receipt,id}';
      if not found or v_publication.decision_bundle_id::text is distinct from v_local.result_json->>'decision_bundle_id'
         or v_publication.bundle_revision is distinct from v_local.common_bundle_revision
         or v_publication.candidate_id is distinct from v_approval.candidate_id
         or v_publication.decided_by_user_id is distinct from v_local.actor_user_id
         or v_local.result_json#>'{publication,ok}' is distinct from 'true'::jsonb
         or v_local.result_json#>'{publication,published}' is distinct from 'true'::jsonb
         or v_local.result_json#>'{publication,receipt}' is distinct from
            private.weekly_source_publication_receipt_json_v1(v_publication.id) then return null; end if;
      v_member:=array_position(v_publication.member_root_ids,v_local.root_timesheet_id);
      if v_member is null or v_publication.member_family_booking_ids[v_member] is distinct from v_scope->>'family_booking_id'
         or v_publication.member_root_versions[v_member] is distinct from v_publication_version
         or not exists(select 1 from public.weekly_source_entitlement_heads h
           where h.id=v_publication.head_ids[v_member] and h.root_timesheet_id=v_local.root_timesheet_id
             and h.root_family_booking_id=v_scope->>'family_booking_id'
             and h.root_timesheet_version=v_publication_version
             and h.decision_bundle_id=v_publication.decision_bundle_id
             and h.bundle_revision=v_publication.bundle_revision
             and h.state in ('COMMITTED_CURRENT','SUPERSEDED')) then return null; end if;
      select h.* into strict v_head from public.weekly_source_entitlement_heads h
        where h.id=v_publication.head_ids[v_member];
      if v_head.authority_kind is distinct from 'PROTECTED'
         or v_head.candidate_id is distinct from v_approval.candidate_id
         or v_head.contract_id is distinct from v_approval.contract_id
         or v_head.week_ending_date is distinct from v_approval.week_ending then return null; end if;
      select coalesce(jsonb_agg(private.weekly_source_publication_component_canonical_v1(
        (to_jsonb(c)-array['id','head_id','decision_bundle_id','bundle_revision','component_sha256','created_at_utc'])
          ||jsonb_build_object('work_date',to_char(c.work_date,'YYYY-MM-DD'),
            'hours_day',c.hours_day::text,'hours_night',c.hours_night::text,
            'hours_sat',c.hours_sat::text,'hours_sun',c.hours_sun::text,
            'hours_bh',c.hours_bh::text,'unit_count',c.unit_count::text,
            'unit_pay_rate',c.unit_pay_rate::text,'unit_charge_rate',c.unit_charge_rate::text,
            'pay_ex_vat',c.pay_ex_vat::text,'charge_ex_vat',c.charge_ex_vat::text),
        'query.local.accepted_component') order by c.component_ordinal),'[]'::jsonb)
        into v_components from public.weekly_source_entitlement_head_components c where c.head_id=v_head.id;
      if jsonb_array_length(v_components) is distinct from v_head.component_count
         or exists(select 1 from public.weekly_source_entitlement_head_components c
           where c.head_id=v_head.id and c.component_sha256 is distinct from
             private.weekly_source_publication_request_digest_v1(private.weekly_source_publication_component_content_v1(
               private.weekly_source_publication_component_canonical_v1((to_jsonb(c)-array['id','head_id',
                 'decision_bundle_id','bundle_revision','component_sha256','created_at_utc'])
                   ||jsonb_build_object('work_date',to_char(c.work_date,'YYYY-MM-DD'),
                     'hours_day',c.hours_day::text,'hours_night',c.hours_night::text,
                     'hours_sat',c.hours_sat::text,'hours_sun',c.hours_sun::text,
                     'hours_bh',c.hours_bh::text,'unit_count',c.unit_count::text,
                     'unit_pay_rate',c.unit_pay_rate::text,'unit_charge_rate',c.unit_charge_rate::text,
                     'pay_ex_vat',c.pay_ex_vat::text,'charge_ex_vat',c.charge_ex_vat::text),
                 'query.local.accepted_component')))) then return null; end if;
      v_origin:=v_head.source_origin_json;
      if v_head.source_generation_digest is distinct from private.weekly_source_publication_request_digest_v1(v_origin) then return null; end if;
    end if;
    -- Compatible V4 local publisher must supply this real closed origin.
    -- The old current-Final constructor is deliberately NOT an accepted
    -- substitute, even if it published a genuine same-root/actor Source HEAD.
    if private.weekly_exceptional_json_keys_exact_v1(v_origin,array['origin_kind','publication_request_id',
       'generation_id','request_sha256','source_qualification_digest','policy_fingerprint',
       'before_origin','before_inventory_digest']) is distinct from true
       or not (v_origin ?& array['origin_kind','publication_request_id','generation_id','request_sha256',
          'source_qualification_digest','policy_fingerprint','before_origin','before_inventory_digest'])
       or v_origin->>'origin_kind' is distinct from 'PROTECTED_LOCAL_DECISION_V1'
       or v_origin->>'publication_request_id' is distinct from v_request.id::text
       or v_origin->>'generation_id' is distinct from v_generation.id::text
       or v_origin->>'request_sha256' is distinct from encode(v_request.request_sha256,'hex')
       or private.weekly_source_publication_request_digest_v1(v_origin)
          is distinct from v_local.publication_origin_digest
       or v_origin->>'source_qualification_digest'
          is distinct from encode(v_local.source_qualification_digest,'hex')
       or coalesce(v_origin->>'source_qualification_digest','') !~ '^[0-9a-f]{64}$'
       or coalesce(v_origin->>'policy_fingerprint','') !~ '^[0-9a-f]{64}$'
       or coalesce(v_origin->>'before_inventory_digest','') !~ '^[0-9a-f]{64}$'
       or jsonb_typeof(v_origin->'before_origin') is distinct from 'object'
       or v_local.approved_snapshot_json->'local_publication_origin' is distinct from v_origin
       or private.weekly_source_sha256_jsonb_v1('PROTECTED_LOCAL_SOURCE_QUALIFICATION_V2',
          v_local.approved_snapshot_json->'local_source_qualification')
          is distinct from v_local.source_qualification_digest
       or coalesce(v_local.approved_snapshot_json->>'common_components_digest','') !~ '^[0-9a-f]{64}$'
       or v_local.approved_snapshot_json->>'common_components_digest' is distinct from encode(
          private.weekly_source_publication_request_digest_v1(v_components),'hex') then return null; end if;
    -- The retained qualification must belong to this exact accepted action.
    -- A later WAIT can reuse this approval with a different source proposal:
    -- point-read the original immutable event, never compare it to latest WAIT.
    v_qualification:=v_local.approved_snapshot_json->'local_source_qualification';
    if private.weekly_exceptional_json_keys_exact_v1(v_qualification,array[
         'schema_version','publication_request_id','generation_id','scope','source_cycle_id',
         'work_event_id','approval_id','actor_user_id','family_event_sequence','source_proposal_hash',
         'complete_vector_hash','rate_policy_fingerprint','prepared_sources']) is distinct from true
       or not (v_qualification ?& array['schema_version','publication_request_id','generation_id',
         'scope','source_cycle_id','work_event_id','approval_id','actor_user_id','family_event_sequence',
         'source_proposal_hash','complete_vector_hash','rate_policy_fingerprint','prepared_sources'])
       or v_qualification->>'schema_version' is distinct from 'PROTECTED_LOCAL_SOURCE_QUALIFICATION_V2'
       or v_qualification->>'publication_request_id' is distinct from v_request.id::text
       or v_qualification->>'generation_id' is distinct from v_generation.id::text
       or v_qualification->>'source_cycle_id' is distinct from v_approval.source_cycle_id::text
       or v_qualification->>'work_event_id' is distinct from v_approval.work_event_id::text
       or v_qualification->>'approval_id' is distinct from v_approval.id::text
       or v_qualification->>'actor_user_id' is distinct from v_local.actor_user_id::text
       or v_qualification->>'complete_vector_hash' is distinct from encode(v_generation.complete_next_vector_hash,'hex')
       or v_qualification->>'rate_policy_fingerprint' is distinct from encode(v_approval.contract_rate_policy_source_fingerprint,'hex')
       or v_origin->>'policy_fingerprint' is distinct from v_qualification->>'rate_policy_fingerprint'
       or v_qualification#>>'{scope,root_timesheet_id}' is distinct from v_local.root_timesheet_id::text
       or v_qualification#>>'{scope,root_version}' is distinct from v_publication_version::text
       or v_qualification#>>'{scope,family_booking_id}' is distinct from v_scope->>'family_booking_id'
       or v_qualification#>>'{scope,target_family_id}' is distinct from v_local.family_id::text
       or v_qualification#>>'{scope,candidate_id}' is distinct from v_approval.candidate_id::text
       or v_qualification#>>'{scope,client_id}' is distinct from v_approval.client_id::text
       or v_qualification#>>'{scope,contract_id}' is distinct from v_approval.contract_id::text
       or v_qualification#>>'{scope,week_ending_date}' is distinct from to_char(v_approval.week_ending,'YYYY-MM-DD')
       or coalesce(v_qualification->>'family_event_sequence','') !~ '^[1-9][0-9]*$'
       or (v_qualification->>'family_event_sequence')::numeric>9223372036854775807
       or coalesce(v_qualification->>'source_proposal_hash','') !~ '^[0-9a-f]{64}$'
       or jsonb_typeof(v_qualification->'prepared_sources') is distinct from 'array' then return null; end if;
    select e.* into v_original_event from public.weekly_exceptional_pay_family_events e
      where e.family_id=v_local.family_id
        and e.event_sequence=(v_qualification->>'family_event_sequence')::bigint;
    if not found or v_original_event.durable_work_event_id is distinct from v_approval.work_event_id
       or v_original_event.evidence_approval_id is distinct from v_approval.id
       or v_original_event.office_actor_user_id is distinct from v_local.actor_user_id
       or v_original_event.work_date is distinct from v_approval.protected_work_date
       or v_original_event.source_proposal_hash is distinct from decode(v_qualification->>'source_proposal_hash','hex')
       or v_original_event.source_proposal_hash is distinct from private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_PROTECTED_SOURCE_PROPOSAL_V1',v_original_event.source_proposal_snapshot_json) then return null; end if;
    -- Qualify the original sealed before-position, never today's HEAD/root.
    -- The complete vector was sealed by the actual stage owner. A later
    -- sibling amendment or physical rotation cannot replace this evidence.
    v_prior_inventory:=v_generation.complete_next_vector_json->'prior_effective_inventory';
    v_before_origin:=v_prior_inventory#>'{approval_basis,origin}';
    if v_prior_inventory->'ok' is distinct from 'true'::jsonb
       or v_prior_inventory#>'{approval_basis,coverage_complete}' is distinct from 'true'::jsonb
       or coalesce(v_before_origin->>'kind','') not in ('INITIAL_AUTHORISED_TSFIN_V1','COMMITTED_SOURCE_HEAD_V1')
       or v_prior_inventory#>>'{approval_basis,scope,root_timesheet_id}' is distinct from v_local.root_timesheet_id::text
       or v_prior_inventory#>>'{approval_basis,scope,root_version}' is distinct from v_publication_version::text
       or v_prior_inventory#>>'{approval_basis,scope,family_booking_id}' is distinct from v_scope->>'family_booking_id'
       or v_prior_inventory#>>'{approval_basis,scope,target_family_id}' is distinct from v_local.family_id::text
       or v_prior_inventory#>>'{approval_basis,scope,candidate_id}' is distinct from v_scope->>'candidate_id'
       or v_prior_inventory#>>'{approval_basis,scope,client_id}' is distinct from v_scope->>'client_id'
       or v_prior_inventory#>>'{approval_basis,scope,contract_id}' is distinct from v_scope->>'contract_id'
       or v_prior_inventory#>>'{approval_basis,scope,week_ending_date}' is distinct from v_scope->>'week_ending_date'
       or v_origin->>'before_inventory_digest' is distinct from v_prior_inventory->>'inventory_digest' then return null; end if;
    if v_before_origin->>'kind'='COMMITTED_SOURCE_HEAD_V1' then
      v_before_origin:=v_before_origin-'source_revision';
    end if;
    if v_origin->'before_origin' is distinct from v_before_origin
       or private.weekly_source_local_origin_canonical_v2(v_origin) is distinct from v_origin then return null; end if;
  else return null;
  end if;
  return jsonb_build_object('lane','SOURCE_LOCAL','publication_request_id',v_request.id,
    'orchestration_run_id',v_run.id,'generation_id',v_generation.id,
    'request_sha256',encode(v_local.request_sha256,'hex'),'receipt_state',v_local.state);
end;
$function$;

-- private.weekly_source_pay_query_next_receipt_v1(uuid,uuid,uuid); supabase/repeatable/05102026_0258_weekly_source_pay_query_next_receipt_v1.sql; SHA256 067601f58a5a6ff3dcad9d443f2ff843f516fa726c893a4beafc57cde2ebae5f
create or replace function private.weekly_source_pay_query_next_receipt_v1(
  p_root_timesheet_id uuid,p_approval_id uuid,p_generation_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_scope jsonb; v_receipts jsonb;
begin
  if p_root_timesheet_id is null or p_approval_id is null or p_generation_id is null then
    raise exception 'WEEKLY_SOURCE_PAY_QUERY_NEXT_RECEIPT_IDENTITY_REQUIRED' using errcode='22023'; end if;
  v_scope:=private.weekly_source_pay_query_scope_v1(p_root_timesheet_id);
  if v_scope is null or v_scope->>'target_family_id' is null then return null; end if;
  select jsonb_agg(jsonb_build_object(
    'lane','DIRECT_NEXT','orchestration_run_id',r.orchestration_run_id,
    'generation_id',r.generation_id,'work_id',r.work_id,'revision_id',r.revision_id,
    'command_id',r.command_id,'agency_sequence',r.agency_sequence::text,
    'accepted_family_bound_version',r.accepted_family_bound_version::text,
    'prepared_request_sha256',encode(r.prepared_request_sha256,'hex'),
    'publication_request_sha256',encode(r.publication_request_sha256,'hex'),
    'source_manifest_sha256',encode(r.source_manifest_sha256,'hex'),'receipt_state','COMPLETE'))
  into v_receipts
  from public.weekly_exceptional_payment_approvals a
  join private.bpay_next_protected_source_receipt r on r.approval_id=a.id and r.generation_id=p_generation_id
  join public.weekly_exceptional_pay_target_families f on f.id=r.family_id
  join public.weekly_exceptional_orchestration_runs o on o.id=r.orchestration_run_id
  join public.weekly_exceptional_pay_generations g on g.id=r.generation_id
  join private.bpay_next_work w on w.id=r.work_id
  join private.bpay_next_work_revision v on v.work_id=w.id and v.id=r.revision_id
  join private.bpay_next_publication p on p.command_id=r.command_id and p.work_id=w.id
    and p.revision_id=v.id and p.candidate_id=w.candidate_id
  join private.bpay_next_command c on c.id=p.command_id
  join private.bpay_next_command_member m on m.command_id=c.id and m.candidate_id=w.candidate_id
  join lateral (select e.* from public.weekly_exceptional_pay_family_events e
    where e.family_id=f.id and e.durable_work_event_id=a.work_event_id
    order by e.event_sequence desc limit 1) e on true
  where a.id=p_approval_id and f.id::text=v_scope->>'target_family_id'
    and a.pay_target_family_id=f.id and g.family_id=f.id and o.family_id=f.id
    and a.withdrawn_at_utc is null
    and a.candidate_id::text=v_scope->>'candidate_id' and a.client_id::text=v_scope->>'client_id'
    and a.contract_id::text=v_scope->>'contract_id'
    and a.week_ending=(v_scope->>'week_ending_date')::date
    and a.protected_work_date between a.week_ending-6 and a.week_ending
    and exists(select 1 from public.weekly_work_events d where d.id=a.work_event_id
      and d.candidate_id=a.candidate_id and d.client_id=a.client_id and d.work_date=a.protected_work_date)
    and e.state='WAIT' and e.evidence_approval_id=a.id and e.work_date=a.protected_work_date
    and e.office_actor_user_id=a.approved_by_user_id
    and e.start_at_local=a.protected_start_at_local and e.end_at_local=a.protected_end_at_local
    and e.break_minutes=a.protected_break_minutes
    and e.fixed_office_target_hash=a.signed_schedule_fact_hash
    and private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_SCHEDULE_V1',
      e.fixed_office_target_snapshot_json)=a.signed_schedule_fact_hash
    and a.creation_orchestration_run_id=o.id
    and o.requested_by_user_id=r.actor_user_id and a.approved_by_user_id=r.actor_user_id
    and o.request_fingerprint=r.prepared_request_sha256
    and o.state='COMPLETE' and o.completed_at_utc is not null and isfinite(o.completed_at_utc)
    and o.after_state_fingerprint=r.publication_request_sha256
    and g.lifecycle_state in ('PUBLISHED','SUPERSEDED')
    and g.published_at_utc is not null and isfinite(g.published_at_utc)
    and g.result_hash=r.publication_request_sha256
    and g.complete_next_vector_json=a.approved_target_pay_components_json
    and private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',
      g.complete_next_vector_json)=g.complete_next_vector_hash
    and g.fixed_target_source_state_fingerprint=r.source_manifest_sha256
    and e.source_proposal_hash=r.source_manifest_sha256
    and private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_SOURCE_PROPOSAL_V1',
      e.source_proposal_snapshot_json)=r.source_manifest_sha256
    and (select count(*) from public.weekly_exceptional_pay_target_events t
      where t.family_id=f.id and t.approval_id=a.id and t.financial_generation_id=g.id)=1
    and exists(select 1 from public.weekly_exceptional_pay_target_events t
      where t.family_id=f.id and t.approval_id=a.id and t.financial_generation_id=g.id
        and t.complete_next_family_vector_fingerprint=g.complete_next_vector_hash
        and t.fixed_target_component_snapshot=g.complete_next_vector_json
        and t.current_source_proposal_snapshot=e.source_proposal_snapshot_json)
    and r.accepted_family_bound_version>0 and r.accepted_family_bound_version<=f.bound_version
    and w.candidate_id=a.candidate_id and w.contract_id=a.contract_id
    and w.booking_id=v_scope->>'family_booking_id' and w.work_kind='SOURCE'
    and w.week_ending_date=a.week_ending and v.week_ending_date=w.week_ending_date
    and v.source_kind='PROTECTED' and v.source_event_id=a.id
    and v.source_head_id is null and v.financial_snapshot_id is null
    and v.approved_at_utc is not null and isfinite(v.approved_at_utc)
    and v.sealed_at_utc is not null and isfinite(v.sealed_at_utc)
    and v.approved_source_ex_vat=a.approved_target_gross
    -- Both exact retained physical identities must belong to the raw family;
    -- neither needs to remain current or equal today's canonical physical root.
    and exists(select 1 from public.timesheets t where t.timesheet_id=w.original_timesheet_id
      and t.booking_id=w.booking_id and t.contract_id=w.contract_id
      and t.week_ending_date=w.week_ending_date and t.sheet_scope='WEEKLY'
      and t.line_type='HOURS' and t.is_adjustment is false and t.version>=1)
    and exists(select 1 from public.timesheets t where t.timesheet_id=v.physical_timesheet_id
      and t.booking_id=w.booking_id and t.contract_id=w.contract_id
      and t.week_ending_date=w.week_ending_date and t.sheet_scope='WEEKLY'
      and t.line_type='HOURS' and t.is_adjustment is false and t.version=v.physical_timesheet_version)
    and p.revision_no=v.revision_no and c.agency_sequence=r.agency_sequence
    and c.command_kind='POSITION_APPLY' and c.expected_member_count=1 and m.member_no=1
    and c.sealed_at_utc is not null and isfinite(c.sealed_at_utc)
    and c.id=private.bpay_next_source_command_id_v1(a.id)
    -- A job is created by later enrolment, not by publication acceptance.
    and not exists(select 1 from private.bpay_next_job j where j.command_id=c.id
      and (j.candidate_id<>w.candidate_id or j.job_kind<>'POSITION_APPLY'
        or j.command_sequence<>c.agency_sequence or j.module_epoch<>c.module_epoch))
    and (select count(*) from public.weekly_exceptional_orchestration_steps s
      where s.orchestration_run_id=o.id and s.step_kind='PUBLISH_NEXT')=1
    and exists(select 1 from public.weekly_exceptional_orchestration_steps s
      where s.orchestration_run_id=o.id and s.step_kind='PUBLISH_NEXT'
        and s.outcome='COMPLETE' and s.completed_at_utc is not null and isfinite(s.completed_at_utc)
        and s.allowlisted_owner_name='public.weekly_exceptional_pay_publish_next_v1'
        and s.allowlisted_owner_signature='jsonb->jsonb'
        and s.bounded_request_hash=r.publication_request_sha256
        and s.owner_response_hash=r.publication_request_sha256
        and s.after_state_fingerprint=r.publication_request_sha256
        and s.before_state_fingerprint=o.before_state_fingerprint
        and s.bounded_owner_response_json=private.bpay_next_protected_receipt_json_v1(o.id,false));
  if jsonb_array_length(v_receipts) is distinct from 1 then return null; end if;
  return v_receipts->0;
end;
$function$;

-- private.bpay_next_protected_receipt_json_v1(uuid,boolean); supabase/repeatable/04102026_0345_banking_pay_next_protected_source_v1.sql; SHA256 52f1a4329c768ccbf3a8722d0eb8ded90dee99b8e3914037ef32cee7a42a22e6
create or replace function private.bpay_next_protected_receipt_json_v1(
  p_run_id uuid,p_replay boolean
) returns jsonb language sql stable security definer
set search_path=pg_catalog,private,public
as $function$
  select pg_catalog.jsonb_build_object('ok',true,'outcome','PUBLISHED_NEXT',
    'idempotent_replay',p_replay,'family_id',r.family_id,
    'orchestration_run_id',r.orchestration_run_id,'approval_id',r.approval_id,
    'generation_id',r.generation_id,'work_id',r.work_id,'revision_id',r.revision_id,
    'command_id',r.command_id,'agency_sequence',r.agency_sequence::text,
    'new_family_bound_version',r.accepted_family_bound_version::text,
    'approved_pay_ex_vat',a.approved_target_gross::text,'state','NEXT_PUBLISHED')
  from private.bpay_next_protected_source_receipt r
  join public.weekly_exceptional_payment_approvals a on a.id=r.approval_id
  where r.orchestration_run_id=p_run_id
$function$;

-- private.bpay_next_work_collection_observation_v1(uuid,text,uuid); supabase/repeatable/12102026_2155_banking_pay_next_treatment_collection_identity_v1.sql; SHA256 241946e54e45b7efa43c881add67a253b82b389873d34041058606a4343148b2
create or replace function private.bpay_next_work_collection_observation_v1(
  p_work_id uuid,p_component_key text,p_revision_id uuid
) returns jsonb language plpgsql stable security invoker set search_path=pg_catalog,private
as $function$
declare v_position private.bpay_next_position%rowtype;v_work private.bpay_next_work%rowtype;
  v_revision private.bpay_next_work_revision%rowtype;v_original private.bpay_next_work_revision%rowtype;
  v_source_current private.bpay_next_work_revision%rowtype;v_source_original private.bpay_next_work_revision%rowtype;
  v_basis private.bpay_next_work_collection%rowtype;v_line private.bpay_next_approved_line%rowtype;
  v_case private.bpay_next_finance_case%rowtype;v_component private.bpay_next_case_component%rowtype;
  v_current private.bpay_next_approved_line%rowtype;v_segments record;v_segmented boolean;
  v_retained boolean:=false;v_removed boolean:=false;v_complete boolean:=false;v_outstanding numeric;v_free numeric;v_negative numeric;v_positive numeric;v_overhang numeric;
begin
  select pos.* into v_position from private.bpay_next_position pos where pos.work_id=p_work_id and pos.component_key=p_component_key;
  select wrk.* into v_work from private.bpay_next_work wrk where wrk.id=p_work_id;
  select rev.* into v_revision from private.bpay_next_work_revision rev where rev.id=p_revision_id and rev.work_id=p_work_id;
  select coll.* into v_basis from private.bpay_next_work_collection coll where coll.work_id=p_work_id and coll.component_key=p_component_key;
  -- Withdrawal retains a previously known sealed observation, never approval zero.
  v_retained:=v_work.approval_state='WITHDRAWN' and v_work.current_revision_id is null
    and v_work.applied_revision_id=p_revision_id and v_basis.observed_revision_id=p_revision_id
    and v_basis.observed_approved_source_ex_vat=v_position.approved_source_ex_vat
    and v_basis.collection_mode='MANUAL' and v_basis.manual_reason_code='AUTOMATIC_COLLECTION_UNAVAILABLE'
    and v_basis.manual_outstanding_source_ex_vat is not null;
  if v_basis.id is null or v_position.applied_revision_id is distinct from p_revision_id
    or not (coalesce(v_retained,false) or (v_work.current_revision_id=p_revision_id and v_work.approval_state='APPROVED'))
    or v_revision.sealed_at_utc is null or v_position.approved_source_ex_vat<0 or v_position.realised_source_ex_vat<0 then
    return jsonb_build_object('complete',false,'segmented',false);end if;
  select rev.* into strict v_original from private.bpay_next_work_revision rev where rev.id=v_basis.original_revision_id;
  select source.* into strict v_source_current from private.bpay_next_work_revision source
    where source.work_id=p_work_id and source.id=(case when v_revision.sealed_at_utc is not null and v_revision.payment_treatment_approval_revision_id is not null then private.bpay_next_treatment_approval_revision_v1(v_revision.id) else v_revision.id end);
  select source.* into strict v_source_original from private.bpay_next_work_revision source
    where source.work_id=p_work_id and source.id=(case when v_original.sealed_at_utc is not null and v_original.payment_treatment_approval_revision_id is not null then private.bpay_next_treatment_approval_revision_v1(v_original.id) else v_original.id end);
  select line.* into strict v_line from private.bpay_next_approved_line line where line.id=v_basis.original_approved_line_id;
  select line.* into v_current from private.bpay_next_approved_line line where line.revision_id=p_revision_id and line.component_key=p_component_key;
  if v_basis.case_id is not null then
    select fc.* into strict v_case from private.bpay_next_finance_case fc where fc.id=v_basis.case_id;
    select cc.* into strict v_component from private.bpay_next_case_component cc where cc.id=v_basis.case_component_id;
    if (v_case.principal_approved,v_case.principal_recovered,v_case.principal_written_off,v_case.active_recovery_hold_amount)
      is distinct from (v_component.approved_source_ex_vat,v_component.recovered_source_ex_vat,
        v_component.written_off_source_ex_vat,v_component.active_recovery_source_ex_vat) then
      return jsonb_build_object('complete',false,'segmented',false);end if;
  end if;
  if v_revision.source_pay_channel is distinct from v_basis.original_source_pay_channel
    or v_position.source_basis_channel is distinct from v_basis.original_source_pay_channel then
    return jsonb_build_object('complete',false,'segmented',false);end if;
  -- The same typed authorised key, not an arbitrary absent DAY/aggregate.
  v_complete:=v_revision.detail_kind=v_original.detail_kind and v_current.id is not null
    and v_current.component_kind=v_line.component_kind
    and v_current.tax_treatment is not distinct from v_line.tax_treatment
    and v_current.source_component_id is not distinct from v_line.source_component_id
    and v_current.source_pay_ex_vat=v_position.approved_source_ex_vat;
  v_complete:=v_complete or (v_revision.certified_zero and v_revision.expected_line_count=0
    and v_revision.approved_source_ex_vat=0 and v_position.approved_source_ex_vat=0);
  -- Explicit accepted REMOVED membership certifies this typed component's zero.
  -- A surviving fixed sibling may make the current revision FIXED; the paid
  -- component and native segment counters retain their original identity.
  v_removed:=v_work.work_kind='SOURCE' and v_original.work_id=p_work_id
    and v_line.revision_id=v_original.id and v_line.component_key=p_component_key
    and v_line.source_component_id is not null
    and p_component_key='SOURCE:'||v_line.source_component_id::text
    and v_current.id is null and v_position.approved_source_ex_vat=0
    and v_revision.source_head_id is not null and v_source_current.source_event_id=v_revision.source_head_id
    and ((v_source_original.source_kind='SOURCE' and v_source_original.source_event_id is not null
        and (v_source_original.source_head_id is null or v_source_original.source_head_id=v_source_original.source_event_id))
      or (v_source_original.source_kind='PROTECTED' and v_source_original.source_head_id is not null
        and v_source_original.source_head_id=v_source_original.source_event_id))
    and ((v_revision.source_kind='SOURCE' and v_source_current.source_event_id is not null
        and (v_revision.source_head_id is null or v_revision.source_head_id=v_source_current.source_event_id))
      or (v_revision.source_kind='PROTECTED' and v_revision.source_head_id is not null
        and v_revision.source_head_id=v_source_current.source_event_id))
    and exists(
      select 1 from private.bpay_next_source_component_binding b
        join private.bpay_next_source_component_binding_version bv on bv.id=b.current_binding_version_id
          and bv.canonical_work_id=b.canonical_work_id and bv.canonical_component_key=b.canonical_component_key
          and bv.candidate_id=b.candidate_id and bv.source_component_id=b.source_component_id
        join private.bpay_next_approved_line classification on classification.id=bv.classification_line_id
        join private.bpay_next_work_revision classified on classified.id=classification.revision_id
          and classified.work_id=p_work_id and classified.sealed_at_utc is not null
        join private.weekly_source_entitlement_publication_receipts receipt on receipt.id=bv.source_receipt_id
        join public.weekly_source_entitlement_decision_bundles bundle on bundle.decision_bundle_id=bv.decision_bundle_id
          and bundle.bundle_revision=bv.bundle_revision and bundle.state='COMMITTED'
        join public.weekly_source_entitlement_heads head on head.id=bv.head_id and head.state='COMMITTED_CURRENT'
        join public.weekly_source_root_authorisations auth on auth.current_entitlement_head_id=head.id
          and auth.root_timesheet_id=head.root_timesheet_id and auth.withdrawn_at_utc is null
        join private.bpay_next_publication publication on publication.command_id=bv.publication_command_id_1
          and publication.work_id=bv.publication_work_id_1 and publication.revision_id=bv.publication_revision_id_1
          and publication.candidate_id=v_work.candidate_id
        join private.bpay_next_publication actual_publication on actual_publication.work_id=p_work_id
          and actual_publication.revision_id=p_revision_id and actual_publication.candidate_id=v_work.candidate_id
      where b.canonical_work_id=p_work_id and b.canonical_component_key=p_component_key
        and b.candidate_id=v_work.candidate_id and b.source_component_id=v_line.source_component_id
        and bv.component_state='REMOVED' and bv.approved_line_id is null
        and bv.approval_work_id=p_work_id and bv.approval_revision_id=v_source_current.id
        and bv.approval_component_key=p_component_key and bv.approval_source_channel=v_basis.original_source_pay_channel
        and bv.publication_work_id_1=p_work_id and bv.publication_revision_id_1=v_source_current.id
        and bv.publication_command_id_2 is null and bv.publication_work_id_2 is null and bv.publication_revision_id_2 is null
        and bv.head_id=v_revision.source_head_id
        and classification.component_key=p_component_key and classification.source_component_id=v_line.source_component_id
        and classification.component_kind=v_line.component_kind
        and classification.tax_treatment is not distinct from v_line.tax_treatment
        and bv.tax_treatment is not distinct from v_line.tax_treatment
        and classified.source_pay_channel=v_basis.original_source_pay_channel
        and ((classified.source_kind='SOURCE' and classified.source_event_id is not null
            and (classified.source_head_id is null or classified.source_head_id=classified.source_event_id))
          or (classified.source_kind='PROTECTED' and classified.source_head_id is not null
            and classified.source_head_id=classified.source_event_id))
        and receipt.candidate_id=v_work.candidate_id and receipt.decision_bundle_id=bv.decision_bundle_id
        and receipt.bundle_revision=bv.bundle_revision and receipt.request_digest=bv.request_digest
        and cardinality(receipt.head_ids)=1 and receipt.head_ids[1]=bv.head_id
        and publication.status in ('QUEUED','APPLYING','APPLIED')
        and actual_publication.status in ('QUEUED','APPLYING','APPLIED'));
  v_complete:=v_complete or coalesce(v_removed,false);
  -- A Source head must be the genuinely authorised committed book. An
  -- unrelated/unbound binding is retained as AMOUNT_UNBOUND, never zero.
  if not coalesce(v_retained,false) and v_work.work_kind='SOURCE' and v_revision.source_head_id is not null and not exists(
    select 1 from private.bpay_next_source_component_binding b
      join private.bpay_next_source_component_binding_version bv on bv.id=b.current_binding_version_id
      join private.weekly_source_entitlement_publication_receipts receipt on receipt.id=bv.source_receipt_id
      join public.weekly_source_entitlement_decision_bundles bundle on bundle.decision_bundle_id=bv.decision_bundle_id
        and bundle.bundle_revision=bv.bundle_revision and bundle.state='COMMITTED'
      join public.weekly_source_entitlement_heads head on head.id=bv.head_id and head.state='COMMITTED_CURRENT'
      join public.weekly_source_root_authorisations auth on auth.current_entitlement_head_id=head.id
        and auth.root_timesheet_id=head.root_timesheet_id and auth.withdrawn_at_utc is null
      join private.bpay_next_publication publication on publication.command_id=bv.publication_command_id_1
        and publication.work_id=p_work_id and publication.revision_id=v_source_current.id and publication.candidate_id=v_work.candidate_id
      join private.bpay_next_publication actual_publication on actual_publication.work_id=p_work_id
        and actual_publication.revision_id=p_revision_id and actual_publication.candidate_id=v_work.candidate_id
      where b.canonical_work_id=p_work_id and b.canonical_component_key=p_component_key
        and bv.approval_work_id=p_work_id and bv.approval_component_key=p_component_key
        and bv.approval_revision_id=v_source_current.id and bv.candidate_id=v_work.candidate_id
        and bv.publication_command_id_2 is null and bv.head_id=v_revision.source_head_id
        and v_source_current.source_event_id=bv.head_id and bv.approval_source_channel=v_revision.source_pay_channel
        and receipt.decision_bundle_id=bv.decision_bundle_id and receipt.bundle_revision=bv.bundle_revision
        and receipt.request_digest=bv.request_digest and cardinality(receipt.head_ids)=1 and receipt.head_ids[1]=bv.head_id
        and publication.status in ('QUEUED','APPLYING','APPLIED')
        and actual_publication.status in ('QUEUED','APPLYING','APPLIED')) then v_complete:=false;end if;
  v_segmented:=exists(select 1 from private.bpay_next_approved_segment a where a.revision_id=p_revision_id and a.component_key=p_component_key)
    or exists(select 1 from private.bpay_next_work_segment_origin_share s where s.work_id=p_work_id and s.component_key=p_component_key);
  if v_segmented then
    -- Reuse native maintained segment balances. Original actual target totals
    -- must also reconcile; no gross-to-net ratio or history re-sum.
    select count(d.segment_key) n,bool_and(d.approved_source_ex_vat>=0 and d.realised_source_ex_vat>=0) nonnegative,
      sum(d.approved_source_ex_vat) approved,sum(d.realised_source_ex_vat) realised,sum(d.held_source_ex_vat) held,
      sum(d.written_off_source_ex_vat) written_off,sum(d.active_recovery_source_ex_vat) recovery_held,
      sum(credit.ex) realised_ex,sum(credit.vat) realised_vat,sum(credit.inc) realised_inc,
      sum(held.ex) held_ex,sum(held.vat) held_vat,sum(held.inc) held_inc,
      sum(d.outstanding_source_ex_vat) outstanding,sum(d.free_recovery_source_ex_vat) free,
      sum(d.negative_source_ex_vat) negative,
      sum(greatest(d.approved_source_ex_vat-d.realised_source_ex_vat-d.held_source_ex_vat,0)) positive,
      sum(greatest(d.held_source_ex_vat-greatest(d.approved_source_ex_vat-d.realised_source_ex_vat,0),0)) overhang
      into v_segments from private.bpay_next_work_segment_debt_basis_v1(p_work_id,p_component_key,p_revision_id) d
      cross join lateral (select coalesce(sum(e.target_ex_vat),0) ex,coalesce(sum(e.target_vat),0) vat,coalesce(sum(e.target_inc_vat),0) inc
        from private.bpay_next_work_segment_effect_share e where e.work_id=p_work_id and e.component_key=p_component_key and e.segment_key=d.segment_key) credit
      cross join lateral (select coalesce(sum(s.target_reserved_ex_vat),0) ex,coalesce(sum(s.target_reserved_vat),0) vat,coalesce(sum(s.target_reserved_inc_vat),0) inc
        from private.bpay_next_work_segment_origin_share s join private.bpay_next_hold h on h.id=s.hold_id and h.status='ACTIVE'
        where s.work_id=p_work_id and s.component_key=p_component_key and s.segment_key=d.segment_key) held;
    v_complete:=v_complete and v_line.component_kind='WORK' and (v_revision.detail_kind='SHIFT' or v_revision.certified_zero
        or (coalesce(v_removed,false) and v_original.detail_kind='SHIFT'))
      and v_segments.n>0 and v_segments.nonnegative
      and (v_segments.approved,v_segments.realised,v_segments.held,v_segments.realised_ex,v_segments.realised_vat,v_segments.realised_inc,
        v_segments.held_ex,v_segments.held_vat,v_segments.held_inc,v_segments.written_off,v_segments.recovery_held)
        is not distinct from (v_position.approved_source_ex_vat,v_position.realised_source_ex_vat,v_position.held_source_ex_vat,
          v_position.realised_target_ex_vat,v_position.realised_target_vat,v_position.realised_target_inc_vat,
          v_position.held_target_ex_vat,v_position.held_target_vat,v_position.held_target_inc_vat,
          coalesce(v_case.principal_written_off,0),coalesce(v_case.active_recovery_hold_amount,0));
    v_outstanding:=v_segments.outstanding;v_free:=v_segments.free;v_negative:=v_segments.negative;v_positive:=v_segments.positive;v_overhang:=v_segments.overhang;
  else
    v_outstanding:=greatest(v_position.realised_source_ex_vat-v_position.approved_source_ex_vat-coalesce(v_case.principal_written_off,0),
      coalesce(v_case.active_recovery_hold_amount,0),0);
    v_free:=v_outstanding-coalesce(v_case.active_recovery_hold_amount,0);
    v_negative:=greatest(v_position.realised_source_ex_vat-v_position.approved_source_ex_vat,0);
    v_positive:=greatest(v_position.approved_source_ex_vat-v_position.realised_source_ex_vat-v_position.held_source_ex_vat,0);
    v_overhang:=greatest(v_position.held_source_ex_vat-greatest(v_position.approved_source_ex_vat-v_position.realised_source_ex_vat,0),0);
  end if;
  return jsonb_build_object('complete',coalesce(v_complete,false),'segmented',v_segmented,
    'outstanding_source_ex_vat',case when v_complete then v_outstanding end,
    'free_recovery_source_ex_vat',case when v_complete then v_free end,
    'negative_source_ex_vat',case when v_complete then v_negative end,
    'positive_source_ex_vat',case when v_complete then v_positive end,
    'held_overhang_source_ex_vat',case when v_complete then v_overhang end);
end
$function$;

-- private.bpay_next_workbench_accepted_work_v1(uuid,text,text); supabase/repeatable/10102026_1252_banking_pay_next_workbench_summary_v1.sql; SHA256 dace1f2703136d94bcadc62d41701d05dd252a6941a4461f9a81b0439d662874
create or replace function private.bpay_next_workbench_accepted_work_v1(
  p_work_id uuid,p_component_key text,p_segment_key text)
returns table(run_id uuid,command_id uuid,module_epoch bigint,selected_source_ex_vat numeric)
language plpgsql stable security definer set search_path=pg_catalog,private
as $function$
declare v_count integer:=0;v record;
begin
  perform private.bpay_next_workbench_require_next_v1();
  for v in
    select r.id run_id,c.id command_id,c.module_epoch,
      case when p_segment_key is not null then
        (select p.included_positive_source_ex_vat from private.bpay_next_run_work_segment_parent p
          where p.run_work_id=rw.id and p.component_key=p_component_key and p.segment_key=p_segment_key)
      else (select l.source_consumed_ex_vat from private.bpay_next_run_line l
          where l.run_work_id=rw.id and l.component_key=p_component_key) end selected_source_ex_vat
    from private.bpay_next_work_choice w
    join private.bpay_next_run_selection rs on rs.run_id=w.run_id and rs.work_id=w.work_id
    join private.bpay_next_pay_run r on r.id=w.run_id and r.selection_state='SEALED'
      and r.status in ('PREPARING','REVIEW','DRAFT','EXECUTING')
    join private.bpay_next_selection_candidate sc on sc.run_id=r.id and sc.candidate_id=rs.candidate_id
    join private.bpay_next_run_command rc on rc.run_id=r.id
    join private.bpay_next_command c on c.id=rc.command_id and c.command_kind='PREPARE'
    left join private.bpay_next_run_worker worker on worker.run_id=r.id and worker.candidate_id=rs.candidate_id
    left join private.bpay_next_run_work rw on rw.run_worker_id=worker.id and rw.work_id=w.work_id
    where w.work_id=p_work_id and w.selection_state='SEALED'
      and (worker.id is null or worker.status in ('PREPARING','REVIEW','READY','DRAFT','CANCELLING','ISSUED'))
      and ((p_segment_key is not null and exists(select 1 from private.bpay_next_selected_segment s
        where s.run_id=r.id and s.work_id=w.work_id and s.component_key=p_component_key
          and s.segment_key=p_segment_key and s.disposition='INCLUDED'))
        or (p_segment_key is null and exists(select 1 from private.bpay_next_approved_line a
          where a.revision_id=w.expected_revision_id and a.component_key=p_component_key
            and not exists(select 1 from private.bpay_next_approved_segment s
              where s.revision_id=a.revision_id and s.component_key=a.component_key))
          and (w.selection_mode='ALL' or exists(select 1 from private.bpay_next_selected_component s
            where s.run_id=r.id and s.work_id=w.work_id and s.component_key=p_component_key))
          and private.bpay_next_snooze_at_cut_v1(w.work_id,w.expected_revision_id,null,p_component_key,
            r.snooze_control_sequence,r.snooze_business_date) is null))
  loop
    v_count:=v_count+1;
    if v_count>1 then raise exception using errcode='23514',message='BPAY_NEXT_WORKBENCH_ACCEPTED_MEMBER_COLLISION';end if;
    run_id:=v.run_id;command_id:=v.command_id;module_epoch:=v.module_epoch;
    selected_source_ex_vat:=v.selected_source_ex_vat;return next;
  end loop;
end
$function$;

-- private.bpay_next_workbench_work_members_v1(uuid,uuid); supabase/repeatable/12102026_2146_banking_pay_next_treatment_workbench_members_v1.sql; SHA256 96afdf304d8679195039817622ea1b08289b3a704e8b20db5878b2dea1723af6
create or replace function private.bpay_next_workbench_work_members_v1(p_work_id uuid,p_revision_id uuid)
returns table(component_key text,approved_line_id uuid,approved_segment_id uuid,segment_key text,
  component_kind text,tax_treatment text,work_date date,approved_quantity numeric,unit_label text,
  approved_amount numeric,realised_amount numeric,held_amount numeric,source_pay_channel text,
  parent_complete boolean,segment_attribution_complete boolean)
language plpgsql security definer set search_path=pg_catalog,private
as $function$
declare v_revision private.bpay_next_work_revision%rowtype;v_approval uuid;v_event uuid;
begin
  perform private.bpay_next_workbench_require_next_v1();
  select x.* into v_revision from private.bpay_next_work_revision x where x.id=p_revision_id and x.work_id=p_work_id;
  v_approval:=p_revision_id;v_event:=v_revision.source_event_id;
  if v_revision.payment_treatment_approval_revision_id is not null and v_revision.sealed_at_utc is not null then
    v_approval:=private.bpay_next_treatment_approval_revision_v1(v_revision.id);
    select x.source_event_id into v_event from private.bpay_next_work_revision x where x.id=v_approval and x.work_id=p_work_id;
  end if;
  return query
  with source_books as materialized (
    select p.component_key,book.qualification_state,book.approval_revision_id,book.approved_line_id,
      book.source_channel,book.approved_source_ex_vat,book.native_realised_paye,book.native_realised_umbrella,
      book.native_held_paye,book.native_held_umbrella
    from private.bpay_next_work w join private.bpay_next_work_revision r on r.id=p_revision_id and r.work_id=w.id
    join private.bpay_next_position p on p.work_id=w.id and p.source_book_state='READY' and p.source_book_revision>0
    left join private.bpay_next_approved_line a on a.revision_id=r.id and a.component_key=p.component_key
    join private.bpay_next_source_component_binding b on b.canonical_work_id=w.id and b.canonical_component_key=p.component_key
    join private.bpay_next_source_component_binding_version v on v.id=b.current_binding_version_id
      and v.approval_work_id=w.id and v.approval_revision_id=v_approval and v.approval_component_key=p.component_key
    left join private.bpay_next_approved_line original_class on original_class.id=coalesce(v.classification_line_id,b.canonical_line_id)
    cross join lateral private.bpay_next_bound_source_snapshot_v1(v.id,p.source_book_revision) book
    where w.id=p_work_id and w.work_kind='SOURCE' and coalesce(a.component_kind,original_class.component_kind)='WORK' and (r.source_head_id is not null
      or (r.source_kind='SOURCE' and v_event is not null and r.financial_snapshot_id is not null))
  ), keys as (
    select a.component_key from private.bpay_next_approved_line a where a.revision_id=p_revision_id
    union select p.component_key from private.bpay_next_position p where p.work_id=p_work_id
  ), parents as (
    select k.component_key,a.id line_id,coalesce(a.component_kind,original_class.component_kind) component_kind,
      case when a.id is not null then a.tax_treatment else original_class.tax_treatment end tax_treatment,
      case when a.id is not null then a.work_date else original_class.work_date end work_date,a.approved_quantity,a.unit_label,
      p.approved_source_ex_vat a,p.realised_source_ex_vat c,p.held_source_ex_vat h,p.source_basis_channel,
      p.realised_target_ex_vat,p.realised_target_vat,p.realised_target_inc_vat,
      p.held_target_ex_vat,p.held_target_vat,p.held_target_inc_vat,
      (p.work_id is not null and p.applied_revision_id=p_revision_id
        and p.approved_source_ex_vat=coalesce(a.source_pay_ex_vat,0)
        and (a.id is not null or p.approved_source_ex_vat=0)
        and (w.work_kind<>'SOURCE' or a.id is not null or original_class.id is not null)
        and (not (w.work_kind='SOURCE' and coalesce(a.component_kind,original_class.component_kind)='WORK' and (r.source_head_id is not null
          or (r.source_kind='SOURCE' and v_event is not null and r.financial_snapshot_id is not null)))
          or (book.qualification_state='READY' and book.approval_revision_id=v_approval
            and book.approved_line_id is not distinct from aa.id and book.source_channel=r.source_pay_channel
            and (book.approved_source_ex_vat,book.native_realised_paye,book.native_held_paye,book.native_realised_umbrella,book.native_held_umbrella)
              is not distinct from (p.approved_source_ex_vat,
                case when r.source_pay_channel='PAYE' then p.realised_source_ex_vat else 0::numeric end,
                case when r.source_pay_channel='PAYE' then p.held_source_ex_vat else 0::numeric end,
                case when r.source_pay_channel='UMBRELLA' then p.realised_source_ex_vat else 0::numeric end,
                case when r.source_pay_channel='UMBRELLA' then p.held_source_ex_vat else 0::numeric end)))) complete,
      (exists(select 1 from private.bpay_next_approved_segment s where s.revision_id=p_revision_id and s.component_key=k.component_key)
        or exists(select 1 from private.bpay_next_work_segment_origin_share s where s.work_id=p_work_id and s.component_key=k.component_key)) segmented
    from keys k left join private.bpay_next_approved_line a on a.revision_id=p_revision_id and a.component_key=k.component_key
    left join private.bpay_next_approved_line aa on aa.revision_id=v_approval and aa.component_key=k.component_key
    left join private.bpay_next_position p on p.work_id=p_work_id and p.component_key=k.component_key
    join private.bpay_next_work w on w.id=p_work_id
    left join private.bpay_next_work_revision r on r.id=p_revision_id and r.work_id=w.id
    left join private.bpay_next_source_component_binding binding on binding.canonical_work_id=w.id and binding.canonical_component_key=k.component_key
    left join private.bpay_next_source_component_binding_version version on version.id=binding.current_binding_version_id
    left join private.bpay_next_approved_line original_class on original_class.id=coalesce(version.classification_line_id,binding.canonical_line_id)
    left join source_books book on book.component_key=k.component_key
  ), segment_keys as (
    select s.component_key,s.segment_key from private.bpay_next_approved_segment s where s.revision_id=p_revision_id
    union select s.component_key,s.segment_key from private.bpay_next_work_segment_origin_share s where s.work_id=p_work_id
  ), members as (
    select p.*,s.segment_key,seg.id segment_id,seg.work_date segment_date,seg.approved_hours,
      coalesce(seg.approved_source_ex_vat,0) segment_a,b.realised_source_ex_vat segment_c,b.active_held_source_ex_vat segment_h
    from parents p join segment_keys s on s.component_key=p.component_key
    left join private.bpay_next_approved_segment seg on seg.revision_id=p_revision_id
      and seg.component_key=s.component_key and seg.segment_key=s.segment_key
    cross join lateral private.bpay_next_work_segment_gross_balance_v1(p_work_id,s.component_key,s.segment_key) b
  ), totals as (
    select m.component_key,sum(m.segment_a) a,sum(m.segment_c) c,sum(m.segment_h) h from members m group by m.component_key
  ), target_credit as (
    select e.component_key,sum(e.target_ex_vat) ex,sum(e.target_vat) vat,sum(e.target_inc_vat) inc
    from private.bpay_next_work_segment_effect_share e where e.work_id=p_work_id group by e.component_key
  ), target_hold as (
    select s.component_key,sum(s.target_reserved_ex_vat) ex,sum(s.target_reserved_vat) vat,sum(s.target_reserved_inc_vat) inc
    from private.bpay_next_work_segment_origin_share s join private.bpay_next_hold h on h.id=s.hold_id and h.status='ACTIVE'
    where s.work_id=p_work_id group by s.component_key
  )
  select m.component_key,m.line_id,m.segment_id,m.segment_key,m.component_kind,m.tax_treatment,
    m.segment_date,m.approved_hours,'hours'::text,m.segment_a,m.segment_c,m.segment_h,m.source_basis_channel,
    coalesce(m.complete,false),
    ((t.a,t.c,t.h,coalesce(c.ex,0),coalesce(c.vat,0),coalesce(c.inc,0),coalesce(h.ex,0),coalesce(h.vat,0),coalesce(h.inc,0))
      is not distinct from (m.a,m.c,m.h,m.realised_target_ex_vat,m.realised_target_vat,m.realised_target_inc_vat,
        m.held_target_ex_vat,m.held_target_vat,m.held_target_inc_vat))
    from members m join totals t on t.component_key=m.component_key
      left join target_credit c on c.component_key=m.component_key left join target_hold h on h.component_key=m.component_key
  union all
  select p.component_key,p.line_id,null::uuid,null::text,p.component_kind,p.tax_treatment,p.work_date,
    p.approved_quantity,p.unit_label,p.a,p.c,p.h,p.source_basis_channel,coalesce(p.complete,false),true
    from parents p where not p.segmented;
end
$function$;

-- private.bpay_next_bound_source_snapshot_v1(uuid,bigint); supabase/repeatable/12102026_2146_banking_pay_next_treatment_bound_source_snapshot_v1.sql; SHA256 f6ee0ff2168d7cc4696f286168ff488213e2589c97a0f6c592c5062fbe076439
create or replace function private.bpay_next_bound_source_snapshot_v1(p_binding_version_id uuid,p_expected_book_revision bigint)
returns table(qualification_state text,selection_state text,candidate_id uuid,
  canonical_work_id uuid,canonical_component_key text,binding_version_id uuid,source_book_revision bigint,
  approval_work_id uuid,approval_revision_id uuid,approved_line_id uuid,head_id uuid,source_receipt_id uuid,
  source_channel text,tax_treatment text,classification_line_id uuid,valuation_policy_id uuid,
  approved_source_ex_vat private.bpay_next_penny_amount,
  native_realised_paye private.bpay_next_penny_amount,native_realised_umbrella private.bpay_next_penny_amount,
  native_held_paye private.bpay_next_penny_amount,native_held_umbrella private.bpay_next_penny_amount)
language plpgsql security definer
set search_path=pg_catalog,private,public
as $function$
declare v_version private.bpay_next_source_component_binding_version%rowtype;
  v_binding private.bpay_next_source_component_binding%rowtype;
  v_position private.bpay_next_position%rowtype;v_line private.bpay_next_approved_line%rowtype;
  v_revision private.bpay_next_work_revision%rowtype;v_count integer;
begin
  if p_binding_version_id is null or p_expected_book_revision is null or p_expected_book_revision<1 then
    raise exception using errcode='22023',message='BPAY_NEXT_BOUND_SNAPSHOT_ID_REQUIRED';end if;
  perform 1 from private.bpay_next_module_control c where c.id=1 and c.active_owner='NEXT' for share;
  if not found then raise exception using errcode='55000',message='BPAY_NEXT_BINDING_NEXT_REQUIRED';end if;
  select v.* into strict v_version from private.bpay_next_source_component_binding_version v where v.id=p_binding_version_id;
  perform 1 from private.bpay_next_worker_control c where c.candidate_id=v_version.candidate_id for share;
  if not found then raise exception using errcode='55000',message='BPAY_NEXT_SOURCE_BOOK_CONTROL_REQUIRED';end if;
  select b.* into strict v_binding from private.bpay_next_source_component_binding b
    where b.canonical_work_id=v_version.canonical_work_id and b.canonical_component_key=v_version.canonical_component_key for share;
  if v_binding.current_binding_version_id is distinct from p_binding_version_id then
    qualification_state:='SUPERSEDED';return next;return;end if;
  if v_version.origin_kind='INITIAL_AUTHORISED_TSFIN_V1' then
    perform private.bpay_next_initial_tsfin_bound_assert_v1(v_version.id);
  else
  if not exists(select 1 from public.weekly_source_entitlement_decision_bundles b
    where b.decision_bundle_id=v_version.decision_bundle_id and b.bundle_revision=v_version.bundle_revision
      and b.state='COMMITTED') then
    qualification_state:='BUNDLE_PENDING';return next;return;end if;
  end if;
  select p.* into v_position from private.bpay_next_position p
    where p.work_id=v_version.canonical_work_id and p.component_key=v_version.canonical_component_key for share;
  if not found then qualification_state:='POSITION_PENDING';return next;return;end if;
  -- Retain actual Position applicability during the native apply interval:
  -- Work.applied may still be the predecessor while this Position is new.
  if not exists(select 1 from private.bpay_next_work w where w.id=v_position.work_id
    and (v_position.applied_revision_id=w.current_revision_id or v_position.applied_revision_id=w.applied_revision_id)) then
    qualification_state:='POSITION_PENDING';return next;return;end if;
  if v_version.origin_kind='INITIAL_AUTHORISED_TSFIN_V1' then
    select pg_catalog.count(*) into v_count from private.bpay_next_publication p
      join private.bpay_next_work w on w.id=p.work_id
      join private.bpay_next_command c on c.id=p.command_id
      join private.bpay_next_command_member m on m.command_id=c.id and m.candidate_id=w.candidate_id
      join private.bpay_next_job j on j.command_id=c.id and j.candidate_id=w.candidate_id and j.job_kind='POSITION_APPLY'
      join private.bpay_next_worker_control ctl on ctl.candidate_id=w.candidate_id
      join private.bpay_next_module_control module on module.id=1 and module.active_owner='NEXT'
      where p.command_id=v_version.publication_command_id_1 and p.work_id=v_version.approval_work_id
        and p.revision_id=v_version.approval_revision_id and p.candidate_id=v_version.candidate_id
        and p.status='APPLIED' and p.phase='DONE' and p.applied_at_utc is not null
        and (case when w.current_revision_id is not null and exists(select 1 from private.bpay_next_work_revision cr where cr.id=w.current_revision_id and cr.sealed_at_utc is not null and cr.payment_treatment_approval_revision_id is not null) then private.bpay_next_treatment_approval_revision_v1(w.current_revision_id) else w.current_revision_id end)=p.revision_id and (case when w.applied_revision_id is not null and exists(select 1 from private.bpay_next_work_revision apr where apr.id=w.applied_revision_id and apr.sealed_at_utc is not null and apr.payment_treatment_approval_revision_id is not null) then private.bpay_next_treatment_approval_revision_v1(w.applied_revision_id) else w.applied_revision_id end)=p.revision_id
        and c.id=private.bpay_next_source_command_id_v1(v_version.initial_root_authorisation_id)
        and c.command_kind='POSITION_APPLY' and c.status='COMPLETE' and c.module_epoch=module.owner_epoch
        and c.expected_member_count=1 and c.enrolled_member_count=1 and c.sealed_at_utc is not null
        and j.status='DONE' and j.phase='DONE' and j.module_epoch=c.module_epoch
        and j.command_sequence=c.agency_sequence and j.owner_epoch>0 and j.owner_epoch<=ctl.active_owner_epoch
        and j.lease_nonce is null and j.lease_until_utc is null
        and (case when v_position.applied_revision_id is not null and exists(select 1 from private.bpay_next_work_revision pr where pr.id=v_position.applied_revision_id and pr.sealed_at_utc is not null and pr.payment_treatment_approval_revision_id is not null) then private.bpay_next_treatment_approval_revision_v1(v_position.applied_revision_id) else v_position.applied_revision_id end)=p.revision_id;
  else
  select pg_catalog.count(*) into v_count from private.bpay_next_source_binding_members_v1(v_version.source_receipt_id) m
    join private.bpay_next_publication p on p.command_id=m.publication_command_id
    join private.bpay_next_work w on w.id=m.work_id
    where p.status='APPLIED' and p.phase='DONE' and p.applied_at_utc is not null
      and (case when w.current_revision_id is not null and exists(select 1 from private.bpay_next_work_revision cr where cr.id=w.current_revision_id and cr.sealed_at_utc is not null and cr.payment_treatment_approval_revision_id is not null) then private.bpay_next_treatment_approval_revision_v1(w.current_revision_id) else w.current_revision_id end)=m.revision_id and (case when w.applied_revision_id is not null and exists(select 1 from private.bpay_next_work_revision apr where apr.id=w.applied_revision_id and apr.sealed_at_utc is not null and apr.payment_treatment_approval_revision_id is not null) then private.bpay_next_treatment_approval_revision_v1(w.applied_revision_id) else w.applied_revision_id end)=m.revision_id
      and ((m.publication_command_id=v_version.publication_command_id_1
            and m.work_id=v_version.publication_work_id_1 and m.revision_id=v_version.publication_revision_id_1)
        or (m.publication_command_id=v_version.publication_command_id_2
            and m.work_id=v_version.publication_work_id_2 and m.revision_id=v_version.publication_revision_id_2));
  end if;
  if v_count is distinct from (case when v_version.publication_command_id_2 is null then 1 else 2 end) then
    qualification_state:='PUBLICATION_PENDING';return next;return;end if;
  if v_position.source_book_state is distinct from 'READY' then qualification_state:='BOOK_UNBOUND';return next;return;end if;
  if v_position.source_book_revision is distinct from p_expected_book_revision then
    qualification_state:='BOOK_REVISION_STALE';return next;return;end if;
  if v_position.source_basis_channel is distinct from v_position.source_book_seed_channel
     or (v_position.source_book_seed_channel='PAYE' and
       (v_position.native_realised_paye is distinct from v_position.realised_source_ex_vat
        or v_position.native_held_paye is distinct from v_position.held_source_ex_vat))
     or (v_position.source_book_seed_channel='UMBRELLA' and
       (v_position.native_realised_umbrella is distinct from v_position.realised_source_ex_vat
        or v_position.native_held_umbrella is distinct from v_position.held_source_ex_vat)) then
    qualification_state:='BOOK_POSTING_REQUIRED';return next;return;end if;
  if v_version.tax_treatment is null or v_version.classification_line_id is null then
    qualification_state:='CLASSIFICATION_UNBOUND';return next;return;end if;
  select r.* into strict v_revision from private.bpay_next_work_revision r where r.id=v_version.approval_revision_id;
  if v_version.component_state='PRESENT' then
    select l.* into strict v_line from private.bpay_next_approved_line l where l.id=v_version.approved_line_id;
    approved_source_ex_vat:=v_line.source_pay_ex_vat;
  else
    if exists(select 1 from private.bpay_next_approved_line l
      where l.revision_id=v_version.approval_revision_id and l.component_key=v_version.approval_component_key) then
      raise exception using errcode='23514',message='BPAY_NEXT_BINDING_REMOVAL_LINE_CONFLICT';end if;
    approved_source_ex_vat:=0;
  end if;
  candidate_id:=v_version.candidate_id;canonical_work_id:=v_version.canonical_work_id;
  canonical_component_key:=v_version.canonical_component_key;binding_version_id:=v_version.id;
  source_book_revision:=v_position.source_book_revision;approval_work_id:=v_version.approval_work_id;
  approval_revision_id:=v_version.approval_revision_id;approved_line_id:=v_version.approved_line_id;
  head_id:=v_version.head_id;source_receipt_id:=v_version.source_receipt_id;source_channel:=v_version.approval_source_channel;
  tax_treatment:=v_version.tax_treatment;classification_line_id:=v_version.classification_line_id;
  valuation_policy_id:=v_revision.valuation_policy_id;
  native_realised_paye:=v_position.native_realised_paye;native_realised_umbrella:=v_position.native_realised_umbrella;
  native_held_paye:=v_position.native_held_paye;native_held_umbrella:=v_position.native_held_umbrella;
  selection_state:='UNBOUND';qualification_state:='READY';return next;
end
$function$;

-- private.bpay_next_initial_tsfin_bound_assert_v1(uuid); supabase/repeatable/07102026_0018_banking_pay_next_initial_tsfin_daily_evidence_v1.sql; SHA256 250470d891b2ab1c1bacd84368d405da0e7da03126b04b413f4d5d8600b0183c
create or replace function private.bpay_next_initial_tsfin_bound_assert_v1(p_binding_version_id uuid)
returns void language plpgsql security definer set search_path=pg_catalog,private,public
as $function$
declare v private.bpay_next_source_component_binding_version%rowtype;l private.bpay_next_approved_line%rowtype;
  cert jsonb;origin jsonb;basis jsonb;component jsonb;
begin
  select x.* into strict v from private.bpay_next_source_component_binding_version x where x.id=p_binding_version_id;
  if v.origin_kind is distinct from 'INITIAL_AUTHORISED_TSFIN_V1' then
    raise exception 'BPAY_NEXT_INITIAL_ORIGIN_REQUIRED' using errcode='23514';end if;
  cert:=private.bpay_next_initial_tsfin_certificate_v1(v.initial_root_authorisation_id);origin:=cert->'origin';basis:=cert->'basis';
  select value into strict component from jsonb_array_elements(cert->'components') x(value)
    where (value->>'component_id')::uuid=v.source_component_id;
  select x.* into strict l from private.bpay_next_approved_line x
    where x.revision_id=(cert->>'revision_id')::uuid and x.source_component_id=v.source_component_id;
  if (v.candidate_id,v.canonical_work_id,v.approval_work_id,v.approval_revision_id,v.publication_command_id_1,
      v.initial_financial_snapshot_id,v.initial_root_timesheet_id,v.initial_root_version,v.initial_authorisation_generation,
      v.initial_authorised_row_signature,v.initial_financial_snapshot_digest,v.initial_inventory_digest,v.initial_entitlement_digest,
      v.initial_detail_digest,v.initial_policy_digest,v.initial_certificate_digest,v.component_sha256)
    is distinct from ((cert->>'candidate_id')::uuid,(cert->>'work_id')::uuid,(cert->>'work_id')::uuid,(cert->>'revision_id')::uuid,
      (cert->>'command_id')::uuid,(origin->>'financial_snapshot_id')::uuid,(origin->>'root_timesheet_id')::uuid,
      (origin->>'root_version')::integer,(origin->>'authorisation_generation')::integer,origin->>'authorised_row_signature',
      decode(origin->>'financial_snapshot_digest','hex'),decode(basis->>'inventory_digest','hex'),decode(basis->>'entitlement_digest','hex'),
      decode(basis->>'detail_digest','hex'),decode(basis->>'policy_fingerprint','hex'),decode(cert->>'certificate_digest','hex'),
      decode(component->>'component_sha256','hex'))
     or (v.approved_line_id,v.classification_line_id,v.canonical_component_key,v.approval_component_key,
         v.approval_source_channel,v.tax_treatment,v.publication_work_id_1,v.publication_revision_id_1)
       is distinct from (l.id,l.id,l.component_key,l.component_key,cert->>'source_channel',l.tax_treatment,
         (cert->>'work_id')::uuid,(cert->>'revision_id')::uuid)
     or v.binding_digest is distinct from sha256(convert_to(jsonb_build_array('INITIAL_AUTHORISED_TSFIN_V1',v.canonical_work_id,
       v.canonical_component_key,v.approval_revision_id,v.approved_line_id,v.initial_root_authorisation_id,
       cert->>'certificate_digest',cert->>'command_id',component->>'component_sha256')::text,'UTF8'))
  then raise exception 'BPAY_NEXT_INITIAL_CAPTURE_CERTIFICATE_CHANGED' using errcode='23514';end if;
end
$function$;

-- private.bpay_next_initial_tsfin_certificate_v1(uuid); supabase/repeatable/12102026_2146_banking_pay_next_treatment_initial_source_certificate_v1.sql; SHA256 36babb4bebb9bb8649ef6999504f5b316e69324ca738768d59f57c7cc12f0548
create or replace function private.bpay_next_initial_tsfin_certificate_v1(p_root_authorisation_id uuid)
returns jsonb language plpgsql security definer
set search_path=pg_catalog,private,public
as $function$
declare
  a public.weekly_source_root_authorisations%rowtype;
  t public.timesheets%rowtype;f public.timesheets_financials%rowtype;
  w private.bpay_next_work%rowtype;r private.bpay_next_work_revision%rowtype;
  p private.bpay_next_publication%rowtype;c public.contracts%rowtype;
  inventory jsonb;basis jsonb;origin jsonb;details jsonb;n integer;epoch bigint;
begin
  if p_root_authorisation_id is null then
    raise exception 'BPAY_NEXT_INITIAL_AUTH_ID_REQUIRED' using errcode='22023';end if;
  select m.owner_epoch into epoch from private.bpay_next_module_control m
    where m.id=1 and m.active_owner='NEXT' for share;
  if epoch is null then raise exception 'BPAY_NEXT_BINDING_NEXT_REQUIRED' using errcode='55000';end if;
  select x.* into strict a from public.weekly_source_root_authorisations x where x.id=p_root_authorisation_id;
  select x.* into strict t from public.timesheets x where x.timesheet_id=a.root_timesheet_id;
  select x.* into strict c from public.contracts x where x.id=t.contract_id;
  select x.* into strict r from private.bpay_next_work_revision x where x.source_event_id=a.id;
  select x.* into strict w from private.bpay_next_work x where x.id=r.work_id;
  select x.* into strict f from public.timesheets_financials x where x.id=r.financial_snapshot_id;
  select x.* into strict p from private.bpay_next_publication x
    where x.command_id=private.bpay_next_source_command_id_v1(a.id);
  if a.withdrawn_at_utc is not null or a.current_entitlement_head_id is not null
     or exists(select 1 from public.weekly_source_entitlement_heads h where btrim(h.root_family_booking_id)=btrim(t.booking_id))
     or t.is_current is distinct from true or t.authorised_at_server is null
     or t.revoked_at is not null or t.archived_at_utc is not null
     or (a.family_booking_id,a.timesheet_version) is distinct from (t.booking_id,t.version)
     or (w.work_kind,w.candidate_id,w.contract_id,w.original_timesheet_id,w.booking_id,w.week_ending_date,(case when w.current_revision_id is not null and exists(select 1 from private.bpay_next_work_revision cr where cr.id=w.current_revision_id and cr.sealed_at_utc is not null and cr.payment_treatment_approval_revision_id is not null) then private.bpay_next_treatment_approval_revision_v1(w.current_revision_id) else w.current_revision_id end))
       is distinct from ('SOURCE'::text,c.candidate_id,c.id,t.timesheet_id,t.booking_id,t.week_ending_date,r.id)
     or w.approval_state is distinct from 'APPROVED'
     or (r.source_kind,r.source_head_id,r.source_event_id,r.physical_timesheet_id,r.physical_timesheet_version,r.week_ending_date)
       is distinct from ('SOURCE'::text,null::uuid,a.id,t.timesheet_id,t.version,t.week_ending_date)
     or r.approved_at_utc is null or r.sealed_at_utc is null
     or f.is_current is distinct from true or f.is_stale is distinct from false or f.authorised_at_utc is null
     or (f.timesheet_id,f.timesheet_version,f.candidate_id,f.client_id)
       is distinct from (t.timesheet_id,t.version,w.candidate_id,c.client_id)
     or (p.work_id,p.revision_id,p.candidate_id,p.revision_no)
       is distinct from (w.id,r.id,w.candidate_id,r.revision_no)
     or not exists(select 1 from private.bpay_next_command command
       join private.bpay_next_command_member member on member.command_id=command.id and member.candidate_id=w.candidate_id
       where command.id=p.command_id and command.command_kind='POSITION_APPLY'
         and command.module_epoch=epoch and command.status in ('SEALED','COMPLETE')
         and command.sealed_at_utc is not null and command.expected_member_count=1 and member.member_no=1
         -- INITIAL_METADATA_PHASE_V2_BEGIN: no fabricated enrollment/job.
         and ((command.status='SEALED' and command.enrolled_member_count=0
           and p.status='QUEUED' and p.phase='NEW' and p.applied_at_utc is null
           and not exists(select 1 from private.bpay_next_job job where job.command_id=command.id))
          or (command.status='COMPLETE' and command.enrolled_member_count=1
           and p.status='APPLIED' and p.phase='DONE' and p.applied_at_utc is not null
           and (select count(*) from private.bpay_next_job job where job.command_id=command.id)=1
           and exists(select 1 from private.bpay_next_job job
             join private.bpay_next_worker_control ctl on ctl.candidate_id=job.candidate_id
             where job.command_id=command.id and job.candidate_id=w.candidate_id
               and job.job_kind='POSITION_APPLY' and job.command_sequence=command.agency_sequence
               and job.module_epoch=command.module_epoch and job.status='DONE' and job.phase='DONE'
               and job.owner_epoch>0 and job.owner_epoch<=ctl.active_owner_epoch
               and job.lease_nonce is null and job.lease_until_utc is null)))
         -- INITIAL_METADATA_PHASE_V2_END
       )
  then raise exception 'BPAY_NEXT_INITIAL_AUTH_NOT_CURRENT' using errcode='55000';end if;
  inventory:=private.weekly_source_effective_inventory_v1(t.timesheet_id);
  basis:=inventory->'approval_basis';origin:=basis->'origin';
  details:=jsonb_build_object('segments',f.invoice_breakdown_json->'segments','additional_units',f.additional_units_json,
    'actual_schedule',f.actual_schedule_json,'rate_source_refs',f.rate_source_refs_json);
  if inventory->>'ok' is distinct from 'true' or inventory->>'authority' is distinct from 'TSFIN'
     or inventory->>'head_id' is not null or jsonb_typeof(inventory->'components') is distinct from 'array'
     or jsonb_typeof(basis) is distinct from 'object' or basis->'coverage_complete' is distinct from 'true'::jsonb
     or basis is distinct from private.weekly_source_inventory_approval_basis_v2(t.timesheet_id,inventory)
     or origin is distinct from jsonb_build_object('kind','INITIAL_AUTHORISED_TSFIN_V1',
       'root_authorisation_id',a.id,'financial_snapshot_id',f.id,'authorisation_generation',a.authorisation_generation,
       'root_timesheet_id',t.timesheet_id,'root_version',t.version::text,'authorised_row_signature',a.authorised_row_signature,
       'financial_snapshot_digest',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_APPROVED_FINANCIAL_SNAPSHOT_V2',
         jsonb_build_object('policy',f.policy_snapshot_json,'details',details,'components',inventory->'components')),'hex'),
       'inventory_digest',basis->>'inventory_digest','entitlement_digest',basis->>'entitlement_digest')
     or basis->>'detail_digest' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_APPROVED_DETAIL_V2',details),'hex')
     or basis->>'policy_fingerprint' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_APPROVED_POLICY_V2',f.policy_snapshot_json),'hex')
     or r.source_inventory_digest is distinct from decode(basis->>'inventory_digest','hex')
     or r.approved_source_ex_vat is distinct from (basis->>'approved_pay_ex_vat')::numeric
     or r.expected_line_count is distinct from jsonb_array_length(inventory->'components')
  then raise exception 'BPAY_NEXT_INITIAL_I1_CERTIFICATE_REQUIRED' using errcode='55000';end if;
  select count(*) into n from private.bpay_next_approved_line l where l.revision_id=r.id;
  if n<>r.expected_line_count or exists(select 1 from jsonb_array_elements(inventory->'components') component
      left join private.bpay_next_approved_line l on l.revision_id=r.id
        and l.source_component_id=(component.value->>'component_id')::uuid
        and l.component_key='SOURCE:'||(component.value->>'component_id')
      where l.id is null or l.line_no is distinct from (component.value->>'component_ordinal')::integer
        or l.evidence_ref is distinct from 'source-component:'||(component.value->>'component_id')||'#'||(component.value->>'component_sha256')
        or l.source_pay_ex_vat is distinct from case when (component.value->>'exclude_from_pay')::boolean then 0 else (component.value->>'pay_ex_vat')::numeric end
        or l.component_kind is distinct from case component.value->>'component_kind' when 'WORKED_TIME' then 'WORK' when 'ADDITIONAL_UNIT' then 'ADDITIONAL' else 'EXPENSE' end
        or l.tax_treatment is distinct from case when component.value->>'component_kind' in ('WORKED_TIME','ADDITIONAL_UNIT') then 'TAXABLE'::text
          when component.value->>'component_kind' in ('EXPENSE','SOURCE_FIXED_EXPENSE') then 'NON_TAXABLE'::text else null::text end)
  then raise exception 'BPAY_NEXT_INITIAL_SEALED_COMPONENTS_MISMATCH' using errcode='23514';end if;
  return jsonb_build_object('candidate_id',w.candidate_id,'work_id',w.id,'revision_id',r.id,'command_id',p.command_id,
    'source_channel',r.source_pay_channel,'origin',origin,'basis',basis,'components',inventory->'components',
    'certificate_digest',encode(private.weekly_source_sha256_jsonb_v1('BPAY_NEXT_INITIAL_TSFIN_CERTIFICATE_V1',basis),'hex'));
end
$function$;

-- private.bpay_next_source_binding_members_v1(uuid); supabase/repeatable/06102026_1246_banking_pay_next_source_book_binding_v1.sql; SHA256 771eaefe07928ff4a93abb73e8d5073f7bf1f9addda5ddd9b629a786053efa36
create or replace function private.bpay_next_source_binding_members_v1(p_receipt_id uuid)
returns table(candidate_id uuid,member_no integer,head_id uuid,prior_head_id uuid,
  work_id uuid,revision_id uuid,publication_command_id uuid,predecessor_revision_id uuid)
language plpgsql security definer
set search_path=pg_catalog,private,public
as $function$
declare
  v_receipt private.weekly_source_entitlement_publication_receipts%rowtype;
  v_n integer; v_i integer; v_row record;
begin
  select r.* into strict v_receipt from private.weekly_source_entitlement_publication_receipts r
    where r.id=p_receipt_id;
  v_n:=pg_catalog.cardinality(v_receipt.head_ids);
  if v_n not between 1 and 2 or not exists (
    select 1 from public.weekly_source_entitlement_decision_bundles b
    where b.decision_bundle_id=v_receipt.decision_bundle_id and b.bundle_revision=v_receipt.bundle_revision
      and b.candidate_id=v_receipt.candidate_id and b.state in ('PROPOSED','COMMITTED')
      and b.request_digest=v_receipt.request_digest and b.decision_id=v_receipt.decision_id
      and b.decided_by_user_id=v_receipt.decided_by_user_id) then
    raise exception using errcode='55000',message='BPAY_NEXT_BINDING_RECEIPT_NOT_QUALIFIED';
  end if;
  for v_i in 1..v_n loop
    select h.id,h.prior_head_id,w.id as work_id,r.id as revision_id,
           p.command_id,coalesce(p.predecessor_revision_id,
             case when p.command_id is null and w.current_revision_id is distinct from r.id
               then w.current_revision_id end) as predecessor_revision_id into v_row
      from public.weekly_source_entitlement_heads h
      join public.weekly_source_root_authorisations a on a.root_timesheet_id=h.root_timesheet_id
        and a.withdrawn_at_utc is null and a.current_entitlement_head_id=h.id
      join private.bpay_next_work w on w.original_timesheet_id=h.root_timesheet_id
        and w.booking_id=h.root_family_booking_id and w.candidate_id=h.candidate_id
        and w.contract_id=h.contract_id and w.week_ending_date=h.week_ending_date and w.work_kind='SOURCE'
      join private.bpay_next_work_revision r on r.work_id=w.id and r.source_head_id=h.id and r.source_event_id=h.id
        and r.physical_timesheet_id=h.root_timesheet_id and r.physical_timesheet_version=h.root_timesheet_version
        and r.source_kind in ('SOURCE','PROTECTED')
      left join private.bpay_next_publication p on p.work_id=w.id and p.revision_id=r.id
        and p.candidate_id=w.candidate_id
      where h.id=v_receipt.head_ids[v_i] and h.state='COMMITTED_CURRENT'
        and h.candidate_id=v_receipt.candidate_id and h.root_timesheet_id=v_receipt.member_root_ids[v_i]
        and h.root_family_booking_id=v_receipt.member_family_booking_ids[v_i]
        and h.root_timesheet_version=v_receipt.member_root_versions[v_i]
        and h.decision_bundle_id=v_receipt.decision_bundle_id and h.bundle_revision=v_receipt.bundle_revision
        and h.publication_receipt_digest=v_receipt.request_digest
        and h.scope_change_tx_token=v_receipt.scope_change_tx_token;
    if not found then
      raise exception using errcode='55000',message='BPAY_NEXT_BINDING_MEMBER_NOT_CURRENT';
    end if;
    candidate_id:=v_receipt.candidate_id; member_no:=v_i; head_id:=v_row.id;
    prior_head_id:=v_row.prior_head_id; work_id:=v_row.work_id; revision_id:=v_row.revision_id;
    publication_command_id:=v_row.command_id; predecessor_revision_id:=v_row.predecessor_revision_id;
    return next;
  end loop;
end
$function$;

-- private.bpay_next_work_segment_gross_balance_v1(uuid,text,text); supabase/repeatable/10102026_1236_banking_pay_next_segment_authority_final_v1.sql; SHA256 96e70b650ed344ef419112ffcdebcf167baedca5ffc035ee79066fe1ad5d6045
create or replace function private.bpay_next_work_segment_gross_balance_v1(
  p_work_id uuid,p_component_key text,p_segment_key text)
returns table(realised_source_ex_vat numeric,active_held_source_ex_vat numeric)
language sql stable security invoker set search_path=pg_catalog,private
as $function$
  select coalesce((select sum(e.source_disposition_ex_vat) from private.bpay_next_work_segment_effect_share e
      where e.work_id=p_work_id and e.component_key=p_component_key and e.segment_key=p_segment_key),0),
    coalesce((select sum(s.source_reserved_ex_vat) from private.bpay_next_work_segment_origin_share s
      join private.bpay_next_hold h on h.id=s.hold_id and h.status='ACTIVE'
      where s.work_id=p_work_id and s.component_key=p_component_key and s.segment_key=p_segment_key),0)
$function$;

-- private.weekly_source_pay_query_gate_v1(uuid); supabase/repeatable/05102026_0308_weekly_source_pay_query_gate_v1.sql; SHA256 31992d662b68652d1d32851110704a6d31c17cbb15f09a4e8d5e664afab17526
create or replace function private.weekly_source_pay_query_gate_v1(p_root_timesheet_id uuid)
returns jsonb language sql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
  select private.weekly_source_pay_query_facts_v1(p_root_timesheet_id)-'hours_incidents'-'manual_reviews';
$function$;

-- private.weekly_source_accepted_removal_query_evidence_v1(uuid,uuid,uuid,uuid,uuid); supabase/repeatable/05102026_0650_weekly_source_accepted_removal_query_evidence_v1.sql; SHA256 dcc3262c28a32376059e0665bdf569b29ff1371f9d6065d62e63b99947773028
create or replace function private.weekly_source_accepted_removal_query_evidence_v1(
  p_review_id uuid,p_approval_id uuid,p_generation_id uuid,p_actor_user_id uuid,p_command_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_review private.weekly_source_manual_reviews%rowtype;
  v_anchor private.weekly_source_manual_review_commands%rowtype;
  v_approval public.weekly_exceptional_payment_approvals%rowtype;
  v_generation public.weekly_exceptional_pay_generations%rowtype;
  v_run public.weekly_exceptional_orchestration_runs%rowtype;
  v_event public.weekly_exceptional_pay_family_events%rowtype;
  v_local private.weekly_source_local_protected_decision_receipts%rowtype;
  v_status jsonb; v_witness jsonb; v_scope jsonb; v_result jsonb;
begin
  if p_review_id is null or p_approval_id is null or p_generation_id is null
     or p_actor_user_id is null or p_command_id is null then
    raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_IDENTITY_REQUIRED' using errcode='22023'; end if;
  select * into strict v_review from private.weekly_source_manual_reviews where id=p_review_id and state='OPEN';
  select * into strict v_approval from public.weekly_exceptional_payment_approvals where id=p_approval_id;
  select * into strict v_generation from public.weekly_exceptional_pay_generations where id=p_generation_id;
  select * into strict v_run from public.weekly_exceptional_orchestration_runs where id=v_approval.creation_orchestration_run_id;
  if v_run.request_kind not in ('WITHDRAW','RECONCILE')
     or v_generation.reason is distinct from v_run.request_kind
     or v_generation.family_id is distinct from v_approval.pay_target_family_id
     or v_run.family_id is distinct from v_generation.family_id
     or v_run.requested_by_user_id is distinct from p_actor_user_id
     or v_approval.approved_by_user_id is distinct from p_actor_user_id
     or v_approval.work_event_id is distinct from v_review.work_event_id
     or v_approval.candidate_id is distinct from v_review.candidate_id
     or v_approval.client_id is distinct from v_review.client_id
     or v_approval.contract_id is distinct from v_review.contract_id
     or v_approval.protected_work_date is distinct from v_review.work_date
  then raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_SCOPE_INVALID' using errcode='55000'; end if;
  v_status:=private.weekly_source_local_saved_status_v1(v_run.family_id,v_run.id,p_actor_user_id);
  if v_status is null or v_status->>'publication_request_id' is distinct from p_command_id::text
     or v_status->>'generation_id' is distinct from p_generation_id::text then
    raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_RECEIPT_REQUIRED' using errcode='55000'; end if;
  select * into strict v_local from private.weekly_source_local_protected_decision_receipts
    where publication_request_id=p_command_id;
  -- No competing C1/NEXT lane, including partial or contradictory evidence.
  if (select count(*) from public.weekly_exceptional_c1_publication_requests r
      where r.generation_id=v_generation.id or r.orchestration_run_id=v_run.id)<>1
     or exists(select 1 from private.bpay_next_protected_source_receipt r
       where r.generation_id=v_generation.id or r.approval_id=v_approval.id or r.orchestration_run_id=v_run.id)
  then raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_RECEIPT_CONFLICT' using errcode='55000'; end if;
  select * into strict v_event from public.weekly_exceptional_pay_family_events e
    where e.family_id=v_run.family_id and e.durable_work_event_id=v_review.work_event_id
      and not exists(select 1 from public.weekly_exceptional_pay_family_events newer
        where newer.family_id=e.family_id and newer.durable_work_event_id=e.durable_work_event_id
          and newer.event_sequence>e.event_sequence);
  if v_event.state is distinct from 'ACCEPTED_SOURCE' or v_event.evidence_approval_id is distinct from v_approval.id
     or v_event.office_actor_user_id is distinct from p_actor_user_id
     or private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_SOURCE_PROPOSAL_V1',
       v_event.source_proposal_snapshot_json) is distinct from v_event.source_proposal_hash
     or not exists(select 1 from public.weekly_exceptional_pay_target_events t
       where t.family_id=v_run.family_id and t.approval_id=v_approval.id and t.financial_generation_id=v_generation.id
         and t.reason=v_run.request_kind and t.actor_user_id=p_actor_user_id
         and t.current_source_proposal_snapshot=v_event.source_proposal_snapshot_json
         and t.complete_next_family_vector_fingerprint=v_generation.complete_next_vector_hash)
  then raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_EVENT_REQUIRED' using errcode='55000'; end if;
  select * into v_anchor from private.weekly_source_manual_review_commands c where c.review_id=v_review.id
    and (c.opening_final_revision_id is not null or c.opening_projection_publication_id is not null);
  if found then
    if (v_anchor.opening_target_family_id is not null and v_anchor.opening_target_family_id<>v_run.family_id)
       or v_event.event_sequence<=v_anchor.opening_event_sequence then
      raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_PREOPENING_ACTION' using errcode='55000'; end if;
  elsif v_approval.approved_at_utc<v_review.opened_at_utc then
    raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_PREOPENING_ACTION' using errcode='55000'; end if;
  v_scope:=private.weekly_source_pay_query_scope_v1(v_local.root_timesheet_id);
  if v_scope is null or v_scope->>'target_family_id' is distinct from v_run.family_id::text
     or v_scope->>'candidate_id' is distinct from v_review.candidate_id::text
     or v_scope->>'client_id' is distinct from v_review.client_id::text
     or v_scope->>'contract_id' is distinct from v_review.contract_id::text then
    raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_SCOPE_INVALID' using errcode='55000'; end if;
  v_witness:=private.weekly_source_selected_source_witness_v1(v_run.family_id,v_approval.source_cycle_id,v_review.work_event_id);
  if v_witness is null or v_witness->'source_proposal' is distinct from v_event.source_proposal_snapshot_json
     or v_witness#>>'{scope,source_group_id}' is distinct from v_review.source_group_id::text then
    raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_SOURCE_UNAVAILABLE' using errcode='55000'; end if;
  if v_local.result_json->>'authority'='COMMON_ENTITLEMENT_HEAD'
     and (v_local.approved_snapshot_json#>>'{local_source_qualification,schema_version}'
        is distinct from 'PROTECTED_LOCAL_SOURCE_QUALIFICATION_V2'
       or v_local.approved_snapshot_json#>>'{local_source_qualification,source_proposal_hash}'
        is distinct from encode(v_event.source_proposal_hash,'hex')) then
    raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_SOURCE_UNAVAILABLE' using errcode='55000'; end if;
  if v_witness->>'kind'='CURRENT_ROW' then
    -- A provisional positive row is not the Final-only zero proposal accepted
    -- by removal. Never silently convert that mismatch into source acceptance.
    if v_witness#>>'{basis,source_cycle_id}' is distinct from v_review.source_cycle_id::text
       or v_witness#>>'{basis,final_revision_id}' is null
       or v_witness#>>'{basis,final_revision_id}' is distinct from v_event.source_proposal_snapshot_json->>'source_revision'
       or v_event.source_proposal_snapshot_json->'source_present' is distinct from 'true'::jsonb
    then raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_SOURCE_MISMATCH' using errcode='55000'; end if;
  elsif v_witness->>'kind'='CERTIFIED_ABSENCE' then
    if v_event.source_proposal_snapshot_json->'source_present' is distinct from 'false'::jsonb
       or v_event.source_proposal_snapshot_json->>'source_minutes' is distinct from '0' then
      raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_SOURCE_MISMATCH' using errcode='55000'; end if;
  else raise exception 'WEEKLY_SOURCE_ACCEPTED_REMOVAL_SOURCE_UNAVAILABLE' using errcode='55000'; end if;
  v_result:=jsonb_build_object('lane','SOURCE_LOCAL_ACCEPTED_SOURCE','scope',v_scope,
    'approval_id',v_approval.id,'generation_id',v_generation.id,'publication_request_id',p_command_id,
    'request_sha256',v_status->'request_sha256','result_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_PROTECTED_LOCAL_RESULT_V1',v_local.result_json),'hex'),'selected_source_witness',v_witness);
  return v_result;
end;
$function$;

-- private.weekly_source_local_saved_status_v1(uuid,uuid,uuid); supabase/repeatable/05102026_0624_weekly_source_local_saved_status_v1.sql; SHA256 1ff5fcfcfb1a9af2014a6cf4f130ae735a46315f2d231f68add210575f5b1b89
create or replace function private.weekly_source_local_saved_status_v1(
  p_family_id uuid,p_orchestration_run_id uuid,p_actor_user_id uuid
) returns jsonb
language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
declare
  v_scope jsonb;
  v_approval public.weekly_exceptional_payment_approvals%rowtype;
  v_generation public.weekly_exceptional_pay_generations%rowtype;
  v_local private.weekly_source_local_protected_decision_receipts%rowtype;
  v_request public.weekly_exceptional_c1_publication_requests%rowtype;
  v_run public.weekly_exceptional_orchestration_runs%rowtype;
  v_event public.weekly_exceptional_pay_family_events%rowtype;
  v_original_event public.weekly_exceptional_pay_family_events%rowtype;
  v_publication private.weekly_source_entitlement_publication_receipts%rowtype;
  v_pending public.weekly_source_pending_entitlement_bundles%rowtype;
  v_head public.weekly_source_entitlement_heads%rowtype;
  v_canonical jsonb;
  v_choice jsonb;
  v_entitlement jsonb;
  v_components jsonb;
  v_origin jsonb;
  v_basis jsonb;
  v_snapshot jsonb;
  v_publication_root public.timesheets%rowtype;
  v_publication_version integer;
  v_prior_inventory jsonb;
  v_before_origin jsonb;
  v_qualification jsonb;
  v_result_hash bytea;
  v_member integer;
  v_count integer;
  v_cycle public.weekly_source_cycles%rowtype;
  v_step public.weekly_exceptional_orchestration_steps%rowtype;
  p_approval_id uuid;
  p_generation_id uuid;
begin
  if p_family_id is null or p_orchestration_run_id is null or p_actor_user_id is null then
    raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_IDENTITY_REQUIRED' using errcode='22023';
  end if;
  -- NULL means no Local evidence at all, never a malformed or partial receipt.
  -- Do not inspect current WAIT, financial authorisation or generation pointers.
  select count(*) into v_count from public.weekly_exceptional_c1_publication_requests r
    where r.family_id=p_family_id and r.orchestration_run_id=p_orchestration_run_id;
  if v_count=0 then
    if exists(select 1 from private.weekly_source_local_protected_decision_receipts l
      join public.weekly_exceptional_c1_publication_requests r on r.id=l.publication_request_id
      where r.orchestration_run_id=p_orchestration_run_id)
    then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    return null;
  end if;
  if v_count<>1 then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  select r.* into strict v_request from public.weekly_exceptional_c1_publication_requests r
    where r.family_id=p_family_id and r.orchestration_run_id=p_orchestration_run_id;
  select l.* into v_local from private.weekly_source_local_protected_decision_receipts l
    where l.publication_request_id=v_request.id;
  if not found then
    if v_request.state='RETIRED'
       or v_request.typed_result_json->>'authority' in ('UNAUTHORISED_TSFIN','COMMON_ENTITLEMENT_HEAD')
    then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    return null;
  end if;
  if v_local.family_id is distinct from p_family_id
     or v_local.actor_user_id is distinct from p_actor_user_id
     or v_local.generation_id is distinct from v_request.generation_id
     or v_request.orchestration_run_id is distinct from p_orchestration_run_id then
    raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
  end if;
  select count(*) into v_count from public.weekly_exceptional_payment_approvals a
    where a.creation_orchestration_run_id=p_orchestration_run_id and a.pay_target_family_id=p_family_id;
  if v_count<>1 then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  select a.id into strict p_approval_id from public.weekly_exceptional_payment_approvals a
    where a.creation_orchestration_run_id=p_orchestration_run_id and a.pay_target_family_id=p_family_id;
  p_generation_id:=v_local.generation_id;
  select jsonb_build_object('root_timesheet_id',t.timesheet_id,'root_version',
      v_local.approved_snapshot_json->'timesheet_version','family_booking_id',t.booking_id,
      'target_family_id',p_family_id,'candidate_id',a.candidate_id,'client_id',a.client_id,
      'contract_id',a.contract_id,'week_ending_date',to_char(a.week_ending,'YYYY-MM-DD'),
      'family_bound_version',v_local.result_json->'family_bound_version')
    into strict v_scope
    from public.timesheets t
    join public.weekly_exceptional_payment_approvals a on a.id=p_approval_id
    join public.contracts c on c.id=t.contract_id
    join public.weekly_exceptional_pay_target_families family on family.id=p_family_id
    where t.timesheet_id=v_local.root_timesheet_id
      and c.candidate_id=a.candidate_id and c.client_id=a.client_id
      and family.candidate_id=a.candidate_id and family.contract_id=a.contract_id
      and family.week_ending_date=a.week_ending
      and t.contract_id=v_request.contract_id and t.week_ending_date=v_request.week_ending_date;
  select a.* into v_approval from public.weekly_exceptional_payment_approvals a
    where a.id=p_approval_id;
  if not found or v_approval.pay_target_family_id::text is distinct from v_scope->>'target_family_id'
     or v_approval.candidate_id::text is distinct from v_scope->>'candidate_id'
     or v_approval.client_id::text is distinct from v_scope->>'client_id'
     or v_approval.contract_id::text is distinct from v_scope->>'contract_id'
     or to_char(v_approval.week_ending,'YYYY-MM-DD') is distinct from v_scope->>'week_ending_date'
     or v_approval.protected_work_date not between
        (v_scope->>'week_ending_date')::date-6 and (v_scope->>'week_ending_date')::date then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  if not exists(select 1 from public.weekly_work_events w
    where w.id=v_approval.work_event_id and w.candidate_id=v_approval.candidate_id
      and w.client_id=v_approval.client_id and w.work_date=v_approval.protected_work_date) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  -- Original report cutoff is the Office permission boundary, not today's
  -- work week or the report most recently imported for another shift.
  select c.* into strict v_cycle from public.weekly_source_cycles c
    where c.id=v_approval.source_cycle_id;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'APPROVE_PROTECTED_PAY',
    v_cycle.source_group_id,v_approval.client_id,v_cycle.finalisation_week_ending);
  select g.* into v_generation from public.weekly_exceptional_pay_generations g
    where g.id=p_generation_id and g.family_id=v_approval.pay_target_family_id;
  if not found or private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_COMPLETE_VECTOR_V1',
       v_generation.complete_next_vector_json) is distinct from v_generation.complete_next_vector_hash
     or not exists(select 1 from public.weekly_exceptional_pay_target_events t
       where t.family_id=v_approval.pay_target_family_id and t.approval_id=v_approval.id
         and t.financial_generation_id=v_generation.id
         and t.complete_next_family_vector_fingerprint=v_generation.complete_next_vector_hash) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  select l.* into v_local from private.weekly_source_local_protected_decision_receipts l
    where l.generation_id=v_generation.id;
  if not found or v_local.family_id is distinct from v_approval.pay_target_family_id
     or v_local.actor_user_id is distinct from v_approval.approved_by_user_id
     or v_local.state not in ('COMPLETE','PENDING_FREEZE')
     or v_local.completed_at_utc is null or not isfinite(v_local.completed_at_utc) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  -- Accepted evidence belongs to its original physical root/version. A lawful
  -- later rotation must not invalidate the same raw booking family's receipt.
  -- Point-read that pinned root; never choose an arbitrary historical winner.
  select t.* into v_publication_root from public.timesheets t
    where t.timesheet_id=v_local.root_timesheet_id;
  if not found or v_publication_root.booking_id is distinct from v_scope->>'family_booking_id'
     or v_publication_root.contract_id is distinct from v_approval.contract_id
     or v_publication_root.week_ending_date is distinct from v_approval.week_ending
     or v_publication_root.sheet_scope is distinct from 'WEEKLY'
     or v_publication_root.line_type is distinct from 'HOURS'
     or v_publication_root.is_adjustment is distinct from false
     or v_local.approved_snapshot_json->>'timesheet_id' is distinct from v_local.root_timesheet_id::text
     or jsonb_typeof(v_local.approved_snapshot_json->'timesheet_version') is distinct from 'number'
     or coalesce(v_local.approved_snapshot_json->>'timesheet_version','') !~ '^[1-9][0-9]*$'
     or (v_local.approved_snapshot_json->>'timesheet_version')::numeric>2147483647 then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  v_publication_version:=(v_local.approved_snapshot_json->>'timesheet_version')::integer;
  select r.* into v_request from public.weekly_exceptional_c1_publication_requests r
    where r.id=v_local.publication_request_id;
  if not found or v_request.state is distinct from 'RETIRED'
     or v_request.completed_at_utc is null or not isfinite(v_request.completed_at_utc)
     or v_request.family_id is distinct from v_local.family_id
     or v_request.generation_id is distinct from v_generation.id
     or v_request.orchestration_run_id is distinct from v_approval.creation_orchestration_run_id
     or v_request.root_timesheet_id is distinct from v_local.root_timesheet_id
     or v_request.candidate_id is distinct from v_approval.candidate_id
     or v_request.contract_id is distinct from v_approval.contract_id
     or v_request.week_ending_date is distinct from v_approval.week_ending
     or v_request.request_sha256 is distinct from v_local.request_sha256
     or v_request.typed_result_json is distinct from v_local.result_json
     or v_request.c1_operation_id is not null or v_request.c1_publication_id is not null
     or v_request.c1_head_revision is not null or v_request.c1_receipt_sha256 is not null then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  select r.* into v_run from public.weekly_exceptional_orchestration_runs r
    where r.id=v_approval.creation_orchestration_run_id;
  v_result_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_LOCAL_RESULT_V1',v_local.result_json);
  if not found or v_run.family_id is distinct from v_local.family_id
     or v_run.requested_by_user_id is distinct from v_local.actor_user_id
     or v_run.state is distinct from 'COMPLETE' or v_run.completed_at_utc is null
     or not isfinite(v_run.completed_at_utc)
     or v_run.after_state_fingerprint is distinct from v_result_hash
     or v_local.result_json->'ok' is distinct from 'true'::jsonb
     or v_local.result_json->'idempotent_replay' is distinct from 'false'::jsonb
     or v_local.result_json->>'family_id' is distinct from v_local.family_id::text
     or v_local.result_json->>'generation_id' is distinct from v_generation.id::text
     or v_local.result_json->>'publication_request_id' is distinct from v_request.id::text
     or coalesce(v_local.result_json->>'family_bound_version','') !~ '^[1-9][0-9]*$'
     or (v_local.result_json->>'family_bound_version')::numeric>
          (v_scope->>'family_bound_version')::numeric then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  v_snapshot:=v_generation.complete_next_vector_json#>'{target_snapshot,tsfin_snapshot_json}';
  if jsonb_typeof(v_snapshot) is distinct from 'object'
     or v_snapshot is distinct from v_approval.approved_target_pay_components_json->'tsfin_snapshot_json' then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  if v_local.state='COMPLETE' then
    -- A different sibling may have superseded this accepted generation. Its
    -- immutable published proof is still needed for this unchanged WAIT event.
    if v_generation.lifecycle_state not in ('PUBLISHED','SUPERSEDED')
       or v_generation.published_at_utc is null or not isfinite(v_generation.published_at_utc)
       or v_generation.result_hash is distinct from v_result_hash
       or v_local.result_json->>'outcome' is distinct from 'PUBLISHED'
       or v_local.result_json->>'state' is distinct from 'LIVE' then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  elsif v_generation.lifecycle_state not in ('PENDING_C1','SUPERSEDED')
     or v_generation.published_at_utc is not null or v_generation.result_hash is not null
     or v_local.result_json->>'outcome' is distinct from 'SAVED_PENDING_FREEZE'
     or v_local.result_json->>'state' is distinct from 'PENDING' then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
  end if;
  if v_local.result_json->>'authority'='UNAUTHORISED_TSFIN' then
    if v_local.state<>'COMPLETE'
       or v_local.result_json->'requires_first_authorisation' is distinct from 'true'::jsonb then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    v_basis:=v_local.approved_snapshot_json->'saved_unauthorised_basis';
    if private.weekly_exceptional_json_keys_exact_v1(v_basis,array['schema_version',
       'financial_snapshot_id','financial_snapshot_sha256','detail_sha256','inventory_sha256',
       'root_version','family_booking_id']) is distinct from true
       or not (v_basis ?& array['schema_version','financial_snapshot_id','financial_snapshot_sha256',
          'detail_sha256','inventory_sha256','root_version','family_booking_id'])
       or v_basis->>'schema_version' is distinct from 'SAVED_UNAUTHORISED_LOCAL_V1'
       or v_basis->>'family_booking_id' is distinct from v_scope->>'family_booking_id'
       or v_basis->>'root_version' is distinct from v_publication_version::text
       or v_basis->>'financial_snapshot_id' is distinct from v_local.result_json->>'timesheet_financials_id'
       or coalesce(v_basis->>'financial_snapshot_sha256','') !~ '^[0-9a-f]{64}$'
       or coalesce(v_basis->>'detail_sha256','') !~ '^[0-9a-f]{64}$'
       or v_basis->>'inventory_sha256' is distinct from encode(v_generation.complete_next_vector_hash,'hex')
       or (v_local.approved_snapshot_json-'saved_unauthorised_basis') is distinct from
          (v_snapshot||jsonb_build_object('timesheet_id',v_local.root_timesheet_id::text,
           'timesheet_version',v_publication_version,'actual_schedule_json',
           v_generation.complete_next_vector_json#>'{target_snapshot,actual_schedule_json}'))
       or not exists(select 1 from public.timesheets_financials f
         where f.id::text=v_basis->>'financial_snapshot_id'
           and f.timesheet_id=v_local.root_timesheet_id
           and f.timesheet_version=v_publication_version
           and f.candidate_id=v_approval.candidate_id and f.client_id=v_approval.client_id) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    -- This is accepted decision evidence, not current financial eligibility.
    -- First Authorise can legitimately change current TSFIN. Do not compare
    -- today's mutable finance row to the original sealed pre-authorise hash.
  elsif v_local.result_json->>'authority'='COMMON_ENTITLEMENT_HEAD' then
    if v_local.result_json->'requires_first_authorisation' is distinct from 'false'::jsonb
       or v_local.approved_snapshot_json->>'common_decision_bundle_id'
          is distinct from v_local.result_json->>'decision_bundle_id'
       or v_local.common_decision_bundle_id::text is distinct from v_local.result_json->>'decision_bundle_id'
       or v_local.common_bundle_revision is null
       or v_local.publication_origin_kind is distinct from 'PROTECTED_LOCAL_DECISION_V1'
       or v_local.publication_origin_digest is null
       or v_local.source_qualification_digest is null then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    if v_local.state='PENDING_FREEZE' then
      select p.* into v_pending from public.weekly_source_pending_entitlement_bundles p
        where p.id::text=v_local.result_json#>>'{publication,pending_bundle_verified}';
      if not found or v_pending.state not in ('PENDING','RELEASING','MANUAL_REVIEW','SUPERSEDED')
         or v_pending.decision_bundle_id::text is distinct from v_local.result_json->>'decision_bundle_id'
         or v_pending.bundle_revision is distinct from v_local.common_bundle_revision
         or v_pending.decided_by_user_id is distinct from v_local.actor_user_id
         or v_pending.candidate_id is distinct from v_approval.candidate_id
         or v_local.result_json#>'{publication,ok}' is distinct from 'true'::jsonb
         or v_local.result_json#>'{publication,published}' is distinct from 'false'::jsonb
         or v_local.result_json#>>'{publication,code}' is distinct from 'WEEKLY_SOURCE_PUBLICATION_DEFERRED_PENDING_FREEZE'
         or v_pending.request_digest is distinct from private.weekly_source_publication_request_digest_v1(
             private.weekly_source_publication_request_canonical_v1(v_pending.request_json,'DEFERRED',v_pending.id)) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      v_member:=array_position(v_pending.member_root_ids,v_local.root_timesheet_id);
      if v_member is null or v_pending.member_family_booking_ids[v_member] is distinct from v_scope->>'family_booking_id'
         or v_pending.member_root_versions[v_member] is distinct from v_publication_version then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      v_canonical:=private.weekly_source_publication_request_canonical_v1(v_pending.request_json,'DEFERRED',v_pending.id);
      -- A self-consistent request digest does not prove that its identities
      -- agree with the separately stored pending row. Bind the complete member
      -- mapping before using the pending row's ordinal to select an entitlement.
      if v_canonical->>'decision_bundle_id' is distinct from v_pending.decision_bundle_id::text
         or (v_canonical->>'bundle_revision')::bigint is distinct from v_pending.bundle_revision
         or v_canonical->>'candidate_id' is distinct from v_pending.candidate_id::text
         or v_canonical->'member_root_ids' is distinct from to_jsonb(v_pending.member_root_ids)
         or v_canonical->'member_family_booking_ids' is distinct from to_jsonb(v_pending.member_family_booking_ids)
         or v_canonical->'member_root_versions' is distinct from to_jsonb(v_pending.member_root_versions)
         or v_canonical->'head_ids' is distinct from to_jsonb(v_pending.proposed_head_ids)
         or v_canonical->>'decision_id' is distinct from v_pending.decision_id::text
         or v_canonical->'member_root_ids'->>(v_member-1) is distinct from v_local.root_timesheet_id::text
         or v_canonical->'member_family_booking_ids'->>(v_member-1) is distinct from v_scope->>'family_booking_id'
         or (v_canonical->'member_root_versions'->>(v_member-1))::integer
            is distinct from v_publication_version then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      select c.value into strict v_choice from jsonb_array_elements(
        v_canonical#>'{financial_request,contract_choices}') c(value)
        where (c.value->>'root_ordinal')::integer=v_member;
      if v_choice->>'contract_id' is distinct from v_scope->>'contract_id'
         or v_choice->>'week_ending_date' is distinct from v_scope->>'week_ending_date' then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      select e.value into strict v_entitlement from jsonb_array_elements(
        v_canonical#>'{financial_request,member_entitlements}') e(value)
        where (e.value->>'root_ordinal')::integer=v_member;
      if v_entitlement->>'authority_kind' is distinct from 'PROTECTED'
         or (v_entitlement->>'component_count')::integer is distinct from jsonb_array_length(v_entitlement->'components') then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      v_components:=v_entitlement->'components';
      v_origin:=v_canonical#>'{financial_request,source_revision}';
    else
      select r.* into v_publication from private.weekly_source_entitlement_publication_receipts r
        where r.id::text=v_local.result_json#>>'{publication,receipt,id}';
      if not found or v_publication.decision_bundle_id::text is distinct from v_local.result_json->>'decision_bundle_id'
         or v_publication.bundle_revision is distinct from v_local.common_bundle_revision
         or v_publication.candidate_id is distinct from v_approval.candidate_id
         or v_publication.decided_by_user_id is distinct from v_local.actor_user_id
         or v_local.result_json#>'{publication,ok}' is distinct from 'true'::jsonb
         or v_local.result_json#>'{publication,published}' is distinct from 'true'::jsonb
         or v_local.result_json#>'{publication,receipt}' is distinct from
            private.weekly_source_publication_receipt_json_v1(v_publication.id) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      v_member:=array_position(v_publication.member_root_ids,v_local.root_timesheet_id);
      if v_member is null or v_publication.member_family_booking_ids[v_member] is distinct from v_scope->>'family_booking_id'
         or v_publication.member_root_versions[v_member] is distinct from v_publication_version
         or not exists(select 1 from public.weekly_source_entitlement_heads h
           where h.id=v_publication.head_ids[v_member] and h.root_timesheet_id=v_local.root_timesheet_id
             and h.root_family_booking_id=v_scope->>'family_booking_id'
             and h.root_timesheet_version=v_publication_version
             and h.decision_bundle_id=v_publication.decision_bundle_id
             and h.bundle_revision=v_publication.bundle_revision
             and h.state in ('COMMITTED_CURRENT','SUPERSEDED')) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      select h.* into strict v_head from public.weekly_source_entitlement_heads h
        where h.id=v_publication.head_ids[v_member];
      if v_head.authority_kind is distinct from 'PROTECTED'
         or v_head.candidate_id is distinct from v_approval.candidate_id
         or v_head.contract_id is distinct from v_approval.contract_id
         or v_head.week_ending_date is distinct from v_approval.week_ending then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      select coalesce(jsonb_agg(private.weekly_source_publication_component_canonical_v1(
        (to_jsonb(c)-array['id','head_id','decision_bundle_id','bundle_revision','component_sha256','created_at_utc'])
          ||jsonb_build_object('work_date',to_char(c.work_date,'YYYY-MM-DD'),
            'hours_day',c.hours_day::text,'hours_night',c.hours_night::text,
            'hours_sat',c.hours_sat::text,'hours_sun',c.hours_sun::text,
            'hours_bh',c.hours_bh::text,'unit_count',c.unit_count::text,
            'unit_pay_rate',c.unit_pay_rate::text,'unit_charge_rate',c.unit_charge_rate::text,
            'pay_ex_vat',c.pay_ex_vat::text,'charge_ex_vat',c.charge_ex_vat::text),
        'query.local.accepted_component') order by c.component_ordinal),'[]'::jsonb)
        into v_components from public.weekly_source_entitlement_head_components c where c.head_id=v_head.id;
      if jsonb_array_length(v_components) is distinct from v_head.component_count
         or exists(select 1 from public.weekly_source_entitlement_head_components c
           where c.head_id=v_head.id and c.component_sha256 is distinct from
             private.weekly_source_publication_request_digest_v1(private.weekly_source_publication_component_content_v1(
               private.weekly_source_publication_component_canonical_v1((to_jsonb(c)-array['id','head_id',
                 'decision_bundle_id','bundle_revision','component_sha256','created_at_utc'])
                   ||jsonb_build_object('work_date',to_char(c.work_date,'YYYY-MM-DD'),
                     'hours_day',c.hours_day::text,'hours_night',c.hours_night::text,
                     'hours_sat',c.hours_sat::text,'hours_sun',c.hours_sun::text,
                     'hours_bh',c.hours_bh::text,'unit_count',c.unit_count::text,
                     'unit_pay_rate',c.unit_pay_rate::text,'unit_charge_rate',c.unit_charge_rate::text,
                     'pay_ex_vat',c.pay_ex_vat::text,'charge_ex_vat',c.charge_ex_vat::text),
                 'query.local.accepted_component')))) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
      v_origin:=v_head.source_origin_json;
      if v_head.source_generation_digest is distinct from private.weekly_source_publication_request_digest_v1(v_origin) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    end if;
    -- Compatible V4 local publisher must supply this real closed origin.
    -- The old current-Final constructor is deliberately NOT an accepted
    -- substitute, even if it published a genuine same-root/actor Source HEAD.
    if private.weekly_exceptional_json_keys_exact_v1(v_origin,array['origin_kind','publication_request_id',
       'generation_id','request_sha256','source_qualification_digest','policy_fingerprint',
       'before_origin','before_inventory_digest']) is distinct from true
       or not (v_origin ?& array['origin_kind','publication_request_id','generation_id','request_sha256',
          'source_qualification_digest','policy_fingerprint','before_origin','before_inventory_digest'])
       or v_origin->>'origin_kind' is distinct from 'PROTECTED_LOCAL_DECISION_V1'
       or v_origin->>'publication_request_id' is distinct from v_request.id::text
       or v_origin->>'generation_id' is distinct from v_generation.id::text
       or v_origin->>'request_sha256' is distinct from encode(v_request.request_sha256,'hex')
       or private.weekly_source_publication_request_digest_v1(v_origin)
          is distinct from v_local.publication_origin_digest
       or v_origin->>'source_qualification_digest'
          is distinct from encode(v_local.source_qualification_digest,'hex')
       or coalesce(v_origin->>'source_qualification_digest','') !~ '^[0-9a-f]{64}$'
       or coalesce(v_origin->>'policy_fingerprint','') !~ '^[0-9a-f]{64}$'
       or coalesce(v_origin->>'before_inventory_digest','') !~ '^[0-9a-f]{64}$'
       or jsonb_typeof(v_origin->'before_origin') is distinct from 'object'
       or v_local.approved_snapshot_json->'local_publication_origin' is distinct from v_origin
       or private.weekly_source_sha256_jsonb_v1('PROTECTED_LOCAL_SOURCE_QUALIFICATION_V2',
          v_local.approved_snapshot_json->'local_source_qualification')
          is distinct from v_local.source_qualification_digest
       or coalesce(v_local.approved_snapshot_json->>'common_components_digest','') !~ '^[0-9a-f]{64}$'
       or v_local.approved_snapshot_json->>'common_components_digest' is distinct from encode(
          private.weekly_source_publication_request_digest_v1(v_components),'hex') then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    -- The retained qualification must belong to this exact accepted action.
    -- A later WAIT can reuse this approval with a different source proposal:
    -- point-read the original immutable event, never compare it to latest WAIT.
    v_qualification:=v_local.approved_snapshot_json->'local_source_qualification';
    if private.weekly_exceptional_json_keys_exact_v1(v_qualification,array[
         'schema_version','publication_request_id','generation_id','scope','source_cycle_id',
         'work_event_id','approval_id','actor_user_id','family_event_sequence','source_proposal_hash',
         'complete_vector_hash','rate_policy_fingerprint','prepared_sources']) is distinct from true
       or not (v_qualification ?& array['schema_version','publication_request_id','generation_id',
         'scope','source_cycle_id','work_event_id','approval_id','actor_user_id','family_event_sequence',
         'source_proposal_hash','complete_vector_hash','rate_policy_fingerprint','prepared_sources'])
       or v_qualification->>'schema_version' is distinct from 'PROTECTED_LOCAL_SOURCE_QUALIFICATION_V2'
       or v_qualification->>'publication_request_id' is distinct from v_request.id::text
       or v_qualification->>'generation_id' is distinct from v_generation.id::text
       or v_qualification->>'source_cycle_id' is distinct from v_approval.source_cycle_id::text
       or v_qualification->>'work_event_id' is distinct from v_approval.work_event_id::text
       or v_qualification->>'approval_id' is distinct from v_approval.id::text
       or v_qualification->>'actor_user_id' is distinct from v_local.actor_user_id::text
       or v_qualification->>'complete_vector_hash' is distinct from encode(v_generation.complete_next_vector_hash,'hex')
       or v_qualification->>'rate_policy_fingerprint' is distinct from encode(v_approval.contract_rate_policy_source_fingerprint,'hex')
       or v_origin->>'policy_fingerprint' is distinct from v_qualification->>'rate_policy_fingerprint'
       or v_qualification#>>'{scope,root_timesheet_id}' is distinct from v_local.root_timesheet_id::text
       or v_qualification#>>'{scope,root_version}' is distinct from v_publication_version::text
       or v_qualification#>>'{scope,family_booking_id}' is distinct from v_scope->>'family_booking_id'
       or v_qualification#>>'{scope,target_family_id}' is distinct from v_local.family_id::text
       or v_qualification#>>'{scope,candidate_id}' is distinct from v_approval.candidate_id::text
       or v_qualification#>>'{scope,client_id}' is distinct from v_approval.client_id::text
       or v_qualification#>>'{scope,contract_id}' is distinct from v_approval.contract_id::text
       or v_qualification#>>'{scope,week_ending_date}' is distinct from to_char(v_approval.week_ending,'YYYY-MM-DD')
       or coalesce(v_qualification->>'family_event_sequence','') !~ '^[1-9][0-9]*$'
       or (v_qualification->>'family_event_sequence')::numeric>9223372036854775807
       or coalesce(v_qualification->>'source_proposal_hash','') !~ '^[0-9a-f]{64}$'
       or jsonb_typeof(v_qualification->'prepared_sources') is distinct from 'array' then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    select e.* into v_original_event from public.weekly_exceptional_pay_family_events e
      where e.family_id=v_local.family_id
        and e.event_sequence=(v_qualification->>'family_event_sequence')::bigint;
    if not found or v_original_event.durable_work_event_id is distinct from v_approval.work_event_id
       or v_original_event.evidence_approval_id is distinct from v_approval.id
       or v_original_event.office_actor_user_id is distinct from v_local.actor_user_id
       or v_original_event.work_date is distinct from v_approval.protected_work_date
       or v_original_event.source_proposal_hash is distinct from decode(v_qualification->>'source_proposal_hash','hex')
       or v_original_event.source_proposal_hash is distinct from private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_PROTECTED_SOURCE_PROPOSAL_V1',v_original_event.source_proposal_snapshot_json) then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    -- Qualify the original sealed before-position, never today's HEAD/root.
    -- The complete vector was sealed by the actual stage owner. A later
    -- sibling amendment or physical rotation cannot replace this evidence.
    v_prior_inventory:=v_generation.complete_next_vector_json->'prior_effective_inventory';
    v_before_origin:=v_prior_inventory#>'{approval_basis,origin}';
    if v_prior_inventory->'ok' is distinct from 'true'::jsonb
       or v_prior_inventory#>'{approval_basis,coverage_complete}' is distinct from 'true'::jsonb
       or coalesce(v_before_origin->>'kind','') not in ('INITIAL_AUTHORISED_TSFIN_V1','COMMITTED_SOURCE_HEAD_V1')
       or v_prior_inventory#>>'{approval_basis,scope,root_timesheet_id}' is distinct from v_local.root_timesheet_id::text
       or v_prior_inventory#>>'{approval_basis,scope,root_version}' is distinct from v_publication_version::text
       or v_prior_inventory#>>'{approval_basis,scope,family_booking_id}' is distinct from v_scope->>'family_booking_id'
       or v_prior_inventory#>>'{approval_basis,scope,target_family_id}' is distinct from v_local.family_id::text
       or v_prior_inventory#>>'{approval_basis,scope,candidate_id}' is distinct from v_scope->>'candidate_id'
       or v_prior_inventory#>>'{approval_basis,scope,client_id}' is distinct from v_scope->>'client_id'
       or v_prior_inventory#>>'{approval_basis,scope,contract_id}' is distinct from v_scope->>'contract_id'
       or v_prior_inventory#>>'{approval_basis,scope,week_ending_date}' is distinct from v_scope->>'week_ending_date'
       or v_origin->>'before_inventory_digest' is distinct from v_prior_inventory->>'inventory_digest' then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
    if v_before_origin->>'kind'='COMMITTED_SOURCE_HEAD_V1' then
      v_before_origin:=v_before_origin-'source_revision';
    end if;
    if v_origin->'before_origin' is distinct from v_before_origin
       or private.weekly_source_local_origin_canonical_v2(v_origin) is distinct from v_origin then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  else raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
  end if;
  -- The original completion step is immutable. Pending release updates the
  -- Local/run/request result together, but does not rewrite that original step.
  select count(*) into v_count from public.weekly_exceptional_orchestration_steps step
    where step.orchestration_run_id=v_run.id and step.step_kind='COMPLETE_LOCAL_PROTECTED_DECISION';
  if v_count<>1 then raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000'; end if;
  select step.* into strict v_step from public.weekly_exceptional_orchestration_steps step
    where step.orchestration_run_id=v_run.id and step.step_kind='COMPLETE_LOCAL_PROTECTED_DECISION';
  if v_step.idempotency_key is distinct from v_local.idempotency_key
     or v_step.allowlisted_owner_name is distinct from 'CloudTMS.weekly_exceptional_pay_complete_local_v1'
     or v_step.allowlisted_owner_signature is distinct from 'jsonb'
     or v_step.bounded_request_hash is distinct from v_local.request_sha256
     or v_step.before_state_fingerprint is distinct from v_run.before_state_fingerprint
     or v_step.completed_at_utc is null or not isfinite(v_step.completed_at_utc)
     or v_step.owner_response_hash is distinct from private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_PROTECTED_LOCAL_RESULT_V1',v_step.bounded_owner_response_json)
     or v_step.after_state_fingerprint is distinct from v_step.owner_response_hash then
    raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
  end if;
  if v_local.result_json ? 'deferred_release_receipt_id' then
    if v_local.state<>'COMPLETE' or v_step.outcome is distinct from 'PENDING'
       or v_step.bounded_owner_response_json->>'outcome' is distinct from 'SAVED_PENDING_FREEZE'
       or v_step.bounded_owner_response_json->>'state' is distinct from 'PENDING'
       or v_local.result_json is distinct from (v_step.bounded_owner_response_json||jsonb_build_object(
         'outcome','PUBLISHED','state','LIVE',
         'deferred_release_receipt_id',v_local.result_json->'deferred_release_receipt_id',
         'publication',v_local.result_json->'publication',
         'family_bound_version',v_local.result_json->'family_bound_version'))
       or not exists(select 1 from public.weekly_source_pending_entitlement_bundles p
         where p.id::text=v_step.bounded_owner_response_json#>>'{publication,pending_bundle_verified}'
           and p.state='RELEASED' and p.decision_bundle_id=v_local.common_decision_bundle_id
           and p.bundle_revision=v_local.common_bundle_revision
           and p.released_receipt_id::text=v_local.result_json->>'deferred_release_receipt_id'
           and p.released_receipt_id=v_publication.id
           and p.released_receipt_digest=v_publication.request_digest) then
      raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
    end if;
  elsif v_step.bounded_owner_response_json is distinct from v_local.result_json
     or v_step.outcome is distinct from (case when v_local.state='PENDING_FREEZE' then 'PENDING' else 'COMPLETE' end) then
    raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
  end if;
  return jsonb_build_object('family_id',v_local.family_id,'orchestration_run_id',v_run.id,
    'publication_request_id',v_request.id,'request_sha256',encode(v_local.request_sha256,'hex'),
    'generation_id',v_generation.id,'state',v_local.state,
    'requires_first_authorisation',v_local.result_json->'requires_first_authorisation',
    'idempotent_replay',true,'result',v_local.result_json||jsonb_build_object('idempotent_replay',true));
exception when no_data_found or too_many_rows or invalid_text_representation or numeric_value_out_of_range then
  raise exception 'WEEKLY_SOURCE_LOCAL_SAVED_STATUS_CONTRADICTION' using errcode='55000';
end;
$function$;

-- private.weekly_source_projection_comparison_manifest_hash_v1(uuid); supabase/repeatable/15092026_1534_weekly_source_upload_publication_v1.sql; SHA256 86b3c843162674b1b7328636fdb80bb60fc564727a1afcf67e9622ddccaa3980
create or replace function private.weekly_source_projection_comparison_manifest_hash_v1(
  p_publication_id uuid
) returns bytea
language sql stable security definer
set search_path to 'private','pg_catalog','pg_temp'
as $function$
  select private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_COMPARISON_MANIFEST_V1',
    private.weekly_source_projection_comparison_manifest_v1(p_publication_id)
  );
$function$;

-- private.weekly_source_projection_comparison_manifest_v1(uuid); supabase/repeatable/15092026_1534_weekly_source_upload_publication_v1.sql; SHA256 f17b87c0c3e3657a76f6f6ee200b64ffc1b5ab76ff7b9ebc9b7ddf7afbc72e57
create or replace function private.weekly_source_projection_comparison_manifest_v1(
  p_publication_id uuid
) returns jsonb
language sql stable security definer
set search_path to 'public','pg_catalog','pg_temp'
as $function$
  select pg_catalog.jsonb_build_object(
    'manifest_version','WEEKLY_SOURCE_COMPARISON_MANIFEST_V1',
    'source_authority',coalesce((
      select pg_catalog.jsonb_agg(
        pg_catalog.encode(comparison.material_comparison_fingerprint,'hex')
        order by pg_catalog.encode(comparison.material_comparison_fingerprint,'hex')
      )
      from public.weekly_issue_comparison_revisions comparison
      where comparison.projection_publication_id=p_publication_id
    ),'[]'::jsonb),
    'timesheet_authority',coalesce((
      select pg_catalog.jsonb_agg(
        pg_catalog.encode(comparison.comparison_fingerprint,'hex')
        order by pg_catalog.encode(comparison.comparison_fingerprint,'hex')
      )
      from public.weekly_timesheet_source_comparisons comparison
      where comparison.projection_publication_id=p_publication_id
    ),'[]'::jsonb)
  );
$function$;

-- private.weekly_source_projection_issue_set_hash_v1(uuid); supabase/repeatable/15092026_1534_weekly_source_upload_publication_v1.sql; SHA256 828b2aee4ad81bb1663e96bc9b6f514814b99a6bdf3a0846c6b28c27c184d82e
create or replace function private.weekly_source_projection_issue_set_hash_v1(
  p_publication_id uuid
) returns bytea
language sql stable security definer
set search_path to 'private','pg_catalog','pg_temp'
as $function$
  select private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_ISSUE_SET_V1',
    private.weekly_source_projection_issue_set_v1(p_publication_id)
  );
$function$;

-- private.weekly_source_projection_issue_set_v1(uuid); supabase/repeatable/15092026_1534_weekly_source_upload_publication_v1.sql; SHA256 8718bea948c6544e997650c12fc7a35ad2427d392da30e298142c983e588c387
create or replace function private.weekly_source_projection_issue_set_v1(
  p_publication_id uuid
) returns jsonb
language sql stable security definer
set search_path to 'public','pg_catalog','pg_temp'
as $function$
  select pg_catalog.jsonb_build_object(
    'issue_set_version','WEEKLY_SOURCE_ISSUE_SET_V1',
    'issues',coalesce((
      select pg_catalog.jsonb_agg(
        pg_catalog.jsonb_build_object(
          'incident_id',comparison.incident_id,
          'issue_family',comparison.issue_family,
          'source_presence',comparison.source_presence,
          'fingerprint',pg_catalog.encode(comparison.material_comparison_fingerprint,'hex')
        ) order by comparison.incident_id,comparison.revision_number
      )
      from public.weekly_issue_comparison_revisions comparison
      where comparison.projection_publication_id=p_publication_id
    ),'[]'::jsonb)
  );
$function$;

-- private.weekly_source_contract_week_settings_authority_assert_v1(uuid); supabase/repeatable/15092026_1534_weekly_source_timesheet_lineage_v1.sql; SHA256 d67e49413349d75d1e5e4fbe71ea0b318f6b21980143f729f64f1e3b4e03f829
create or replace function private.weekly_source_contract_week_settings_authority_assert_v1(
  p_contract_week_id uuid
) returns jsonb
language plpgsql
stable
security definer
set search_path to 'public','private','extensions','pg_catalog','pg_temp'
as $function$
declare
  v_snapshot jsonb;
  v_version text;
  v_fingerprint text;
  v_resolved_at timestamptz;
  v_expected text;
begin
  select
    contract_week.settings_authority_json,
    contract_week.settings_authority_version,
    contract_week.settings_authority_fingerprint,
    contract_week.settings_authority_resolved_at
  into v_snapshot,v_version,v_fingerprint,v_resolved_at
  from public.contract_weeks contract_week
  where contract_week.id=p_contract_week_id;
  if not found then
    raise exception 'WEEKLY_SOURCE_CONTRACT_WEEK_NOT_FOUND' using errcode='P0002';
  end if;

  if coalesce(v_snapshot,'{}'::jsonb)='{}'::jsonb
     or v_version is distinct from 'CONTRACT_SETTINGS_AUTHORITY_V1'
     or coalesce(v_fingerprint,'') !~ '^[0-9a-f]{64}$'
     or v_resolved_at is null
     or nullif(v_snapshot->>'resolved_at_utc','') is null then
    raise exception 'WEEKLY_SOURCE_CONTRACT_WEEK_AUTHORITY_NOT_FROZEN' using errcode='55000';
  end if;

  v_expected:=pg_catalog.encode(extensions.digest(pg_catalog.convert_to(
    (v_snapshot-'authority_fingerprint'-'resolved_at_utc')::text,'UTF8'
  ),'sha256'),'hex');
  if v_expected is distinct from v_fingerprint
     or v_snapshot->>'authority_fingerprint' is distinct from v_fingerprint
     or (v_snapshot->>'resolved_at_utc')::timestamptz is distinct from v_resolved_at then
    raise exception 'WEEKLY_SOURCE_CONTRACT_WEEK_AUTHORITY_INVALID' using errcode='22023';
  end if;

  return v_snapshot;
exception
  when invalid_text_representation or datetime_field_overflow then
    raise exception 'WEEKLY_SOURCE_CONTRACT_WEEK_AUTHORITY_INVALID' using errcode='22023';
end;
$function$;

-- private.weekly_source_timesheet_lineage_assert_v1(uuid); supabase/repeatable/15092026_1534_weekly_source_timesheet_lineage_v1.sql; SHA256 fd7331b20d9152a472f1394f286fa5bb30ad3f640c4edd9d9b134e359b818cc2
create or replace function private.weekly_source_timesheet_lineage_assert_v1(
  p_row_resolution_id uuid
) returns public.weekly_source_row_timesheet_lineages
language plpgsql
stable
security definer
set search_path to 'public','private','pg_catalog','pg_temp'
as $function$
declare
  v_lineage public.weekly_source_row_timesheet_lineages%rowtype;
  v_resolution public.weekly_source_row_resolutions%rowtype;
  v_contract_week public.contract_weeks%rowtype;
  v_timesheet public.timesheets%rowtype;
  v_contract_week_settings jsonb;
  v_timesheet_settings jsonb;
  v_expected_fingerprint bytea;
  v_root_identity jsonb;
begin
  -- Decision D8: this relation is the per-source-row BINDING and carries no
  -- authorisation generation, so there is exactly one row per resolution.  The
  -- authorisation record lives in public.weekly_source_root_authorisations.
  select * into v_lineage
  from public.weekly_source_row_timesheet_lineages
  where row_resolution_id=p_row_resolution_id;
  if not found then
    raise exception 'WEEKLY_SOURCE_TIMESHEET_LINEAGE_MISSING' using errcode='55000';
  end if;

  select * into strict v_resolution
  from public.weekly_source_row_resolutions
  where id=v_lineage.row_resolution_id;
  select * into strict v_contract_week
  from public.contract_weeks
  where id=v_lineage.contract_week_id;
  select * into strict v_timesheet
  from public.timesheets
  where timesheet_id=v_lineage.timesheet_id;

  -- G6-8 / proof/34 section 5 step 4 and section 6.  The stored physical id is
  -- never trusted on its own: it is resolved through the installed Workbench
  -- rotation authority and compared with the retained family identity and
  -- version.  A rotation observed after first authorisation is
  -- WEEKLY_SOURCE_ROOT_INTEGRITY_FAILURE, never a stale rebuild.
  v_root_identity:=private.weekly_source_root_integrity_assert_v1(
    v_lineage.timesheet_id,v_lineage.family_booking_id,v_lineage.timesheet_version
  );

  v_contract_week_settings:=
    private.weekly_source_contract_week_settings_authority_assert_v1(v_contract_week.id);
  v_timesheet_settings:=
    private._timesheet_settings_authority_frozen_v1(v_timesheet.timesheet_id);

  v_expected_fingerprint:=private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_ROW_TIMESHEET_LINEAGE_V1',
    pg_catalog.jsonb_build_object(
      'row_resolution_id',v_lineage.row_resolution_id,
      'source_cycle_id',v_lineage.source_cycle_id,
      'work_event_id',v_lineage.work_event_id,
      'candidate_id',v_lineage.candidate_id,
      'client_id',v_lineage.client_id,
      'contract_id',v_lineage.contract_id,
      'contract_week_id',v_lineage.contract_week_id,
      'timesheet_id',v_lineage.timesheet_id,
      'week_ending_date',v_lineage.week_ending_date
    )
  );

  if v_resolution.mapping_state<>'RESOLVED'
     or v_resolution.work_event_id is distinct from v_lineage.work_event_id
     or v_resolution.candidate_id is distinct from v_lineage.candidate_id
     or v_resolution.client_id is distinct from v_lineage.client_id
     or v_resolution.contract_id is distinct from v_lineage.contract_id
     or v_contract_week.contract_id is distinct from v_lineage.contract_id
     or v_contract_week.week_ending_date is distinct from v_lineage.week_ending_date
     or v_contract_week.additional_seq<>0
     or v_contract_week.is_adjustment
     or v_contract_week.status='CANCELLED'::public.contract_week_status_enum
     or v_contract_week.timesheet_id is distinct from v_lineage.timesheet_id
     or v_timesheet.contract_id is distinct from v_lineage.contract_id
     or v_timesheet.week_ending_date is distinct from v_lineage.week_ending_date
     or v_timesheet.sheet_scope<>'WEEKLY'::public.timesheet_scope_enum
     or v_timesheet.line_type<>'HOURS'::public.timesheet_line_type_enum
     or v_timesheet.is_adjustment
     or not v_timesheet.is_current
     or v_timesheet.revoked_at is not null
     or v_timesheet.archived_at_utc is not null
     or v_lineage.family_booking_id is distinct from v_timesheet.booking_id
     or v_lineage.timesheet_version is distinct from v_timesheet.version
     or v_lineage.family_booking_id is distinct from
        (v_root_identity->>'family_booking_id')
     or v_lineage.timesheet_version is distinct from
        (v_root_identity->>'canonical_version')::integer
     or coalesce((v_root_identity->>'requested_is_canonical')::boolean,false)
        is not true
     or v_timesheet.settings_authority_resolved_at is null
     or (v_timesheet_settings->>'resolved_at_utc')::timestamptz is distinct from
        v_timesheet.settings_authority_resolved_at
     or v_timesheet.settings_authority_fingerprint is distinct from
        v_contract_week.settings_authority_fingerprint
     or v_timesheet_settings->>'authority_fingerprint' is distinct from
        v_contract_week_settings->>'authority_fingerprint'
     or v_lineage.lineage_fingerprint is distinct from v_expected_fingerprint then
    raise exception 'WEEKLY_SOURCE_TIMESHEET_LINEAGE_INVALID' using errcode='55000';
  end if;

  return v_lineage;
exception
  when no_data_found or too_many_rows then
    raise exception 'WEEKLY_SOURCE_TIMESHEET_LINEAGE_INVALID' using errcode='55000';
end;
$function$;

-- private.weekly_source_manual_review_command_immutable_v1(); supabase/migrations/05102026_0428_weekly_source_manual_review_commands.sql; SHA256 a90c97d98d72f092864b6db9cb59ae8d0d71d04bf306d1c367f08c0356e919df
create function private.weekly_source_manual_review_command_immutable_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
begin
  raise exception 'WEEKLY_SOURCE_MANUAL_REVIEW_COMMAND_IMMUTABLE' using errcode='55000';
end;
$function$;

-- private.bpay_next_daily_approval_evidence_v1(uuid); supabase/repeatable/11102026_1129_banking_pay_next_daily_hours_only_integrity_v1.sql; SHA256 d2f2b6e71fca4f7b23c54122ee6d3e1d6f3f962ce90c960e9c2f30fb18b0f7a7
create or replace function private.bpay_next_daily_approval_evidence_v1(p_financial_id uuid)
returns jsonb
language plpgsql stable security definer
set search_path = pg_catalog, public, private
as $function$
declare
  v_tf public.timesheets_financials%rowtype;
  v_ts public.timesheets%rowtype;
  v_contract public.contracts%rowtype;
  v_context record;
  v_date date;
  v_rates jsonb;
  v_selected jsonb;
  v_paye jsonb;
  v_umbrella jsonb;
  v_rows jsonb;
  v_bucket record;
begin
  select tf.* into strict v_tf from public.timesheets_financials tf where tf.id=p_financial_id;
  select t.* into strict v_ts from public.timesheets t where t.timesheet_id=v_tf.timesheet_id;
  -- Daily Timesheets are hours only (owner 8 Oct 2026); integrity guard only
  if v_ts.sheet_scope = 'DAILY'::public.timesheet_scope_enum and v_ts.line_type::text = 'HOURS'
     and (v_tf.additional_units_json is distinct from '{}'::jsonb
     or v_tf.additional_pay_ex_vat is distinct from 0::numeric
     or coalesce(v_tf.expenses_pay_ex_vat,0)<>0 or coalesce(v_tf.mileage_pay_ex_vat,0)<>0
     or coalesce(v_tf.mileage_units,0)<>0 or coalesce(v_tf.travel_pay_ex_vat,0)<>0
     or coalesce(v_tf.accommodation_pay_ex_vat,0)<>0 or coalesce(v_tf.other_pay_ex_vat,0)<>0) then
    raise exception using errcode='23514',message='BPAY_NEXT_DAILY_HOURS_ONLY_VIOLATION';
  end if;
  if v_ts.sheet_scope is distinct from 'DAILY'::public.timesheet_scope_enum
     or v_ts.line_type::text is distinct from 'HOURS'
     or v_ts.is_current is distinct from true or v_ts.archived_at_utc is not null or v_ts.revoked_at is not null
     or v_ts.is_adjustment is true or v_ts.parent_timesheet_id is not null or v_ts.correction_id is not null
     or nullif(btrim(v_ts.adjustment_origin),'') is not null or nullif(btrim(v_ts.correction_kind),'') is not null
     or nullif(btrim(v_ts.booking_id),'') is null
     or v_tf.is_current is distinct from true or v_tf.is_stale is distinct from false
     or v_tf.timesheet_version is distinct from v_ts.version
     or v_tf.authorised_at_utc is null or v_ts.authorised_at_server is null
     or v_tf.basis::text is distinct from 'SELF_REPORTED'
     or v_tf.candidate_id is null or v_tf.client_id is null or nullif(btrim(v_tf.role),'') is null
     or upper(v_tf.pay_method) not in ('PAYE','UMBRELLA') or v_tf.pay_method is null
     or v_tf.has_rate_issue is distinct from false or v_tf.has_pay_channel_issue is distinct from false
     or v_tf.invoice_breakdown_json->>'mode' is distinct from 'AGGREGATE'
     or jsonb_typeof(v_tf.policy_snapshot_json) is distinct from 'object'
     or jsonb_typeof(v_tf.rate_source_refs_json) is distinct from 'object'
     or v_tf.worked_start_iso is null or v_tf.worked_end_iso is null or v_tf.worked_end_iso<=v_tf.worked_start_iso
     or (v_tf.worked_start_iso,v_tf.worked_end_iso,v_tf.break_start_iso,v_tf.break_end_iso,v_tf.break_minutes)
        is distinct from (v_ts.worked_start_iso,v_ts.worked_end_iso,v_ts.break_start_iso,v_ts.break_end_iso,v_ts.break_minutes)
     or (v_tf.break_start_iso is null)<>(v_tf.break_end_iso is null)
     or (v_tf.break_start_iso is not null and v_tf.break_end_iso<=v_tf.break_start_iso)
     or v_tf.break_minutes<0
 then
    raise exception using errcode='23514',message='BPAY_NEXT_DAILY_APPROVAL_PROVENANCE_REQUIRED';
  end if;
  -- A real contracted DAILY retains its existing Contract identity. This
  -- does not turn a Contract edit into authorisation or manufacture a Contract
  -- for a contractless Daily. Both paths require the same authorised TF below.
  if v_ts.contract_id is not null then
    select c.* into strict v_contract from public.contracts c where c.id=v_ts.contract_id;
    if v_contract.candidate_id is distinct from v_tf.candidate_id
       or v_contract.client_id is distinct from v_tf.client_id then
      raise exception using errcode='23514',message='BPAY_NEXT_DAILY_CONTRACT_IDENTITY_CONFLICT';
    end if;
  end if;
  -- The existing canonical context resolves the factual Candidate and Office
  -- financial Client. No latest-history lookup or Rota re-admission.
  select ctx.* into strict v_context
    from public.tsfin_load_context_batch(array[v_ts.timesheet_id]) ctx;
  if v_context.effective_timesheet_id is distinct from v_ts.timesheet_id
     or (v_context.out_cur_fin->>'id') is distinct from v_tf.id::text
     or (v_context.out_candidate->>'id') is distinct from v_tf.candidate_id::text
     or v_context.out_client_id is distinct from v_tf.client_id then
    raise exception using errcode='23514',message='BPAY_NEXT_DAILY_CONTEXT_IDENTITY_CONFLICT';
  end if;
  v_date:=(v_tf.worked_start_iso at time zone 'Europe/London')::date;
  if v_ts.week_ending_date is distinct from v_date+(7-extract(isodow from v_date)::integer) then
    raise exception using errcode='23514',message='BPAY_NEXT_DAILY_WORK_DATE_CONFLICT';
  end if;
  -- Both channels use the SAME existing dated override/default resolver.
  -- The opposite channel remains unavailable when that authority returns NULL.
  select jsonb_object_agg(r.rate_type,to_jsonb(r)) into v_rates
    from public.tsfin_resolve_rates_batch(jsonb_build_array(
      jsonb_build_object('k',v_ts.timesheet_id,'candidate_id',v_tf.candidate_id,
        'client_id',v_tf.client_id,'role',v_tf.role,'band',v_tf.band,'date',v_date,'rate_type','PAYE'),
      jsonb_build_object('k',v_ts.timesheet_id,'candidate_id',v_tf.candidate_id,
        'client_id',v_tf.client_id,'role',v_tf.role,'band',v_tf.band,'date',v_date,'rate_type','UMBRELLA')
    )) r;
  v_selected:=v_rates->upper(v_tf.pay_method);
  if v_selected is null or coalesce(v_selected->>'source_kind','') not in ('CANDIDATE_OVERRIDE','CLIENT_DEFAULT')
     or private._candidate_daily_rate_contract_v1(v_selected) is distinct from
        private._candidate_daily_rate_contract_v1(jsonb_build_object(
          'source_kind',v_tf.rate_source_refs_json->>'kind',
          'override_id',v_tf.rate_source_refs_json->>'override_id',
          'default_id',v_tf.rate_source_refs_json->>'default_id',
          'rate_type',v_tf.rate_source_refs_json->>'rate_type',
          'pay_day',v_tf.pay_day,'pay_night',v_tf.pay_night,'pay_sat',v_tf.pay_sat,'pay_sun',v_tf.pay_sun,'pay_bh',v_tf.pay_bh,
          'charge_day',v_tf.charge_day,'charge_night',v_tf.charge_night,'charge_sat',v_tf.charge_sat,
          'charge_sun',v_tf.charge_sun,'charge_bh',v_tf.charge_bh
        )) then
    raise exception using errcode='40001',message='BPAY_NEXT_DAILY_RATE_AUTHORITY_STALE';
  end if;
  v_paye:=v_rates->'PAYE'; v_umbrella:=v_rates->'UMBRELLA';
  if (v_paye-array['k','rate_type','source_kind','override_id','pay_day','pay_night','pay_sat','pay_sun','pay_bh'])
     is distinct from
     (v_umbrella-array['k','rate_type','source_kind','override_id','pay_day','pay_night','pay_sat','pay_sun','pay_bh']) then
    raise exception using errcode='23514',message='BPAY_NEXT_DAILY_CHANNEL_CONTEXT_CONFLICT';
  end if;
  for v_bucket in select x.value from jsonb_each(v_rates) channel
    cross join lateral jsonb_each(channel.value) x
    where x.key in ('pay_day','pay_night','pay_sat','pay_sun','pay_bh',
                    'charge_day','charge_night','charge_sat','charge_sun','charge_bh')
  loop
    if v_bucket.value<>'null'::jsonb and
       ((v_bucket.value#>>'{}')::numeric<>round((v_bucket.value#>>'{}')::numeric,6)
        or (v_bucket.value#>>'{}')::numeric<0
        or abs((v_bucket.value#>>'{}')::numeric)>=1000000000000) then
      raise exception using errcode='22003',message='BPAY_NEXT_DAILY_AVAILABLE_RATE_PRECISION_INVALID';
    end if;
  end loop;
  select coalesce(jsonb_agg(jsonb_build_object('rate_family','STANDARD','rate_code',b.code,
      'unit_label',nullif(btrim(v_contract.bucket_labels_json->>lower(b.code)),''),
      'paye_rate',(v_paye->>b.pay_key)::numeric,
      'umbrella_rate',(v_umbrella->>b.pay_key)::numeric,'charge_rate',(v_paye->>b.charge_key)::numeric)
      order by b.code),'[]'::jsonb) into v_rows
    from (values ('DAY'::text,'pay_day'::text,'charge_day'::text),
      ('NIGHT','pay_night','charge_night'),('SAT','pay_sat','charge_sat'),
      ('SUN','pay_sun','charge_sun'),('BH','pay_bh','charge_bh')) b(code,pay_key,charge_key);
  return jsonb_build_object('contract_version','BPAY_NEXT_DAILY_APPROVAL_EVIDENCE_V1',
    'timesheet_id',v_ts.timesheet_id,'timesheet_version',v_ts.version,'financial_id',v_tf.id,
    'booking_id',v_ts.booking_id,'candidate_id',v_tf.candidate_id,'client_id',v_tf.client_id,
    'work_date',v_date,'role',v_tf.role,'band',v_tf.band,
    'policy_snapshot_json',v_tf.policy_snapshot_json,'rate_source_refs_json',v_tf.rate_source_refs_json,
    'resolved_channels',v_rates,'rates',v_rows);
end
$function$;

-- private._candidate_daily_rate_contract_v1(jsonb); supabase/repeatable/07082026_2128_candidate_finalize_reject_no_work_rpcs_v1.sql; SHA256 1d8f9f2706bc6f3a7791ac8ffa014ae287faace5b030c930ec7768a04f79e6a8
create or replace function private._candidate_daily_rate_contract_v1(p_rate jsonb)
returns jsonb
language sql
immutable
set search_path = pg_catalog, private
as $function$
  select jsonb_build_object(
    'source_kind',nullif(p_rate->>'source_kind',''),
    'override_id',nullif(p_rate->>'override_id','')::uuid,
    'default_id',nullif(p_rate->>'default_id','')::uuid,
    'rate_type',nullif(upper(p_rate->>'rate_type'),''),
    'pay_day',nullif(p_rate->>'pay_day','')::numeric,
    'pay_night',nullif(p_rate->>'pay_night','')::numeric,
    'pay_sat',nullif(p_rate->>'pay_sat','')::numeric,
    'pay_sun',nullif(p_rate->>'pay_sun','')::numeric,
    'pay_bh',nullif(p_rate->>'pay_bh','')::numeric,
    'charge_day',nullif(p_rate->>'charge_day','')::numeric,
    'charge_night',nullif(p_rate->>'charge_night','')::numeric,
    'charge_sat',nullif(p_rate->>'charge_sat','')::numeric,
    'charge_sun',nullif(p_rate->>'charge_sun','')::numeric,
    'charge_bh',nullif(p_rate->>'charge_bh','')::numeric
  )
$function$;

-- public.tsfin_load_context_batch(uuid[]); supabase/repeatable/21072026_1235_36_tsfin_load_context_batch.sql; SHA256 3781fa6733119ea219fd0e6478cadf4da5504f359cfd2248c34b33badc4f0e81
create or replace function public.tsfin_load_context_batch(p_timesheet_ids uuid[])
returns table (
  effective_timesheet_id uuid,
  out_timesheet jsonb,
  out_cur_fin jsonb,
  out_candidate jsonb,
  out_umbrella jsonb,
  out_client_id uuid,
  out_effective_flags jsonb,
  out_policy jsonb
)
language sql
stable
security definer
set search_path to 'public', 'extensions', 'pg_temp'
as $$
with input_ids as (
  select distinct unnest(p_timesheet_ids) as input_timesheet_id
  where p_timesheet_ids is not null
),
t_in as (
  select
    i.input_timesheet_id,
    t0.*
  from input_ids i
  join public.timesheets t0
    on t0.timesheet_id = i.input_timesheet_id
),
t_eff_id as (
  select
    t_in.input_timesheet_id,
    coalesce(tc.timesheet_id, t_in.timesheet_id) as effective_timesheet_id
  from t_in
  left join public.timesheets tc
    on tc.booking_id = t_in.booking_id
   and tc.is_current = true
),
t_eff as (
  select
    e.input_timesheet_id,
    e.effective_timesheet_id,
    te.*
  from t_eff_id e
  join public.timesheets te
    on te.timesheet_id = e.effective_timesheet_id
),
base as (
  select
    te.effective_timesheet_id,
    correction_policy.envelope_json as correction_policy_envelope,
    correction_policy.leg_json as correction_policy_leg,

    -- TIME anchor date for client_settings.effective_from selection:
    -- DAILY: worked_start_iso local date
    -- WEEKLY: week_ending_date (fallback)
    coalesce(
      case
        when te.worked_start_iso is not null
          then (te.worked_start_iso at time zone 'Europe/London')::date
        else null
      end,
      te.week_ending_date::date
    ) as time_anchor_date,

    -- FINANCE anchor date for finance windows:
    -- authorised_at_server local date if present, else "today" local date
    coalesce(
      case
        when nullif(correction_policy.leg_json #>> '{tsfin_policy,pay_policy_date}', '') is not null
          then (correction_policy.leg_json #>> '{tsfin_policy,pay_policy_date}')::date
        else null
      end,
      case
        when te.authorised_at_server is not null
          then (te.authorised_at_server at time zone 'Europe/London')::date
        else null
      end,
      (now() at time zone 'Europe/London')::date
    ) as finance_anchor_date,

    -- ✅ Ensure new correction fields are always present in out_timesheet (even if null)
    (to_jsonb(te)
      || jsonb_build_object(
        'correction_id', te.correction_id,
        'correction_kind', te.correction_kind,
        'adjustment_origin', te.adjustment_origin
      )
    ) as out_timesheet,

    -- ✅ This will now include travel_/accommodation_/other_ columns automatically
    to_jsonb(tf) as out_cur_fin,

    to_jsonb(c)  as out_candidate,
    to_jsonb(u)  as out_umbrella,

    cid.client_id as out_client_id,
    authority.settings_authority_json as settings_authority,

    -- ✅ Expand “effective flags” for weekly consumers (still source-of-truth = v_timesheets_summary)
    jsonb_build_object(
      'route_type',                    v.route_type,

      'contract_id',                   v.contract_id,
      'contract_week_id',              v.contract_week_id,
      'contract_week_ending_date',     v.contract_week_ending_date,
      'basis',                         v.basis,

      'client_requires_hr',            (authority.settings_authority_json#>>'{values,requires_hr}')::boolean,
      'client_autoprocess_hr',         (authority.settings_authority_json#>>'{values,autoprocess_hr}')::boolean,
      'client_no_timesheet_required',  (authority.settings_authority_json#>>'{values,no_timesheet_required}')::boolean,
      'client_is_nhsp',                (authority.settings_authority_json#>>'{values,is_nhsp}')::boolean,

      'require_reference_to_pay',      (authority.settings_authority_json#>>'{values,require_reference_to_pay}')::boolean,
      'require_reference_to_invoice',  (authority.settings_authority_json#>>'{values,require_reference_to_invoice}')::boolean,

      'client_hr_validation_required', (authority.settings_authority_json#>>'{values,hr_validation_required}')::boolean,
      'client_ts_reference_required',  (authority.settings_authority_json#>>'{values,ts_reference_required}')::boolean,
      'client_pay_reference_required', (authority.settings_authority_json#>>'{values,require_reference_to_pay}')::boolean,
      'client_invoice_reference_required', (authority.settings_authority_json#>>'{values,require_reference_to_invoice}')::boolean,

      'pay_method',                    v.pay_method,
      'processing_status',             v.processing_status,
      'authorised_at_server',          v.authorised_at_server,

      -- ✅ NEW: computed here (because v_timesheets_summary does not expose hr_validation_required_for_invoice)
      'hr_validation_required_for_invoice',
        (
          v.timesheet_id is not null
          and coalesce((authority.settings_authority_json#>>'{values,hr_validation_required}')::boolean, false) = true
          and coalesce((authority.settings_authority_json#>>'{values,no_timesheet_required}')::boolean, false) = false
          and coalesce(v.total_hours, tf.total_hours, 0::numeric) > 0::numeric
        ),

      -- ✅ NEW: pass through validation status for TSFIN recompute gating
      'validation_status', v.validation_status
    ) as out_effective_flags
  from t_eff te

  left join lateral (
    select
      public._ctms_correction_policy_envelope_read_v1(te.effective_timesheet_id) as envelope_json,
      public._ctms_correction_policy_leg_read_v1(te.effective_timesheet_id) as leg_json
  ) correction_policy on true

  left join public.timesheets_financials tf
    on tf.timesheet_id = te.effective_timesheet_id
   and tf.is_current = true

  left join lateral (
    with candidate_resolution as (
      select
        case
          when upper(coalesce(te.sheet_scope::text, '')) = 'DAILY'
           and upper(coalesce(te.submission_mode::text, '')) = 'MANUAL'
           and coalesce(te.candidate_hint_text->>'candidate_id', '') ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
            then (te.candidate_hint_text->>'candidate_id')::uuid
          else null::uuid
        end as manual_candidate_hint_id,
        case
          when upper(coalesce(te.sheet_scope::text, '')) = 'DAILY'
           and upper(coalesce(te.submission_mode::text, '')) = 'MANUAL'
            then tf.candidate_id
          else null::uuid
        end as manual_current_candidate_id
    ),
    candidate_matches as (
      select
        c1.id as candidate_id,
        0 as match_priority,
        c1.updated_at as match_updated_at,
        c1.created_at as match_created_at
      from public.candidates c1
      cross join candidate_resolution cr
      where cr.manual_candidate_hint_id is not null
        and c1.id = cr.manual_candidate_hint_id

      union all

      select
        c1.id as candidate_id,
        1 as match_priority,
        c1.updated_at as match_updated_at,
        c1.created_at as match_created_at
      from public.candidates c1
      cross join candidate_resolution cr
      where cr.manual_current_candidate_id is not null
        and c1.id = cr.manual_current_candidate_id
        and (
          cr.manual_candidate_hint_id is null
          or c1.id <> cr.manual_candidate_hint_id
        )

      union all

      select
        c1.id as candidate_id,
        case
          when c1.key_norm = te.occupant_key_norm then 2
          else 3
        end as match_priority,
        c1.updated_at as match_updated_at,
        c1.created_at as match_created_at
      from public.candidates c1
      where
        c1.key_norm = te.occupant_key_norm
        or (
          te.occupant_key_norm is not null
          and c1.nhsp_hr_name_aliases @> to_jsonb(array[te.occupant_key_norm]::text[])
        )
    )
    select candidate_matches.candidate_id
    from candidate_matches
    order by
      candidate_matches.match_priority,
      candidate_matches.match_updated_at desc nulls last,
      candidate_matches.match_created_at desc nulls last
    limit 1
  ) candidate_pick on true

  left join public.candidates c
    on c.id = candidate_pick.candidate_id

  left join public.umbrellas u
    on (c.umbrella_id is not null and u.id = c.umbrella_id)

  left join public.v_timesheets_summary v
    on v.timesheet_id = te.effective_timesheet_id

  left join lateral (
    select ch.client_id
    from public.client_hospitals ch
    where te.hospital_norm is not null
      and ch.hospital_name_norm @> jsonb_build_array(te.hospital_norm)
    limit 1
  ) ch on true

  -- ✅ Resolve a single client_id for this timesheet (works for WEEKLY and DAILY)
  left join lateral (
    select coalesce(v.client_id, tf.client_id, ch.client_id) as client_id
  ) cid on true

  left join lateral (
    select private._contract_settings_effective_core_v1(
      cid.client_id,
      te.contract_id,
      coalesce(
        (te.worked_start_iso at time zone 'Europe/London')::date,
        (te.scheduled_start_iso at time zone 'Europe/London')::date,
        te.week_ending_date::date
      ),
      case when te.sheet_scope='DAILY'::public.timesheet_scope_enum then 'DAILY' else 'FINANCE' end,
      te.effective_timesheet_id
    ) as settings_authority_json
  ) authority on true
),
ctx as (
  select
    b.effective_timesheet_id,

    b.out_timesheet,
    b.out_cur_fin,
    b.out_candidate,
    b.out_umbrella,
    b.out_client_id,
    b.out_effective_flags,

    -- Every policy input comes from the Timesheet authority snapshot.  The
    -- correction envelope keeps its existing explicit overrides.
    jsonb_build_object(
      'timezone_id', coalesce(b.settings_authority#>>'{values,timezone_id}','Europe/London'),
      'day_start',   coalesce(b.settings_authority#>>'{values,day_start}','06:00:00'),
      'day_end',     coalesce(b.settings_authority#>>'{values,day_end}','20:00:00'),
      'night_start', coalesce(b.settings_authority#>>'{values,night_start}','20:00:00'),
      'night_end',   coalesce(b.settings_authority#>>'{values,night_end}','06:00:00'),
      'sat_start',   coalesce(b.settings_authority#>>'{values,sat_start}','00:00:00'),
      'sat_end',     coalesce(b.settings_authority#>>'{values,sat_end}','00:00:00'),
      'sun_start',   coalesce(b.settings_authority#>>'{values,sun_start}','00:00:00'),
      'sun_end',     coalesce(b.settings_authority#>>'{values,sun_end}','00:00:00'),
      'bh_start',    coalesce(b.settings_authority#>>'{values,bh_start}','00:00:00'),
      'bh_end',      coalesce(b.settings_authority#>>'{values,bh_end}','00:00:00'),

      'vat_rate_pct',
      coalesce(nullif(b.correction_policy_leg #>> '{tsfin_policy,applied_pay_vat_rate_pct}', '')::numeric,
        nullif(b.settings_authority#>>'{values,vat_rate_pct}','')::numeric,20::numeric),

      'pay_vat_rate_pct',
      coalesce(nullif(b.correction_policy_leg #>> '{tsfin_policy,applied_pay_vat_rate_pct}', '')::numeric,
        nullif(b.settings_authority#>>'{values,vat_rate_pct}','')::numeric,20::numeric),

      'correction_financials_policy_envelope', b.correction_policy_envelope,
      'correction_financials_policy_envelope_fingerprint', b.correction_policy_leg ->> 'envelope_fingerprint',
      'correction_leg_fingerprint', b.correction_policy_leg ->> 'leg_fingerprint',
      'correction_tsfin_policy', b.correction_policy_leg -> 'tsfin_policy',
      'correction_tsfin_policy_fingerprint', b.correction_policy_leg #>> '{tsfin_policy,tsfin_policy_fingerprint}',
      'correction_invoice_policy', b.correction_policy_leg -> 'invoice_policy',
      'correction_invoice_policy_fingerprint', b.correction_policy_leg #>> '{invoice_policy,invoice_policy_fingerprint}',
      'correction_invoice_stream', b.correction_policy_leg #>> '{invoice_policy,invoice_stream}',
      'correction_pay_policy_date', b.correction_policy_leg #>> '{tsfin_policy,pay_policy_date}',
      'correction_invoice_policy_date', b.correction_policy_leg #>> '{invoice_policy,invoice_policy_date}',

      'holiday_pay_pct',
      coalesce(nullif(b.settings_authority#>>'{values,holiday_pay_pct}','')::numeric,12.07::numeric),

      'erni_pct',
      coalesce(nullif(b.correction_policy_leg #>> '{tsfin_policy,erni_pct}', '')::numeric,
        nullif(b.settings_authority#>>'{values,erni_pct}','')::numeric,13.8::numeric),

      'mileage_pay_defaults',
      b.settings_authority#>'{values,mileage_pay_defaults}',

      'mileage_charge_defaults',
      b.settings_authority#>'{values,mileage_charge_defaults}',

      'apply_holiday_to',
      coalesce(b.settings_authority#>>'{values,apply_holiday_to}','PAYE_ONLY'),

      'apply_erni_to',
      coalesce(nullif(b.correction_policy_leg #>> '{tsfin_policy,apply_erni_to}', ''),
        b.settings_authority#>>'{values,apply_erni_to}','PAYE_ONLY'),

      'margin_includes',
      coalesce(b.settings_authority#>'{values,margin_includes}',
        jsonb_build_object('expenses',false,'mileage',false)),

      'bh_list',
      coalesce(b.settings_authority#>'{values,bh_list}','[]'::jsonb),

      'hr_attach_to_invoice', coalesce((b.settings_authority#>>'{values,hr_attach_to_invoice}')::boolean,true),
      'ts_attach_to_invoice', coalesce((b.settings_authority#>>'{values,ts_attach_to_invoice}')::boolean,true),

      'week_ending_weekday', coalesce((b.settings_authority#>>'{values,week_ending_weekday}')::integer,0),
      'default_submission_mode', coalesce(b.settings_authority#>>'{values,default_submission_mode}','ELECTRONIC'),
      'settings_authority_version',b.settings_authority->>'authority_version',
      'settings_authority_fingerprint',b.settings_authority->>'authority_fingerprint'
    ) as out_policy
  from base b
)
select
  effective_timesheet_id,
  out_timesheet,
  out_cur_fin,
  out_candidate,
  out_umbrella,
  out_client_id,
  out_effective_flags,
  out_policy
from ctx;
$$;

-- public.tsfin_resolve_rates_batch(jsonb); supabase/repeatable/05012026_tsfin_resolve_rates_batch.sql; SHA256 52e0361d183e4c99ff95aa71f3fffd5165881fc212af92890ab7a12230c46dcb
create or replace function public.tsfin_resolve_rates_batch(p_items jsonb)
returns table (
  k text,
  candidate_id uuid,
  client_id uuid,
  role text,
  band text,
  date_ymd date,
  rate_type text,

  source_kind text,
  override_id uuid,
  default_id uuid,

  pay_day numeric,
  pay_night numeric,
  pay_sat numeric,
  pay_sun numeric,
  pay_bh numeric,

  charge_day numeric,
  charge_night numeric,
  charge_sat numeric,
  charge_sun numeric,
  charge_bh numeric
)
language sql
stable
as $$
with items as (
  select
    coalesce(nullif(elem->>'k',''), nullif(elem->>'timesheet_id','')) as k,

    nullif(elem->>'candidate_id','')::uuid as candidate_id,
    nullif(elem->>'client_id','')::uuid as client_id,

    nullif(elem->>'role','') as role,
    nullif(elem->>'band','') as band,

    nullif(elem->>'date','')::date as date_ymd,

    upper(coalesce(nullif(elem->>'rate_type',''), 'UMBRELLA')) as rate_type_raw
  from jsonb_array_elements(coalesce(p_items, '[]'::jsonb)) as elem
),
norm as (
  select
    i.*,
    case
      when i.rate_type_raw in ('PAYE','UMBRELLA') then i.rate_type_raw
      else 'UMBRELLA'
    end as rate_type
  from items i
),
resolved as (
  select
    n.k,
    n.candidate_id,
    n.client_id,
    n.role,
    n.band,
    n.date_ymd,
    n.rate_type,

    ov.id as override_id,

    df.id as default_id,

    -- pay buckets: override first, else client defaults by rate_type
    case
      when ov.id is not null then ov.pay_day
      when df.id is not null and n.rate_type = 'PAYE' then df.paye_day
      when df.id is not null and n.rate_type = 'UMBRELLA' then df.umb_day
      else null
    end as pay_day,

    case
      when ov.id is not null then ov.pay_night
      when df.id is not null and n.rate_type = 'PAYE' then df.paye_night
      when df.id is not null and n.rate_type = 'UMBRELLA' then df.umb_night
      else null
    end as pay_night,

    case
      when ov.id is not null then ov.pay_sat
      when df.id is not null and n.rate_type = 'PAYE' then df.paye_sat
      when df.id is not null and n.rate_type = 'UMBRELLA' then df.umb_sat
      else null
    end as pay_sat,

    case
      when ov.id is not null then ov.pay_sun
      when df.id is not null and n.rate_type = 'PAYE' then df.paye_sun
      when df.id is not null and n.rate_type = 'UMBRELLA' then df.umb_sun
      else null
    end as pay_sun,

    case
      when ov.id is not null then ov.pay_bh
      when df.id is not null and n.rate_type = 'PAYE' then df.paye_bh
      when df.id is not null and n.rate_type = 'UMBRELLA' then df.umb_bh
      else null
    end as pay_bh,

    -- charge buckets: always from client defaults (may be null if no default)
    case when df.id is not null then df.charge_day else null end as charge_day,
    case when df.id is not null then df.charge_night else null end as charge_night,
    case when df.id is not null then df.charge_sat else null end as charge_sat,
    case when df.id is not null then df.charge_sun else null end as charge_sun,
    case when df.id is not null then df.charge_bh else null end as charge_bh

  from norm n

  -- Candidate override (pay-only): exact client + exact role + exact rate_type.
  -- Band rule (STRICT):
  --  - if band provided: ONLY exact band
  --  - if band null: ONLY band is null (no guessing)
  left join lateral (
    select o.*
    from public.rates_candidate_overrides o
    where n.candidate_id is not null
      and n.client_id is not null
      and n.role is not null
      and n.date_ymd is not null
      and o.candidate_id = n.candidate_id
      and o.client_id = n.client_id
      and o.role = n.role
      and o.rate_type = n.rate_type
      and o.date_from <= n.date_ymd
      and (o.date_to is null or o.date_to >= n.date_ymd)
      and (
        (n.band is null and o.band is null)
        or
        (n.band is not null and o.band = n.band)
      )
    order by
      case
        when n.band is not null and o.band = n.band then 0
        when o.band is null then 1
        else 9
      end,
      o.date_from desc,
      o.updated_at desc
    limit 1
  ) ov on true

  -- Client defaults (charge always, pay fallback if no override).
  -- Must be enabled: disabled_at_utc is null.
  -- Band rule (STRICT):
  --  - if band provided: ONLY exact band
  --  - if band null: ONLY band null
  left join lateral (
    select d.*
    from public.rates_client_defaults d
    where n.client_id is not null
      and n.role is not null
      and n.date_ymd is not null
      and d.client_id = n.client_id
      and d.role = n.role
      and d.disabled_at_utc is null
      and d.date_from <= n.date_ymd
      and (d.date_to is null or d.date_to >= n.date_ymd)
      and (
        (n.band is null and d.band is null)
        or
        (n.band is not null and d.band = n.band)
      )
    order by
      case
        when n.band is not null and d.band = n.band then 0
        when d.band is null then 1
        else 9
      end,
      d.date_from desc,
      d.updated_at desc
    limit 1
  ) df on true
)
select
  r.k,
  r.candidate_id,
  r.client_id,
  r.role,
  r.band,
  r.date_ymd,
  r.rate_type,

  case
    when r.override_id is not null then 'CANDIDATE_OVERRIDE'
    when r.default_id is not null then 'CLIENT_DEFAULT'
    else 'NONE'
  end as source_kind,

  r.override_id,
  r.default_id,

  r.pay_day, r.pay_night, r.pay_sat, r.pay_sun, r.pay_bh,
  r.charge_day, r.charge_night, r.charge_sat, r.charge_sun, r.charge_bh
from resolved r;
$$;

-- private.bpay_next_treatment_payload_assert_v1(uuid); supabase/repeatable/12102026_2135_banking_pay_next_treatment_native_publication_v1.sql; SHA256 2a3c04531f229e7963e0f226716f577f97d9ca056c818fbee8898a7319d62fd2
create or replace function private.bpay_next_treatment_payload_assert_v1(p_revision_id uuid)
returns void language plpgsql volatile security invoker set search_path=pg_catalog,private
as $function$
declare r private.bpay_next_work_revision%rowtype; a private.bpay_next_work_revision%rowtype;
begin
 select x.* into strict r from private.bpay_next_work_revision x where x.id=p_revision_id;
 if r.payment_treatment_approval_revision_id is null then return;end if;
 select x.* into a from private.bpay_next_work_revision x
  where x.id=r.payment_treatment_approval_revision_id and x.work_id=r.work_id;
 if a.id is null or a.id=r.id or a.payment_treatment_approval_revision_id is not null
  or a.sealed_at_utc is null or a.approved_at_utc is null or r.source_event_id is not null
  or r.revision_no<=a.revision_no
  or (to_jsonb(r)-array['id','revision_no','source_event_id','approved_at_utc','sealed_at_utc','created_at_utc','payment_treatment_approval_revision_id']) is distinct from (to_jsonb(a)-array['id','revision_no','source_event_id','approved_at_utc','sealed_at_utc','created_at_utc','payment_treatment_approval_revision_id']) then
  raise exception using errcode='23514',message='BPAY_NEXT_TREATMENT_SOURCE_CHANGED';end if;
 if exists(with original as (select to_jsonb(x)-array['id','revision_id','created_at_utc'] payload from private.bpay_next_approved_line x where x.revision_id=a.id), treatment as (select to_jsonb(x)-array['id','revision_id','created_at_utc'] payload from private.bpay_next_approved_line x where x.revision_id=r.id)
  (select payload from original except all select payload from treatment)
  union all (select payload from treatment except all select payload from original)) then
  raise exception using errcode='23514',message='BPAY_NEXT_TREATMENT_LINE_PAYLOAD_CHANGED';end if;
 if exists(with original as (select jsonb_build_array(l.component_key,to_jsonb(x)-array['id','approved_line_id']) payload from private.bpay_next_rate_detail x join private.bpay_next_approved_line l on l.id=x.approved_line_id where l.revision_id=a.id), treatment as (select jsonb_build_array(l.component_key,to_jsonb(x)-array['id','approved_line_id']) payload from private.bpay_next_rate_detail x join private.bpay_next_approved_line l on l.id=x.approved_line_id where l.revision_id=r.id)
  (select payload from original except all select payload from treatment)
  union all (select payload from treatment except all select payload from original)) then
  raise exception using errcode='23514',message='BPAY_NEXT_TREATMENT_RATE_PAYLOAD_CHANGED';end if;
 if exists(with original as (select to_jsonb(x)-array['id','revision_id'] payload from private.bpay_next_rate_schedule x where x.revision_id=a.id), treatment as (select to_jsonb(x)-array['id','revision_id'] payload from private.bpay_next_rate_schedule x where x.revision_id=r.id)
  (select payload from original except all select payload from treatment)
  union all (select payload from treatment except all select payload from original)) then
  raise exception using errcode='23514',message='BPAY_NEXT_TREATMENT_SCHEDULE_PAYLOAD_CHANGED';end if;
 if exists(with original as (select jsonb_build_array(l.component_key,to_jsonb(x)-array['id','approved_line_id']) payload from private.bpay_next_shift_detail x join private.bpay_next_approved_line l on l.id=x.approved_line_id where l.revision_id=a.id), treatment as (select jsonb_build_array(l.component_key,to_jsonb(x)-array['id','approved_line_id']) payload from private.bpay_next_shift_detail x join private.bpay_next_approved_line l on l.id=x.approved_line_id where l.revision_id=r.id)
  (select payload from original except all select payload from treatment)
  union all (select payload from treatment except all select payload from original)) then
  raise exception using errcode='23514',message='BPAY_NEXT_TREATMENT_SHIFT_PAYLOAD_CHANGED';end if;
 if exists(with original as (select jsonb_build_array(l.component_key,d.detail_no,to_jsonb(x)-array['id','shift_detail_id']) payload from private.bpay_next_break_detail x join private.bpay_next_shift_detail d on d.id=x.shift_detail_id join private.bpay_next_approved_line l on l.id=d.approved_line_id where l.revision_id=a.id), treatment as (select jsonb_build_array(l.component_key,d.detail_no,to_jsonb(x)-array['id','shift_detail_id']) payload from private.bpay_next_break_detail x join private.bpay_next_shift_detail d on d.id=x.shift_detail_id join private.bpay_next_approved_line l on l.id=d.approved_line_id where l.revision_id=r.id)
  (select payload from original except all select payload from treatment)
  union all (select payload from treatment except all select payload from original)) then
  raise exception using errcode='23514',message='BPAY_NEXT_TREATMENT_BREAK_PAYLOAD_CHANGED';end if;
 if r.sealed_at_utc is not null then
 if exists(with original as (select jsonb_build_array(l.component_key,d.detail_no,to_jsonb(x)-array['id','revision_id','approved_line_id','shift_detail_id']) payload from private.bpay_next_approved_segment x join private.bpay_next_approved_line l on l.id=x.approved_line_id join private.bpay_next_shift_detail d on d.id=x.shift_detail_id where x.revision_id=a.id), treatment as (select jsonb_build_array(l.component_key,d.detail_no,to_jsonb(x)-array['id','revision_id','approved_line_id','shift_detail_id']) payload from private.bpay_next_approved_segment x join private.bpay_next_approved_line l on l.id=x.approved_line_id join private.bpay_next_shift_detail d on d.id=x.shift_detail_id where x.revision_id=r.id)
  (select payload from original except all select payload from treatment)
  union all (select payload from treatment except all select payload from original)) then
  raise exception using errcode='23514',message='BPAY_NEXT_TREATMENT_SEGMENT_PAYLOAD_CHANGED';end if;
 end if;
end
$function$;

-- private.bpay_next_local_detail_seam_guard_v1(); supabase/repeatable/10102026_0736_banking_pay_next_local_detail_seam_v1.sql; SHA256 9d6367a21014cce75bb0a3ca7e0b01ca4c6ecbd2fa9d7e20ae9cd6f3f0ac3e5b
create or replace function private.bpay_next_local_detail_seam_guard_v1()
returns trigger language plpgsql security invoker
set search_path=pg_catalog
as $guard$
begin
  if tg_op in ('UPDATE','DELETE','TRUNCATE') then
    raise exception using errcode='23514',message='BPAY_NEXT_LOCAL_DETAIL_SEAM_IMMUTABLE';
  elsif tg_op='INSERT' then
    if new.transaction_id is distinct from pg_catalog.pg_current_xact_id() or new.consumed is distinct from true then
      raise exception using errcode='23514',message='BPAY_NEXT_LOCAL_DETAIL_SEAM_CONSUMPTION_INVALID';
    end if;
  end if;
  return new;
end $guard$;

-- private.bpay_next_case_list_native_changed_v1(); supabase/repeatable/11102026_1738_banking_pay_next_case_list_v1.sql; SHA256 1ded05c740fc31c993d3001048cd5b762c17e9b712c764f0ffcc522a0e6f53f2
create or replace function private.bpay_next_case_list_native_changed_v1()
returns trigger language plpgsql volatile security definer set search_path=pg_catalog,private
as $function$
declare v_id uuid;v_candidate uuid;
begin
 if tg_table_schema<>'private' then raise exception using errcode='42501',message='BPAY_NEXT_CASE_LIST_TRIGGER_SCOPE';end if;
 update private.bpay_next_workbench_revision set workbench_revision=workbench_revision+1,
  updated_at_utc=pg_catalog.transaction_timestamp() where id=1;
 if tg_table_name='bpay_next_workbench_candidate_metadata' then
  v_candidate:=case when tg_op='DELETE' then old.candidate_id else new.candidate_id end;
  if tg_op='UPDATE' and (old.candidate_sort_name,old.tms_ref)
    is not distinct from (new.candidate_sort_name,new.tms_ref) then return null;end if;
  update private.bpay_next_case_list_key k set
   candidate_sort_name=lower(coalesce(m.candidate_sort_name,nullif(btrim(ca.display_name),''),
    nullif(btrim(concat_ws(' ',ca.first_name,ca.last_name)),''),ca.id::text)),
   candidate_display_name=coalesce(m.candidate_sort_name,nullif(btrim(ca.display_name),''),
    nullif(btrim(concat_ws(' ',ca.first_name,ca.last_name)),''),ca.id::text),
   candidate_reference=coalesce(m.tms_ref,ca.tms_ref)
  from public.candidates ca left join private.bpay_next_workbench_candidate_metadata m on m.candidate_id=ca.id
  where k.candidate_id=v_candidate and ca.id=v_candidate;
 elsif tg_table_name='bpay_next_finance_case' then
  v_id:=case when tg_op='DELETE' then old.id else new.id end;
  perform private.bpay_next_case_list_refresh_key_v1(v_id);
 elsif tg_table_name in ('bpay_next_case_rule','bpay_next_case_component','bpay_next_case_period','bpay_next_snooze','bpay_next_work_collection') then
  v_id:=case when tg_op='DELETE' then old.case_id else new.case_id end;
  if v_id is null then return null;end if;
  perform private.bpay_next_case_list_refresh_key_v1(v_id);
 else raise exception using errcode='42501',message='BPAY_NEXT_CASE_LIST_TRIGGER_SCOPE';end if;

 return null;
end
$function$;

-- private.bpay_next_case_list_refresh_key_v1(uuid); supabase/repeatable/12102026_0132_banking_pay_next_candidate_case_sort_readers_v1.sql; SHA256 a8fa272bf93d079cc78a7b32bf5fbbbe91f81c4d2c9f832f232ad10dcad4b86a
create or replace function private.bpay_next_case_list_refresh_key_v1(p_case_id uuid)
returns void language plpgsql volatile security invoker set search_path=pg_catalog,private,public
as $function$
declare v_origin jsonb;v_collection private.bpay_next_work_collection%rowtype;
begin
 select c.* into v_collection from private.bpay_next_work_collection c where c.case_id=p_case_id;
 if found then
  v_origin:=private.bpay_next_payment_client_origin_v1(v_collection.original_revision_id);
 end if;
 insert into private.bpay_next_case_list_key(case_id,candidate_id,created_at_utc,candidate_sort_name,
  candidate_display_name,candidate_reference,case_subtype,case_type_label,client_id,client_display_name,client_association,list_status,list_original,list_outstanding,list_weekly_due,list_funded,list_recovered,list_written_off)
 select c.id,c.candidate_id,r0.case_created_at_utc,
  lower(coalesce(m.candidate_sort_name,nullif(btrim(ca.display_name),''),nullif(btrim(concat_ws(' ',ca.first_name,ca.last_name)),''),ca.id::text)),
  coalesce(m.candidate_sort_name,nullif(btrim(ca.display_name),''),nullif(btrim(concat_ws(' ',ca.first_name,ca.last_name)),''),ca.id::text),
  coalesce(m.tms_ref,ca.tms_ref),r.case_subtype,
  case r.case_subtype when 'LOAN' then 'Payment Advance' when 'PAYMENT_ADVANCE' then 'Payment Advance'
   when 'OVERPAYMENT' then 'Overpayment' when 'UNDERPAYMENT' then 'Underpayment'
   when 'MANUAL_CREDIT' then 'Manual Credit' when 'MANUAL_DEBT' then 'Manual Debt' else 'Unmapped case' end,
  case when v_origin->>'classification'='CLASSIFIED' then (v_origin->>'client_id')::uuid end,
  v_origin->>'client_display_name',
  case when v_collection.id is null then 'UNASSOCIATED' when v_origin->>'classification'='CLASSIFIED' then 'FROZEN' else 'UNKNOWN' end,c.status,c.principal_approved,
  (case when c.case_kind in ('LOAN','ADVANCE') then c.principal_funded else c.principal_approved end)-c.principal_recovered-c.principal_written_off-c.principal_paid_credit,r.weekly_due_source_ex_vat,c.principal_funded,c.principal_recovered,c.principal_written_off
 from private.bpay_next_finance_case c join public.candidates ca on ca.id=c.candidate_id
 left join private.bpay_next_case_rule r0 on r0.case_id=c.id and r0.candidate_id=c.candidate_id and r0.rule_revision=1
 left join private.bpay_next_case_rule r on r.id=c.current_rule_id and r.case_id=c.id and r.candidate_id=c.candidate_id
  and r.rule_revision=c.current_rule_revision
 left join private.bpay_next_workbench_candidate_metadata m on m.candidate_id=c.candidate_id
 where c.id=p_case_id
 on conflict(case_id) do update set candidate_id=excluded.candidate_id,created_at_utc=excluded.created_at_utc,
  candidate_sort_name=excluded.candidate_sort_name,candidate_display_name=excluded.candidate_display_name,candidate_reference=excluded.candidate_reference,
  case_subtype=excluded.case_subtype,case_type_label=excluded.case_type_label,client_id=excluded.client_id,
  client_display_name=excluded.client_display_name,client_association=excluded.client_association,list_status=excluded.list_status,list_original=excluded.list_original,
  list_outstanding=excluded.list_outstanding,list_weekly_due=excluded.list_weekly_due,list_funded=excluded.list_funded,list_recovered=excluded.list_recovered,list_written_off=excluded.list_written_off;
end
$function$;

-- private.bpay_next_payment_client_origin_v1(uuid); supabase/repeatable/12102026_0620_banking_pay_next_frozen_used_line_detail_v1.sql; SHA256 827fb08eff5914f5a754c30f11273be492138c155778ea33e5533b03f1c0e206
create or replace function private.bpay_next_payment_client_origin_v1(p_revision_id uuid)
returns jsonb
language plpgsql stable security definer
set search_path=pg_catalog,private
as $function$
declare
  v_revision private.bpay_next_work_revision%rowtype;
  v_work private.bpay_next_work%rowtype;
  v_daily boolean;
  v_evidence jsonb;
  v_settings jsonb;
  v_client_id uuid;
  v_classification text:='UNKNOWN';
begin
  if p_revision_id is null then
    raise exception using errcode='22023',message='BPAY_NEXT_FROZEN_REVISION_REQUIRED';
  end if;
  select r.* into strict v_revision from private.bpay_next_work_revision r where r.id=p_revision_id;
  select w.* into strict v_work from private.bpay_next_work w where w.id=v_revision.work_id;
  if v_revision.approved_at_utc is null or v_revision.sealed_at_utc is null then
    raise exception using errcode='55000',message='BPAY_NEXT_FROZEN_DETAIL_NOT_AVAILABLE';
  end if;
  v_daily:=v_work.origin_kind='DAILY' or (
    v_revision.daily_approval_evidence_json->>'contract_version'='BPAY_NEXT_DAILY_APPROVAL_EVIDENCE_V1'
    and v_revision.daily_approval_evidence_json->>'sheet_scope'='DAILY');
  v_evidence:=v_revision.daily_approval_evidence_json;
  v_settings:=v_evidence->'settings_authority_json';
  -- Only sealed native Daily evidence can classify its original Client here.
  -- Missing proof keeps the payment visible; contradictions never infer a Client.
  if v_daily and jsonb_typeof(v_evidence)='object'
     and v_evidence ?& array['contract_version','sheet_scope','timesheet_id','timesheet_version',
       'financial_id','candidate_id','booking_id','contract_id','client_id','work_date',
       'financial_authorised_at_utc','timesheet_authorised_at_utc']
     and v_evidence->>'client_id' ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
     and v_evidence->>'financial_authorised_at_utc' is not null
     and v_evidence->>'timesheet_authorised_at_utc' is not null
     and jsonb_typeof(v_settings)='object'
     and v_settings ?& array['authority_version','workflow','client_id','contract_id','relevant_date','authority_fingerprint'] then
    v_classification:='UNCLASSIFIED_MISMATCH';
    if v_evidence->>'contract_version'='BPAY_NEXT_DAILY_APPROVAL_EVIDENCE_V1'
       and v_evidence->>'sheet_scope'='DAILY'
       and v_evidence->>'client_id' ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
       and v_evidence->>'timesheet_id'=v_revision.physical_timesheet_id::text
       and v_evidence->>'timesheet_version'=v_revision.physical_timesheet_version::text
       and v_evidence->>'financial_id'=v_revision.financial_snapshot_id::text
       and v_evidence->>'candidate_id'=v_work.candidate_id::text
       and v_evidence->>'booking_id'=v_work.booking_id
       and v_evidence->'contract_id'=coalesce(to_jsonb(v_work.contract_id),'null'::jsonb)
       and (v_work.origin_kind<>'DAILY' or v_evidence->>'work_date'=v_work.origin_work_date::text)
       and jsonb_typeof(v_settings)='object'
       and v_settings->>'authority_version'='CONTRACT_SETTINGS_AUTHORITY_V1'
       and v_settings->>'workflow'='DAILY'
       and v_settings->>'client_id'=v_evidence->>'client_id'
       and v_settings->'contract_id'=v_evidence->'contract_id'
       and v_settings->>'relevant_date'=v_evidence->>'work_date'
       and v_settings->>'authority_fingerprint' ~ '^[0-9a-f]{64}$'
       and v_evidence->>'financial_authorised_at_utc' is not null
       and v_evidence->>'timesheet_authorised_at_utc' is not null then
      v_client_id:=(v_evidence->>'client_id')::uuid;v_classification:='CLASSIFIED';
    end if;
  end if;
  return jsonb_build_object(
    'revision_id',v_revision.id,'origin_kind',v_work.origin_kind,
    'source_kind',v_revision.source_kind,
    'sheet_scope',case when v_daily then 'DAILY' end,'contract_id',v_work.contract_id,
    'client_id',v_client_id,'classification',v_classification,
    'work_date',case when v_work.origin_kind='DAILY' then v_work.origin_work_date::text
      when v_daily then v_revision.daily_approval_evidence_json->>'work_date' end,
    'physical_timesheet_id',v_revision.physical_timesheet_id,
    'physical_timesheet_version',v_revision.physical_timesheet_version,
    'candidate_display_name',v_revision.candidate_display_name,
    'candidate_reference',v_revision.candidate_reference,
    'client_display_name',v_revision.client_display_name,'job_title',v_revision.job_title,
    'band_label',v_revision.band_label,'timesheet_reference',v_revision.timesheet_reference,
    'pay_channel',v_revision.source_pay_channel,
    'authorised_at_utc',case when v_daily then v_revision.daily_approval_evidence_json->'financial_authorised_at_utc'
      else to_jsonb(v_revision.approved_at_utc) end);
end
$function$;

-- private.bpay_next_component_resolution_event_guard_v1(); supabase/repeatable/12102026_2100_banking_pay_next_resolution_remaining_quote_v1.sql; SHA256 be7dfddbd6cafbc6f0456a62ffba1135565418f066199fd99be0efd160b5f8ba
create or replace function private.bpay_next_component_resolution_event_guard_v1()
returns trigger language plpgsql security invoker set search_path=pg_catalog,private
as $function$
declare d private.bpay_next_component_resolution%rowtype;m private.bpay_next_pay_method_change_member%rowtype;
 r private.bpay_next_pay_method_change_receipt%rowtype;a private.bpay_next_approved_line%rowtype;
 rev private.bpay_next_work_revision%rowtype;
begin
 if TG_OP<>'INSERT' then raise exception using errcode='55000',message='BPAY_NEXT_RESOLUTION_EVENT_IMMUTABLE';end if;
 if new.event_kind='NEED' then
  -- Retaining an explicit unresolved scope must not require a quotable rate.
  select wb45src.* into a from private.bpay_next_approved_line wb45src
   where id=new.approved_line_id and revision_id=new.revision_id;
  select wb45src.* into rev from private.bpay_next_work_revision wb45src where id=new.revision_id;
  if a.id is null or rev.sealed_at_utc is null or rev.approved_at_utc is null
   or(new.rate_family='STANDARD' and (a.component_kind not in ('WORK','PROTECTED_WORK')
    or not exists(select 1 from private.bpay_next_rate_detail where approved_line_id=a.id and bucket=new.rate_code)))
   or(new.rate_family='ADDITIONAL' and (a.component_kind<>'ADDITIONAL' or a.component_key<>'ADDITIONAL:'||new.rate_code))
   or(new.rate_family='ADJUSTMENT' and (a.component_kind<>'ADJUSTMENT' or a.component_key<>new.rate_code)) then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_NEED_IDENTITY_CHANGED';end if;
  select wb45src.* into m from private.bpay_next_pay_method_change_member wb45src where operation_id=new.need_operation_id and member_key=new.need_member_key;
  select wb45src.* into r from private.bpay_next_pay_method_change_receipt wb45src where operation_id=new.need_operation_id;
  if m.classification is distinct from 'NEEDS_DECISION' or m.work_id is distinct from new.work_id
   or m.revision_id is distinct from new.revision_id or m.candidate_id is distinct from new.candidate_id
   or (m.approved_line_id is not null and m.approved_line_id<>new.approved_line_id)
   or r.post_metadata_version is distinct from new.need_version or r.actor_user_id is distinct from new.actor_user_id then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_NEED_IDENTITY_CHANGED';end if;
 else
  perform private.bpay_next_component_resolution_basis_v1(new.revision_id,new.approved_line_id,new.rate_family,new.rate_code);
  select wb45src.* into d from private.bpay_next_component_resolution wb45src where id=new.decision_id and decision_version=new.decision_version;
  if (d.work_id,d.candidate_id,d.based_on_revision_id,d.approved_line_id,d.rate_family,d.rate_code)
   is distinct from (new.work_id,new.candidate_id,new.revision_id,new.approved_line_id,new.rate_family,new.rate_code)
   or d.state is distinct from 'ACTIVE'
   or(new.event_kind='SAVED' and (d.command_id,d.actor_user_id) is distinct from (new.command_id,new.actor_user_id)) then
   raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_EVENT_IDENTITY_CHANGED';end if;
 end if;
 return new;
end
$function$;

-- private.bpay_next_component_resolution_event_audit_guard_v1(); supabase/repeatable/12102026_2100_banking_pay_next_resolution_remaining_quote_v1.sql; SHA256 3f93786cd3d3d61ed9172b70ff4a4e1153801870db49744bcd846e971cafdd25
create or replace function private.bpay_next_component_resolution_event_audit_guard_v1()
returns trigger language plpgsql security invoker set search_path=pg_catalog,private
as $function$
begin
 if new.event_kind='CLEARED' and not exists(select 1 from private.bpay_next_component_resolution d
   where d.id=new.decision_id and d.decision_version=new.decision_version and d.state='CLEARED') then
  raise exception using errcode='23514',message='BPAY_NEXT_RESOLUTION_AUDIT_MISSING';end if;
 return null;
end
$function$;

-- private.bpay_next_segment_revision_seal_v1(); supabase/repeatable/10102026_1236_banking_pay_next_segment_authority_final_v1.sql; SHA256 327f1a1c3d37cc00415b9c91b571a0eee57dcafa4d25f56cc70a6819bba7a8f2
create or replace function private.bpay_next_segment_revision_seal_v1()
returns trigger language plpgsql security invoker set search_path=pg_catalog,private
as $function$
declare v_row record; v_whole jsonb; v_expenses jsonb;
begin
  if old.sealed_at_utc is not null or new.sealed_at_utc is null then return new; end if;
  -- Genuine stable keys were persisted by the named approval producers.
  -- Existing producer traversal remains; read CHECK is a point lookup below.
  insert into private.bpay_next_approved_segment(revision_id,approved_line_id,component_key,segment_key,
    shift_detail_id,work_date,shift_start_at,shift_end_at,shift_start_local,shift_end_local,shift_overnight,
    approved_hours,hours_day,hours_night,hours_sat,hours_sun,hours_bh,
    pay_day,pay_night,pay_sat,pay_sun,pay_bh,approved_source_ex_vat,pay_excluded)
  select a.revision_id,a.id,a.component_key,d.segment_key,d.id,d.work_date,d.shift_start_at,d.shift_end_at,
    d.shift_start_local,d.shift_end_local,d.shift_overnight,d.approved_hours,
    d.hours_day,d.hours_night,d.hours_sat,d.hours_sun,d.hours_bh,
    rd.pay_day,rd.pay_night,rd.pay_sat,rd.pay_sun,rd.pay_bh,d.segment_pay_ex_vat,d.pay_excluded
  from private.bpay_next_approved_line a join private.bpay_next_shift_detail d on d.approved_line_id=a.id
  left join lateral(select max(x.source_pay_rate::numeric) filter(where x.bucket='DAY') pay_day,
    max(x.source_pay_rate::numeric) filter(where x.bucket='NIGHT') pay_night,
    max(x.source_pay_rate::numeric) filter(where x.bucket='SAT') pay_sat,
    max(x.source_pay_rate::numeric) filter(where x.bucket='SUN') pay_sun,
    max(x.source_pay_rate::numeric) filter(where x.bucket='BH') pay_bh
    from private.bpay_next_rate_detail x where x.approved_line_id=a.id) rd on true
  where a.revision_id=new.id and d.segment_key is not null;
  for v_row in select a.id,a.component_key,a.source_pay_ex_vat,a.approved_quantity,
      count(s.id) segment_count,sum(s.approved_source_ex_vat) segment_gross,
      sum(case when new.source_kind='ORDINARY' and s.pay_excluded then 0 else s.approved_hours end) segment_hours
    from private.bpay_next_approved_line a left join private.bpay_next_approved_segment s on s.approved_line_id=a.id
    where a.revision_id=new.id and a.component_kind in ('WORK','PROTECTED_WORK')
    group by a.id,a.component_key,a.source_pay_ex_vat,a.approved_quantity
  loop
    if v_row.segment_count>0 and (v_row.segment_gross,v_row.segment_hours)
      is distinct from (v_row.source_pay_ex_vat,v_row.approved_quantity) then
      raise exception using errcode='23514',message='BPAY_NEXT_APPROVED_SEGMENT_PARENT_TOTAL_MISMATCH';
    end if;
    if exists(select 1 from private.bpay_next_shift_detail d where d.approved_line_id=v_row.id
      and d.segment_key is not null) and exists(select 1 from private.bpay_next_shift_detail d
      where d.approved_line_id=v_row.id and d.segment_key is null) then
      raise exception using errcode='23514',message='BPAY_NEXT_APPROVED_SEGMENT_IDENTITY_INCOMPLETE';
    end if;
  end loop;
  select coalesce(jsonb_agg(x.basis order by x.identity),'[]'::jsonb) into v_whole from (
    select 'SEGMENT:'||s.segment_key identity,encode(private.bpay_next_segment_pay_basis_v1(s.id),'hex') basis
      from private.bpay_next_approved_segment s where s.revision_id=new.id
    union all select 'LINE:'||a.component_key,encode(private.bpay_next_line_pay_basis_v1(a.id),'hex')
      from private.bpay_next_approved_line a where a.revision_id=new.id
        and not exists(select 1 from private.bpay_next_approved_segment s where s.approved_line_id=a.id)
  ) x;
  select coalesce(jsonb_agg(encode(private.bpay_next_line_pay_basis_v1(a.id),'hex') order by a.component_key),'[]'::jsonb)
    into v_expenses from private.bpay_next_approved_line a where a.revision_id=new.id and a.component_kind in ('EXPENSE','MILEAGE');
  insert into private.bpay_next_revision_worker_basis(revision_id,whole_basis,expense_basis)
    values(new.id,pg_catalog.sha256(pg_catalog.convert_to(v_whole::text,'UTF8')),
      pg_catalog.sha256(pg_catalog.convert_to(v_expenses::text,'UTF8')));
  return new;
end
$function$;

-- private.bpay_next_segment_child_guard_v1(); supabase/repeatable/10102026_1236_banking_pay_next_segment_authority_final_v1.sql; SHA256 2a39fcbbc72bdaae06ed597cb1f7e3f8c97d8832dec85be697bd6d733be38f0b
create or replace function private.bpay_next_segment_child_guard_v1()
returns trigger language plpgsql security invoker set search_path=pg_catalog,private
as $function$
declare v_revision private.bpay_next_work_revision%rowtype; v_shift private.bpay_next_shift_detail%rowtype;
  v_rates record;v_whole jsonb;v_expenses jsonb;
begin
  if tg_op<>'INSERT' then raise exception using errcode='55000',message='BPAY_NEXT_SEGMENT_FACT_IMMUTABLE'; end if;
  if tg_table_name in ('bpay_next_approved_segment','bpay_next_revision_worker_basis') then
    select r.* into strict v_revision from private.bpay_next_work_revision r where r.id=new.revision_id for share;
    if v_revision.sealed_at_utc is not null then
      raise exception using errcode='55000',message='BPAY_NEXT_APPROVED_SEGMENT_REVISION_SEALED';
    end if;
    if tg_table_name='bpay_next_approved_segment' then
      select d.* into strict v_shift from private.bpay_next_shift_detail d where d.id=new.shift_detail_id;
      select max(x.source_pay_rate::numeric) filter(where x.bucket='DAY') pay_day,
        max(x.source_pay_rate::numeric) filter(where x.bucket='NIGHT') pay_night,
        max(x.source_pay_rate::numeric) filter(where x.bucket='SAT') pay_sat,
        max(x.source_pay_rate::numeric) filter(where x.bucket='SUN') pay_sun,
        max(x.source_pay_rate::numeric) filter(where x.bucket='BH') pay_bh into v_rates
        from private.bpay_next_rate_detail x where x.approved_line_id=v_shift.approved_line_id;
      if (new.approved_line_id,new.segment_key,new.work_date,new.shift_start_at,new.shift_end_at,
          new.shift_start_local,new.shift_end_local,new.shift_overnight,new.approved_hours,
          new.hours_day,new.hours_night,new.hours_sat,new.hours_sun,new.hours_bh,new.approved_source_ex_vat,new.pay_excluded)
        is distinct from (v_shift.approved_line_id,v_shift.segment_key,v_shift.work_date,v_shift.shift_start_at,v_shift.shift_end_at,
          v_shift.shift_start_local,v_shift.shift_end_local,v_shift.shift_overnight,v_shift.approved_hours,
          v_shift.hours_day,v_shift.hours_night,v_shift.hours_sat,v_shift.hours_sun,v_shift.hours_bh,v_shift.segment_pay_ex_vat,v_shift.pay_excluded)
        or (new.pay_day,new.pay_night,new.pay_sat,new.pay_sun,new.pay_bh)
          is distinct from (v_rates.pay_day,v_rates.pay_night,v_rates.pay_sat,v_rates.pay_sun,v_rates.pay_bh)
        or not exists(select 1 from private.bpay_next_approved_line a where a.id=new.approved_line_id
          and a.revision_id=new.revision_id and a.component_key=new.component_key and a.component_kind in ('WORK','PROTECTED_WORK')) then
        raise exception using errcode='23514',message='BPAY_NEXT_APPROVED_SEGMENT_NATIVE_IDENTITY_MISMATCH';
      end if;
    else
      select coalesce(jsonb_agg(x.basis order by x.identity),'[]'::jsonb) into v_whole from (
        select 'SEGMENT:'||s.segment_key identity,encode(private.bpay_next_segment_pay_basis_v1(s.id),'hex') basis
          from private.bpay_next_approved_segment s where s.revision_id=new.revision_id
        union all select 'LINE:'||a.component_key,encode(private.bpay_next_line_pay_basis_v1(a.id),'hex')
          from private.bpay_next_approved_line a where a.revision_id=new.revision_id
            and not exists(select 1 from private.bpay_next_approved_segment s where s.approved_line_id=a.id)
      ) x;
      select coalesce(jsonb_agg(encode(private.bpay_next_line_pay_basis_v1(a.id),'hex') order by a.component_key),'[]'::jsonb)
        into v_expenses from private.bpay_next_approved_line a where a.revision_id=new.revision_id and a.component_kind in ('EXPENSE','MILEAGE');
      if (new.whole_basis,new.expense_basis) is distinct from
        (pg_catalog.sha256(pg_catalog.convert_to(v_whole::text,'UTF8')),pg_catalog.sha256(pg_catalog.convert_to(v_expenses::text,'UTF8'))) then
        raise exception using errcode='23514',message='BPAY_NEXT_REVISION_WORKER_BASIS_MISMATCH';
      end if;
    end if;
  end if;
  return new;
end
$function$;
