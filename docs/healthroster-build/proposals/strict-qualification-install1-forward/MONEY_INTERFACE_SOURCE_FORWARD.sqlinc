-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/OFF_RULE_AUTHORITY.sqlinc; raw SHA256 d3cce691e9beb7b32f22e0749ff31072012b9d3f40aa98e1581a05f69c87806b
-- Adjacent SOURCE PROPOSAL. No new relation, GUC, setting, public RPC or grant.
-- Only the existing controlled feature owner enters the command dispatcher.
-- The managed writer remeasures the committed input and validates the complete
-- authorization DTO. Merely supplying this JSON is never admission authority.
create or replace function private.weekly_source_rule_qualification_authorization_v1(p_cycle_id uuid,p_actor_id uuid,p_purpose text)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare r private.cloudtms_database_releases%rowtype; auth jsonb; n integer; recorded_at timestamptz;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict r from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1;
  if current_database()<>'cloudtms_test_clone' or r.status<>'VERIFIED' or r.completed_at_utc is null
    or r.installed_contract_sha256 is distinct from r.repository_contract_sha256
    or r.evidence_json#>>'{managed_release,environment}' is distinct from 'TEST'
    or r.evidence_json#>>'{managed_release,expected_database}' is distinct from current_database()
    or jsonb_typeof(r.evidence_json->'weekly_source_protected_test_setup_authorizations') is distinct from 'array'
    or p_purpose not in ('SOURCE_FIXTURE_SETUP','AUTOMATIC_JOURNEY') then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_AUTHORIZATION_REQUIRED' using errcode='55000'; end if;
  select count(*),jsonb_agg(value)->0 into n,auth
    from jsonb_array_elements(r.evidence_json->'weekly_source_protected_test_setup_authorizations') value
    where value->>'schema_version'='WEEKLY_SOURCE_OFF_RULE_TEST_AUTHORIZATION_V1'
      and value->>'source_cycle_id'=p_cycle_id::text and value->>'journey_actor_user_id'=p_actor_id::text
      and value->>'purpose'=p_purpose;
  select coalesce(max((audit.after_json->>'recorded_at_utc')::timestamptz),r.completed_at_utc) into recorded_at
    from public.audit_events audit where audit.object_type='weekly_source_post_verified_evidence'
      and audit.object_id_text=r.release_id and audit.action='WEEKLY_SOURCE_POST_VERIFIED_EVIDENCE_RECORDED'
      and audit.event_sequence_is_authoritative and audit.after_json->>'artifact_slot'='weekly_source_protected_test_setup_authorizations'
      and exists(select 1 from jsonb_array_elements(audit.after_json->'artifacts') item
        where item->>'authorization_sha256'=auth->>'authorization_sha256');
  if n<>1 or not private.weekly_source_qualification_closed_object_v1(auth,array['schema_version','authorization_id','scope_id',
    'release_id','source_commit','contract_sha256','agency_id','source_group_id','source_cycle_id','setup_actor_user_id',
    'journey_actor_user_id','purpose','week_ending','expires_at_utc','fixture_namespace','fixture_manifest','assignment_id',
    'assignment_version','assignment_sha256','rule_set_version_id','rule_values_sha256','original_source_cas',
    'allowed_operations','banking_install_receipt_sha256','security_receipt_sha256','source_effects_review_sha256','authorization_sha256'])
    or auth->>'release_id' is distinct from r.release_id or auth->>'source_commit' is distinct from r.git_commit
    or auth->>'contract_sha256' is distinct from r.installed_contract_sha256
    or auth->>'fixture_namespace' is distinct from 'WSQ_TEST_'
    or auth->>'authorization_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_OFF_RULE_TEST_AUTHORIZATION_V1',auth-'authorization_sha256'),'hex')
    or exists(select 1 from unnest(array['authorization_id','scope_id','agency_id','source_group_id','source_cycle_id',
      'setup_actor_user_id','journey_actor_user_id','assignment_id','rule_set_version_id']) key
      where coalesce(auth->>key,'') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
    or exists(select 1 from unnest(array['contract_sha256','assignment_sha256','rule_values_sha256',
      'banking_install_receipt_sha256','security_receipt_sha256','source_effects_review_sha256']) key
      where coalesce(auth->>key,'') !~ '^[0-9a-f]{64}$')
    or coalesce(auth->>'assignment_version','') !~ '^[1-9][0-9]*$'
    or coalesce(auth->>'week_ending','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
    or extract(dow from (auth->>'week_ending')::date)<>0
    or (auth->>'expires_at_utc')::timestamptz<=clock_timestamp()
    or (auth->>'expires_at_utc')::timestamptz>recorded_at+
      case when p_purpose='SOURCE_FIXTURE_SETUP' then interval '14 days' else interval '2 hours' end
    or private.weekly_source_protected_qualification_release_v1()->>'release_id' is distinct from r.release_id then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_AUTHORIZATION_REQUIRED' using errcode='55000'; end if;
  -- These actual evidence bindings are measured by the protected writer, never
  -- a function-presence test or an arbitrary caller hash. No operational PASS.
  perform private.weekly_source_off_rule_setup_shape_assert_v1(auth);
  if r.evidence_json#>>'{weekly_source_off_rule_test_controls,banking_install_receipt_sha256}' is distinct from auth->>'banking_install_receipt_sha256'
    or r.evidence_json#>>'{weekly_source_off_rule_test_controls,security_receipt_sha256}' is distinct from auth->>'security_receipt_sha256'
    or r.evidence_json#>>'{weekly_source_off_rule_test_controls,source_effects_review_sha256}' is distinct from auth->>'source_effects_review_sha256' then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_CONTROLS_REQUIRED' using errcode='55000'; end if;
  if not private.weekly_source_qualification_closed_object_v1(r.evidence_json->'weekly_source_off_rule_test_controls',array[
    'schema_version','release_id','source_commit','contract_sha256','banking_install_receipt_sha256','security_receipt_sha256','source_effects_review_sha256',
    'banking_first_install_complete','effective_acl_pass','browser_denied','source_effects_no_external_calls'])
    or r.evidence_json#>>'{weekly_source_off_rule_test_controls,schema_version}' is distinct from 'WEEKLY_SOURCE_OFF_RULE_TEST_CONTROLS_V1'
    or r.evidence_json#>>'{weekly_source_off_rule_test_controls,release_id}' is distinct from r.release_id
    or r.evidence_json#>>'{weekly_source_off_rule_test_controls,source_commit}' is distinct from r.git_commit
    or r.evidence_json#>>'{weekly_source_off_rule_test_controls,contract_sha256}' is distinct from r.installed_contract_sha256
    or exists(select 1 from unnest(array['banking_first_install_complete','effective_acl_pass','browser_denied','source_effects_no_external_calls']) key
      where r.evidence_json#>array['weekly_source_off_rule_test_controls',key] is distinct from 'true'::jsonb) then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_CONTROLS_REQUIRED' using errcode='55000'; end if;
  return auth;
exception when no_data_found or too_many_rows or invalid_text_representation or datetime_field_overflow or invalid_datetime_format then
  raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_AUTHORIZATION_REQUIRED' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_rule_qualification_scope_assert_v1(p_auth jsonb,p_actor_id uuid,p_initial_open boolean default false)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare auth jsonb; c public.weekly_source_cycles%rowtype; g public.weekly_source_groups%rowtype;
  a public.weekly_source_group_rule_assignments%rowtype; v public.weekly_source_rule_set_versions%rowtype;
  manifest jsonb; item jsonb; clients uuid[]; actual jsonb; lease jsonb; n integer; today date;
begin
  auth:=private.weekly_source_rule_qualification_authorization_v1((p_auth->>'source_cycle_id')::uuid,p_actor_id,p_auth->>'purpose');
  if auth is distinct from p_auth then raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_AUTHORIZATION_CHANGED' using errcode='40001'; end if;
  perform private._weekly_source_settings_require_admin_v1((auth->>'setup_actor_user_id')::uuid);
  select * into strict c from public.weekly_source_cycles where id=(auth->>'source_cycle_id')::uuid;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and active and source_family='ROSTER' and environment='TEST';
  perform private._weekly_source_settings_deployment_v1(g.agency_id,g.environment);
  perform private.weekly_source_office_authority_v1(p_actor_id,'APPROVE_PROTECTED_PAY',g.id,null,c.finalisation_week_ending);
  if not private.weekly_source_pay_actor_allowed_v1(p_actor_id) then raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_ACTOR_REFUSED' using errcode='42501'; end if;
  select * into strict a from public.weekly_source_group_rule_assignments where id=(auth->>'assignment_id')::uuid
    and source_group_id=g.id and not feature_enabled and rule_set_version_id=(auth->>'rule_set_version_id')::uuid
    and c.finalisation_week_ending between effective_from_week_ending and coalesce(effective_to_week_ending,'infinity'::date);
  select version.* into strict v from public.weekly_source_rule_set_versions version
    join public.weekly_source_rule_sets rules on rules.id=version.rule_set_id and rules.agency_id=g.agency_id and rules.environment=g.environment
    where version.id=a.rule_set_version_id;
  today:=(clock_timestamp() at time zone 'Europe/London')::date;
  if (g.id::text,g.agency_id::text,c.finalisation_week_ending::text,a.version::text) is distinct from
    (auth->>'source_group_id',auth->>'agency_id',auth->>'week_ending',auth->>'assignment_version')
    or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_ASSIGNMENT_V1',to_jsonb(a)),'hex') is distinct from auth->>'assignment_sha256'
    or v.values_sha256 is distinct from auth->>'rule_values_sha256'
    or v.values_json->>'invoice_sender' is distinct from 'CLIENT_SELF_BILL'
    or (auth->>'purpose'='AUTOMATIC_JOURNEY' and (v.values_json->>'equal_protected_hours' is distinct from 'CLEAR_AUTOMATICALLY'
      or (select automatic_reconcile_actor_user_id from public.weekly_source_global_settings where singleton) is distinct from p_actor_id))
    or exists(select 1 from public.weekly_source_group_rule_assignments enabled where enabled.source_group_id=g.id and enabled.feature_enabled)
    or private.weekly_source_bulk_producer_ready_v1(c.id) or private.weekly_source_automatic_reconcile_producer_ready_v1(c.id) then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_SCOPE_CHANGED' using errcode='40001'; end if;
  manifest:=auth->'fixture_manifest';
  if not private.weekly_source_qualification_closed_object_v1(manifest,array['group_code','client_ids','contract_ids','candidate_ids','client_refs','candidate_refs'])
    or g.code is distinct from manifest->>'group_code' or g.code !~ '^WSQ_TEST_[A-Z0-9_]+$'
    or jsonb_typeof(manifest->'client_ids') is distinct from 'array' or jsonb_array_length(manifest->'client_ids') not between 1 and 100 then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FIXTURE_REFUSED' using errcode='42501'; end if;
  select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(manifest->'client_ids') value;
  if to_jsonb(clients) is distinct from manifest->'client_ids'
    or cardinality(clients)<>(select count(distinct value) from unnest(clients) value)
    or exists(select 1 from unnest(clients) client where not exists(select 1 from public.weekly_source_group_clients member
      where member.source_group_id=g.id and member.client_id=client and c.finalisation_week_ending between member.valid_from and coalesce(member.valid_to,'infinity'::date))) then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FIXTURE_REFUSED' using errcode='42501'; end if;
  for item in select value from jsonb_array_elements(manifest->'client_refs') value loop
    if not private.weekly_source_qualification_closed_object_v1(item,array['client_id','cli_ref']) or item->>'cli_ref' !~ '^CLI-913013[0-9]{2}$'
      or not exists(select 1 from public.clients client where client.id=(item->>'client_id')::uuid and client.id=any(clients) and client.cli_ref=item->>'cli_ref') then
      raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FIXTURE_REFUSED' using errcode='42501'; end if;
  end loop;
  for item in select value from jsonb_array_elements(manifest->'candidate_refs') value loop
    if not private.weekly_source_qualification_closed_object_v1(item,array['candidate_id','tms_ref']) or item->>'tms_ref' !~ '^CCR-913013[0-9]{2}$'
      or not exists(select 1 from public.candidates candidate where candidate.id=(item->>'candidate_id')::uuid and candidate.tms_ref=item->>'tms_ref') then
      raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FIXTURE_REFUSED' using errcode='42501'; end if;
  end loop;
  select coalesce(jsonb_agg(contract.id order by contract.id),'[]'::jsonb) into actual from public.contracts contract
    where contract.client_id=any(clients) and daterange(contract.start_date,contract.end_date,'[]')
      && daterange(c.finalisation_week_ending-6,c.finalisation_week_ending,'[]');
  if actual is distinct from manifest->'contract_ids' or (select coalesce(jsonb_agg(distinct contract.candidate_id order by contract.candidate_id),'[]'::jsonb)
    from public.contracts contract where contract.id in(select value::uuid from jsonb_array_elements_text(manifest->'contract_ids') value)) is distinct from manifest->'candidate_ids'
    or jsonb_array_length(manifest->'client_refs')<>cardinality(clients)
    or (select coalesce(jsonb_agg(value->'client_id' order by value->'client_id'),'[]'::jsonb) from jsonb_array_elements(manifest->'client_refs') value) is distinct from manifest->'client_ids'
    or (select coalesce(jsonb_agg(value->'candidate_id' order by value->'candidate_id'),'[]'::jsonb) from jsonb_array_elements(manifest->'candidate_refs') value) is distinct from manifest->'candidate_ids' then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FIXTURE_REFUSED' using errcode='42501'; end if;
  perform private._weekly_source_rule_group_context_v1(g.id,a.effective_from_week_ending,a.effective_to_week_ending,v.values_json,true);
  -- HISTORICAL_FIXTURE_OPEN_BOUNDARY: every use rechecks the real native
  -- assignment audit; only the first source OPEN additionally requires zero
  -- prior uploads. No historical operational enablement is inferred.
  if a.effective_from_week_ending<today then
    perform private.weekly_source_historical_fixture_setup_assert_v1(auth,p_initial_open and auth->>'purpose'='SOURCE_FIXTURE_SETUP');
  end if;
  if p_initial_open then
    if auth->>'purpose'='SOURCE_FIXTURE_SETUP' and (c.finalisation_week_ending<>a.effective_from_week_ending
      or c.current_final_revision_id is not null or c.state in ('FINALISING','FINALISED','CORRECTION_IN_PROGRESS')
      or exists(select 1 from public.weekly_source_final_revisions final where final.source_cycle_id=c.id)
      or auth->'original_source_cas' is distinct from 'null'::jsonb) then
      raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FUTURE_UNFINALISED_REQUIRED' using errcode='55000'; end if;
  else
    select count(*),jsonb_agg(audit.after_json)->0 into n,lease from public.audit_events audit
      where audit.object_type='weekly_source_off_rule_test_journey' and audit.object_id_text=auth->>'scope_id'
        and audit.action='WEEKLY_SOURCE_OFF_RULE_TEST_OPENED' and audit.event_sequence_is_authoritative
        and not exists(select 1 from public.audit_events terminal where terminal.object_type=audit.object_type and terminal.object_id_text=audit.object_id_text
          and terminal.event_sequence_is_authoritative and terminal.action in ('WEEKLY_SOURCE_OFF_RULE_TEST_CLOSED','WEEKLY_SOURCE_OFF_RULE_TEST_REVOKED'));
    if n<>1 or lease->>'authorization_sha256' is distinct from auth->>'authorization_sha256'
      or lease->>'scope_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_TEST_SCOPE_V1',lease-'scope_sha256'),'hex') then
      raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  end if;
  if auth->>'purpose'='AUTOMATIC_JOURNEY' then
    if not p_initial_open then
      -- ORIGINAL_CAPTURED_PHYSICAL_ROOTS: recheck the OPEN union of Source
      -- pay roots and signed evidence roots, including genuine physical NULL
      -- Client. Never recollect only surviving OPEN incidents after a round.
      if lease#>>'{original_census,schema_version}' is distinct from 'WEEKLY_SOURCE_QUALIFICATION_CENSUS_V1'
        or lease#>>'{original_census,source_cycle_id}' is distinct from c.id::text
        or lease#>>'{original_census,source_group_id}' is distinct from g.id::text
        or lease#>>'{original_census,week_ending}' is distinct from c.finalisation_week_ending::text
        or lease#>'{original_census,original_client_ids}' is distinct from auth#>'{fixture_manifest,client_ids}'
        or lease#>>'{original_census,census_sha256}' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_SOURCE_QUALIFICATION_CENSUS_V1',lease->'original_census'-'census_sha256'),'hex') then
        raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_ORIGINAL_ROOT_CHANGED' using errcode='40001'; end if;
      for item in select value from jsonb_array_elements(lease#>'{original_census,original_root_identities}') value loop
        if not private.weekly_source_qualification_closed_object_v1(item,array['timesheet_id','booking_id','contract_id','candidate_id','client_id']) then
          raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_ORIGINAL_ROOT_CHANGED' using errcode='40001'; end if;
        select jsonb_build_object('timesheet_id',sheet.timesheet_id,'booking_id',sheet.booking_id,'contract_id',contract.id,
          'candidate_id',contract.candidate_id,'client_id',sheet.client_id) into actual
          from public.timesheets sheet join public.contracts contract on contract.id=sheet.contract_id
          where sheet.timesheet_id=(item->>'timesheet_id')::uuid and (sheet.client_id is null or sheet.client_id=contract.client_id);
        if actual is distinct from item then
          raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_ORIGINAL_ROOT_CHANGED' using errcode='40001'; end if;
      end loop;
    end if;
    if cardinality(clients)<>1 or auth->'original_source_cas' is null or auth->'original_source_cas'='null'::jsonb
      or private.weekly_source_bulk_source_cas_v1(c.id,clients) is distinct from auth->'original_source_cas'
      or not exists(select 1 from public.weekly_source_final_revisions final where final.id=c.current_final_revision_id
        and final.source_cycle_id=c.id and final.state='CURRENT' and final.rule_set_version_id=v.id) then
      raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_ORIGINAL_SOURCE_CHANGED' using errcode='40001'; end if;
  end if;
  return auth;
exception when no_data_found or too_many_rows or invalid_text_representation or datetime_field_overflow then
  raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

-- Normal reads remain NULL while OFF. Only nested calls of the existing
-- controlled owner can see this owner-authored XID/PID command context.
create or replace function private.weekly_source_rule_qualification_context_v1(p_client_id uuid,p_cycle_id uuid)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare frame jsonb; auth jsonb; n integer; stack text;
begin
  select count(*),jsonb_agg(audit.after_json)->0 into n,frame from public.audit_events audit
    where audit.object_type='weekly_source_off_rule_command' and audit.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_ADMITTED'
      and audit.event_sequence_is_authoritative and audit.after_json->>'transaction_id'=pg_current_xact_id_if_assigned()::text
      and audit.after_json->>'backend_pid'=pg_backend_pid()::text
      and not exists(select 1 from public.audit_events closed where closed.object_type=audit.object_type and closed.object_id_text=audit.object_id_text
        and closed.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_COMPLETED' and closed.event_sequence_is_authoritative);
  if n=0 then return null; end if;
  get diagnostics stack=pg_context;
  if n<>1 or stack !~ 'PL/pgSQL function (private\.)?weekly_source_rule_qualification_execute_v1\(jsonb\)'
    or frame->>'source_cycle_id' is distinct from p_cycle_id::text or frame->'operational_ready' is distinct from 'false'::jsonb
    or frame->>'command_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_COMMAND_V1',frame-'command_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_COMMAND_UNAVAILABLE' using errcode='55000'; end if;
  auth:=private.weekly_source_rule_qualification_scope_assert_v1(frame->'authorization',(frame->>'actor_user_id')::uuid,false);
  if p_client_id is not null and not(auth#>'{fixture_manifest,client_ids}' @> jsonb_build_array(p_client_id)) then
    raise exception 'WEEKLY_SOURCE_RULE_QUALIFICATION_FOREIGN_CLIENT' using errcode='42501'; end if;
  return auth;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/HISTORICAL_FIXTURE_ASSIGNMENT.sqlinc; raw SHA256 ea11961b8fd26f352cd45ee28a2e6582f0781e68ccfef961cdbc5e52b8dad202
-- Direct owner clarification, 14 October: a dedicated fresh TEST Client/cycle
-- may use a genuine older open file, uploaded today. This does not establish
-- historical operational feature enablement or change the activation owner.
create or replace function private.weekly_source_historical_fixture_assignment_scope_v1(p_frame jsonb)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare req jsonb:=p_frame->'native_request'; c public.weekly_source_cycles%rowtype; g public.weekly_source_groups%rowtype;
  reference public.weekly_source_group_rule_assignments%rowtype; v public.weekly_source_rule_set_versions%rowtype;
  controls jsonb; manifest jsonb:=p_frame->'fixture_manifest'; clients uuid[]; actor uuid; week date; actual jsonb;
begin
  actor:=(p_frame->>'actor_user_id')::uuid;
  perform private._weekly_source_settings_require_admin_v1(actor);
  if p_frame->'execution' is distinct from private.weekly_source_protected_qualification_release_v1()
    or p_frame->>'phase' is distinct from 'HISTORICAL_DISABLED_FIXTURE_ASSIGNMENT_ONLY'
    or p_frame->'operational_ready' is distinct from 'false'::jsonb
    or p_frame->>'current_local_date' is distinct from ((clock_timestamp() at time zone 'Europe/London')::date)::text
    or not exists(select 1 from pg_locks lock_row where lock_row.locktype='advisory' and lock_row.granted and lock_row.mode='ExclusiveLock'
      and lock_row.database=(select oid from pg_database where datname=current_database()) and lock_row.classid=20261013::oid
      and lock_row.objid=1::oid and lock_row.objsubid=2 and lock_row.pid=(p_frame->>'turn_backend_pid')::integer and lock_row.pid<>pg_backend_pid()) then
    raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  select evidence_json->'weekly_source_off_rule_test_controls' into strict controls from private.cloudtms_database_releases
    where release_id=p_frame#>>'{execution,release_id}';
  perform private.weekly_source_post_verified_artifact_assert_v1('weekly_source_off_rule_test_controls',jsonb_build_array(controls),p_frame->'execution',
    p_frame#>>'{execution,source_commit}');
  select * into strict c from public.weekly_source_cycles where id=(p_frame->>'source_cycle_id')::uuid;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and active and source_family='ROSTER' and environment='TEST';
  perform private._weekly_source_settings_deployment_v1(g.agency_id,g.environment);
  week:=c.finalisation_week_ending;
  if not private.weekly_source_qualification_closed_object_v1(req,array['actor_user_id','agency_id','environment','source_group_id','rule_set_version_id',
      'effective_from_week_ending','effective_to_week_ending','expected_group_version','request_id'])
    or req->>'actor_user_id' is distinct from actor::text or req->>'agency_id' is distinct from g.agency_id::text
    or req->>'environment' is distinct from 'TEST' or req->>'source_group_id' is distinct from g.id::text
    or req->>'effective_from_week_ending' is distinct from week::text or req->>'effective_to_week_ending' is distinct from week::text
    or week>=(clock_timestamp() at time zone 'Europe/London')::date or extract(dow from week)<>0
    or not private.weekly_source_qualification_closed_object_v1(manifest,array['group_code','client_ids','contract_ids','candidate_ids','client_refs','candidate_refs'])
    or g.code is distinct from manifest->>'group_code' or g.code !~ '^WSQ_TEST_[A-Z0-9_]+$' then
    raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_SCOPE_INVALID' using errcode='22023'; end if;
  select * into strict reference from public.weekly_source_group_rule_assignments where id=(p_frame->>'future_reference_assignment_id')::uuid
    and source_group_id=g.id and not feature_enabled and effective_from_week_ending>=(clock_timestamp() at time zone 'Europe/London')::date;
  if encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_ASSIGNMENT_V1',to_jsonb(reference)),'hex')
      is distinct from p_frame->>'expected_future_assignment_sha256' or reference.rule_set_version_id::text is distinct from req->>'rule_set_version_id'
    or exists(select 1 from public.weekly_source_group_rule_assignments a where a.source_group_id=g.id and a.feature_enabled) then
    raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_REFERENCE_CHANGED' using errcode='40001'; end if;
  select version.* into strict v from public.weekly_source_rule_set_versions version join public.weekly_source_rule_sets rules
    on rules.id=version.rule_set_id and rules.agency_id=g.agency_id and rules.environment=g.environment where version.id=reference.rule_set_version_id;
  if v.values_json->>'invoice_sender' is distinct from 'CLIENT_SELF_BILL' then
    raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_RULE_REFUSED' using errcode='22023'; end if;
  -- Every fixture Client is in the dedicated group's dated census. A fresh
  -- group excludes old, failed, partial and report uploads too, before any
  -- native assignment/coverage or Source business row is produced.
  select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(manifest->'client_ids') value;
  if cardinality(clients) not between 1 and 100 or to_jsonb(clients) is distinct from manifest->'client_ids'
    or cardinality(clients)<>(select count(distinct value) from unnest(clients) value)
    or c.current_complete_upload_id is not null or c.current_projection_publication_id is not null or c.current_final_revision_id is not null
    or c.state in ('FINALISING','FINALISED','CORRECTION_IN_PROGRESS')
    or exists(select 1 from public.weekly_source_uploads u join public.weekly_source_cycles cycle on cycle.id=u.source_cycle_id
      where cycle.source_group_id=g.id or (cycle.finalisation_week_ending=week and (cycle.scope_client_id=any(clients)
        or u.file_metadata_json->>'client_id' in(select value::text from unnest(clients) value)
        or exists(select 1 from public.weekly_source_group_clients member where member.source_group_id=cycle.source_group_id
          and member.client_id=any(clients) and week between member.valid_from and coalesce(member.valid_to,'infinity'::date)))))
    or exists(select 1 from public.weekly_source_final_revisions f join public.weekly_source_cycles cycle on cycle.id=f.source_cycle_id where cycle.source_group_id=g.id)
    or exists(select 1 from public.weekly_source_report_scopes scope where scope.source_group_id=g.id)
    or exists(select 1 from public.weekly_source_self_bill_reports report where report.source_group_id=g.id)
    or exists(select 1 from public.weekly_source_billing_movements movement where movement.actual_client_id=any(clients))
    or exists(select 1 from unnest(clients) client where not exists(select 1 from public.weekly_source_group_clients member
      where member.source_group_id=g.id and member.client_id=client and week between member.valid_from and coalesce(member.valid_to,'infinity'::date))) then
    raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_NOT_FRESH' using errcode='55000'; end if;
  select coalesce(jsonb_agg(distinct member.client_id order by member.client_id),'[]'::jsonb) into actual
    from public.weekly_source_group_clients member where member.source_group_id=g.id;
  if actual is distinct from manifest->'client_ids' or (select coalesce(jsonb_agg(contract.id order by contract.id),'[]'::jsonb)
      from public.contracts contract where contract.client_id=any(clients) and daterange(contract.start_date,contract.end_date,'[]')&&daterange(week-6,week,'[]'))
      is distinct from manifest->'contract_ids'
    or (select coalesce(jsonb_agg(distinct contract.candidate_id order by contract.candidate_id),'[]'::jsonb) from public.contracts contract
      where contract.id in(select value::uuid from jsonb_array_elements_text(manifest->'contract_ids'))) is distinct from manifest->'candidate_ids'
    or (select coalesce(jsonb_agg(ref->'client_id' order by ref->'client_id'),'[]'::jsonb) from jsonb_array_elements(manifest->'client_refs') ref) is distinct from manifest->'client_ids'
    or (select coalesce(jsonb_agg(ref->'candidate_id' order by ref->'candidate_id'),'[]'::jsonb) from jsonb_array_elements(manifest->'candidate_refs') ref) is distinct from manifest->'candidate_ids'
    or exists(select 1 from jsonb_array_elements(manifest->'client_refs') ref where not private.weekly_source_qualification_closed_object_v1(ref,array['client_id','cli_ref'])
      or coalesce(ref->>'cli_ref','') !~ '^CLI-913013[0-9]{2}$' or not exists(select 1 from public.clients client where client.id=(ref->>'client_id')::uuid and client.cli_ref=ref->>'cli_ref'))
    or exists(select 1 from jsonb_array_elements(manifest->'candidate_refs') ref where not private.weekly_source_qualification_closed_object_v1(ref,array['candidate_id','tms_ref'])
      or coalesce(ref->>'tms_ref','') !~ '^CCR-913013[0-9]{2}$' or not exists(select 1 from public.candidates candidate where candidate.id=(ref->>'candidate_id')::uuid and candidate.tms_ref=ref->>'tms_ref')) then
    raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_IDENTITY_CHANGED' using errcode='40001'; end if;
  perform private._weekly_source_rule_group_context_v1(g.id,week,week,v.values_json,false);
end;
$function$;

create or replace function private.weekly_source_historical_fixture_assignment_assert_v1(p_native_request jsonb)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare frame jsonb; n integer; stack text;
begin
  get diagnostics stack=pg_context;
  if stack !~ 'PL/pgSQL function (private\.)?weekly_source_historical_fixture_rule_assign_v1\(uuid,jsonb\)' then
    raise exception 'WEEKLY_SOURCE_RULE_FUTURE_WEEK_REQUIRED' using errcode='22023'; end if;
  select count(*),jsonb_agg(audit.after_json)->0 into n,frame from public.audit_events audit
    where audit.object_type='weekly_source_historical_fixture_assignment' and audit.action='WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNMENT_ADMITTED'
      and audit.event_sequence_is_authoritative and audit.after_json->>'transaction_id'=pg_current_xact_id_if_assigned()::text
      and audit.after_json->>'backend_pid'=pg_backend_pid()::text
      and not exists(select 1 from public.audit_events done where done.object_type=audit.object_type and done.object_id_text=audit.object_id_text
        and done.action='WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNED' and done.event_sequence_is_authoritative);
  if n<>1 or frame->'native_request' is distinct from p_native_request or frame->>'frame_sha256' is distinct from
    encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNMENT_FRAME_V1',frame-'frame_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_RULE_FUTURE_WEEK_REQUIRED' using errcode='22023'; end if;
  perform private.weekly_source_historical_fixture_assignment_scope_v1(frame);
end;
$function$;

create or replace function private.weekly_source_historical_fixture_rule_assign_v1(p_actor_user_id uuid,p_request jsonb)
returns jsonb language plpgsql volatile security invoker set search_path to 'pg_catalog','pg_temp'
as $function$
declare frame jsonb; result jsonb; assignment public.weekly_source_group_rule_assignments%rowtype; request_id uuid;
begin
  perform private.weekly_source_protected_qualification_owner_v1();
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['schema_version','expected_execution','turn_backend_pid','source_cycle_id',
    'future_reference_assignment_id','expected_future_assignment_sha256','fixture_manifest','native_request','reason'])
    or p_request->>'schema_version' is distinct from 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNMENT_REQUEST_V1'
    or coalesce(p_request->>'expected_future_assignment_sha256','') !~ '^[0-9a-f]{64}$'
    or coalesce(p_request->>'turn_backend_pid','') !~ '^[1-9][0-9]*$'
    or char_length(coalesce(p_request->>'reason','')) not between 1 and 500
    or p_request->'expected_execution' is distinct from private.weekly_source_protected_qualification_release_v1() then
    raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_REQUEST_INVALID' using errcode='22023'; end if;
  request_id:=(p_request#>>'{native_request,request_id}')::uuid;
  frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNMENT_FRAME_V1','request_id',request_id,
    'actor_user_id',p_actor_user_id,'execution',p_request->'expected_execution','turn_backend_pid',p_request->'turn_backend_pid',
    'source_cycle_id',p_request->'source_cycle_id','future_reference_assignment_id',p_request->'future_reference_assignment_id',
    'expected_future_assignment_sha256',p_request->'expected_future_assignment_sha256','fixture_manifest',p_request->'fixture_manifest',
    'native_request',p_request->'native_request','transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid()::text,
    'current_local_date',(clock_timestamp() at time zone 'Europe/London')::date,
    'phase','HISTORICAL_DISABLED_FIXTURE_ASSIGNMENT_ONLY','operational_ready',false);
  frame:=frame||jsonb_build_object('frame_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNMENT_FRAME_V1',frame),'hex'));
  perform private.weekly_source_historical_fixture_assignment_scope_v1(frame);
  perform public._audit_insert('weekly_source_historical_fixture_assignment',request_id::text,'WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNMENT_ADMITTED',null,frame,p_request->>'reason',p_actor_user_id);
  -- One actual unchanged native producer, with only the bounded past-date
  -- assertion forwarded below. Native admin/CAS/locks/immutable/overlap and all
  -- finalised-week refusals remain in that complete owner.
  result:=public.weekly_source_group_rule_assign_atomic_v1(p_request->'native_request');
  select * into strict assignment from public.weekly_source_group_rule_assignments where id=(result->>'assignment_id')::uuid;
  if assignment.feature_enabled or assignment.feature_receipt_json is not null or assignment.assignment_receipt_json is distinct from result-'replayed'
    and assignment.assignment_receipt_json is distinct from result then
    raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_DISABLED_ASSIGNMENT_REQUIRED' using errcode='55000'; end if;
  perform public._audit_insert('weekly_source_historical_fixture_assignment',request_id::text,'WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNED',frame,
    jsonb_build_object('schema_version','WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNED_V1','execution',frame->'execution','source_cycle_id',frame->'source_cycle_id',
      'assignment_id',assignment.id,'assignment_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_ASSIGNMENT_V1',to_jsonb(assignment)),'hex'),
      'rule_set_version_id',assignment.rule_set_version_id,'native_receipt',result,'frame_sha256',frame->>'frame_sha256',
      'phase','HISTORICAL_DISABLED_FIXTURE_ASSIGNMENT_ONLY','operational_ready',false,'historical_operational_activation',false),p_request->>'reason',p_actor_user_id);
  return result;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/HISTORICAL_FIXTURE_SETUP_ASSERT.sqlinc; raw SHA256 62427e8448747206f82c9e533f615d469164b27a9fe0f5dc7e6208b16d948f28
-- Past TEST fixture setup is derived from its real owner-produced assignment
-- audit and unchanged native receipt. It never authorises feature activation.
create or replace function private.weekly_source_historical_fixture_setup_assert_v1(p_auth jsonb,p_initial_open boolean)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare completed jsonb; frame jsonb; assignment public.weekly_source_group_rule_assignments%rowtype;
  reference public.weekly_source_group_rule_assignments%rowtype; c public.weekly_source_cycles%rowtype; n integer;
  clients uuid[]; week date; today date; native_receipt jsonb;
begin
  today:=(clock_timestamp() at time zone 'Europe/London')::date;
  week:=(p_auth->>'week_ending')::date;
  select * into strict c from public.weekly_source_cycles where id=(p_auth->>'source_cycle_id')::uuid;
  select * into strict assignment from public.weekly_source_group_rule_assignments where id=(p_auth->>'assignment_id')::uuid;
  select count(*),jsonb_agg(audit.after_json)->0,jsonb_agg(audit.before_json)->0 into n,completed,frame
    from public.audit_events audit where audit.object_type='weekly_source_historical_fixture_assignment'
      and audit.action='WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNED' and audit.event_sequence_is_authoritative
      and audit.after_json->>'assignment_id'=assignment.id::text;
  if n<>1 or not private.weekly_source_qualification_closed_object_v1(completed,array['schema_version','execution','source_cycle_id','assignment_id',
      'assignment_sha256','rule_set_version_id','native_receipt','frame_sha256','phase','operational_ready','historical_operational_activation'])
    or not private.weekly_source_qualification_closed_object_v1(frame,array['schema_version','request_id','actor_user_id','execution','turn_backend_pid',
      'source_cycle_id','future_reference_assignment_id','expected_future_assignment_sha256','fixture_manifest','native_request','transaction_id','backend_pid',
      'current_local_date','phase','operational_ready','frame_sha256'])
    or completed->'execution' is distinct from frame->'execution'
    or week>=today or extract(dow from week)<>0 or c.finalisation_week_ending<>week
    or assignment.source_group_id::text is distinct from p_auth->>'source_group_id'
    or c.source_group_id<>assignment.source_group_id or assignment.feature_enabled or assignment.feature_receipt_json is not null
    or assignment.effective_from_week_ending<>week or assignment.effective_to_week_ending is distinct from week
    or assignment.rule_set_version_id::text is distinct from p_auth->>'rule_set_version_id'
    or assignment.version::text is distinct from p_auth->>'assignment_version'
    or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_ASSIGNMENT_V1',to_jsonb(assignment)),'hex')
      is distinct from p_auth->>'assignment_sha256'
    or completed->>'schema_version' is distinct from 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNED_V1'
    or completed->>'phase' is distinct from 'HISTORICAL_DISABLED_FIXTURE_ASSIGNMENT_ONLY'
    or completed->'operational_ready' is distinct from 'false'::jsonb
    or completed->'historical_operational_activation' is distinct from 'false'::jsonb
    or completed->>'source_cycle_id' is distinct from c.id::text
    or completed->>'assignment_sha256' is distinct from p_auth->>'assignment_sha256'
    or completed->>'rule_set_version_id' is distinct from p_auth->>'rule_set_version_id'
    or completed->>'frame_sha256' is distinct from frame->>'frame_sha256'
    or frame->>'frame_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNMENT_FRAME_V1',frame-'frame_sha256'),'hex')
    or frame->'execution' is distinct from private.weekly_source_protected_qualification_release_v1()
    or frame->>'actor_user_id' is distinct from p_auth->>'setup_actor_user_id'
    or frame->>'source_cycle_id' is distinct from c.id::text or frame->'fixture_manifest' is distinct from p_auth->'fixture_manifest'
    or frame->'operational_ready' is distinct from 'false'::jsonb
    or frame->>'phase' is distinct from 'HISTORICAL_DISABLED_FIXTURE_ASSIGNMENT_ONLY'
    or assignment.assignment_request_id::text is distinct from frame#>>'{native_request,request_id}'
    or assignment.created_by_user_id::text is distinct from p_auth->>'setup_actor_user_id'
    or assignment.assignment_request_sha256 is distinct from encode(extensions.digest(convert_to((frame->'native_request')::text,'UTF8'),'sha256'),'hex')
    or not exists(select 1 from public.audit_events admitted where admitted.object_type='weekly_source_historical_fixture_assignment'
      and admitted.object_id_text=assignment.assignment_request_id::text and admitted.event_sequence_is_authoritative
      and admitted.action='WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNMENT_ADMITTED' and admitted.after_json=frame) then
    raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNMENT_UNPROVED' using errcode='55000'; end if;
  native_receipt:=completed->'native_receipt';
  if native_receipt is distinct from assignment.assignment_receipt_json
    or native_receipt->>'contract' is distinct from 'WEEKLY_SOURCE_RULE_ASSIGNED_V1'
    or native_receipt->>'assignment_id' is distinct from assignment.id::text
    or native_receipt->'feature_enabled' is distinct from 'false'::jsonb or native_receipt->'replayed' is distinct from 'false'::jsonb then
    raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNMENT_UNPROVED' using errcode='55000'; end if;
  select * into strict reference from public.weekly_source_group_rule_assignments where id=(frame->>'future_reference_assignment_id')::uuid;
  if reference.source_group_id<>assignment.source_group_id or reference.feature_enabled
    or reference.rule_set_version_id is distinct from assignment.rule_set_version_id
    or reference.effective_from_week_ending<today
    or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_ASSIGNMENT_V1',to_jsonb(reference)),'hex')
      is distinct from frame->>'expected_future_assignment_sha256' then
    raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_REFERENCE_CHANGED' using errcode='40001'; end if;
  if p_initial_open then
    -- Include every state and every group: an unsuccessful/partial old upload
    -- is still a prior upload for the fixture Client/week, never a fresh cycle.
    select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(p_auth#>'{fixture_manifest,client_ids}') value;
    if c.current_complete_upload_id is not null or c.current_projection_publication_id is not null or c.current_final_revision_id is not null
      or c.state in ('FINALISING','FINALISED','CORRECTION_IN_PROGRESS')
      or p_auth->'original_source_cas' is distinct from 'null'::jsonb
      or exists(select 1 from public.weekly_source_final_revisions final where final.source_cycle_id=c.id)
      or exists(select 1 from public.weekly_source_uploads upload join public.weekly_source_cycles cycle on cycle.id=upload.source_cycle_id
        where cycle.source_group_id=c.source_group_id or (cycle.finalisation_week_ending=week and (
          cycle.scope_client_id=any(clients) or upload.file_metadata_json->>'client_id' in(select value::text from unnest(clients) value)
          or exists(select 1 from public.weekly_source_group_clients member where member.source_group_id=cycle.source_group_id
            and member.client_id=any(clients) and week between member.valid_from and coalesce(member.valid_to,'infinity'::date))))) then
      raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_NOT_FRESH' using errcode='55000'; end if;
  end if;
exception when no_data_found or too_many_rows or invalid_text_representation or datetime_field_overflow or invalid_datetime_format then
  raise exception 'WEEKLY_SOURCE_HISTORICAL_FIXTURE_ASSIGNMENT_UNPROVED' using errcode='55000';
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/13_complete_nullable_physical_qualification_scope.sqlinc; raw SHA256 230744af317821a507560e02b7cad2d0424a6de8b856cc397ce4a65c5e518433
-- SOURCE PROPOSAL ONLY. Root integrates and proves; no operational activation.
-- The only persisted relation named here is the existing audit_events owner.
-- Its scope is transaction-bound and cannot authorize another transaction.
create or replace function private.weekly_source_protected_qualification_owner_v1()
returns void language plpgsql stable security invoker set search_path to 'pg_catalog','pg_temp'
as $function$
declare owner_name name;
begin
  select pg_get_userbyid(proowner) into strict owner_name from pg_proc
    where oid='private.weekly_source_protected_qualification_owner_v1()'::regprocedure;
  if session_user is distinct from owner_name or current_user is distinct from owner_name then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_OWNER_REQUIRED' using errcode='42501'; end if;
  perform private.weekly_source_query_require_service_v1();
end;
$function$;

create or replace function private.weekly_source_protected_qualification_release_v1()
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare r private.cloudtms_database_releases%rowtype; i private.cloudtms_database_identity%rowtype;
begin
  select * into strict i from private.cloudtms_database_identity where singleton and environment='TEST';
  select * into strict r from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1;
  if current_database()<>'cloudtms_test_clone' or r.status is distinct from 'VERIFIED'
    or r.completed_at_utc is null or r.installed_contract_sha256 is distinct from r.repository_contract_sha256
    or r.evidence_json#>>'{managed_release,environment}' is distinct from 'TEST'
    or r.evidence_json#>>'{managed_release,expected_database}' is distinct from current_database()
    or r.evidence_json#>>'{weekly_source_protected_qualification_catalogue,schema_version}'
      is distinct from 'WEEKLY_SOURCE_QUALIFICATION_INSTALLED_CATALOGUE_V1'
    or r.evidence_json#>>'{weekly_source_protected_qualification_catalogue,contract_sha256}' is distinct from r.installed_contract_sha256
    or r.evidence_json#>>'{weekly_source_protected_qualification_catalogue,jsonb_sha256}' is distinct from encode(
      private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_QUALIFICATION_INSTALLED_CATALOGUE_V1',
        private.weekly_source_protected_qualification_current_catalogue_v1()),'hex') then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_INSTALLED_RELEASE_REQUIRED' using errcode='55000'; end if;
  return jsonb_build_object('release_id',r.release_id,'source_commit',r.git_commit,
    'contract_sha256',r.installed_contract_sha256,'installation_id',i.installation_id,
    'environment',i.environment,'database',current_database(),
    'managed_manifest_sha256',r.evidence_json#>>'{managed_release,manifest_sha256}',
    'installed_catalogue_jsonb_sha256',r.evidence_json#>>'{weekly_source_protected_qualification_catalogue,jsonb_sha256}');
exception when no_data_found or too_many_rows then
  raise exception 'WEEKLY_SOURCE_QUALIFICATION_INSTALLED_RELEASE_REQUIRED' using errcode='55000';
end;
$function$;

-- Plain discovery only. Original signed physical identities and immutable
-- Source pay roots are sealed. Protection family/current-generation state is
-- not made a second Source authority, and a completed Client is never removed.
create or replace function private.weekly_source_protected_qualification_census_v1(p_cycle_id uuid)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare c public.weekly_source_cycles%rowtype; p public.weekly_source_projection_publications%rowtype;
  clients uuid[]; facts jsonb; cas_value jsonb; roots jsonb; items jsonb; census jsonb;
begin
  select * into strict c from public.weekly_source_cycles where id=p_cycle_id;
  select * into strict p from public.weekly_source_projection_publications
    where id=c.current_projection_publication_id and source_cycle_id=c.id and state='CURRENT'
      and authority_scope_kind='CYCLE' and correction_session_id is null and report_scope_id is null;
  perform private.weekly_source_query_current_publication_v1(c.id,p.id);
  select coalesce(array_agg(distinct incident.client_id order by incident.client_id),'{}'::uuid[])
    into clients from public.weekly_discrepancy_incidents incident
    join public.weekly_issue_comparison_revisions comparison on comparison.id=incident.current_comparison_revision_id
      and comparison.incident_id=incident.id
    join public.weekly_work_events work on work.id=incident.work_event_id and work.candidate_id=incident.candidate_id
      and work.client_id=incident.client_id and work.first_source_group_id=c.source_group_id
    join public.contracts contract on contract.id=comparison.contract_id and contract.candidate_id=work.candidate_id
      and contract.client_id=work.client_id
    where incident.source_cycle_id=c.id and incident.state='OPEN'
      and private.weekly_source_is_import_authoritative_v1(work.client_id,contract.id,work.work_date)
      and (private.weekly_source_checking_client_scope_v1(p.id) is null
        or incident.client_id=private.weekly_source_checking_client_scope_v1(p.id));
  if cardinality(clients) not between 1 and 100 then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_ORIGINAL_CLIENTS_REQUIRED' using errcode='55000'; end if;
  facts:=private.weekly_source_bulk_source_facts_v1(c.id,clients);
  cas_value:=private.weekly_source_bulk_source_cas_v1(c.id,clients);
  select coalesce(jsonb_agg(jsonb_build_object('incident_id',incident.id,'work_event_id',work.id,
    'client_id',work.client_id,'candidate_id',work.candidate_id,'contract_id',contract.id,'work_date',work.work_date,
    'comparison_revision_id',comparison.id,'evidence_timesheet_id',comparison.candidate_timesheet_id)
    order by work.candidate_id,work.id,incident.id),'[]'::jsonb) into items
    from public.weekly_discrepancy_incidents incident
    join public.weekly_issue_comparison_revisions comparison on comparison.id=incident.current_comparison_revision_id
      and comparison.incident_id=incident.id
    join public.weekly_work_events work on work.id=incident.work_event_id and work.candidate_id=incident.candidate_id
      and work.client_id=incident.client_id and work.first_source_group_id=c.source_group_id
    join public.contracts contract on contract.id=comparison.contract_id and contract.candidate_id=work.candidate_id
      and contract.client_id=work.client_id
    where incident.source_cycle_id=c.id and incident.state='OPEN' and work.client_id=any(clients)
      and private.weekly_source_is_import_authoritative_v1(work.client_id,contract.id,work.work_date);
  if exists(select 1 from jsonb_array_elements(items) item where item->>'evidence_timesheet_id' is not null
    and not exists(select 1 from public.timesheets sheet join public.contracts contract on contract.id=sheet.contract_id
      where sheet.timesheet_id=(item->>'evidence_timesheet_id')::uuid
        and contract.id=(item->>'contract_id')::uuid and contract.candidate_id=(item->>'candidate_id')::uuid
        and contract.client_id=(item->>'client_id')::uuid
        and (sheet.client_id is null or sheet.client_id=contract.client_id))) then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_SIGNED_ROOT_SCOPE_INVALID' using errcode='55000'; end if;
  with ids as (
    select (item->>'evidence_timesheet_id')::uuid id from jsonb_array_elements(items) item
      where item->>'evidence_timesheet_id' is not null
    union select (item->>'timesheet_id')::uuid from jsonb_array_elements(facts->'root_identities') item
  ) select coalesce(jsonb_agg(jsonb_build_object('timesheet_id',sheet.timesheet_id,'booking_id',sheet.booking_id,
    'contract_id',contract.id,'candidate_id',contract.candidate_id,'client_id',sheet.client_id)
    order by sheet.timesheet_id),'[]'::jsonb) into roots from ids
    join public.timesheets sheet on sheet.timesheet_id=ids.id join public.contracts contract on contract.id=sheet.contract_id;
  census:=jsonb_build_object('schema_version','WEEKLY_SOURCE_QUALIFICATION_CENSUS_V1','source_cycle_id',c.id,
    'source_group_id',c.source_group_id,'week_ending',c.finalisation_week_ending,'original_client_ids',to_jsonb(clients),
    'original_root_identities',roots,'original_items',items,'source_cas',cas_value);
  return census||jsonb_build_object('census_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_QUALIFICATION_CENSUS_V1',census),'hex'));
exception when no_data_found or too_many_rows or invalid_text_representation then
  raise exception 'WEEKLY_SOURCE_QUALIFICATION_SOURCE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_protected_qualification_begin_v1(p_request jsonb)
returns jsonb language plpgsql volatile security invoker set search_path to 'pg_catalog','pg_temp'
as $function$
declare actor uuid; cycle_id uuid; scope_id uuid; c public.weekly_source_cycles%rowtype;
  g public.weekly_source_groups%rowtype; census jsonb; execution jsonb; scope_value jsonb; existing_count integer;
begin
  perform private.weekly_source_protected_qualification_owner_v1();
  if not private.weekly_exceptional_json_keys_exact_v1(p_request,array['scope_id','actor_user_id','source_cycle_id',
      'expected_execution','expected_census_sha256','capabilities','reason','turn_backend_pid'])
    or not(p_request ?& array['scope_id','actor_user_id','source_cycle_id','expected_execution','expected_census_sha256','capabilities','reason','turn_backend_pid'])
    or jsonb_typeof(p_request->'capabilities') is distinct from 'array'
    or p_request->'capabilities' not in ('["BULK_SIGNED"]'::jsonb,'["AUTOMATIC_RECONCILE","BULK_SIGNED"]'::jsonb)
    or char_length(coalesce(p_request->>'reason','')) not between 1 and 1000 then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_REQUEST_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid; cycle_id:=(p_request->>'source_cycle_id')::uuid; scope_id:=(p_request->>'scope_id')::uuid;
  if actor is null or cycle_id is null or scope_id is null then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_REQUEST_INVALID' using errcode='22023'; end if;
  if not exists(select 1 from pg_locks lock_row where lock_row.locktype='advisory' and lock_row.granted
    and lock_row.mode='ExclusiveLock' and lock_row.classid=20261013::oid and lock_row.objid=1::oid and lock_row.objsubid=2
      and lock_row.database=(select oid from pg_database where datname=current_database())
    and lock_row.pid=(p_request->>'turn_backend_pid')::integer and lock_row.pid<>pg_backend_pid()) then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_SHARED_TURN_REQUIRED' using errcode='55000'; end if;
  perform private._weekly_source_settings_require_admin_v1(actor);
  select * into strict c from public.weekly_source_cycles where id=cycle_id;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and active and source_family='ROSTER';
  perform private._weekly_source_settings_deployment_v1(g.agency_id,g.environment);
  if g.environment<>'TEST' then raise exception 'WEEKLY_SOURCE_QUALIFICATION_TEST_ONLY' using errcode='42501'; end if;
  perform private.weekly_source_office_authority_v1(actor,'APPROVE_PROTECTED_PAY',g.id,null,c.finalisation_week_ending);
  execution:=private.weekly_source_protected_qualification_release_v1();
  if execution is distinct from p_request->'expected_execution' then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_EXECUTION_CHANGED' using errcode='40001'; end if;
  if private.weekly_source_bulk_producer_ready_v1(c.id) or private.weekly_source_automatic_reconcile_producer_ready_v1(c.id) then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_OPERATIONAL_SCOPE_REFUSED' using errcode='55000'; end if;
  census:=private.weekly_source_protected_qualification_census_v1(c.id);
  if census->>'census_sha256' is distinct from p_request->>'expected_census_sha256' then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_SOURCE_CHANGED' using errcode='40001'; end if;
  select count(*) into existing_count from public.audit_events audit
    where audit.object_type='weekly_source_protected_qualification' and audit.action='WEEKLY_SOURCE_QUALIFICATION_SCOPE_ADMITTED'
      and audit.after_json->>'transaction_id'=pg_current_xact_id()::text
      and audit.after_json->>'backend_pid'=pg_backend_pid()::text;
  if existing_count<>0 then raise exception 'WEEKLY_SOURCE_QUALIFICATION_SCOPE_ALREADY_ADMITTED' using errcode='23505'; end if;
  scope_value:=jsonb_build_object('schema_version','WEEKLY_SOURCE_TEST_ROLLBACK_QUALIFICATION_SCOPE_V1','scope_id',scope_id,
    'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid()::text,'database',current_database(),
    'turn_backend_pid',p_request->>'turn_backend_pid',
    'execution',execution,'actor_user_id',actor,'agency_id',g.agency_id,'source_group_id',g.id,'source_cycle_id',c.id,
    'current_local_date',(clock_timestamp() at time zone 'Europe/London')::date,'week_ending',c.finalisation_week_ending,
    'capabilities',p_request->'capabilities','original_census',census,'operational_ready',false,'max_native_steps',64);
  scope_value:=scope_value||jsonb_build_object('scope_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_TEST_ROLLBACK_QUALIFICATION_SCOPE_V1',scope_value),'hex'));
  perform public._audit_insert('weekly_source_protected_qualification',scope_id::text,'WEEKLY_SOURCE_QUALIFICATION_SCOPE_ADMITTED',
    null,scope_value,p_request->>'reason',actor);
  return scope_value;
exception when no_data_found or too_many_rows or invalid_text_representation then
  raise exception 'WEEKLY_SOURCE_QUALIFICATION_SCOPE_INVALID' using errcode='55000';
end;
$function$;

-- This is not producer_ready. It can be consumed only below the private,
-- owner-session dispatcher. Actual public service/API calls cannot enter it.
create or replace function private.weekly_source_protected_qualification_assert_v1(
  p_scope_id uuid,p_cycle_id uuid,p_client_ids uuid[],p_capability text
) returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare scope_value jsonb; c public.weekly_source_cycles%rowtype; g public.weekly_source_groups%rowtype;
  clients uuid[]; actual_cas jsonb; context_value text; scopes integer; rules jsonb; original jsonb; actual jsonb;
begin
  perform private.weekly_source_protected_qualification_owner_v1();
  get diagnostics context_value=pg_context;
  if context_value !~ 'PL/pgSQL function (private\.)?weekly_source_protected_qualification_step_v1\(uuid,text,jsonb\)' then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_CALLER_REQUIRED' using errcode='42501'; end if;
  select count(*),jsonb_agg(audit.after_json)->0 into scopes,scope_value from public.audit_events audit
    where audit.object_type='weekly_source_protected_qualification' and audit.action='WEEKLY_SOURCE_QUALIFICATION_SCOPE_ADMITTED'
      and audit.event_sequence_is_authoritative
      and audit.after_json->>'transaction_id'=pg_current_xact_id()::text
      and audit.after_json->>'backend_pid'=pg_backend_pid()::text
      and (p_scope_id is null or audit.object_id_text=p_scope_id::text);
  if scopes<>1 or scope_value->>'schema_version' is distinct from 'WEEKLY_SOURCE_TEST_ROLLBACK_QUALIFICATION_SCOPE_V1'
    or scope_value->>'database' is distinct from current_database()
    or scope_value->'operational_ready' is distinct from 'false'::jsonb
    or scope_value->>'source_cycle_id' is distinct from p_cycle_id::text
    or scope_value->>'current_local_date' is distinct from ((clock_timestamp() at time zone 'Europe/London')::date)::text
    or scope_value->>'scope_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_TEST_ROLLBACK_QUALIFICATION_SCOPE_V1',scope_value-'scope_sha256'),'hex')
    or scope_value->'execution' is distinct from private.weekly_source_protected_qualification_release_v1()
    or not exists(select 1 from pg_locks lock_row where lock_row.locktype='advisory' and lock_row.granted
      and lock_row.mode='ExclusiveLock' and lock_row.classid=20261013::oid and lock_row.objid=1::oid and lock_row.objsubid=2
      and lock_row.database=(select oid from pg_database where datname=current_database())
      and lock_row.pid=(scope_value->>'turn_backend_pid')::integer and lock_row.pid<>pg_backend_pid())
    or p_capability not in ('BULK_SIGNED','AUTOMATIC_RECONCILE')
    or not(scope_value->'capabilities' @> jsonb_build_array(p_capability)) then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  perform private._weekly_source_settings_require_admin_v1((scope_value->>'actor_user_id')::uuid);
  select * into strict c from public.weekly_source_cycles where id=p_cycle_id;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and active and source_family='ROSTER';
  if (g.id::text,g.agency_id::text,g.environment,c.finalisation_week_ending::text) is distinct from
    (scope_value->>'source_group_id',scope_value->>'agency_id','TEST',scope_value->>'week_ending') then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_SOURCE_CHANGED' using errcode='40001'; end if;
  perform private._weekly_source_settings_deployment_v1(g.agency_id,g.environment);
  perform private.weekly_source_office_authority_v1((scope_value->>'actor_user_id')::uuid,'APPROVE_PROTECTED_PAY',g.id,null,c.finalisation_week_ending);
  select array_agg(value::uuid order by value::uuid) into clients
    from jsonb_array_elements_text(scope_value#>'{original_census,original_client_ids}') value;
  if p_client_ids is not null and to_jsonb(p_client_ids) is distinct from to_jsonb(clients) then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_ORIGINAL_CLIENT_CENSUS_CHANGED' using errcode='40001'; end if;
  actual_cas:=private.weekly_source_bulk_source_cas_v1(c.id,clients);
  if actual_cas is distinct from scope_value#>'{original_census,source_cas}' then
    raise exception 'WEEKLY_SOURCE_QUALIFICATION_SOURCE_CHANGED' using errcode='40001'; end if;
  -- No mutable family/current-generation state is compared. Every original
  -- physical root identity remains; native signed/stage/inventory guards do
  -- their own version/signature/currentness work without a qualification waiver.
  for original in select value from jsonb_array_elements(scope_value#>'{original_census,original_root_identities}') value loop
    select jsonb_build_object('timesheet_id',sheet.timesheet_id,'booking_id',sheet.booking_id,'contract_id',contract.id,
      'candidate_id',contract.candidate_id,'client_id',sheet.client_id) into actual
      from public.timesheets sheet join public.contracts contract on contract.id=sheet.contract_id
      where sheet.timesheet_id=(original->>'timesheet_id')::uuid and (sheet.client_id is null or sheet.client_id=contract.client_id);
    if actual is distinct from original then
      raise exception 'WEEKLY_SOURCE_QUALIFICATION_ORIGINAL_ROOT_CHANGED' using errcode='40001'; end if;
  end loop;
  if p_capability='AUTOMATIC_RECONCILE' then
    if cardinality(clients)<>1 then raise exception 'WEEKLY_SOURCE_QUALIFICATION_AUTOMATIC_SCOPE_INVALID' using errcode='55000'; end if;
    rules:=private.weekly_source_effective_rule_set_v1(clients[1],c.id)->'values';
    if rules is null or rules->>'invoice_sender' is distinct from 'CLIENT_SELF_BILL'
      or rules->>'equal_protected_hours' is distinct from 'CLEAR_AUTOMATICALLY'
      or (select automatic_reconcile_actor_user_id from public.weekly_source_global_settings where singleton)
        is distinct from (scope_value->>'actor_user_id')::uuid then
      raise exception 'WEEKLY_SOURCE_QUALIFICATION_AUTOMATIC_SCOPE_INVALID' using errcode='55000'; end if;
  end if;
  return scope_value;
exception when no_data_found or too_many_rows or invalid_text_representation then
  raise exception 'WEEKLY_SOURCE_QUALIFICATION_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/OFF_RULE_NATIVE_PARENT_SCOPE.sqlinc; raw SHA256 f7f598f2fb9c9e997742482f8fedeee1709f7fe129c82cad9a4527d0043d1585
-- One read-only parent resolver for the actual command owner and advisory
-- transport discovery. NULL auth means discovery only; it never admits OFF.
create or replace function private.weekly_source_off_rule_native_parent_scope_v1(p_request jsonb,p_actor uuid,p_auth jsonb default null)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare subjects jsonb:=jsonb_build_array(p_request); subject jsonb; field text; selector uuid; parent jsonb;
  cycles uuid[]:='{}'::uuid[]; bindings jsonb:='[]'::jsonb; observed uuid; expected uuid; qualified boolean:=p_auth is not null; ambiguous boolean:=false;
  run_row public.weekly_exceptional_orchestration_runs%rowtype; family public.weekly_exceptional_pay_target_families%rowtype;
  proof jsonb; proof_result jsonb; prepare_request jsonb; command_frame jsonb; n integer; key text;
  root public.timesheets%rowtype; contract public.contracts%rowtype; fixture_week date; client_id uuid; candidate_id uuid; contract_id uuid;
begin
  if jsonb_typeof(p_request) is distinct from 'object' or p_actor is null then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_INVALID' using errcode='22023'; end if;
  if qualified then expected:=(p_auth->>'source_cycle_id')::uuid; fixture_week:=(p_auth->>'week_ending')::date; end if;
  -- Only declared native subject payloads, not arbitrary uploaded raw columns.
  foreach key in array array['c1_request','service_snapshot','target_snapshot'] loop
    if jsonb_typeof(p_request->key)='object' then subjects:=subjects||jsonb_build_array(p_request->key); end if;
  end loop;
  foreach key in array array['p_rows','c1_sources','c1_components'] loop
    if jsonb_typeof(p_request->key)='array' then subjects:=subjects||(p_request->key); end if;
  end loop;
  for subject in select value from jsonb_array_elements(subjects) value loop
    if jsonb_typeof(subject) is distinct from 'object' then
      if qualified then raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_INVALID' using errcode='22023'; end if;
      ambiguous:=true;continue;end if;
    if qualified and ((subject ? 'source_cycle_id' and nullif(subject->>'source_cycle_id','') is not null and (subject->>'source_cycle_id')::uuid<>expected)
      or (subject ? 'source_group_id' and nullif(subject->>'source_group_id','') is not null and subject->>'source_group_id' is distinct from p_auth->>'source_group_id')
      or (subject ? 'agency_id' and nullif(subject->>'agency_id','') is not null and subject->>'agency_id' is distinct from p_auth->>'agency_id')
      or (subject ? 'actor_user_id' and nullif(subject->>'actor_user_id','') is not null and (subject->>'actor_user_id')::uuid<>p_actor)
      or (subject ? 'p_actor_user_id' and nullif(subject->>'p_actor_user_id','') is not null and (subject->>'p_actor_user_id')::uuid<>p_actor)) then
      raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
    if nullif(subject->>'source_cycle_id','') is not null then
      begin cycles:=array_append(cycles,(subject->>'source_cycle_id')::uuid);
      exception when others then if qualified then raise; end if;ambiguous:=true;end;
    end if;
    foreach field in array array['upload_id','expected_current_upload_id','projection_publication_id','p_publication_id','publication_id','expected_projection_publication_id',
      'final_revision_id','current_final_revision_id','expected_source_revision','current_comparison_revision_id','report_scope_id','correction_session_id',
      'run_id','task_id','projection_receipt_id','orchestration_run_id','publication_request_id','family_id','work_event_id','prior_work_event_id',
      'root_timesheet_id','evidence_timesheet_id','upload_row_id','client_id','candidate_id','contract_id'] loop
      if nullif(subject->>field,'') is null then continue; end if;
      parent:=null;observed:=null;client_id:=null;candidate_id:=null;contract_id:=null;
      begin
      selector:=(subject->>field)::uuid;
      case field
        when 'upload_id','expected_current_upload_id' then
          select jsonb_build_object('source_cycle_id',u.source_cycle_id,'upload_id',u.id,'report_scope_id',u.report_scope_id,
            'client_id',nullif(u.file_metadata_json->>'client_id','')::uuid) into strict parent from public.weekly_source_uploads u where u.id=selector;
        when 'projection_publication_id','p_publication_id','publication_id','expected_projection_publication_id' then
          select jsonb_build_object('source_cycle_id',p.source_cycle_id,'upload_id',p.upload_id,'publication_id',p.id,'report_scope_id',p.report_scope_id)
            into strict parent from public.weekly_source_projection_publications p where p.id=selector;
          if nullif(subject->>'upload_id','') is not null and parent->>'upload_id' is distinct from (subject->>'upload_id')::uuid::text then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
        when 'final_revision_id','current_final_revision_id','expected_source_revision' then
          select jsonb_build_object('source_cycle_id',r.source_cycle_id,'final_revision_id',r.id,'upload_id',r.upload_id,'report_scope_id',r.report_scope_id)
            into strict parent from public.weekly_source_final_revisions r where r.id=selector;
        when 'current_comparison_revision_id' then
          select jsonb_build_object('source_cycle_id',i.source_cycle_id,'work_event_id',i.work_event_id,'client_id',i.client_id,
            'candidate_id',i.candidate_id,'contract_id',r.contract_id,'comparison_revision_id',r.id)
            into strict parent from public.weekly_issue_comparison_revisions r join public.weekly_discrepancy_incidents i on i.id=r.incident_id where r.id=selector;
        when 'report_scope_id' then
          select jsonb_build_object('source_cycle_id',s.source_cycle_id,'client_id',s.client_id,'report_scope_id',s.id)
            into strict parent from public.weekly_source_report_scopes s where s.id=selector;
        when 'correction_session_id' then
          select jsonb_build_object('source_cycle_id',s.source_cycle_id,'report_scope_id',s.report_scope_id)
            into strict parent from public.weekly_final_source_correction_sessions s where s.id=selector;
        when 'run_id' then
          select jsonb_build_object('source_cycle_id',r.source_cycle_id,'final_revision_id',r.final_revision_id,'run_id',r.id,'actor_user_id',r.requested_by_user_id)
            into strict parent from public.weekly_source_finalisation_pay_runs r where r.id=selector;
          if (parent->>'actor_user_id')::uuid<>p_actor or (nullif(subject->>'final_revision_id','') is not null
            and parent->>'final_revision_id' is distinct from (subject->>'final_revision_id')::uuid::text) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
        when 'task_id' then
          select jsonb_build_object('source_cycle_id',r.source_cycle_id,'final_revision_id',r.final_revision_id,'run_id',r.id,'root_timesheet_id',t.root_timesheet_id,
            'client_id',m.client_id,'contract_id',sheet.contract_id,'candidate_id',k.candidate_id,'task_id',t.id)
            into strict parent from public.weekly_source_finalisation_pay_tasks t join public.weekly_source_finalisation_pay_runs r on r.id=t.run_id
            join public.weekly_source_client_manifests m on m.id=t.client_manifest_id join public.timesheets sheet on sheet.timesheet_id=t.root_timesheet_id
            join public.contracts k on k.id=sheet.contract_id where t.id=selector and m.final_revision_id=r.final_revision_id;
          if nullif(subject->>'run_id','') is null or parent->>'run_id' is distinct from (subject->>'run_id')::uuid::text then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
        when 'projection_receipt_id' then
          select jsonb_build_object('source_cycle_id',r.source_cycle_id,'final_revision_id',r.final_revision_id,'root_timesheet_id',r.root_timesheet_id,'client_id',r.client_id,'actor_user_id',r.actor_user_id)
            into strict parent from public.weekly_source_ordinary_pay_projection_receipts r where r.id=selector;
          if nullif(subject->>'task_id','') is not null and not exists(select 1 from public.weekly_source_finalisation_pay_tasks t
            join public.weekly_source_finalisation_pay_runs r on r.id=t.run_id where t.id=(subject->>'task_id')::uuid
              and r.id=(subject->>'run_id')::uuid and r.final_revision_id=(parent->>'final_revision_id')::uuid
              and t.root_timesheet_id=(parent->>'root_timesheet_id')::uuid) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
        when 'family_id' then
          select f.* into strict family from public.weekly_exceptional_pay_target_families f where f.id=selector;
          select k.* into strict contract from public.contracts k where k.id=family.contract_id;
          parent:=jsonb_build_object('family_id',family.id,'root_timesheet_id',family.root_timesheet_id,'contract_id',contract.id,'candidate_id',family.candidate_id,'client_id',contract.client_id);
          if qualified and family.agency_id::text is distinct from p_auth->>'agency_id' then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
        when 'orchestration_run_id' then
          select r.* into strict run_row from public.weekly_exceptional_orchestration_runs r where r.id=selector;
          select f.* into strict family from public.weekly_exceptional_pay_target_families f where f.id=run_row.family_id;
          select k.* into strict contract from public.contracts k where k.id=family.contract_id;
          if run_row.requested_by_user_id<>p_actor or nullif(subject->>'family_id','') is not null and (subject->>'family_id')::uuid<>family.id then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
          parent:=jsonb_build_object('family_id',family.id,'root_timesheet_id',family.root_timesheet_id,'contract_id',contract.id,'candidate_id',family.candidate_id,'client_id',contract.client_id);
          -- No source_cycle_id exists on this native run. Resolve a real
          -- completed OFF prepare command's exact request/result, or the
          -- original native approval. Never infer a cycle from group/week.
          n:=0;
          for proof in select jsonb_build_object('frame',admitted.after_json,'completion',done.after_json)
            from public.audit_events admitted join public.audit_events done on done.object_type=admitted.object_type and done.object_id_text=admitted.object_id_text
              and done.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_COMPLETED' and done.event_sequence_is_authoritative and done.before_json=admitted.after_json
            where admitted.object_type='weekly_source_off_rule_command' and admitted.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_ADMITTED'
              and admitted.event_sequence_is_authoritative and admitted.after_json->>'native_operation'='weekly_exceptional_pay_prepare_action_v1'
              and admitted.after_json->>'actor_user_id'=p_actor::text and done.after_json#>>'{native_prepare_result,orchestration_run_id}'=run_row.id::text
              and (not qualified or admitted.after_json#>>'{authorization,scope_id}'=p_auth->>'scope_id')
          loop
            n:=n+1;command_frame:=proof->'frame';proof_result:=proof#>'{completion,native_prepare_result}';
            prepare_request:=command_frame->'native_prepare_request';
            if command_frame->>'command_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_COMMAND_V1',command_frame-'command_sha256'),'hex')
              or proof#>>'{completion,command_sha256}' is distinct from command_frame->>'command_sha256'
              or proof#>>'{completion,native_result_sha256}' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_NATIVE_RESULT_V1',proof_result),'hex')
              or command_frame->>'native_request_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_NATIVE_REQUEST_V1',prepare_request),'hex')
              or run_row.request_fingerprint is distinct from private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_PREPARE_ACTION_REQUEST_V1',prepare_request)
              or prepare_request->>'family_id' is distinct from family.id::text or prepare_request->>'actor_user_id' is distinct from p_actor::text
              or proof_result->>'family_id' is distinct from family.id::text or proof_result->>'source_cycle_id' is distinct from prepare_request->>'source_cycle_id'
              or proof_result->>'work_event_id' is distinct from prepare_request->>'work_event_id'
              or command_frame->>'source_cycle_id' is distinct from prepare_request->>'source_cycle_id' then
              raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
          end loop;
          if n>0 then
            observed:=(prepare_request->>'source_cycle_id')::uuid;
            parent:=parent||jsonb_build_object('source_cycle_id',observed,'work_event_id',prepare_request->>'work_event_id');
          else
            select count(distinct a.source_cycle_id),(array_agg(a.source_cycle_id))[1] into n,observed from public.weekly_exceptional_payment_approvals a
              where a.creation_orchestration_run_id=run_row.id and a.pay_target_family_id=family.id;
            if n>1 or (qualified and n<>1) then raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
            if n=1 then parent:=parent||jsonb_build_object('source_cycle_id',observed); end if;
            -- An ordinary unstaged run may have neither proof. Discovery
            -- returns no OFF cycle and leaves native staged=false unchanged.
          end if;
          if qualified and family.agency_id::text is distinct from p_auth->>'agency_id' then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
        when 'publication_request_id' then
          select jsonb_build_object('family_id',r.family_id,'orchestration_run_id',r.orchestration_run_id,'root_timesheet_id',r.root_timesheet_id,
            'candidate_id',r.candidate_id,'contract_id',r.contract_id,'client_id',k.client_id) into strict parent
            from public.weekly_exceptional_c1_publication_requests r join public.contracts k on k.id=r.contract_id where r.id=selector;
          if qualified and not exists(select 1 from public.weekly_exceptional_payment_approvals a where a.creation_orchestration_run_id=(parent->>'orchestration_run_id')::uuid
            and a.pay_target_family_id=(parent->>'family_id')::uuid and a.source_cycle_id=expected) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
        when 'work_event_id','prior_work_event_id' then
          select jsonb_build_object('source_group_id',w.first_source_group_id,'client_id',w.client_id,'candidate_id',w.candidate_id,'work_date',w.work_date)
            into strict parent from public.weekly_work_events w where w.id=selector;
          if qualified and parent->>'source_group_id' is distinct from p_auth->>'source_group_id' then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
        when 'root_timesheet_id','evidence_timesheet_id' then
          select sheet.* into strict root from public.timesheets sheet where sheet.timesheet_id=selector;
          select k.* into strict contract from public.contracts k where k.id=root.contract_id;
          parent:=jsonb_build_object('root_timesheet_id',root.timesheet_id,'contract_id',contract.id,'candidate_id',contract.candidate_id,'client_id',contract.client_id);
          if qualified and root.client_id is not null and root.client_id is distinct from contract.client_id then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
          if qualified and nullif(subject->>'final_revision_id','') is not null and not exists(select 1 from public.weekly_source_billing_movements m
            where m.final_revision_id=(subject->>'final_revision_id')::uuid and m.invoice_timesheet_id=root.timesheet_id and m.actual_client_id=contract.client_id) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
        when 'upload_row_id' then
          select jsonb_build_object('source_cycle_id',u.source_cycle_id,'upload_id',u.id) into strict parent
            from public.weekly_source_upload_rows r join public.weekly_source_uploads u on u.id=r.upload_id where r.id=selector;
        when 'client_id' then parent:=jsonb_build_object('client_id',selector);
        when 'candidate_id' then parent:=jsonb_build_object('candidate_id',selector);
        when 'contract_id' then
          select jsonb_build_object('contract_id',k.id,'client_id',k.client_id,'candidate_id',k.candidate_id) into strict parent from public.contracts k where k.id=selector;
      end case;
      observed:=nullif(parent->>'source_cycle_id','')::uuid;
      if observed is not null then cycles:=array_append(cycles,observed); end if;
      foreach key in array array['family_id','work_event_id','root_timesheet_id','contract_id','candidate_id','client_id','final_revision_id','report_scope_id','upload_id'] loop
        if nullif(parent->>key,'') is not null and nullif(subject->>key,'') is not null
          and (parent->>key)::uuid is distinct from (subject->>key)::uuid then
          raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
      end loop;
      if nullif(parent->>'actor_user_id','') is not null and (parent->>'actor_user_id')::uuid is distinct from p_actor then
        raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
      if qualified then
        client_id:=nullif(parent->>'client_id','')::uuid;candidate_id:=nullif(parent->>'candidate_id','')::uuid;contract_id:=nullif(parent->>'contract_id','')::uuid;
        if nullif(parent->>'root_timesheet_id','') is not null then
          select sheet.* into strict root from public.timesheets sheet where sheet.timesheet_id=(parent->>'root_timesheet_id')::uuid;
          select k.* into strict contract from public.contracts k where k.id=root.contract_id;
          if (root.client_id is not null and root.client_id is distinct from contract.client_id)
            or (contract_id is not null and contract_id is distinct from contract.id)
            or (candidate_id is not null and candidate_id is distinct from contract.candidate_id)
            or (client_id is not null and client_id is distinct from contract.client_id) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_LINK_CHANGED' using errcode='42501'; end if;
          client_id:=contract.client_id;candidate_id:=contract.candidate_id;contract_id:=contract.id;
          -- Bind the physical root to actual Source membership or the
          -- immutable OPEN signed-evidence union. Source coverage may include
          -- older work; never infer root membership from calendar equality.
          if not exists(select 1 from public.weekly_source_billing_movements m
            join public.weekly_source_final_revisions r on r.id=m.final_revision_id
            where r.source_cycle_id=expected and m.invoice_timesheet_id=root.timesheet_id and m.actual_client_id=contract.client_id)
            and not exists(select 1 from public.weekly_source_finalisation_pay_tasks t
              join public.weekly_source_finalisation_pay_runs r on r.id=t.run_id
              where r.source_cycle_id=expected and t.root_timesheet_id=root.timesheet_id)
            and not exists(select 1 from public.audit_events opened,
              lateral jsonb_array_elements(opened.after_json#>'{original_census,original_root_identities}') original_root
              where opened.object_type='weekly_source_off_rule_test_journey' and opened.object_id_text=p_auth->>'scope_id'
                and opened.action='WEEKLY_SOURCE_OFF_RULE_TEST_OPENED' and opened.event_sequence_is_authoritative
                and original_root->>'timesheet_id'=root.timesheet_id::text) then
            raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
        end if;
        if (observed is not null and observed<>expected)
          or (client_id is not null and not(p_auth#>'{fixture_manifest,client_ids}' @> jsonb_build_array(client_id)))
          or (candidate_id is not null and not(p_auth#>'{fixture_manifest,candidate_ids}' @> jsonb_build_array(candidate_id)))
          or (contract_id is not null and not(p_auth#>'{fixture_manifest,contract_ids}' @> jsonb_build_array(contract_id))) then
          raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
      end if;
      bindings:=bindings||jsonb_build_array(jsonb_build_object('selector',field,'id',selector,'parent',parent));
      exception when others then
        if qualified then raise; end if;
        -- Retain actual parent provenance even when a sibling link is bad,
        -- then discover remaining parents. A matching OFF claim must refuse.
        observed:=nullif(parent->>'source_cycle_id','')::uuid;
        if observed is not null then cycles:=array_append(cycles,observed); end if;
        ambiguous:=true;
      end;
    end loop;
  end loop;
  if qualified and exists(select 1 from unnest(cycles) value where value is distinct from expected) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_FOREIGN' using errcode='42501'; end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_SCOPE_V1',
    'source_cycle_id',case when (select count(distinct value) from unnest(cycles) value)=1 then cycles[1] else null end,
    'observed_cycle_ids',to_jsonb(cycles),'bindings',bindings,'ambiguous',ambiguous or (select count(distinct value) from unnest(cycles) value)>1);
exception when others then
  if qualified then raise; end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_OFF_RULE_NATIVE_PARENT_SCOPE_V1','source_cycle_id',null,'observed_cycle_ids',to_jsonb(cycles),'bindings',bindings,'ambiguous',true);
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/OFF_RULE_COMMAND.sqlinc; raw SHA256 94e4fb4a1c4644a8001abbdc88b4c8d285943406666fb908c91be5347d007360
create or replace function private.weekly_source_rule_qualification_setup_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare auth jsonb; actor uuid; journey uuid; action text; lease jsonb; result jsonb; n integer;
  assignment public.weekly_source_group_rule_assignments%rowtype; census jsonb; clients uuid[]; audit_id uuid;
begin
  perform private.weekly_source_query_require_service_v1();
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['actor_user_id','agency_id','environment','qualification_action',
    'source_cycle_id','journey_actor_user_id','purpose','reason']) or p_request->>'environment' is distinct from 'TEST'
    or char_length(coalesce(p_request->>'reason','')) not between 1 and 500 then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid; journey:=(p_request->>'journey_actor_user_id')::uuid; action:=p_request->>'qualification_action';
  perform private._weekly_source_settings_require_admin_v1(actor);
  auth:=private.weekly_source_rule_qualification_authorization_v1((p_request->>'source_cycle_id')::uuid,journey,p_request->>'purpose');
  if auth->>'setup_actor_user_id' is distinct from actor::text or auth->>'agency_id' is distinct from p_request->>'agency_id'
    or private._weekly_source_settings_deployment_v1((auth->>'agency_id')::uuid,'TEST')<>'TEST'
    or action not in ('OFF_RULE_OPEN','OFF_RULE_CLOSE','OFF_RULE_REVOKE') then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_REFUSED' using errcode='42501'; end if;
  perform pg_advisory_xact_lock(hashtextextended('weekly-source-off-rule-test:'||(auth->>'scope_id'),0));
  -- The same assignment store serializes configuration and qualification. No
  -- toggle or metadata write is made to it. Readers revalidate its full hash.
  select * into strict assignment from public.weekly_source_group_rule_assignments where id=(auth->>'assignment_id')::uuid for share;
  if exists(select 1 from public.audit_events audit where audit.object_type='weekly_source_off_rule_test_journey'
    and audit.object_id_text=auth->>'scope_id' and audit.event_sequence_is_authoritative
    and audit.action in ('WEEKLY_SOURCE_OFF_RULE_TEST_CLOSED','WEEKLY_SOURCE_OFF_RULE_TEST_REVOKED')) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_TERMINAL' using errcode='55000'; end if;
  select count(*),jsonb_agg(audit.after_json)->0 into n,lease from public.audit_events audit
    where audit.object_type='weekly_source_off_rule_test_journey' and audit.object_id_text=auth->>'scope_id'
      and audit.action='WEEKLY_SOURCE_OFF_RULE_TEST_OPENED' and audit.event_sequence_is_authoritative;
  if action='OFF_RULE_OPEN' then
    if n<>0 then raise exception 'WEEKLY_SOURCE_OFF_RULE_SCOPE_ALREADY_OPEN' using errcode='23505'; end if;
    perform private.weekly_source_rule_qualification_scope_assert_v1(auth,journey,true);
    lease:=jsonb_build_object('schema_version','WEEKLY_SOURCE_OFF_RULE_TEST_SCOPE_V1','scope_id',auth->>'scope_id',
      'authorization_id',auth->>'authorization_id','authorization_sha256',auth->>'authorization_sha256',
      'purpose',auth->>'purpose','source_cycle_id',auth->>'source_cycle_id','source_group_id',auth->>'source_group_id',
      'week_ending',auth->>'week_ending','assignment_id',assignment.id,'assignment_version',assignment.version,
      'rule_set_version_id',assignment.rule_set_version_id,'opened_at_utc',clock_timestamp(),
      'opened_local_date',(clock_timestamp() at time zone 'Europe/London')::date,
      'coverage_floor_local_date',((auth->>'week_ending')::date-6),
      'actor_user_id',journey,'setup_actor_user_id',actor,'operational_ready',false,'expires_at_utc',auth->>'expires_at_utc');
    if auth->>'purpose'='AUTOMATIC_JOURNEY' then
      -- Capture ONCE, before any protected round. Every remaining Client and
      -- original physical root stays in this immutable audited census.
      census:=private.weekly_source_protected_qualification_census_v1((auth->>'source_cycle_id')::uuid);
      if census->'original_client_ids' is distinct from auth#>'{fixture_manifest,client_ids}'
        or census->'source_cas' is distinct from auth->'original_source_cas'
        or (select coalesce(jsonb_agg(distinct row_value->'contract_id' order by row_value->'contract_id'),'[]'::jsonb)
          from jsonb_array_elements(census->'original_items') row_value) is distinct from auth#>'{fixture_manifest,contract_ids}'
        or (select coalesce(jsonb_agg(distinct row_value->'candidate_id' order by row_value->'candidate_id'),'[]'::jsonb)
          from jsonb_array_elements(census->'original_items') row_value) is distinct from auth#>'{fixture_manifest,candidate_ids}' then
        raise exception 'WEEKLY_SOURCE_OFF_RULE_ORIGINAL_CENSUS_CHANGED' using errcode='40001'; end if;
      lease:=lease||jsonb_build_object('original_census',census);
    end if;
    lease:=lease||jsonb_build_object('scope_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_TEST_SCOPE_V1',lease),'hex'));
    perform public._audit_insert('weekly_source_off_rule_test_journey',auth->>'scope_id','WEEKLY_SOURCE_OFF_RULE_TEST_OPENED',null,lease,p_request->>'reason',actor);
    return lease;
  end if;
  if n<>1 then raise exception 'WEEKLY_SOURCE_OFF_RULE_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  if action='OFF_RULE_CLOSE' then
    perform private.weekly_source_rule_qualification_scope_assert_v1(auth,journey,false);
    if auth->>'purpose'='AUTOMATIC_JOURNEY' then
      census:=lease->'original_census';
      if census is null or census->>'census_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
          'WEEKLY_SOURCE_QUALIFICATION_CENSUS_V1',census-'census_sha256'),'hex') then
        raise exception 'WEEKLY_SOURCE_OFF_RULE_ORIGINAL_CENSUS_UNAVAILABLE' using errcode='55000'; end if;
      select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(census->'original_client_ids') value;
      if private.weekly_source_bulk_source_cas_v1((auth->>'source_cycle_id')::uuid,clients) is distinct from census->'source_cas' then
        raise exception 'WEEKLY_SOURCE_OFF_RULE_ORIGINAL_CENSUS_CHANGED' using errcode='40001'; end if;
      -- Same closed DTO as the original controlled journey. The closure audit
      -- preserves the OPEN census; it never recollects remaining incidents.
      result:=jsonb_build_object('scope_id',auth->>'scope_id','scope_sha256',lease->>'scope_sha256',
        'setup_authorization_sha256',auth->>'authorization_sha256','original_census_sha256',census->>'census_sha256',
        'actor_user_id',journey,'source_cycle_id',auth->>'source_cycle_id','week_ending',auth->>'week_ending',
        'execution_release_id',auth->>'release_id','execution_source_commit',auth->>'source_commit',
        'execution_contract_sha256',auth->>'contract_sha256','state','CLOSED','closed_at_utc',clock_timestamp(),
        'all_assignments_disabled',true,'all_operational_producers_false',true);
    else
      -- The first genuine Source producer may have no protected incidents.
      -- Its resulting frozen Source CAS is a setup result, not a protected
      -- capability census/certificate or manufactured protection evidence.
      select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(auth#>'{fixture_manifest,client_ids}') value;
      result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_OFF_RULE_TEST_SOURCE_CLOSURE_V1','scope_id',auth->>'scope_id',
        'scope_sha256',lease->>'scope_sha256','authorization_sha256',auth->>'authorization_sha256',
        'source_cycle_id',auth->>'source_cycle_id','week_ending',auth->>'week_ending','rule_set_version_id',auth->>'rule_set_version_id',
        'rule_values_sha256',auth->>'rule_values_sha256','result_source_cas',private.weekly_source_bulk_source_cas_v1((auth->>'source_cycle_id')::uuid,clients),
        'actor_user_id',journey,'release_id',auth->>'release_id','source_commit',auth->>'source_commit','contract_sha256',auth->>'contract_sha256',
        'state','CLOSED','closed_at_utc',clock_timestamp(),'all_assignments_disabled',true,'all_operational_producers_false',true);
    end if;
  else result:=jsonb_build_object('scope_id',auth->>'scope_id','state','REVOKED','closed_at_utc',clock_timestamp(),'operational_ready',false); end if;
  perform public._audit_insert('weekly_source_off_rule_test_journey',auth->>'scope_id',
    case when action='OFF_RULE_CLOSE' then 'WEEKLY_SOURCE_OFF_RULE_TEST_CLOSED' else 'WEEKLY_SOURCE_OFF_RULE_TEST_REVOKED' end,
    lease,result,p_request->>'reason',actor);
  if action='OFF_RULE_CLOSE' and auth->>'purpose'='AUTOMATIC_JOURNEY' then
    select audit.id into strict audit_id from public.audit_events audit
      where audit.object_type='weekly_source_off_rule_test_journey' and audit.object_id_text=auth->>'scope_id'
        and audit.action='WEEKLY_SOURCE_OFF_RULE_TEST_CLOSED' and audit.event_sequence_is_authoritative and audit.after_json=result;
    -- OFF_RULE_ORIGINAL_CENSUS_CLOSED: returned identifiers are measured from
    -- the genuine audit row, never supplied by caller or inserted as evidence.
    return result||jsonb_build_object('closure_audit_id',audit_id,'closure_audit_sha256',
      encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_TEST_JOURNEY_CLOSED_V1',result),'hex'));
  end if;
  return result;
end;
$function$;

create or replace function private.weekly_source_rule_qualification_execute_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare actor uuid; cycle_id uuid; auth jsonb; req jsonb; op text; purpose text; frame jsonb; result jsonb;
  command_id uuid:=gen_random_uuid(); stack text; parent_scope jsonb; completion jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  get diagnostics stack=pg_context;
  if stack !~ 'PL/pgSQL function (public\.)?weekly_source_group_rule_feature_set_atomic_v1\(jsonb\)' then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_CONTROLLED_OWNER_REQUIRED' using errcode='42501'; end if;
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['actor_user_id','agency_id','environment','qualification_action',
    'source_cycle_id','native_operation','native_request']) or p_request->>'qualification_action' is distinct from 'OFF_RULE_COMMAND'
    or p_request->>'environment' is distinct from 'TEST' or jsonb_typeof(p_request->'native_request') is distinct from 'object' then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_COMMAND_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid;cycle_id:=(p_request->>'source_cycle_id')::uuid;op:=p_request->>'native_operation';req:=p_request->'native_request';
  if op in ('weekly_source_upload_context_v1','weekly_source_upload_stage_begin_atomic_v1','weekly_source_upload_stage_rows_atomic_v1',
    'weekly_source_upload_seal_atomic_v1','weekly_source_projection_begin_atomic_v1','weekly_source_projection_rows_apply_atomic_v1',
    'weekly_source_projection_publish_atomic_v1','weekly_source_import_prepare_atomic_v1','weekly_source_finalise_atomic_v1',
    'weekly_source_finalisation_pay_open_atomic_v1','weekly_source_finalisation_pay_task_start_atomic_v1',
    'weekly_source_ordinary_pay_projection_apply_atomic_v1','weekly_source_finalisation_pay_task_finish_atomic_v1','REPORT_FIN_AB_FINALISE') then
    purpose:='SOURCE_FIXTURE_SETUP';
  elsif op in ('weekly_source_automatic_reconcile_atomic_v1','weekly_exceptional_pay_prepare_action_v1',
    'weekly_exceptional_pay_action_context_v1','weekly_exceptional_pay_action_publication_status_v1',
    'weekly_exceptional_pay_stage_c1_request_v1') then purpose:='AUTOMATIC_JOURNEY';
  else raise exception 'WEEKLY_SOURCE_OFF_RULE_NATIVE_OPERATION_REFUSED' using errcode='42501'; end if;
  auth:=private.weekly_source_rule_qualification_authorization_v1(cycle_id,actor,purpose);
  if auth->>'agency_id' is distinct from p_request->>'agency_id' or not(auth->'allowed_operations' @> jsonb_build_array(op))
    or (req ? 'actor_user_id' and req->>'actor_user_id' is distinct from actor::text)
    or (req ? 'p_actor_user_id' and req->>'p_actor_user_id' is distinct from actor::text)
    or (req ? 'source_cycle_id' and req->>'source_cycle_id' is distinct from cycle_id::text)
    or (req ? 'source_group_id' and req->>'source_group_id' is distinct from auth->>'source_group_id')
    or (req ? 'client_id' and not(auth#>'{fixture_manifest,client_ids}' @> jsonb_build_array((req->>'client_id')::uuid))) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_COMMAND_SCOPE_REFUSED' using errcode='42501'; end if;
  -- Nonwaiting same-scope gate precedes OPEN revalidation. It remains held
  -- through native dispatch/completion until transaction end. No group/row
  -- lock is acquired ahead of native I1; a CLOSE holder returns busy here.
  if not pg_try_advisory_xact_lock(hashtextextended('weekly-source-off-rule-test:'||(auth->>'scope_id'),0)) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SCOPE_BUSY' using errcode='55P03'; end if;
  perform private.weekly_source_rule_qualification_scope_assert_v1(auth,actor,false);
  parent_scope:=private.weekly_source_off_rule_native_parent_scope_v1(req,actor,auth);
  if exists(select 1 from public.audit_events audit where audit.object_type='weekly_source_off_rule_command'
    and audit.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_ADMITTED' and audit.event_sequence_is_authoritative
    and audit.after_json->>'transaction_id'=pg_current_xact_id()::text and audit.after_json->>'backend_pid'=pg_backend_pid()::text
    and not exists(select 1 from public.audit_events closed where closed.object_type=audit.object_type and closed.object_id_text=audit.object_id_text
      and closed.action='WEEKLY_SOURCE_OFF_RULE_COMMAND_COMPLETED' and closed.event_sequence_is_authoritative)) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_COMMAND_NESTED' using errcode='55000'; end if;
  frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_OFF_RULE_COMMAND_V1','command_id',command_id,
    'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid()::text,'source_cycle_id',cycle_id,'actor_user_id',actor,
    'authorization',auth,'native_operation',op,'native_request_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_OFF_RULE_NATIVE_REQUEST_V1',req),'hex'),'native_parent_scope',parent_scope,'operational_ready',false);
  if op='weekly_exceptional_pay_prepare_action_v1' then frame:=frame||jsonb_build_object('native_prepare_request',req); end if;
  frame:=frame||jsonb_build_object('command_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_COMMAND_V1',frame),'hex'));
  perform public._audit_insert('weekly_source_off_rule_command',command_id::text,'WEEKLY_SOURCE_OFF_RULE_COMMAND_ADMITTED',null,frame,'Controlled OFF fixture native command',actor);
  case op
    when 'weekly_source_upload_context_v1' then result:=public.weekly_source_upload_context_v1(req);
    when 'weekly_source_upload_stage_begin_atomic_v1' then result:=public.weekly_source_upload_stage_begin_atomic_v1(req);
    when 'weekly_source_upload_stage_rows_atomic_v1' then result:=public.weekly_source_upload_stage_rows_atomic_v1(req);
    when 'weekly_source_upload_seal_atomic_v1' then result:=public.weekly_source_upload_seal_atomic_v1(req);
    when 'weekly_source_projection_begin_atomic_v1' then result:=public.weekly_source_projection_begin_atomic_v1(req);
    when 'weekly_source_projection_rows_apply_atomic_v1' then result:=public.weekly_source_projection_rows_apply_atomic_v1(
      (req->>'p_actor_user_id')::uuid,(req->>'p_publication_id')::uuid,req->'p_rows');
    when 'weekly_source_projection_publish_atomic_v1' then result:=public.weekly_source_projection_publish_atomic_v1(req);
    when 'weekly_source_import_prepare_atomic_v1' then result:=public.weekly_source_import_prepare_atomic_v1(req);
    when 'weekly_source_finalise_atomic_v1' then result:=public.weekly_source_finalise_atomic_v1(req);
    when 'weekly_source_finalisation_pay_open_atomic_v1' then result:=public.weekly_source_finalisation_pay_open_atomic_v1(req);
    when 'weekly_source_finalisation_pay_task_start_atomic_v1' then result:=public.weekly_source_finalisation_pay_task_start_atomic_v1(req);
    when 'weekly_source_ordinary_pay_projection_apply_atomic_v1' then result:=public.weekly_source_ordinary_pay_projection_apply_atomic_v1(req);
    when 'weekly_source_finalisation_pay_task_finish_atomic_v1' then result:=public.weekly_source_finalisation_pay_task_finish_atomic_v1(req);
    when 'REPORT_FIN_AB_FINALISE' then result:=private.weekly_source_rule_report_fixture_finalise_v1(auth,req);
    when 'weekly_source_automatic_reconcile_atomic_v1' then result:=public.weekly_source_automatic_reconcile_atomic_v1(req);
    when 'weekly_exceptional_pay_prepare_action_v1' then result:=public.weekly_exceptional_pay_prepare_action_v1(req);
    when 'weekly_exceptional_pay_action_context_v1' then result:=public.weekly_exceptional_pay_action_context_v1(req);
    when 'weekly_exceptional_pay_action_publication_status_v1' then result:=public.weekly_exceptional_pay_action_publication_status_v1(req);
    when 'weekly_exceptional_pay_stage_c1_request_v1' then result:=public.weekly_exceptional_pay_stage_c1_request_v1(req);
  end case;
  -- The command frame is closed even for a legal native refusal result. Errors
  -- abort the whole command/audit transaction; a later session starts afresh.
  completion:=jsonb_build_object('command_id',command_id,'command_sha256',frame->>'command_sha256','native_result_sha256',
    encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_NATIVE_RESULT_V1',result),'hex'),'operational_ready',false);
  if op='weekly_exceptional_pay_prepare_action_v1' then
    if result->>'source_cycle_id' is distinct from cycle_id::text or result->>'family_id' is distinct from req->>'family_id'
      or result->>'work_event_id' is distinct from req->>'work_event_id'
      or not exists(select 1 from public.weekly_exceptional_orchestration_runs r where r.id=(result->>'orchestration_run_id')::uuid
        and r.family_id=(req->>'family_id')::uuid and r.requested_by_user_id=actor
        and r.request_fingerprint=private.weekly_source_sha256_jsonb_v1('WEEKLY_PROTECTED_PREPARE_ACTION_REQUEST_V1',req)) then
      raise exception 'WEEKLY_SOURCE_OFF_RULE_PREPARE_RESULT_CHANGED' using errcode='42501'; end if;
    completion:=completion||jsonb_build_object('native_prepare_result',result);
  end if;
  perform public._audit_insert('weekly_source_off_rule_command',command_id::text,'WEEKLY_SOURCE_OFF_RULE_COMMAND_COMPLETED',frame,
    completion,'Controlled OFF fixture native command complete',actor);
  return result;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/OFF_RULE_STATUS.sqlinc; raw SHA256 8eb29b29ffe55dc406dfadc4c84ff389ca493b62d0b331a15981e01fc3e0f97b
-- The existing service-registered feature owner dispatches this read. An
-- absent authorization is ordinary; a claimed invalid/expired scope refuses.
create or replace function private.weekly_source_rule_qualification_status_v1(p_request jsonb)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare r private.cloudtms_database_releases%rowtype; auth jsonb; actor uuid; cycle_id uuid; n integer;
begin
  perform private.weekly_source_query_require_service_v1();
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['actor_user_id','agency_id','environment','qualification_action','source_cycle_id','purpose'])
    or p_request->>'qualification_action' is distinct from 'OFF_RULE_STATUS' or p_request->>'environment' is distinct from 'TEST'
    or p_request->>'purpose' not in ('SOURCE_FIXTURE_SETUP','AUTOMATIC_JOURNEY') then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_STATUS_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid; cycle_id:=(p_request->>'source_cycle_id')::uuid;
  select * into strict r from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1;
  select count(*) into n from jsonb_array_elements(case when jsonb_typeof(r.evidence_json->'weekly_source_protected_test_setup_authorizations')='array'
    then r.evidence_json->'weekly_source_protected_test_setup_authorizations' else '[]'::jsonb end) value
    where value->>'schema_version'='WEEKLY_SOURCE_OFF_RULE_TEST_AUTHORIZATION_V1' and value->>'source_cycle_id'=cycle_id::text
      and value->>'journey_actor_user_id'=actor::text and value->>'purpose'=p_request->>'purpose';
  if n=0 then return jsonb_build_object('contract','WEEKLY_SOURCE_OFF_RULE_TEST_ADMISSION_V1','qualified_fixture',false,'operational_ready',false); end if;
  auth:=private.weekly_source_rule_qualification_authorization_v1(cycle_id,actor,p_request->>'purpose');
  if auth->>'agency_id' is distinct from p_request->>'agency_id' then raise exception 'WEEKLY_SOURCE_OFF_RULE_STATUS_REFUSED' using errcode='42501'; end if;
  perform private.weekly_source_rule_qualification_scope_assert_v1(auth,actor,false);
  return jsonb_build_object('contract','WEEKLY_SOURCE_OFF_RULE_TEST_ADMISSION_V1','qualified_fixture',true,'operational_ready',false,
    'purpose',auth->>'purpose','source_cycle_id',cycle_id,'actor_user_id',actor,'allowed_operations',auth->'allowed_operations',
    'scope_id',auth->>'scope_id','authorization_sha256',auth->>'authorization_sha256');
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/OFF_RULE_TRANSPORT_STATUS.sqlinc; raw SHA256 08242ac91fd3f1a715e4ea40cd09cdd5e56351c498fce48c76f0dea7b0ace4c8
create or replace function private.weekly_source_rule_qualification_transport_status_v1(p_request jsonb)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare req jsonb; parent_scope jsonb; cycle_id uuid; actor uuid; op text; purpose text; result jsonb; claim jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['actor_user_id','agency_id','environment','qualification_action','native_operation','native_request'])
    or p_request->>'qualification_action' is distinct from 'OFF_RULE_TRANSPORT_STATUS' or p_request->>'environment' is distinct from 'TEST'
    or jsonb_typeof(p_request->'native_request') is distinct from 'object' then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_TRANSPORT_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid;op:=p_request->>'native_operation';req:=p_request->'native_request';
  if op in ('weekly_source_upload_context_v1','weekly_source_upload_stage_begin_atomic_v1','weekly_source_upload_stage_rows_atomic_v1',
    'weekly_source_upload_seal_atomic_v1','weekly_source_projection_begin_atomic_v1','weekly_source_projection_rows_apply_atomic_v1',
    'weekly_source_projection_publish_atomic_v1','weekly_source_import_prepare_atomic_v1','weekly_source_finalise_atomic_v1',
    'weekly_source_finalisation_pay_open_atomic_v1','weekly_source_finalisation_pay_task_start_atomic_v1',
    'weekly_source_ordinary_pay_projection_apply_atomic_v1','weekly_source_finalisation_pay_task_finish_atomic_v1') then purpose:='SOURCE_FIXTURE_SETUP';
  elsif op in ('weekly_source_automatic_reconcile_atomic_v1','weekly_exceptional_pay_prepare_action_v1',
    'weekly_exceptional_pay_action_context_v1','weekly_exceptional_pay_action_publication_status_v1','weekly_exceptional_pay_stage_c1_request_v1') then purpose:='AUTOMATIC_JOURNEY';
  else raise exception 'WEEKLY_SOURCE_OFF_RULE_TRANSPORT_OPERATION_REFUSED' using errcode='42501'; end if;
  if (req ? 'actor_user_id' and req->>'actor_user_id' is distinct from actor::text)
    or (req ? 'p_actor_user_id' and req->>'p_actor_user_id' is distinct from actor::text) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_TRANSPORT_ACTOR_REFUSED' using errcode='42501'; end if;
  parent_scope:=private.weekly_source_off_rule_native_parent_scope_v1(req,actor,null);
  if parent_scope->>'source_cycle_id' is null or (parent_scope->>'ambiguous')::boolean then
    if (select count(distinct value) from jsonb_array_elements_text(parent_scope->'observed_cycle_ids') value)>1 then
      raise exception 'WEEKLY_SOURCE_OFF_RULE_TRANSPORT_SCOPE_CHANGED' using errcode='40001'; end if;
    for cycle_id in select distinct value::uuid from jsonb_array_elements_text(parent_scope->'observed_cycle_ids') value loop
      claim:=private.weekly_source_rule_qualification_status_v1(jsonb_build_object('actor_user_id',actor,'agency_id',p_request->>'agency_id',
        'environment','TEST','qualification_action','OFF_RULE_STATUS','source_cycle_id',cycle_id,'purpose',purpose));
      if (claim->>'qualified_fixture')::boolean then
        raise exception 'WEEKLY_SOURCE_OFF_RULE_TRANSPORT_SCOPE_CHANGED' using errcode='40001'; end if;
    end loop;
    -- Advisory discovery never admits OFF. In particular an ordinary
    -- unstaged run has no OFF cycle and retains its actual native response.
    return jsonb_build_object('contract','WEEKLY_SOURCE_OFF_RULE_TEST_ADMISSION_V1','qualified_fixture',false,'operational_ready',false);
  end if;
  cycle_id:=(parent_scope->>'source_cycle_id')::uuid;
  result:=private.weekly_source_rule_qualification_status_v1(jsonb_build_object('actor_user_id',actor,'agency_id',p_request->>'agency_id',
    'environment','TEST','qualification_action','OFF_RULE_STATUS','source_cycle_id',cycle_id,'purpose',purpose));
  return result;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/01_operational_rule_projection.sqlinc; raw SHA256 43a1f07212674c233e35dc24c6917377f639e703fe0a0a44fc18443b09113e5a
create or replace function private.weekly_source_operational_effective_rule_set_v1(p_client_id uuid,p_cycle_id uuid)
returns jsonb language sql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
  select jsonb_build_object('contract','WEEKLY_SOURCE_EFFECTIVE_RULE_SET_V1','source_group_id',g.id,
    'assignment_id',a.id,'assignment_version',a.version,'rule_set_id',r.id,'rule_set_version_id',v.id,
    'version_number',v.version_number,'values_sha256',v.values_sha256,'values',v.values_json)
  from public.weekly_source_cycles c join public.weekly_source_groups g on g.id=c.source_group_id and g.active and g.source_family='ROSTER'
  join public.weekly_source_group_clients gc on gc.source_group_id=g.id and gc.client_id=p_client_id
    and c.finalisation_week_ending between gc.valid_from and coalesce(gc.valid_to,'infinity'::date)
  join public.weekly_source_group_rule_assignments a on a.source_group_id=g.id and a.feature_enabled
    and a.feature_purpose='RULE_SET'
    and c.finalisation_week_ending between a.effective_from_week_ending and coalesce(a.effective_to_week_ending,'infinity'::date)
  join public.weekly_source_rule_set_versions v on v.id=a.rule_set_version_id
  join public.weekly_source_rule_sets r on r.id=v.rule_set_id and r.agency_id=g.agency_id and r.environment=g.environment
  where c.id=p_cycle_id
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/02_effective_rule_owner.sqlinc; raw SHA256 d7a855b54ccb0b9b01d27d7ba2ad4fe3d4895baac41c88b9d1d6bcb5580c44f0
create or replace function private.weekly_source_effective_rule_set_v1(p_client_id uuid,p_cycle_id uuid)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare normal jsonb; auth jsonb; result jsonb;
begin
  normal:=private.weekly_source_operational_effective_rule_set_v1(p_client_id,p_cycle_id);
  if normal is not null then return normal; end if;
  auth:=private.weekly_source_rule_qualification_context_v1(p_client_id,p_cycle_id);
  if auth is null then return null; end if;
  select jsonb_build_object('contract','WEEKLY_SOURCE_EFFECTIVE_RULE_SET_V1','source_group_id',g.id,
    'assignment_id',a.id,'assignment_version',a.version,'rule_set_id',rules.id,'rule_set_version_id',v.id,
    'version_number',v.version_number,'values_sha256',v.values_sha256,'values',v.values_json) into strict result
  from public.weekly_source_cycles c join public.weekly_source_groups g on g.id=c.source_group_id and g.active and g.source_family='ROSTER'
  join public.weekly_source_group_clients member on member.source_group_id=g.id and member.client_id=p_client_id
    and c.finalisation_week_ending between member.valid_from and coalesce(member.valid_to,'infinity'::date)
  join public.weekly_source_group_rule_assignments a on a.source_group_id=g.id and a.id=(auth->>'assignment_id')::uuid and not a.feature_enabled
    and c.finalisation_week_ending between a.effective_from_week_ending and coalesce(a.effective_to_week_ending,'infinity'::date)
  join public.weekly_source_rule_set_versions v on v.id=a.rule_set_version_id and v.id=(auth->>'rule_set_version_id')::uuid
  join public.weekly_source_rule_sets rules on rules.id=v.rule_set_id and rules.agency_id=g.agency_id and rules.environment=g.environment
  where c.id=p_cycle_id;
  return result;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/03_cas_operational_projection.sqlinc; raw SHA256 38fb7787aa4d96f1d7832fd9735f7ed7ab921ef22a4ccf252e3dc76083b07fe7
-- Complete forward schema correction; frozen predecessor remains evidence.
-- Root-review owner-private Source census. It never reads protection-stage
-- tables or mutable Timesheet/TSFIN lifecycle, and never makes a pay decision.
create or replace function private.weekly_source_bulk_source_facts_v1(p_cycle_id uuid,p_client_ids uuid[])
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare c public.weekly_source_cycles%rowtype; g public.weekly_source_groups%rowtype;
  p public.weekly_source_projection_publications%rowtype; u public.weekly_source_uploads%rowtype;
  clients uuid[]; facts jsonb; actual_client uuid;
begin
  if p_cycle_id is null or p_client_ids is null or array_position(p_client_ids,null::uuid) is not null then
    raise exception 'WEEKLY_SOURCE_BULK_SOURCE_CAS_INVALID' using errcode='22023'; end if;
  select coalesce(array_agg(distinct value order by value),'{}'::uuid[]) into clients from unnest(p_client_ids) value;
  if cardinality(clients)>100 then raise exception 'WEEKLY_SOURCE_BULK_SOURCE_CAS_SCOPE_TOO_LARGE' using errcode='54000'; end if;
  select * into strict c from public.weekly_source_cycles where id=p_cycle_id;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and active and source_family='ROSTER';
  select * into strict p from public.weekly_source_projection_publications where id=c.current_projection_publication_id
    and source_cycle_id=c.id and state='CURRENT' and authority_scope_kind='CYCLE' and correction_session_id is null and report_scope_id is null;
  select * into strict u from public.weekly_source_uploads where id=c.current_complete_upload_id and id=p.upload_id
    and source_cycle_id=c.id and state='CURRENT' and report_scope_id is null;
  perform private.weekly_source_query_current_publication_v1(c.id,p.id);
  actual_client:=private.weekly_source_checking_client_scope_v1(p.id);
  if exists(select 1 from unnest(clients) client where (actual_client is not null and actual_client<>client)
    or not exists(select 1 from public.weekly_source_group_clients member where member.source_group_id=g.id and member.client_id=client
      and daterange(member.valid_from,coalesce(member.valid_to,'infinity'::date),'[]')
        && daterange(coalesce(u.confirmed_coverage_start_local_date,c.finalisation_week_ending-6),
          coalesce(u.confirmed_coverage_end_local_date,c.finalisation_week_ending),'[]'))) then
    raise exception 'WEEKLY_SOURCE_BULK_SOURCE_CAS_CLIENT_SCOPE_CHANGED' using errcode='40001'; end if;
  -- CTE scope comes from saved Source parents. Incident IDs contribute stable
  -- work-event scope irrespective of OPEN/CLOSED; their mutable rows do not.
  with report_scopes as materialized (
    select scope.* from public.weekly_source_report_scopes scope where scope.source_group_id=g.id
      and scope.client_id=any(clients) and scope.self_bill_report_id is not null
  ), report_bindings as materialized (
    select binding.* from public.weekly_source_self_bill_report_line_bindings binding
      join public.weekly_source_self_bill_reports report on report.id=binding.self_bill_report_id
      where report.source_group_id=g.id and report.client_id=any(clients) and binding.state='CURRENT'
  ), publications as materialized (
    select publication.* from public.weekly_source_projection_publications publication where publication.id=p.id
      or publication.id in(select current_projection_publication_id from report_scopes)
      or publication.id in(select export_projection_publication_id from report_bindings)
  ), uploads as materialized (
    select upload.* from public.weekly_source_uploads upload where upload.id=u.id
      or upload.id in(select upload_id from publications)
  ), source_rows as materialized (
    select row_data.* from public.weekly_source_upload_rows row_data where row_data.upload_id in(select id from uploads)
  ), resolutions as materialized (
    select resolution.* from public.weekly_source_row_resolutions resolution
      join source_rows row_data on row_data.id=resolution.upload_row_id
      join publications publication on publication.upload_id=row_data.upload_id
        and resolution.generation=coalesce(publication.projection_generation,publication.authority_scope_version)
      where resolution.client_id=any(clients)
      union select resolution.* from public.weekly_source_row_resolutions resolution
        join report_bindings binding on binding.bound_row_resolution_id=resolution.id
  ), events as materialized (
    select event.* from public.weekly_work_events event where event.first_source_group_id=g.id and event.client_id=any(clients)
      and (event.id in(select work_event_id from resolutions) or event.id in(select work_event_id from report_bindings)
        or exists(select 1 from public.weekly_discrepancy_incidents incident where incident.source_cycle_id=c.id
          and incident.work_event_id=event.id and incident.client_id=event.client_id))
  ), revisions as materialized (
    select revision.* from public.weekly_source_final_revisions revision
      join public.weekly_source_cycles source_cycle on source_cycle.id=revision.source_cycle_id and source_cycle.source_group_id=g.id
      where revision.state in ('CURRENT','PREPARED','SUPERSEDED') and (
        revision.source_cycle_id=c.id or revision.report_scope_id in(select id from report_scopes)
        or exists(select 1 from public.weekly_source_final_snapshot_lines snapshot where snapshot.final_revision_id=revision.id
          and snapshot.work_event_id in(select id from events)))
  ), snapshots as materialized (
    select snapshot.* from public.weekly_source_final_snapshot_lines snapshot where snapshot.final_revision_id in(select id from revisions)
      and snapshot.client_id=any(clients)
  ), lineages as materialized (
    select lineage.* from public.weekly_source_row_timesheet_lineages lineage where lineage.client_id=any(clients)
      and (lineage.row_resolution_id in(select id from resolutions) or lineage.work_event_id in(select id from events))
  ), pay_receipts as materialized (
    select receipt.* from public.weekly_source_ordinary_pay_projection_receipts receipt where receipt.client_id=any(clients)
      and receipt.final_revision_id in(select id from revisions)
  ), financial_identities as materialized (
    -- The Source receipt is immutable and already pins all published economics
    -- and root-before/after/service hashes. Protection may replace currentness
    -- on the same native family; the Source financial identity stays exact.
    select financial.id,financial.timesheet_id,financial.client_id,financial.candidate_id,
      (select min(m.contract_id::text)::uuid
        from pay_receipts receipt
        cross join lateral jsonb_array_elements(case when jsonb_typeof(receipt.source_unit_outcomes_json)='array'
          then receipt.source_unit_outcomes_json else '[]'::jsonb end) unit
        join public.weekly_source_billing_movements m on m.id=(unit->>'movement_id')::uuid
          and m.final_revision_id=receipt.final_revision_id and m.invoice_timesheet_id=receipt.root_timesheet_id
          and m.actual_client_id=receipt.client_id and m.candidate_id=financial.candidate_id
          and encode(m.movement_economic_hash,'hex')=unit->>'movement_economic_hash'
          and m.source_profile_kind<>'SELF_BILL_REPORT'
          and m.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION')
        where receipt.published_timesheet_financial_id=financial.id
        having count(distinct m.contract_id)=1) as contract_id
      from public.timesheets_financials financial where financial.id in(select published_timesheet_financial_id from pay_receipts)
  ), root_identities as materialized (
    select root.timesheet_id,root.client_id,contract.candidate_id,root.contract_id,root.booking_id
      from public.timesheets root join public.contracts contract on contract.id=root.contract_id
      where root.timesheet_id in(select root_timesheet_id from pay_receipts)
  ), cycles as materialized (
    select cycle.* from public.weekly_source_cycles cycle where cycle.id=c.id or cycle.id in(select source_cycle_id from publications)
      or cycle.id in(select source_cycle_id from revisions)
  ), contracts as materialized (
    select contract.* from public.contracts contract where contract.client_id=any(clients)
      and (daterange(contract.start_date,contract.end_date,'[]') && daterange(
        coalesce(u.confirmed_coverage_start_local_date,c.finalisation_week_ending-6),
        coalesce(u.confirmed_coverage_end_local_date,c.finalisation_week_ending),'[]')
        or contract.id in(select contract_id from resolutions) or contract.id in(select contract_id from snapshots)
        or exists(select 1 from public.weekly_issue_comparison_revisions comparison
          join public.weekly_discrepancy_incidents incident on incident.current_comparison_revision_id=comparison.id
          where incident.source_cycle_id=c.id and incident.client_id=contract.client_id and comparison.contract_id=contract.id))
  ), policy_dates as materialized (
    select client client_id,null::uuid contract_id,c.finalisation_week_ending work_date from unnest(clients) client
    union select client_id,contract_id,work_date from snapshots
    union select resolution.client_id,resolution.contract_id,row_data.work_date from resolutions resolution
      join source_rows row_data on row_data.id=resolution.upload_row_id
    union select client_id,null::uuid,work_date from events
    union select contract.client_id,contract.id,greatest(contract.start_date,
      coalesce(u.confirmed_coverage_start_local_date,c.finalisation_week_ending-6)) from contracts contract
  ), resolved_policies as materialized (
    select client_id,contract_id,work_date,private._weekly_source_effective_policy_v1(client_id,contract_id,work_date) policy
      from policy_dates
  )
  select jsonb_build_object('schema_version','WEEKLY_SOURCE_BULK_SOURCE_FACTS_V1','source_cycle_id',c.id,
    'client_ids',to_jsonb(clients),'group',to_jsonb(g),
    'cycles',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from cycles x),'[]'::jsonb),
    'clients',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from public.clients x where x.id=any(clients)),'[]'::jsonb),
    'memberships',coalesce((select jsonb_agg(to_jsonb(x) order by x.client_id,x.valid_from,x.id)
      from public.weekly_source_group_clients x where x.source_group_id=g.id and x.client_id=any(clients)),'[]'::jsonb),
    'client_policies',coalesce((select jsonb_agg(to_jsonb(x) order by x.client_id,x.effective_from,x.id)
      from public.weekly_source_client_policies x where x.source_group_id=g.id and x.client_id=any(clients)),'[]'::jsonb),
    'client_settings',coalesce((select jsonb_agg(to_jsonb(x) order by x.client_id,x.id) from public.client_settings x where x.client_id=any(clients)),'[]'::jsonb),
    'contracts',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from contracts x),'[]'::jsonb),
    'contract_policies',coalesce((select jsonb_agg(to_jsonb(x) order by x.contract_id,x.effective_from,x.id)
      from public.weekly_source_contract_policies x where x.contract_id in(select id from contracts)),'[]'::jsonb),
    'global_settings',coalesce((select jsonb_agg(to_jsonb(x)) from public.weekly_source_global_settings x where x.singleton),'[]'::jsonb),
    'resolved_policies',coalesce((select jsonb_agg(to_jsonb(x) order by x.client_id,x.contract_id nulls first,x.work_date) from resolved_policies x),'[]'::jsonb),
    'assignments',coalesce((select jsonb_agg(to_jsonb(x) order by x.effective_from_week_ending,x.id)
      from public.weekly_source_group_rule_assignments x where x.source_group_id=g.id),'[]'::jsonb),
    'rule_versions',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from public.weekly_source_rule_set_versions x
      where x.id in(select rule_set_version_id from public.weekly_source_group_rule_assignments where source_group_id=g.id)
        or x.id in(select rule_set_version_id from revisions)),'[]'::jsonb),
    'effective_rules',coalesce((select jsonb_agg(jsonb_build_object('client_id',client,
      'effective_rule_set',private.weekly_source_operational_effective_rule_set_v1(client,c.id)) order by client) from unnest(clients) client),'[]'::jsonb),
    'profiles',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from public.weekly_source_format_profiles x
      where x.id in(select source_format_profile_id from uploads)),'[]'::jsonb),
    'uploads',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from uploads x),'[]'::jsonb),
    'publications',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from publications x),'[]'::jsonb),
    'rows',coalesce((select jsonb_agg(to_jsonb(x) order by x.upload_id,x.source_row_ordinal,x.id) from source_rows x),'[]'::jsonb),
    'resolutions',coalesce((select jsonb_agg(to_jsonb(x) order by x.upload_row_id,x.generation,x.id) from resolutions x),'[]'::jsonb),
    'economics',coalesce((select jsonb_agg(to_jsonb(x) order by x.row_resolution_id,x.id) from public.weekly_source_row_economic_snapshots x
      where x.row_resolution_id in(select id from resolutions)),'[]'::jsonb),
    'expense_policy_snapshots',coalesce((select jsonb_agg(to_jsonb(x) order by x.row_resolution_id,x.id)
      from public.weekly_source_row_expense_policy_snapshots x where x.row_resolution_id in(select id from resolutions)),'[]'::jsonb),
    'expense_authorities',coalesce((select jsonb_agg(to_jsonb(x) order by x.work_event_id,x.generation,x.id)
      from public.weekly_expense_authority_generations x where x.final_revision_id in(select id from revisions)
        and x.work_event_id in(select id from events)),'[]'::jsonb),
    'expense_cell_evidence',coalesce((select jsonb_agg(to_jsonb(x) order by x.upload_id,x.source_row_ordinal,x.id)
      from public.weekly_source_expense_cell_evidence x where x.upload_id in(select id from uploads)),'[]'::jsonb),
    'charge_checks',coalesce((select jsonb_agg(to_jsonb(x) order by x.row_resolution_id,x.id)
      from public.weekly_source_charge_checks x where x.row_resolution_id in(select id from resolutions)),'[]'::jsonb),
    'charge_acceptances',coalesce((select jsonb_agg(to_jsonb(x) order by x.row_resolution_id,x.id)
      from public.weekly_source_charge_acceptances x where x.row_resolution_id in(select id from resolutions)),'[]'::jsonb),
    'invoice_hold_releases',coalesce((select jsonb_agg(to_jsonb(x) order by x.upload_row_id,x.hold_kind,x.id)
      from public.weekly_source_invoice_hold_releases x where x.upload_row_id in(select id from source_rows)),'[]'::jsonb),
    'transitions',coalesce((select jsonb_agg(to_jsonb(x) order by x.final_revision_id,x.work_event_id,x.id)
      from public.weekly_source_state_transitions x where x.final_revision_id in(select id from revisions)
        and x.work_event_id in(select id from events)),'[]'::jsonb),
    'report_scopes',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from report_scopes x),'[]'::jsonb),
    'reports',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from public.weekly_source_self_bill_reports x
      where x.source_group_id=g.id and x.client_id=any(clients)),'[]'::jsonb),
    'report_bindings',coalesce((select jsonb_agg(to_jsonb(x) order by x.report_row_id,x.id) from report_bindings x),'[]'::jsonb),
    'events',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from events x),'[]'::jsonb),
    'revisions',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from revisions x),'[]'::jsonb),
    'snapshots',coalesce((select jsonb_agg(to_jsonb(x) order by x.final_revision_id,x.work_event_id,x.id) from snapshots x),'[]'::jsonb),
    'lineages',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from lineages x),'[]'::jsonb),
    'pay_receipts',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from pay_receipts x),'[]'::jsonb),
    'financial_identities',coalesce((select jsonb_agg(to_jsonb(x) order by x.id) from financial_identities x),'[]'::jsonb),
    'root_identities',coalesce((select jsonb_agg(to_jsonb(x) order by x.timesheet_id) from root_identities x),'[]'::jsonb)) into facts;
  if exists(select 1 from jsonb_array_elements(facts->'pay_receipts') receipt
    where receipt->>'published_timesheet_financial_id' is not null and (
      jsonb_typeof(receipt->'source_unit_outcomes_json') is distinct from 'array'
      or case when jsonb_typeof(receipt->'source_unit_outcomes_json')='array'
        then jsonb_array_length(receipt->'source_unit_outcomes_json')=0 else true end
      or exists(select 1 from jsonb_array_elements(case when jsonb_typeof(receipt->'source_unit_outcomes_json')='array'
          then receipt->'source_unit_outcomes_json' else '[]'::jsonb end) unit
        where not exists(select 1 from public.weekly_source_billing_movements m
          where m.id=(unit->>'movement_id')::uuid and m.final_revision_id=(receipt->>'final_revision_id')::uuid
            and m.invoice_timesheet_id=(receipt->>'root_timesheet_id')::uuid
            and m.actual_client_id=(receipt->>'client_id')::uuid
            and exists(select 1 from jsonb_array_elements(facts->'financial_identities') financial
              where financial->>'id'=receipt->>'published_timesheet_financial_id'
                and financial->>'candidate_id'=m.candidate_id::text
                and financial->>'contract_id'=m.contract_id::text)
            and encode(m.movement_economic_hash,'hex')=unit->>'movement_economic_hash'
            and m.source_profile_kind<>'SELF_BILL_REPORT'
            and m.source_line_kind not in ('SELF_BILL_REPORT_LINE','INVOICE_VAT_ROUNDING','SOURCE_REBILL_LINE','SOURCE_INVOICE_CORRECTION'))))) then
    raise exception 'WEEKLY_SOURCE_BULK_SOURCE_CAS_FINANCIAL_IDENTITY_INVALID' using errcode='55000'; end if;
  if (select count(*) from public.clients where id=any(clients))<>cardinality(clients)
    or exists(select 1 from jsonb_array_elements(facts->'pay_receipts') receipt
      where receipt->>'published_timesheet_financial_id' is not null and not exists(
        select 1 from jsonb_array_elements(facts->'financial_identities') financial
          where financial->>'id'=receipt->>'published_timesheet_financial_id'
            and financial->>'timesheet_id'=receipt->>'root_timesheet_id' and financial->>'client_id'=receipt->>'client_id'
            and exists(select 1 from jsonb_array_elements(facts->'root_identities') root
              join jsonb_array_elements(facts->'contracts') contract on contract->>'id'=financial->>'contract_id'
              where root->>'timesheet_id'=financial->>'timesheet_id'
                and root->>'candidate_id'=financial->>'candidate_id' and root->>'contract_id'=financial->>'contract_id'
                and (root->>'client_id' is null or root->>'client_id'=financial->>'client_id')
                and contract->>'client_id'=financial->>'client_id' and contract->>'candidate_id'=financial->>'candidate_id'))) then
    raise exception 'WEEKLY_SOURCE_BULK_SOURCE_CAS_FINANCIAL_IDENTITY_INVALID' using errcode='55000'; end if;
  if octet_length(convert_to(facts::text,'UTF8'))>8388608 then
    raise exception 'WEEKLY_SOURCE_BULK_SOURCE_CAS_SCOPE_TOO_LARGE' using errcode='54000'; end if;
  return facts;
exception when no_data_found or too_many_rows or invalid_text_representation then
  raise exception 'WEEKLY_SOURCE_BULK_SOURCE_CAS_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_bulk_source_cas_v1(p_cycle_id uuid,p_client_ids uuid[])
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare facts jsonb;
begin
  facts:=private.weekly_source_bulk_source_facts_v1(p_cycle_id,p_client_ids);
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_BULK_SOURCE_CAS_V1','source_cycle_id',p_cycle_id,
    'client_ids',facts->'client_ids','source_cas_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_BULK_SOURCE_CAS_V1',facts),'hex'));
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/04_final_revision_rule_guard.sqlinc; raw SHA256 e2349dc619a7b30c74328d62a8f1aace2435a361d30309b9c43e3ff543fef3a3
create or replace function private.weekly_source_final_rule_version_guard_v1()
returns trigger language plpgsql security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_version uuid;
begin
  if tg_op='UPDATE' then
    if new.rule_set_version_id is distinct from old.rule_set_version_id then
      raise exception 'WEEKLY_SOURCE_FINAL_RULE_VERSION_IMMUTABLE' using errcode='55000';
    end if;
    return new;
  end if;
  select a.rule_set_version_id into v_version from public.weekly_source_cycles c
    join public.weekly_source_groups g on g.id=c.source_group_id and g.active and g.source_family='ROSTER'
    join public.weekly_source_group_rule_assignments a on a.source_group_id=g.id and a.feature_enabled and a.feature_purpose='RULE_SET'
      and c.finalisation_week_ending between a.effective_from_week_ending and coalesce(a.effective_to_week_ending,'infinity'::date)
    where c.id=new.source_cycle_id;
  if v_version is null then
    -- One exact per-command actual F1 reference; the normal disabled path is
    -- unchanged. UPDATE immutability above and the locked native FIN remain.
    v_version:=nullif(private.weekly_source_rule_qualification_context_v1(null,new.source_cycle_id)->>'rule_set_version_id','')::uuid;
  end if;
  if new.rule_set_version_id is not null and new.rule_set_version_id is distinct from v_version then
    raise exception 'WEEKLY_SOURCE_FINAL_RULE_VERSION_STALE' using errcode='40001';
  end if;
  new.rule_set_version_id:=v_version;
  return new;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/05_coverage_floor_owner.sqlinc; raw SHA256 6f34e8d9ab9bf08a7bb0fc240fea49a35edc420ff7b7d1f98210a697476f34f3
create or replace function private.weekly_source_rule_coverage_floor_v1(p_client_id uuid,p_cycle_id uuid)
returns date language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_cycle public.weekly_source_cycles%rowtype; v_floor date;
begin
  select * into strict v_cycle from public.weekly_source_cycles where id=p_cycle_id;
  if private.weekly_source_effective_rule_set_v1(p_client_id,p_cycle_id) is null then return null; end if;
  if private.weekly_source_operational_effective_rule_set_v1(p_client_id,p_cycle_id) is null then
    -- Qualification exposure is its genuine existing audit OPEN, never an
    -- invented normal activation receipt or a checking-time clock substitute.
    select (audit.after_json->>'coverage_floor_local_date')::date into strict v_floor
    from public.audit_events audit
    where audit.object_type='weekly_source_off_rule_test_journey' and audit.action='WEEKLY_SOURCE_OFF_RULE_TEST_OPENED'
      and audit.event_sequence_is_authoritative and audit.object_id_text=private.weekly_source_rule_qualification_context_v1(p_client_id,p_cycle_id)->>'scope_id';
    if v_floor<>v_cycle.finalisation_week_ending-6 then
      raise exception 'WEEKLY_SOURCE_RULE_COVERAGE_HISTORY_UNPROVABLE' using errcode='55000'; end if;
    return v_floor;
  end if;
  -- F1's only feature writer refuses false->false. A RULE_SET purpose and
  -- complete receipt remain after disable; a never-enabled draft has neither.
  -- Refuse malformed activated history rather than advancing a client's floor.
  if exists(select 1 from public.weekly_source_group_rule_assignments a
    join public.weekly_source_group_clients gc on gc.source_group_id=a.source_group_id and gc.client_id=p_client_id
      and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]')
        && daterange(a.effective_from_week_ending,coalesce(a.effective_to_week_ending,'infinity'::date),'[]')
    where a.source_group_id=v_cycle.source_group_id and a.feature_purpose='RULE_SET'
      and a.effective_from_week_ending<=v_cycle.finalisation_week_ending and (
        a.rule_set_version_id is null or a.feature_release_id is null or a.feature_changed_at_utc is null
        or a.feature_changed_by_user_id is null or a.feature_request_id is null or a.feature_request_sha256 is null
        or a.feature_receipt_json->>'contract' is distinct from 'WEEKLY_SOURCE_RULE_FEATURE_RECEIPT_V1'
        or a.feature_receipt_json->>'assignment_id' is distinct from a.id::text
        or a.feature_receipt_json->>'source_group_id' is distinct from a.source_group_id::text
        or a.feature_receipt_json->>'rule_set_version_id' is distinct from a.rule_set_version_id::text
        or a.feature_receipt_json->>'effective_from_week_ending' is distinct from a.effective_from_week_ending::text
        or a.feature_receipt_json->>'release_id' is distinct from a.feature_release_id
        or a.feature_receipt_json->>'actor_user_id' is distinct from a.feature_changed_by_user_id::text
        or a.feature_receipt_json->>'request_id' is distinct from a.feature_request_id::text
        or (a.feature_receipt_json->>'changed_at_utc')::timestamptz is distinct from a.feature_changed_at_utc
        or a.feature_receipt_json->>'feature_purpose' is distinct from 'RULE_SET'
        or a.feature_receipt_json->'feature_enabled' is distinct from to_jsonb(a.feature_enabled)
      )) then
    raise exception 'WEEKLY_SOURCE_RULE_COVERAGE_HISTORY_UNPROVABLE' using errcode='55000';
  end if;
  with applicable_assignments as (
    select greatest(a.effective_from_week_ending+((7-extract(dow from a.effective_from_week_ending)::integer)%7),
      gc.valid_from+((7-extract(dow from gc.valid_from)::integer)%7)) first_week,
      least(coalesce(a.effective_to_week_ending,'infinity'::date),coalesce(gc.valid_to,'infinity'::date),
        v_cycle.finalisation_week_ending) last_week
    from public.weekly_source_group_rule_assignments a
    join public.weekly_source_group_clients gc on gc.source_group_id=a.source_group_id and gc.client_id=p_client_id
    join public.weekly_source_rule_set_versions version on version.id=a.rule_set_version_id
    join public.weekly_source_rule_sets rules on rules.id=version.rule_set_id
    join public.weekly_source_groups source_group on source_group.id=a.source_group_id
      and source_group.agency_id=rules.agency_id and source_group.environment=rules.environment
    where a.source_group_id=v_cycle.source_group_id and a.feature_purpose='RULE_SET'
      and a.feature_release_id is not null and a.feature_changed_at_utc is not null
  ), frozen_use as (
    select source_cycle.finalisation_week_ending first_week
    from public.weekly_source_final_revisions final
    join public.weekly_source_cycles source_cycle on source_cycle.id=final.source_cycle_id
      and source_cycle.source_group_id=v_cycle.source_group_id
    join public.weekly_source_group_clients gc on gc.source_group_id=source_cycle.source_group_id
      and gc.client_id=p_client_id and source_cycle.finalisation_week_ending
        between gc.valid_from and coalesce(gc.valid_to,'infinity'::date)
    join public.weekly_source_rule_set_versions version on version.id=final.rule_set_version_id
    join public.weekly_source_rule_sets rules on rules.id=version.rule_set_id
    join public.weekly_source_groups source_group on source_group.id=source_cycle.source_group_id
      and source_group.agency_id=rules.agency_id and source_group.environment=rules.environment
    where source_cycle.finalisation_week_ending<=v_cycle.finalisation_week_ending
      and (source_cycle.scope_client_id=p_client_id or exists(
        select 1 from public.weekly_source_client_manifests manifest
        where manifest.final_revision_id=final.id and manifest.client_id=p_client_id)
        or exists(select 1 from public.weekly_source_report_scopes report
          where report.id=final.report_scope_id and report.source_cycle_id=source_cycle.id and report.client_id=p_client_id))
  ) select min(first_week)-6 into v_floor from (
    select first_week from applicable_assignments where first_week<=last_week
    union all select first_week from frozen_use
  ) history;
  if v_floor is null then raise exception 'WEEKLY_SOURCE_RULE_COVERAGE_HISTORY_UNPROVABLE' using errcode='55000'; end if;
  return v_floor;
exception when invalid_text_representation or invalid_datetime_format or datetime_field_overflow then
  raise exception 'WEEKLY_SOURCE_RULE_COVERAGE_HISTORY_UNPROVABLE' using errcode='55000';
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/07_automatic_capability_admission.sqlinc; raw SHA256 b08e604e3df9b13eaeb1b0e7ab635e85a0a80d94785ecb76327d35b14a866ac4
create or replace function private.weekly_source_automatic_reconcile_capability_assert_v1(p_cycle_id uuid)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_ready boolean; v_auth jsonb;
begin
  if to_regprocedure('private.weekly_source_automatic_reconcile_producer_ready_v1(uuid)') is null
    or to_regprocedure('private.weekly_source_automatic_reconcile_delta_assert_v1(uuid,uuid)') is null then
    raise exception 'WEEKLY_SOURCE_AUTOMATIC_RECONCILE_DELTA_UNAVAILABLE' using errcode='55000'; end if;
  execute 'select private.weekly_source_automatic_reconcile_producer_ready_v1($1)' into v_ready using p_cycle_id;
  if v_ready is distinct from true then
    v_auth:=private.weekly_source_rule_qualification_context_v1(null,p_cycle_id);
    if v_auth is null or v_auth->>'purpose' is distinct from 'AUTOMATIC_JOURNEY' then
      raise exception 'WEEKLY_SOURCE_AUTOMATIC_RECONCILE_DELTA_UNAVAILABLE' using errcode='55000'; end if;
  end if;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/08_cas_admission_owner.sqlinc; raw SHA256 c5e3217b5ad271d66614ad3df0ad80870f57817fb18e042b9dcb43339a69e285
create or replace function private.weekly_source_bulk_source_cas_assert_v1(p_cycle_id uuid,p_client_ids uuid[])
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_ready boolean; v_cas jsonb; v_clients uuid[]; v_auth jsonb;
begin
  if p_client_ids is null or array_position(p_client_ids,null::uuid) is not null then
    raise exception 'WEEKLY_SOURCE_BULK_SOURCE_CAS_INVALID' using errcode='22023'; end if;
  select coalesce(array_agg(distinct item order by item),'{}'::uuid[]) into v_clients from unnest(p_client_ids) item;
  if to_regprocedure('private.weekly_source_bulk_producer_ready_v1(uuid)') is null
    or to_regprocedure('private.weekly_source_bulk_source_cas_v1(uuid,uuid[])') is null then
    raise exception 'WEEKLY_SOURCE_BULK_PRODUCER_UNAVAILABLE' using errcode='55000'; end if;
  execute 'select private.weekly_source_bulk_producer_ready_v1($1)' into v_ready using p_cycle_id;
  if v_ready is distinct from true then
    begin
      perform private.weekly_source_protected_qualification_assert_v1(null,p_cycle_id,v_clients,'BULK_SIGNED');
    exception when sqlstate '42501' or sqlstate '55000' then
      v_auth:=private.weekly_source_rule_qualification_context_v1(null,p_cycle_id);
      if v_auth is null or v_auth->>'purpose' is distinct from 'AUTOMATIC_JOURNEY'
        or v_auth#>'{fixture_manifest,client_ids}' is distinct from to_jsonb(v_clients) then
        raise exception 'WEEKLY_SOURCE_BULK_PRODUCER_UNAVAILABLE' using errcode='55000'; end if;
    end;
  end if;
  execute 'select private.weekly_source_bulk_source_cas_v1($1,$2)' into v_cas using p_cycle_id,v_clients;
  if not private.weekly_exceptional_json_keys_exact_v1(v_cas,array['schema_version','source_cycle_id','client_ids','source_cas_sha256'])
    or not(v_cas ?& array['schema_version','source_cycle_id','client_ids','source_cas_sha256'])
    or v_cas->>'schema_version' is distinct from 'WEEKLY_SOURCE_BULK_SOURCE_CAS_V1'
    or v_cas->>'source_cycle_id' is distinct from p_cycle_id::text
    or v_cas->'client_ids' is distinct from to_jsonb(v_clients)
    or coalesce(v_cas->>'source_cas_sha256','') !~ '^[0-9a-f]{64}$' then
    raise exception 'WEEKLY_SOURCE_BULK_SOURCE_CAS_INVALID' using errcode='55000'; end if;
  return v_cas;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/10_complete_bulk_test_scope.sqlinc; raw SHA256 1c91b6644e98967c1aac0f343c096c96fdc27f05b291f5919b0bb942828377e6
-- Source proposal: explicit, expiring, fixture-only TEST admission in the
-- EXISTING audit log. No assignment/readiness mutation, table or service grant.
-- Only the existing controlled feature setup RPC calls the write owner.
create or replace function private.weekly_source_protected_test_authorization_v1(p_authorization_id uuid)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare r private.cloudtms_database_releases%rowtype; auth jsonb; n integer;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict r from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1;
  if current_database()<>'cloudtms_test_clone' or r.status<>'VERIFIED' or r.completed_at_utc is null
    or r.installed_contract_sha256 is distinct from r.repository_contract_sha256
    or r.evidence_json#>>'{managed_release,environment}' is distinct from 'TEST'
    or r.evidence_json#>>'{managed_release,expected_database}' is distinct from current_database()
    or jsonb_typeof(r.evidence_json->'weekly_source_protected_test_setup_authorizations') is distinct from 'array' then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_AUTHORIZATION_REQUIRED' using errcode='55000'; end if;
  select count(*),jsonb_agg(value)->0 into n,auth
    from jsonb_array_elements(r.evidence_json->'weekly_source_protected_test_setup_authorizations') value
    where value->>'authorization_id'=p_authorization_id::text;
  if n<>1 or not private.weekly_source_qualification_closed_object_v1(auth,array['schema_version','authorization_id','scope_id',
      'release_id','source_commit','contract_sha256','agency_id','source_group_id','source_cycle_id','setup_actor_user_id',
      'journey_actor_user_id','week_ending','expires_at_utc','fixture_namespace','fixture_manifest','original_census',
      'prerequisite_qualification_sha256','capabilities','authorization_sha256'])
    or auth->>'schema_version' is distinct from 'WEEKLY_SOURCE_PROTECTED_TEST_SETUP_AUTHORIZATION_V1'
    or auth->>'release_id' is distinct from r.release_id or auth->>'source_commit' is distinct from r.git_commit
    or auth->>'contract_sha256' is distinct from r.installed_contract_sha256
    or auth->'capabilities' is distinct from '["BULK_SIGNED"]'::jsonb
    or auth->>'fixture_namespace' is distinct from 'WSQ_TEST_'
    or auth->>'authorization_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PROTECTED_TEST_SETUP_AUTHORIZATION_V1',auth-'authorization_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_AUTHORIZATION_REQUIRED' using errcode='55000'; end if;
  -- This is an observed latest installed release, not function-presence READY.
  if private.weekly_source_protected_qualification_release_v1()->>'release_id' is distinct from r.release_id then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_INSTALLED_RELEASE_REQUIRED' using errcode='55000'; end if;
  return auth;
exception when no_data_found or too_many_rows or invalid_text_representation then
  raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_AUTHORIZATION_REQUIRED' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_protected_test_scope_assert_v1(
  p_cycle_id uuid,p_actor_user_id uuid,p_original_client_ids uuid[],p_work_event_id uuid default null
) returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare lease jsonb; auth jsonb; n integer; c public.weekly_source_cycles%rowtype;
  g public.weekly_source_groups%rowtype; clients uuid[]; expected jsonb; item jsonb; actual jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict c from public.weekly_source_cycles where id=p_cycle_id;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and active and source_family='ROSTER' and environment='TEST';
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'APPROVE_PROTECTED_PAY',g.id,null,c.finalisation_week_ending);
  select count(*),jsonb_agg(a.after_json)->0 into n,lease from public.audit_events a
    where a.object_type='weekly_source_protected_test_journey' and a.action='WEEKLY_SOURCE_TEST_JOURNEY_OPENED'
      and a.event_sequence_is_authoritative and a.after_json->>'source_cycle_id'=c.id::text
      and a.after_json->>'journey_actor_user_id'=p_actor_user_id::text
      and not exists(select 1 from public.audit_events closed where closed.object_type=a.object_type
        and closed.object_id_text=a.object_id_text and closed.event_sequence_is_authoritative
        and closed.action in ('WEEKLY_SOURCE_TEST_JOURNEY_CLOSED','WEEKLY_SOURCE_TEST_JOURNEY_REVOKED'));
  if n<>1 or lease->>'contract' is distinct from 'WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_V1'
    or lease->'operational_ready' is distinct from 'false'::jsonb
    or lease->>'scope_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_V1',lease-'scope_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  auth:=private.weekly_source_protected_test_authorization_v1((lease->>'authorization_id')::uuid);
  if lease->>'authorization_sha256' is distinct from auth->>'authorization_sha256'
    or lease->>'scope_id' is distinct from auth->>'scope_id'
    or lease->>'source_cycle_id' is distinct from auth->>'source_cycle_id'
    or lease->>'journey_actor_user_id' is distinct from auth->>'journey_actor_user_id'
    or lease->>'week_ending' is distinct from c.finalisation_week_ending::text
    or auth->>'agency_id' is distinct from g.agency_id::text or auth->>'source_group_id' is distinct from g.id::text
    or clock_timestamp()>=(auth->>'expires_at_utc')::timestamptz
    or (clock_timestamp() at time zone 'Europe/London')::date is distinct from (lease->>'opened_local_date')::date
    or exists(select 1 from public.weekly_source_group_rule_assignments a where a.source_group_id=g.id and a.feature_enabled
      and c.finalisation_week_ending between a.effective_from_week_ending and coalesce(a.effective_to_week_ending,'infinity'::date))
    or private.weekly_source_bulk_producer_ready_v1(c.id) or private.weekly_source_automatic_reconcile_producer_ready_v1(c.id) then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  select array_agg(value::uuid order by value::uuid) into clients
    from jsonb_array_elements_text(auth#>'{original_census,original_client_ids}') value;
  if p_original_client_ids is not null and to_jsonb(p_original_client_ids) is distinct from to_jsonb(clients) then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_ORIGINAL_CENSUS_CHANGED' using errcode='40001'; end if;
  if private.weekly_source_bulk_source_cas_v1(c.id,clients) is distinct from auth#>'{original_census,source_cas}' then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_SOURCE_CHANGED' using errcode='40001'; end if;
  for item in select value from jsonb_array_elements(auth#>'{original_census,original_root_identities}') value loop
    select jsonb_build_object('timesheet_id',s.timesheet_id,'booking_id',s.booking_id,'contract_id',k.id,
      'candidate_id',k.candidate_id,'client_id',s.client_id) into actual
      from public.timesheets s join public.contracts k on k.id=s.contract_id
      where s.timesheet_id=(item->>'timesheet_id')::uuid and (s.client_id is null or s.client_id=k.client_id);
    if actual is distinct from item then raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_ORIGINAL_ROOT_CHANGED' using errcode='40001'; end if;
  end loop;
  if p_work_event_id is not null and not exists(select 1 from jsonb_array_elements(auth#>'{original_census,original_items}') item
    where item->>'work_event_id'=p_work_event_id::text) then
    raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_FOREIGN_EVENT_REFUSED' using errcode='42501'; end if;
  return lease||jsonb_build_object('original_census',auth->'original_census','capabilities',auth->'capabilities');
exception when no_data_found or too_many_rows or invalid_text_representation or datetime_field_overflow then
  raise exception 'WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;

-- This write helper is not a new public/service RPC. The existing admin-only
-- feature setup owner dispatches OPEN/CLOSE/REVOKE, always before feature writes.
create or replace function private.weekly_source_protected_test_setup_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare actor uuid; auth jsonb; lease jsonb; result jsonb; c public.weekly_source_cycles%rowtype;
  g public.weekly_source_groups%rowtype; action text; manifest jsonb; census jsonb; n integer; q jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['actor_user_id','agency_id','environment','qualification_action',
      'authorization_id','expected_authorization_sha256','reason'])
    or not(p_request ?& array['actor_user_id','agency_id','environment','qualification_action','authorization_id','expected_authorization_sha256','reason'])
    or char_length(coalesce(p_request->>'reason','')) not between 1 and 500 then
    raise exception 'WEEKLY_SOURCE_TEST_SETUP_REQUEST_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid;action:=p_request->>'qualification_action';
  perform private._weekly_source_settings_require_admin_v1(actor);
  if private._weekly_source_settings_deployment_v1((p_request->>'agency_id')::uuid,p_request->>'environment')<>'TEST'
    or action not in ('OPEN','CLOSE','REVOKE') then raise exception 'WEEKLY_SOURCE_TEST_SETUP_REQUEST_INVALID' using errcode='22023'; end if;
  auth:=private.weekly_source_protected_test_authorization_v1((p_request->>'authorization_id')::uuid);
  if auth->>'authorization_sha256' is distinct from p_request->>'expected_authorization_sha256'
    or auth->>'setup_actor_user_id' is distinct from actor::text or auth->>'agency_id' is distinct from p_request->>'agency_id' then
    raise exception 'WEEKLY_SOURCE_TEST_SETUP_AUTHORIZATION_CHANGED' using errcode='40001'; end if;
  perform pg_advisory_xact_lock(hashtextextended('weekly-source-test-journey:'||(auth->>'scope_id'),0));
  select * into strict c from public.weekly_source_cycles where id=(auth->>'source_cycle_id')::uuid;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and id=(auth->>'source_group_id')::uuid
    and active and source_family='ROSTER' and environment='TEST';
  if g.code is distinct from auth#>>'{fixture_manifest,group_code}' or g.code !~ '^WSQ_TEST_[A-Z0-9_]+$'
    or g.agency_id::text is distinct from auth->>'agency_id'
    or c.finalisation_week_ending::text is distinct from auth->>'week_ending' then
    raise exception 'WEEKLY_SOURCE_TEST_SETUP_FIXTURE_SCOPE_INVALID' using errcode='42501'; end if;
  select count(*),jsonb_agg(a.after_json)->0 into n,lease from public.audit_events a
    where a.object_type='weekly_source_protected_test_journey' and a.object_id_text=auth->>'scope_id'
      and a.action='WEEKLY_SOURCE_TEST_JOURNEY_OPENED' and a.event_sequence_is_authoritative;
  if exists(select 1 from public.audit_events a where a.object_type='weekly_source_protected_test_journey'
    and a.object_id_text=auth->>'scope_id' and a.event_sequence_is_authoritative
    and a.action in ('WEEKLY_SOURCE_TEST_JOURNEY_CLOSED','WEEKLY_SOURCE_TEST_JOURNEY_REVOKED')) then
    raise exception 'WEEKLY_SOURCE_TEST_SETUP_SCOPE_TERMINAL' using errcode='55000'; end if;
  if action='OPEN' then
    perform private.weekly_source_office_authority_v1((auth->>'journey_actor_user_id')::uuid,'APPROVE_PROTECTED_PAY',g.id,null,c.finalisation_week_ending);
    if n<>0 or (auth->>'expires_at_utc')::timestamptz<=clock_timestamp()
      or (auth->>'expires_at_utc')::timestamptz>clock_timestamp()+interval '2 hours'
      or exists(select 1 from public.weekly_source_group_rule_assignments a where a.source_group_id=g.id and a.feature_enabled
        and c.finalisation_week_ending between a.effective_from_week_ending and coalesce(a.effective_to_week_ending,'infinity'::date))
      or private.weekly_source_bulk_producer_ready_v1(c.id) or private.weekly_source_automatic_reconcile_producer_ready_v1(c.id) then
      raise exception 'WEEKLY_SOURCE_TEST_SETUP_OPEN_REFUSED' using errcode='55000'; end if;
    census:=private.weekly_source_protected_qualification_census_v1(c.id);
    if census is distinct from auth->'original_census' then raise exception 'WEEKLY_SOURCE_TEST_SETUP_CENSUS_CHANGED' using errcode='40001'; end if;
    manifest:=auth->'fixture_manifest';
    if manifest->'client_ids' is distinct from census->'original_client_ids'
      or (select coalesce(jsonb_agg(distinct item->'candidate_id' order by item->'candidate_id'),'[]'::jsonb)
        from jsonb_array_elements(census->'original_items') item) is distinct from manifest->'candidate_ids'
      or (select coalesce(jsonb_agg(distinct item->'contract_id' order by item->'contract_id'),'[]'::jsonb)
        from jsonb_array_elements(census->'original_items') item) is distinct from manifest->'contract_ids'
      or (select coalesce(jsonb_agg(distinct item->'work_event_id' order by item->'work_event_id'),'[]'::jsonb)
        from jsonb_array_elements(census->'original_items') item) is distinct from manifest->'work_event_ids'
      or (select coalesce(jsonb_agg(item->'timesheet_id' order by item->'timesheet_id'),'[]'::jsonb)
        from jsonb_array_elements(census->'original_root_identities') item) is distinct from manifest->'original_root_ids'
      or (select coalesce(jsonb_agg(item->'client_id' order by item->'client_id'),'[]'::jsonb)
        from jsonb_array_elements(manifest->'client_refs') item) is distinct from manifest->'client_ids'
      or (select coalesce(jsonb_agg(item->'candidate_id' order by item->'candidate_id'),'[]'::jsonb)
        from jsonb_array_elements(manifest->'candidate_refs') item) is distinct from manifest->'candidate_ids'
      or exists(select 1 from jsonb_array_elements(manifest->'client_refs') item
        where coalesce(item->>'cli_ref','') !~ '^CLI-913013[0-9]{2}$'
          or not exists(select 1 from public.clients client where client.id=(item->>'client_id')::uuid and client.cli_ref=item->>'cli_ref'))
      or exists(select 1 from jsonb_array_elements(manifest->'candidate_refs') item
        where coalesce(item->>'tms_ref','') !~ '^CCR-913013[0-9]{2}$'
          or not exists(select 1 from public.candidates candidate where candidate.id=(item->>'candidate_id')::uuid and candidate.tms_ref=item->>'tms_ref')) then
      raise exception 'WEEKLY_SOURCE_TEST_SETUP_FIXTURE_SCOPE_INVALID' using errcode='42501'; end if;
    -- Explicit prerequisite evidence stays NON-OPERATIONAL. Its NEXT_PAY row
    -- must be a genuine installed Banking prerequisite; root's managed writer
    -- binds the artifact/record. Function presence is never accepted here.
    select value into strict q from private.cloudtms_database_releases r,
      lateral jsonb_array_elements(r.evidence_json->'weekly_source_protected_prerequisite_qualifications') value
      where r.release_id=auth->>'release_id' and value->>'qualification_sha256'=auth->>'prerequisite_qualification_sha256';
    perform private.weekly_source_protected_prerequisite_release_assert_v2(q,g.id,
      (q->>'effective_from_week_ending')::date,(q->>'effective_to_week_ending')::date,auth->>'prerequisite_qualification_sha256');
    if q->'capabilities' is distinct from '["BULK_SIGNED"]'::jsonb
      or not exists(select 1 from jsonb_array_elements(q->'gate_receipts') receipt
        where receipt->>'gate'='NEXT_PAY' and receipt->>'status'='PREREQUISITE_PASS') then
      raise exception 'WEEKLY_SOURCE_TEST_SETUP_NEXT_PREREQUISITE_REQUIRED' using errcode='55000'; end if;
    lease:=jsonb_build_object('contract','WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_V1','scope_id',auth->>'scope_id',
      'authorization_id',auth->>'authorization_id','authorization_sha256',auth->>'authorization_sha256',
      'source_group_id',g.id,'source_cycle_id',c.id,'agency_id',g.agency_id,'week_ending',c.finalisation_week_ending,
      'journey_actor_user_id',auth->>'journey_actor_user_id','setup_actor_user_id',actor,'expires_at_utc',auth->>'expires_at_utc',
      'opened_local_date',(clock_timestamp() at time zone 'Europe/London')::date,'operational_ready',false);
    lease:=lease||jsonb_build_object('scope_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_TEST_JOURNEY_SCOPE_V1',lease),'hex'));
    perform public._audit_insert('weekly_source_protected_test_journey',auth->>'scope_id','WEEKLY_SOURCE_TEST_JOURNEY_OPENED',null,lease,p_request->>'reason',actor);
    return lease;
  end if;
  if n<>1 then raise exception 'WEEKLY_SOURCE_TEST_SETUP_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  if action='CLOSE' then
    perform private.weekly_source_protected_test_scope_assert_v1(c.id,(auth->>'journey_actor_user_id')::uuid,null,null);
    result:=jsonb_build_object('scope_id',auth->>'scope_id','scope_sha256',lease->>'scope_sha256','setup_authorization_sha256',auth->>'authorization_sha256',
      'original_census_sha256',auth#>>'{original_census,census_sha256}','actor_user_id',auth->>'journey_actor_user_id',
      'source_cycle_id',c.id,'week_ending',c.finalisation_week_ending,'execution_release_id',auth->>'release_id',
      'execution_source_commit',auth->>'source_commit','execution_contract_sha256',auth->>'contract_sha256',
      'state','CLOSED','closed_at_utc',clock_timestamp(),'all_assignments_disabled',true,'all_operational_producers_false',true);
  else
    result:=jsonb_build_object('scope_id',auth->>'scope_id','state','REVOKED','closed_at_utc',clock_timestamp(),'operational_ready',false);
  end if;
  perform public._audit_insert('weekly_source_protected_test_journey',auth->>'scope_id',
    case when action='CLOSE' then 'WEEKLY_SOURCE_TEST_JOURNEY_CLOSED' else 'WEEKLY_SOURCE_TEST_JOURNEY_REVOKED' end,
    lease,result,p_request->>'reason',actor);
  return result;
exception when no_data_found or too_many_rows or invalid_text_representation or datetime_field_overflow then
  raise exception 'WEEKLY_SOURCE_TEST_SETUP_REQUEST_INVALID' using errcode='22023';
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/ACTIVATION_WINDOW_BINDING.sqlinc; raw SHA256 883eab37fd437a4b802c2f6331de865b7eb0e1bca8d5ec12d2624d9a950604a4
create or replace function private.weekly_source_activation_window_binding_assert_v1(p_binding jsonb,p_native jsonb,p_closure jsonb,p_group uuid,p_from date,p_to date)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare a public.weekly_source_group_rule_assignments%rowtype; v public.weekly_source_rule_set_versions%rowtype; lease jsonb; off_lease boolean;
begin
  if not private.weekly_source_qualification_closed_object_v1(p_binding,array['schema_version','assignment_id','assignment_version','assignment_sha256',
    'source_group_id','feature_purpose','rule_set_version_id','rule_values_sha256','effective_from_week_ending','effective_to_week_ending',
    'native_effective_from_week_ending','native_effective_to_week_ending','fixture_cycle_id','fixture_rule_set_version_id','fixture_rule_values_sha256',
    'scope_id','scope_sha256','original_census_sha256','scope_binding_sha256'])
    or p_binding->>'schema_version' is distinct from 'WEEKLY_SOURCE_ACTIVATION_WINDOW_BINDING_V1'
    or exists(select 1 from unnest(array['assignment_id','source_group_id','fixture_cycle_id','scope_id']) key
      where coalesce(p_binding->>key,'') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
    or exists(select 1 from unnest(array['assignment_sha256','scope_sha256','original_census_sha256','scope_binding_sha256']) key
      where coalesce(p_binding->>key,'') !~ '^[0-9a-f]{64}$')
    or coalesce(p_binding->>'assignment_version','') !~ '^[1-9][0-9]*$'
    or p_binding->>'scope_binding_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_ACTIVATION_WINDOW_BINDING_V1',p_binding-'scope_binding_sha256'),'hex')
    or p_binding->>'source_group_id' is distinct from p_group::text
    or p_binding->>'effective_from_week_ending' is distinct from p_from::text
    or p_binding->>'effective_to_week_ending' is distinct from p_to::text
    or p_binding->>'native_effective_from_week_ending' is distinct from p_native->>'effective_from_week_ending'
    or p_binding->>'native_effective_to_week_ending' is distinct from p_native->>'effective_to_week_ending'
    or p_binding->>'fixture_cycle_id' is distinct from p_closure->>'source_cycle_id'
    or exists(select 1 from unnest(array['scope_id','scope_sha256','original_census_sha256']) key where p_binding->>key is distinct from p_closure->>key)
    or extract(dow from p_from)<>0 or (p_to is not null and (extract(dow from p_to)<>0 or p_to<p_from))
    or extract(dow from (p_native->>'effective_from_week_ending')::date)<>0
    or p_from<(p_native->>'effective_from_week_ending')::date then
    raise exception 'WEEKLY_SOURCE_OPERATIONAL_ACTIVATION_WINDOW_BINDING_INVALID' using errcode='55000'; end if;
  select * into strict a from public.weekly_source_group_rule_assignments where id=(p_binding->>'assignment_id')::uuid;
  if a.source_group_id<>p_group or a.effective_from_week_ending<>p_from or a.effective_to_week_ending is distinct from p_to
    or a.rule_set_version_id::text is distinct from p_binding->>'rule_set_version_id'
    or p_binding->>'feature_purpose' not in ('RULE_SET','PROTECTED_SOURCE') then
    raise exception 'WEEKLY_SOURCE_OPERATIONAL_ACTIVATION_WINDOW_BINDING_CHANGED' using errcode='40001'; end if;
  -- Before activation/recording the ENTIRE exact saved row is still disabled.
  -- After activation the normal native receipt, request/CAS and admin guards
  -- remain the capability reader's authority; this is never a new toggle.
  if not a.feature_enabled and (a.version::text is distinct from p_binding->>'assignment_version'
    or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_ASSIGNMENT_V1',to_jsonb(a)),'hex')
      is distinct from p_binding->>'assignment_sha256') then
    raise exception 'WEEKLY_SOURCE_OPERATIONAL_ACTIVATION_WINDOW_BINDING_CHANGED' using errcode='40001'; end if;
  if a.feature_enabled and (a.feature_purpose is distinct from p_binding->>'feature_purpose'
    or a.feature_receipt_json#>'{protected_capability_qualification,activation_scope}' is distinct from p_binding) then
    raise exception 'WEEKLY_SOURCE_OPERATIONAL_ACTIVATION_WINDOW_BINDING_CHANGED' using errcode='40001'; end if;
  select audit.after_json,audit.object_type='weekly_source_off_rule_test_journey' into strict lease,off_lease
    from public.audit_events audit where audit.object_id_text=p_closure->>'scope_id' and audit.event_sequence_is_authoritative
      and ((audit.object_type='weekly_source_off_rule_test_journey' and audit.action='WEEKLY_SOURCE_OFF_RULE_TEST_OPENED')
        or (audit.object_type='weekly_source_protected_test_journey' and audit.action='WEEKLY_SOURCE_TEST_JOURNEY_OPENED'))
      and audit.after_json->>'scope_sha256'=p_closure->>'scope_sha256';
  if p_binding->>'feature_purpose'='PROTECTED_SOURCE' then
    if a.rule_set_version_id is not null or p_binding->'rule_values_sha256' is distinct from 'null'::jsonb
      or p_binding->'fixture_rule_set_version_id' is distinct from 'null'::jsonb
      or p_binding->'fixture_rule_values_sha256' is distinct from 'null'::jsonb
      or p_native->'capabilities' @> '["AUTOMATIC_RECONCILE"]'::jsonb or off_lease then
      raise exception 'WEEKLY_SOURCE_OPERATIONAL_ACTIVATION_WINDOW_BINDING_INVALID' using errcode='55000'; end if;
  else
    select * into strict v from public.weekly_source_rule_set_versions where id=a.rule_set_version_id;
    if not off_lease or lease->>'purpose' is distinct from 'AUTOMATIC_JOURNEY'
      or lease->>'rule_set_version_id' is distinct from v.id::text
      or p_binding->>'fixture_rule_set_version_id' is distinct from v.id::text
      or p_binding->>'fixture_rule_values_sha256' is distinct from v.values_sha256
      or p_binding->>'rule_values_sha256' is distinct from v.values_sha256
      or v.values_json->>'invoice_sender' is distinct from 'CLIENT_SELF_BILL' then
      raise exception 'WEEKLY_SOURCE_OPERATIONAL_ACTIVATION_WINDOW_BINDING_INVALID' using errcode='55000'; end if;
    perform private._weekly_source_rule_group_context_v1(p_group,p_from,p_to,v.values_json,true);
  end if;
exception when no_data_found or too_many_rows or invalid_text_representation or datetime_field_overflow or invalid_datetime_format then
  raise exception 'WEEKLY_SOURCE_OPERATIONAL_ACTIVATION_WINDOW_BINDING_INVALID' using errcode='55000';
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/FINAL_OPERATIONAL_CERTIFICATE.sqlinc; raw SHA256 9ba9d59f3168492d53cf38c003e5a7cca117aa627edcbfe211061a0d628e8c2f
-- All operational callers use this full certificate. V1-native-only and V2
-- prerequisite certificates cannot enter activation, receipt or readiness.
create or replace function private.weekly_source_protected_operational_certificate_assert_v1(
  p_q jsonb,p_group_id uuid,p_from date,p_to date,p_expected_sha256 text
) returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare q jsonb:=p_q; g public.weekly_source_groups%rowtype; r private.cloudtms_database_releases%rowtype;
  executed private.cloudtms_database_releases%rowtype; native jsonb; row_value jsonb; closure jsonb;
  needed text[]; keys text[]; remote_needed text[]:=array['CLIENT_HTTP','OFFICE_UI','MYTMS_PHONE']; origin text; n integer;
begin
  select * into strict g from public.weekly_source_groups where id=p_group_id and active and source_family='ROSTER' and environment='TEST';
  select * into strict r from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1;
  if current_database()<>'cloudtms_test_clone' or r.status<>'VERIFIED' or r.completed_at_utc is null
    or r.installed_contract_sha256 is distinct from r.repository_contract_sha256
    or r.evidence_json#>>'{managed_release,environment}' is distinct from 'TEST'
    or r.evidence_json#>>'{managed_release,expected_database}' is distinct from current_database()
    or not private.weekly_source_qualification_closed_object_v1(q,array['schema_version','phase','release_id','git_commit','contract_sha256',
      'agency_id','environment','source_group_id','effective_from_week_ending','effective_to_week_ending','capabilities',
      'native_execution_qualification','remote_gate_receipts','test_setup_closure','source_equivalence','activation_scope','receipt_input_commit','qualification_sha256'])
    or q->>'schema_version' is distinct from 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_OPERATIONAL_QUALIFICATION_V1'
    or q->>'phase' is distinct from 'ALL_PRE_SWITCH_GATES_QUALIFIED'
    or q->>'release_id' is distinct from r.release_id or q->>'git_commit' is distinct from r.git_commit
    or q->>'contract_sha256' is distinct from r.installed_contract_sha256 or q->>'agency_id' is distinct from g.agency_id::text
    or q->>'source_group_id' is distinct from g.id::text or q->>'environment' is distinct from g.environment
    or q->>'effective_from_week_ending' is distinct from p_from::text or q->>'effective_to_week_ending' is distinct from p_to::text
    or coalesce(p_expected_sha256,'') !~ '^[0-9a-f]{64}$' or q->>'qualification_sha256' is distinct from p_expected_sha256
    or q->>'qualification_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PROTECTED_CAPABILITY_OPERATIONAL_QUALIFICATION_V1',q-'qualification_sha256'),'hex')
    or q->'capabilities' not in ('["BULK_SIGNED"]'::jsonb,'["AUTOMATIC_RECONCILE","BULK_SIGNED"]'::jsonb) then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  native:=q->'native_execution_qualification';closure:=q->'test_setup_closure';
  select * into strict executed from private.cloudtms_database_releases where release_id=native->>'release_id';
  if executed.status<>'VERIFIED' or executed.completed_at_utc is null
    or executed.git_commit is distinct from native->>'git_commit'
    or executed.installed_contract_sha256 is distinct from executed.repository_contract_sha256
    or executed.installed_contract_sha256 is distinct from r.installed_contract_sha256
    or executed.evidence_json#>>'{weekly_source_protected_qualification_catalogue,jsonb_sha256}'
      is distinct from r.evidence_json#>>'{weekly_source_protected_qualification_catalogue,jsonb_sha256}'
    or private.weekly_source_protected_qualification_release_v1()->>'release_id' is distinct from r.release_id
    or not private.weekly_source_qualification_closed_object_v1(native,array['schema_version','release_id','git_commit','contract_sha256','agency_id','environment',
      'source_group_id','effective_from_week_ending','effective_to_week_ending','capabilities','gate_receipts','qualification_sha256'])
    or native->>'schema_version' is distinct from 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_QUALIFICATION_V1'
    or native->>'contract_sha256' is distinct from r.installed_contract_sha256
    or native->>'agency_id' is distinct from g.agency_id::text or native->>'source_group_id' is distinct from g.id::text
    or native->>'environment' is distinct from 'TEST' or native->>'effective_from_week_ending' is distinct from q#>>'{activation_scope,native_effective_from_week_ending}'
    or native->>'effective_to_week_ending' is distinct from q#>>'{activation_scope,native_effective_to_week_ending}' or native->'capabilities' is distinct from q->'capabilities'
    or native->>'qualification_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PROTECTED_CAPABILITY_QUALIFICATION_V1',native-'qualification_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  needed:=array['SOURCE_CAS_NATIVE','NATIVE_PROTECTION','SECURITY','LEGACY_PAY','NEXT_PAY','CLIENT_API','DOCUMENT','OWN_STAGE_CAS','SOURCE_ROUTING'];
  if q->'capabilities' @> '["AUTOMATIC_RECONCILE"]'::jsonb then needed:=array_append(needed,'AUTOMATIC_COMPONENT_DELTA'); end if;
  if jsonb_typeof(native->'gate_receipts') is distinct from 'array' or jsonb_array_length(native->'gate_receipts')<>cardinality(needed)
    or (select count(distinct value->>'gate') from jsonb_array_elements(native->'gate_receipts') value)<>cardinality(needed) then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  for row_value in select value from jsonb_array_elements(native->'gate_receipts') value loop
    if not private.weekly_source_qualification_closed_object_v1(row_value,array['gate','status','execution','database','receipt_id','receipt_sha256',
        'source_commit','contract_sha256','source_group_id','agency_id','environment'])
      or not(coalesce(row_value->>'gate','')=any(needed)) or row_value->>'status' is distinct from 'PASS'
      or row_value->>'execution' is distinct from 'AGENCY_TEST_NATIVE' or row_value->>'database' is distinct from current_database()
      or row_value->>'source_commit' is distinct from executed.git_commit or row_value->>'contract_sha256' is distinct from executed.installed_contract_sha256
      or row_value->>'source_group_id' is distinct from g.id::text or row_value->>'agency_id' is distinct from g.agency_id::text
      or row_value->>'environment' is distinct from 'TEST' or nullif(row_value->>'receipt_id','') is null
      or coalesce(row_value->>'receipt_sha256','') !~ '^[0-9a-f]{64}$' then
      raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  end loop;
  if not private.weekly_source_qualification_closed_object_v1(closure,array['scope_id','scope_sha256','setup_authorization_sha256',
      'original_census_sha256','actor_user_id','source_cycle_id','week_ending','execution_release_id','execution_source_commit',
      'execution_contract_sha256','closure_audit_id','closure_audit_sha256','state','closed_at_utc','all_assignments_disabled','all_operational_producers_false'])
    or exists(select 1 from unnest(array['scope_id','actor_user_id','source_cycle_id','closure_audit_id']) k
      where coalesce(closure->>k,'') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
    or exists(select 1 from unnest(array['scope_sha256','setup_authorization_sha256','original_census_sha256','closure_audit_sha256']) k
      where coalesce(closure->>k,'') !~ '^[0-9a-f]{64}$')
    or coalesce(closure->>'week_ending','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
    or coalesce(closure->>'closed_at_utc','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$'
    or closure->>'state' is distinct from 'CLOSED' or closure->'all_assignments_disabled' is distinct from 'true'::jsonb
    or closure->'all_operational_producers_false' is distinct from 'true'::jsonb
    or closure->>'execution_release_id' is distinct from executed.release_id
    or closure->>'execution_source_commit' is distinct from executed.git_commit
    or closure->>'execution_contract_sha256' is distinct from executed.installed_contract_sha256
    or (closure->>'week_ending')::date<(native->>'effective_from_week_ending')::date
    or (native->>'effective_to_week_ending' is not null and (closure->>'week_ending')::date>(native->>'effective_to_week_ending')::date)
    or not exists(select 1 from public.audit_events a where a.id=(closure->>'closure_audit_id')::uuid
      and a.object_id_text=closure->>'scope_id' and a.event_sequence_is_authoritative
      and ((a.object_type='weekly_source_protected_test_journey' and a.action='WEEKLY_SOURCE_TEST_JOURNEY_CLOSED')
        or (a.object_type='weekly_source_off_rule_test_journey' and a.action='WEEKLY_SOURCE_OFF_RULE_TEST_CLOSED'))
      and a.after_json=closure-'closure_audit_id'-'closure_audit_sha256'
      and encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_TEST_JOURNEY_CLOSED_V1',a.after_json),'hex')=closure->>'closure_audit_sha256') then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  if jsonb_typeof(q->'remote_gate_receipts') is distinct from 'array' or jsonb_array_length(q->'remote_gate_receipts')<>3
    or (select count(distinct value->>'gate') from jsonb_array_elements(q->'remote_gate_receipts') value)<>3 then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  for row_value in select value from jsonb_array_elements(q->'remote_gate_receipts') value loop
    origin:=case row_value->>'gate' when 'CLIENT_HTTP' then 'AUTHENTICATED_DEPLOYED_HTTP'
      when 'OFFICE_UI' then 'DEPLOYED_OFFICE_BROWSER_UI' when 'MYTMS_PHONE' then 'PHYSICAL_TESTFLIGHT_MYTMS_PHONE' end;
    keys:=case row_value->>'gate'
      when 'CLIENT_HTTP' then array['real_authenticated_session','trusted_actor_injected','closed_browser_payload','native_preview_commit_retry',
        'native_source_cas_error_order','foreign_actor_and_scope_refused','operational_readiness_false']
      when 'OFFICE_UI' then array['actual_deployed_bundle','deep_link_scope','actual_preview_and_confirmation','native_partial_retry_display',
        'unauthorised_controls_absent','operational_readiness_false']
      when 'MYTMS_PHONE' then array['actual_installed_test_build','actual_candidate_authenticated_session','genuine_signed_submission_bytes',
        'native_signature_authority','actual_approved_hours_display','actual_document_bytes_and_hash','operational_readiness_false'] end;
    if not private.weekly_source_qualification_closed_object_v1(row_value,array['schema_version','gate','origin','execution_release_id',
        'execution_source_commit','execution_contract_sha256','environment','database','agency_id','source_group_id','source_cycle_id',
        'actor_user_id','week_ending','scope_id','scope_sha256','original_census_sha256','server_request_ids','server_trace_sha256',
        'native_result_receipts_sha256','capture_sha256','deployments','assertions','receipt_id','receipt_sha256'])
      or origin is null or row_value->>'origin' is distinct from origin
      or row_value->>'schema_version' is distinct from 'WEEKLY_SOURCE_PROTECTED_REMOTE_GATE_RECEIPT_V1'
      or row_value->>'execution_release_id' is distinct from executed.release_id or row_value->>'execution_source_commit' is distinct from executed.git_commit
      or row_value->>'execution_contract_sha256' is distinct from executed.installed_contract_sha256
      or row_value->>'source_group_id' is distinct from g.id::text or row_value->>'agency_id' is distinct from g.agency_id::text
      or row_value->>'environment' is distinct from 'TEST' or row_value->>'database' is distinct from current_database()
      or exists(select 1 from unnest(array['source_cycle_id','actor_user_id','week_ending','scope_id','scope_sha256','original_census_sha256']) k
        where row_value->>k is distinct from closure->>k)
      or not private.weekly_source_qualification_closed_object_v1(row_value->'assertions',keys)
      or exists(select 1 from unnest(keys) k where row_value#>array['assertions',k] is distinct from 'true'::jsonb)
      or exists(select 1 from unnest(array['receipt_sha256','server_trace_sha256','native_result_receipts_sha256','capture_sha256']) k
        where coalesce(row_value->>k,'') !~ '^[0-9a-f]{64}$')
      or coalesce(row_value->>'receipt_id','') !~ '^[A-Za-z0-9_./:@-]{1,256}$'
      or jsonb_typeof(row_value->'server_request_ids') is distinct from 'array'
      or jsonb_array_length(row_value->'server_request_ids') not between 1 and 100
      or (select count(distinct value) from jsonb_array_elements(row_value->'server_request_ids') value)
        <>jsonb_array_length(row_value->'server_request_ids')
      or exists(select 1 from jsonb_array_elements(row_value->'server_request_ids') request_id
        where jsonb_typeof(request_id)<>'string' or request_id#>>'{}' !~ '^[A-Za-z0-9:_-]{1,128}$')
      or not private.weekly_source_qualification_closed_object_v1(row_value->'deployments',array['worker_script','worker_version_id',
        'worker_source_commit','office_source_commit','office_bundle_sha256','mytms_source_commit','mytms_build_id',
        'mytms_bundle_identifier','mytms_build_artifact_sha256'])
      or coalesce(row_value#>>'{deployments,worker_version_id}','') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
      or exists(select 1 from unnest(array['office_source_commit','mytms_source_commit']) k
        where coalesce(row_value#>>array['deployments',k],'') !~ '^[0-9a-f]{40}$')
      or exists(select 1 from unnest(array['office_bundle_sha256','mytms_build_artifact_sha256']) k
        where coalesce(row_value#>>array['deployments',k],'') !~ '^[0-9a-f]{64}$')
      or nullif(row_value#>>'{deployments,mytms_build_id}','') is null
      or row_value#>>'{deployments,worker_script}' is distinct from 'test-cloudtms-backend'
      or row_value#>>'{deployments,worker_source_commit}' is distinct from executed.git_commit
      or row_value#>>'{deployments,mytms_bundle_identifier}' is distinct from 'net.cloudtms.mytms.test' then
      raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  end loop;
  if (select count(distinct value->'deployments') from jsonb_array_elements(q->'remote_gate_receipts') value)<>1 then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  if coalesce(q->>'receipt_input_commit','') !~ '^[0-9a-f]{40}$' then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  perform private.weekly_source_activation_window_binding_assert_v1(q->'activation_scope',native,closure,g.id,p_from,p_to);
  -- Installed execution is immutable. Only receipt-input Git data differs.
  perform private.weekly_source_protected_execution_tree_assert_v2(q->'source_equivalence',executed.git_commit,q->>'receipt_input_commit');
  return q;
exception when no_data_found or too_many_rows or invalid_text_representation or datetime_field_overflow then
  raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000';
end;
$function$;

create or replace function private.weekly_source_protected_execution_tree_assert_v2(p_proof jsonb,p_execution_commit text,p_installation_commit text)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare file jsonb;
begin
  -- PostgreSQL cannot read Git objects. This asserts the closed receipt DTO;
  -- the protected managed writer MUST remeasure the literal complete Git tree.
  -- A caller JSON/hash assertion is never source equivalence authority.
  if not private.weekly_source_qualification_closed_object_v1(p_proof,array['schema_version','execution_source_commit','installation_source_commit',
      'inventory_schema','files','receipt_bindings','source_equivalence_sha256'])
    or p_proof->>'schema_version' is distinct from 'WEEKLY_SOURCE_COMMITTED_EXECUTION_TREE_EQUIVALENCE_V2'
    or p_proof->>'inventory_schema' is distinct from 'WEEKLY_SOURCE_NATIVE_RELEASE_TOOLCHAIN_VERIFIER_INVENTORY_V2'
    or p_proof->>'execution_source_commit' is distinct from p_execution_commit
    or p_proof->>'installation_source_commit' is distinct from p_installation_commit
    or p_proof->>'source_equivalence_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_COMMITTED_EXECUTION_TREE_EQUIVALENCE_V2',p_proof-'source_equivalence_sha256'),'hex')
    or jsonb_typeof(p_proof->'files') is distinct from 'array' or jsonb_array_length(p_proof->'files')=0
    or jsonb_typeof(p_proof->'receipt_bindings') is distinct from 'array'
    or (select count(distinct value->>'path') from jsonb_array_elements(p_proof->'files') value)<>jsonb_array_length(p_proof->'files')
    or exists(select 1 from unnest(array['.node-version','.gitattributes','osv-scanner.toml','.github/workflows/database-release.yml','supabase/release/export_contract.sql',
      'supabase/release/current-release.json','supabase/release/current-contract.json','scripts/cloudtms-db-release.mjs']) required_path
      where not exists(select 1 from jsonb_array_elements(p_proof->'files') item where item->>'path'=required_path)) then
    raise exception 'WEEKLY_SOURCE_PROTECTED_EXECUTION_TREE_CHANGED' using errcode='55000'; end if;
  for file in select value from jsonb_array_elements(p_proof->'files') value loop
    if not private.weekly_source_qualification_closed_object_v1(file,array['path','git_mode','git_type','execution_blob_oid','installation_blob_oid',
        'execution_sha256','installation_sha256','comparison','comparison_sha256'])
      or nullif(file->>'path','') is null or file->>'git_mode' not in ('100644','100755') or file->>'git_type' is distinct from 'blob'
      or exists(select 1 from unnest(array['execution_sha256','installation_sha256','comparison_sha256']) k
        where coalesce(file->>k,'') !~ '^[0-9a-f]{64}$')
      or exists(select 1 from unnest(array['execution_blob_oid','installation_blob_oid']) k where coalesce(file->>k,'') !~ '^[0-9a-f]{40}$')
      or (file->>'path'<>'supabase/release/current-release.json' and
        (file->>'comparison' is distinct from 'EXACT_GIT_OBJECT' or file->>'execution_blob_oid' is distinct from file->>'installation_blob_oid'
          or file->>'execution_sha256' is distinct from file->>'installation_sha256'))
      or (file->>'path'='supabase/release/current-release.json'
        and file->>'comparison' is distinct from 'RELEASE_AUTHORITY_EXCEPT_CLOSED_RECEIPT_DESCRIPTORS') then
      raise exception 'WEEKLY_SOURCE_PROTECTED_EXECUTION_TREE_CHANGED' using errcode='55000'; end if;
  end loop;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/ACTIVATION_PROBE_AUTHORIZATION_ASSERT.sqlinc; raw SHA256 9a4698490f95584ed2e94ea58e1a6a9312c52b3a55f3109f067e9e3be3ba88b9
-- All operational callers use this full certificate. V1-native-only and V2
-- prerequisite certificates cannot enter activation, receipt or readiness.
create or replace function private.weekly_source_protected_activation_probe_authorization_assert_v1(
  p_q jsonb,p_group_id uuid,p_from date,p_to date,p_expected_sha256 text
) returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare q jsonb:=p_q; g public.weekly_source_groups%rowtype; r private.cloudtms_database_releases%rowtype;
  executed private.cloudtms_database_releases%rowtype; native jsonb; row_value jsonb; closure jsonb;
  needed text[]; keys text[]; remote_needed text[]:=array['CLIENT_HTTP','OFFICE_UI','MYTMS_PHONE']; origin text; n integer;
begin
  select * into strict g from public.weekly_source_groups where id=p_group_id and active and source_family='ROSTER' and environment='TEST';
  select * into strict r from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1;
  if current_database()<>'cloudtms_test_clone' or r.status<>'VERIFIED' or r.completed_at_utc is null
    or r.installed_contract_sha256 is distinct from r.repository_contract_sha256
    or r.evidence_json#>>'{managed_release,environment}' is distinct from 'TEST'
    or r.evidence_json#>>'{managed_release,expected_database}' is distinct from current_database()
    or not private.weekly_source_qualification_closed_object_v1(q,array['schema_version','phase','release_id','git_commit','contract_sha256',
      'agency_id','environment','source_group_id','effective_from_week_ending','effective_to_week_ending','capabilities',
      'native_execution_qualification','remote_gate_receipts','test_setup_closure','source_equivalence','assignment_scope','operational_ready','probe_authorization_sha256'])
    or q->>'schema_version' is distinct from 'WEEKLY_SOURCE_ACTIVATION_PROBE_AUTHORIZATION_V1'
    or q->>'phase' is distinct from 'ALL_OTHER_GATES_QUALIFIED_SECURITY_ACTIVATION_PROBE_ONLY'
    or q->'operational_ready' is distinct from 'false'::jsonb
    or q->>'release_id' is distinct from r.release_id or q->>'git_commit' is distinct from r.git_commit
    or q->>'contract_sha256' is distinct from r.installed_contract_sha256 or q->>'agency_id' is distinct from g.agency_id::text
    or q->>'source_group_id' is distinct from g.id::text or q->>'environment' is distinct from g.environment
    or q->>'effective_from_week_ending' is distinct from p_from::text or q->>'effective_to_week_ending' is distinct from p_to::text
    or coalesce(p_expected_sha256,'') !~ '^[0-9a-f]{64}$' or q->>'probe_authorization_sha256' is distinct from p_expected_sha256
    or q->>'probe_authorization_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_ACTIVATION_PROBE_AUTHORIZATION_V1',q-'probe_authorization_sha256'),'hex')
    or q->'capabilities' not in ('["BULK_SIGNED"]'::jsonb,'["AUTOMATIC_RECONCILE","BULK_SIGNED"]'::jsonb) then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  native:=q->'native_execution_qualification';closure:=q->'test_setup_closure';
  select * into strict executed from private.cloudtms_database_releases where release_id=native->>'release_id';
  if executed.status<>'VERIFIED' or executed.completed_at_utc is null
    or executed.git_commit is distinct from native->>'git_commit'
    or executed.installed_contract_sha256 is distinct from executed.repository_contract_sha256
    or executed.installed_contract_sha256 is distinct from r.installed_contract_sha256
    or executed.evidence_json#>>'{weekly_source_protected_qualification_catalogue,jsonb_sha256}'
      is distinct from r.evidence_json#>>'{weekly_source_protected_qualification_catalogue,jsonb_sha256}'
    or private.weekly_source_protected_qualification_release_v1()->>'release_id' is distinct from r.release_id
    or not private.weekly_source_qualification_closed_object_v1(native,array['schema_version','release_id','git_commit','contract_sha256','agency_id','environment',
      'source_group_id','effective_from_week_ending','effective_to_week_ending','capabilities','gate_receipts','negative_security_receipt','other_gates_sha256'])
    or native->>'schema_version' is distinct from 'WEEKLY_SOURCE_ACTIVATION_PROBE_NATIVE_OTHER_GATES_V1'
    or native->>'contract_sha256' is distinct from r.installed_contract_sha256
    or native->>'agency_id' is distinct from g.agency_id::text or native->>'source_group_id' is distinct from g.id::text
    or native->>'environment' is distinct from 'TEST' or native->>'effective_from_week_ending' is distinct from q#>>'{assignment_scope,native_effective_from_week_ending}'
    or native->>'effective_to_week_ending' is distinct from q#>>'{assignment_scope,native_effective_to_week_ending}' or native->'capabilities' is distinct from q->'capabilities'
    or native->>'other_gates_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_ACTIVATION_PROBE_NATIVE_OTHER_GATES_V1',native-'other_gates_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  row_value:=native->'negative_security_receipt';
  if not private.weekly_source_qualification_closed_object_v1(row_value,array['gate','status','execution','database','receipt_id','receipt_sha256',
    'source_commit','contract_sha256','source_group_id','agency_id','environment'])
    or row_value->>'gate' is distinct from 'SECURITY_NEGATIVES' or row_value->>'status' is distinct from 'NEGATIVE_PASS'
    or row_value->>'execution' is distinct from 'AGENCY_TEST_NATIVE' or row_value->>'database' is distinct from current_database()
    or row_value->>'source_commit' is distinct from executed.git_commit or row_value->>'contract_sha256' is distinct from executed.installed_contract_sha256
    or row_value->>'source_group_id' is distinct from g.id::text or row_value->>'agency_id' is distinct from g.agency_id::text
    or row_value->>'environment' is distinct from 'TEST' or coalesce(row_value->>'receipt_id','') !~ '^[A-Za-z0-9_./:@-]{1,256}$'
    or coalesce(row_value->>'receipt_sha256','') !~ '^[0-9a-f]{64}$' then
    raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_OTHER_GATES_REQUIRED' using errcode='55000'; end if;
  needed:=array['SOURCE_CAS_NATIVE','NATIVE_PROTECTION','LEGACY_PAY','NEXT_PAY','CLIENT_API','DOCUMENT','OWN_STAGE_CAS','SOURCE_ROUTING'];
  if q->'capabilities' @> '["AUTOMATIC_RECONCILE"]'::jsonb then needed:=array_append(needed,'AUTOMATIC_COMPONENT_DELTA'); end if;
  if jsonb_typeof(native->'gate_receipts') is distinct from 'array' or jsonb_array_length(native->'gate_receipts')<>cardinality(needed)
    or (select count(distinct value->>'gate') from jsonb_array_elements(native->'gate_receipts') value)<>cardinality(needed) then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  for row_value in select value from jsonb_array_elements(native->'gate_receipts') value loop
    if not private.weekly_source_qualification_closed_object_v1(row_value,array['gate','status','execution','database','receipt_id','receipt_sha256',
        'source_commit','contract_sha256','source_group_id','agency_id','environment'])
      or not(coalesce(row_value->>'gate','')=any(needed)) or row_value->>'status' is distinct from 'PASS'
      or row_value->>'execution' is distinct from 'AGENCY_TEST_NATIVE' or row_value->>'database' is distinct from current_database()
      or row_value->>'source_commit' is distinct from executed.git_commit or row_value->>'contract_sha256' is distinct from executed.installed_contract_sha256
      or row_value->>'source_group_id' is distinct from g.id::text or row_value->>'agency_id' is distinct from g.agency_id::text
      or row_value->>'environment' is distinct from 'TEST' or nullif(row_value->>'receipt_id','') is null
      or coalesce(row_value->>'receipt_sha256','') !~ '^[0-9a-f]{64}$' then
      raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  end loop;
  if not private.weekly_source_qualification_closed_object_v1(closure,array['scope_id','scope_sha256','setup_authorization_sha256',
      'original_census_sha256','actor_user_id','source_cycle_id','week_ending','execution_release_id','execution_source_commit',
      'execution_contract_sha256','closure_audit_id','closure_audit_sha256','state','closed_at_utc','all_assignments_disabled','all_operational_producers_false'])
    or exists(select 1 from unnest(array['scope_id','actor_user_id','source_cycle_id','closure_audit_id']) k
      where coalesce(closure->>k,'') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
    or exists(select 1 from unnest(array['scope_sha256','setup_authorization_sha256','original_census_sha256','closure_audit_sha256']) k
      where coalesce(closure->>k,'') !~ '^[0-9a-f]{64}$')
    or coalesce(closure->>'week_ending','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
    or coalesce(closure->>'closed_at_utc','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$'
    or closure->>'state' is distinct from 'CLOSED' or closure->'all_assignments_disabled' is distinct from 'true'::jsonb
    or closure->'all_operational_producers_false' is distinct from 'true'::jsonb
    or closure->>'execution_release_id' is distinct from executed.release_id
    or closure->>'execution_source_commit' is distinct from executed.git_commit
    or closure->>'execution_contract_sha256' is distinct from executed.installed_contract_sha256
    or (closure->>'week_ending')::date<(native->>'effective_from_week_ending')::date
    or (native->>'effective_to_week_ending' is not null and (closure->>'week_ending')::date>(native->>'effective_to_week_ending')::date)
    or not exists(select 1 from public.audit_events a where a.id=(closure->>'closure_audit_id')::uuid
      and a.object_id_text=closure->>'scope_id' and a.event_sequence_is_authoritative
      and ((a.object_type='weekly_source_protected_test_journey' and a.action='WEEKLY_SOURCE_TEST_JOURNEY_CLOSED')
        or (a.object_type='weekly_source_off_rule_test_journey' and a.action='WEEKLY_SOURCE_OFF_RULE_TEST_CLOSED'))
      and a.after_json=closure-'closure_audit_id'-'closure_audit_sha256'
      and encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_TEST_JOURNEY_CLOSED_V1',a.after_json),'hex')=closure->>'closure_audit_sha256') then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  if jsonb_typeof(q->'remote_gate_receipts') is distinct from 'array' or jsonb_array_length(q->'remote_gate_receipts')<>3
    or (select count(distinct value->>'gate') from jsonb_array_elements(q->'remote_gate_receipts') value)<>3 then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  for row_value in select value from jsonb_array_elements(q->'remote_gate_receipts') value loop
    origin:=case row_value->>'gate' when 'CLIENT_HTTP' then 'AUTHENTICATED_DEPLOYED_HTTP'
      when 'OFFICE_UI' then 'DEPLOYED_OFFICE_BROWSER_UI' when 'MYTMS_PHONE' then 'PHYSICAL_TESTFLIGHT_MYTMS_PHONE' end;
    keys:=case row_value->>'gate'
      when 'CLIENT_HTTP' then array['real_authenticated_session','trusted_actor_injected','closed_browser_payload','native_preview_commit_retry',
        'native_source_cas_error_order','foreign_actor_and_scope_refused','operational_readiness_false']
      when 'OFFICE_UI' then array['actual_deployed_bundle','deep_link_scope','actual_preview_and_confirmation','native_partial_retry_display',
        'unauthorised_controls_absent','operational_readiness_false']
      when 'MYTMS_PHONE' then array['actual_installed_test_build','actual_candidate_authenticated_session','genuine_signed_submission_bytes',
        'native_signature_authority','actual_approved_hours_display','actual_document_bytes_and_hash','operational_readiness_false'] end;
    if not private.weekly_source_qualification_closed_object_v1(row_value,array['schema_version','gate','origin','execution_release_id',
        'execution_source_commit','execution_contract_sha256','environment','database','agency_id','source_group_id','source_cycle_id',
        'actor_user_id','week_ending','scope_id','scope_sha256','original_census_sha256','server_request_ids','server_trace_sha256',
        'native_result_receipts_sha256','capture_sha256','deployments','assertions','receipt_id','receipt_sha256'])
      or origin is null or row_value->>'origin' is distinct from origin
      or row_value->>'schema_version' is distinct from 'WEEKLY_SOURCE_PROTECTED_REMOTE_GATE_RECEIPT_V1'
      or row_value->>'execution_release_id' is distinct from executed.release_id or row_value->>'execution_source_commit' is distinct from executed.git_commit
      or row_value->>'execution_contract_sha256' is distinct from executed.installed_contract_sha256
      or row_value->>'source_group_id' is distinct from g.id::text or row_value->>'agency_id' is distinct from g.agency_id::text
      or row_value->>'environment' is distinct from 'TEST' or row_value->>'database' is distinct from current_database()
      or exists(select 1 from unnest(array['source_cycle_id','actor_user_id','week_ending','scope_id','scope_sha256','original_census_sha256']) k
        where row_value->>k is distinct from closure->>k)
      or not private.weekly_source_qualification_closed_object_v1(row_value->'assertions',keys)
      or exists(select 1 from unnest(keys) k where row_value#>array['assertions',k] is distinct from 'true'::jsonb)
      or exists(select 1 from unnest(array['receipt_sha256','server_trace_sha256','native_result_receipts_sha256','capture_sha256']) k
        where coalesce(row_value->>k,'') !~ '^[0-9a-f]{64}$')
      or coalesce(row_value->>'receipt_id','') !~ '^[A-Za-z0-9_./:@-]{1,256}$'
      or jsonb_typeof(row_value->'server_request_ids') is distinct from 'array'
      or jsonb_array_length(row_value->'server_request_ids') not between 1 and 100
      or (select count(distinct value) from jsonb_array_elements(row_value->'server_request_ids') value)
        <>jsonb_array_length(row_value->'server_request_ids')
      or exists(select 1 from jsonb_array_elements(row_value->'server_request_ids') request_id
        where jsonb_typeof(request_id)<>'string' or request_id#>>'{}' !~ '^[A-Za-z0-9:_-]{1,128}$')
      or not private.weekly_source_qualification_closed_object_v1(row_value->'deployments',array['worker_script','worker_version_id',
        'worker_source_commit','office_source_commit','office_bundle_sha256','mytms_source_commit','mytms_build_id',
        'mytms_bundle_identifier','mytms_build_artifact_sha256'])
      or coalesce(row_value#>>'{deployments,worker_version_id}','') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
      or exists(select 1 from unnest(array['office_source_commit','mytms_source_commit']) k
        where coalesce(row_value#>>array['deployments',k],'') !~ '^[0-9a-f]{40}$')
      or exists(select 1 from unnest(array['office_bundle_sha256','mytms_build_artifact_sha256']) k
        where coalesce(row_value#>>array['deployments',k],'') !~ '^[0-9a-f]{64}$')
      or nullif(row_value#>>'{deployments,mytms_build_id}','') is null
      or row_value#>>'{deployments,worker_script}' is distinct from 'test-cloudtms-backend'
      or row_value#>>'{deployments,worker_source_commit}' is distinct from executed.git_commit
      or row_value#>>'{deployments,mytms_bundle_identifier}' is distinct from 'net.cloudtms.mytms.test' then
      raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  end loop;
  if (select count(distinct value->'deployments') from jsonb_array_elements(q->'remote_gate_receipts') value)<>1 then
    raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000'; end if;
  if not private.weekly_source_qualification_closed_object_v1(q->'assignment_scope',array['scope_id','scope_sha256','original_census_sha256',
    'setup_actor_user_id','assignment_id','expected_assignment_version','expected_assignment_sha256','source_group_id','effective_from_week_ending',
    'effective_to_week_ending','rule_set_version_id','native_effective_from_week_ending','native_effective_to_week_ending'])
    or exists(select 1 from unnest(array['scope_id','setup_actor_user_id','assignment_id','source_group_id']) key
      where coalesce(q#>>array['assignment_scope',key],'') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
    or exists(select 1 from unnest(array['scope_sha256','original_census_sha256','expected_assignment_sha256']) key
      where coalesce(q#>>array['assignment_scope',key],'') !~ '^[0-9a-f]{64}$')
    or coalesce(q#>>'{assignment_scope,expected_assignment_version}','') !~ '^[1-9][0-9]*$'
    or exists(select 1 from unnest(array['effective_from_week_ending','native_effective_from_week_ending']) key
      where coalesce(q#>>array['assignment_scope',key],'') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        or extract(dow from (q#>>array['assignment_scope',key])::date)<>0)
    or exists(select 1 from unnest(array['effective_to_week_ending','native_effective_to_week_ending']) key
      where q#>array['assignment_scope',key]<>'null'::jsonb and
        (coalesce(q#>>array['assignment_scope',key],'') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
          or extract(dow from (q#>>array['assignment_scope',key])::date)<>0))
    or q#>'{assignment_scope,rule_set_version_id}' is distinct from 'null'::jsonb
    or q#>>'{assignment_scope,source_group_id}' is distinct from g.id::text
    or q#>>'{assignment_scope,effective_from_week_ending}' is distinct from p_from::text
    or q#>>'{assignment_scope,effective_to_week_ending}' is distinct from p_to::text
    or q#>>'{assignment_scope,original_census_sha256}' is distinct from closure->>'original_census_sha256'
    or p_from<(native->>'effective_from_week_ending')::date then
    raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_ASSIGNMENT_INVALID' using errcode='55000'; end if;
  perform private.weekly_source_protected_execution_tree_assert_v2(q->'source_equivalence',executed.git_commit,r.git_commit);
  return q;
exception when no_data_found or too_many_rows or invalid_text_representation or datetime_field_overflow then
  raise exception 'WEEKLY_SOURCE_PROTECTED_OPERATIONAL_GATES_REQUIRED' using errcode='55000';
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/ACTIVATION_PROBE_SCOPE.sqlinc; raw SHA256 03e72b4f50fe5716f5baf206e4979a799da161f365a5b8338792308c5b408bf6
create or replace function private.weekly_source_protected_activation_probe_begin_v1(p_request jsonb)
returns jsonb language plpgsql volatile security invoker set search_path to 'pg_catalog','pg_temp'
as $function$
declare r private.cloudtms_database_releases%rowtype; auth jsonb; scope jsonb; assignment public.weekly_source_group_rule_assignments%rowtype;
  actor uuid; n integer; clients uuid[]; old_auth jsonb; original_census jsonb; original_lease jsonb;
begin
  perform private.weekly_source_protected_qualification_owner_v1();
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['scope_id','actor_user_id','probe_authorization_sha256','turn_backend_pid'])
    or coalesce(p_request->>'probe_authorization_sha256','') !~ '^[0-9a-f]{64}$'
    or coalesce(p_request->>'turn_backend_pid','') !~ '^[1-9][0-9]*$' then
    raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_REQUEST_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid;
  perform private._weekly_source_settings_require_admin_v1(actor);
  if not exists(select 1 from pg_locks lock_row where lock_row.locktype='advisory' and lock_row.granted and lock_row.mode='ExclusiveLock'
    and lock_row.database=(select oid from pg_database where datname=current_database())
    and lock_row.classid=20261013::oid and lock_row.objid=1::oid and lock_row.objsubid=2
    and lock_row.pid=(p_request->>'turn_backend_pid')::integer and lock_row.pid<>pg_backend_pid()) then
    raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_OWNED_TURN_REQUIRED' using errcode='55000'; end if;
  select * into strict r from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1;
  select count(*),jsonb_agg(value)->0 into n,auth from jsonb_array_elements(r.evidence_json->'weekly_source_protected_activation_probe_authorizations') value
    where value->>'probe_authorization_sha256'=p_request->>'probe_authorization_sha256';
  if n<>1 then raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_AUTHORIZATION_REQUIRED' using errcode='55000'; end if;
  perform private.weekly_source_protected_activation_probe_authorization_assert_v1(auth,(auth->>'source_group_id')::uuid,
    (auth->>'effective_from_week_ending')::date,(auth->>'effective_to_week_ending')::date,auth->>'probe_authorization_sha256');
  select * into strict assignment from public.weekly_source_group_rule_assignments where id=(auth#>>'{assignment_scope,assignment_id}')::uuid;
  if assignment.feature_enabled or assignment.rule_set_version_id is not null or assignment.source_group_id::text is distinct from auth->>'source_group_id'
    or assignment.effective_from_week_ending::text is distinct from auth->>'effective_from_week_ending'
    or assignment.effective_to_week_ending::text is distinct from auth->>'effective_to_week_ending'
    or assignment.version::text is distinct from auth#>>'{assignment_scope,expected_assignment_version}'
    or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_ASSIGNMENT_V1',to_jsonb(assignment)),'hex')
      is distinct from auth#>>'{assignment_scope,expected_assignment_sha256}'
    or actor::text is distinct from auth#>>'{assignment_scope,setup_actor_user_id}' then
    raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_ASSIGNMENT_CHANGED' using errcode='40001'; end if;
  -- Recover the exact original, CLOSED Client/root census from its genuine
  -- installed authorization; never recollect only remaining OPEN incidents.
  select value into strict old_auth from private.cloudtms_database_releases historical,
    lateral jsonb_array_elements(historical.evidence_json->'weekly_source_protected_test_setup_authorizations') value
    where historical.release_id=auth#>>'{test_setup_closure,execution_release_id}'
      and value->>'scope_id'=auth#>>'{test_setup_closure,scope_id}'
      and value->>'authorization_sha256'=auth#>>'{test_setup_closure,setup_authorization_sha256}';
  -- OFF_CLOSED_ORIGINAL_CENSUS_BRIDGE. The new independent-session path
  -- retains the original census in its real OPEN audit. It is not derived
  -- from whatever OPEN incidents remain after native protected rounds.
  if old_auth->>'schema_version'='WEEKLY_SOURCE_OFF_RULE_TEST_AUTHORIZATION_V1' then
    if old_auth->>'purpose' is distinct from 'AUTOMATIC_JOURNEY' then
      raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_ORIGINAL_CENSUS_CHANGED' using errcode='40001'; end if;
    select audit.after_json into strict original_lease from public.audit_events audit
      where audit.object_type='weekly_source_off_rule_test_journey' and audit.object_id_text=old_auth->>'scope_id'
        and audit.action='WEEKLY_SOURCE_OFF_RULE_TEST_OPENED' and audit.event_sequence_is_authoritative
        and audit.after_json->>'authorization_sha256'=old_auth->>'authorization_sha256';
    if original_lease->>'scope_sha256' is distinct from auth#>>'{test_setup_closure,scope_sha256}'
      or original_lease->>'scope_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_OFF_RULE_TEST_SCOPE_V1',original_lease-'scope_sha256'),'hex')
      or not exists(select 1 from public.audit_events closed where closed.id=(auth#>>'{test_setup_closure,closure_audit_id}')::uuid
        and closed.object_type='weekly_source_off_rule_test_journey' and closed.object_id_text=old_auth->>'scope_id'
        and closed.action='WEEKLY_SOURCE_OFF_RULE_TEST_CLOSED' and closed.event_sequence_is_authoritative
        and closed.after_json=auth->'test_setup_closure'-'closure_audit_id'-'closure_audit_sha256') then
      raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_ORIGINAL_CENSUS_CHANGED' using errcode='40001'; end if;
    original_census:=original_lease->'original_census';
    if original_census->'source_cas' is distinct from old_auth->'original_source_cas' then
      raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_ORIGINAL_CENSUS_CHANGED' using errcode='40001'; end if;
  else original_census:=old_auth->'original_census'; end if;
  if original_census->>'census_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_QUALIFICATION_CENSUS_V1',original_census-'census_sha256'),'hex')
    or original_census->>'source_cycle_id' is distinct from old_auth->>'source_cycle_id'
    or original_census->>'census_sha256' is distinct from auth#>>'{assignment_scope,original_census_sha256}' then
    raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_ORIGINAL_CENSUS_CHANGED' using errcode='40001'; end if;
  select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(original_census->'original_client_ids') value;
  if private.weekly_source_bulk_source_cas_v1((old_auth->>'source_cycle_id')::uuid,clients) is distinct from original_census->'source_cas' then
    raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_ORIGINAL_SOURCE_CHANGED' using errcode='40001'; end if;
  if exists(select 1 from public.audit_events audit where audit.object_type='weekly_source_activation_probe'
    and audit.action='WEEKLY_SOURCE_ACTIVATION_PROBE_ADMITTED' and audit.event_sequence_is_authoritative
    and audit.after_json->>'transaction_id'=pg_current_xact_id()::text and audit.after_json->>'backend_pid'=pg_backend_pid()::text) then
    raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_ALREADY_ADMITTED' using errcode='23505'; end if;
  scope:=jsonb_build_object('schema_version','WEEKLY_SOURCE_ACTIVATION_PROBE_SCOPE_V1','scope_id',(p_request->>'scope_id')::uuid,
    'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid()::text,'turn_backend_pid',p_request->>'turn_backend_pid',
    'current_local_date',(clock_timestamp() at time zone 'Europe/London')::date,'execution',private.weekly_source_protected_qualification_release_v1(),
    'actor_user_id',actor,'assignment_id',assignment.id,'assignment_version',assignment.version,'authorization',auth,
    'original_census',original_census,'original_source_facts',private.weekly_source_bulk_source_facts_v1((old_auth->>'source_cycle_id')::uuid,clients),
    'phase','ACTIVATION_PROBE_ONLY','operational_ready',false);
  scope:=scope||jsonb_build_object('scope_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_ACTIVATION_PROBE_SCOPE_V1',scope),'hex'));
  perform public._audit_insert('weekly_source_activation_probe',scope->>'scope_id','WEEKLY_SOURCE_ACTIVATION_PROBE_ADMITTED',null,scope,
    'Owner transaction-bound activation probe; all other real pre-switch gates retained',actor);
  return scope;
end;
$function$;

create or replace function private.weekly_source_protected_activation_probe_assert_v1(p_scope_id uuid,p_actor uuid,p_group uuid,p_from date,p_to date,p_assignment uuid)
returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare scope jsonb; n integer; stack text; auth jsonb; clients uuid[]; completed jsonb; actual_facts jsonb; target public.weekly_source_group_rule_assignments%rowtype;
begin
  perform private.weekly_source_protected_qualification_owner_v1();
  get diagnostics stack=pg_context;
  if stack !~ 'PL/pgSQL function (private\.)?weekly_source_protected_activation_probe_execute_v1\(uuid,jsonb\)' then
    raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_CALLER_REQUIRED' using errcode='42501'; end if;
  select count(*),jsonb_agg(audit.after_json)->0 into n,scope from public.audit_events audit where audit.object_type='weekly_source_activation_probe'
    and audit.object_id_text=p_scope_id::text and audit.action='WEEKLY_SOURCE_ACTIVATION_PROBE_ADMITTED' and audit.event_sequence_is_authoritative
    and audit.after_json->>'transaction_id'=pg_current_xact_id_if_assigned()::text and audit.after_json->>'backend_pid'=pg_backend_pid()::text;
  auth:=scope->'authorization';
  if n<>1 or scope->>'phase' is distinct from 'ACTIVATION_PROBE_ONLY' or scope->'operational_ready' is distinct from 'false'::jsonb
    or scope->>'actor_user_id' is distinct from p_actor::text or scope->>'assignment_id' is distinct from p_assignment::text
    or auth->>'source_group_id' is distinct from p_group::text or auth->>'effective_from_week_ending' is distinct from p_from::text
    or auth->>'effective_to_week_ending' is distinct from p_to::text
    or scope->>'current_local_date' is distinct from ((clock_timestamp() at time zone 'Europe/London')::date)::text
    or scope->'execution' is distinct from private.weekly_source_protected_qualification_release_v1()
    or scope->>'scope_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_ACTIVATION_PROBE_SCOPE_V1',scope-'scope_sha256'),'hex')
    or not exists(select 1 from pg_locks lock_row where lock_row.locktype='advisory' and lock_row.granted and lock_row.mode='ExclusiveLock'
      and lock_row.database=(select oid from pg_database where datname=current_database())
      and lock_row.classid=20261013::oid and lock_row.objid=1::oid and lock_row.objsubid=2
      and lock_row.pid=(scope->>'turn_backend_pid')::integer and lock_row.pid<>pg_backend_pid()) then
    raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
  perform private._weekly_source_settings_require_admin_v1(p_actor);
  perform private.weekly_source_protected_activation_probe_authorization_assert_v1(auth,p_group,p_from,p_to,auth->>'probe_authorization_sha256');
  select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(scope#>'{original_census,original_client_ids}') value;
  if private.weekly_source_bulk_source_cas_v1((scope#>>'{original_census,source_cycle_id}')::uuid,clients) is distinct from scope#>'{original_census,source_cas}' then
    -- Exact native own-probe replay only: reverse the one actual configuration
    -- row in memory, then compare the ENTIRE original Source facts. No Client,
    -- root/nullable identity, binding, receipt or other category is omitted.
    select audit.after_json into strict completed from public.audit_events audit where audit.object_type='weekly_source_activation_probe'
      and audit.object_id_text=p_scope_id::text and audit.action='WEEKLY_SOURCE_ACTIVATION_PROBE_COMPLETED' and audit.event_sequence_is_authoritative
      and audit.after_json->>'transaction_id'=pg_current_xact_id_if_assigned()::text and audit.after_json->>'backend_pid'=pg_backend_pid()::text;
    select * into strict target from public.weekly_source_group_rule_assignments where id=p_assignment;
    if completed->>'scope_sha256' is distinct from scope->>'scope_sha256' or completed->'native_result' is distinct from target.feature_receipt_json
      or completed->>'assignment_after_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_ASSIGNMENT_V1',to_jsonb(target)),'hex') then
      raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_ORIGINAL_SOURCE_CHANGED' using errcode='40001'; end if;
    actual_facts:=private.weekly_source_bulk_source_facts_v1((scope#>>'{original_census,source_cycle_id}')::uuid,clients);
    actual_facts:=jsonb_set(actual_facts,'{assignments}',(select jsonb_agg(case when row_value->>'id'=p_assignment::text then
      (select original from jsonb_array_elements(scope#>'{original_source_facts,assignments}') original where original->>'id'=p_assignment::text)
      else row_value end order by ordinal) from jsonb_array_elements(actual_facts->'assignments') with ordinality rows(row_value,ordinal)));
    if actual_facts is distinct from scope->'original_source_facts' then
      raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_ORIGINAL_SOURCE_CHANGED' using errcode='40001'; end if;
  end if;
  return auth;
end;
$function$;

create or replace function private.weekly_source_protected_activation_probe_execute_v1(p_scope_id uuid,p_request jsonb)
returns jsonb language plpgsql volatile security invoker set search_path to 'pg_catalog','pg_temp'
as $function$
declare result jsonb; cycle_id uuid; scope jsonb; target public.weekly_source_group_rule_assignments%rowtype;
begin
  perform private.weekly_source_protected_qualification_owner_v1();
  if p_request->'feature_enabled' is distinct from 'true'::jsonb or p_request->>'feature_purpose' is distinct from 'PROTECTED_SOURCE'
    or p_request->'rule_set_version_id' is distinct from 'null'::jsonb or p_request ? 'activation_probe_scope_id'
    or p_request ? 'protected_capability_qualification_sha256' then
    raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_NATIVE_REQUEST_INVALID' using errcode='22023'; end if;
  result:=public.weekly_source_group_rule_feature_set_atomic_v1(p_request||jsonb_build_object('activation_probe_scope_id',p_scope_id));
  for cycle_id in select id from public.weekly_source_cycles where source_group_id=(p_request->>'source_group_id')::uuid loop
    if private.weekly_source_bulk_producer_ready_v1(cycle_id) or private.weekly_source_automatic_reconcile_producer_ready_v1(cycle_id) then
      raise exception 'WEEKLY_SOURCE_ACTIVATION_PROBE_OPERATIONAL_LEAK' using errcode='55000'; end if;
  end loop;
  select audit.after_json into strict scope from public.audit_events audit where audit.object_type='weekly_source_activation_probe'
    and audit.object_id_text=p_scope_id::text and audit.action='WEEKLY_SOURCE_ACTIVATION_PROBE_ADMITTED' and audit.event_sequence_is_authoritative
    and audit.after_json->>'transaction_id'=pg_current_xact_id()::text and audit.after_json->>'backend_pid'=pg_backend_pid()::text;
  select * into strict target from public.weekly_source_group_rule_assignments where id=(p_request->>'assignment_id')::uuid;
  if not exists(select 1 from public.audit_events audit where audit.object_type='weekly_source_activation_probe' and audit.object_id_text=p_scope_id::text
    and audit.action='WEEKLY_SOURCE_ACTIVATION_PROBE_COMPLETED' and audit.event_sequence_is_authoritative) then
    perform public._audit_insert('weekly_source_activation_probe',p_scope_id::text,'WEEKLY_SOURCE_ACTIVATION_PROBE_COMPLETED',null,
      jsonb_build_object('scope_sha256',scope->>'scope_sha256','transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid()::text,
        'native_result',result,'assignment_after_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_ASSIGNMENT_V1',to_jsonb(target)),'hex')),
      'Actual native probe receipt; rollback required', (p_request->>'actor_user_id')::uuid);
  end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_ACTIVATION_PROBE_RESULT_V1','phase','PROBE_COMPLETED_ROLLBACK_REQUIRED',
    'scope_id',p_scope_id,'native_result',result,'operational_ready',false);
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/SETUP_STATIC_SHAPE_ASSERT.sqlinc; raw SHA256 b400d184f791415db84c1badc31e9aee82fad7601512bfcbd78c267479dc468e
create or replace function private.weekly_source_off_rule_setup_shape_assert_v1(p_auth jsonb)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare manifest jsonb:=p_auth->'fixture_manifest'; key text; ids jsonb; sorted jsonb; permitted text[];
begin
  if not private.weekly_source_qualification_closed_object_v1(manifest,array['group_code','client_ids','contract_ids','candidate_ids','client_refs','candidate_refs'])
    or coalesce(manifest->>'group_code','') !~ '^WSQ_TEST_[A-Z0-9_]+$'
    or coalesce(p_auth->>'week_ending','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
    or (p_auth->>'week_ending')::date::text is distinct from p_auth->>'week_ending'
    or extract(dow from (p_auth->>'week_ending')::date)<>0
    or coalesce(p_auth->>'expires_at_utc','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$' then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
  for key in select unnest(array['client_ids','contract_ids','candidate_ids']) loop
    ids:=manifest->key;
    if jsonb_typeof(ids) is distinct from 'array' or jsonb_array_length(ids) not between 1 and 100
      or exists(select 1 from jsonb_array_elements(ids) id where jsonb_typeof(id) is distinct from 'string'
        or coalesce(id#>>'{}','') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$') then
      raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
    select jsonb_agg(id order by id) into sorted from (select distinct id from jsonb_array_elements(ids) id) dedupe;
    if ids is distinct from sorted then raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
  end loop;
  if jsonb_typeof(manifest->'client_refs') is distinct from 'array' or jsonb_typeof(manifest->'candidate_refs') is distinct from 'array'
    or (select coalesce(jsonb_agg(value->'client_id' order by ord),'[]'::jsonb) from jsonb_array_elements(manifest->'client_refs') with ordinality refs(value,ord)) is distinct from manifest->'client_ids'
    or (select coalesce(jsonb_agg(value->'candidate_id' order by ord),'[]'::jsonb) from jsonb_array_elements(manifest->'candidate_refs') with ordinality refs(value,ord)) is distinct from manifest->'candidate_ids'
    or exists(select 1 from jsonb_array_elements(manifest->'client_refs') ref where not private.weekly_source_qualification_closed_object_v1(ref,array['client_id','cli_ref'])
      or coalesce(ref->>'cli_ref','') !~ '^CLI-913013[0-9]{2}$')
    or exists(select 1 from jsonb_array_elements(manifest->'candidate_refs') ref where not private.weekly_source_qualification_closed_object_v1(ref,array['candidate_id','tms_ref'])
      or coalesce(ref->>'tms_ref','') !~ '^CCR-913013[0-9]{2}$')
    or (select count(distinct value->>'cli_ref') from jsonb_array_elements(manifest->'client_refs'))<>jsonb_array_length(manifest->'client_ids')
    or (select count(distinct value->>'tms_ref') from jsonb_array_elements(manifest->'candidate_refs'))<>jsonb_array_length(manifest->'candidate_ids') then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
  permitted:=case p_auth->>'purpose' when 'SOURCE_FIXTURE_SETUP' then array[
    'weekly_source_upload_context_v1','weekly_source_upload_stage_begin_atomic_v1','weekly_source_upload_stage_rows_atomic_v1','weekly_source_upload_seal_atomic_v1',
    'weekly_source_projection_begin_atomic_v1','weekly_source_projection_rows_apply_atomic_v1','weekly_source_projection_publish_atomic_v1',
    'weekly_source_import_prepare_atomic_v1','weekly_source_finalise_atomic_v1','weekly_source_finalisation_pay_open_atomic_v1',
    'weekly_source_finalisation_pay_task_start_atomic_v1','weekly_source_ordinary_pay_projection_apply_atomic_v1','weekly_source_finalisation_pay_task_finish_atomic_v1',
    'REPORT_FIN_AB_FINALISE'] when 'AUTOMATIC_JOURNEY' then array['weekly_source_automatic_reconcile_atomic_v1','weekly_exceptional_pay_prepare_action_v1',
    'weekly_exceptional_pay_action_context_v1','weekly_exceptional_pay_action_publication_status_v1','weekly_exceptional_pay_stage_c1_request_v1'] else null end;
  ids:=p_auth->'allowed_operations';
  if permitted is null or jsonb_typeof(ids) is distinct from 'array' or jsonb_array_length(ids) not between 1 and cardinality(permitted)
    or exists(select 1 from jsonb_array_elements(ids) op where jsonb_typeof(op)<>'string' or not(op#>>'{}'=any(permitted))) then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
  select jsonb_agg(op order by op) into sorted from (select distinct op from jsonb_array_elements(ids) op) dedupe;
  if ids is distinct from sorted then raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
  if p_auth->>'purpose'='AUTOMATIC_JOURNEY' and (not private.weekly_source_qualification_closed_object_v1(p_auth->'original_source_cas',
      array['schema_version','source_cycle_id','client_ids','source_cas_sha256'])
    or p_auth#>>'{original_source_cas,schema_version}' is distinct from 'WEEKLY_SOURCE_BULK_SOURCE_CAS_V1'
    or p_auth#>>'{original_source_cas,source_cycle_id}' is distinct from p_auth->>'source_cycle_id'
    or p_auth#>'{original_source_cas,client_ids}' is distinct from manifest->'client_ids'
    or jsonb_array_length(manifest->'client_ids')<>1
    or coalesce(p_auth#>>'{original_source_cas,source_cas_sha256}','') !~ '^[0-9a-f]{64}$') then
    raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023'; end if;
exception when invalid_text_representation or datetime_field_overflow or invalid_datetime_format then
  raise exception 'WEEKLY_SOURCE_OFF_RULE_SETUP_SHAPE_INVALID' using errcode='22023';
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/POST_VERIFIED_SETUP_ASSERT.sqlinc; raw SHA256 0610fc771a322fa11e8cc4c0aca94d0c20a34bf873626aa8926ab0de22f072e0
-- The normalized OFF DTO is independently checked here before it is appended.
-- Raw artifact/native/control provenance is measured by the protected writer.
create or replace function private.weekly_source_post_verified_setup_artifact_assert_v1(p_artifact jsonb,p_execution jsonb)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare g public.weekly_source_groups%rowtype; c public.weekly_source_cycles%rowtype; a public.weekly_source_group_rule_assignments%rowtype;
  v public.weekly_source_rule_set_versions%rowtype; item jsonb; clients uuid[];
begin
  perform private.weekly_source_off_rule_setup_shape_assert_v1(p_artifact);
  if not private.weekly_source_qualification_closed_object_v1(p_artifact,array['schema_version','authorization_id','scope_id','release_id','source_commit','contract_sha256',
    'agency_id','source_group_id','source_cycle_id','setup_actor_user_id','journey_actor_user_id','purpose','week_ending','expires_at_utc','fixture_namespace',
    'fixture_manifest','assignment_id','assignment_version','assignment_sha256','rule_set_version_id','rule_values_sha256','original_source_cas','allowed_operations',
    'banking_install_receipt_sha256','security_receipt_sha256','source_effects_review_sha256','authorization_sha256'])
    or p_artifact->>'schema_version' is distinct from 'WEEKLY_SOURCE_OFF_RULE_TEST_AUTHORIZATION_V1'
    or p_artifact->>'release_id' is distinct from p_execution->>'release_id' or p_artifact->>'source_commit' is distinct from p_execution->>'source_commit'
    or p_artifact->>'contract_sha256' is distinct from p_execution->>'contract_sha256' or p_artifact->>'fixture_namespace' is distinct from 'WSQ_TEST_'
    or p_artifact->>'purpose' not in ('SOURCE_FIXTURE_SETUP','AUTOMATIC_JOURNEY')
    or p_artifact->>'authorization_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_OFF_RULE_TEST_AUTHORIZATION_V1',p_artifact-'authorization_sha256'),'hex')
    or exists(select 1 from unnest(array['authorization_id','scope_id','agency_id','source_group_id','source_cycle_id','setup_actor_user_id','journey_actor_user_id',
      'assignment_id','rule_set_version_id']) key where coalesce(p_artifact->>key,'') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
    or exists(select 1 from unnest(array['contract_sha256','assignment_sha256','rule_values_sha256','banking_install_receipt_sha256','security_receipt_sha256','source_effects_review_sha256']) key
      where coalesce(p_artifact->>key,'') !~ '^[0-9a-f]{64}$')
    or coalesce(p_artifact->>'assignment_version','') !~ '^[1-9][0-9]*$'
    or (p_artifact->>'expires_at_utc')::timestamptz<=clock_timestamp()
    or (p_artifact->>'expires_at_utc')::timestamptz>clock_timestamp()+
      case when p_artifact->>'purpose'='SOURCE_FIXTURE_SETUP' then interval '14 days' else interval '2 hours' end then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SETUP_INVALID' using errcode='22023'; end if;
  perform private._weekly_source_settings_require_admin_v1((p_artifact->>'setup_actor_user_id')::uuid);
  select * into strict c from public.weekly_source_cycles where id=(p_artifact->>'source_cycle_id')::uuid;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and id=(p_artifact->>'source_group_id')::uuid
    and agency_id=(p_artifact->>'agency_id')::uuid and active and source_family='ROSTER' and environment='TEST';
  perform private._weekly_source_settings_deployment_v1(g.agency_id,g.environment);
  select * into strict a from public.weekly_source_group_rule_assignments where id=(p_artifact->>'assignment_id')::uuid and source_group_id=g.id
    and not feature_enabled and c.finalisation_week_ending between effective_from_week_ending and coalesce(effective_to_week_ending,'infinity'::date);
  select version.* into strict v from public.weekly_source_rule_set_versions version join public.weekly_source_rule_sets rules
    on rules.id=version.rule_set_id and rules.agency_id=g.agency_id and rules.environment=g.environment
    where version.id=a.rule_set_version_id;
  if c.finalisation_week_ending::text is distinct from p_artifact->>'week_ending' or a.version::text is distinct from p_artifact->>'assignment_version'
    or a.rule_set_version_id::text is distinct from p_artifact->>'rule_set_version_id' or v.values_sha256 is distinct from p_artifact->>'rule_values_sha256'
    or v.values_json->>'invoice_sender' is distinct from 'CLIENT_SELF_BILL'
    or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_ASSIGNMENT_V1',to_jsonb(a)),'hex') is distinct from p_artifact->>'assignment_sha256'
    or exists(select 1 from public.weekly_source_group_rule_assignments enabled where enabled.source_group_id=g.id and enabled.feature_enabled)
    or g.code is distinct from p_artifact#>>'{fixture_manifest,group_code}' or g.code !~ '^WSQ_TEST_[A-Z0-9_]+$' then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SETUP_SCOPE_CHANGED' using errcode='40001'; end if;
  perform private.weekly_source_office_authority_v1((p_artifact->>'journey_actor_user_id')::uuid,'APPROVE_PROTECTED_PAY',g.id,null,c.finalisation_week_ending);
  if not private.weekly_source_pay_actor_allowed_v1((p_artifact->>'journey_actor_user_id')::uuid) then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SETUP_ACTOR_REFUSED' using errcode='42501'; end if;
  select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(p_artifact#>'{fixture_manifest,client_ids}') value;
  if cardinality(clients) not between 1 and 100 or to_jsonb(clients) is distinct from p_artifact#>'{fixture_manifest,client_ids}' then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SETUP_SCOPE_CHANGED' using errcode='40001'; end if;
  -- HISTORICAL_FIXTURE_RECORD_BOUNDARY: every past scope uses the exact
  -- genuine native disabled assignment; Source setup also proves vacancy.
  if a.effective_from_week_ending<(clock_timestamp() at time zone 'Europe/London')::date then
    perform private.weekly_source_historical_fixture_setup_assert_v1(p_artifact,p_artifact->>'purpose'='SOURCE_FIXTURE_SETUP');
  end if;
  if p_artifact->>'purpose'='AUTOMATIC_JOURNEY' then
    if cardinality(clients)<>1 or v.values_json->>'equal_protected_hours' is distinct from 'CLEAR_AUTOMATICALLY'
      or private.weekly_source_bulk_source_cas_v1(c.id,clients) is distinct from p_artifact->'original_source_cas'
      or not exists(select 1 from public.weekly_source_final_revisions final where final.id=c.current_final_revision_id
        and final.source_cycle_id=c.id and final.state='CURRENT' and final.rule_set_version_id=v.id)
      or (select automatic_reconcile_actor_user_id from public.weekly_source_global_settings where singleton)
        is distinct from (p_artifact->>'journey_actor_user_id')::uuid then
      raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SETUP_SOURCE_CHANGED' using errcode='40001'; end if;
  else
    if c.finalisation_week_ending<>a.effective_from_week_ending or c.current_final_revision_id is not null
    or c.state in ('FINALISING','FINALISED','CORRECTION_IN_PROGRESS')
    or exists(select 1 from public.weekly_source_final_revisions final where final.source_cycle_id=c.id)
    or p_artifact->'original_source_cas' is distinct from 'null'::jsonb then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SETUP_FUTURE_UNFINALISED_REQUIRED' using errcode='55000'; end if;
  end if;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/POST_VERIFIED_BULK_SETUP_ASSERT.sqlinc; raw SHA256 81fbe2c9cd141d10a909072f140a734e8a759a39ce5102691b57ed25fd40982d
create or replace function private.weekly_source_post_verified_bulk_setup_artifact_assert_v1(p_auth jsonb,p_execution jsonb)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare c public.weekly_source_cycles%rowtype; g public.weekly_source_groups%rowtype; census jsonb; q jsonb; r private.cloudtms_database_releases%rowtype; manifest jsonb;
begin
  if not private.weekly_source_qualification_closed_object_v1(p_auth,array['schema_version','authorization_id','scope_id','agency_id','source_group_id',
    'source_cycle_id','setup_actor_user_id','journey_actor_user_id','week_ending','expires_at_utc','fixture_namespace','fixture_manifest','original_census',
    'prerequisite_qualification_sha256','capabilities','release_id','source_commit','contract_sha256','authorization_sha256'])
    or p_auth->>'schema_version' is distinct from 'WEEKLY_SOURCE_PROTECTED_TEST_SETUP_AUTHORIZATION_V1'
    or p_auth->>'release_id' is distinct from p_execution->>'release_id' or p_auth->>'source_commit' is distinct from p_execution->>'source_commit'
    or p_auth->>'contract_sha256' is distinct from p_execution->>'contract_sha256'
    or p_auth->>'fixture_namespace' is distinct from 'WSQ_TEST_' or p_auth->'capabilities' is distinct from '["BULK_SIGNED"]'::jsonb
    or p_auth->>'authorization_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PROTECTED_TEST_SETUP_AUTHORIZATION_V1',p_auth-'authorization_sha256'),'hex')
    or exists(select 1 from unnest(array['authorization_id','scope_id','agency_id','source_group_id','source_cycle_id','setup_actor_user_id','journey_actor_user_id']) key
      where coalesce(p_auth->>key,'') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
    or exists(select 1 from unnest(array['contract_sha256','prerequisite_qualification_sha256','authorization_sha256']) key where coalesce(p_auth->>key,'') !~ '^[0-9a-f]{64}$')
    or (p_auth->>'expires_at_utc')::timestamptz<=clock_timestamp() or (p_auth->>'expires_at_utc')::timestamptz>clock_timestamp()+interval '2 hours' then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_BULK_SETUP_INVALID' using errcode='22023'; end if;
  perform private._weekly_source_settings_require_admin_v1((p_auth->>'setup_actor_user_id')::uuid);
  select * into strict c from public.weekly_source_cycles where id=(p_auth->>'source_cycle_id')::uuid;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and id=(p_auth->>'source_group_id')::uuid
    and agency_id=(p_auth->>'agency_id')::uuid and active and source_family='ROSTER' and environment='TEST';
  perform private._weekly_source_settings_deployment_v1(g.agency_id,g.environment);
  perform private.weekly_source_office_authority_v1((p_auth->>'journey_actor_user_id')::uuid,'APPROVE_PROTECTED_PAY',g.id,null,c.finalisation_week_ending);
  if c.finalisation_week_ending::text is distinct from p_auth->>'week_ending'
    or exists(select 1 from public.weekly_source_group_rule_assignments a where a.source_group_id=g.id and a.feature_enabled)
    or private.weekly_source_bulk_producer_ready_v1(c.id) or private.weekly_source_automatic_reconcile_producer_ready_v1(c.id) then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_BULK_SETUP_SCOPE_CHANGED' using errcode='40001'; end if;
  census:=private.weekly_source_protected_qualification_census_v1(c.id);manifest:=p_auth->'fixture_manifest';
  if census is distinct from p_auth->'original_census'
    or not private.weekly_source_qualification_closed_object_v1(manifest,array['group_code','client_ids','candidate_ids','contract_ids','original_root_ids','work_event_ids','client_refs','candidate_refs'])
    or g.code is distinct from manifest->>'group_code' or g.code !~ '^WSQ_TEST_[A-Z0-9_]+$'
    or manifest->'client_ids' is distinct from census->'original_client_ids'
    or (select coalesce(jsonb_agg(distinct item->'candidate_id' order by item->'candidate_id'),'[]'::jsonb) from jsonb_array_elements(census->'original_items') item) is distinct from manifest->'candidate_ids'
    or (select coalesce(jsonb_agg(distinct item->'contract_id' order by item->'contract_id'),'[]'::jsonb) from jsonb_array_elements(census->'original_items') item) is distinct from manifest->'contract_ids'
    or (select coalesce(jsonb_agg(distinct item->'work_event_id' order by item->'work_event_id'),'[]'::jsonb) from jsonb_array_elements(census->'original_items') item) is distinct from manifest->'work_event_ids'
    or (select coalesce(jsonb_agg(item->'timesheet_id' order by item->'timesheet_id'),'[]'::jsonb) from jsonb_array_elements(census->'original_root_identities') item) is distinct from manifest->'original_root_ids'
    or (select coalesce(jsonb_agg(item->'client_id' order by item->'client_id'),'[]'::jsonb) from jsonb_array_elements(manifest->'client_refs') item) is distinct from manifest->'client_ids'
    or (select coalesce(jsonb_agg(item->'candidate_id' order by item->'candidate_id'),'[]'::jsonb) from jsonb_array_elements(manifest->'candidate_refs') item) is distinct from manifest->'candidate_ids'
    or exists(select 1 from jsonb_array_elements(manifest->'client_refs') item where not private.weekly_source_qualification_closed_object_v1(item,array['client_id','cli_ref'])
      or coalesce(item->>'cli_ref','') !~ '^CLI-913013[0-9]{2}$' or not exists(select 1 from public.clients client where client.id=(item->>'client_id')::uuid and client.cli_ref=item->>'cli_ref'))
    or exists(select 1 from jsonb_array_elements(manifest->'candidate_refs') item where not private.weekly_source_qualification_closed_object_v1(item,array['candidate_id','tms_ref'])
      or coalesce(item->>'tms_ref','') !~ '^CCR-913013[0-9]{2}$' or not exists(select 1 from public.candidates candidate where candidate.id=(item->>'candidate_id')::uuid and candidate.tms_ref=item->>'tms_ref')) then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_BULK_SETUP_CENSUS_CHANGED' using errcode='40001'; end if;
  select * into strict r from private.cloudtms_database_releases where release_id=p_execution->>'release_id';
  select value into strict q from jsonb_array_elements(r.evidence_json->'weekly_source_protected_prerequisite_qualifications') value
    where value->>'qualification_sha256'=p_auth->>'prerequisite_qualification_sha256';
  perform private.weekly_source_protected_prerequisite_release_assert_v2(q,g.id,(q->>'effective_from_week_ending')::date,
    (q->>'effective_to_week_ending')::date,p_auth->>'prerequisite_qualification_sha256');
  if q->'capabilities' is distinct from '["BULK_SIGNED"]'::jsonb or not exists(select 1 from jsonb_array_elements(q->'gate_receipts') receipt
    where receipt->>'gate'='NEXT_PAY' and receipt->>'status'='PREREQUISITE_PASS') then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_BULK_SETUP_NEXT_REQUIRED' using errcode='55000'; end if;
exception when no_data_found or too_many_rows or invalid_text_representation or datetime_field_overflow or invalid_datetime_format then
  raise exception 'WEEKLY_SOURCE_POST_VERIFIED_BULK_SETUP_INVALID' using errcode='22023';
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/POST_VERIFIED_PARTIAL_ASSERT.sqlinc; raw SHA256 9eb4bff291bccd7127df1cf878854ffe896dacd24f0c68264690496188398724
create or replace function private.weekly_source_post_verified_partial_artifact_assert_v1(p_artifact jsonb,p_execution jsonb)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare needed text[]:=array['CLIENT_API','DOCUMENT','LEGACY_PAY','NATIVE_PROTECTION','NEXT_PAY','OWN_STAGE_CAS','SECURITY','SOURCE_CAS_NATIVE','SOURCE_ROUTING'];
  expected jsonb; item jsonb;
begin
  if p_artifact->'capabilities'='["AUTOMATIC_RECONCILE","BULK_SIGNED"]'::jsonb then needed:=array_prepend('AUTOMATIC_COMPONENT_DELTA',needed); end if;
  if not private.weekly_source_qualification_closed_object_v1(p_artifact,array['schema_version','phase','operational_ready','release_id','git_commit','contract_sha256',
    'agency_id','environment','source_group_id','effective_from_week_ending','effective_to_week_ending','capabilities','required_gate_census','gate_receipts','held_gates','partial_evidence_sha256'])
    or p_artifact->>'schema_version' is distinct from 'WEEKLY_SOURCE_PROTECTED_NATIVE_PARTIAL_EVIDENCE_V1'
    or p_artifact->>'phase' is distinct from 'MEASURED_PARTIAL_NON_OPERATIONAL' or p_artifact->'operational_ready' is distinct from 'false'::jsonb
    or p_artifact->>'release_id' is distinct from p_execution->>'release_id' or p_artifact->>'git_commit' is distinct from p_execution->>'source_commit'
    or p_artifact->>'contract_sha256' is distinct from p_execution->>'contract_sha256' or p_artifact->>'environment' is distinct from 'TEST'
    or p_artifact->'capabilities' not in ('["BULK_SIGNED"]'::jsonb,'["AUTOMATIC_RECONCILE","BULK_SIGNED"]'::jsonb)
    or p_artifact->'required_gate_census' is distinct from to_jsonb(needed)
    or jsonb_typeof(p_artifact->'gate_receipts') is distinct from 'array' or jsonb_array_length(p_artifact->'gate_receipts') not between 1 and cardinality(needed)
    or p_artifact->>'partial_evidence_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_PROTECTED_NATIVE_PARTIAL_EVIDENCE_V1',p_artifact-'partial_evidence_sha256'),'hex')
    or not exists(select 1 from public.weekly_source_groups g where g.id=(p_artifact->>'source_group_id')::uuid
      and g.agency_id=(p_artifact->>'agency_id')::uuid and g.active and g.environment='TEST' and g.source_family='ROSTER') then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_PARTIAL_INVALID' using errcode='22023'; end if;
  if (select count(distinct value->>'gate') from jsonb_array_elements(p_artifact->'gate_receipts') value)<>jsonb_array_length(p_artifact->'gate_receipts') then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_PARTIAL_INVALID' using errcode='22023'; end if;
  for item in select value from jsonb_array_elements(p_artifact->'gate_receipts') value loop
    if not private.weekly_source_qualification_closed_object_v1(item,array['gate','status','execution','database','receipt_id','receipt_sha256','source_commit',
      'contract_sha256','source_group_id','agency_id','environment']) or not(coalesce(item->>'gate','')=any(needed)) or item->>'status' is distinct from 'PASS'
      or item->>'execution' is distinct from 'AGENCY_TEST_NATIVE' or item->>'database' is distinct from current_database()
      or item->>'source_commit' is distinct from p_execution->>'source_commit' or item->>'contract_sha256' is distinct from p_execution->>'contract_sha256'
      or item->>'source_group_id' is distinct from p_artifact->>'source_group_id' or item->>'agency_id' is distinct from p_artifact->>'agency_id'
      or item->>'environment' is distinct from 'TEST' or coalesce(item->>'receipt_id','') !~ '^[A-Za-z0-9_./:@-]{1,256}$'
      or coalesce(item->>'receipt_sha256','') !~ '^[0-9a-f]{64}$' then
      raise exception 'WEEKLY_SOURCE_POST_VERIFIED_PARTIAL_INVALID' using errcode='22023'; end if;
  end loop;
  select coalesce(jsonb_agg(gate order by gate),'[]'::jsonb) into expected from unnest(needed) gate
    where not exists(select 1 from jsonb_array_elements(p_artifact->'gate_receipts') value where value->>'gate'=gate);
  if p_artifact->'held_gates' is distinct from expected then raise exception 'WEEKLY_SOURCE_POST_VERIFIED_PARTIAL_INVALID' using errcode='22023'; end if;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/REPORT_FIXTURE_REFERENCE.sqlinc; raw SHA256 697d3ca1fe0d9af1588d9e71c0b25c69b2dc48effd86e01dccc05aec65e28031
-- R1 owner-session/savepoint authority only. Actual independent HTTP retains
-- the unqualified operational Report selector refusal until its R2 certificate.
-- This is not a public variant selector and has no service/browser EXECUTE.
create or replace function private.weekly_source_rule_report_fixture_bind_v1(p_request jsonb)
returns jsonb language plpgsql volatile security invoker set search_path to 'pg_catalog','pg_temp'
as $function$
declare actor uuid; auth jsonb; req jsonb; scope public.weekly_source_report_scopes%rowtype;
  report public.weekly_source_self_bill_reports%rowtype; source_cas jsonb; clients uuid[]; ref jsonb; wrapped jsonb;
begin
  perform private.weekly_source_protected_qualification_owner_v1();
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['actor_user_id','source_cycle_id','case_id','variant','native_request'])
    or p_request->>'variant' not in ('A','B') or p_request->>'case_id' not in ('BOUND_NEGATIVE','D_NEGATIVE','D_POSITIVE','D_ZERO',
      'NEXT_ACTIVE','ORDINARY_NHSP_REGRESSION','STANDALONE_NEGATIVE') then
    raise exception 'WEEKLY_SOURCE_REPORT_FIXTURE_REFERENCE_INVALID' using errcode='22023'; end if;
  actor:=(p_request->>'actor_user_id')::uuid;req:=p_request->'native_request';
  auth:=private.weekly_source_rule_qualification_authorization_v1((p_request->>'source_cycle_id')::uuid,actor,'SOURCE_FIXTURE_SETUP');
  perform private.weekly_source_rule_qualification_scope_assert_v1(auth,actor,false);
  if not private.weekly_source_qualification_closed_object_v1(req,array['actor_user_id','source_cycle_id','authority_scope_kind','report_scope_id','upload_id',
    'projection_publication_id','expected_authority_scope_version','expected_row_manifest_hash','expected_comparison_manifest_hash','expected_issue_set_hash',
    'exclude_unfinalised_acknowledged']) or req->>'authority_scope_kind' is distinct from 'SELF_BILL_REPORT_SCOPE'
    or req->>'actor_user_id' is distinct from actor::text or req->>'source_cycle_id' is distinct from auth->>'source_cycle_id' then
    raise exception 'WEEKLY_SOURCE_REPORT_FIXTURE_REFERENCE_INVALID' using errcode='22023'; end if;
  select * into strict scope from public.weekly_source_report_scopes where id=(req->>'report_scope_id')::uuid
    and source_cycle_id=(auth->>'source_cycle_id')::uuid and source_group_id=(auth->>'source_group_id')::uuid
    and current_complete_upload_id=(req->>'upload_id')::uuid and current_projection_publication_id=(req->>'projection_publication_id')::uuid
    and version=(req->>'expected_authority_scope_version')::bigint and projection_state='CURRENT' and current_final_revision_id is null;
  select * into strict report from public.weekly_source_self_bill_reports where id=scope.self_bill_report_id
    and source_cycle_id=scope.source_cycle_id and source_group_id=scope.source_group_id and client_id=scope.client_id;
  if not(auth#>'{fixture_manifest,client_ids}' @> jsonb_build_array(scope.client_id)) then
    raise exception 'WEEKLY_SOURCE_REPORT_FIXTURE_FOREIGN_CLIENT' using errcode='42501'; end if;
  perform private.weekly_source_office_authority_v1(actor,'FINALISE_WEEK',scope.source_group_id,scope.client_id,
    (select finalisation_week_ending from public.weekly_source_cycles where id=scope.source_cycle_id));
  select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(auth#>'{fixture_manifest,client_ids}') value;
  source_cas:=private.weekly_source_bulk_source_cas_v1(scope.source_cycle_id,clients);
  ref:=jsonb_build_object('schema_version','WEEKLY_SOURCE_REPORT_FIN_FIXTURE_REFERENCE_V1','case_id',p_request->>'case_id',
    'variant',p_request->>'variant','source_cycle_id',scope.source_cycle_id,'report_scope_id',scope.id,'client_id',scope.client_id,
    'rule_set_version_id',auth->>'rule_set_version_id','rule_set_values_sha256',auth->>'rule_values_sha256',
    'source_census_sha256',source_cas->>'source_cas_sha256','native_request_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_REPORT_FIN_FIXTURE_REQUEST_V1',req),'hex'));
  wrapped:=jsonb_build_object('schema_version','WEEKLY_SOURCE_REPORT_FIN_FIXTURE_FRAME_V1','scope_id',auth->>'scope_id',
    'authorization_sha256',auth->>'authorization_sha256','transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid()::text,
    'reference',ref,'source_cas',source_cas,'operational_ready',false);
  wrapped:=wrapped||jsonb_build_object('frame_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_REPORT_FIN_FIXTURE_FRAME_V1',wrapped),'hex'));
  perform public._audit_insert('weekly_source_off_rule_report_reference',gen_random_uuid()::text,'WEEKLY_SOURCE_REPORT_FIN_FIXTURE_BOUND',null,wrapped,
    'Owner rollback A/B Report FIN fixture reference',actor);
  return ref;
end;
$function$;

create or replace function private.weekly_source_rule_report_fixture_finalise_v1(p_auth jsonb,p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare auth jsonb; frame jsonb; ref jsonb; n integer; clients uuid[]; stack text;
begin
  perform private.weekly_source_protected_qualification_owner_v1();
  get diagnostics stack=pg_context;
  if stack !~ 'PL/pgSQL function (private\.)?weekly_source_rule_qualification_execute_v1\(jsonb\)' then
    raise exception 'WEEKLY_SOURCE_REPORT_FIXTURE_CONTROLLED_CALLER_REQUIRED' using errcode='42501'; end if;
  auth:=private.weekly_source_rule_qualification_context_v1(null,(p_request->>'source_cycle_id')::uuid);
  if auth is distinct from p_auth or auth->>'purpose' is distinct from 'SOURCE_FIXTURE_SETUP' then
    raise exception 'WEEKLY_SOURCE_REPORT_FIXTURE_SCOPE_CHANGED' using errcode='40001'; end if;
  select count(*),jsonb_agg(audit.after_json)->0 into n,frame from public.audit_events audit
    where audit.object_type='weekly_source_off_rule_report_reference' and audit.action='WEEKLY_SOURCE_REPORT_FIN_FIXTURE_BOUND'
      and audit.event_sequence_is_authoritative and audit.after_json->>'scope_id'=auth->>'scope_id'
      and audit.after_json->>'transaction_id'=pg_current_xact_id()::text and audit.after_json->>'backend_pid'=pg_backend_pid()::text;
  ref:=frame->'reference';
  select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(auth#>'{fixture_manifest,client_ids}') value;
  if n<>1 or frame->>'authorization_sha256' is distinct from auth->>'authorization_sha256' or frame->'operational_ready' is distinct from 'false'::jsonb
    or frame->>'frame_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_REPORT_FIN_FIXTURE_FRAME_V1',frame-'frame_sha256'),'hex')
    or ref->>'variant' not in ('A','B') or ref->>'source_cycle_id' is distinct from auth->>'source_cycle_id'
    or ref->>'report_scope_id' is distinct from p_request->>'report_scope_id'
    or ref->>'rule_set_version_id' is distinct from auth->>'rule_set_version_id' or ref->>'rule_set_values_sha256' is distinct from auth->>'rule_values_sha256'
    or ref->>'native_request_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_REPORT_FIN_FIXTURE_REQUEST_V1',p_request),'hex')
    or frame->'source_cas' is distinct from private.weekly_source_bulk_source_cas_v1((auth->>'source_cycle_id')::uuid,clients) then
    raise exception 'WEEKLY_SOURCE_REPORT_FIXTURE_REFERENCE_CHANGED' using errcode='40001'; end if;
  return private.weekly_source_finalise_engine_v1(p_request,null::uuid,false,ref->>'variant');
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/NONOPERATIONAL_PREREQUISITE_READER.sqlinc; raw SHA256 c0c7b32a56ad4974759932c38214691888d3bd4a8d5400838ceb24943cde110d
-- Protected writer alone records these real R1 receipts on R2. The R1
-- identity is retained, and the writer compares the complete committed native
-- source set byte-for-byte. No ledger/status/receipt is edited by this reader.
create or replace function private.weekly_source_protected_prerequisite_release_assert_v2(
  p_q jsonb,p_group_id uuid,p_from date,p_to date,p_expected_sha256 text
) returns jsonb language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare g public.weekly_source_groups%rowtype; r private.cloudtms_database_releases%rowtype;
  executed private.cloudtms_database_releases%rowtype; q jsonb:=p_q; entry jsonb; needed text[]; source_value jsonb;
begin
  select * into strict g from public.weekly_source_groups where id=p_group_id and active and source_family='ROSTER';
  select * into strict r from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1;
  select * into strict executed from private.cloudtms_database_releases where release_id=q#>>'{execution_identity,release_id}';
  if not private.weekly_exceptional_json_keys_exact_v1(q,array['schema_version','phase','release_id','git_commit','contract_sha256',
      'agency_id','environment','source_group_id','effective_from_week_ending','effective_to_week_ending','capabilities',
      'execution_identity','source_equivalence','gate_receipts','required_operational_replay','qualification_sha256'])
    or not(q ?& array['schema_version','phase','release_id','git_commit','contract_sha256','agency_id','environment','source_group_id',
      'effective_from_week_ending','effective_to_week_ending','capabilities','execution_identity','source_equivalence','gate_receipts',
      'required_operational_replay','qualification_sha256'])
    or q->>'schema_version' is distinct from 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_PREREQUISITE_QUALIFICATION_V2'
    or q->>'phase' is distinct from 'PREREQUISITES_QUALIFIED_OPERATIONAL_REPLAY_PENDING'
    or current_database()<>'cloudtms_test_clone' or g.environment<>'TEST'
    or r.status<>'VERIFIED' or r.completed_at_utc is null or r.installed_contract_sha256 is distinct from r.repository_contract_sha256
    or r.evidence_json#>>'{managed_release,environment}' is distinct from 'TEST'
    or r.evidence_json#>>'{managed_release,expected_database}' is distinct from current_database()
    or not private.weekly_exceptional_json_keys_exact_v1(q->'execution_identity',array['release_id','source_commit','contract_sha256',
      'installation_id','agency_id','environment','database','managed_manifest_sha256','installed_catalogue_jsonb_sha256'])
    or q->>'release_id' is distinct from r.release_id or q->>'git_commit' is distinct from r.git_commit
    or q->>'contract_sha256' is distinct from r.installed_contract_sha256
    or q->>'agency_id' is distinct from g.agency_id::text or q->>'source_group_id' is distinct from g.id::text
    or q->>'environment' is distinct from 'TEST' or q->>'effective_from_week_ending' is distinct from p_from::text
    or q->>'effective_to_week_ending' is distinct from p_to::text
    or q->>'qualification_sha256' is distinct from p_expected_sha256
    or coalesce(q->>'qualification_sha256','') !~ '^[0-9a-f]{64}$'
    or encode(private.weekly_source_sha256_jsonb_v1(q->>'schema_version',q-'qualification_sha256'),'hex')
      is distinct from q->>'qualification_sha256'
    or executed.status<>'VERIFIED' or executed.completed_at_utc is null
    or executed.git_commit is distinct from q#>>'{execution_identity,source_commit}'
    or executed.installed_contract_sha256 is distinct from executed.repository_contract_sha256
    or executed.installed_contract_sha256 is distinct from r.installed_contract_sha256
    or executed.installed_contract_sha256 is distinct from q#>>'{execution_identity,contract_sha256}'
    or q#>>'{execution_identity,managed_manifest_sha256}' is distinct from executed.evidence_json#>>'{managed_release,manifest_sha256}'
    or q#>>'{execution_identity,installed_catalogue_jsonb_sha256}'
      is distinct from executed.evidence_json#>>'{weekly_source_protected_qualification_catalogue,jsonb_sha256}'
    or q#>>'{execution_identity,installed_catalogue_jsonb_sha256}'
      is distinct from r.evidence_json#>>'{weekly_source_protected_qualification_catalogue,jsonb_sha256}'
    or q#>>'{execution_identity,agency_id}' is distinct from g.agency_id::text
    or q#>>'{execution_identity,environment}' is distinct from 'TEST'
    or q#>>'{execution_identity,database}' is distinct from current_database()
    or not exists(select 1 from private.cloudtms_database_identity identity where identity.singleton and identity.environment='TEST'
      and identity.installation_id::text=q#>>'{execution_identity,installation_id}')
    or executed.evidence_json#>>'{managed_release,environment}' is distinct from 'TEST'
    or executed.evidence_json#>>'{managed_release,expected_database}' is distinct from current_database()
    or q->'required_operational_replay' is distinct from '["CONTROLLED_ACTIVATION_POSITIVE_NEGATIVE_CAS", "REAL_CLIENT_API_PREVIEW_COMMIT_RETRY_ERROR_ORDER", "REAL_OFFICE_UI_DEEP_LINK_ACTIONS", "REAL_MYTMS_SIGNED_DOCUMENT_AND_APP", "REAL_POST_ACTIVATION_NATIVE_LEGACY_NEXT_REPLAY", "REAL_POST_ACTIVATION_SOURCE_ROUTING"]'::jsonb then
    raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_RELEASE_UNQUALIFIED' using errcode='55000'; end if;
  perform private.weekly_source_protected_execution_tree_assert_v2(q->'source_equivalence',executed.git_commit,r.git_commit);
  if jsonb_typeof(q->'capabilities') is distinct from 'array'
    or q->'capabilities' not in ('["BULK_SIGNED"]'::jsonb,'["AUTOMATIC_RECONCILE","BULK_SIGNED"]'::jsonb)
    or jsonb_typeof(q->'gate_receipts') is distinct from 'array' then
    raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_RELEASE_UNQUALIFIED' using errcode='55000'; end if;
  needed:=array['SOURCE_CAS_NATIVE','NATIVE_PROTECTION','SECURITY','LEGACY_PAY','NEXT_PAY','CLIENT_API','DOCUMENT','OWN_STAGE_CAS','SOURCE_ROUTING'];
  if q->'capabilities' @> '["AUTOMATIC_RECONCILE"]'::jsonb then needed:=array_append(needed,'AUTOMATIC_COMPONENT_DELTA'); end if;
  if jsonb_array_length(q->'gate_receipts')<>cardinality(needed)
    or (select count(distinct value->>'gate') from jsonb_array_elements(q->'gate_receipts') value)<>cardinality(needed) then
    raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_RELEASE_UNQUALIFIED' using errcode='55000'; end if;
  for entry in select value from jsonb_array_elements(q->'gate_receipts') value loop
    if not private.weekly_exceptional_json_keys_exact_v1(entry,array['gate','status','execution','receipt_id','receipt_sha256',
        'execution_release_id','execution_source_commit','execution_contract_sha256','execution_installation_id','scope_id',
        'scope_sha256','transaction_id','source_cycle_id','week_ending','original_census_sha256','source_cas_sha256'])
      or not(entry ?& array['gate','status','execution','receipt_id','receipt_sha256','execution_release_id','execution_source_commit',
        'execution_contract_sha256','execution_installation_id','scope_id','scope_sha256','transaction_id','source_cycle_id','week_ending','original_census_sha256','source_cas_sha256'])
      or not(coalesce(entry->>'gate','')=any(needed)) or entry->>'status' is distinct from 'PREREQUISITE_PASS'
      or entry->>'execution' is distinct from 'AGENCY_TEST_NATIVE_ROLLBACK'
      or entry->>'execution_release_id' is distinct from executed.release_id
      or entry->>'execution_source_commit' is distinct from executed.git_commit
      or entry->>'execution_contract_sha256' is distinct from executed.installed_contract_sha256
      or entry->>'execution_installation_id' is distinct from q#>>'{execution_identity,installation_id}'
      or coalesce(entry->>'scope_id','') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
      or coalesce(entry->>'transaction_id','') !~ '^[0-9]+$'
      or coalesce(entry->>'source_cycle_id','') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
      or coalesce(entry->>'week_ending','') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
      or (entry->>'week_ending')::date<p_from or (p_to is not null and (entry->>'week_ending')::date>p_to)
      or nullif(entry->>'receipt_id','') is null
      or exists(select 1 from unnest(array['receipt_sha256','scope_sha256','original_census_sha256','source_cas_sha256']) field
        where coalesce(entry->>field,'') !~ '^[0-9a-f]{64}$') then
      raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_RELEASE_UNQUALIFIED' using errcode='55000'; end if;
  end loop;
  return q;
exception when no_data_found or too_many_rows or invalid_text_representation then
  raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_RELEASE_UNQUALIFIED' using errcode='55000';
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/POST_VERIFIED_EVIDENCE_RECORD.sqlinc; raw SHA256 9f8e8a6448ead46d3d35e539938a6d1b36996d3a39ce8688645d4db806e12238
-- Complete adjacent owner-session proposal. Protected controller must measure
-- real Git objects and validate raw artifacts before this SQL call. No new
-- release, status transition, DDL, ledger, feature setting or browser grant.
create or replace function private.weekly_source_post_verified_artifact_assert_v1(p_slot text,p_artifacts jsonb,p_execution jsonb,p_receipt_commit text)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare artifact jsonb;
begin
  if jsonb_typeof(p_artifacts) is distinct from 'array' or jsonb_array_length(p_artifacts) not between 1 and 100 then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_ARTIFACT_INVALID' using errcode='22023'; end if;
  case p_slot
    when 'weekly_source_protected_prerequisite_qualifications' then
      for artifact in select value from jsonb_array_elements(p_artifacts) value loop
        if artifact->'capabilities' is distinct from '["BULK_SIGNED"]'::jsonb then
          raise exception 'WEEKLY_SOURCE_POST_VERIFIED_PREREQUISITE_SCOPE_REFUSED' using errcode='55000'; end if;
        perform private.weekly_source_protected_prerequisite_release_assert_v2(artifact,(artifact->>'source_group_id')::uuid,
          (artifact->>'effective_from_week_ending')::date,(artifact->>'effective_to_week_ending')::date,artifact->>'qualification_sha256');
      end loop;
    when 'weekly_source_protected_activation_probe_authorizations' then
      for artifact in select value from jsonb_array_elements(p_artifacts) value loop
        perform private.weekly_source_protected_activation_probe_authorization_assert_v1(artifact,(artifact->>'source_group_id')::uuid,
          (artifact->>'effective_from_week_ending')::date,(artifact->>'effective_to_week_ending')::date,artifact->>'probe_authorization_sha256');
      end loop;
    when 'weekly_source_protected_partial_native_evidence' then
      for artifact in select value from jsonb_array_elements(p_artifacts) value loop
        perform private.weekly_source_post_verified_partial_artifact_assert_v1(artifact,p_execution);
      end loop;
    when 'weekly_source_protected_capability_qualifications' then
      for artifact in select value from jsonb_array_elements(p_artifacts) value loop
        perform private.weekly_source_protected_operational_certificate_assert_v1(artifact,(artifact->>'source_group_id')::uuid,
          (artifact->>'effective_from_week_ending')::date,(artifact->>'effective_to_week_ending')::date,artifact->>'qualification_sha256');
      end loop;
    when 'weekly_source_report_fin_native_comparisons' then
      perform private.weekly_source_report_fin_native_comparisons_assert_v1(p_artifacts,p_execution,p_receipt_commit);
    when 'weekly_source_report_fin_qualifications' then
      perform private.weekly_source_report_fin_qualifications_assert_v1(p_artifacts,p_execution,p_receipt_commit);
    when 'weekly_source_protected_test_setup_authorizations' then
      for artifact in select value from jsonb_array_elements(p_artifacts) value loop
        if artifact->>'schema_version'='WEEKLY_SOURCE_PROTECTED_TEST_SETUP_AUTHORIZATION_V1' then
          perform private.weekly_source_post_verified_bulk_setup_artifact_assert_v1(artifact,p_execution);
        else perform private.weekly_source_post_verified_setup_artifact_assert_v1(artifact,p_execution); end if;
      end loop;
    when 'weekly_source_off_rule_test_controls' then
      if jsonb_array_length(p_artifacts)<>1 then raise exception 'WEEKLY_SOURCE_POST_VERIFIED_ARTIFACT_INVALID' using errcode='22023'; end if;
      artifact:=p_artifacts->0;
      if not private.weekly_source_qualification_closed_object_v1(artifact,array['schema_version','release_id','source_commit','contract_sha256',
        'banking_install_receipt_sha256','security_receipt_sha256','source_effects_review_sha256','banking_first_install_complete','effective_acl_pass',
        'browser_denied','source_effects_no_external_calls']) or artifact->>'schema_version' is distinct from 'WEEKLY_SOURCE_OFF_RULE_TEST_CONTROLS_V1'
        or artifact->>'release_id' is distinct from p_execution->>'release_id' or artifact->>'source_commit' is distinct from p_execution->>'source_commit'
        or artifact->>'contract_sha256' is distinct from p_execution->>'contract_sha256'
        or exists(select 1 from unnest(array['banking_install_receipt_sha256','security_receipt_sha256','source_effects_review_sha256']) key
          where coalesce(artifact->>key,'') !~ '^[0-9a-f]{64}$')
        or exists(select 1 from unnest(array['banking_first_install_complete','effective_acl_pass','browser_denied','source_effects_no_external_calls']) key
          where artifact->key is distinct from 'true'::jsonb) then
        raise exception 'WEEKLY_SOURCE_POST_VERIFIED_ARTIFACT_INVALID' using errcode='22023'; end if;
    else raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SLOT_REFUSED' using errcode='42501';
  end case;
end;
$function$;

create or replace function private.weekly_source_post_verified_evidence_record_v1(p_actor_user_id uuid,p_request jsonb)
returns jsonb language plpgsql volatile security invoker set search_path to 'pg_catalog','pg_temp'
as $function$
declare r private.cloudtms_database_releases%rowtype; execution jsonb; slot text; artifact jsonb; prior jsonb; next_value jsonb;
  next_evidence jsonb; receipt jsonb; prior_sha text; new_sha text; artifact_sha text; item jsonb; key text;
  identity_before jsonb; identity_after jsonb; managed_lock bigint:=hashtextextended('cloudtms_database_release_admission_v1',0);
begin
  perform private.weekly_source_protected_qualification_owner_v1();
  perform private._weekly_source_settings_require_admin_v1(p_actor_user_id);
  if not private.weekly_source_qualification_closed_object_v1(p_request,array['schema_version','expected_execution','expected_evidence_sha256',
    'receipt_input_commit','receipt_tree_proof','artifact_slot','artifacts','reason','turn_backend_pid'])
    or p_request->>'schema_version' is distinct from 'WEEKLY_SOURCE_POST_VERIFIED_EVIDENCE_RECORD_V1'
    or coalesce(p_request->>'expected_evidence_sha256','') !~ '^[0-9a-f]{64}$'
    or coalesce(p_request->>'receipt_input_commit','') !~ '^[0-9a-f]{40}$'
    or char_length(coalesce(p_request->>'reason','')) not between 1 and 1000
    or coalesce(p_request->>'turn_backend_pid','') !~ '^[1-9][0-9]*$' then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_REQUEST_INVALID' using errcode='22023'; end if;
  if not exists(select 1 from pg_locks lock_row where lock_row.locktype='advisory' and lock_row.granted and lock_row.mode='ExclusiveLock'
    and lock_row.pid=pg_backend_pid() and lock_row.database=(select oid from pg_database where datname=current_database())
    and lock_row.objsubid=1 and lock_row.classid=((managed_lock>>32)&4294967295)::oid and lock_row.objid=(managed_lock&4294967295)::oid)
    or not exists(select 1 from pg_locks lock_row where lock_row.locktype='advisory' and lock_row.granted and lock_row.mode='ExclusiveLock'
      and lock_row.pid=(p_request->>'turn_backend_pid')::integer and lock_row.pid<>pg_backend_pid()
      and lock_row.database=(select oid from pg_database where datname=current_database())
      and lock_row.classid=20261013::oid and lock_row.objid=1::oid and lock_row.objsubid=2) then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_OWNED_MUTEX_REQUIRED' using errcode='55000'; end if;
  execution:=private.weekly_source_protected_qualification_release_v1();
  if execution is distinct from p_request->'expected_execution' then raise exception 'WEEKLY_SOURCE_POST_VERIFIED_EXECUTION_CHANGED' using errcode='40001'; end if;
  select * into strict r from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1 for update;
  if r.release_id is distinct from execution->>'release_id' or r.status<>'VERIFIED' or r.completed_at_utc is null
    or r.git_commit is distinct from execution->>'source_commit' or r.installed_contract_sha256 is distinct from execution->>'contract_sha256' then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_EXECUTION_CHANGED' using errcode='40001'; end if;
  prior_sha:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_RELEASE_EVIDENCE_V1',r.evidence_json),'hex');
  if prior_sha is distinct from p_request->>'expected_evidence_sha256' then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_EVIDENCE_CHANGED' using errcode='40001'; end if;
  -- SQL verifies the closed measured DTO. Real Git/mode/type/raw-byte equality
  -- must be measured by the protected controller, not asserted by caller JSON.
  perform private.weekly_source_protected_execution_tree_assert_v2(p_request->'receipt_tree_proof',r.git_commit,p_request->>'receipt_input_commit');
  slot:=p_request->>'artifact_slot';artifact:=p_request->'artifacts';
  perform private.weekly_source_post_verified_artifact_assert_v1(slot,artifact,execution,p_request->>'receipt_input_commit');
  if slot='weekly_source_off_rule_test_controls' then
    prior:=r.evidence_json->slot;next_value:=artifact->0;
    if prior is not null and prior is distinct from next_value then
      raise exception 'WEEKLY_SOURCE_POST_VERIFIED_REPLACEMENT_REFUSED' using errcode='23505'; end if;
  else
    prior:=coalesce(r.evidence_json->slot,'[]'::jsonb);
    if jsonb_typeof(prior) is distinct from 'array' then raise exception 'WEEKLY_SOURCE_POST_VERIFIED_EXISTING_SLOT_INVALID' using errcode='55000'; end if;
    next_value:=prior;
    for item in select value from jsonb_array_elements(artifact) value loop
      key:=case slot when 'weekly_source_protected_test_setup_authorizations' then 'authorization_id'
        when 'weekly_source_protected_activation_probe_authorizations' then 'probe_authorization_sha256'
        when 'weekly_source_protected_partial_native_evidence' then 'partial_evidence_sha256'
        when 'weekly_source_protected_prerequisite_qualifications' then 'qualification_sha256'
        when 'weekly_source_protected_capability_qualifications' then 'qualification_sha256'
        when 'weekly_source_report_fin_qualifications' then 'qualification_sha256'
        when 'weekly_source_report_fin_native_comparisons' then 'comparison_sha256' end;
      if key is null or nullif(item->>key,'') is null then raise exception 'WEEKLY_SOURCE_POST_VERIFIED_ARTIFACT_ID_REQUIRED' using errcode='22023'; end if;
      if exists(select 1 from jsonb_array_elements(next_value) existing where existing->>key=item->>key and existing is distinct from item) then
        raise exception 'WEEKLY_SOURCE_POST_VERIFIED_REPLACEMENT_REFUSED' using errcode='23505'; end if;
      if exists(select 1 from jsonb_array_elements(next_value) existing where existing is distinct from item and (
        (slot='weekly_source_protected_test_setup_authorizations' and
          (existing->>'source_cycle_id',existing->>'journey_actor_user_id',existing->>'purpose') is not distinct from
          (item->>'source_cycle_id',item->>'journey_actor_user_id',item->>'purpose'))
        or (slot in ('weekly_source_protected_capability_qualifications','weekly_source_protected_prerequisite_qualifications') and
          (existing->>'source_group_id',existing->>'effective_from_week_ending',existing->>'effective_to_week_ending',existing->>'rule_set_version_id')
            is not distinct from (item->>'source_group_id',item->>'effective_from_week_ending',item->>'effective_to_week_ending',item->>'rule_set_version_id'))
        or (slot='weekly_source_report_fin_qualifications' and existing->'scope' is not distinct from item->'scope'))) then
        raise exception 'WEEKLY_SOURCE_POST_VERIFIED_AMBIGUOUS_SCOPE_REFUSED' using errcode='23505'; end if;
      if not exists(select 1 from jsonb_array_elements(next_value) existing where existing=item) then next_value:=next_value||jsonb_build_array(item); end if;
    end loop;
  end if;
  next_evidence:=jsonb_set(r.evidence_json,array[slot],next_value,true);
  new_sha:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_RELEASE_EVIDENCE_V1',next_evidence),'hex');
  identity_before:=to_jsonb(r)-'evidence_json';
  if next_evidence is distinct from r.evidence_json then
    update private.cloudtms_database_releases as release_row set evidence_json=next_evidence where release_row.release_id=r.release_id and release_row.status='VERIFIED'
      and release_row.evidence_json=r.evidence_json returning to_jsonb(release_row)-'evidence_json' into identity_after;
    if not found or identity_after is distinct from identity_before then raise exception 'WEEKLY_SOURCE_POST_VERIFIED_IDENTITY_CHANGED' using errcode='40001'; end if;
  end if;
  artifact_sha:=encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_POST_VERIFIED_ARTIFACT_SET_V1',artifact),'hex');
  receipt:=jsonb_build_object('schema_version','WEEKLY_SOURCE_POST_VERIFIED_EVIDENCE_RECEIPT_V1','execution',execution,
    'receipt_input_commit',p_request->>'receipt_input_commit','receipt_tree_sha256',p_request#>>'{receipt_tree_proof,source_equivalence_sha256}',
    'artifact_slot',slot,'artifacts_sha256',artifact_sha,'prior_evidence_sha256',prior_sha,'evidence_sha256',new_sha,
    'actor_user_id',p_actor_user_id,'recorded_at_utc',clock_timestamp(),'replayed',next_evidence=r.evidence_json,
    'operational_settings_changed',false);
  receipt:=receipt||jsonb_build_object('receipt_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_POST_VERIFIED_EVIDENCE_RECEIPT_V1',receipt),'hex'));
  perform public._audit_insert('weekly_source_post_verified_evidence',r.release_id,'WEEKLY_SOURCE_POST_VERIFIED_EVIDENCE_RECORDED',null,
    receipt||jsonb_build_object('artifacts',artifact,'receipt_tree_proof',p_request->'receipt_tree_proof'),p_request->>'reason',p_actor_user_id);
  return receipt;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/12_complete_report_nullable_rounding_owner.sqlinc; raw SHA256 c41ff4b378ab64eb4e566fc552c4f589100e8fab6a6a9f2d4361985b1c3c2312
create or replace function private.weekly_source_vat_rounding_movement_insert_v1(p_final_revision_id uuid,p_client_id uuid,p_identity_movement_id uuid,p_invoice_window_cycle_id uuid)
returns uuid language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare revision public.weekly_source_final_revisions%rowtype; identity_row public.weekly_source_billing_movements%rowtype;
  rules jsonb; net numeric; vat numeric; rate numeric; target numeric; difference bigint; rate_count integer;
  id uuid; pending_hold_rows uuid[]; facts jsonb; pay jsonb; charge jsonb; mapping bytea; h bytea; profile text;
  report_scope public.weekly_source_report_scopes%rowtype; report public.weekly_source_self_bill_reports%rowtype; report_row public.weekly_source_upload_rows%rowtype; report_upload public.weekly_source_uploads%rowtype;
begin
  select * into strict revision from public.weekly_source_final_revisions where weekly_source_final_revisions.id=p_final_revision_id;
  rules:=private.weekly_source_frozen_rule_values_v1(revision.id);
  if rules is null or rules->>'invoice_sender'<>'CLIENT_SELF_BILL' or rules->>'invoice_vat_method'='SUM_OF_LINES' then return null; end if;
  if p_invoice_window_cycle_id is null or not exists(select 1 from public.weekly_source_cycles actual
    join public.weekly_source_cycles original on original.id=revision.source_cycle_id and actual.source_group_id=original.source_group_id
    where actual.id=p_invoice_window_cycle_id and (actual.scope_client_id is null or actual.scope_client_id=p_client_id)) then
    raise exception 'WEEKLY_SOURCE_VAT_ROUNDING_WINDOW_INVALID' using errcode='55000'; end if;
  if revision.state not in ('CURRENT','PREPARED') or p_client_id is null then raise exception 'WEEKLY_SOURCE_VAT_ROUNDING_SCOPE_INVALID' using errcode='55000'; end if;
  select m.id into id from public.weekly_source_billing_movements m where m.vat_rounding_revision_id=revision.id and m.actual_client_id=p_client_id
    and coalesce(m.invoice_window_cycle_id,m.finalisation_cycle_id)=p_invoice_window_cycle_id;
  if found then return id; end if;
  select coalesce(sum(m.invoice_presentation_charge_pence),0),coalesce(sum(m.vat_amount*100),0),min(m.vat_rate_pct),count(distinct m.vat_rate_pct),min(m.source_profile_kind)
    into net,vat,rate,rate_count,profile from public.weekly_source_billing_movements m
    where m.final_revision_id=revision.id and m.actual_client_id=p_client_id and m.source_line_kind<>'INVOICE_VAT_ROUNDING'
      and private.weekly_source_invoice_movement_window_id_v1(m.id)=p_invoice_window_cycle_id;
  if rate_count=0 then return null; end if;
  if rate_count<>1 or profile not in ('SELF_BILL_REPORT','HEALTHROSTER_ACTUAL_ROWS','GENERIC_COMPLETE_SNAPSHOT') then
    raise exception 'WEEKLY_SOURCE_VAT_ROUNDING_RATE_AMBIGUOUS' using errcode='55000'; end if;
  target:=private.weekly_source_invoice_vat_target_pence_v1(net,vat,rules->>'invoice_vat_method',rate);
  if target is null then raise exception 'WEEKLY_SOURCE_VAT_ROUNDING_METHOD_INVALID' using errcode='55000'; end if;
  select array_agg(distinct s.id order by s.id) into pending_hold_rows
    from public.weekly_source_billing_movements m join public.weekly_source_upload_rows s
      on s.id::text=m.source_facts_json->>'upload_row_id'
    where m.final_revision_id=revision.id and m.actual_client_id=p_client_id
      and private.weekly_source_invoice_movement_window_id_v1(m.id)=p_invoice_window_cycle_id
      and m.source_facts_json->>'invoice_hold'='VAT_FIT'
;
  difference:=(target-vat)::bigint;
  -- This proposed zero authority is restricted to unresolved actual VAT_FIT.
  -- D0 with no hold (including Report210825) retains no movement/visible line.
  if difference=0 and pending_hold_rows is null then return null; end if;
  if p_identity_movement_id is not null then
    select * into strict identity_row from public.weekly_source_billing_movements where weekly_source_billing_movements.id=p_identity_movement_id;
    if revision.authority_scope_kind='SELF_BILL_REPORT_SCOPE' and profile='SELF_BILL_REPORT'
      and identity_row.source_profile_kind='SELF_BILL_REPORT' and identity_row.source_line_kind='SELF_BILL_REPORT_LINE' then
      -- REPORT_NATIVE_NULLABLE_ROUNDING_ORIGIN. Clone the actual immutable
      -- Report component, including its existing NULLs. Never substitute pay
      -- identity. Report's native compositor must preserve source ordinal;
      -- actual rendered last-component equality is still a qualification gate.
      select * into strict report_scope from public.weekly_source_report_scopes where id=revision.report_scope_id;
      select * into strict report from public.weekly_source_self_bill_reports where id=report_scope.self_bill_report_id;
      select * into strict report_upload from public.weekly_source_uploads where id=revision.upload_id;
      select * into strict report_row from public.weekly_source_upload_rows where id=identity_row.self_bill_report_row_id;
      if revision.reason is distinct from 'INITIAL_FINALISATION'
        or report_scope.source_cycle_id<>revision.source_cycle_id or report_scope.client_id<>p_client_id
        or report.source_cycle_id<>revision.source_cycle_id or report.client_id<>p_client_id or report.source_group_id<>report_scope.source_group_id
        or report_upload.source_cycle_id<>revision.source_cycle_id or report_upload.report_scope_id is distinct from report_scope.id
        or report_upload.content_sha256 is distinct from report.content_sha256
        or p_invoice_window_cycle_id<>revision.source_cycle_id or identity_row.final_revision_id<>revision.id
        or identity_row.actual_client_id<>p_client_id or identity_row.finalisation_cycle_id<>revision.source_cycle_id
        or private.weekly_source_invoice_movement_window_id_v1(identity_row.id)<>p_invoice_window_cycle_id
        or report_row.upload_id<>revision.upload_id or report_row.row_finalisation_state is distinct from 'SOURCE_REPORT_LINE'
        or identity_row.source_facts_json->>'schema_version' is distinct from 'WEEKLY_SOURCE_SELF_BILL_REPORT_FACTS_V1'
        or identity_row.source_facts_json->>'self_bill_report_id' is distinct from report.id::text
        or identity_row.source_facts_json->>'report_scope_id' is distinct from report_scope.id::text
        or identity_row.source_facts_json->>'upload_row_id' is distinct from report_row.id::text
        or identity_row.source_facts_json->>'source_row_ordinal' is distinct from report_row.source_row_ordinal::text
        or identity_row.source_facts_json->>'rule_set_version_id' is distinct from revision.rule_set_version_id::text
        or identity_row.source_facts_json ? 'row_resolution_id'
        or identity_row.total_pay_ex_vat<>0
        or identity_row.canonical_pay_vector_json is distinct from private.weekly_source_invoice_only_vector_v1('PAY',0)
        or identity_row.invoice_presentation_charge_pence is distinct from report_row.source_shift_charge_pence
        or identity_row.vat_amount*100 is distinct from report_row.source_vat_pence::numeric
        or identity_row.total_inc_vat*100 is distinct from report_row.source_gross_pence::numeric
        or report_row.source_gross_pence::numeric is distinct from report_row.source_shift_charge_pence::numeric+report_row.source_vat_pence::numeric
        or exists(select 1 from public.weekly_source_upload_rows later where later.upload_id=revision.upload_id
          and later.source_row_ordinal>report_row.source_row_ordinal)
        or exists(select 1 from public.weekly_source_billing_movements other where other.final_revision_id=revision.id
          and other.actual_client_id=p_client_id and other.source_line_kind<>'SELF_BILL_REPORT_LINE') then
        raise exception 'WEEKLY_SOURCE_VAT_ROUNDING_REPORT_ORIGIN_INVALID' using errcode='55000'; end if;
    else
    if identity_row.final_revision_id<>revision.id or identity_row.actual_client_id<>p_client_id
      or identity_row.source_line_kind='INVOICE_VAT_ROUNDING' or identity_row.candidate_id is null
      or identity_row.contract_id is null or identity_row.work_event_id is null or identity_row.invoice_timesheet_id is null then
      raise exception 'WEEKLY_SOURCE_VAT_ROUNDING_IDENTITY_INVALID' using errcode='55000'; end if;
    end if;
  end if;
  -- The calling integration must select A(NULL) or B(real last line) only after
  -- hosted admission/render/pay-isolation proof. There is no UI/default choice.
  pay:=private.weekly_source_invoice_only_vector_v1('PAY',0); charge:=private.weekly_source_invoice_only_vector_v1('CHARGE',0);
  facts:=jsonb_build_object('schema_version','WEEKLY_SOURCE_VAT_ROUNDING_FACTS_V1','rule_set_version_id',revision.rule_set_version_id,
    'invoice_vat_method',rules->>'invoice_vat_method','membership_net_pence',net,
    'invoice_window_cycle_id',p_invoice_window_cycle_id,'pending_vat_fit_upload_row_ids',coalesce(to_jsonb(pending_hold_rows),'[]'::jsonb),'membership_vat_pence',vat,
    'target_vat_pence',target,'identity_movement_id',p_identity_movement_id,'description','VAT rounding (matches the client''s self-bill)');
  mapping:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_VAT_ROUNDING_V1',jsonb_build_object('rule_set_version_id',revision.rule_set_version_id));
  h:=private.weekly_source_billing_movement_hash_v1(jsonb_build_object('vat_rounding_revision_id',revision.id,'final_revision_id',revision.id,
    'finalisation_cycle_id',revision.source_cycle_id,'actual_client_id',p_client_id,'candidate_id',identity_row.candidate_id,'contract_id',identity_row.contract_id,
    'work_event_id',identity_row.work_event_id,'movement_role','POSITIVE','prior_movement_id',p_identity_movement_id,'source_profile_kind',profile,
    'source_line_kind','INVOICE_VAT_ROUNDING','source_facts',facts,'pay_vector',pay,'charge_vector',charge,'total_pay_pence',0,
    'calculated_comparison_charge_pence',0,'source_validation_charge_pence',null,'invoice_presentation_charge_pence',0,
    'vat_rate_pct',rate,'vat_amount',difference::numeric/100,'total_inc_vat',difference::numeric/100,'price_check_result','NOT_APPLICABLE',
    'price_check_fingerprint',null,'charge_acceptance_id',null,'mapping_rate_policy_fingerprint',encode(mapping,'hex'),'invoice_timesheet_id',identity_row.invoice_timesheet_id)
    ||case when p_invoice_window_cycle_id=revision.source_cycle_id then '{}'::jsonb else jsonb_build_object('invoice_window_cycle_id',p_invoice_window_cycle_id) end);
  insert into public.weekly_source_billing_movements(vat_rounding_revision_id,invoice_window_cycle_id,final_revision_id,finalisation_cycle_id,actual_client_id,candidate_id,contract_id,work_event_id,
    movement_role,prior_movement_id,source_profile_kind,source_line_kind,source_facts_json,canonical_pay_vector_json,canonical_charge_vector_json,
    total_pay_ex_vat,calculated_comparison_charge_pence,invoice_presentation_charge_pence,vat_rate_pct,vat_amount,total_inc_vat,
    price_check_result,mapping_rate_policy_fingerprint,invoice_timesheet_id,original_cycle_key,movement_economic_hash)
  values(revision.id,case when p_invoice_window_cycle_id=revision.source_cycle_id then null else p_invoice_window_cycle_id end,revision.id,revision.source_cycle_id,p_client_id,identity_row.candidate_id,identity_row.contract_id,identity_row.work_event_id,
    'POSITIVE',p_identity_movement_id,profile,'INVOICE_VAT_ROUNDING',facts,pay,charge,0,0,0,rate,difference::numeric/100,difference::numeric/100,
    'NOT_APPLICABLE',mapping,identity_row.invoice_timesheet_id,revision.source_cycle_id::text,h) returning public.weekly_source_billing_movements.id into id;
  return id;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/11_complete_historical_fixture_native_assignment.sqlinc; raw SHA256 c1e8aa26fbea0b47aa4bd800efb5ca293469deb8363c1f51f61645d731b3b5ac
create or replace function public.weekly_source_group_rule_assign_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_actor uuid; v_agency uuid; v_environment text; v_group_id uuid; v_version_id uuid;
  v_request_id uuid; v_expected bigint; v_from date; v_to date; v_hash text; v_id uuid:=gen_random_uuid(); v_receipt jsonb;
  v_group public.weekly_source_groups%rowtype; v_version public.weekly_source_rule_set_versions%rowtype;
  v_prior public.weekly_source_group_rule_assignments%rowtype;
begin
  perform private._weekly_source_settings_assert_request_v1(p_request,array['actor_user_id','agency_id','environment','source_group_id','rule_set_version_id','effective_from_week_ending','effective_to_week_ending','expected_group_version','request_id'],'WEEKLY_SOURCE_RULE_ASSIGN_REQUEST_INVALID');
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid; v_agency:=(p_request->>'agency_id')::uuid; v_group_id:=(p_request->>'source_group_id')::uuid;
    v_version_id:=nullif(p_request->>'rule_set_version_id','')::uuid; v_request_id:=(p_request->>'request_id')::uuid;
    v_expected:=(p_request->>'expected_group_version')::bigint; v_from:=(p_request->>'effective_from_week_ending')::date;
    v_to:=nullif(p_request->>'effective_to_week_ending','')::date;
  exception when others then raise exception 'WEEKLY_SOURCE_RULE_ASSIGN_REQUEST_INVALID' using errcode='22023'; end;
  perform private._weekly_source_settings_require_admin_v1(v_actor);
  v_environment:=private._weekly_source_settings_deployment_v1(v_agency,p_request->>'environment');
  if v_group_id is null or v_request_id is null or v_expected is null or v_expected<1 or v_from is null
    or p_request->>'effective_from_week_ending'<>to_char(v_from,'YYYY-MM-DD')
    or (v_to is not null and (p_request->>'effective_to_week_ending'<>to_char(v_to,'YYYY-MM-DD') or v_to<v_from or (v_to-v_from)%7<>0))
    or not p_request ? 'rule_set_version_id' then raise exception 'WEEKLY_SOURCE_RULE_ASSIGN_REQUEST_INVALID' using errcode='22023'; end if;
  v_hash:=encode(extensions.digest(convert_to(p_request::text,'UTF8'),'sha256'),'hex');
  -- Same lifecycle gate as cycle creation; lock cycles too, as finalisation
  -- holds the cycle row even when no group lock is needed by its old owner.
  perform pg_advisory_xact_lock(hashtextextended('weekly-source-cycle-lifecycle:'||v_group_id::text,0));
  select * into v_group from public.weekly_source_groups where id=v_group_id for update;
  if not found or v_group.agency_id<>v_agency or v_group.environment<>v_environment or not v_group.active or v_group.source_family<>'ROSTER' then
    raise exception 'WEEKLY_SOURCE_RULE_GROUP_NOT_APPLICABLE' using errcode='22023'; end if;
  select * into v_prior from public.weekly_source_group_rule_assignments where source_group_id=v_group_id and assignment_request_id=v_request_id;
  if found then
    if v_prior.assignment_request_sha256<>v_hash then raise exception 'WEEKLY_SOURCE_RULE_REQUEST_REUSED' using errcode='22023'; end if;
    return v_prior.assignment_receipt_json||jsonb_build_object('replayed',true);
  end if;
  if v_group.version<>v_expected then raise exception 'WEEKLY_SOURCE_RULE_GROUP_STALE' using errcode='40001'; end if;
  if v_from<(transaction_timestamp() at time zone 'Europe/London')::date then
    -- Only the owner-XID audit of a fresh disabled historical TEST fixture
    -- substitutes this date assertion. All native guards below remain.
    perform private.weekly_source_historical_fixture_assignment_assert_v1(p_request);
  end if;
  perform 1 from public.weekly_source_cycles c where c.source_group_id=v_group_id and c.finalisation_week_ending>=v_from
    and c.finalisation_week_ending<=coalesce(v_to,'infinity'::date) order by c.id for update;
  if exists(select 1 from public.weekly_source_cycles c where c.source_group_id=v_group_id
    and c.finalisation_week_ending between v_from and coalesce(v_to,'infinity'::date)
    and (c.current_final_revision_id is not null or c.state in ('FINALISING','FINALISED','CORRECTION_IN_PROGRESS')
      or exists(select 1 from public.weekly_source_final_revisions f where f.source_cycle_id=c.id))) then
    raise exception 'WEEKLY_SOURCE_RULE_FINALISED_WEEK_REFUSED' using errcode='55000'; end if;
  if v_version_id is not null then
    select v.* into v_version from public.weekly_source_rule_set_versions v join public.weekly_source_rule_sets r on r.id=v.rule_set_id
      where v.id=v_version_id and r.agency_id=v_agency and r.environment=v_environment;
    if not found then raise exception 'WEEKLY_SOURCE_RULE_VERSION_NOT_FOUND' using errcode='22023'; end if;
    perform private._weekly_source_rule_group_context_v1(v_group_id,v_from,v_to,v_version.values_json,false);
  end if;
  -- A new choice clips only an earlier open assignment. Future overlapping
  -- choices and same-start replacements need an explicit new range decision.
  select * into v_prior from public.weekly_source_group_rule_assignments a where a.source_group_id=v_group_id
    and daterange(a.effective_from_week_ending,coalesce(a.effective_to_week_ending,'infinity'::date),'[]')
      && daterange(v_from,coalesce(v_to,'infinity'::date),'[]') order by a.effective_from_week_ending for update;
  if found then
    if v_prior.feature_enabled and exists(select 1 from public.weekly_source_rule_set_versions v
      where v.id=v_prior.rule_set_version_id and v.values_json->>'invoice_sender'='AGENCY_INVOICE') then
      raise exception 'WEEKLY_SOURCE_RULE_ACTIVE_AGENCY_TRANSITION_REQUIRED' using errcode='55000'; end if;
    if v_prior.effective_from_week_ending>=v_from or v_prior.effective_to_week_ending is not null
      or (v_from-v_prior.effective_from_week_ending)%7<>0
      or exists(select 1 from public.weekly_source_group_rule_assignments a where a.source_group_id=v_group_id
        and a.id<>v_prior.id and daterange(a.effective_from_week_ending,coalesce(a.effective_to_week_ending,'infinity'::date),'[]')
          && daterange(v_from,coalesce(v_to,'infinity'::date),'[]')) then
      raise exception 'WEEKLY_SOURCE_RULE_ASSIGNMENT_OVERLAP' using errcode='22023'; end if;
    update public.weekly_source_group_rule_assignments set effective_to_week_ending=v_from-7,version=version+1 where id=v_prior.id;
  end if;
  update public.weekly_source_groups set version=version+1,updated_by_user_id=v_actor,updated_at_utc=transaction_timestamp()
    where id=v_group_id returning * into v_group;
  v_receipt:=jsonb_build_object('contract','WEEKLY_SOURCE_RULE_ASSIGNED_V1','assignment_id',v_id,'assignment_version',1,
    'source_group_id',v_group_id,'source_group_version',v_group.version,'rule_set_version_id',v_version_id,
    'effective_from_week_ending',v_from,'effective_to_week_ending',v_to,'feature_enabled',false,'replayed',false);
  insert into public.weekly_source_group_rule_assignments(id,source_group_id,rule_set_version_id,effective_from_week_ending,effective_to_week_ending,
    assignment_request_id,assignment_request_sha256,assignment_receipt_json,created_by_user_id)
    values(v_id,v_group_id,v_version_id,v_from,v_to,v_request_id,v_hash,v_receipt,v_actor);
  return v_receipt;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/09_complete_controlled_setup_transport.sqlinc; raw SHA256 5af440278222cf223ef4bcfc8b75c9d7f24828ed135366148d2ec4c85c3f910f
-- Complete isolated source proposal. Root review and native proofs pending.
create or replace function public.weekly_source_group_rule_feature_set_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare v_actor uuid; v_agency uuid; v_environment text; v_group_id uuid; v_assignment_id uuid; v_version_id uuid;
  v_request_id uuid; v_expected bigint; v_enabled boolean; v_from date; v_release_id text; v_reason text; v_purpose text; v_hash text; v_receipt jsonb;
  v_group public.weekly_source_groups%rowtype; v_assignment public.weekly_source_group_rule_assignments%rowtype;
  v_latest private.cloudtms_database_releases%rowtype; v_values jsonb;
  v_member record; v_manifest jsonb; v_shape jsonb; v_result jsonb; v_changes jsonb:='[]'::jsonb;
  v_entry jsonb; v_apply_values jsonb; v_scope_date date; v_agency_invoice boolean:=false; v_qualification jsonb;
begin
  if p_request->>'qualification_action' in ('OFF_RULE_OPEN','OFF_RULE_CLOSE','OFF_RULE_REVOKE') then
    return private.weekly_source_rule_qualification_setup_atomic_v1(p_request);
  elsif p_request->>'qualification_action'='OFF_RULE_COMMAND' then
    return private.weekly_source_rule_qualification_execute_v1(p_request);
  elsif p_request->>'qualification_action'='OFF_RULE_TRANSPORT_STATUS' then
    return private.weekly_source_rule_qualification_transport_status_v1(p_request);
  elsif p_request->>'qualification_action'='OFF_RULE_STATUS' then
    return private.weekly_source_rule_qualification_status_v1(p_request);
  end if;
  if p_request ? 'qualification_action' then
    return private.weekly_source_protected_test_setup_atomic_v1(p_request);
  end if;
  perform private._weekly_source_settings_assert_request_v1(p_request,array['actor_user_id','agency_id','environment','source_group_id','assignment_id',
    'rule_set_version_id','effective_from_week_ending','expected_assignment_version','feature_enabled','feature_purpose','release_id','reason','request_id',
    'client_settings_versions','protected_capability_qualification_sha256','activation_probe_scope_id'],'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID');
  begin
    v_actor:=(p_request->>'actor_user_id')::uuid; v_agency:=(p_request->>'agency_id')::uuid; v_group_id:=(p_request->>'source_group_id')::uuid;
    v_assignment_id:=(p_request->>'assignment_id')::uuid; v_version_id:=nullif(p_request->>'rule_set_version_id','')::uuid;
    v_request_id:=(p_request->>'request_id')::uuid; v_expected:=(p_request->>'expected_assignment_version')::bigint;
    v_enabled:=(p_request->>'feature_enabled')::boolean; v_from:=(p_request->>'effective_from_week_ending')::date;
    v_release_id:=p_request->>'release_id'; v_reason:=btrim(p_request->>'reason'); v_purpose:=p_request->>'feature_purpose';
  exception when others then raise exception 'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID' using errcode='22023'; end;
  perform private._weekly_source_settings_require_admin_v1(v_actor);
  v_environment:=private._weekly_source_settings_deployment_v1(v_agency,p_request->>'environment');
  if v_group_id is null or v_assignment_id is null or v_request_id is null or v_expected is null or v_from is null
    or jsonb_typeof(p_request->'feature_enabled') is distinct from 'boolean'
    or not p_request ? 'rule_set_version_id' or v_release_id is null or v_reason is null or char_length(v_reason) not between 1 and 500
    or v_purpose is null or v_purpose not in ('RULE_SET','SIGNED_CHECK_ONLY','PROTECTED_SOURCE') or (v_version_id is null)<>(v_purpose in ('SIGNED_CHECK_ONLY','PROTECTED_SOURCE'))
    or p_request->>'effective_from_week_ending'<>to_char(v_from,'YYYY-MM-DD') then
    raise exception 'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID' using errcode='22023'; end if;
  if p_request ? 'protected_capability_qualification_sha256' and
    (jsonb_typeof(p_request->'protected_capability_qualification_sha256') is distinct from 'string'
      or coalesce(p_request->>'protected_capability_qualification_sha256','') !~ '^[0-9a-f]{64}$') then
    raise exception 'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID' using errcode='22023'; end if;
  if v_purpose in ('RULE_SET','PROTECTED_SOURCE') and v_enabled and not(p_request ? 'protected_capability_qualification_sha256') and not(p_request ? 'activation_probe_scope_id') then
    raise exception 'WEEKLY_SOURCE_PROTECTED_CAPABILITY_RELEASE_UNQUALIFIED' using errcode='55000'; end if;
  if p_request ? 'activation_probe_scope_id' then
    if v_purpose is distinct from 'PROTECTED_SOURCE' or v_enabled is distinct from true or v_version_id is not null
      or p_request ? 'protected_capability_qualification_sha256' then
      raise exception 'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID' using errcode='22023'; end if;
    perform private.weekly_source_protected_activation_probe_assert_v1((p_request->>'activation_probe_scope_id')::uuid,
      v_actor,v_group_id,v_from,(select effective_to_week_ending from public.weekly_source_group_rule_assignments where id=v_assignment_id),v_assignment_id);
  end if;
  if v_purpose='SIGNED_CHECK_ONLY' and p_request ? 'protected_capability_qualification_sha256' then
    raise exception 'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID' using errcode='22023'; end if;
  v_hash:=encode(extensions.digest(convert_to(p_request::text,'UTF8'),'sha256'),'hex');
  perform pg_advisory_xact_lock(hashtextextended('weekly-source-cycle-lifecycle:'||v_group_id::text,0));
  -- Match the Client owner's client-before-group lock order. Recheck the exact
  -- dated membership after taking the group/assignment locks below.
  if (select count(distinct gc.client_id) from public.weekly_source_group_clients gc
    where gc.source_group_id=v_group_id and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]')
      && daterange(v_from-6,'infinity'::date,'[]'))>100 then
    raise exception 'WEEKLY_SOURCE_RULE_ACTIVATION_SCOPE_TOO_LARGE' using errcode='22023'; end if;
  for v_member in select distinct gc.client_id from public.weekly_source_group_clients gc
    where gc.source_group_id=v_group_id and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]')
      && daterange(v_from-6,'infinity'::date,'[]') order by gc.client_id
  loop
    perform pg_advisory_xact_lock(hashtextextended('weekly-source-settings-client:'||v_member.client_id::text,0));
  end loop;
  select * into v_group from public.weekly_source_groups where id=v_group_id for update;
  if not found or v_group.agency_id<>v_agency or v_group.environment<>v_environment or not v_group.active or v_group.source_family<>'ROSTER' then
    raise exception 'WEEKLY_SOURCE_RULE_GROUP_NOT_APPLICABLE' using errcode='22023'; end if;
  select * into v_assignment from public.weekly_source_group_rule_assignments where id=v_assignment_id and source_group_id=v_group_id for update;
  if not found or v_assignment.rule_set_version_id is distinct from v_version_id or v_assignment.effective_from_week_ending<>v_from then
    raise exception 'WEEKLY_SOURCE_RULE_ASSIGNMENT_NOT_FOUND' using errcode='22023'; end if;
  -- Latest record, not latest successful record: an APPLYING/FAILED successor holds activation.
  select * into v_latest from private.cloudtms_database_releases order by started_at_utc desc,release_id desc limit 1;
  if not found or v_latest.release_id<>v_release_id or v_latest.status<>'VERIFIED'
    or v_latest.completed_at_utc is null or v_latest.installed_contract_sha256 is distinct from v_latest.repository_contract_sha256 then
    raise exception 'WEEKLY_SOURCE_RULE_VERIFIED_RELEASE_REQUIRED' using errcode='55000'; end if;
  if v_assignment.feature_request_id=v_request_id then
    if v_assignment.feature_request_sha256<>v_hash then raise exception 'WEEKLY_SOURCE_RULE_REQUEST_REUSED' using errcode='22023'; end if;
    if v_assignment.feature_enabled and v_assignment.feature_receipt_json ? 'protected_capability_qualification' then
      if p_request ? 'activation_probe_scope_id' then
        perform private.weekly_source_protected_activation_probe_assert_v1((p_request->>'activation_probe_scope_id')::uuid,
          v_actor,v_group_id,v_from,v_assignment.effective_to_week_ending,v_assignment_id);
      else
        perform private.weekly_source_protected_operational_certificate_assert_v1(
          v_assignment.feature_receipt_json->'protected_capability_qualification',v_group_id,v_from,v_assignment.effective_to_week_ending,
          v_assignment.feature_receipt_json#>>'{protected_capability_qualification,qualification_sha256}');
      end if;
    end if;
    return v_assignment.feature_receipt_json||jsonb_build_object('replayed',true);
  end if;
  if v_assignment.version<>v_expected then raise exception 'WEEKLY_SOURCE_RULE_ASSIGNMENT_STALE' using errcode='40001'; end if;
  perform 1 from public.clients c where exists(select 1 from public.weekly_source_group_clients gc
    where gc.client_id=c.id and gc.source_group_id=v_group_id
      and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]') && daterange(v_from-6,coalesce(v_assignment.effective_to_week_ending,'infinity'::date),'[]'))
    order by c.id for update;
  perform 1 from public.client_settings cs where exists(select 1 from public.weekly_source_group_clients gc
    where gc.client_id=cs.client_id and gc.source_group_id=v_group_id
      and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]') && daterange(v_from-6,coalesce(v_assignment.effective_to_week_ending,'infinity'::date),'[]'))
    order by cs.id for update;
  perform 1 from public.contracts c where exists(select 1 from public.weekly_source_group_clients gc
    where gc.client_id=c.client_id and gc.source_group_id=v_group_id
      and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]') && daterange(v_from-6,coalesce(v_assignment.effective_to_week_ending,'infinity'::date),'[]'))
    order by c.id for share;
  -- Same owner requalification is metadata-only. Exact current assignment CAS,
  -- actor/deployment/latest VERIFIED and locked Client/Contract gates above stay.
  if p_request ? 'activation_probe_scope_id' then
    v_qualification:=private.weekly_source_protected_activation_probe_assert_v1((p_request->>'activation_probe_scope_id')::uuid,
      v_actor,v_group_id,v_from,v_assignment.effective_to_week_ending,v_assignment_id);
  elsif v_enabled and p_request ? 'protected_capability_qualification_sha256' then
    v_qualification:=private.weekly_source_protected_capability_release_evidence_v1(v_group_id,v_from,
      v_assignment.effective_to_week_ending,p_request->>'protected_capability_qualification_sha256');
    perform private.weekly_source_protected_operational_certificate_assert_v1(v_qualification,v_group_id,v_from,
      v_assignment.effective_to_week_ending,p_request->>'protected_capability_qualification_sha256');
  elsif p_request ? 'protected_capability_qualification_sha256' then
    raise exception 'WEEKLY_SOURCE_RULE_FEATURE_REQUEST_INVALID' using errcode='22023'; end if;
  if v_assignment.feature_enabled=v_enabled then
    if not v_enabled or v_qualification is null or v_assignment.feature_purpose is distinct from v_purpose then
      raise exception 'WEEKLY_SOURCE_RULE_FEATURE_ALREADY_SET' using errcode='22023'; end if;
    if v_purpose='PROTECTED_SOURCE' then
      perform private.weekly_source_protected_source_activation_scope_v1(v_group_id,v_from,v_assignment.effective_to_week_ending);
    else
      select values_json into strict v_values from public.weekly_source_rule_set_versions where id=v_version_id;
      perform private._weekly_source_rule_group_context_v1(v_group_id,v_from,v_assignment.effective_to_week_ending,v_values,true);
    end if;
    if p_request ? 'client_settings_versions' and p_request->'client_settings_versions'<>'[]'::jsonb then
      raise exception 'WEEKLY_SOURCE_RULE_CLIENT_CAS_MANIFEST_INVALID' using errcode='22023'; end if;
    -- Preserve the exact AGENCY restore receipt, without calling Client save.
    v_receipt:=v_assignment.feature_receipt_json||jsonb_build_object('assignment_version',v_assignment.version+1,
      'release_id',v_release_id,'actor_user_id',v_actor,'changed_at_utc',transaction_timestamp(),'reason',v_reason,
      'request_id',v_request_id,'protected_capability_qualification',v_qualification,'requalification',true,'replayed',false);
    update public.weekly_source_group_rule_assignments set feature_changed_by_user_id=v_actor,
      feature_changed_at_utc=transaction_timestamp(),feature_change_reason=v_reason,feature_release_id=v_release_id,
      feature_request_id=v_request_id,feature_request_sha256=v_hash,feature_receipt_json=v_receipt,version=version+1 where id=v_assignment_id;
    return v_receipt;
  end if;
  select v.values_json into v_values from public.weekly_source_rule_set_versions v join public.weekly_source_rule_sets r on r.id=v.rule_set_id
    where v.id=v_version_id and r.agency_id=v_agency and r.environment=v_environment;
  if v_version_id is not null and not found then raise exception 'WEEKLY_SOURCE_RULE_VERSION_NOT_FOUND' using errcode='22023'; end if;
  v_agency_invoice:=coalesce(v_values->>'invoice_sender'='AGENCY_INVOICE',false);
  if v_agency_invoice then
    v_manifest:=p_request->'client_settings_versions';
    if jsonb_typeof(v_manifest) is distinct from 'array' or jsonb_array_length(v_manifest) not between 1 and 100 then
      raise exception 'WEEKLY_SOURCE_RULE_CLIENT_CAS_MANIFEST_REQUIRED' using errcode='22023'; end if;
    for v_entry in select value from jsonb_array_elements(v_manifest) loop
      perform private._weekly_source_settings_assert_request_v1(v_entry,array['client_id','expected_settings_version'],'WEEKLY_SOURCE_RULE_CLIENT_CAS_MANIFEST_INVALID');
      if jsonb_typeof(v_entry->'client_id') is distinct from 'string' or v_entry->>'client_id' !~ '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$'
        or jsonb_typeof(v_entry->'expected_settings_version') is distinct from 'string'
        or v_entry->>'expected_settings_version' !~ '^[0-9a-f]{64}$' then
        raise exception 'WEEKLY_SOURCE_RULE_CLIENT_CAS_MANIFEST_INVALID' using errcode='22023'; end if;
    end loop;
    if (select count(distinct value->>'client_id') from jsonb_array_elements(v_manifest))<>jsonb_array_length(v_manifest)
      or (select count(distinct gc.client_id) from public.weekly_source_group_clients gc where gc.source_group_id=v_group_id
        and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]') && daterange(v_from-6,coalesce(v_assignment.effective_to_week_ending,'infinity'::date),'[]'))<>jsonb_array_length(v_manifest)
      or exists(select 1 from jsonb_array_elements(v_manifest) x where not exists(select 1 from public.weekly_source_group_clients gc
        where gc.source_group_id=v_group_id and gc.client_id=(x.value->>'client_id')::uuid
          and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]') && daterange(v_from-6,coalesce(v_assignment.effective_to_week_ending,'infinity'::date),'[]'))) then
      raise exception 'WEEKLY_SOURCE_RULE_CLIENT_CAS_MANIFEST_INVALID' using errcode='22023'; end if;
    for v_member in select gc.client_id,greatest(v_from-6,min(gc.valid_from)) as scope_date
      from public.weekly_source_group_clients gc where gc.source_group_id=v_group_id
        and daterange(gc.valid_from,coalesce(gc.valid_to,'infinity'::date),'[]') && daterange(v_from-6,coalesce(v_assignment.effective_to_week_ending,'infinity'::date),'[]')
      group by gc.client_id order by gc.client_id
    loop
      v_scope_date:=v_member.scope_date;
      if v_scope_date<(transaction_timestamp() at time zone 'Europe/London')::date then
        raise exception 'WEEKLY_SOURCE_RULE_FUTURE_WEEK_REQUIRED' using errcode='22023'; end if;
      v_shape:=private._weekly_source_settings_client_shape_v1(v_agency,v_environment,v_member.client_id,v_scope_date);
      if v_shape->>'settings_version'<>(select value->>'expected_settings_version' from jsonb_array_elements(v_manifest) where (value->>'client_id')::uuid=v_member.client_id) then
        raise exception 'WEEKLY_SOURCE_RULE_CLIENT_SETTINGS_STALE' using errcode='40001'; end if;
      if v_enabled then
        if exists(select 1 from public.weekly_source_client_policies cp where cp.source_group_id=v_group_id and cp.client_id=v_member.client_id
          and cp.effective_from>v_scope_date and cp.effective_from<=coalesce(v_assignment.effective_to_week_ending,'infinity'::date)) then
          raise exception 'WEEKLY_SOURCE_RULE_ACTIVATION_FUTURE_SETTINGS_REFUSED' using errcode='22023'; end if;
        v_changes:=v_changes||jsonb_build_array(jsonb_build_object('client_id',v_member.client_id,'scope_date',v_scope_date,
          'before_values',v_shape->'settings','before_settings_version',v_shape->>'settings_version',
          'before_policy_id',(select cp.id from public.weekly_source_client_policies cp where cp.source_group_id=v_group_id and cp.client_id=v_member.client_id
            and v_scope_date between cp.effective_from and coalesce(cp.effective_to,'infinity'::date))));
      else
        select value into v_entry from jsonb_array_elements(v_assignment.feature_receipt_json->'client_changes')
          where (value->>'client_id')::uuid=v_member.client_id;
        if not found or v_entry->>'after_settings_version' is distinct from v_shape->>'settings_version'
          or (v_entry->>'scope_date')::date<>v_scope_date then
          raise exception 'WEEKLY_SOURCE_RULE_CLIENT_RESTORE_STALE' using errcode='40001'; end if;
        v_changes:=v_changes||jsonb_build_array(v_entry);
      end if;
    end loop;
  elsif p_request ? 'client_settings_versions' and p_request->'client_settings_versions'<>'[]'::jsonb then
    raise exception 'WEEKLY_SOURCE_RULE_CLIENT_CAS_MANIFEST_INVALID' using errcode='22023';
  end if;
  if v_enabled then
    if v_from<(transaction_timestamp() at time zone 'Europe/London')::date then
      raise exception 'WEEKLY_SOURCE_RULE_FUTURE_WEEK_REQUIRED' using errcode='22023'; end if;
    perform 1 from public.weekly_source_cycles c where c.source_group_id=v_group_id
      and c.finalisation_week_ending between v_from and coalesce(v_assignment.effective_to_week_ending,'infinity'::date) order by c.id for update;
    if exists(select 1 from public.weekly_source_cycles c where c.source_group_id=v_group_id
      and c.finalisation_week_ending between v_from and coalesce(v_assignment.effective_to_week_ending,'infinity'::date)
      and (c.current_final_revision_id is not null or c.state in ('FINALISING','FINALISED','CORRECTION_IN_PROGRESS')
        or exists(select 1 from public.weekly_source_final_revisions f where f.source_cycle_id=c.id))) then
      raise exception 'WEEKLY_SOURCE_RULE_FINALISED_WEEK_REFUSED' using errcode='55000'; end if;
    if v_purpose='PROTECTED_SOURCE' then
      perform private.weekly_source_protected_source_activation_scope_v1(v_group_id,v_from,v_assignment.effective_to_week_ending);
    else
      perform private._weekly_source_rule_group_context_v1(v_group_id,v_from,v_assignment.effective_to_week_ending,v_values,not v_agency_invoice);
    end if;
  end if;
  -- Publish the gate and the approved Client policy transition together. The
  -- feature receipt and Client writes cannot survive any refusal below.
  update public.weekly_source_group_rule_assignments set feature_enabled=v_enabled,feature_purpose=v_purpose,
    feature_changed_by_user_id=v_actor,feature_changed_at_utc=transaction_timestamp(),feature_change_reason=v_reason,feature_release_id=v_release_id,
    feature_request_id=v_request_id,feature_request_sha256=v_hash,feature_receipt_json='{}'::jsonb where id=v_assignment_id;
  if v_agency_invoice then
    v_manifest:='[]'::jsonb;
    for v_entry in select value from jsonb_array_elements(v_changes) order by value->>'client_id' loop
      v_scope_date:=(v_entry->>'scope_date')::date;
      v_shape:=private._weekly_source_settings_client_shape_v1(v_agency,v_environment,(v_entry->>'client_id')::uuid,v_scope_date);
      v_apply_values:=v_entry->'before_values'||jsonb_build_object('effective_from',v_scope_date);
      if v_enabled then v_apply_values:=v_apply_values||jsonb_build_object('authority_mode','SOURCE_AUTHORITY','document_mode','CHECK_ONLY','self_bill_enabled',false); end if;
      v_result:=public.weekly_source_client_settings_save_atomic_v1(jsonb_build_object('actor_user_id',v_actor,'agency_id',v_agency,'environment',v_environment,
        'client_id',v_entry->>'client_id','expected_settings_version',v_shape->>'settings_version','settings',v_apply_values));
      if coalesce((v_result->>'ok')::boolean,false) is not true then raise exception 'WEEKLY_SOURCE_RULE_CLIENT_TRANSITION_FAILED' using errcode='55000'; end if;
      v_shape:=private._weekly_source_settings_client_shape_v1(v_agency,v_environment,(v_entry->>'client_id')::uuid,v_scope_date);
      v_manifest:=v_manifest||jsonb_build_array(v_entry||jsonb_build_object(
        case when v_enabled then 'after_values' else 'restored_values' end,v_shape->'settings',
        case when v_enabled then 'after_settings_version' else 'restored_settings_version' end,v_shape->>'settings_version',
        case when v_enabled then 'after_policy_id' else 'restored_policy_id' end,(select cp.id from public.weekly_source_client_policies cp
          where cp.source_group_id=v_group_id and cp.client_id=(v_entry->>'client_id')::uuid
            and v_scope_date between cp.effective_from and coalesce(cp.effective_to,'infinity'::date))));
    end loop;
    v_changes:=v_manifest;
    if v_enabled then perform private._weekly_source_rule_group_context_v1(v_group_id,v_from,v_assignment.effective_to_week_ending,v_values,true); end if;
  end if;
  v_receipt:=jsonb_build_object('contract','WEEKLY_SOURCE_RULE_FEATURE_RECEIPT_V1','assignment_id',v_assignment_id,
    'assignment_version',v_assignment.version+1,'source_group_id',v_group_id,'rule_set_version_id',v_version_id,
    'effective_from_week_ending',v_from,'feature_enabled',v_enabled,'feature_purpose',v_purpose,'release_id',v_release_id,
    'actor_user_id',v_actor,'changed_at_utc',transaction_timestamp(),'reason',v_reason,'request_id',v_request_id,'client_changes',v_changes,'replayed',false)||case when v_qualification is null then '{}'::jsonb else
      jsonb_build_object('protected_capability_qualification',v_qualification) end;
  update public.weekly_source_group_rule_assignments set feature_enabled=v_enabled,feature_purpose=v_purpose,
    feature_changed_by_user_id=v_actor,feature_changed_at_utc=transaction_timestamp(),feature_change_reason=v_reason,feature_release_id=v_release_id,
    feature_request_id=v_request_id,feature_request_sha256=v_hash,feature_receipt_json=v_receipt,version=version+1 where id=v_assignment_id;
  return v_receipt;
end;
$function$;


-- Frozen Money d4b62cb15159d0afb02cfebf8c1e034c68c26550:docs/healthroster-build/proposals/strict-qualification-native-interfaces/OWNER_ONLY_ADDITIONS_ACL.sqlinc; raw SHA256 acfbbf1b156ac7d9183185ed52b4b240f4543b404498732510e9ad526a2f6a25
-- New private owners only. Root reasserts its complete existing service/private union after composition.
alter function private.weekly_source_rule_qualification_authorization_v1(uuid,uuid,text) owner to "postgres";
