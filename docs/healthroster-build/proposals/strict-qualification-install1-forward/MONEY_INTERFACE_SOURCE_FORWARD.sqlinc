alter function private.weekly_source_operational_effective_rule_set_v1(uuid,uuid) owner to "postgres";
revoke all on function private.weekly_source_operational_effective_rule_set_v1(uuid,uuid) from PUBLIC,anon,authenticated,service_role,authenticator,supabase_admin;
