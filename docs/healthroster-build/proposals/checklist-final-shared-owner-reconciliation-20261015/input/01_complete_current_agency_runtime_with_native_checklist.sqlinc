-- Exact selected runtime component 19: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/17_61_agency_authorised_native_observation.sqlinc
-- Mounted only through complete native E26/frame/assert/observe successors.
-- VALIDATION is an authorised canonical queued recompute, not a paid edit.
create or replace function private.weekly_source_agency_validation_frame_open_v1(p_request_id uuid,p_snapshot jsonb,p_outbox_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype; context jsonb; frame jsonb;
begin
 context:=private.weekly_source_agency_validation_context_v1(p_request_id);
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id for update;
 if context->>'outbox_id' is distinct from p_outbox_id::text then raise exception 'AGENCY_CHANGE_NATIVE_OUTBOX_CHANGED' using errcode='40001';end if;
 perform private.weekly_source_agency_snapshot_provenance_assert_v1(r.id,p_snapshot);
 -- The actual canonical builder does not emit an approval timestamp. The
 -- unchanged E26 lifecycle owner preserves it from native TS/TF authority;
 -- observe() verifies that real post-write timestamp, never invents one here.
 if p_snapshot->>'processing_status' is distinct from case when context->'week_complete'='true'::jsonb
   then 'READY_FOR_INVOICE' else 'READY_FOR_HR' end then
  raise exception 'AGENCY_CHANGE_VALIDATION_SNAPSHOT_LIFECYCLE_INVALID' using errcode='55000';end if;
 frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_AUTHORISED_WRITE_FRAME_V1','request_id',r.id,
  'request_sha256',encode(r.request_sha256,'hex'),'mode','AUTHORISED_VALIDATION','transaction_id',pg_current_xact_id()::text,
  'backend_pid',pg_backend_pid(),'phase_actor_user_id',r.updated_by_user_id,'timesheet_id',r.current_timesheet_id,
  'timesheet_version',r.current_timesheet_version,'prior_financial_id',r.current_financial_id,'outbox_id',p_outbox_id,
  'prior_financial_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_VALIDATION_PRIOR_ROW_V1',
   context#>'{context,out_cur_fin}'-array['is_current','updated_at']),'hex'),
  'timesheet_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_VALIDATION_TIMESHEET_V1',context#>'{context,out_timesheet}'),'hex'),
  'snapshot_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_CANONICAL_SNAPSHOT_V1',p_snapshot),'hex'),
  'publication_id',r.source_publication_id,'facts_sha256',context->'week_facts_sha256',
  'validation_actor_user_id',context->'validation_actor_user_id','source_cas',r.source_cas);
 update private.weekly_source_agency_timesheet_change_requests set native_receipts=native_receipts||jsonb_build_object('validation_write_frame',frame),
  version=version+1,updated_at_utc=transaction_timestamp() where id=r.id;
 return frame;
end;
$function$;
alter function private.weekly_source_agency_validation_frame_open_v1(uuid,jsonb,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_validation_frame_open_v1(uuid,jsonb,uuid) from public,anon,authenticated,service_role;

create or replace function private.weekly_source_agency_validation_write_assert_v1(p_timesheet_id uuid,p_snapshot jsonb,p_actor_user_id uuid,p_outbox_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype; t public.timesheets%rowtype;
 f public.timesheets_financials%rowtype; frame jsonb; facts jsonb; v public.timesheet_validations%rowtype;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where current_timesheet_id=p_timesheet_id and state='ACTIVE';
 frame:=r.native_receipts->'validation_write_frame';
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict f from public.timesheets_financials where id=r.current_financial_id and is_current;
 select * into strict v from public.timesheet_validations where timesheet_id=p_timesheet_id;
 facts:=private.weekly_source_agency_week_facts_v1(p_timesheet_id);
 if r.phase<>'AUTHORISED' or frame->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_AUTHORISED_WRITE_FRAME_V1'
  or frame->>'mode' is distinct from 'AUTHORISED_VALIDATION' or frame->>'transaction_id' is distinct from pg_current_xact_id()::text
  or frame->>'backend_pid' is distinct from pg_backend_pid()::text or frame->>'request_id' is distinct from r.id::text
  or frame->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
  or frame->>'phase_actor_user_id' is distinct from r.updated_by_user_id::text
  or frame->>'timesheet_id' is distinct from t.timesheet_id::text or frame->>'timesheet_version' is distinct from t.version::text
  or frame->'source_cas' is distinct from r.source_cas or r.source_cas is distinct from private.weekly_source_bulk_source_cas_v1(r.source_cycle_id,array[r.client_id])
  or p_outbox_id is null or frame->>'outbox_id' is distinct from p_outbox_id::text or p_outbox_id is distinct from r.outbox_id
  or r.outbox_reason is distinct from 'CONTEXT_CHANGED'::public.ts_fin_reason_enum
  or p_snapshot is null or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_CANONICAL_SNAPSHOT_V1',p_snapshot),'hex')
    is distinct from frame->>'snapshot_sha256'
  or (p_actor_user_id is not null and p_actor_user_id is distinct from r.updated_by_user_id)
  or f.paid_at_utc is not null or f.locked_by_invoice_id is not null or f.id::text is distinct from frame->>'prior_financial_id'
  or f.timesheet_version is distinct from t.version or t.authorised_at_server is null or t.revoked_at is not null
  or f.authorised_at_utc is distinct from t.authorised_at_server
  or f.authorised_by_user_id::text is distinct from r.native_receipts#>>'{authorise,phase_actor_user_id}'
  or frame->>'timesheet_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('AGENCY_VALIDATION_TIMESHEET_V1',to_jsonb(t)),'hex')
  or frame->>'prior_financial_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('AGENCY_VALIDATION_PRIOR_ROW_V1',to_jsonb(f)-array['is_current','updated_at']),'hex')
  or frame->>'facts_sha256' is distinct from facts->>'facts_hash'
  or v.validation_source_kind is distinct from 'AGENCY_INVOICE_WEEK' or v.last_source is not null
  or v.validation_source_publication_id is distinct from r.source_publication_id
  or encode(v.validation_source_facts_sha256,'hex') is distinct from facts->>'facts_hash'
  or not exists(select 1 from public.ts_financials_outbox q where q.id=p_outbox_id and q.timesheet_id=p_timesheet_id
    and q.reason=r.outbox_reason and q.attempt_count>=1 and q.next_attempt_at>transaction_timestamp()) then
  raise exception 'AGENCY_CHANGE_GENUINE_AUTHORISED_WRITE_FRAME_REQUIRED' using errcode='55000';end if;
 perform private.weekly_source_agency_snapshot_provenance_assert_v1(r.id,p_snapshot);
 return frame;
end;
$function$;
alter function private.weekly_source_agency_validation_write_assert_v1(uuid,jsonb,uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_validation_write_assert_v1(uuid,jsonb,uuid,uuid) from public,anon,authenticated,service_role;

create or replace function private.weekly_source_agency_validation_write_observe_v1(p_timesheet_id uuid,p_snapshot jsonb,p_outbox_id uuid)
returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype; t public.timesheets%rowtype;
 f public.timesheets_financials%rowtype; prior public.timesheets_financials%rowtype;
 frame jsonb; observation jsonb; flags jsonb; signature jsonb; actual_signature text; facts jsonb;
begin
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where current_timesheet_id=p_timesheet_id and state='ACTIVE' for update;
 frame:=r.native_receipts->'validation_write_frame';
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict f from public.timesheets_financials where timesheet_id=p_timesheet_id and is_current;
 select * into strict prior from public.timesheets_financials where id=(frame->>'prior_financial_id')::uuid;
 facts:=private.weekly_source_agency_week_facts_v1(t.timesheet_id);
 if r.phase<>'AUTHORISED' or frame->>'transaction_id' is distinct from pg_current_xact_id()::text
  or frame->>'backend_pid' is distinct from pg_backend_pid()::text or frame->>'request_id' is distinct from r.id::text
  or frame->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
  or frame->>'snapshot_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_CANONICAL_SNAPSHOT_V1',p_snapshot),'hex')
  or frame->>'outbox_id' is distinct from p_outbox_id::text or f.id=prior.id or prior.is_current
  or frame->>'timesheet_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('AGENCY_VALIDATION_TIMESHEET_V1',to_jsonb(t)),'hex')
  or frame->>'prior_financial_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1('AGENCY_VALIDATION_PRIOR_ROW_V1',to_jsonb(prior)-array['is_current','updated_at']),'hex')
  or frame->>'facts_sha256' is distinct from facts->>'facts_hash'
  or f.timesheet_version is distinct from t.version or f.paid_at_utc is not null or f.locked_by_invoice_id is not null
  or f.authorised_at_utc is distinct from t.authorised_at_server or f.authorised_by_user_id is distinct from prior.authorised_by_user_id
  or f.actual_schedule_json is distinct from t.actual_schedule_json
  or f.processing_status::text is distinct from case when facts->'complete'='true'::jsonb then 'READY_FOR_INVOICE' else 'READY_FOR_HR' end
  or not exists(select 1 from public.ts_financials_outbox q where q.id=p_outbox_id and q.timesheet_id=t.timesheet_id and q.reason='CONTEXT_CHANGED') then
  raise exception 'AGENCY_CHANGE_VALIDATION_NEW_ROW_UNPROVED' using errcode='55000';end if;
 -- Retain only this genuinely new native row/signature under the current
 -- XID/PID before the SAME sole segment writer rederives its native flags.
 signature:=public.timesheet_lifecycle_guard_signature_v1(t.timesheet_id,r.contract_week_id,false);
 actual_signature:=nullif(btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature')),'');
 if actual_signature is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000';end if;
 update private.weekly_source_agency_timesheet_change_requests set current_financial_id=f.id,current_row_signature=actual_signature,
  version=version+1,updated_at_utc=transaction_timestamp() where id=r.id;
 flags:=private.weekly_source_agency_segment_flags_apply_v1(r.id);
 select * into strict f from public.timesheets_financials where id=f.id and is_current;
 observation:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_VALIDATION_WRITE_OBSERVED_V1','request_id',r.id,
  'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'financial_id',f.id,'prior_financial_id',prior.id,
  'observed_outbox_id',p_outbox_id,'publication_id',r.source_publication_id,'facts_sha256',facts->>'facts_hash',
  'validation_actor_user_id',frame->'validation_actor_user_id','phase_actor_user_id',r.updated_by_user_id,
  'financial_row_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_VALIDATION_RECOMPUTE_ROW_V1',to_jsonb(f)),'hex'),
  'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid());
 signature:=public.timesheet_lifecycle_guard_signature_v1(t.timesheet_id,r.contract_week_id,false);
 actual_signature:=nullif(btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature')),'');
 if actual_signature is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000';end if;
 update private.weekly_source_agency_timesheet_change_requests set native_receipts=(native_receipts-'validation_write_frame')||
   jsonb_build_object('validation_write_observation',observation,'segment_flags',flags),current_row_signature=actual_signature,
  version=version+1,updated_at_utc=transaction_timestamp() where id=r.id;
end;
$function$;
alter function private.weekly_source_agency_validation_write_observe_v1(uuid,jsonb,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_validation_write_observe_v1(uuid,jsonb,uuid) from public,anon,authenticated,service_role;

create or replace function public.weekly_source_agency_validation_apply_v1(p_request_id uuid,p_expected_request_version bigint,
 p_expected_context_sha256 text,p_snapshot jsonb)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare context jsonb; r private.weekly_source_agency_timesheet_change_requests%rowtype;
 native_result record; observation jsonb; receipt jsonb; f public.timesheets_financials%rowtype;
begin
 context:=private.weekly_source_agency_validation_context_v1(p_request_id);
 if context->>'context_sha256' is distinct from p_expected_context_sha256
  or context->>'request_version' is distinct from p_expected_request_version::text then
  raise exception 'AGENCY_CHANGE_WORKER_CONTEXT_CHANGED' using errcode='40001';end if;
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 select * into strict native_result from public.tsfin_write_snapshots_and_complete(jsonb_build_array(
  jsonb_build_object('outbox_id',r.outbox_id,'timesheet_id',r.current_timesheet_id,'snapshot',p_snapshot)));
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 observation:=r.native_receipts->'validation_write_observation';
 select * into strict f from public.timesheets_financials where id=r.current_financial_id and is_current;
 if native_result.ok_count is distinct from 1 or native_result.fail_count is distinct from 0 or native_result.errors is distinct from '[]'::jsonb
  or observation->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_NATIVE_VALIDATION_WRITE_OBSERVED_V1'
  or observation->>'request_id' is distinct from r.id::text or observation->>'observed_outbox_id' is distinct from r.outbox_id::text
  or observation->>'transaction_id' is distinct from pg_current_xact_id()::text or observation->>'backend_pid' is distinct from pg_backend_pid()::text
  or observation->>'financial_id' is distinct from f.id::text or observation->>'financial_row_sha256' is distinct from
    encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_VALIDATION_RECOMPUTE_ROW_V1',to_jsonb(f)),'hex')
  or exists(select 1 from public.ts_financials_outbox where id=r.outbox_id) then
  raise exception 'AGENCY_CHANGE_NATIVE_VALIDATION_RECOMPUTE_UNPROVED' using errcode='55000';end if;
 receipt:=(observation-'schema_version')||jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_VALIDATION_RECOMPUTE_V1',
  'native_ok_count',native_result.ok_count,'native_fail_count',native_result.fail_count);
 update private.weekly_source_agency_timesheet_change_requests set native_receipts=(native_receipts-'validation_write_observation')||
  jsonb_build_object('validation_recompute',receipt),version=version+1,updated_at_utc=transaction_timestamp(),last_refusal_code=null
  where id=r.id returning * into r;
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_VALIDATION_APPLY_RESULT_V1','request_id',r.id,'request_version',r.version,
  'phase',r.phase,'phase_actor_user_id',r.updated_by_user_id,'timesheet_id',r.current_timesheet_id,
  'timesheet_version',r.current_timesheet_version,'outbox_id',r.outbox_id,'financial_id',r.current_financial_id,
  'native_write_observed',true,'native_queue_completed',true,'validation_receipt',receipt);
end;
$function$;
alter function public.weekly_source_agency_validation_apply_v1(uuid,bigint,text,jsonb) owner to postgres;
revoke all on function public.weekly_source_agency_validation_apply_v1(uuid,bigint,text,jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_agency_validation_apply_v1(uuid,bigint,text,jsonb) to service_role;


-- Exact selected runtime component 20: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/18_62_complete_native_financial_observation_with_validation.sqlinc
-- SOURCE construction. A frame is written only by the genuine native phase /
-- current queued writer owner; it never comes from a browser capability/GUC.
create or replace function private.weekly_source_agency_financial_frame_open_v1(
  p_request_id uuid,p_mode text,p_snapshot jsonb,p_outbox_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  r private.weekly_source_agency_timesheet_change_requests%rowtype;
  t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
  queue public.ts_financials_outbox%rowtype; claim jsonb; purpose jsonb; frame jsonb; receipts jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if p_mode not in('MANUAL','RECOMPUTE') or p_mode is null
    or jsonb_typeof(p_snapshot) is distinct from 'object' or octet_length(p_snapshot::text)>1048576 then
    raise exception 'AGENCY_CHANGE_FINANCIAL_FRAME_INVALID' using errcode='22023'; end if;
  select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
  r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,
    r.initial_row_signature,r.request_key,r.updated_by_user_id);
  if r.phase='AUTHORISED' and p_mode='RECOMPUTE' then
    return private.weekly_source_agency_validation_frame_open_v1(r.id,p_snapshot,p_outbox_id);
  end if;
  if r.state<>'ACTIVE' or (p_mode='MANUAL' and r.phase<>'UNAUTHORISED')
    or (p_mode='RECOMPUTE' and r.phase<>'RECOMPUTE_PENDING') then
    raise exception 'AGENCY_CHANGE_FINANCIAL_PHASE_INVALID' using errcode='55000'; end if;
  if p_mode='RECOMPUTE' then
    select * into strict queue from public.ts_financials_outbox where id=p_outbox_id for update;
    if p_outbox_id is distinct from r.outbox_id or queue.timesheet_id is distinct from r.current_timesheet_id
      or queue.reason is distinct from r.outbox_reason then
      raise exception 'AGENCY_CHANGE_NATIVE_OUTBOX_CHANGED' using errcode='40001'; end if;
  elsif p_outbox_id is not null then
    raise exception 'AGENCY_CHANGE_FINANCIAL_FRAME_INVALID' using errcode='22023';
  end if;
  select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id for update;
  select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current for update;
  if t.version is distinct from r.current_timesheet_version
    or f.timesheet_version is distinct from t.version or f.id is distinct from r.current_financial_id
    or f.locked_by_invoice_id is not null or t.authorised_at_server is not null
    or exists(select 1 from public.invoice_lines l where l.timesheet_id=t.timesheet_id) then
    raise exception 'AGENCY_CHANGE_FINANCIAL_BEFORE_CHANGED' using errcode='40001'; end if;
  if p_snapshot->>'timesheet_id' is distinct from t.timesheet_id::text
    or p_snapshot->>'timesheet_version' is distinct from t.version::text
    or p_snapshot->'actual_schedule_json' is distinct from r.native_receipts#>'{original_capture,schedule}'
    or (p_mode='RECOMPUTE' and t.actual_schedule_json is distinct from r.native_receipts#>'{original_capture,schedule}') then
    raise exception 'AGENCY_CHANGE_CANONICAL_TARGET_CHANGED' using errcode='40001'; end if;
  -- The same existing policy/unit guards remain the financial admission owners.
  perform public._ctms_assert_tsfin_snapshot_policy_v1(t.timesheet_id,p_snapshot);
  claim:=private.weekly_source_agency_original_claim_recheck_v1(r.id);
  purpose:=private.weekly_source_agency_paid_write_purpose_v1(r.id);
  -- Unavailable original hours stay unavailable to protection. The financial
  -- purpose preserves the actual signed/document/old-financial identities;
  -- it does not relabel a document view as an immutable worker claim.
  frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_FINANCIAL_WRITE_FRAME_V1',
    'request_id',r.id,'request_sha256',encode(r.request_sha256,'hex'),'mode',p_mode,
    'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid(),
    'phase_actor_user_id',r.updated_by_user_id,'timesheet_id',t.timesheet_id,'timesheet_version',t.version,
    'prior_financial_id',f.id,'prior_financial_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_PRIOR_FINANCIAL_V1',to_jsonb(f)-array['is_current','updated_at']),'hex'),
    'snapshot_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_CANONICAL_SNAPSHOT_V1',p_snapshot),'hex'),
    'source_cas',r.source_cas,'original_submission_proved',claim->'available',
    'paid_write_purpose_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_PAID_WRITE_PURPOSE_V1',purpose),'hex'),
    'original_submission_sha256',claim->'claim_sha256',
    'original_submission_state',claim->'submission_state','prior_financial_updated_at',f.updated_at,'outbox_id',p_outbox_id);
  receipts:=r.native_receipts||jsonb_build_object('financial_write_frame',frame);
  if octet_length(receipts::text)>65536 then
    raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED' using errcode='54000'; end if;
  update private.weekly_source_agency_timesheet_change_requests set native_receipts=receipts,
    version=version+1,updated_at_utc=transaction_timestamp() where id=r.id;
  return frame;
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_CHANGE_FINANCIAL_BEFORE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_financial_frame_open_v1(uuid,text,jsonb,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_financial_frame_open_v1(uuid,text,jsonb,uuid)
  from public,anon,authenticated,service_role;

create or replace function private.weekly_source_agency_financial_write_assert_v1(
  p_timesheet_id uuid,p_snapshot jsonb,p_actor_user_id uuid,p_outbox_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  r private.weekly_source_agency_timesheet_change_requests%rowtype;
  t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
  frame jsonb; claim jsonb; purpose jsonb; invoice public.invoices%rowtype;
  keys constant text[]:=array['schema_version','request_id','request_sha256','mode','transaction_id','backend_pid',
    'phase_actor_user_id','timesheet_id','timesheet_version','prior_financial_id','prior_financial_sha256',
    'snapshot_sha256','source_cas','original_submission_proved','paid_write_purpose_sha256',
    'original_submission_sha256','original_submission_state','prior_financial_updated_at','outbox_id'];
begin
  select * into r from private.weekly_source_agency_timesheet_change_requests
    where current_timesheet_id=p_timesheet_id and state='ACTIVE';
  if not found then return null; end if;
  perform private.weekly_source_query_require_service_v1();
  if r.phase='AUTHORISED' then
    return private.weekly_source_agency_validation_write_assert_v1(p_timesheet_id,p_snapshot,p_actor_user_id,p_outbox_id);
  end if;
  frame:=r.native_receipts->'financial_write_frame';
  if jsonb_typeof(frame) is distinct from 'object' or not(frame ?& keys) or frame-keys<>'{}'::jsonb
    or frame->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_FINANCIAL_WRITE_FRAME_V1'
    or frame->>'transaction_id' is distinct from pg_current_xact_id()::text
    or frame->>'backend_pid' is distinct from pg_backend_pid()::text
    or frame->>'request_id' is distinct from r.id::text
    or frame->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
    or frame->>'phase_actor_user_id' is distinct from r.updated_by_user_id::text
    or frame->>'timesheet_id' is distinct from r.current_timesheet_id::text
    or frame->>'timesheet_version' is distinct from r.current_timesheet_version::text
    or frame->'source_cas' is distinct from r.source_cas
    or (frame->>'mode'='MANUAL' and (r.phase<>'UNAUTHORISED' or p_outbox_id is not null))
    or (frame->>'mode'='RECOMPUTE' and (r.phase<>'RECOMPUTE_PENDING'
      or frame->>'outbox_id' is distinct from r.outbox_id::text))
    or frame->>'mode' is null or frame->>'mode' not in('MANUAL','RECOMPUTE')
    or coalesce(frame->>'snapshot_sha256','')!~'^[0-9a-f]{64}$'
    or coalesce(frame->>'prior_financial_sha256','')!~'^[0-9a-f]{64}$'
    or jsonb_typeof(frame->'original_submission_proved') is distinct from 'boolean'
    or coalesce(frame->>'paid_write_purpose_sha256','')!~'^[0-9a-f]{64}$'
    or (frame->'original_submission_proved'='true'::jsonb
      and coalesce(frame->>'original_submission_sha256','')!~'^[0-9a-f]{64}$')
    or (frame->'original_submission_proved'='false'::jsonb
      and (frame->'original_submission_sha256' is distinct from 'null'::jsonb
        or frame->'original_submission_state' is distinct from 'null'::jsonb))
    or (p_actor_user_id is not null and frame->>'phase_actor_user_id' is distinct from p_actor_user_id::text)
    or (p_outbox_id is not null and frame->>'outbox_id' is distinct from p_outbox_id::text)
    or (p_snapshot is not null and encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_CANONICAL_SNAPSHOT_V1',p_snapshot),'hex') is distinct from frame->>'snapshot_sha256') then
    raise exception 'AGENCY_CHANGE_GENUINE_FINANCIAL_FRAME_REQUIRED' using errcode='55000'; end if;
  -- Recheck immutable original input rather than trusting the stored digest.
  if private.weekly_source_agency_change_request_sha256_v1(r.contract_week_id,r.reason,
      r.initial_row_signature,r.request_key,r.actor_user_id,r.native_receipts->'original_capture')
    is distinct from r.request_sha256 then
    raise exception 'AGENCY_CHANGE_ORIGINAL_REQUEST_DIGEST_INVALID' using errcode='55000'; end if;
  if current_setting('transaction_isolation') is distinct from 'read committed' then
    raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001'; end if;
  if private.weekly_source_pay_actor_allowed_v1(r.updated_by_user_id) is distinct from true then
    raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
  perform private.weekly_source_office_authority_v1(r.updated_by_user_id,'VIEW_PAY_WORK',
    r.source_group_id,r.client_id,r.week_ending_date);
  if private.weekly_source_bulk_source_cas_v1(r.source_cycle_id,array[r.client_id]) is distinct from r.source_cas then
    raise exception 'AGENCY_CHANGE_ORIGINAL_SOURCE_CAS_CHANGED' using errcode='40001'; end if;
  if (private.weekly_source_effective_rule_set_v1(r.client_id,r.source_cycle_id)->>'rule_set_version_id')
    is distinct from r.rule_set_version_id::text then
    raise exception 'AGENCY_CHANGE_OPERATIONAL_RULE_UNAVAILABLE' using errcode='55000'; end if;
  -- The genuine phase owner acquired original D1 before family/financial rows.
  -- Re-reading here does not invent a second lock-order or an invoice chooser.
  if r.original_draft_invoice_id is not null then
    select * into strict invoice from public.invoices where id=r.original_draft_invoice_id;
    if not r.return_hold or invoice.invoice_no is distinct from r.original_draft_invoice_no
      or invoice.client_id is distinct from r.client_id or invoice.type is distinct from 'INVOICE'
      or invoice.status not in('DRAFT','ON_HOLD') or invoice.issued_at_utc is not null or invoice.paid_at_utc is not null then
      raise exception 'AGENCY_CHANGE_ORIGINAL_D1_CHANGED' using errcode='40001'; end if;
  end if;
  select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
  select * into strict f from public.timesheets_financials where timesheet_id=p_timesheet_id and is_current;
  if t.is_current is distinct from true or t.version is distinct from r.current_timesheet_version
    or t.contract_id is distinct from r.contract_id or t.week_ending_date is distinct from r.week_ending_date
    or btrim(t.booking_id) is distinct from r.canonical_family_booking_id
    or t.authorised_at_server is not null or t.actual_schedule_json is distinct from r.native_receipts#>'{original_capture,schedule}'
    or f.id::text is distinct from frame->>'prior_financial_id' or f.timesheet_version is distinct from t.version
    or f.locked_by_invoice_id is not null or exists(select 1 from public.invoice_lines l where l.timesheet_id=t.timesheet_id)
    or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_PRIOR_FINANCIAL_V1',to_jsonb(f)-array['is_current','updated_at']),'hex')
      is distinct from frame->>'prior_financial_sha256' then
    raise exception 'AGENCY_CHANGE_FINANCIAL_BEFORE_CHANGED' using errcode='40001'; end if;
  claim:=private.weekly_source_agency_original_claim_recheck_v1(r.id);
  purpose:=private.weekly_source_agency_paid_write_purpose_v1(r.id);
  if claim->'available' is distinct from frame->'original_submission_proved'
    or coalesce(claim->'claim_sha256','null'::jsonb) is distinct from frame->'original_submission_sha256'
    or coalesce(claim->'submission_state','null'::jsonb) is distinct from frame->'original_submission_state'
    or encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_PAID_WRITE_PURPOSE_V1',purpose),'hex')
      is distinct from frame->>'paid_write_purpose_sha256' then
    raise exception 'AGENCY_CHANGE_NATIVE_PAID_WRITE_PURPOSE_CHANGED' using errcode='40001'; end if;
  return frame;
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_CHANGE_GENUINE_FINANCIAL_FRAME_REQUIRED' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_financial_write_assert_v1(uuid,jsonb,uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_financial_write_assert_v1(uuid,jsonb,uuid,uuid)
  from public,anon,authenticated,service_role;
-- E7 is SECURITY INVOKER. This is the only nested service EXECUTE addition;
-- it exposes no creator/frame write and cannot admit a standalone paid writer.
grant execute on function private.weekly_source_agency_financial_write_assert_v1(uuid,jsonb,uuid,uuid) to service_role;

create or replace function private.weekly_source_agency_financial_write_observe_v1(
  p_timesheet_id uuid,p_snapshot jsonb,p_outbox_id uuid
) returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
 prior public.timesheets_financials%rowtype; frame jsonb; observation jsonb; receipts jsonb; signature jsonb; segment_flags_receipt jsonb;
begin
 select * into r from private.weekly_source_agency_timesheet_change_requests
  where current_timesheet_id=p_timesheet_id and state='ACTIVE' for update;
 if not found then return; end if;
 perform private.weekly_source_query_require_service_v1();
 if r.phase='AUTHORISED' then
  perform private.weekly_source_agency_validation_write_observe_v1(p_timesheet_id,p_snapshot,p_outbox_id);
  return;
 end if;
 frame:=r.native_receipts->'financial_write_frame';
 if frame->>'transaction_id' is distinct from pg_current_xact_id()::text
  or frame->>'backend_pid' is distinct from pg_backend_pid()::text
  or frame->>'request_id' is distinct from r.id::text
  or frame->>'snapshot_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
   'WEEKLY_SOURCE_AGENCY_CANONICAL_SNAPSHOT_V1',p_snapshot),'hex')
  or frame->>'outbox_id' is distinct from p_outbox_id::text then
  raise exception 'AGENCY_CHANGE_FINANCIAL_OBSERVATION_FRAME_INVALID' using errcode='55000'; end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict f from public.timesheets_financials where timesheet_id=p_timesheet_id and is_current;
 select * into strict prior from public.timesheets_financials where id=(frame->>'prior_financial_id')::uuid;
 if f.id=prior.id or f.timesheet_version is distinct from t.version or prior.is_current
  or f.paid_at_utc is not null or f.locked_by_invoice_id is not null
  or t.version is distinct from r.current_timesheet_version or t.is_current is distinct from true
  or f.actual_schedule_json is distinct from r.native_receipts#>'{original_capture,schedule}'
  or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_PRIOR_FINANCIAL_V1',to_jsonb(prior)-array['is_current','updated_at']),'hex')
    is distinct from frame->>'prior_financial_sha256' then
  raise exception 'AGENCY_CHANGE_NEW_FINANCIAL_ROW_UNPROVED' using errcode='55000'; end if;
 if p_outbox_id is not null and not exists(select 1 from public.ts_financials_outbox q
  where q.id=p_outbox_id and q.id=r.outbox_id and q.timesheet_id=t.timesheet_id and q.reason=r.outbox_reason) then
  raise exception 'AGENCY_CHANGE_NATIVE_OUTBOX_CHANGED' using errcode='40001'; end if;
 -- Retain the genuine new row under the original native XID/PID frame before
 -- deriving its flags. The same existing segment writer runs after EVERY
 -- observed request recompute; its actual post-write row is what is hashed.
 update private.weekly_source_agency_timesheet_change_requests set current_financial_id=f.id,
  version=version+1,updated_at_utc=transaction_timestamp() where id=r.id returning * into r;
 segment_flags_receipt:=private.weekly_source_agency_segment_flags_apply_v1(r.id);
 select * into strict f from public.timesheets_financials where id=r.current_financial_id and is_current;
 observation:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_FINANCIAL_WRITE_V1',
  'observed_outbox_id',p_outbox_id,'timesheet_id',t.timesheet_id,'timesheet_version',t.version,
  'financial_id',f.id,'financial_row_sha256',encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_AGENCY_RECOMPUTE_ROW_V1',to_jsonb(f)),'hex'),
  'prior_financial_id',prior.id,'prior_financial_sha256',frame->'prior_financial_sha256',
  'prior_paid_marker_retained',prior.paid_at_utc is not null,
  'prior_financial_updated_at_before',frame->'prior_financial_updated_at',
  'prior_financial_updated_at_after',prior.updated_at,
  'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid(),
  'native_phase_actor_user_id',frame->'phase_actor_user_id','snapshot_sha256',frame->'snapshot_sha256');
 receipts:=(r.native_receipts-'financial_write_frame')||jsonb_build_object(
   case when p_outbox_id is null then 'manual_financial_write' else 'recompute' end,observation,
   'segment_flags',segment_flags_receipt);
 if octet_length(receipts::text)>65536 then
  raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED' using errcode='54000'; end if;
 -- A newly written row is retained before queue success. No phase is completed
 -- from a count, queue absence or financial status; the same native core resumes.
 update private.weekly_source_agency_timesheet_change_requests set native_receipts=receipts,
  current_financial_id=f.id,version=version+1,updated_at_utc=transaction_timestamp() where id=r.id;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NEW_FINANCIAL_ROW_UNPROVED' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_financial_write_observe_v1(uuid,jsonb,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_financial_write_observe_v1(uuid,jsonb,uuid)
 from public,anon,authenticated,service_role;


-- Exact selected runtime component 21: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/19_63_complete_native_flags_with_validation_observation.sqlinc
-- Primary26.5's native per-event flag derivation. It is owner-private and
-- supplies no cash, quantity certificate, scope override or browser capability.
-- The existing Source scope refuses the genuine revoked UNA phase. Its native
-- query-facts body is shared through an owner-only admitted Agency adapter;
-- an unavailable native result is never relabelled to a clear query state.
create or replace function private.weekly_source_agency_segment_flags_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
 e public.weekly_work_events%rowtype; i public.weekly_discrepancy_incidents%rowtype;
 comparison public.weekly_issue_comparison_revisions%rowtype;
 response public.weekly_discrepancy_events%rowtype;
 segment jsonb; source_entry jsonb; flag jsonb; flags jsonb:='[]'::jsonb; basis jsonb:='[]'::jsonb;
 event_id uuid; count_value integer; active_protection boolean; disputed boolean;
 candidate_minutes numeric; source_minutes numeric; cutoff timestamptz; frame jsonb; result jsonb;
 native_query_facts jsonb; query_item jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001';end if;
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 if r.state<>'ACTIVE' or r.phase not in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT','AUTHORISED')
  or private.weekly_source_agency_change_request_sha256_v1(r.contract_week_id,r.reason,r.initial_row_signature,
   r.request_key,r.actor_user_id,r.native_receipts->'original_capture') is distinct from r.request_sha256 then
  raise exception 'AGENCY_CHANGE_ORIGINAL_REQUEST_DIGEST_INVALID' using errcode='55000';end if;
 if private.weekly_source_pay_actor_allowed_v1(r.updated_by_user_id) is distinct from true then
  raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501';end if;
 perform private.weekly_source_office_authority_v1(r.updated_by_user_id,'VIEW_PAY_WORK',r.source_group_id,r.client_id,r.week_ending_date);
 if private.weekly_source_bulk_source_cas_v1(r.source_cycle_id,array[r.client_id]) is distinct from r.source_cas
  or private.weekly_source_effective_rule_set_v1(r.client_id,r.source_cycle_id)->>'rule_set_version_id'
    is distinct from r.rule_set_version_id::text then
  raise exception 'AGENCY_CHANGE_ORIGINAL_SOURCE_CAS_CHANGED' using errcode='40001';end if;
 select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
 select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
 if t.timesheet_id is distinct from r.initial_timesheet_id or t.version is distinct from r.current_timesheet_version
  or t.contract_id is distinct from r.contract_id or t.week_ending_date is distinct from r.week_ending_date
  or t.is_current is distinct from true or t.archived_at_utc is not null
  or f.id is distinct from r.current_financial_id or f.timesheet_version is distinct from t.version
  or f.locked_by_invoice_id is not null or exists(select 1 from public.invoice_lines where timesheet_id=t.timesheet_id)
  or t.actual_schedule_json is distinct from r.native_receipts#>'{original_capture,schedule}'
  or f.actual_schedule_json is distinct from t.actual_schedule_json
  or f.invoice_breakdown_json->>'mode' is distinct from 'SEGMENTS'
  or jsonb_typeof(f.invoice_breakdown_json->'segments') is distinct from 'array'
  or jsonb_array_length(f.invoice_breakdown_json->'segments')>100
  or jsonb_array_length(f.invoice_breakdown_json->'segments')<>jsonb_array_length(t.actual_schedule_json) then
  raise exception 'AGENCY_CHANGE_SEGMENT_NATIVE_TARGET_CHANGED' using errcode='40001';end if;
 -- During the genuine E7/E25/E26 observation, row signature/currentness has
 -- already changed. Only its existing native frame, actual XID/PID and snapshot
 -- cut can admit that intermediate phase; no caller assertion is accepted.
 if r.phase in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING') then
  frame:=r.native_receipts->'financial_write_frame';
  if frame->>'request_id' is distinct from r.id::text
   or frame->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
   or frame->>'transaction_id' is distinct from pg_current_xact_id()::text
   or frame->>'backend_pid' is distinct from pg_backend_pid()::text
   or frame->>'phase_actor_user_id' is distinct from r.updated_by_user_id::text
   or frame->>'timesheet_id' is distinct from t.timesheet_id::text
   or frame->>'timesheet_version' is distinct from t.version::text
   or frame->'source_cas' is distinct from r.source_cas
   or frame->>'mode' not in('MANUAL','RECOMPUTE') or frame->>'mode' is null then
   raise exception 'AGENCY_CHANGE_GENUINE_FINANCIAL_FRAME_REQUIRED' using errcode='55000';end if;
 else
  r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,
    r.initial_row_signature,r.request_key,r.updated_by_user_id);
 end if;
 cutoff:=transaction_timestamp();
 if r.phase='AUTHORISED' then
  if r.native_receipts#>>'{authorise,result,ok}' is distinct from 'true'
   or r.native_receipts#>>'{authorise,result,timesheet_id}' is distinct from t.timesheet_id::text
   or (r.native_receipts#>>'{authorise,financial_id}' is distinct from f.id::text
    and coalesce((r.native_receipts#>>'{validation_write_frame,schema_version}'='WEEKLY_SOURCE_AGENCY_AUTHORISED_WRITE_FRAME_V1'
      and r.native_receipts#>>'{validation_write_frame,request_id}'=r.id::text
      and r.native_receipts#>>'{validation_write_frame,request_sha256}'=encode(r.request_sha256,'hex')
      and r.native_receipts#>>'{validation_write_frame,transaction_id}'=pg_current_xact_id()::text
      and r.native_receipts#>>'{validation_write_frame,backend_pid}'=pg_backend_pid()::text
      and r.native_receipts#>>'{validation_write_frame,prior_financial_id}'=r.native_receipts#>>'{validation_refresh,financial_id}'
      and exists(select 1 from public.timesheets_financials prior where prior.id::text=r.native_receipts#>>'{validation_write_frame,prior_financial_id}'
        and not prior.is_current and prior.timesheet_id=t.timesheet_id and prior.authorised_at_utc=t.authorised_at_server)),false) is distinct from true)
   or (r.native_receipts#>>'{authorise,authorised_at_server}')::timestamptz is distinct from t.authorised_at_server
   or f.authorised_by_user_id::text is distinct from r.native_receipts#>>'{authorise,phase_actor_user_id}'
   or t.authorised_at_server is null or t.revoked_at is not null then
   raise exception 'AGENCY_CHANGE_GENUINE_AUTHORISE_RECEIPT_REQUIRED' using errcode='55000';end if;
  cutoff:=t.authorised_at_server;
 elsif t.authorised_at_server is not null then
  raise exception 'AGENCY_CHANGE_SEGMENT_NATIVE_TARGET_CHANGED' using errcode='40001';end if;
 native_query_facts:=private.weekly_source_agency_native_query_facts_v1(r.id);
 if native_query_facts->'ok' is distinct from 'true'::jsonb or native_query_facts->>'code' is distinct from 'OK'
  or jsonb_typeof(native_query_facts->'hours_incidents') is distinct from 'array'
  or jsonb_typeof(native_query_facts->'manual_reviews') is distinct from 'array'
  or jsonb_typeof(native_query_facts->'blocked') is distinct from 'boolean'
  or coalesce(native_query_facts->>'query_state_sha256','')!~'^[0-9a-f]{64}$'
  or native_query_facts#>>'{scope,root_timesheet_id}' is distinct from t.timesheet_id::text
  or native_query_facts#>>'{scope,root_version}' is distinct from t.version::text
  or native_query_facts#>>'{scope,candidate_id}' is distinct from r.candidate_id::text
  or native_query_facts#>>'{scope,client_id}' is distinct from r.client_id::text
  or native_query_facts#>>'{scope,contract_id}' is distinct from r.contract_id::text
  or native_query_facts#>>'{scope,week_ending_date}' is distinct from r.week_ending_date::text then
  raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
 for segment in select value from jsonb_array_elements(f.invoice_breakdown_json->'segments') loop
  if jsonb_typeof(segment) is distinct from 'object' or nullif(segment->>'segment_id','') is null
   or segment->>'work_event_id'!~'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'
   or segment->>'work_event_id' is null or segment->>'source_shift_id' is distinct from segment->>'work_event_id' then
   raise exception 'AGENCY_CHANGE_SEGMENT_EVENT_UNBOUND' using errcode='55000';end if;
  event_id:=(segment->>'work_event_id')::uuid;
  select count(*) into count_value from jsonb_array_elements(t.actual_schedule_json) s where s->>'work_event_id'=event_id::text;
  if count_value<>1 then raise exception 'AGENCY_CHANGE_SEGMENT_EVENT_AMBIGUOUS' using errcode='55000';end if;
  select value into strict source_entry from jsonb_array_elements(t.actual_schedule_json) s(value) where value->>'work_event_id'=event_id::text;
  select * into strict e from public.weekly_work_events where id=event_id;
  if e.candidate_id is distinct from r.candidate_id or e.client_id is distinct from r.client_id
   or e.first_source_group_id is distinct from r.source_group_id or e.work_date::text is distinct from source_entry->>'date'
   or segment->>'date' is distinct from source_entry->>'date' or segment->>'start' is distinct from source_entry->>'start'
   or segment->>'end' is distinct from source_entry->>'end'
   or (segment->>'break_mins')::numeric is distinct from (source_entry->>'break_minutes')::numeric then
   raise exception 'AGENCY_CHANGE_SEGMENT_EVENT_UNBOUND' using errcode='55000';end if;
  active_protection:=exists(select 1 from private.weekly_source_check_only_shift_protections p
   where p.candidate_id=e.candidate_id and p.work_event_id=e.id and p.state='ACTIVE');
  if active_protection and exists(select 1 from private.weekly_source_check_only_shift_protections p
   where p.candidate_id=e.candidate_id and p.work_event_id=e.id and p.state='ACTIVE'
    and (p.client_id is distinct from r.client_id or p.contract_id is distinct from r.contract_id
      or p.week_ending_date is distinct from r.week_ending_date or p.work_date is distinct from e.work_date)) then
   raise exception 'AGENCY_CHANGE_PROTECTION_EVENT_SCOPE_CHANGED' using errcode='40001';end if;
  disputed:=false;i:=null;comparison:=null;response:=null;query_item:=null;
  select count(*) into count_value from jsonb_array_elements(native_query_facts->'hours_incidents') q
   where q->>'work_event_id'=e.id::text;
  if count_value>1 then raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
  if count_value=1 then
   select value into strict query_item from jsonb_array_elements(native_query_facts->'hours_incidents') q(value)
    where value->>'work_event_id'=e.id::text;
   if query_item->>'source_group_id' is distinct from r.source_group_id::text
    or query_item->>'candidate_id' is distinct from r.candidate_id::text or query_item->>'client_id' is distinct from r.client_id::text
    or query_item->>'comparison_contract_id' is distinct from r.contract_id::text then
    raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
  end if;
  select * into i from public.weekly_discrepancy_incidents where source_group_id=r.source_group_id and work_event_id=e.id and state='OPEN';
  if found then
   select * into strict comparison from public.weekly_issue_comparison_revisions where id=i.current_comparison_revision_id;
   if query_item->>'id' is distinct from i.id::text or query_item->>'current_comparison_revision_id' is distinct from comparison.id::text
    or query_item->>'material_comparison_fingerprint' is distinct from encode(comparison.material_comparison_fingerprint,'hex')
    or i.candidate_id is distinct from r.candidate_id or i.client_id is distinct from r.client_id
    or comparison.incident_id is distinct from i.id or comparison.contract_id is distinct from r.contract_id
    or comparison.id is distinct from(select id from public.weekly_issue_comparison_revisions
      where incident_id=i.id order by revision_number desc limit 1) then
    raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
   if comparison.issue_family='SOURCE_HOURS_DIFFER' then
    if comparison.source_presence is distinct from 'PRESENT'
     or comparison.candidate_timesheet_id is distinct from r.initial_timesheet_id
     or comparison.candidate_timesheet_revision is distinct from r.initial_timesheet_version
     or comparison.projection_publication_id is distinct from r.source_publication_id
     or comparison.system_start_at_local is distinct from (source_entry->>'date')::date+(source_entry->>'start')::time
     or comparison.system_end_at_local is distinct from (source_entry->>'end_date')::date+(source_entry->>'end')::time
     or comparison.system_break_minutes is distinct from (source_entry->>'break_minutes')::integer then
     raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SOURCE_UNAVAILABLE' using errcode='55000';end if;
    select * into response from public.weekly_discrepancy_events where incident_id=i.id and issue_episode=i.episode_number
     and event_kind='CANDIDATE_RESPONDED' and actor_kind='CANDIDATE' order by occurred_at_utc desc,id desc limit 1;
    if found then
     if response.expected_comparison_fingerprint is distinct from comparison.material_comparison_fingerprint
      or response.projection_publication_id is distinct from comparison.projection_publication_id
      or response.bounded_payload_json->>'choice' is null
      or response.bounded_payload_json->>'choice' not in('CANDIDATE_WRONG','CANDIDATE_CORRECT','NEITHER_CORRECT') then
      raise exception 'AGENCY_CHANGE_NATIVE_QUERY_RESPONSE_UNAVAILABLE' using errcode='55000';end if;
     if response.occurred_at_utc<=cutoff and response.bounded_payload_json->>'choice' in('CANDIDATE_CORRECT','NEITHER_CORRECT') then
      if comparison.candidate_start_at_local is null or comparison.candidate_end_at_local is null
       or comparison.candidate_break_minutes is null or comparison.candidate_end_at_local<=comparison.candidate_start_at_local then
       raise exception 'AGENCY_CHANGE_NATIVE_QUERY_CLAIM_UNAVAILABLE' using errcode='55000';end if;
      candidate_minutes:=extract(epoch from(comparison.candidate_end_at_local-comparison.candidate_start_at_local))/60-comparison.candidate_break_minutes;
      source_minutes:=extract(epoch from(comparison.system_end_at_local-comparison.system_start_at_local))/60-comparison.system_break_minutes;
      if candidate_minutes<=0 or source_minutes<=0 then
       raise exception 'AGENCY_CHANGE_NATIVE_QUERY_CLAIM_UNAVAILABLE' using errcode='55000';end if;
      disputed:=source_minutes<=candidate_minutes;
     end if;
    elsif i.candidate_action_state='RESPONDED' then
     raise exception 'AGENCY_CHANGE_NATIVE_QUERY_RESPONSE_UNAVAILABLE' using errcode='55000';end if;
   end if;
  elsif query_item is not null then
   raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';
  end if;
  flag:=jsonb_build_object('segment_id',segment->>'segment_id','exclude_from_pay',active_protection or disputed);
  flags:=flags||jsonb_build_array(flag);
  basis:=basis||jsonb_build_array(jsonb_build_object('work_event_id',e.id,'source_entry',source_entry,
   'active_protection',active_protection,'disputed_before_authorisation',disputed,
   'incident_id',i.id,'comparison_id',comparison.id,'response_event_id',response.id));
 end loop;
 if (select count(distinct s->>'segment_id') from jsonb_array_elements(flags) s)<>jsonb_array_length(flags) then
  raise exception 'AGENCY_CHANGE_SEGMENT_EVENT_AMBIGUOUS' using errcode='55000';end if;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_SEGMENT_FLAGS_V1','request_id',r.id,
  'request_sha256',encode(r.request_sha256,'hex'),'timesheet_id',t.timesheet_id,'timesheet_version',t.version,
  'financial_id',f.id,'phase_actor_user_id',r.updated_by_user_id,'source_cas',r.source_cas,'flags',flags,'basis',basis,
  'native_query_state_sha256',native_query_facts->'query_state_sha256');
 if octet_length(result::text)>65536 then raise exception 'AGENCY_CHANGE_SEGMENT_FLAGS_BOUND_EXCEEDED' using errcode='54000';end if;
 return result;
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'AGENCY_CHANGE_NATIVE_SEGMENT_FLAGS_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_segment_flags_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_segment_flags_v1(uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 22: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/20_64_complete_authorise_with_native_validation_writer.sqlinc
-- Concrete mechanical AUTHORISE phase of the SINGLE planned change owner.
-- It calls the unchanged native authorise owner; it does not declare validation,
-- Return, whole-week completeness, protected netting or the action COMPLETED.
create or replace function private.weekly_source_agency_change_authorise_step_v1(
 p_request_id uuid,p_actual_actor_user_id uuid
) returns private.weekly_source_agency_timesheet_change_requests
language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 before_ts public.timesheets%rowtype; after_ts public.timesheets%rowtype;
 before_fin public.timesheets_financials%rowtype; after_fin public.timesheets_financials%rowtype;
 actor public.tms_users%rowtype; result jsonb; signature jsonb; flags_receipt jsonb; pay_purpose jsonb; receipts jsonb;
 actual_signature text; error_code text; error_state text;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,
  r.initial_row_signature,r.request_key,p_actual_actor_user_id);
 select * into strict actor from public.tms_users where id=p_actual_actor_user_id and is_active;
 if r.state='COMPLETED' then return r;end if;
 if r.phase='AUTHORISED' then
  select * into strict after_ts from public.timesheets where timesheet_id=r.current_timesheet_id;
  select * into strict after_fin from public.timesheets_financials where id=r.current_financial_id and is_current;
  if r.native_receipts#>>'{authorise,result,ok}' is distinct from 'true'
   or r.native_receipts#>>'{authorise,result,operation}' is distinct from 'timesheet_authorise'
   or r.native_receipts#>>'{authorise,result,timesheet_id}' is distinct from after_ts.timesheet_id::text
   or (r.native_receipts#>>'{authorise,financial_id}' is distinct from after_fin.id::text
    and (r.native_receipts#>>'{validation_recompute,schema_version}' is distinct from 'WEEKLY_SOURCE_AGENCY_NATIVE_VALIDATION_RECOMPUTE_V1'
      or r.native_receipts#>>'{validation_recompute,request_id}' is distinct from r.id::text
      or r.native_receipts#>>'{validation_recompute,financial_id}' is distinct from after_fin.id::text
      or r.native_receipts#>>'{validation_recompute,financial_row_sha256}' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_AGENCY_VALIDATION_RECOMPUTE_ROW_V1',to_jsonb(after_fin)),'hex')))
   or (r.native_receipts#>>'{authorise,authorised_at_server}')::timestamptz is distinct from after_ts.authorised_at_server
   or after_fin.authorised_by_user_id::text is distinct from r.native_receipts#>>'{authorise,phase_actor_user_id}'
   or after_ts.authorised_at_server is null or after_ts.revoked_at is not null then
   raise exception 'AGENCY_CHANGE_GENUINE_AUTHORISE_RECEIPT_REQUIRED' using errcode='55000';end if;
  -- A permitted current reader/resumer sees the original genuine phase actor.
  -- Replay never rewrites who approved that native authorisation.
  perform public.weekly_source_agency_week_validation_refresh_v1(r.current_timesheet_id,r.source_publication_id);
  select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
  return r;
 end if;
 if r.phase<>'FINANCIAL_CURRENT' then raise exception 'AGENCY_CHANGE_AUTHORISE_PHASE_NOT_READY' using errcode='55000';end if;
 begin
  if r.updated_by_user_id is distinct from p_actual_actor_user_id then
   update private.weekly_source_agency_timesheet_change_requests set updated_by_user_id=p_actual_actor_user_id,
    version=version+1,updated_at_utc=transaction_timestamp() where id=r.id returning * into r;
   insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,action,after_json,reason,correlation_id)
   values(gen_random_uuid(),transaction_timestamp(),p_actual_actor_user_id,actor.role,'WEEKLY_SOURCE_AGENCY_CHANGE',r.id::text,
    'RESUME_CURRENT_SCOPED_ACTOR',jsonb_build_object('phase',r.phase,'original_creator_user_id',r.actor_user_id,
      'current_resumer_user_id',p_actual_actor_user_id),r.reason,r.request_key);
  end if;
  select * into strict before_ts from public.timesheets where timesheet_id=r.current_timesheet_id for update;
  select * into strict before_fin from public.timesheets_financials where id=r.current_financial_id and is_current for update;
  if before_ts.timesheet_id is distinct from r.initial_timesheet_id or before_ts.version is distinct from r.initial_timesheet_version
   or before_ts.authorised_at_server is not null or before_fin.is_stale is distinct from false
   or before_fin.timesheet_version is distinct from before_ts.version
   or before_fin.processing_status::text not in('PENDING_AUTH','READY_FOR_HR')
   or before_fin.locked_by_invoice_id is not null or exists(select 1 from public.invoice_lines where timesheet_id=before_ts.timesheet_id)
   or r.native_receipts#>>'{queue_completion,financial_id}' is distinct from before_fin.id::text
   or r.native_receipts#>>'{queue_completion,native_ok_count}' is distinct from '1'
   or r.native_receipts#>>'{queue_completion,native_fail_count}' is distinct from '0'
   or r.native_receipts#>>'{recompute,financial_id}' is distinct from before_fin.id::text
   or r.native_receipts#>>'{recompute,financial_row_sha256}' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_RECOMPUTE_ROW_V1',to_jsonb(before_fin)),'hex') then
   raise exception 'AGENCY_INVOICE_TSFIN_NOT_READY' using errcode='55000';end if;
  pay_purpose:=private.weekly_source_agency_paid_write_purpose_v1(r.id);
  flags_receipt:=private.weekly_source_agency_segment_flags_apply_v1(r.id);
  select * into strict before_fin from public.timesheets_financials where id=r.current_financial_id and is_current;
  signature:=public.timesheet_lifecycle_guard_signature_v1(r.current_timesheet_id,r.contract_week_id,false);
  actual_signature:=nullif(btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature')),'');
  if actual_signature is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000';end if;
  receipts:=r.native_receipts||jsonb_build_object('segment_flags',flags_receipt);
  update private.weekly_source_agency_timesheet_change_requests set native_receipts=receipts,current_row_signature=actual_signature,
   version=version+1,updated_at_utc=transaction_timestamp() where id=r.id returning * into r;
  result:=public.timesheet_authorise_generic_atomic(p_timesheet_id=>r.current_timesheet_id,
   p_expected_timesheet_id=>r.current_timesheet_id,p_actor_user_id=>p_actual_actor_user_id,
   p_now_utc=>transaction_timestamp(),p_expected_row_signature=>r.current_row_signature);
  select * into strict after_ts from public.timesheets where timesheet_id=r.current_timesheet_id;
  select * into strict after_fin from public.timesheets_financials where id=r.current_financial_id and is_current;
  if result->>'ok' is distinct from 'true' or result->>'success' is distinct from 'true'
   or result->>'operation' is distinct from 'timesheet_authorise'
   or result->>'timesheet_id' is distinct from r.current_timesheet_id::text
   or result->>'current_timesheet_id' is distinct from r.current_timesheet_id::text
   or result->>'requested_timesheet_id' is distinct from r.current_timesheet_id::text
   or result->>'contract_week_id' is distinct from r.contract_week_id::text
   or result->>'candidate_id' is distinct from r.candidate_id::text
   or result->>'was_stale' is distinct from 'false' or result->>'current_version' is distinct from r.current_timesheet_version::text
   or after_ts.authorised_at_server is null or after_ts.authorised_at_server is distinct from after_fin.authorised_at_utc
   or after_ts.revoked_at is not null or after_fin.authorised_by_user_id is distinct from p_actual_actor_user_id
   or after_fin.processing_status::text not in('READY_FOR_HR','READY_FOR_INVOICE')
   or to_jsonb(after_ts)-array['authorised_at_server','revoked_at','revoked_reason','revoked_by','updated_at']
    is distinct from to_jsonb(before_ts)-array['authorised_at_server','revoked_at','revoked_reason','revoked_by','updated_at']
   or to_jsonb(after_fin)-array['processing_status','authorised_by_user_id','authorised_at_utc','updated_at']
    is distinct from to_jsonb(before_fin)-array['processing_status','authorised_by_user_id','authorised_at_utc','updated_at'] then
   raise exception 'AGENCY_CHANGE_NATIVE_AUTHORISE_POSTCONDITION_UNPROVED' using errcode='55000';end if;
  actual_signature:=nullif(btrim(result->>'backend_row_signature'),'');
  signature:=public.timesheet_lifecycle_guard_signature_v1(r.current_timesheet_id,r.contract_week_id,false);
  if actual_signature is null or actual_signature is distinct from
    btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature')) then
   raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000';end if;
  receipts:=r.native_receipts||jsonb_build_object('authorise',jsonb_build_object(
   'schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_AUTHORISE_V1','request_id',r.id,'phase_actor_user_id',p_actual_actor_user_id,
   'timesheet_id',after_ts.timesheet_id,'timesheet_version',after_ts.version,'financial_id',after_fin.id,
   'authorised_at_server',after_ts.authorised_at_server,'result',result,
   'pay_purpose_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_PAID_WRITE_PURPOSE_V1',pay_purpose),'hex'),
   'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid()));
  if octet_length(receipts::text)>65536 then raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED' using errcode='54000';end if;
  update private.weekly_source_agency_timesheet_change_requests set phase='AUTHORISED',native_receipts=receipts,
   current_row_signature=actual_signature,last_refusal_code=null,version=version+1,updated_at_utc=transaction_timestamp()
   where id=r.id returning * into r;
  perform public.weekly_source_agency_week_validation_refresh_v1(r.current_timesheet_id,r.source_publication_id);
  select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
  insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,action,after_json,reason,correlation_id)
  values(gen_random_uuid(),transaction_timestamp(),p_actual_actor_user_id,actor.role,'WEEKLY_SOURCE_AGENCY_CHANGE',r.id::text,
   'NATIVE_AUTHORISE_PHASE_COMPLETED',jsonb_build_object('phase',r.phase,'current_timesheet_id',r.current_timesheet_id,
    'financial_id',r.current_financial_id,'original_creator_user_id',r.actor_user_id,'actual_phase_actor_user_id',p_actual_actor_user_id),r.reason,r.request_key);
 exception when others then
  get stacked diagnostics error_code=MESSAGE_TEXT,error_state=RETURNED_SQLSTATE;
  if error_state='55P03' then raise;end if;
  update private.weekly_source_agency_timesheet_change_requests set last_refusal_code=case
   when error_code~'^[A-Z][A-Z0-9_]{0,199}$' then error_code else 'AGENCY_CHANGE_NATIVE_AUTHORISE_FAILED' end,
   version=version+1,updated_at_utc=transaction_timestamp() where id=p_request_id returning * into r;
 end;
 return r;
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'AGENCY_CHANGE_NATIVE_AUTHORISE_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_change_authorise_step_v1(uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_change_authorise_step_v1(uuid,uuid) from public,anon,authenticated,service_role;

-- Finite mechanical Worker RPC; the single business request and actual actor
-- have already been recorded/admitted. It exposes no T0/D1/segment choice.
create or replace function public.weekly_source_agency_change_authorise_step_v1(p_request_id uuid,p_actor_user_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype;
begin
 perform private.weekly_source_query_require_service_v1();
 r:=private.weekly_source_agency_change_authorise_step_v1(p_request_id,p_actor_user_id);
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_AUTHORISE_STEP_RESULT_V1','request_id',r.id,
  'request_version',r.version,'phase',r.phase,'view_actor_user_id',p_actor_user_id,
  'timesheet_id',r.current_timesheet_id,'timesheet_version',r.current_timesheet_version,
  'financial_id',r.current_financial_id,'last_refusal_code',r.last_refusal_code,
  'authorise_receipt',r.native_receipts->'authorise','completed_receipt',r.completed_receipt);
end;
$function$;
alter function public.weekly_source_agency_change_authorise_step_v1(uuid,uuid) owner to postgres;
revoke all on function public.weekly_source_agency_change_authorise_step_v1(uuid,uuid) from public,anon,authenticated;
grant execute on function public.weekly_source_agency_change_authorise_step_v1(uuid,uuid) to service_role;


-- Exact selected runtime component 23: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/21_66_agency_actual_validation_hooks.sqlinc
create or replace function private.weekly_source_agency_publication_validation_v1(p_publication_id uuid)
returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare p public.weekly_source_projection_publications%rowtype; c public.weekly_source_cycles%rowtype; r record;
begin
 select * into strict p from public.weekly_source_projection_publications where id=p_publication_id;
 if p.authority_scope_kind<>'CYCLE' or p.correction_session_id is not null or p.state<>'CURRENT' then return;end if;
 select * into strict c from public.weekly_source_cycles where id=p.source_cycle_id;
 if c.current_projection_publication_id is distinct from p.id or c.current_complete_upload_id is distinct from p.upload_id then
  raise exception 'AGENCY_INVOICE_VALIDATION_PUBLICATION_STALE' using errcode='40001';end if;
 for r in select cw.timesheet_id from public.contract_weeks cw join public.contracts con on con.id=cw.contract_id
  join public.weekly_source_group_clients m on m.source_group_id=c.source_group_id and m.client_id=con.client_id
   and cw.week_ending_date between m.valid_from and coalesce(m.valid_to,'infinity'::date)
  where cw.week_ending_date=c.finalisation_week_ending and coalesce(cw.additional_seq,0)=0 and not cw.is_adjustment
   and cw.timesheet_id is not null and (c.scope_client_id is null or c.scope_client_id=con.client_id)
   and private.weekly_source_agency_invoice_check_only_v1(cw.timesheet_id) is true order by cw.timesheet_id loop
  perform public.weekly_source_agency_week_validation_refresh_v1(r.timesheet_id,p.id);
 end loop;
end;
$function$;
alter function private.weekly_source_agency_publication_validation_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_publication_validation_v1(uuid) from public,anon,authenticated,service_role;

-- Ordinary native generic Authorise/pair Authorise update the actual current
-- financial approval. This AFTER update sees both native TS and TF approvals;
-- it does not fire on the subsequent E26 INSERT before its observer retention.
create or replace function private.weekly_source_agency_authorise_validation_after_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare main_id uuid; facts jsonb;
begin
 if new.is_current is not true or new.authorised_at_utc is null
  or new.authorised_at_utc is not distinct from old.authorised_at_utc
  or private.weekly_source_agency_invoice_check_only_v1(new.timesheet_id) is distinct from true then return new;end if;
 select cw.timesheet_id into strict main_id from public.timesheets t join public.contract_weeks cw
  on cw.contract_id=t.contract_id and cw.week_ending_date=t.week_ending_date and coalesce(cw.additional_seq,0)=0 and not cw.is_adjustment
  where t.timesheet_id=new.timesheet_id;
 facts:=private.weekly_source_agency_week_facts_v1(main_id);
 perform public.weekly_source_agency_week_validation_refresh_v1(main_id,(facts->>'publication_id')::uuid);
 return new;
end;
$function$;
alter function private.weekly_source_agency_authorise_validation_after_v1() owner to postgres;
revoke all on function private.weekly_source_agency_authorise_validation_after_v1() from public,anon,authenticated,service_role;
drop trigger if exists weekly_source_agency_authorise_validation_after_v1 on public.timesheets_financials;
create trigger weekly_source_agency_authorise_validation_after_v1 after update of authorised_at_utc on public.timesheets_financials
 for each row execute function private.weekly_source_agency_authorise_validation_after_v1();

-- The legacy import admission uses the EXISTING native preview resolver. Its
-- recipients/raw comparison rows stay private; the HTTP caller gets one bool.
create or replace function private.weekly_source_agency_legacy_import_validation_admit_v1(p_import_id uuid)
returns boolean language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare hi public.hr_imports%rowtype; preview jsonb; first_date date; last_date date; client uuid;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict hi from public.hr_imports where id=p_import_id and pruned_at is null;
 if hi.import_scope is not null and upper(hi.import_scope::text)<>'HR_WEEKLY' then return true;end if;
 preview:=public.hr_weekly_validation_preview(p_import_id);
 if preview->>'import_id' is distinct from p_import_id::text or jsonb_typeof(preview->'rows') is distinct from 'array'
  or jsonb_array_length(preview->'rows')>5000 then raise exception 'HR_VALIDATION_NATIVE_TARGETS_UNAVAILABLE' using errcode='55000';end if;
 client:=(preview->>'client_id')::uuid;
 first_date:=coalesce((preview->>'file_date_min')::date,hi.coverage_start_date);
 last_date:=coalesce((preview->>'file_date_max')::date,hi.coverage_end_date);
 if client is null or first_date is null or last_date is null then
  raise exception 'HR_VALIDATION_NATIVE_TARGETS_UNAVAILABLE' using errcode='55000';end if;
 if exists(select 1 from public.contract_weeks cw join public.contracts con on con.id=cw.contract_id
  where con.client_id=client and cw.timesheet_id is not null and cw.week_ending_date>=first_date and cw.week_ending_date-6<=last_date
   and private.weekly_source_agency_invoice_check_only_v1(cw.timesheet_id) is true) then
  raise exception 'AGENCY_INVOICE_USES_COMPLETENESS_WRITER' using errcode='55000';end if;
 return true;
end;
$function$;
alter function private.weekly_source_agency_legacy_import_validation_admit_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_legacy_import_validation_admit_v1(uuid) from public,anon,authenticated,service_role;

create or replace function public.weekly_source_agency_legacy_import_validation_admit_v1(p_import_id uuid,p_actor_user_id uuid)
returns boolean language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
begin
 perform private.weekly_source_query_require_service_v1();
 if not exists(select 1 from public.tms_users where id=p_actor_user_id and is_active and lower(btrim(role))='admin') then
  raise exception 'ADMIN_REQUIRED' using errcode='42501';end if;
 return private.weekly_source_agency_legacy_import_validation_admit_v1(p_import_id);
end;
$function$;
alter function public.weekly_source_agency_legacy_import_validation_admit_v1(uuid,uuid) owner to postgres;
revoke all on function public.weekly_source_agency_legacy_import_validation_admit_v1(uuid,uuid) from public,anon,authenticated;
grant execute on function public.weekly_source_agency_legacy_import_validation_admit_v1(uuid,uuid) to service_role;


-- Exact selected runtime component 24: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/22_53_agency_same_draft_return_step.sqlinc
-- Mechanical RETURN after genuine typed validation AND its native recompute.
-- The whole-week producer/writer/authorised Worker mode are required source
-- dependencies, not supplied by an asserted readiness flag in this function.
create or replace function private.weekly_source_agency_change_return_step_v1(
 p_request_id uuid,p_actual_actor_user_id uuid
) returns private.weekly_source_agency_timesheet_change_requests
language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 actor public.tms_users%rowtype; ts public.timesheets%rowtype;
 fin public.timesheets_financials%rowtype; validation public.timesheet_validations%rowtype;
 week_facts record; receipt jsonb; stored_validation jsonb; completion jsonb;
 signature jsonb; actual_signature text; error_code text; error_state text;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,
  r.initial_row_signature,r.request_key,p_actual_actor_user_id);
 select * into strict actor from public.tms_users where id=p_actual_actor_user_id and is_active;
 if r.state='COMPLETED' then
  if r.completed_receipt->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_NATIVE_COMPLETED_V1'
   or r.completed_receipt->>'request_id' is distinct from r.id::text
   or r.completed_receipt->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
   or r.completed_receipt->>'timesheet_id' is distinct from r.current_timesheet_id::text
   or r.completed_receipt->>'timesheet_version' is distinct from r.current_timesheet_version::text
   or r.completed_receipt->>'original_draft_invoice_id' is distinct from r.original_draft_invoice_id::text
   or r.completed_receipt->>'original_creator_user_id' is distinct from r.actor_user_id::text
   or r.completed_receipt->>'completed_actor_user_id' is distinct from r.completed_by_user_id::text
   or r.return_hold or r.completed_at_utc is null or r.phase<>'COMPLETED'
   or (r.completed_receipt->>'completed_at_utc')::timestamptz is distinct from r.completed_at_utc then
   raise exception 'AGENCY_CHANGE_GENUINE_COMPLETED_RECEIPT_REQUIRED' using errcode='55000';end if;
  return r; -- Current reader authority was checked; original step actor stays immutable.
 end if;
 if r.phase<>'AUTHORISED' then raise exception 'AGENCY_CHANGE_RETURN_PHASE_NOT_READY' using errcode='55000';end if;
 begin
  select * into strict ts from public.timesheets where timesheet_id=r.current_timesheet_id for update;
  select * into strict fin from public.timesheets_financials where id=r.current_financial_id and is_current for update;
  select * into strict validation from public.timesheet_validations where timesheet_id=ts.timesheet_id for update;
  select * into strict week_facts from private.weekly_source_agency_week_complete_v1(ts.timesheet_id);
  if ts.timesheet_id is distinct from r.initial_timesheet_id or ts.version is distinct from r.current_timesheet_version
   or ts.is_current is distinct from true or ts.revoked_at is not null or ts.archived_at_utc is not null
   or ts.authorised_at_server is null or fin.authorised_at_utc is distinct from ts.authorised_at_server
   or fin.authorised_by_user_id::text is distinct from r.native_receipts#>>'{authorise,phase_actor_user_id}'
   or (r.native_receipts#>>'{authorise,authorised_at_server}')::timestamptz is distinct from ts.authorised_at_server
   or fin.timesheet_version is distinct from ts.version or fin.is_stale is distinct from false
   or fin.processing_status::text is distinct from 'READY_FOR_INVOICE' or fin.locked_by_invoice_id is not null
   or validation.validation_source_kind is distinct from 'AGENCY_INVOICE_WEEK'
   or validation.validation_source_publication_id is distinct from r.source_publication_id
   or validation.last_source is not null or validation.status::text is distinct from 'VALIDATION_OK'
   or validation.pre_validated or validation.validated_at_utc is null
   or week_facts.complete is distinct from true or week_facts.reasons is distinct from array[]::text[]
   or week_facts.facts_hash is null or week_facts.facts_hash!~'^[0-9a-f]{64}$'
   or encode(validation.validation_source_facts_sha256,'hex') is distinct from week_facts.facts_hash then
   raise exception 'AGENCY_CHANGE_CURRENT_NATIVE_WEEK_VALIDATION_REQUIRED' using errcode='55000';end if;
  stored_validation:=r.native_receipts->'validation_recompute';
  if jsonb_typeof(stored_validation) is distinct from 'object'
   or stored_validation->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_NATIVE_VALIDATION_RECOMPUTE_V1'
   or stored_validation->>'request_id' is distinct from r.id::text
   or stored_validation->>'timesheet_id' is distinct from ts.timesheet_id::text
   or stored_validation->>'timesheet_version' is distinct from ts.version::text
   or stored_validation->>'financial_id' is distinct from fin.id::text
   or stored_validation->>'publication_id' is distinct from r.source_publication_id::text
   or stored_validation->>'facts_sha256' is distinct from week_facts.facts_hash
   or stored_validation->>'validation_actor_user_id' is distinct from validation.validation_source_actor_user_id::text
   or stored_validation->>'native_ok_count' is distinct from '1'
   or stored_validation->>'native_fail_count' is distinct from '0'
   or stored_validation->>'observed_outbox_id' is null
   or stored_validation->>'financial_row_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_VALIDATION_RECOMPUTE_ROW_V1',to_jsonb(fin)),'hex') then
   raise exception 'AGENCY_CHANGE_GENUINE_VALIDATION_RECOMPUTE_RECEIPT_REQUIRED' using errcode='55000';end if;
  -- This native readiness read does not advance from queue absence or TSFIN status.
  -- Receipt production must be mounted from the actual canonical writer/complete owner.
  receipt:=private.weekly_source_agency_draft_round_trip_v1(r.request_key,'RETURN',p_actual_actor_user_id);
  if receipt->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_DRAFT_ROUND_TRIP_RECEIPT_V1'
   or receipt->>'ok' is distinct from 'true' or receipt->>'request_id' is distinct from r.id::text
   or receipt->>'step' is distinct from 'RETURN'
   or receipt->>'phase_actor_user_id' is distinct from p_actual_actor_user_id::text
   or receipt->>'original_draft_invoice_id' is distinct from r.original_draft_invoice_id::text
   or receipt->>'original_draft_invoice_no' is distinct from r.original_draft_invoice_no
   or (r.original_draft_invoice_id is null and receipt->>'not_required' is distinct from 'true')
   or (r.original_draft_invoice_id is not null and
      (receipt->>'timesheet_id' is distinct from r.current_timesheet_id::text
       or receipt->>'financial_id' is distinct from r.current_financial_id::text)) then
   raise exception 'AGENCY_CHANGE_GENUINE_SAME_D1_RETURN_RECEIPT_REQUIRED' using errcode='55000';end if;
  signature:=public.timesheet_lifecycle_guard_signature_v1(r.current_timesheet_id,r.contract_week_id,false);
  actual_signature:=nullif(btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature')),'');
  if actual_signature is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000';end if;
  completion:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_COMPLETED_V1','request_id',r.id,
   'request_sha256',encode(r.request_sha256,'hex'),'original_creator_user_id',r.actor_user_id,
   'completed_actor_user_id',p_actual_actor_user_id,'timesheet_id',ts.timesheet_id,'timesheet_version',ts.version,
   'financial_id',fin.id,'original_draft_invoice_id',r.original_draft_invoice_id,
   'original_draft_invoice_no',r.original_draft_invoice_no,'publication_id',r.source_publication_id,
   'week_facts_sha256',week_facts.facts_hash,'validation_recompute',stored_validation,'return_receipt',receipt,
   'completed_at_utc',transaction_timestamp(),'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid());
  if octet_length(completion::text)>16384 or octet_length((r.native_receipts||jsonb_build_object('return',receipt))::text)>65536 then
   raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED' using errcode='54000';end if;
  update private.weekly_source_agency_timesheet_change_requests set state='COMPLETED',phase='COMPLETED',return_hold=false,
   native_receipts=native_receipts||jsonb_build_object('return',receipt),completed_receipt=completion,
   current_row_signature=actual_signature,completed_at_utc=transaction_timestamp(),completed_by_user_id=p_actual_actor_user_id,
   updated_by_user_id=p_actual_actor_user_id,updated_at_utc=transaction_timestamp(),version=version+1,last_refusal_code=null
   where id=r.id returning * into r;
  insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,action,after_json,reason,correlation_id)
  values(gen_random_uuid(),transaction_timestamp(),p_actual_actor_user_id,actor.role,'WEEKLY_SOURCE_AGENCY_CHANGE',r.id::text,
   'NATIVE_SAME_D1_RETURN_COMPLETED',jsonb_build_object('phase',r.phase,'original_draft_invoice_id',r.original_draft_invoice_id,
    'original_creator_user_id',r.actor_user_id,'actual_phase_actor_user_id',p_actual_actor_user_id),r.reason,r.request_key);
 exception when others then
  get stacked diagnostics error_code=MESSAGE_TEXT,error_state=RETURNED_SQLSTATE;
  if error_state='55P03' then raise;end if;
  update private.weekly_source_agency_timesheet_change_requests set last_refusal_code=case
   when error_state='42883' then 'AGENCY_CHANGE_NATIVE_WEEK_PRODUCER_UNAVAILABLE'
   when error_code~'^[A-Z][A-Z0-9_]{0,199}$' then error_code else 'AGENCY_CHANGE_NATIVE_RETURN_FAILED' end,
   version=version+1,updated_at_utc=transaction_timestamp() where id=p_request_id returning * into r;
 end;
 return r;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_RETURN_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_change_return_step_v1(uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_change_return_step_v1(uuid,uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 25: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/23_54_return_step_service_reply.sqlinc
-- Mechanical service continuation of the one business request. This reply
-- gives no invoice edit payload/financial preparation/private authority frame.
create or replace function public.weekly_source_agency_change_return_step_v1(p_request_id uuid,p_actor_user_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype;
begin
 perform private.weekly_source_query_require_service_v1();
 r:=private.weekly_source_agency_change_return_step_v1(p_request_id,p_actor_user_id);
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_RETURN_STEP_RESULT_V1',
  'request_id',r.id,'request_version',r.version,'phase',r.phase,'view_actor_user_id',p_actor_user_id,
  'timesheet_id',r.current_timesheet_id,'timesheet_version',r.current_timesheet_version,
  'completed',r.state='COMPLETED','last_refusal_code',r.last_refusal_code,
  'completed_actor_user_id',r.completed_by_user_id,'return_invoice_no',case when r.state='COMPLETED' then r.original_draft_invoice_no end,
  'completion_sha256',case when r.state='COMPLETED' then encode(private.weekly_source_sha256_jsonb_v1(
     'WEEKLY_SOURCE_AGENCY_NATIVE_COMPLETED_RECEIPT_V1',r.completed_receipt),'hex') end);
end;
$function$;
alter function public.weekly_source_agency_change_return_step_v1(uuid,uuid) owner to postgres;
revoke all on function public.weekly_source_agency_change_return_step_v1(uuid,uuid) from public,anon,authenticated;
grant execute on function public.weekly_source_agency_change_return_step_v1(uuid,uuid) to service_role;


-- Exact selected runtime component 26: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/24_19_agency_native_worker_apply.sqlinc
-- Source construction: actual canonical Worker/manual/native queued writer
-- bridge. This does not complete paid-domain, protection or AUTHORISE/D1 proof.
create or replace function private.weekly_source_agency_snapshot_provenance_assert_v1(
 p_request_id uuid,p_snapshot jsonb
) returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 schedule jsonb; segments jsonb; source_entry jsonb; segment jsonb; matches integer;
begin
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 schedule:=r.native_receipts#>'{original_capture,schedule}';
 segments:=p_snapshot#>'{invoice_breakdown_json,segments}';
 if jsonb_typeof(p_snapshot) is distinct from 'object' or octet_length(p_snapshot::text)>1048576
  or p_snapshot->>'timesheet_id' is distinct from r.current_timesheet_id::text
  or p_snapshot->>'timesheet_version' is distinct from r.current_timesheet_version::text
  or p_snapshot->>'candidate_id' is distinct from r.candidate_id::text
  or p_snapshot->>'client_id' is distinct from r.client_id::text
  or p_snapshot->'actual_schedule_json' is distinct from schedule
  or jsonb_typeof(schedule) is distinct from 'array' or jsonb_typeof(segments) is distinct from 'array'
  or jsonb_array_length(schedule)>100 or jsonb_array_length(segments)<>jsonb_array_length(schedule)
  or p_snapshot#>>'{invoice_breakdown_json,mode}' is distinct from 'SEGMENTS' then
  raise exception 'AGENCY_CHANGE_CANONICAL_SOURCE_PROVENANCE_INVALID' using errcode='22023'; end if;
 perform public._ctms_assert_tsfin_snapshot_policy_v1(r.current_timesheet_id,p_snapshot);
 for source_entry in select value from jsonb_array_elements(schedule) loop
  -- Re-derive membership from the locked actual native capture and native
  -- event identity. Native Source CAS/rule/finalisation is checked separately.
  if not exists(select 1 from public.weekly_work_events e
    where e.id=(source_entry->>'work_event_id')::uuid and e.candidate_id=r.candidate_id
      and e.client_id=r.client_id and e.first_source_group_id=r.source_group_id
      and e.work_date=(source_entry->>'date')::date)
   or source_entry->>'source_shift_id' is distinct from source_entry->>'work_event_id' then
   raise exception 'AGENCY_CHANGE_NATIVE_SOURCE_EVENT_CHANGED' using errcode='40001'; end if;
  select count(*) into matches from jsonb_array_elements(segments) s
   where s->>'work_event_id'=source_entry->>'work_event_id'
     and s->>'source_shift_id'=source_entry->>'work_event_id'
     and s->>'date'=source_entry->>'date' and s->>'start'=source_entry->>'start'
     and s->>'end'=source_entry->>'end'
     and (s->>'break_mins')::numeric=(source_entry->>'break_minutes')::numeric
     and (s->>'is_reversal')::boolean is not true;
  if matches<>1 then raise exception 'AGENCY_CHANGE_NATIVE_SOURCE_EVENT_CHANGED' using errcode='40001'; end if;
 end loop;
 for segment in select value from jsonb_array_elements(segments) loop
  if not exists(select 1 from jsonb_array_elements(schedule) e where e->>'work_event_id'=segment->>'work_event_id')
   or segment->>'segment_id' is null or segment->>'segment_id'=''
   or nullif(segment->>'invoice_locked_invoice_id','') is not null then
   raise exception 'AGENCY_CHANGE_CANONICAL_SOURCE_PROVENANCE_INVALID' using errcode='22023'; end if;
 end loop;
 if (select count(distinct s->>'segment_id') from jsonb_array_elements(segments) s)<>jsonb_array_length(segments) then
  raise exception 'AGENCY_CHANGE_CANONICAL_SOURCE_PROVENANCE_INVALID' using errcode='22023'; end if;
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'AGENCY_CHANGE_CANONICAL_SOURCE_PROVENANCE_INVALID' using errcode='22023';
end;
$function$;
alter function private.weekly_source_agency_snapshot_provenance_assert_v1(uuid,jsonb) owner to postgres;
revoke all on function private.weekly_source_agency_snapshot_provenance_assert_v1(uuid,jsonb)
 from public,anon,authenticated,service_role;

create or replace function public.weekly_source_agency_change_worker_apply_v1(
 p_request_id uuid,p_expected_request_version bigint,p_expected_context_sha256 text,p_snapshot jsonb
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; before_ts public.timesheets%rowtype; f public.timesheets_financials%rowtype;
 q public.ts_financials_outbox%rowtype; before_queue jsonb; context jsonb; result jsonb; observation jsonb;
 receipts jsonb; signature jsonb; old_phase text; actor uuid; observed boolean:=false; queue_complete boolean:=false;
 error_code text; write_result record; next_signature text;
begin
 perform private.weekly_source_query_require_service_v1();
 if p_request_id is null or p_expected_request_version is null or p_expected_request_version<1
  or p_expected_context_sha256 is null or p_expected_context_sha256!~'^[0-9a-f]{64}$' then
  raise exception 'AGENCY_CHANGE_WORKER_APPLY_INVALID' using errcode='22023'; end if;
 context:=private.weekly_source_agency_change_worker_context_v1(p_request_id);
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id for update;
 if r.version is distinct from p_expected_request_version
  or context->>'context_sha256' is distinct from p_expected_context_sha256 then
  raise exception 'AGENCY_CHANGE_WORKER_CONTEXT_CHANGED' using errcode='40001'; end if;
 old_phase:=r.phase;actor:=r.updated_by_user_id;
 begin
  perform private.weekly_source_agency_snapshot_provenance_assert_v1(r.id,p_snapshot);
  if old_phase='UNAUTHORISED' then
   select * into strict before_ts from public.timesheets where timesheet_id=r.current_timesheet_id;
   perform private.weekly_source_agency_financial_frame_open_v1(r.id,'MANUAL',p_snapshot,null::uuid);
   -- One existing manual owner, same physical T0, no rotation/evidence selector.
   -- Patch is derived entirely from the genuine immutable Source capture.
   result:=public.contract_week_manual_upsert_atomic(
    p_week_id=>r.contract_week_id,p_expected_timesheet_id=>r.current_timesheet_id,
    p_timesheet_create_json=>null::jsonb,
    p_timesheet_patch_json=>jsonb_build_object('actual_schedule_json',r.native_receipts#>'{original_capture,schedule}'),
    p_contract_week_patch_json=>'{}'::jsonb,p_tsfin_snapshot_json=>p_snapshot,p_rotation_json=>null::jsonb,
    p_actor_user_id=>actor,p_materialise_staged_evidence=>false,p_now_utc=>transaction_timestamp(),
    p_expected_row_signature=>r.current_row_signature,
    p_queue_timesheet_materialisation_json=>jsonb_build_object('suppress_timesheet_evidence_materialisation',true));
   select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
   select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
   select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
   observation:=r.native_receipts->'manual_financial_write';
   if result->>'ok' is distinct from 'true' or result->>'operation' is distinct from 'weekly_manual_process_update'
    or result->>'created_now' is distinct from 'false' or result->>'timesheet_id' is distinct from t.timesheet_id::text
    or result->>'timesheet_financials_id' is distinct from f.id::text
    or t.version is distinct from r.current_timesheet_version
    or to_jsonb(t)-array['actual_schedule_json','updated_at']
      is distinct from to_jsonb(before_ts)-array['actual_schedule_json','updated_at']
    or t.actual_schedule_json is distinct from r.native_receipts#>'{original_capture,schedule}'
    or observation->>'financial_id' is distinct from f.id::text
    or observation->>'transaction_id' is distinct from pg_current_xact_id()::text
    or observation->>'backend_pid' is distinct from pg_backend_pid()::text then
    raise exception 'AGENCY_CHANGE_NATIVE_MANUAL_POSTCONDITION_UNPROVED'; end if;
   next_signature:=result->>'backend_row_signature';
   if nullif(btrim(next_signature),'') is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE'; end if;
   receipts:=r.native_receipts||jsonb_build_object('manual_process',jsonb_build_object(
     'schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_MANUAL_PROCESS_V1','phase_actor_user_id',actor,
     'native_result_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_NATIVE_MANUAL_RESULT_V1',result),'hex'),
     'timesheet_id',t.timesheet_id,'financial_id',f.id,'current_row_signature',next_signature));
   update private.weekly_source_agency_timesheet_change_requests set phase='SCHEDULE_APPLIED',native_receipts=receipts,
    current_financial_id=f.id,current_row_signature=next_signature,version=version+1,updated_at_utc=transaction_timestamp()
    where id=r.id returning * into r;
   select to_jsonb(existing) into before_queue from public.ts_financials_outbox existing
    where existing.timesheet_id=t.timesheet_id and existing.reason='MANUAL'::public.ts_fin_reason_enum;
   -- Preserve the existing upsert/queue owner and its genuine row identity.
   perform public.enqueue_ts_financials(t.timesheet_id,'MANUAL'::public.ts_fin_reason_enum);
   select * into strict q from public.ts_financials_outbox
    where timesheet_id=t.timesheet_id and reason='MANUAL'::public.ts_fin_reason_enum for update;
   if q.attempt_count<>0 or q.next_attempt_at is not null or q.last_error is not null then
    raise exception 'AGENCY_CHANGE_NATIVE_ENQUEUE_UNPROVED'; end if;
   receipts:=r.native_receipts||jsonb_build_object('enqueue',jsonb_build_object(
    'schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_ENQUEUE_V1','phase_actor_user_id',actor,
    'outbox_id',q.id,'timesheet_id',q.timesheet_id,'reason',q.reason,
    'before_sha256',case when before_queue is null then null else encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_NATIVE_QUEUE_BEFORE_V1',before_queue),'hex') end,
    'after_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_NATIVE_QUEUE_AFTER_V1',to_jsonb(q)),'hex')));
   update private.weekly_source_agency_timesheet_change_requests set phase='RECOMPUTE_PENDING',native_receipts=receipts,
    outbox_id=q.id,outbox_reason=q.reason,version=version+1,updated_at_utc=transaction_timestamp(),last_refusal_code=null
    where id=r.id returning * into r;
   observed:=true;
  elsif old_phase='RECOMPUTE_PENDING' then
   -- This is the exact queued native owner; no Worker no-op or paid-success
   -- shortcut. The new E26 observation must precede its real queue success.
   select * into strict write_result from public.tsfin_write_snapshots_and_complete(jsonb_build_array(
     jsonb_build_object('outbox_id',r.outbox_id,'timesheet_id',r.current_timesheet_id,'snapshot',p_snapshot)));
   select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
   observation:=r.native_receipts->'recompute';
   select * into strict f from public.timesheets_financials where id=r.current_financial_id and is_current;
   if write_result.ok_count is distinct from 1 or write_result.fail_count is distinct from 0
    or write_result.errors is distinct from '[]'::jsonb
    or observation->>'observed_outbox_id' is distinct from r.outbox_id::text
    or observation->>'financial_id' is distinct from f.id::text
    or observation->>'transaction_id' is distinct from pg_current_xact_id()::text
    or observation->>'backend_pid' is distinct from pg_backend_pid()::text
    or observation->>'financial_row_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_RECOMPUTE_ROW_V1',to_jsonb(f)),'hex')
    or exists(select 1 from public.ts_financials_outbox where id=r.outbox_id) then
    raise exception 'AGENCY_CHANGE_NATIVE_RECOMPUTE_POSTCONDITION_UNPROVED'; end if;
   signature:=public.timesheet_lifecycle_guard_signature_v1(r.current_timesheet_id,r.contract_week_id,false);
   next_signature:=btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature'));
   if nullif(next_signature,'') is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE'; end if;
   receipts:=r.native_receipts||jsonb_build_object('queue_completion',jsonb_build_object(
    'schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_QUEUE_COMPLETION_V1','outbox_id',r.outbox_id,
    'timesheet_id',r.current_timesheet_id,'financial_id',f.id,'phase_actor_user_id',actor,
    'native_ok_count',write_result.ok_count,'native_fail_count',write_result.fail_count,
    'actual_observation_transaction_id',observation->'transaction_id','actual_observation_backend_pid',observation->'backend_pid'));
   update private.weekly_source_agency_timesheet_change_requests set phase='FINANCIAL_CURRENT',native_receipts=receipts,
    current_row_signature=next_signature,version=version+1,updated_at_utc=transaction_timestamp(),last_refusal_code=null
    where id=r.id returning * into r;
   observed:=true;queue_complete:=true;
  else raise exception 'AGENCY_CHANGE_WORKER_PHASE_NOT_READY'; end if;
  if octet_length(r.native_receipts::text)>65536 then raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED'; end if;
 exception when others then
  get stacked diagnostics error_code=MESSAGE_TEXT;
  update private.weekly_source_agency_timesheet_change_requests set last_refusal_code=case
    when error_code~'^[A-Z][A-Z0-9_]{0,199}$' then error_code else 'AGENCY_CHANGE_NATIVE_PHASE_FAILED' end,
    version=version+1,updated_at_utc=transaction_timestamp() where id=p_request_id returning * into r;
  observed:=false;queue_complete:=false;
 end;
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_WORKER_RESULT_V1',
  'request_id',r.id,'request_version',r.version,'phase',r.phase,'phase_actor_user_id',r.updated_by_user_id,
  'timesheet_id',r.current_timesheet_id,'timesheet_version',r.current_timesheet_version,
  'current_financial_id',r.current_financial_id,'outbox_id',r.outbox_id,'last_refusal_code',r.last_refusal_code,
  'native_write_observed',observed,'native_queue_completed',queue_complete);
end;
$function$;
alter function public.weekly_source_agency_change_worker_apply_v1(uuid,bigint,text,jsonb) owner to postgres;
revoke all on function public.weekly_source_agency_change_worker_apply_v1(uuid,bigint,text,jsonb) from public,anon,authenticated;
grant execute on function public.weekly_source_agency_change_worker_apply_v1(uuid,bigint,text,jsonb) to service_role;


-- Exact selected runtime component 27: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/25_84_complete_native_worker_context_with_manual_typed_validation.sqlinc
-- Finite service-only canonical Worker input. No Office/browser read projection,
-- caller phase/actor/schedule selector, calculation or mutation-in-read.
create or replace function public.weekly_source_agency_change_worker_targets_v1(p_timesheet_ids uuid[])
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if p_timesheet_ids is null or cardinality(p_timesheet_ids) not between 1 and 100
  or array_position(p_timesheet_ids,null::uuid) is not null
  or (select count(distinct id) from unnest(p_timesheet_ids) id)<>cardinality(p_timesheet_ids) then
  raise exception 'AGENCY_CHANGE_WORKER_TARGETS_INVALID' using errcode='22023'; end if;
 select coalesce(jsonb_agg(jsonb_build_object('request_id',r.id,'timesheet_id',r.current_timesheet_id,
   'phase',r.phase,'outbox_id',r.outbox_id) order by r.current_timesheet_id),'[]'::jsonb) into result
 from private.weekly_source_agency_timesheet_change_requests r
 where r.state='ACTIVE' and r.current_timesheet_id=any(p_timesheet_ids);
 if jsonb_array_length(result)>100 or octet_length(result::text)>65536 then
  raise exception 'AGENCY_CHANGE_WORKER_TARGETS_BOUND_EXCEEDED' using errcode='54000'; end if;
 return result;
end;
$function$;
alter function public.weekly_source_agency_change_worker_targets_v1(uuid[]) owner to postgres;
revoke all on function public.weekly_source_agency_change_worker_targets_v1(uuid[]) from public,anon,authenticated;
grant execute on function public.weekly_source_agency_change_worker_targets_v1(uuid[]) to service_role;

create or replace function private.weekly_source_agency_change_worker_context_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
 q public.ts_financials_outbox%rowtype; context jsonb; weekly jsonb; frame jsonb; claim jsonb;
 validation jsonb; shifts jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,
   r.initial_row_signature,r.request_key,r.updated_by_user_id);
 if r.state<>'ACTIVE' or r.phase not in('UNAUTHORISED','RECOMPUTE_PENDING') then
  raise exception 'AGENCY_CHANGE_WORKER_PHASE_NOT_READY' using errcode='55000'; end if;
 select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
 select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
 if t.version is distinct from r.current_timesheet_version or f.id is distinct from r.current_financial_id
  or f.timesheet_version is distinct from t.version or f.locked_by_invoice_id is not null
  or t.authorised_at_server is not null or exists(select 1 from public.invoice_lines where timesheet_id=t.timesheet_id) then
  raise exception 'AGENCY_CHANGE_WORKER_CURRENT_TARGET_CHANGED' using errcode='40001'; end if;
 -- Current native planned-request purpose preserves original evidence,
 -- even when its hours parser is unavailable. It does not grant Protect pay.
 perform private.weekly_source_agency_paid_write_purpose_v1(r.id);
 if r.phase='RECOMPUTE_PENDING' then
  select * into strict q from public.ts_financials_outbox where id=r.outbox_id;
  if q.timesheet_id is distinct from t.timesheet_id or q.reason is distinct from r.outbox_reason
   or r.outbox_reason is distinct from 'MANUAL'::public.ts_fin_reason_enum
   or q.attempt_count<1 or q.next_attempt_at is null or q.next_attempt_at<=transaction_timestamp() then
   raise exception 'AGENCY_CHANGE_NATIVE_OUTBOX_CHANGED' using errcode='40001'; end if;
 end if;
 select to_jsonb(x) into strict context from public.tsfin_load_context_batch(array[t.timesheet_id]) x
  where x.effective_timesheet_id=t.timesheet_id;
 select to_jsonb(x) into strict weekly from public.tsfin_load_weekly_context_batch(array[t.timesheet_id]) x
  where x.timesheet_id=t.timesheet_id;
 if (select count(*) from public.timesheet_validations where timesheet_id=t.timesheet_id)>1 then
  raise exception 'AGENCY_CHANGE_NATIVE_VALIDATION_AMBIGUOUS' using errcode='55000'; end if;
 select jsonb_build_object('timesheet_id',v.timesheet_id,'status',v.status,'reason_code',v.reason_code,
   'validated_at_utc',v.validated_at_utc,'updated_at',v.updated_at,
   'validation_source_kind',v.validation_source_kind) into validation
 from public.timesheet_validations v where v.timesheet_id=t.timesheet_id;
 select x.shifts into strict shifts from public.tsfin_load_nhsp_shifts_batch(array[t.timesheet_id]) x
  where x.timesheet_id=t.timesheet_id;
 if jsonb_typeof(shifts) is distinct from 'array' or jsonb_array_length(shifts)>100 then
  raise exception 'AGENCY_CHANGE_NATIVE_CALCULATOR_CONTEXT_BOUND_EXCEEDED' using errcode='54000'; end if;
 if context#>>'{out_timesheet,timesheet_id}' is distinct from t.timesheet_id::text
  or context#>>'{out_cur_fin,id}' is distinct from f.id::text
  or context#>>'{out_candidate,id}' is distinct from r.candidate_id::text
  or context->>'out_client_id' is distinct from r.client_id::text
  or weekly#>>'{out_cw,id}' is distinct from r.contract_week_id::text
  or weekly#>>'{out_contract,id}' is distinct from r.contract_id::text
  or weekly#>>'{out_contract,candidate_id}' is distinct from r.candidate_id::text
  or weekly#>>'{out_contract,client_id}' is distinct from r.client_id::text then
  raise exception 'AGENCY_CHANGE_NATIVE_CALCULATOR_CONTEXT_UNAVAILABLE' using errcode='55000'; end if;
 frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_CANONICAL_WORKER_CONTEXT_V1',
   'request_id',r.id,'request_sha256',encode(r.request_sha256,'hex'),'request_version',r.version,
   'phase',r.phase,'phase_actor_user_id',r.updated_by_user_id,'current_row_signature',r.current_row_signature,
   'source_cas',r.source_cas,'source_schedule',r.native_receipts#>'{original_capture,schedule}',
   'outbox_id',r.outbox_id,'outbox_reason',r.outbox_reason,
   'outbox_row',case when r.phase='RECOMPUTE_PENDING' then to_jsonb(q) else null::jsonb end,
   'context',context,'weekly_context',weekly,'weekly_validation',validation,'nhsp_shifts',shifts);
 if r.version>9007199254740991 or octet_length(frame::text)>2097152 then
  raise exception 'AGENCY_CHANGE_WORKER_CONTEXT_BOUND_EXCEEDED' using errcode='54000'; end if;
 return frame||jsonb_build_object('context_sha256',encode(private.weekly_source_sha256_jsonb_v1(
   'WEEKLY_SOURCE_AGENCY_CANONICAL_WORKER_CONTEXT_V1',frame),'hex'));
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_CALCULATOR_CONTEXT_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_change_worker_context_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_change_worker_context_v1(uuid)
 from public,anon,authenticated,service_role;

create or replace function public.weekly_source_agency_change_worker_context_v1(p_request_id uuid)
returns jsonb language sql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
 select private.weekly_source_agency_change_worker_context_v1(p_request_id);
$function$;
alter function public.weekly_source_agency_change_worker_context_v1(uuid) owner to postgres;
revoke all on function public.weekly_source_agency_change_worker_context_v1(uuid) from public,anon,authenticated;
grant execute on function public.weekly_source_agency_change_worker_context_v1(uuid) to service_role;


-- Exact selected runtime component 28: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/26_80_native_agency_business_entry.sqlinc
-- Primary 26.5.1's single positional business owner. Existing native owners
-- retain all actor, source, physical, financial, claim and same-D1 admission.
-- This source proposal is not mounted or qualified until the joint Source
-- arbiter/caller/foreign-writer composition and native gates are complete.
create or replace function public.weekly_source_agency_timesheet_change_v1(
 p_contract_week_id uuid,p_reason text,p_expected_signature text,p_request_key text,p_actor_user_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype; continuation text; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 -- Begin rechecks the original immutable business digest, the real current
 -- scoped actor and the native physical/Source phase postconditions on replay.
 -- It never substitutes a new Source capture or an actor for the original click.
 r:=private.weekly_source_agency_change_begin_v1(p_contract_week_id,p_reason,
   p_expected_signature,p_request_key,p_actor_user_id);
 -- A prior causal refusal is not a permanent resume prohibition. Each owner
 -- rederives its actual postconditions before retrying the SAME request.
 if r.state='ACTIVE' and r.phase='FINANCIAL_CURRENT' then
  r:=private.weekly_source_agency_change_authorise_step_v1(r.id,p_actor_user_id);
 end if;
 if r.state='ACTIVE' and r.phase='AUTHORISED' then
  r:=private.weekly_source_agency_change_return_step_v1(r.id,p_actor_user_id);
 end if;
 if r.environment is distinct from 'TEST' or r.contract_week_id is distinct from p_contract_week_id
  or r.request_key is distinct from p_request_key or r.reason is distinct from p_reason
  or r.initial_row_signature is distinct from p_expected_signature
  or r.current_timesheet_id is distinct from r.initial_timesheet_id
  or r.current_timesheet_version is distinct from r.initial_timesheet_version
  or r.version not between 1 and 9007199254740991
  or r.state not in('ACTIVE','COMPLETED') then
  raise exception 'AGENCY_CHANGE_NATIVE_BUSINESS_RESULT_INVALID' using errcode='55000';end if;
 if r.state='COMPLETED' and (r.phase<>'COMPLETED' or r.return_hold
  or r.completed_receipt is null or r.completed_by_user_id is null or r.completed_at_utc is null or r.last_refusal_code is not null
  or r.completed_receipt->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_NATIVE_COMPLETED_V1'
  or r.completed_receipt->>'request_id' is distinct from r.id::text
  or r.completed_receipt->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
  or r.completed_receipt->>'timesheet_id' is distinct from r.current_timesheet_id::text
  or r.completed_receipt->>'completed_actor_user_id' is distinct from r.completed_by_user_id::text) then
  raise exception 'AGENCY_CHANGE_GENUINE_COMPLETION_RECEIPT_REQUIRED' using errcode='55000';end if;
 continuation:=case when r.state='COMPLETED' then 'NONE'
  when r.phase='UNAUTHORISED' then 'MANUAL'
  when r.phase in('RECOMPUTE_PENDING','AUTHORISED') then 'WORKER' else 'NONE' end;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_BUSINESS_RESULT_V1',
  'request_id',r.id,'request_key',r.request_key,'request_sha256',encode(r.request_sha256,'hex'),
  'request_version',r.version,'state',r.state,'phase',r.phase,'view_actor_user_id',p_actor_user_id,
  'contract_week_id',r.contract_week_id,'timesheet_id',r.current_timesheet_id,
  'timesheet_version',r.current_timesheet_version,'current_row_signature',r.current_row_signature,
  'completed',r.state='COMPLETED','completed_actor_user_id',r.completed_by_user_id,
  'return_invoice_no',case when r.state='COMPLETED' then r.original_draft_invoice_no end,
  'completion_sha256',case when r.state='COMPLETED' then encode(private.weekly_source_sha256_jsonb_v1(
   'WEEKLY_SOURCE_AGENCY_NATIVE_COMPLETED_RECEIPT_V1',r.completed_receipt),'hex') end,
  'last_refusal_code',r.last_refusal_code,'return_hold',r.return_hold,'continuation',continuation,
  'code',case when r.state='COMPLETED' then 'OK' when r.last_refusal_code is not null then r.last_refusal_code
    else 'AGENCY_INVOICE_TSFIN_NOT_READY' end);
 if octet_length(result::text)>16384 then
  raise exception 'AGENCY_CHANGE_NATIVE_BUSINESS_RESULT_BOUND_EXCEEDED' using errcode='54000';end if;
 return result;
end;
$function$;
alter function public.weekly_source_agency_timesheet_change_v1(uuid,text,text,text,uuid) owner to postgres;
revoke all on function public.weekly_source_agency_timesheet_change_v1(uuid,text,text,text,uuid)
 from public,anon,authenticated,service_role;
grant execute on function public.weekly_source_agency_timesheet_change_v1(uuid,text,text,text,uuid) to service_role;


-- Exact selected runtime component 29: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/27_08_native_agency_crosscheck_context.sqlinc
-- Service Worker support projection. Actual clinical comparison and typed
-- completeness stay with their existing native owners; no second comparison.
create or replace function private.weekly_source_agency_crosscheck_context_v1(p_timesheet_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare t public.timesheets%rowtype; main_id uuid; facts jsonb; validation public.timesheet_validations%rowtype;
  hi public.hr_imports%rowtype; rows_json jsonb; source_count integer; comparison_count integer; record_json jsonb;
  has_native_mismatch boolean; has_native_ambiguity boolean;
begin
  perform private.weekly_source_query_require_service_v1();
  select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
  if private.weekly_source_agency_invoice_check_only_v1(t.timesheet_id) is distinct from true then
    return jsonb_build_object('contract','WEEKLY_SOURCE_AGENCY_CROSSCHECK_CONTEXT_V1','timesheet_id',t.timesheet_id,
      'timesheet_version',t.version,'is_agency_invoice',false);
  end if;
  if t.is_current is distinct from true or t.revoked_at is not null or t.archived_at_utc is not null
    or t.sheet_scope::text<>'WEEKLY' or t.line_type::text<>'HOURS' then
    raise exception 'AGENCY_INVOICE_SUPPORT_TIMESHEET_STALE' using errcode='40001';end if;
  select cw.timesheet_id into strict main_id from public.contract_weeks cw
    where cw.contract_id=t.contract_id and cw.week_ending_date=t.week_ending_date
      and coalesce(cw.additional_seq,0)=0 and not cw.is_adjustment;
  facts:=private.weekly_source_agency_week_facts_v1(main_id);
  select value into strict record_json from jsonb_array_elements(facts->'records') r(value)
    where r->>'timesheet_id'=t.timesheet_id::text and r->>'timesheet_version'=t.version::text;
  -- A real bridge import is the deterministic established Mode A import,
  -- never a Source UUID relabelled as hr_imports provenance.
  select * into strict hi from public.hr_imports
    where coverage_operation_key=private.weekly_source_mode_a_operation_key_v1((facts->>'publication_id')::uuid,(facts->>'client_id')::uuid)
      and client_id=(facts->>'client_id')::uuid and import_scope::text='HR_WEEKLY'
      and source_system::text='HEALTHROSTER' and pruned_at is null
      and parser_version='WEEKLY_SOURCE_MODE_A_BRIDGE_V1'
      and parse_summary_json->>'weekly_source_upload_id'=facts->>'upload_id'
      and parse_summary_json->>'weekly_source_projection_publication_id'=facts->>'publication_id'
      and source_file_sha256=(select encode(u.content_sha256,'hex') from public.weekly_source_uploads u where u.id=(facts->>'upload_id')::uuid);
  select * into strict validation from public.timesheet_validations v where v.timesheet_id=t.timesheet_id;
  if validation.validation_source_kind is distinct from 'AGENCY_INVOICE_WEEK' or validation.last_source is not null
    or validation.pre_validated or validation.validation_source_publication_id::text is distinct from facts->>'publication_id'
    or encode(validation.validation_source_facts_sha256,'hex') is distinct from facts->>'facts_hash'
    or validation.status::text not in ('VALIDATION_OK','VALIDATION_ERROR')
    or validation.override_requested_at_utc is not null or validation.override_requested_by is not null
    or validation.override_confirmed_at_utc is not null or validation.override_confirmed_by is not null or validation.override_reason is not null then
    raise exception 'AGENCY_INVOICE_SUPPORT_TYPED_VALIDATION_REQUIRED' using errcode='55000';end if;
  select count(*) into source_count from jsonb_array_elements(facts->'finalised_source') source
    where exists(select 1 from jsonb_array_elements(record_json->'schedule') segment
      where segment->>'work_event_id'=source->>'work_event_id');
  with native_rows as materialized (
    select comparison.id comparison_id,comparison.comparison_state,ur.id upload_row_id,hr.id bridge_row_id,
      jsonb_build_object('date',ur.work_date,'source_system','HEALTHROSTER','hr_request_id',hr.hr_request_id,
        'nhsp_shift_id',null,'external_row_key',ur.external_source_key,'ward',ur.bounded_raw_columns_json->>'ward',
        'assignment_code',ur.bounded_raw_columns_json->>'assignment_code','ref_num',comparison.source_reference_number,
        'start',to_char(ur.start_at_local,'HH24:MI'),'end',to_char(ur.end_at_local,'HH24:MI'),
        'break_mins',ur.break_minutes,'paid_minutes',ur.actual_net_minutes) row_json
    from public.weekly_timesheet_source_comparisons comparison
    join public.weekly_source_upload_rows ur on ur.id=comparison.upload_row_id and ur.upload_id=(facts->>'upload_id')::uuid
      and ur.row_finalisation_state='SOURCE_WORKED'
    join public.weekly_source_row_resolutions resolution on resolution.upload_row_id=ur.id
      and resolution.work_event_id=comparison.work_event_id and resolution.mapping_state='RESOLVED'
      and resolution.generation=(select coalesce(p.projection_generation,p.authority_scope_version) from public.weekly_source_projection_publications p where p.id=(facts->>'publication_id')::uuid)
    join public.hr_rows hr on hr.import_id=hi.id and hr.payload_json->>'weekly_source_upload_row_id'=ur.id::text
    where comparison.projection_publication_id=(facts->>'publication_id')::uuid
      and comparison.source_cycle_id=(facts->>'source_cycle_id')::uuid and comparison.upload_id=ur.upload_id
      and comparison.timesheet_id=t.timesheet_id and comparison.timesheet_revision=t.version
      and comparison.contract_id=t.contract_id and comparison.work_date=ur.work_date
      and comparison.source_start_at_local is not distinct from ur.start_at_local
      and comparison.source_end_at_local is not distinct from ur.end_at_local
      and comparison.source_break_minutes is not distinct from ur.break_minutes
      and exists(select 1 from jsonb_array_elements(facts->'finalised_source') source
        where source->>'work_event_id'=comparison.work_event_id::text and source->>'upload_row_id'=ur.id::text)
      and exists(select 1 from jsonb_array_elements(record_json->'schedule') segment
        where segment->>'work_event_id'=comparison.work_event_id::text)
  ) select count(*)::integer,coalesce(jsonb_agg(row_json order by row_json->>'date',upload_row_id),'[]'::jsonb),
      coalesce(bool_or(comparison_state='HOURS_MISMATCH'),false),
      coalesce(bool_or(comparison_state not in ('EXACT_MATCH','REFERENCE_MISSING','HOURS_MISMATCH')),false)
    into comparison_count,rows_json,has_native_mismatch,has_native_ambiguity from native_rows;
  if source_count=0 or source_count<>comparison_count or comparison_count>100 or has_native_ambiguity then
    raise exception 'AGENCY_INVOICE_SUPPORT_NATIVE_COMPARISON_UNAVAILABLE' using errcode='55000';end if;
  return jsonb_build_object('contract','WEEKLY_SOURCE_AGENCY_CROSSCHECK_CONTEXT_V1','is_agency_invoice',true,
    'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'source_cycle_id',facts->'source_cycle_id',
    'projection_publication_id',facts->'publication_id','upload_id',facts->'upload_id','hr_import_id',hi.id,
    'facts_sha256',facts->'facts_hash','week_complete',facts->'complete','validation_source_kind',validation.validation_source_kind,
    'validation_status',validation.status,'validation_reason',validation.reason_code,
    'crosscheck_status',case when has_native_mismatch then 'HOURS_MISMATCH_HR' else 'OK' end,
    'crosscheck_issues',case when has_native_mismatch then jsonb_build_array('HOURS_MISMATCH_HR') else null::jsonb end,
    'rows',rows_json);
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_INVOICE_SUPPORT_NATIVE_PROVENANCE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_crosscheck_context_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_crosscheck_context_v1(uuid) from public,anon,authenticated,service_role;

create or replace function public.weekly_source_agency_crosscheck_context_v1(p_timesheet_id uuid)
returns jsonb language sql stable security definer
set search_path to 'pg_catalog','private','pg_temp'
as $function$ select private.weekly_source_agency_crosscheck_context_v1(p_timesheet_id); $function$;
alter function public.weekly_source_agency_crosscheck_context_v1(uuid) owner to postgres;
revoke all on function public.weekly_source_agency_crosscheck_context_v1(uuid) from public,anon,authenticated;
grant execute on function public.weekly_source_agency_crosscheck_context_v1(uuid) to service_role;


-- Exact selected runtime component 30: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/28_18_complete_native_agency_issue_requirements_with_actual_scoped_credit.sqlinc
-- Read-only facts for the ONE existing issue/send validator. There is no new
-- issue endpoint, amount calculation, invoice status writer or caller selector.
create or replace function private.weekly_source_agency_issue_requirements_v1(p_invoice_id uuid)
returns text[] language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare i public.invoices%rowtype; target uuid; support jsonb; codes text[]:=array[]::text[];
  native_message text; validation_required boolean:=false; evidence_missing boolean:=false; credit_unissued boolean:=false;
  r private.timesheet_correction_requests%rowtype; chain jsonb;
begin
  select * into i from public.invoices where id=p_invoice_id;
  -- Actual ordinary unissued INVOICE only. Historical delivery/paid invoices
  -- and Credit Notes retain their existing native issue/delivery protocol.
  if i.id is null or i.type::text<>'INVOICE' or i.status::text not in ('DRAFT','ON_HOLD') or i.issued_at_utc is not null then return codes;end if;
  for target in select distinct l.timesheet_id from public.invoice_lines l where l.invoice_id=i.id
    and l.timesheet_id is not null and private.weekly_source_agency_invoice_check_only_v1(l.timesheet_id) is true order by l.timesheet_id loop
    support:=null;
    begin
      support:=private.weekly_source_agency_crosscheck_context_v1(target);
    exception when sqlstate '55000' or sqlstate '40001' then
      get stacked diagnostics native_message=message_text;
      if native_message not like 'AGENCY_INVOICE_%' then raise;end if;
      -- Genuine unavailable current Source/typed provenance is a validation
      -- requirement, never a legacy override or readiness inference.
      validation_required:=true;
    end;
    if support is not null then
      if support->'is_agency_invoice' is distinct from 'true'::jsonb or support->'week_complete' is distinct from 'true'::jsonb
        or support->>'validation_source_kind' is distinct from 'AGENCY_INVOICE_WEEK'
        or support->>'validation_status' is distinct from 'VALIDATION_OK' then validation_required:=true;end if;
      if not exists(select 1 from public.invoice_hr_source_rows hs where hs.invoice_id=i.id and hs.source_system='HEALTHROSTER'
        and hs.import_id=(support->>'hr_import_id')::uuid and jsonb_typeof(hs.rows_json)='array' and jsonb_array_length(hs.rows_json)>0) then
        evidence_missing:=true;
      end if;
    else
      evidence_missing:=true;
    end if;
    for r in select request.* from private.timesheet_correction_requests request
      where request.replacement_timesheet_id=target and request.state='APPLIED'
        and request.original_invoice_id is not null order by request.id loop
      chain:=public.timesheet_correction_chain_scope_v1(target,false,32,100);
      if chain->'valid' is distinct from 'true'::jsonb or chain#>'{requested_correction_unit,valid}' is distinct from 'true'::jsonb
        or not(chain#>'{requested_correction_unit,member_ids}' ? r.reversal_timesheet_id::text)
        or not(chain#>'{requested_correction_unit,member_ids}' ? target::text) then
        raise exception 'AGENCY_INVOICE_NATIVE_PAIR_UNAVAILABLE' using errcode='55000';end if;
      -- Scoped CN keeps the real T0 line identity and records R0 in metadata.
      -- Existing native resume authority verifies EVERY clone/original/member
      -- and exact original amounts; no second sum or native identity rewrite.
      if not exists(select 1 from public.invoices cn
        where cn.type::text='CREDIT_NOTE' and cn.status::text in ('ISSUED','PAID') and cn.issued_at_utc is not null
          and cn.client_id=i.client_id and cn.original_invoice_id=r.original_invoice_id
          and cn.header_snapshot_json#>>'{credit_scope,reversal_timesheet_id}'=r.reversal_timesheet_id::text
          and cn.header_snapshot_json#>>'{credit_scope,reversed_timesheet_id}'=r.reversed_timesheet_id::text
          and exists(select 1 from public.invoice_lines line where line.invoice_id=cn.id
            and line.timesheet_id=r.reversed_timesheet_id and line.meta_json->>'reversal_timesheet_id'=r.reversal_timesheet_id::text)
          and exists(select 1 from public.timesheets reversal join public.timesheets_financials financial
            on financial.timesheet_id=reversal.timesheet_id and financial.is_current and not financial.is_stale
              and financial.timesheet_version=reversal.version and financial.authorised_at_utc=reversal.authorised_at_server
            where reversal.timesheet_id=r.reversal_timesheet_id and reversal.is_current and reversal.revoked_at is null
              and financial.locked_by_invoice_id=cn.id)
          and exists(select 1 from public.invoice_document_versions doc where doc.id=cn.issued_document_version_id
            and doc.entity_type='INVOICE' and doc.entity_id=cn.id and doc.purpose='FINAL_ISSUE'
            and doc.status='READY' and doc.verified_at_utc is not null and doc.sha256 is not null and doc.r2_key is not null)
          and exists(select 1 from private._invoice_credit_resume_v1(r.original_invoice_id,
            case when pg_input_is_valid(coalesce(cn.header_snapshot_json#>>'{credit_scope,creating_operation_id}',
              cn.header_snapshot_json->>'credit_operation_id',''),'uuid')
              then coalesce(cn.header_snapshot_json#>>'{credit_scope,creating_operation_id}',cn.header_snapshot_json->>'credit_operation_id')::uuid end,
            cn.id,r.reversal_timesheet_id) native_credit where native_credit.credit_note_id=cn.id)
      ) then credit_unissued:=true;end if;
    end loop;
  end loop;
  if validation_required then codes:=array_append(codes,'HEALTHROSTER_VALIDATION_REQUIRED');end if;
  if credit_unissued then codes:=array_append(codes,'AGENCY_INVOICE_CREDIT_NOTE_NOT_ISSUED');end if;
  if evidence_missing then codes:=array_append(codes,'HEALTHROSTER_EVIDENCE_MISSING');end if;
  return codes;
end;
$function$;
alter function private.weekly_source_agency_issue_requirements_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_issue_requirements_v1(uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 31: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/29_15_native_agency_issue_close.sqlinc
-- Primary26.4: the actual newly issued ordinary Invoice retires only unrelated
-- absent/unfinalised subjects in its exact native worker/client week. Native
-- contact retirement is reused; no send, resolved classification or cash write.
create or replace function private.weekly_source_agency_issue_close_v1(p_invoice_id uuid)
returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare i public.invoices%rowtype; actual_audit public.audit_events%rowtype; target record; main_id uuid; facts jsonb;
  incident record; wait_event record; wait_fact jsonb; protected boolean; actor public.tms_users%rowtype;
  source_decision jsonb;
begin
  select * into strict i from public.invoices where id=p_invoice_id;
  if i.type::text<>'INVOICE' or i.status::text<>'ISSUED' or i.issued_at_utc is null then return;end if;
  if not exists(select 1 from public.invoice_lines l where l.invoice_id=i.id and l.timesheet_id is not null
    and private.weekly_source_agency_invoice_check_only_v1(l.timesheet_id) is true) then return;end if;
  if current_setting('transaction_isolation') is distinct from 'read committed' then
    raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001';end if;
  -- Exact issue-owner audit, including frozen asynchronous issue time distinct
  -- from its audit observation timestamp. No current-XID or clock fiction.
  select a.* into strict actual_audit from public.audit_events a
    where a.object_type='invoice' and a.object_id_text=i.id::text and a.action='INVOICE_ISSUED'
      and (a.ts_utc=i.issued_at_utc or case when jsonb_typeof(a.after_json->'issue_at_utc')='string'
        and pg_input_is_valid(coalesce(a.after_json->>'issue_at_utc',''),'timestamptz')
        then (a.after_json->>'issue_at_utc')::timestamptz=i.issued_at_utc else false end)
    order by a.ts_utc desc,a.id desc limit 1;
  select * into strict actor from public.tms_users where id=actual_audit.actor_user_id and is_active;
  for target in select distinct t.contract_id,t.week_ending_date from public.invoice_lines l
    join public.timesheets t on t.timesheet_id=l.timesheet_id
    where l.invoice_id=i.id and private.weekly_source_agency_invoice_check_only_v1(t.timesheet_id) is true
    order by t.contract_id,t.week_ending_date loop
    select cw.timesheet_id into strict main_id from public.contract_weeks cw where cw.contract_id=target.contract_id
      and cw.week_ending_date=target.week_ending_date and coalesce(cw.additional_seq,0)=0 and not cw.is_adjustment;
    facts:=private.weekly_source_agency_week_facts_v1(main_id);
    perform private.weekly_source_office_authority_v1(actor.id,'VIEW_SOURCE_PROGRESS',(facts->>'source_group_id')::uuid,
      (facts->>'client_id')::uuid,target.week_ending_date);
    if facts->'complete' is distinct from 'true'::jsonb then
      raise exception 'HEALTHROSTER_VALIDATION_REQUIRED' using errcode='55000';end if;
    for incident in select d.*,x.issue_family,x.id comparison_id,x.contract_id comparison_contract_id
      from public.weekly_discrepancy_incidents d
      join public.weekly_issue_comparison_revisions x on x.id=d.current_comparison_revision_id and x.incident_id=d.id
      join public.weekly_work_events e on e.id=d.work_event_id and e.candidate_id=d.candidate_id and e.client_id=d.client_id
      where d.state='OPEN' and d.source_group_id=(facts->>'source_group_id')::uuid and d.source_cycle_id=(facts->>'source_cycle_id')::uuid
        and d.candidate_id=(facts->>'candidate_id')::uuid and d.client_id=(facts->>'client_id')::uuid
        and x.contract_id=target.contract_id and x.projection_publication_id=(facts->>'publication_id')::uuid
        and x.issue_family in ('HEALTHROSTER_NOT_FINALISED','SOURCE_MISSING_OR_NOT_AUTHORISED')
        and e.work_date between target.week_ending_date-6 and target.week_ending_date
        and not exists(select 1 from jsonb_array_elements(facts->'records') r
          cross join lateral jsonb_array_elements(r->'schedule') s where s->>'work_event_id'=d.work_event_id::text)
        and not exists(select 1 from private.weekly_source_manual_reviews mr where mr.work_event_id=d.work_event_id
          and mr.candidate_id=d.candidate_id and mr.client_id=d.client_id and mr.state='OPEN')
        and not exists(select 1 from private.timesheet_correction_requests pending where pending.state='WAITING'
          and pending.contract_id=target.contract_id and pending.candidate_id=d.candidate_id
          and pending.client_id=d.client_id and pending.week_ending_date=target.week_ending_date)
        and not exists(select 1 from private.weekly_source_agency_timesheet_change_requests pending where pending.state='ACTIVE'
          and pending.contract_id=target.contract_id and pending.candidate_id=d.candidate_id
          and pending.client_id=d.client_id and pending.week_ending_date=target.week_ending_date)
        and not exists(select 1 from private.weekly_source_check_only_shift_protections p where p.state='ACTIVE'
          and p.work_event_id=d.work_event_id and p.candidate_id=d.candidate_id)
      order by d.id for update of d loop
      protected:=false;
      -- Status WAIT alone is not a certificate. The same genuine native wait
      -- receipt owner is consulted for the latest actual family/event position.
      for wait_event in select family.root_timesheet_id,event.id event_id
        from public.weekly_exceptional_pay_target_families family join public.weekly_exceptional_pay_family_events event on event.family_id=family.id
        where family.contract_id=target.contract_id and family.candidate_id=incident.candidate_id
          and family.week_ending_date=target.week_ending_date and event.durable_work_event_id=incident.work_event_id and event.state='WAIT'
          and event.event_sequence=(select max(tail.event_sequence) from public.weekly_exceptional_pay_family_events tail
            where tail.family_id=family.id and tail.durable_work_event_id=event.durable_work_event_id) order by event.id loop
        wait_fact:=private.weekly_source_protected_wait_receipt_v1(wait_event.root_timesheet_id,wait_event.event_id);
        if jsonb_typeof(wait_fact) is distinct from 'object' then
          raise exception 'AGENCY_INVOICE_QUALIFIED_WAIT_EVIDENCE_UNAVAILABLE' using errcode='55000';end if;
        protected:=true;
      end loop;
      if protected then continue;end if;
      -- This incident is an actual Source Missing/unfinalised subject. Consume
      -- the narrow genuine Source Missing/credit owner, never a universal
      -- Agency pending classifier, status alias, unknown-as-false or money sum.
      source_decision:=private.weekly_source_kept_as_paid_context_for_publication_v1(incident.work_event_id,actor.id,(facts->>'publication_id')::uuid);
      if source_decision->>'work_event_id' is distinct from incident.work_event_id::text
        or source_decision->>'candidate_id' is distinct from incident.candidate_id::text
        or source_decision->>'client_id' is distinct from incident.client_id::text
        or source_decision->>'contract_id' is distinct from target.contract_id::text
        or source_decision->>'projection_publication_id' is distinct from facts->>'publication_id'
        or source_decision->'decision_needed' is distinct from 'false'::jsonb then
        continue;
      end if;
      update public.weekly_discrepancy_incidents set state='CANCELLED',resolved_at_utc=null,resolution_kind=null
        where id=incident.id and state='OPEN' and episode_number=incident.episode_number
          and current_comparison_revision_id=incident.comparison_id;
      if not found then raise exception 'AGENCY_INVOICE_ISSUE_INCIDENT_STALE' using errcode='40001';end if;
      perform private.weekly_source_incident_contact_retire_v1(incident.id);
      insert into public.audit_events(ts_utc,actor_user_id,actor_display,actor_role_at_time,object_type,object_id_text,action,
        before_json,after_json,reason) values(transaction_timestamp(),actor.id,actor.display_name,actor.role,
        'weekly_discrepancy_incident',incident.id::text,'AGENCY_INVOICE_ISSUE_CANCELLED_UNCARRIED_QUERY',
        jsonb_build_object('state','OPEN','episode_number',incident.episode_number,'comparison_id',incident.comparison_id),
        jsonb_build_object('state','CANCELLED','invoice_id',i.id,'invoice_no',i.invoice_no,'issued_at_utc',i.issued_at_utc,
          'native_issue_audit_id',actual_audit.id,'source_publication_id',facts->'publication_id','week_ending',target.week_ending_date,
          'resolved_at_utc',null,'resolution_kind',null),'Actual issued preset Invoice; uncarried absent/unfinalised native query retired');
    end loop;
  end loop;
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_INVOICE_ISSUE_CLOSE_NATIVE_PROVENANCE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_issue_close_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_issue_close_v1(uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 32: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/30_20_native_mode_a_unit_census.sqlinc
create or replace function private.weekly_source_agency_mode_a_units_v1(p_import_id uuid)
returns table(candidate_id uuid,client_id uuid,has_preset boolean,timesheet_ids uuid[],week_endings date[])
language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare hi public.hr_imports%rowtype; preview jsonb;
begin
 select * into strict hi from public.hr_imports where id=p_import_id and pruned_at is null;
 if hi.source_system::text<>'HEALTHROSTER' or upper(coalesce(hi.import_scope::text,''))<>'HR_WEEKLY' then return;end if;
 preview:=public.hr_weekly_validation_preview(hi.id);
 if preview->>'import_id' is distinct from hi.id::text
  or preview->>'client_id' is distinct from hi.client_id::text
  or jsonb_typeof(preview->'rows') is distinct from 'array'
  or jsonb_array_length(preview->'rows')>5000 then
  raise exception 'HR_VALIDATION_NATIVE_TARGETS_UNAVAILABLE' using errcode='55000';end if;
 if exists(select 1 from jsonb_array_elements(preview->'rows') r
  where jsonb_typeof(r) is distinct from 'object'
   or jsonb_typeof(r->'candidate_id') is distinct from 'string'
   or (r->>'candidate_id')!~'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
   or jsonb_typeof(r->'client_id') is distinct from 'string'
   or r->>'client_id' is distinct from hi.client_id::text
   or jsonb_typeof(r->'week_ending_date') is distinct from 'string'
   or not pg_input_is_valid(r->>'week_ending_date','date')
   or (r->>'week_ending_date')!~'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
   or (jsonb_typeof(r->'timesheet_id') is distinct from 'null' and
    (jsonb_typeof(r->'timesheet_id') is distinct from 'string' or
     (r->>'timesheet_id')!~'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'))) then
  raise exception 'HR_VALIDATION_NATIVE_TARGETS_UNAVAILABLE' using errcode='55000';end if;
 return query
 with native_rows as materialized (
  select (r->>'candidate_id')::uuid candidate,(r->>'client_id')::uuid client,
   (r->>'timesheet_id')::uuid ts,(r->>'week_ending_date')::date own_week
  from jsonb_array_elements(preview->'rows') r
 ), classified as (
  select n.*,coalesce(private.weekly_source_agency_invoice_check_only_v1(n.ts),false)
   or exists(select 1 from public.weekly_source_group_clients m
    join public.weekly_source_groups g on g.id=m.source_group_id
    where m.client_id=n.client and n.own_week between m.valid_from and coalesce(m.valid_to,'infinity'::date)
     and private.weekly_source_configured_agency_invoice_v1(n.client,g.id,g.agency_id,g.environment,n.own_week) is true) preset
  from native_rows n
 )
 select n.candidate,n.client,bool_or(n.preset),
  coalesce(array_agg(distinct n.ts order by n.ts) filter(where n.ts is not null),array[]::uuid[]),
  array_agg(distinct n.own_week order by n.own_week)
 from classified n group by n.candidate,n.client order by n.candidate,n.client;
end;
$function$;
alter function private.weekly_source_agency_mode_a_units_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_mode_a_units_v1(uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 33: 7afa77836974e011516d146be6778a5db32fc9e6:docs/healthroster-build/proposals/agency-current-shared-owner-union-forward-20261015/repeatable/02_same_request_identity_guard.sqlinc

create or replace function private.weekly_source_agency_change_identity_guard_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','private','pg_temp'
as $function$
declare v_mutable constant text[]:=array['state','phase','version','current_timesheet_id','current_timesheet_version',
  'current_row_signature','return_hold','outbox_id','outbox_reason','current_financial_id','native_receipts',
  'last_refusal_code','completed_receipt','updated_at_utc','completed_at_utc','updated_by_user_id','completed_by_user_id','current_source_dependency_tokens'];
begin
  if tg_op='DELETE' then raise exception 'AGENCY_CHANGE_HISTORY_DELETE_FORBIDDEN' using errcode='55000';end if;
  if to_jsonb(new)-v_mutable is distinct from to_jsonb(old)-v_mutable then
    raise exception 'AGENCY_CHANGE_IMMUTABLE_CAPTURE_CHANGED' using errcode='55000';
  end if;
  if new.native_receipts->'original_capture' is distinct from old.native_receipts->'original_capture' then
    raise exception 'AGENCY_CHANGE_ORIGINAL_NATIVE_CAPTURE_CHANGED' using errcode='55000';
  end if;
  if new.current_source_dependency_tokens is distinct from old.current_source_dependency_tokens then
    if old.state is distinct from 'ACTIVE' or not new.current_source_dependency_tokens @> old.current_source_dependency_tokens
      or new.native_receipts#>>'{source_admission,schema_version}' is distinct from 'WEEKLY_SOURCE_AGENCY_SOURCE_PHASE_ADMISSION_V1'
      or new.native_receipts#>>'{source_admission,request_id}' is distinct from old.id::text
      or new.native_receipts#>>'{source_admission,request_sha256}' is distinct from encode(old.request_sha256,'hex')
      or new.native_receipts#>>'{source_admission,actor_user_id}' is distinct from new.updated_by_user_id::text
      or new.native_receipts#>>'{source_admission,transaction_id}' is distinct from pg_current_xact_id()::text
      or new.native_receipts#>>'{source_admission,backend_pid}' is distinct from pg_backend_pid()::text
      or new.native_receipts#>'{source_admission,source_cas}' is distinct from old.source_cas
      or new.native_receipts#>>'{source_admission,source_dependency_tokens_sha256}' is distinct from encode(
        private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_SOURCE_DEPENDENCY_TOKENS_V1',new.current_source_dependency_tokens),'hex') then
      raise exception 'AGENCY_CHANGE_NATIVE_SOURCE_FOOTPRINT_RECEIPT_REQUIRED' using errcode='55000';end if;
  end if;
  if old.state='COMPLETED' and to_jsonb(new) is distinct from to_jsonb(old) then
    raise exception 'AGENCY_CHANGE_COMPLETED_RECEIPT_IMMUTABLE' using errcode='55000';
  end if;
  if to_jsonb(new) is distinct from to_jsonb(old) and new.version<>old.version+1 then
    raise exception 'AGENCY_CHANGE_PHASE_VERSION_INVALID' using errcode='40001';
  end if;
  return new;
end;
$function$;
alter function private.weekly_source_agency_change_identity_guard_v1() owner to postgres;
revoke all on function private.weekly_source_agency_change_identity_guard_v1() from public,anon,authenticated,service_role;
create trigger weekly_source_agency_change_identity_guard_v1
  before update or delete on private.weekly_source_agency_timesheet_change_requests
  for each row execute function private.weekly_source_agency_change_identity_guard_v1();


-- Exact selected runtime component 34: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/repeatable/03_actual_source_phase_admission.sqlinc
-- Purpose-bound admission for an existing ORDINARY physical T0. No Source
-- correction/claim, planned P0, generation or alternative arbiter is created.
create or replace function private.weekly_source_agency_source_phase_admit_v1(
 p_timesheet_id uuid,p_actor_user_id uuid,p_candidate_id uuid,p_source_cycle_id uuid,
 p_client_id uuid,p_expected_source_cas jsonb,p_native_admission jsonb
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $agency_source_phase$
declare t public.timesheets%rowtype;c public.contracts%rowtype;cycle public.weekly_source_cycles%rowtype;
 gate jsonb:=p_native_admission;locks jsonb;family jsonb;family_before jsonb;family_after jsonb;before_footprint jsonb;after_footprint jsonb;
 members uuid[];scope_hash bytea;token_digest bytea;old_timeout text:=current_setting('lock_timeout');
begin
 perform private.weekly_source_query_require_service_v1();
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001';end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict c from public.contracts where id=t.contract_id;
 select * into strict cycle from public.weekly_source_cycles where id=p_source_cycle_id;
 if p_candidate_id is null or p_client_id is null or c.candidate_id is distinct from p_candidate_id
  or c.client_id is distinct from p_client_id or t.is_current is distinct from true
  or t.archived_at_utc is not null or t.sheet_scope::text is distinct from 'WEEKLY'
  or t.line_type::text is distinct from 'HOURS' or t.correction_id is not null or coalesce(t.is_adjustment,false)
  or t.week_ending_date is distinct from cycle.finalisation_week_ending
  or(cycle.scope_client_id is not null and cycle.scope_client_id is distinct from p_client_id) then
  raise exception 'AGENCY_CHANGE_SOURCE_PHASE_SUBJECT_CHANGED' using errcode='40001';end if;
 perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',cycle.source_group_id,p_client_id,t.week_ending_date);
 -- The exact actual Candidate/I1 result is passed only by the two reviewed
 -- private capture/resume callers, from their literal native invocation BEFORE
 -- D1 invoice/family locks. It is neither a public input nor a callback/flag.
 -- Do not reacquire a potentially changed Candidate after holding that order.
 if jsonb_typeof(gate) is distinct from 'object' or gate->>'ok' is distinct from 'true'
  or gate->>'gate' is distinct from 'GRANTED' or gate->>'candidate_id' is distinct from p_candidate_id::text then
  raise exception 'AGENCY_CHANGE_CANDIDATE_NATIVE_SCOPE_INVALID' using errcode='55000';end if;
 begin
  perform set_config('lock_timeout','1ms',true);
  locks:=private.weekly_source_lock_family_rows_v1(array[t.timesheet_id],p_candidate_id);
  if locks->>'ok' is distinct from 'true' or jsonb_typeof(locks->'families') is distinct from 'array'
   or jsonb_array_length(locks->'families')<>1 then
   raise exception 'AGENCY_CHANGE_NATIVE_FAMILY_LOCK_REFUSED' using errcode='55000';end if;
  family:=locks->'families'->0;
  if family->>'requested_timesheet_id' is distinct from t.timesheet_id::text
   or family->>'canonical_timesheet_id' is distinct from t.timesheet_id::text
   or family->'requested_is_canonical' is distinct from 'true'::jsonb
   or family->>'canonical_version' is distinct from t.version::text
   or jsonb_typeof(family->'member_timesheet_ids') is distinct from 'array' then
   raise exception 'AGENCY_CHANGE_NATIVE_FAMILY_CHANGED' using errcode='40001';end if;
  select array_agg(value::uuid order by value::uuid) into members from jsonb_array_elements_text(family->'member_timesheet_ids');
  select coalesce(jsonb_agg(to_jsonb(s) order by s.family_timesheet_id),'[]'::jsonb) into family_before
   from public._pay_timesheet_rotation_scope(array[t.timesheet_id]) s;
  -- SAME arbiter PHYSICAL then existing workflow/week/cycle dependencies.
  perform private.timesheet_correction_a0_family_tokens_retain_v1(t.timesheet_id,members);
  before_footprint:=private.timesheet_correction_a0_source_footprint_v1(p_source_cycle_id,array[p_client_id]);
  if before_footprint->>'schema_version' is distinct from 'CORRECTION_A0_NATIVE_SOURCE_FOOTPRINT_V1'
   or jsonb_typeof(before_footprint->'tokens') is distinct from 'array'
   or(p_expected_source_cas is not null and before_footprint->'source_cas' is distinct from p_expected_source_cas) then
   raise exception 'AGENCY_CHANGE_ORIGINAL_SOURCE_CAS_CHANGED' using errcode='40001';end if;
  perform private.timesheet_correction_a0_fence_acquire_v1(before_footprint->'tokens',true);
  -- Separate actual pre-mutation native reads, after retention; no same-write
  -- AFTER/STABLE snapshot assumption and no currentness inferred from a token.
  after_footprint:=private.timesheet_correction_a0_source_footprint_v1(p_source_cycle_id,array[p_client_id]);
  if after_footprint is distinct from before_footprint then
   raise exception 'AGENCY_CHANGE_SOURCE_FOOTPRINT_CHANGED_UNDER_LOCK' using errcode='40001';end if;
  select coalesce(jsonb_agg(to_jsonb(s) order by s.family_timesheet_id),'[]'::jsonb) into family_after
   from public._pay_timesheet_rotation_scope(array[t.timesheet_id]) s;
  if family_after is distinct from family_before or jsonb_array_length(family_after) is distinct from cardinality(members)
   or exists(select 1 from jsonb_array_elements(family_after) s where s->>'requested_timesheet_id' is distinct from t.timesheet_id::text
    or s->>'canonical_timesheet_id' is distinct from t.timesheet_id::text
    or s->>'booking_id' is distinct from family->>'family_booking_id'
    or not (s->>'family_timesheet_id')::uuid=any(members)) then
   raise exception 'AGENCY_CHANGE_NATIVE_FAMILY_CHANGED' using errcode='40001';end if;
  select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
  select * into strict c from public.contracts where id=t.contract_id;
  if c.candidate_id is distinct from p_candidate_id or c.client_id is distinct from p_client_id
   or t.version::text is distinct from family->>'canonical_version' or t.is_current is distinct from true then
   raise exception 'AGENCY_CHANGE_SOURCE_PHASE_SUBJECT_CHANGED' using errcode='40001';end if;
  perform set_config('lock_timeout',old_timeout,true);
 exception when others then perform set_config('lock_timeout',old_timeout,true);raise;end;
 token_digest:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_SOURCE_DEPENDENCY_TOKENS_V1',after_footprint->'tokens');
 scope_hash:=private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_SOURCE_PHASE_ADMISSION_V1',jsonb_build_object(
  'actor_user_id',p_actor_user_id,'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'candidate_id',p_candidate_id,
  'client_id',p_client_id,'source_cycle_id',p_source_cycle_id,'source_cas',after_footprint->'source_cas',
  'native_gate',gate,'native_family',locks,'native_rotation_scope',family_after,'native_source_footprint',after_footprint,
  'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid()));
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SOURCE_PHASE_ADMISSION_V1','actor_user_id',p_actor_user_id,
  'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'candidate_id',p_candidate_id,'client_id',p_client_id,
  'source_cycle_id',p_source_cycle_id,'source_cas',after_footprint->'source_cas','source_dependency_tokens',after_footprint->'tokens',
  'source_dependency_tokens_sha256',encode(token_digest,'hex'),'admission_sha256',encode(scope_hash,'hex'),
  'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid());
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'AGENCY_CHANGE_SOURCE_PHASE_UNAVAILABLE' using errcode='55000';
end;
$agency_source_phase$;
alter function private.weekly_source_agency_source_phase_admit_v1(uuid,uuid,uuid,uuid,uuid,jsonb,jsonb) owner to postgres;
revoke all on function private.weekly_source_agency_source_phase_admit_v1(uuid,uuid,uuid,uuid,uuid,jsonb,jsonb) from public,anon,authenticated,service_role;


-- Exact selected runtime component 35: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/repeatable/04_active_source_mutation_guard.sqlinc
-- BEFORE-only native Source mutation basis. No AFTER/STABLE visibility claim.
-- Most selected Source arrays hash their entire native row. Three identity /
-- dependency projections below follow the actual bulk_source_facts body.
create or replace function private.weekly_source_agency_source_mutation_basis_v1(p_relation text,p_row jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $agency_source_basis$
declare keys text[];result jsonb;comparison public.weekly_issue_comparison_revisions%rowtype;
begin
 if p_row is null then return null;end if;
 if jsonb_typeof(p_row) is distinct from 'object' then
  raise exception 'AGENCY_ACTIVE_SOURCE_MUTATION_CONTEXT_INVALID' using errcode='55000';end if;
 case p_relation
 when 'public.timesheets' then keys:=array['timesheet_id','contract_id','booking_id'];
 when 'public.timesheets_financials' then keys:=array['id','timesheet_id','client_id','candidate_id'];
 when 'public.weekly_source_billing_movements' then
  keys:=array['id','final_revision_id','invoice_timesheet_id','actual_client_id','candidate_id','contract_id',
   'movement_economic_hash','source_profile_kind','source_line_kind'];
 when 'public.weekly_issue_comparison_revisions' then keys:=array['id','incident_id','contract_id'];
 when 'public.weekly_discrepancy_incidents' then
  keys:=array['id','source_cycle_id','client_id','work_event_id'];
 else return p_row;
 end case;
 select coalesce(jsonb_object_agg(key,value),'{}'::jsonb) into result from jsonb_each(p_row) where key=any(keys);
 if p_relation='public.weekly_discrepancy_incidents' then
  -- A native comparison pointer is a dependency only through the actual
  -- referenced Contract in bulk facts. New comparison wording/hours or an
  -- OPEN/CLOSED/audit update does not silently become another Source CAS.
  -- This new volatile BEFORE reader deliberately obtains a fresh explicit
  -- native reference; it does not relabel the existing STABLE CAS owners.
  if p_row->>'current_comparison_revision_id' is not null then
   select * into strict comparison from public.weekly_issue_comparison_revisions
    where id=(p_row->>'current_comparison_revision_id')::uuid and incident_id=(p_row->>'id')::uuid;
   result:=result||jsonb_build_object('source_contract_dependency',comparison.contract_id);
  else result:=result||jsonb_build_object('source_contract_dependency',null);end if;
 end if;
 return result;
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'AGENCY_ACTIVE_SOURCE_MUTATION_CONTEXT_INVALID' using errcode='55000';
end;
$agency_source_basis$;
alter function private.weekly_source_agency_source_mutation_basis_v1(text,jsonb) owner to postgres;
revoke all on function private.weekly_source_agency_source_mutation_basis_v1(text,jsonb) from public,anon,authenticated,service_role;

-- Called only inside the SAME raw BEFORE owner, after real OLD+NEW tokens
-- have gone through ordinary same-arbiter acquisition. No purpose flag / GUC
-- / mutable actor session can exempt a Source authority change.
create or replace function private.weekly_source_agency_active_source_mutation_assert_v1(
 p_relation text,p_old jsonb,p_new jsonb,p_raw_tokens jsonb
) returns void language plpgsql volatile security definer set search_path to 'pg_catalog','public','private','pg_temp'
as $agency_source_guard$
declare raw_tokens jsonb:='[]'::jsonb;nested_tokens jsonb:='[]'::jsonb;token jsonb;captured jsonb;
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
begin
 if p_old is null and p_new is null then
  raise exception 'AGENCY_ACTIVE_SOURCE_MUTATION_CONTEXT_INVALID' using errcode='55000';end if;
 if p_old is not null then raw_tokens:=raw_tokens||private.timesheet_correction_a0_source_raw_tokens_v1(p_relation,p_old);end if;
 if p_new is not null then raw_tokens:=raw_tokens||private.timesheet_correction_a0_source_raw_tokens_v1(p_relation,p_new);end if;
 if p_old is not null then nested_tokens:=nested_tokens||private.timesheet_correction_a0_source_revision_tokens_v1(p_relation,p_old)
  ||private.timesheet_correction_a0_source_policy_tokens_v1(p_relation,p_old);end if;
 if p_new is not null then nested_tokens:=nested_tokens||private.timesheet_correction_a0_source_revision_tokens_v1(p_relation,p_new)
  ||private.timesheet_correction_a0_source_policy_tokens_v1(p_relation,p_new);end if;
 raw_tokens:=raw_tokens||nested_tokens;
 -- Native trigger's exact RAW plus NESTED union, with duplicates preserved, must
 -- match. This is not a caller-normalised or sampled dependency list.
 if raw_tokens is distinct from p_raw_tokens then
  raise exception 'AGENCY_CHANGE_SOURCE_FOOTPRINT_CHANGED_UNDER_LOCK' using errcode='40001';end if;
 if private.weekly_source_agency_source_mutation_basis_v1(p_relation,p_old)
  is not distinct from private.weekly_source_agency_source_mutation_basis_v1(p_relation,p_new) then return;end if;
 for r in select request.* from private.weekly_source_agency_timesheet_change_requests request
  where request.state='ACTIVE' and exists(
   select 1 from jsonb_array_elements(raw_tokens) raw
   where request.current_source_dependency_tokens @> jsonb_build_array(raw)
    or(raw->>'kind' in('SOURCE_CONTRACT_COVERAGE','SOURCE_POLICY_MEMBERSHIP_COVERAGE') and exists(
     select 1 from jsonb_array_elements(request.current_source_dependency_tokens) held
      where held->>'kind'=raw->>'kind' and held->>'uuid'=raw->>'uuid'
       and daterange((held->'coverage'->>0)::date,(held->'coverage'->>1)::date,'[]')
         && daterange((raw->'coverage'->>0)::date,(raw->'coverage'->>1)::date,'[]'))))
  order by request.id
 loop
  -- The existing immutable creator/click digest and captured Source scope
  -- remain the authority; a corrupted request cannot unlock foreign Source.
  captured:=r.native_receipts->'original_capture';
  if captured->>'source_dependency_tokens_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_AGENCY_SOURCE_DEPENDENCY_TOKENS_V1',r.source_dependency_tokens),'hex')
   or r.request_sha256 is distinct from private.weekly_source_agency_change_request_sha256_v1(
    r.contract_week_id,r.reason,r.initial_row_signature,r.request_key,r.actor_user_id,captured)
   or not r.current_source_dependency_tokens @> r.source_dependency_tokens then
   raise exception 'AGENCY_ACTIVE_SOURCE_CAPTURE_INVALID' using errcode='55000';end if;
  raise exception 'AGENCY_ACTIVE_SOURCE_MUTATION_REFUSED' using errcode='40001',detail=jsonb_build_object(
   'schema_version','WEEKLY_SOURCE_AGENCY_ACTIVE_SOURCE_REFUSAL_V1','request_id',r.id,'request_key',r.request_key,
   'phase',r.phase,'current_timesheet_id',r.current_timesheet_id,'original_draft_invoice_id',r.original_draft_invoice_id,
   'source_cycle_id',r.source_cycle_id,'recovery','RESUME_SAME_REQUEST_WITH_CURRENT_SCOPED_ACTOR')::text;
 end loop;
end;
$agency_source_guard$;
alter function private.weekly_source_agency_active_source_mutation_assert_v1(text,jsonb,jsonb,jsonb) owner to postgres;
revoke all on function private.weekly_source_agency_active_source_mutation_assert_v1(text,jsonb,jsonb,jsonb) from public,anon,authenticated,service_role;


-- Exact selected runtime component 36: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/repeatable/05_actual_native_capture_and_digest.sqlinc
-- Owner-private native capture for the single planned preset-T0 request.
-- Resolves stored native identities; no browser T0/D1/schedule/phase choices.
create or replace function private.weekly_source_agency_change_capture_v1(
  p_contract_week_id uuid,p_actor_user_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  v_week public.contract_weeks%rowtype; v_ts public.timesheets%rowtype;
  v_contract public.contracts%rowtype; v_group public.weekly_source_groups%rowtype;
  v_cycle public.weekly_source_cycles%rowtype; v_upload public.weekly_source_uploads%rowtype;
  v_publication public.weekly_source_projection_publications%rowtype;
  v_profile public.weekly_source_format_profiles%rowtype; v_invoice public.invoices%rowtype;
  v_fin public.timesheets_financials%rowtype;
  v_rules jsonb; v_scope jsonb; v_locks jsonb; v_signature jsonb; v_cas jsonb;
  native_admission jsonb; source_admission jsonb;
  v_count integer; v_ids uuid[]; v_invoice_ids uuid[]; v_locked_invoice_ids uuid[]; v_schedule jsonb;
  v_requested_timesheet_id uuid; v_claim jsonb; v_original_submission jsonb; v_legacy_document jsonb; v_before_pay jsonb; v_before_pay_witness jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if current_setting('transaction_isolation') is distinct from 'read committed' then
    raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001'; end if;
  if p_contract_week_id is null or p_actor_user_id is null then
    raise exception 'AGENCY_CHANGE_REQUEST_INVALID' using errcode='22023'; end if;
  if private.weekly_source_pay_actor_allowed_v1(p_actor_user_id) is distinct from true then
    raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
  select * into strict v_week from public.contract_weeks where id=p_contract_week_id;
  select * into strict v_contract from public.contracts where id=v_week.contract_id;
  if coalesce(v_week.additional_seq,0)<>0 or coalesce(v_week.is_adjustment,false)
    or v_week.timesheet_id is null or v_contract.candidate_id is null or v_contract.client_id is null then
    raise exception 'AGENCY_INVOICE_SECOND_FAMILY_REFUSED' using errcode='55000'; end if;
  -- The native invoice editor owns invoice -> Timesheet/financial lock order.
  -- Probe actual T0 placement, lock the same D1 first, then acquire the
  -- unchanged native family lock and rederive both identities.
  v_requested_timesheet_id:=v_week.timesheet_id;
  select * into strict v_ts from public.timesheets where timesheet_id=v_requested_timesheet_id;
  native_admission:=private.weekly_source_agency_candidate_admit_v1(v_requested_timesheet_id,p_actor_user_id);
  v_scope:=public.weekly_source_office_authorise_scope_v1(jsonb_build_object(
    'actor_user_id',p_actor_user_id,'timesheet_id',v_requested_timesheet_id));
  if v_scope->>'contract' is distinct from 'WEEKLY_SOURCE_AUTHORISE_SCOPE_V1'
    or v_scope->>'applicable' is distinct from 'true'
    or private.weekly_source_agency_invoice_check_only_v1(v_requested_timesheet_id) is distinct from true then
    raise exception 'AGENCY_CHANGE_SOURCE_SCOPE_REFUSED' using errcode='42501'; end if;
  select coalesce(array_agg(distinct l.invoice_id order by l.invoice_id),'{}'::uuid[]) into v_locked_invoice_ids
    from public.invoice_lines l where l.timesheet_id=v_requested_timesheet_id;
  if cardinality(v_locked_invoice_ids)>1 then
    raise exception 'AGENCY_CHANGE_INVOICE_PLACEMENT_SPLIT' using errcode='55000'; end if;
  if cardinality(v_locked_invoice_ids)=1 then
    select * into strict v_invoice from public.invoices where id=v_locked_invoice_ids[1] for update;
    if v_invoice.type is distinct from 'INVOICE' or v_invoice.status not in('DRAFT','ON_HOLD')
      or v_invoice.issued_at_utc is not null or v_invoice.paid_at_utc is not null
      or v_invoice.client_id is distinct from v_contract.client_id then
      raise exception 'AGENCY_CHANGE_ORIGIN_INVOICE_NOT_DRAFT' using errcode='55000'; end if;
  end if;
  -- Call-only shared native family owner: canonical/raw booking locks, complete
  -- family row locks, Candidate binding and canonical collision refusal.
  v_locks:=private.weekly_source_lock_family_rows_v1(array[v_week.timesheet_id],v_contract.candidate_id);
  if v_locks->>'ok' is distinct from 'true' then
    raise exception 'AGENCY_CHANGE_NATIVE_FAMILY_LOCK_REFUSED' using errcode='55000',detail=v_locks::text; end if;
  select * into strict v_week from public.contract_weeks where id=p_contract_week_id for update;
  select * into strict v_ts from public.timesheets where timesheet_id=v_week.timesheet_id for update;
  if v_week.timesheet_id is distinct from v_requested_timesheet_id
    or v_ts.is_current is distinct from true or v_ts.revoked_at is not null or v_ts.archived_at_utc is not null
    or v_ts.status::text='REVOKED' or v_ts.contract_id is distinct from v_contract.id
    or v_ts.week_ending_date is distinct from v_week.week_ending_date
    or v_ts.sheet_scope::text is distinct from 'WEEKLY' or v_ts.line_type::text is distinct from 'HOURS'
    or v_ts.correction_id is not null or coalesce(v_ts.is_adjustment,false)
    or (select count(*) from public.timesheets t where btrim(t.booking_id)=btrim(v_ts.booking_id) and t.is_current)<>1
    or exists(select 1 from public.contract_weeks sibling where sibling.contract_id=v_week.contract_id
      and sibling.week_ending_date=v_week.week_ending_date and coalesce(sibling.additional_seq,0)=0
      and sibling.id<>v_week.id and sibling.timesheet_id is not null) then
    raise exception 'AGENCY_INVOICE_TIMESHEET_ROTATED' using errcode='40001'; end if;
  v_scope:=public.weekly_source_office_authorise_scope_v1(jsonb_build_object(
    'actor_user_id',p_actor_user_id,'timesheet_id',v_ts.timesheet_id));
  if v_scope->>'contract' is distinct from 'WEEKLY_SOURCE_AUTHORISE_SCOPE_V1'
    or v_scope->>'applicable' is distinct from 'true' then
    raise exception 'AGENCY_CHANGE_SOURCE_SCOPE_REFUSED' using errcode='42501'; end if;
  if private.weekly_source_agency_invoice_check_only_v1(v_ts.timesheet_id) is distinct from true then
    raise exception 'AGENCY_CHANGE_PRESET_SCOPE_REFUSED' using errcode='55000'; end if;
  select array_agg(c.id order by c.id) into v_ids from public.weekly_source_cycles c
    join public.weekly_source_groups g on g.id=c.source_group_id and g.active and g.source_family='ROSTER'
    join public.weekly_source_group_clients member on member.source_group_id=g.id and member.client_id=v_contract.client_id
      and v_week.week_ending_date between member.valid_from and coalesce(member.valid_to,'infinity'::date)
    where c.finalisation_week_ending=v_week.week_ending_date
      and (c.scope_client_id is null or c.scope_client_id=v_contract.client_id);
  -- A real Client cycle takes precedence over its group parent only when there
  -- is exactly one such Client cycle. A different Client is never a fallback.
  if cardinality(v_ids)>1 then
    select array_agg(c.id order by c.id) into v_ids from public.weekly_source_cycles c
      where c.id=any(v_ids) and c.scope_client_id=v_contract.client_id; end if;
  if coalesce(cardinality(v_ids),0)<>1 then
    raise exception 'AGENCY_CHANGE_SOURCE_CYCLE_AMBIGUOUS' using errcode='55000'; end if;
  select * into strict v_cycle from public.weekly_source_cycles where id=v_ids[1] for update;
  select * into strict v_group from public.weekly_source_groups where id=v_cycle.source_group_id for update;
  if v_group.environment is distinct from 'TEST' then
    raise exception 'AGENCY_CHANGE_TEST_SCOPE_REQUIRED' using errcode='42501'; end if;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
    v_group.id,v_contract.client_id,v_week.week_ending_date);
  -- Exact current owner admits either the genuinely enabled assignment or its
  -- already-native current-XID OFF qualification authority. No local override.
  v_rules:=private.weekly_source_effective_rule_set_v1(v_contract.client_id,v_cycle.id);
  if v_rules->>'contract' is distinct from 'WEEKLY_SOURCE_EFFECTIVE_RULE_SET_V1'
    or v_rules->>'source_group_id' is distinct from v_group.id::text
    or v_rules#>>'{values,invoice_sender}' is distinct from 'AGENCY_INVOICE' then
    raise exception 'AGENCY_CHANGE_OPERATIONAL_RULE_UNAVAILABLE' using errcode='55000'; end if;
  source_admission:=private.weekly_source_agency_source_phase_admit_v1(v_ts.timesheet_id,p_actor_user_id,
    v_contract.candidate_id,v_cycle.id,v_contract.client_id,null::jsonb,native_admission);
  select * into strict v_publication from public.weekly_source_projection_publications
    where id=v_cycle.current_projection_publication_id and source_cycle_id=v_cycle.id
      and state='CURRENT' and authority_scope_kind='CYCLE' and correction_session_id is null and report_scope_id is null for update;
  select * into strict v_upload from public.weekly_source_uploads
    where id=v_cycle.current_complete_upload_id and id=v_publication.upload_id and source_cycle_id=v_cycle.id
      and state='CURRENT' and report_scope_id is null for update;
  perform private.weekly_source_query_current_publication_v1(v_cycle.id,v_publication.id);
  if v_upload.confirmed_coverage_start_local_date is null or v_upload.confirmed_coverage_end_local_date is null
    or v_upload.confirmed_coverage_start_local_date>v_week.week_ending_date-6
    or v_upload.confirmed_coverage_end_local_date<v_week.week_ending_date then
    raise exception 'AGENCY_CHANGE_ACCEPTED_COVERAGE_UNAVAILABLE' using errcode='55000'; end if;
  select * into strict v_profile from public.weekly_source_format_profiles
    where id=v_upload.source_format_profile_id and active;
  if v_profile.profile_code is distinct from v_rules#>>'{values,checking_profile_kind}'
    or ((v_profile.profile_code in('HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1','HEALTHROSTER_WEEKLY_EXPLICIT_ACTUAL_V1')
        and v_profile.final_authority_kind='HEALTHROSTER_ACTUAL_ROWS' and v_profile.row_finalisation_capability='FINALISED_ROW_ONLY')
      or(v_profile.profile_code='ROSTER_WEEKLY_SUMMARY_ACTUAL_V1'
        and v_profile.final_authority_kind='GENERIC_COMPLETE_SNAPSHOT' and v_profile.row_finalisation_capability='COMPLETE_FILE_ROWS')) is distinct from true then
    raise exception 'AGENCY_CHANGE_FINALISED_PROFILE_UNAVAILABLE' using errcode='55000'; end if;
  if exists(select 1 from public.weekly_source_row_resolutions r
    join public.weekly_source_upload_rows row_data on row_data.id=r.upload_row_id
    where row_data.upload_id=v_upload.id and r.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version)
      and r.contract_id=v_contract.id and r.candidate_id=v_contract.candidate_id and r.client_id=v_contract.client_id
      and row_data.work_date between v_week.week_ending_date-6 and v_week.week_ending_date
      and r.mapping_state='RESOLVED' and row_data.row_finalisation_state='SOURCE_WORKED'
      and (row_data.start_at_local is null or row_data.end_at_local is null or row_data.break_minutes is null
        or row_data.actual_net_minutes is null or row_data.actual_net_minutes<=0 or r.paid_minutes is distinct from row_data.actual_net_minutes
        or row_data.start_at_local::date<>row_data.work_date
        or row_data.end_at_local<=row_data.start_at_local
        or date_trunc('minute',row_data.start_at_local) is distinct from row_data.start_at_local
        or date_trunc('minute',row_data.end_at_local) is distinct from row_data.end_at_local
        or row_data.end_at_local::date is distinct from case when row_data.end_at_local::time<=row_data.start_at_local::time
          then row_data.work_date+1 else row_data.work_date end
        or extract(epoch from(row_data.end_at_local-row_data.start_at_local))/60-row_data.break_minutes<>row_data.actual_net_minutes
        or(v_profile.row_finalisation_capability='FINALISED_ROW_ONLY'
          and (nullif(btrim(row_data.finalised_by),'') is null
            or row_data.finalised_by is distinct from row_data.bounded_raw_columns_json->>'finalised_by')))) then
    raise exception 'AGENCY_CHANGE_FINALISED_ROW_PROVENANCE_INVALID' using errcode='55000'; end if;
  if exists(select 1 from public.weekly_source_row_resolutions r
    join public.weekly_source_upload_rows row_data on row_data.id=r.upload_row_id
    left join public.weekly_work_events event on event.id=r.work_event_id
    where row_data.upload_id=v_upload.id and r.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version)
      and r.contract_id=v_contract.id and r.candidate_id=v_contract.candidate_id and r.client_id=v_contract.client_id
      and row_data.work_date between v_week.week_ending_date-6 and v_week.week_ending_date
      and r.mapping_state='RESOLVED' and row_data.row_finalisation_state='SOURCE_WORKED'
      and (event.id is null or event.candidate_id is distinct from v_contract.candidate_id
        or event.client_id is distinct from v_contract.client_id or event.work_date is distinct from row_data.work_date
        or event.first_source_group_id is distinct from v_group.id)) then
    raise exception 'AGENCY_CHANGE_FINALISED_EVENT_PROVENANCE_INVALID' using errcode='55000'; end if;
  if exists(select 1 from public.weekly_source_row_resolutions r
    join public.weekly_source_upload_rows row_data on row_data.id=r.upload_row_id
    where row_data.upload_id=v_upload.id and r.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version)
      and r.contract_id=v_contract.id and row_data.work_date between v_week.week_ending_date-6 and v_week.week_ending_date
      and r.mapping_state='RESOLVED' and row_data.row_finalisation_state='SOURCE_WORKED'
    group by r.work_event_id having count(*)<>1) then
    raise exception 'AGENCY_CHANGE_FINALISED_EVENT_AMBIGUOUS' using errcode='55000'; end if;
  -- The schedule carries the native work_event_id. It contains no imported
  -- money, rates, planned hours or protected worker hours.
  select coalesce(jsonb_agg(jsonb_build_object('date',row_data.work_date::text,
      'start',to_char(row_data.start_at_local,'HH24:MI'),'end',to_char(row_data.end_at_local,'HH24:MI'),
      'end_date',row_data.end_at_local::date::text,'break_minutes',row_data.break_minutes,
      'source_shift_id',event.id::text,'work_event_id',event.id::text)
    order by row_data.work_date,row_data.start_at_local,event.id),'[]'::jsonb) into v_schedule
    from public.weekly_source_row_resolutions r
    join public.weekly_source_upload_rows row_data on row_data.id=r.upload_row_id
    join public.weekly_work_events event on event.id=r.work_event_id and event.candidate_id=v_contract.candidate_id
      and event.client_id=v_contract.client_id and event.work_date=row_data.work_date and event.first_source_group_id=v_group.id
    where row_data.upload_id=v_upload.id and r.generation=coalesce(v_publication.projection_generation,v_publication.authority_scope_version)
      and r.contract_id=v_contract.id and r.candidate_id=v_contract.candidate_id and r.client_id=v_contract.client_id
      and row_data.work_date between v_week.week_ending_date-6 and v_week.week_ending_date
      and r.mapping_state='RESOLVED' and row_data.row_finalisation_state='SOURCE_WORKED';
  if jsonb_array_length(v_schedule)>100 or octet_length(v_schedule::text)>65536 then
    raise exception 'AGENCY_CHANGE_SCHEDULE_BOUND_EXCEEDED' using errcode='54000'; end if;
  select coalesce(array_agg(distinct l.invoice_id order by l.invoice_id),'{}'::uuid[]) into v_invoice_ids
    from public.invoice_lines l where l.timesheet_id=v_ts.timesheet_id;
  if v_invoice_ids is distinct from v_locked_invoice_ids then
    raise exception 'AGENCY_CHANGE_INVOICE_PLACEMENT_CHANGED_UNDER_LOCK' using errcode='40001'; end if;
  if coalesce(cardinality(v_invoice_ids),0)>1 then
    raise exception 'AGENCY_CHANGE_INVOICE_PLACEMENT_SPLIT' using errcode='55000'; end if;
  if cardinality(v_invoice_ids)=1 then
    select * into strict v_invoice from public.invoices where id=v_invoice_ids[1] for update;
    if v_invoice.type is distinct from 'INVOICE' or v_invoice.status not in('DRAFT','ON_HOLD')
      or v_invoice.issued_at_utc is not null or v_invoice.paid_at_utc is not null
      or v_invoice.client_id is distinct from v_contract.client_id then
      raise exception 'AGENCY_CHANGE_ORIGIN_INVOICE_NOT_DRAFT' using errcode='55000'; end if;
  end if;
  select count(*) into v_count from public.timesheets_financials where timesheet_id=v_ts.timesheet_id and is_current;
  if v_count<>1 then raise exception 'AGENCY_INVOICE_TSFIN_NOT_READY' using errcode='55000'; end if;
  select * into strict v_fin from public.timesheets_financials where timesheet_id=v_ts.timesheet_id and is_current for update;
  v_signature:=public.timesheet_lifecycle_guard_signature_v1(v_ts.timesheet_id,v_week.id,false);
  if nullif(btrim(coalesce(v_signature->>'backend_row_signature',v_signature->>'row_signature',v_signature->>'signature')),'') is null then
    raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000'; end if;
  v_cas:=private.weekly_source_bulk_source_cas_v1(v_cycle.id,array[v_contract.client_id]);
  if v_cas is distinct from source_admission->'source_cas' then
    raise exception 'AGENCY_CHANGE_SOURCE_FOOTPRINT_CHANGED_UNDER_LOCK' using errcode='40001';end if;
  v_before_pay:=private.weekly_source_agency_before_collection_inputs_v1(v_ts.timesheet_id,p_actor_user_id);
  if v_before_pay#>>'{scope,timesheet_id}' is distinct from v_ts.timesheet_id::text
    or v_before_pay#>>'{scope,timesheet_version}' is distinct from v_ts.version::text
    or v_before_pay#>>'{scope,current_financial_id}' is distinct from v_fin.id::text
    or v_before_pay#>>'{scope,actual_actor_user_id}' is distinct from p_actor_user_id::text
    or v_before_pay#>>'{scope,source_group_id}' is distinct from v_group.id::text
    or v_before_pay#>>'{scope,source_cycle_id}' is distinct from v_cycle.id::text then
    raise exception 'AGENCY_CHANGE_NATIVE_BEFORE_PAY_INPUTS_CHANGED' using errcode='40001'; end if;
  -- Retain actual scope, hashes and timing only, never a second cash ledger.
  v_before_pay_witness:=private.weekly_source_agency_original_pay_identity_v1(
    v_ts.timesheet_id,p_actor_user_id,v_fin.id,null::uuid);
  v_before_pay_witness:=(v_before_pay_witness-'native_original_reservations')||jsonb_build_object(
    'native_reservations_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'AGENCY_CURRENT_NATIVE_ORIGINAL_RESERVATIONS_V1',v_before_pay_witness->'native_original_reservations'),'hex'));
  v_before_pay_witness:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_BEFORE_PAY_INPUT_WITNESS_V1',
    'original_identity',v_before_pay_witness,
    'scope',v_before_pay->'scope','native_input_reason',v_before_pay->'reason',
    'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid(),
    'native_inputs_sha256',encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_AGENCY_BEFORE_PAY_INPUTS_V1',v_before_pay),'hex'));
  if octet_length(v_before_pay_witness::text)>32768 then
    raise exception 'AGENCY_CHANGE_NATIVE_BEFORE_PAY_INPUT_BOUND_EXCEEDED' using errcode='54000'; end if;
  v_original_submission:=private.weekly_source_actual_timesheet_submission_v1(v_ts.timesheet_id);
  v_claim:=private.weekly_source_agency_submitted_claim_v1(v_ts.timesheet_id);
  -- Retain original native metadata/hash, not another hours/document store.
  if v_claim->>'available'='true' then
    v_claim:=(v_claim-'claim')||jsonb_build_object('claim_witness',v_claim->'claim'-'actual_schedule_json',
      'submission_state','IMMUTABLE_CANDIDATE_CLAIM');
  elsif v_original_submission->>'support_state'='NOT_SUBMITTED'
    and v_original_submission->>'actual_submitted'='false' then
    v_claim:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
      'available',true,'submission_state','NO_ORIGINAL_SUBMISSION','claim_witness',null,
      'claim_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_NO_ORIGINAL_SUBMISSION_V1',
        jsonb_build_object('timesheet_id',v_ts.timesheet_id,'timesheet_version',v_ts.version,
          'native_submission',v_original_submission))),'hex'),
      'native_submission',v_original_submission);
  end if;
  v_legacy_document:=private.weekly_source_agency_legacy_original_document_v1(v_ts.timesheet_id,null,p_actor_user_id);
  if v_legacy_document->>'available'='true' then
    v_legacy_document:=(v_legacy_document-'document_view')||jsonb_build_object(
      'document_witness',v_legacy_document->'document_view'-'original_shift_lines','document_state','FROZEN_DOCUMENT_VIEW');
  end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_CHANGE_NATIVE_CAPTURE_V1',
    'agency_id',v_group.agency_id,'environment',v_group.environment,'contract_week_id',v_week.id,
    'contract_id',v_contract.id,'candidate_id',v_contract.candidate_id,'client_id',v_contract.client_id,
    'week_ending_date',v_week.week_ending_date,'source_group_id',v_group.id,'source_cycle_id',v_cycle.id,
    'source_upload_id',v_upload.id,'source_publication_id',v_publication.id,
    'rule_set_version_id',(v_rules->>'rule_set_version_id')::uuid,'source_cas',v_cas,
    'source_dependency_tokens',source_admission->'source_dependency_tokens',
    'source_dependency_tokens_sha256',source_admission->>'source_dependency_tokens_sha256',
    'initial_timesheet_id',v_ts.timesheet_id,'initial_timesheet_version',v_ts.version,
    'initial_row_signature',btrim(coalesce(v_signature->>'backend_row_signature',v_signature->>'row_signature',v_signature->>'signature')),
    'canonical_family_booking_id',btrim(v_ts.booking_id),'original_draft_invoice_id',v_invoice.id,
    'original_draft_invoice_no',v_invoice.invoice_no,'current_financial_id',v_fin.id,'schedule',v_schedule,
    'original_submitted_claim',v_claim,'original_legacy_document',v_legacy_document,'original_before_pay_inputs',v_before_pay_witness);
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_CHANGE_NATIVE_CAPTURE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_change_capture_v1(uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_change_capture_v1(uuid,uuid) from public,anon,authenticated,service_role;

-- Digest original business input and ORIGINAL native capture only. Current
-- Source/T0, mutable phase receipts and the genuine later resumer do not enter it.
create or replace function private.weekly_source_agency_change_request_sha256_v1(
  p_contract_week_id uuid,p_reason text,p_expected_signature text,p_request_key text,
  p_original_creator_user_id uuid,p_original_capture jsonb
) returns bytea language sql immutable
set search_path to 'pg_catalog','private','pg_temp'
as $function$
  select private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_CHANGE_REQUEST_V1',jsonb_build_object(
    'contract_week_id',p_contract_week_id,'reason',p_reason,'expected_signature',p_expected_signature,
    'request_key',p_request_key,'original_creator_user_id',p_original_creator_user_id,
    'original_capture',p_original_capture));
$function$;
alter function private.weekly_source_agency_change_request_sha256_v1(uuid,text,text,text,uuid,jsonb) owner to postgres;
revoke all on function private.weekly_source_agency_change_request_sha256_v1(uuid,text,text,text,uuid,jsonb)
  from public,anon,authenticated,service_role;


-- Exact selected runtime component 37: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/repeatable/06_actual_original_claim_recheck.sqlinc
-- Recheck the native original claim through immutable workflow/component owners.
-- The ordinary current-submission reader is unchanged and still rejects revoke.
create or replace function private.weekly_source_agency_original_claim_recheck_v1(
 p_request_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 w public.candidate_submission_workflows%rowtype;
 h public.candidate_submission_components%rowtype; sig public.candidate_submission_components%rowtype;
 t public.timesheets%rowtype; capture jsonb; stored jsonb; witness jsonb;
 input jsonb; patch jsonb; schedule jsonb; actual jsonb; count_hours integer;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 capture:=r.native_receipts->'original_capture';stored:=capture->'original_submitted_claim';
 if private.weekly_source_agency_change_request_sha256_v1(r.contract_week_id,r.reason,r.initial_row_signature,
  r.request_key,r.actor_user_id,capture) is distinct from r.request_sha256 then
  raise exception 'AGENCY_CHANGE_ORIGINAL_REQUEST_DIGEST_INVALID' using errcode='55000'; end if;
 select * into strict t from public.timesheets where timesheet_id=r.initial_timesheet_id;
 if r.current_timesheet_id is distinct from r.initial_timesheet_id or t.is_current is distinct from true
  or t.version is distinct from r.initial_timesheet_version or t.contract_id is distinct from r.contract_id
  or t.week_ending_date is distinct from r.week_ending_date or t.sheet_scope::text is distinct from 'WEEKLY'
  or t.line_type::text is distinct from 'HOURS' or t.archived_at_utc is not null
  or (t.revoked_at is not null and coalesce((t.revoked_reason='TIMESHEET_UNAUTHORISE'
    and t.revoked_by=r.native_receipts#>>'{unauthorise,phase_actor_user_id}'
    and r.native_receipts#>>'{unauthorise,result,timesheet_id}'=t.timesheet_id::text
    and r.native_receipts#>>'{unauthorise,result,ok}'='true'
    and r.phase in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT')),false) is distinct from true) then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_SCOPE_CHANGED' using errcode='40001'; end if;
 if stored->>'available' is distinct from 'true' then
  return jsonb_build_object('available',false,'reason',coalesce(stored->>'reason','ORIGINAL_CLAIM_PRODUCER_UNAVAILABLE'));
 end if;
 if stored->>'submission_state'='NO_ORIGINAL_SUBMISSION' then
  if stored#>>'{native_submission,actual_submitted}' is distinct from 'false'
   or stored#>>'{native_submission,support_state}' is distinct from 'NOT_SUBMITTED'
   or stored->>'claim_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_AGENCY_NO_ORIGINAL_SUBMISSION_V1',jsonb_build_object('timesheet_id',r.initial_timesheet_id,
     'timesheet_version',r.initial_timesheet_version,'native_submission',stored->'native_submission')),'hex')
   or exists(select 1 from public.candidate_submission_workflows workflow
    where workflow.target_timesheet_id=t.timesheet_id and workflow.candidate_id=r.candidate_id
     and workflow.worker_submitted_at_utc is not null and workflow.cancelled_at_utc is null
     and workflow.workflow_kind in('CONTRACT_HOURS','CONTRACT_COMBINED')
     and workflow.state in('WORKER_SUBMITTED','WORKER_SUBMITTED_PENDING_REVIEW_DOCUMENT','READY_FOR_MANAGER_APPROVAL',
       'AWAITING_MANAGER_APPROVAL','MANAGER_APPROVED','MANAGER_APPROVED_PENDING_FINAL_DOCUMENT','READY_TO_FINALISE',
       'AWAITING_PAPER_RETURN','RECEIVED','FINALISED')) then
   raise exception 'AGENCY_CHANGE_ORIGINAL_SUBMISSION_CHANGED' using errcode='40001'; end if;
  -- This is a proved original absence, not a paid quantity or signed claim.
  return jsonb_build_object('available',true,'submission_state','NO_ORIGINAL_SUBMISSION',
   'claim_sha256',stored->'claim_sha256','claim',null);
 end if;
 if stored->>'submission_state' is distinct from 'IMMUTABLE_CANDIDATE_CLAIM'
  or jsonb_typeof(stored->'claim_witness') is distinct from 'object' then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_PRODUCER_UNAVAILABLE' using errcode='55000'; end if;
 witness:=stored->'claim_witness';
 select * into strict w from public.candidate_submission_workflows
  where id=(witness->>'workflow_id')::uuid and generation=(witness->>'workflow_generation')::integer
   and target_timesheet_id=r.initial_timesheet_id and candidate_id=r.candidate_id and contract_id=r.contract_id
   and environment=r.environment
   and week_ending_date=r.week_ending_date and scope='WEEKLY'
   and workflow_kind in('CONTRACT_HOURS','CONTRACT_COMBINED') and worker_submitted_at_utc is not null
   and cancelled_at_utc is null and state in('WORKER_SUBMITTED','WORKER_SUBMITTED_PENDING_REVIEW_DOCUMENT',
    'READY_FOR_MANAGER_APPROVAL','AWAITING_MANAGER_APPROVAL','MANAGER_APPROVED','MANAGER_APPROVED_PENDING_FINAL_DOCUMENT',
    'READY_TO_FINALISE','AWAITING_PAPER_RETURN','RECEIVED','FINALISED');
 if jsonb_typeof(w.immutable_submission_json) is distinct from 'object'
  or octet_length(w.immutable_submission_sha256) is distinct from 32
  or private._candidate_sha256_jsonb_v1(w.immutable_submission_json) is distinct from w.immutable_submission_sha256
  or encode(w.immutable_submission_sha256,'hex') is distinct from witness->>'submission_sha256'
  or (t.candidate_workflow_id is not null and (t.candidate_workflow_id is distinct from w.id
    or t.candidate_workflow_generation is distinct from w.generation)) then
  raise exception 'AGENCY_CHANGE_ORIGINAL_SUBMISSION_CHANGED' using errcode='40001'; end if;
 select count(*) into count_hours from public.candidate_submission_components component
  where component.workflow_id=w.id and component.workflow_generation=w.generation
   and component.component_kind='HOURS_TIMESHEET' and component.required
   and component.state='IMMUTABLE' and component.immutable_at_utc is not null
   and (component.timesheet_id is null or component.timesheet_id=t.timesheet_id);
 select * into strict h from public.candidate_submission_components where id=(witness->>'hours_component_id')::uuid
  and workflow_id=w.id and workflow_generation=w.generation and component_kind='HOURS_TIMESHEET'
  and required and state='IMMUTABLE' and immutable_at_utc is not null
  and (timesheet_id is null or timesheet_id=t.timesheet_id);
 select * into strict sig from public.candidate_submission_components where id=w.candidate_signature_component_id
  and id=(witness->>'candidate_signature_component_id')::uuid and workflow_id=w.id and workflow_generation=w.generation
  and document_role='CANDIDATE_SIGNATURE' and state='IMMUTABLE' and immutable_at_utc is not null;
 if count_hours<>1 or w.candidate_signed_at_utc is null or nullif(btrim(sig.storage_key),'') is null
  or octet_length(sig.source_content_sha256) is distinct from 32
  or sig.source_content_sha256 is distinct from w.candidate_signature_sha256 then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_COMPONENT_CHANGED' using errcode='40001'; end if;
 input:=coalesce(w.immutable_submission_json->'hours_submission',w.immutable_submission_json);
 patch:=coalesce(input->'timesheet_patch_json',input);
 schedule:=coalesce(patch->'actual_schedule_json',input#>'{canonical_tsfin_snapshot,actual_schedule_json}');
 if jsonb_typeof(schedule) is distinct from 'array' or jsonb_array_length(schedule)>100
  or octet_length(schedule::text)>65536 then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_BOUND_INVALID' using errcode='55000'; end if;
 actual:=jsonb_build_object('authority','CANDIDATE_IMMUTABLE_HOURS','timesheet_id',t.timesheet_id,
  'timesheet_version',r.initial_timesheet_version,'candidate_id',r.candidate_id,'client_id',r.client_id,
  'contract_id',r.contract_id,'week_ending_date',r.week_ending_date,'workflow_id',w.id,'workflow_generation',w.generation,
  'submission_sha256',encode(w.immutable_submission_sha256,'hex'),'hours_component_id',h.id,
  'candidate_signature_component_id',sig.id,'submitted_at_utc',w.worker_submitted_at_utc,
  'signed_at_utc',w.candidate_signed_at_utc,'actual_schedule_json',schedule);
 -- Validate the actual native instants, while retaining the original emitted
 -- timestamp strings so a different session TimeZone cannot rewrite claim bytes.
 if actual-array['actual_schedule_json','submitted_at_utc','signed_at_utc']
    is distinct from witness-array['submitted_at_utc','signed_at_utc']
  or (witness->>'submitted_at_utc')::timestamptz is distinct from w.worker_submitted_at_utc
  or (witness->>'signed_at_utc')::timestamptz is distinct from w.candidate_signed_at_utc then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_CHANGED' using errcode='40001'; end if;
 actual:=witness||jsonb_build_object('actual_schedule_json',schedule);
 if encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',actual),'hex')
    is distinct from stored->>'claim_sha256' then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_CHANGED' using errcode='40001'; end if;
 return jsonb_build_object('available',true,'submission_state','IMMUTABLE_CANDIDATE_CLAIM',
  'claim_sha256',stored->'claim_sha256','claim',actual);
exception when no_data_found or too_many_rows or invalid_text_representation
 or invalid_datetime_format or datetime_field_overflow then
 raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_original_claim_recheck_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_original_claim_recheck_v1(uuid)
 from public,anon,authenticated,service_role;


-- Exact selected runtime component 38: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/repeatable/115_complete_current_request_assert_with_original_claim_recheck.sqlinc
-- One current-actor admission for an existing immutable business request.
-- A genuine scoped resumer is independent of its immutable original creator.
create or replace function private.weekly_source_agency_change_request_assert_v1(
  p_contract_week_id uuid,p_reason text,p_expected_signature text,p_request_key text,p_actor_user_id uuid
) returns private.weekly_source_agency_timesheet_change_requests
language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  v_request private.weekly_source_agency_timesheet_change_requests%rowtype;
  v_week public.contract_weeks%rowtype; v_ts public.timesheets%rowtype;
  v_contract public.contracts%rowtype; v_group public.weekly_source_groups%rowtype;
  v_locks jsonb; v_signature jsonb; v_original jsonb; v_cas jsonb; v_scope jsonb;
  v_hash bytea; v_unauthorise_actor text; v_rule_version uuid; native_admission jsonb; source_admission jsonb; merged_tokens jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if current_setting('transaction_isolation') is distinct from 'read committed' then
    raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001'; end if;
  if p_contract_week_id is null or p_actor_user_id is null or p_request_key is null
    or length(p_request_key) not between 1 and 200 or p_request_key is distinct from btrim(p_request_key)
    or p_reason is null or length(p_reason) not between 1 and 2000 or p_reason is distinct from btrim(p_reason)
    or p_expected_signature is null or length(p_expected_signature) not between 1 and 512 then
    raise exception 'AGENCY_CHANGE_REQUEST_INVALID' using errcode='22023'; end if;
  if private.weekly_source_pay_actor_allowed_v1(p_actor_user_id) is distinct from true then
    raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
  select * into strict v_request from private.weekly_source_agency_timesheet_change_requests where request_key=p_request_key;
  if p_contract_week_id is distinct from v_request.contract_week_id or p_reason is distinct from v_request.reason
    or p_expected_signature is distinct from v_request.initial_row_signature then
    raise exception 'AGENCY_CHANGE_REQUEST_KEY_REUSED' using errcode='22023'; end if;
  v_original:=v_request.native_receipts->'original_capture';
  if jsonb_typeof(v_original) is distinct from 'object'
    or v_original->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_CHANGE_NATIVE_CAPTURE_V1'
    or v_original->>'contract_week_id' is distinct from v_request.contract_week_id::text
    or v_original->>'contract_id' is distinct from v_request.contract_id::text
    or v_original->>'candidate_id' is distinct from v_request.candidate_id::text
    or v_original->>'client_id' is distinct from v_request.client_id::text
    or v_original->>'agency_id' is distinct from v_request.agency_id::text
    or v_original->>'environment' is distinct from v_request.environment
    or v_original->>'week_ending_date' is distinct from v_request.week_ending_date::text
    or v_original->>'source_group_id' is distinct from v_request.source_group_id::text
    or v_original->>'source_cycle_id' is distinct from v_request.source_cycle_id::text
    or v_original->>'source_upload_id' is distinct from v_request.source_upload_id::text
    or v_original->>'source_publication_id' is distinct from v_request.source_publication_id::text
    or v_original->>'rule_set_version_id' is distinct from v_request.rule_set_version_id::text
    or v_original->'source_cas' is distinct from v_request.source_cas
    or v_original->>'initial_timesheet_id' is distinct from v_request.initial_timesheet_id::text
    or v_original->>'initial_timesheet_version' is distinct from v_request.initial_timesheet_version::text
    or v_original->>'initial_row_signature' is distinct from v_request.initial_row_signature
    or v_original->>'canonical_family_booking_id' is distinct from v_request.canonical_family_booking_id
    or v_original->>'original_draft_invoice_id' is distinct from v_request.original_draft_invoice_id::text
    or v_original->>'original_draft_invoice_no' is distinct from v_request.original_draft_invoice_no then
    raise exception 'AGENCY_CHANGE_ORIGINAL_CAPTURE_INVALID' using errcode='55000'; end if;
  -- The current actor is deliberately NOT the creator parameter here. This
  -- rechecks the original immutable capture even after a native phase changed T0.
  v_hash:=private.weekly_source_agency_change_request_sha256_v1(p_contract_week_id,p_reason,p_expected_signature,
    p_request_key,v_request.actor_user_id,v_original);
  if v_hash is distinct from v_request.request_sha256 then
    raise exception 'AGENCY_CHANGE_ORIGINAL_REQUEST_DIGEST_INVALID' using errcode='55000'; end if;
  select * into strict v_week from public.contract_weeks where id=v_request.contract_week_id;
  select * into strict v_contract from public.contracts where id=v_request.contract_id;
  if v_week.contract_id is distinct from v_request.contract_id or v_week.week_ending_date is distinct from v_request.week_ending_date
    or coalesce(v_week.additional_seq,0)<>0 or coalesce(v_week.is_adjustment,false)
    or v_week.timesheet_id is null or v_contract.candidate_id is distinct from v_request.candidate_id
    or v_contract.client_id is distinct from v_request.client_id then
    raise exception 'AGENCY_CHANGE_CURRENT_SUBJECT_SCOPE_CHANGED' using errcode='40001'; end if;
  native_admission:=private.weekly_source_agency_candidate_admit_v1(v_week.timesheet_id,p_actor_user_id);
  -- Preserve invoice -> Timesheet/financial order. The immutable D1 is the
  -- only return destination; an unrelated placement is never adopted.
  if v_request.state='ACTIVE' then
    if v_request.original_draft_invoice_id is not null then
      perform 1 from public.invoices where id=v_request.original_draft_invoice_id for update;
      if not found then
        raise exception 'AGENCY_DRAFT_ROUND_TRIP_ORIGINAL_D1_CHANGED' using errcode='40001'; end if;
    end if;
    if exists(select 1 from public.invoice_lines line
      where line.timesheet_id in(v_request.initial_timesheet_id,v_request.current_timesheet_id)
        and line.invoice_id is distinct from v_request.original_draft_invoice_id) then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_FOREIGN_PLACEMENT' using errcode='40001'; end if;
  end if;
  v_locks:=private.weekly_source_lock_family_rows_v1(array[v_week.timesheet_id],v_request.candidate_id);
  if v_locks->>'ok' is distinct from 'true' then
    raise exception 'AGENCY_CHANGE_NATIVE_FAMILY_LOCK_REFUSED' using errcode='55000',detail=v_locks::text; end if;
  select * into strict v_week from public.contract_weeks where id=v_request.contract_week_id for update;
  select * into strict v_ts from public.timesheets where timesheet_id=v_week.timesheet_id for update;
  select * into strict v_group from public.weekly_source_groups where id=v_request.source_group_id and active and source_family='ROSTER' for update;
  if v_group.agency_id is distinct from v_request.agency_id or v_group.environment is distinct from 'TEST'
    or v_ts.contract_id is distinct from v_request.contract_id or v_ts.week_ending_date is distinct from v_request.week_ending_date
    or v_ts.is_current is distinct from true or v_ts.archived_at_utc is not null
    or v_ts.sheet_scope::text is distinct from 'WEEKLY' or v_ts.line_type::text is distinct from 'HOURS'
    or v_ts.correction_id is not null or coalesce(v_ts.is_adjustment,false) then
    raise exception 'AGENCY_CHANGE_CURRENT_SUBJECT_SCOPE_CHANGED' using errcode='40001'; end if;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'VIEW_PAY_WORK',
    v_group.id,v_request.client_id,v_request.week_ending_date);
  if (select count(*) from public.weekly_source_group_clients membership
    join public.weekly_source_groups source_group on source_group.id=membership.source_group_id and source_group.active
    where membership.client_id=v_request.client_id and v_request.week_ending_date between membership.valid_from
      and coalesce(membership.valid_to,'infinity'::date))<>1 then
    raise exception 'WEEKLY_SOURCE_AUTHORISE_SCOPE_AMBIGUOUS' using errcode='55000'; end if;
  select * into strict v_request from private.weekly_source_agency_timesheet_change_requests where id=v_request.id for update;
  if v_request.state='COMPLETED' then
    -- No economic action or relabelled authorisation. Exact completed receipt
    -- is readable only after the genuine current user's present subject scope.
    v_scope:=public.weekly_source_office_authorise_scope_v1(jsonb_build_object(
      'actor_user_id',p_actor_user_id,'timesheet_id',v_ts.timesheet_id));
    if v_scope->>'contract' is distinct from 'WEEKLY_SOURCE_AUTHORISE_SCOPE_V1'
      or v_scope->>'applicable' is distinct from 'true' then
      raise exception 'AGENCY_CHANGE_SOURCE_SCOPE_REFUSED' using errcode='42501'; end if;
    return v_request;
  end if;
  if exists(select 1 from public.invoice_lines line
    where line.timesheet_id in(v_request.initial_timesheet_id,v_request.current_timesheet_id)
      and line.invoice_id is distinct from v_request.original_draft_invoice_id) then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_FOREIGN_PLACEMENT' using errcode='40001'; end if;
  if v_ts.timesheet_id is distinct from v_request.current_timesheet_id
    or v_ts.version is distinct from v_request.current_timesheet_version
    or btrim(v_ts.booking_id) is distinct from v_request.canonical_family_booking_id then
    raise exception 'AGENCY_INVOICE_TIMESHEET_ROTATED' using errcode='40001'; end if;
  if v_ts.revoked_at is not null then
    v_unauthorise_actor:=v_request.native_receipts#>>'{unauthorise,phase_actor_user_id}';
    if v_request.phase not in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT')
      or v_ts.revoked_reason is distinct from 'TIMESHEET_UNAUTHORISE'
      or v_ts.revoked_by is distinct from v_unauthorise_actor
      or v_request.native_receipts#>>'{unauthorise,result,timesheet_id}' is distinct from v_ts.timesheet_id::text
      or v_request.native_receipts#>>'{unauthorise,result,ok}' is distinct from 'true' then
      raise exception 'AGENCY_INVOICE_TIMESHEET_ROTATED' using errcode='40001'; end if;
  end if;
  -- Every advancing native phase rechecks the actual immutable original claim.
  -- The helper retains unavailable/absence semantics; no claim is manufactured.
  perform private.weekly_source_agency_original_claim_recheck_v1(v_request.id);
  v_cas:=private.weekly_source_bulk_source_cas_v1(v_request.source_cycle_id,array[v_request.client_id]);
  if v_cas is distinct from v_request.source_cas then
    raise exception 'AGENCY_CHANGE_ORIGINAL_SOURCE_CAS_CHANGED' using errcode='40001'; end if;
  select (private.weekly_source_effective_rule_set_v1(v_request.client_id,v_request.source_cycle_id)->>'rule_set_version_id')::uuid
    into v_rule_version;
  if v_rule_version is distinct from v_request.rule_set_version_id then
    raise exception 'AGENCY_CHANGE_OPERATIONAL_RULE_UNAVAILABLE' using errcode='55000'; end if;
  if v_original->>'source_dependency_tokens_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_AGENCY_SOURCE_DEPENDENCY_TOKENS_V1',v_request.source_dependency_tokens),'hex') then
    raise exception 'AGENCY_CHANGE_ORIGINAL_NATIVE_SOURCE_FOOTPRINT_CHANGED' using errcode='55000';end if;
  source_admission:=private.weekly_source_agency_source_phase_admit_v1(v_ts.timesheet_id,p_actor_user_id,
    v_request.candidate_id,v_request.source_cycle_id,v_request.client_id,v_request.source_cas,native_admission);
  select coalesce(jsonb_agg(value order by value),'[]'::jsonb) into merged_tokens from(
    select distinct value from jsonb_array_elements(v_request.current_source_dependency_tokens||(source_admission->'source_dependency_tokens'))
  ) native_current_union;
  if merged_tokens is distinct from v_request.current_source_dependency_tokens then
    source_admission:=(source_admission-'source_dependency_tokens')||jsonb_build_object('request_id',v_request.id,
      'request_sha256',encode(v_request.request_sha256,'hex'),'source_dependency_tokens_sha256',encode(
        private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_SOURCE_DEPENDENCY_TOKENS_V1',merged_tokens),'hex'));
    update private.weekly_source_agency_timesheet_change_requests set current_source_dependency_tokens=merged_tokens,
      native_receipts=native_receipts||jsonb_build_object('source_admission',source_admission),
      updated_by_user_id=p_actor_user_id,updated_at_utc=transaction_timestamp(),version=version+1
      where id=v_request.id returning * into v_request;
    insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,action,after_json,reason,correlation_id)
      select gen_random_uuid(),transaction_timestamp(),p_actor_user_id,a.role,'WEEKLY_SOURCE_AGENCY_CHANGE',v_request.id::text,
        'NATIVE_SOURCE_FOOTPRINT_RETAINED',jsonb_build_object('phase',v_request.phase,'request_version',v_request.version,
          'original_creator_user_id',v_request.actor_user_id,'current_resumer_user_id',p_actor_user_id,
          'source_dependency_tokens_sha256',source_admission->>'source_dependency_tokens_sha256'),v_request.reason,v_request.request_key
      from public.tms_users a where a.id=p_actor_user_id and a.is_active;
    if not found then raise exception 'AGENCY_CHANGE_CURRENT_ACTOR_UNAVAILABLE' using errcode='42501';end if;
  end if;
  v_signature:=public.timesheet_lifecycle_guard_signature_v1(v_ts.timesheet_id,v_week.id,false);
  -- A changed signature is admissible only when the existing canonical writer
  -- observation has retained its actual matching outbox/current financial cut.
  -- Generic TSFIN currentness or outbox disappearance alone never proves it.
  if btrim(coalesce(v_signature->>'backend_row_signature',v_signature->>'row_signature',v_signature->>'signature'))
    is distinct from v_request.current_row_signature
    and coalesce((v_request.phase='UNAUTHORISED'
      and v_request.native_receipts#>>'{financial_write_frame,mode}'='MANUAL'
      and v_request.native_receipts#>>'{financial_write_frame,request_id}'=v_request.id::text
      and v_request.native_receipts#>>'{financial_write_frame,request_sha256}'=encode(v_request.request_sha256,'hex')
      and v_request.native_receipts#>>'{financial_write_frame,transaction_id}'=pg_current_xact_id()::text
      and v_request.native_receipts#>>'{financial_write_frame,backend_pid}'=pg_backend_pid()::text
      and v_request.native_receipts#>>'{financial_write_frame,phase_actor_user_id}'=v_request.updated_by_user_id::text
      and v_request.native_receipts#>>'{financial_write_frame,timesheet_id}'=v_ts.timesheet_id::text
      and v_request.native_receipts#>>'{financial_write_frame,timesheet_version}'=v_ts.version::text
      and v_request.native_receipts#>'{financial_write_frame,source_cas}'=v_request.source_cas
      and v_ts.actual_schedule_json=v_request.native_receipts#>'{original_capture,schedule}')
     or(v_request.phase='RECOMPUTE_PENDING'
      and v_request.native_receipts#>>'{recompute,observed_outbox_id}'=v_request.outbox_id::text
      and v_request.native_receipts#>>'{recompute,timesheet_id}'=v_request.current_timesheet_id::text
      and v_request.native_receipts#>>'{recompute,timesheet_version}'=v_request.current_timesheet_version::text
      and exists(select 1 from public.timesheets_financials tf where tf.is_current
        and tf.id::text=v_request.native_receipts#>>'{recompute,financial_id}'
        and tf.timesheet_id=v_request.current_timesheet_id and tf.timesheet_version=v_request.current_timesheet_version
        and encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_RECOMPUTE_ROW_V1',to_jsonb(tf)),'hex')
          =v_request.native_receipts#>>'{recompute,financial_row_sha256}')),false) is distinct from true then
    raise exception 'AGENCY_CHANGE_CURRENT_PHASE_SIGNATURE_CHANGED' using errcode='40001'; end if;
  return v_request;
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_CHANGE_CURRENT_REQUEST_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_change_request_assert_v1(uuid,text,text,text,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_change_request_assert_v1(uuid,text,text,text,uuid)
  from public,anon,authenticated,service_role;


-- Exact selected runtime component 39: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/repeatable/07_actual_native_begin.sqlinc
-- Initial portion of the SINGLE planned native change owner. Owner-private;
-- not a second business entry or a public placeholder. Canonical Worker/native
-- completion and authorise/return phases are separate continuing construction.
create or replace function private.weekly_source_agency_change_begin_v1(
 p_contract_week_id uuid,p_reason text,p_expected_signature text,p_request_key text,p_actor_user_id uuid
) returns private.weekly_source_agency_timesheet_change_requests
language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 capture jsonb; signature jsonb; receipt jsonb; native_result jsonb;
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype; cw public.contract_weeks%rowtype;
 actor public.tms_users%rowtype; next_signature text; error_code text; error_state text;
 audit_id uuid; receipts jsonb; pay_purpose jsonb; dependency_tokens jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001'; end if;
 if p_contract_week_id is null or p_actor_user_id is null or p_reason is null
  or length(p_reason) not between 1 and 2000 or p_reason is distinct from btrim(p_reason)
  or p_request_key is null or length(p_request_key) not between 1 and 200
  or p_request_key is distinct from btrim(p_request_key)
  or p_expected_signature is null or length(p_expected_signature) not between 1 and 512 then
  raise exception 'AGENCY_CHANGE_REQUEST_INVALID' using errcode='22023'; end if;
 if private.weekly_source_pay_actor_allowed_v1(p_actor_user_id) is distinct from true then
  raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
 select * into strict actor from public.tms_users where id=p_actor_user_id and is_active;
 -- Only duplicate click-key admission serialisation; real invoice/family/source
 -- locks are still derived and taken by capture/request authority in native order.
 perform pg_advisory_xact_lock(hashtextextended('weekly_source_agency_change_key:'||p_request_key,0));
 select * into r from private.weekly_source_agency_timesheet_change_requests where request_key=p_request_key;
 if found then
  r:=private.weekly_source_agency_change_request_assert_v1(p_contract_week_id,p_reason,
    p_expected_signature,p_request_key,p_actor_user_id);
  if r.state='COMPLETED' then return r; end if;
  if r.updated_by_user_id is distinct from p_actor_user_id then
   update private.weekly_source_agency_timesheet_change_requests set updated_by_user_id=p_actor_user_id,
    updated_at_utc=transaction_timestamp(),version=version+1 where id=r.id returning * into r;
   insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,
     action,after_json,reason,correlation_id)
    values(gen_random_uuid(),transaction_timestamp(),p_actor_user_id,actor.role,'WEEKLY_SOURCE_AGENCY_CHANGE',r.id::text,
      'RESUME_CURRENT_SCOPED_ACTOR',jsonb_build_object('phase',r.phase,'request_version',r.version,
        'original_creator_user_id',r.actor_user_id,'current_resumer_user_id',p_actor_user_id),p_reason,r.request_key);
  end if;
 else
  capture:=private.weekly_source_agency_change_capture_v1(p_contract_week_id,p_actor_user_id);
  dependency_tokens:=capture->'source_dependency_tokens';
  if jsonb_typeof(dependency_tokens) is distinct from 'array'
   or capture->>'source_dependency_tokens_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
    'WEEKLY_SOURCE_AGENCY_SOURCE_DEPENDENCY_TOKENS_V1',dependency_tokens),'hex') then
   raise exception 'AGENCY_CHANGE_NATIVE_SOURCE_FOOTPRINT_REQUIRED' using errcode='55000';end if;
  -- Keep the actual full immutable tokens on the same request, and only their
  -- native digest in the original small capture / request-input hash.
  capture:=capture-'source_dependency_tokens';
  if capture->>'initial_row_signature' is distinct from p_expected_signature then
   raise exception 'AGENCY_CHANGE_EXPECTED_SIGNATURE_CHANGED' using errcode='40001'; end if;
  if octet_length(jsonb_build_object('original_capture',capture)::text)>49152 then
   raise exception 'AGENCY_CHANGE_NATIVE_CAPTURE_BOUND_EXCEEDED' using errcode='54000'; end if;
  if exists(select 1 from private.weekly_source_agency_timesheet_change_requests active
   where active.state='ACTIVE' and (active.contract_week_id=p_contract_week_id
     or(active.agency_id=(capture->>'agency_id')::uuid
       and active.canonical_family_booking_id=capture->>'canonical_family_booking_id'))) then
   raise exception 'AGENCY_CHANGE_EXISTING_ACTIVE_REQUEST_REQUIRED' using errcode='40001'; end if;
  insert into private.weekly_source_agency_timesheet_change_requests(
   request_key,request_sha256,actor_user_id,reason,environment,agency_id,contract_week_id,contract_id,candidate_id,
   client_id,week_ending_date,source_group_id,source_cycle_id,source_upload_id,source_publication_id,rule_set_version_id,
   source_cas,source_dependency_tokens,current_source_dependency_tokens,initial_timesheet_id,initial_timesheet_version,initial_row_signature,canonical_family_booking_id,
   original_draft_invoice_id,original_draft_invoice_no,current_timesheet_id,current_timesheet_version,current_row_signature,
   return_hold,current_financial_id,native_receipts,updated_by_user_id)
  values(p_request_key,private.weekly_source_agency_change_request_sha256_v1(p_contract_week_id,p_reason,
    p_expected_signature,p_request_key,p_actor_user_id,capture),p_actor_user_id,p_reason,'TEST',
   (capture->>'agency_id')::uuid,p_contract_week_id,(capture->>'contract_id')::uuid,(capture->>'candidate_id')::uuid,
   (capture->>'client_id')::uuid,(capture->>'week_ending_date')::date,(capture->>'source_group_id')::uuid,
   (capture->>'source_cycle_id')::uuid,(capture->>'source_upload_id')::uuid,(capture->>'source_publication_id')::uuid,
   (capture->>'rule_set_version_id')::uuid,capture->'source_cas',dependency_tokens,dependency_tokens,(capture->>'initial_timesheet_id')::uuid,
   (capture->>'initial_timesheet_version')::integer,p_expected_signature,capture->>'canonical_family_booking_id',
   (capture->>'original_draft_invoice_id')::uuid,capture->>'original_draft_invoice_no',
   (capture->>'initial_timesheet_id')::uuid,(capture->>'initial_timesheet_version')::integer,p_expected_signature,
   false,(capture->>'current_financial_id')::uuid,
   jsonb_build_object('original_capture',capture),p_actor_user_id) returning * into r;
  insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,
    action,after_json,reason,correlation_id)
   values(gen_random_uuid(),transaction_timestamp(),p_actor_user_id,actor.role,'WEEKLY_SOURCE_AGENCY_CHANGE',r.id::text,
    'CAPTURE_NATIVE_REQUEST',jsonb_build_object('phase',r.phase,'request_version',r.version,
      'request_sha256',encode(r.request_sha256,'hex')),p_reason,p_request_key);
 end if;
 -- Each attempted phase has its own subtransaction. Failure does not relabel
 -- an earlier real phase, discard D1's hold or manufacture queue/completion.
 if r.phase='CAPTURED' then
  begin
   if r.original_draft_invoice_id is not null then
    receipt:=private.weekly_source_agency_draft_round_trip_v1(r.request_key,'REMOVE',p_actor_user_id);
    if receipt->>'ok' is distinct from 'true' or receipt->>'step' is distinct from 'REMOVE'
     or receipt->>'request_id' is distinct from r.id::text then
     raise exception 'AGENCY_CHANGE_NATIVE_DRAFT_REMOVAL_UNPROVED'; end if;
    next_signature:=receipt->>'current_row_signature';
   else
    if exists(select 1 from public.invoice_lines l where l.timesheet_id=r.current_timesheet_id) then
     raise exception 'AGENCY_CHANGE_FOREIGN_DRAFT_PLACEMENT'; end if;
    signature:=public.timesheet_lifecycle_guard_signature_v1(r.current_timesheet_id,r.contract_week_id,false);
    next_signature:=btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature'));
    receipt:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_DRAFT_ABSENCE_V1',
      'request_id',r.id,'timesheet_id',r.current_timesheet_id,'original_draft_invoice_id',null,
      'native_editor_called',false,'native_observed_no_placement',true,'phase_actor_user_id',p_actor_user_id);
   end if;
   if nullif(next_signature,'') is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE'; end if;
   receipts:=r.native_receipts||jsonb_build_object('remove_draft',receipt);
   if octet_length(receipts::text)>65536 then raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED'; end if;
   update private.weekly_source_agency_timesheet_change_requests set phase='DRAFT_REMOVED',native_receipts=receipts,
    return_hold=r.original_draft_invoice_id is not null,
    current_row_signature=next_signature,updated_by_user_id=p_actor_user_id,version=version+1,
    updated_at_utc=transaction_timestamp(),last_refusal_code=null where id=r.id returning * into r;
  exception when others then
   get stacked diagnostics error_code=MESSAGE_TEXT,error_state=RETURNED_SQLSTATE;
   update private.weekly_source_agency_timesheet_change_requests set last_refusal_code=case when error_code~'^[A-Z][A-Z0-9_]{0,199}$' then error_code
      else 'AGENCY_CHANGE_NATIVE_PHASE_FAILED' end,
    updated_by_user_id=p_actor_user_id,updated_at_utc=transaction_timestamp(),version=version+1
    where id=r.id returning * into r;
   return r;
  end;
 end if;
 if r.phase='DRAFT_REMOVED' then
  begin
   r:=private.weekly_source_agency_change_request_assert_v1(p_contract_week_id,p_reason,
     p_expected_signature,p_request_key,p_actor_user_id);
   select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
   select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
   select * into strict cw from public.contract_weeks where id=r.contract_week_id;
   if t.authorised_at_server is not null or f.authorised_at_utc is not null or cw.status::text='AUTHORISED' then
    native_result:=public.timesheet_unauthorise_atomic(t.timesheet_id,t.timesheet_id,p_actor_user_id,
      transaction_timestamp(),r.current_row_signature);
    if native_result->>'ok' is distinct from 'true' or native_result->>'timesheet_id' is distinct from t.timesheet_id::text
      or native_result->>'operation' is distinct from 'timesheet_unauthorise' then
     raise exception 'AGENCY_CHANGE_NATIVE_UNAUTHORISE_UNPROVED'; end if;
    select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
    select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
    if t.authorised_at_server is not null or f.authorised_at_utc is not null
      or t.revoked_reason is distinct from 'TIMESHEET_UNAUTHORISE' or t.revoked_by is distinct from p_actor_user_id::text then
     raise exception 'AGENCY_CHANGE_NATIVE_UNAUTHORISE_POSTCONDITION_UNPROVED'; end if;
    receipt:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_UNAUTHORISE_V1',
      'phase_actor_user_id',p_actor_user_id,'native_result_sha256',encode(private.weekly_source_sha256_jsonb_v1(
        'WEEKLY_SOURCE_AGENCY_NATIVE_UNAUTHORISE_RESULT_V1',native_result),'hex'),
      'result',jsonb_build_object('ok',true,'operation',native_result->'operation','timesheet_id',native_result->'timesheet_id',
        'current_version',native_result->'current_version','revoked_at',native_result->'revoked_at'));
   else
    receipt:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_ALREADY_UNAUTHORISED_V1',
      'phase_actor_user_id',p_actor_user_id,'native_unauthorise_called',false,
      'observed_timesheet_authorised_at',t.authorised_at_server,'observed_financial_authorised_at',f.authorised_at_utc,
      'observed_contract_week_status',cw.status::text);
   end if;
   signature:=public.timesheet_lifecycle_guard_signature_v1(t.timesheet_id,r.contract_week_id,false);
   next_signature:=btrim(coalesce(signature->>'backend_row_signature',signature->>'row_signature',signature->>'signature'));
   if nullif(next_signature,'') is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE'; end if;
   receipts:=r.native_receipts||jsonb_build_object('unauthorise',receipt);
   update private.weekly_source_agency_timesheet_change_requests set phase='UNAUTHORISED',native_receipts=receipts,
    current_row_signature=next_signature,current_financial_id=f.id,updated_by_user_id=p_actor_user_id,version=version+1,
    updated_at_utc=transaction_timestamp(),last_refusal_code=null where id=r.id returning * into r;
   pay_purpose:=private.weekly_source_agency_paid_write_purpose_v1(r.id);
   receipts:=r.native_receipts||jsonb_build_object('after_una_pay_purpose',pay_purpose);
   if octet_length(receipts::text)>65536 then raise exception 'AGENCY_CHANGE_NATIVE_RECEIPT_BOUND_EXCEEDED'; end if;
   update private.weekly_source_agency_timesheet_change_requests set native_receipts=receipts,
    version=version+1,updated_at_utc=transaction_timestamp() where id=r.id returning * into r;
  exception when others then
   get stacked diagnostics error_code=MESSAGE_TEXT,error_state=RETURNED_SQLSTATE;
   update private.weekly_source_agency_timesheet_change_requests set last_refusal_code=case when error_code~'^[A-Z][A-Z0-9_]{0,199}$' then error_code
      else 'AGENCY_CHANGE_NATIVE_PHASE_FAILED' end,
    updated_by_user_id=p_actor_user_id,updated_at_utc=transaction_timestamp(),version=version+1
    where id=r.id returning * into r;
   return r;
  end;
 end if;
 return r;
end;
$function$;
alter function private.weekly_source_agency_change_begin_v1(uuid,text,text,text,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_change_begin_v1(uuid,text,text,text,uuid)
 from public,anon,authenticated,service_role;


-- Exact selected runtime component 40: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/repeatable/116_complete_current_source_raw05_with_active_before_union.sqlinc
-- Raw immutable selector extraction. No parent/request lookup precedes it.
-- Same proposed A0 arbiter; no business pricing, publication or entitlement.
create or replace function private.timesheet_correction_a0_source_raw_tokens_v1(p_relation text,p_row jsonb)
returns jsonb language plpgsql immutable security definer set search_path to 'pg_catalog','pg_temp'
as $source_raw$
declare tokens jsonb:='[]'::jsonb; identity uuid; primary_key text; token jsonb; pair jsonb;
 parent_relation text; parent_column text; scope_kind text; left_column text; right_column text;
begin
 if jsonb_typeof(p_row) is distinct from 'object' or p_relation is null
  or p_relation not in('public.weekly_source_groups','public.weekly_source_cycles','public.weekly_source_uploads','public.weekly_source_upload_rows','public.weekly_source_projection_publications','public.weekly_source_row_resolutions','public.weekly_source_row_economic_snapshots','public.weekly_source_row_expense_policy_snapshots','public.weekly_expense_authority_generations','public.weekly_source_expense_cell_evidence','public.weekly_source_charge_checks','public.weekly_source_charge_acceptances','public.weekly_source_invoice_hold_releases','public.weekly_source_state_transitions','public.weekly_source_report_scopes','public.weekly_source_self_bill_reports','public.weekly_source_self_bill_report_line_bindings','public.weekly_work_events','public.weekly_source_final_revisions','public.weekly_source_final_snapshot_lines','public.weekly_source_row_timesheet_lineages','public.weekly_source_ordinary_pay_projection_receipts','public.weekly_discrepancy_incidents','public.weekly_issue_comparison_revisions','public.weekly_source_billing_movements','public.weekly_source_group_clients','public.weekly_source_client_policies','public.weekly_source_contract_policies','public.weekly_source_group_rule_assignments','public.weekly_source_rule_set_versions','public.weekly_source_rule_sets','public.weekly_source_format_profiles','public.clients','public.client_settings','public.contracts','public.timesheets','public.timesheets_financials','public.weekly_source_global_settings') then
  raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';end if;
 if p_relation='public.weekly_source_global_settings' then
  if p_row->'singleton'='true'::jsonb then
   return jsonb_build_array(jsonb_build_object('kind','SOURCE_GLOBAL_SETTINGS','json','true'));
  end if;
  return tokens;
 end if;
 primary_key:=case when p_relation='public.timesheets' then 'timesheet_id' else 'id' end;
 identity:=(p_row->>primary_key)::uuid;
 if identity is null then raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';end if;
 tokens:=jsonb_build_array(jsonb_build_object('kind','SOURCE_OBJECT',
  'json',jsonb_build_array(p_relation,identity)::text));
 -- These exact parent predicates select ALL child rows; another UUID column
 -- on a child is never automatically a dependency/phantom token.
 case p_relation
 when 'public.weekly_source_upload_rows','public.weekly_source_expense_cell_evidence' then
  parent_relation:='public.weekly_source_uploads';parent_column:='upload_id';
 when 'public.weekly_source_row_economic_snapshots','public.weekly_source_row_expense_policy_snapshots',
   'public.weekly_source_charge_checks','public.weekly_source_charge_acceptances' then
  parent_relation:='public.weekly_source_row_resolutions';parent_column:='row_resolution_id';
 when 'public.weekly_source_invoice_hold_releases' then
  parent_relation:='public.weekly_source_upload_rows';parent_column:='upload_row_id';
 when 'public.weekly_source_contract_policies' then
  parent_relation:='public.contracts';parent_column:='contract_id';
 when 'public.client_settings' then
  parent_relation:='public.clients';parent_column:='client_id';
 when 'public.weekly_source_group_rule_assignments' then
  parent_relation:='public.weekly_source_groups';parent_column:='source_group_id';
 when 'public.weekly_source_self_bill_report_line_bindings' then
  if p_row->>'state'='CURRENT' then
   parent_relation:='public.weekly_source_self_bill_reports';parent_column:='self_bill_report_id';
  end if;
 else null;
 end case;
 if parent_column is not null and p_row->>parent_column is not null then
  tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_OBJECT',
   'json',jsonb_build_array(parent_relation,(p_row->>parent_column)::uuid)::text));
 end if;
 if p_relation='public.weekly_source_group_clients' then
  if p_row->>'client_id' is null or p_row->>'valid_from' is null then
   raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';end if;
  tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_POLICY_MEMBERSHIP_COVERAGE',
   'uuid',(p_row->>'client_id')::uuid::text,'coverage',jsonb_build_array((p_row->>'valid_from')::date,(p_row->>'valid_to')::date)));
 end if;
 if p_relation='public.weekly_source_final_revisions' and p_row->>'state' in('CURRENT','PREPARED','SUPERSEDED')
  and p_row->>'source_cycle_id' is not null then
  tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_CYCLE_UUID','uuid',(p_row->>'source_cycle_id')::uuid::text));
 end if;
 if p_relation='public.weekly_source_row_resolutions' and p_row->>'upload_row_id' is not null
  and p_row->>'generation' is not null and p_row->>'client_id' is not null then
  -- Never broaden this AND slot to a raw-row/upload/Client object token.
  pair:=jsonb_build_array((p_row->>'upload_row_id')::uuid,(p_row->>'generation')::integer,(p_row->>'client_id')::uuid);
  tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_RESOLUTION_SLOT','json',pair::text));
 end if;
 case p_relation
 when 'public.weekly_source_final_snapshot_lines','public.weekly_source_ordinary_pay_projection_receipts' then
  scope_kind:='SOURCE_REVISION_CLIENT';left_column:='final_revision_id';right_column:='client_id';
 when 'public.weekly_expense_authority_generations','public.weekly_source_state_transitions' then
  scope_kind:='SOURCE_REVISION_EVENT';left_column:='final_revision_id';right_column:='work_event_id';
 when 'public.weekly_source_group_clients','public.weekly_source_client_policies','public.weekly_source_self_bill_reports' then
  scope_kind:='SOURCE_GROUP_CLIENT';left_column:='source_group_id';right_column:='client_id';
 when 'public.weekly_source_report_scopes' then
  if p_row->>'self_bill_report_id' is not null then
   scope_kind:='SOURCE_GROUP_CLIENT';left_column:='source_group_id';right_column:='client_id';
  end if;
 when 'public.weekly_discrepancy_incidents' then
  scope_kind:='SOURCE_CYCLE_CLIENT';left_column:='source_cycle_id';right_column:='client_id';
 else null;
 end case;
 if scope_kind is not null and p_row->>left_column is not null and p_row->>right_column is not null then
  tokens:=tokens||jsonb_build_array(jsonb_build_object('kind',scope_kind,
   'json',jsonb_build_array((p_row->>left_column)::uuid,(p_row->>right_column)::uuid)::text));
 end if;
 if p_relation='public.weekly_source_row_timesheet_lineages' and p_row->>'client_id' is not null then
  if p_row->>'row_resolution_id' is not null then
   tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_LINEAGE_RESOLUTION_CLIENT',
    'json',jsonb_build_array((p_row->>'row_resolution_id')::uuid,(p_row->>'client_id')::uuid)::text));
  end if;
  if p_row->>'work_event_id' is not null then
   tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_LINEAGE_EVENT_CLIENT',
    'json',jsonb_build_array((p_row->>'work_event_id')::uuid,(p_row->>'client_id')::uuid)::text));
  end if;
 end if;
 if p_relation='public.contracts' and p_row->>'client_id' is not null
  and p_row->>'start_date' is not null and p_row->>'end_date' is not null
  and (p_row->>'start_date')::date<=(p_row->>'end_date')::date then
  tokens:=tokens||jsonb_build_array(jsonb_build_object('kind','SOURCE_CONTRACT_COVERAGE',
   'uuid',(p_row->>'client_id')::uuid::text,'coverage',jsonb_build_array(p_row->>'start_date',p_row->>'end_date')));
 end if;
 for token in select value from jsonb_array_elements(tokens) loop
  perform private.timesheet_correction_a0_source_token_assert_v1(token);
 end loop;
 select coalesce(jsonb_agg(value order by value),'[]'::jsonb) into tokens
  from(select distinct value from jsonb_array_elements(tokens)) complete;
 return tokens;
exception when invalid_text_representation or datetime_field_overflow then
 raise exception 'CORRECTION_A0_SOURCE_RAW_CONTEXT_INVALID' using errcode='55000';
end;
