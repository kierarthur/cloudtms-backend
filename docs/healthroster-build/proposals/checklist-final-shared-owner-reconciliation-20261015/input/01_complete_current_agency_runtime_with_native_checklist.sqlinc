-- Exact selected runtime component 1: 41b9004e1290b6c5a46a92cb972427d3b31dfb4d:docs/healthroster-build/proposals/agency-prospective-contract-fixed-approval-native-forward-20261015/123_contract_fixed_approval_native_helpers.sqlinc
-- Source proposal: native Contract write locks and the system-owned fixed key.
-- No trigger, new store, caller approval choice or transport-only completion.
create or replace function private.weekly_source_contract_fixed_approval_locks_v1(p_client_ids uuid[])
returns void language plpgsql volatile security definer
set search_path to 'pg_catalog','pg_temp'
as $contract_fixed_locks$
declare clients uuid[];groups_before uuid[];groups_after uuid[];identity uuid;
begin
 if p_client_ids is null or cardinality(p_client_ids) not between 1 and 2 or array_position(p_client_ids,null) is not null then
  raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_SCOPE_INVALID' using errcode='22023';end if;
 select array_agg(distinct value order by value) into clients from unnest(p_client_ids) value;
 if (select count(*) from public.clients c where c.id=any(clients))<>cardinality(clients) then
  raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_SCOPE_INVALID' using errcode='22023';end if;
 select coalesce(array_agg(distinct m.source_group_id order by m.source_group_id),'{}'::uuid[]) into groups_before
 from public.weekly_source_group_clients m where m.client_id=any(clients);
 -- Same lifecycle/client keys and order as the actual feature/Client owners.
 -- Existing native deletion/clone callers may already hold their Contract;
 -- non-waiting acquisition refuses a race instead of reversing that lock order.
 foreach identity in array groups_before loop
  if not pg_try_advisory_xact_lock(hashtextextended('weekly-source-cycle-lifecycle:'||identity::text,0)) then
   raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';end if;
 end loop;
 foreach identity in array clients loop
  if not pg_try_advisory_xact_lock(hashtextextended('weekly-source-settings-client:'||identity::text,0)) then
   raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';end if;
 end loop;
 perform 1 from public.clients c where c.id=any(clients) order by c.id for update nowait;
 perform 1 from public.weekly_source_groups g where g.id=any(groups_before) order by g.id for update nowait;
 perform 1 from public.weekly_source_group_rule_assignments a where a.source_group_id=any(groups_before) order by a.id for update nowait;
 perform 1 from public.weekly_source_group_clients m where m.client_id=any(clients) order by m.id for update nowait;
 perform 1 from public.weekly_source_client_policies cp where cp.client_id=any(clients) order by cp.id for update nowait;
 perform 1 from public.client_settings cs where cs.client_id=any(clients) order by cs.id for update nowait;
 select coalesce(array_agg(distinct m.source_group_id order by m.source_group_id),'{}'::uuid[]) into groups_after
 from public.weekly_source_group_clients m where m.client_id=any(clients);
 if groups_after is distinct from groups_before then
  raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';end if;
exception when lock_not_available then
 raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';
end;
$contract_fixed_locks$;
alter function private.weekly_source_contract_fixed_approval_locks_v1(uuid[]) owner to postgres;
revoke all on function private.weekly_source_contract_fixed_approval_locks_v1(uuid[]) from public,anon,authenticated,service_role;

create or replace function private.weekly_source_contract_fixed_approval_sync_v1(p_contract_id uuid,p_actor_user_id uuid)
returns public.contracts language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','extensions','pg_temp'
as $contract_fixed_sync$
declare contract public.contracts%rowtype;target_client uuid;before_policy jsonb;after_policy jsonb;scope record;authority jsonb;
 today date:=(transaction_timestamp() at time zone 'Europe/London')::date;
 v_environment text;fixed boolean:=false;group_id uuid;scope_date date;capture jsonb;response jsonb;receipt_key text;
begin
 perform private.weekly_source_query_require_service_v1();
 -- Permission remains with the actual native Contract/deletion/clone caller.
 -- This private helper derives a system key and records that caller's REAL actor.
 if not exists(select 1 from public.tms_users u where u.id=p_actor_user_id and u.is_active) then
  raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_ACTOR_REQUIRED' using errcode='42501';end if;
 select c.* into strict contract from public.contracts c where c.id=p_contract_id;
 target_client:=contract.client_id;
 perform private.weekly_source_contract_fixed_approval_locks_v1(array[target_client]);
 select s.candidate_app_environment into strict v_environment from public.settings_defaults s where s.id=1;
 -- The native configured predicate considers EVERY Contract for the Client.
 -- Inserting/changing one route can therefore apply/clear other raw keys.
 -- Refresh that same complete Client set, with one receipt per real change.
 for contract in select c.* from public.contracts c where c.client_id=target_client order by c.id for update nowait
 loop
 fixed:=false;group_id:=null;scope_date:=null;
 before_policy:=contract.candidate_manager_approval_policy_json;
 if before_policy is not null and jsonb_typeof(before_policy) is distinct from 'object' then
  raise exception 'CANDIDATE_MANAGER_CONTRACT_POLICY_FIELD_INVALID' using errcode='22023';end if;
 if contract.weekly_timesheet_source::text='HEALTHROSTER' and contract.end_date>=greatest(contract.start_date,today) then
  -- The raw Contract key represents an existing current/future preset.107 is
  -- still the sole dated Candidate consumer; this unversioned key NEVER grants
  -- approval for an earlier, later, DAILY, expense or combined workflow.
  for scope in
   with dates as (
    select greatest(contract.start_date,today) evaluation_date
    union select m.valid_from from public.weekly_source_group_clients m where m.client_id=contract.client_id
    union select m.valid_to+1 from public.weekly_source_group_clients m where m.client_id=contract.client_id and isfinite(m.valid_to)
    union select a.effective_from_week_ending-6 from public.weekly_source_group_rule_assignments a
     join public.weekly_source_group_clients m on m.source_group_id=a.source_group_id where m.client_id=contract.client_id
    union select a.effective_to_week_ending+1 from public.weekly_source_group_rule_assignments a
     join public.weekly_source_group_clients m on m.source_group_id=a.source_group_id where m.client_id=contract.client_id and isfinite(a.effective_to_week_ending)
    union select cp.effective_from from public.weekly_source_client_policies cp where cp.client_id=contract.client_id
    union select cp.effective_to+1 from public.weekly_source_client_policies cp where cp.client_id=contract.client_id and isfinite(cp.effective_to)
    union select cs.effective_from from public.client_settings cs where cs.client_id=contract.client_id and cs.effective_from is not null
    union select c.end_date+1 from public.contracts c where c.client_id=contract.client_id and isfinite(c.end_date)
   )
   select distinct g.id,g.agency_id,g.environment,greatest(d.evaluation_date,contract.start_date,today) evaluation_date
   from dates d join public.weekly_source_group_clients m on m.client_id=contract.client_id
    and greatest(d.evaluation_date,contract.start_date,today) between m.valid_from and coalesce(m.valid_to,'infinity'::date)
   join public.weekly_source_groups g on g.id=m.source_group_id and g.active and g.source_family='ROSTER' and g.environment=v_environment
   where greatest(d.evaluation_date,contract.start_date,today)<=contract.end_date order by evaluation_date,g.id
  loop
   if (select count(*) from public.weekly_source_group_clients m join public.weekly_source_groups g on g.id=m.source_group_id
     and g.active and g.source_family='ROSTER' and g.environment=v_environment where m.client_id=contract.client_id
      and scope.evaluation_date between m.valid_from and coalesce(m.valid_to,'infinity'::date))<>1 then
    raise exception 'WEEKLY_SOURCE_GROUP_CARDINALITY_INVALID' using errcode='55000';end if;
   authority:=private._contract_settings_effective_core_v1(contract.client_id,contract.id,scope.evaluation_date,'WEEKLY',null);
   if authority->>'configured_route'='HEALTHROSTER_WEEKLY_VALIDATION'
    and coalesce((authority#>>'{applicability,configuration_valid}')::boolean,false)
    and not coalesce((authority#>>'{applicability,import_authoritative}')::boolean,false)
    and private.weekly_source_configured_agency_invoice_v1(contract.client_id,scope.id,scope.agency_id,scope.environment,scope.evaluation_date) is true then
    fixed:=true;group_id:=scope.id;scope_date:=scope.evaluation_date;exit;
   end if;
  end loop;
 end if;
 after_policy:=case when fixed then coalesce(before_policy,'{}'::jsonb)||jsonb_build_object('approval','NOT_REQUIRED') else before_policy-'approval' end;
 if after_policy is not distinct from before_policy then continue;end if;
 capture:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_FIXED_APPROVAL_CHANGE_V1','contract_id',contract.id,
  'client_id',contract.client_id,'source_group_id',group_id,'effective_from',scope_date,'expected_contract_updated_at',contract.updated_at,
  'before_policy',before_policy,'after_policy',after_policy,'operation',case when fixed then 'APPLY' else 'CLEAR' end);
 capture:=capture||jsonb_build_object('input_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_FIXED_APPROVAL_CHANGE_V1',capture),'hex'));
 receipt_key:='SOURCE_AGENCY_FIXED:'||gen_random_uuid()::text;
 update public.contracts c set candidate_manager_approval_policy_json=after_policy,updated_at=transaction_timestamp()
  where c.id=contract.id returning c.* into contract;
 response:=public.contract_manager_authoriser_policy_get_v1(contract.id)||jsonb_build_object('system_fixed_approval',capture,'idempotent_replay',false);
 insert into public.candidate_manager_authoriser_policy_receipts(entity_kind,entity_id,idempotency_key,semantic_sha256,response_json,actor_user_id,recorded_at_utc)
 values('CONTRACT',contract.id,receipt_key,extensions.digest(convert_to(after_policy::text,'UTF8'),'sha256'),response,p_actor_user_id,transaction_timestamp());
 end loop;
 select c.* into strict contract from public.contracts c where c.id=p_contract_id and c.client_id=target_client;
 return contract;
exception when no_data_found or too_many_rows then
 raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_SCOPE_INVALID' using errcode='55000';
 when lock_not_available then
 raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';
end;
$contract_fixed_sync$;
alter function private.weekly_source_contract_fixed_approval_sync_v1(uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_contract_fixed_approval_sync_v1(uuid,uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 2: 41b9004e1290b6c5a46a92cb972427d3b31dfb4d:docs/healthroster-build/proposals/agency-prospective-contract-fixed-approval-native-forward-20261015/124_contract_write_with_native_fixed_approval.sqlinc
-- Source proposal: the actual existing Contract create/PATCH payloads remain
-- finite and admin-owned. System approval cannot be supplied in values.
create or replace function public.weekly_source_contract_write_atomic_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $contract_write$
declare actor uuid;mode text;values_json jsonb;contract_id uuid;expected timestamptz;
 before_row public.contracts%rowtype;after_row public.contracts%rowtype;source_row public.contracts%rowtype;
 old_client uuid;new_client uuid;old_client_contract uuid;source_id uuid;source_expected timestamptz;columns_sql text;expressions_sql text;changes_sql text;
 permitted constant text[]:=array[
 'candidate_id','client_id','role','band','display_site','ward_hint','start_date','end_date','pay_method_snapshot',
 'rates_json','std_hours_json','std_schedule_json','bucket_labels_json','additional_rates_json','default_submission_mode',
 'week_ending_weekday_snapshot','auto_invoice','require_reference_to_pay','require_reference_to_invoice','mileage_pay_rate','mileage_charge_rate',
 'overrideclientsettings','candidate_paper_submission_enabled_override','candidate_expenses_require_separate_timesheet_override',
 'candidate_expense_invoice_email_override','is_ad_hoc','is_nhsp','autoprocess_hr','requires_hr','no_timesheet_required',
 'weekly_timesheet_source','daily_calc_of_invoices','group_nightsat_sunbh','self_bill','hr_attach_to_invoice','ts_attach_to_invoice',
 'reference_number_required_to_issue_invoice','send_manual_invoices_to_different_email','manual_invoices_alt_email_address',
 'send_ts_queries_to_different_email','ts_queries_alt_email_address','timesheet_break_entry_mode','created_at','updated_at'];
begin
 perform private.weekly_source_query_require_service_v1();
 if jsonb_typeof(p_request) is distinct from 'object' or p_request-array['actor_user_id','mode','values','contract_id','expected_updated_at',
   'policy_source_contract_id','policy_source_expected_updated_at']<>'{}'::jsonb then
  raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_WRITE_INVALID' using errcode='22023';end if;
 actor:=(p_request->>'actor_user_id')::uuid;mode:=p_request->>'mode';values_json:=p_request->'values';
 perform private._weekly_source_settings_require_admin_v1(actor);
 if mode is null or mode not in('POST','PATCH') or jsonb_typeof(values_json) is distinct from 'object' or values_json='{}'::jsonb
  or octet_length(values_json::text)>262144 or exists(select 1 from jsonb_object_keys(values_json) key where not(key=any(permitted))) then
  raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_WRITE_INVALID' using errcode='22023';end if;
 if mode='PATCH' then
  contract_id:=(p_request->>'contract_id')::uuid;expected:=(p_request->>'expected_updated_at')::timestamptz;
  if contract_id is null or expected is null or values_json ? 'created_at' or p_request ? 'policy_source_contract_id'
    or p_request ? 'policy_source_expected_updated_at' then
   raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_WRITE_INVALID' using errcode='22023';end if;
  select c.* into strict before_row from public.contracts c where c.id=contract_id;
  old_client:=before_row.client_id;new_client:=case when values_json ? 'client_id' then (values_json->>'client_id')::uuid else old_client end;
 else
  if p_request ? 'contract_id' or p_request ? 'expected_updated_at' then
   raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_WRITE_INVALID' using errcode='22023';end if;
  new_client:=(values_json->>'client_id')::uuid;old_client:=new_client;
 end if;
 perform private.weekly_source_contract_fixed_approval_locks_v1(array[old_client,new_client]);
 if mode='PATCH' then
  select c.* into strict before_row from public.contracts c where c.id=contract_id for update nowait;
  if before_row.client_id is distinct from old_client or before_row.updated_at is distinct from expected then
   raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';end if;
 else
  source_id:=(p_request->>'policy_source_contract_id')::uuid;
  source_expected:=(p_request->>'policy_source_expected_updated_at')::timestamptz;
  if (source_id is null)<>(source_expected is null) then
   raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_WRITE_INVALID' using errcode='22023';end if;
  if source_id is not null then
   select c.* into strict source_row from public.contracts c where c.id=source_id for share nowait;
   if source_row.client_id is distinct from new_client or source_row.updated_at is distinct from source_expected then
    raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';end if;
   -- Copy ordinary manager-policy bytes from the ACTUAL source Contract;
   -- the next native sync rederives only the fixed key for the new scope.
   values_json:=values_json||jsonb_build_object('candidate_manager_approval_policy_json',source_row.candidate_manager_approval_policy_json);
  end if;
 end if;
 -- Identifiers come exclusively from the finite list above or the one native
 -- copy field. JSON values remain bound parameters; no caller SQL is accepted.
 select string_agg(format('%I',key),',' order by key),
  string_agg(format('incoming.%I',key),',' order by key),
  string_agg(format('%I=incoming.%I',key,key),',' order by key)
 into columns_sql,expressions_sql,changes_sql from jsonb_object_keys(values_json) key;
 if mode='POST' then
  execute format('insert into public.contracts as target(%s) select %s from jsonb_populate_record(null::public.contracts,$1) incoming returning target.*',columns_sql,expressions_sql)
   into strict after_row using values_json;
 else
  execute format('update public.contracts as target set %s from jsonb_populate_record(null::public.contracts,$1) incoming where target.id=$2 and target.updated_at is not distinct from $3 returning target.*',changes_sql)
   into strict after_row using values_json,contract_id,expected;
 end if;
 after_row:=private.weekly_source_contract_fixed_approval_sync_v1(after_row.id,actor);
 if old_client is distinct from new_client then
  select c.id into old_client_contract from public.contracts c where c.client_id=old_client order by c.id limit 1;
  if old_client_contract is not null then perform private.weekly_source_contract_fixed_approval_sync_v1(old_client_contract,actor);end if;
 end if;
 return to_jsonb(after_row);
exception when no_data_found or too_many_rows then
 raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';
 when lock_not_available then
 raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_CONTEXT_STALE' using errcode='40001';
 when invalid_text_representation or invalid_datetime_format or datetime_field_overflow then
 raise exception 'CANDIDATE_FIXED_APPROVAL_CONTRACT_WRITE_INVALID' using errcode='22023';
end;
$contract_write$;
alter function public.weekly_source_contract_write_atomic_v1(jsonb) owner to postgres;
revoke all on function public.weekly_source_contract_write_atomic_v1(jsonb) from public,anon,authenticated,service_role;
grant execute on function public.weekly_source_contract_write_atomic_v1(jsonb) to service_role;


-- Exact selected runtime component 3: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/01_06_agency_immutable_submitted_claim.sqlinc
-- Read only. Reuse the actual submission owner's complete native proof before
-- exposing the immutable worker schedule to private Agency consumers. This is
-- neither the edited current T0 schedule nor a financial target/capability.
create or replace function private.weekly_source_agency_submitted_claim_v1(
  p_timesheet_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  v_submission jsonb; v_workflow public.candidate_submission_workflows%rowtype;
  v_input jsonb; v_patch jsonb; v_schedule jsonb; v_receipt jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  v_submission:=private.weekly_source_actual_timesheet_submission_v1(p_timesheet_id);
  if v_submission->>'actual_submitted' is distinct from 'true'
    or v_submission->>'support_state' is distinct from 'PROVED'
    or v_submission->>'sheet_scope' is distinct from 'WEEKLY' then
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
      'available',false,'reason','ACTUAL_WEEKLY_SUBMISSION_UNPROVED','claim',null);
  end if;
  if v_submission->>'authority' is distinct from 'CANDIDATE_IMMUTABLE_HOURS' then
    -- The existing legacy reader proves a current source and official document;
    -- it does not expose a frozen original hours vector after a native T0 edit.
    -- Keep that missing producer explicit instead of reading mutable T0 hours.
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
      'available',false,'reason','LEGACY_FROZEN_HOURS_CLAIM_UNAVAILABLE','claim',null);
  end if;
  if not pg_input_is_valid(coalesce(v_submission->>'workflow_id',''),'uuid')
    or not pg_input_is_valid(coalesce(v_submission->>'workflow_generation',''),'integer') then
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
      'available',false,'reason','IMMUTABLE_WORKFLOW_IDENTITY_UNPROVED','claim',null);
  end if;
  select * into v_workflow from public.candidate_submission_workflows
    where id=(v_submission->>'workflow_id')::uuid
      and generation=(v_submission->>'workflow_generation')::integer
      and target_timesheet_id=p_timesheet_id
      and candidate_id=(v_submission->>'candidate_id')::uuid
      and contract_id=(v_submission->>'contract_id')::uuid
      and week_ending_date=(v_submission->>'week_ending_date')::date
      and scope='WEEKLY' and workflow_kind in('CONTRACT_HOURS','CONTRACT_COMBINED')
      and worker_submitted_at_utc is not null and cancelled_at_utc is null;
  if v_workflow.id is null or jsonb_typeof(v_workflow.immutable_submission_json) is distinct from 'object'
    or octet_length(v_workflow.immutable_submission_sha256) is distinct from 32
    or private._candidate_sha256_jsonb_v1(v_workflow.immutable_submission_json)
      is distinct from v_workflow.immutable_submission_sha256
    or encode(v_workflow.immutable_submission_sha256,'hex') is distinct from v_submission->>'submission_sha256'
    or v_workflow.candidate_signed_at_utc is null then
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
      'available',false,'reason','IMMUTABLE_SUBMISSION_CHANGED_OR_UNPROVED','claim',null);
  end if;
  v_input:=coalesce(v_workflow.immutable_submission_json->'hours_submission',v_workflow.immutable_submission_json);
  v_patch:=coalesce(v_input->'timesheet_patch_json',v_input);
  v_schedule:=coalesce(v_patch->'actual_schedule_json',v_input#>'{canonical_tsfin_snapshot,actual_schedule_json}');
  if jsonb_typeof(v_input) is distinct from 'object' or jsonb_typeof(v_patch) is distinct from 'object'
    or jsonb_typeof(v_schedule) is distinct from 'array'
    or jsonb_array_length(v_schedule)>100 or octet_length(v_schedule::text)>65536
    or exists(select 1 from jsonb_array_elements(v_schedule) entry where jsonb_typeof(entry) is distinct from 'object') then
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
      'available',false,'reason','FROZEN_WORKER_HOURS_CLAIM_BOUND_OR_SHAPE_INVALID','claim',null);
  end if;
  -- The original vector is preserved verbatim. Canonical date/break conversion
  -- and work_event membership remain the actual native producer's duties.
  v_receipt:=jsonb_build_object('authority','CANDIDATE_IMMUTABLE_HOURS',
    'timesheet_id',p_timesheet_id,'timesheet_version',v_submission->'timesheet_version',
    'candidate_id',v_submission->'candidate_id','client_id',v_submission->'client_id',
    'contract_id',v_submission->'contract_id','week_ending_date',v_submission->'week_ending_date',
    'workflow_id',v_workflow.id,'workflow_generation',v_workflow.generation,
    'submission_sha256',encode(v_workflow.immutable_submission_sha256,'hex'),
    'hours_component_id',v_submission->'hours_component_id',
    'candidate_signature_component_id',v_submission->'candidate_signature_component_id',
    'submitted_at_utc',v_workflow.worker_submitted_at_utc,'signed_at_utc',v_workflow.candidate_signed_at_utc,
    'actual_schedule_json',v_schedule);
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',
    'available',true,'reason',null,'claim',v_receipt,
    'claim_sha256',encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_SUBMITTED_CLAIM_V1',v_receipt),'hex'));
end;
$function$;
alter function private.weekly_source_agency_submitted_claim_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_submitted_claim_v1(uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 4: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/02_20_agency_native_pay_scope.sqlinc
-- Owner-private input seam for Agency's actual native ORDINARY grain.
-- This returns scope/approval/history inputs, never a paid/withheld quantity,
-- monetary permission, Source namespace or caller-selected financial subject.
create or replace function private.weekly_source_agency_native_pay_scope_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 req private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
 work private.bpay_next_work%rowtype; revision private.bpay_next_work_revision%rowtype;
 members uuid[]; module_owner text; module_epoch bigint; work_value jsonb; revision_value jsonb;
 legacy jsonb; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict req from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 req:=private.weekly_source_agency_change_request_assert_v1(req.contract_week_id,req.reason,
   req.initial_row_signature,req.request_key,req.updated_by_user_id);
 if req.state<>'ACTIVE' then raise exception 'AGENCY_CHANGE_CURRENT_REQUEST_UNAVAILABLE' using errcode='55000'; end if;
 select * into strict t from public.timesheets where timesheet_id=req.current_timesheet_id;
 select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
 select array_agg(distinct family.family_timesheet_id order by family.family_timesheet_id) into members
 from public._pay_timesheet_rotation_scope(array[t.timesheet_id]) family;
 if members is null or cardinality(members) not between 1 and 256 or not t.timesheet_id=any(members)
  or f.id is distinct from req.current_financial_id or f.timesheet_version is distinct from t.version then
  raise exception 'AGENCY_CHANGE_NATIVE_PAY_FAMILY_SCOPE_CHANGED' using errcode='40001'; end if;
 select m.active_owner,m.owner_epoch into strict module_owner,module_epoch
 from private.bpay_next_module_control m where m.id=1;
 if module_owner is null or module_owner not in('LEGACY','NEXT') or module_epoch is null
  or module_epoch<0 or(module_owner='NEXT' and module_epoch=0) then
  raise exception 'AGENCY_CHANGE_NATIVE_PAY_MODULE_UNAVAILABLE' using errcode='55000'; end if;
 if module_owner='LEGACY' then
  -- Its exact certified grain is family/shift HOURS. It supplies no general
  -- cash/reservation/final-transfer authority and cannot permit a paid writer.
  legacy:=private.weekly_source_settlement_allocation_v1(t.timesheet_id);
 else
  select w.* into work from private.bpay_next_work w where w.booking_id=t.booking_id;
  if found then
   if work.work_kind is distinct from 'ORDINARY' or work.origin_kind is distinct from 'CONTRACT'
    or work.candidate_id is distinct from req.candidate_id or work.contract_id is distinct from req.contract_id
    or work.week_ending_date is distinct from req.week_ending_date
    or work.original_timesheet_id is null or not work.original_timesheet_id=any(members) then
    raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_WORK_SCOPE_CONFLICT' using errcode='55000'; end if;
   work_value:=jsonb_build_object('work_id',work.id,'work_kind',work.work_kind,'origin_kind',work.origin_kind,
    'original_timesheet_id',work.original_timesheet_id,'booking_id',work.booking_id,
    'candidate_id',work.candidate_id,'contract_id',work.contract_id,'week_ending_date',work.week_ending_date,
    'current_revision_id',work.current_revision_id,'applied_revision_id',work.applied_revision_id,
    'current_revision_no',work.current_revision_no);
   if coalesce(work.current_revision_id,work.applied_revision_id) is not null then
    select v.* into strict revision from private.bpay_next_work_revision v
     where v.id=coalesce(work.current_revision_id,work.applied_revision_id) and v.work_id=work.id;
    if revision.source_kind is distinct from 'ORDINARY'
     or revision.physical_timesheet_id is null or not revision.physical_timesheet_id=any(members)
     or revision.week_ending_date is distinct from req.week_ending_date then
     raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_REVISION_SCOPE_CONFLICT' using errcode='55000'; end if;
    revision_value:=jsonb_build_object('revision_id',revision.id,'work_id',revision.work_id,
     'source_kind',revision.source_kind,'revision_no',revision.revision_no,
     'physical_timesheet_id',revision.physical_timesheet_id,'physical_timesheet_version',revision.physical_timesheet_version,
     'financial_snapshot_id',revision.financial_snapshot_id,'detail_kind',revision.detail_kind,
     'source_pay_channel',revision.source_pay_channel,'expected_line_count',revision.expected_line_count,
     'certified_zero',revision.certified_zero,'approved_source_ex_vat',revision.approved_source_ex_vat,
     'sealed_at_utc',revision.sealed_at_utc);
   end if;
  end if;
 end if;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_PAY_SCOPE_V1',
  'request_id',req.id,'request_sha256',encode(req.request_sha256,'hex'),'phase_actor_user_id',req.updated_by_user_id,
  'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'contract_week_id',req.contract_week_id,
  'contract_id',req.contract_id,'candidate_id',req.candidate_id,'client_id',req.client_id,'week_ending_date',req.week_ending_date,
  'family_member_ids',to_jsonb(members),'active_owner',module_owner,'owner_epoch',module_epoch,
  'current_financial_id',f.id,'current_financial_paid_marker',f.paid_at_utc,
  'original_captured_financial_id',req.native_receipts#>'{original_capture,current_financial_id}',
  'ordinary_work',work_value,'ordinary_revision',revision_value,'legacy_family_hours',legacy);
 if octet_length(result::text)>262144 then raise exception 'AGENCY_CHANGE_NATIVE_PAY_SCOPE_BOUND_EXCEEDED' using errcode='54000'; end if;
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_PAY_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_native_pay_scope_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_native_pay_scope_v1(uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 5: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/03_21_agency_legacy_original_document.sqlinc
-- Read-only original-document VIEW witness. It is deliberately not the
-- worker's immutable submitted-hours claim. It grants no paid writer, amount,
-- authorisation, source membership or protection capability. Current capture
-- uses the actual submission reader and the actual native snapshot assembler.
-- Historical reads use ONLY the document captured by the planned request.
create or replace function private.weekly_source_agency_legacy_original_document_v1(
 p_timesheet_id uuid,p_request_id uuid,p_actual_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','extensions','pg_temp'
as $function$
declare
 t public.timesheets%rowtype; c public.contracts%rowtype;
 d public.invoice_document_versions%rowtype;
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 capture jsonb; stored jsonb; witness jsonb; submission jsonb; model jsonb;
 actual_snapshot record; doc_id uuid; days jsonb; shifts jsonb; signing jsonb;
 source_fingerprint text; receipt jsonb; count_rows bigint;
 snapshot_keys constant text[]:=array['snapshot_schema_version','request_key','presentation_model',
  'presentation_model_hash','timesheet_sources','supporting_sources','supporting_manifest','higher_rate_support'];
 signing_keys constant text[]:=array['submission_mode','r2_nurse_key','r2_auth_key','img_sha256_nurse',
  'img_sha256_auth','auth_name','auth_job_title','authorised_at_server','qr_status','qr_scanned_at',
  'qr_signed_hash','qr_signed_at_utc','manual_pdf_r2_key','manual_document_asset_id'];
begin
 perform private.weekly_source_query_require_service_v1();
 if private.weekly_source_pay_actor_allowed_v1(p_actual_actor_user_id) is distinct from true then
  raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict c from public.contracts where id=t.contract_id;
 if t.is_current is distinct from true or t.archived_at_utc is not null
  or t.sheet_scope::text is distinct from 'WEEKLY' or t.line_type::text is distinct from 'HOURS'
  or t.week_ending_date is null or c.candidate_id is null or c.client_id is null then
  raise exception 'AGENCY_LEGACY_ORIGINAL_SCOPE_CHANGED' using errcode='40001'; end if;
 if p_request_id is null then
  if t.revoked_at is not null then
   raise exception 'AGENCY_LEGACY_ORIGINAL_CURRENT_SUBMISSION_REQUIRED' using errcode='40001'; end if;
  submission:=private.weekly_source_actual_timesheet_submission_v1(t.timesheet_id);
  if submission->>'actual_submitted' is distinct from 'true'
   or submission->>'support_state' is distinct from 'PROVED'
   or submission->>'authority' is distinct from 'VERIFIED_LEGACY_SOURCE_DOCUMENT'
   or submission->>'timesheet_id' is distinct from t.timesheet_id::text
   or submission->>'timesheet_version' is distinct from t.version::text
   or submission->>'candidate_id' is distinct from c.candidate_id::text
   or submission->>'client_id' is distinct from c.client_id::text
   or submission->>'contract_id' is distinct from c.id::text
   or submission->>'week_ending_date' is distinct from t.week_ending_date::text
   or not pg_input_is_valid(coalesce(submission->>'document_version_id',''),'uuid') then
   return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_LEGACY_ORIGINAL_DOCUMENT_VIEW_V1',
    'available',false,'reason','GENUINE_LEGACY_SUBMISSION_UNPROVED','document_view',null,'worker_claim_proved',null);
  end if;
  doc_id:=(submission->>'document_version_id')::uuid;
  source_fingerprint:=submission->>'source_evidence_fingerprint';
  if source_fingerprint is null or source_fingerprint!~'^[0-9a-f]{64}$'
   or doc_id is distinct from t.current_document_version_id then
   raise exception 'AGENCY_LEGACY_ORIGINAL_DOCUMENT_CHANGED' using errcode='40001'; end if;
 else
  select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
  capture:=r.native_receipts->'original_capture';stored:=capture->'original_legacy_document';
  if private.weekly_source_agency_change_request_sha256_v1(r.contract_week_id,r.reason,r.initial_row_signature,
   r.request_key,r.actor_user_id,capture) is distinct from r.request_sha256
   or r.initial_timesheet_id is distinct from t.timesheet_id or r.current_timesheet_id is distinct from t.timesheet_id
   or r.initial_timesheet_version is distinct from t.version or r.current_timesheet_version is distinct from t.version
   or r.candidate_id is distinct from c.candidate_id or r.client_id is distinct from c.client_id
   or r.contract_id is distinct from c.id or r.week_ending_date is distinct from t.week_ending_date
   or stored->>'document_state' is distinct from 'FROZEN_DOCUMENT_VIEW'
   or stored->>'available' is distinct from 'true' or jsonb_typeof(stored->'document_witness') is distinct from 'object' then
   raise exception 'AGENCY_LEGACY_ORIGINAL_CAPTURE_INVALID' using errcode='55000'; end if;
  -- Read permission belongs to the real current reader, not the original
  -- creator or a former phase actor. A read never impersonates either actor.
  perform private.weekly_source_office_authority_v1(p_actual_actor_user_id,'VIEW_PAY_WORK',
   r.source_group_id,r.client_id,r.week_ending_date);
  witness:=stored->'document_witness';
  if witness->>'authority' is distinct from 'VERIFIED_LEGACY_FROZEN_TIMESHEET_DOCUMENT'
   or not pg_input_is_valid(coalesce(witness->>'document_version_id',''),'uuid') then
   raise exception 'AGENCY_LEGACY_ORIGINAL_CAPTURE_INVALID' using errcode='55000'; end if;
  doc_id:=(witness->>'document_version_id')::uuid;
  source_fingerprint:=witness->>'source_evidence_fingerprint';
  -- Generic unauthorise may clear its authorisation clock. It is allowed only
  -- through this request's actual recorded native unauthorise result; every
  -- signature/QR/asset identity remains the originally captured value.
  if t.revoked_at is not null and coalesce((t.revoked_reason='TIMESHEET_UNAUTHORISE'
   and t.revoked_by=r.native_receipts#>>'{unauthorise,phase_actor_user_id}'
   and r.native_receipts#>>'{unauthorise,result,timesheet_id}'=t.timesheet_id::text
   and r.native_receipts#>>'{unauthorise,result,ok}'='true'
   and r.phase in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT')),false) is distinct from true then
   raise exception 'AGENCY_LEGACY_ORIGINAL_SCOPE_CHANGED' using errcode='40001'; end if;
 end if;
 select * into strict d from public.invoice_document_versions where id=doc_id;
 if d.entity_type is distinct from 'TIMESHEET' or d.entity_id is distinct from t.timesheet_id
  or d.purpose is distinct from 'TIMESHEET' or d.template_version is distinct from 'timesheet-professional-v2'
  or d.status not in('READY','SUPERSEDED') or d.ready_at_utc is null or d.verified_at_utc is null
  or nullif(btrim(d.r2_key),'') is null or coalesce(d.sha256,'')!~'^[0-9a-f]{64}$'
  or d.size_bytes is null or d.size_bytes<=0 or d.page_count is null or d.page_count<=0
  or jsonb_typeof(d.snapshot_json) is distinct from 'object' or octet_length(d.snapshot_json::text)>1048576
  or not(d.snapshot_json ?& snapshot_keys) or d.snapshot_json-snapshot_keys<>'{}'::jsonb
  or d.snapshot_json->>'snapshot_schema_version' is distinct from 'TIMESHEET_PRESENTATION_SNAPSHOT_V5'
  or encode(extensions.digest(convert_to(d.snapshot_json::text,'UTF8'),'sha256'),'hex') is distinct from d.snapshot_hash then
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_LEGACY_ORIGINAL_DOCUMENT_VIEW_V1',
   'available',false,'reason','FROZEN_LEGACY_DOCUMENT_ORIGINAL_UNAVAILABLE','document_view',null,'worker_claim_proved',null);
 end if;
 model:=d.snapshot_json->'presentation_model';
 if jsonb_typeof(model) is distinct from 'object'
  or model->>'schema_version' is distinct from 'TIMESHEET_RENDER_MODEL_V2'
  or model->>'timesheet_id' is distinct from t.timesheet_id::text
  or model->>'sheet_scope' is distinct from 'WEEKLY'
  or model->>'document_revision' is distinct from d.source_revision
  or model#>>'{week_period,start_date}' is distinct from (t.week_ending_date-6)::text
  or model#>>'{week_period,end_date}' is distinct from t.week_ending_date::text
  or encode(extensions.digest(convert_to(model::text,'UTF8'),'sha256'),'hex')
   is distinct from d.snapshot_json->>'presentation_model_hash' then
  raise exception 'AGENCY_LEGACY_ORIGINAL_MODEL_CHANGED' using errcode='55000'; end if;
 days:=model#>'{week_period,days}';
 if jsonb_typeof(days) is distinct from 'array' or jsonb_array_length(days)<>7
  or exists(select 1 from jsonb_array_elements(days) with ordinality day(value,ordinality)
   where jsonb_typeof(value) is distinct from 'object' or value->>'date' is distinct from
    (t.week_ending_date-7+ordinality::integer)::text or jsonb_typeof(value->'shift_lines') is distinct from 'array') then
  raise exception 'AGENCY_LEGACY_ORIGINAL_WEEK_VECTOR_INVALID' using errcode='55000'; end if;
 select count(*),coalesce(jsonb_agg(shift.value order by day.ordinality,shift.ordinality),'[]'::jsonb)
  into count_rows,shifts from jsonb_array_elements(days) with ordinality day(value,ordinality)
  cross join lateral jsonb_array_elements(day.value->'shift_lines') with ordinality shift(value,ordinality);
 if count_rows not between 1 and 100 or octet_length(shifts::text)>65536
  or exists(select 1 from jsonb_array_elements(days) day cross join lateral jsonb_array_elements(day->'shift_lines') shift
   where jsonb_typeof(shift) is distinct from 'object' or shift->>'date' is distinct from day->>'date'
    or nullif(shift->>'row_key','') is null or nullif(shift->>'segment_id','') is null
    or coalesce(shift->>'display_start_local','')!~'^(?:[01][0-9]|2[0-3]):[0-5][0-9]$'
    or coalesce(shift->>'display_end_local','')!~'^(?:[01][0-9]|2[0-3]):[0-5][0-9]$')
  or (select count(distinct value->>'row_key') from jsonb_array_elements(shifts))<>count_rows then
  raise exception 'AGENCY_LEGACY_ORIGINAL_SHIFT_VECTOR_INVALID' using errcode='55000'; end if;
 signing:=(select jsonb_object_agg(key,value) from jsonb_each(to_jsonb(t)) where key=any(signing_keys));
 if p_request_id is null then
  if d.status is distinct from 'READY' or d.superseded_at_utc is not null
   or d.source_revision is distinct from t.document_revision::text then
   raise exception 'AGENCY_LEGACY_ORIGINAL_CURRENT_DOCUMENT_REQUIRED' using errcode='40001'; end if;
  -- Literal actual owner and native arguments. This is not a mapper callback,
  -- schema equality assertion, current T0 fallback or caller-normalised vector.
  select * into strict actual_snapshot from private._invoice_presentation_snapshot_batch(jsonb_build_array(
   jsonb_build_object('request_key',d.snapshot_json->>'request_key','entity_type','TIMESHEET',
    'entity_id',t.timesheet_id,'purpose','TIMESHEET','template_version',d.template_version)),transaction_timestamp());
  if actual_snapshot.valid is distinct from true or actual_snapshot.snapshot_json is distinct from d.snapshot_json
   or actual_snapshot.snapshot_hash is distinct from d.snapshot_hash
   or actual_snapshot.presentation_model is distinct from model then
   raise exception 'AGENCY_LEGACY_ORIGINAL_NATIVE_DOCUMENT_SOURCE_CHANGED' using errcode='40001'; end if;
  receipt:=jsonb_build_object('authority','VERIFIED_LEGACY_FROZEN_TIMESHEET_DOCUMENT','timesheet_id',t.timesheet_id,
   'timesheet_version',t.version,'candidate_id',c.candidate_id,'client_id',c.client_id,'contract_id',c.id,
   'week_ending_date',t.week_ending_date,'document_version_id',d.id,'document_source_revision',d.source_revision,
   'document_template_version',d.template_version,'document_snapshot_sha256',d.snapshot_hash,
   'presentation_model_sha256',d.snapshot_json->'presentation_model_hash','document_sha256',d.sha256,
   'document_size_bytes',d.size_bytes,'document_page_count',d.page_count,'document_r2_key',d.r2_key,
   'ready_at_utc',d.ready_at_utc,'verified_at_utc',d.verified_at_utc,
   'source_evidence_fingerprint',source_fingerprint,'signing_basis',signing,'original_shift_lines',shifts);
 else
  if witness->>'document_source_revision' is distinct from d.source_revision
   or witness->>'document_template_version' is distinct from d.template_version
   or witness->>'document_snapshot_sha256' is distinct from d.snapshot_hash
   or witness->'presentation_model_sha256' is distinct from d.snapshot_json->'presentation_model_hash'
   or witness->>'document_sha256' is distinct from d.sha256
   or witness->>'document_size_bytes' is distinct from d.size_bytes::text
   or witness->>'document_page_count' is distinct from d.page_count::text
   or witness->>'document_r2_key' is distinct from d.r2_key
   or (witness->>'ready_at_utc')::timestamptz is distinct from d.ready_at_utc
   or (witness->>'verified_at_utc')::timestamptz is distinct from d.verified_at_utc
   or (signing-array['authorised_at_server','qr_scanned_at','qr_signed_at_utc']) is distinct from
    ((witness->'signing_basis')-array['authorised_at_server','qr_scanned_at','qr_signed_at_utc'])
   or (witness#>>'{signing_basis,qr_scanned_at}')::timestamptz is distinct from t.qr_scanned_at
   or (witness#>>'{signing_basis,qr_signed_at_utc}')::timestamptz is distinct from t.qr_signed_at_utc
   or (t.authorised_at_server is null and witness#>>'{signing_basis,authorised_at_server}' is not null
    and coalesce(r.native_receipts#>>'{unauthorise,result,ok}'='true',false) is distinct from true)
   or (t.authorised_at_server is not null and t.authorised_at_server is distinct from
    (witness#>>'{signing_basis,authorised_at_server}')::timestamptz) then
   raise exception 'AGENCY_LEGACY_ORIGINAL_CAPTURED_DOCUMENT_CHANGED' using errcode='40001'; end if;
  -- Retain captured timestamp bytes. Actual instants were checked above, so
  -- another session TimeZone cannot manufacture a different original hash.
  receipt:=witness||jsonb_build_object('original_shift_lines',shifts);
  if encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_AGENCY_LEGACY_ORIGINAL_DOCUMENT_VIEW_V1',receipt),'hex')
   is distinct from stored->>'document_view_sha256' then
   raise exception 'AGENCY_LEGACY_ORIGINAL_CAPTURED_VECTOR_CHANGED' using errcode='40001'; end if;
 end if;
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_LEGACY_ORIGINAL_DOCUMENT_VIEW_V1','available',true,
  'reason',null,'document_view',receipt,'document_view_sha256',encode(private.weekly_source_sha256_jsonb_v1(
   'WEEKLY_SOURCE_AGENCY_LEGACY_ORIGINAL_DOCUMENT_VIEW_V1',receipt),'hex'),'worker_claim_proved',null);
exception when no_data_found or too_many_rows or invalid_text_representation
 or invalid_datetime_format or datetime_field_overflow then
 raise exception 'AGENCY_LEGACY_ORIGINAL_DOCUMENT_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_legacy_original_document_v1(uuid,uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_legacy_original_document_v1(uuid,uuid,uuid)
 from public,anon,authenticated,service_role;


-- Exact selected runtime component 6: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/04_28_agency_original_pay_identity.sqlinc
-- Read-only identity/preservation witness for the single planned T0 change.
-- Amounts remain in the native ledgers. No payment, collection or hours maths.
create or replace function private.weekly_source_agency_original_pay_identity_v1(
 p_timesheet_id uuid,p_actor_user_id uuid,p_original_financial_id uuid,p_request_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 scope jsonb; t public.timesheets%rowtype; original public.timesheets_financials%rowtype;
 v_work_id uuid; line_ids uuid[]; effect_ids uuid[]; transfer_ids uuid[];
 lines jsonb; effects jsonb; transfers jsonb; reservations jsonb:='[]'::jsonb;
 transfer private.bpay_next_transfer%rowtype; reservation jsonb; result jsonb;
 financial_identity jsonb; signed_identity jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if p_request_id is null then
  scope:=private.weekly_source_agency_physical_pay_inputs_v1(p_timesheet_id,p_actor_user_id);
 else
  scope:=private.weekly_source_agency_native_pay_scope_v1(p_request_id);
  if scope->>'phase_actor_user_id' is distinct from p_actor_user_id::text then
   raise exception 'AGENCY_CHANGE_PAY_PHASE_ACTOR_CHANGED' using errcode='42501'; end if;
 end if;
 if scope->>'timesheet_id' is distinct from p_timesheet_id::text then
  raise exception 'AGENCY_CHANGE_PAY_PHYSICAL_TARGET_CHANGED' using errcode='40001'; end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict original from public.timesheets_financials where id=p_original_financial_id
  and timesheet_id=p_timesheet_id and timesheet_version=t.version
  and candidate_id=(scope->>'candidate_id')::uuid and client_id=(scope->>'client_id')::uuid for update;
 -- These are the exact lifecycle/placement fields changed by unchanged UNA,
 -- REMOVE and current-row retirement. All economic fields and the paid marker
 -- remain in the hash; no authorised/processing label certifies a money amount.
 financial_identity:=to_jsonb(original)-array[
  'is_current','updated_at','processing_status','authorised_by_user_id','authorised_at_utc','locked_by_invoice_id','locked_at_utc'];
 if jsonb_typeof(original.invoice_breakdown_json->'segments')='array' then
  financial_identity:=jsonb_set(financial_identity,'{invoice_breakdown_json,segments}',
   coalesce((select jsonb_agg(segment.value-'invoice_locked_invoice_id' order by segment.ordinality)
    from jsonb_array_elements(original.invoice_breakdown_json->'segments') with ordinality segment(value,ordinality)),'[]'::jsonb),false);
 end if;
 signed_identity:=to_jsonb(t)-array[
  'actual_schedule_json','updated_at','authorised_at_server','revoked_at','revoked_reason','revoked_by'];
 -- Type-directed timestamp instants, from these two literal native relations,
 -- preserve hashes across sessions without changing a GUC or timestamp value.
 select jsonb_object_agg(value.key,case when column_type.atttypid='pg_catalog.timestamptz'::regtype
   and value.value<>'null'::jsonb then to_jsonb(extract(epoch from(value.value#>>'{}')::timestamptz))
   else value.value end) into financial_identity from jsonb_each(financial_identity) value
  join pg_attribute column_type on column_type.attrelid='public.timesheets_financials'::regclass
   and column_type.attname=value.key and column_type.attnum>0 and not column_type.attisdropped;
 select jsonb_object_agg(value.key,case when column_type.atttypid='pg_catalog.timestamptz'::regtype
   and value.value<>'null'::jsonb then to_jsonb(extract(epoch from(value.value#>>'{}')::timestamptz))
   else value.value end) into signed_identity from jsonb_each(signed_identity) value
  join pg_attribute column_type on column_type.attrelid='public.timesheets'::regclass
   and column_type.attname=value.key and column_type.attnum>0 and not column_type.attisdropped;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORIGINAL_PAY_IDENTITY_V1',
  'timesheet_id',t.timesheet_id,'timesheet_version',t.version,'original_financial_id',original.id,
  'original_financial_identity_sha256',encode(private.weekly_source_sha256_jsonb_v1(
   'WEEKLY_SOURCE_AGENCY_ORIGINAL_FINANCIAL_IDENTITY_V1',financial_identity),'hex'),
  'original_paid_marker',original.paid_at_utc,
  'signed_timesheet_identity_sha256',encode(private.weekly_source_sha256_jsonb_v1(
   'WEEKLY_SOURCE_AGENCY_SIGNED_TIMESHEET_IDENTITY_V1',signed_identity),'hex'),
  'active_owner',scope->'active_owner','owner_epoch',scope->'owner_epoch',
  'ordinary_work_id',scope#>'{ordinary_work,work_id}',
  'original_run_line_ids',null,'original_run_lines_sha256',null,
  'original_effect_ids',null,'original_effects_sha256',null,
  'original_transfer_ids',null,'original_transfers_sha256',null,'native_original_reservations',null);
 if scope->>'active_owner'='NEXT' then
  -- Existing native Candidate financial fence owns its real module SHARE /
  -- worker-control UPDATE and active NET refusal. No invented job or lease.
  perform private.bpay_next_assert_candidate_financial_fence_v1(
   (scope->>'candidate_id')::uuid,null::uuid,null::uuid,null::bigint);
  v_work_id:=(scope#>>'{ordinary_work,work_id}')::uuid;
  if v_work_id is null then
   if original.paid_at_utc is not null then
    raise exception 'AGENCY_CHANGE_PAID_ORDINARY_WORK_UNBOUND' using errcode='55000'; end if;
  else
   select coalesce(array_agg(l.id order by l.id),'{}'::uuid[]),
    coalesce(jsonb_agg(to_jsonb(l) order by l.id),'[]'::jsonb) into line_ids,lines
    from private.bpay_next_run_line l where l.work_id=v_work_id;
   select coalesce(array_agg(e.id order by e.id),'{}'::uuid[]),
    coalesce(jsonb_agg((to_jsonb(e)-'occurred_at_utc')||jsonb_build_object(
     'occurred_at_epoch',extract(epoch from e.occurred_at_utc)) order by e.id),'[]'::jsonb) into effect_ids,effects
    from private.bpay_next_financial_effect e where e.work_id=v_work_id;
   select coalesce(array_agg(distinct native.id order by native.id),'{}'::uuid[]) into transfer_ids from(
    select tr.id from private.bpay_next_transfer tr join private.bpay_next_transfer_member member
     on member.transfer_id=tr.id and member.run_line_id=any(line_ids)
     where tr.candidate_id=(scope->>'candidate_id')::uuid and tr.original_transfer_id is null
    union select tr.id from private.bpay_next_transfer tr join private.bpay_next_financial_effect effect
     on effect.original_transfer_id=tr.id and effect.id=any(effect_ids)
     where tr.candidate_id=(scope->>'candidate_id')::uuid and tr.original_transfer_id is null
   ) native;
   if cardinality(line_ids)>100 or cardinality(effect_ids)>100 or cardinality(transfer_ids)>100
    or octet_length(lines::text)>262144 or octet_length(effects::text)>262144 then
    raise exception 'AGENCY_CHANGE_ORIGINAL_PAY_IDENTITY_BOUND_EXCEEDED' using errcode='54000'; end if;
   -- Only immutable Original cash identity. Runtime bank account selection,
   -- posting status and member assembly remain exclusively native authorities.
   select coalesce(jsonb_agg(jsonb_build_object('id',tr.id,'run_worker_id',tr.run_worker_id,
    'candidate_id',tr.candidate_id,'projection_id',tr.projection_id,'transfer_no',tr.transfer_no,
    'currency',tr.currency,'cash_amount',tr.cash_amount,'original_transfer_id',tr.original_transfer_id,
    'return_cash_id',tr.return_cash_id,'created_at_epoch',extract(epoch from tr.created_at_utc)) order by tr.id),'[]'::jsonb)
    into transfers from private.bpay_next_transfer tr where tr.id=any(transfer_ids);
   for transfer in select tr.* from private.bpay_next_transfer tr where tr.id=any(transfer_ids) order by tr.id loop
    select to_jsonb(native) into strict reservation
     from private.bpay_next_original_reservation_v1(transfer.run_worker_id,transfer.id) native;
    reservations:=reservations||jsonb_build_array(jsonb_build_object('transfer_id',transfer.id,
     'run_worker_id',transfer.run_worker_id,'native_reservation',reservation));
   end loop;
   result:=result||jsonb_build_object('original_run_line_ids',to_jsonb(line_ids),
    'original_run_lines_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_ORIGINAL_RUN_LINES_V1',lines),'hex'),
    'original_effect_ids',to_jsonb(effect_ids),
    'original_effects_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_ORIGINAL_EFFECTS_V1',effects),'hex'),
    'original_transfer_ids',to_jsonb(transfer_ids),
    'original_transfers_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_ORIGINAL_TRANSFERS_V1',transfers),'hex'),
    'native_original_reservations',reservations);
  end if;
 end if;
 if octet_length(result::text)>32768 then
  raise exception 'AGENCY_CHANGE_ORIGINAL_PAY_IDENTITY_BOUND_EXCEEDED' using errcode='54000'; end if;
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_ORIGINAL_PAY_IDENTITY_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_original_pay_identity_v1(uuid,uuid,uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_original_pay_identity_v1(uuid,uuid,uuid,uuid)
 from public,anon,authenticated,service_role;


-- Exact selected runtime component 7: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/05_29_agency_paid_write_purpose.sqlinc
-- Finite planned-request purpose. The permission is the genuine ACTIVE native
-- change/UNA phase, not a collection reader's `complete` flag or paid amount.
create or replace function private.weekly_source_agency_paid_write_purpose_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 before_identity jsonb; current_identity jsonb; native_input jsonb; item jsonb;
 t public.timesheets%rowtype; original public.timesheets_financials%rowtype; claim jsonb; document_view jsonb;
 original_id uuid; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,
  r.initial_row_signature,r.request_key,r.updated_by_user_id);
 if r.state<>'ACTIVE' or r.phase not in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT')
  or r.current_timesheet_id is distinct from r.initial_timesheet_id
  or r.current_timesheet_version is distinct from r.initial_timesheet_version then
  raise exception 'AGENCY_CHANGE_PAID_PURPOSE_PHASE_INVALID' using errcode='55000'; end if;
 select * into strict t from public.timesheets where timesheet_id=r.initial_timesheet_id;
 if t.authorised_at_server is not null
  or (r.native_receipts#>>'{unauthorise,schema_version}'='WEEKLY_SOURCE_AGENCY_NATIVE_UNAUTHORISE_V1'
   and (r.native_receipts#>>'{unauthorise,result,ok}' is distinct from 'true'
    or r.native_receipts#>>'{unauthorise,result,timesheet_id}' is distinct from t.timesheet_id::text
    or t.revoked_reason is distinct from 'TIMESHEET_UNAUTHORISE'
    or t.revoked_by is distinct from r.native_receipts#>>'{unauthorise,phase_actor_user_id}'))
  or r.native_receipts#>>'{unauthorise,schema_version}' is null
  or r.native_receipts#>>'{unauthorise,schema_version}' not in(
   'WEEKLY_SOURCE_AGENCY_NATIVE_UNAUTHORISE_V1','WEEKLY_SOURCE_AGENCY_NATIVE_ALREADY_UNAUTHORISED_V1') then
  raise exception 'AGENCY_CHANGE_GENUINE_UNAUTHORISE_RECEIPT_REQUIRED' using errcode='55000'; end if;
 original_id:=(r.native_receipts#>>'{original_capture,current_financial_id}')::uuid;
 before_identity:=r.native_receipts#>'{original_capture,original_before_pay_inputs,original_identity}';
 if before_identity->>'schema_version' is distinct from 'WEEKLY_SOURCE_AGENCY_ORIGINAL_PAY_IDENTITY_V1'
  or before_identity->>'original_financial_id' is distinct from original_id::text then
  raise exception 'AGENCY_CHANGE_ORIGINAL_PAY_CAPTURE_REQUIRED' using errcode='55000'; end if;
 current_identity:=private.weekly_source_agency_original_pay_identity_v1(t.timesheet_id,r.updated_by_user_id,original_id,r.id);
 -- Compare the immutable Original cut, not approval state that UNA changes.
 -- A foreign payroll/cash effect or run capture is not silently adopted.
 if current_identity-array['native_original_reservations','original_paid_marker']
    is distinct from before_identity-array['native_reservations_sha256','original_paid_marker']
  or (current_identity->>'original_paid_marker')::timestamptz
    is distinct from (before_identity->>'original_paid_marker')::timestamptz then
  raise exception 'AGENCY_CHANGE_ORIGINAL_PAY_IDENTITY_CHANGED' using errcode='40001'; end if;
 select * into strict original from public.timesheets_financials where id=original_id;
 claim:=private.weekly_source_agency_original_claim_recheck_v1(r.id);
 if r.native_receipts#>>'{original_capture,original_submitted_claim,available}'='true'
  and claim->>'available' is distinct from 'true' then
  raise exception 'AGENCY_CHANGE_ORIGINAL_CLAIM_CHANGED' using errcode='40001'; end if;
 if r.native_receipts#>>'{original_capture,original_legacy_document,available}'='true' then
  document_view:=private.weekly_source_agency_legacy_original_document_v1(t.timesheet_id,r.id,r.updated_by_user_id);
  if document_view->>'available' is distinct from 'true'
   or document_view->'document_view_sha256'
    is distinct from r.native_receipts#>'{original_capture,original_legacy_document,document_view_sha256}' then
   raise exception 'AGENCY_CHANGE_ORIGINAL_DOCUMENT_CHANGED' using errcode='40001'; end if;
 end if;
 if current_identity->>'active_owner'='NEXT' then
  native_input:=private.weekly_source_agency_ordinary_collection_inputs_v1(r.id);
  if original.paid_at_utc is not null and native_input->'native_component_inputs' is null then
   raise exception 'AGENCY_CHANGE_PAID_ORDINARY_INPUTS_UNBOUND' using errcode='55000'; end if;
  for item in select value from jsonb_array_elements(coalesce(current_identity->'native_original_reservations','[]'::jsonb)) loop
   -- Literal existing native reservation outcomes. No amount/ratio calculation,
   -- and no UNKNOWN, pending posting, inconsistent projection or assumed zero.
   if item#>>'{native_reservation,reservation_state}' is null
    or item#>>'{native_reservation,reservation_state}' not in(
     'POSTED','RETURNED','CLOSED_INTERNAL','RESERVED','INTERNAL_RESERVED','ISSUED_AWAITING_RECEIPT') then
    raise exception 'AGENCY_CHANGE_NATIVE_ORIGINAL_RESERVATION_NOT_ADMISSIBLE' using errcode='55000'; end if;
  end loop;
 end if;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_PAID_WRITE_PURPOSE_V1',
  'request_id',r.id,'request_sha256',encode(r.request_sha256,'hex'),'phase',r.phase,
  'phase_actor_user_id',r.updated_by_user_id,'timesheet_id',t.timesheet_id,'timesheet_version',t.version,
  'original_financial_id',original.id,'original_paid_marker',before_identity->'original_paid_marker',
  'original_identity_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_ORIGINAL_PAY_IDENTITY_CUT_V1',before_identity),'hex'),
  'current_native_inputs_sha256',case when native_input is null then null else encode(private.weekly_source_sha256_jsonb_v1(
   'AGENCY_CURRENT_NATIVE_ORDINARY_INPUTS_V1',native_input),'hex') end,
  'current_native_reservations_sha256',encode(private.weekly_source_sha256_jsonb_v1(
   'AGENCY_CURRENT_NATIVE_ORIGINAL_RESERVATIONS_V1',current_identity->'native_original_reservations'),'hex'),
  'source_cas',r.source_cas,'original_submission_proved',claim->'available',
  'original_submission_sha256',claim->'claim_sha256','original_submission_state',claim->'submission_state',
  'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid());
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_PAID_WRITE_PURPOSE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_paid_write_purpose_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_paid_write_purpose_v1(uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 8: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/06_34_complete_ordinary_collection_native_json_codec.sqlinc
-- Actual ORDINARY native collection/reservation INPUTS only. These are not a
-- universal paid/withheld quantity, protection v_position or paid edit permit.
-- The established native owners retain every money formula and uncertainty.
create or replace function private.weekly_source_agency_ordinary_collection_inputs_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 scope jsonb; v_work private.bpay_next_work%rowtype;
 before_work jsonb; before_worker jsonb; after_worker jsonb;
 v_keys text[]; v_key text; v_position private.bpay_next_position%rowtype;
 v_basis private.bpay_next_work_collection%rowtype; rows jsonb:='[]'::jsonb;
 observation jsonb; reservation jsonb; native_error text; item jsonb; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 scope:=private.weekly_source_agency_native_pay_scope_v1(p_request_id);
 if scope->>'active_owner' is distinct from 'NEXT' then
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORDINARY_COLLECTION_INPUTS_V1',
   'scope',scope,'native_component_inputs',null,'reason','LEGACY_COLLECTION_PROTOCOL_NOT_NEXT',
   'paid_writer_permission',null,'paid_quantity_known',null,'withheld_quantity_known',null);
 end if;
 if jsonb_typeof(scope->'ordinary_work') is distinct from 'object'
  or not pg_input_is_valid(coalesce(scope#>>'{ordinary_work,work_id}',''),'uuid') then
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORDINARY_COLLECTION_INPUTS_V1',
   'scope',scope,'native_component_inputs',null,'reason','NATIVE_ORDINARY_WORK_UNAVAILABLE',
   'paid_writer_permission',null,'paid_quantity_known',null,'withheld_quantity_known',null);
 end if;
 select * into strict v_work from private.bpay_next_work where id=(scope#>>'{ordinary_work,work_id}')::uuid;
 if v_work.work_kind is distinct from 'ORDINARY' or v_work.origin_kind is distinct from 'CONTRACT'
  or v_work.booking_id is distinct from scope#>>'{ordinary_work,booking_id}'
  or v_work.candidate_id::text is distinct from scope->>'candidate_id'
  or v_work.contract_id::text is distinct from scope->>'contract_id'
  or v_work.week_ending_date::text is distinct from scope->>'week_ending_date'
  or v_work.current_revision_id::text is distinct from scope#>>'{ordinary_work,current_revision_id}'
  or v_work.applied_revision_id::text is distinct from scope#>>'{ordinary_work,applied_revision_id}' then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_WORK_SCOPE_CONFLICT' using errcode='40001'; end if;
 before_work:=to_jsonb(v_work);
 select to_jsonb(worker) into before_worker from private.bpay_next_worker_control worker where candidate_id=v_work.candidate_id;
 -- All actual native v_keys, including historical paid/held/collection v_keys.
 -- Caller supplies no v_key, date, subset, source_component_id or after cursor.
 select coalesce(array_agg(component_key order by component_key),'{}'::text[]) into v_keys from (
  select line.component_key from private.bpay_next_approved_line line
   join private.bpay_next_work_revision revision on revision.id=line.revision_id and revision.work_id=v_work.id
   where revision.id=v_work.current_revision_id or revision.id=v_work.applied_revision_id
  union select pos.component_key from private.bpay_next_position pos where pos.work_id=v_work.id
  union select collection.component_key from private.bpay_next_work_collection collection where collection.work_id=v_work.id
 ) native_keys;
 if cardinality(v_keys)>1000 or array_position(v_keys,null::text) is not null
  or exists(select 1 from unnest(v_keys) actual_key where length(actual_key) not between 1 and 256
   or octet_length(actual_key)>1024) then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_COMPONENT_BOUND_EXCEEDED' using errcode='54000'; end if;
 foreach v_key in array v_keys loop
  v_position:=null;v_basis:=null;observation:=null;reservation:=null;native_error:=null;
  select * into v_position from private.bpay_next_position pos where pos.work_id=v_work.id and pos.component_key=v_key;
  select * into v_basis from private.bpay_next_work_collection collection where collection.work_id=v_work.id and collection.component_key=v_key;
  if v_position.work_id is not null and v_position.applied_revision_id is not null then
   begin
    observation:=private.bpay_next_work_collection_observation_v1(v_work.id,v_key,v_position.applied_revision_id);
   exception when no_data_found or too_many_rows then
    get stacked diagnostics native_error=returned_sqlstate;
   end;
  end if;
  if v_basis.id is not null and v_basis.original_transfer_id is not null then
   -- The run worker is derived from the real Original transfer. It is not an
   -- Office selected payer or a stored held_source_ex_vat -> withheld shortcut.
   select to_jsonb(native) into reservation
    from private.bpay_next_transfer transfer
    cross join lateral private.bpay_next_original_reservation_v1(transfer.run_worker_id,transfer.id) native
    where transfer.id=v_basis.original_transfer_id and transfer.candidate_id=v_work.candidate_id;
  end if;
  item:=jsonb_build_object('component_key',v_key,'actual_position',to_jsonb(v_position),
   'actual_collection',to_jsonb(v_basis),'native_collection_observation',observation,
   'native_observation_sqlstate',native_error,'native_original_reservation',reservation);
  rows:=rows||jsonb_build_array(item);
  if octet_length(rows::text)>1048576 then
   raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_COMPONENT_BOUND_EXCEEDED' using errcode='54000'; end if;
 end loop;
 select to_jsonb(worker) into after_worker from private.bpay_next_worker_control worker where candidate_id=v_work.candidate_id;
 if before_work is distinct from (select to_jsonb(current_work) from private.bpay_next_work current_work where id=v_work.id)
  or before_worker is distinct from after_worker
  or not exists(select 1 from private.bpay_next_module_control module where module.id=1
   and module.active_owner='NEXT' and module.owner_epoch::text=scope->>'owner_epoch') then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_INPUTS_CHANGED' using errcode='40001'; end if;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORDINARY_COLLECTION_INPUTS_V1',
  'scope',scope,'native_component_inputs',rows,'native_worker_control',before_worker,
  'reason',null,'paid_writer_permission',null,'paid_quantity_known',null,'withheld_quantity_known',null);
 if octet_length(result::text)>1310720 then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_COMPONENT_BOUND_EXCEEDED' using errcode='54000'; end if;
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_INPUTS_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_ordinary_collection_inputs_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_ordinary_collection_inputs_v1(uuid)
 from public,anon,authenticated,service_role;


-- Exact selected runtime component 9: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/07_35_complete_before_collection_native_json_codec.sqlinc
-- Actual ORDINARY native collection/reservation INPUTS only. These are not a
-- universal paid/withheld quantity, protection v_position or paid edit permit.
-- The established native owners retain every money formula and uncertainty.
create or replace function private.weekly_source_agency_before_collection_inputs_v1(p_timesheet_id uuid,p_actual_actor_user_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 scope jsonb; v_work private.bpay_next_work%rowtype;
 before_work jsonb; before_worker jsonb; after_worker jsonb;
 v_keys text[]; v_key text; v_position private.bpay_next_position%rowtype;
 v_basis private.bpay_next_work_collection%rowtype; rows jsonb:='[]'::jsonb;
 observation jsonb; reservation jsonb; native_error text; item jsonb; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 scope:=private.weekly_source_agency_physical_pay_inputs_v1(p_timesheet_id,p_actual_actor_user_id);
 if scope->>'active_owner' is distinct from 'NEXT' then
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORDINARY_COLLECTION_INPUTS_V1',
   'scope',scope,'native_component_inputs',null,'reason','LEGACY_COLLECTION_PROTOCOL_NOT_NEXT',
   'paid_writer_permission',null,'paid_quantity_known',null,'withheld_quantity_known',null);
 end if;
 if jsonb_typeof(scope->'ordinary_work') is distinct from 'object'
  or not pg_input_is_valid(coalesce(scope#>>'{ordinary_work,work_id}',''),'uuid') then
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORDINARY_COLLECTION_INPUTS_V1',
   'scope',scope,'native_component_inputs',null,'reason','NATIVE_ORDINARY_WORK_UNAVAILABLE',
   'paid_writer_permission',null,'paid_quantity_known',null,'withheld_quantity_known',null);
 end if;
 select * into strict v_work from private.bpay_next_work where id=(scope#>>'{ordinary_work,work_id}')::uuid;
 if v_work.work_kind is distinct from 'ORDINARY' or v_work.origin_kind is distinct from 'CONTRACT'
  or v_work.booking_id is distinct from scope#>>'{ordinary_work,booking_id}'
  or v_work.candidate_id::text is distinct from scope->>'candidate_id'
  or v_work.contract_id::text is distinct from scope->>'contract_id'
  or v_work.week_ending_date::text is distinct from scope->>'week_ending_date'
  or v_work.current_revision_id::text is distinct from scope#>>'{ordinary_work,current_revision_id}'
  or v_work.applied_revision_id::text is distinct from scope#>>'{ordinary_work,applied_revision_id}' then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_WORK_SCOPE_CONFLICT' using errcode='40001'; end if;
 before_work:=to_jsonb(v_work);
 select to_jsonb(worker) into before_worker from private.bpay_next_worker_control worker where candidate_id=v_work.candidate_id;
 -- All actual native v_keys, including historical paid/held/collection v_keys.
 -- Caller supplies no v_key, date, subset, source_component_id or after cursor.
 select coalesce(array_agg(component_key order by component_key),'{}'::text[]) into v_keys from (
  select line.component_key from private.bpay_next_approved_line line
   join private.bpay_next_work_revision revision on revision.id=line.revision_id and revision.work_id=v_work.id
   where revision.id=v_work.current_revision_id or revision.id=v_work.applied_revision_id
  union select pos.component_key from private.bpay_next_position pos where pos.work_id=v_work.id
  union select collection.component_key from private.bpay_next_work_collection collection where collection.work_id=v_work.id
 ) native_keys;
 if cardinality(v_keys)>1000 or array_position(v_keys,null::text) is not null
  or exists(select 1 from unnest(v_keys) actual_key where length(actual_key) not between 1 and 256
   or octet_length(actual_key)>1024) then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_COMPONENT_BOUND_EXCEEDED' using errcode='54000'; end if;
 foreach v_key in array v_keys loop
  v_position:=null;v_basis:=null;observation:=null;reservation:=null;native_error:=null;
  select * into v_position from private.bpay_next_position pos where pos.work_id=v_work.id and pos.component_key=v_key;
  select * into v_basis from private.bpay_next_work_collection collection where collection.work_id=v_work.id and collection.component_key=v_key;
  if v_position.work_id is not null and v_position.applied_revision_id is not null then
   begin
    observation:=private.bpay_next_work_collection_observation_v1(v_work.id,v_key,v_position.applied_revision_id);
   exception when no_data_found or too_many_rows then
    get stacked diagnostics native_error=returned_sqlstate;
   end;
  end if;
  if v_basis.id is not null and v_basis.original_transfer_id is not null then
   -- The run worker is derived from the real Original transfer. It is not an
   -- Office selected payer or a stored held_source_ex_vat -> withheld shortcut.
   select to_jsonb(native) into reservation
    from private.bpay_next_transfer transfer
    cross join lateral private.bpay_next_original_reservation_v1(transfer.run_worker_id,transfer.id) native
    where transfer.id=v_basis.original_transfer_id and transfer.candidate_id=v_work.candidate_id;
  end if;
  item:=jsonb_build_object('component_key',v_key,'actual_position',to_jsonb(v_position),
   'actual_collection',to_jsonb(v_basis),'native_collection_observation',observation,
   'native_observation_sqlstate',native_error,'native_original_reservation',reservation);
  rows:=rows||jsonb_build_array(item);
  if octet_length(rows::text)>1048576 then
   raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_COMPONENT_BOUND_EXCEEDED' using errcode='54000'; end if;
 end loop;
 select to_jsonb(worker) into after_worker from private.bpay_next_worker_control worker where candidate_id=v_work.candidate_id;
 if before_work is distinct from (select to_jsonb(current_work) from private.bpay_next_work current_work where id=v_work.id)
  or before_worker is distinct from after_worker
  or not exists(select 1 from private.bpay_next_module_control module where module.id=1
   and module.active_owner='NEXT' and module.owner_epoch::text=scope->>'owner_epoch') then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_INPUTS_CHANGED' using errcode='40001'; end if;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_ORDINARY_COLLECTION_INPUTS_V1',
  'scope',scope,'native_component_inputs',rows,'native_worker_control',before_worker,
  'reason',null,'paid_writer_permission',null,'paid_quantity_known',null,'withheld_quantity_known',null);
 if octet_length(result::text)>1310720 then
  raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_COMPONENT_BOUND_EXCEEDED' using errcode='54000'; end if;
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_INPUTS_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_before_collection_inputs_v1(uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_before_collection_inputs_v1(uuid,uuid)
 from public,anon,authenticated,service_role;


-- Exact selected runtime component 10: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/08_38_agency_candidate_native_admission.sqlinc
-- Existing native Candidate/I1 owners, before original D1/family business locks.
-- No new arbiter, selector, job row, actor impersonation or lease is created.
create or replace function private.weekly_source_agency_candidate_admit_v1(
 p_timesheet_id uuid,p_actual_actor_user_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare t public.timesheets%rowtype;c public.contracts%rowtype;gate jsonb;module_owner text;
 owned private.weekly_source_agency_timesheet_change_requests%rowtype;
begin
 perform private.weekly_source_query_require_service_v1();
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001'; end if;
 if private.weekly_source_pay_actor_allowed_v1(p_actual_actor_user_id) is distinct from true then
  raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict c from public.contracts where id=t.contract_id;
 if t.is_current is distinct from true or t.archived_at_utc is not null
  or t.sheet_scope::text is distinct from 'WEEKLY' or t.line_type::text is distinct from 'HOURS'
  or c.candidate_id is null or c.client_id is null then
  raise exception 'AGENCY_CHANGE_CANDIDATE_NATIVE_SCOPE_INVALID' using errcode='55000'; end if;
 if private.weekly_source_agency_invoice_check_only_v1(t.timesheet_id) is distinct from true then
  -- The ordinary check-only reader deliberately rejects every revoked root.
  -- The single change owner may be between its genuine UNA and AUTH only;
  -- original source/rule/input/scope and phase CAS are asserted by its caller.
  select * into strict owned from private.weekly_source_agency_timesheet_change_requests
   where current_timesheet_id=t.timesheet_id and state='ACTIVE';
  if owned.current_timesheet_id is distinct from owned.initial_timesheet_id
   or owned.current_timesheet_version is distinct from t.version
   or owned.contract_id is distinct from c.id or owned.candidate_id is distinct from c.candidate_id
   or owned.client_id is distinct from c.client_id
   or owned.phase not in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT')
   or t.revoked_at is null or t.revoked_reason is distinct from 'TIMESHEET_UNAUTHORISE'
   or t.revoked_by is distinct from owned.native_receipts#>>'{unauthorise,phase_actor_user_id}'
   or owned.native_receipts#>>'{unauthorise,result,ok}' is distinct from 'true'
   or owned.native_receipts#>>'{unauthorise,result,timesheet_id}' is distinct from t.timesheet_id::text then
   raise exception 'AGENCY_CHANGE_CANDIDATE_NATIVE_SCOPE_INVALID' using errcode='55000'; end if;
 end if;
 gate:=private.weekly_source_candidate_serial_gate_v1(c.candidate_id,
  'WORKBENCH_CANDIDATE_FIRST_AUTHORISATION',t.timesheet_id,'AGENCY_CHANGE_OFFICE_AUTHORISE_ADMISSION');
 if gate->>'ok' is distinct from 'true' or gate->>'gate' is distinct from 'GRANTED'
  or gate->>'candidate_id' is distinct from c.candidate_id::text then
  raise exception 'AGENCY_CHANGE_CANDIDATE_NATIVE_ADMISSION_BUSY' using errcode='55P03'; end if;
 select active_owner into strict module_owner from private.bpay_next_module_control where id=1;
 if module_owner='NEXT' then
  perform private.bpay_next_assert_candidate_financial_fence_v1(c.candidate_id,null::uuid,null::uuid,null::bigint);
 elsif module_owner is distinct from 'LEGACY' then
  raise exception 'AGENCY_CHANGE_NATIVE_PAY_MODULE_UNAVAILABLE' using errcode='55000'; end if;
 return gate;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_CANDIDATE_NATIVE_SCOPE_INVALID' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_candidate_admit_v1(uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_candidate_admit_v1(uuid,uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 11: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/09_40_complete_physical_pay_scope_client_cycle.sqlinc
-- Before-action input scope, derived from the real current main Contract week.
-- This supplies no paid writer, per-shift money or protection authority.
create or replace function private.weekly_source_agency_physical_pay_inputs_v1(
 p_timesheet_id uuid,p_actual_actor_user_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype;
 c public.contracts%rowtype; cw public.contract_weeks%rowtype;
 group_id uuid; cycle_id uuid; cycle_ids uuid[]; member_ids uuid[]; n bigint;
 native_work private.bpay_next_work%rowtype; native_revision private.bpay_next_work_revision%rowtype;
 work_value jsonb; revision_value jsonb; legacy jsonb; module_owner text; module_epoch bigint;
 result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if p_timesheet_id is null or private.weekly_source_pay_actor_allowed_v1(p_actual_actor_user_id) is distinct from true then
  raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501'; end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict c from public.contracts where id=t.contract_id;
 select count(*) into n from public.contract_weeks week where week.contract_id=c.id
  and week.week_ending_date=t.week_ending_date and coalesce(week.additional_seq,0)=0
  and coalesce(week.is_adjustment,false)=false and week.timesheet_id=t.timesheet_id;
 if n<>1 or t.is_current is distinct from true or t.revoked_at is not null or t.archived_at_utc is not null
  or t.sheet_scope::text is distinct from 'WEEKLY' or t.line_type::text is distinct from 'HOURS'
  or private.weekly_source_agency_invoice_check_only_v1(t.timesheet_id) is distinct from true then
  raise exception 'AGENCY_CHANGE_NATIVE_MAIN_PAY_SCOPE_UNAVAILABLE' using errcode='55000'; end if;
 select * into strict cw from public.contract_weeks week where week.contract_id=c.id
  and week.week_ending_date=t.week_ending_date and coalesce(week.additional_seq,0)=0
  and coalesce(week.is_adjustment,false)=false and week.timesheet_id=t.timesheet_id;
 select array_agg(cycle.id order by cycle.id) into cycle_ids from public.weekly_source_groups g
  join public.weekly_source_group_clients member on member.source_group_id=g.id and member.client_id=c.client_id
   and t.week_ending_date between member.valid_from and coalesce(member.valid_to,'infinity'::date)
  join public.weekly_source_cycles cycle on cycle.source_group_id=g.id and cycle.finalisation_week_ending=t.week_ending_date
  where g.active and g.environment='TEST' and g.source_family='ROSTER'
   and (cycle.scope_client_id is null or cycle.scope_client_id=c.client_id);
 if cardinality(cycle_ids)>1 then
  select array_agg(cycle.id order by cycle.id) into cycle_ids from public.weekly_source_cycles cycle
   where cycle.id=any(cycle_ids) and cycle.scope_client_id=c.client_id; end if;
 if coalesce(cardinality(cycle_ids),0)<>1 then
  raise exception 'AGENCY_CHANGE_SOURCE_CYCLE_AMBIGUOUS' using errcode='55000'; end if;
 select cycle.source_group_id,cycle.id into strict group_id,cycle_id
  from public.weekly_source_cycles cycle where cycle.id=cycle_ids[1];
 perform private.weekly_source_office_authority_v1(p_actual_actor_user_id,'VIEW_PAY_WORK',group_id,c.client_id,t.week_ending_date);
 select * into strict f from public.timesheets_financials where timesheet_id=t.timesheet_id and is_current;
 select array_agg(distinct family.family_timesheet_id order by family.family_timesheet_id) into member_ids
  from public._pay_timesheet_rotation_scope(array[t.timesheet_id]) family;
 if member_ids is null or cardinality(member_ids) not between 1 and 256 or not t.timesheet_id=any(member_ids)
  or f.timesheet_version is distinct from t.version or f.candidate_id is distinct from c.candidate_id
  or f.client_id is distinct from c.client_id then
  raise exception 'AGENCY_CHANGE_NATIVE_PAY_FAMILY_SCOPE_CHANGED' using errcode='40001'; end if;
 select module.active_owner,module.owner_epoch into strict module_owner,module_epoch from private.bpay_next_module_control module where module.id=1;
 if module_owner is null or module_owner not in('LEGACY','NEXT') or module_epoch is null or module_epoch<0
  or(module_owner='NEXT' and module_epoch=0) then
  raise exception 'AGENCY_CHANGE_NATIVE_PAY_MODULE_UNAVAILABLE' using errcode='55000'; end if;
 if module_owner='LEGACY' then
  legacy:=private.weekly_source_settlement_allocation_v1(t.timesheet_id);
 else
  select * into native_work from private.bpay_next_work work where work.booking_id=t.booking_id;
  if found then
   if native_work.work_kind is distinct from 'ORDINARY' or native_work.origin_kind is distinct from 'CONTRACT'
    or native_work.candidate_id is distinct from c.candidate_id or native_work.contract_id is distinct from c.id
    or native_work.week_ending_date is distinct from t.week_ending_date
    or native_work.original_timesheet_id is null or not native_work.original_timesheet_id=any(member_ids) then
    raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_WORK_SCOPE_CONFLICT' using errcode='55000'; end if;
   work_value:=jsonb_build_object('work_id',native_work.id,'work_kind',native_work.work_kind,'origin_kind',native_work.origin_kind,
    'original_timesheet_id',native_work.original_timesheet_id,'booking_id',native_work.booking_id,
    'candidate_id',native_work.candidate_id,'contract_id',native_work.contract_id,'week_ending_date',native_work.week_ending_date,
    'current_revision_id',native_work.current_revision_id,'applied_revision_id',native_work.applied_revision_id,
    'current_revision_no',native_work.current_revision_no);
   if coalesce(native_work.current_revision_id,native_work.applied_revision_id) is not null then
    select * into strict native_revision from private.bpay_next_work_revision revision
     where revision.id=coalesce(native_work.current_revision_id,native_work.applied_revision_id) and revision.work_id=native_work.id;
    if native_revision.source_kind is distinct from 'ORDINARY' or native_revision.physical_timesheet_id is null
     or not native_revision.physical_timesheet_id=any(member_ids) or native_revision.week_ending_date is distinct from t.week_ending_date then
     raise exception 'AGENCY_CHANGE_NATIVE_ORDINARY_REVISION_SCOPE_CONFLICT' using errcode='55000'; end if;
    revision_value:=jsonb_build_object('revision_id',native_revision.id,'work_id',native_revision.work_id,
     'source_kind',native_revision.source_kind,'revision_no',native_revision.revision_no,
     'physical_timesheet_id',native_revision.physical_timesheet_id,'physical_timesheet_version',native_revision.physical_timesheet_version,
     'financial_snapshot_id',native_revision.financial_snapshot_id,'detail_kind',native_revision.detail_kind,
     'source_pay_channel',native_revision.source_pay_channel,'expected_line_count',native_revision.expected_line_count,
     'certified_zero',native_revision.certified_zero,'approved_source_ex_vat',native_revision.approved_source_ex_vat,
     'sealed_at_utc',native_revision.sealed_at_utc);
   end if;
  end if;
 end if;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_PHYSICAL_PAY_INPUTS_V1',
  'actual_actor_user_id',p_actual_actor_user_id,'timesheet_id',t.timesheet_id,'timesheet_version',t.version,
  'contract_week_id',cw.id,'contract_id',c.id,'candidate_id',c.candidate_id,'client_id',c.client_id,
  'week_ending_date',t.week_ending_date,'source_group_id',group_id,'source_cycle_id',cycle_id,
  'family_member_ids',to_jsonb(member_ids),'active_owner',module_owner,'owner_epoch',module_epoch,
  'current_financial_id',f.id,'current_financial_paid_marker',f.paid_at_utc,
  'ordinary_work',work_value,'ordinary_revision',revision_value,'legacy_family_hours',legacy);
 if octet_length(result::text)>262144 then raise exception 'AGENCY_CHANGE_NATIVE_PAY_SCOPE_BOUND_EXCEEDED' using errcode='54000'; end if;
 return result;
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_PAY_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_physical_pay_inputs_v1(uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_physical_pay_inputs_v1(uuid,uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 12: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/10_44_agency_native_segment_flag_apply.sqlinc
-- One existing flag writer. All economic sums, charge and margin remain inside
-- tsfin_update_segments_locked; this wrapper derives identity and proves flags.
create or replace function private.weekly_source_agency_segment_flags_apply_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 before_fin public.timesheets_financials%rowtype; after_fin public.timesheets_financials%rowtype;
 plan jsonb; native_result jsonb; old_segment jsonb; new_segment jsonb; flag jsonb; count_value integer;
begin
 plan:=private.weekly_source_agency_segment_flags_v1(p_request_id);
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 select * into strict before_fin from public.timesheets_financials where id=r.current_financial_id and is_current;
 native_result:=public.tsfin_update_segments_locked(r.current_timesheet_id,plan->'flags',r.updated_by_user_id);
 select * into strict after_fin from public.timesheets_financials where id=before_fin.id and is_current;
 if native_result#>>'{updated,id}' is distinct from after_fin.id::text
  or to_jsonb(after_fin)-array['invoice_breakdown_json','total_pay_ex_vat','total_charge_ex_vat','margin_ex_vat','updated_at']
    is distinct from to_jsonb(before_fin)-array['invoice_breakdown_json','total_pay_ex_vat','total_charge_ex_vat','margin_ex_vat','updated_at']
  or jsonb_typeof(after_fin.invoice_breakdown_json->'segments') is distinct from 'array'
  or jsonb_array_length(after_fin.invoice_breakdown_json->'segments')<>jsonb_array_length(plan->'flags') then
  raise exception 'AGENCY_CHANGE_NATIVE_SEGMENT_FLAG_WRITE_UNPROVED' using errcode='55000';end if;
 for old_segment in select value from jsonb_array_elements(before_fin.invoice_breakdown_json->'segments') loop
  select count(*) into count_value from jsonb_array_elements(after_fin.invoice_breakdown_json->'segments') s
    where s->>'segment_id'=old_segment->>'segment_id';
  if count_value<>1 then raise exception 'AGENCY_CHANGE_NATIVE_SEGMENT_FLAG_WRITE_UNPROVED' using errcode='55000';end if;
  select value into strict new_segment from jsonb_array_elements(after_fin.invoice_breakdown_json->'segments') s(value)
    where value->>'segment_id'=old_segment->>'segment_id';
  select value into strict flag from jsonb_array_elements(plan->'flags') s(value) where value->>'segment_id'=old_segment->>'segment_id';
  if new_segment-'exclude_from_pay' is distinct from old_segment-'exclude_from_pay'
   or new_segment->'exclude_from_pay' is distinct from flag->'exclude_from_pay' then
   raise exception 'AGENCY_CHANGE_NATIVE_SEGMENT_FLAG_WRITE_UNPROVED' using errcode='55000';end if;
 end loop;
 return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_SEGMENT_FLAG_WRITE_V1',
  'request_id',r.id,'request_sha256',encode(r.request_sha256,'hex'),'phase_actor_user_id',r.updated_by_user_id,
  'timesheet_id',r.current_timesheet_id,'timesheet_version',r.current_timesheet_version,'financial_id',after_fin.id,
  'flags',plan->'flags','basis_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_SEGMENT_FLAG_BASIS_V1',plan->'basis'),'hex'),
  'native_result_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_SEGMENT_FLAG_WRITE_RESULT_V1',native_result),'hex'),
  'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid());
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_SEGMENT_FLAG_WRITE_UNPROVED' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_segment_flags_apply_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_segment_flags_apply_v1(uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 13: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/11_51_agency_owned_native_query_facts.sqlinc
-- Native scope adapter for the genuine owned UNA/recompute phase. The original
-- Source scope still refuses revoked roots; no shared predicate or GUC changes.
-- Only this owner and the unchanged original scope call the private facts kernel.
create or replace function private.weekly_source_agency_native_query_facts_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 r private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; c public.contracts%rowtype; family public.weekly_exceptional_pay_target_families%rowtype;
 identity jsonb; frame jsonb; native_scope jsonb; actual_scope jsonb; count_value integer;
begin
 perform private.weekly_source_query_require_service_v1();
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001';end if;
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 if r.state<>'ACTIVE' or r.phase not in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING','FINANCIAL_CURRENT','AUTHORISED')
  or private.weekly_source_agency_change_request_sha256_v1(r.contract_week_id,r.reason,r.initial_row_signature,
   r.request_key,r.actor_user_id,r.native_receipts->'original_capture') is distinct from r.request_sha256 then
  raise exception 'AGENCY_CHANGE_ORIGINAL_REQUEST_DIGEST_INVALID' using errcode='55000';end if;
 if private.weekly_source_pay_actor_allowed_v1(r.updated_by_user_id) is distinct from true then
  raise exception 'WEEKLY_SOURCE_PAYMENT_AUTHORISER_REQUIRED' using errcode='42501';end if;
 perform private.weekly_source_office_authority_v1(r.updated_by_user_id,'VIEW_PAY_WORK',r.source_group_id,r.client_id,r.week_ending_date);
 if private.weekly_source_bulk_source_cas_v1(r.source_cycle_id,array[r.client_id]) is distinct from r.source_cas
  or private.weekly_source_effective_rule_set_v1(r.client_id,r.source_cycle_id)->>'rule_set_version_id'
    is distinct from r.rule_set_version_id::text then
  raise exception 'AGENCY_CHANGE_ORIGINAL_SOURCE_CAS_CHANGED' using errcode='40001';end if;
 select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
 select * into strict c from public.contracts where id=t.contract_id;
 identity:=private.weekly_source_resolve_root_identity_v1(t.timesheet_id);
 if identity->>'ok' is distinct from 'true' or identity->>'requested_is_canonical' is distinct from 'true'
  or identity->>'family_is_current' is distinct from 'true' or identity->>'canonical_timesheet_id' is distinct from t.timesheet_id::text
  or identity->>'family_booking_id' is distinct from t.booking_id
  or t.timesheet_id is distinct from r.initial_timesheet_id or t.version is distinct from r.current_timesheet_version
  or t.is_current is distinct from true or t.archived_at_utc is not null or t.sheet_scope::text is distinct from 'WEEKLY'
  or t.line_type::text is distinct from 'HOURS' or t.is_adjustment is distinct from false
  or c.id is distinct from r.contract_id or c.candidate_id is distinct from r.candidate_id or c.client_id is distinct from r.client_id
  or t.week_ending_date is distinct from r.week_ending_date then
  raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
 select count(*) into count_value from public.contract_weeks where contract_id=c.id and week_ending_date=t.week_ending_date
  and additional_seq=0 and is_adjustment is false and timesheet_id=t.timesheet_id;
 if count_value<>1 then raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
 if r.phase in('UNAUTHORISED','SCHEDULE_APPLIED','RECOMPUTE_PENDING') then
  frame:=r.native_receipts->'financial_write_frame';
  if frame->>'transaction_id' is distinct from pg_current_xact_id()::text or frame->>'backend_pid' is distinct from pg_backend_pid()::text
   or frame->>'request_id' is distinct from r.id::text or frame->>'request_sha256' is distinct from encode(r.request_sha256,'hex')
   or frame->>'phase_actor_user_id' is distinct from r.updated_by_user_id::text
   or frame->>'timesheet_id' is distinct from t.timesheet_id::text or frame->>'timesheet_version' is distinct from t.version::text
   or frame->'source_cas' is distinct from r.source_cas then
   raise exception 'AGENCY_CHANGE_GENUINE_FINANCIAL_FRAME_REQUIRED' using errcode='55000';end if;
 else
  r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,r.initial_row_signature,r.request_key,r.updated_by_user_id);
 end if;
 if t.revoked_at is not null and (r.phase='AUTHORISED' or t.revoked_reason is distinct from 'TIMESHEET_UNAUTHORISE'
   or t.revoked_by is distinct from r.native_receipts#>>'{unauthorise,phase_actor_user_id}'
   or r.native_receipts#>>'{unauthorise,result,ok}' is distinct from 'true'
   or r.native_receipts#>>'{unauthorise,result,timesheet_id}' is distinct from t.timesheet_id::text) then
  raise exception 'AGENCY_CHANGE_GENUINE_UNAUTHORISE_RECEIPT_REQUIRED' using errcode='55000';end if;
 select count(*) into count_value from public.weekly_exceptional_pay_target_families where btrim(root_family_booking_id)=btrim(t.booking_id);
 if count_value>1 then raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
 if count_value=1 then
  select * into strict family from public.weekly_exceptional_pay_target_families where btrim(root_family_booking_id)=btrim(t.booking_id);
  if family.root_timesheet_id is distinct from t.timesheet_id or family.root_family_booking_id is distinct from t.booking_id
   or family.candidate_id is distinct from c.candidate_id or family.contract_id is distinct from c.id
   or family.week_start_date is distinct from t.week_ending_date-6 or family.week_ending_date is distinct from t.week_ending_date
   or family.bound_version is null or family.bound_version<1 then
   raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
 end if;
 native_scope:=jsonb_build_object('root_timesheet_id',t.timesheet_id,'family_booking_id',t.booking_id,'target_family_id',family.id,
  'candidate_id',c.candidate_id,'client_id',c.client_id,'contract_id',c.id,'week_ending_date',t.week_ending_date,
  'root_version',t.version::text,'family_bound_version',family.bound_version::text);
 if t.revoked_at is null then
  -- Where the original native scope is applicable it must be byte-identical.
  -- Its real integrity/refusal errors propagate and are never swallowed.
  actual_scope:=private.weekly_source_pay_query_scope_v1(t.timesheet_id);
  if actual_scope is not null and actual_scope is distinct from native_scope then
   raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';end if;
 end if;
 return private.weekly_source_native_query_facts_for_scope_v1(native_scope);
exception when no_data_found or too_many_rows then
 raise exception 'AGENCY_CHANGE_NATIVE_QUERY_SUBJECT_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_native_query_facts_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_native_query_facts_v1(uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 14: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/12_56_native_invoice_segment_selection.sqlinc
-- Selection-only witness of the unchanged invoice editor's SEGMENTS arm.
-- No monetary aggregation, rates, VAT, rounding, line construction or mutation.
create or replace function private.weekly_source_agency_invoice_segment_selection_v1(
 p_timesheet_id uuid,p_financial_id uuid,p_invoice_id uuid
) returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare fin public.timesheets_financials%rowtype; invoice public.invoices%rowtype;
 ts public.timesheets%rowtype; pc record; segment jsonb; selected jsonb:='[]'::jsonb;
 natural_start date; invoice_week date; target_week date; reference text;
begin
 select * into strict invoice from public.invoices where id=p_invoice_id;
 select * into strict ts from public.timesheets where timesheet_id=p_timesheet_id and is_current;
 select * into strict fin from public.timesheets_financials where id=p_financial_id and timesheet_id=ts.timesheet_id
  and is_current and timesheet_version=ts.version and client_id=invoice.client_id;
 if invoice.type is distinct from 'INVOICE' or invoice.status not in('DRAFT','ON_HOLD')
  or invoice.issued_at_utc is not null or invoice.paid_at_utc is not null
  or private.weekly_source_agency_invoice_check_only_v1(ts.timesheet_id) is distinct from true
  or fin.processing_status::text is distinct from 'READY_FOR_INVOICE' or fin.is_stale is distinct from false
  or fin.invoice_breakdown_json->>'mode' is distinct from 'SEGMENTS'
  or jsonb_typeof(fin.invoice_breakdown_json->'segments') is distinct from 'array'
  or jsonb_array_length(fin.invoice_breakdown_json->'segments')>100 then
  raise exception 'AGENCY_DRAFT_NATIVE_SELECTION_UNAVAILABLE' using errcode='55000';end if;
 invoice_week:=(invoice.header_snapshot_json#>>'{meta,invoice_week_start}')::date;
 natural_start:=ts.week_ending_date-6;
 if invoice_week is null then raise exception 'AGENCY_DRAFT_NATIVE_SELECTION_UNAVAILABLE' using errcode='55000';end if;
 select * into strict pc from public.v_ts_invoice_precheck where timesheet_id=ts.timesheet_id;
 for segment in select value from jsonb_array_elements(fin.invoice_breakdown_json->'segments') loop
  if jsonb_typeof(segment) is distinct from 'object' or nullif(btrim(segment->>'segment_id'),'') is null then
   raise exception 'AGENCY_DRAFT_NATIVE_COMPONENT_UNBOUND' using errcode='55000';end if;
  if nullif(btrim(coalesce(segment->>'invoice_locked_invoice_id','')),'') is not null then continue;end if;
  target_week:=nullif(btrim(coalesce(segment->>'invoice_target_week_start','')),'')::date;
  reference:=btrim(coalesce(segment->>'ref_num',''));
  if pc.require_reference_to_invoice is true and reference='' then continue;end if;
  if target_week is null or target_week=natural_start then
   if invoice_week<>natural_start then continue;end if;
   selected:=selected||jsonb_build_array(segment);
  elsif invoice_week=target_week and target_week<=(now() at time zone 'Europe/London')::date then
   selected:=selected||jsonb_build_array(segment);
  end if;
 end loop;
 if selected is distinct from fin.invoice_breakdown_json->'segments'
  or (select count(distinct s->>'segment_id') from jsonb_array_elements(selected) s)<>jsonb_array_length(selected) then
  raise exception 'AGENCY_DRAFT_ROUND_TRIP_NATIVE_COMPONENT_SUBSET_REFUSED' using errcode='55000';end if;
 return jsonb_build_object('schema_version','INVOICE_EDIT_NATIVE_SEGMENT_SELECTION_WITNESS_V1',
  'timesheet_id',ts.timesheet_id,'financial_id',fin.id,'invoice_id',invoice.id,
  'invoice_week_start',invoice_week,'segments',selected);
exception when no_data_found or too_many_rows or invalid_text_representation then
 raise exception 'AGENCY_DRAFT_NATIVE_SELECTION_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_invoice_segment_selection_v1(uuid,uuid,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_invoice_segment_selection_v1(uuid,uuid,uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 15: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/13_57_complete_same_draft_with_unchanged_editor.sqlinc
-- R239 owner-private same-original-D1 operation. Called only by the single
-- native change owner; caller cannot choose invoice, Timesheet, line or payload.
create or replace function private.weekly_source_agency_draft_round_trip_v1(
  p_request_key text,p_step text,p_actor_user_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
  v_request private.weekly_source_agency_timesheet_change_requests%rowtype;
  v_invoice public.invoices%rowtype; v_fin public.timesheets_financials%rowtype;
  v_step text:=upper(btrim(p_step)); v_ids jsonb; v_result jsonb; v_plan jsonb;
  v_unrelated bytea; v_actual jsonb; v_signature jsonb;
  v_after_fin public.timesheets_financials%rowtype; v_line_ids jsonb;
begin
  perform private.weekly_source_query_require_service_v1();
  if v_step is null or v_step not in('REMOVE','RETURN') then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_STEP_INVALID' using errcode='22023'; end if;
  select * into strict v_request from private.weekly_source_agency_timesheet_change_requests where request_key=p_request_key;
  v_request:=private.weekly_source_agency_change_request_assert_v1(v_request.contract_week_id,v_request.reason,
    v_request.initial_row_signature,v_request.request_key,p_actor_user_id);
  if v_request.state is distinct from 'ACTIVE'
    or(v_step='REMOVE' and v_request.phase is distinct from 'CAPTURED')
    or(v_step='RETURN' and v_request.phase is distinct from 'AUTHORISED') then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_PHASE_INVALID' using errcode='55000'; end if;
  if v_request.original_draft_invoice_id is null then
    if exists(select 1 from public.invoice_lines l where l.timesheet_id in(v_request.initial_timesheet_id,v_request.current_timesheet_id)) then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_FOREIGN_PLACEMENT' using errcode='55000'; end if;
    return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_DRAFT_ROUND_TRIP_RECEIPT_V1',
      'ok',true,'request_id',v_request.id,'step',v_step,'phase_actor_user_id',p_actor_user_id,'not_required',true,
      'original_draft_invoice_id',null,'original_draft_invoice_no',null); end if;
  select * into strict v_invoice from public.invoices where id=v_request.original_draft_invoice_id for update;
  if v_invoice.type is distinct from 'INVOICE' or v_invoice.status not in('DRAFT','ON_HOLD')
    or v_invoice.issued_at_utc is not null or v_invoice.paid_at_utc is not null
    or v_invoice.client_id is distinct from v_request.client_id
    or v_invoice.invoice_no is distinct from v_request.original_draft_invoice_no then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_ORIGINAL_D1_CHANGED' using errcode='40001'; end if;
  if jsonb_array_length(private.timesheet_correction_draft_holds_v1(v_invoice.id))>0
    or exists(select 1 from private.weekly_source_agency_timesheet_change_requests other_request
      where other_request.id<>v_request.id and other_request.return_hold and other_request.original_draft_invoice_id=v_invoice.id) then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_OTHER_RETURN_HOLD' using errcode='55000'; end if;
  if exists(select 1 from public.invoice_lines l where l.timesheet_id in(v_request.initial_timesheet_id,v_request.current_timesheet_id)
    and l.invoice_id<>v_invoice.id) then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_FOREIGN_PLACEMENT' using errcode='55000'; end if;
  select * into strict v_fin from public.timesheets_financials
    where timesheet_id=v_request.current_timesheet_id and is_current for update;
  v_unrelated:=private.weekly_source_sha256_jsonb_v1('AGENCY_DRAFT_UNRELATED_NATIVE_LINES_V1',
    coalesce((select jsonb_agg(to_jsonb(l) order by l.id) from public.invoice_lines l where l.invoice_id=v_invoice.id
      and l.timesheet_id is distinct from v_request.initial_timesheet_id
      and l.timesheet_id is distinct from v_request.current_timesheet_id),'[]'::jsonb));
  if v_step='REMOVE' then
    if v_request.return_hold or v_request.current_timesheet_id is distinct from v_request.initial_timesheet_id
      or v_fin.id::text is distinct from v_request.native_receipts#>>'{original_capture,current_financial_id}' then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_ORIGINAL_FINANCIAL_CUT_CHANGED' using errcode='40001'; end if;
    select coalesce(jsonb_agg(l.id order by l.id),'[]'::jsonb) into v_ids
      from public.invoice_lines l where l.invoice_id=v_invoice.id and l.timesheet_id=v_request.current_timesheet_id;
    if jsonb_array_length(v_ids)=0 or jsonb_array_length(v_ids)>100 then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_ORIGINAL_PLACEMENT_UNPROVED' using errcode='55000'; end if;
    v_result:=public.invoice_apply_edits(v_invoice.id,jsonb_build_object('remove_invoice_line_ids',v_ids),p_actor_user_id);
    if exists(select 1 from public.invoice_lines l where l.timesheet_id=v_request.current_timesheet_id)
      or exists(select 1 from public.timesheets_financials tf where tf.timesheet_id=v_request.current_timesheet_id
        and tf.is_current and tf.locked_by_invoice_id is not null) then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_REMOVE_NOT_PROVED' using errcode='55000'; end if;
  else
    if v_request.return_hold is distinct from true or v_fin.id is distinct from v_request.current_financial_id
      or v_fin.timesheet_version is distinct from v_request.current_timesheet_version
      or v_fin.is_stale is distinct from false or v_fin.authorised_at_utc is null
      or v_fin.processing_status::text is distinct from 'READY_FOR_INVOICE'
      or v_fin.locked_by_invoice_id is not null then
      raise exception 'AGENCY_INVOICE_TSFIN_NOT_READY' using errcode='55000'; end if;
    if exists(select 1 from public.invoice_lines l where l.timesheet_id=v_request.current_timesheet_id) then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_RETURN_PLACEMENT_CHANGED' using errcode='40001'; end if;
    v_plan:=private.weekly_source_agency_invoice_segment_selection_v1(v_request.current_timesheet_id,v_fin.id,v_invoice.id);
    if v_plan->>'schema_version' is distinct from 'INVOICE_EDIT_NATIVE_SEGMENT_SELECTION_WITNESS_V1'
      or v_plan->>'timesheet_id' is distinct from v_request.current_timesheet_id::text
      or v_plan->>'financial_id' is distinct from v_fin.id::text or v_plan->>'invoice_id' is distinct from v_invoice.id::text
      or v_plan->'segments' is distinct from v_fin.invoice_breakdown_json->'segments' then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_NATIVE_COMPONENT_SUBSET_REFUSED' using errcode='55000';end if;
    -- Literal unchanged native editor/service branch, with one internally derived
    -- payload. No expected money/VAT/line calculator or general permission change.
    v_result:=public.invoice_apply_edits(v_invoice.id,jsonb_build_object('add_timesheet_ids',jsonb_build_array(v_request.current_timesheet_id)),p_actor_user_id);
    select * into strict v_after_fin from public.timesheets_financials where id=v_fin.id and is_current;
    if to_jsonb(v_after_fin)-array['invoice_breakdown_json','locked_by_invoice_id','locked_at_utc','updated_at']
       is distinct from to_jsonb(v_fin)-array['invoice_breakdown_json','locked_by_invoice_id','locked_at_utc','updated_at']
      or v_after_fin.invoice_breakdown_json-'segments' is distinct from v_fin.invoice_breakdown_json-'segments'
      or (select jsonb_agg(s.value-'invoice_locked_invoice_id' order by s.ordinality)
          from jsonb_array_elements(v_after_fin.invoice_breakdown_json->'segments') with ordinality s(value,ordinality))
       is distinct from (select jsonb_agg(s.value-'invoice_locked_invoice_id' order by s.ordinality)
          from jsonb_array_elements(v_fin.invoice_breakdown_json->'segments') with ordinality s(value,ordinality))
      or (jsonb_array_length(v_plan->'segments')>0 and
          (v_after_fin.locked_by_invoice_id is distinct from v_invoice.id or v_after_fin.locked_at_utc is null))
      or exists(select 1 from jsonb_array_elements(v_after_fin.invoice_breakdown_json->'segments') s
        where s->>'invoice_locked_invoice_id' is distinct from v_invoice.id::text) then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_COMPLETE_NATIVE_COMPONENTS_UNPROVED' using errcode='55000';end if;
    select coalesce(jsonb_agg(to_jsonb(l) order by l.id),'[]'::jsonb),coalesce(jsonb_agg(l.id order by l.id),'[]'::jsonb)
      into v_actual,v_line_ids from public.invoice_lines l where l.invoice_id=v_invoice.id and l.timesheet_id=v_request.current_timesheet_id;
    if (jsonb_array_length(v_plan->'segments')>0 and jsonb_array_length(v_actual)=0)
      or (jsonb_array_length(v_plan->'segments')=0 and jsonb_array_length(v_actual)<>0)
      or (select count(distinct l->>'source_key') from jsonb_array_elements(v_actual) l)<>jsonb_array_length(v_actual)
      or exists(select 1 from jsonb_array_elements(v_actual) l
        where l#>>'{meta_json,tsfin_id}' is distinct from v_fin.id::text
          or l->>'booking_id' is distinct from (select booking_id from public.timesheets where timesheet_id=v_request.current_timesheet_id)
          or l->>'invoice_id' is distinct from v_invoice.id::text or l->>'timesheet_id' is distinct from v_request.current_timesheet_id::text) then
      raise exception 'AGENCY_DRAFT_ROUND_TRIP_NATIVE_LINE_IDENTITY_UNPROVED' using errcode='55000';end if;
    -- Complete actual identity census from this native call; hashes do not assert
    -- independent rendered document order or another monetary qualification.
    v_plan:=v_plan||jsonb_build_object('native_invoice_line_ids',v_line_ids,
      'native_invoice_lines_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_DRAFT_NATIVE_RETURNED_LINES_V1',v_actual),'hex'),
      'native_locked_segments_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_DRAFT_NATIVE_RETURNED_SEGMENTS_V1',v_after_fin.invoice_breakdown_json->'segments'),'hex'));
  end if;
  if (v_result is not null and (jsonb_typeof(v_result) is distinct from 'object'
      or v_result->>'invoice_id' is distinct from v_invoice.id::text
      or v_result->>'status' not in('DRAFT','ON_HOLD')))
    or v_result->>'ok'='false' or v_result->>'success'='false'
    or (select invoice_no from public.invoices where id=v_invoice.id) is distinct from v_request.original_draft_invoice_no
    or private.weekly_source_sha256_jsonb_v1('AGENCY_DRAFT_UNRELATED_NATIVE_LINES_V1',
      coalesce((select jsonb_agg(to_jsonb(l) order by l.id) from public.invoice_lines l where l.invoice_id=v_invoice.id
        and l.timesheet_id is distinct from v_request.initial_timesheet_id
        and l.timesheet_id is distinct from v_request.current_timesheet_id),'[]'::jsonb)) is distinct from v_unrelated then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_UNRELATED_D1_CHANGED' using errcode='55000'; end if;
  v_signature:=public.timesheet_lifecycle_guard_signature_v1(v_request.current_timesheet_id,v_request.contract_week_id,false);
  if nullif(btrim(coalesce(v_signature->>'backend_row_signature',v_signature->>'row_signature',v_signature->>'signature')),'') is null then
    raise exception 'AGENCY_DRAFT_ROUND_TRIP_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000'; end if;
  return jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_DRAFT_ROUND_TRIP_RECEIPT_V1',
    'ok',true,'request_id',v_request.id,'step',v_step,'phase_actor_user_id',p_actor_user_id,
    'original_draft_invoice_id',v_invoice.id,'original_draft_invoice_no',v_invoice.invoice_no,
    'timesheet_id',v_request.current_timesheet_id,'financial_id',v_fin.id,'native_result',v_result,
    'unrelated_lines_sha256',encode(v_unrelated,'hex'),'native_line_plan',v_plan,
    'current_row_signature',btrim(coalesce(v_signature->>'backend_row_signature',v_signature->>'row_signature',v_signature->>'signature')));
exception when no_data_found or too_many_rows then
  raise exception 'AGENCY_DRAFT_ROUND_TRIP_NATIVE_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_draft_round_trip_v1(text,text,uuid) owner to postgres;
revoke all on function private.weekly_source_agency_draft_round_trip_v1(text,text,uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 16: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/14_58_agency_native_week_facts.sqlinc
-- Primary26.4: one factual whole-week derivation. No money, payment, rates,
-- validation mutation or readiness inferred from a queue/status/caller flag.
create or replace function private.weekly_source_agency_week_facts_v1(p_timesheet_id uuid)
returns jsonb language plpgsql stable security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare
 t public.timesheets%rowtype; w public.contract_weeks%rowtype; con public.contracts%rowtype;
 cycle public.weekly_source_cycles%rowtype; pub public.weekly_source_projection_publications%rowtype;
 upload public.weekly_source_uploads%rowtype; profile public.weekly_source_format_profiles%rowtype;
 rules jsonb; cycles uuid[]; records jsonb:='[]'; sources jsonb:='[]'; carried jsonb:='[]';
 coverage jsonb:='[]'; queries jsonb:='[]'; protections jsonb:='[]'; pairs jsonb:='[]'; pending jsonb:='[]';
 facts jsonb; checks jsonb; reasons text[]:='{}'; rec record; row_data record; item jsonb; source_item jsonb;
 incident record; response public.weekly_discrepancy_events%rowtype; protection record; pair record;
 chain jsonb; leg uuid; n integer; hit integer; event_id uuid; valid boolean; disputed boolean; wait_fact jsonb;
 coverage_ok boolean:=false; finalised_ok boolean:=true; queries_ok boolean:=true; matching_ok boolean:=true;
 records_ok boolean:=true; authorised_ok boolean:=true; decisions_ok boolean:=true; protection_ok boolean:=true;
begin
 if p_timesheet_id is null then raise exception 'AGENCY_INVOICE_TIMESHEET_REQUIRED' using errcode='22023';end if;
 select * into strict t from public.timesheets where timesheet_id=p_timesheet_id;
 select * into strict con from public.contracts where id=t.contract_id;
 select * into strict w from public.contract_weeks where timesheet_id=t.timesheet_id
  and contract_id=con.id and week_ending_date=t.week_ending_date and coalesce(additional_seq,0)=0 and not is_adjustment;
 if t.is_current is distinct from true or t.revoked_at is not null or t.archived_at_utc is not null
  or t.sheet_scope::text<>'WEEKLY' or t.line_type::text<>'HOURS'
  or private.weekly_source_agency_invoice_check_only_v1(t.timesheet_id) is distinct from true then
  raise exception 'AGENCY_INVOICE_TIMESHEET_ROTATED' using errcode='40001';end if;
 select array_agg(c.id order by c.id) into cycles from public.weekly_source_cycles c
  join public.weekly_source_groups g on g.id=c.source_group_id and g.active and g.source_family='ROSTER'
  join public.weekly_source_group_clients m on m.source_group_id=g.id and m.client_id=con.client_id
   and w.week_ending_date between m.valid_from and coalesce(m.valid_to,'infinity'::date)
  where c.finalisation_week_ending=w.week_ending_date and(c.scope_client_id is null or c.scope_client_id=con.client_id);
 if cardinality(cycles)>1 then select array_agg(c.id order by c.id) into cycles from public.weekly_source_cycles c
  where c.id=any(cycles) and c.scope_client_id=con.client_id;end if;
 if coalesce(cardinality(cycles),0)<>1 then raise exception 'AGENCY_INVOICE_SOURCE_CYCLE_AMBIGUOUS' using errcode='55000';end if;
 select * into strict cycle from public.weekly_source_cycles where id=cycles[1];
 rules:=private.weekly_source_effective_rule_set_v1(con.client_id,cycle.id);
 if rules#>>'{values,invoice_sender}' is distinct from 'AGENCY_INVOICE' then
  raise exception 'AGENCY_INVOICE_RULE_UNAVAILABLE' using errcode='55000';end if;
 select * into pub from public.weekly_source_projection_publications where id=cycle.current_projection_publication_id
  and source_cycle_id=cycle.id and state='CURRENT' and authority_scope_kind='CYCLE' and report_scope_id is null and correction_session_id is null;
 if pub.id is null then raise exception 'AGENCY_INVOICE_CURRENT_PUBLICATION_UNAVAILABLE' using errcode='55000';end if;
 perform private.weekly_source_query_current_publication_v1(cycle.id,pub.id);
 select * into strict upload from public.weekly_source_uploads where id=pub.upload_id and id=cycle.current_complete_upload_id
  and source_cycle_id=cycle.id and report_scope_id is null and state='CURRENT';
 if upload.blocked_count<>0 or upload.blocking_economic_duplicate_count<>0 or upload.malformed_count<>0 then
  raise exception 'AGENCY_INVOICE_SOURCE_MAPPING_UNAVAILABLE' using errcode='55000';end if;
 if exists(select 1 from public.weekly_source_upload_rows ur left join public.weekly_source_row_resolutions rr
  on rr.upload_row_id=ur.id and rr.generation=coalesce(pub.projection_generation,pub.authority_scope_version)
  where ur.upload_id=upload.id and ur.row_finalisation_state='SOURCE_WORKED'
   and ur.work_date between w.week_ending_date-6 and w.week_ending_date and rr.mapping_state is distinct from 'RESOLVED') then
  raise exception 'AGENCY_INVOICE_SOURCE_MAPPING_UNAVAILABLE' using errcode='55000';end if;
 select * into strict profile from public.weekly_source_format_profiles where id=upload.source_format_profile_id and active;
 if profile.profile_code is distinct from rules#>>'{values,checking_profile_kind}'
  or not((profile.final_authority_kind='HEALTHROSTER_ACTUAL_ROWS' and profile.row_finalisation_capability='FINALISED_ROW_ONLY')
    or(profile.profile_code='ROSTER_WEEKLY_SUMMARY_ACTUAL_V1' and profile.final_authority_kind='GENERIC_COMPLETE_SNAPSHOT'
      and profile.row_finalisation_capability='COMPLETE_FILE_ROWS')) then
  raise exception 'AGENCY_INVOICE_FINALISED_PROFILE_UNAVAILABLE' using errcode='55000';end if;
 -- COMPLETE is an actual accepted/ticked coverage witness. All seven days are
 -- tested before evaluating shifts; an export's absence of rows is not coverage.
 select coalesce(jsonb_agg(jsonb_build_object('publication_id',p.id,'upload_id',u.id,
  'upload_sha256',encode(u.content_sha256,'hex'),'start',u.confirmed_coverage_start_local_date,
  'end',u.confirmed_coverage_end_local_date,'confirmed_actor',u.coverage_confirmed_by_user_id,
  'confirmed_at',u.coverage_confirmed_at_utc) order by p.id),'[]') into coverage
 from public.weekly_source_projection_publications p join public.weekly_source_uploads u on u.id=p.upload_id
 where p.source_cycle_id=cycle.id and p.authority_scope_kind='CYCLE' and p.report_scope_id is null
  and p.state in('CURRENT','STALE') and p.published_at_utc is not null and p.correction_session_id is null
  and u.state in('CURRENT','SUPERSEDED') and u.coverage_state='COMPLETE' and u.coverage_timezone='Europe/London'
  and u.coverage_confirmed_by_user_id is not null and u.coverage_confirmed_at_utc is not null
  and coalesce(u.file_metadata_json->>'import_use','CHECKING')='CHECKING'
  and exists(select 1 from public.weekly_source_upload_attempts a where a.logical_upload_id=u.id and a.result='ACCEPTED')
  and (cycle.scope_client_id=con.client_id or exists(select 1 from public.weekly_source_row_resolutions rr
   join public.weekly_source_upload_rows ur on ur.id=rr.upload_row_id and ur.upload_id=u.id
   where rr.mapping_state='RESOLVED' and rr.client_id=con.client_id));
 coverage_ok:=not exists(select 1 from generate_series(0,6) day where not exists(
  select 1 from jsonb_array_elements(coverage) c where w.week_ending_date-day between (c->>'start')::date and(c->>'end')::date));
 -- This is the current native finalised tuple, not the worker's signed claim.
 for row_data in select rr.*,ur.work_date,ur.start_at_local,ur.end_at_local,ur.break_minutes,ur.actual_net_minutes,
  ur.row_finalisation_state,ur.finalised_by,ur.bounded_raw_columns_json,ur.normalised_row_hash,
  e.candidate_id event_candidate,e.client_id event_client,e.work_date event_date,e.first_source_group_id
  from public.weekly_source_row_resolutions rr join public.weekly_source_upload_rows ur on ur.id=rr.upload_row_id
  left join public.weekly_work_events e on e.id=rr.work_event_id
  where ur.upload_id=upload.id and rr.generation=coalesce(pub.projection_generation,pub.authority_scope_version)
   and rr.contract_id=con.id and rr.candidate_id=con.candidate_id and rr.client_id=con.client_id
   and ur.work_date between w.week_ending_date-6 and w.week_ending_date
  order by ur.work_date,ur.start_at_local,rr.id loop
  if row_data.row_finalisation_state='SOURCE_WORKED' then
   valid:=row_data.mapping_state='RESOLVED' and row_data.work_event_id is not null
    and row_data.event_candidate=con.candidate_id and row_data.event_client=con.client_id
    and row_data.event_date=row_data.work_date and row_data.first_source_group_id=cycle.source_group_id
    and row_data.start_at_local is not null and row_data.end_at_local>row_data.start_at_local
    and row_data.break_minutes is not null and row_data.actual_net_minutes>0
    and row_data.paid_minutes=row_data.actual_net_minutes
    and extract(epoch from(row_data.end_at_local-row_data.start_at_local))/60-row_data.break_minutes=row_data.actual_net_minutes
    and date_trunc('minute',row_data.start_at_local)=row_data.start_at_local
    and date_trunc('minute',row_data.end_at_local)=row_data.end_at_local
    and (profile.row_finalisation_capability<>'FINALISED_ROW_ONLY' or(nullif(btrim(row_data.finalised_by),'') is not null
     and row_data.finalised_by=row_data.bounded_raw_columns_json->>'finalised_by'));
   if valid is distinct from true then raise exception 'AGENCY_INVOICE_SOURCE_TUPLE_UNAVAILABLE' using errcode='55000';end if;
   if exists(select 1 from jsonb_array_elements(sources) s where s->>'work_event_id'=row_data.work_event_id::text) then
    raise exception 'AGENCY_INVOICE_SOURCE_EVENT_AMBIGUOUS' using errcode='55000';end if;
   sources:=sources||jsonb_build_array(jsonb_build_object('work_event_id',row_data.work_event_id,'upload_row_id',row_data.upload_row_id,
    'row_sha256',encode(row_data.normalised_row_hash,'hex'),'date',row_data.work_date,'start',to_char(row_data.start_at_local,'HH24:MI'),
    'end',to_char(row_data.end_at_local,'HH24:MI'),'end_date',row_data.end_at_local::date,'break_minutes',row_data.break_minutes));
  end if;
 end loop;
 -- Current native reversal/replacement units remain native units. A reversal
 -- is excluded from the positive records only with the real APPLIED request
 -- and a valid complete chain. Both native legs must actually be authorised.
 for pair in select r.* from private.timesheet_correction_requests r where r.contract_id=con.id
  and r.candidate_id=con.candidate_id and r.client_id=con.client_id and r.week_ending_date=w.week_ending_date
  and r.state='APPLIED' order by r.id loop
  chain:=public.timesheet_correction_chain_scope_v1(pair.replacement_timesheet_id,false,32,100);
  if chain->'valid' is distinct from 'true'::jsonb or chain#>'{requested_correction_unit,valid}' is distinct from 'true'::jsonb
   or jsonb_typeof(chain#>'{requested_correction_unit,member_ids}') is distinct from 'array'
   or not(chain#>'{requested_correction_unit,member_ids}' ? pair.replacement_timesheet_id::text)
   or not(chain#>'{requested_correction_unit,member_ids}' ? pair.reversal_timesheet_id::text) then
   raise exception 'AGENCY_INVOICE_NATIVE_PAIR_UNAVAILABLE' using errcode='55000';end if;
  for leg in select value::uuid from jsonb_array_elements_text(chain#>'{requested_correction_unit,member_ids}') loop
   if not exists(select 1 from public.timesheets x join public.timesheets_financials f on f.timesheet_id=x.timesheet_id
    and f.is_current and not f.is_stale and f.timesheet_version=x.version
    and f.candidate_id=con.candidate_id and f.client_id=con.client_id
    where x.timesheet_id=leg and x.is_current and x.revoked_at is null
    and x.authorised_at_server is not null and f.authorised_at_utc=x.authorised_at_server) then authorised_ok:=false;end if;
  end loop;
  pairs:=pairs||jsonb_build_array(jsonb_build_object('request_id',pair.id,'state_revision',pair.state_revision,
   'reversed_timesheet_id',pair.reversed_timesheet_id,'reversal_timesheet_id',pair.reversal_timesheet_id,
   'replacement_timesheet_id',pair.replacement_timesheet_id,'member_ids',chain#>'{requested_correction_unit,member_ids}'));
 end loop;
 for rec in select x.*,cw.id week_id from public.contract_weeks cw join public.timesheets x on x.timesheet_id=cw.timesheet_id
  where cw.contract_id=con.id and cw.week_ending_date=w.week_ending_date and x.is_current and x.archived_at_utc is null
   and x.sheet_scope::text='WEEKLY' and x.line_type::text='HOURS'
   and not exists(select 1 from jsonb_array_elements(pairs) p where x.timesheet_id::text in(p->>'reversed_timesheet_id',p->>'reversal_timesheet_id'))
  order by x.timesheet_id loop
  if jsonb_typeof(rec.actual_schedule_json) is distinct from 'array' then
   raise exception 'AGENCY_INVOICE_RECORD_SCHEDULE_UNAVAILABLE' using errcode='55000';end if;
  if jsonb_array_length(rec.actual_schedule_json)=0 then continue;end if; -- empty P0 is not invoiceable
  if rec.revoked_at is not null or rec.authorised_at_server is null then authorised_ok:=false;end if;
  if (select count(*) from public.timesheets_financials f where f.timesheet_id=rec.timesheet_id and f.is_current and not f.is_stale
    and f.timesheet_version=rec.version and f.authorised_at_utc is not distinct from rec.authorised_at_server
    and f.candidate_id=con.candidate_id and f.client_id=con.client_id and f.actual_schedule_json is not distinct from rec.actual_schedule_json)<>1 then authorised_ok:=false;end if;
  records:=records||jsonb_build_array(jsonb_build_object('timesheet_id',rec.timesheet_id,'timesheet_version',rec.version,
   'contract_week_id',rec.week_id,'authorised_at_server',rec.authorised_at_server,'revoked_at',rec.revoked_at,'schedule',rec.actual_schedule_json));
  for item in select value from jsonb_array_elements(rec.actual_schedule_json) loop
   if jsonb_typeof(item) is distinct from 'object' or jsonb_typeof(item->'work_event_id') is distinct from 'string'
    or coalesce(item->>'work_event_id','')!~'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' then
    raise exception 'AGENCY_INVOICE_RECORD_EVENT_UNBOUND' using errcode='55000';end if;
   event_id:=(item->>'work_event_id')::uuid;
   select count(*) into hit from jsonb_array_elements(sources) s where s->>'work_event_id'=event_id::text;
   if hit<>1 then finalised_ok:=false;matching_ok:=false;else
    select value into strict source_item from jsonb_array_elements(sources) s(value) where value->>'work_event_id'=event_id::text;
    if item->>'date' is distinct from source_item->>'date' or item->>'start' is distinct from source_item->>'start'
     or item->>'end' is distinct from source_item->>'end' or item->>'end_date' is distinct from source_item->>'end_date'
     or (item->>'break_minutes')::integer is distinct from(source_item->>'break_minutes')::integer then matching_ok:=false;end if;
   end if;
   carried:=carried||jsonb_build_array(jsonb_build_object('work_event_id',event_id,'timesheet_id',rec.timesheet_id));
  end loop;
 end loop;
 if exists(select 1 from jsonb_array_elements(carried) r group by r->>'work_event_id' having count(*)<>1)
  or exists(select 1 from jsonb_array_elements(sources) s where not exists(select 1 from jsonb_array_elements(carried) r
   where r->>'work_event_id'=s->>'work_event_id')) or jsonb_array_length(carried)<>jsonb_array_length(sources) then records_ok:=false;end if;
 -- Only a genuine pre-authorisation worker dispute on a finalised carried
 -- shift can hold invoicing. Reminders and unprotected absent/unfinalised
 -- subjects are deliberately outside this predicate.
 for incident in select i.id incident_id,i.work_event_id,i.episode_number,i.candidate_action_state,
  x.id comparison_id,x.incident_id comparison_incident_id,x.contract_id comparison_contract_id,x.issue_family,
  x.revision_number,x.projection_publication_id,x.material_comparison_fingerprint,
  x.candidate_start_at_local,x.candidate_end_at_local,x.candidate_break_minutes,
  x.system_start_at_local,x.system_end_at_local,x.system_break_minutes from public.weekly_discrepancy_incidents i
  left join public.weekly_issue_comparison_revisions x on x.id=i.current_comparison_revision_id
  where i.source_group_id=cycle.source_group_id and i.source_cycle_id=cycle.id and i.candidate_id=con.candidate_id
   and i.client_id=con.client_id and i.state='OPEN'
   and exists(select 1 from jsonb_array_elements(carried) r where r->>'work_event_id'=i.work_event_id::text)
  order by i.id loop
  if incident.comparison_id is null or incident.comparison_incident_id is distinct from incident.incident_id
   or incident.comparison_contract_id is distinct from con.id
   or incident.revision_number is distinct from(select max(revision_number) from public.weekly_issue_comparison_revisions where incident_id=incident.incident_id)
   or incident.projection_publication_id is distinct from pub.id then raise exception 'AGENCY_INVOICE_QUERY_EVIDENCE_UNAVAILABLE' using errcode='55000';end if;
  if incident.issue_family<>'SOURCE_HOURS_DIFFER' then continue;end if;
  response:=null;select * into response from public.weekly_discrepancy_events e where e.incident_id=incident.incident_id
   and e.issue_episode=incident.episode_number and e.event_kind='CANDIDATE_RESPONDED' and e.actor_kind='CANDIDATE'
   order by e.occurred_at_utc desc,e.id desc limit 1;
  disputed:=false;
  if response.id is not null then
   if response.expected_comparison_fingerprint is distinct from incident.material_comparison_fingerprint
    or response.projection_publication_id is distinct from pub.id
    or response.bounded_payload_json->>'choice' is null
    or response.bounded_payload_json->>'choice' not in('CANDIDATE_WRONG','CANDIDATE_CORRECT','NEITHER_CORRECT') then
    raise exception 'AGENCY_INVOICE_QUERY_RESPONSE_UNAVAILABLE' using errcode='55000';end if;
   if incident.candidate_start_at_local is null or incident.candidate_end_at_local is null
    or incident.candidate_break_minutes is null or incident.system_start_at_local is null
    or incident.system_end_at_local is null or incident.system_break_minutes is null then
    raise exception 'AGENCY_INVOICE_QUERY_TUPLE_UNAVAILABLE' using errcode='55000';end if;
   disputed:=response.bounded_payload_json->>'choice' in('CANDIDATE_CORRECT','NEITHER_CORRECT')
    and extract(epoch from(incident.system_end_at_local-incident.system_start_at_local))/60-incident.system_break_minutes
      <=extract(epoch from(incident.candidate_end_at_local-incident.candidate_start_at_local))/60-incident.candidate_break_minutes
    and exists(
    select 1 from jsonb_array_elements(records) r join jsonb_array_elements(carried) a
     on a->>'timesheet_id'=r->>'timesheet_id' and a->>'work_event_id'=incident.work_event_id::text
     where (r->>'authorised_at_server')::timestamptz is null
      or response.occurred_at_utc<=(r->>'authorised_at_server')::timestamptz);
  elsif incident.candidate_action_state='RESPONDED' then raise exception 'AGENCY_INVOICE_QUERY_RESPONSE_UNAVAILABLE' using errcode='55000';end if;
  if disputed then queries_ok:=false;end if;
  queries:=queries||jsonb_build_array(jsonb_build_object('incident_id',incident.incident_id,'comparison_id',incident.comparison_id,
   'comparison_fingerprint',encode(incident.material_comparison_fingerprint,'hex'),'response_id',response.id,'disputed',disputed));
 end loop;
 -- Existing Source WAIT remains a genuine native receipt, distinct from the
 -- planned check-only intent. No event status alone establishes qualified WAIT.
 for protection in select family.root_timesheet_id,e.id event_id,e.durable_work_event_id
  from public.weekly_exceptional_pay_target_families family
  join public.weekly_exceptional_pay_family_events e on e.family_id=family.id
  where family.contract_id=con.id and family.candidate_id=con.candidate_id
   and family.week_ending_date=w.week_ending_date and e.state='WAIT'
   and e.event_sequence=(select max(tail.event_sequence) from public.weekly_exceptional_pay_family_events tail
    where tail.family_id=family.id and tail.durable_work_event_id=e.durable_work_event_id) order by e.id loop
  wait_fact:=private.weekly_source_protected_wait_receipt_v1(protection.root_timesheet_id,protection.event_id);
  if jsonb_typeof(wait_fact) is distinct from 'object' then
   raise exception 'AGENCY_INVOICE_QUALIFIED_WAIT_EVIDENCE_UNAVAILABLE' using errcode='55000';end if;
  protection_ok:=false;reasons:=array_append(reasons,'PROTECTED_SHIFT_WAITING');
  protections:=protections||jsonb_build_array(jsonb_build_object('native_wait_event_id',protection.event_id,
   'work_event_id',protection.durable_work_event_id,'qualified_receipt',wait_fact));
 end loop;
 select coalesce(jsonb_agg(jsonb_build_object('request_id',r.id,'state_revision',r.state_revision) order by r.id),'[]') into pending
  from private.timesheet_correction_requests r where r.contract_id=con.id and r.candidate_id=con.candidate_id
   and r.client_id=con.client_id and r.week_ending_date=w.week_ending_date and r.state='WAITING';
 decisions_ok:=jsonb_array_length(pending)=0 and not exists(select 1 from private.weekly_source_manual_reviews r
  where r.contract_id=con.id and r.candidate_id=con.candidate_id and r.client_id=con.client_id
   and r.work_date between w.week_ending_date-6 and w.week_ending_date and r.state='OPEN'
   and exists(select 1 from jsonb_array_elements(carried) event where event->>'work_event_id'=r.work_event_id::text));
 for protection in select p.* from private.weekly_source_check_only_shift_protections p where p.candidate_id=con.candidate_id
  and p.contract_id=con.id and p.client_id=con.client_id and p.week_ending_date=w.week_ending_date and p.state='ACTIVE' order by p.id loop
  select count(*) into hit from jsonb_array_elements(sources) s where s->>'work_event_id'=protection.work_event_id::text;
  if hit=0 then protection_ok:=false;reasons:=array_append(reasons,'PROTECTED_SHIFT_WAITING');else
   select value into strict source_item from jsonb_array_elements(sources) s(value) where s->>'work_event_id'=protection.work_event_id::text;
   if protection.protected_start_at_local is distinct from(source_item->>'date')::date+(source_item->>'start')::time
    or protection.protected_end_at_local is distinct from(source_item->>'end_date')::date+(source_item->>'end')::time
    or protection.protected_break_minutes is distinct from(source_item->>'break_minutes')::integer then
    protection_ok:=false;reasons:=array_append(reasons,'PROTECTED_HOURS_DIFFER');end if;
  end if;
  protections:=protections||jsonb_build_array(jsonb_build_object('id',protection.id,'version',protection.version,'work_event_id',protection.work_event_id,
   'start',protection.protected_start_at_local,'end',protection.protected_end_at_local,'break_minutes',protection.protected_break_minutes));
 end loop;
 if not coverage_ok then reasons:=array_prepend('COVERAGE_MISSING',reasons);end if;
 if not finalised_ok then reasons:=array_append(reasons,'NOT_FINALISED');end if;
 if not queries_ok then reasons:=array_append(reasons,'QUERY_UNRESOLVED');end if;
 if not matching_ok then reasons:=array_append(reasons,'HOURS_DIFFER');end if;
 if not records_ok then reasons:=array_append(reasons,'RECORDS_NOT_ALIGNED');end if;
 if not authorised_ok then reasons:=array_append(reasons,'NOT_AUTHORISED');end if;
 if not decisions_ok then reasons:=array_append(reasons,'CORRECTION_PENDING');end if;
 checks:=jsonb_build_object('coverage',coverage_ok,'finalised',finalised_ok,'pre_authorisation_queries',queries_ok,'matching',matching_ok,
  'records_equal_source',records_ok,'authorised_units',authorised_ok,'no_pending_decision',decisions_ok,'protected_resolved',protection_ok);
 facts:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_NATIVE_WEEK_FACTS_V1','main_timesheet_id',t.timesheet_id,
  'main_contract_week_id',w.id,'contract_id',con.id,'candidate_id',con.candidate_id,'client_id',con.client_id,'week_ending',w.week_ending_date,
  'source_cycle_id',cycle.id,'source_group_id',cycle.source_group_id,'publication_id',pub.id,'upload_id',upload.id,
  'rule_set_version_id',rules->'rule_set_version_id','coverage',coverage,'finalised_source',sources,'records',records,
  'pairs',pairs,'queries',queries,'pending_corrections',pending,'protections',protections,'conditions',checks,'reasons',to_jsonb(reasons));
 if jsonb_array_length(records)>100 or jsonb_array_length(sources)>100 or octet_length(facts::text)>2097152 then
  raise exception 'AGENCY_INVOICE_WEEK_FACTS_BOUND_EXCEEDED' using errcode='54000';end if;
 return facts||jsonb_build_object('complete',cardinality(reasons)=0,'facts_hash',encode(private.weekly_source_sha256_jsonb_v1(
  'WEEKLY_SOURCE_AGENCY_NATIVE_WEEK_FACTS_V1',facts),'hex'));
exception when no_data_found or too_many_rows then raise exception 'AGENCY_INVOICE_WEEK_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_week_facts_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_week_facts_v1(uuid) from public,anon,authenticated,service_role;

create or replace function private.weekly_source_agency_week_complete_v1(p_timesheet_id uuid)
returns table(complete boolean,reasons text[],facts_hash text) language sql stable security definer
set search_path to 'pg_catalog','private','pg_temp'
as $function$
 select (f->>'complete')::boolean,array(select jsonb_array_elements_text(f->'reasons')),f->>'facts_hash'
 from(select private.weekly_source_agency_week_facts_v1(p_timesheet_id) f) s;
$function$;
alter function private.weekly_source_agency_week_complete_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_week_complete_v1(uuid) from public,anon,authenticated,service_role;


-- Exact selected runtime component 17: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/15_73_complete_sole_writer_with_superseded_override_retirement.sqlinc
-- One writer in the existing store. The existing AFTER validation wakeup is
-- retained, including its actual CONTEXT_CHANGED queue and locked-row skip.
create or replace function public.weekly_source_agency_week_validation_refresh_v1(
 p_timesheet_id uuid,p_publication_id uuid
) returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare facts jsonb; item jsonb; target uuid; native_actor uuid; validation public.timesheet_validations%rowtype;
 actor public.tms_users%rowtype; written jsonb:='[]'; status_value public.validation_status_enum; reason_value text;
 r private.weekly_source_agency_timesheet_change_requests%rowtype; queue public.ts_financials_outbox%rowtype;
 fin public.timesheets_financials%rowtype; sig jsonb; signature text; receipt jsonb; result jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'AGENCY_CHANGE_READ_COMMITTED_REQUIRED' using errcode='25001';end if;
 facts:=private.weekly_source_agency_week_facts_v1(p_timesheet_id);
 if p_publication_id is null or facts->>'publication_id' is distinct from p_publication_id::text then
  raise exception 'AGENCY_INVOICE_VALIDATION_PUBLICATION_STALE' using errcode='40001';end if;
 -- The validating actor is an actual native approval actor, or the immutable
 -- accepted upload actor for a not-yet-authorised week. It is not a caller field.
 select coalesce(f.authorised_by_user_id,u.uploaded_by_user_id) into strict native_actor
 from public.timesheets t join public.weekly_source_uploads u on u.id=(facts->>'upload_id')::uuid
 left join public.timesheets_financials f on f.timesheet_id=t.timesheet_id and f.is_current and f.timesheet_version=t.version
 where t.timesheet_id=p_timesheet_id;
 select * into strict actor from public.tms_users where id=native_actor;
 status_value:=case when facts->'complete'='true'::jsonb then 'VALIDATION_OK'::public.validation_status_enum
  else 'VALIDATION_ERROR'::public.validation_status_enum end;
 reason_value:=case when status_value='VALIDATION_OK' then null else facts#>>'{reasons,0}' end;
 if status_value='VALIDATION_ERROR' and nullif(reason_value,'') is null then
  raise exception 'AGENCY_INVOICE_VALIDATION_REASON_UNAVAILABLE' using errcode='55000';end if;
 for item in select value from jsonb_array_elements(facts->'records') loop
  target:=(item->>'timesheet_id')::uuid;
  perform 1 from public.timesheets t where t.timesheet_id=target and t.is_current
   and t.version=(item->>'timesheet_version')::integer for update;
  if not found then raise exception 'AGENCY_INVOICE_TIMESHEET_ROTATED' using errcode='40001';end if;
  insert into public.timesheet_validations(id,timesheet_id,booking_id,status,reason_code,validated_at_utc,last_source,
   created_at,updated_at,pre_validated,validation_source_kind,validation_source_publication_id,
   validation_source_facts_sha256,validation_source_actor_user_id)
  select gen_random_uuid(),t.timesheet_id,t.booking_id,status_value,reason_value,transaction_timestamp(),null,
   transaction_timestamp(),transaction_timestamp(),false,'AGENCY_INVOICE_WEEK',p_publication_id,
   decode(facts->>'facts_hash','hex'),native_actor from public.timesheets t where t.timesheet_id=target
  on conflict(timesheet_id) do update set status=excluded.status,reason_code=excluded.reason_code,
   validated_at_utc=excluded.validated_at_utc,last_source=null,updated_at=excluded.updated_at,pre_validated=false,
   override_requested_at_utc=null,override_requested_by=null,override_confirmed_at_utc=null,override_confirmed_by=null,
   override_reason=null,override_cleared_at_utc=case when timesheet_validations.override_reason is not null
    then transaction_timestamp() else timesheet_validations.override_cleared_at_utc end,
   validation_source_kind=excluded.validation_source_kind,validation_source_publication_id=excluded.validation_source_publication_id,
   validation_source_facts_sha256=excluded.validation_source_facts_sha256,validation_source_actor_user_id=excluded.validation_source_actor_user_id
  where (timesheet_validations.status,timesheet_validations.reason_code,timesheet_validations.pre_validated,
   timesheet_validations.validation_source_kind,timesheet_validations.validation_source_publication_id,
   timesheet_validations.validation_source_facts_sha256,timesheet_validations.validation_source_actor_user_id)
   is distinct from(excluded.status,excluded.reason_code,false,excluded.validation_source_kind,
    excluded.validation_source_publication_id,excluded.validation_source_facts_sha256,excluded.validation_source_actor_user_id)
  returning * into validation;
  if not found then select * into strict validation from public.timesheet_validations where timesheet_id=target;end if;
  written:=written||jsonb_build_array(jsonb_build_object('timesheet_id',target,'validation_id',validation.id,'status',validation.status,
   'reason_code',validation.reason_code,'updated_at',validation.updated_at));
 end loop;
 result:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_VALIDATION_REFRESH_V1','main_timesheet_id',p_timesheet_id,
  'publication_id',p_publication_id,'facts_hash',facts->>'facts_hash','complete',facts->'complete','reasons',facts->'reasons',
  'validation_actor_user_id',native_actor,'written',written);
 select * into r from private.weekly_source_agency_timesheet_change_requests where current_timesheet_id=p_timesheet_id and state='ACTIVE';
 if found and r.phase='AUTHORISED' then
  if r.source_publication_id is distinct from p_publication_id or r.source_cas is distinct from
    private.weekly_source_bulk_source_cas_v1(r.source_cycle_id,array[r.client_id]) then
   raise exception 'AGENCY_CHANGE_ORIGINAL_SOURCE_CAS_CHANGED' using errcode='40001';end if;
  select * into strict fin from public.timesheets_financials where id=r.current_financial_id and is_current;
  if fin.timesheet_id is distinct from r.current_timesheet_id or fin.timesheet_version is distinct from r.current_timesheet_version
   or fin.authorised_by_user_id::text is distinct from r.native_receipts#>>'{authorise,phase_actor_user_id}'
   or fin.authorised_at_utc is distinct from(r.native_receipts#>>'{authorise,authorised_at_server}')::timestamptz then
   raise exception 'AGENCY_CHANGE_GENUINE_AUTHORISE_RECEIPT_REQUIRED' using errcode='55000';end if;
  select * into strict validation from public.timesheet_validations where timesheet_id=p_timesheet_id;
  -- Do not enqueue anew from a successful validation replay. A real retained
  -- post-write receipt for this current row remains a genuine completed queue.
  if r.native_receipts#>>'{validation_recompute,financial_id}' is distinct from fin.id::text
   or r.native_receipts#>>'{validation_recompute,facts_sha256}' is distinct from facts->>'facts_hash' then
   select * into queue from public.ts_financials_outbox where timesheet_id=p_timesheet_id and reason='CONTEXT_CHANGED';
   if not found then
    perform public.enqueue_ts_financials_priority(array[p_timesheet_id],'CONTEXT_CHANGED'::public.ts_fin_reason_enum);
    select * into strict queue from public.ts_financials_outbox where timesheet_id=p_timesheet_id and reason='CONTEXT_CHANGED';
   end if;
   sig:=public.timesheet_lifecycle_guard_signature_v1(p_timesheet_id,r.contract_week_id,false);
   signature:=nullif(btrim(coalesce(sig->>'backend_row_signature',sig->>'row_signature',sig->>'signature')),'');
   if signature is null then raise exception 'AGENCY_CHANGE_NATIVE_SIGNATURE_UNAVAILABLE' using errcode='55000';end if;
   receipt:=result||jsonb_build_object('request_id',r.id,'request_sha256',encode(r.request_sha256,'hex'),
    'timesheet_version',r.current_timesheet_version,'financial_id',fin.id,'outbox_id',queue.id,'outbox_reason',queue.reason,
    'validation_row_sha256',encode(private.weekly_source_sha256_jsonb_v1('AGENCY_NATIVE_TYPED_VALIDATION_ROW_V1',to_jsonb(validation)),'hex'),
    'transaction_id',pg_current_xact_id()::text,'backend_pid',pg_backend_pid());
   update private.weekly_source_agency_timesheet_change_requests set native_receipts=native_receipts||jsonb_build_object('validation_refresh',receipt),
    outbox_id=queue.id,outbox_reason=queue.reason,current_row_signature=signature,version=version+1,updated_at_utc=transaction_timestamp()
    where id=r.id;
  end if;
 end if;
 -- Superseded positive originals and native reversal legs are not additional
 -- invoiceable records. They retain an explicit error in this SAME store.
 for target in select distinct id::uuid from jsonb_array_elements(facts->'pairs') p
  cross join lateral unnest(array[p->>'reversed_timesheet_id',p->>'reversal_timesheet_id']) id loop
  -- Preserve the actual retired override in the native audit before clearing
  -- current authority. An old LEGACY override never authorises this typed row.
  select * into validation from public.timesheet_validations where timesheet_id=target for update;
  if found and (validation.override_requested_at_utc is not null or validation.override_requested_by is not null
    or validation.override_confirmed_at_utc is not null or validation.override_confirmed_by is not null
    or validation.override_reason is not null) then
   insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,action,before_json,after_json,reason)
   values(gen_random_uuid(),transaction_timestamp(),native_actor,actor.role,'timesheet_validation',target::text,
    'AGENCY_SUPERSEDED_VALIDATION_OVERRIDE_RETIRED',
    jsonb_build_object('validation_id',validation.id,'validation_source_kind',validation.validation_source_kind,
     'status',validation.status,'override_requested_at_utc',validation.override_requested_at_utc,
     'override_requested_by',validation.override_requested_by,'override_confirmed_at_utc',validation.override_confirmed_at_utc,
     'override_confirmed_by',validation.override_confirmed_by,'override_reason',validation.override_reason,
     'override_cleared_at_utc',validation.override_cleared_at_utc),
    jsonb_build_object('validation_source_kind','AGENCY_INVOICE_WEEK','status','VALIDATION_ERROR',
     'reason_code','SUPERSEDED_BY_CORRECTION','publication_id',p_publication_id),
    'SUPERSEDED_BY_CORRECTION');
  end if;
  update public.timesheet_validations set status='VALIDATION_ERROR',reason_code='SUPERSEDED_BY_CORRECTION',
   validated_at_utc=transaction_timestamp(),pre_validated=false,last_source=null,updated_at=transaction_timestamp(),
   override_requested_at_utc=null,override_requested_by=null,override_confirmed_at_utc=null,override_confirmed_by=null,
   override_reason=null,override_cleared_at_utc=case when override_requested_at_utc is not null or override_requested_by is not null
    or override_confirmed_at_utc is not null or override_confirmed_by is not null or override_reason is not null
    then transaction_timestamp() else override_cleared_at_utc end,
   validation_source_kind='AGENCY_INVOICE_WEEK',validation_source_publication_id=p_publication_id,
   validation_source_facts_sha256=decode(facts->>'facts_hash','hex'),validation_source_actor_user_id=native_actor
   where timesheet_id=target;
 end loop;
 insert into public.audit_events(id,ts_utc,actor_user_id,actor_role_at_time,object_type,object_id_text,action,after_json,reason,correlation_id)
 values(gen_random_uuid(),transaction_timestamp(),native_actor,actor.role,'WEEKLY_SOURCE_AGENCY_VALIDATION',p_timesheet_id::text,
  'NATIVE_WHOLE_WEEK_VALIDATION_REFRESHED',jsonb_build_object('publication_id',p_publication_id,'facts_hash',facts->>'facts_hash',
   'complete',facts->'complete','written',written,'native_actor_source','ACTUAL_AUTHORISE_OR_ACCEPTED_UPLOAD'),reason_value,null);
 return result;
exception when no_data_found or too_many_rows then raise exception 'AGENCY_INVOICE_VALIDATION_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function public.weekly_source_agency_week_validation_refresh_v1(uuid,uuid) owner to postgres;
revoke all on function public.weekly_source_agency_week_validation_refresh_v1(uuid,uuid) from public,anon,authenticated;
grant execute on function public.weekly_source_agency_week_validation_refresh_v1(uuid,uuid) to service_role;

-- All legacy/reference/override paths ultimately write this existing table.
-- Preserve non-preset writes and native deletes. A preset status can only carry
-- rederived typed native completeness; old Mode A and every override refuse.
create or replace function private.weekly_source_agency_validation_source_guard_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare main_id uuid; facts jsonb; reason_value text; actor_id uuid; expected_status text;
begin
 if tg_op='DELETE' then return old;end if;
 if private.weekly_source_agency_invoice_check_only_v1(new.timesheet_id) is distinct from true
  and new.validation_source_kind='LEGACY' then return new;end if;
 if new.status::text in('OVERRIDDEN','OVERRIDE_AWAITING_CONFIRM') then
  raise exception 'AGENCY_INVOICE_VALIDATION_OVERRIDE_FORBIDDEN' using errcode='55000';end if;
 if new.override_requested_at_utc is not null or new.override_requested_by is not null
  or new.override_confirmed_at_utc is not null or new.override_confirmed_by is not null or new.override_reason is not null then
  raise exception 'AGENCY_INVOICE_VALIDATION_OVERRIDE_FORBIDDEN' using errcode='55000';end if;
 if new.validation_source_kind is distinct from 'AGENCY_INVOICE_WEEK' or new.last_source is not null then
  raise exception 'AGENCY_INVOICE_USES_COMPLETENESS_WRITER' using errcode='55000';end if;
 select cw.timesheet_id into strict main_id from public.timesheets t join public.contract_weeks cw
  on cw.contract_id=t.contract_id and cw.week_ending_date=t.week_ending_date and coalesce(cw.additional_seq,0)=0 and not cw.is_adjustment
  where t.timesheet_id=new.timesheet_id;
 facts:=private.weekly_source_agency_week_facts_v1(main_id);
 expected_status:=case when facts->'complete'='true'::jsonb then 'VALIDATION_OK' else 'VALIDATION_ERROR' end;
 reason_value:=case when expected_status='VALIDATION_OK' then null else facts#>>'{reasons,0}' end;
 if exists(select 1 from jsonb_array_elements(facts->'pairs') p where new.timesheet_id::text in
  (p->>'reversed_timesheet_id',p->>'reversal_timesheet_id')) then expected_status:='VALIDATION_ERROR';reason_value:='SUPERSEDED_BY_CORRECTION';end if;
 select coalesce(f.authorised_by_user_id,u.uploaded_by_user_id) into strict actor_id
  from public.timesheets t join public.weekly_source_uploads u on u.id=(facts->>'upload_id')::uuid
  left join public.timesheets_financials f on f.timesheet_id=t.timesheet_id and f.is_current and f.timesheet_version=t.version
  where t.timesheet_id=main_id;
 if new.validation_source_publication_id::text is distinct from facts->>'publication_id'
  or new.validation_source_facts_sha256 is distinct from decode(facts->>'facts_hash','hex')
  or new.validation_source_actor_user_id is distinct from actor_id or new.status::text is distinct from expected_status
  or new.reason_code is distinct from reason_value or new.pre_validated is distinct from false
  or new.validated_at_utc is distinct from transaction_timestamp() then
  raise exception 'AGENCY_INVOICE_GENUINE_COMPLETENESS_REQUIRED' using errcode='55000';end if;
 return new;
exception when no_data_found or too_many_rows then raise exception 'AGENCY_INVOICE_VALIDATION_SCOPE_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_validation_source_guard_v1() owner to postgres;
revoke all on function private.weekly_source_agency_validation_source_guard_v1() from public,anon,authenticated,service_role;
drop trigger if exists weekly_source_agency_validation_source_guard_v1 on public.timesheet_validations;
create trigger weekly_source_agency_validation_source_guard_v1 before insert or update on public.timesheet_validations
 for each row execute function private.weekly_source_agency_validation_source_guard_v1();


-- Exact selected runtime component 18: 38964e6acf7e0d10af9cfbc223a9bb251a4dadfd:docs/healthroster-build/proposals/agency-current-source-callers-lifecycle-module-20261015/callers/16_60_agency_authorised_validation_context.sqlinc
-- The actual canonical Worker reads its existing native inputs under the
-- genuine authorised request. Nothing here authorises from a status alone.
create or replace function private.weekly_source_agency_validation_context_v1(p_request_id uuid)
returns jsonb language plpgsql volatile security definer
set search_path to 'pg_catalog','public','private','pg_temp'
as $function$
declare r private.weekly_source_agency_timesheet_change_requests%rowtype;
 t public.timesheets%rowtype; f public.timesheets_financials%rowtype; q public.ts_financials_outbox%rowtype;
 v public.timesheet_validations%rowtype; facts jsonb; context jsonb; weekly jsonb; shifts jsonb; frame jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 select * into strict r from private.weekly_source_agency_timesheet_change_requests where id=p_request_id;
 r:=private.weekly_source_agency_change_request_assert_v1(r.contract_week_id,r.reason,r.initial_row_signature,r.request_key,r.updated_by_user_id);
 if r.state<>'ACTIVE' or r.phase<>'AUTHORISED' then raise exception 'AGENCY_CHANGE_VALIDATION_PHASE_NOT_READY' using errcode='55000';end if;
 select * into strict t from public.timesheets where timesheet_id=r.current_timesheet_id;
 select * into strict f from public.timesheets_financials where id=r.current_financial_id and is_current;
 select * into strict v from public.timesheet_validations where timesheet_id=t.timesheet_id;
 select * into strict q from public.ts_financials_outbox where id=r.outbox_id;
 facts:=private.weekly_source_agency_week_facts_v1(t.timesheet_id);
 if t.is_current is distinct from true or t.version is distinct from r.current_timesheet_version
  or t.authorised_at_server is null or t.revoked_at is not null or f.timesheet_version is distinct from t.version
  or f.authorised_at_utc is distinct from t.authorised_at_server
  or f.authorised_by_user_id::text is distinct from r.native_receipts#>>'{authorise,phase_actor_user_id}'
  or (r.native_receipts#>>'{authorise,authorised_at_server}')::timestamptz is distinct from t.authorised_at_server
  or f.paid_at_utc is not null or f.locked_by_invoice_id is not null
  or exists(select 1 from public.invoice_lines where timesheet_id=t.timesheet_id)
  or t.actual_schedule_json is distinct from r.native_receipts#>'{original_capture,schedule}'
  or f.actual_schedule_json is distinct from t.actual_schedule_json
  or q.timesheet_id is distinct from t.timesheet_id or q.reason is distinct from 'CONTEXT_CHANGED'::public.ts_fin_reason_enum
  or r.outbox_reason is distinct from q.reason or q.attempt_count<1 or q.next_attempt_at is null
  or q.next_attempt_at<=transaction_timestamp() or v.validation_source_kind is distinct from 'AGENCY_INVOICE_WEEK'
  or v.last_source is not null or v.pre_validated or v.validation_source_publication_id is distinct from r.source_publication_id
  or v.status::text not in('VALIDATION_OK','VALIDATION_ERROR') or encode(v.validation_source_facts_sha256,'hex') is distinct from facts->>'facts_hash'
  or facts->>'publication_id' is distinct from r.source_publication_id::text
  or r.native_receipts#>>'{validation_refresh,request_id}' is distinct from r.id::text
  or r.native_receipts#>>'{validation_refresh,outbox_id}' is distinct from q.id::text
  or r.native_receipts#>>'{validation_refresh,financial_id}' is distinct from f.id::text
  or r.native_receipts#>>'{validation_refresh,facts_hash}' is distinct from facts->>'facts_hash'
  or r.native_receipts#>>'{validation_refresh,validation_row_sha256}' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
   'AGENCY_NATIVE_TYPED_VALIDATION_ROW_V1',to_jsonb(v)),'hex') then
  raise exception 'AGENCY_CHANGE_GENUINE_VALIDATION_CONTEXT_REQUIRED' using errcode='55000';end if;
 select to_jsonb(x) into strict context from public.tsfin_load_context_batch(array[t.timesheet_id]) x where x.effective_timesheet_id=t.timesheet_id;
 select to_jsonb(x) into strict weekly from public.tsfin_load_weekly_context_batch(array[t.timesheet_id]) x where x.timesheet_id=t.timesheet_id;
 select x.shifts into strict shifts from public.tsfin_load_nhsp_shifts_batch(array[t.timesheet_id]) x where x.timesheet_id=t.timesheet_id;
 if context#>>'{out_timesheet,timesheet_id}' is distinct from t.timesheet_id::text or context#>>'{out_cur_fin,id}' is distinct from f.id::text
  or context#>>'{out_candidate,id}' is distinct from r.candidate_id::text or context->>'out_client_id' is distinct from r.client_id::text
  or weekly#>>'{out_cw,id}' is distinct from r.contract_week_id::text or weekly#>>'{out_contract,id}' is distinct from r.contract_id::text
  or jsonb_typeof(shifts) is distinct from 'array' or jsonb_array_length(shifts)>100 then
  raise exception 'AGENCY_CHANGE_NATIVE_CALCULATOR_CONTEXT_UNAVAILABLE' using errcode='55000';end if;
 frame:=jsonb_build_object('schema_version','WEEKLY_SOURCE_AGENCY_AUTHORISED_VALIDATION_CONTEXT_V1',
  'request_id',r.id,'request_sha256',encode(r.request_sha256,'hex'),'request_version',r.version,'phase',r.phase,
  'phase_actor_user_id',r.updated_by_user_id,'current_row_signature',r.current_row_signature,'source_cas',r.source_cas,
  'source_schedule',t.actual_schedule_json,'outbox_id',q.id,'outbox_reason',q.reason,'outbox_row',to_jsonb(q),
  'context',context,'weekly_context',weekly,'weekly_validation',to_jsonb(v),'nhsp_shifts',shifts,
  'week_facts_sha256',facts->>'facts_hash','week_complete',facts->'complete','validation_actor_user_id',v.validation_source_actor_user_id);
 if octet_length(frame::text)>2097152 then raise exception 'AGENCY_CHANGE_WORKER_CONTEXT_BOUND_EXCEEDED' using errcode='54000';end if;
 return frame||jsonb_build_object('context_sha256',encode(private.weekly_source_sha256_jsonb_v1(
  'WEEKLY_SOURCE_AGENCY_AUTHORISED_VALIDATION_CONTEXT_V1',frame),'hex'));
exception when no_data_found or too_many_rows then raise exception 'AGENCY_CHANGE_NATIVE_VALIDATION_CONTEXT_UNAVAILABLE' using errcode='55000';
end;
$function$;
alter function private.weekly_source_agency_validation_context_v1(uuid) owner to postgres;
revoke all on function private.weekly_source_agency_validation_context_v1(uuid) from public,anon,authenticated,service_role;
