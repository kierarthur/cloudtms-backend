{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact paid-match question, verified by decodePaidMatchQuestion",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "WEEKLY_SOURCE_PAID_MATCH_QUESTION_V1"
        },
        "state": {
          "const": "READY"
        },
        "reason_code": {
          "type": "null"
        },
        "upload_row_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "upload_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "projection_publication_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "client_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "contract_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "expected_authority_scope_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Canonical positive PostgreSQL bigint decimal <= 9223372036854775807. The shared decoder enforces the upper bound without Number conversion."
        },
        "expected_row_manifest_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_paid_overlap_inputs_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "work_event_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
              },
              "work_date": {
                "type": "string",
                "format": "date"
              },
              "start": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "break_minutes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "contract_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
              },
              "same_allowed": {
                "type": "boolean",
                "description": "Exactly equals choice.contract_id === question.contract_id; shared decoder checks this relationship."
              }
            },
            "required": [
              "work_event_id",
              "work_date",
              "start",
              "end",
              "break_minutes",
              "contract_id",
              "same_allowed"
            ],
            "additionalProperties": false
          },
          "description": "Unique work_event_id; verified by shared decoder."
        }
      },
      "required": [
        "schema_version",
        "state",
        "reason_code",
        "upload_row_id",
        "upload_id",
        "projection_publication_id",
        "candidate_id",
        "client_id",
        "contract_id",
        "expected_authority_scope_version",
        "expected_row_manifest_hash",
        "expected_paid_overlap_inputs_sha256",
        "choices"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
