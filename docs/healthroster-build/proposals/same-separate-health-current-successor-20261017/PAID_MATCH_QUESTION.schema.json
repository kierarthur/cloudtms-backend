        "upload_row_id",
        "upload_id",
        "projection_publication_id",
        "candidate_id",
        "client_id",
        "contract_id",
        "expected_authority_scope_version",
        "expected_row_manifest_hash",
        "expected_paid_overlap_inputs_sha256",
