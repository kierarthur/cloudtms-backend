create or replace function private.weekly_source_paid_choice_revision_guard_v1()
returns trigger language plpgsql security definer
set search_path to 'pg_catalog','pg_temp'
as $function$
begin
  if tg_table_schema is distinct from 'public' or tg_table_name is distinct from 'weekly_source_final_revisions' then
    raise exception 'WEEKLY_SOURCE_PAID_CHOICE_REVISION_GUARD_TARGET_INVALID' using errcode='55000';end if;
  if tg_op='UPDATE' then
    if old.paid_overlap_choice_census is distinct from new.paid_overlap_choice_census then
      raise exception 'WEEKLY_SOURCE_PAID_CHOICE_REVISION_CENSUS_IMMUTABLE' using errcode='55000';end if;
    return new;
  elsif tg_op='DELETE' then
    if old.paid_overlap_choice_census is distinct from '{}'::jsonb then
      raise exception 'WEEKLY_SOURCE_PAID_CHOICE_REVISION_CENSUS_IMMUTABLE' using errcode='55000';end if;
    return old;
  elsif tg_op='TRUNCATE' then
    if exists(select 1 from public.weekly_source_final_revisions r where r.paid_overlap_choice_census is distinct from '{}'::jsonb) then
      raise exception 'WEEKLY_SOURCE_PAID_CHOICE_REVISION_CENSUS_IMMUTABLE' using errcode='55000';end if;
    return null;
  end if;
  raise exception 'WEEKLY_SOURCE_PAID_CHOICE_REVISION_GUARD_OPERATION_INVALID' using errcode='55000';
end;
$function$;
