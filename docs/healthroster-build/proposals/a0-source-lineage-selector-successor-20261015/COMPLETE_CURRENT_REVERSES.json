      "file": "04_native_source_footprint.sqlinc",
      "source_commit": "aad0dd848253abca76a4917765b8d20c4d128646",
      "source_path": "docs/healthroster-build/proposals/a0-source-native-footprint-construction-20261015/construction/01_native_source_footprint.sqlinc",
