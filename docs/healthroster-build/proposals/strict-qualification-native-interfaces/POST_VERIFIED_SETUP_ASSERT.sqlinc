-- The normalized OFF DTO is independently checked here before it is appended.
-- Raw artifact/native/control provenance is measured by the protected writer.
create or replace function private.weekly_source_post_verified_setup_artifact_assert_v1(p_artifact jsonb,p_execution jsonb)
returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare g public.weekly_source_groups%rowtype; c public.weekly_source_cycles%rowtype; a public.weekly_source_group_rule_assignments%rowtype;
  v public.weekly_source_rule_set_versions%rowtype; item jsonb; clients uuid[];
begin
  perform private.weekly_source_off_rule_setup_shape_assert_v1(p_artifact);
  if not private.weekly_source_qualification_closed_object_v1(p_artifact,array['schema_version','authorization_id','scope_id','release_id','source_commit','contract_sha256',
    'agency_id','source_group_id','source_cycle_id','setup_actor_user_id','journey_actor_user_id','purpose','week_ending','expires_at_utc','fixture_namespace',
    'fixture_manifest','assignment_id','assignment_version','assignment_sha256','rule_set_version_id','rule_values_sha256','original_source_cas','allowed_operations',
    'banking_install_receipt_sha256','security_receipt_sha256','source_effects_review_sha256','authorization_sha256'])
    or p_artifact->>'schema_version' is distinct from 'WEEKLY_SOURCE_OFF_RULE_TEST_AUTHORIZATION_V1'
    or p_artifact->>'release_id' is distinct from p_execution->>'release_id' or p_artifact->>'source_commit' is distinct from p_execution->>'source_commit'
    or p_artifact->>'contract_sha256' is distinct from p_execution->>'contract_sha256' or p_artifact->>'fixture_namespace' is distinct from 'WSQ_TEST_'
    or p_artifact->>'purpose' not in ('SOURCE_FIXTURE_SETUP','AUTOMATIC_JOURNEY')
    or p_artifact->>'authorization_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_OFF_RULE_TEST_AUTHORIZATION_V1',p_artifact-'authorization_sha256'),'hex')
    or exists(select 1 from unnest(array['authorization_id','scope_id','agency_id','source_group_id','source_cycle_id','setup_actor_user_id','journey_actor_user_id',
      'assignment_id','rule_set_version_id']) key where coalesce(p_artifact->>key,'') !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
    or exists(select 1 from unnest(array['contract_sha256','assignment_sha256','rule_values_sha256','banking_install_receipt_sha256','security_receipt_sha256','source_effects_review_sha256']) key
      where coalesce(p_artifact->>key,'') !~ '^[0-9a-f]{64}$')
    or coalesce(p_artifact->>'assignment_version','') !~ '^[1-9][0-9]*$'
    or (p_artifact->>'expires_at_utc')::timestamptz<=clock_timestamp()
    or (p_artifact->>'expires_at_utc')::timestamptz>clock_timestamp()+
      case when p_artifact->>'purpose'='SOURCE_FIXTURE_SETUP' then interval '14 days' else interval '2 hours' end then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SETUP_INVALID' using errcode='22023'; end if;
  perform private._weekly_source_settings_require_admin_v1((p_artifact->>'setup_actor_user_id')::uuid);
  select * into strict c from public.weekly_source_cycles where id=(p_artifact->>'source_cycle_id')::uuid;
  select * into strict g from public.weekly_source_groups where id=c.source_group_id and id=(p_artifact->>'source_group_id')::uuid
    and agency_id=(p_artifact->>'agency_id')::uuid and active and source_family='ROSTER' and environment='TEST';
  perform private._weekly_source_settings_deployment_v1(g.agency_id,g.environment);
  select * into strict a from public.weekly_source_group_rule_assignments where id=(p_artifact->>'assignment_id')::uuid and source_group_id=g.id
    and not feature_enabled and c.finalisation_week_ending between effective_from_week_ending and coalesce(effective_to_week_ending,'infinity'::date);
  select version.* into strict v from public.weekly_source_rule_set_versions version join public.weekly_source_rule_sets rules
    on rules.id=version.rule_set_id and rules.agency_id=g.agency_id and rules.environment=g.environment
    where version.id=a.rule_set_version_id;
  if c.finalisation_week_ending::text is distinct from p_artifact->>'week_ending' or a.version::text is distinct from p_artifact->>'assignment_version'
    or a.rule_set_version_id::text is distinct from p_artifact->>'rule_set_version_id' or v.values_sha256 is distinct from p_artifact->>'rule_values_sha256'
    or v.values_json->>'invoice_sender' is distinct from 'CLIENT_SELF_BILL'
    or encode(private.weekly_source_sha256_jsonb_v1('WEEKLY_SOURCE_OFF_RULE_ASSIGNMENT_V1',to_jsonb(a)),'hex') is distinct from p_artifact->>'assignment_sha256'
    or exists(select 1 from public.weekly_source_group_rule_assignments enabled where enabled.source_group_id=g.id and enabled.feature_enabled)
    or g.code is distinct from p_artifact#>>'{fixture_manifest,group_code}' or g.code !~ '^WSQ_TEST_[A-Z0-9_]+$' then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SETUP_SCOPE_CHANGED' using errcode='40001'; end if;
  perform private.weekly_source_office_authority_v1((p_artifact->>'journey_actor_user_id')::uuid,'APPROVE_PROTECTED_PAY',g.id,null,c.finalisation_week_ending);
  if not private.weekly_source_pay_actor_allowed_v1((p_artifact->>'journey_actor_user_id')::uuid) then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SETUP_ACTOR_REFUSED' using errcode='42501'; end if;
  select array_agg(value::uuid order by value::uuid) into clients from jsonb_array_elements_text(p_artifact#>'{fixture_manifest,client_ids}') value;
  if cardinality(clients) not between 1 and 100 or to_jsonb(clients) is distinct from p_artifact#>'{fixture_manifest,client_ids}' then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SETUP_SCOPE_CHANGED' using errcode='40001'; end if;
  -- HISTORICAL_FIXTURE_RECORD_BOUNDARY: every past scope uses the exact
  -- genuine native disabled assignment; Source setup also proves vacancy.
  if a.effective_from_week_ending<(clock_timestamp() at time zone 'Europe/London')::date then
    perform private.weekly_source_historical_fixture_setup_assert_v1(p_artifact,p_artifact->>'purpose'='SOURCE_FIXTURE_SETUP');
  end if;
  if p_artifact->>'purpose'='AUTOMATIC_JOURNEY' then
    if cardinality(clients)<>1 or v.values_json->>'equal_protected_hours' is distinct from 'CLEAR_AUTOMATICALLY'
      or private.weekly_source_bulk_source_cas_v1(c.id,clients) is distinct from p_artifact->'original_source_cas'
      or not exists(select 1 from public.weekly_source_final_revisions final where final.id=c.current_final_revision_id
        and final.source_cycle_id=c.id and final.state='CURRENT' and final.rule_set_version_id=v.id)
      or (select automatic_reconcile_actor_user_id from public.weekly_source_global_settings where singleton)
        is distinct from (p_artifact->>'journey_actor_user_id')::uuid then
      raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SETUP_SOURCE_CHANGED' using errcode='40001'; end if;
  else
    if c.finalisation_week_ending<>a.effective_from_week_ending or c.current_final_revision_id is not null
    or c.state in ('FINALISING','FINALISED','CORRECTION_IN_PROGRESS')
    or exists(select 1 from public.weekly_source_final_revisions final where final.source_cycle_id=c.id)
    or p_artifact->'original_source_cas' is distinct from 'null'::jsonb then
    raise exception 'WEEKLY_SOURCE_POST_VERIFIED_SETUP_FUTURE_UNFINALISED_REQUIRED' using errcode='55000'; end if;
  end if;
end;
$function$;
