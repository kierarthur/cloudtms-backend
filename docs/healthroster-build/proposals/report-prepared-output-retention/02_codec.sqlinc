  if pg_catalog.jsonb_typeof(v_output->'hr_crosscheck_issues') not in ('null','array') then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_output->'hr_crosscheck_issues')='array' and exists(select 1 from pg_catalog.jsonb_array_elements(v_output->'hr_crosscheck_issues') a where pg_catalog.jsonb_typeof(a) not in ('null','string')) then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_output->'hr_crosscheck_status') not in ('null','string') then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_output->'id') not in ('null','string') or pg_catalog.jsonb_typeof(v_output->'id')='null' then
