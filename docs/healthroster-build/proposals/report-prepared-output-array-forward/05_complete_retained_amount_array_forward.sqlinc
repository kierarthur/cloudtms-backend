    or pg_catalog.jsonb_typeof(v_fin) is distinct from 'object'
    or pg_catalog.jsonb_typeof(v_writer) is distinct from 'object' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_RETENTION_UNPROVED' using errcode='55000'; end if;
  if p_receipt.outcome is distinct from 'PREPARED_FOR_AUTHORISATION'
    or private.weekly_source_report_prepared_output_supported_v1(p_receipt.final_revision_id) is distinct from true
    or private.weekly_source_report_projection_receipt_assert_v1(p_receipt) is distinct from true
    or p_receipt.prepared_writer_output_hash is null
    or p_receipt.prepared_writer_output_hash is distinct from private.weekly_source_report_prepared_output_hash_v1(p_receipt.receipt_hash,v_output)
