  if pg_catalog.jsonb_typeof(v_fin->'processed_by_user_id') not in ('null','string') then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if v_fin->>'processed_by_user_id' is not null and v_fin->>'processed_by_user_id'!~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'processing_status') not in ('null','string') or pg_catalog.jsonb_typeof(v_fin->'processing_status')='null' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'rate_source_refs_json') not in ('null','string') or pg_catalog.jsonb_typeof(v_fin->'rate_source_refs_json')='null' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'remittance_last_sent_at_utc') not in ('null','string') then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'remittance_send_count') not in ('null','number') or pg_catalog.jsonb_typeof(v_fin->'remittance_send_count')='null' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'role') not in ('null','string') then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'stale_reason') not in ('null','string') then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'timesheet_id') not in ('null','string') or pg_catalog.jsonb_typeof(v_fin->'timesheet_id')='null' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if v_fin->>'timesheet_id' is not null and v_fin->>'timesheet_id'!~*'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'timesheet_version') not in ('null','number') or pg_catalog.jsonb_typeof(v_fin->'timesheet_version')='null' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'total_charge_ex_vat') not in ('null','string') or pg_catalog.jsonb_typeof(v_fin->'total_charge_ex_vat')='null' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'total_hours') not in ('null','string') or pg_catalog.jsonb_typeof(v_fin->'total_hours')='null' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'total_pay_ex_vat') not in ('null','string') or pg_catalog.jsonb_typeof(v_fin->'total_pay_ex_vat')='null' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'travel_charge_ex_vat') not in ('null','string') or pg_catalog.jsonb_typeof(v_fin->'travel_charge_ex_vat')='null' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'travel_pay_ex_vat') not in ('null','string') or pg_catalog.jsonb_typeof(v_fin->'travel_pay_ex_vat')='null' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'updated_at') not in ('null','string') or pg_catalog.jsonb_typeof(v_fin->'updated_at')='null' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'worked_end_iso') not in ('null','string') then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if pg_catalog.jsonb_typeof(v_fin->'worked_start_iso') not in ('null','string') then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  for v_key in select pg_catalog.unnest(array['accommodation_charge_ex_vat','accommodation_pay_ex_vat','additional_charge_ex_vat','additional_margin_ex_vat','additional_pay_ex_vat','charge_bh','charge_day','charge_night','charge_sat','charge_sun','expenses_charge_ex_vat','expenses_pay_ex_vat','hours_bh','hours_day','hours_night','hours_sat','hours_sun','margin_ex_vat','mileage_charge_ex_vat','mileage_charge_rate','mileage_pay_ex_vat','mileage_pay_rate','mileage_units','other_charge_ex_vat','other_pay_ex_vat','pay_bh','pay_day','pay_night','pay_sat','pay_sun','pay_total_inc_vat_snapshot','pay_vat_amount_snapshot','pay_vat_rate_pct_snapshot','pay_wtr_rate_pct_snapshot','total_charge_ex_vat','total_hours','total_pay_ex_vat','travel_charge_ex_vat','travel_pay_ex_vat']::text[]) loop
    if pg_catalog.jsonb_typeof(v_fin->v_key) is distinct from 'null' and
      (pg_catalog.jsonb_typeof(v_fin->v_key) is distinct from 'string'
       or coalesce(v_fin->>v_key,'')!~'^-?(0|[1-9][0-9]*)([.][0-9]+)?$') then
      raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  end loop;
  if coalesce(v_fin->>'total_pay_ex_vat','')!~'^-?(0|[1-9][0-9]*)([.][0-9]+)?$'
    or coalesce(v_fin->>'timesheet_version','')!~'^[1-9][0-9]*$' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_CODEC_INVALID' using errcode='55000'; end if;
  if v_scope->>'final_revision_id' is distinct from p_receipt.final_revision_id::text
    or v_scope->>'source_cycle_id' is distinct from p_receipt.source_cycle_id::text
    or not exists(select 1 from public.weekly_source_final_revisions r where r.id=p_receipt.final_revision_id
      and r.rule_set_version_id::text=v_scope->>'rule_set_version_id')
    or v_scope->>'client_id' is distinct from p_receipt.client_id::text
    or v_scope->>'root_timesheet_id' is distinct from p_receipt.root_timesheet_id::text
    or v_scope->>'published_timesheet_financial_id' is distinct from p_receipt.published_timesheet_financial_id::text
    or v_scope->>'actor_user_id' is distinct from p_receipt.actor_user_id::text
    or v_scope->>'request_hash' is distinct from pg_catalog.encode(p_receipt.request_hash,'hex')
    or v_scope->>'service_snapshot_hash' is distinct from pg_catalog.encode(p_receipt.service_snapshot_hash,'hex')
    or v_scope->>'server_calculation_fingerprint' is distinct from pg_catalog.encode(p_receipt.server_calculation_fingerprint,'hex')
    or v_fin->>'id' is distinct from p_receipt.published_timesheet_financial_id::text
    or v_fin->>'timesheet_id' is distinct from p_receipt.root_timesheet_id::text
    or v_fin->>'client_id' is distinct from p_receipt.client_id::text
    or v_fin->>'candidate_id' is distinct from v_scope->>'candidate_id'
    or v_fin->>'timesheet_version' is distinct from v_scope->>'root_timesheet_version' then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_RETENTION_UNPROVED' using errcode='55000'; end if;
  -- Reconstruct exactly the retained original writer's ten-field marker.
  -- No current row/status/clock/amount lookup is made by this historical read.
  v_expected_writer:=pg_catalog.jsonb_build_object('ok',true,'timesheet_id',v_fin->'timesheet_id',
    'timesheet_financials_id',v_fin->'id','processing_status',v_fin->'processing_status',
    'timesheet_version',(v_fin->>'timesheet_version')::integer,
    'updated_at',v_fin->'updated_at','computed_at_utc',v_fin->'computed_at_utc',
    'version_marker',pg_catalog.md5(pg_catalog.jsonb_build_object(
      'id',v_fin->'id','timesheet_id',v_fin->'timesheet_id','timesheet_version',(v_fin->>'timesheet_version')::integer,
      'processing_status',v_fin->'processing_status','updated_at',v_fin->'updated_at','computed_at_utc',v_fin->'computed_at_utc',
      'total_hours',(v_fin->>'total_hours')::numeric,'total_pay_ex_vat',(v_fin->>'total_pay_ex_vat')::numeric,
      'total_charge_ex_vat',(v_fin->>'total_charge_ex_vat')::numeric,'margin_ex_vat',(v_fin->>'margin_ex_vat')::numeric)::text));
  if v_writer is distinct from v_expected_writer then
    raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_RETENTION_UNPROVED' using errcode='55000'; end if;
  return v_fin->>'total_pay_ex_vat';
exception when invalid_text_representation or numeric_value_out_of_range then
  raise exception 'WEEKLY_SOURCE_PREPARED_OUTPUT_RETENTION_UNPROVED' using errcode='55000';
end;
$function$;
