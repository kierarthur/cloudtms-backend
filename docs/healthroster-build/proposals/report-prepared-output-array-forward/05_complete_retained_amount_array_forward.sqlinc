    or v_output->>'native_writer_signature' is distinct from
      'public.tsfin_write_current_snapshot_single_bounded(uuid,integer,jsonb,uuid,timestamp with time zone)'
    or coalesce(v_output->>'financial_row_sha256','')!~'^[0-9a-f]{64}$'
    or pg_catalog.jsonb_typeof(v_scope) is distinct from 'object'
    or (select pg_catalog.array_agg(k order by k) from pg_catalog.jsonb_object_keys(v_scope) k)
      is distinct from array['actor_user_id','candidate_id','client_id','final_revision_id','published_timesheet_financial_id','request_hash','root_timesheet_id','root_timesheet_version','rule_set_version_id','server_calculation_fingerprint','service_snapshot_hash','source_cycle_id']::text[] then
