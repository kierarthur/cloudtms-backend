create or replace function private.weekly_source_report_prepared_pay_amount_v1(p_receipt public.weekly_source_ordinary_pay_projection_receipts)
returns text language plpgsql stable security definer
set search_path to 'pg_catalog','pg_temp'
set array_nulls to 'on'
as $function$
declare v_output jsonb; v_fin jsonb; v_scope jsonb; v_writer jsonb; v_expected_writer jsonb; v_key text;
begin
  -- Historical receipts are intentionally unbackfilled. NULL is unknown.
  if p_receipt.prepared_writer_output_json is null and p_receipt.prepared_writer_output_hash is null then return null; end if;
  v_output:=p_receipt.prepared_writer_output_json; v_fin:=v_output->'financial_output';
  v_scope:=v_output->'scope'; v_writer:=v_output->'writer_result';
  if p_receipt.prepared_writer_output_hash is null or pg_catalog.jsonb_typeof(v_output) is distinct from 'object'
