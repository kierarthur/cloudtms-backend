create or replace function private.timesheet_contract_move_evidence_source_v1(p_timesheet_id uuid)
returns jsonb language plpgsql volatile security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
declare a private.timesheet_contract_family_aliases%rowtype; m private.timesheet_contract_move_members%rowtype;
 original_t public.timesheets%rowtype; current_t public.timesheets%rowtype; placement jsonb; evidence jsonb;
begin
 if p_timesheet_id is null or not exists(select 1 from private.timesheet_contract_family_aliases v where v.timesheet_id=p_timesheet_id) then
  return null;
 end if;
 placement:=private.timesheet_contract_current_placement_v1(p_timesheet_id);
 select t.* into strict current_t from public.timesheets t where t.timesheet_id=(placement->>'current_timesheet_id')::uuid;
 select v.* into strict a from private.timesheet_contract_family_aliases v where v.timesheet_id=current_t.timesheet_id;
 select v.* into strict m from private.timesheet_contract_move_members v where v.operation_id=a.accepted_operation_id and v.member_key=a.member_key;
 select t.* into strict original_t from public.timesheets t where t.timesheet_id=a.original_timesheet_id;
 evidence:=private.timesheet_contract_move_evidence_v1(original_t.timesheet_id);
 if m.immutable_evidence_hash is distinct from private.timesheet_contract_move_row_hash_v1(evidence)
  or (current_t.actual_schedule_json,current_t.worked_start_iso,current_t.worked_end_iso,current_t.worked_minutes,
    current_t.break_start_iso,current_t.break_end_iso,current_t.break_minutes,current_t.additional_units_week,current_t.additional_units_per_day,
    current_t.candidate_workflow_id,current_t.candidate_workflow_generation)
   is distinct from (original_t.actual_schedule_json,original_t.worked_start_iso,original_t.worked_end_iso,original_t.worked_minutes,
    original_t.break_start_iso,original_t.break_end_iso,original_t.break_minutes,original_t.additional_units_week,original_t.additional_units_per_day,
    original_t.candidate_workflow_id,original_t.candidate_workflow_generation) then
  raise exception 'CONTRACT_MOVE_ORIGINAL_EVIDENCE_CHANGED' using errcode='23514';end if;
 return jsonb_build_object('version','CONTRACT_MOVE_EVIDENCE_SOURCE_V1','requested_timesheet_id',p_timesheet_id,
  'original_timesheet_id',original_t.timesheet_id,'current_timesheet_id',current_t.timesheet_id,'family_root_id',a.family_root_id,
  'member_key',a.member_key,'operation_id',a.accepted_operation_id,'placement_receipt_id',placement->'placement_receipt_id',
  'placement_revision',placement->'placement_revision','immutable_evidence_hash',encode(m.immutable_evidence_hash,'hex'),
  'original_timesheet',to_jsonb(original_t),'evidence',evidence,
  'document_source',jsonb_build_object('timesheet_id',original_t.timesheet_id,'current_document_version_id',original_t.current_document_version_id,
   'manual_document_asset_id',original_t.manual_document_asset_id,'manual_pdf_r2_key',original_t.manual_pdf_r2_key));
end;
$function$;
