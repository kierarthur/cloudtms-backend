-- Health service envelopes and immutable replay identity; no money/cut producer.
create or replace function private.daily_rate_correction_request_assert_v1(p_args jsonb,p_kind text)
returns void language plpgsql immutable security definer set search_path='pg_catalog','private','pg_temp'
as $function$
declare keys text[]; ids text[]; key text;
begin
 if jsonb_typeof(p_args) is distinct from 'object' or p_args->>'version' is distinct from 'DAILY_RATE_CORRECTION_V1' then
  raise exception 'DAILY_RATE_REQUEST_INVALID' using errcode='22023';end if;
 if p_kind='PREVIEW' then
  keys:=array['version','request_id','actor_user_id','timesheet_id','context_digest','calculation_snapshot','rate_provenance','reason'];
  ids:=array['request_id','actor_user_id','timesheet_id'];
 elsif p_kind='ACCEPT' then
  keys:=array['version','request_id','actor_user_id','operation_id','review_id','review_digest','expected_state_revision'];
  ids:=array['request_id','actor_user_id','operation_id','review_id'];
 elsif p_kind='READ_RESULT' then keys:=array['version','operation_id','actor_user_id'];ids:=array['operation_id','actor_user_id'];
 else raise exception 'DAILY_RATE_REQUEST_INVALID' using errcode='22023';end if;
 if not(p_args ?& keys) or p_args-keys<>'{}'::jsonb then raise exception 'DAILY_RATE_REQUEST_INVALID' using errcode='22023';end if;
 foreach key in array ids loop
  if jsonb_typeof(p_args->key) is distinct from 'string' or p_args->>key !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then
   raise exception 'DAILY_RATE_REQUEST_INVALID' using errcode='22023';end if;
 end loop;
 if p_kind='PREVIEW' then
  if jsonb_typeof(p_args->'reason') is distinct from 'string'
   or jsonb_typeof(p_args->'context_digest') not in('string','null')
   or (jsonb_typeof(p_args->'context_digest')='string' and p_args->>'context_digest' !~ '^[0-9a-f]{64}$')
   or jsonb_typeof(p_args->'calculation_snapshot') not in('object','null')
   or jsonb_typeof(p_args->'rate_provenance') not in('object','null') then raise exception 'DAILY_RATE_REQUEST_INVALID' using errcode='22023';end if;
  perform private.timesheet_contract_move_reason_v1(p_args->>'reason','DAILY_RATE_CORRECTION');
 elsif p_kind='ACCEPT' then
  if jsonb_typeof(p_args->'review_digest') is distinct from 'string' or p_args->>'review_digest' !~ '^[0-9a-f]{64}$'
   or jsonb_typeof(p_args->'expected_state_revision') is distinct from 'string'
   or p_args->>'expected_state_revision' !~ '^[1-9][0-9]*$' or length(p_args->>'expected_state_revision')>19 then raise exception 'DAILY_RATE_REQUEST_INVALID' using errcode='22023';end if;
  if (p_args->>'expected_state_revision')::numeric>9223372036854775807 then raise exception 'DAILY_RATE_REQUEST_INVALID' using errcode='22023';end if;
 end if;
end;
$function$;

create or replace function private.daily_rate_correction_request_hash_v1(p_args jsonb,p_kind text)
returns bytea language plpgsql immutable security definer set search_path='pg_catalog','private','pg_temp'
as $function$
declare body jsonb:=p_args;
begin
 perform private.daily_rate_correction_request_assert_v1(p_args,p_kind);
 if p_kind='PREVIEW' then
  body:=jsonb_set(body-array['context_digest','calculation_snapshot','rate_provenance'],'{reason}',
   to_jsonb(private.timesheet_contract_move_reason_v1(p_args->>'reason','DAILY_RATE_CORRECTION')));
 end if;
 return private.timesheet_contract_move_row_hash_v1(jsonb_build_object('kind',p_kind,'request',body));
end;
$function$;

create or replace function private.daily_rate_correction_preview_replay_v1(p_args jsonb)
returns jsonb language plpgsql volatile security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
declare q private.timesheet_contract_move_requests%rowtype; o private.timesheet_contract_move_operations%rowtype; actor uuid;
begin
 perform private.daily_rate_correction_request_assert_v1(p_args,'PREVIEW');actor:=(p_args->>'actor_user_id')::uuid;
 if not private.weekly_source_pay_actor_allowed_v1(actor) or not exists(select 1 from public.tms_users u
  where u.id=actor and u.is_active and upper(u.role::text)='ADMIN') then raise exception 'DAILY_RATE_ACTOR_NOT_ALLOWED' using errcode='42501';end if;
 select v.* into q from private.timesheet_contract_move_requests v where v.request_id=(p_args->>'request_id')::uuid;
 if q.request_id is null then return null;end if;
 select v.* into strict o from private.timesheet_contract_move_operations v where v.id=q.operation_id;
 if q.request_kind<>'PREVIEW' or q.request_hash is distinct from private.daily_rate_correction_request_hash_v1(p_args,'PREVIEW')
  or o.purpose<>'DAILY_RATE_CORRECTION' or o.created_by_user_id<>actor or o.from_timesheet_id<>(p_args->>'timesheet_id')::uuid
  or q.receipt_json is null then raise exception 'DAILY_RATE_REQUEST_CONFLICT' using errcode='22023';end if;
 return q.receipt_json;
end;
$function$;
