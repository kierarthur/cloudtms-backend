-- HELD SOURCE TEMPLATE. Never installed with an unbound owner block.
create or replace function private.daily_rate_correction_review_v1(p_args jsonb)
returns jsonb language plpgsql volatile security definer
set search_path=pg_catalog,public,private,pg_temp
as $function$
declare actor uuid; v_request_id uuid; request_hash bytea; prepared jsonb; daily jsonb; physical jsonb; invoice jsonb;
 o private.timesheet_contract_move_operations%rowtype; review_id uuid; manifest jsonb; digest bytea;
 scope_hash bytea; invoice_hash bytea; replay jsonb; preflight jsonb; blockers jsonb; result jsonb;
 ready boolean; preserved boolean; authority text; policy text; now_utc timestamptz;
 -- SOURCE-LOCAL BINDINGS, NOT A BANKING FUNCTION SIGNATURE OR JSON DTO.
 -- The unprovided owner block must derive every value from its genuine native
 -- cut/freeze/current-role Summary contract. Defaults intentionally grant none.
 bank_pay_cut_hash bytea; bank_manifest_extension jsonb; bank_pay_effect jsonb;
 bank_financial_visible boolean; bank_ready boolean; bank_blockers jsonb; bank_links jsonb;
begin
 perform private.daily_rate_correction_request_assert_v1(p_args,'PREVIEW');
 actor:=(p_args->>'actor_user_id')::uuid;v_request_id:=(p_args->>'request_id')::uuid;
 replay:=private.daily_rate_correction_preview_replay_v1(p_args);
 if replay is not null then return private.daily_rate_correction_public_assert_v1(replay,'PREVIEW');end if;
 -- Lock the actual native context without comparing a stale digest until a
 -- concurrent identical preview has had the chance to finish and replay.
 perform private.daily_rate_correction_health_actor_require_v1(actor,false);
 if current_setting('transaction_isolation') is distinct from 'read committed' then
  raise exception 'DAILY_RATE_LOCKED_CONTEXT_ISOLATION_REQUIRED' using errcode='55000';end if;
 perform private.daily_rate_correction_context_v1((p_args->>'timesheet_id')::uuid,actor,true);
 replay:=private.daily_rate_correction_preview_replay_v1(p_args);
 if replay is not null then return private.daily_rate_correction_public_assert_v1(replay,'PREVIEW');end if;
 daily:=private.daily_rate_correction_health_basis_v1(p_args,true);
 prepared:=private.daily_rate_correction_health_review_prepare_v1(p_args);
 if prepared->'daily' is distinct from daily then raise exception 'REVIEW_STALE' using errcode='40001';end if;
 physical:=prepared->'physical';
 select x.* into strict o from private.timesheet_contract_move_operations x where x.id=(prepared->>'operation_id')::uuid;
 @@BANK_REVIEW@@
 -- No successful/nominal defaults. The complete body cannot be generated until
 -- an exact published/reviewed owner source block is frozen at this boundary.
 if bank_pay_cut_hash is null or octet_length(bank_pay_cut_hash)<>32
  or jsonb_typeof(bank_manifest_extension) is distinct from 'object'
  or bank_manifest_extension ?| array['daily','physical','invoice','reason']
  or bank_financial_visible is null or bank_ready is null
  or jsonb_typeof(bank_blockers) is distinct from 'array' or jsonb_typeof(bank_links) is distinct from 'array' then
  raise exception 'DAILY_RATE_BANK_REVIEW_UNBOUND' using errcode='55000';end if;
 perform private.daily_rate_correction_public_assert_v1(bank_pay_effect,'EFFECT');
 perform private.daily_rate_correction_health_actions_assert_v1(bank_links);
 if not bank_financial_visible and bank_pay_effect is distinct from '{"visibility":"REDACTED"}'::jsonb then
  raise exception 'DAILY_RATE_FINANCIAL_PROJECTION_DENIED' using errcode='42501';end if;
 if private.daily_rate_correction_health_basis_v1(p_args,true) is distinct from daily
  or private.daily_rate_correction_scope_v1(o.id,false) is distinct from physical then
  raise exception 'REVIEW_STALE' using errcode='40001';end if;
 invoice:=private.invoice_contract_move_inspect_v1(physical,daily,actor,true);
 select x.* into strict o from private.timesheet_contract_move_operations x where x.id=o.id;
 -- Existing native0858 supports the genuine approved revision/publication arm.
 -- An unprovided NOT_REQUIRED certificate cannot be substituted for this cut.
 if o.financial_state is distinct from 'QUALIFIED' or o.current_financial_cut_id is null
  or o.state is distinct from 'REVIEWED' or o.accept_request_id is not null
  or o.placement_receipt_json is not null or o.created_by_user_id is distinct from actor then
  raise exception 'DAILY_RATE_BANK_REVIEW_UNBOUND' using errcode='55000';end if;
 perform pg_advisory_xact_lock(hashtextextended('timesheet-contract-move-request:'||v_request_id::text,0));
 replay:=private.daily_rate_correction_preview_replay_v1(p_args);
 if replay is not null then return private.daily_rate_correction_public_assert_v1(replay,'PREVIEW');end if;
 request_hash:=private.daily_rate_correction_request_hash_v1(p_args,'PREVIEW');
 scope_hash:=decode(physical->>'scope_sha256','hex');invoice_hash:=decode(invoice->>'certificate_digest','hex');
 if scope_hash is null or octet_length(scope_hash)<>32 or invoice_hash is null or octet_length(invoice_hash)<>32
  or jsonb_typeof(invoice->'slices') is distinct from 'array' or jsonb_array_length(invoice->'slices')=0
  or exists(select 1 from jsonb_array_elements(invoice->'slices') s
    where coalesce(s->>'authority','') not in('SOURCE_FINANCIAL','CONTRACT_PRICED')) then
  raise exception 'DAILY_RATE_NATIVE_REVIEW_UNBOUND' using errcode='23514';end if;
 if not exists(select 1 from jsonb_array_elements(invoice->'slices') s where s->>'authority'<>'SOURCE_FINANCIAL') then
  authority:='SOURCE_FINANCIAL';policy:='PRESERVE_SOURCE';
 elsif not exists(select 1 from jsonb_array_elements(invoice->'slices') s where s->>'authority'<>'CONTRACT_PRICED') then
  authority:='CONTRACT_PRICED';policy:='ORDINARY_CORRECTION';
 else authority:='MIXED';policy:='MIXED';end if;
 manifest:=jsonb_build_object('daily',daily,'physical',physical,'invoice',invoice,'reason',o.reason)||bank_manifest_extension;
 review_id:=gen_random_uuid();now_utc:=clock_timestamp();
 digest:=private.timesheet_contract_move_row_hash_v1(jsonb_build_object('version','DAILY_RATE_CORRECTION_REVIEW_V1',
  'operation_id',o.id,'review_id',review_id,'preview_request_id',v_request_id,'preview_request_hash',encode(request_hash,'hex'),
  'scope_hash',encode(scope_hash,'hex'),'pay_cut_hash',encode(bank_pay_cut_hash,'hex'),
  'invoice_hash',encode(invoice_hash,'hex'),'manifest',manifest));
 update private.timesheet_contract_move_operations set expected_scope_hash=scope_hash,before_pay_cut_hash=bank_pay_cut_hash,
  before_invoice_hash=invoice_hash,invoice_authority=authority,invoice_move_policy=policy,state_revision=state_revision+1 where id=o.id;
 select x.* into strict o from private.timesheet_contract_move_operations x where x.id=o.id;
 insert into private.timesheet_contract_move_requests(request_id,operation_id,request_kind,request_hash,review_id,state_revision,created_at_utc)
 values(v_request_id,o.id,'PREVIEW',request_hash,review_id,o.state_revision,now_utc);
 insert into private.timesheet_contract_move_reviews(id,operation_id,review_no,preview_request_id,preview_request_hash,
  review_digest,scope_hash,pay_cut_hash,invoice_hash,manifest_json,created_at_utc)
 values(review_id,o.id,1,v_request_id,request_hash,digest,scope_hash,bank_pay_cut_hash,invoice_hash,manifest,now_utc);
 preflight:=private.invoice_contract_move_preflight_v1(review_id,actor,true);
 blockers:=bank_blockers||(preflight->'known_blockers');
 preserved:=physical#>>'{members,0,immutable_evidence_hash}' is not distinct from daily#>>'{context,unchanged_work_sha256}';
 if not preserved then raise exception 'DAILY_RATE_WORKED_FACTS_MISMATCH' using errcode='23514';end if;
 ready:=bank_ready and preflight->'ready_to_confirm'='true'::jsonb and jsonb_array_length(blockers)=0;
 result:=jsonb_build_object('version','DAILY_RATE_CORRECTION_V1','operation_id',o.id,'review_id',review_id,
  'review_digest',encode(digest,'hex'),'state_revision',o.state_revision::text,'ready_to_confirm',ready,
  'current_timesheet_id',o.from_timesheet_id,'summary',jsonb_build_object('worked_facts_preserved',preserved,
    'pay_effect',bank_pay_effect,'invoice_effect',private.daily_rate_correction_health_invoice_effect_v1(invoice)),
  'known_blockers',blockers,'confirm',case when ready then jsonb_build_object('request_version','DAILY_RATE_CORRECTION_V1',
    'review_id',review_id,'review_digest',encode(digest,'hex'),'expected_state_revision',o.state_revision::text) else null end,
  'links',bank_links);
 result:=private.daily_rate_correction_public_assert_v1(result,'PREVIEW');
 update private.timesheet_contract_move_requests q set receipt_json=result where q.request_id=v_request_id and q.operation_id=o.id;
 return result;
end;
$function$;
revoke all on function private.daily_rate_correction_review_v1(jsonb) from public,anon,authenticated,service_role;
