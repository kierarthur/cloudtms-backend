create or replace function private.weekly_source_self_bill_report_projection_rows_v1(p_actor_user_id uuid,p_publication_id uuid,p_rows jsonb)
returns jsonb language plpgsql volatile security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare p public.weekly_source_projection_publications%rowtype; s public.weekly_source_report_scopes%rowtype; c public.weekly_source_cycles%rowtype;
begin
  if p_actor_user_id is null or jsonb_typeof(p_rows) is distinct from 'array' or jsonb_array_length(p_rows)<>0 then
    raise exception 'WEEKLY_SOURCE_REPORT_PAY_RESOLUTIONS_FORBIDDEN' using errcode='22023'; end if;
  select * into strict p from public.weekly_source_projection_publications where id=p_publication_id;
  perform 1 from public.weekly_source_groups where id=(select source_group_id from public.weekly_source_cycles where id=p.source_cycle_id) for update;
  select * into strict c from public.weekly_source_cycles where id=p.source_cycle_id for update;
  select * into strict s from public.weekly_source_report_scopes where id=p.report_scope_id for update;
  select * into strict p from public.weekly_source_projection_publications where id=p_publication_id for update;
  if p.authority_scope_kind<>'SELF_BILL_REPORT_SCOPE' or s.self_bill_report_id is null or p.state<>'BUILDING'
    or p.correction_session_id is not null or s.current_complete_upload_id is distinct from p.upload_id
    or s.version<>p.authority_scope_version or s.projection_state<>'REBUILDING' then
    raise exception 'WEEKLY_SOURCE_REPORT_PROJECTION_STALE' using errcode='40001'; end if;
  perform private.weekly_source_office_authority_v1(p_actor_user_id,'RECHECK_SOURCE',c.source_group_id,s.client_id,c.finalisation_week_ending);
  perform private.weekly_source_self_bill_report_seal_assert_v1(p.upload_id);
  return jsonb_build_object('ok',true,'status','APPLIED','publication_id',p.id,'rows_applied',0,'expected_rows',0,'invoice_only',true);
end;
$function$;
