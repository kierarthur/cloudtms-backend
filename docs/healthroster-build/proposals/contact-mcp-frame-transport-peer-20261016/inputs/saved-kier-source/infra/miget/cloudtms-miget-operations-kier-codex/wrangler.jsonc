{
  "$schema": "../cloudtms-miget-operations/node_modules/wrangler/config-schema.json",
  "name": "codex-kier-miget-operations",
  "main": "../cloudtms-miget-operations/src/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MIGET_POSTGREST_ORIGIN": "https://cloudtms-codex-poc-postgrest-kwtyn.eu-east-1.migetapp.com",
    "MIGET_RESOURCE_ID": "01a02ef7-1977-79bd-ad56-7e86927d5f81",
    "MIGET_TEST_ONLY": "true",
    "MIGET_TRANSACTION_ROLLBACK_ENABLED": "true"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "11c78f14afea494c9d5e8d8ad57d41a2"
    },
    {
      "binding": "MYTMS_HYPERDRIVE",
      "id": "7e979a8127c84c319dfc2ecf488aa903"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
