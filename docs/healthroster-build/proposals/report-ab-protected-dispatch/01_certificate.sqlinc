-- Source proposal only. No native qualification or operational selection.
create or replace function private.weekly_source_report_fin_certificate_assert_v1(
  p_certificate jsonb,p_group uuid,p_version uuid,p_from date,p_to date
) returns void language plpgsql stable security definer set search_path to 'pg_catalog','pg_temp'
as $function$
declare latest jsonb; recorded private.cloudtms_database_releases%rowtype;
  installation jsonb; execution jsonb; scope_value jsonb; decision jsonb; row_value jsonb; paired jsonb;
  key_value text; case_value text; required_cases constant text[]:=array[
    'BOUND_NEGATIVE','D_NEGATIVE','D_POSITIVE','D_ZERO','NEXT_ACTIVE','ORDINARY_NHSP_REGRESSION','STANDALONE_NEGATIVE'];
  assertion_keys constant text[]:=array['actual_report_and_export_binding','bound_export_pay_finalised','native_fin_atomic',
    'native_invoice_admission','native_invoice_validation','native_frozen_render','invoice_target_matches_original',
    'rounding_identity_and_last_line_checked','zero_invoice_only_pay_vectors','no_report_pay_orchestrator',
    'no_row_resolution_pay_entitlement','next_active_no_expense_observation','ordinary_nhsp_unchanged',
    'native_candidate_i1_hooks_retained','no_provider_settlement_email_network','rollback_fresh_restored'];
begin
  if p_group is null or p_version is null or p_from is null or not private.weekly_source_qualification_closed_object_v1(p_certificate,
    array['schema_version','phase','installation','scope','execution','native_comparisons','decision','decision_binding','source_equivalence','qualification_sha256'])
    or p_certificate->>'schema_version' is distinct from 'WEEKLY_SOURCE_REPORT_FIN_AB_QUALIFICATION_V1'
    or p_certificate->>'phase' is distinct from 'BOTH_NATIVE_VARIANTS_QUALIFIED'
    or p_certificate->>'qualification_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_REPORT_FIN_AB_QUALIFICATION_V1',p_certificate-'qualification_sha256'),'hex') then
    raise exception 'WEEKLY_SOURCE_REPORT_FIN_RELEASE_UNQUALIFIED' using errcode='55000'; end if;
  installation:=p_certificate->'installation'; execution:=p_certificate->'execution'; scope_value:=p_certificate->'scope';
  decision:=p_certificate->'decision'; latest:=private.weekly_source_protected_qualification_release_v1();
  if not private.weekly_source_qualification_closed_object_v1(scope_value,array['agency_id','source_group_id','rule_set_version_id',
      'rule_set_values_sha256','effective_from_week_ending','effective_to_week_ending'])
    or scope_value->>'source_group_id' is distinct from p_group::text or scope_value->>'rule_set_version_id' is distinct from p_version::text
    or scope_value->>'effective_from_week_ending' is distinct from p_from::text
    or scope_value->>'effective_to_week_ending' is distinct from p_to::text
    or scope_value->>'rule_set_values_sha256' is distinct from (select v.values_sha256 from public.weekly_source_rule_set_versions v where v.id=p_version)
    or not exists(select 1 from public.weekly_source_groups g join public.weekly_source_rule_set_versions v on v.id=p_version
      join public.weekly_source_rule_sets r on r.id=v.rule_set_id and r.agency_id=g.agency_id and r.environment=g.environment
      where g.id=p_group and g.active and g.source_family='ROSTER' and g.environment='TEST'
        and scope_value->>'agency_id'=g.agency_id::text)
    or installation is distinct from latest or execution->>'release_id' is not distinct from installation->>'release_id'
    or execution->>'contract_sha256' is distinct from installation->>'contract_sha256'
    or execution->>'installation_id' is distinct from installation->>'installation_id'
    or execution->>'installed_catalogue_jsonb_sha256' is distinct from installation->>'installed_catalogue_jsonb_sha256'
    or not private.weekly_source_qualification_closed_object_v1(execution,array['release_id','source_commit','contract_sha256','installation_id',
      'environment','database','managed_manifest_sha256','installed_catalogue_jsonb_sha256']) then
    raise exception 'WEEKLY_SOURCE_REPORT_FIN_RELEASE_UNQUALIFIED' using errcode='55000'; end if;
  select * into strict recorded from private.cloudtms_database_releases where release_id=execution->>'release_id';
  if recorded.status is distinct from 'VERIFIED' or recorded.completed_at_utc is null
    or recorded.git_commit is distinct from execution->>'source_commit'
    or recorded.installed_contract_sha256 is distinct from execution->>'contract_sha256'
    or recorded.installed_contract_sha256 is distinct from recorded.repository_contract_sha256
    or recorded.evidence_json#>>'{managed_release,environment}' is distinct from 'TEST'
    or recorded.evidence_json#>>'{managed_release,expected_database}' is distinct from current_database()
    or recorded.evidence_json#>>'{managed_release,manifest_sha256}' is distinct from execution->>'managed_manifest_sha256'
    or recorded.evidence_json#>>'{weekly_source_protected_qualification_catalogue,jsonb_sha256}' is distinct from execution->>'installed_catalogue_jsonb_sha256'
    or recorded.evidence_json->'weekly_source_report_fin_native_comparisons' is distinct from p_certificate->'native_comparisons'
    or execution->>'environment' is distinct from 'TEST' or execution->>'database' is distinct from current_database()
    or execution->>'source_commit' !~ '^[0-9a-f]{40}$' then
    raise exception 'WEEKLY_SOURCE_REPORT_FIN_RECORDED_EXECUTION_CHANGED' using errcode='55000'; end if;
  perform private.weekly_source_protected_execution_tree_assert_v2(p_certificate->'source_equivalence',
    execution->>'source_commit',installation->>'source_commit');
  if not private.weekly_source_qualification_closed_object_v1(decision,array['schema_version','selected_variant','native_comparison_sha256','reason'])
    or decision->>'schema_version' is distinct from 'WEEKLY_SOURCE_REPORT_FIN_REVIEWED_DECISION_V1'
    or decision->>'selected_variant' is null or decision->>'selected_variant' not in ('A','B')
    or decision->>'native_comparison_sha256' is distinct from encode(private.weekly_source_sha256_jsonb_v1(
      'WEEKLY_SOURCE_REPORT_FIN_NATIVE_COMPARISONS_V1',p_certificate->'native_comparisons'),'hex')
    or coalesce(length(btrim(decision->>'reason')),0) not between 1 and 1000
    or not private.weekly_source_qualification_closed_object_v1(p_certificate->'decision_binding',array['path','blob_oid','sha256','json_pointer'])
    or p_certificate#>>'{decision_binding,path}' is distinct from 'supabase/release/weekly-source-protected-operational.json'
    or coalesce(p_certificate#>>'{decision_binding,json_pointer}','') !~ '^/report_fin_qualifications/(0|[1-9][0-9]?)/decision$'
    or coalesce(p_certificate#>>'{decision_binding,blob_oid}','') !~ '^[0-9a-f]{40}$'
    or coalesce(p_certificate#>>'{decision_binding,sha256}','') !~ '^[0-9a-f]{64}$'
    or not exists(select 1 from jsonb_array_elements(p_certificate#>'{source_equivalence,receipt_bindings}') binding
      where binding->>'role'='INSTALLATION' and binding->>'key'='weeklySourceProtectedOperational'
        and binding->>'path'=p_certificate#>>'{decision_binding,path}'
        and binding->>'blob_oid'=p_certificate#>>'{decision_binding,blob_oid}'
        and binding->>'sha256'=p_certificate#>>'{decision_binding,sha256}')
    or jsonb_typeof(p_certificate->'native_comparisons') is distinct from 'array'
    or jsonb_array_length(p_certificate->'native_comparisons')<>cardinality(required_cases)*2 then
    raise exception 'WEEKLY_SOURCE_REPORT_FIN_NATIVE_COMPARISON_REQUIRED' using errcode='55000'; end if;
  for case_value in select unnest(required_cases) loop
    if (select count(*) from jsonb_array_elements(p_certificate->'native_comparisons') e
      where e->>'case_id'=case_value and e->>'variant'='A')<>1
      or (select count(*) from jsonb_array_elements(p_certificate->'native_comparisons') e
      where e->>'case_id'=case_value and e->>'variant'='B')<>1 then
      raise exception 'WEEKLY_SOURCE_REPORT_FIN_NATIVE_COMPARISON_REQUIRED' using errcode='55000'; end if;
  end loop;
  for row_value in select value from jsonb_array_elements(p_certificate->'native_comparisons') loop
    if not private.weekly_source_qualification_closed_object_v1(row_value,array['schema_version','execution','scope','case_id','variant',
      'source_fixture_sha256','original_report_sha256','report_row_manifest_sha256','binding_authority_sha256','native_tool_receipt',
      'native_result','comparison','assertions','receipt_id','receipt_sha256'])
      or row_value->>'schema_version' is distinct from 'WEEKLY_SOURCE_REPORT_FIN_NATIVE_VARIANT_V1'
      or row_value->'execution' is distinct from execution or row_value->'scope' is distinct from scope_value
      or not private.weekly_source_qualification_closed_object_v1(row_value->'assertions',assertion_keys)
      or exists(select 1 from unnest(assertion_keys) k where row_value->'assertions'->k is distinct from 'true'::jsonb)
      or not private.weekly_source_qualification_closed_object_v1(row_value->'native_tool_receipt',
        array['accepted','database','rolledBack','connectedFresh','tool_receipt_sha256','journey_id'])
      or row_value#>'{native_tool_receipt,accepted}' is distinct from 'true'::jsonb
      or row_value#>'{native_tool_receipt,rolledBack}' is distinct from 'true'::jsonb
      or row_value#>'{native_tool_receipt,connectedFresh}' is distinct from 'true'::jsonb
      or row_value#>>'{native_tool_receipt,database}' is distinct from current_database()
      or row_value#>>'{native_tool_receipt,journey_id}' is distinct from ('REPORT_FIN_'||(row_value->>'case_id')||'_'||(row_value->>'variant')) then
      raise exception 'WEEKLY_SOURCE_REPORT_FIN_NATIVE_COMPARISON_REQUIRED' using errcode='55000'; end if;
    for key_value in select unnest(array['source_fixture_sha256','original_report_sha256','report_row_manifest_sha256',
      'binding_authority_sha256','receipt_sha256']) loop
      if coalesce(row_value->>key_value,'') !~ '^[0-9a-f]{64}$' then
        raise exception 'WEEKLY_SOURCE_REPORT_FIN_NATIVE_COMPARISON_REQUIRED' using errcode='55000'; end if;
    end loop;
    if not private.weekly_source_qualification_closed_object_v1(row_value->'native_result',array['source_cycle_id','report_scope_id',
      'final_revision_id','client_manifest_id','invoice_id','fin_result_sha256','admission_receipt_sha256','validation_receipt_sha256',
      'rendered_document_sha256','pay_isolation_receipt_sha256'])
      or not private.weekly_source_qualification_closed_object_v1(row_value->'comparison',array['schema_version','net_pence','vat_pence','gross_pence',
        'rounding_pence','report_lines_sha256','invoice_target_sha256','pay_isolation_sha256','render_semantics_sha256'])
      or row_value#>>'{comparison,schema_version}' is distinct from 'WEEKLY_SOURCE_REPORT_FIN_COMPARISON_V1'
      or exists(select 1 from unnest(array['net_pence','vat_pence','gross_pence','rounding_pence']) k
        where jsonb_typeof(row_value->'comparison'->k) is distinct from 'string' or coalesce(row_value->'comparison'->>k,'') !~ '^(0|-?[1-9][0-9]{0,14})$')
      or exists(select 1 from unnest(array['report_lines_sha256','invoice_target_sha256','pay_isolation_sha256','render_semantics_sha256']) k
        where coalesce(row_value->'comparison'->>k,'') !~ '^[0-9a-f]{64}$') then
      raise exception 'WEEKLY_SOURCE_REPORT_FIN_NATIVE_COMPARISON_REQUIRED' using errcode='55000'; end if;
    if (row_value#>>'{comparison,net_pence}')::bigint+(row_value#>>'{comparison,vat_pence}')::bigint
        is distinct from (row_value#>>'{comparison,gross_pence}')::bigint
      or (row_value->>'case_id'='D_POSITIVE' and (row_value#>>'{comparison,rounding_pence}')::bigint<=0)
      or (row_value->>'case_id'='D_NEGATIVE' and (row_value#>>'{comparison,rounding_pence}')::bigint>=0)
      or (row_value->>'case_id'='D_ZERO' and (row_value#>>'{comparison,rounding_pence}')::bigint<>0) then
      raise exception 'WEEKLY_SOURCE_REPORT_FIN_NATIVE_COMPARISON_REQUIRED' using errcode='55000'; end if;
    select value into strict paired from jsonb_array_elements(p_certificate->'native_comparisons')
      where value->>'case_id'=row_value->>'case_id' and value->>'variant'<>row_value->>'variant';
    if row_value->'comparison' is distinct from paired->'comparison'
      or row_value#>>'{native_result,source_cycle_id}' is distinct from paired#>>'{native_result,source_cycle_id}'
      or row_value#>>'{native_result,report_scope_id}' is distinct from paired#>>'{native_result,report_scope_id}'
      or exists(select 1 from unnest(array['source_fixture_sha256','original_report_sha256','report_row_manifest_sha256',
        'binding_authority_sha256']) k where row_value->>k is distinct from paired->>k) then
      raise exception 'WEEKLY_SOURCE_REPORT_FIN_VARIANTS_DIFFERENT_NATIVE_BASIS' using errcode='55000'; end if;
  end loop;
exception when undefined_function or undefined_table or no_data_found or too_many_rows or invalid_text_representation then
  raise exception 'WEEKLY_SOURCE_REPORT_FIN_RELEASE_UNQUALIFIED' using errcode='55000';
end;
$function$;
