          "function_name": "weekly_source_pay_actor_allowed_v1",
          "identity_arguments": "p_actor_user_id uuid",
          "definition": "CREATE OR REPLACE FUNCTION private.weekly_source_pay_actor_allowed_v1(p_actor_user_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'pg_temp'\nAS $function$\n  select exists(select 1 from public.tms_users actor\n    where actor.id=p_actor_user_id and actor.is_active is true\n      and (lower(btrim(coalesce(actor.role,'')))='admin'\n        or coalesce(actor.payment_authoriser,false)\n        or coalesce(actor.payment_golden_key,false)));\n$function$\n",
