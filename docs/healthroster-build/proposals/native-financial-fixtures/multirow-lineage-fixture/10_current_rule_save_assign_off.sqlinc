-- Source proposal only. Root executes inside its one agency TEST rollback transaction.
-- No nested transaction, clock override, queue drain, payment/provider/email call.
-- Run before phase 02. This proves configuration owners/OFF semantics, not enabled money admission.
create temporary table nfx_rule_state(saved jsonb,assigned jsonb,before_policy jsonb) on commit drop;
do $nfx_rules_off$ declare s pg_temp.nfx_state%rowtype;v_saved jsonb;v_assigned jsonb;before_policy jsonb;begin
 select * into strict s from pg_temp.nfx_state;
 if exists(select 1 from public.weekly_source_rule_sets where code='NFX_MULTI_MONEY_OFF_20261013')
 or exists(select 1 from public.weekly_source_rule_set_versions where save_request_id='452f81b6-119a-8fdd-998f-c0779c9f19d7'::uuid)
 or exists(select 1 from public.weekly_source_group_rule_assignments where assignment_request_id='e65cf165-bd11-8061-9dce-09af0ae11898'::uuid) then raise exception 'NFX_RULE_NAMESPACE_NOT_VACANT';end if;
 before_policy:=private._weekly_source_effective_policy_v1(s.client_id,s.contract_id,date '2026-10-06');
 v_saved:=public.weekly_source_rule_set_version_save_atomic_v1(jsonb_build_object('actor_user_id',s.actor_id,'agency_id',current_setting('cloudtms.nfx.agency_id'),'environment','TEST','source_group_id',s.group_id,'request_id','452f81b6-119a-8fdd-998f-c0779c9f19d7','rule_set',jsonb_build_object('id',null,'code','NFX_MULTI_MONEY_OFF_20261013','display_name','NFX disabled source money','expected_version',0),'values','{"self_bill_source":"SAME_FILE","final_report_profile_kind":"NONE","invoice_membership":"FINALISED_IN_CYCLE_WINDOW","pay_membership":"ALL_FINALISED_IN_FILE","invoice_amount_basis":"SOURCE_AMOUNT","source_amount_basis":"EXPORT_ACTUAL_COST_INC_VAT_NET_AGENCY_WORKER_PAY","line_vat_method":"LINE_GROSS_MINUS_NET_FROM_SOURCE","invoice_vat_method":"SUM_OF_LINES","rate_difference_policy":"FLAG_ALLOW_IGNORE","negative_adjustment_policy":"NEGATIVE_ADJUSTMENT_LINE","lookback_warning":"WARN_IF_AFTER_OLDEST_PROTECTED","identical_rekey":"COMPLETE_AUTOMATICALLY","authorised_late_addition":"COMPLETE_AUTOMATICALLY","equal_protected_hours":"CLEAR_AUTOMATICALLY","signed_comparison":"ON_EVERY_PUBLICATION","unfinalised_action":"ASK_CLIENT_TO_FINALISE","unfinalised_chase":"ASK_FROM_FIRST_CHECKING_IMPORT_SHOWING_IT","changed_query_clocks":"REASK_WITH_NEW_CLOCKS_EXCLUDE_UNCHANGED","invoice_sender":"CLIENT_SELF_BILL","earliest_final_weekday":4,"earliest_final_local_time":"00:00","attach_healthroster_section":true,"checking_profile_kind":"HEALTHROSTER_WEEKLY_FROM_TO_ACTUAL_V1"}'::jsonb));
 if v_saved->>'contract'<>'WEEKLY_SOURCE_RULE_SET_SAVED_V1' then raise exception 'NFX_NATIVE_RULE_SAVE_FAILED';end if;
 v_assigned:=public.weekly_source_group_rule_assign_atomic_v1(jsonb_build_object('actor_user_id',s.actor_id,'agency_id',current_setting('cloudtms.nfx.agency_id'),'environment','TEST','source_group_id',s.group_id,'request_id','e65cf165-bd11-8061-9dce-09af0ae11898','rule_set_version_id',v_saved->>'rule_set_version_id','effective_from_week_ending','2026-10-18','effective_to_week_ending',null,'expected_group_version',(select version from public.weekly_source_groups where id=s.group_id)));
 if v_assigned->>'contract'<>'WEEKLY_SOURCE_RULE_ASSIGNED_V1' or not exists(select 1 from public.weekly_source_group_rule_assignments where id=(v_assigned->>'assignment_id')::uuid and feature_enabled=false and effective_from_week_ending=date '2026-10-18') then raise exception 'NFX_NATIVE_ASSIGNMENT_NOT_OFF';end if;
 if private.weekly_source_effective_rule_set_v1(s.client_id,s.cycle_id) is not null
 or private._weekly_source_effective_policy_v1(s.client_id,s.contract_id,date '2026-10-06') is distinct from before_policy then raise exception 'NFX_DISABLED_RULE_POLICY_DRIFT';end if;
 insert into pg_temp.nfx_rule_state values(v_saved,v_assigned,before_policy);
end;$nfx_rules_off$;
