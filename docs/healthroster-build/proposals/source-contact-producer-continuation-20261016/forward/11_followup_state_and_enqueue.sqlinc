-- Routine step provenance is separate from the global logical send ordinal.
-- Explicit manual contacts neither reset nor advance the routine step vector.
-- Every actual accepted contact remains relevant to the next interval clock.
create or replace function private.weekly_contact_source_manager_followup_state_v1(p_incident_id uuid,p_at timestamptz)
returns jsonb language plpgsql stable security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
declare i public.weekly_discrepancy_incidents%rowtype;sg public.weekly_source_groups%rowtype;s public.weekly_source_global_settings%rowtype;
 keys jsonb;history jsonb;steps integer;completed integer;step jsonb;due timestamptz;cutoff jsonb;basis uuid;
begin
 select * into strict i from public.weekly_discrepancy_incidents where id=p_incident_id;
 select * into strict sg from public.weekly_source_groups where id=i.source_group_id;
 select * into strict s from public.weekly_source_global_settings where singleton;
 keys:=private.weekly_contact_source_identity_v1(sg.agency_id,sg.environment,i.candidate_id,i.client_id,'CHECK_HOURS','MANAGER',
  jsonb_build_object('work_event_id',i.work_event_id,'incident_id',i.id,'incident_episode',i.episode_number));
 history:=private.weekly_contact_source_logical_history_v1(sg.agency_id,sg.environment,i.candidate_id,i.client_id,decode(keys->>'logical_contact_key','hex'));
 select coalesce(max(capture_member.routine_step),0),count(distinct capture_member.routine_step) filter(where capture_member.routine_step>0)
  into completed,steps from public.weekly_contact_delivery_memberships accepted
  join public.weekly_message_dispatch_commands command on command.id=accepted.delivery_id
  join public.weekly_contact_source_intent_captures capture on capture.message_intent_id=command.message_intent_id
  join public.weekly_contact_source_intent_capture_members capture_member on capture_member.message_intent_id=capture.message_intent_id
   and capture_member.logical_contact_key=accepted.logical_contact_key and capture_member.send_ordinal=accepted.send_ordinal
  where accepted.logical_contact_key=decode(keys->>'logical_contact_key','hex') and accepted.accepted_at_utc is not null
   and capture.capture_kind in('ROUTINE_FOLLOWUP','ROUTINE_MANUAL_FOLLOWUP','FOLLOWUP_RECOMPOSITION');
 if completed<>steps then raise exception 'CONTACT_SOURCE_ROUTINE_HISTORY_UNRESOLVED' using errcode='55000';end if;
 select id into basis from public.weekly_contact_delivery_memberships where logical_contact_key=decode(keys->>'logical_contact_key','hex')
  and accepted_at_utc is not null order by accepted_at_utc desc,send_ordinal desc limit 1;
 cutoff:=private.weekly_contact_source_cutoff_classification_v1(i.id,p_at);
 if history->'last_accepted_send'<>'null'::jsonb then
  if(history->'last_accepted_send'->>'accepted_at_utc')::timestamptz>p_at then
   raise exception 'CONTACT_SOURCE_TIME_INVALID' using errcode='22023';end if;
  step:=s.manager_followups->completed;
  if step is not null then due:=private.weekly_source_manager_interval_due_v1(i.client_id,
   (history->'last_accepted_send'->>'accepted_at_utc')::timestamptz,(step->>'interval_value')::integer,step->>'interval_unit');end if;
 end if;
 return jsonb_build_object('version','CONTACT_SOURCE_MANAGER_FOLLOWUP_V1','policy_revision',s.version::text,
  'logical_contact_key',keys->'logical_contact_key','incident_id',i.id,'incident_episode',i.episode_number,
  'last_accepted_at_utc',history->'last_accepted_send'->'accepted_at_utc','next_send_ordinal',case when step is null then null else history->'next_send_ordinal' end,
  'routine_sequence',step->'sequence','mode',step->'mode','due_at_utc',case when due is null then null
    else to_char(due at time zone 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') end,
  'basis_accepted_membership_id',basis,'routine_in_scope',cutoff->'routine'->'in_scope',
  'reason',case when history->'last_accepted_send'='null'::jsonb then 'NO_ACCEPTED_CONTACT'
   when history->'unknown_original'='true'::jsonb then 'ORIGINAL_SUBMISSION_UNCERTAIN'
   when history->'original_retry_pending'='true'::jsonb then 'ORIGINAL_ATTEMPT_OWNER_PENDING'
   when cutoff->'routine'->'in_scope' is distinct from 'true'::jsonb then 'OUTSIDE_ROUTINE_SCOPE'
   when step is null then 'FOLLOWUPS_COMPLETE' else 'SCHEDULED' end,'requires_current_start_admission',true);
end;
$function$;

-- Same existing timing ABI, with actual new provenance understood. Its old
-- accepted-membership permission/binding boundary remains independently checked.
create or replace function private.weekly_source_manager_followup_timing_v1(p_accepted_membership_id uuid,p_at_utc timestamptz)
returns jsonb language plpgsql stable security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
declare m public.weekly_contact_delivery_memberships%rowtype;i public.weekly_discrepancy_incidents%rowtype;
 sg public.weekly_source_groups%rowtype;keys jsonb;state jsonb;
begin
 select * into strict m from public.weekly_contact_delivery_memberships where id=p_accepted_membership_id;
 if m.audience<>'MANAGER' or m.accepted_at_utc is null or m.incident_id is null or m.purpose<>'CHECK_HOURS' then
  raise exception 'WEEKLY_SOURCE_MANAGER_ACCEPTED_SCOPE_INVALID' using errcode='42501';end if;
 select * into strict i from public.weekly_discrepancy_incidents where id=m.incident_id;
 select * into strict sg from public.weekly_source_groups where id=i.source_group_id;
 keys:=private.weekly_contact_source_identity_v1(sg.agency_id,sg.environment,i.candidate_id,i.client_id,'CHECK_HOURS','MANAGER',
  jsonb_build_object('work_event_id',i.work_event_id,'incident_id',i.id,'incident_episode',i.episode_number));
 if m.candidate_id<>i.candidate_id or m.client_id<>i.client_id or m.work_event_id is distinct from i.work_event_id
  or m.incident_episode is distinct from i.episode_number or encode(m.logical_contact_key,'hex')<>keys->>'logical_contact_key'
  or encode(m.budget_owner_key,'hex')<>keys->>'budget_owner_key' then
  raise exception 'WEEKLY_SOURCE_MANAGER_ACCEPTED_SCOPE_INVALID' using errcode='42501';end if;
 state:=private.weekly_contact_source_manager_followup_state_v1(i.id,p_at_utc);
 return(state-array['routine_sequence','basis_accepted_membership_id'])||jsonb_build_object('version','MANAGER_FOLLOWUP_TIMING_V1');
end;
$function$;

create or replace function private.weekly_contact_source_manager_followup_enqueue_v1(p_incident_id uuid,p_at timestamptz)
returns jsonb language plpgsql volatile security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
declare i public.weekly_discrepancy_incidents%rowtype;sg public.weekly_source_groups%rowtype;state jsonb;member jsonb;
 scope_id uuid;scope_revision text;checking jsonb;generation_id uuid;route_id uuid;intent_id uuid;logical bytea;group_key bytea;
 group_json jsonb;model jsonb;sequence integer;
begin
 select * into strict i from public.weekly_discrepancy_incidents where id=p_incident_id;
 select * into strict sg from public.weekly_source_groups where id=i.source_group_id;
 perform private.weekly_contact_deployment_lock_v1(sg.agency_id,sg.environment);
 perform private.weekly_contact_context_v1(sg.agency_id,sg.environment);
 scope_id:=private.weekly_contact_scope_lock_v1(sg.agency_id,sg.environment,i.candidate_id,i.client_id);
 p_at:=clock_timestamp();state:=private.weekly_contact_source_manager_followup_state_v1(i.id,p_at);
 if state->>'reason'<>'SCHEDULED' or state->>'mode'<>'AUTOMATIC' or(state->>'due_at_utc')::timestamptz>p_at then
  return jsonb_build_object('version','CONTACT_SOURCE_FOLLOWUP_ENQUEUE_V1','message_intent_id',null,'disposition',state->>'reason');end if;
 member:=private.weekly_contact_manual_member_facts_v1(i.id,'MANAGER',p_at);
 -- Manual cooldown is displayed for the explicit Office action. Automation
 -- instead uses its actual accepted-step due time; all other exclusions hold.
 if member->'eligible' is distinct from 'true'::jsonb and member->>'exclusion_reason'<>'MANUAL_ENQUIRY_COOLDOWN' then
  return jsonb_build_object('version','CONTACT_SOURCE_FOLLOWUP_ENQUEUE_V1','message_intent_id',null,'disposition',member->>'exclusion_reason');end if;
 checking:=private.weekly_contact_checking_scope_revision_v1(scope_id);
 select revision::text into strict scope_revision from public.weekly_contact_pause_scopes where id=scope_id;
 member:=member||jsonb_build_object('scope_id',scope_id,'scope_revision',scope_revision,'checking_revision',checking->>'revision',
  'send_ordinal',state->'next_send_ordinal','eligible',true,'exclusion_reason',null);
 member:=member||jsonb_build_object('followup_state',state);
 logical:=private.weekly_source_sha256_jsonb_v1('CONTACT_SOURCE_ROUTINE_FOLLOWUP_INTENT_V1',jsonb_build_object(
  'logical_contact_key',state->'logical_contact_key','routine_sequence',state->'routine_sequence','send_ordinal',state->'next_send_ordinal',
  'basis_accepted_at_utc',state->'last_accepted_at_utc','policy_revision',state->'policy_revision'));
 select id into intent_id from public.weekly_message_intents where logical_key=logical;
 if found then return jsonb_build_object('version','CONTACT_SOURCE_FOLLOWUP_ENQUEUE_V1','message_intent_id',intent_id,'disposition','ORIGINAL_QUEUED_STEP');end if;
 generation_id:=private.weekly_contact_manual_manager_generation_v1(jsonb_build_array(member),null,p_at);
 select recipient_route_id into strict route_id from public.weekly_manager_recipient_generations where id=generation_id;
 select coalesce(max(tranche_sequence),0)+1 into sequence from public.weekly_message_intents
  where recipient_generation_id=generation_id and tranche_kind='MANAGER_AUTOMATIC_FOLLOWUP';
 -- Reviewed additive native tranche: manual resend retains its own meaning.
 -- The capture seals the actual accepted predecessor and routine sequence.
 insert into public.weekly_message_intents(environment,agency_id,source_cycle_id,audience_kind,recipient_route_id,recipient_generation_id,
  sorted_due_event_ids,tranche_kind,tranche_sequence,logical_key,state,due_at_utc)
 values(sg.environment,sg.agency_id,i.source_cycle_id,'MANAGER',route_id,generation_id,'{}','MANAGER_AUTOMATIC_FOLLOWUP',sequence,logical,'DUE',p_at)
 returning id into intent_id;
 model:=jsonb_build_object('kind','MANAGER_QUERY_MODEL_V1','policy_version','1.8.0','renderer_version','1.4.0','structure_version','1.0.0',
  'rows',jsonb_build_array(member->'manager_row'),'plain_body',null,'attachment_count',0);
 group_key:=private.weekly_source_sha256_jsonb_v1('CONTACT_SOURCE_ROUTINE_FOLLOWUP_GROUP_V1',jsonb_build_object(
  'source_cycle_id',i.source_cycle_id,'recipient',member->'manager_address','logical_contact_key',state->'logical_contact_key'));
 group_json:=jsonb_build_object('group_key',encode(group_key,'hex'),'recipient',jsonb_build_object('candidate_id',null,'manager_address',member->'manager_address'),
  'preview',model,'canonical_content_sha256',encode(private.weekly_source_sha256_jsonb_v1('CONTACT_SOURCE_ROUTINE_FOLLOWUP_CONTENT_V1',
   jsonb_build_object('group_key',encode(group_key,'hex'),'preview',model,'recipient',member->'manager_address')),'hex'));
 perform private.weekly_contact_source_capture_insert_v1(intent_id,'ROUTINE_FOLLOWUP',null,null,jsonb_build_array(member),group_json,
  (state->>'routine_sequence')::integer,(state->>'basis_accepted_membership_id')::uuid,p_at,null);
 return jsonb_build_object('version','CONTACT_SOURCE_FOLLOWUP_ENQUEUE_V1','message_intent_id',intent_id,'disposition','ONE_DUE_AUTOMATIC_STEP_QUEUED');
end;
$function$;
