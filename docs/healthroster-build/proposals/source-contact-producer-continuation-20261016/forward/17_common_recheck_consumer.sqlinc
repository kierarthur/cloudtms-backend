-- One bounded native observation per selected original task and call. The
-- cursor is a real native UUID in an explicit phase; no pass claims the whole
-- task complete after visiting only manager work or a truncated result set.
create or replace function private.weekly_contact_recheck_task_selected_v1(p_task uuid,p_expected_selection jsonb,p_selection_at timestamptz)
returns jsonb language plpgsql volatile security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
declare task public.weekly_contact_recheck_tasks%rowtype;scope public.weekly_contact_pause_scopes%rowtype;
 progress public.weekly_contact_recheck_progress%rowtype;checking jsonb;native uuid;result jsonb;phase text;at_utc timestamptz;next_due timestamptz;
 selection jsonb;pair jsonb;selection_at timestamptz;
begin
 select * into strict task from public.weekly_contact_recheck_tasks where id=p_task;
 select * into strict scope from public.weekly_contact_pause_scopes where id=task.scope_id;
 perform private.weekly_contact_deployment_lock_v1(scope.agency_id,scope.environment);
 perform private.weekly_contact_context_v1(scope.agency_id,scope.environment);
 selection_at:=coalesce(p_selection_at,clock_timestamp());selection:=private.weekly_contact_recheck_selection_scope_facts_v1(task.id,selection_at);
 if p_expected_selection is not null and selection is distinct from p_expected_selection then
  raise exception 'CONTACT_RECHECK_SELECTION_STALE' using errcode='40001';end if;
 for pair in select value from jsonb_array_elements(selection->'pairs')order by(value->>'candidate_id')::uuid,(value->>'client_id')::uuid loop
  perform private.weekly_contact_scope_lock_v1(scope.agency_id,scope.environment,(pair->>'candidate_id')::uuid,(pair->>'client_id')::uuid);end loop;
 if private.weekly_contact_recheck_selection_scope_facts_v1(task.id,selection_at)is distinct from selection then
  raise exception 'CONTACT_RECHECK_SELECTION_STALE' using errcode='40001';end if;
 select * into strict scope from public.weekly_contact_pause_scopes where id=scope.id;
 select * into strict task from public.weekly_contact_recheck_tasks where id=p_task for update;
 at_utc:=clock_timestamp();
 if task.state='DONE' or task.due_at_utc>at_utc or(task.state='LEASED' and task.lease_expires_at_utc>at_utc) then
  return jsonb_build_object('version','CONTACT_RECHECK_TASK_RESULT_V1','task_id',task.id,'disposition','NOT_DUE');end if;
 checking:=private.weekly_contact_checking_scope_revision_v1(scope.id);
 select * into progress from public.weekly_contact_recheck_progress where task_id=task.id for update;
 if not found or progress.phase='COMPLETE' or(progress.scope_revision,progress.checking_revision)
    is distinct from(scope.revision,(checking->>'revision')::bigint) then
  perform private.weekly_contact_recheck_record_v1(task.id,'SOURCE_ACTIVATION',null,scope.revision,(checking->>'revision')::bigint,
   decode(checking->>'facts_sha256','hex'),jsonb_build_object('version','CONTACT_RECHECK_OBSERVATION_V1','disposition','CURRENT_SCOPE_BEGIN'));
  select * into strict progress from public.weekly_contact_recheck_progress where task_id=task.id;
 end if;
 loop
  phase:=progress.phase;
  select native_id into native from private.weekly_contact_recheck_native_ids_v1(scope.id,phase,progress.last_native_id) order by native_id limit 1;
  if native is not null then
   if(phase,native)is distinct from(selection->>'phase',(selection->>'native_id')::uuid)then
    raise exception 'CONTACT_RECHECK_SELECTION_STALE' using errcode='40001';end if;
   if phase='SOURCE_ACTIVATION' then
    result:=private.weekly_contact_source_scope_first_activation_v1(scope.id,native);
   elsif phase in('SOURCE_WORKER','SOURCE_MANAGER') then
    result:=private.weekly_contact_source_recompose_intent_v1(native,null);
   elsif phase='LEGACY_OUTBOX' then
    -- This is the actual existing query-body/attachment/outbox recomposer,
    -- with its original accepted/unknown ownership and full original scopes.
    result:=private.weekly_contact_query_recompose_v1(native,scope.agency_id,scope.environment,null,null);
   else raise exception 'CONTACT_RECHECK_PROGRESS_INVALID' using errcode='23514';end if;
   checking:=private.weekly_contact_checking_scope_revision_v1(scope.id);
   perform private.weekly_contact_recheck_record_v1(task.id,phase,native,scope.revision,(checking->>'revision')::bigint,
    decode(checking->>'facts_sha256','hex'),jsonb_build_object('version','CONTACT_RECHECK_OBSERVATION_V1','disposition','NATIVE_OBSERVED','result',result));
   update public.weekly_contact_recheck_tasks set state='READY',lease_token=null,lease_expires_at_utc=null where id=task.id;
   return jsonb_build_object('version','CONTACT_RECHECK_TASK_RESULT_V1','task_id',task.id,'disposition','CONTINUE',
    'phase',phase,'native_id',native,'native_disposition',result->'disposition');
  end if;
  phase:=case phase when 'SOURCE_ACTIVATION' then 'SOURCE_WORKER' when 'SOURCE_WORKER' then 'SOURCE_MANAGER'
   when 'SOURCE_MANAGER' then 'LEGACY_OUTBOX' else 'COMPLETE' end;
  perform private.weekly_contact_recheck_record_v1(task.id,phase,null,scope.revision,(checking->>'revision')::bigint,
   decode(checking->>'facts_sha256','hex'),jsonb_build_object('version','CONTACT_RECHECK_OBSERVATION_V1','disposition','PHASE_EXHAUSTED'));
  if phase='COMPLETE' then exit;end if;
  select * into strict progress from public.weekly_contact_recheck_progress where task_id=task.id;
 end loop;
 at_utc:=clock_timestamp();next_due:=private.weekly_contact_recheck_next_due_v1(scope.id,at_utc);
 if next_due is null then
  update public.weekly_contact_recheck_tasks set state='DONE',lease_token=null,lease_expires_at_utc=null,completed_at_utc=at_utc,
   disposition_json=jsonb_build_object('version','CONTACT_RECHECK_COMPLETION_V1','phase','COMPLETE','scope_revision',scope.revision::text,
    'checking_revision',checking->>'revision','all_current_phases_exhausted',true) where id=task.id;
 else
  update public.weekly_contact_recheck_tasks set state='READY',due_at_utc=next_due,lease_token=null,lease_expires_at_utc=null where id=task.id;
 end if;
 return jsonb_build_object('version','CONTACT_RECHECK_TASK_RESULT_V1','task_id',task.id,
  'disposition',case when next_due is null then 'COMPLETE' else 'WAITING_ACTUAL_NATIVE_DUE' end,
  'next_due_at_utc',case when next_due is null then null else to_char(next_due at time zone 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') end);
end;
$function$;

create or replace function private.weekly_contact_recheck_task_v1(p_task uuid)
returns jsonb language plpgsql volatile security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
begin return private.weekly_contact_recheck_task_selected_v1(p_task,null,null);end;
$function$;

create or replace function public.weekly_source_contact_recheck_batch_v1(p_request jsonb)
returns jsonb language plpgsql volatile security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
declare agency uuid;deployment_environment text;worker text;batch_limit integer;selected record;result jsonb;results jsonb:='[]';
 processed integer:=0;held integer:=0;selection_at timestamptz;selections jsonb:='[]';selection jsonb;pair record;valid_selections jsonb:='[]';
begin
 perform private.weekly_source_query_require_service_v1();
 perform private.weekly_contact_assert_closed_v1(p_request,array['version','agency_id','environment','worker_id','limit'],
  array['version','agency_id','environment','worker_id','limit'],'CONTACT_RECHECK_REQUEST_INVALID');
 if p_request->>'version' is distinct from 'CONTACT_RECHECK_BATCH_V1' or jsonb_typeof(p_request->'environment') is distinct from 'string'
  or p_request->>'environment' not in('TEST','LIVE') or jsonb_typeof(p_request->'worker_id') is distinct from 'string'
  or char_length(p_request->>'worker_id') not between 1 and 120 or btrim(p_request->>'worker_id')=''
  or jsonb_typeof(p_request->'limit') is distinct from 'number' or p_request->>'limit'!~'^[1-9][0-9]*$'
  or(p_request->>'limit')::numeric>100 then raise exception 'CONTACT_RECHECK_REQUEST_INVALID' using errcode='22023';end if;
 agency:=private.weekly_contact_uuid_v1(p_request->'agency_id');deployment_environment:=p_request->>'environment';
 worker:=p_request->>'worker_id';batch_limit:=(p_request->>'limit')::integer;
 perform private.weekly_contact_deployment_lock_v1(agency,deployment_environment);
 perform private.weekly_contact_context_v1(agency,deployment_environment);
 selection_at:=clock_timestamp();
 for selected in select task.id from public.weekly_contact_recheck_tasks task join public.weekly_contact_pause_scopes scope on scope.id=task.scope_id
  where scope.agency_id=agency and scope.environment=deployment_environment and task.due_at_utc<=selection_at
   and(task.state='READY' or(task.state='LEASED' and task.lease_expires_at_utc<=selection_at))
  order by task.due_at_utc,task.id limit batch_limit loop
  begin
   selections:=selections||jsonb_build_array(private.weekly_contact_recheck_selection_scope_facts_v1(selected.id,selection_at));
  exception when others then
   held:=held+1;results:=results||jsonb_build_array(jsonb_build_object('version','CONTACT_RECHECK_TASK_RESULT_V1','task_id',selected.id,
    'disposition','HELD_DEPENDENCY','code','CONTACT_RECHECK_ITEM_HELD'));
  end;
 end loop;
 -- All actual connected native bodies in this existing bounded batch precede
 -- every task/progress/native row mutation, in the shared sorted scope order.
 for pair in select distinct(native_pair.value->>'candidate_id')::uuid candidate_id,(native_pair.value->>'client_id')::uuid client_id
  from jsonb_array_elements(selections)selected_fact(value) cross join lateral jsonb_array_elements(selected_fact.value->'pairs')native_pair(value) order by 1,2 loop
  perform private.weekly_contact_scope_lock_v1(agency,deployment_environment,pair.candidate_id,pair.client_id);end loop;
 for selection in select value from jsonb_array_elements(selections)loop
  begin
   if private.weekly_contact_recheck_selection_scope_facts_v1((selection->'task'->>'id')::uuid,selection_at)is distinct from selection then
    raise exception 'CONTACT_RECHECK_SELECTION_STALE' using errcode='40001';end if;
   valid_selections:=valid_selections||jsonb_build_array(selection);
  exception when others then
   held:=held+1;results:=results||jsonb_build_array(jsonb_build_object('version','CONTACT_RECHECK_TASK_RESULT_V1','task_id',(selection->'task'->>'id')::uuid,
    'disposition','HELD_DEPENDENCY','code','CONTACT_RECHECK_ITEM_HELD'));
  end;
 end loop;
 for selection in select value from jsonb_array_elements(valid_selections)loop
  begin
   result:=private.weekly_contact_recheck_task_selected_v1((selection->'task'->>'id')::uuid,selection,selection_at);processed:=processed+1;
  exception when others then
   -- The per-item subtransaction rolls back every partial child/cursor. The
   -- original task and sender owners remain available for the same retry.
   held:=held+1;result:=jsonb_build_object('version','CONTACT_RECHECK_TASK_RESULT_V1','task_id',(selection->'task'->>'id')::uuid,
    'disposition','HELD_DEPENDENCY','code','CONTACT_RECHECK_ITEM_HELD');
  end;
  results:=results||jsonb_build_array(result);
 end loop;
 return jsonb_build_object('ok',true,'version','CONTACT_RECHECK_BATCH_RESULT_V1','processed',processed,'held',held,
  'selection_complete',false,'results',results);
end;
$function$;
