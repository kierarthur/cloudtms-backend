-- The existing Office Send manager now selection can perform a configured,
-- genuinely due MANUAL step. New enquiry remains EXPLICIT_MANUAL and is never
-- inferred to have consumed this routine vector. This is an internal owner,
-- not another browser command or a replacement provider/sender.
create or replace function private.weekly_contact_source_manager_manual_step_v1(p_actor uuid,p_cycle uuid,p_publication uuid,
 p_incidents uuid[],p_workspace_version text)
returns jsonb language plpgsql volatile security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
declare guard jsonb;sg public.weekly_source_groups%rowtype;incident public.weekly_discrepancy_incidents%rowtype;
 state jsonb;member jsonb;members jsonb:='[]';scope_id uuid;checking jsonb;at_utc timestamptz;due timestamptz;
 recipient text;generation_id uuid;route_id uuid;intent_id uuid;sequence integer;key bytea;group_key bytea;group_json jsonb;model jsonb;
begin
 perform private.weekly_source_query_require_service_v1();
 guard:=private.weekly_source_query_current_publication_v1(p_cycle,p_publication);
 perform private.weekly_source_office_authority_v1(p_actor,'SEND_MANAGER',(guard->>'source_group_id')::uuid,null,
  (guard->>'finalisation_week_ending')::date);
 select * into strict sg from public.weekly_source_groups where id=(guard->>'source_group_id')::uuid;
 if p_incidents is null or cardinality(p_incidents)=0 or cardinality(p_incidents)>500
  or cardinality(p_incidents)<>(select count(distinct id) from unnest(p_incidents)id)
  or p_workspace_version is null or p_workspace_version!~'^[0-9a-f]{64}$'
  or(select count(*) from public.weekly_discrepancy_incidents where id=any(p_incidents) and source_cycle_id=p_cycle)<>cardinality(p_incidents) then
  raise exception 'WEEKLY_SOURCE_MANAGER_SEND_SELECTION_INVALID' using errcode='22023';end if;
 perform private.weekly_contact_deployment_lock_v1(sg.agency_id,sg.environment);
 perform private.weekly_contact_context_v1(sg.agency_id,sg.environment);
 perform private.weekly_contact_source_manager_selection_lock_v1(p_incidents,'[]');
 for incident in select distinct on(candidate_id,client_id)* from public.weekly_discrepancy_incidents where id=any(p_incidents)
  order by candidate_id,client_id,id loop
  perform private.weekly_contact_scope_lock_v1(sg.agency_id,sg.environment,incident.candidate_id,incident.client_id);
 end loop;
 at_utc:=clock_timestamp();
 for incident in select * from public.weekly_discrepancy_incidents where id=any(p_incidents) order by id loop
  member:=private.weekly_contact_manual_member_facts_v1(incident.id,'MANAGER',at_utc);
  state:=private.weekly_contact_source_manager_followup_state_v1(incident.id,at_utc);
  if member->'eligible' is distinct from 'true'::jsonb or state->>'reason' is distinct from 'SCHEDULED'
   or state->>'mode' is distinct from 'MANUAL' or(state->>'due_at_utc')::timestamptz>at_utc then
   raise exception 'WEEKLY_SOURCE_MANAGER_SEND_SELECTION_STALE' using errcode='40001';end if;
  if recipient is null then recipient:=member->>'manager_address';
  elsif recipient is distinct from member->>'manager_address' then
   raise exception 'WEEKLY_SOURCE_MANAGER_SEND_ONE_RECIPIENT_REQUIRED' using errcode='22023';end if;
  scope_id:=private.weekly_contact_scope_lock_v1(sg.agency_id,sg.environment,incident.candidate_id,incident.client_id);
  checking:=private.weekly_contact_checking_scope_revision_v1(scope_id);
  member:=member||jsonb_build_object('scope_id',scope_id,
   'scope_revision',(select revision::text from public.weekly_contact_pause_scopes where id=scope_id),
   'checking_revision',checking->>'revision','send_ordinal',state->'next_send_ordinal','followup_state',state,
   'routine_step',state->'routine_sequence','basis_accepted_membership_id',state->'basis_accepted_membership_id');
  due:=greatest(due,(state->>'due_at_utc')::timestamptz);
  members:=members||jsonb_build_array(member);
 end loop;
 key:=private.weekly_source_sha256_jsonb_v1('CONTACT_SOURCE_ROUTINE_MANUAL_INTENT_V1',jsonb_build_object(
  'actor_user_id',p_actor,'source_cycle_id',p_cycle,'projection_publication_id',p_publication,'workspace_version',p_workspace_version,
  'members',(select jsonb_agg(jsonb_build_object('logical_contact_key',m->'logical_contact_key','send_ordinal',m->'send_ordinal',
   'routine_step',m->'routine_step','basis_accepted_at_utc',m->'followup_state'->'last_accepted_at_utc',
   'policy_revision',m->'followup_state'->'policy_revision') order by m->>'logical_contact_key') from jsonb_array_elements(members)m)));
 select id into intent_id from public.weekly_message_intents where logical_key=key;
 if found then return jsonb_build_object('ok',true,'status','ORIGINAL_QUEUED_STEP','message_intent_id',intent_id);end if;
 generation_id:=private.weekly_contact_manual_manager_generation_v1(members,p_actor,at_utc);
 select recipient_route_id into strict route_id from public.weekly_manager_recipient_generations where id=generation_id;
 select coalesce(max(tranche_sequence),0)+1 into sequence from public.weekly_message_intents
  where recipient_generation_id=generation_id and tranche_kind='MANAGER_MANUAL_RESEND';
 insert into public.weekly_message_intents(environment,agency_id,source_cycle_id,audience_kind,recipient_route_id,recipient_generation_id,
  sorted_due_event_ids,tranche_kind,tranche_sequence,logical_key,state,due_at_utc,created_at_utc)
 values(sg.environment,sg.agency_id,p_cycle,'MANAGER',route_id,generation_id,'{}','MANAGER_MANUAL_RESEND',sequence,key,'DUE',due,clock_timestamp())
 returning id into intent_id;
 select jsonb_build_object('kind','MANAGER_QUERY_MODEL_V1','policy_version','1.8.0','renderer_version','1.4.0','structure_version','1.0.0',
  'rows',jsonb_agg(m->'manager_row' order by private.weekly_source_query_ascii_fold_v1(m->'manager_row'->>'clientName') collate "C",m->>'client_id',
   private.weekly_source_query_ascii_fold_v1(m->'manager_row'->>'displayName') collate "C",m->>'candidate_id',m->'manager_row'->>'workDate',
   m->'manager_row'->>'sourceStartInstant',m->>'issue_id'),'plain_body',null,'attachment_count',0) into model from jsonb_array_elements(members)m;
 group_key:=private.weekly_source_sha256_jsonb_v1('CONTACT_SOURCE_ROUTINE_MANUAL_GROUP_V1',jsonb_build_object(
  'source_cycle_id',p_cycle,'recipient',recipient,'workspace_version',p_workspace_version,'incident_ids',to_jsonb(p_incidents)));
 group_json:=jsonb_build_object('group_key',encode(group_key,'hex'),'recipient',jsonb_build_object('candidate_id',null,'manager_address',recipient),
  'preview',model,'canonical_content_sha256',encode(private.weekly_source_sha256_jsonb_v1('CONTACT_SOURCE_ROUTINE_MANUAL_CONTENT_V1',
   jsonb_build_object('group_key',encode(group_key,'hex'),'preview',model,'recipient',recipient)),'hex'));
 perform private.weekly_contact_source_capture_insert_v1(intent_id,'ROUTINE_MANUAL_FOLLOWUP',null,null,members,group_json,null,null,at_utc,p_actor);
 return jsonb_build_object('ok',true,'status','ONE_DUE_MANUAL_STEP_QUEUED','message_intent_id',intent_id);
end;
$function$;
