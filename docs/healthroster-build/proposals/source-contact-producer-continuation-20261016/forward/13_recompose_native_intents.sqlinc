-- A new exact subset gets its own real native intent/render/provider identity.
-- The old whole body/link is retired atomically. Original question clocks,
-- accepted/uncertain attempts and per-member logical ordinals are never edited.
create or replace function private.weekly_contact_source_recompose_intent_v1(p_intent_id uuid,p_manager_generation uuid)
returns jsonb language plpgsql volatile security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
declare original public.weekly_message_intents%rowtype;cap public.weekly_contact_source_intent_captures%rowtype;
 members jsonb;model jsonb;group_json jsonb;recipient jsonb;key bytea;group_key bytea;intent_id uuid;generation_id uuid;
 route_id uuid;old_kind text;kind text;manual_request uuid;at_utc timestamptz;event_ids uuid[];member jsonb;receipt_count integer;
begin
 select * into strict original from public.weekly_message_intents where id=p_intent_id;
 perform private.weekly_contact_source_intent_composition_lock_v1(original.id);
 perform private.weekly_contact_source_intent_lock_v1(original.id);
 perform target.id from public.weekly_message_dispatch_targets target join public.weekly_message_dispatch_commands command
  on command.id=target.dispatch_command_id where command.message_intent_id=original.id order by target.id for update of target;
 perform id from public.weekly_message_dispatch_commands where message_intent_id=original.id order by id for update;
 if original.state='DISPATCHED' or exists(select 1 from public.weekly_message_renders render where render.message_intent_id=original.id
  and private.weekly_contact_source_render_attempted_v1(render.id)) then
  return jsonb_build_object('version','CONTACT_SOURCE_RECOMPOSITION_V1','original_message_intent_id',original.id,
   'message_intent_id',null,'disposition','ORIGINAL_ATTEMPT_OWNER');end if;
 at_utc:=clock_timestamp();
 select * into cap from public.weekly_contact_source_intent_captures where message_intent_id=original.id;
 if found and original.state in('DUE','RENDERED') and(p_manager_generation is null or p_manager_generation=original.recipient_generation_id)
  and private.weekly_contact_source_capture_current_v1(original.id,at_utc,true) then
  return jsonb_build_object('version','CONTACT_SOURCE_RECOMPOSITION_V1','original_message_intent_id',original.id,
   'message_intent_id',original.id,'disposition','CURRENT_CAPTURE_UNCHANGED');end if;
 members:=private.weekly_contact_source_intent_current_subset_v1(original.id,at_utc);
 select * into cap from public.weekly_contact_source_intent_captures where message_intent_id=original.id;
 if jsonb_array_length(members)=0 then
  if not private.weekly_contact_source_retire_unsubmitted_v1(original.id) then
   raise exception 'CONTACT_SOURCE_ORIGINAL_ATTEMPT_OWNER' using errcode='40001';end if;
  return jsonb_build_object('version','CONTACT_SOURCE_RECOMPOSITION_V1','original_message_intent_id',original.id,
   'message_intent_id',null,'disposition','NO_CURRENT_ELIGIBLE_SUBSET');end if;
 kind:=case when cap.capture_kind in('EXPLICIT_MANUAL','MANUAL_RECOMPOSITION') then 'MANUAL_RECOMPOSITION'
  when cap.capture_kind in('ROUTINE_FOLLOWUP','FOLLOWUP_RECOMPOSITION','ROUTINE_MANUAL_FOLLOWUP') then 'FOLLOWUP_RECOMPOSITION'
  else 'ROUTINE_RECOMPOSITION' end;manual_request:=cap.manual_request_id;
 if original.audience_kind='MANAGER' then
  generation_id:=p_manager_generation;
  if generation_id is null then
   generation_id:=private.weekly_contact_manual_manager_generation_v1(members,null,at_utc);
  end if;
  select recipient_route_id into strict route_id from public.weekly_manager_recipient_generations where id=generation_id and state='ACTIVE';
  select jsonb_build_object('kind','MANAGER_QUERY_MODEL_V1','policy_version','1.8.0','renderer_version','1.4.0','structure_version','1.0.0',
   'rows',jsonb_agg(m->'manager_row' order by private.weekly_source_query_ascii_fold_v1(m->'manager_row'->>'clientName') collate "C",m->>'client_id',
    private.weekly_source_query_ascii_fold_v1(m->'manager_row'->>'displayName') collate "C",m->>'candidate_id',m->'manager_row'->>'workDate',
    m->'manager_row'->>'sourceStartInstant',m->>'issue_id'),'plain_body',null,'attachment_count',0) into model from jsonb_array_elements(members)m;
  recipient:=jsonb_build_object('candidate_id',null,'manager_address',members->0->'manager_address');
  if exists(select 1 from jsonb_array_elements(members)m where m->>'manager_address' is distinct from recipient->>'manager_address') then
   raise exception 'CONTACT_SOURCE_RECOMPOSITION_RECIPIENT_CHANGED' using errcode='40001';end if;
  -- Retain real due provenance while binding this new native generation's
  -- exact copied event. No current-clock substitute is used for the due time.
  if generation_id=original.recipient_generation_id then event_ids:=original.sorted_due_event_ids;
  else
   select coalesce(array_agg(rebased_event_id order by rebased_event_id),'{}') into event_ids
    from public.weekly_contact_source_due_event_rebases where recipient_generation_id=generation_id and original_event_id=any(original.sorted_due_event_ids);
  end if;
  if cardinality(original.sorted_due_event_ids)>0 and cardinality(event_ids)<>cardinality(original.sorted_due_event_ids) then
   raise exception 'CONTACT_SOURCE_RECOMPOSITION_DUE_PROVENANCE_UNAVAILABLE' using errcode='55000';end if;
 else
  generation_id:=original.candidate_generation_id;event_ids:=original.sorted_due_event_ids;
  recipient:=jsonb_build_object('candidate_id',members->0->'candidate_id','manager_address',null);
  model:=jsonb_build_object('kind','WORKER_QUERY_MODEL_V1','policy_version','weekly-source-candidate-push-v1','renderer_version','1.0.0',
   'structure_version',null,'rows','[]'::jsonb,'plain_body',case members->0->>'purpose' when 'CHECK_HOURS'
     then 'Open MyTMS to check your Timesheet hours.' else 'Open MyTMS to submit your Timesheet hours.' end,'attachment_count',0);
 end if;
 group_key:=private.weekly_source_sha256_jsonb_v1('CONTACT_SOURCE_RECOMPOSITION_GROUP_V1',jsonb_build_object(
  'original_message_intent_id',original.id,'native_generation_id',generation_id,'recipient',recipient));
 select private.weekly_source_sha256_jsonb_v1('CONTACT_SOURCE_RECOMPOSITION_INTENT_V1',jsonb_build_object(
  'group_key',encode(group_key,'hex'),'original_due_at_utc',to_char(original.due_at_utc at time zone 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"'),
  'members',jsonb_agg(jsonb_build_object('logical_contact_key',m->'logical_contact_key','native_member_id',m->'native_member_id',
   'comparison_revision_id',m->'comparison_revision_id','send_ordinal',m->'send_ordinal','policy_sha256',m->'policy_sha256') order by m->>'logical_contact_key'),
  'preview',model)) into key from jsonb_array_elements(members)m;
 select id into intent_id from public.weekly_message_intents where logical_key=key;
 if found then return jsonb_build_object('version','CONTACT_SOURCE_RECOMPOSITION_V1','original_message_intent_id',original.id,
  'message_intent_id',intent_id,'disposition','ORIGINAL_SUBSET_REPLAY');end if;
 group_json:=jsonb_build_object('group_key',encode(group_key,'hex'),'recipient',recipient,'preview',model,
  'canonical_content_sha256',encode(private.weekly_source_sha256_jsonb_v1('CONTACT_SOURCE_RECOMPOSITION_CONTENT_V1',
    jsonb_build_object('group_key',encode(group_key,'hex'),'recipient',recipient,'preview',model)),'hex'));
 insert into public.weekly_message_intents(environment,agency_id,source_cycle_id,audience_kind,candidate_cohort_id,candidate_generation_id,
  recipient_route_id,recipient_generation_id,sorted_due_event_ids,tranche_kind,tranche_sequence,logical_key,state,due_at_utc,created_at_utc)
 values(original.environment,original.agency_id,original.source_cycle_id,original.audience_kind,original.candidate_cohort_id,
  case when original.audience_kind='CANDIDATE' then generation_id end,route_id,
  case when original.audience_kind='MANAGER' then generation_id end,event_ids,original.tranche_kind,original.tranche_sequence,key,'DUE',original.due_at_utc,clock_timestamp())
 returning id into intent_id;
 perform private.weekly_contact_source_capture_insert_v1(intent_id,kind,manual_request,original.id,members,group_json,null,null,at_utc,cap.accepted_actor_user_id);
 if not private.weekly_contact_source_retire_unsubmitted_v1(original.id) then
  raise exception 'CONTACT_SOURCE_ORIGINAL_ATTEMPT_OWNER' using errcode='40001';end if;
 return jsonb_build_object('version','CONTACT_SOURCE_RECOMPOSITION_V1','original_message_intent_id',original.id,
  'message_intent_id',intent_id,'disposition','EXACT_CURRENT_SUBSET_QUEUED');
end;
$function$;
