create or replace function private.weekly_contact_query_recompose_v1(
 p_delivery_id uuid,p_agency uuid,p_environment text,p_claimed_outbox uuid default null,p_claim_token text default null
) returns jsonb language plpgsql volatile security definer set search_path='pg_catalog','public','private','pg_temp'
as $function$
declare requested public.hr_issue_email_deliveries%rowtype;root public.hr_issue_email_deliveries%rowtype;
 d public.hr_issue_email_deliveries%rowtype;o public.mail_outbox%rowtype;item public.hr_issue_email_delivery_items%rowtype;
 pair record;fact jsonb;guard jsonb;logical bytea;ordinal integer;eligible text[]:='{}';excluded jsonb:='[]';
 unknown_count integer:=0;accepted_count integer:=0;paused_count integer:=0;next_at timestamptz;at_utc timestamptz;
 target_id uuid;target_mail uuid;revision bigint;native_result jsonb;saved jsonb;ids text[];outcome text;reason text;
begin
 perform private.weekly_source_query_require_service_v1();
 perform private.weekly_contact_deployment_lock_v1(p_agency,p_environment);
 perform private.weekly_contact_context_v1(p_agency,p_environment);
 select * into strict requested from public.hr_issue_email_deliveries where id=p_delivery_id;
 select * into strict root from public.hr_issue_email_deliveries where id=requested.original_delivery_id;
 if root.original_delivery_id<>root.id or root.payload_revision<>1 or root.import_id<>requested.import_id
  or root.operation_id<>requested.operation_id then raise exception 'CONTACT_QUERY_SCOPE_INVALID' using errcode='42501';end if;
 -- Discover all genuine original scopes before acquiring any native row lock.
 for pair in select distinct a.candidate_id,a.client_id from public.hr_issue_email_delivery_items i
  join public.import_review_decisions a on a.action_id=i.action_id where i.delivery_id=root.id order by a.candidate_id,a.client_id loop
  if pair.candidate_id is null or pair.client_id is null then raise exception 'CONTACT_QUERY_SCOPE_INVALID' using errcode='42501';end if;
  perform private.weekly_contact_scope_lock_v1(p_agency,p_environment,pair.candidate_id,pair.client_id);
 end loop;
 -- Original outbox first, then the finite actual family, then delivery rows.
 perform 1 from public.mail_outbox where id=root.mail_outbox_id for update;
 perform 1 from public.mail_outbox m join public.hr_issue_email_deliveries x on x.mail_outbox_id=m.id
  where x.original_delivery_id=root.id order by m.id for update of m;
 select * into strict root from public.hr_issue_email_deliveries where id=root.id for update;
 perform 1 from public.hr_issue_email_deliveries x where x.original_delivery_id=root.id order by x.id for update;
 select * into strict requested from public.hr_issue_email_deliveries where id=p_delivery_id;
 perform public._import_review_assert_actor_v1(root.created_by_user_id);
 if p_claimed_outbox is not null then
  select * into strict o from public.mail_outbox where id=p_claimed_outbox;
  if requested.mail_outbox_id<>o.id or o.attempt_lease_token is distinct from p_claim_token
   or o.attempt_lease_expires_at_utc is null or o.attempt_lease_expires_at_utc<=clock_timestamp() then
   raise exception 'CONTACT_QUERY_LEASE_STALE' using errcode='40001';end if;
 end if;
 at_utc:=clock_timestamp();ordinal:=root.reminder_sequence+1;
 for item in select * from public.hr_issue_email_delivery_items where delivery_id=root.id order by action_id,id loop
  fact:=private.weekly_contact_query_member_v1(root.id,item.id);reason:=null;
  logical:=private.weekly_source_sha256_jsonb_v1('WEEKLY_CONTACT_QUERY_MEMBERSHIP_V1',jsonb_build_object('issue_id',item.issue_id,'purpose','TIMESHEET_QUERY'));
  if exists(select 1 from public.weekly_contact_delivery_memberships m where m.logical_contact_key=logical and m.send_ordinal=ordinal and m.accepted_at_utc is not null)
   or exists(select 1 from public.hr_issue_email_delivery_items i join public.hr_issue_email_deliveries x on x.id=i.delivery_id
    where i.action_id=item.action_id and i.marked_sent_at_utc is not null and x.status='SENT') then
   accepted_count:=accepted_count+1;reason:='ALREADY_ACCEPTED';
  elsif exists(select 1 from public.weekly_contact_delivery_memberships m join public.weekly_contact_submission_permits p on p.query_delivery_id=m.delivery_id
   where m.logical_contact_key=logical and m.send_ordinal=ordinal and p.owner_kind='TIMESHEET_QUERY_OUTBOX' and p.status in('PREPARED','STARTED','AMBIGUOUS'))
   or exists(select 1 from public.hr_issue_email_delivery_items i join public.hr_issue_email_deliveries x on x.id=i.delivery_id
    where i.action_id=item.action_id and x.legacy_claim_lease_token is not null and x.status<>'SENT')
   or exists(select 1 from public.hr_issue_email_delivery_items i join public.hr_issue_email_deliveries x on x.id=i.delivery_id
    join public.mail_outbox mail on mail.id=x.mail_outbox_id where i.action_id=item.action_id and mail.provider_status='DELIVERY_UNCERTAIN') then
   unknown_count:=unknown_count+1;reason:='CHECK_ORIGINAL_ATTEMPT';
  elsif fact->'current' is distinct from 'true'::jsonb then reason:='OBSOLETE';
  else
   guard:=private.weekly_contact_scope_guard_v1((fact->'pair'->>'candidate_id')::uuid,(fact->'pair'->>'client_id')::uuid,'MANAGER',at_utc);
   if guard->'allow' is distinct from 'true'::jsonb then
    if guard->>'next_allowed_utc' is null then raise exception 'CONTACT_QUERY_SCOPE_INVALID' using errcode='42501';end if;
    paused_count:=paused_count+1;reason:='CONTACT_PAUSED';next_at:=least(next_at,(guard->>'next_allowed_utc')::timestamptz);
   end if;
  end if;
  if reason is null then eligible:=array_append(eligible,item.action_id);
  else excluded:=excluded||jsonb_build_array(jsonb_build_object('action_id',item.action_id,'issue_id',item.issue_id,'reason',reason));end if;
 end loop;
 -- A shared immutable PDF key cannot be carried through after another worker
 -- using that key was excluded. Request genuine per-Timesheet native evidence;
 -- do not invent a PDF, strip pages or claim a multi-worker attachment is safe.
 if exists(select 1 from public.hr_issue_email_delivery_items a join public.import_review_decisions da on da.action_id=a.action_id
  join public.hr_issue_email_delivery_items b on b.delivery_id=a.delivery_id and b.action_id<>a.action_id
  join public.import_review_decisions db on db.action_id=b.action_id
  where a.delivery_id=root.id and a.action_id=any(eligible) and not(b.action_id=any(eligible))
   and da.candidate_id is distinct from db.candidate_id
   and private.weekly_source_issued_signed_query_evidence_v1(da.timesheet_id,root.import_id)->>'attachment_r2_key'
    =private.weekly_source_issued_signed_query_evidence_v1(db.timesheet_id,root.import_id)->>'attachment_r2_key') then
  raise exception 'CONTACT_QUERY_SHARED_ATTACHMENT_REQUIRES_NATIVE_REBUILD' using errcode='55000';end if;
 if cardinality(eligible)>0 then
  for d in select * from public.hr_issue_email_deliveries x where x.original_delivery_id=root.id and x.status='QUEUED' and x.retired_at_utc is null order by payload_revision loop
   select array_agg(i.action_id order by i.action_id) into ids from public.hr_issue_email_delivery_items i where i.delivery_id=d.id;
   if ids=eligible and private.weekly_contact_query_content_v1(d.mail_outbox_id,d.id)->'current'='true'::jsonb then
    if target_id is not null then raise exception 'CONTACT_QUERY_ACTIVE_PAYLOAD_DUPLICATE' using errcode='40001';end if;
    target_id:=d.id;target_mail:=d.mail_outbox_id;
   end if;
  end loop;
  if target_id is null then
   revision:=root.next_payload_revision;
   if revision=9223372036854775807 then raise exception 'CONTACT_QUERY_REVISION_EXHAUSTED' using errcode='22003';end if;
   native_result:=private.weekly_contact_query_enqueue_core_v1(root.import_id,root.operation_id,to_jsonb(eligible),root.created_by_user_id,5000,100,root.id,revision);
   if native_result->>'group_count'<>'1' then raise exception 'CONTACT_QUERY_RECOMPOSITION_GROUP_CHANGED' using errcode='40001';end if;
   target_id:=(native_result->'groups'->0->>'delivery_id')::uuid;target_mail:=(native_result->'groups'->0->>'mail_outbox_id')::uuid;
   update public.hr_issue_email_deliveries set next_payload_revision=revision+1 where id=root.id;
   saved:=private.weekly_contact_query_content_v1(target_mail,target_id);
   if saved->'current' is distinct from 'true'::jsonb then raise exception 'CONTACT_QUERY_RECOMPOSITION_STALE' using errcode='40001';end if;
  end if;
 end if;
 -- Only never-admitted payloads may retire. Retain original START/unknown
 -- ownership even after a lease expires; an expiry is no provider evidence.
 for d in select * from public.hr_issue_email_deliveries x where x.original_delivery_id=root.id and x.status='QUEUED'
  and x.id is distinct from target_id order by x.id loop
  if exists(select 1 from public.weekly_contact_submission_permits p where p.query_delivery_id=d.id and p.status in('PREPARED','STARTED','AMBIGUOUS','ACCEPTED')) then continue;end if;
  select * into strict o from public.mail_outbox where id=d.mail_outbox_id;
  if o.status::text='SENT' or o.sent_at is not null or o.provider_status='DELIVERY_UNCERTAIN' or d.legacy_claim_lease_token is not null then continue;end if;
  update public.hr_issue_email_deliveries set status='RETIRED',retired_at_utc=at_utc,
   retirement_reason=case when target_id is not null then 'CONTACT_RECOMPOSED' when paused_count>0 then 'CONTACT_PAUSED'
    when accepted_count>0 then 'CONTACT_ACCEPTED_ELSEWHERE' else 'CONTACT_OBSOLETE' end,updated_at_utc=at_utc where id=d.id;
  update public.mail_outbox set status='FAILED',provider_status='CONTACT_RETIRED_NOT_SENT',last_error='CONTACT_PAYLOAD_RETIRED',
   attempt_lease_token=null,attempt_leased_at_utc=null,attempt_lease_expires_at_utc=null,next_attempt_at_utc=next_at where id=o.id;
 end loop;
 update public.hr_issue_email_deliveries set contact_rechecked_at_utc=at_utc where id=root.id;
 if root.status='RETIRED' or exists(select 1 from public.hr_issue_email_deliveries x where x.id=root.id and x.status='RETIRED') then
  update public.mail_outbox set next_attempt_at_utc=case when next_at is not null then next_at when unknown_count>0 then at_utc+interval '15 minutes' else null end where id=root.mail_outbox_id;
 end if;
 perform private.weekly_contact_query_complete_v1(root.import_id,root.operation_id,root.created_by_user_id);
 outcome:=case when target_id=requested.id then 'CURRENT' when target_id is not null then 'RECOMPOSED'
  when unknown_count>0 then 'CHECK_ORIGINAL_ATTEMPT' when paused_count>0 then 'PAUSED' else 'OBSOLETE' end;
 return jsonb_build_object('ok',true,'version','TIMESHEET_QUERY_RECOMPOSE_RESULT_V1','mail_outbox_id',requested.mail_outbox_id,'query_delivery_id',requested.id,
  'original_delivery_id',root.id,'disposition',outcome,'replacements',case when target_id is null then '[]'::jsonb
   else jsonb_build_array(jsonb_build_object('mail_outbox_id',target_mail,'query_delivery_id',target_id)) end,
  'excluded',excluded,'next_eligible_at_utc',case when next_at is null then null else to_char(next_at at time zone 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') end);
end;
$function$;
