          "name": "original_component",
          "type": "jsonb",
          "nullable": false
        },
        {
          "name": "captured_at_utc",
          "type": "timestamp with time zone",
          "nullable": false
        }
      ],
      "constraints": [
        {
          "name": "bpay_next_case_channel_compo_applied_basis_source_amount__check",
          "definition": "CHECK (((applied_basis_source_amount_ex_vat)::numeric >= (0)::numeric))"
        },
        {
          "name": "bpay_next_case_channel_compon_applied_rule_id_case_id_cand_fkey",
          "definition": "FOREIGN KEY (applied_rule_id, case_id, candidate_id) REFERENCES private.bpay_next_case_rule(id, case_id, candidate_id) ON DELETE RESTRICT"
        },
        {
          "name": "bpay_next_case_channel_compon_case_component_id_case_id_ca_fkey",
          "definition": "FOREIGN KEY (case_component_id, case_id, candidate_id) REFERENCES private.bpay_next_case_component(id, case_id, candidate_id) ON DELETE RESTRICT"
        },
        {
          "name": "bpay_next_case_channel_compon_command_id_case_id_candidate_fkey",
          "definition": "FOREIGN KEY (command_id, case_id, candidate_id) REFERENCES private.bpay_next_case_channel_request(command_id, case_id, candidate_id) ON DELETE RESTRICT"
        },
        {
          "name": "bpay_next_case_channel_compon_original_rule_id_case_id_can_fkey",
          "definition": "FOREIGN KEY (original_rule_id, case_id, candidate_id) REFERENCES private.bpay_next_case_rule(id, case_id, candidate_id) ON DELETE RESTRICT"
        },
        {
          "name": "bpay_next_case_channel_compon_previous_component_revision_check",
          "definition": "CHECK (((previous_component_revision > 0) AND (previous_component_revision < '9223372036854775807'::bigint)))"
        },
        {
          "name": "bpay_next_case_channel_compon_valuation_policy_id_valuatio_fkey",
          "definition": "FOREIGN KEY (valuation_policy_id, valuation_window_id) REFERENCES private.bpay_next_valuation_policy_window(policy_id, source_window_id) ON DELETE RESTRICT"
        },
        {
          "name": "bpay_next_case_channel_compone_command_id_component_ordinal_key",
          "definition": "UNIQUE (command_id, component_ordinal)"
        },
        {
          "name": "bpay_next_case_channel_component_captured_at_utc_check",
          "definition": "CHECK (isfinite(captured_at_utc))"
        },
        {
          "name": "bpay_next_case_channel_component_check",
          "definition": "CHECK ((applied_component_revision = (previous_component_revision + 1)))"
        },
        {
          "name": "bpay_next_case_channel_component_check1",
          "definition": "CHECK (((target_inc_vat)::numeric = ((target_ex_vat)::numeric + (target_vat)::numeric)))"
        },
        {
          "name": "bpay_next_case_channel_component_check2",
          "definition": "CHECK ((fixed_reimbursement = (tax_treatment = 'NON_TAXABLE'::text)))"
        },
        {
          "name": "bpay_next_case_channel_component_check3",
          "definition": "CHECK (((NOT fixed_reimbursement) OR ((target_ex_vat)::numeric = (applied_basis_source_amount_ex_vat)::numeric)))"
        },
        {
          "name": "bpay_next_case_channel_component_component_ordinal_check",
          "definition": "CHECK ((component_ordinal > 0))"
        },
        {
          "name": "bpay_next_case_channel_component_instruction_kind_check",
          "definition": "CHECK ((instruction_kind = ANY (ARRAY['RECOVERY'::text, 'CREDIT'::text])))"
        },
        {
          "name": "bpay_next_case_channel_component_original_component_check",
          "definition": "CHECK (((jsonb_typeof(original_component) = 'object'::text) AND (octet_length((original_component)::text) <= 16384)))"
        },
        {
          "name": "bpay_next_case_channel_component_pkey",
          "definition": "PRIMARY KEY (command_id, case_component_id)"
        },
        {
          "name": "bpay_next_case_channel_component_quote_operands_check",
          "definition": "CHECK (((jsonb_typeof(quote_operands) = 'object'::text) AND (octet_length((quote_operands)::text) <= 8192)))"
        },
        {
          "name": "bpay_next_case_channel_component_resolution_mode_check",
          "definition": "CHECK ((resolution_mode = ANY (ARRAY['SUGGESTED_EQUIVALENT_BASIS'::pay_finance_component_resolution_mode_enum, 'MANUAL_AMOUNT'::pay_finance_component_resolution_mode_enum])))"
        },
        {
          "name": "bpay_next_case_channel_component_source_pay_channel_check",
          "definition": "CHECK ((source_pay_channel = ANY (ARRAY['PAYE'::text, 'UMBRELLA'::text])))"
        },
        {
          "name": "bpay_next_case_channel_component_target_ex_vat_check",
          "definition": "CHECK (((target_ex_vat)::numeric >= (0)::numeric))"
        },
        {
          "name": "bpay_next_case_channel_component_target_pay_channel_check",
          "definition": "CHECK ((target_pay_channel = ANY (ARRAY['PAYE'::text, 'UMBRELLA'::text])))"
        },
        {
          "name": "bpay_next_case_channel_component_target_vat_check",
          "definition": "CHECK (((target_vat)::numeric >= (0)::numeric))"
        },
        {
          "name": "bpay_next_case_channel_component_tax_treatment_check",
          "definition": "CHECK ((tax_treatment = ANY (ARRAY['TAXABLE'::text, 'NON_TAXABLE'::text])))"
        }
      ],
      "triggers": [
        "CREATE TRIGGER bpay_next_case_channel_component_immutable_v1 BEFORE DELETE OR UPDATE ON private.bpay_next_case_channel_component FOR EACH ROW EXECUTE FUNCTION private.bpay_next_effect_immutable_v1()",
