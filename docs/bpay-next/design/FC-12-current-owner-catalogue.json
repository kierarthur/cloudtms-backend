      "constraints": [
        {
          "name": "bpay_next_case_restructure_p_previous_opening_outstanding_check",
          "definition": "CHECK (((previous_opening_outstanding)::numeric >= (0)::numeric))"
        },
        {
          "name": "bpay_next_case_restructure_pe_case_component_id_case_id_ca_fkey",
          "definition": "FOREIGN KEY (case_component_id, case_id, candidate_id) REFERENCES private.bpay_next_case_component(id, case_id, candidate_id) ON DELETE RESTRICT"
