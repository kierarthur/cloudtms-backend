          "definition": "CHECK (((opening_due)::numeric >= (0)::numeric))"
        },
        {
          "name": "bpay_next_case_restructure_period_opening_outstanding_check",
          "definition": "CHECK (((opening_outstanding)::numeric >= (0)::numeric))"
        },
        {
          "name": "bpay_next_case_restructure_period_period_revision_check",
          "definition": "CHECK ((period_revision > 1))"
        },
        {
          "name": "bpay_next_case_restructure_period_pkey",
          "definition": "PRIMARY KEY (case_component_id, pay_week_start, period_revision)"
