  "schema": [
    {
      "name": "bpay_next_case_restructure_outcome",
      "owner": "cloudtms_bpay_local_owner",
      "acl": "{cloudtms_bpay_local_owner=arwdDxtm/cloudtms_bpay_local_owner}",
      "columns": [
        {
          "name": "command_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "case_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "candidate_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "job_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "outcome",
          "type": "text",
          "nullable": false
        },
        {
          "name": "applied_case_revision",
          "type": "bigint",
          "nullable": true
        },
        {
          "name": "applied_rule_id",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "issue_code",
          "type": "text",
          "nullable": true
        },
        {
          "name": "completed_at_utc",
          "type": "timestamp with time zone",
          "nullable": false
        }
      ],
      "constraints": [
        {
          "name": "bpay_next_case_restructure_ou_applied_rule_id_case_id_cand_fkey",
          "definition": "FOREIGN KEY (applied_rule_id, case_id, candidate_id) REFERENCES private.bpay_next_case_rule(id, case_id, candidate_id) ON DELETE RESTRICT"
        },
        {
          "name": "bpay_next_case_restructure_ou_command_id_case_id_candidate_fkey",
          "definition": "FOREIGN KEY (command_id, case_id, candidate_id) REFERENCES private.bpay_next_case_restructure_request(command_id, case_id, candidate_id) ON DELETE RESTRICT"
        },
        {
          "name": "bpay_next_case_restructure_outcome_check",
          "definition": "CHECK ((((outcome = 'APPLIED'::text) AND (applied_case_revision > 0) AND (applied_case_revision IS NOT NULL) AND (applied_rule_id = command_id) AND (applied_rule_id IS NOT NULL) AND (issue_code IS NULL)) OR ((outcome = 'BLOCKED'::text) AND (applied_case_revision IS NULL) AND (applied_rule_id IS NULL) AND (issue_code = ANY (ARRAY['BPAY_NEXT_CASE_PROTECTION_CHANGED'::text, 'BPAY_NEXT_CASE_RESTRUCTURE_UNSUPPORTED'::text, 'BPAY_NEXT_CASE_RESTRUCTURE_NO_BALANCE'::text, 'BPAY_NEXT_CASE_RESTRUCTURE_TOTAL_CHANGED'::text, 'BPAY_NEXT_CASE_PROTECTION_BALANCE_INVALID'::text])) AND (issue_code IS NOT NULL))))"
        },
        {
          "name": "bpay_next_case_restructure_outcome_completed_at_utc_check",
          "definition": "CHECK (isfinite(completed_at_utc))"
        },
        {
          "name": "bpay_next_case_restructure_outcome_job_id_fkey",
          "definition": "FOREIGN KEY (job_id) REFERENCES private.bpay_next_job(id) ON DELETE RESTRICT"
        },
        {
          "name": "bpay_next_case_restructure_outcome_job_id_key",
          "definition": "UNIQUE (job_id)"
        },
        {
          "name": "bpay_next_case_restructure_outcome_outcome_check",
          "definition": "CHECK ((outcome = ANY (ARRAY['APPLIED'::text, 'BLOCKED'::text])))"
        },
        {
          "name": "bpay_next_case_restructure_outcome_pkey",
          "definition": "PRIMARY KEY (command_id)"
        }
      ],
      "triggers": [
        "CREATE TRIGGER bpay_next_case_restructure_outcome_immutable_v1 BEFORE DELETE OR UPDATE ON private.bpay_next_case_restructure_outcome FOR EACH ROW EXECUTE FUNCTION private.bpay_next_effect_immutable_v1()",
        "CREATE TRIGGER bpay_next_case_restructure_outcome_truncate_v1 BEFORE TRUNCATE ON private.bpay_next_case_restructure_outcome FOR EACH STATEMENT EXECUTE FUNCTION private.bpay_next_effect_immutable_v1()"
      ]
    },
