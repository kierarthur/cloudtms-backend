{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "codex-cloudtms-backend",
  "main": "../broker/src/index.js",
  "compatibility_date": "2025-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "test-cloudtms-preview",
      "preview_bucket_name": "test-cloudtms-preview"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "6f3888a777f844959e35f4b2fb0dce9b",
      "preview_id": "6f3888a777f844959e35f4b2fb0dce9b"
    }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
