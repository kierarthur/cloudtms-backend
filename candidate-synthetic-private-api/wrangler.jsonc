{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "test-cloudtms-candidate-synthetic-private-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CANDIDATE_APP_ENVIRONMENT": "TEST",
    "CANDIDATE_AGENCY_ID": "457bce0f-65ad-4335-b839-96a85c8d18b1",
    "CANDIDATE_DATA_PLANE_ID": "41a0e81a-7f9b-405f-862d-16c58db30bb9",
    "CANDIDATE_ROUTE_VERSION": "1",
    "CANDIDATE_ROUTE_CONTEXT_READ_KEY_VERSIONS": "1",
    "CANDIDATE_APP_READY_PROOF_ENABLED": "TRUE",
    "CANDIDATE_APP_READY_PROOF_CLASS": "SYNTHETIC_NON_BUSINESS_FIXTURE",
    "CANDIDATE_APP_READY_RUNTIME_MARKER_SHA256": "f078fdc3b8a030b060626117136db67452e46d12c54cc19b2f6097f0d4a08951"
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "test-cloudtms-preview"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
