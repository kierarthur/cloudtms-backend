{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "test-cloudtms-weekly-source-delivery",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "WEEKLY_SOURCE_ENVIRONMENT": "TEST"
  },
  "services": [
    {
      "binding": "CLOUDTMS_WEEKLY_SOURCE_RUNTIME",
      "service": "test-cloudtms-backend"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WEEKLY_SOURCE_DELIVERY_QUEUE",
        "queue": "test-cloudtms-weekly-source-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "test-cloudtms-weekly-source-delivery",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 30,
        "max_concurrency": 1,
        "dead_letter_queue": "test-cloudtms-weekly-source-delivery-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
