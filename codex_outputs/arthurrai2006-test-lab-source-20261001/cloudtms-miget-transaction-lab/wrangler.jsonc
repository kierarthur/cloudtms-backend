{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-cloudtms-miget-transaction-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": ["MIGET_TRANSACTION_LAB_ROUTE_TOKEN"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "11c78f14afea494c9d5e8d8ad57d41a2"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
